# 旧注解模型仅供显式基线测试／审计引用；服务初始化不引用它的 payload。
pub mod model;
# 开发审计通过 @src/source_audit 显式访问，不参与服务初始化
pub mod typed;

pub use crate::typed::{payload};
use ontology::intent as intent;
use crate::typed::{prepared};
use ontology::world as world;
use ontology::sqlite as sqlite;
use std::transform_service as service;
use std::http as http;
use std::value::{Value};

def lower: Fn(Value) -> Value = world::stage_prepared(
    typed::model_world,
    fn() {
        prepared
    },
    fn(payload) {
        intent::query_request_method_factory(payload, sqlite::build_query)
    }
);

type QueryService = struct {
    lower: Fn(Value) -> Value
};
impl service::TransformService for QueryService {
    init: fn(ctx) {
        {lower: lower}.ty!(Self)
    },
    transform: fn(self, input) {
        self.lower(input)
    },
};

@service::collection
pub type MainService = struct {
    @service::slot("ic/transform")
    @http::post("/ic/transform")
    query: QueryService,
};
