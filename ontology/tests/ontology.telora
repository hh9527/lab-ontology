pub def computed_measure_host_needs_no_physical_column: test::Test = test::should_ok(fn() {
    let payload = edsl::build_root("computed-without-host-v1", [ComputedWithoutHostColumn.type], knowledge::profile,
        fn(subject) { subject == "analyst" });
    if edsl::measure_domain(payload, "host_total").computed != None { True }
    else { fail!("computed measure must use its mapped dependencies") }
});

pub def unrelated_unmapped_field_does_not_block_model: test::Test = test::should_ok(fn() {
    let payload = edsl::build_root("unrelated-unmapped-v1", [UnrelatedUnmappedField.type], knowledge::profile,
        fn(subject) { subject == "analyst" });
    if array::length(payload.entities) == 1 { True } else { fail!("unrelated field should not require mapping") }
});

def union_single_int_column: Array(edsl::UnionColumnDecl) = [{field: 0, column: "id"}];
def union_single_float_column: Array(edsl::UnionColumnDecl) = [{field: 0, column: "amount"}];
def union_single_state_column: Array(edsl::UnionColumnDecl) = [{field: 0, column: "state"}];

def union_text_on_int: edsl::ScopePredicate = {field: 0, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("1")};
def union_number_on_int: edsl::ScopePredicate = {field: 0, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Number(1.0)};
def union_int_on_float: edsl::ScopePredicate = {field: 0, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Int(1)};
def union_int_on_int: edsl::ScopePredicate = {field: 0, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Int(1)};
