# spider-model/src/model.telora
#
# EnterpriseKnowledge for the Spider `concert_singer` domain, built on the
# ontology eDSL.  The domain-neutral declarations here are PRIVATE: physical
# table/column names and relation paths live in this module and are never
# published to docs/DOMAIN.md or docs/INTENT.md.  Only the stable business
# vocabulary ids (measures/dimensions/entities) are public, and they are
# documented in docs/DOMAIN.md.
#
# Physical tables and columns are mapped with lowercase identifiers; SQLite
# identifier matching is case-insensitive, so the generated SQL runs against
# the actual database regardless of the physical casing.

import "ontology/query" as qb;
import "ontology/edsl" as edsl;

# ---------------------------------------------------------------------------
# Pre-bound decorator arguments (decorator calls do not re-type literals).
# ---------------------------------------------------------------------------

def count_agg: qb.AggregateFunction = 'Count;
def avg_agg: qb.AggregateFunction = 'Avg;
def min_agg: qb.AggregateFunction = 'Min;
def max_agg: qb.AggregateFunction = 'Max;

def flag_true: Bool = 'True;
def flag_false: Bool = 'False;

# Numeric dimensions accept equality/order comparisons and both Int/Number
# filter values; text dimensions accept equality and the closed text operators.
def num_ops: Array(edsl.FilterOp) = ['Eq, 'Ne, 'Gt, 'Ge, 'Lt, 'Le];
def text_ops: Array(edsl.FilterOp) = ['Eq, 'Ne, 'Contains, 'NotContains, 'StartsWith, 'EndsWith];
def text_kinds: Array(edsl.FilterInputKind) = ['Text];
def num_kinds: Array(edsl.FilterInputKind) = ['Int, 'Number];

def safe_kind: edsl.RelationKind = 'Safe;
def fanout_kind: edsl.RelationKind = 'FanOut;

def requires_none: Array(Type) = [];

# ---------------------------------------------------------------------------
# Entity declarations.
#
# IMPORTANT: canonical field indexes are the alphabetical order of the field
# names (see ontology docs).  Fields are written below in alphabetical order so
# the index comments match the canonical order used by @edsl.relation.
#
# A physical column can back several logical fields when several measures need
# to aggregate the same column (each field carries at most one plain measure).
# ---------------------------------------------------------------------------

# --- singer ---------------------------------------------------------------
# Business object: a singer with a name, country, representative song name,
# song release year and age.
# Canonical fields: age(0), age_avg(1), age_max(2), age_min(3), country(4),
# id(5), name(6), song_name(7), song_release_year(8).
@edsl.entity_id("singer")
@edsl.entity_source("singer", "sg")
# Fan-out first hop of a declared two-hop existence route to concerts:
# singer --(participates in many rows)--> singer_in_concert --(one concert)--> concert.
# The base lowers this as the link shape: bridge and concert are joined inside a
# single correlated EXISTS, so singer rows are never amplified and requests return
# only singer dimensions.
@edsl.relation(SingerInConcert, fanout_kind, 5, 1)
@edsl.exists_route(SingerInConcert, Concert)
type Singer = struct {
    @edsl.column("age")
    @edsl.dimension("singer_age", flag_true, flag_true, num_ops, num_kinds)
    age: Int,

    @edsl.column("age")
    @edsl.measure("singer_age_avg", avg_agg, requires_none)
    age_avg: Int,

    @edsl.column("age")
    @edsl.measure("singer_age_max", max_agg, requires_none)
    age_max: Int,

    @edsl.column("age")
    @edsl.measure("singer_age_min", min_agg, requires_none)
    age_min: Int,

    @edsl.column("country")
    @edsl.dimension("singer_country", flag_true, flag_true, text_ops, text_kinds)
    country: String,

    @edsl.column("singer_id")
    @edsl.key(flag_true)
    @edsl.measure("singer_count", count_agg, requires_none)
    id: Int,

    @edsl.column("name")
    @edsl.dimension("singer_name", flag_true, flag_true, text_ops, text_kinds)
    name: String,

    @edsl.column("song_name")
    @edsl.dimension("singer_song_name", flag_true, flag_true, text_ops, text_kinds)
    song_name: String,

    @edsl.column("song_release_year")
    @edsl.dimension("singer_song_year", flag_true, flag_true, num_ops, num_kinds)
    song_release_year: Int,
};

# --- stadium ---------------------------------------------------------------
# Business object: a stadium with location, name, capacity and three ticket
# price statistics (highest/lowest/average).
# Canonical fields: average(0), capacity(1), capacity_avg(2), capacity_max(3),
# highest(4), id(5), location(6), lowest(7), name(8).
#
# Several logical fields map to the same physical column "capacity": each
# struct field can carry at most one plain measure, so a separate field is
# declared for each aggregate of the capacity statistic.
@edsl.entity_id("stadium")
@edsl.entity_source("stadium", "st")
type Stadium = struct {
    @edsl.column("average")
    @edsl.dimension("stadium_average", flag_true, flag_true, num_ops, num_kinds)
    average: Int,

    @edsl.column("capacity")
    @edsl.dimension("stadium_capacity", flag_true, flag_true, num_ops, num_kinds)
    capacity: Int,

    @edsl.column("capacity")
    @edsl.measure("stadium_capacity_avg", avg_agg, requires_none)
    capacity_avg: Int,

    @edsl.column("capacity")
    @edsl.measure("stadium_capacity_max", max_agg, requires_none)
    capacity_max: Int,

    @edsl.column("highest")
    @edsl.dimension("stadium_highest", flag_true, flag_true, num_ops, num_kinds)
    highest: Int,

    @edsl.column("stadium_id")
    @edsl.key(flag_true)
    @edsl.measure("stadium_count", count_agg, requires_none)
    id: Int,

    @edsl.column("location")
    @edsl.dimension("stadium_location", flag_true, flag_true, text_ops, text_kinds)
    location: String,

    @edsl.column("lowest")
    @edsl.dimension("stadium_lowest", flag_true, flag_true, num_ops, num_kinds)
    lowest: Int,

    @edsl.column("name")
    @edsl.dimension("stadium_name", flag_true, flag_true, text_ops, text_kinds)
    name: String,
};

# --- concert ---------------------------------------------------------------
# Business object: a concert with a name and theme, held in a stadium in a
# given year.
# Canonical fields: id(0), name(1), stadium_id(2), theme(3), year(4).
@edsl.entity_id("concert")
@edsl.entity_source("concert", "co")
@edsl.relation(Stadium, safe_kind, 2, 5)
type Concert = struct {
    @edsl.column("concert_id")
    @edsl.key(flag_true)
    @edsl.measure("concert_count", count_agg, requires_none)
    id: Int,

    @edsl.column("concert_name")
    @edsl.dimension("concert_name", flag_true, flag_true, text_ops, text_kinds)
    name: String,

    @edsl.column("stadium_id")
    stadium_id: Int,

    @edsl.column("theme")
    @edsl.dimension("concert_theme", flag_true, flag_true, text_ops, text_kinds)
    theme: String,

    @edsl.column("year")
    @edsl.dimension("concert_year", flag_true, flag_true, num_ops, num_kinds)
    year: Int,
};

# --- singer_in_concert (bridge) --------------------------------------------
# Business object: a many-to-many participation bridge between singers and
# concerts.  Counting its rows counts participations; grouping it by a singer
# or concert attribute counts that side's participations.
# Canonical fields: concert_id(0), singer_id(1).
@edsl.entity_id("singer_in_concert")
@edsl.entity_source("singer_in_concert", "sic")
@edsl.relation(Concert, safe_kind, 0, 0)
@edsl.relation(Singer, safe_kind, 1, 5)
type SingerInConcert = struct {
    @edsl.column("concert_id")
    @edsl.measure("singer_in_concert_count", count_agg, requires_none)
    concert_id: Int,

    @edsl.column("singer_id")
    singer_id: Int,
};

# ---------------------------------------------------------------------------
# Profile and prepared payload.
# ---------------------------------------------------------------------------

def profile: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Exists, 'Join, 'Group, 'Order,
        'Limit, 'Offset,
    ],
    allowed_join_kinds: ['Inner, 'Left],
    allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
    allowed_scalars: [
        'Substr, 'Instr, 'If, 'Add, 'Sub, 'Lower, 'Length,
        'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not,
    ],
    allow_distinct: 'True,
};

# The make-query resolver authenticates a single fixed subject.  Dynamic
# subjects are not part of the INTENT contract.
def authorize: Fn(String) -> Bool = fn(subject) {
    subject == "public"
};

def entity_types: Array(Type) = [
    Singer,
    Stadium,
    Concert,
    SingerInConcert,
];

def payload: edsl.PreparedPayload = do {
    let result: edsl.PreparedPayload = edsl.build_root(
        "concert-singer-v1",
        entity_types,
        profile,
        authorize,
    );
    result
};

export {
    Singer,
    Stadium,
    Concert,
    SingerInConcert,
    profile,
    authorize,
    payload,
};
