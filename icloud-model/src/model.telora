# KPI rows have a separate sampling grain; declared metrics and raw-sample
# summaries remain distinct knowledge points over that grain.
@edsl::entity_id("device_kpi")
@edsl::entity_source("NetworkDeviceKPI", "k")
@edsl::dataset_description("Device KPI samples", "UTC samples of network device measurements")
@edsl::relation_description("device_kpi_of_device", "Samples for device", "Resource and tenant identify the KPI owner")
@edsl::dataset(metric_kind, kpi_grain, kpi_time)
@edsl::named_relation_key("device_kpi_of_device", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::And([
            edsl::RelationKey::FieldEq({ from: "res_id", to: "id" }),
        ]),
        edsl::RelationKey::FieldEq({ from: "tenant_id", to: "tenant_id" }),
    ]))
type DeviceKpi = struct {
    @edsl::column("resId")
    @edsl::dimension("device_kpi_res_id", yes, yes, text_ops, text_inputs)
    @edsl::measure("device_kpi_sample_count", qb::AggregateFunction::Count, none_required)
    @edsl::measure_description("device_kpi_sample_count", "Eligible KPI sample count", "Counts sample rows satisfying the intent's explicit sample predicate and time window")
    res_id: String,
    @edsl::column("tenantId")
    @edsl::dimension("device_kpi_tenant_id", yes, yes, text_ops, text_inputs)
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(utc_role, utc_seconds)
    @edsl::dimension("device_kpi_ts_raw", yes, yes, utc_window_ops, text_inputs)
    ts: String,
    @edsl::column("cpuUsage")
    @edsl::measure("cpu_usage", avg_agg, none_required)
    @edsl::metric_value("cpu_usage", avg_agg, percent_unit)
    @edsl::sample_aggregate("cpu_peak", qb::AggregateFunction::Max, percent_unit)
    cpu_usage: Float,
    @edsl::column("memUsage")
    @edsl::measure("memory_usage", avg_agg, none_required)
    @edsl::metric_value("memory_usage", avg_agg, percent_unit)
    @edsl::measure_description("memory_usage", "Average memory usage", "Mean memory utilization across the eligible device KPI samples, in percent")
    mem_usage: Float,
    @edsl::column("portCount")
    @edsl::dimension("port_count_sample", yes, yes, int_ops, int_inputs)
    @edsl::measure("port_count", sum_agg, none_required)
    @edsl::measure_description("port_count", "Total port count", "Sum of declared device port-count samples")
    @edsl::metric_value("port_count", sum_agg, no_unit)
    @edsl::sample_aggregate("port_count_peak", qb::AggregateFunction::Max, no_unit)
    @edsl::measure_description("port_count_peak", "Peak sample port count", "Maximum raw port count in the selected samples")
    @edsl::sample_aggregate("port_count_sample_avg", avg_agg, no_unit)
    @edsl::measure_description("port_count_sample_avg", "Average port-count sample", "Mean raw portCount per eligible KPI sample; distinct from the published Sum of port-count samples")
    port_count: Int,
    @edsl::column("portUsedCount")
    @edsl::dimension("used_port_sample", yes, yes, int_ops, int_inputs)
    @edsl::measure("used_port_count", sum_agg, none_required)
    @edsl::metric_value("used_port_count", sum_agg, no_unit)
    @edsl::sample_aggregate("used_port_sample_avg", avg_agg, no_unit)
    @edsl::sample_aggregate("used_port_sample_max", qb::AggregateFunction::Max, no_unit)
    @edsl::measure_description("used_port_sample_max", "Maximum used ports in a KPI sample", "Maximum raw used-port count in the eligible samples; distinct from the published Sum")
    port_used_count: Int,
    @edsl::column("operStatusCount")
    @edsl::dimension("running_port_sample", yes, yes, int_ops, int_inputs)
    @edsl::measure("running_port_count", sum_agg, none_required)
    @edsl::metric_value("running_port_count", sum_agg, no_unit)
    @edsl::sample_aggregate("running_port_sample_avg", avg_agg, no_unit)
    oper_status_count: Int,
    @edsl::column("adminStatusCount")
    @edsl::dimension("admin_port_sample", yes, yes, int_ops, int_inputs)
    admin_status_count: Int,
};

