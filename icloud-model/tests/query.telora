def independent_metric_plan: Fn(edsl::PreparedPayload) -> qb::Plan = fn(knowledge) {
    let average: edsl::MetricQualification = {
        relation: "device_kpi_of_device", dataset: "device_kpi", measure: "memory_usage",
        filters: [], start: "2024-02-26T00:00:00Z", end: "2024-02-29T00:00:00Z",
        op: edsl::HavingOp::Ge, threshold: edsl::FilterInput::Number(47.5),
    };
    let ports: edsl::MetricQualification = {...average,
        measure: "port_count_sample_avg", threshold: edsl::FilterInput::Int(48)};
    edsl::lower_metric_qualifications(knowledge,
        {measures: [{id: "device_count", subject: "public", input: edsl::MeasureInput::All}],
         dimensions: [], filters: [], ordering: [], limit: None, offset: None, partition: None},
        [average, ports], None)
};

