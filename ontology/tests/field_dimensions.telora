use ontology::groups as g;
use ontology::model as m;
use ontology::transform as t;
use ontology::scalars as s;
use std::array as array;
use std::test as test;

type Row = struct {
    @g::exact("id")
    id: Int,
    @m::column("LABEL")
    @g::search("name")
    @g::exact("name_exact")
    name: Option(String),
    @g::numeric("reading")
    reading: Float,
    @g::epoch_millis("at")
    at: s::EpochMillis
};
def dataset: m::Dataset(Row) = m::dataset("readings", "readings", Row.type, ["id"]);
pub def properties_expand_into_shared_declaration: test::Test = test::should_ok(
    fn() {
        let groups = t::declare(dataset, [], [], []).groups;
        array::length(groups) == 5 && array::any(
            groups,
            fn(binding) {
                let member = binding.members[0];
                member.id == "name" && member.nullable && member.value == String.type && member.node == g::Node::Column(
                    {name: "name", value: String.type, nullable: True}
                )
            }
        )
    }
);
pub def composed_ability_reuses_declared_dimension: test::Test = test::should_ok(
    fn() {
        g::binding_facts(g::field_binding(dataset, "name")) == g::field_dimensions(dataset)[1]
    }
);
type Invalid = struct {
    @g::search("number")
    number: Int
};
pub def search_requires_text: test::Test = test::should_fail_with(
    fn() {
        g::field_dimensions(m::dataset("invalid", "invalid", Invalid.type, []));
        True
    },
    "search dimension requires String"
);
pub def missing_dimension_is_diagnosed: test::Test = test::should_fail_with(
    fn() {
        g::field_binding(dataset, "absent");
        True
    },
    "unknown declared field dimension"
);

def shared: g::DimensionGroup(Int) = g::dimension_group(
    "shared",
    Int.type,
    True,
    g::numeric_filters
);
type Narrowed = struct {
    @g::field_view(shared, "limited", False, [g::Filter::Eq])
    value: Int
};
pub def field_view_preserves_shared_group_and_member_policy: test::Test = test::should_ok(
    fn() {
        let binding = g::field_dimensions(m::dataset("narrowed", "narrowed", Narrowed.type, []))[0];
        let member = binding.members[0];
        member.group == "shared" && !member.projectable && member.filters == [g::Filter::Eq] && member.kind == g::MemberKind::Dimension(
            {projectable: True, filters: g::numeric_filters}
        )
    }
);
type WrongView = struct {
    @g::field_view(shared, "wrong", True, [g::Filter::Eq])
    value: String
};
pub def field_view_requires_matching_value_type: test::Test = test::should_fail_with(
    fn() {
        g::field_dimensions(m::dataset("wrong", "wrong", WrongView.type, []));
        True
    },
    "field view does not match group type"
);
