pub mod model;
pub mod units;
pub mod identities;
pub mod groups;
pub mod domains;
pub mod datasets;
mod profile;
use ontology::world as w;
use ontology::intent as intent;
use ontology::sqlite as sqlite;
use std::transform_service as service;
use std::http as http;
use std::value::{Value};
def lower: Fn(Value) -> Value = w::stage(
    model::model_world,
    fn(payload) {
        intent::query_request_method_factory(payload, sqlite::build_query)
    }
);
type QueryService = struct {
    lower: Fn(Value) -> Value
};
impl service::TransformService for QueryService {
    init: fn(ctx) {
        {lower}.ty!(Self)
    },
    transform: fn(self, input) {
        self.lower(input)
    },
};
@service::collection
pub type MainService = struct {
    @service::slot("ns/transform")
    @http::post("/ns/transform")
    query: QueryService,
};
