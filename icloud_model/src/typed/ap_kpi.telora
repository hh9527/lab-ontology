use super::metric_values as metric;
use ontology::quantity as statistic_quantity;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::quantity as presentation;
use ontology::semantic as domain;
# 保留暂定租户／资源／UTC 样本身份，生产唯一性仍待 #51 确认。
use super::inventory as i;
use super::ap_quantities as a;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::quantity as q;
use ontology::samples as samples;
use ontology::values as v;
use ontology::query as qb;
type ApMemoryUtilization = struct(q::Percent);
def ap_memory_statistics: samples::Group(ApMemoryUtilization) = samples::group(
    "ap_memory_utilization", ApMemoryUtilization.type, samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max], None
);
@domain::bind(i::DeviceById.type, "source_resId")
@domain::dataset(
    "source_NetworkAPKPI",
    "NetworkAPKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
@domain::relations(source_relations)
type NetworkAPKPI = struct {
    @m::column("ts")
    @g::view("source_NetworkAPKPI__ts", True, g::numeric_filters)
    @g::utc_bucket_view("source_NetworkAPKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkAPKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkAPKPI_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("ap_kpi_sample_count")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkAPKPI__resId")
    source_resId: domain::Reference(i::DeviceById),
    @m::column("tenantId")
    @g::exact("source_NetworkAPKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_NetworkAPKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_NetworkAPKPI__projectId")
    source_projectId: String,
    @m::column("hwCurrAssStationCount")
    @g::view("source_NetworkAPKPI__hwCurrAssStationCount", True, g::numeric_filters)
    @samples::field(
        a::count_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_associated_terminals"},
            {statistic: samples::Statistic::Max, publish: "ap_associated_terminals_max"},
            {statistic: samples::Statistic::Min, publish: "ap_associated_terminals_min"}
        ]
    )
    @samples::valid_count("source_hwCurrAssStationCountEffcnt")
    @domain::count("ap_associated_terminals_observation_count")
    source_hwCurrAssStationCount: q::Count,
    @m::column("hwApMemoryUseRate")
    @g::view("ap_memory_usage_sample", True, g::numeric_filters)
    @samples::field(ap_memory_statistics, [
        {statistic: samples::Statistic::Mean, publish: "ap_memory_usage_avg"},
        {statistic: samples::Statistic::Min, publish: "ap_memory_usage_min"},
        {statistic: samples::Statistic::Max, publish: "ap_memory_usage_max"}
    ])
    @domain::count("ap_memory_usage_observation_count")
    memory_usage: Option(ApMemoryUtilization),
    @m::column("hwApEthportUpRate")
    @g::view("source_NetworkAPKPI__hwApEthportUpRate", True, g::numeric_filters)
    @samples::field(
        a::rate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_uplink_tx_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_uplink_tx_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_uplink_tx_rate_min"}
        ]
    )
    @samples::valid_count("source_hwApEthportUpRateEffcnt")
    @domain::count("ap_uplink_tx_rate_observation_count")
    source_hwApEthportUpRate: a::KilobitsPerSecond,
    @m::column("hwApEthportDownRate")
    @g::view("source_NetworkAPKPI__hwApEthportDownRate", True, g::numeric_filters)
    @samples::field(
        a::rate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_uplink_rx_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_uplink_rx_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_uplink_rx_rate_min"}
        ]
    )
    @samples::valid_count("source_hwApEthportDownRateEffcnt")
    @domain::count("ap_uplink_rx_rate_observation_count")
    source_hwApEthportDownRate: a::KilobitsPerSecond,
    @m::column("hwAPUpPortPER")
    @g::view("source_NetworkAPKPI__hwAPUpPortPER", True, g::numeric_filters)
    @samples::field(
        metric::ApUplinkErrorRate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_uplink_packet_error_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_uplink_packet_error_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_uplink_packet_error_rate_min"}
        ]
    )
    @samples::valid_count("source_hwAPUpPortPEREffcnt")
    @domain::count("ap_uplink_packet_error_rate_observation_count")
    source_hwAPUpPortPER: metric::ApUplinkErrorRate,
    @m::column("hwCurrAssStationCountEffcnt")
    @g::view("source_NetworkAPKPI__hwCurrAssStationCountEffcnt", True, g::numeric_filters)
    source_hwCurrAssStationCountEffcnt: a::EffectiveCount,
    @m::column("hwApEthportUpRateEffcnt")
    @g::view("source_NetworkAPKPI__hwApEthportUpRateEffcnt", True, g::numeric_filters)
    source_hwApEthportUpRateEffcnt: a::EffectiveCount,
    @m::column("hwApEthportDownRateEffcnt")
    @g::view("source_NetworkAPKPI__hwApEthportDownRateEffcnt", True, g::numeric_filters)
    source_hwApEthportDownRateEffcnt: a::EffectiveCount,
    @m::column("hwAPUpPortPEREffcnt")
    @g::view("source_NetworkAPKPI__hwAPUpPortPEREffcnt", True, g::numeric_filters)
    source_hwAPUpPortPEREffcnt: a::EffectiveCount,
};

pub use self::{NetworkAPKPI};

def source_relations: Array(r::Relation) = [
    r::relation(
        "source_EntNetworkElement_NetworkAPKPI",
        i::ap_subject,
        domain::endpoint(NetworkAPKPI.type, "source_resId"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    )
];
