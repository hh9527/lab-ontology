def device: r::Endpoint = domain::endpoint(PonDeviceOnuKPI.type, "res_id");
def relations: Array(r::Relation) = [
    r::relation(
        "onu_kpi_of_pon_device",
        device,
        p::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "onu_kpi_of_onu_role",
        device,
        onu::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntPonElementAssociationPonDeviceOnuKPI",
        p::subject,
        device,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

