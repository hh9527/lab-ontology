pub def ic_physical_link_peer_is_traversable_from_both_endpoints: test::Test = test::should_ok(fn() {
    let from_a = lower(json::parse(r#"{
        "op":"graph", "root":"a", "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"physical_link_peer_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let from_z = lower(json::parse(r#"{
        "op":"graph", "root":"z", "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"physical_link_peer_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    if string::contains(from_a.sql, "a_ne_res_id") && string::contains(from_a.sql, "z_ne_res_id")
        && string::contains(from_a.sql, "tenantId") && string::contains(from_a.sql, " OR ")
        && string::contains(from_z.sql, " OR ") { True }
    else { fail!("IC bidirectional link lost A/Z or tenant ownership", from_a.sql, from_z.sql) }
});

pub def site_qualified_link_names_use_one_undirected_participation_relation: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"link",
        "nodes":[{"id":"link","entity":"physical_link"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"physical_link_attached_device","from":"link","to":"device"}],
        "select":[{"node":"link","dimension":"physical_link_name"}],
        "filters":[{"node":"device","dimension":"device_class","op":"eq","kind":"text","value":"router"}],
        "exists":[{"anchor":"device","nodes":[{"id":"site","entity":"site"}],
            "edges":[{"relation":"device_located_at_site","from":"device","to":"site"}],
            "filters":[{"node":"site","dimension":"site_type","op":"eq","kind":"text","value":"offline"}]}]
    }"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "link.a_ne_res_id = device.id AND link.tenantId = device.tenant_id")
        && string::contains(sq.sql, "link.z_ne_res_id = device.id AND link.tenantId = device.tenant_id")
        && string::contains(sq.sql, "SELECT link.name AS link_physical_link_name")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM X_SITE_VIEW AS site")
        && string::contains(pg.sql, "\"link\".\"name\"")
        && sq.bindings == pg.bindings { True }
    else { fail!(`site-scoped link name lost A/Z, tenant or site predicate: \{sq.sql} / \{pg.sql}`) }
});

pub def site_qualified_link_count_uses_correlated_device_candidate: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{"op":"graph","root":"link",
        "nodes":[{"id":"link","entity":"physical_link"}],"edges":[],
        "select":[],"count":"link",
        "exists":[{"anchor":"link",
            "nodes":[{"id":"device","entity":"device"},{"id":"site","entity":"site"}],
            "edges":[{"relation":"physical_link_attached_device","from":"link","to":"device"},
                     {"relation":"device_located_at_site","from":"device","to":"site"}],
            "filters":[{"node":"site","dimension":"site_type","op":"eq","kind":"text","value":"offline"}]}]
    }"#).unwrap!());
    if string::contains(query.sql, "count(link.id)")
        && string::contains(query.sql, "EXISTS (SELECT 1 FROM I_EntNetworkElement AS device")
        && string::contains(query.sql, "link.a_ne_res_id")
        && string::contains(query.sql, "link.z_ne_res_id") { True }
    else { fail!(`link count lost identity or candidate correlation: \{query.sql}`) }
});

pub def site_storage_counts_include_empty_full_site_identity: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"site","include_empty":true,
        "nodes":[{"id":"site","entity":"site"},{"id":"storage","entity":"storage_device"}],
        "edges":[{"relation":"storage_device_site","from":"storage","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"}],
        "count":"storage","group_by_identity":["site"],
        "filters":[{"node":"site","dimension":"site_type","op":"eq","kind":"text","value":"offline"},
                   {"node":"storage","dimension":"storage_device_subclass","op":"ne","kind":"text","value":"fc_switch_device"}]
    }"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "LEFT JOIN (SELECT * FROM HuaweiStorageDevice AS storage WHERE")
        && string::contains(sq.sql, "count(storage.id)")
        && string::contains(sq.sql, "GROUP BY site.SITE_NAME, site.SITE_ID")
        && string::contains(sq.sql, "storage.parentResId = site.SITE_ID")
        && string::contains(sq.sql, "storage.projectId = site.SITE_ID")
        && string::contains(sq.sql, "storage.parentResId = site.SITE_ID OR storage.projectId = site.SITE_ID")
        && string::contains(pg.sql, "LEFT JOIN (SELECT * FROM \"HuaweiStorageDevice\" AS \"storage\" WHERE")
        && sq.bindings == pg.bindings { True }
    else { fail!(`site child count lost zero groups, OR identity or subtype qualification: \{sq.sql} / \{pg.sql}`) }
});

pub def site_storage_count_requires_explicit_root_identity_group: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"site","include_empty":true,
        "nodes":[{"id":"site","entity":"site"},{"id":"storage","entity":"storage_device"}],
        "edges":[{"relation":"storage_device_site","from":"storage","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"}],"count":"storage"}"#).unwrap!())
}, "graph cannot prove the non-root count subject has one row per root relationship");

pub def site_storage_count_threshold_retains_zero_sites: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"site","include_empty":true,
        "nodes":[{"id":"site","entity":"site"},{"id":"storage","entity":"storage_device"}],
        "edges":[{"relation":"storage_device_site","from":"storage","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"}],
        "count":"storage","group_by_identity":["site"],
        "count_having":{"op":"lt","value":5}}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "LEFT JOIN HuaweiStorageDevice AS storage")
        && string::contains(sq.sql, "GROUP BY site.SITE_NAME, site.SITE_ID HAVING count(storage.id) < ?1")
        && string::contains(pg.sql, "HAVING count(\"storage\".\"id\") < $1")
        && sq.bindings == [qb::Val::Int(5)] && pg.bindings == sq.bindings { True }
    else { fail!("site count threshold lost grouped zero-site semantics", sq, pg) }
});

pub def site_storage_count_threshold_requires_root_grain: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"site","include_empty":true,
        "nodes":[{"id":"site","entity":"site"},{"id":"storage","entity":"storage_device"}],
        "edges":[{"relation":"storage_device_site","from":"storage","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"}],"count":"storage",
        "count_having":{"op":"lt","value":5}}"#).unwrap!())
}, "graph count threshold requires a count subject, complete root identity grouping and root-only dimensions");

