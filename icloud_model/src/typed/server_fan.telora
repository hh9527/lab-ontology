use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# ServerFan独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(
    String
);
@registry::entity("server_fan_entity")
type Identity = struct {
    id: ComponentId
};
@registry::dataset("server_fan", "PhysicalServerFan", ["id"])
@registry::roles([subject, parent, tenant])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("server_fan__slotId", Int.type, True, g::numeric_filters),
            g::input(m::field(PhysicalServerFan.type, Int.type, "source_slotId")),
            "server_fan__slotId",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::record_counts(["server_fan_count"])
@registry::relations(relations)
type PhysicalServerFan = struct {
    @g::exact("server_fan_id")
    id: ComponentId,
    @g::search("server_fan_name")
    name: String,
    @m::column("parentResId")
    parent_res_id: server::ServerOriginId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @g::search("server_fan_manufacturer")
    manufacturer: String,
    @m::column("sn")
    @g::search("server_fan__sn")
    source_sn: String,
    @m::column("slotId")
    source_slotId: Int,
    @m::column("healthStatus")
    @v::classification(health, "server_fan__healthStatus")
    source_healthStatus: Int,
    @m::column("fanName")
    @g::search("server_fan__fanName")
    source_fanName: String,
    @m::column("projectId")
    @g::exact("server_fan__projectId")
    source_projectId: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(PhysicalServerFan) = registry::dataset_of(PhysicalServerFan.type);
def subject: m::Role(PhysicalServerFan) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerFan.type, ComponentId.type, "id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def parent: m::Role(PhysicalServerFan) = m::role(
    dataset,
    server::origin_entity,
    "server_origin",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerFan.type, server::ServerOriginId.type, "parent_res_id"),
            m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServerFan) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerFan.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type ServerFanHealthStatus = enum {
    @ev::itag(0)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("warning", "警告")
    Warning,
    @ev::itag(2)
    @ev::description("average", "一般")
    Average,
    @ev::itag(3)
    @ev::description("serious", "严重")
    Serious,
    @ev::itag(4)
    @ev::description("critical", "紧急")
    Critical,
    @ev::itag(-1)
    @ev::description("wrong", "错误")
    Wrong,
    @ev::itag(-2)
    @ev::description("unknown", "未知")
    Unknown,
};
def health: v::Domain(ServerFanHealthStatus, Int) = v::from_enum(
    "ServerFanHealthStatus",
    ServerFanHealthStatus.type,
    Int.type,
    False
);
def tenant_cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "fan_parent_server",
        r::endpoint(dataset.row, parent.id),
        r::endpoint(server::dataset.row, server::origin.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_PhysicalServerFan",
        r::endpoint(server::dataset.row, server::origin.id),
        r::endpoint(dataset.row, parent.id),
        tenant_cardinality
    ),
    r::relation(
        "source_PhysicalServerFan_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        tenant_cardinality
    ),
    r::relation(
        "fan_belongs_to_tenant",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        tenant_cardinality
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerFan, Identity};
