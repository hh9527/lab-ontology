use crate::model as model;
use ontology::world as world;
use std::test as test;
use std::array as array;

pub def registered_ns_passes_model_self_check: test::Test = test::should_ok(
    fn() {
        array::length(model::model_world.datasets) == 151 && array::length(
            model::model_world.entities
        ) == 129 && world::self_check(model::model_world)
    }
);
