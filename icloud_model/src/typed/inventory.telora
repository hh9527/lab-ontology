use super::site as site;
use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 首批独立声明：Tenant 与 EntNetworkElement，保留现有 transform 名称和源编码。
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;

type TenantId = struct(String);
type DeviceId = struct(String);
type SiteId = struct(String);
@registry::entity("tenant_entity")
type TenantIdentity = struct {
    id: TenantId
};
@registry::entity("device_entity")
type DeviceIdentity = struct {
    id: DeviceId
};
@knowledge_policy::reverse_references(True)
type DeviceClass = enum {
    @ev::rename("ne.category.ac")
    @ev::alias("AC")
    @ev::alias("WAC")
    Wac,
    @ev::rename("ne.category.switch")
    @ev::alias("LSW")
    Lsw,
    @ev::rename("ne.category.router")
    @ev::alias("AR")
    Router,
    @ev::rename("ne.category.firewall")
    @ev::alias("FW")
    Firewall,
    @ev::rename("ne.category.fatap")
    @ev::alias("AP")
    Ap,
    @ev::rename("TianGuan")
    Tianguan,
    @ev::rename("ne.category.printer")
    @ev::alias("printer")
    Printer,
    @ev::rename("ne.category.ups")
    @ev::alias("ups")
    Ups,
    @ev::rename("ne.category.lb")
    @ev::alias("lb")
    Lb,
    @ev::rename("ne.category.unknown")
    Others,
};
@knowledge_policy::reverse_references(True)
type DeviceCommuState = enum {
    @ev::rename("0")
    @ev::alias("online")
    Online,
    @ev::rename("1")
    @ev::alias("offline")
    Offline,
    @ev::rename("other")
    Other,
};

@edsl::reference("id", ["id"])
@registry::dataset("device", "I_EntNetworkElement", ["id"])
@registry::roles([device_subject, device_tenant, site::project, site::subnet])
@registry::groups(
    [
        g::dimension(
            devices,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(IEntNetworkElement.type, String.type, "ip_address"))),
            "device_ip_address_ipv4",
            True,
            g::ipv4_filters
        ),
    ]
)
@registry::record_counts(["device_count"])
type IEntNetworkElement = struct {
    @edsl::field_role(edsl::FieldRole::Appellation)
    @g::search("device_alias")
    alias: String,
    @edsl::field_role(edsl::FieldRole::Classification)
    @v::classification(classes, "device_class")
    classification: String,
    @m::column("commuState")
    @v::classification(communication, "device_commu_state")
    commu_state: String,
    @g::exact("device_id")
    id: DeviceId,
    @m::column("tenantId")
    @g::exact("device_tenant_id")
    tenant_id: TenantId,
    @m::column("projectId")
    project_id: SiteId,
    @m::column("refParentSubnet")
    ref_parent_subnet: SiteId,
    @edsl::field_role(edsl::FieldRole::Appellation)
    @g::search("device_name")
    name: String,
    # 沿用现有 Local 毫秒假定，未在本次迁移中确认生产时钟单位。
    @m::column("createTime")
    @g::epoch_millis("device_create_ms")
    create_time: s::EpochMillis,
    @g::search("device_mac")
    mac: String,
    @m::column("ipAddress")
    @g::search("device_ip_address")
    ip_address: String,
    @edsl::field_role(edsl::FieldRole::Classification)
    @g::search("device_manufacturer")
    manufacturer: String,
    @m::column("location")
    @g::search("device__location")
    source_location: String,
    @m::column("typeId")
    @g::exact("device__typeId")
    source_typeId: String,
    @m::column("version")
    @g::search("device__version")
    source_version: String,
    @m::column("timeZone")
    @g::exact("device__timeZone")
    source_timeZone: String,
    @m::column("sn")
    @g::search("device__sn")
    source_sn: String,
    @m::column("productName")
    @g::search("device__productName")
    source_productName: String,
    @m::column("language")
    @g::exact("device__language")
    source_language: String,
    @m::column("remark")
    @g::search("device__remark")
    source_remark: String,
    @m::column("neOsVersion")
    @g::search("device__neOsVersion")
    source_neOsVersion: String,
    @m::column("nePatchVersion")
    @g::search("device__nePatchVersion")
    source_nePatchVersion: String,
};

@registry::dataset("tenant", "X_TENANT_VIEW", ["id"])
@registry::roles([tenant_subject])
@registry::record_counts(["tenant_count"])
@registry::relations(relations)
type XTenantView = struct {
    @m::column("TENANT_ID")
    @g::exact("tenant_id")
    id: TenantId,
    @m::column("TENANT_NAME")
    @g::search("tenant_name")
    name: String,
    @m::column("INDUSTRY")
    @g::exact("tenant_industry")
    industry: String,
    # 沿用现有 Local 毫秒假定，不从整数编码推断 UTC。
    @m::column("TENANT_ACCESS_TIME")
    @g::epoch_millis("tenant_access_ms")
    access_time: s::EpochMillis,
};

def tenant: m::Entity(TenantIdentity) = registry::entity_of(TenantIdentity.type);
def device: m::Entity(DeviceIdentity) = registry::entity_of(DeviceIdentity.type);
def tenants: m::Dataset(XTenantView) = registry::dataset_of(XTenantView.type);
def devices: m::Dataset(IEntNetworkElement) = registry::dataset_of(IEntNetworkElement.type);
def tenant_subject: m::Role(XTenantView) = m::role(
    tenants,
    tenant,
    "subject",
    False,
    [
        m::identity_part(
            m::field(XTenantView.type, TenantId.type, "id"),
            m::field(TenantIdentity.type, TenantId.type, "id")
        )
    ]
);
def device_subject: m::Role(IEntNetworkElement) = m::role(
    devices,
    device,
    "subject",
    False,
    [
        m::identity_part(
            m::field(IEntNetworkElement.type, DeviceId.type, "id"),
            m::field(DeviceIdentity.type, DeviceId.type, "id")
        )
    ]
);
def device_tenant: m::Role(IEntNetworkElement) = m::role(
    devices,
    tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(IEntNetworkElement.type, TenantId.type, "tenant_id"),
            m::field(TenantIdentity.type, TenantId.type, "id")
        )
    ]
);
pub def classes: v::Domain(DeviceClass, String) = v::from_enum(
    "DeviceClass",
    DeviceClass.type,
    String.type,
    True
);
def communication: v::Domain(DeviceCommuState, String) = v::from_enum(
    "DeviceCommuState",
    DeviceCommuState.type,
    String.type,
    False
);

def relations: Array(r::Relation) = [
    r::relation(
        "device_belongs_to_tenant",
        r::endpoint(devices.row, device_tenant.id),
        r::endpoint(tenants.row, tenant_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntNetworkElement_X_TENANT_VIEW",
        r::endpoint(devices.row, device_tenant.id),
        r::endpoint(tenants.row, tenant_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{
    IEntNetworkElement,
    XTenantView,
    TenantId,
    DeviceId,
    DeviceIdentity,
    TenantIdentity,
    devices,
    tenants,
    device,
    tenant,
    device_subject,
    tenant_subject,
    device_tenant,
    relations,
    SiteId
};
