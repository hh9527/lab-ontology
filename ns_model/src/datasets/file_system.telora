    @v::map(domains::FsHealthStatus.type, "fs_health_status", [v::member(domains::FsHealthStatus::Unknown, ["0"]), v::member(domains::FsHealthStatus::Normal, ["1"]), v::member(domains::FsHealthStatus::Failure, ["2"]), v::member(domains::FsHealthStatus::Downgrade, ["5"])])
    health_status: Option(String),
    @m::column("runningStatus")
    @g::field_view(g::dimension_group("file-system/running_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "fs_running_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::FsRunningStatus.type, "fs_running_status", [v::member(domains::FsRunningStatus::PreCopy, ["14"]), v::member(domains::FsRunningStatus::Reconstruction, ["16"]), v::member(domains::FsRunningStatus::Online, ["27"]), v::member(domains::FsRunningStatus::Offline, ["28"]), v::member(domains::FsRunningStatus::Balancing, ["32"]), v::member(domains::FsRunningStatus::Initializing, ["53"]), v::member(domains::FsRunningStatus::Deleting, ["106"])])
    running_status: Option(String),
    @m::column("latestIoTime")
    @g::field_view(g::dimension_group("file-system/latest_io_time", Int.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "fs_latest_io_time_ms", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    latest_io_time: Option(Int),
