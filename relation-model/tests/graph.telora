        "exists":[{"anchor":"site","nodes":[{"id":"other","entity":"device"}],
            "edges":[{"relation":"device_site","from":"other","to":"site"}],
            "filters":[{"node":"other","dimension":"device_id","op":"eq","kind":"text","value":"device-1"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "LEFT JOIN sites AS site ON (site.tenant_id = tenant.id AND EXISTS (")
        && string::contains(sq.sql, "LEFT JOIN devices AS device ON")
        && string::contains(pg.sql, "LEFT JOIN \"sites\" AS \"site\" ON (")
        && string::contains(pg.sql, "LEFT JOIN \"devices\" AS \"device\" ON")
        && sq.bindings == [qb::Val::String("device-1")]
        && pg.bindings == sq.bindings {
        True
    } else { fail!("nullable ancestor existence must narrow the counted instance lineage", sq, pg) }
});

pub def empty_group_count_rejects_sibling_existence: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"tenant", "include_empty":true,
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"},{"id":"site","entity":"site"}],
        "edges":[{"relation":"device_tenant","from":"device","to":"tenant"},
                 {"relation":"site_tenant","from":"site","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"device",
        "exists":[{"anchor":"site","nodes":[{"id":"other","entity":"device"}],
            "edges":[{"relation":"device_site","from":"other","to":"site"}]}]
    }"#).unwrap!())
}, "unsupported graph include_empty existence outside counted instance lineage");

pub def empty_group_peer_count_reports_unsupported: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d", "include_empty":true,
        "nodes":[{"id":"d","entity":"device"},{"id":"peer","entity":"device"}],
        "edges":[{"relation":"connected_device","from":"d","to":"peer"}],
        "select":[{"node":"d","dimension":"device_id"}], "count":"peer"
    }"#).unwrap!())
}, "unsupported graph include_empty: business link connected_device between d and peer needs outer-join counting semantics for peer; do not replace it with EXISTS when zero-match groups or peer counts matter");

pub def empty_group_count_negated_exists_keeps_bound_filter_in_on: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"tenant", "include_empty":true,
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"device",
        "exists":[{"anchor":"device","negated":true,"nodes":[{"id":"site","entity":"site"}],
            "edges":[{"relation":"device_site","from":"device","to":"site"}],
            "filters":[{"node":"site","dimension":"site_id","op":"eq","kind":"text","value":"site-1"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "LEFT JOIN devices AS device ON (device.tenant_id = tenant.id AND NOT EXISTS (")
        && string::contains(pg.sql, "AND NOT EXISTS (")
        && string::contains(sq.sql, "site.id = ?1")
        && string::contains(pg.sql, "\"site\".\"id\" = $1")
        && sq.bindings == [qb::Val::String("site-1")]
        && pg.bindings == sq.bindings {
        True
    } else { fail!("negated nullable existence must stay in ON with its allocated binding", sq, pg) }
});

pub def empty_group_count_rejects_undeclared_existence_edge: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"tenant", "include_empty":true,
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"device",
        "exists":[{"anchor":"device","nodes":[{"id":"site","entity":"site"}],
            "edges":[{"relation":"unknown_site","from":"device","to":"site"}]}]
    }"#).unwrap!())
}, "unknown named relation");

pub def empty_group_requires_nonroot_count: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"tenant", "include_empty":true,
        "nodes":[{"id":"tenant","entity":"tenant"}], "edges":[],
        "select":[], "count":"tenant"
    }"#).unwrap!())
}, "graph include_empty requires a non-root count subject");

pub def count_rejects_tenant_sibling_as_site_child: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"site",
        "nodes":[{"id":"site","entity":"site"},{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"site_tenant","from":"site","to":"tenant"},
                 {"relation":"device_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"site","dimension":"site_id"}], "count":"device"
    }"#).unwrap!())
}, "relation site_tenant between site and tenant may multiply device; if this edge only filters rows, use correlated EXISTS");

pub def grouped_count_projects_nonroot_site_on_proven_child_grain: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"tenant", "include_empty":true,
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"site","entity":"site"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"site_tenant","from":"site","to":"tenant"},
                 {"relation":"device_site","from":"device","to":"site"}],
        "select":[{"node":"tenant","dimension":"tenant_id"},
                  {"node":"site","dimension":"site_id"}], "count":"device"
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "site.id AS site_site_id")
        && string::contains(sq.sql, "count(device.id)")
        && string::contains(sq.sql, "GROUP BY tenant.id, site.id")
        && string::contains(sq.sql, "LEFT JOIN sites AS site")
        && string::contains(sq.sql, "LEFT JOIN devices AS device")
        && string::contains(pg.sql, "GROUP BY \"tenant\".\"id\", \"site\".\"id\"") {
        True
    } else { fail!("grouped child count lost site identity or zero groups", sq, pg) }
});

pub def root_device_count_groups_by_declared_safe_site: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"site","entity":"site"}],
        "edges":[{"relation":"device_site","from":"device","to":"site"}],
        "select":[{"node":"site","dimension":"site_id"}], "count":"device"
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "count(device.id)")
        && string::contains(sq.sql, "GROUP BY site.id")
        && string::contains(sq.sql, "device.tenant_id = site.tenant_id")
        && string::contains(pg.sql, "GROUP BY \"site\".\"id\"") {
        True
    } else { fail!("safe ancestor dimension did not group root device count", sq, pg) }
});

# Two owners can display the same id while differing by tenant. A request for
# per-owner counts must group on the entire declared identity, even when it
# displays only the shared id.
pub def owner_count_keeps_hidden_composite_identity: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[{"node":"device","dimension":"device_id"}],
        "count":"device", "group_by_identity":["device"]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "GROUP BY device.id, device.tenant_id")
        && string::contains(pg.sql, "GROUP BY \"device\".\"id\", \"device\".\"tenant_id\"")
        && !string::contains(sq.sql, "tenant_id AS") {
        True
    } else { fail!("per-owner count merged composite identities", sq, pg) }
});

pub def owner_count_rejects_unrelated_identity: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device", "group_by_identity":["tenant"]
    }"#).unwrap!())
}, "graph group identity references an unknown node");

pub def grouped_count_rejects_nonfunctional_peer_branch: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"tenant",
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"},
                 {"id":"link","entity":"connection"}],
