            v::member(classes::AlarmResourceType::ServerRack, ["ne.category.server.rack"]),
            v::member(classes::AlarmResourceType::ServerTaishan, ["ne.category.server.taishan"]),
            v::member(
                classes::AlarmResourceType::ServerHeterogeneous,
