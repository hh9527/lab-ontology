use super::classifications as classes;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储组件来源：parent 使用存储设备身份；原始文本不按单位说明隐式解析。
use super::inventory as i;
use super::storage as storage;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("StorageChassis")
type StorageChassisById = struct(ComponentId);
@domain::subject("StorageChassis", "source_id")
@domain::dataset("source_SYS_Chassis", "SYS_Chassis", ["source_id"])
@domain::relations(relations)
type SysChassis = struct {
    @m::column("tenantId")
    @g::exact("source_SYS_Chassis__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("id")
    @g::exact("source_SYS_Chassis__id")
    source_id: StorageChassisById,
    @m::column("projectId")
    @g::exact("source_SYS_Chassis__projectId")
    source_projectId: String,
    @m::column("name")
    @g::search("source_SYS_Chassis__name")
    source_name: String,
    @m::column("oriResId")
    @g::exact("source_SYS_Chassis__oriResId")
    source_oriResId: String,
    @m::column("parentResId")
    @g::exact("source_SYS_Chassis__parentResId")
    source_parentResId: domain::Reference(storage::StorageById),
    @m::column("curSupplyMode")
    @g::exact("source_SYS_Chassis__curSupplyMode_raw")
    @v::map_or(
        classes::PowerSupplyMode.type,
        "source_SYS_Chassis__curSupplyMode",
        [
            v::member(classes::PowerSupplyMode::Dual, ["双路供电"]),
            v::member(classes::PowerSupplyMode::Single, ["单路供电"])
        ],
        classes::PowerSupplyMode::Unknown
    )
    source_curSupplyMode: String,
    @m::column("systemSupplyMode")
    @g::exact("source_SYS_Chassis__systemSupplyMode_raw")
    @v::map_or(
        classes::PowerSupplyMode.type,
        "source_SYS_Chassis__systemSupplyMode",
        [
            v::member(classes::PowerSupplyMode::Dual, ["双路供电"]),
            v::member(classes::PowerSupplyMode::Single, ["单路供电"])
        ],
        classes::PowerSupplyMode::Unknown
    )
    source_systemSupplyMode: String,
    @m::column("macAddress")
    @g::search("source_SYS_Chassis__macAddress")
    source_macAddress: String,
    @m::column("logicType")
    @g::exact("source_SYS_Chassis__logicType_raw")
    @v::map(
        SourceSYSChassisLogicType.type,
        "source_SYS_Chassis__logicType",
        [
            v::member(SourceSYSChassisLogicType::CascadingEnclosureDiskEnclosure, ["0"]),
            v::member(SourceSYSChassisLogicType::ControlEnclosure, ["1"]),
            v::member(SourceSYSChassisLogicType::DataSwitch, ["2"]),
            v::member(SourceSYSChassisLogicType::ManagementSwitch, ["3"]),
            v::member(SourceSYSChassisLogicType::ManagementServer, ["4"])
        ]
    )
    source_logicType: String,
    @m::column("height")
    @g::exact("source_SYS_Chassis__height")
    source_height: String,
    @m::column("model")
    @g::search("source_SYS_Chassis__model")
    source_model: String,
    @m::column("wwn")
    @g::search("source_SYS_Chassis__wwn")
    source_wwn: String,
    @m::column("temperature")
    @g::exact("source_SYS_Chassis__temperature")
    source_temperature: String,
    @m::column("boardType")
    @g::exact("source_SYS_Chassis__boardType_raw")
    @v::map_or(
        classes::BoardKind.type,
        "source_SYS_Chassis__boardType",
        [
            v::member(classes::BoardKind::Control, ["控制板"]),
            v::member(classes::BoardKind::Interface, ["接口板"]),
            v::member(classes::BoardKind::Expansion, ["扩展板"])
        ],
        classes::BoardKind::Unknown
    )
    source_boardType: String,
    @m::column("slot")
    @g::exact("source_SYS_Chassis__slot")
    source_slot: String,
    @m::column("chassisId")
    @g::exact("source_SYS_Chassis__chassisId")
    source_chassisId: String,
    @m::column("sn")
    @g::search("source_SYS_Chassis__sn")
    source_sn: String,
    @m::column("healthStatus")
    @g::exact("source_SYS_Chassis__healthStatus_raw")
    @v::map(
        SourceSYSChassisHealthStatus.type,
        "source_SYS_Chassis__healthStatus",
        [
            v::member(SourceSYSChassisHealthStatus::Unknown, ["0"]),
            v::member(SourceSYSChassisHealthStatus::Normal, ["1"]),
            v::member(SourceSYSChassisHealthStatus::Faulty, ["2"])
        ]
    )
    source_healthStatus: String,
    @m::column("runningStatus")
    @g::exact("source_SYS_Chassis__runningStatus_raw")
    @v::map(
        SourceSYSChassisRunningStatus.type,
        "source_SYS_Chassis__runningStatus",
        [
            v::member(SourceSYSChassisRunningStatus::Unknown, ["0"]),
            v::member(SourceSYSChassisRunningStatus::Normal, ["1"]),
            v::member(SourceSYSChassisRunningStatus::Running, ["2"]),
            v::member(SourceSYSChassisRunningStatus::HighTemperatureSleep, ["5"]),
            v::member(SourceSYSChassisRunningStatus::Online, ["27"]),
            v::member(SourceSYSChassisRunningStatus::Offline, ["28"])
        ]
    )
    source_runningStatus: String,
};

def subject: r::Endpoint = domain::endpoint(SysChassis.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(SysChassis.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(SysChassis.type, "source_parentResId");

@knowledge_policy::reverse_references(True)
type SourceSYSChassisLogicType = enum {
    @ev::description("Cascading Enclosure (Disk Enclosure)", "级联框（硬盘框）")
    CascadingEnclosureDiskEnclosure,

    @ev::description("Control Enclosure", "控制框")
    ControlEnclosure,

    @ev::description("Data Switch", "数据交换机")
    DataSwitch,

    @ev::description("Management Switch", "管理交换机")
    ManagementSwitch,

    @ev::description("Management Server", "管理服务器")
    ManagementServer,
};

@knowledge_policy::reverse_references(True)
type SourceSYSChassisHealthStatus = enum {
    @ev::description("Unknown", "未知")
    Unknown,

    @ev::description("Normal", "正常")
    Normal,

    @ev::description("Faulty", "故障")
    Faulty,
};

@knowledge_policy::reverse_references(True)
type SourceSYSChassisRunningStatus = enum {
    @ev::description("Unknown", "未知")
    Unknown,

    @ev::description("Normal", "正常")
    Normal,

    @ev::description("Running", "运行")
    Running,

    @ev::description("High Temperature Sleep", "高温休眠")
    HighTemperatureSleep,

    @ev::description("Online", "在线")
    Online,

    @ev::description("Offline", "离线")
    Offline,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceCompositionSYS_Chassis",
        storage::subject,
        parent,
        cardinality
    ),
    r::relation(
        "source_SYS_ChassisAssociationX_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{SysChassis, StorageChassisById};

pub use self::{
    SourceSYSChassisLogicType,
    SourceSYSChassisHealthStatus,
    SourceSYSChassisRunningStatus
};
