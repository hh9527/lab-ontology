# 语义成员完整列出；内部结构和内置类型不列为 World 成员。
use crate::typed_relations as original;
use ontology::experimental::world as world;

def model_world: world::World = {
    revision: "typed-relation-v1",
    types: [
        world::type_entry(original::TenantId.type), world::type_entry(original::SiteId.type), world::type_entry(original::DeviceId.type),
        world::type_entry(original::ConnectionId.type), world::type_entry(original::RouteId.type),
        world::type_entry(original::TenantIdentity.type), world::type_entry(original::SiteIdentity.type), world::type_entry(original::DeviceIdentity.type),
        world::type_entry(original::ConnectionIdentity.type), world::type_entry(original::RouteIdentity.type),
        world::type_entry(original::TenantRow.type), world::type_entry(original::SiteRow.type), world::type_entry(original::DeviceRow.type),
        world::type_entry(original::ConnectionRow.type), world::type_entry(original::RouteRow.type),
    ],
    entities: [world::entity(original::tenant), world::entity(original::site), world::entity(original::device),
        world::entity(original::connection), world::entity(original::route)],
    datasets: original::datasets,
    relations: original::declarations,
    alternatives: original::alternatives,
    links: [original::connected, original::upstream],
    profile: original::profile,
};
pub use self::{model_world};
