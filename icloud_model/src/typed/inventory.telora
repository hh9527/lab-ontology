use ontology::experimental::knowledge_policy as knowledge_policy;
# 首批独立声明：Tenant 与 EntNetworkElement，保留现有 transform 名称和源编码。
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;

type TenantId = struct(String);
type DeviceId = struct(String);
type SiteId = struct(String);
type TenantIdentity = struct { id: TenantId };
type DeviceIdentity = struct { id: DeviceId };
@knowledge_policy::reverse_references(True)
type DeviceClass = struct(String);
@knowledge_policy::reverse_references(True)
type DeviceCommuState = struct(String);

type DeviceRow = struct {
    alias: String,
    classification: String,
    commu_state: String,
    id: DeviceId,
    tenant_id: TenantId,
    project_id: SiteId,
    ref_parent_subnet: SiteId,
    name: String,
    # 沿用现有 Local 毫秒假定，未在本次迁移中确认生产时钟单位。
    create_time: s::EpochMillis,
    mac: String,
    ip_address: String,
    manufacturer: String,
    source_location: String,
    source_typeId: String,
    source_version: String,
    source_timeZone: String,
    source_sn: String,
    source_productName: String,
    source_language: String,
    source_remark: String,
    source_neOsVersion: String,
    source_nePatchVersion: String,
};

type TenantRow = struct {
    id: TenantId,
    name: String,
    industry: String,
    # 沿用现有 Local 毫秒假定，不从整数编码推断 UTC。
    access_time: s::EpochMillis,
};

def tenant: m::Entity(TenantIdentity) = m::entity("tenant_entity", TenantIdentity.type);
def device: m::Entity(DeviceIdentity) = m::entity("device_entity", DeviceIdentity.type);
def tenants: m::Dataset(TenantRow) = m::dataset("tenant", "X_TENANT_VIEW", TenantRow.type, ["id"]);
def devices: m::Dataset(DeviceRow) = m::dataset("device", "I_EntNetworkElement", DeviceRow.type, ["id"]);
def tenant_subject: m::Role(TenantRow) = m::role(tenants, tenant, "subject", False, [m::identity_part(m::field(TenantRow.type, TenantId.type, "id"), m::field(TenantIdentity.type, TenantId.type, "id"))]);
def device_subject: m::Role(DeviceRow) = m::role(devices, device, "subject", False, [m::identity_part(m::field(DeviceRow.type, DeviceId.type, "id"), m::field(DeviceIdentity.type, DeviceId.type, "id"))]);
def device_tenant: m::Role(DeviceRow) = m::role(devices, tenant, "tenant", False, [m::identity_part(m::field(DeviceRow.type, TenantId.type, "tenant_id"), m::field(TenantIdentity.type, TenantId.type, "id"))]);
def exact: for(Row, Value) Fn(m::Dataset(Row), m::Field(Row, Value), String) -> g::Binding(Row) = fn(dataset, field, id) {
    g::dimension(dataset, g::dimension_group("exact", Value.type, True, [g::Filter::Eq]), g::input(field), id, True, [g::Filter::Eq])
};
def search: for(Row) Fn(m::Dataset(Row), m::Field(Row, String), String) -> g::Binding(Row) = fn(dataset, field, id) {
    g::dimension(dataset, g::dimension_group("search", String.type, True, g::text_search_filters), g::input(field), id, True, g::text_search_filters)
};
def epoch_millis: for(Row) Fn(m::Dataset(Row), m::Field(Row, s::EpochMillis), String) -> g::Binding(Row) = fn(dataset, field, id) {
    g::dimension(dataset, g::dimension_group("epoch_millis", s::EpochMillis.type, True, g::time_filters), g::input(field), id, True, g::time_filters)
};
def classes: v::Domain(DeviceClass, String) = v::domain("DeviceClass", DeviceClass.type, String.type, [
    v::member(DeviceClass("WAC"), ["ne.category.ac", "AC", "WAC"]),
    v::member(DeviceClass("LSW"), ["ne.category.switch", "LSW"]),
    v::member(DeviceClass("router"), ["ne.category.router", "AR"]),
    v::member(DeviceClass("firewall"), ["ne.category.firewall", "FW"]),
    v::member(DeviceClass("AP"), ["ne.category.fatap", "AP"]),
    v::member(DeviceClass("tianguan"), ["TianGuan"]),
    v::member(DeviceClass("printer"), ["ne.category.printer", "printer"]),
    v::member(DeviceClass("ups"), ["ne.category.ups", "ups"]),
    v::member(DeviceClass("lb"), ["ne.category.lb", "lb"]),
    v::member(DeviceClass("others"), ["ne.category.unknown"]),
], True);
def communication: v::Domain(DeviceCommuState, String) = v::domain("DeviceCommuState", DeviceCommuState.type, String.type, [
    v::member(DeviceCommuState("online"), ["0", "online"]),
    v::member(DeviceCommuState("offline"), ["1", "offline"]),
    v::member(DeviceCommuState("other"), ["other"]),
], False);

def device_declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(devices, [device_subject, device_tenant], [
    search(devices, m::field(DeviceRow.type, String.type, "alias"), "device_alias"),
    exact(devices, m::field(DeviceRow.type, DeviceId.type, "id"), "device_id"),
    exact(devices, m::field(DeviceRow.type, TenantId.type, "tenant_id"), "device_tenant_id"),
    search(devices, m::field(DeviceRow.type, String.type, "name"), "device_name"),
    epoch_millis(devices, m::field(DeviceRow.type, s::EpochMillis.type, "create_time"), "device_create_ms"),
    search(devices, m::field(DeviceRow.type, String.type, "mac"), "device_mac"),
    search(devices, m::field(DeviceRow.type, String.type, "ip_address"), "device_ip_address"),
    search(devices, m::field(DeviceRow.type, String.type, "manufacturer"), "device_manufacturer"),
    search(devices, m::field(DeviceRow.type, String.type, "source_location"), "device__location"),
    exact(devices, m::field(DeviceRow.type, String.type, "source_typeId"), "device__typeId"),
    search(devices, m::field(DeviceRow.type, String.type, "source_version"), "device__version"),
    exact(devices, m::field(DeviceRow.type, String.type, "source_timeZone"), "device__timeZone"),
    search(devices, m::field(DeviceRow.type, String.type, "source_sn"), "device__sn"),
    search(devices, m::field(DeviceRow.type, String.type, "source_productName"), "device__productName"),
    exact(devices, m::field(DeviceRow.type, String.type, "source_language"), "device__language"),
    search(devices, m::field(DeviceRow.type, String.type, "source_remark"), "device__remark"),
    search(devices, m::field(DeviceRow.type, String.type, "source_neOsVersion"), "device__neOsVersion"),
    search(devices, m::field(DeviceRow.type, String.type, "source_nePatchVersion"), "device__nePatchVersion"),
    g::dimension(devices, g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters), g::ipv4(g::input(m::field(DeviceRow.type, String.type, "ip_address"))), "device_ip_address_ipv4", True, g::ipv4_filters),
], ["device_count"]), [
    t::column(m::field(DeviceRow.type, String.type, "alias"), "alias"),
    t::column(m::field(DeviceRow.type, String.type, "classification"), "classification"),
    t::column(m::field(DeviceRow.type, String.type, "commu_state"), "commuState"),
    t::column(m::field(DeviceRow.type, DeviceId.type, "id"), "id"),
    t::column(m::field(DeviceRow.type, TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::field(DeviceRow.type, SiteId.type, "project_id"), "projectId"),
    t::column(m::field(DeviceRow.type, SiteId.type, "ref_parent_subnet"), "refParentSubnet"),
    t::column(m::field(DeviceRow.type, String.type, "name"), "name"),
    t::column(m::field(DeviceRow.type, s::EpochMillis.type, "create_time"), "createTime"),
    t::column(m::field(DeviceRow.type, String.type, "mac"), "mac"),
    t::column(m::field(DeviceRow.type, String.type, "ip_address"), "ipAddress"),
    t::column(m::field(DeviceRow.type, String.type, "manufacturer"), "manufacturer"),
    t::column(m::field(DeviceRow.type, String.type, "source_location"), "location"),
    t::column(m::field(DeviceRow.type, String.type, "source_typeId"), "typeId"),
    t::column(m::field(DeviceRow.type, String.type, "source_version"), "version"),
    t::column(m::field(DeviceRow.type, String.type, "source_timeZone"), "timeZone"),
    t::column(m::field(DeviceRow.type, String.type, "source_sn"), "sn"),
    t::column(m::field(DeviceRow.type, String.type, "source_productName"), "productName"),
    t::column(m::field(DeviceRow.type, String.type, "source_language"), "language"),
    t::column(m::field(DeviceRow.type, String.type, "source_remark"), "remark"),
    t::column(m::field(DeviceRow.type, String.type, "source_neOsVersion"), "neOsVersion"),
    t::column(m::field(DeviceRow.type, String.type, "source_nePatchVersion"), "nePatchVersion"),
]), [
    v::bind(devices, v::dimension_group(classes, True, g::equality_filters), g::input(m::field(DeviceRow.type, String.type, "classification")), "device_class", True, g::equality_filters),
    v::bind(devices, v::dimension_group(communication, True, g::equality_filters), g::input(m::field(DeviceRow.type, String.type, "commu_state")), "device_commu_state", True, g::equality_filters),
]);

def tenant_declaration: t::Declaration = t::map_columns(t::declare(tenants, [tenant_subject], [
    exact(tenants, m::field(TenantRow.type, TenantId.type, "id"), "tenant_id"),
    search(tenants, m::field(TenantRow.type, String.type, "name"), "tenant_name"),
    exact(tenants, m::field(TenantRow.type, String.type, "industry"), "tenant_industry"),
    epoch_millis(tenants, m::field(TenantRow.type, s::EpochMillis.type, "access_time"), "tenant_access_ms"),
], ["tenant_count"]), [
    t::column(m::field(TenantRow.type, TenantId.type, "id"), "TENANT_ID"),
    t::column(m::field(TenantRow.type, String.type, "name"), "TENANT_NAME"),
    t::column(m::field(TenantRow.type, String.type, "industry"), "INDUSTRY"),
    t::column(m::field(TenantRow.type, s::EpochMillis.type, "access_time"), "TENANT_ACCESS_TIME"),
]);

def relations: Array(r::Relation) = [
    r::relation("device_belongs_to_tenant", devices, device_tenant, tenants, tenant_subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("source_EntNetworkElement_X_TENANT_VIEW", devices, device_tenant, tenants, tenant_subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
pub use self::{DeviceRow, TenantRow, TenantId, DeviceId, DeviceIdentity, TenantIdentity,
    devices, tenants, device, tenant, device_subject, tenant_subject, device_tenant,
    device_declaration, tenant_declaration, relations, exact, search, SiteId};
