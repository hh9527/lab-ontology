# Property 只为 trait 实现提供证据；调用方依赖建模能力，不做开放属性查询。
use std::type_property as props;
use ontology::ontology as edsl;
use ontology::model as m;
use ontology::groups as g;
use ontology::transform as t;

trait EntityModel {
    id: Fn() -> String,
};
impl(T: Property(edsl::EntityId)) EntityModel for T {
    id: fn() {
        props::required@[edsl::EntityId, T]().id
    },
};

type DatasetInfo = struct {
    id: String,
    source: String,
    grain: Array(String),
    kind: edsl::DatasetKind,
    clock: Option(String),
};
trait DatasetModel {
    describe: Fn() -> DatasetInfo,
};
impl(T: Property(edsl::EntityId) + Property(edsl::EntitySource) + ?Property(edsl::DatasetSpec)) DatasetModel for T {
    describe: fn() {
        let id = props::required@[edsl::EntityId, T]();
        let source = props::required@[edsl::EntitySource, T]();
        let spec = match props::optional@[edsl::DatasetSpec, T]() {
            Some(value) => value,
            None => {kind: edsl::DatasetKind::Entity, grain: [], utc_time: None}.ty!(
                edsl::DatasetSpec
            ),
        };
        {id: id.id, source: source.table, grain: spec.grain, kind: spec.kind, clock: spec.utc_time}.ty!(
            DatasetInfo
        )
    },
};

def entity: for(Identity: EntityModel) Fn(TypeOf(Identity)) -> m::Entity(Identity) = fn(identity) {
    m::entity(EntityModel(Identity).id(), identity)
};
def dataset: for(Row: DatasetModel) Fn(TypeOf(Row)) -> m::Dataset(Row) = fn(row) {
    let info = DatasetModel(Row).describe();
    m::dataset(info.id, info.source, row, info.grain)
};
# 不做模型自检；保留数据集种类与时钟，供原有 transform 准备阶段消费。
def declare: for(Row: DatasetModel) Fn(
    TypeOf(Row),
    Array(m::Role(Row)),
    Array(g::Binding(Row)),
    Array(String)
) -> t::Declaration = fn(row, roles, groups, counts) {
    let info = DatasetModel(Row).describe();
    let model = m::dataset(info.id, info.source, row, info.grain);
    t::declare(model, roles, groups, counts) <~ {kind: info.kind, clock: info.clock}
};

pub use self::{EntityModel, DatasetModel, DatasetInfo, entity, dataset, declare};
