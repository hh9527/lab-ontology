use ontology::quantity as statistic_quantity;
use ontology::quantity as q;
use ontology::semantic as domain;
# 采样身份由资源 ID 与 UTC 采集时间组成，实体关系不代替采样 grain。
use super::inventory as i;
use super::pon_device as pon;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
@domain::entity_by("PonEthernetPort")
type PonEthernetPortById = struct(String);
use ontology::quantity::{EffectiveCount};
type RxOpticalPower = struct(q::Dbm);
type TxOpticalPower = struct(q::Dbm);
type ReceivedOctets = struct(q::Bytes);
type TransmittedOctets = struct(q::Bytes);
type ReceiveUtilization = struct(q::Percent);
type TransmitUtilization = struct(q::Percent);
@domain::bind(PonEthernetPortById.type, "source_resId")
@domain::dataset(
    "source_PonDeviceEthernetPortKPI",
    "PonDeviceEthernetPortKPI",
    ["source_resId", "source_ts"]
)
@domain::metric("source_ts")
@domain::relations(relations)
type PonDeviceEthernetPortKPI = struct {
    @m::column("ts")
    @g::view("source_PonDeviceEthernetPortKPI__ts", True, g::numeric_filters)
    @g::utc_bucket_view("source_PonDeviceEthernetPortKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_PonDeviceEthernetPortKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_PonDeviceEthernetPortKPI_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("pon_ethernet_sample_count")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_PonDeviceEthernetPortKPI__resId")
    source_resId: PonEthernetPortById,
    @m::column("tenantId")
    @g::exact("source_PonDeviceEthernetPortKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_PonDeviceEthernetPortKPI__parentId")
    @domain::attribute("source_parentId")
    source_parentId: domain::Reference(pon::PonElementById),
    @m::column("projectId")
    @g::exact("source_PonDeviceEthernetPortKPI__projectId")
    source_projectId: String,
    @m::column("portName")
    @g::search("source_PonDeviceEthernetPortKPI__portName")
    @domain::attribute("source_portName")
    source_portName: String,
    @m::column("hwOpticsRxPower")
    @g::view("source_PonDeviceEthernetPortKPI__hwOpticsRxPower", True, g::numeric_filters)
    @samples::valid_count("source_hwOpticsRxPowerEffcnt")
    source_hwOpticsRxPower: RxOpticalPower,
    @m::column("hwOpticsTxPower")
    @g::view("source_PonDeviceEthernetPortKPI__hwOpticsTxPower", True, g::numeric_filters)
    @samples::valid_count("source_hwOpticsTxPowerEffcnt")
    source_hwOpticsTxPower: TxOpticalPower,
    @m::column("ifHCInOctets")
    @g::view("source_PonDeviceEthernetPortKPI__ifHCInOctets", True, g::numeric_filters)
    @samples::valid_count("source_ifHCInOctetsEffcnt")
    source_ifHCInOctets: ReceivedOctets,
    @m::column("ifHCOutOctets")
    @g::view("source_PonDeviceEthernetPortKPI__ifHCOutOctets", True, g::numeric_filters)
    @samples::valid_count("source_ifHCOutOctetsEffcnt")
    source_ifHCOutOctets: TransmittedOctets,
    @m::column("ifInBandRate")
    @g::view("source_PonDeviceEthernetPortKPI__ifInBandRate", True, g::numeric_filters)
    @samples::valid_count("source_ifInBandRateEffcnt")
    source_ifInBandRate: ReceiveUtilization,
    @m::column("ifOutBandRate")
    @g::view("source_PonDeviceEthernetPortKPI__ifOutBandRate", True, g::numeric_filters)
    @samples::valid_count("source_ifOutBandRateEffcnt")
    source_ifOutBandRate: TransmitUtilization,
    @m::column("hwOpticsRxPowerEffcnt")
    @g::view("source_PonDeviceEthernetPortKPI__hwOpticsRxPowerEffcnt", True, g::numeric_filters)
    source_hwOpticsRxPowerEffcnt: EffectiveCount,
    @m::column("hwOpticsTxPowerEffcnt")
    @g::view("source_PonDeviceEthernetPortKPI__hwOpticsTxPowerEffcnt", True, g::numeric_filters)
    source_hwOpticsTxPowerEffcnt: EffectiveCount,
    @m::column("ifHCInOctetsEffcnt")
    @g::view("source_PonDeviceEthernetPortKPI__ifHCInOctetsEffcnt", True, g::numeric_filters)
    source_ifHCInOctetsEffcnt: EffectiveCount,
    @m::column("ifHCOutOctetsEffcnt")
    @g::view("source_PonDeviceEthernetPortKPI__ifHCOutOctetsEffcnt", True, g::numeric_filters)
    source_ifHCOutOctetsEffcnt: EffectiveCount,
    @m::column("ifInBandRateEffcnt")
    @g::view("source_PonDeviceEthernetPortKPI__ifInBandRateEffcnt", True, g::numeric_filters)
    source_ifInBandRateEffcnt: EffectiveCount,
    @m::column("ifOutBandRateEffcnt")
    @g::view("source_PonDeviceEthernetPortKPI__ifOutBandRateEffcnt", True, g::numeric_filters)
    source_ifOutBandRateEffcnt: EffectiveCount,
};
def owner: r::Endpoint = domain::endpoint(PonDeviceEthernetPortKPI.type, "source_parentId");

def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElementAssociationPonDeviceEthernetPortKPI",
        pon::subject,
        owner,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{PonDeviceEthernetPortKPI};
