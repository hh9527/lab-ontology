def having_rejects_unknown_or_unprojected_measure = fn() {
    !qb.structure_ok(having_unknown_measure_plan())
};

# ---------------------------------------------------------------------------
# P0: case normalization (`Lower`) and Instr/Substr case semantics.
#
# `Instr`/`Substr` are case-sensitive (SQLite default); the closed way to get
# case-insensitive starts-with / contains / not-contains / ends-with is to
# apply `Lower` to both sides.  `Length` gives the suffix arithmetic used by
# ends-with.  In the default SQLite build `lower` folds ASCII A-Z only.
# ---------------------------------------------------------------------------

def lower_probe_plan: Fn(qb.Expr) -> qb.Plan = fn(probe) {
    let plan: qb.Plan = {
        revision: "test-lower-probe",
        sources: [qb.source("c", "commands")],
        projection: [qb.expr_item(probe)],
        filter: None,
        exists: [],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def lower_filter_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-lower-filter",
        sources: [qb.source("c", "commands")],
        projection: [
            qb.expr_item(qb.column("c", "id")),
            qb.expr_item(qb.lower(qb.column("c", "name"))),
        ],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [
            qb.lower(qb.column("c", "name")),
            qb.bind_string("run"),
        ])),
        exists: [],
        joins: [],
        grouping: [],
        having: [],
        ordering: [qb.asc(qb.lower(qb.column("c", "name")))],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def lower_renders_closed_case_normalization = fn() {
    let q = qb.transform_sqlite(lower_filter_plan());
    let expected: Array(qb.Val) = [qb.Val.String("run")];
    q.sql == "SELECT c.id, lower(c.name) FROM commands AS c WHERE lower(c.name) = ? ORDER BY lower(c.name) ASC"
        && q.bindings == expected
};

def ci_contains_plan: Fn() -> qb.Plan = fn() {
    let hay = qb.lower(qb.column("c", "command"));
    let needle = qb.lower(qb.bind_string("run"));
    let contains: qb.Expr = qb.scalar(qb.ScalarFunction.Gt, [qb.instr(hay, needle), qb.bind_int(0)]);
    let plan: qb.Plan = {
        revision: "test-ci-contains",
        sources: [qb.source("c", "commands")],
        projection: [qb.expr_item(qb.column("c", "id"))],
        filter: Some(contains),
        exists: [],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def case_insensitive_contains_normalizes_both_sides = fn() {
    let q = qb.transform_sqlite(ci_contains_plan());
    let expected: Array(qb.Val) = [qb.Val.String("run"), qb.Val.Int(0)];
    q.sql == "SELECT c.id FROM commands AS c WHERE instr(lower(c.command), lower(?)) > ?"
        && q.bindings == expected
};

def ci_starts_with_plan: Fn() -> qb.Plan = fn() {
    let starts: qb.Expr = qb.scalar(qb.ScalarFunction.Eq, [
        qb.instr(
            qb.lower(qb.column("c", "command")),
            qb.lower(qb.bind_string("run")),
        ),
        qb.bind_int(1),
    ]);
    let plan: qb.Plan = {
        revision: "test-ci-starts-with",
        sources: [qb.source("c", "commands")],
        projection: [qb.expr_item(qb.column("c", "id"))],
        filter: Some(starts),
        exists: [],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def case_insensitive_starts_with_is_position_one = fn() {
    let q = qb.transform_sqlite(ci_starts_with_plan());
    let expected: Array(qb.Val) = [qb.Val.String("run"), qb.Val.Int(1)];
    q.sql == "SELECT c.id FROM commands AS c WHERE instr(lower(c.command), lower(?)) = ?"
        && q.bindings == expected
};

def ci_ends_with_plan: Fn() -> qb.Plan = fn() {
    let hay = qb.lower(qb.column("c", "command"));
    let needle = qb.lower(qb.bind_string("run"));
    # suffix start = length(hay) - length(needle) + 1
    let suffix_start: qb.Expr = qb.sub(
        qb.length(hay),
        qb.sub(qb.length(needle), qb.bind_int(1)),
    );
    let suffix: qb.Expr = qb.substr([hay, suffix_start]);
    let pred: qb.Expr = qb.scalar(qb.ScalarFunction.Eq, [suffix, needle]);
    let plan: qb.Plan = {
        revision: "test-ci-ends-with",
        sources: [qb.source("c", "commands")],
        projection: [qb.expr_item(qb.column("c", "id"))],
        filter: Some(pred),
        exists: [],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def case_insensitive_ends_with_uses_length_arithmetic = fn() {
    let q = qb.transform_sqlite(ci_ends_with_plan());
    let expected: Array(qb.Val) = [qb.Val.String("run"), qb.Val.Int(1), qb.Val.String("run")];
    q.sql == "SELECT c.id FROM commands AS c WHERE substr(lower(c.command), (length(lower(c.command)) - (length(lower(?)) - ?))) = lower(?)"
        && q.bindings == expected
        && (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
};

def case_sensitive_instr_not_contains_is_zero = fn() {
    let pred: qb.Expr = qb.scalar(qb.ScalarFunction.Eq, [
        qb.instr(qb.column("c", "command"), qb.bind_string("run")),
        qb.bind_int(0),
    ]);
    let q = qb.transform_sqlite(lower_probe_plan(pred));
    let expected: Array(qb.Val) = [qb.Val.String("run"), qb.Val.Int(0)];
    q.sql == "SELECT instr(c.command, ?) = ? FROM commands AS c"
        && q.bindings == expected
};

def lower_rejects_wrong_arity = fn() {
    !qb.structure_ok(lower_probe_plan(qb.scalar(qb.ScalarFunction.Lower, [
        qb.column("c", "command"),
        qb.column("c", "id"),
    ])))
};

def length_rejects_wrong_arity = fn() {
    !qb.structure_ok(lower_probe_plan(qb.scalar(qb.ScalarFunction.Length, [])))
};

def lower_requires_profile_scalar = fn() {
    let no_lower: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Filter, qb.Operator.Order],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Substr, qb.ScalarFunction.Instr, qb.ScalarFunction.Eq],
        allow_distinct: True,
    };
    !qb.profile_accepts(lower_filter_plan(), no_lower)
        && qb.profile_accepts(lower_filter_plan(), full_profile())
};

# ---------------------------------------------------------------------------
# P0: correlated EXISTS (base-grain preserving semi-join filter).
# ---------------------------------------------------------------------------

def exists_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-exists",
        sources: [qb.source("d", "devices")],
        projection: [qb.expr_item(qb.column("d", "id"))],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("d", "kind"), qb.bind_string("sensor")])),
        exists: [qb.exists(
            qb.source("a", "alerts"),
            [qb.column_eq(qb.column_ref("d", "id"), qb.column_ref("a", "device_id"))],
            None,
        )],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def exists_renders_correlated_semi_join = fn() {
    let q = qb.transform_sqlite(exists_plan());
    let expected: Array(qb.Val) = [qb.Val.String("sensor")];
    q.sql == "SELECT d.id FROM devices AS d WHERE d.kind = ? AND EXISTS (SELECT 1 FROM alerts AS a WHERE d.id = a.device_id)"
        && q.bindings == expected
};

def exists_count_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-exists-count",
        sources: [qb.source("d", "devices")],
        projection: [
            qb.aggregate(qb.AggregateFunction.Count, qb.column("d", "id"), False, "device_count"),
        ],
        filter: None,
        exists: [qb.exists(
            qb.source("a", "alerts"),
            [qb.column_eq(qb.column_ref("d", "id"), qb.column_ref("a", "device_id"))],
            None,
        )],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def exists_keeps_base_grain_no_fan_out_join = fn() {
    # The correlated subquery is only a predicate: no JOIN is emitted, so a
    # COUNT/SUM over the main grain cannot be inflated by related inner rows.
    let q = qb.transform_sqlite(exists_count_plan());
    q.sql == "SELECT count(d.id) AS device_count FROM devices AS d WHERE EXISTS (SELECT 1 FROM alerts AS a WHERE d.id = a.device_id)"
        && !string.contains(q.sql, "JOIN")
};

