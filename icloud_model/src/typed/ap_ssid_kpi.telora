use ontology::quantity as statistic_quantity;
use ontology::semantic as domain;
# SSID 样本独立声明：显式保留连接终端原始样本之和，不解释为去重终端数。
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::quantity as q;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
@domain::entity_by("Ssid")
type SsidById = struct(String);
# 来源字节数保留 Int，不能直接用 Float 表示的通用 Bytes 改变公开类型或精度。
type ByteCount = struct(q::IntegerBytes);
@domain::bind(SsidById.type, "res_id")
@g::groupable(["ap_radio_ssid_kpi__ssidName"])
@domain::dataset("ap_radio_ssid_kpi", "NetworkApRadioSsidKPI", ["res_id", "tenant_id", "ts"])
@domain::metric("ts")
@domain::relations(relations)
@edsl::relation_description(
    "ap_ssid_kpi_of_device",
    "SSID 所属 AP",
    "parentId 关联设备身份，并限制设备分类为无线接入点；不把普通网元统称为 AP"
)
type NetworkApRadioSsidKPI = struct {
    @m::column("resId")
    @g::exact("ap_ssid_id")
    res_id: SsidById,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @m::column("parentId")
    @domain::attribute("parent_id")
    parent_id: domain::Reference(i::DeviceById),
    @g::view("ap_ssid_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("ap_radio_ssid_kpi_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("ap_radio_ssid_kpi_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("ap_radio_ssid_kpi_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("ap_ssid_sample_count")
    @edsl::field_role(edsl::FieldRole::Classification)
    ts: s::DateTimeUtc,
    @m::column("connectedTerminals")
    @g::view("ap_ssid_connected_terminals_raw", True, g::numeric_filters)
    @samples::field(
        terminal_statistics,
        [
            {statistic: samples::Statistic::Sum, publish: "ap_ssid_connected_terminals"},
            {statistic: samples::Statistic::Mean, publish: "ap_ssid_connected_terminals_sample_avg"}
        ]
    )
    @samples::valid_count("source_connectedTerminalsEffcnt")
    @domain::count("ap_ssid_connected_terminals_sample_avg_observation_count")
    connected_terminals: q::Count,
    @m::column("projectId")
    @g::exact("ap_radio_ssid_kpi__projectId")
    source_projectId: String,
    @m::column("ssidName")
    @g::search("ap_radio_ssid_kpi__ssidName")
    @domain::attribute("source_ssidName")
    @edsl::field_role(edsl::FieldRole::Classification)
    source_ssidName: String,
    @m::column("hwSsidAirportRecvBytes")
    @g::view("ap_radio_ssid_kpi__hwSsidAirportRecvBytes", True, g::numeric_filters)
    @samples::field(
        byte_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_ssid_receive_bytes"},
            {statistic: samples::Statistic::Max, publish: "ap_ssid_receive_bytes_max"},
            {statistic: samples::Statistic::Min, publish: "ap_ssid_receive_bytes_min"}
        ]
    )
    @samples::valid_count("source_hwSsidAirportRecvBytesEffcnt")
    @domain::count("ap_ssid_receive_bytes_observation_count")
    source_hwSsidAirportRecvBytes: ByteCount,
    @m::column("hwSsidAirportTransmitBytes")
    @g::view("ap_radio_ssid_kpi__hwSsidAirportTransmitBytes", True, g::numeric_filters)
    @samples::field(
        byte_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_ssid_transmit_bytes"},
            {statistic: samples::Statistic::Max, publish: "ap_ssid_transmit_bytes_max"},
            {statistic: samples::Statistic::Min, publish: "ap_ssid_transmit_bytes_min"}
        ]
    )
    @samples::valid_count("source_hwSsidAirportTransmitBytesEffcnt")
    @domain::count("ap_ssid_transmit_bytes_observation_count")
    source_hwSsidAirportTransmitBytes: ByteCount,
    @m::column("hwSsidAirportRecvBytesEffcnt")
    @g::view("ap_radio_ssid_kpi__hwSsidAirportRecvBytesEffcnt", True, g::numeric_filters)
    source_hwSsidAirportRecvBytesEffcnt: statistic_quantity::EffectiveCount,
    @m::column("hwSsidAirportTransmitBytesEffcnt")
    @g::view("ap_radio_ssid_kpi__hwSsidAirportTransmitBytesEffcnt", True, g::numeric_filters)
    source_hwSsidAirportTransmitBytesEffcnt: statistic_quantity::EffectiveCount,
    @m::column("connectedTerminalsEffcnt")
    @g::view("ap_radio_ssid_kpi__connectedTerminalsEffcnt", True, g::numeric_filters)
    source_connectedTerminalsEffcnt: statistic_quantity::EffectiveCount,
};
def device: r::Endpoint = domain::endpoint(NetworkApRadioSsidKPI.type, "parent_id");
def terminal_statistics: samples::Group(q::Count) = samples::group(
    "ssid_terminals",
    q::Count.type,
    samples::Statistic::Sum,
    [samples::Statistic::Mean],
    None
);
def byte_statistics: samples::Group(ByteCount) = samples::group(
    "ssid_bytes",
    ByteCount.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("byte")
);
def relations: Array(r::Relation) = [
    r::relation(
        "ap_ssid_kpi_of_device",
        device,
        i::ap_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntNetworkElement_NetworkApRadioSsidKPI",
        i::ap_subject,
        device,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{NetworkApRadioSsidKPI};
