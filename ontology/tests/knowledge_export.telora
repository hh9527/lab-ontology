use crate::ontology as edsl;
use crate::knowledge as knowledge;
use crate::query as qb;
use std::array as array;
use std::codec as codec;
use std::dict as dict;
use std::value::{Value};
use std::test as test;

def visible: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension, owner: "fixture", id: "name/a#%"};
def hidden: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension, owner: "fixture", id: "hidden"};
def logical: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Ty, owner: "", id: "State"};
def member: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Value, owner: "State", id: "Ready"};

@edsl::value_type("State", String.type, [
    {id: "Ready", label: "Ready", wires: [edsl::FilterInput::Text("ready"), edsl::FilterInput::Text("ok")]},
])
@edsl::knowledge_doc(logical, "State documentation")
@edsl::knowledge_doc(member, "Ready documentation")
@edsl::term("ready state", "Ready term", member)
type State = struct {};

@edsl::entity_id("fixture") @edsl::entity_source("fixture", "f")
@edsl::knowledge_doc(visible, "Visible override")
@edsl::knowledge_doc(hidden, "Hidden override")
@edsl::related_to(visible, hidden)
@edsl::related_to(visible, logical)
@edsl::term("visible term", "Visible term documentation", visible)
@edsl::term("hidden term", "Hidden term documentation", hidden)
type Fixture = struct {
    @edsl::column("name") @edsl::key()
    @edsl::dimension("name/a#%", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text]) name: String,
    @edsl::column("state") @edsl::dimension_type(State.type)
    @edsl::dimension("state", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text]) state: String,
    @edsl::column("secret")
    @edsl::dimension("hidden", False, False, [], []) secret: String,
};
def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Filter],
    allowed_join_kinds: [], allowed_aggregates: [], allow_distinct: False,
    allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::If, qb::ScalarFunction::Or],
};
def payload: edsl::PreparedPayload = edsl::build_root("export-fixture", [Fixture.type], profile);

def points: Array(knowledge::Point) = knowledge::export_points(payload);

pub def every_exported_node_matches_cached_info: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let expected = knowledge::index_from_model(payload).entries;
    array::length(points) == array::length(expected) && array::all(points, fn(item) {
        let response = codec::decode@[knowledge::NodeResponse](info(Value::Object({key: Value::String(edsl::knowledge_key(item.target))}))).unwrap!();
        match response {
            knowledge::NodeResponse::Document(knowledge::NodeResult::Found(node)) =>
                if codec::encode(node) == knowledge::node_value(item) { True }
                else { fail!("export differs from cached lookup", item.target, item, node) },
            _ => fail!("exported node not found through info", item.target),
        }
    })
});

pub def metadata_visibility_and_encoded_keys_survive_export: test::Test = test::should_ok(fn() {
    let item = match array::find(points, fn(item) { item.target == visible }) { Some(item) => item, None => fail!("visible dimension missing") };
    let value = match array::find(points, fn(item) { item.target == member }) { Some(item) => item, None => fail!("value missing") };
    item.summary == "Visible override" && array::length(item.terms) == 1
        && edsl::knowledge_key(item.target) == "Dimension/fixture/name%2Fa%23%25"
        && array::any(item.refs, fn(ref) { ref.target == logical && ref.kind == knowledge::LinkKind::Related })
        && !array::any(item.refs, fn(ref) { ref.target == hidden })
        && !array::any(points, fn(point) { point.target == hidden })
        && value.summary == "Ready documentation" && array::length(value.terms) == 1
});

pub def export_envelope_preserves_discovery_and_all_nodes: test::Test = test::should_ok(fn() {
    let exported = knowledge::knowledge_root_method_factory(knowledge::model_roots(payload).knowledge)(Value::Object({}));
    match exported {
        Value::Object(fields) => dict::get(fields, "format") == Some(Value::String("ontology-knowledge-export-v1"))
            && dict::get(fields, "discovery") == Some(knowledge::knowledge_discovery_method_factory(payload)(Value::Object({})))
            && dict::get(fields, "nodes") == Some(codec::encode(array::map(points, knowledge::node_value))),
        _ => False,
    }
});

pub def export_rejects_invalid_request_shape: test::Test = test::should_fail(fn() {
    knowledge::knowledge_root_method_factory(knowledge::model_roots(payload).knowledge)(Value::String("invalid"))
});

pub def constructing_roots_and_handlers_does_not_materialize_knowledge: test::Test = test::should_ok(fn() {
    let roots = knowledge::model_roots(payload);
    let lazy = {...roots.knowledge, nodes: fn() { fail!("knowledge nodes forced during service init") }};
    let handler = knowledge::knowledge_root_method_factory(lazy);
    roots.lowering.revision == payload.revision
});

pub def root_may_return_entry_nodes_for_indirect_discovery: test::Test = test::should_ok(fn() {
    let roots = knowledge::model_roots(payload);
    let partial = {...roots.knowledge, complete: False, nodes: fn() {
        array::map(array::filter(points, fn(item) { item.target.kind == edsl::KnowledgeKind::Index }), knowledge::node_value)
    }};
    match knowledge::knowledge_root_method_factory(partial)(Value::Object({})) {
        Value::Object(fields) => dict::get(fields, "complete") == Some(codec::encode(False))
            && match dict::get(fields, "nodes") { Some(Value::Array(nodes)) => array::length(nodes) == 1, _ => False },
        _ => False,
    }
});
