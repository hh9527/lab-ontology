@domain::subject("PhysicalServerFan", "id")
@domain::dataset("physical-server-fan", "PhysicalServerFan", ["id"])
@domain::relations(relations)
pub type PhysicalServerFan = struct {
    @g::field_view(g::dimension_group("physical-server-fan/id", ids::PhysicalServerFanById.type, True, [g::Filter::Eq]), "psf_id", True, [g::Filter::Eq])
    @domain::count("psf_count")
    id: ids::PhysicalServerFanById,
    @g::field_view(g::dimension_group("physical-server-fan/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "psf_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("physical-server-fan/obj_sys_id", domain::Reference(ids::PhysicalServerFanByObjSysId).type, True, [g::Filter::Eq]), "psf_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::PhysicalServerFanByObjSysId)),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("physical-server-fan/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "psf_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
    @g::field_view(g::dimension_group("physical-server-fan/sn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "psf_sn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    sn: Option(String),
    @m::column("slotId")
    @g::field_view(g::dimension_group("physical-server-fan/slot_id", Int.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "psf_slot_id", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    slot_id: Option(Int),
    @m::column("healthStatus")
    @g::field_view(g::dimension_group("physical-server-fan/health_status/raw", Int.type, True, [g::Filter::Eq, g::Filter::Ne]), "psf_health_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::PsfHealthStatus.type, "psf_health_status", [v::member(domains::PsfHealthStatus::Normal, [0]), v::member(domains::PsfHealthStatus::Warning, [1]), v::member(domains::PsfHealthStatus::Minor, [2]), v::member(domains::PsfHealthStatus::Major, [3]), v::member(domains::PsfHealthStatus::Critical, [4]), v::member(domains::PsfHealthStatus::Error, [-1]), v::member(domains::PsfHealthStatus::Unknown, [-2])])
    health_status: Option(Int),
