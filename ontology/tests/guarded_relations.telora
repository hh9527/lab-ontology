use crate::ontology as edsl;
use crate::query as qb;
use std::test as test;

@edsl::entity_id("site")
@edsl::entity_source("sites", "s")
type Site = struct {
    @edsl::column("id")
    @edsl::key(True)
    id: String,
};

@edsl::entity_id("bad_field_alarm")
@edsl::entity_source("bad_field_alarms", "a")
@edsl::named_guarded_relation_key("alarm_site", Site.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({from: "site_id", to: "id"}),
    {field: "missing", op: edsl::FilterOp::Ne, input: edsl::FilterInput::Text("3")})
type BadFieldAlarm = struct {
    @edsl::column("site_id")
    site_id: String,
};

@edsl::entity_id("bad_type_alarm")
@edsl::entity_source("bad_type_alarms", "a")
@edsl::named_guarded_relation_key("alarm_site", Site.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({from: "site_id", to: "id"}),
    {field: "site_id", op: edsl::FilterOp::Ne, input: edsl::FilterInput::Int(3)})
type BadTypeAlarm = struct {
    @edsl::column("site_id")
    site_id: String,
};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column],
    allowed_join_kinds: [], allowed_aggregates: [], allowed_scalars: [], allow_distinct: False,
};

pub def missing_guard_field_fails_during_preparation: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-guard-field", [Site.type, BadFieldAlarm.type], profile, fn(subject) { True })
}, "relation guard references an unknown source field");

pub def wrong_guard_value_type_fails_during_preparation: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-guard-type", [Site.type, BadTypeAlarm.type], profile, fn(subject) { True })
}, "relation guard value disagrees with source field type");
