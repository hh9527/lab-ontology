use crate::intent::{ query_intent_lower_factory, query_intent_ast_factory };
use crate::ontology as edsl;
use crate::knowledge as knowledge;
use crate::query as qb;
use crate::sqlite as sqlite;
use crate::postgres as postgres;
use std::json as json;
use std::array as array;
use std::string as string;
use std::test as test;

pub mod test_knowledge;
use self::test_knowledge::{ payload, Approval, Order, Customer };

@edsl::entity_id("broken_filtered_events")
@edsl::entity_source("broken_filtered_events", "bad")
type BrokenFilteredEvent = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::filtered_measure("missing_kind_count", qb::AggregateFunction::Count, [],
        {field: "missing_kind", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("critical")})
    id: Int,
    @edsl::column("kind")
    @edsl::dimension("event_kind", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    kind: String,
};

pub def filtered_measure_rejects_unknown_named_field: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-filtered-field", [BrokenFilteredEvent.type], payload.profile, fn(subject) { subject == "analyst" })
}, "measure predicate references an unknown field");

pub def computed_measure_references_its_declared_operands: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Measure, owner: "approvals", id: "ApprovalTotal"};
    match knowledge::by_target(payload, "analyst", id) {
        knowledge::DocResult::Found(point) => if array::any(point.refs, fn(ref) {
            ref.target.kind == edsl::KnowledgeKind::Measure && ref.target.owner == "approvals"
                && ref.target.id == "ApprovalApprovedCount"
        }) && array::any(point.refs, fn(ref) {
            ref.target.kind == edsl::KnowledgeKind::Measure && ref.target.owner == "approvals"
                && ref.target.id == "ApprovalRejectedCount"
        }) { True } else { fail!("computed knowledge lost its declared measure operands", point) },
        other => fail!("computed measure is not discoverable", other),
    }
});

pub def computed_measure_requires_arithmetic_profile_at_preparation: test::Test = test::should_fail_with(fn() {
    let restricted = {...payload.profile, allowed_scalars: array::filter(payload.profile.allowed_scalars,
        fn(op) { op != qb::ScalarFunction::Add })};
    edsl::build_root("no-computed-add", [Approval.type], restricted, fn(subject) { subject == "analyst" })
}, "computed measure requires its declared arithmetic and aggregate capabilities in the query profile");

pub def filtered_measure_requires_filter_profile_at_preparation: test::Test = test::should_fail_with(fn() {
    let restricted = {...payload.profile, allowed_operators: array::filter(payload.profile.allowed_operators,
        fn(op) { op != qb::Operator::Filter })};
    edsl::build_root("no-filtered-count", [Approval.type], restricted, fn(subject) { subject == "analyst" })
}, "declared measure uses aggregate, filter or scalar capabilities not allowed by the query profile");

pub def counted_measure_requires_count_profile_at_preparation: test::Test = test::should_fail_with(fn() {
    let restricted = {...payload.profile, allowed_aggregates: array::filter(payload.profile.allowed_aggregates,
        fn(function) { function != qb::AggregateFunction::Count })};
    edsl::build_root("no-count", [Approval.type], restricted, fn(subject) { subject == "analyst" })
}, "declared measure uses aggregate, filter or scalar capabilities not allowed by the query profile");

pub def text_dimension_requires_its_search_scalar_at_preparation: test::Test = test::should_fail_with(fn() {
    let restricted = {...payload.profile, allowed_scalars: array::filter(payload.profile.allowed_scalars,
        fn(function) { function != qb::ScalarFunction::Instr })};
    edsl::build_root("no-text-search", [Order.type, Customer.type], restricted,
        fn(subject) { subject == "analyst" })
}, "declared dimension filter uses capabilities not allowed by the query profile");

pub def component_alarm_named_graph: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload, "analyst")(json::parse(r#"{
        "op":"graph", "root":"component", "nodes":[{"id":"component","entity":"components"}],
        "edges":[], "select":[], "count":"component",
        "exists":[{"anchor":"component","nodes":[{"id":"site","entity":"sites"},{"id":"alarm","entity":"alarms"}],
            "edges":[{"relation":"component_site","from":"component","to":"site"},
                     {"relation":"site_alarms","from":"site","to":"alarm"}],
            "filters":[{"node":"alarm","dimension":"AlarmLevel","op":"eq","kind":"int","value":2}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "count(component.id)")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM sites AS site INNER JOIN alarms AS alarm")
        && string::contains(sq.sql, "alarm.level = ?1")
        && string::contains(pg.sql, "INNER JOIN \"alarms\" AS \"alarm\"")
        && sq.bindings == [qb::Val::Int(2)] && pg.bindings == sq.bindings {
        True
    } else { fail!("component/alarm graph lost correlation or binding", sq, pg) }
});

pub def component_alarm_rejects_undeclared_edge: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload, "analyst")(json::parse(r#"{
        "op":"graph", "root":"component", "nodes":[{"id":"component","entity":"components"}],
        "edges":[], "select":[], "count":"component",
        "exists":[{"anchor":"component","nodes":[{"id":"alarm","entity":"alarms"}],
            "edges":[{"relation":"component_alarms","from":"component","to":"alarm"}]}]
    }"#).unwrap!())
}, "unknown named relation");

pub def backend_is_bound_at_factory_creation: test::Test = test::should_ok(fn() {
    let input = json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"alarms"}],
        "edges":[], "select":[{"node":"alarm","dimension":"AlarmLevel"}],
        "filters":[{"node":"alarm","dimension":"AlarmLevel","op":"eq","kind":"int","value":42}]
    }"#).unwrap!();
    let sq = query_intent_lower_factory(payload, "analyst", sqlite::build_query)(input);
    let pg = query_intent_lower_factory(payload, "analyst", postgres::build_query)(input);
    if sq.bindings == [qb::Val::Int(42)] && pg.bindings == sq.bindings
        && string::contains(sq.sql, "?1") && string::contains(pg.sql, "$1") {
        True
    } else { fail!("backend selection changed graph lowering or bindings", sq, pg) }
});

pub def raw_global_take_uses_bound_limit_and_identity_tie_breaker: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload, "analyst")(json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"alarms"}],
        "edges":[], "select":[{"node":"alarm","dimension":"AlarmLevel"}],
        "order_by":[{"node":"alarm","dimension":"AlarmLevel","direction":"desc"}],
        "take":2
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "ORDER BY alarm.level DESC, alarm.id ASC")
        && string::contains(sq.sql, "LIMIT ?1")
        && string::contains(pg.sql, "\"alarm\".\"id\" ASC")
        && string::contains(pg.sql, "LIMIT $1")
        && sq.bindings == [qb::Val::Int(2)] && pg.bindings == sq.bindings { True }
    else { fail!("raw take lost bound or common ordering semantics", sq, pg) }
});

pub def raw_global_take_requires_order: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload, "analyst")(json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"alarms"}],
        "edges":[], "select":[{"node":"alarm","dimension":"AlarmLevel"}], "take":2
    }"#).unwrap!())
}, "graph raw take requires ordered raw rows");

pub def legacy_op_is_rejected: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload, "analyst")(json::parse(r#"{
        "op":"list", "measures":[], "dimensions":["ComponentId"], "filters":[]
    }"#).unwrap!())
}, "unsupported intent op; use graph or graph_pair with named nodes and relations");
