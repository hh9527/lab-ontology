# 逻辑标量使用具名类型，与其物理文本表示区分。
# 原始文本到 IPv4 的部分转换由 groups::ipv4 显式声明，失败产生 NULL。
use crate::ontology as edsl;
use std::type_desc as td;
use std::array as array;
use crate::knowledge_policy as policy;

type Ipv4 = struct(
    String
);
pub use self::{Ipv4};
# EpochMillis/DateTimeUtc 表达绝对时刻；Date/DateTime 不包含时区。
# DateTimeTz（带时区身份）与 DateTimeOffset（仅偏移量）尚未实现。
@policy::reverse_references(False)
type EpochMillis = struct(
    Int
);
@policy::reverse_references(False)
type DateTimeUtc = struct(
    String
);
@policy::reverse_references(False)
type DateTime = struct(
    String
);
@policy::reverse_references(False)
type Date = struct(
    String
);
# 仅拆开可空包装与类型引用，不能把任意 newtype 的物理表示当作时间语义。
def time_role: Fn(Type) -> Option(edsl::TimeField) = fn(value) {
    if value == EpochMillis.type {
        Some({semantics: edsl::TimeSemantics::Utc, encoding: edsl::TimeEncoding::EpochMillis})
    } else if value == DateTimeUtc.type {
        Some({semantics: edsl::TimeSemantics::Utc, encoding: edsl::TimeEncoding::Rfc3339Text})
    } else if value == DateTime.type {
        Some({semantics: edsl::TimeSemantics::Local, encoding: edsl::TimeEncoding::LocalText})
    } else if value == Date.type {
        Some({semantics: edsl::TimeSemantics::Date, encoding: edsl::TimeEncoding::DateText})
    } else if td::kind(value) == td::TypeDescKind::Ref {
        match td::resolve(value) {
            Ok(resolved) => time_role(resolved),
            Err(error) => fail!(error.message, value)
        }
    } else {
        None
    }
};
def field_time_role: Fn(Type) -> Option(edsl::TimeField) = fn(value) {
    let known = time_role(value);
    if known != None {
        known
    } else if td::kind(value) == td::TypeDescKind::Ref {
        match td::resolve(value) {
            Ok(resolved) => field_time_role(resolved),
            Err(error) => fail!(error.message, value)
        }
    } else if td::kind(value) == td::TypeDescKind::Enum {
        match array::find(
            td::variants(value),
            fn(variant) {
                variant.name == "Some"
            }
        ) {
            Some(variant) => match variant.payload {
                Some(payload) => time_role(payload),
                None => None
            },
            None => None,
        }
    } else {
        time_role(value)
    }
};
def input_kind: Fn(edsl::TimeField) -> edsl::FilterInputKind = fn(role) {
    match role.encoding {
        edsl::TimeEncoding::EpochMillis => edsl::FilterInputKind::EpochMillis,
        edsl::TimeEncoding::Rfc3339Text => edsl::FilterInputKind::DateTimeUtc,
        edsl::TimeEncoding::DateText => edsl::FilterInputKind::Date,
        edsl::TimeEncoding::LocalText => edsl::FilterInputKind::DateTime,
    }
};
pub use self::{EpochMillis, DateTimeUtc, DateTime, Date, time_role, field_time_role, input_kind};
