use ontology::semantic as s;
use ontology::relations as r;
use ontology::ontology as e;
use ontology::query as q;
use ontology::groups as g;
use ontology::intent;
use ontology::sqlite;
use std::test;
use std::json;
use std::codec;
use std::value::{Value};

@s::entity_by("Port")
type PortById = struct(String);
@s::dataset("ports", "ports", ["id"])
type Port = struct {
    @g::exact("port_id") id: PortById,
    @g::exact("port_kind") kind: String,
    @g::exact("port_logic") logic: String
};
@s::dataset("samples", "samples", ["id"])
@s::relations([restricted])
type Sample = struct {
    @g::exact("sample_id") id: PortById
};
def edge:r::Relation = r::relation("samples_port",s::endpoint(Sample.type,"id"),s::endpoint(Port.type,"id"),{from:e::Cardinality::Many0,to:e::Cardinality::Optional});
def restricted:r::Relation = s::guarded_in_to(s::guarded_to(edge,"logic",e::FilterOp::Eq,"0"),"kind",["FC","FCoE","ETH","RoCE"]);
def profile:q::PlanProfile = {allowed_operators:[q::Operator::Source,q::Operator::Column,q::Operator::Project,q::Operator::Join,q::Operator::Filter,q::Operator::Scalar,q::Operator::Bind,q::Operator::Order,q::Operator::Limit],allowed_join_kinds:[q::JoinKind::Inner,q::JoinKind::Left],allowed_scalars:[q::ScalarFunction::Eq,q::ScalarFunction::And,q::ScalarFunction::Or,q::ScalarFunction::BinaryText],allowed_aggregates:[],allow_distinct:False};
use ontology::preparation as p;
def payload:e::PreparedPayload = s::payload("guard-test",[Port.type,Sample.type],profile);
pub def guard_query:Value = codec::encode(sqlite::build_query(intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"samples"},{"id":"p","entity":"ports"}],"edges":[{"relation":"samples_port","from":"s","to":"p"}],"select":[{"node":"s","dimension":"sample_id"},{"node":"p","dimension":"port_id"}],"order_by":[{"node":"s","dimension":"sample_id","direction":"Asc"}],"take":10}"#).unwrap!())));
pub def conjunction_keeps_previous_predicate:test::Test=test::should_ok(fn(){
    match restricted.guard {Some(r::Guard::All(parts)) => if parts == [] {fail!("missing guards")} else {()}, _ => fail!("guard must preserve conjunction")}
});
pub def membership_empty_is_rejected:test::Test=test::should_fail_with(fn(){s::guarded_in_to(edge,"kind",[].ty!(Array(String)));()},"relation membership guard requires at least one value");
pub def incompatible_guard_is_rejected:test::Test=test::should_fail_with(fn(){s::guarded_to(edge,"kind",e::FilterOp::Eq,1);()},"relation guard requires a compatible equality literal");
pub def missing_target_field_is_rejected:test::Test=test::should_fail_with(fn(){s::guarded_to(edge,"absent",e::FilterOp::Eq,"x");()},"relation guard field does not exist");
