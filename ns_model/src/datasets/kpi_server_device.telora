pub def relations: Array(r::Relation) = [
    r::relation("sede__s2_rev", domain::endpoint(KpiServerDevice.type, "obj_id"), domain::endpoint(serverdevice_2_kpi::Serverdevice2Kpi.type, "obj_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
