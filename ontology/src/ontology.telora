# EnterpriseKnowledge eDSL core (domain-independent).
#
# Provides:
#   - typed-property carriers for declaring enterprise knowledge on nominal
#     entity structs (physical columns, keys, measures, dimensions, computed
#     dimensions, entity sources, relations);
#   - one-time root preparation (build_root) that collects the property facts,
#     validates them, precomputes safe paths, and publishes a PreparedPayload;
#   - a hot-path lowering (lower) that turns a typed QueryRequest into a
#     query Plan and validates it against the knowledge's PlanProfile.
#
# All Plan/PlanProfile/Query types come from this crate's query module.

use crate::query as qb;
use crate::sqlite as sqlite;
use std::array as array;
use std::type_desc as td;
use std::type_property as property;
use std::prelude as prelude;
use std::regex as regex;
use std::string as string;

# SQL-facing scalar result of a declared Model projection. This knowledge is
# checked before ontology lowering emits a set QueryPlan.
type OutputType = enum { Text, Integer, Number, Boolean };

# ---------------------------------------------------------------------------
# Property carriers (declared on entity structs and their fields).
# ---------------------------------------------------------------------------

# Member-level: physical column mapping for a field.
@prelude::property(PropertyTarget::Field)
type ColumnMap = struct { column: String };

# Member-level: marks the representative key field. A declared dataset grain,
# when present, defines the complete identity and may include other fields.
@prelude::property(PropertyTarget::Field)
type KeyFlag = struct { value: Bool };

# Member-level: measure declaration (aggregate over a field at the entity's
# natural grain). The id is the stable business vocabulary id (exchange
# protocol); the aggregate output alias is derived from it at prepare time.
# `requires` lists additional entities the measure semantics need (beyond its
# own grain), reached only through grain-safe paths.
@prelude::property(PropertyTarget::Field)
type MeasureDef = struct {
    id: String,
    aggregate: qb::AggregateFunction,
    input: MeasureInput,
    requires: Array(Type),
};

type MeasureNote = struct { id: String, label: String, summary: String };
@prelude::property(PropertyTarget::Field)
type MeasureDescriptions = struct { notes: Array(MeasureNote) };

type DimensionNote = struct { id: String, label: String, summary: String };
@prelude::property(PropertyTarget::Field)
type DimensionDescriptions = struct { notes: Array(DimensionNote) };

type LocalizedKnowledgeText = struct { locale: String, label: String, summary: String };
type LocalizedMemberText = struct { kind: MemberAliasKind, id: String, text: LocalizedKnowledgeText };
@prelude::property(PropertyTarget::Field)
type LocalizedMemberTexts = struct { notes: Array(LocalizedMemberText) };

type MemberAliasKind = enum { Dimension, Measure };
type KnowledgeAlias = struct { kind: MemberAliasKind, id: String, label: String };
@prelude::property(PropertyTarget::Field)
type MemberAliasesDef = struct { aliases: Array(KnowledgeAlias) };

# Member-level: filtered measure declaration. Adds a domain-declared inherent
# predicate to the aggregate: only rows matching the predicate count into this
# measure. The predicate references a declared, authorized, filterable dimension
# of the same entity (reusing enum value, operation, input kind and scope
# validation). The inherent predicate and user global filters keep separate
# semantics and are never flattened into one global AND. Multiple annotations
# fold by appending (composable).
@prelude::property(PropertyTarget::Field)
type FilteredMeasureDef = struct { measures: Array(FilteredMeasureSpec) };

type FilteredMeasureSpec = struct {
    id: String,
    aggregate: qb::AggregateFunction,
    requires: Array(Type),
    predicate: ScopePredicate,
};

# Member-level: computed measure declaration. Combines two already-declared
# measures (plain, filtered, or computed) with a restricted qb.ComputedOp.Add/qb.ComputedOp.Sub. The
# dependencies must exist and share the declaring entity's grain; the dependency
# graph must be acyclic. Multiple annotations fold by appending.
@prelude::property(PropertyTarget::Field)
type ComputedMeasureDef = struct { measures: Array(ComputedMeasureSpec) };

type ComputedMeasureSpec = struct {
    id: String,
    op: qb::ComputedOp,
    left: String,
    right: String,
};

# Member-level: plain dimension declaration over a field. `authorized` is the
# query/projection authorization status: an unauthorized dimension still
# belongs to the closed vocabulary (typed requests may reference it) but any
# grouping/sorting/filtering use fails atomically. `filterable` independently
# controls whether a filter capability exists for an authorized dimension.
@prelude::property(PropertyTarget::Field)
type DimensionDef = struct {
    id: String,
    authorized: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
};

# Member-level: computed dimension declaration. The builder receives the base
# field's column expression and returns the canonical computed expression
# (e.g. Substr(column, 1, 7)); literals are lowered to bound values at build
# time, never pre-rendered SQL. Builders may use any closed query scalar
# (including qb.ScalarFunction.Instr, qb.ScalarFunction.If, qb.ComputedOp.Add, qb.ComputedOp.Sub) and are validated by arity checks.
@prelude::property(PropertyTarget::Field)
type ComputedDimensionDef = struct {
    id: String,
    output_type: OutputType,
    authorized: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
    build: Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr),
};

# Member-level: inherent row-range scope of a dimension member. Predicates
# reference canonical field indexes of the member's own entity; the scope is
# merged with user filters in deterministic order at lowering time. Dynamic
# values stay parameterized; contradictory scope/filter constraints fail.
@prelude::property(PropertyTarget::Field)
type ScopeDef = struct { predicates: Array(ScopePredicate) };

@prelude::property(PropertyTarget::Type)
type EntityScopeDef = struct { predicates: Array(EntityScopePredicate) };

type EntityScopePredicate = struct { field: String, op: FilterOp, input: FilterInput };

# Type-level: entity base data source.
@prelude::property(PropertyTarget::Type)
type EntitySource = struct { table: String, alias: String };

# Type-level: stable business id of an entity (used by existence filters and
# row-level targets). Falls back to the source alias when absent.
@prelude::property(PropertyTarget::Type)
type EntityId = struct { id: String };

# Dataset semantics are declared independently of the physical source. Grain
# fields identify one logical row; time names the authoritative UTC instant.
type DatasetKind = enum { Entity, Event, Metric };
type TimeSemantics = enum { Utc, Local };
type TimeEncoding = enum { CanonicalUtcSecondText, UtcEpochMillis, LocalText, LocalEpochMillis };
@prelude::property(PropertyTarget::Field)
type TimeField = struct { semantics: TimeSemantics, encoding: TimeEncoding };
@prelude::property(PropertyTarget::Type)
type DatasetSpec = struct {
    kind: DatasetKind,
    grain: Array(String),
    utc_time: Option(String),
};
@prelude::property(PropertyTarget::Type)
type DatasetDescription = struct { label: String, summary: String };
@prelude::property(PropertyTarget::Type)
type LocalizedDatasetTexts = struct { texts: Array(LocalizedKnowledgeText) };
@prelude::property(PropertyTarget::Type)
type DatasetAliasesDef = struct { labels: Array(String) };

type RelationNote = struct { id: String, label: String, summary: String };
@prelude::property(PropertyTarget::Type)
type RelationDescriptions = struct { notes: Array(RelationNote) };
type LocalizedRelationText = struct { id: String, text: LocalizedKnowledgeText };
@prelude::property(PropertyTarget::Type)
type LocalizedRelationTexts = struct { notes: Array(LocalizedRelationText) };
type RelationAlias = struct { id: String, label: String };
@prelude::property(PropertyTarget::Type)
type RelationAliasesDef = struct { aliases: Array(RelationAlias) };

@prelude::property(PropertyTarget::Field)
type MetricValueSpec = struct {
    id: String,
    aggregate: qb::AggregateFunction,
    unit: Option(String),
};

# Additional explicitly named summaries over raw samples of an existing metric
# field. They do not change that field's declared primary metric aggregation.
@prelude::property(PropertyTarget::Field)
type SampleAggregateDef = struct { summaries: Array(MetricValueSpec) };

# Union (multi-source) entity declaration. An entity declared only with
# `union_source` (and no `entity_source`) is a logical entity whose rows are the
# UNION ALL of an ordered list of physical branches. Every branch maps each
# canonical logical field (by index) to that branch's physical column; all
# branches must map the full logical field set with a consistent order. Optional
# `filter` is a fixed, closed row filter over one logical field (Eq). No raw
# SQL/Expr/fragment is accepted.
type UnionColumnDecl = struct {
    field: Int,
    column: String,
};

type UnionBranchDecl = struct {
    table: String,
    alias: String,
    columns: Array(UnionColumnDecl),
    filter: Option(ScopePredicate),
};

@prelude::property(PropertyTarget::Type)
type UnionSourceDef = struct {
    alias: String,
    branches: Array(UnionBranchDecl),
};

# Type-level: relation declarations from this entity to target entities.
@prelude::property(PropertyTarget::Type)
type RelationDef = struct { relations: Array(RelationDecl) };

type LinkDirection = enum { Undirected, Directed };
type BusinessLinkDecl = struct { id: String, a_relation: String, z_relation: String, direction: LinkDirection };
@prelude::property(PropertyTarget::Type)
type BusinessLinkDef = struct { links: Array(BusinessLinkDecl) };

# A single column-equality key between two entities: `from`/`to` are canonical
# field indexes of the declaring (from) entity and the target (to) entity.
type RelationPair = struct { from: Int, to: Int };

# Relation key: a closed conjunction/disjunction tree over column-equality
# pairs. `RelationKey.And`/`RelationKey.Or` arrays must be non-empty. It lowers to the query public
# JoinCondition tree via `join_on`/`on_eq`/`on_and`/`on_or`; no raw SQL.
type RelationKey = enum {
    Eq(RelationPair),
    FieldEq(RelationFieldPair),
    And(Array(RelationKey)),
    Or(Array(RelationKey)),
};

type RelationFieldPair = struct { from: String, to: String };

# Owner/scalar witnesses keep both sides of a relation key aligned at model
# construction time; the prepared key remains the closed RelationKey tree.
type ModelFieldRef(Owner, Scalar) = struct { owner: Type, scalar: Type, name: String };
type TypedRelationPair(Src, Dest) = struct { from: String, to: String };

def model_field: for(Owner, Scalar) Fn(TypeOf(Owner), TypeOf(Scalar), String) -> ModelFieldRef(Owner, Scalar) = fn(owner, scalar, name) {
    let field = match array::find(td::fields(owner), fn(f) { f.name == name }) {
        Some(f) => f,
        None => fail!("model field reference does not exist on its owner", owner, name),
    };
    if field.ty != scalar {
        fail!("model field reference has the wrong scalar type", owner, name, scalar)
    } else {
        {owner, scalar, name}
    }
};

def typed_relation_pair: for(Src, Dest, Scalar) Fn(ModelFieldRef(Src, Scalar), ModelFieldRef(Dest, Scalar)) -> TypedRelationPair(Src, Dest) = fn(left, right) {
    {from: left.name, to: right.name}
};

type RelationDecl = struct {
    id: String,
    target: Type,
    kind: RelationKind,
    key: RelationKey,
};

# Variant-level: stable external/physical value and display label for a
# payload-free enum variant. When a plain dimension field is typed with a
# named enum, its variants (with or without this annotation) form the closed
# value domain: the stable value is used for filtering bindings and the label
# for discovery. Variants without the annotation use the variant name as both
# stable value and label.
@prelude::property(PropertyTarget::Variant)
type EnumValueDef = struct { value: String, label: String };

# A closed value domain on a scalar field. A canonical business value may
# represent several distinct physical scalar values. Unlike enum_value, this does
# not require the stored field to have a Telora enum type.
type CanonicalValueSpec = struct { id: String, label: String, wires: Array(FilterInput) };

@prelude::property(PropertyTarget::Field)
type CanonicalValuesDef = struct { values: Array(CanonicalValueSpec) };

type CanonicalAlias = struct { id: String, label: String };
@prelude::property(PropertyTarget::Field)
type CanonicalAliasesDef = struct { aliases: Array(CanonicalAlias) };

type LocalizedValueLabel = struct { locale: String, label: String };
type LocalizedCanonicalValue = struct { id: String, locale: String, label: String };
@prelude::property(PropertyTarget::Field)
type LocalizedCanonicalValuesDef = struct { labels: Array(LocalizedCanonicalValue) };

@prelude::property(PropertyTarget::Type)
type NativePairDef = struct { pairs: Array(NativePairSpec) };
type NativePairSpec = struct { id: String, first: String, second: String };
type NativePairEntry = struct { id: String, entity: Int, first: String, second: String };

# Type-level: dual-endpoint hub declaration, annotated on the hub entity (the
# base grain of any request using the hub).  A hub row carries two role columns
# (`left_field`, `right_field`) that both reference the participant entity's key
# (`key_field` on `participant`).  The hub row is filtered by the participant
# target when either role matches the participant's key; the two roles are
# mutually exclusive endpoints of one hub row.  Multiple annotations fold by
# appending.
@prelude::property(PropertyTarget::Type)
type DualHubDef = struct { hubs: Array(DualHubDecl) };

type DualHubDecl = struct {
    participant: Type,
    key_field: Int,
    left_field: Int,
    right_field: Int,
};

# Type-level paired-endpoint (peer) route declaration on the hub entity.  The
# hub row's two role fields (`origin_field`/`peer_field`) reference the key
# fields of two participant entities (`origin_participant`/`peer_participant`).
# When both participants are the SAME entity (same key field), the two
# endpoints are symmetric and both endpoint-exchange branches are allowed;
# otherwise each participant is pinned to its own declared endpoint role.
# Multiple annotations fold by appending.
@prelude::property(PropertyTarget::Type)
type PeerHubDef = struct { hubs: Array(PeerHubDecl) };

type PeerHubDecl = struct {
    origin_participant: Type,
    origin_key: Int,
    origin_field: Int,
    peer_participant: Type,
    peer_key: Int,
    peer_field: Int,
    directed: Bool,
    field_names: Option(PeerHubFieldNames),
    relations: Option(PeerHubRelations),
};

type PeerHubFieldNames = struct { origin_key: String, origin_field: String, peer_key: String, peer_field: String };
type PeerHubRelations = struct { origin: String, peer: String };

# ---------------------------------------------------------------------------
# Public request vocabulary.
# ---------------------------------------------------------------------------

type RelationKind = enum { Safe, FanOut };

# A graph query names entity instances separately from entity types. Each edge
# references a declared relation, whose from/to roles remain authoritative.
type GraphNode = struct { id: String, entity: String };
type GraphEdge = struct { relation: String, from: String, to: String };
type GraphSelect = struct { node: String, dimension: String };
type GraphFilter = struct { node: String, request: FilterRequest };
type GraphExist = struct { anchor: String, nodes: Array(GraphNode), edges: Array(GraphEdge), filters: Array(GraphFilter), negated: Bool };
type GraphRequest = struct {
    root: String,
    nodes: Array(GraphNode),
    edges: Array(GraphEdge),
    select: Array(GraphSelect),
    filters: Array(GraphFilter),
    exists: Array(GraphExist),
    count: Option(String),
    include_empty: Bool,
};

# Filter operations. Comparison ops map to the closed query scalars
# (FilterOp.Eq/FilterOp.Ne/FilterOp.Gt/FilterOp.Ge/FilterOp.Lt/FilterOp.Le); text ops (FilterOp.Contains/FilterOp.NotContains/FilterOp.StartsWith/
# FilterOp.EndsWith) lower through the closed qb.ScalarFunction.Instr/qb.ScalarFunction.Lower/qb.ScalarFunction.Length/qb.ScalarFunction.Substr/qb.ComputedOp.Add/qb.ComputedOp.Sub
# vocabulary and always keep the runtime value in a parameterized Bind.
type FilterOp = enum {
    Eq, Ne, Gt, Ge, Lt, Le,
    Contains, NotContains, StartsWith, EndsWith,
};

type FilterInputKind = enum { Text, Number, Int, Bool };

type FilterInput = enum {
    Text(String),
    Number(Float),
    Int(Int),
    Bool(Bool),
};

# A member's inherent row-range scope predicate: a constraint on one field of
# the member's own entity (canonical field index, filter op, literal value).
# Scope predicates always lower to parameterized bindings.
type ScopePredicate = struct {
    field: Int,
    op: FilterOp,
    input: FilterInput,
};

type OrderDirection = enum { Asc, Desc };

type OrderTarget = enum {
    Measure(String),
    Dimension(String),
};

type MeasureInput = enum { All, Distinct };

type DimensionInput = enum { None };

type MeasureRequest = struct {
    id: String,
    subject: String,
    input: MeasureInput,
};

type DimensionRequest = struct {
    id: String,
    subject: String,
    input: DimensionInput,
};

type FilterRequest = struct {
    id: String,
    subject: String,
    op: FilterOp,
    input: FilterInput,
};

# A closed field-to-field predicate on ONE prepared subject: both `left` and
# `right` name a declared, authorized, plain (column-backed) attribute
# (dimension id) of the SAME subject entity; `op` is a closed comparison
# operator (at least FilterOp.Eq / FilterOp.Ne).  Lowering produces a comparison of the two
# validated column references only and never a dynamic binding.
type FieldFilterRequest = struct {
    subject: String,
    op: FilterOp,
    left: String,
    right: String,
};

# A closed OR-group over a single dimension: a base row matches when its value
# equals any of the listed values (lowered to the query `Or(Eq(...), ...)`).
# Values keep request order and become parameterized bindings; there is no raw
# Expr/SQL/column/alias escape.
type AnyOfRequest = struct {
    id: String,
    subject: String,
    values: Array(FilterInput),
};

type OrderRequest = struct {
    target: OrderTarget,
    direction: OrderDirection,
};

# One internal (non-projected) ordering aggregate of a grouped dimension
# listing.  `measure` is a declared, authorized measure on the request's base
# entity; its aggregate value only orders the groups (and a Top-N limit),
# never a returned column.  `subject` authorizes the internal measure, and
# `direction` selects Asc/Desc.
type InternalOrderRequest = struct {
    measure: String,
    subject: String,
    direction: OrderDirection,
};

# One hidden HAVING predicate over an internal related aggregate (a declared
# measure on the subject or on a directly-related entity).  The aggregate value
# is used only by the HAVING comparison; it is never returned.
type InternalHavingRequest = struct {
    measure: String,
    subject: String,
    op: HavingOp,
    threshold: FilterInput,
};

# Restricted Top Per Group request: partition the aggregated result by a set of
# selected dimensions and keep the top `take` rows per partition under a stable
# ordering. v1 does not combine with a global limit or offset.
@check(fn(part) {
    if array::length(part.by) == 0 {
        Err(blame!("partition must name at least one dimension", part.by))
    } else if part.take <= 0 || part.take > qb::max_partition_take {
        Err(blame!("partition take must be a positive integer within the upper bound", part.take))
    } else {
        Ok(())
    }
})
type PartitionRequest = struct {
    by: Array(String),   # dimension ids defining the partitions
    take: Int,           # positive integer with an upper bound (max_partition_take)
};

# Request-local numeric constraints hold at construction, including decoding
# and merge-update. Ordering feasibility is checked after lowering resolves it.
@check(fn(request) {
    let limit = match request.limit {
        Some(n) => if n > 0 { Ok(()) } else { Err(blame!("limit must be a positive integer", n)) },
        None => Ok(()),
    };
    limit?;
    match request.offset {
        Some(n) => if n >= 0 { Ok(()) } else { Err(blame!("offset must be a non-negative integer", n)) },
        None => Ok(()),
    }
})
type QueryRequest = struct {
    measures: Array(MeasureRequest),
    dimensions: Array(DimensionRequest),
    filters: Array(FilterRequest),
    ordering: Array(OrderRequest),
    limit: Option(Int),
    offset: Option(Int),
    partition: Option(PartitionRequest),
};

# Existence filter request: keeps the base grain while restricting to base rows
# that have at least one related row in the target entity (or, when
# `min_matches` is set, at least `min_matches` related rows). The target is a
# stable entity id related to the base entity; the relation may be declared in
# either direction (a reverse existence is derived without duplicating edges)
# and fan-out relations are allowed (existence never amplifies the subject
# grain). `filters` constrain the related rows and are parameterized bindings.
type ExistsRequest = struct {
    target: String,
    subject: String,
    filters: Array(FilterRequest),
    any_of: Array(AnyOfRequest),
    min_matches: Option(Int),
};

type NamedExistsRequest = struct { relation: String, spec: ExistsRequest };
type MetricQualification = struct {
    relation: String,
    dataset: String,
    measure: String,
    filters: Array(FilterRequest),
    start: String,
    end: String,
    op: HavingOp,
    threshold: FilterInput,
};
type EpochMetricQualification = struct {
    relation: String,
    dataset: String,
    measure: String,
    filters: Array(FilterRequest),
    field: String,
    start: Int,
    end: Int,
    op: HavingOp,
    threshold: FilterInput,
};
type TimedMetricQualification = struct {
    relation: String,
    dataset: String,
    measure: String,
    filters: Array(FilterRequest),
    window: SampleWindow,
    op: HavingOp,
    threshold: FilterInput,
};
type SampleQualification = struct {
    relation: String,
    dataset: String,
    filters: Array(FilterRequest),
    start: String,
    end: String,
    min_matches: Int,
};
type EpochSampleQualification = struct {
    relation: String,
    dataset: String,
    field: String,
    filters: Array(FilterRequest),
    start: Int,
    end: Int,
    min_matches: Int,
};
type TimedSampleQualification = struct {
    relation: String,
    dataset: String,
    filters: Array(FilterRequest),
    window: SampleWindow,
    min_matches: Int,
};
type SampleCountRange = struct {
    qualification: SampleQualification,
    min_matches: Int,
    max_matches: Int,
};
type EpochSampleCountRange = struct {
    qualification: EpochSampleQualification,
    min_matches: Int,
    max_matches: Int,
};
type TimedSampleCountRange = struct {
    qualification: TimedSampleQualification,
    min_matches: Int,
    max_matches: Int,
};
type ComponentContextSpec = struct {
    relation: String,
    target: String,
    dimensions: Array(DimensionRequest),
    filters: Array(FilterRequest),
};
type OwnerSiteScope = struct {
    ancestor_relation: String,
    site_relation: String,
    tenant_relation: String,
    ancestor_filters: Array(FilterRequest),
    site_filters: Array(FilterRequest),
    tenant_filters: Array(FilterRequest),
};
type SiteTenantScope = struct {
    site_relation: String,
    tenant_relation: String,
    site_filters: Array(FilterRequest),
    tenant_filters: Array(FilterRequest),
};
type EndpointPairRequest = struct {
    pair: String,
    first: FilterInput,
    second: FilterInput,
    subject: String,
};
type ChildSiteScope = struct {
    parent_relation: String,
    site_relation: String,
    tenant_relation: String,
    child_tenant_relation: String,
    parent_tenant_relation: String,
    parent_filters: Array(FilterRequest),
    site_filters: Array(FilterRequest),
    tenant_filters: Array(FilterRequest),
};
type UtcWindowRequest = struct { dataset: String, start: String, end: String };
type UtcFieldWindowRequest = struct { dataset: String, field: String, start: String, end: String };
type UtcEpochWindowRequest = struct { dataset: String, field: String, start: Int, end: Int };
type SampleWindow = enum { Text(UtcWindowRequest), Epoch(UtcEpochWindowRequest) };
type UtcDaysWindowRequest = struct { dataset: String, as_of: String, days: Int };

# Aggregate-result (HAVING) predicate over a requested measure alias.
type HavingOp = enum { Eq, Ne, Gt, Ge, Lt, Le };

type HavingRequest = struct {
    measure: String,
    subject: String,
    op: HavingOp,
    threshold: FilterInput,
};

# One participant reference of a paired-endpoint request: the stable entity id
# of the participant (must match one endpoint slot of the hub's paired route),
# an optional exact key value (a dynamic scalar, always bound), and zero or more
# attribute filters over the participant's OWN entity.  An entity-only side
# (`key = None`, `filters = []`) is legal: the declared participant entity
# (prepared route source/table/alias) is itself the verified identity/type
# constraint and is tied to its own endpoint role by the two exchange
# equalities inside the single correlated EXISTS, so it never degenerates into
# a broad cross-product match.  When both key and attribute filters are
# present they are ANDed inside that participant's own alias.
type PeerRef = struct {
    entity: String,
    key: Option(FilterInput),
    filters: Array(FilterRequest),
};

# Paired-endpoint (peer) request on a hub base row: keep the hub row only when
# its two mutually exclusive endpoints are the two specified participants
# (`origin` and `peer`) of the hub's declared paired route.  `peer` must differ
# from `origin`; self-pair and same-side matches are rejected deterministically.
type PeerRequest = struct {
    subject: String,
    origin: PeerRef,
    peer: PeerRef,
};

type PeerObservationScope = struct {
    hub: String,
    origin_relation: String,
    owner_relation: String,
    origin_filters: Array(FilterRequest),
};

# ---------------------------------------------------------------------------
# Prepared payload types.
# ---------------------------------------------------------------------------

type FieldEntry = struct {
    index: Int,
    name: String,
    column: String,
    is_key: Bool,
    ty: Type,
};

# One member of a closed enum value domain. `value` is the stable
# external/physical value used for filter bindings; `label` is the display
# label; `variant` is the canonical enum variant name.
type EnumValueEntry = struct {
    variant: String,
    value: String,
    label: String,
};

# Prepared union (derived) branch: physical source, ordered per-field physical
# column names (aligned to the canonical logical field order), and an optional
# fixed row filter over one logical field.
type UnionBranchEntry = struct {
    table: String,
    alias: String,
    columns: Array(String),
    filter: Option(ScopePredicate),
};

# Prepared union (derived) source: the logical alias and ordered branches.
type UnionEntry = struct {
    alias: String,
    branches: Array(UnionBranchEntry),
};

type EntityEntry = struct {
    index: Int,
    id: String,
    entity_type: Type,
    table: String,
    alias: String,
    source: qb::Source,
    key_field: Int,
    fields: Array(FieldEntry),
    union: Option(UnionEntry),
    dataset: Option(DatasetSpec),
    metrics: Array(MetricValueEntry),
    description: Option(DatasetDescription),
    scope: Array(ScopePredicate),
};

type MetricValueEntry = struct {
    id: String,
    field: String,
    aggregate: qb::AggregateFunction,
    unit: Option(String),
    role: MetricValueRole,
};

type MeasurePredicateBrief = struct { field: String, op: FilterOp, input: FilterInput };
type MeasureBrief = struct {
    id: String,
    label: String,
    aliases: Array(String),
    summary: String,
    localized: Array(LocalizedKnowledgeText),
    dataset: String,
    field: Option(String),
    aggregate: Option(qb::AggregateFunction),
    input: Option(MeasureInput),
    required_dataset_ids: Array(String),
    predicate: Option(MeasurePredicateBrief),
    computed: Option(ComputedMeasureEntry),
    metric: Option(MetricValueEntry),
};

type DimensionScopeBrief = struct { field: String, op: FilterOp, input: FilterInput };
type DimensionBrief = struct {
    id: String,
    label: String,
    aliases: Array(String),
    summary: String,
    localized: Array(LocalizedKnowledgeText),
    dataset: String,
    field: String,
    computed: Bool,
    authorized: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
    values: Array(EnumValueEntry),
    canonical_values: Array(CanonicalValueSpec),
    canonical_aliases: Array(CanonicalAlias),
    localized_values: Array(LocalizedCanonicalValue),
    scope: Array(DimensionScopeBrief),
};

type BusinessValueBrief = struct { id: String, label: String, aliases: Array(String), localized: Array(LocalizedValueLabel) };
type SubjectDimensionBrief = struct {
    id: String,
    label: String,
    aliases: Array(String),
    summary: String,
    localized: Array(LocalizedKnowledgeText),
    dataset: String,
    field: String,
    computed: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
    values: Array(BusinessValueBrief),
    scope: Array(DimensionScopeBrief),
};

type MetricValueRole = enum { DeclaredMetric, SampleSummary };

type TimeRoleBrief = struct {
    field: String,
    semantics: TimeSemantics,
    encoding: TimeEncoding,
    authoritative: Bool,
    dimension_ids: Array(String),
};

type DatasetBrief = struct {
    id: String,
    label: String,
    aliases: Array(String),
    summary: String,
    localized: Array(LocalizedKnowledgeText),
    kind: DatasetKind,
    dimension_ids: Array(String),
    measure_ids: Array(String),
    metric_ids: Array(String),
    relation_ids: Array(String),
    time_roles: Array(TimeRoleBrief),
    scope: Array(DimensionScopeBrief),
};

# Prepared dependency spec of a computed measure: operands are business measure
# ids resolved at lowering time against the prepared measures.
type ComputedMeasureEntry = struct {
    op: qb::ComputedOp,
    left: String,
    right: String,
};

type MeasureEntry = struct {
    id: String,
    entity: Int,
    field: Int,
    aggregate: qb::AggregateFunction,
    input: MeasureInput,
    alias: String,
    requires: Array(Int),
    predicate: Option(ScopePredicate),
    computed: Option(ComputedMeasureEntry),
};

type DimensionEntry = struct {
    id: String,
    entity: Int,
    field: Int,
    output_type: OutputType,
    computed: Bool,
    build: Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr),
    authorized: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
    values: Array(EnumValueEntry),
    canonical_values: Array(CanonicalValueSpec),
    canonical_aliases: Array(CanonicalAlias),
    scope: Array(ScopePredicate),
};

type RelationEntry = struct {
    id: String,
    label: String,
    summary: String,
    from: Int,
    to: Int,
    kind: RelationKind,
    key: RelationKey,
};

type BusinessLinkEntry = struct {
    id: String,
    hub: Int,
    participant: Int,
    a_relation: String,
    z_relation: String,
    direction: LinkDirection,
};

type RelationShape = enum {
    Equality,
    All(Array(RelationShape)),
    Any(Array(RelationShape)),
};

type RelationBrief = struct {
    id: String,
    label: String,
    aliases: Array(String),
    summary: String,
    localized: Array(LocalizedKnowledgeText),
    from_dataset: String,
    to_dataset: String,
    kind: RelationKind,
    shape: RelationShape,
};

# A prepared, validated dual-endpoint hub route.  `hub` is the base-grain hub
# entity whose rows carry two role columns (`left`/`right` field indexes) that
# reference the participant entity (`participant`) through its stable key field
# (`participant_key`).  A hub row is kept when its left or right endpoint
# matches a participant key (each hub base row is counted once).
type HubRouteEntry = struct {
    hub: Int,
    participant: Int,
    participant_key: Int,
    left: Int,
    right: Int,
};

# A prepared, validated paired-endpoint route.  `hub` is the hub entity whose
# row carries the two role fields (`origin_field`/`peer_field`); `origin_entity`
# (`origin_key`) and `peer_entity` (`peer_key`) are the two participant
# entities and their declared key fields.  `exchange` is True when both role
# fields reference the same participant entity/key (both endpoint assignments
# are legal); otherwise each participant is pinned to its own endpoint slot.
type PeerRouteEntry = struct {
    hub: Int,
    origin_entity: Int,
    origin_key: Int,
    origin_field: Int,
    peer_entity: Int,
    peer_key: Int,
    peer_field: Int,
    exchange: Bool,
    relations: Option(PeerHubRelations),
};

type PathResult = enum {
    Safe(Array(Int)),
    FanOut(Array(Int)),
    Missing,
    Truncated,
};

type PreparedPayload = struct {
    revision: String,
    entities: Array(EntityEntry),
    measures: Array(MeasureEntry),
    dimensions: Array(DimensionEntry),
    relations: Array(RelationEntry),
    business_links: Array(BusinessLinkEntry),
    hub_routes: Array(HubRouteEntry),
    peer_routes: Array(PeerRouteEntry),
    native_pairs: Array(NativePairEntry),
    paths: Array(Array(PathResult)),
    # `ambiguous_paths[s][t]` is True when more than one distinct Safe path
    # connects entity s to entity t (parallel or otherwise ambiguous declared
    # Safe routes).  Precomputed once at prepare time; a hidden join route that
    # must not be chosen by declaration order rejects on this matrix.
    ambiguous_paths: Array(Array(Bool)),
    profile: qb::PlanProfile,
    authorize: Fn(String) -> Bool,
};

# ---------------------------------------------------------------------------
# Provider factories (used as decorators by the knowledge author).
# ---------------------------------------------------------------------------

def column: Fn(String) -> Fn(property::FieldPropertyCtx, Option(ColumnMap)) -> ColumnMap = fn(column) {
    fn(ctx, previous) {
        let result: ColumnMap = { column };
        result
    }
};

def key: Fn(Bool) -> Fn(property::FieldPropertyCtx, Option(KeyFlag)) -> KeyFlag = fn(value) {
    fn(ctx, previous) {
        let result: KeyFlag = { value };
        result
    }
};

def measure: Fn(String, qb::AggregateFunction, Array(Type)) -> Fn(property::FieldPropertyCtx, Option(MeasureDef)) -> MeasureDef = fn(id, aggregate, requires) {
    fn(ctx, previous) {
        let result: MeasureDef = { id, aggregate, input: MeasureInput::All, requires };
        result
    }
};

def measure_description: Fn(String, String, String) -> Fn(property::FieldPropertyCtx, Option(MeasureDescriptions)) -> MeasureDescriptions =
    fn(id, label, summary) {
        fn(ctx, previous) {
            let note: MeasureNote = { id, label, summary };
            {notes: match previous {
                Some(existing) => array::push(existing.notes, note),
                None => [note],
            }}
        }
    };

def dimension_description: Fn(String, String, String) -> Fn(property::FieldPropertyCtx, Option(DimensionDescriptions)) -> DimensionDescriptions =
    fn(id, label, summary) {
        fn(ctx, previous) {
            let note: DimensionNote = { id, label, summary };
            {notes: match previous {
                Some(existing) => array::push(existing.notes, note),
                None => [note],
            }}
        }
    };

def localized_member: Fn(MemberAliasKind, String, String, String, String) -> Fn(property::FieldPropertyCtx, Option(LocalizedMemberTexts)) -> LocalizedMemberTexts = fn(kind, id, locale, label, summary) {
    fn(ctx, previous) {
        let notes = match previous { Some(p) => p.notes, None => [] };
        {notes: array::push(notes, {kind, id, text: {locale, label, summary}})}
    }
};

def localized_dimension: Fn(String, String, String, String) -> Fn(property::FieldPropertyCtx, Option(LocalizedMemberTexts)) -> LocalizedMemberTexts = fn(id, locale, label, summary) {
    localized_member(MemberAliasKind::Dimension, id, locale, label, summary)
};

def localized_measure: Fn(String, String, String, String) -> Fn(property::FieldPropertyCtx, Option(LocalizedMemberTexts)) -> LocalizedMemberTexts = fn(id, locale, label, summary) {
    localized_member(MemberAliasKind::Measure, id, locale, label, summary)
};

def member_alias: Fn(MemberAliasKind, String, String) -> Fn(property::FieldPropertyCtx, Option(MemberAliasesDef)) -> MemberAliasesDef = fn(kind, id, label) {
    fn(ctx, previous) {
        let aliases = match previous { Some(p) => p.aliases, None => [] };
        { aliases: array::push(aliases, {kind, id, label}) }
    }
};

def dimension_alias: Fn(String, String) -> Fn(property::FieldPropertyCtx, Option(MemberAliasesDef)) -> MemberAliasesDef = fn(id, label) {
    member_alias(MemberAliasKind::Dimension, id, label)
};

def measure_alias: Fn(String, String) -> Fn(property::FieldPropertyCtx, Option(MemberAliasesDef)) -> MemberAliasesDef = fn(id, label) {
    member_alias(MemberAliasKind::Measure, id, label)
};

# A measure whose stable vocabulary id denotes DISTINCT aggregate semantics.
# The input mode is model knowledge, not a per-query caller choice.
def distinct_measure: Fn(String, qb::AggregateFunction, Array(Type)) -> Fn(property::FieldPropertyCtx, Option(MeasureDef)) -> MeasureDef = fn(id, aggregate, requires) {
    fn(ctx, previous) {
        let result: MeasureDef = { id, aggregate, input: MeasureInput::Distinct, requires };
        result
    }
};

def filtered_measure: Fn(String, qb::AggregateFunction, Array(Type), ScopePredicate) -> Fn(property::FieldPropertyCtx, Option(FilteredMeasureDef)) -> FilteredMeasureDef = fn(id, aggregate, requires, predicate) {
    fn(ctx, previous) {
        let spec: FilteredMeasureSpec = { id, aggregate, requires, predicate };
        let all = match previous {
            Some(p) => array::push(p.measures, spec),
            None => [spec],
        };
        let result: FilteredMeasureDef = { measures: all };
        result
    }
};

def computed_measure: Fn(String, qb::ComputedOp, String, String) -> Fn(property::FieldPropertyCtx, Option(ComputedMeasureDef)) -> ComputedMeasureDef = fn(id, op, left, right) {
    fn(ctx, previous) {
        let spec: ComputedMeasureSpec = { id, op, left, right };
        let all = match previous {
            Some(p) => array::push(p.measures, spec),
            None => [spec],
        };
        let result: ComputedMeasureDef = { measures: all };
        result
    }
};

def dimension: Fn(String, Bool, Bool, Array(FilterOp), Array(FilterInputKind)) -> Fn(property::FieldPropertyCtx, Option(DimensionDef)) -> DimensionDef = fn(id, authorized, filterable, ops, input_kinds) {
    fn(ctx, previous) {
        let result: DimensionDef = { id, authorized, filterable, ops, input_kinds };
        result
    }
};

def computed_dimension: Fn(String, OutputType, Bool, Bool, Array(FilterOp), Array(FilterInputKind), Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr)) -> Fn(property::FieldPropertyCtx, Option(ComputedDimensionDef)) -> ComputedDimensionDef = fn(id, output_type, authorized, filterable, ops, input_kinds, build) {
    fn(ctx, previous) {
        let result: ComputedDimensionDef = { id, output_type, authorized, filterable, ops, input_kinds, build };
        result
    }
};

def entity_source: Fn(String, String) -> Fn(td::TypeDesc, Option(EntitySource)) -> EntitySource = fn(table, alias) {
    fn(ctx, previous) {
        let result: EntitySource = { table, alias };
        result
    }
};

def entity_id: Fn(String) -> Fn(td::TypeDesc, Option(EntityId)) -> EntityId = fn(id) {
    fn(ctx, previous) {
        let result: EntityId = { id };
        result
    }
};

def dataset: Fn(DatasetKind, Array(String), Option(String)) -> Fn(td::TypeDesc, Option(DatasetSpec)) -> DatasetSpec = fn(kind, grain, utc_time) {
    fn(ctx, previous) {
        let result: DatasetSpec = { kind, grain, utc_time };
        result
    }
};

def metric_value: Fn(String, qb::AggregateFunction, Option(String)) -> Fn(property::FieldPropertyCtx, Option(MetricValueSpec)) -> MetricValueSpec = fn(id, aggregate, unit) {
    fn(ctx, previous) {
        let result: MetricValueSpec = { id, aggregate, unit };
        result
    }
};

def sample_aggregate: Fn(String, qb::AggregateFunction, Option(String)) -> Fn(property::FieldPropertyCtx, Option(SampleAggregateDef)) -> SampleAggregateDef = fn(id, aggregate, unit) {
    fn(ctx, previous) {
        let summary: MetricValueSpec = { id, aggregate, unit };
        let summaries = match previous {
            Some(existing) => array::push(existing.summaries, summary),
            None => [summary],
        };
        { summaries }
    }
};

def time_field: Fn(TimeSemantics, TimeEncoding) -> Fn(property::FieldPropertyCtx, Option(TimeField)) -> TimeField = fn(semantics, encoding) {
    fn(ctx, previous) {
        if (semantics == TimeSemantics::Utc) != (encoding == TimeEncoding::CanonicalUtcSecondText || encoding == TimeEncoding::UtcEpochMillis) {
            fail!("UTC time semantics require a UTC encoding", ctx)
        } else {
        let result: TimeField = { semantics, encoding };
        result
        }
    }
};

def dataset_description: Fn(String, String) -> Fn(td::TypeDesc, Option(DatasetDescription)) -> DatasetDescription = fn(label, summary) {
    fn(ctx, previous) {
        if label == "" || summary == "" { fail!("dataset description requires a label and summary") }
        else {
            let result: DatasetDescription = { label, summary };
            result
        }
    }
};

def localized_dataset: Fn(String, String, String) -> Fn(td::TypeDesc, Option(LocalizedDatasetTexts)) -> LocalizedDatasetTexts = fn(locale, label, summary) {
    fn(ctx, previous) {
        let texts = match previous { Some(p) => p.texts, None => [] };
        {texts: array::push(texts, {locale, label, summary})}
    }
};

