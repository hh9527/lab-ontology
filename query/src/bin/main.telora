# query/src/bin/main.telora
#
# Demonstrates a legal Plan validated against a full PlanProfile and
# concretized deterministically into a parameterized SQLite Query.
#
# The Query is encoded across the public JSON codec boundary with
# `codec.encode(Value, query)`.  Because `Val` carries the `@json.untagged`
# codec property, `Query.bindings` is encoded as a native JSON scalar array
# (e.g. [1, 4, 50, 20]) with no variant wrapper such as {"Int": 1}.
# The returned Value is encoded as JSON by the default Entry.

import "std/codec" as codec;
import "std/result" as result;
import "std/value" { Value };
import "@src/lib" as qb;

def full_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [
            'Source, 'Column, 'Bind, 'Scalar, 'Aggregate, 'Project,
            'Filter, 'Join, 'Group, 'Order, 'Limit, 'Offset, 'Partition,
        ],
        allowed_join_kinds: ['Inner, 'Left],
        allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
        allowed_scalars: ['Substr, 'Instr, 'If, 'Add, 'Sub, 'JsonExtract, 'JsonType, 'JsonValid, 'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not],
        allow_distinct: 'True,
    };
    profile
};

def demo_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "demo-1",
        sources: [qb.source("o", "orders")],
        projection: [
            qb.expr_item(qb.column("o", "id")),
            qb.expr_item(qb.substr([qb.column("o", "name"), qb.bind_int(1), qb.bind_int(4)])),
        ],
        filter: 'Some(qb.scalar('Gt, [qb.column("o", "total"), qb.bind_float(50.0)])),
        joins: [],
        grouping: [],
        ordering: [qb.desc(qb.column("o", "total"))],
        limit: 'Some(20),
        offset: 'None,
        partition: 'None,
    };
    plan
};

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    let plan = demo_plan();
    let validated = qb.validate(plan, full_profile());
    let query = qb.transform_sqlite(validated);
    codec.encode(Value, query) |> result.unwrap
};
