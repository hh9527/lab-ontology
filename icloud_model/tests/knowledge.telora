use crate::model::{ payload };
use ontology::knowledge as knowledge;
use ontology::ontology as edsl;
use ontology::query as qb;
use std::value::{ Value };
use std::codec as codec;
use std::array as array;
use std::string as string;
use std::test as test;

def lookup: Fn(edsl::KnowledgeTarget) -> knowledge::DocResult = knowledge::knowledge_lookup_factory(payload);

def key_input: Fn(edsl::KnowledgeKind, String, String) -> Value = fn(kind, owner, id) {
    let key: edsl::KnowledgeTarget = {kind, owner, id};
    Value::Object({key: Value::String(edsl::knowledge_key(key))})
};

pub def device_publishes_identity_reference_and_roles: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let response = codec::decode@[knowledge::NodeResponse](info(key_input(edsl::KnowledgeKind::Dataset, "", "device"))).unwrap!();
    match response {
        knowledge::NodeResponse::Document(knowledge::NodeResult::Found(node)) => do {
            let detail = codec::decode@[knowledge::DatasetDetail](node.detail).unwrap!();
            if detail.references == [{id: "id", fields: ["id"]}]
                && array::any(detail.field_roles, fn(field) { field.field == "name" && field.roles == [edsl::FieldRole::Appellation] })
                && array::any(detail.field_roles, fn(field) { field.field == "alias" && field.roles == [edsl::FieldRole::Appellation] })
                && array::any(detail.field_roles, fn(field) { field.field == "classification" && field.roles == [edsl::FieldRole::Classification] })
                && array::any(detail.field_roles, fn(field) { field.field == "id" && field.roles == [edsl::FieldRole::Reference] }) { True }
            else { fail!("device identity discovery incomplete", detail) }
        },
        other => fail!("device document missing", other),
    }
});

pub def existing_device_metric_publishes_metric_role: test::Test = test::should_ok(fn() {
    let response = codec::decode@[knowledge::NodeResponse](knowledge::knowledge_info_method_factory(payload)(
        key_input(edsl::KnowledgeKind::Field, "device_kpi", "cpu_usage"))).unwrap!();
    match response {
        knowledge::NodeResponse::Document(knowledge::NodeResult::Found(node)) => do {
            let detail = codec::decode@[knowledge::FieldDetail](node.detail).unwrap!();
            if detail.roles == [edsl::FieldRole::Metric] && detail.reference_ids == [] { True }
            else { fail!("formal device metric role missing", detail) }
        },
        other => fail!("metric field document missing", other),
    }
});

pub def utc1_dimensions_publish_format_in_wire_detail: test::Test = test::should_ok(fn() {
    let dimensions = array::filter(payload.dimensions, fn(dimension) {
        array::any(dimension.input_kinds, fn(kind) { kind == edsl::FilterInputKind::Utc1 })
    });
    let points = array::map(dimensions, fn(dimension) {
        let target: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
            owner: payload.entities[dimension.entity].id, id: dimension.id};
        match lookup(target) {
            knowledge::DocResult::Found(point) => point,
            other => fail!("UTC text dimension is not discoverable", target, other),
        }
    });
    if array::length(points) < 6 { fail!("expected UTC text dimensions", points) }
    else if array::all(points, fn(point) {
        let node = codec::decode@[knowledge::Node](knowledge::node_value(point)).unwrap!();
        let detail = codec::decode@[edsl::VisibleDimensionBrief](node.detail).unwrap!();
        array::length(detail.input_docs) == 1
            && detail.input_docs[0].kind == edsl::FilterInputKind::Utc1
            && string::contains(detail.input_docs[0].text, "YYYY-MM-DD HH:MM:SS")
            && string::contains(detail.input_docs[0].text, "2026-09-20 16:00:00")
    }) { () } else { fail!("UTC input documentation missing from wire detail") }
});

pub def complex_model_knowledge_map_is_closed: test::Test = test::should_ok(fn() {
    let points = knowledge::map(payload);
    let entries = knowledge::index_entries(points).entries;
    if array::length(points) > 19 && array::length(entries) == array::length(points)
        && array::any(entries, fn(entry) { entry.key.id == "device" && entry.key.kind == edsl::KnowledgeKind::Dataset })
    { True } else { fail!("complex model has an undiscoverable or dangling knowledge point") }
});

pub def server_asset_and_site_path_are_discoverable_from_one_model: test::Test = test::should_ok(fn() {
    let asset: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
        owner: "server_device", id: "server_asset_number"};
    let relation: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "server_device", id: "server_located_at_site"};
    let server: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset,
        owner: "", id: "server_device"};
    match lookup(server) {
        knowledge::DocResult::Found(point) => if array::any(point.refs, fn(ref) { ref.target == asset })
            && array::any(point.refs, fn(ref) { ref.target == relation }) {
            match lookup(asset) {
                knowledge::DocResult::Found(dimension) => if dimension.dimension != None { True }
                    else { fail!("server asset dimension has no declared detail") },
                other => fail!("server asset dimension is undiscoverable", other),
            }
        } else { fail!("server document lost the asset or site relation reference") },
        other => fail!("server dataset is undiscoverable", other),
    }
});

pub def site_and_server_knowledge_publish_their_effective_identity: test::Test = test::should_ok(fn() {
    let site: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "site"};
    let server: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "server_device"};
    match (lookup(site), lookup(server)) {
        (knowledge::DocResult::Found(site_point), knowledge::DocResult::Found(server_point)) =>
            if site_point.grain == ["site_id"] && server_point.grain == ["id"] { True }
            else { fail!("knowledge identity differs from the model", site_point.grain, server_point.grain) },
        other => fail!("site or server dataset is not discoverable", other),
    }
});

pub def site_name_knowledge_keeps_its_complete_display_value: test::Test = test::should_ok(fn() {
    let target: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
        owner: "site", id: "site_name"};
    match lookup(target) {
        knowledge::DocResult::Found(point) => if string::contains(point.summary, "Complete stored site display name") { True }
            else { fail!("site name knowledge lost its complete-value semantics", point.summary) },
        other => fail!("site name dimension is not discoverable", other),
    }
});

pub def server_class_localized_values_keep_subrack_distinct_from_enclosure: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let subrack = checked_response(
        info(key_input(edsl::KnowledgeKind::Value, "server_class", "subrack")));
    let enclosure = checked_response(
        info(key_input(edsl::KnowledgeKind::Value, "server_class", "enclosure")));
    match (subrack, enclosure) {
        (knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(a)),
            knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(b))) =>
                if a.target.kind == edsl::KnowledgeKind::Value && a.target.id == "subrack"
                    && b.target.kind == edsl::KnowledgeKind::Value && b.target.id == "enclosure"
                    && array::any(a.localized, fn(text) { text.label == "天工机框服务器" })
                    && array::any(b.localized, fn(text) { text.label == "机柜" }) { True }
                else { fail!("server class localizations point to the wrong values", a.target, b.target) },
        other => fail!("server class localizations are not discoverable", other),
    }
});

pub def memory_knowledge_does_not_claim_server_cpu_ownership: test::Test = test::should_ok(fn() {
    let memory: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "server_memory"};
    let relation: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "server_memory", id: "memory_parent_server"};
    let point = knowledge::knowledge_info_method_factory(payload)(
        key_input(edsl::KnowledgeKind::Dataset, "", "server_memory"));
    match checked_response(point) {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(dataset)) =>
            if dataset.target == memory && array::any(dataset.refs, fn(ref) { ref.target == relation }) {
                match lookup(relation) {
                    knowledge::DocResult::Found(link) =>
                        if string::contains(link.summary, "not memory measurements") { True }
                        else { fail!("memory relation lost its metric ownership warning", link) },
                    other => fail!("memory containment is undiscoverable", other),
                }
            } else { fail!("memory knowledge lost its declared containment reference", dataset) },
        other => fail!("memory topic is undiscoverable", other),
    }
});

pub def alarm_tenant_reference_knowledge_distinguishes_existing_entities: test::Test = test::should_ok(fn() {
    let dimension = knowledge::knowledge_info_method_factory(payload)(
        key_input(edsl::KnowledgeKind::Dimension, "current_alarm", "alarm_tenant_id"));
    let relation: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "current_alarm", id: "alarm_belongs_to_tenant"};
    match checked_response(dimension) {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if point.target.kind == edsl::KnowledgeKind::Dimension
                && point.target.owner == "current_alarm"
                && string::contains(point.summary, "orphan IDs") {
                match lookup(relation) {
                    knowledge::DocResult::Found(link) =>
                        if string::contains(link.summary, "existing Tenant entity") { True }
                        else { fail!("tenant ownership relation lost existence semantics", link) },
                    other => fail!("tenant ownership relation is undiscoverable", other),
                }
            } else { fail!("alarm tenant reference lost raw-ID semantics", point) },
        other => fail!("alarm tenant reference is undiscoverable", other),
    }
});

pub def alarm_name_suffix_is_discoverable_without_leaking_to_tenant_id: test::Test = test::should_ok(fn() {
    let name: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
        owner: "current_alarm", id: "alarm_name"};
    let tenant: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
        owner: "current_alarm", id: "alarm_tenant_id"};
    match lookup(name) {
        knowledge::DocResult::Found(point) => match point.dimension {
            Some(detail) => if array::any(detail.ops, fn(op) { op == edsl::FilterOp::EndsWith }) {
                match lookup(tenant) {
                    knowledge::DocResult::Found(other) => match other.dimension {
                        Some(tenant_detail) => if !array::any(tenant_detail.ops, fn(op) { op == edsl::FilterOp::EndsWith }) { True }
                            else { fail!("suffix capability leaked to tenant ID", other) },
                        None => fail!("tenant ID dimension lacks detail"),
                    },
                    other => fail!("tenant ID is undiscoverable", other),
                }
            } else { fail!("alarm name suffix capability is undiscoverable", point) },
            None => fail!("alarm name dimension lacks detail"),
        },
        other => fail!("alarm name dimension is undiscoverable", other),
    }
});

