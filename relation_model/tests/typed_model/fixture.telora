use ontology::model as model;

type TenantId = struct(String);
@check(fn(value) {
    if value == "" { Err(blame!("device id must be nonempty", value)) } else { Ok(()) }
})
type DeviceId = struct(String);
type SiteId = struct(String);
type DeviceIdentity = struct { tenant: TenantId, local: DeviceId };
type SiteIdentity = struct { tenant: TenantId, local: SiteId };
type Inventory = struct { tenant: TenantId, device: DeviceId, site: Option(SiteId) };
type Sample = struct { owner_tenant: TenantId, owner: DeviceId, sequence: Int, reading: Float };
type Connection = struct { tenant: TenantId, id: String, a: DeviceId, z: DeviceId };

def device: model::Entity(DeviceIdentity) = model::entity("device", DeviceIdentity.type);
def site: model::Entity(SiteIdentity) = model::entity("site", SiteIdentity.type);
def inventory: model::Dataset(Inventory) = model::dataset("inventory", "devices", Inventory.type, ["tenant", "device"]);
def samples: model::Dataset(Sample) = model::dataset("samples", "device_samples", Sample.type, ["owner_tenant", "owner", "sequence"]);
def connections: model::Dataset(Connection) = model::dataset("connections", "connections", Connection.type, ["tenant", "id"]);

def inventory_parts: Array(model::IdentityPart(Inventory, DeviceIdentity)) = [
    model::identity_part(model::field(Inventory.type, TenantId.type, "tenant"), model::field(DeviceIdentity.type, TenantId.type, "tenant")),
    model::identity_part(model::field(Inventory.type, DeviceId.type, "device"), model::field(DeviceIdentity.type, DeviceId.type, "local")),
];
def device_role: model::Role(Inventory) = model::role(inventory, device, "device", False, inventory_parts);
def site_role: model::Role(Inventory) = model::role(inventory, site, "site", True, [
    model::identity_part(model::field(Inventory.type, TenantId.type, "tenant"), model::field(SiteIdentity.type, TenantId.type, "tenant")),
    model::identity_part(model::optional_field(Inventory.type, SiteId.type, "site"), model::field(SiteIdentity.type, SiteId.type, "local")),
]);
def sample_role: model::Role(Sample) = model::role(samples, device, "subject", False, [
    model::identity_part(model::field(Sample.type, TenantId.type, "owner_tenant"), model::field(DeviceIdentity.type, TenantId.type, "tenant")),
    model::identity_part(model::field(Sample.type, DeviceId.type, "owner"), model::field(DeviceIdentity.type, DeviceId.type, "local")),
]);
def endpoint: Fn(String) -> model::Role(Connection) = fn(name) {
    model::role(connections, device, name, False, [
        model::identity_part(model::field(Connection.type, TenantId.type, "tenant"), model::field(DeviceIdentity.type, TenantId.type, "tenant")),
        model::identity_part(model::field(Connection.type, DeviceId.type, name), model::field(DeviceIdentity.type, DeviceId.type, "local")),
    ])
};

pub use self::{TenantId, DeviceId, SiteId, DeviceIdentity, SiteIdentity, Inventory, Sample, Connection,
    device, site, inventory, samples, connections, inventory_parts, device_role, site_role, sample_role, endpoint};
