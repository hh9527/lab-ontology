use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储磁盘／端口：保留来源 grain、原始文本与明确单位，不推断额外身份或关系。
use super::inventory as i;
use super::storage as storage;
use super::fc_switch as fc;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
# 来源没有唯一键；diskId 不是已经确认的全局身份。
# 主体字段用于知识归属，不声明全局唯一性。
@domain::subject("StorageDisk", "source_diskId")
@domain::dataset("source_SYS_StorageDisk", "SYS_StorageDisk", [])
@domain::relations(relations)
type SysStorageDisk = struct {
    @m::column("displayHealthStatus")
    @g::exact("source_SYS_StorageDisk__displayHealthStatus_raw")
    @v::map(
        SourceSYSStorageDiskDisplayHealthStatus.type,
        "source_SYS_StorageDisk__displayHealthStatus",
        [
            v::member(SourceSYSStorageDiskDisplayHealthStatus::Unknown, ["0"]),
            v::member(SourceSYSStorageDiskDisplayHealthStatus::Normal, ["1"]),
            v::member(SourceSYSStorageDiskDisplayHealthStatus::Faulty, ["2"]),
            v::member(SourceSYSStorageDiskDisplayHealthStatus::AboutToFail, ["3"]),
            v::member(SourceSYSStorageDiskDisplayHealthStatus::SingleLink, ["4"]),
            v::member(SourceSYSStorageDiskDisplayHealthStatus::Healthy, ["5"]),
            v::member(SourceSYSStorageDiskDisplayHealthStatus::Erasing, ["6"]),
            v::member(SourceSYSStorageDiskDisplayHealthStatus::ErasingAndVerifying, ["7"])
        ]
    )
    source_displayHealthStatus: String,
    @m::column("vendor")
    @g::search("source_SYS_StorageDisk__vendor")
    source_vendor: String,
    @m::column("tenantId")
    @g::exact("source_SYS_StorageDisk__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("name")
    @g::search("source_SYS_StorageDisk__name")
    source_name: String,
    @m::column("description")
    @g::search("source_SYS_StorageDisk__description")
    source_description: String,
    @m::column("virtualDisk")
    @g::field_view(
        g::dimension_group(
            "source_SYS_StorageDisk__virtualDisk",
            Bool.type,
            True,
            g::equality_filters
        ),
        "source_SYS_StorageDisk__virtualDisk",
        True,
        g::equality_filters
    )
    source_virtualDisk: Bool,
    @m::column("parentResId")
    @g::exact("source_SYS_StorageDisk__parentResId")
    source_parentResId: domain::Reference(storage::StorageById),
    @m::column("devRole")
    @g::exact("source_SYS_StorageDisk__devRole_raw")
    @v::map(
        SourceSYSStorageDiskDevRole.type,
        "source_SYS_StorageDisk__devRole",
        [
            v::member(SourceSYSStorageDiskDevRole::MetadataDisk, ["zk_disk"]),
            v::member(SourceSYSStorageDiskDevRole::PrimaryStorageOfTheStoragePool, ["main_storage"]),
            v::member(SourceSYSStorageDiskDevRole::CacheOfTheStoragePool, ["osd_cache"]),
            v::member(SourceSYSStorageDiskDevRole::SystemDisk, ["system_disk"]),
            v::member(SourceSYSStorageDiskDevRole::NotInUse, ["no_use"])
        ]
    )
    source_devRole: String,
    @m::column("bomId")
    @g::search("source_SYS_StorageDisk__bomId")
    source_bomId: String,
    @m::column("barCode")
    @g::search("source_SYS_StorageDisk__barCode")
    source_barCode: String,
    @m::column("role")
    @g::exact("source_SYS_StorageDisk__role_raw")
    @v::map(
        SourceSYSStorageDiskRole.type,
        "source_SYS_StorageDisk__role",
        [
            v::member(SourceSYSStorageDiskRole::MetadataDisk, ["zk_disk"]),
            v::member(SourceSYSStorageDiskRole::PrimaryStoragePoolStorage, ["main_storage"]),
            v::member(SourceSYSStorageDiskRole::StoragePoolCache, ["osd_cache"])
        ]
    )
    source_role: String,
    @m::column("totalCapacity")
    @g::exact("source_SYS_StorageDisk__totalCapacity")
    source_totalCapacity: String,
    @m::column("remainLife")
    @g::exact("source_SYS_StorageDisk__remainLife")
    source_remainLife: String,
    @m::column("wearRate")
    @g::exact("source_SYS_StorageDisk__wearRate")
    source_wearRate: String,
    @m::column("diskId")
    @g::exact("source_SYS_StorageDisk__diskId")
    source_diskId: String,
    @m::column("speed")
    @g::exact("source_SYS_StorageDisk__speed")
    source_speed: String,
    @m::column("sn")
    @g::search("source_SYS_StorageDisk__sn")
    source_sn: String,
    @m::column("firmware")
    @g::search("source_SYS_StorageDisk__firmware")
    source_firmware: String,
    @m::column("slotNumber")
    @g::exact("source_SYS_StorageDisk__slotNumber")
    source_slotNumber: String,
    @m::column("projectId")
    @g::exact("source_SYS_StorageDisk__projectId")
    source_projectId: String,
    @m::column("logicalType")
    @g::exact("source_SYS_StorageDisk__logicalType_raw")
    @v::map(
        SourceSYSStorageDiskLogicalType.type,
        "source_SYS_StorageDisk__logicalType",
        [
            v::member(SourceSYSStorageDiskLogicalType::FreeDisk, ["1"]),
            v::member(SourceSYSStorageDiskLogicalType::MemberDisk, ["2"]),
            v::member(SourceSYSStorageDiskLogicalType::HotSpareDisk, ["3"]),
            v::member(SourceSYSStorageDiskLogicalType::CacheDisk, ["4"])
        ]
    )
    source_logicalType: String,
    @m::column("diskType")
    @g::exact("source_SYS_StorageDisk__diskType_raw")
    @v::map(
        SourceSYSStorageDiskDiskType.type,
        "source_SYS_StorageDisk__diskType",
        [
            v::member(SourceSYSStorageDiskDiskType::Sas, ["sas_disk", "SAS"]),
            v::member(SourceSYSStorageDiskDiskType::SataDisk, ["sata_disk"]),
            v::member(SourceSYSStorageDiskDiskType::SsdCardOrNvMeSs, ["ssd_card"]),
            v::member(SourceSYSStorageDiskDiskType::Ssd, ["ssd_disk", "SSD"]),
            v::member(SourceSYSStorageDiskDiskType::NlSas, ["NL_SAS"]),
            v::member(SourceSYSStorageDiskDiskType::M2Disk, ["m2_disk"])
        ]
    )
    source_diskType: String,
};
def tenant: r::Endpoint = domain::endpoint(SysStorageDisk.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(SysStorageDisk.type, "source_parentResId");

@knowledge_policy::reverse_references(True)
type SourceSYSStorageDiskDisplayHealthStatus = enum {
    @ev::description("Unknown", "未知")
    Unknown,

    @ev::description("Normal", "正常")
    Normal,

    @ev::description("Faulty", "故障")
    Faulty,

    @ev::description("About to fail", "即将故障")
    AboutToFail,

    @ev::description("Single link", "单链路")
    SingleLink,

    @ev::description("healthy", "亚健康")
    Healthy,

    @ev::description("erasing", "擦除中")
    Erasing,

    @ev::description("erasing and verifying", "擦除校验中")
    ErasingAndVerifying,
};

@knowledge_policy::reverse_references(True)
type SourceSYSStorageDiskDevRole = enum {
    @ev::description("metadata disk", "元数据盘")
    MetadataDisk,

    @ev::description("primary storage of the storage pool", "存储池主存")
    PrimaryStorageOfTheStoragePool,

    @ev::description("cache of the storage pool", "存储池缓存")
    CacheOfTheStoragePool,

    @ev::description("system disk", "系统盘")
    SystemDisk,

    @ev::description("not in use", "未使用")
    NotInUse,
};

@knowledge_policy::reverse_references(True)
type SourceSYSStorageDiskRole = enum {
    @ev::description("metadata disk", "元数据盘")
    MetadataDisk,

    @ev::description("Primary storage pool storage", "存储池主存")
    PrimaryStoragePoolStorage,

    @ev::description("Storage pool cache", "存储池缓存")
    StoragePoolCache,
};

@knowledge_policy::reverse_references(True)
type SourceSYSStorageDiskLogicalType = enum {
    @ev::description("Free Disk", "空闲盘")
    FreeDisk,

    @ev::description("Member Disk", "成员盘")
    MemberDisk,

    @ev::description("Hot Spare Disk", "热备盘")
    HotSpareDisk,

    @ev::description("Cache Disk", "缓存盘")
    CacheDisk,
};

@knowledge_policy::reverse_references(True)
type SourceSYSStorageDiskDiskType = enum {
    Sas,

    @ev::description("SATA disk", "SATA盘")
    SataDisk,

    @ev::description("SSD card or NVMe SS", "SSD卡&NVMe SSD")
    SsdCardOrNvMeSs,

    Ssd,

    NlSas,

    @ev::description("M2 disk", "M2盘")
    M2Disk,
};

def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceAssociationSYS_StorageDisk",
        storage::subject,
        parent,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_SYS_StorageDiskAssociationX_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{SysStorageDisk};

pub use self::{
    SourceSYSStorageDiskDisplayHealthStatus,
    SourceSYSStorageDiskDevRole,
    SourceSYSStorageDiskRole,
    SourceSYSStorageDiskLogicalType,
    SourceSYSStorageDiskDiskType
};
