use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# Frame独立声明，保留源可空性和已声明粒度
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
# 可空DN仅表达来源引用，不虚构Frame主键或grain
type FrameDn = struct(String);
@domain::entity_by("Frame")
type FrameByDn = struct(FrameDn);

@domain::subject("Frame", "frame_dn")
@domain::dataset("frame", "I_EnterpriseFrame", [])
@edsl::reference("dn", ["frame_dn"])
@domain::relations(relations)
type IEnterpriseFrame = struct {
    @edsl::field_role(edsl::FieldRole::Appellation)
    @g::search("frame_name")
    name: String,
    @m::column("refParentNE")
    ref_parent_ne: Option(domain::Reference(i::DeviceById)),
    @m::column("tenantId")
    tenant_id: Option(domain::Reference(i::TenantById)),
    @m::column("operState")
    @v::classification(FrameOperState_domain, "frame_oper_state")
    oper_state: Option(Int),
    @m::column("manufacturer")
    @g::search("frame__manufacturer")
    source_manufacturer: Option(String),
    @m::column("softVersion")
    @g::search("frame__softVersion")
    source_softVersion: Option(String),
    @m::column("remark")
    @g::search("frame__remark")
    source_remark: Option(String),
    @m::column("projectId")
    @g::exact("frame__projectId")
    source_projectId: Option(String),
    @m::column("frameDn")
    @g::exact("frame__frameDn")
    frame_dn: Option(domain::Reference(FrameByDn)),
    @m::column("adminState")
    @v::classification(FrameAdminState_domain, "frame__adminState")
    source_adminState: Option(Int),
};
def device: r::Endpoint = domain::endpoint(IEnterpriseFrame.type, "ref_parent_ne");
def tenant: r::Endpoint = domain::endpoint(IEnterpriseFrame.type, "tenant_id");
def frame_reference: r::Endpoint = domain::endpoint(IEnterpriseFrame.type, "frame_dn");
@knowledge_policy::reverse_references(True)
type FrameOperState = enum {
    @ev::itag(3)
    @ev::itag(11)
    @ev::itag(13)
    @ev::itag(15)
    @ev::itag(16)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(2)
    @ev::itag(12)
    @ev::itag(17)
    @ev::description("error", "故障")
    Error,
    @ev::itag(4)
    @ev::description("offline", "离线")
    Offline,
    @ev::itag(-1)
    @ev::itag(1)
    @ev::description("unknow", "未知")
    Unknown,
};
def FrameOperState_domain: v::Domain(FrameOperState, Int) = v::from_enum(
    "FrameOperState",
    FrameOperState.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type FrameAdminState = enum {
    @ev::itag(4)
    @ev::itag(11)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(2)
    @ev::itag(3)
    @ev::itag(12)
    @ev::description("error", "故障")
    Error,
    @ev::itag(13)
    @ev::description("important", "回环")
    Important,
    @ev::itag(1)
    @ev::itag(-1)
    @ev::description("unknow", "未知")
    Unknown,
};
def FrameAdminState_domain: v::Domain(FrameAdminState, Int) = v::from_enum(
    "FrameAdminState",
    FrameAdminState.type,
    Int.type,
    False
);
def relations: Array(r::Relation) = [
    r::relation(
        "frame_belongs_to_device",
        device,
        i::device_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntNetworkElement_EnterpriseFrame",
        i::device_subject,
        device,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EnterpriseFrame_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations, FrameDn, FrameByDn, frame_reference};

pub use self::{IEnterpriseFrame};
