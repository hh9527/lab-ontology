}, "graph measure source may be multiplied by a joined relation");

pub def normal_wac_frame_context_observes_device_cpu_peak: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"frame",
        "nodes":[{"id":"frame","entity":"frame"},{"id":"device","entity":"device"},
                 {"id":"sample","entity":"device_kpi"}],
        "edges":[{"relation":"frame_belongs_to_device","from":"frame","to":"device"},
                 {"relation":"device_kpi_of_device","from":"sample","to":"device"}],
        "select":[{"node":"frame","dimension":"frame_name"},{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"sample","measure":"cpu_peak"}],
        "group_by_identity":["frame","device"],
        "filters":[{"node":"frame","dimension":"frame_oper_state","op":"eq","kind":"text","value":"normal"},
                   {"node":"device","dimension":"device_class","op":"eq","kind":"text","value":"WAC"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-01 00:00:00"}]}
    "#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "max(sample.cpuUsage) AS sample_cpu_peak")
        && string::contains(sq.sql, "frame.operState")
        && string::contains(sq.sql, "device.classification")
        && string::contains(sq.sql, "sample.ts >=") && string::contains(sq.sql, "sample.ts <")
        && string::contains(sq.sql, "GROUP BY frame.name, device.name, frame.id, frame.tenantId, device.id, device.tenant_id")
        && string::contains(pg.sql, "max(\"sample\".\"cpuUsage\")")
        && sq.bindings == pg.bindings { True }
    else { fail!("frame context changed Device CPU peak ownership or canonical/time filters", sq, pg) }
});

