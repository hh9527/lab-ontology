use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::disk_pool;
use crate::datasets::kpi_storage_enterprise_disk_domain;
@domain::subject("DiskPool", "obj_sys_id")
@domain::dataset("enterprise-disk-domain-2-kpi", "enterpriseDiskDomain2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseDiskDomain2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-disk-domain-2-kpi/obj_sys_id", ids::EnterpriseDiskDomain2KpiByObjSysId.type, True, [g::Filter::Eq]), "edd2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("edd2_count")
    obj_sys_id: ids::EnterpriseDiskDomain2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-disk-domain-2-kpi/obj_id", domain::Reference(ids::EnterpriseDiskDomain2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "edd2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseDiskDomain2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("edd2__dp", domain::endpoint(EnterpriseDiskDomain2Kpi.type, "obj_sys_id"), domain::endpoint(disk_pool::DiskPool.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("edd2__sedd", domain::endpoint(EnterpriseDiskDomain2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_disk_domain::KpiStorageEnterpriseDiskDomain.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
