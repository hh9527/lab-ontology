use ontology::semantic as domain;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_device as pon;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
# 仅沿用旧百分比尺度假定，尚未确认生产比例；不增加范围检查。
type AssumedOnlinePercent = struct(Float);
def online_statistics: samples::Group(AssumedOnlinePercent) = samples::group(
    "reported_network_online",
    AssumedOnlinePercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max],
    Some("%")
);
@domain::subject("PonElement", "source_resId")
@domain::dataset(
    "source_PonDeviceOnlineKPI",
    "PonDeviceOnlineKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
@domain::relations(relations)
type PonDeviceOnlineKPI = struct {
    @m::column("ts")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceOnlineKPI__ts",
            s::DateTimeUtc.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceOnlineKPI__ts",
        True,
        g::numeric_filters
    )
    @g::utc_bucket_view("source_PonDeviceOnlineKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_PonDeviceOnlineKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_PonDeviceOnlineKPI_utc_month", qb::UtcBucketUnit::Month)
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_PonDeviceOnlineKPI__resId")
    source_resId: domain::Reference(pon::PonElementById),
    @m::column("tenantId")
    @g::exact("source_PonDeviceOnlineKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_PonDeviceOnlineKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_PonDeviceOnlineKPI__projectId")
    source_projectId: String,
    @m::column("onlineRate")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceOnlineKPI__onlineRate",
            AssumedOnlinePercent.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceOnlineKPI__onlineRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        online_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "pon_online_table_rate_avg"},
            {statistic: samples::Statistic::Min, publish: "pon_online_table_rate_min"},
            {statistic: samples::Statistic::Max, publish: "pon_online_table_rate_max"}
        ]
    )
    source_onlineRate: AssumedOnlinePercent,
    @m::column("onlineRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceOnlineKPI__onlineRateEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceOnlineKPI__onlineRateEffcnt",
        True,
        g::numeric_filters
    )
    source_onlineRateEffcnt: EffectiveCount,
};
def owner: r::Endpoint = domain::endpoint(PonDeviceOnlineKPI.type, "source_resId");

def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElement_PonDeviceOnlineKPI",
        pon::subject,
        owner,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{PonDeviceOnlineKPI};
