use ontology::samples as samples;
use ontology::relations as relations;
use ontology::query as query;
# Development audit: export the prepared model, not a second parse of source.
use crate::typed::{payload, roots};
use ontology::ontology as edsl;
use ontology::quantity as quantity;
use ontology::preparation as preparation;
use std::array as array;
use std::codec as codec;
use std::value::{Value};

def scalar_name: Fn(Type) -> String = fn(ty) {
    if ty == String.type {
        "String"
    } else if ty == Int.type {
        "Int"
    } else if ty == Float.type {
        "Float"
    } else if ty == Bool.type {
        "Bool"
    } else {
        "Unsupported"
    }
};

type Equality = struct {
    from_column: String,
    to_column: String
};
type Key = enum {
    Eq(Equality),
    And(Array(Key)),
    Or(Array(Key))
};
type Field = struct {
    unit: Option(quantity::Unit),
    nullable: Bool,
    name: String,
    column: String,
    scalar: String,
    is_key: Bool,
    time: Option(edsl::TimeField),
};
type TimeRole = struct {
    field: String,
    encoding: edsl::TimeEncoding,
    semantics: edsl::TimeSemantics,
    logical_type: String
};
type SamplingStatistic = struct {
    id: String,
    field: String,
    mean: samples::MeanContract
};
type Dataset = struct {
    identity: Option(Array(String)),
    identity_attributes: Array(String),
    statistics: Array(SamplingStatistic),
    id: String,
    table: String,
    fields: Array(Field),
    grain: Array(String),
    time_roles: Array(TimeRole),
    scope: Array(edsl::PreparedGuard),
    sample_measures: Array(edsl::SampleMeasureEntry),
};
type Relation = struct {
    id: String,
    source_names: Array(String),
    from_dataset: String,
    to_dataset: String,
    from_table: String,
    to_table: String,
    cardinality: edsl::RelationCardinality,
    key: Key,
};
type Dimension = struct {
    groupable: Bool,
    projectable: Bool,
    id: String,
    dataset: String,
    column: String,
    computed: Bool,
    authorized: Bool,
    filterable: Bool,
    ops: Array(edsl::FilterOp),
    input_kinds: Array(edsl::FilterInputKind),
    half_open: Bool,
    values: Array(edsl::CanonicalValueSpec),
};
type Report = struct {
    revision: String,
    datasets: Array(Dataset),
    relations: Array(Relation),
    dimensions: Array(Dimension),
};
def column: Fn(edsl::EntityEntry, Int) -> String = fn(entity, index) {
    match array::find(
        entity.fields,
        fn(field) {
            field.index == index
        }
    ) {
        Some(field) => field.column,
        None => fail!("prepared field index missing", entity.id, index),
    }
};
def key: Fn(edsl::RelationEntry, edsl::RelationKey) -> Key = fn(relation, value) {
    match value {
        edsl::RelationKey::Eq(pair) => {
            let from = payload.entities[relation.from];
            let to = payload.entities[relation.to];
            Key::Eq({from_column: column(from, pair.from), to_column: column(to, pair.to),})
        },
        edsl::RelationKey::And(parts) => Key::And(
            array::map(
                parts,
                fn(part) {
                    key(relation, part)
                }
            )
        ),
        edsl::RelationKey::Or(parts) => Key::Or(
            array::map(
                parts,
                fn(part) {
                    key(relation, part)
                }
            )
        ),
    }
};

pub def report: Value = codec::encode(
    {
        revision: payload.revision,
        datasets: array::map(
            payload.entities,
            fn(entity) {
                {
                    id: entity.id,
                    table: entity.table,
                    identity: match entity.group_identity {
                        None => None,
                        Some(identity) => Some(
                            array::map(
                                identity.fields,
                                fn(index) {
                                    entity.fields[index].name
                                }
                            )
                        )
                    },
                    identity_attributes: match entity.group_identity {
                        None => [],
                        Some(identity) => array::map(
                            identity.attributes,
                            fn(index) {
                                entity.fields[index].name
                            }
                        )
                    },
                    statistics: array::map(
                        array::filter(
                            payload.measures,
                            fn(measure) {
                                measure.entity == entity.index && measure.aggregate == query::AggregateFunction::Avg
                            }
                        ),
                        fn(measure) {
                            let field = entity.fields[measure.field].name;
                            {
                                id: measure.id,
                                field,
                                mean: samples::mean_contract(entity.entity_type, field)
                            }.ty!(SamplingStatistic)
                        }
                    ),
                    grain: array::map(
                        entity.grain_fields,
                        fn(index) {
                            entity.fields[index].name
                        }
                    ),
                    time_roles: array::flat_map(
                        entity.fields,
                        fn(field) {
                            match field.time {
                                Some(time) => [
                                    {
                                        field: field.name,
                                        encoding: time.encoding,
                                        semantics: time.semantics,
                                        logical_type: match time.encoding {
                                            edsl::TimeEncoding::EpochMillis => "EpochMillis",
                                            edsl::TimeEncoding::DateText => "Date",
                                            edsl::TimeEncoding::LocalText => "DateTime",
                                            edsl::TimeEncoding::Rfc3339Text => "DateTimeUtc"
                                        }
                                    }.ty!(TimeRole)
                                ],
                                None => []
                            }
                        }
                    ),
                    scope: entity.scope,
                    sample_measures: entity.sample_measures,
                    fields: array::map(
                        entity.fields,
                        fn(field) {
                            {
                                name: field.name,
                                unit: match array::find(
                                    preparation::prepare(entity.entity_type).fields,
                                    fn(logical) {
                                        logical.name == field.name
                                    }
                                ) {
                                    Some(logical) => logical.unit,
                                    None => None
                                },
                                column: field.column,
                                scalar: scalar_name(field.ty),
                                nullable: field.nullable,
                                is_key: array::length(entity.grain_fields) == 1 && entity.grain_fields[
                                    0
                                ] == field.index,
                                time: field.time,
                            }.ty!(Field)
                        }
                    ),
                }.ty!(Dataset)
            }
        ),
        relations: array::map(
            payload.relations,
            fn(relation) {
                {
                    id: relation.id,
                    source_names: relations::source_names(roots, relation.id),
                    from_dataset: payload.entities[relation.from].id,
                    to_dataset: payload.entities[relation.to].id,
                    from_table: payload.entities[relation.from].table,
                    to_table: payload.entities[relation.to].table,
                    cardinality: relation.cardinality,
                    key: key(relation, relation.key),
                }.ty!(Relation)
            }
        ),
        dimensions: array::map(
            payload.dimensions,
            fn(dimension) {
                {
                    id: dimension.id,
                    dataset: payload.entities[dimension.entity].id,
                    column: column(payload.entities[dimension.entity], dimension.field),
                    computed: dimension.computed,
                    groupable: dimension.groupable,
                    projectable: dimension.projectable,
                    authorized: dimension.authorized,
                    filterable: dimension.filterable,
                    ops: dimension.ops,
                    input_kinds: dimension.input_kinds,
                    half_open: dimension.half_open,
                    values: dimension.canonical_values,
                }.ty!(Dimension)
            }
        ),
    }.ty!(Report)
);
