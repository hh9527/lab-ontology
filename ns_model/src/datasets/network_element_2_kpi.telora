use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::kpi_network_device_info;
use crate::datasets::network_element;
@domain::subject("NetworkElement", "obj_sys_id")
@domain::dataset("network-element-2-kpi", "EntNetworkElement2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type NetworkElement2Kpi = struct {
    @m::column("objSysId")
    @g::field_view(g::dimension_group("network-element-2-kpi/obj_sys_id", ids::NetworkElementById.type, True, [g::Filter::Eq]), "ne2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("ne2_count")
    obj_sys_id: ids::NetworkElementById,
    @g::field_view(g::dimension_group("network-element-2-kpi/obj_id", domain::Reference(ids::NetworkElement2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "ne2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::NetworkElement2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("ne2__ndi", domain::endpoint(NetworkElement2Kpi.type, "obj_id"), domain::endpoint(kpi_network_device_info::KpiNetworkDeviceInfo.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne2__ne_rev", domain::endpoint(NetworkElement2Kpi.type, "obj_sys_id"), domain::endpoint(network_element::NetworkElement.type, "id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
