use crate::model::{ payload };
use ontology::intent::{ query_intent_ast_factory };
use ontology::sqlite as sqlite;
use ontology::query as qb;
use std::array as array;
use std::json as json;
use std::string as string;
use std::test as test;

def lower: Fn(std::value::Value) -> qb::Query = fn(value) {
    sqlite::build_query(query_intent_ast_factory(payload, "public")(value))
};

pub def independent_kpi_qualifications_preserve_owner_grain: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[{"node":"device","dimension":"device_name"}], "count":"device",
        "group_by_identity":["device"],
        "exists":[
            {"anchor":"device", "nodes":[{"id":"cpu","entity":"device_kpi"}],
             "edges":[{"relation":"device_kpi_of_device","from":"cpu","to":"device"}],
             "filters":[
                 {"node":"cpu","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                 {"node":"cpu","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}],
             "having":[{"node":"cpu","measure":"cpu_usage","op":"gt","kind":"number","value":80.0}]},
            {"anchor":"device", "nodes":[{"id":"ports","entity":"device_kpi"}],
             "edges":[{"relation":"device_kpi_of_device","from":"ports","to":"device"}],
             "filters":[
                 {"node":"ports","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-02-01 00:00:00"},
                 {"node":"ports","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-04 00:00:00"}],
             "having":[{"node":"ports","measure":"port_count_sample_avg","op":"gt","kind":"number","value":20.0}]}
        ]
    }"#).unwrap!());
    if string::contains(query.sql, "EXISTS (SELECT 1 FROM NetworkDeviceKPI AS cpu")
        && string::contains(query.sql, "EXISTS (SELECT 1 FROM NetworkDeviceKPI AS ports")
        && string::contains(query.sql, "HAVING avg(cpu.cpuUsage) > ?3")
        && string::contains(query.sql, "HAVING avg(ports.portCount) > ?6")
        && string::contains(query.sql, "device.id = cpu.resId AND device.tenant_id = cpu.tenantId")
        && string::contains(query.sql, "device.id = ports.resId AND device.tenant_id = ports.tenantId")
        && string::contains(query.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && query.bindings == [qb::Val::String("2025-01-01 00:00:00"), qb::Val::String("2025-01-04 00:00:00"),
            qb::Val::Float(80.0), qb::Val::String("2025-02-01 00:00:00"),
            qb::Val::String("2025-02-04 00:00:00"), qb::Val::Float(20.0)] { True }
    else { fail!(`independent KPI qualification lost its identity, windows, or aggregates: \{query.sql}`, query.bindings) }
});

pub def qualification_rejects_unrelated_sample_relation: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "exists":[{"anchor":"device", "nodes":[{"id":"cpu","entity":"device_kpi"}],
            "edges":[{"relation":"server_current_alarm","from":"cpu","to":"device"}],
            "having":[{"node":"cpu","measure":"cpu_usage","op":"gt","kind":"number","value":80.0}]}]
    }"#).unwrap!())
}, "graph existence edge role or target does not match declared relation");

pub def qualification_rejects_wrong_measure_owner: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "exists":[{"anchor":"device", "nodes":[{"id":"cpu","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"cpu","to":"device"}],
            "having":[{"node":"cpu","measure":"device_count","op":"gt","kind":"int","value":1}]}]
    }"#).unwrap!())
}, "graph aggregate measure does not belong to its sample node");

pub def qualified_device_observes_an_independent_kpi_window: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"observed","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"observed","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"observed","measure":"port_count_sample_avg"}],
        "group_by_identity":["device"],
        "filters":[
            {"node":"observed","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-02-01 00:00:00"},
            {"node":"observed","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-04 00:00:00"}],
        "exists":[{"anchor":"device", "nodes":[{"id":"cpu","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"cpu","to":"device"}],
            "filters":[
                {"node":"cpu","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                {"node":"cpu","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}],
            "having":[{"node":"cpu","measure":"cpu_usage","op":"gt","kind":"number","value":80.0}]}]
    }"#).unwrap!());
    if string::contains(query.sql, "avg(observed.portCount) AS observed_port_count_sample_avg")
        && string::contains(query.sql, "HAVING avg(cpu.cpuUsage)")
        && string::contains(query.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && array::length(query.bindings) == 5 { True }
    else { fail!(`qualified KPI observation lost measure grain or window: \{query.sql}`, query.bindings) }
});

pub def measure_projection_rejects_another_fanout_join: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"observed","entity":"device_kpi"},
                 {"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"device_kpi_of_device","from":"observed","to":"device"},
                 {"relation":"device_current_alarm","from":"alarm","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"observed","measure":"port_count"}],
        "group_by_identity":["device"]
    }"#).unwrap!())
}, "graph measure source may be multiplied by a joined relation; use correlated EXISTS for qualification");

pub def measure_projection_rejects_wrong_owner: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "measures":[{"node":"device","measure":"cpu_usage"}]
    }"#).unwrap!())
}, "graph projection measure does not belong to its named node");

pub def measure_projection_rejects_ambiguous_combined_count: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "measures":[{"node":"device","measure":"device_count"}]
    }"#).unwrap!())
}, "graph cannot combine row count with measure projection; choose one aggregation grain");

pub def ic_physical_link_peer_is_traversable_from_both_endpoints: test::Test = test::should_ok(fn() {
    let from_a = lower(json::parse(r#"{
        "op":"graph", "root":"a", "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"physical_link_peer_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let from_z = lower(json::parse(r#"{
        "op":"graph", "root":"z", "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"physical_link_peer_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    if string::contains(from_a.sql, "a_ne_res_id") && string::contains(from_a.sql, "z_ne_res_id")
        && string::contains(from_a.sql, "tenantId") && string::contains(from_a.sql, " OR ")
        && string::contains(from_z.sql, " OR ") { True }
    else { fail!("IC bidirectional link lost A/Z or tenant ownership", from_a.sql, from_z.sql) }
});

pub def ic_peer_does_not_accept_an_unrelated_endpoint_relation: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"a", "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"physical_link_belongs_to_tenant","from":"a","to":"z"}],
        "select":[{"node":"z","dimension":"device_id"}]
    }"#).unwrap!())
}, "graph edge role or target does not match declared relation");

pub def alarm_server_component_requires_shared_tenant: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"alarm",
        "nodes":[{"id":"alarm","entity":"current_alarm"},{"id":"server","entity":"server_device"}],
        "edges":[{"relation":"server_current_alarm","from":"alarm","to":"server"}],
        "select":[{"node":"alarm","dimension":"alarm_csn"}],
        "exists":[{"anchor":"server",
            "nodes":[{"id":"fan","entity":"server_fan"},{"id":"tenant","entity":"tenant"}],
            "edges":[{"relation":"fan_parent_server","from":"fan","to":"server"},
                     {"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
            "constraints":[{"relation":"fan_belongs_to_tenant","from":"fan","to":"tenant"}],
            "filters":[{"node":"fan","dimension":"server_fan_manufacturer","op":"eq","kind":"text","value":"Huawei"}]
        }]
    }"#).unwrap!());
    if string::contains(query.sql, "alarm.MEDN = server.id")
        && string::contains(query.sql, "alarm.TENANTID = server.tenantId")
        && string::contains(query.sql, "server.oriResId = fan.parentResId")
        && string::contains(query.sql, "server.tenantId = tenant.TENANT_ID")
        && string::contains(query.sql, "fan.tenantId = tenant.TENANT_ID") { True }
    else { fail!(`component qualification lost tenant alignment: \{query.sql}`, query.bindings) }
});

pub def alarm_component_rejects_wrong_constraint_role: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"alarm",
        "nodes":[{"id":"alarm","entity":"current_alarm"},{"id":"server","entity":"server_device"}],
        "edges":[{"relation":"server_current_alarm","from":"alarm","to":"server"}],
        "select":[{"node":"alarm","dimension":"alarm_csn"}],
        "exists":[{"anchor":"server",
            "nodes":[{"id":"fan","entity":"server_fan"},{"id":"tenant","entity":"tenant"}],
            "edges":[{"relation":"fan_parent_server","from":"fan","to":"server"},
                     {"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
            "constraints":[{"relation":"device_belongs_to_tenant","from":"fan","to":"tenant"}]
        }]
    }"#).unwrap!())
}, "graph constraint relation does not match its named node roles");

pub def constraint_rejects_unknown_node: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"server", "nodes":[{"id":"server","entity":"server_device"}],
        "edges":[], "select":[], "count":"server",
        "constraints":[{"relation":"server_belongs_to_tenant","from":"server","to":"missing"}]
    }"#).unwrap!())
}, "graph node is not connected to the root");

pub def outer_constraint_preserves_named_relation_key: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"server",
        "nodes":[{"id":"server","entity":"server_device"},{"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "constraints":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "select":[{"node":"server","dimension":"server_name"}]
    }"#).unwrap!());
    if string::contains(query.sql, "WHERE server.tenantId = tenant.TENANT_ID") { True }
    else { fail!(`outer constraint did not materialize its named key: \{query.sql}`) }
});

pub def empty_population_rejects_where_constraint: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"server",
        "nodes":[{"id":"server","entity":"server_device"},{"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "constraints":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "include_empty":true, "select":[{"node":"server","dimension":"server_name"}]
    }"#).unwrap!())
}, "graph include_empty cannot apply constraint edges in WHERE without changing empty populations");
