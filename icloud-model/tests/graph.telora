        && string::contains(query.sql, "count(alarm.CSN)")
        && string::contains(query.sql, "WHERE (((alarm.SEVERITY = ?")
        && array::length(query.bindings) == 13 { True }
    else { fail!(`alarm severity grouping lost its business-value grain: \{query.sql}`, query.bindings) }
});

