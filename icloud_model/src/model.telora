# The published PON link is parentId=id only. Its global-ID scope and the
# candidate per-port sample grain need validation against production data.
@edsl::entity_id("pon_port_kpi")
@edsl::entity_source("PonDevicePonPortKPI", "ppk")
@edsl::dataset(edsl::DatasetKind::Metric, ["res_id", "tenant_id", "ts"], Some("ts"))
@edsl::dataset_description("PON port KPI samples", "Port-level samples under a PON device; sample identity is provisional")
@edsl::relation_description("pon_port_kpi_of_device", "PON port samples for device", "Published PON link equates parent ID to the device primary key")
@edsl::named_relation_key("pon_port_kpi_of_device", PonDevice.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "parent_id", to: "id"}))
@edsl::related_to({kind: edsl::KnowledgeKind::Dimension, owner: "pon_port_kpi", id: "pon_port_receive_sample"}, {kind: edsl::KnowledgeKind::Dimension, owner: "device_kpi", id: "device_kpi__ifUtilizationRate"})
@edsl::related_to({kind: edsl::KnowledgeKind::Dimension, owner: "pon_port_kpi", id: "pon_port_receive_sample"}, {kind: edsl::KnowledgeKind::Dimension, owner: "interface_kpi", id: "interface_kpi__ifInBandRate"})
type PonPortKpi = struct {
    @edsl::column("resId")
    @edsl::key()
    res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("parentId")
    parent_id: String,
    @edsl::column("portName")
    port_name: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("pon_port_kpi_ts", True, True, utc_window_ops, datetime_utc_inputs)
    @edsl::dimension_description("pon_port_kpi_ts", "PON port sample time", "UTC-second timestamp of each port KPI sample; use an explicit half-open window for period aggregates")
    ts: String,
    @edsl::column("ifInBandRate")
    @edsl::measure("pon_port_receive_usage", qb::AggregateFunction::Avg, [])
    @edsl::dimension("pon_port_receive_sample", True, True, int_ops, number_inputs)
    @edsl::dimension_description("pon_port_receive_sample", "PON port receive bandwidth utilization sample", "One source-reported PON-port receive bandwidth sample in percent, not device port occupancy or ONU receive usage.")
    @edsl::dimension_alias("pon_port_receive_sample", "PON端口接收带宽利用率")
    @edsl::dimension_alias("pon_port_receive_sample", "端口利用率")
    @edsl::metric_value("pon_port_receive_usage", qb::AggregateFunction::Avg, Some("%"))
    @edsl::sample_aggregate("pon_port_receive_sample_max", qb::AggregateFunction::Max, Some("%"))
    @edsl::sample_aggregate("pon_port_receive_sample_min", qb::AggregateFunction::Min, Some("%"))
    @edsl::measure_description("pon_port_receive_usage", "Average PON port receive bandwidth utilization", "Arithmetic mean of eligible raw PON-port receive samples in percent; not a peak or time-weighted rate. NULL is ignored.")
    @edsl::measure_description("pon_port_receive_sample_max", "Peak PON port receive bandwidth utilization sample", "Maximum eligible raw PON-port receive sample in percent, not maximum of period averages or device port occupancy; NULL is ignored.")
    @edsl::measure_description("pon_port_receive_sample_min", "Minimum PON port receive bandwidth utilization sample", "Minimum eligible raw PON-port receive sample in percent; ignores NULL, unlike raw ascending Top-1.")
    if_in_band_rate: Float,
    @edsl::column("projectId")
    @edsl::dimension("pon_port_kpi__projectId", True, True, text_ops, text_inputs)
    @edsl::dimension_description("pon_port_kpi__projectId", "Project ID", "Project ID.")
    source_projectId: String,
    @edsl::column("ifOutBandRate")
    @edsl::dimension("pon_port_kpi__ifOutBandRate", True, True, int_ops, number_inputs)
    @edsl::dimension_description("pon_port_kpi__ifOutBandRate", "PON port transmit bandwidth utilization sample", "Source-reported transmit bandwidth utilization of a PON optical port, not device-level port occupancy or ONU transmit usage. Preserve the source scale.")
    @edsl::dimension_alias("pon_port_kpi__ifOutBandRate", "PON端口发送带宽利用率")
    source_ifOutBandRate: Float,
    @edsl::column("onuHwOpticsTxPower")
    @edsl::dimension("pon_port_kpi__onuHwOpticsTxPower", True, True, int_ops, number_inputs)
    @edsl::dimension_description("pon_port_kpi__onuHwOpticsTxPower", "Optical Module Transmit Power", "Transmit optical power of an optical module.")
    source_onuHwOpticsTxPower: Float,
    @edsl::column("hwOpticsTemperature")
    @edsl::dimension("pon_port_kpi__hwOpticsTemperature", True, True, int_ops, number_inputs)
    @edsl::dimension_description("pon_port_kpi__hwOpticsTemperature", "PON Optical Module Temperature", "Temperature of a PON optical module.")
    source_hwOpticsTemperature: Float,
    @edsl::column("ifHCInOctetsSpeed")
    @edsl::dimension("pon_port_kpi__ifHCInOctetsSpeed", True, True, int_ops, number_inputs)
    @edsl::dimension_description("pon_port_kpi__ifHCInOctetsSpeed", "ifHCInOctetsSpeed", "Port receive rate within the period")
    source_ifHCInOctetsSpeed: Float,
    @edsl::column("ifHCOutOctetsSpeed")
    @edsl::dimension("pon_port_kpi__ifHCOutOctetsSpeed", True, True, int_ops, number_inputs)
    @edsl::dimension_description("pon_port_kpi__ifHCOutOctetsSpeed", "ifHCOutOctetsSpeed", "Port transmission rate within the period")
    source_ifHCOutOctetsSpeed: Float,
    @edsl::column("ifInBandRateEffcnt")
    @edsl::dimension("pon_port_kpi__ifInBandRateEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("pon_port_kpi__ifInBandRateEffcnt", "Valid Count of Optical Port Receive Bandwidth Utilization", "Number of times that valid statistics on the receive bandwidth usage of an optical port are collected.")
    source_ifInBandRateEffcnt: Int,
    @edsl::column("ifOutBandRateEffcnt")
    @edsl::dimension("pon_port_kpi__ifOutBandRateEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("pon_port_kpi__ifOutBandRateEffcnt", "Valid Count of Optical Port Transmit Bandwidth Utilization", "Number of times that valid statistics on the transmit bandwidth usage of an optical port are collected.")
    source_ifOutBandRateEffcnt: Int,
    @edsl::column("onuHwOpticsTxPowerEffcnt")
    @edsl::dimension("pon_port_kpi__onuHwOpticsTxPowerEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("pon_port_kpi__onuHwOpticsTxPowerEffcnt", "Valid Count of Optical Module Transmit Power", "Number of times that valid statistics on the transmit optical power of an optical module are collected.")
    source_onuHwOpticsTxPowerEffcnt: Int,
    @edsl::column("hwOpticsTemperatureEffcnt")
    @edsl::dimension("pon_port_kpi__hwOpticsTemperatureEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("pon_port_kpi__hwOpticsTemperatureEffcnt", "Valid Count of PON Optical Module Temperature", "Number of times that valid statistics on the PON optical module temperature are collected.")
    source_hwOpticsTemperatureEffcnt: Int,
};

# Source SSID samples link parentId to their AP's id.
# The candidate sampling grain still needs a production uniqueness check.
@edsl::entity_id("ap_radio_ssid_kpi")
@edsl::entity_source("NetworkApRadioSsidKPI", "ask")
@edsl::dataset(edsl::DatasetKind::Metric, ["res_id", "tenant_id", "ts"], Some("ts"))
@edsl::dataset_description("AP radio SSID samples", "SSID-level connected-terminal samples belonging to an AP")
@edsl::relation_description("ap_ssid_kpi_of_device", "SSID samples for AP", "SSID parent identifies the owning AP")
@edsl::named_relation_key("ap_ssid_kpi_of_device", Device.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "parent_id", to: "id"}))
type ApRadioSsidKpi = struct {
    @edsl::column("resId")
    @edsl::key()
    @edsl::dimension("ap_ssid_id", True, True, text_ops, text_inputs)
    res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("parentId")
    parent_id: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("ap_ssid_sample_time", True, True, utc_window_ops, datetime_utc_inputs)
    ts: String,
    @edsl::column("connectedTerminals")
    @edsl::dimension("ap_ssid_connected_terminals_raw", True, True, int_ops, int_inputs)
    @edsl::measure("ap_ssid_connected_terminals", qb::AggregateFunction::Sum, [])
    @edsl::metric_value("ap_ssid_connected_terminals", qb::AggregateFunction::Sum, None)
    @edsl::sample_aggregate("ap_ssid_connected_terminals_sample_avg", qb::AggregateFunction::Avg, None)
    @edsl::measure_description("ap_ssid_connected_terminals_sample_avg", "Mean connected terminals per SSID sample", "Average over eligible raw SSID sample rows, not equal-weight SSID means")
    connected_terminals: Int,
    @edsl::column("projectId")
    @edsl::dimension("ap_radio_ssid_kpi__projectId", True, True, text_ops, text_inputs)
    @edsl::dimension_description("ap_radio_ssid_kpi__projectId", "Project ID", "Project ID.")
    source_projectId: String,
    @edsl::column("ssidName")
    @edsl::dimension("ap_radio_ssid_kpi__ssidName", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("ap_radio_ssid_kpi__ssidName", "SSID Name", "SSID name. Raw text search, not semantic ordering or identifier normalization.")
    source_ssidName: String,
    @edsl::column("hwSsidAirportRecvBytes")
    @edsl::dimension("ap_radio_ssid_kpi__hwSsidAirportRecvBytes", True, True, int_ops, int_inputs)
    @edsl::dimension_description("ap_radio_ssid_kpi__hwSsidAirportRecvBytes", "Bytes Received by SSID", "Number of bytes received by the SSID, in bytes.")
    source_hwSsidAirportRecvBytes: Int,
    @edsl::column("hwSsidAirportTransmitBytes")
    @edsl::dimension("ap_radio_ssid_kpi__hwSsidAirportTransmitBytes", True, True, int_ops, int_inputs)
    @edsl::dimension_description("ap_radio_ssid_kpi__hwSsidAirportTransmitBytes", "Bytes Sent by SSID", "Number of bytes sent by the SSID, in bytes.")
    source_hwSsidAirportTransmitBytes: Int,
    @edsl::column("hwSsidAirportRecvBytesEffcnt")
    @edsl::dimension("ap_radio_ssid_kpi__hwSsidAirportRecvBytesEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("ap_radio_ssid_kpi__hwSsidAirportRecvBytesEffcnt", "Valid Bytes Received by SSID", "Number of valid bytes received by the SSID.")
    source_hwSsidAirportRecvBytesEffcnt: Int,
    @edsl::column("hwSsidAirportTransmitBytesEffcnt")
    @edsl::dimension("ap_radio_ssid_kpi__hwSsidAirportTransmitBytesEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("ap_radio_ssid_kpi__hwSsidAirportTransmitBytesEffcnt", "Valid Bytes Sent by SSID", "Number of valid bytes sent by the SSID.")
    source_hwSsidAirportTransmitBytesEffcnt: Int,
    @edsl::column("connectedTerminalsEffcnt")
    @edsl::dimension("ap_radio_ssid_kpi__connectedTerminalsEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("ap_radio_ssid_kpi__connectedTerminalsEffcnt", "Valid Connected Terminals", "Number of valid connected terminals.")
    source_connectedTerminalsEffcnt: Int,
};

# KPI rows have a separate sampling grain; declared metrics and raw-sample
