use ontology::registry as registry;
use ontology::ontology as edsl;
use ontology::scalars as scalars;
use std::test as test;

@registry::entity("identity")
type Identity = struct {
    id: String
};
@registry::dataset("plain", "plain_rows", [])
type Plain = struct {
    id: String
};
@registry::dataset("metrics", "metric_rows", ["id", "at"])
@registry::metric("at")
type Metric = struct {
    id: String,
    at: scalars::DateTimeUtc
};
@registry::dataset("events", "event_rows", ["id"])
@registry::event("at")
type Event = struct {
    id: String,
    at: scalars::DateTimeUtc
};

pub def entity_identity: test::Test = test::should_ok(
    fn() {
        let entity = registry::entity_of(Identity.type);
        entity.id == "identity" && entity.identity == Identity.type
    }
);
pub def absent_optional_spec: test::Test = test::should_ok(
    fn() {
        let value = registry::declaration(Plain.type);
        value.dataset.id == "plain" && value.dataset.source == "plain_rows" && value.dataset.grain == [] && value.kind == edsl::DatasetKind::Entity && value.clock == None
    }
);
pub def metric_and_event_keep_semantics: test::Test = test::should_ok(
    fn() {
        let metric = registry::declaration(Metric.type);
        let event = registry::declaration(Event.type);
        metric.kind == edsl::DatasetKind::Metric && metric.clock == Some("at") && metric.dataset.grain == [
            "id",
            "at"
        ] && event.kind == edsl::DatasetKind::Event && event.clock == Some("at")
    }
);
