use ontology::experimental::model as m;
use ontology::experimental::transform as t;
use ontology::experimental::scalars as s;
use ontology::ontology as edsl;
use ontology::query as qb;
use std::test as test;

type Row = struct { id: Int, at: Option(s::EpochMillis), local: s::LocalEpochMillis };
type Other = struct { at: s::EpochMillis };
def rows: m::Dataset(Row) = m::dataset("events", "event_rows", Row.type, ["id"]);
def base: t::Declaration = t::declare(rows, [], [], []);
def declared: t::Declaration = t::event(base, m::optional_field(Row.type, s::EpochMillis.type, "at"));
def profile: qb::PlanProfile = {allowed_operators: [qb::Operator::Source, qb::Operator::Column], allowed_aggregates: [], allowed_join_kinds: [], allowed_scalars: [], allow_distinct: False};
pub def event_preserves_grain_and_nullable_clock: test::Test = test::should_ok(fn() {
    t::prepare("events", [declared], profile).payload.entities[0].dataset == Some({kind: edsl::DatasetKind::Event, grain: ["id"], utc_time: Some("at")})
});
pub def event_requires_utc: test::Test = test::should_fail_with(fn() { t::event(base, m::field(Row.type, s::LocalEpochMillis.type, "local")) }, "metric clock requires a UTC instant type");
pub def event_rejects_other_row: test::Test = test::should_fail_with(fn() { t::event(base, m::field(Other.type, s::EpochMillis.type, "at")) }, "metric clock belongs to another dataset row");
pub def erased_event_clock_is_required: test::Test = test::should_fail_with(fn() { t::prepare("bad", [declared <~ {clock: None}], profile) }, "temporal dataset requires an explicit UTC clock");
pub def erased_event_clock_is_rechecked: test::Test = test::should_fail_with(fn() { t::prepare("bad", [declared <~ {clock: Some("local")}], profile) }, "metric clock requires a UTC instant field");
pub def event_requires_grain: test::Test = test::should_fail_with(fn() {
    t::prepare("bad", [t::event(t::declare(m::dataset("ungrained", "event_rows", Row.type, []), [], [], []), m::optional_field(Row.type, s::EpochMillis.type, "at"))], profile)
}, "metric dataset requires a complete sample grain");
pub def erased_entity_clock_is_rejected: test::Test = test::should_fail_with(fn() { t::prepare("bad", [declared <~ {kind: edsl::DatasetKind::Entity}], profile) }, "entity dataset cannot declare a temporal clock");
