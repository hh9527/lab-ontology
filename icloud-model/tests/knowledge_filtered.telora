use crate::model::{ payload, Device, Tenant, Site };
use ontology::knowledge as knowledge;
use ontology::ontology as edsl;
use ontology::query as qb;
use std::value::{ Value };
use std::codec as codec;
use std::array as array;
use std::test as test;

pub def device_name_search_requires_instr_during_model_preparation: test::Test = test::should_fail_with(fn() {
    let restricted = {...payload.profile, allowed_scalars: array::filter(payload.profile.allowed_scalars,
        fn(function) { function != qb::ScalarFunction::Instr })};
    edsl::build_root("no-device-search", [Device.type, Tenant.type, Site.type], restricted,
        fn(subject) { subject == "public" })
}, "declared dimension filter uses capabilities not allowed by the query profile");

pub def alarm_severity_measure_predicates_are_discoverable: test::Test = test::should_ok(fn() {
    let critical: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Measure, owner: "current_alarm", id: "critical_alarm_count"};
    let major: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Measure, owner: "current_alarm", id: "major_alarm_count"};
    let critical_point = knowledge::by_target(payload, "public", critical);
    let major_point = knowledge::by_target(payload, "public", major);
    match (critical_point, major_point) {
        (knowledge::DocResult::Found(c), knowledge::DocResult::Found(m)) =>
            match (c.measure, m.measure) {
                (Some(cm), Some(mm)) => match (cm.predicate, mm.predicate) {
                    (Some(cp), Some(mp)) => if cp.field == "severity" && mp.field == "severity"
                        && cp.input == edsl::FilterInput::Text("critical")
                        && mp.input == edsl::FilterInput::Text("major")
                        && array::any(c.refs, fn(ref) {
                            ref.target.kind == edsl::KnowledgeKind::Dimension
                                && ref.target.owner == "current_alarm" && ref.target.id == "alarm_severity"
                        })
                        && array::any(c.refs, fn(ref) {
                            ref.target.kind == edsl::KnowledgeKind::Value
                                && ref.target.owner == "alarm_severity" && ref.target.id == "critical"
                        })
                        && array::any(m.refs, fn(ref) {
                            ref.target.kind == edsl::KnowledgeKind::Value
                                && ref.target.owner == "alarm_severity" && ref.target.id == "major"
                        }) { True }
                    else { fail!("alarm knowledge lost separate severity predicates") },
                    _ => fail!("filtered alarm measures have no discoverable predicate"),
                },
                _ => fail!("alarm filtered measures have no measure details"),
            },
        _ => fail!("alarm filtered measures are not discoverable"),
    }
});

pub def on_demand_filtered_measure_matches_full_catalog: test::Test = test::should_ok(fn() {
    let request = Value::Object({target: Value::Object({kind: Value::String("measure"),
        owner: Value::String("current_alarm"), id: Value::String("critical_alarm_count")})});
    let response = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic")(request);
    match codec::decode@[knowledge::KnowledgeResponse](response).unwrap!() {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(item)) =>
            match item.measure {
                Some(measure) => if measure.predicate != None
                    && array::any(item.refs, fn(ref) {
                        ref.target.kind == edsl::KnowledgeKind::Value
                            && ref.target.owner == "alarm_severity" && ref.target.id == "critical"
                    }) { True }
                    else { fail!("on-demand filtered measure lost its predicate or value reference", item) },
                None => fail!("on-demand filtered measure lost its details", item),
            },
        other => fail!("on-demand measure returned a non-document", other),
    }
});
