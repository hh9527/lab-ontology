use ontology::semantic as domain;
use ontology::groups as g;
# 网络光模块来源：未声明唯一键，不推断设备与接口的复合身份。
use super::inventory as i;
use ontology::model as m;
# 主体字段用于知识归属，不声明全局唯一性。
@domain::subject("NetworkOpticalModule", "source_vendorSn")
@domain::dataset("source_EnterpriseOpticalModule", "I_EnterpriseOpticalModule", [])
type IEnterpriseOpticalModule = struct {
    @m::column("neResId")
    @g::exact("source_EnterpriseOpticalModule__neResId")
    source_neResId: String,
    @m::column("version")
    @g::search("source_EnterpriseOpticalModule__version")
    source_version: String,
    @m::column("vendorPn")
    @g::search("source_EnterpriseOpticalModule__vendorPn")
    source_vendorPn: String,
    @m::column("vendorName")
    @g::search("source_EnterpriseOpticalModule__vendorName")
    source_vendorName: String,
    @m::column("vendorSn")
    @g::search("source_EnterpriseOpticalModule__vendorSn")
    source_vendorSn: String,
    @m::column("ifName")
    @g::search("source_EnterpriseOpticalModule__ifName")
    source_ifName: String,
    @m::column("projectId")
    @g::exact("source_EnterpriseOpticalModule__projectId")
    source_projectId: String,
};

pub use self::{IEnterpriseOpticalModule};
