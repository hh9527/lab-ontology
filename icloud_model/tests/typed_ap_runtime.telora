use crate::typed::{payload};
use crate::model as baseline;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};

type Pair = struct {
    id: String,
    typed: qb::Query,
    baseline: qb::Query,
    postgres: qb::Query,
    columns: Array(intent::ResultColumn),
    baseline_columns: Array(intent::ResultColumn)
};
def pair: Fn(String, Value) -> Pair = fn(id, request) {
    let actual = intent::query_intent_ast_factory(payload)(request);
    let expected = intent::query_intent_ast_factory(baseline::payload)(request);
    {
        id,
        typed: sqlite::build_query(actual),
        baseline: sqlite::build_query(expected),
        postgres: postgres::build_query(actual),
        columns: intent::result_columns(payload, request, actual),
        baseline_columns: intent::result_columns(baseline::payload, request, expected)
    }
};
def entities: Array(String) = ["source_NetworkAPKPI", "source_NetworkApRadioKPI"];
def cases: Array(Pair) = array::concat(
    [
        array::map(
            array::filter(
                payload.dimensions,
                fn(dimension) {
                    array::any(
                        entities,
                        fn(entity) {
                            entity == payload.entities[dimension.entity].id
                        }
                    )
                }
            ),
            fn(dimension) {
                let entity = payload.entities[dimension.entity];
                pair(
                    `project_\{dimension.id}`,
                    json::parse(
                        `{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"\{entity.id}"}],"edges":[],"select":[{"node":"r","dimension":"\{dimension.id}"}]}`
                    ).unwrap!()
                )
            }
        ),
        array::map(
