use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# FC 交换机来源：分类不隐含范围过滤，容量字段不作未声明的单位换算。
use super::inventory as i;
use super::site as site;
use super::current_alarm as alarm;
use super::physical_link as link;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type FcSwitchId = struct(
    String
);
@registry::entity("fc_switch_entity")
type Identity = struct {
    id: FcSwitchId
};
# 来源说明未明确比例尺度，不从相似存储模型推定 0..1 或百分比。
type ReportedUtilization = struct(
    Float
);
type Megabytes = struct(
    Float
);
# 其余容量字段未明确单位，不默认与 MB 可互换。
type ReportedCapacity = struct(
    Float
);
type PortCount = struct(
    Int
);
@registry::dataset("source_FCSwitchDevice", "FCSwitchDevice", ["source_id"])
@registry::roles([subject, tenant, parent_site, project_site])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_FCSwitchDevice__usedCapacityRate",
                ReportedUtilization.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(FCSwitchDevice.type, ReportedUtilization.type, "source_usedCapacityRate")
            ),
            "source_FCSwitchDevice__usedCapacityRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_FCSwitchDevice__totalStoragePoolCapacity",
                ReportedCapacity.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    FCSwitchDevice.type,
                    ReportedCapacity.type,
                    "source_totalStoragePoolCapacity"
                )
            ),
            "source_FCSwitchDevice__totalStoragePoolCapacity",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_FCSwitchDevice__unUsedCapacity",
                Megabytes.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(FCSwitchDevice.type, Megabytes.type, "source_unUsedCapacity")),
            "source_FCSwitchDevice__unUsedCapacity",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::numeric_filters),
            g::input(m::field(FCSwitchDevice.type, s::EpochMillis.type, "source_createTime")),
            "source_FCSwitchDevice__createTime",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_FCSwitchDevice__usedCapacity",
                ReportedCapacity.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(FCSwitchDevice.type, ReportedCapacity.type, "source_usedCapacity")),
            "source_FCSwitchDevice__usedCapacity",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_FCSwitchDevice__totalCapacity",
                ReportedCapacity.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(FCSwitchDevice.type, ReportedCapacity.type, "source_totalCapacity")),
            "source_FCSwitchDevice__totalCapacity",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(FCSwitchDevice.type, String.type, "source_ipAddress"))),
            "source_FCSwitchDevice__ipAddress_ipv4",
            True,
            g::ipv4_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_FCSwitchDevice__portNum",
                PortCount.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(FCSwitchDevice.type, PortCount.type, "source_portNum")),
            "source_FCSwitchDevice__portNum",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
@registry::alternatives(alternatives)
type FCSwitchDevice = struct {
    @m::column("usedCapacityRate")
    source_usedCapacityRate: ReportedUtilization,
    @m::column("totalStoragePoolCapacity")
    source_totalStoragePoolCapacity: ReportedCapacity,
    @m::column("unUsedCapacity")
    source_unUsedCapacity: Megabytes,
    @m::column("subClassName")
    @v::classification(
        SourceFCSwitchDeviceSubClassName_domain,
        "source_FCSwitchDevice__subClassName"
    )
    source_subClassName: String,
    @m::column("nativeId")
    @g::exact("source_FCSwitchDevice__nativeId")
    source_nativeId: String,
    @m::column("name")
    @g::search("source_FCSwitchDevice__name")
    source_name: String,
    @m::column("createTime")
    source_createTime: s::EpochMillis,
    @m::column("regionId")
    @g::exact("source_FCSwitchDevice__regionId")
    source_regionId: String,
    @m::column("tenantId")
    @g::exact("source_FCSwitchDevice__tenantId")
    source_tenantId: i::TenantId,
    @m::column("id")
    @g::exact("source_FCSwitchDevice__id")
    source_id: FcSwitchId,
    @m::column("belongSeries")
    @g::search("source_FCSwitchDevice__belongSeries")
    source_belongSeries: String,
    @m::column("projectId")
    @g::exact("source_FCSwitchDevice__projectId")
    source_projectId: i::SiteId,
    @m::column("powerStatus")
    @v::classification(SourceFCSwitchDevicePowerStatus_domain, "source_FCSwitchDevice__powerStatus")
    source_powerStatus: String,
    @m::column("classification")
    @v::classification(
        SourceFCSwitchDeviceClassification_domain,
        "source_FCSwitchDevice__classification"
    )
    source_classification: String,
    @m::column("hotPatchVersion")
    @g::search("source_FCSwitchDevice__hotPatchVersion")
    source_hotPatchVersion: String,
    @m::column("deviceType")
    @v::classification(SourceFCSwitchDeviceDeviceType_domain, "source_FCSwitchDevice__deviceType")
    source_deviceType: String,
    @m::column("parentResId")
    @g::exact("source_FCSwitchDevice__parentResId")
    source_parentResId: i::SiteId,
    @m::column("runningStatus")
    @v::classification(
        SourceFCSwitchDeviceRunningStatus_domain,
        "source_FCSwitchDevice__runningStatus"
    )
    source_runningStatus: String,
    @m::column("healthStatus")
    @v::classification(
        SourceFCSwitchDeviceHealthStatus_domain,
        "source_FCSwitchDevice__healthStatus"
    )
    source_healthStatus: String,
    @m::column("connectStatus")
    @v::classification(
        SourceFCSwitchDeviceConnectStatus_domain,
        "source_FCSwitchDevice__connectStatus"
    )
    source_connectStatus: Int,
    @m::column("usedCapacity")
    source_usedCapacity: ReportedCapacity,
    @m::column("totalCapacity")
    source_totalCapacity: ReportedCapacity,
    @m::column("manufacturer")
    @g::search("source_FCSwitchDevice__manufacturer")
    source_manufacturer: String,
    @m::column("sn")
    @g::search("source_FCSwitchDevice__sn")
    source_sn: String,
    @m::column("productmodel")
    @g::search("source_FCSwitchDevice__productmodel")
    source_productmodel: String,
    @m::column("location")
    @g::search("source_FCSwitchDevice__location")
    source_location: String,
    @m::column("ipAddress")
    @g::search("source_FCSwitchDevice__ipAddress")
    source_ipAddress: String,
    @m::column("version")
    @g::search("source_FCSwitchDevice__version")
    source_version: String,
    @m::column("serialNum")
    @g::search("source_FCSwitchDevice__serialNum")
    source_serialNum: String,
    @m::column("virtualFabricId")
    @g::exact("source_FCSwitchDevice__virtualFabricId")
    source_virtualFabricId: String,
    @m::column("portNum")
    source_portNum: PortCount,
    @m::column("domainId")
    @g::exact("source_FCSwitchDevice__domainId")
    source_domainId: String,
    @m::column("fabricWwn")
    @g::search("source_FCSwitchDevice__fabricWwn")
    source_fabricWwn: String,
    @m::column("wwn")
    @g::search("source_FCSwitchDevice__wwn")
    source_wwn: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(FCSwitchDevice) = registry::dataset_of(FCSwitchDevice.type);
def subject: m::Role(FCSwitchDevice) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(FCSwitchDevice.type, FcSwitchId.type, "source_id"),
            m::field(Identity.type, FcSwitchId.type, "id")
        )
    ]
);
def tenant: m::Role(FCSwitchDevice) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(FCSwitchDevice.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent_site: m::Role(FCSwitchDevice) = m::role(
    dataset,
    site::entity,
    "parent_site",
    False,
    [
        m::identity_part(
            m::field(FCSwitchDevice.type, i::SiteId.type, "source_parentResId"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def project_site: m::Role(FCSwitchDevice) = m::role(
    dataset,
    site::entity,
    "project_site",
    False,
    [
        m::identity_part(
            m::field(FCSwitchDevice.type, i::SiteId.type, "source_projectId"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def alarm_reference: m::Role(alarm::TCurrentAlarm) = m::role(
    alarm::dataset,
    entity,
    "fc_alarm_reference",
    False,
    [
        m::reference_part(
            m::field(alarm::TCurrentAlarm.type, String.type, "res_id"),
            m::field(Identity.type, FcSwitchId.type, "id")
        )
    ]
);
def a_reference: m::Role(link::EnterprisePhysicalLink) = m::role(
    link::dataset,
    entity,
    "fc_a_reference",
    False,
    [
        m::reference_part(
            m::field(link::EnterprisePhysicalLink.type, String.type, "a_ne_res_id"),
            m::field(Identity.type, FcSwitchId.type, "id")
        )
    ]
);
def z_reference: m::Role(link::EnterprisePhysicalLink) = m::role(
    link::dataset,
    entity,
    "fc_z_reference",
    False,
    [
        m::reference_part(
            m::field(link::EnterprisePhysicalLink.type, String.type, "z_ne_res_id"),
            m::field(Identity.type, FcSwitchId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceSubClassName = enum {
    @ev::rename("EnterpriseStorage")
    @ev::description("Enterprise flash storage device", "闪存存储设备")
    EnterpriseFlashStorageDevice,
    @ev::rename("FusionStorageDevice")
    @ev::description("Distributed storage device", "分布式存储设备")
    DistributedStorageDevice,
    @ev::rename("SmisStorageDevice")
    @ev::description("Lenovo SMIS storage device", "联想SISM存储设备")
    LenovoSmisStorageDevice,
    @ev::rename("HuaweiSmisStorageDevice")
    @ev::description("Huawei SMIS storage device", "华为SMIS存储设备")
    HuaweiSmisStorageDevice,
    @ev::rename("SYS_ProtectDevice")
    @ev::description(
        "Data protection appliance and backup cluster storage device",
        "数据保护一体机、备份集群存储设备"
    )
    DataProtectionApplianceAndBackupClusterStorageDevice,
    @ev::rename("DsmStorageDevice")
    @ev::description("Mobile specification DSM and DFS storage device", "移动规范DSM、DFS存储设备")
    MobileSpecificationDsmAndDfsStorageDevice,
    @ev::rename("HPEStorageDevice")
    @ev::description("HPE storage device", "HP存储设备")
    HpeStorageDevice,
    @ev::rename("VSPStorageDevice")
    @ev::description("VSP storage device", "VSP存储设备")
    VspStorageDevice,
    @ev::rename("FCSwitchDevice")
    @ev::description("FC switch device", "FC交换机")
    FcSwitchDevice,
};
def SourceFCSwitchDeviceSubClassName_domain: v::Domain(SourceFCSwitchDeviceSubClassName, String) = v::from_enum(
    "SourceFCSwitchDeviceSubClassName",
    SourceFCSwitchDeviceSubClassName.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDevicePowerStatus = enum {
    @ev::rename("poweroff")
    @ev::description("power off", "下电")
    PowerOff,
    @ev::rename("poweron")
    @ev::description("power on", "上电")
    PowerOn,
};
def SourceFCSwitchDevicePowerStatus_domain: v::Domain(SourceFCSwitchDevicePowerStatus, String) = v::from_enum(
    "SourceFCSwitchDevicePowerStatus",
    SourceFCSwitchDevicePowerStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceClassification = enum {
    @ev::rename("HuaweiStorage")
    @ev::description("Huawei Storage Device", "华为存储设备")
    HuaweiStorageDevice,
    @ev::rename("FcSwitch")
    @ev::description("Fibre Channel Switch", "交换机")
    FibreChannelSwitch,
    @ev::rename("ThirdPartyStorage")
    @ev::description("Third-Party Storage Device", "三方存储设备")
    ThirdPartyStorageDevice,
};
def SourceFCSwitchDeviceClassification_domain: v::Domain(SourceFCSwitchDeviceClassification, String) = v::from_enum(
    "SourceFCSwitchDeviceClassification",
    SourceFCSwitchDeviceClassification.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceDeviceType = enum {
    @ev::rename("storage")
    @ev::description("storage device", "存储设备")
    StorageDevice,
    @ev::rename("fcswitch")
    @ev::description("FC switch", "FC交换机")
    FcSwitch,
