# Behavior checks for the dog kennel intent-to-Query lowering.
#
# Each exported definition lowers one documented intent and asserts that the
# produced Query has consistent placeholders and bindings.  A failure fails the
# suite, so `telora test query` reports it.

use crate::model::{ payload };
use std::test as test;
use ontology::ontology as edsl;
use ontology::intent::{ query_intent_lower_factory };
use ontology::query as qb;
use ontology::sqlite as sqlite;
use std::array as array;
use std::json as json;
use std::string as string;
use std::value::{ Value };

pub def lowering_rejects_non_object_case: test::Test = test::should_fail_with(fn() {
    let lower = query_intent_lower_factory(payload, "resolver", sqlite::render_query_plan_with_context);
    lower(Value::Int(7))
}, "intent field is not an object");

def lower_intent: Fn(Value) -> qb::Query =
    query_intent_lower_factory(payload, "resolver", sqlite::render_query_plan_with_context);

def placeholder_count: Fn(String) -> Int = fn(sql) {
    let parts = string::split(sql, "?");
    array::length(parts) - 1
};

def check_query: Fn(String, Value, Int) -> Bool = fn(label, intent, expected_bindings) {
    let query: qb::Query = lower_intent(intent);
    let placeholders = placeholder_count(query.sql);
    let bindings = array::length(query.bindings);
    if placeholders == bindings && bindings == expected_bindings {
        True
    } else {
        fail!("query assertion failed", label, query.sql, bindings, placeholders)
    }
};

def check_deterministic: Fn(String, Value) -> Bool = fn(label, intent) {
    let first: qb::Query = lower_intent(intent);
    let second: qb::Query = lower_intent(intent);
    if first.sql == second.sql && first.bindings == second.bindings {
        True
    } else {
        fail!("non-deterministic lowering", label)
    }
};

