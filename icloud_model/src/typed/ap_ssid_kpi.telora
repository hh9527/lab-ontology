# SSID 样本独立声明：显式保留连接终端原始样本之和，不解释为去重终端数。
use super::inventory as i;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::quantity as q;
use ontology::experimental::scalars as s;
use ontology::experimental::samples as samples;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
type SsidId = struct(String);
# 来源字节数保留 Int，不能直接用 Float 表示的通用 Bytes 改变公开类型或精度。
type ByteCount = struct(Int);
type Row = struct {
    res_id: SsidId,
    tenant_id: i::TenantId,
    parent_id: i::DeviceId,
    ts: s::Rfc3339Utc,
    connected_terminals: q::Count,
    source_projectId: String,
    source_ssidName: String,
    source_hwSsidAirportRecvBytes: ByteCount,
    source_hwSsidAirportTransmitBytes: ByteCount,
    source_hwSsidAirportRecvBytesEffcnt: Int,
    source_hwSsidAirportTransmitBytesEffcnt: Int,
    source_connectedTerminalsEffcnt: Int,
};
def dataset: m::Dataset(Row) = m::dataset("ap_radio_ssid_kpi", "NetworkApRadioSsidKPI", Row.type, ["res_id", "tenant_id", "ts"]);
def device: m::Role(Row) = m::role(dataset, i::device, "device", False, [m::identity_part(m::field(Row.type, i::DeviceId.type, "parent_id"), m::field(i::DeviceIdentity.type, i::DeviceId.type, "id"))]);
def terminal_statistics: samples::Group(q::Count) = samples::group("ssid_terminals", q::Count.type, samples::Statistic::Sum, [samples::Statistic::Mean], None);
def byte_statistics: samples::Group(ByteCount) = samples::group("ssid_bytes", ByteCount.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("byte"));
def declaration: t::Declaration = t::with_samples(t::metric(t::map_columns(t::declare(dataset, [device], [
    i::exact(dataset, m::field(Row.type, SsidId.type, "res_id"), "ap_ssid_id"),
    g::dimension(dataset, g::dimension_group("ap_ssid_sample_time", s::Rfc3339Utc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), g::input(m::field(Row.type, s::Rfc3339Utc.type, "ts")), "ap_ssid_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::Rfc3339Utc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::Rfc3339Utc.type, "ts")), qb::UtcBucketUnit::Hour), "ap_radio_ssid_kpi_utc_hour", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::Rfc3339Utc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::Rfc3339Utc.type, "ts")), qb::UtcBucketUnit::Day), "ap_radio_ssid_kpi_utc_day", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::Rfc3339Utc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::Rfc3339Utc.type, "ts")), qb::UtcBucketUnit::Month), "ap_radio_ssid_kpi_utc_month", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("ap_ssid_connected_terminals_raw", q::Count.type, True, g::numeric_filters), g::input(m::field(Row.type, q::Count.type, "connected_terminals")), "ap_ssid_connected_terminals_raw", True, g::numeric_filters),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "ap_radio_ssid_kpi__projectId"),
    i::search(dataset, m::field(Row.type, String.type, "source_ssidName"), "ap_radio_ssid_kpi__ssidName"),
    g::dimension(dataset, g::dimension_group("ap_radio_ssid_kpi__hwSsidAirportRecvBytes", ByteCount.type, True, g::numeric_filters), g::input(m::field(Row.type, ByteCount.type, "source_hwSsidAirportRecvBytes")), "ap_radio_ssid_kpi__hwSsidAirportRecvBytes", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("ap_radio_ssid_kpi__hwSsidAirportTransmitBytes", ByteCount.type, True, g::numeric_filters), g::input(m::field(Row.type, ByteCount.type, "source_hwSsidAirportTransmitBytes")), "ap_radio_ssid_kpi__hwSsidAirportTransmitBytes", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("ap_radio_ssid_kpi__hwSsidAirportRecvBytesEffcnt", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_hwSsidAirportRecvBytesEffcnt")), "ap_radio_ssid_kpi__hwSsidAirportRecvBytesEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("ap_radio_ssid_kpi__hwSsidAirportTransmitBytesEffcnt", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_hwSsidAirportTransmitBytesEffcnt")), "ap_radio_ssid_kpi__hwSsidAirportTransmitBytesEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("ap_radio_ssid_kpi__connectedTerminalsEffcnt", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_connectedTerminalsEffcnt")), "ap_radio_ssid_kpi__connectedTerminalsEffcnt", True, g::numeric_filters),
], []), [
    t::column(m::field(Row.type, SsidId.type, "res_id"), "resId"),
    t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::field(Row.type, i::DeviceId.type, "parent_id"), "parentId"),
    t::column(m::field(Row.type, s::Rfc3339Utc.type, "ts"), "ts"),
    t::column(m::field(Row.type, q::Count.type, "connected_terminals"), "connectedTerminals"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::field(Row.type, String.type, "source_ssidName"), "ssidName"),
    t::column(m::field(Row.type, ByteCount.type, "source_hwSsidAirportRecvBytes"), "hwSsidAirportRecvBytes"),
    t::column(m::field(Row.type, ByteCount.type, "source_hwSsidAirportTransmitBytes"), "hwSsidAirportTransmitBytes"),
    t::column(m::field(Row.type, Int.type, "source_hwSsidAirportRecvBytesEffcnt"), "hwSsidAirportRecvBytesEffcnt"),
    t::column(m::field(Row.type, Int.type, "source_hwSsidAirportTransmitBytesEffcnt"), "hwSsidAirportTransmitBytesEffcnt"),
    t::column(m::field(Row.type, Int.type, "source_connectedTerminalsEffcnt"), "connectedTerminalsEffcnt"),
]), m::field(Row.type, s::Rfc3339Utc.type, "ts")), [
    samples::bind(dataset, terminal_statistics, m::field(Row.type, q::Count.type, "connected_terminals"), [{statistic: samples::Statistic::Sum, publish: "ap_ssid_connected_terminals"}, {statistic: samples::Statistic::Mean, publish: "ap_ssid_connected_terminals_sample_avg"}]),
    samples::bind(dataset, byte_statistics, m::field(Row.type, ByteCount.type, "source_hwSsidAirportRecvBytes"), [{statistic: samples::Statistic::Mean, publish: "ap_ssid_receive_bytes"}, {statistic: samples::Statistic::Max, publish: "ap_ssid_receive_bytes_max"}, {statistic: samples::Statistic::Min, publish: "ap_ssid_receive_bytes_min"}]),
    samples::bind(dataset, byte_statistics, m::field(Row.type, ByteCount.type, "source_hwSsidAirportTransmitBytes"), [{statistic: samples::Statistic::Mean, publish: "ap_ssid_transmit_bytes"}, {statistic: samples::Statistic::Max, publish: "ap_ssid_transmit_bytes_max"}, {statistic: samples::Statistic::Min, publish: "ap_ssid_transmit_bytes_min"}]),
]);
def relations: Array(r::Relation) = [
    r::relation("ap_ssid_kpi_of_device", dataset, device, i::devices, i::device_subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("source_EntNetworkElement_NetworkApRadioSsidKPI", i::devices, i::device_subject, dataset, device, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
pub use self::{declaration, relations};
