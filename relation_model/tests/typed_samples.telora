use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::samples as samples;
use ontology::experimental::quantity as q;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};
use std::test as test;

type Row = struct { seq: Int, owner: String, at: Option(s::EpochMillis), local: s::LocalEpochMillis, rx: Option(q::BytesPerSecond), tx: Option(q::BytesPerSecond) };
def rows: m::Dataset(Row) = m::dataset("samples", "sample_rows", Row.type, ["seq"]);
def statistics: samples::Group(q::BytesPerSecond) = samples::group("reported_rate", q::BytesPerSecond.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max, samples::Statistic::Latest], Some("byte/s"));
def names: Fn(String) -> Array(samples::Name) = fn(prefix) { [
    {statistic: samples::Statistic::Mean, publish: `\{prefix}_mean`},
    {statistic: samples::Statistic::Min, publish: `\{prefix}_min`},
    {statistic: samples::Statistic::Max, publish: `\{prefix}_max`},
    {statistic: samples::Statistic::Latest, publish: `\{prefix}_latest`},
] };
def rx: samples::Binding(Row) = samples::bind(rows, statistics, m::optional_field(Row.type, q::BytesPerSecond.type, "rx"), names("rx"));
def tx: samples::Binding(Row) = samples::bind(rows, statistics, m::optional_field(Row.type, q::BytesPerSecond.type, "tx"), names("tx"));
def base: t::Declaration = t::declare(rows, [], [
    g::dimension(rows, g::dimension_group("owners", String.type, True, g::equality_filters), g::input(m::field(Row.type, String.type, "owner")), "owner", True, g::equality_filters),
    g::dimension(rows, g::dimension_group("at", s::EpochMillis.type, True, g::time_filters), g::input(m::optional_field(Row.type, s::EpochMillis.type, "at")), "at", True, g::time_filters),
], ["total"]);
def declared: t::Declaration = t::with_samples(t::metric(t::map_columns(base, [
    t::column(m::optional_field(Row.type, s::EpochMillis.type, "at"), "UTC_MS"),
    t::column(m::optional_field(Row.type, q::BytesPerSecond.type, "rx"), "RX_RATE"),
    t::column(m::optional_field(Row.type, q::BytesPerSecond.type, "tx"), "TX_RATE"),
]), m::optional_field(Row.type, s::EpochMillis.type, "at")), [rx, tx]);
def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Column, qb::Operator::Project, qb::Operator::Aggregate, qb::Operator::Group, qb::Operator::Order, qb::Operator::Partition, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Filter],
    allowed_aggregates: [qb::AggregateFunction::Sum, qb::AggregateFunction::Avg, qb::AggregateFunction::Min, qb::AggregateFunction::Max, qb::AggregateFunction::Latest, qb::AggregateFunction::Count],
    allowed_join_kinds: [], allowed_scalars: [qb::ScalarFunction::Gt, qb::ScalarFunction::Le, qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Ge, qb::ScalarFunction::Lt, qb::ScalarFunction::And], allow_distinct: False,
};
def payload: edsl::PreparedPayload = t::prepare("samples", [declared], profile).payload;
def ast: Fn(String) -> qb::QueryAst = fn(extra) { intent::query_intent_ast_factory(payload)(json::parse(`{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"samples"}],"edges":[],\{extra}}`).unwrap!()) };
type RuntimeCase = struct { id: String, sqlite: qb::Query, postgres: qb::Query };
def runtime_case: Fn(String, String) -> RuntimeCase = fn(id, extra) { let query = ast(extra); {id, sqlite: sqlite::build_query(query), postgres: postgres::build_query(query)} };
pub def runtime_cases: Value = codec::encode([
    integer_case, text_case, count_case,
    runtime_case("mixed", r#""select":[{"node":"s","dimension":"owner"}],"measures":[{"node":"s","measure":"rx_mean"},{"node":"s","measure":"rx_min"},{"node":"s","measure":"rx_max"},{"node":"s","measure":"rx_latest"},{"node":"s","measure":"tx_latest"},{"node":"s","measure":"total"}]"#),
    runtime_case("window", r#""select":[{"node":"s","dimension":"owner"}],"measures":[{"node":"s","measure":"rx_latest"}],"time_windows":[{"node":"s","dimension":"at","start":0,"end":2}]"#),
    runtime_case("total", r#""select":[],"measures":[{"node":"s","measure":"rx_mean"},{"node":"s","measure":"rx_latest"},{"node":"s","measure":"total"}]"#),
]);
pub def samples_require_explicit_metric_clock: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [t::checked_with_samples(base, [rx])], profile) }, "sample measures require an explicit metric clock");
pub def local_clock_cannot_be_authoritative_utc: test::Test = test::should_fail_with(fn() { t::checked_metric(base, m::checked_field(Row.type, s::LocalEpochMillis.type, "local")) }, "metric clock requires a UTC instant type");
pub def erased_clock_is_rechecked: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [declared <~ {clock: Some("local")}], profile) }, "metric clock requires a UTC instant field");
pub def erased_sample_owner_is_rechecked: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [declared <~ {samples: [samples::binding_facts(rx) <~ {dataset: "other"}]}], profile) }, "sample binding belongs to another dataset");
pub def samples_cannot_claim_time_as_numeric_gauge: test::Test = test::should_fail_with(fn() { samples::checked_group("bad", s::EpochMillis.type, samples::Statistic::Mean, [], None) }, "sample group requires a name and numeric sample type");
pub def sample_statistics_cannot_repeat: test::Test = test::should_fail_with(fn() { samples::checked_group("bad", q::BytesPerSecond.type, samples::Statistic::Mean, [samples::Statistic::Mean], None) }, "sample group statistics must be distinct");
pub def every_statistic_needs_an_explicit_name: test::Test = test::should_fail_with(fn() { samples::checked_bind(rows, statistics, m::checked_optional_field(Row.type, q::BytesPerSecond.type, "rx"), []) }, "sample binding must name every statistic exactly once");
pub def sample_public_names_cannot_repeat: test::Test = test::should_fail_with(fn() { samples::checked_bind(rows, statistics, m::checked_optional_field(Row.type, q::BytesPerSecond.type, "rx"), array::map(names("rx"), fn(name) { name <~ {publish: "duplicate"} })) }, "sample binding public names must be distinct SQL identifiers");
pub def repeated_group_bindings_cannot_publish_the_same_measure: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [t::checked_with_samples(declared, [rx, rx])], profile) }, "typed transform measure ids must be unique");
pub def metric_dataset_retains_sample_grain_and_clock: test::Test = test::should_ok(fn() { payload.entities[0].dataset == Some({kind: edsl::DatasetKind::Metric, grain: ["seq"], utc_time: Some("at")}) });
pub def sample_unit_and_primary_role_are_preserved: test::Test = test::should_ok(fn() { payload.entities[0].sample_measures[0] == {id: "rx_mean", field: "rx", aggregate: qb::AggregateFunction::Avg, unit: Some("byte/s"), role: edsl::SampleMeasureRole::Primary} });
pub def metric_requires_a_sample_grain: test::Test = test::should_fail_with(fn() {
    let ungrained = m::checked_dataset("ungrained", "sample_rows", Row.type, []);
    t::checked_prepare("bad", [t::checked_metric(t::checked_declare(ungrained, [], [], []), m::checked_optional_field(Row.type, s::EpochMillis.type, "at"))], profile)
}, "metric dataset requires a complete sample grain");
pub def latest_backend_capability_is_required: test::Test = test::should_fail_with(fn() {
    t::checked_prepare("bad", [declared], profile <~ {allowed_aggregates: [qb::AggregateFunction::Avg, qb::AggregateFunction::Min, qb::AggregateFunction::Max, qb::AggregateFunction::Count]})
}, "declared measure uses aggregate, filter or scalar capabilities not allowed by the query profile");
pub def erased_latest_clock_role_is_rechecked: test::Test = test::should_fail_with(fn() {
    let entity = payload.entities[0];
    let fields = array::map(entity.fields, fn(field) { if field.name == "at" { field <~ {time: Some({semantics: edsl::TimeSemantics::Local, encoding: edsl::TimeEncoding::EpochMillis})} } else { field } });
    edsl::validate_transform_contract(payload <~ {entities: [entity <~ {fields}]})
}, "Latest requires an authoritative UTC instant role");

type IntegerRow = struct { seq: Int, at: s::EpochMillis, value: Option(Int) };
def integer_rows: m::Dataset(IntegerRow) = m::dataset("integers", "integer_samples", IntegerRow.type, ["seq"]);
def integer_payload: edsl::PreparedPayload = t::prepare("integers", [t::with_samples(t::metric(t::declare(integer_rows, [], [], []), m::field(IntegerRow.type, s::EpochMillis.type, "at")), [
    samples::bind(integer_rows, samples::group("integers", Int.type, samples::Statistic::Mean, [samples::Statistic::Latest], None), m::optional_field(IntegerRow.type, Int.type, "value"), [{statistic: samples::Statistic::Mean, publish: "integer_mean"}, {statistic: samples::Statistic::Latest, publish: "integer_latest"}]),
])], profile).payload;
def integer_case: RuntimeCase = do {
    let query = intent::query_intent_ast_factory(integer_payload)(json::parse(r#"{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"integers"}],"edges":[],"select":[],"measures":[{"node":"s","measure":"integer_latest"}]}"#).unwrap!());
    {id: "integer", sqlite: sqlite::build_query(query), postgres: postgres::build_query(query)}
};
pub def integer_latest_preserves_primitive_type: test::Test = test::should_ok(fn() {
    edsl::measure_output_type(integer_payload, "integer_latest") == edsl::OutputType::Integer && edsl::measure_output_type(integer_payload, "integer_mean") == edsl::OutputType::Number
});

type TextRow = struct { seq: Int, at: Option(s::Rfc3339Utc), value: Option(Int) };
def text_rows: m::Dataset(TextRow) = m::dataset("text_samples", "text_samples", TextRow.type, ["seq"]);
def text_payload: edsl::PreparedPayload = t::prepare("text", [t::with_samples(t::metric(t::declare(text_rows, [], [], []), m::optional_field(TextRow.type, s::Rfc3339Utc.type, "at")), [
    samples::bind(text_rows, samples::group("text_values", Int.type, samples::Statistic::Latest, [], None), m::optional_field(TextRow.type, Int.type, "value"), [{statistic: samples::Statistic::Latest, publish: "text_latest"}]),
])], profile).payload;
def text_case: RuntimeCase = do {
    let query = intent::query_intent_ast_factory(text_payload)(json::parse(r#"{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"text_samples"}],"edges":[],"select":[],"measures":[{"node":"s","measure":"text_latest"}]}"#).unwrap!());
    {id: "text", sqlite: sqlite::build_query(query), postgres: postgres::build_query(query)}
};

pub def rates_cannot_be_summed_as_sample_amounts: test::Test = test::should_fail_with(fn() { samples::checked_group("bad", q::BytesPerSecond.type, samples::Statistic::Sum, [], Some("byte/s")) }, "sample Sum requires an explicitly additive quantity type");
pub def plain_numbers_do_not_imply_additivity: test::Test = test::should_fail_with(fn() { samples::checked_group("bad", Float.type, samples::Statistic::Sum, [], None) }, "sample Sum requires an explicitly additive quantity type");
type CountRow = struct { seq: Int, at: s::EpochMillis, value: q::Count };
def count_rows: m::Dataset(CountRow) = m::dataset("counts", "count_samples", CountRow.type, ["seq"]);
def count_payload: edsl::PreparedPayload = t::prepare("counts", [t::with_samples(t::metric(t::declare(count_rows, [], [], []), m::field(CountRow.type, s::EpochMillis.type, "at")), [
    samples::bind(count_rows, samples::group("counts", q::Count.type, samples::Statistic::Sum, [samples::Statistic::Mean], None), m::field(CountRow.type, q::Count.type, "value"), [{statistic: samples::Statistic::Sum, publish: "count_sum"}, {statistic: samples::Statistic::Mean, publish: "count_mean"}]),
])], profile).payload;
def count_case: RuntimeCase = do {
    let query = intent::query_intent_ast_factory(count_payload)(json::parse(r#"{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"counts"}],"edges":[],"select":[],"measures":[{"node":"s","measure":"count_sum"},{"node":"s","measure":"count_mean"}]}"#).unwrap!());
    {id: "counts", sqlite: sqlite::build_query(query), postgres: postgres::build_query(query)}
};

pub def event_cannot_publish_metric_sample_roles: test::Test = test::should_fail_with(fn() {
    t::checked_prepare("bad", [t::checked_with_samples(t::checked_event(base, m::checked_optional_field(Row.type, s::EpochMillis.type, "at")), [rx])], profile)
}, "sample measures require a Metric dataset");
