use ontology::ontology as edsl;
use ontology::query as qb;

def yes: Bool = True;
def eq_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def text_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def no_types: Array(Type) = [];

@edsl::entity_id("tenant")
@edsl::entity_source("tenants", "tenant")
type Tenant = struct {
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::dimension("tenant_id", yes, yes, eq_ops, text_inputs)
    id: String,
};

@edsl::entity_id("site")
@edsl::entity_source("sites", "site")
@edsl::named_typed_relation_key("site_tenant", Site.type, Tenant.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Site.type, String.type, "tenant_id"), edsl::model_field(Tenant.type, String.type, "id")),
])
type Site = struct {
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::dimension("site_id", yes, yes, eq_ops, text_inputs)
    id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

@edsl::entity_id("device")
@edsl::entity_source("devices", "device")
@edsl::named_typed_relation_key("device_tenant", Device.type, Tenant.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Device.type, String.type, "tenant_id"), edsl::model_field(Tenant.type, String.type, "id")),
])
@edsl::named_typed_relation_key("device_site", Device.type, Site.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Device.type, String.type, "site_id"), edsl::model_field(Site.type, String.type, "id")),
    edsl::typed_relation_pair(edsl::model_field(Device.type, String.type, "tenant_id"), edsl::model_field(Site.type, String.type, "tenant_id")),
])
type Device = struct {
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::dimension("device_id", yes, yes, eq_ops, text_inputs)
    @edsl::measure("device_count", qb::AggregateFunction::Count, no_types)
    id: String,
    @edsl::column("site_id")
    site_id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

# A and Z designate physical endpoint positions, not a business direction.
# Composite keys prevent an endpoint with a matching device ID in another
# tenant from becoming a valid relation.
@edsl::entity_id("connection")
@edsl::entity_source("connections", "connection")
@edsl::named_typed_relation_key("connection_a", Connection.type, Device.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Connection.type, String.type, "a_device_id"), edsl::model_field(Device.type, String.type, "id")),
    edsl::typed_relation_pair(edsl::model_field(Connection.type, String.type, "tenant_id"), edsl::model_field(Device.type, String.type, "tenant_id")),
])
@edsl::named_typed_relation_key("connection_z", Connection.type, Device.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Connection.type, String.type, "z_device_id"), edsl::model_field(Device.type, String.type, "id")),
    edsl::typed_relation_pair(edsl::model_field(Connection.type, String.type, "tenant_id"), edsl::model_field(Device.type, String.type, "tenant_id")),
])
type Connection = struct {
    @edsl::column("a_device_id")
    a_device_id: String,
    @edsl::column("id")
    @edsl::key(yes)
    id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
    @edsl::column("z_device_id")
    z_device_id: String,
};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column,
        qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
        qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join,
        qb::Operator::Group],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count],
    allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::And],
    allow_distinct: True,
};

def payload: edsl::PreparedPayload = edsl::build_root("relation-pressure-v1",
    [Tenant.type, Site.type, Device.type, Connection.type], profile,
    fn(subject) { subject == "resolver" });

pub use self::{ Tenant, Site, Device, Connection, payload };
