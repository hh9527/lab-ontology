# JSON-backed dimension rejection paths. Each fails atomically through the
# public build_root + lower path; no partial Plan/Query is published.
def int_kinds: Array(edsl.FilterInputKind) = ['Int];

# A profile that lacks JsonExtract must reject a JSON dimension at lowering.
def no_json_profile: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Group, 'Order, 'Limit,
    ],
    allowed_join_kinds: ['Inner, 'Left],
    allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
    allowed_scalars: ['Substr, 'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not],
    allow_distinct: 'True,
};

@edsl.entity_source("json_noextract", "j")
type JsonNoExtract = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("JsonNoExtractCount", count_agg, no_types)
    id: Int,
    @edsl.column("doc")
    @edsl.json_dimension("JsonNoExtractChannel", flag_true, flag_true, eq_ops, text_kinds, "$.channel")
    doc: String,
};

def json_profile_missing: qb.Plan = do {
    let payload = edsl.build_root("json-noextract", [JsonNoExtract], no_json_profile, invalid_authorize);
    let request: edsl.QueryRequest = {
        measures: [{ id: "JsonNoExtractCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "JsonNoExtractChannel", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(payload, request);
    plan
};

# An unauthorized JSON dimension must fail atomically when selected.
@edsl.entity_source("json_unauth", "u")
type JsonUnauth = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("JsonUnauthCount", count_agg, no_types)
    id: Int,
    @edsl.column("doc")
    @edsl.json_dimension("JsonUnauthChannel", flag_false, flag_true, eq_ops, text_kinds, "$.channel")
    doc: String,
};

def json_unauthorized: qb.Plan = do {
    let payload = edsl.build_root("json-unauth", [JsonUnauth], knowledge.profile, invalid_authorize);
    let request: edsl.QueryRequest = {
        measures: [{ id: "JsonUnauthCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "JsonUnauthChannel", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(payload, request);
    plan
};

# Illegal filter input on a JSON dimension (text input for an Int-kind path).
def json_bad_input: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "DeviceCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: "DeviceRetryCount", subject: "analyst", op: 'Eq, input: 'Text("2") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Ordering by a JSON dimension that was not requested.
def json_unrequested_ordering: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "DeviceCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "DeviceOwner", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Dimension("DeviceChannel"), direction: 'Asc }],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# ---------------------------------------------------------------------------
# Next-round failure scenarios (non-exported; surfaced by best-effort checks).
# Existence filters, HAVING, measureless row lists and text operations must fail
# atomically with deterministic diagnostics, never publishing a partial Plan.
# ---------------------------------------------------------------------------

# Existence filter naming an entity outside the knowledge.
def exists_unknown_entity: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let exists: edsl.ExistsRequest = { target: "bogus-entity", subject: "analyst", filters: [], any_of: [], min_matches: 'None };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [exists], []);
    plan
};

# Existence filter whose target is not directly related to the base entity.
def exists_indirect_target: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "ItemQty", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let exists: edsl.ExistsRequest = { target: "traces", subject: "analyst", filters: [], any_of: [], min_matches: 'None };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [exists], []);
    plan
};

# HAVING referencing a measure that was not requested.
def having_unrequested_measure: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let having: edsl.HavingRequest = {
        measure: "TraceCount",
        subject: "analyst",
        op: 'Ge,
        threshold: 'Number(1.0),
    };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [], [having]);
    plan
};

# Top Per Group requires an aggregated measure; measureless row lists reject it.
def row_partition_invalid: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Dimension("OrderRegion"), direction: 'Asc }],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Measureless row projection may not dereference an attribute across a fan-out
# relation (that would amplify base rows); an existence filter is the alternative.
def row_fanout_attribute: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [],
        dimensions: [
            { id: "CustomerTier", subject: "analyst", input: 'None },
            { id: "OrderRegion", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

