pub def count_tenants_with_more_than_five_uncleared_alarms: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"tenant",
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"alarm_belongs_to_tenant","from":"alarm","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_name"}],
        "filters":[{"node":"alarm","dimension":"alarm_cleared","op":"eq","kind":"text","value":"uncleared"}],
        "count":"alarm","group_by_identity":["tenant"],
        "count_having":{"op":"gt","value":5},"count_groups":true}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "SELECT count(1) FROM (SELECT tenant.TENANT_NAME")
        && string::contains(sq.sql, "INNER JOIN T_CURRENT_ALARM AS alarm")
        && string::contains(sq.sql, "alarm.TENANTID = tenant.TENANT_ID")
        && string::contains(sq.sql, "GROUP BY tenant.TENANT_NAME, tenant.TENANT_ID HAVING count(alarm.CSN) >")
        && string::contains(pg.sql, "HAVING count(\"alarm\".\"CSN\") >")
        && sq.bindings == [qb::Val::Int(0), qb::Val::Int(5)]
        && sq.bindings == pg.bindings { True }
    else { fail!("tenant alarm group count lost declared ownership or tenant identity", sq, pg) }
});

pub def site_alarm_count_through_device_preserves_event_grain: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"site",
        "nodes":[{"id":"site","entity":"site"},{"id":"device","entity":"device"},
                 {"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"device_located_at_site","from":"device","to":"site"},
                 {"relation":"device_current_alarm","from":"alarm","to":"device"}],
        "select":[{"node":"site","dimension":"site_name"}],
        "filters":[{"node":"alarm","dimension":"alarm_cleared","op":"eq","kind":"text","value":"uncleared"}],
        "count":"alarm","group_by_identity":["site"],
        "count_having":{"op":"gt","value":5},"count_groups":true}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "SELECT count(1) FROM (SELECT site.SITE_NAME")
        && string::contains(sq.sql, "device.projectId = site.SITE_ID OR device.refParentSubnet = site.SITE_ID")
        && string::contains(sq.sql, "alarm.MEDN = device.id AND alarm.TENANTID = device.tenant_id")
        && string::contains(sq.sql, "GROUP BY site.SITE_NAME, site.SITE_ID HAVING count(alarm.CSN) >")
        && string::contains(pg.sql, "HAVING count(\"alarm\".\"CSN\") >")
        && sq.bindings == [qb::Val::Int(0), qb::Val::Int(5)] && pg.bindings == sq.bindings { True }
    else { fail!("multi-hop site alarm count lost event grain or full device ownership", sq, pg) }
});

