                    {statistic: sample::Statistic::Max, publish: "sea_avg_opt_delay_max"},
                    {statistic: sample::Statistic::Min, publish: "sea_avg_opt_delay_min"}
                ]
            ),
            sample::bind(
                dataset,
                groups::group_9,
                m::optional_field(Row.type, units::Percent.type, "ne_contrlable_rate"),
                [
                    {statistic: sample::Statistic::Mean, publish: "sea_ne_contrlable_rate"},
                    {statistic: sample::Statistic::Max, publish: "sea_ne_contrlable_rate_max"},
                    {statistic: sample::Statistic::Min, publish: "sea_ne_contrlable_rate_min"}
                ]
            )
        ]
    ),
    m::field(Row.type, s::DateTimeUtc.type, "ts")
);
