pub def q0047_storage_sites_qualify_by_hidden_identity: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"qualify_group","relation":"storage_device_site","measures":["storage_device_named_count"],"dimensions":["site_id","site_name"],"visible_dimensions":["site_name"],"filters":[{"dimension":"storage_running_status","op":"eq","kind":"text","value":"normal"},{"dimension":"storage_device_subclass","op":"eq","kind":"text","value":"fc_switch_device"}],"having":[{"measure":"storage_device_named_count","op":"lt","kind":"int","value":5}],"ordering":[],"limit":1000,"offset":null}`);
    if array::length(string::split(q.sql, "SELECT s.SITE_NAME FROM HuaweiStorageDevice AS sd")) > 1
        && array::length(string::split(q.sql, "INNER JOIN X_SITE_VIEW AS s ON")) > 1
        && array::length(string::split(q.sql, "sd.parentResId = s.SITE_ID")) > 1
        && array::length(string::split(q.sql, "sd.projectId = s.SITE_ID")) > 1
        && array::length(string::split(q.sql, "GROUP BY s.SITE_ID, s.SITE_NAME")) > 1
        && array::length(string::split(q.sql, "HAVING count(sd.name) < ?")) > 1
        && q.bindings == [qb::Val::String("1"), qb::Val::String("FCSwitchDevice"), qb::Val::Int(5), qb::Val::Int(1000)] {
        True
    } else { fail!("Q0047 must group by site identity but only return name", q.sql, q.bindings) }
});

pub def q0048_q0049_storage_subclasses_keep_site_identity: test::Test = test::should_ok(fn() {
    let prefix = `{"op":"qualify_group","relation":"storage_device_site","measures":["storage_device_named_count"],"dimensions":["site_id","site_name"],"visible_dimensions":["site_name"],"filters":[{"dimension":"storage_running_status","op":"eq","kind":"text","value":"normal"},{"dimension":"storage_device_subclass","op":"eq","kind":"text","value":"`;
    let suffix = `"}],"having":[{"measure":"storage_device_named_count","op":"lt","kind":"int","value":5}],"ordering":[],"limit":1000,"offset":null}`;
    let flash = lower_json(`\{prefix}enterprise_flash_storage_device\{suffix}`);
    let distributed = lower_json(`\{prefix}distributed_storage_device\{suffix}`);
    if flash.sql == distributed.sql
        && array::length(string::split(flash.sql, "GROUP BY s.SITE_ID, s.SITE_NAME")) > 1
        && flash.bindings == [qb::Val::String("1"), qb::Val::String("EnterpriseStorage"), qb::Val::Int(5), qb::Val::Int(1000)]
        && distributed.bindings == [qb::Val::String("1"), qb::Val::String("FusionStorageDevice"), qb::Val::Int(5), qb::Val::Int(1000)] {
        True
    } else { fail!("Q0048/49 must differ only in subclass binding", flash, distributed) }
});

