use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::terminal_info;
@domain::subject("NetworkElement", "resid")
@domain::dataset("dev-info", "TBL_DEV_INFO", ["resid"])
@domain::relations(relations)
pub type DevInfo = struct {
    @m::column("RESID")
    @g::field_view(g::dimension_group("dev-info/resid", ids::NetworkElementById.type, True, [g::Filter::Eq]), "di_res_id", True, [g::Filter::Eq])
    @domain::count("di_count")
    resid: ids::NetworkElementById,
    @m::column("MAC")
    @g::field_view(g::dimension_group("dev-info/mac", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "di_mac", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    mac: Option(String),
    @m::column("IP")
    @g::field_view(g::dimension_group("dev-info/ip", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "di_ip", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ip: Option(String),
    @m::column("NAME")
    @g::field_view(g::dimension_group("dev-info/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "di_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: Option(String),
    @m::column("CLASS_NAME")
    @g::field_view(g::dimension_group("dev-info/class_name/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "di_class_name_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::DiClassName.type, "di_class_name", [v::member(domains::DiClassName::NetworkDevice, ["EntNetworkElement"]), v::member(domains::DiClassName::PonDevice, ["EntPonElement"])])
    class_name: Option(String),
};

pub def relations: Array(r::Relation) = [
    r::relation("di__ti_rev", domain::endpoint(DevInfo.type, "resid"), domain::endpoint(terminal_info::TerminalInfo.type, "access_device_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
