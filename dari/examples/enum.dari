type Params = Schema({severity: ic::AlarmSeverity, category: ic::DeviceClass});
data request: Params = input();
type Alarm = Schema({id: String, severity: ic::AlarmSeverity, category: ic::DeviceClass, status: Option(ic::OpenStatus)});
data alarms: Table(Alarm) = source("enum_alarms");
data rows = query! {
    let a = from(alarms);
    let projected = a |> filter(a.severity == request.severity && a.category == request.category)
      |> project({id: a.id, severity: a.severity, category: a.category, status: a.status});
    projected
      |> order_by(asc(projected.id))
      |> take(10)
};
answer tree! { Answer [UseTable(ref = rows)] };
