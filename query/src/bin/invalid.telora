# query/src/bin/invalid.telora
#
# Demonstrates that an illegal Plan produces Host diagnostics and no Query.
# `JsonExtract` is given a column as its second argument instead of a literal
# string Bind path, so structural validation inside transform_sqlite rejects
# the plan.  Running with --best-effort reports the diagnostics, exits non-zero
# and publishes no output (no partial Query is ever produced).

import "std/value" { Value };
import "@src/lib" as qb;

def invalid_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "invalid-json-path",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.json_extract(qb.column("e", "payload"), "$.attempt_id")),
            qb.expr_item(qb.scalar('JsonExtract, [
                qb.column("e", "payload"),
                qb.column("e", "path"),
            ])),
        ],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    let plan = invalid_plan();
    let query = qb.transform_sqlite(plan);
    let result: Value = 'Object({
        unreachable: 'False,
        sql: 'String(query.sql),
    });
    result
};
