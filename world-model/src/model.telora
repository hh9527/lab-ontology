# world-model/src/model.telora
#
# EnterpriseKnowledge for the Spider `world_1` domain (PRIVATE mappings).
# Physical table/column names and relation paths stay in this module and are
# never published to docs/DOMAIN.md / docs/INTENT.md.
#
# Numeric attributes publish the ordinary aggregate variants that are
# meaningful for each physical field:
#   - additive numeric quantities: sum / avg / min / max;
#   - numeric rates/percentages and non-additive numeric (e.g. years,
#     life expectancy): avg / min / max (sum would misstate meaning);
#   - explicit entity row-count measures stay separate.
# The eDSL allows one `measure` property per struct field, so each extra
# ordinary aggregate is carried by a dedicated field that reuses the same
# physical column.  Carrier fields carry only measures and no dimension/key.

use ontology::query as qb;
use ontology::ontology as edsl;

def count_agg: qb::AggregateFunction = qb::AggregateFunction::Count;
def sum_agg: qb::AggregateFunction = qb::AggregateFunction::Sum;
def avg_agg: qb::AggregateFunction = qb::AggregateFunction::Avg;
def min_agg: qb::AggregateFunction = qb::AggregateFunction::Min;
def max_agg: qb::AggregateFunction = qb::AggregateFunction::Max;

def flag_true: Bool = True;
def flag_false: Bool = False;

def num_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Gt, edsl::FilterOp::Ge, edsl::FilterOp::Lt, edsl::FilterOp::Le];
def text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Contains, edsl::FilterOp::NotContains, edsl::FilterOp::StartsWith, edsl::FilterOp::EndsWith];
def text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def num_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int, edsl::FilterInputKind::Number];

def safe_kind: edsl::RelationKind = edsl::RelationKind::Safe;

def requires_none: Array(Type) = [];

# --- country ---------------------------------------------------------------
# Canonical field order (alphabetical by field name) keeps `code` at index 0 so
# the City / CountryLanguage relations stay valid.
@edsl::entity_id("country")
@edsl::entity_source("country", "c")
type Country = struct {
    @edsl::column("Code")
    @edsl::key(flag_true)
    @edsl::measure("country_count", count_agg, requires_none)
    @edsl::dimension("country_code", flag_true, flag_true, text_ops, text_kinds)
    code: String,

    @edsl::column("Continent")
    @edsl::dimension("country_continent", flag_true, flag_true, text_ops, text_kinds)
    continent: String,

    # GNP (additive quantity): sum / avg / min / max
    @edsl::column("GNP")
    @edsl::measure("country_gnp_avg", avg_agg, requires_none)
    @edsl::dimension("country_gnp", flag_true, flag_true, num_ops, num_kinds)
    gnp: Float,
    @edsl::column("GNP")
    @edsl::measure("country_gnp_sum", sum_agg, requires_none)
    gnp_sum: Float,
    @edsl::column("GNP")
    @edsl::measure("country_gnp_min", min_agg, requires_none)
    gnp_min: Float,
    @edsl::column("GNP")
    @edsl::measure("country_gnp_max", max_agg, requires_none)
    gnp_max: Float,

    @edsl::column("GovernmentForm")
    @edsl::measure("country_government_count", count_agg, requires_none)
    @edsl::dimension("country_government", flag_true, flag_true, text_ops, text_kinds)
    government_form: String,

    @edsl::column("HeadOfState")
    @edsl::dimension("country_head", flag_true, flag_true, text_ops, text_kinds)
    head_of_state: String,

    # Independence year (non-additive point-in-time): avg / min / max
    @edsl::column("IndepYear")
    @edsl::dimension("country_indep_year", flag_true, flag_true, num_ops, num_kinds)
    indep_year: Int,
    @edsl::column("IndepYear")
    @edsl::measure("country_indep_year_avg", avg_agg, requires_none)
    indep_year_avg: Int,
    @edsl::column("IndepYear")
    @edsl::measure("country_indep_year_min", min_agg, requires_none)
    indep_year_min: Int,
    @edsl::column("IndepYear")
    @edsl::measure("country_indep_year_max", max_agg, requires_none)
    indep_year_max: Int,

    # Life expectancy (rate-like): avg / min / max
    @edsl::column("LifeExpectancy")
    @edsl::measure("country_life_expectancy_avg", avg_agg, requires_none)
    @edsl::dimension("country_life_expectancy", flag_true, flag_true, num_ops, num_kinds)
    life_expectancy: Float,
    @edsl::column("LifeExpectancy")
    @edsl::measure("country_life_expectancy_min", min_agg, requires_none)
    life_expectancy_min: Float,
    @edsl::column("LifeExpectancy")
    @edsl::measure("country_life_expectancy_max", max_agg, requires_none)
    life_expectancy_max: Float,

    @edsl::column("Name")
    @edsl::dimension("country_name", flag_true, flag_true, text_ops, text_kinds)
    name: String,

    # Population (additive quantity): sum / avg / min / max
    @edsl::column("Population")
    @edsl::measure("country_population_sum", sum_agg, requires_none)
    @edsl::dimension("country_population", flag_true, flag_true, num_ops, num_kinds)
    population: Int,
    @edsl::column("Population")
    @edsl::measure("country_population_avg", avg_agg, requires_none)
    population_avg: Int,
    @edsl::column("Population")
    @edsl::measure("country_population_min", min_agg, requires_none)
    population_min: Int,
    @edsl::column("Population")
    @edsl::measure("country_population_max", max_agg, requires_none)
    population_max: Int,

    @edsl::column("Region")
    @edsl::dimension("country_region", flag_true, flag_true, text_ops, text_kinds)
    region: String,

    # Surface area (additive quantity): sum / avg / min / max
    @edsl::column("SurfaceArea")
    @edsl::measure("country_surface_area_avg", avg_agg, requires_none)
    @edsl::dimension("country_surface_area", flag_true, flag_true, num_ops, num_kinds)
    surface_area: Float,
    @edsl::column("SurfaceArea")
    @edsl::measure("country_surface_area_sum", sum_agg, requires_none)
    surface_area_sum: Float,
    @edsl::column("SurfaceArea")
    @edsl::measure("country_surface_area_min", min_agg, requires_none)
    surface_area_min: Float,
    @edsl::column("SurfaceArea")
    @edsl::measure("country_surface_area_max", max_agg, requires_none)
    surface_area_max: Float,
};

# --- country language ------------------------------------------------------
# A language spoken in a country.  Declared before City so City can reference it
# in its declared two-hop existence route (City -> Country -> CountryLanguage).
# `country_code` stays canonical field 0.
@edsl::entity_id("country_language")
@edsl::entity_source("countrylanguage", "cl")
@edsl::relation(Country.type, safe_kind, 0, 0)
type CountryLanguage = struct {
    @edsl::column("CountryCode")
    country_code: String,

    @edsl::column("IsOfficial")
    @edsl::dimension("language_official", flag_true, flag_true, text_ops, text_kinds)
    is_official: String,

    @edsl::column("Language")
    @edsl::measure("language_count", count_agg, requires_none)
    @edsl::dimension("language_name", flag_true, flag_true, text_ops, text_kinds)
    language: String,

    # Percentage (rate): avg / min / max
    @edsl::column("Percentage")
    @edsl::measure("language_percentage_max", max_agg, requires_none)
    @edsl::dimension("language_percentage", flag_true, flag_true, num_ops, num_kinds)
    percentage: Int,
    @edsl::column("Percentage")
    @edsl::measure("language_percentage_avg", avg_agg, requires_none)
    percentage_avg: Int,
    @edsl::column("Percentage")
    @edsl::measure("language_percentage_min", min_agg, requires_none)
    percentage_min: Int,
};

# --- city ------------------------------------------------------------------
# A city belonging to a country.  `country_code` stays canonical field 0.
# Declared two-hop existence route: a City row may be qualified by the
# existence of a matching CountryLanguage row through its Country owner
# (City -> Country -> CountryLanguage).  Only grain-safe owner join + a
# correlated EXISTS; never a synthetic direct City-to-CountryLanguage join.
@edsl::entity_id("city")
@edsl::entity_source("city", "ct")
@edsl::relation(Country.type, safe_kind, 0, 0)
@edsl::exists_route(Country.type, CountryLanguage.type)
type City = struct {
    @edsl::column("CountryCode")
    country_code: String,

    @edsl::column("District")
    @edsl::dimension("city_district", flag_true, flag_true, text_ops, text_kinds)
    district: String,

    @edsl::column("ID")
    @edsl::key(flag_true)
    @edsl::measure("city_count", count_agg, requires_none)
    id: Int,

    @edsl::column("Name")
    @edsl::dimension("city_name", flag_true, flag_true, text_ops, text_kinds)
    name: String,

    # Population (additive quantity): sum / avg / min / max
    @edsl::column("Population")
    @edsl::dimension("city_population", flag_true, flag_true, num_ops, num_kinds)
    population: Int,
    @edsl::column("Population")
    @edsl::measure("city_population_sum", sum_agg, requires_none)
    population_sum: Int,
    @edsl::column("Population")
    @edsl::measure("city_population_avg", avg_agg, requires_none)
    population_avg: Int,
    @edsl::column("Population")
    @edsl::measure("city_population_min", min_agg, requires_none)
    population_min: Int,
    @edsl::column("Population")
    @edsl::measure("city_population_max", max_agg, requires_none)
    population_max: Int,
};

# ---------------------------------------------------------------------------
# Profile / payload.
# ---------------------------------------------------------------------------

def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
        qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order,
        qb::Operator::Limit, qb::Operator::Offset,
    ],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Sum, qb::AggregateFunction::Avg, qb::AggregateFunction::Min, qb::AggregateFunction::Max],
    allowed_scalars: [
        qb::ScalarFunction::Substr, qb::ScalarFunction::Instr, qb::ScalarFunction::If, qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Lower, qb::ScalarFunction::Length,
        qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not,
    ],
    allow_distinct: True,
};

def authorize: Fn(String) -> Bool = fn(subject) {
    subject == "public"
};

def entity_types: Array(Type) = [
    Country.type,
    City.type,
    CountryLanguage.type,
];

def payload: edsl::PreparedPayload = do {
    let result: edsl::PreparedPayload = edsl::build_root(
        "world-v1",
        entity_types,
        profile,
        authorize,
    );
    result
};

pub use self::{
    Country,
    City,
    CountryLanguage,
    profile,
    authorize,
    payload,
};
