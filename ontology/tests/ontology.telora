};

@edsl::entity_id("amb_owner_a")
@edsl::entity_source("amb_owner_a", "ama")
@edsl::relation(AmbTarget.type, fanout_kind, 0, 2)
type AmbOwnerA = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_id("amb_owner_b")
@edsl::entity_source("amb_owner_b", "amb")
@edsl::relation(AmbTarget.type, fanout_kind, 0, 2)
type AmbOwnerB = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_id("amb_target")
@edsl::entity_source("amb_target", "amt")
type AmbTarget = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("level")
    level: Int,
    @edsl::column("site_id")
    site_id: Int,
};

# Invalid: two relations from the via entity connect it to the same target.
@edsl::entity_id("double_leaf")
@edsl::entity_source("double_leaf", "dl")
@edsl::relation(DoubleOwner.type, safe_kind, 1, 0)
@edsl::exists_route(DoubleOwner.type, DoubleTarget.type)
type DoubleLeaf = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("owner_id")
    owner_id: Int,
};

@edsl::entity_id("double_owner")
@edsl::entity_source("double_owner", "dlo")
@edsl::relation(DoubleTarget.type, fanout_kind, 0, 2)
@edsl::relation(DoubleTarget.type, safe_kind, 0, 0)
type DoubleOwner = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_id("double_target")
@edsl::entity_source("double_target", "dlt")
type DoubleTarget = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("level")
    level: Int,
    @edsl::column("site_id")
    site_id: Int,
};

def route_problem_count: Fn(Array(Type)) -> Int = fn(types) {
    let graph = edsl::knowledge_graph(types);
    let build = edsl::route_build(graph.0, graph.1);
    array::length(build.problems)
};

def check_route_prepare_valid: Fn() -> Bool = fn() {
    let types: Array(Type) = [GoodLeaf.type, GoodOwner.type, GoodTarget.type];
    let graph = edsl::knowledge_graph(types);
    let build = edsl::route_build(graph.0, graph.1);
    check(array::length(build.problems) == 0 && array::length(build.routes) == 1,
        "route prepare: valid two-hop declaration resolves exactly one route")
};

def check_route_accepts_fanout_first_hop: Fn() -> Bool = fn() {
    # A declared two-hop route whose first hop is FanOut is now accepted: the
    # whole A -> B -> C condition lowers as one correlated EXISTS with an inner
    # join to C, so the one-to-many first hop never fans out the subject A.
    let types: Array(Type) = [BadFanLeaf.type, BadFanOwner.type, BadFanTarget.type];
    let graph = edsl::knowledge_graph(types);
    let build = edsl::route_build(graph.0, graph.1);
    check(array::length(build.problems) == 0 && array::length(build.routes) == 1,
        "route prepare: a fan-out first-hop route resolves exactly once (bounded link existence)")
};

def check_route_rejects_direction_mismatch: Fn() -> Bool = fn() {
    let types: Array(Type) = [BadDirLeaf.type, BadDirOwner.type, BadDirTarget.type];
    check(route_problem_count(types) > 0, "route prepare: reverse-only owner hop (direction mismatch) is rejected")
};

def check_route_rejects_ambiguous_target: Fn() -> Bool = fn() {
    let types: Array(Type) = [AmbLeaf.type, AmbOwnerA.type, AmbOwnerB.type, AmbTarget.type];
    check(route_problem_count(types) > 0, "route prepare: multiple routes to the same target are rejected")
};

def check_route_rejects_ambiguous_second_hop: Fn() -> Bool = fn() {
    let types: Array(Type) = [DoubleLeaf.type, DoubleOwner.type, DoubleTarget.type];
    check(route_problem_count(types) > 0, "route prepare: ambiguous via->target relation set is rejected")
};

# ---------------------------------------------------------------------------
# Dual-endpoint hub slice (hub is the base grain; participant is the filter
# target).
#
# Pair is the dual-endpoint hub whose two role columns reference Member's key.
# Each hub base row is naturally counted once; the correlated union EXISTS
# filters hubs whose left or right endpoint matches a participant.  This is a
# participant attribute filter over the participant (inner) side.
# ---------------------------------------------------------------------------

def hub_base_request: edsl::QueryRequest = {
    measures: [{ id: "PairCount", subject: "analyst", input: edsl::MeasureInput::All }],
    dimensions: [],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def member_target_exists_spec: edsl::ExistsRequest = {
    target: "members",
    subject: "analyst",
    filters: [],
    any_of: [],
    min_matches: None,
};

def member_filtered_exists_spec: edsl::ExistsRequest = {
    target: "members",
    subject: "analyst",
    filters: [{ id: "MemberKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("vip") }],
    any_of: [],
    min_matches: None,
};

def check_hub_route_prepared: Fn() -> Bool = fn() {
    let p = knowledge::payload;
    let members = entity_id_index(p.entities, "members");
    let pairs = entity_id_index(p.entities, "pairs");
    let route_ok = array::any(p.hub_routes, fn(r) { r.hub == pairs && r.participant == members });
    check(route_ok, "hub: prepared payload stores the Pair(hub base) -> Member route")
        && check(array::length(p.hub_routes) == 1, "hub: exactly one dual-hub route is declared")
};

def check_hub_union_exists_lowering: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_full(knowledge::payload, hub_base_request, [member_target_exists_spec], []);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(pr.id) AS PairCount FROM pairs AS pr WHERE EXISTS (SELECT 1 FROM members AS mb WHERE (pr.left_member_id = mb.id OR pr.right_member_id = mb.id))";
    check(array::length(plan.exists) == 1 && array::length(plan.joins) == 0,
        "hub: hub base grain uses one correlated EXISTS, no fan-out join")
        && check(query.sql == expected_sql, "hub: SQL direction is FROM hub WHERE EXISTS(participant ...)")
        && check(array::length(query.bindings) == 0, "hub: no bindings without dynamic values")
};

def check_hub_union_inner_filter: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_full(knowledge::payload, hub_base_request, [member_filtered_exists_spec], []);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::String("vip")];
    check(string::contains(query.sql, "AND mb.kind = ?"),
        "hub: participant-attribute inner filters stay parameterized on the filter target")
        && check(query.bindings == expected, "hub: inner filter binding order is deterministic")
};

def check_hub_union_deterministic: Fn() -> Bool = fn() {
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_full(knowledge::payload, hub_base_request, [member_target_exists_spec], []));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_full(knowledge::payload, hub_base_request, [member_target_exists_spec], []));
    check(q1.sql == q2.sql && q1.bindings == q2.bindings,
        "hub: repeated lowering of the hub-base dual-end union is byte-identical")
};

def check_hub_union_feasible: Fn() -> Bool = fn() {
    let p = knowledge::payload;
    check(edsl::correlation_feasible(p, "pairs", "members"), "hub: hub base to participant target is feasible")
        && check(!edsl::correlation_feasible(p, "pairs", "orders"), "hub: unrelated participant target is infeasible")
        && check(!edsl::correlation_feasible(p, "pairs", "pairs"), "hub: self target is infeasible")
};

# ---------------------------------------------------------------------------
# Dual-hub declaration fixtures (valid and invalid).
# ---------------------------------------------------------------------------

@edsl::entity_source("hp_t", "hp")
type HubParticipant = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("tag")
    tag: Int,
};

@edsl::entity_source("hpk_t", "hpk")
type HubParticipantNoKey = struct {
    @edsl::column("id")
    id: Int,
    @edsl::column("tag")
    tag: Int,
};

@edsl::entity_source("h1_t", "h1")
@edsl::dual_hub(HubParticipant.type, 0, 1, 2)
