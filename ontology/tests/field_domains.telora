use ontology::values as v;
use ontology::enum_values as ev;
use ontology::groups as g;
use ontology::model as m;
use ontology::transform as t;
use std::test as test;
use std::array as array;

type Status = enum {
    @ev::itag(1)
    Active,
    @ev::itag(2)
    Inactive,
};
def status: v::Domain(Status, Int) = v::from_enum("Status", Status.type, Int.type, False);
type Row = struct {
    @v::classification(status, "status")
    status: Option(Int),
    @v::field_domain(status, "scope", False, [g::Filter::Eq])
    scope: Int,
    other: Int
};
def dataset: m::Dataset(Row) = m::dataset("device", "devices", Row.type, []);
def declared: t::Declaration = t::declare(dataset, [], [], []);
pub def optional_domain_preserves_type_and_encoding: test::Test = test::should_ok(
    fn() {
        let binding = v::binding_facts(v::field_binding(dataset, "status"));
        array::length(declared.domains) == 2 && binding.nullable && binding.definition.value == Status.type && binding.definition.wire == Int.type && binding.definition.values[
            0
        ].id == "Active"
    }
);
pub def filter_only_policy_is_preserved: test::Test = test::should_ok(
    fn() {
        let binding = v::field_binding(dataset, "scope");
        !binding.projectable && !binding.group_projectable && binding.filters == [g::Filter::Eq] && !binding.nullable
    }
);
pub def explicit_binding_preserves_field_properties: test::Test = test::should_ok(
    fn() {
        let explicit = v::bind(
            dataset,
            v::dimension_group(status, True, g::equality_filters),
            g::input(m::field(Row.type, Int.type, "other")),
            "other",
            True,
            g::equality_filters
        );
        array::length(t::with_domains(declared, [explicit]).domains) == 3 && array::length(
            t::checked_with_domains(declared, [explicit]).domains
        ) == 3 && array::length(t::checked_declare(dataset, [], [], []).domains) == 2
    }
);
type Wrong = struct {
    @v::classification(status, "status")
    status: String
};
pub def incompatible_source_is_rejected: test::Test = test::should_fail_with(
    fn() {
        t::declare(m::dataset("wrong", "wrong", Wrong.type, []), [], [], []);
        True
    },
    "group input field has incompatible type"
);
