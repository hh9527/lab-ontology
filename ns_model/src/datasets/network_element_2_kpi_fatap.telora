pub type NetworkElement2KpiFatap = struct {
    @m::column("objSysId")
    @g::field_view(g::dimension_group("network-element-2-kpi-fatap/obj_sys_id", ids::NetworkElementById.type, True, [g::Filter::Eq]), "neelfa_obj_sys_id", True, [g::Filter::Eq])
