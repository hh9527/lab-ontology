use super::classifications as classes;
use super::collaboration as collaboration;
use super::fc_switch as fc_switch;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 告警事件独立声明；current 是来源表名，不隐含未清除范围。
# 来源时钟单位与本地时间编码延续旧模型假定，仍需生产确认。
use super::inventory as i;
use super::site as site;
use super::server as server;
use super::storage as storage;
use super::pon_device as pon;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
@domain::subject("Alarm", "csn")
@domain::dataset("current_alarm", "T_CURRENT_ALARM", ["csn"])
@domain::event("occur_utc")
@domain::computed_counts(
    [
        {
            name: "critical_or_major_alarm_count",
            op: qb::ComputedOp::Add,
            left: "critical_alarm_count",
            right: "major_alarm_count"
        },
        {
            name: "weighted_severe_alarm_score",
            op: qb::ComputedOp::Add,
            left: "critical_or_major_alarm_count",
            right: "critical_alarm_count"
        }
    ]
)
@domain::relations(relations)
type TCurrentAlarm = struct {
    @m::column("CSN")
    @g::field_view(
        g::dimension_group("alarm_csn", Int.type, True, g::numeric_filters),
        "alarm_csn",
        True,
        g::numeric_filters
    )
    @domain::count("alarm_count")
    @domain::count_when("alarm_open_count", "alarm_cleared", AlarmCleared::Uncleared)
    @domain::count_when("critical_alarm_count", "alarm_severity", AlarmSeverity::Critical)
    @domain::count_when("major_alarm_count", "alarm_severity", AlarmSeverity::Major)
    csn: Int,
    @m::column("OCCURUTC")
    @g::field_view(
        g::dimension_group("alarm_occur_utc", s::EpochMillis.type, True, g::time_filters),
        "alarm_occur_utc_raw",
        True,
        g::time_filters
    )
    occur_utc: s::EpochMillis,
    @m::column("ARRIVEUTC")
    arrive_utc: s::EpochMillis,
    @m::column("OCCURTIME")
    occur_time: s::EpochMillis,
    @m::column("MEDN")
    @domain::targets(
        [
            {name: "collaboration", identity: collaboration::CollaborationById.type}.ty!(
                domain::ReferenceTarget
            ),
            {name: "device", identity: i::DeviceById.type}.ty!(domain::ReferenceTarget),
            {name: "server", identity: server::ServerById.type}.ty!(domain::ReferenceTarget),
            {name: "storage", identity: storage::StorageById.type}.ty!(domain::ReferenceTarget),
            {name: "pon", identity: pon::PonElementById.type}.ty!(domain::ReferenceTarget),
            {name: "fc_alarm_reference", identity: fc_switch::FcSwitchById.type}.ty!(
                domain::ReferenceTarget
            )
        ]
    )
    res_id: domain::Reference(String),
    @m::column("STREXT13")
    strext13: domain::Reference(site::SiteById),
    @m::column("ALARMNAME")
    @g::field_view(
        g::dimension_group("alarm_alarm_name", String.type, True, g::text_search_filters),
        "alarm_name",
        True,
        g::text_search_filters
    )
    alarm_name: String,
    @m::column("SEVERITY")
    @g::exact("alarm_severity_raw")
    @v::map(
        AlarmSeverity.type,
        "alarm_severity",
        [
            v::member(AlarmSeverity::Critical, [1]),
            v::member(AlarmSeverity::Major, [2]),
            v::member(AlarmSeverity::Minor, [3]),
            v::member(AlarmSeverity::Warning, [4])
        ]
    )
    severity: Int,
    @m::column("CLEARED")
    @g::exact("alarm_cleared_raw")
    @v::map(
        AlarmCleared.type,
        "alarm_cleared",
        [v::member(AlarmCleared::Uncleared, [0]), v::member(AlarmCleared::Cleared, [1])]
    )
    cleared: Int,
    @m::column("CHANGEFLAG")
    @g::exact("alarm_change_flag_raw")
    @v::map(
        AlarmChangeFlag.type,
        "alarm_change_flag",
        [
            v::member(AlarmChangeFlag::Add, [1]),
            v::member(AlarmChangeFlag::Update, [2]),
            v::member(AlarmChangeFlag::Delete, [3])
        ]
    )
    change_flag: Int,
    @m::column("TENANTID")
    @g::field_view(
        g::dimension_group(
            "alarm_tenant_id",
            domain::Reference(i::TenantById).type,
            True,
            [g::Filter::Eq]
        ),
        "alarm_tenant_id",
        True,
        [g::Filter::Eq]
    )
    tenant_id: domain::Reference(i::TenantById),
    @m::column("CLEARUSER")
    @g::field_view(
        g::dimension_group("alarm_source_CLEARUSER", String.type, True, [g::Filter::Eq]),
        "current_alarm__CLEARUSER",
        True,
        [g::Filter::Eq]
    )
    source_CLEARUSER: String,
    @m::column("CLEARUTC")
    @g::field_view(
        g::dimension_group("alarm_source_CLEARUTC", s::EpochMillis.type, True, g::time_filters),
        "current_alarm__CLEARUTC",
        True,
        g::time_filters
    )
    source_CLEARUTC: s::EpochMillis,
    @m::column("CLEARCATEGORY")
    @g::exact("current_alarm__CLEARCATEGORY_raw")
    @v::map(
        CurrentAlarmCLEARCATEGORY.type,
        "current_alarm__CLEARCATEGORY",
        [
            v::member(CurrentAlarmCLEARCATEGORY::Auto, [1]),
            v::member(CurrentAlarmCLEARCATEGORY::Manual, [2])
        ]
    )
    source_CLEARCATEGORY: Int,
    @m::column("ACKED")
    @g::exact("current_alarm__ACKED_raw")
    @v::map(
        CurrentAlarmACKED.type,
        "current_alarm__ACKED",
        [
            v::member(CurrentAlarmACKED::Unconfirmed, [0]),
            v::member(CurrentAlarmACKED::Confirmed, [1])
        ]
    )
    source_ACKED: Int,
    @m::column("ACKUSER")
    @g::field_view(
        g::dimension_group("alarm_source_ACKUSER", String.type, True, [g::Filter::Eq]),
        "current_alarm__ACKUSER",
        True,
        [g::Filter::Eq]
    )
    source_ACKUSER: String,
    @m::column("ACKUTC")
    @g::field_view(
        g::dimension_group("alarm_source_ACKUTC", s::EpochMillis.type, True, g::time_filters),
        "current_alarm__ACKUTC",
        True,
