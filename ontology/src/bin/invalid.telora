    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let any: edsl.AnyOfRequest = { id: "OrderRegion", subject: "nobody", values: ['Text("east")] };
    let plan: qb.Plan = edsl.lower_any(knowledge.payload, request, [any], [], []);
    plan
};

# A union entity cannot combine with an existence filter (derived outer cannot
# carry EXISTS).
def union_with_exists: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "ItemCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let exists: edsl.ExistsRequest = { target: "children", subject: "analyst", filters: [], any_of: [], min_matches: 'None };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [exists], []);
    plan
};

# A union entity request cannot join or filter another entity (derived outer
# cannot declare physical joins/sources).
def union_join_other: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "ItemCount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "ItemOwner", subject: "analyst", input: 'None },
            { id: "CustomerTier", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# A union entity must declare at least one branch (prepare-time failure).
def empty_union_branches: Array(edsl.UnionBranchDecl) = [];

@edsl.union_source("x", empty_union_branches)
type EmptyUnion = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
};

def union_empty_branches_payload: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [EmptyUnion];
    let result: edsl.PreparedPayload = edsl.build_root("empty-union", entity_types, knowledge.profile, invalid_authorize);
    result
};

# Union mapping negative prepare fixtures: heterogeneous physical column maps
# must be rejected atomically (missing, duplicate, out-of-range, wrong order or
# illegal physical column).

def union_missing_cols: Array(edsl.UnionColumnDecl) = [{ field: 0, column: "id" }];
def union_missing_branches: Array(edsl.UnionBranchDecl) = [{ table: "t1", alias: "x", columns: union_missing_cols, filter: 'None }];
@edsl.union_source("umiss", union_missing_branches)
type UMissing = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
    @edsl.column("name")
    name: String,
};
def union_missing_payload: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [UMissing];
    edsl.build_root("u-missing", entity_types, knowledge.profile, invalid_authorize)
};

