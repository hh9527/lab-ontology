# 只由框架准备器发布的局部契约；后续绑定 profile 时不重复验证结构。
def required_capabilities: Fn(Array(qb::Operator), Array(qb::ScalarFunction)) -> qb::PlanProfile = fn(
    operators,
    scalars
) {
    {
        allowed_operators: operators,
        allowed_scalars: scalars,
        allowed_aggregates: [],
        allowed_join_kinds: [],
        allow_distinct: False
    }
};
def prepare_local_contract: Fn(PreparedPayload) -> qb::PlanProfile = fn(payload) {
    let measures = array::map(
        payload.measures,
        fn(entry) {
            let entity = payload.entities[entry.entity];
            let required = match entry.computed {
                Some(value) => required_capabilities(
                    [qb::Operator::Scalar],
                    [
                        match value.op {
                            qb::ComputedOp::Add => qb::ScalarFunction::Add,
                            qb::ComputedOp::Sub => qb::ScalarFunction::Sub
                        }
                    ]
                ),
                None => {
                    let input = measure_row_expr(qb::build_context(), payload, entry, entity.source);
                    qb::aggregate_requirements(
                        {
                            function: entry.aggregate,
                            arg: input.1,
                            distinct: False,
                            filter: match entry.predicate {
                                Some(predicate) => Some(
                                    resolve_measure_predicate_with_context(
                                        qb::build_context(),
                                        predicate,
                                        entity.source
                                    ).1
                                ),
                                None => None
                            },
                            alias: entry.id,
                            latest: measure_latest_order(entity, entry, entity.source)
                        }.ty!(qb::AggregateCall)
                    )
                }
            };
            required
        }
    );
    let dimensions = array::flat_map(
        payload.dimensions,
        fn(entry) {
            let base = qb::expression_requirements(
                dimension_expr(qb::build_context(), payload, entry).1
            );
            let projection = if entry.authorized && entry.projectable {
                let required = if array::length(entry.canonical_values) > 0 {
                    base <~ {
                        allowed_operators: qb::capability_union(
                            base.allowed_operators,
                            [qb::Operator::Filter, qb::Operator::Bind, qb::Operator::Scalar]
                        ),
                        allowed_scalars: qb::capability_union(
                            base.allowed_scalars,
                            qb::capability_union(
                                [qb::ScalarFunction::If],
                                filter_profile_scalars(entry, FilterOp::Eq)
                            )
                        )
                    }
                } else {
                    base <~ {
                        allowed_operators: qb::capability_union(
                            base.allowed_operators,
                            [qb::Operator::Filter]
                        )
                    }
                };
                [required]
            } else {
                []
            };
            let filters = if entry.filterable && array::length(entry.ops) > 0 {
                let required = base <~ {
                    allowed_operators: qb::capability_union(
                        base.allowed_operators,
                        [qb::Operator::Filter, qb::Operator::Bind, qb::Operator::Scalar]
                    ),
                    allowed_scalars: array::fold(
                        entry.ops,
                        base.allowed_scalars,
                        fn(scalars, op) {
                            qb::capability_union(scalars, filter_profile_scalars(entry, op))
                        }
                    )
                };
                [required]
            } else {
                []
            };
            array::concat([projection, filters])
        }
    );
    let sources = array::map(
        payload.entities,
        fn(entity) {
            entity.source_scope.required
        }
    );
    qb::combine_requirements(array::concat([sources, measures, dimensions]))
};
pub use self::{prepare_local_contract};

def prepare_source_scopes: Fn(PreparedPayload) -> PreparedPayload = fn(payload) {
    payload <~ {
        entities: array::map(
            payload.entities,
            fn(entity) {
                let prepared = array::fold(
                    entity.scope,
                    (qb::build_context(), [].ty!(Array(FilterResolution))),
                    fn(state, predicate) {
                        let dimension = match array::find(
                            payload.dimensions,
                            fn(d) {
                                d.entity == entity.index && d.field == predicate.index
                            }
                        ) {
                            Some(value) => value,
                            None => fail!(
                                "entity scope requires a declared dimension",
                                entity.id,
                                predicate.field
                            )
                        };
                        let resolved = resolve_scope_on_dimension(
                            state.0,
                            payload,
                            dimension,
                            {field: predicate.field, op: predicate.op, input: predicate.input}
                        );
                        (resolved.0, array::push(state.1, resolved.1))
                    }
                );
                match find_internal_conflict(prepared.1) {
                    Some(conflict) => fail!(
                        "entity scope has contradictory predicates",
                        entity.id,
                        conflict.field
                    ),
                    None => ()
                };
                let expression = combine_filters(
                    array::map(
                        prepared.1,
                        fn(value) {
                            value.expr
                        }
                    )
                );
                entity <~ {
                    source_scope: {
                        alias: entity.alias,
                        bindings: prepared.0.bindings,
                        expression,
                        required: qb::combine_requirements(
                            [
                                required_capabilities([qb::Operator::Source], []),
                                match expression {
                                    Some(expr) => qb::expression_requirements(expr),
                                    None => required_capabilities([], [])
                                }
                            ]
                        )
                    }
                }
            }
        )
    }
};
pub use self::{prepare_source_scopes};
