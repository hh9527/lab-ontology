use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::storage_disk;
use crate::datasets::kpi_storage_cloud_block_disk;
@domain::subject("StorageDisk", "obj_sys_id")
@domain::dataset("cloud-block-disk-2-kpi", "cloudBlockDisk2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type CloudBlockDisk2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("cloud-block-disk-2-kpi/obj_sys_id", ids::CloudBlockDisk2KpiByObjSysId.type, True, [g::Filter::Eq]), "cbd2_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: ids::CloudBlockDisk2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("cloud-block-disk-2-kpi/obj_id", domain::Reference(ids::CloudBlockDisk2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "cbd2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::CloudBlockDisk2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("cbd2__sd", domain::endpoint(CloudBlockDisk2Kpi.type, "obj_sys_id"), domain::endpoint(storage_disk::StorageDisk.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("cbd2__scbd", domain::endpoint(CloudBlockDisk2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_cloud_block_disk::KpiStorageCloudBlockDisk.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
