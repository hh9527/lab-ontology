# ---------------------------------------------------------------------------
# Knowledge profile and root payload
# ---------------------------------------------------------------------------

def profile: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Exists, 'Join, 'Group, 'Having, 'Order,
        'Limit, 'Offset, 'Partition,
    ],
    allowed_join_kinds: ['Inner, 'Left],
    allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
    allowed_scalars: [
        'Substr, 'Instr, 'If, 'Add, 'Sub, 'Lower, 'Length,
        'JsonExtract, 'JsonType, 'JsonValid,
        'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not,
    ],
    allow_distinct: 'True,
};

def authorize: Fn(String) -> Bool = fn(subject) {
    subject == "analyst" || subject == "resolver"
};

def payload: edsl.PreparedPayload = edsl.build_root(
    "icm-model-v1",
    [
        Tenant, Site, Alarm,
        NetDevice, PonDevice, ServerDevice, StorageDevice,
        TerminalDevice, CollabDevice,
        PhysicalLink,
        NetKpi, NetOnlineKpi, ApRadioKpi, ServerKpi, PonKpi, OnuKpi,
        PonPortKpi, StorageKpi,
        StorageController, StorageChassis, StorageBackupPower, StorageDisk,
        StorageFan, StoragePort, StoragePsu,
        ServerPsu, ServerOptical, ServerDisk, ServerFan, ServerMemory,
        ServerProcessor, ServerNic, ServerPort,
        NetPort, NetOptical,
    ],
    profile,
    authorize,
);

def device_payload: edsl.PreparedPayload = edsl.build_root(
    "icm-model-device-v1",
    [Device],
    profile,
    authorize,
);

export { payload, device_payload };
export { profile, authorize };
