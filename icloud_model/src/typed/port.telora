use ontology::experimental::knowledge_policy as knowledge_policy;
# 网络端口独立声明，保留现有 transform 契约
use super::inventory as i;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
type PortId = struct(String);
# 源带宽单位为 bit/s，不与 BytesPerSecond 隐式互换
type BitsPerSecond = struct(Float);
type Identity = struct { id: PortId };
type Row = struct {
    id: PortId,
    tenant_id: i::TenantId,
    ref_parent_ne: i::DeviceId,
    name: String,
    oper_status: String,
    source_adminState: String,
    source_bandwidth: BitsPerSecond,
    source_alias: String,
    source_portIndex: String,
    source_nativeId: String,
    source_remark: String,
    source_duplexMode: String,
    source_ipAddress: String,
    source_ifMtu: Int,
    source_parentResId: String,
    source_ifPhysAddress: String,
    source_ifType: Int,
};
def entity: m::Entity(Identity) = m::entity("port_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset("port", "I_EnterpriseNetworkLTP", Row.type, ["id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, PortId.type, "id"), m::field(Identity.type, PortId.type, "id"))]);
def device: m::Role(Row) = m::role(dataset, i::device, "device", False, [m::identity_part(m::field(Row.type, i::DeviceId.type, "ref_parent_ne"), m::field(i::DeviceIdentity.type, i::DeviceId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
@knowledge_policy::reverse_references(True)
type PortOperStatus = struct(String);
def PortOperStatus_domain: v::Domain(PortOperStatus, String) = v::domain("PortOperStatus", PortOperStatus.type, String.type, [
    v::member(PortOperStatus("up"), ["active"]),
    v::member(PortOperStatus("down"), ["inactive"]),
    v::member(PortOperStatus("unknown"), ["unknown"]),
], False);
@knowledge_policy::reverse_references(True)
type PortAdminState = struct(String);
def PortAdminState_domain: v::Domain(PortAdminState, String) = v::domain("PortAdminState", PortAdminState.type, String.type, [
    v::member(PortAdminState("wire_active_19c13051"), ["active"]),
    v::member(PortAdminState("wire_inactive_2133f51d"), ["inactive"]),
    v::member(PortAdminState("wire_test_35f03aff"), ["test"]),
], False);
@knowledge_policy::reverse_references(True)
type PortIfType = struct(String);
def PortIfType_domain: v::Domain(PortIfType, Int) = v::domain("PortIfType", PortIfType.type, Int.type, [
    v::member(PortIfType("wire_1_8d618873"), [1]),
    v::member(PortIfType("wire_2_d0a68914"), [2]),
    v::member(PortIfType("wire_3_bab86ec8"), [3]),
