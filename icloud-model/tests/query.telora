pub def pon_parent_role_requires_inherent_classification: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"list_roles","measures":[],"dimensions":["pon_onu_name"],"filters":[],"ordering":[],"roles":[{"relation":"pon_onu_parent_olt","dimension":"pon_olt_name","output":"parent_olt_name"}],"limit":null,"offset":null}`);
    let datasets = edsl::knowledge_index_for_subject(payload, "public");
    let child_dataset = array::find(datasets, fn(d) { d.id == "pon_onu_role" });
    let parent_dataset = array::find(datasets, fn(d) { d.id == "pon_olt_role" });
    if string::contains(q.sql, "onu.parentOltResId = role_0.id")
        && string::contains(q.sql, "onu.classification = ?")
        && string::contains(q.sql, "role_0.classification = ?")
        && q.bindings == [qb::Val::String("ne.category.pon.onu"), qb::Val::String("ne.category.olt")]
        && (match child_dataset {
            Some(d) => array::length(d.scope) == 1 && d.scope[0].field == "classification"
                && d.scope[0].input == edsl::FilterInput::Text("onu"),
            None => False,
        })
        && (match parent_dataset {
            Some(d) => array::length(d.scope) == 1 && d.scope[0].field == "classification"
                && d.scope[0].input == edsl::FilterInput::Text("olt"),
            None => False,
        }) { True }
    else { fail!("self-table parent_of must carry both model-defined role domains", q, child_dataset, parent_dataset) }
});

