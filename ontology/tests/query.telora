def union_all_profile_recurses_into_branches = fn() {
    # Dropping Filter or the Count aggregate must reject the outer plan even
    # though the offending capability lives only inside a branch.
    let no_filter: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Aggregate, qb.Operator.Group, qb.Operator.Having],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Eq],
        allow_distinct: True,
    };
    let no_count: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Filter, qb.Operator.Aggregate, qb.Operator.Group, qb.Operator.Having],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Sum],
        allowed_scalars: [qb.ScalarFunction.Eq],
        allow_distinct: True,
    };
    qb.profile_accepts(union_filtered_outer_plan(), full_profile())
        && !qb.profile_accepts(union_filtered_outer_plan(), no_filter)
        && !qb.profile_accepts(union_filtered_outer_plan(), no_count)
};

# ---------------------------------------------------------------------------
# Correlated EXISTS whose outer column references a JOINED main alias (the
# Query-layer shape used by the Ontology for bounded two-hop existence).
#
# A correlated EXISTS is only a predicate; it never emits a join to the inner
# source. Combining a grain-safe owner INNER JOIN with a correlated EXISTS on
# the joined owner alias keeps the base grain: the inner (target) table appears
# only inside the subquery, never in the outer FROM/JOIN list.
# ---------------------------------------------------------------------------

def assert_ok: Fn(Bool, String) -> Bool = fn(cond, label) {
    if cond { True } else { fail!("query contract check failed", label) }
};

def two_hop_exists_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-two-hop-exists",
        sources: [qb.source("b", "components")],
        projection: [qb.aggregate(qb.AggregateFunction.Count, qb.column("b", "id"), False, "component_count")],
        filter: None,
        joins: [
            qb.join(
                qb.JoinKind.Inner,
                qb.source("s", "sites"),
                qb.column_ref("b", "site_id"),
                qb.column_ref("s", "id"),
            ),
        ],
        exists: [qb.exists(
            qb.source("a", "alarms"),
            [qb.column_eq(qb.column_ref("s", "id"), qb.column_ref("a", "site_id"))],
            Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("a", "level"), qb.bind_int(3)])),
        )],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def expected_two_hop_sql = "SELECT count(b.id) AS component_count FROM components AS b INNER JOIN sites AS s ON b.site_id = s.id WHERE EXISTS (SELECT 1 FROM alarms AS a WHERE s.id = a.site_id AND a.level = ?)";

def two_hop_exists_structure_accepts_joined_outer_alias = fn() {
    let plan = two_hop_exists_plan();
    let joins_ok = array.length(plan.joins) == 1 && array.length(plan.exists) == 1;
    assert_ok(qb.structure_ok(plan) && joins_ok,
        "two-hop: EXISTS outer column may reference a joined main alias")
};

def two_hop_exists_lowers_with_owner_join_and_correlated_exists = fn() {
    let q = qb.transform_sqlite(two_hop_exists_plan());
    let expected: Array(qb.Val) = [qb.Val.Int(3)];
    assert_ok(q.sql == expected_two_hop_sql,
        "two-hop: SQL shape is owner join + correlated EXISTS")
        && assert_ok(q.bindings == expected, "two-hop: bindings stay in placeholder order")
        && assert_ok(!string.contains(q.sql, "JOIN alarms"), "two-hop: the target is never outer-joined")
};

def two_hop_exists_deterministic = fn() {
    let q1 = qb.transform_sqlite(two_hop_exists_plan());
    let q2 = qb.transform_sqlite(two_hop_exists_plan());
    assert_ok(q1.sql == q2.sql && q1.bindings == q2.bindings,
        "two-hop: repeated lowering is byte-identical")
};

def two_hop_exists_profile_accepts = fn() {
    assert_ok(qb.profile_accepts(two_hop_exists_plan(), full_profile()),
        "two-hop: Join + Exists plan is accepted by the full profile")
};

def two_hop_exists_rejects_unknown_outer_alias = fn() {
    # A correlated EXISTS whose outer column names an alias that is neither a
    # base source nor a joined alias must be rejected structurally.
    let plan: qb.Plan = {
        revision: "test-two-hop-bad-outer",
        sources: [qb.source("b", "components")],
        projection: [qb.expr_item(qb.column("b", "id"))],
        filter: None,
        joins: [],
        exists: [qb.exists(
            qb.source("a", "alarms"),
            [qb.column_eq(qb.column_ref("ghost", "id"), qb.column_ref("a", "site_id"))],
            None,
        )],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    assert_ok(!qb.structure_ok(plan),
        "two-hop: an EXISTS outer column must resolve to a visible main alias")
};

# ---------------------------------------------------------------------------
# Correlated-union EXISTS (closed alternatives): `exists_union` keeps a base row
# when the inner source matches any alternative; each alternative is a non-empty
# conjunction of ColumnEq and every equality connects an outer main column to an
# inner source column.  The inner (target) table appears only inside the
# subquery, never in the outer FROM/JOIN list.
# ---------------------------------------------------------------------------

def union_exists_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-union-exists",
        sources: [qb.source("h", "hub")],
        projection: [qb.aggregate(qb.AggregateFunction.Count, qb.column("h", "id"), False, "hub_count")],
        filter: None,
        joins: [],
        exists: [qb.exists_union(
            qb.source("p", "part"),
            [
                [qb.column_eq(qb.column_ref("h", "left_id"), qb.column_ref("p", "id"))],
                [qb.column_eq(qb.column_ref("h", "right_id"), qb.column_ref("p", "id"))],
            ],
            Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("p", "kind"), qb.bind_string("vip")])),
        )],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def expected_union_exists_sql = "SELECT count(h.id) AS hub_count FROM hub AS h WHERE EXISTS (SELECT 1 FROM part AS p WHERE (h.left_id = p.id OR h.right_id = p.id) AND p.kind = ?)";

def union_exists_probe_plan: Fn(qb.Exists) -> qb.Plan = fn(ex) {
    let plan: qb.Plan = {
        revision: "test-union-exists-probe",
        sources: [qb.source("h", "hub")],
        projection: [qb.aggregate(qb.AggregateFunction.Count, qb.column("h", "id"), False, "hub_count")],
        filter: None,
        joins: [],
        exists: [ex],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def union_exists_structure_accepts_alternatives = fn() {
    let plan = union_exists_plan();
    assert_ok(qb.structure_ok(plan) && array.length(plan.exists) == 1,
        "union exists: closed equality alternatives are structurally valid")
};

def union_exists_lowers_without_fanout_join = fn() {
    let q = qb.transform_sqlite(union_exists_plan());
    let expected: Array(qb.Val) = [qb.Val.String("vip")];
    assert_ok(q.sql == expected_union_exists_sql,
        "union exists: lowers to a correlated EXISTS over the alternatives")
        && assert_ok(q.bindings == expected, "union exists: participant filter binds in order")
        && assert_ok(!string.contains(q.sql, "JOIN part"), "union exists: the inner source is never outer-joined")
};

def union_exists_deterministic = fn() {
    let q1 = qb.transform_sqlite(union_exists_plan());
    let q2 = qb.transform_sqlite(union_exists_plan());
    assert_ok(q1.sql == q2.sql && q1.bindings == q2.bindings,
        "union exists: repeated lowering is byte-identical")
};

def union_exists_profile_accepts = fn() {
    assert_ok(qb.profile_accepts(union_exists_plan(), full_profile()),
        "union exists: Exists plan is accepted by the full profile")
};

def union_exists_rejects_empty_alternatives = fn() {
    let empty_union: Array(Array(qb.ColumnEq)) = [];
    let ex = qb.exists_union(qb.source("p", "part"), empty_union, None);
    assert_ok(!qb.structure_ok(union_exists_probe_plan(ex)),
        "union exists: an empty alternatives list is rejected")
};

def union_exists_rejects_empty_alternative = fn() {
    let empty_alt: Array(Array(qb.ColumnEq)) = [[]];
    let ex = qb.exists_union(qb.source("p", "part"), empty_alt, None);
    assert_ok(!qb.structure_ok(union_exists_probe_plan(ex)),
        "union exists: an empty conjunction alternative is rejected")
};

def union_exists_rejects_unknown_outer_alias = fn() {
    let bad: Array(Array(qb.ColumnEq)) = [[qb.column_eq(qb.column_ref("ghost", "id"), qb.column_ref("p", "id"))]];
    let ex = qb.exists_union(qb.source("p", "part"), bad, None);
    assert_ok(!qb.structure_ok(union_exists_probe_plan(ex)),
        "union exists: every equality outer column must be a visible main alias")
};

def union_exists_rejects_inner_mismatch = fn() {
    # A union equality whose right column is not on the inner source alias must
    # be rejected: the equality must strictly connect outer and inner.
    let bad: Array(Array(qb.ColumnEq)) = [[qb.column_eq(qb.column_ref("h", "id"), qb.column_ref("other", "id"))]];
    let ex = qb.exists_union(qb.source("p", "part"), bad, None);
    assert_ok(!qb.structure_ok(union_exists_probe_plan(ex)),
        "union exists: every equality right column must belong to the inner source")
};

# ---------------------------------------------------------------------------
# Closed paired-endpoint (peer) correlated EXISTS.
#
# A peer predicate keeps a hub base row when the ORIGIN and PEER participants
# (each proven through its own inner source alias) occupy the two mutually
# exclusive endpoints of that row, in either endpoint order.  It renders as a
# correlated EXISTS with TWO inner participant sources and the two ordered
# endpoint-exchange branches; participant key binds belong to the corresponding
# inner alias.  No participant is ever outer-joined, so the hub grain is not
# fanned out.
# ---------------------------------------------------------------------------

def peer_probe_plan: Fn(qb.Exists) -> qb.Plan = fn(ex) {
    let plan: qb.Plan = {
        revision: "test-peer-probe",
        sources: [qb.source("pr", "pairs")],
        projection: [qb.expr_item(qb.column("pr", "id"))],
        filter: None,
        exists: [ex],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def peer_left_role: qb.ColumnRef = qb.column_ref("pr", "left_id");
def peer_right_role: qb.ColumnRef = qb.column_ref("pr", "right_id");
def peer_origin_key: qb.ColumnRef = qb.column_ref("mo", "id");
def peer_peer_key: qb.ColumnRef = qb.column_ref("mp", "id");

# Build a valid closed paired correlation over the members table used twice
# (origin alias `mo`, peer alias `mp`).
def peer_corr_fixture: Fn(qb.Val, qb.Val) -> qb.PeerCorr = fn(origin, peer) {
    let a_origin = qb.column_eq(peer_left_role, peer_origin_key);
    let a_peer = qb.column_eq(peer_right_role, peer_peer_key);
    let b_origin = qb.column_eq(peer_right_role, peer_origin_key);
    let b_peer = qb.column_eq(peer_left_role, peer_peer_key);
    let branch_a = qb.peer_branch(a_origin, a_peer);
    let branch_b = qb.peer_branch(b_origin, b_peer);
    let origin_filter: qb.Expr = qb.scalar(qb.ScalarFunction.Eq, [qb.column("mo", "id"), qb.bind_val(origin)]);
    let peer_filter: qb.Expr = qb.scalar(qb.ScalarFunction.Eq, [qb.column("mp", "id"), qb.bind_val(peer)]);
    qb.peer_corr_distinct(
        qb.source("mo", "members"),
        qb.source("mp", "members"),
        branch_a,
        branch_b,
        Some(origin_filter),
        Some(peer_filter),
        True,
    )
};

def peer_exists_lowers_to_two_ordered_branches = fn() {
    let ex = qb.exists_peer(peer_corr_fixture(qb.Val.Int(101), qb.Val.Int(202)));
    let q = qb.transform_sqlite(peer_probe_plan(ex));
    let expected: Array(qb.Val) = [qb.Val.Int(101), qb.Val.Int(202)];
    let expected_sql = "SELECT pr.id FROM pairs AS pr WHERE EXISTS (SELECT 1 FROM members AS mo, members AS mp WHERE ((pr.left_id = mo.id AND pr.right_id = mp.id) OR (pr.right_id = mo.id AND pr.left_id = mp.id)) AND mo.id <> mp.id AND mo.id = ? AND mp.id = ?)";
    assert_ok(q.sql == expected_sql,
        "peer: two inner participant aliases and the two ordered endpoint-exchange branches")
        && assert_ok(q.bindings == expected, "peer: origin/peer key binds belong to their own inner aliases in placeholder order")
        && assert_ok(!string.contains(q.sql, " JOIN "), "peer: no outer participant join; no fan-out")
};

def peer_exists_structure_accepts = fn() {
    qb.structure_ok(peer_probe_plan(qb.exists_peer(peer_corr_fixture(qb.Val.Int(1), qb.Val.Int(2)))))
};

def peer_exists_rejects_unknown_hub_role_alias = fn() {
    # The hub role columns must reference a visible outer alias.
    let ghost: qb.ColumnRef = qb.column_ref("ghost", "left_id");
    let a_origin = qb.column_eq(ghost, peer_origin_key);
    let a_peer = qb.column_eq(peer_right_role, peer_peer_key);
    let b_origin = qb.column_eq(peer_right_role, peer_origin_key);
    let b_peer = qb.column_eq(peer_left_role, peer_peer_key);
    let corr = qb.peer_corr(
        qb.source("mo", "members"),
        qb.source("mp", "members"),
        qb.peer_branch(a_origin, a_peer),
        qb.peer_branch(b_origin, b_peer),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("mo", "id"), qb.bind_int(1)])),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("mp", "id"), qb.bind_int(2)])),
    );
    !qb.structure_ok(peer_probe_plan(qb.exists_peer(corr)))
};

def peer_exists_rejects_same_endpoint = fn() {
    # Same-side match: the two hub role columns must be distinct.
    let a_origin = qb.column_eq(peer_left_role, peer_origin_key);
    let a_peer = qb.column_eq(peer_left_role, peer_peer_key);
    let b_origin = qb.column_eq(peer_left_role, peer_origin_key);
    let b_peer = qb.column_eq(peer_left_role, peer_peer_key);
    let corr = qb.peer_corr(
        qb.source("mo", "members"),
        qb.source("mp", "members"),
        qb.peer_branch(a_origin, a_peer),
        qb.peer_branch(b_origin, b_peer),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("mo", "id"), qb.bind_int(1)])),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("mp", "id"), qb.bind_int(2)])),
    );
    !qb.structure_ok(peer_probe_plan(qb.exists_peer(corr)))
};

def peer_exists_rejects_inconsistent_branches = fn() {
    # The two exchange branches must swap the SAME two hub roles and SAME inner
    # key columns; an inconsistent branch loses the identity proof shape.
    let a_origin = qb.column_eq(peer_left_role, peer_origin_key);
    let a_peer = qb.column_eq(peer_right_role, peer_peer_key);
    let b_origin = qb.column_eq(peer_right_role, peer_origin_key);
    let b_peer = qb.column_eq(qb.column_ref("pr", "other_col"), peer_peer_key);
    let corr = qb.peer_corr(
        qb.source("mo", "members"),
        qb.source("mp", "members"),
        qb.peer_branch(a_origin, a_peer),
        qb.peer_branch(b_origin, b_peer),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("mo", "id"), qb.bind_int(1)])),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("mp", "id"), qb.bind_int(2)])),
    );
    !qb.structure_ok(peer_probe_plan(qb.exists_peer(corr)))
};

def peer_exists_rejects_cross_alias_participant_filter = fn() {
    # A participant filter must belong to its own inner alias; referencing the
    # other participant alias breaks the identity proof.
    let a_origin = qb.column_eq(peer_left_role, peer_origin_key);
    let a_peer = qb.column_eq(peer_right_role, peer_peer_key);
    let b_origin = qb.column_eq(peer_right_role, peer_origin_key);
    let b_peer = qb.column_eq(peer_left_role, peer_peer_key);
    let corr = qb.peer_corr(
        qb.source("mo", "members"),
        qb.source("mp", "members"),
        qb.peer_branch(a_origin, a_peer),
        qb.peer_branch(b_origin, b_peer),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("mp", "id"), qb.bind_int(1)])),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("mp", "id"), qb.bind_int(2)])),
    );
    !qb.structure_ok(peer_probe_plan(qb.exists_peer(corr)))
};

def peer_exists_equal_key_values_across_aliases = fn() {
    # Cross-table key collisions are legal at the AST level because each
    # equality is tied to its own participant alias; the SQL never reinterprets
    # one endpoint value through both tables in a single equality.
    qb.structure_ok(peer_probe_plan(qb.exists_peer(peer_corr_fixture(qb.Val.Int(7), qb.Val.Int(7)))))
};

def peer_exists_operator_vocabulary = fn() {
    let ex = qb.exists_peer(peer_corr_fixture(qb.Val.Int(1), qb.Val.Int(2)));
    let expected: Array(qb.Operator) = [
        qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Exists,
    ];
    qb.operators(peer_probe_plan(ex)) == expected
};

def peer_exists_profile_accepts = fn() {
    let ex = qb.exists_peer(peer_corr_fixture(qb.Val.Int(1), qb.Val.Int(2)));
    let plan = peer_probe_plan(ex);
    qb.profile_accepts(plan, full_profile())
};

def peer_exists_profile_rejects_without_exists = fn() {
    # A paired correlation is an Exists capability; removing qb.Operator.Exists must reject
    # it even when the underlying equality/scalar capabilities are allowed.
    let ex = qb.exists_peer(peer_corr_fixture(qb.Val.Int(1), qb.Val.Int(2)));
    let plan = peer_probe_plan(ex);
    let no_exists: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Eq, qb.ScalarFunction.And, qb.ScalarFunction.Or],
        allow_distinct: True,
    };
    !qb.profile_accepts(plan, no_exists)
};

def peer_exists_deterministic = fn() {
    let ex = qb.exists_peer(peer_corr_fixture(qb.Val.Int(101), qb.Val.Int(202)));
    let q1 = qb.transform_sqlite(peer_probe_plan(ex));
    let q2 = qb.transform_sqlite(peer_probe_plan(ex));
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

def peer_exists_placeholders_match_bindings = fn() {
    let ex = qb.exists_peer(peer_corr_fixture(qb.Val.Int(101), qb.Val.Int(202)));
    let q = qb.transform_sqlite(peer_probe_plan(ex));
    (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
};

def peer_exists_cross_table_no_bare_key_guard = fn() {
    # For participants of DIFFERENT entities/tables the same key value is still
    # two different identities: NO bare `<>` inequality is added, and the pair
    # stays legal (cross-table key collision).
    let a_origin = qb.column_eq(peer_left_role, qb.column_ref("lo", "id"));
    let a_peer = qb.column_eq(peer_right_role, qb.column_ref("rp", "id"));
    let b_origin = qb.column_eq(peer_right_role, qb.column_ref("lo", "id"));
    let b_peer = qb.column_eq(peer_left_role, qb.column_ref("rp", "id"));
    let corr = qb.peer_corr(
        qb.source("lo", "left_parts"),
        qb.source("rp", "right_parts"),
        qb.peer_branch(a_origin, a_peer),
        qb.peer_branch(b_origin, b_peer),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("lo", "id"), qb.bind_int(22)])),
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("rp", "id"), qb.bind_int(22)])),
    );
    let q = qb.transform_sqlite(peer_probe_plan(qb.exists_peer(corr)));
    let expected: Array(qb.Val) = [qb.Val.Int(22), qb.Val.Int(22)];
    assert_ok(!string.contains(q.sql, "<>"), "peer: no bare key inequality across different participant tables")
        && assert_ok(q.bindings == expected,
            "peer: cross-table equal keys remain two independent bindings")
};

# ---------------------------------------------------------------------------
# Result-set distinct rows (`transform_sqlite_distinct`).
#
# A row/listing Plan (ungrouped, aggregate-free, expression-only projection) is
# rendered as `SELECT DISTINCT ...`, so the result contains mutually distinct
# rows.  SQLite requires every ORDER BY term of a SELECT DISTINCT to appear in
# the result set, so the wrapper enforces that ordering keys are projected
# expressions.  Bindings keep placeholder order; determinism is preserved.
# ---------------------------------------------------------------------------

def distinct_probe_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-distinct-probe",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "region"))],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("o", "kind"), qb.bind_string("sensor")])),
        joins: [],
        grouping: [],
        having: [],
        ordering: [qb.asc(qb.column("o", "region"))],
        limit: Some(25),
        offset: None,
        exists: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def distinct_probe_aggregate_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-distinct-aggregate",
        sources: [qb.source("o", "orders")],
        projection: [
            qb.expr_item(qb.column("o", "region")),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("o", "id"), False, "order_count"),
        ],
        filter: None,
        joins: [],
        grouping: [qb.column("o", "region")],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        exists: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def distinct_rows_lowers_to_select_distinct = fn() {
    let q = qb.transform_sqlite_distinct(distinct_probe_plan());
    let expected: Array(qb.Val) = [qb.Val.String("sensor"), qb.Val.Int(25)];
    assert_ok(q.sql == "SELECT DISTINCT o.region FROM orders AS o WHERE o.kind = ? ORDER BY o.region ASC LIMIT ?",
        "distinct rows: SELECT DISTINCT over a row projection")
        && assert_ok(q.bindings == expected, "distinct rows: bindings keep placeholder order")
        && assert_ok((array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings),
            "distinct rows: placeholder count matches binding count")
};

def distinct_rows_structure_is_ok_and_deterministic = fn() {
    let p1 = distinct_probe_plan();
    let q1 = qb.transform_sqlite_distinct(p1);
    let q2 = qb.transform_sqlite_distinct(p1);
    assert_ok(qb.structure_ok(p1), "distinct rows: the underlying row plan is structurally valid")
        && assert_ok(q1.sql == q2.sql && q1.bindings == q2.bindings,
            "distinct rows: repeated lowering is byte-identical")
};

# The distinct row wrapper accepts only expression-only projections; an
# aggregate/grouped body is not a distinct-row shape and is rejected by the
# deterministic lowering guard (its structure itself stays valid).
def distinct_rows_rejects_aggregate_projection = fn() {
    # `structure_ok` is true for the grouped plan; the distinct-row wrapper
    # rejects it deterministically (asserted here via the public guard result
    # being false is not observable without a failure, so we assert the guard
    # precondition: the plan is grouped/aggregate-bearing and not row-level).
    let p = distinct_probe_aggregate_plan();
    let aggregate_present = array.any(p.projection, fn(item) {
        match item {
            qb.SelectItem.Aggregate(_) => True,
            qb.SelectItem.Computed(_) => True,
            qb.SelectItem.Expr(_) => False,
        }
    });
    assert_ok(array.length(p.grouping) > 0 && aggregate_present,
        "distinct rows: aggregate/grouped plans are outside the row-distinct shape")
};

# ---------------------------------------------------------------------------
# Anti-existence (`exists_not` -> `NOT EXISTS (...)`).
#
# Wrapping any correlated body with `exists_not` keeps the same correlation,
# source and bindings but renders as `NOT EXISTS`, so base rows with no matching
# related row are kept (NULL semantics stay SQL-native).
# ---------------------------------------------------------------------------

def not_exists_probe_plan: Fn() -> qb.Plan = fn() {
    let ex = qb.exists_not(qb.exists(
        qb.source("a", "alerts"),
        [qb.column_eq(qb.column_ref("d", "id"), qb.column_ref("a", "device_id"))],
        Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("a", "level"), qb.bind_int(3)])),
    ));
    let plan: qb.Plan = {
        revision: "test-not-exists",
        sources: [qb.source("d", "devices")],
        projection: [qb.expr_item(qb.column("d", "id"))],
        filter: None,
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        exists: [ex],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def exists_not_lowers_to_not_exists = fn() {
    let q = qb.transform_sqlite(not_exists_probe_plan());
    let expected: Array(qb.Val) = [qb.Val.Int(3)];
    assert_ok(q.sql == "SELECT d.id FROM devices AS d WHERE NOT EXISTS (SELECT 1 FROM alerts AS a WHERE d.id = a.device_id AND a.level = ?)",
        "exists_not: the correlated body renders as NOT EXISTS")
        && assert_ok(q.bindings == expected, "exists_not: inner filter bindings keep placeholder order")
        && assert_ok(qb.structure_ok(not_exists_probe_plan()), "exists_not: the negated body is structurally valid")
};

def exists_not_deterministic = fn() {
    let q1 = qb.transform_sqlite(not_exists_probe_plan());
    let q2 = qb.transform_sqlite(not_exists_probe_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

# ---------------------------------------------------------------------------
# Internal (non-projected) ordering aggregate: a grouped Plan may ORDER BY an
# aggregate call that is NOT projected (e.g. return only the group name but
# order the groups by their record count and take Top N).
# ---------------------------------------------------------------------------

def internal_agg_order_plan: Fn() -> qb.Plan = fn() {
    let call: qb.AggregateCall = {
        function: qb.AggregateFunction.Count,
        arg: qb.column("o", "id"),
        distinct: False,
        filter: None,
        alias: "__internal_order",
    };
    let ob = qb.order_by(qb.OrderKey.Aggregate(call), qb.Ordering.Desc);
    let plan: qb.Plan = {
        revision: "test-internal-agg-order",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "region"))],
        filter: None,
        joins: [],
        grouping: [qb.column("o", "region")],
        having: [],
        ordering: [ob],
        limit: Some(3),
        offset: None,
        exists: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def internal_aggregate_ordering_lowers_without_projection = fn() {
    let p = internal_agg_order_plan();
    let q = qb.transform_sqlite(p);
    let expected: Array(qb.Val) = [qb.Val.Int(3)];
    assert_ok(qb.structure_ok(p), "internal aggregate ordering: the grouped plan is structurally valid")
        && assert_ok(qb.profile_accepts(p, full_profile()), "internal aggregate ordering: profile accepts the internal aggregate")
        && assert_ok(q.sql == "SELECT o.region FROM orders AS o GROUP BY o.region ORDER BY count(o.id) DESC LIMIT ?",
            "internal aggregate ordering: SQL orders groups by the unprojected aggregate and returns only the group column")
        && assert_ok(q.bindings == expected, "internal aggregate ordering: bindings keep placeholder order")
};

def internal_aggregate_ordering_deterministic = fn() {
    let p = internal_agg_order_plan();
    let q1 = qb.transform_sqlite(p);
    let q2 = qb.transform_sqlite(p);
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

# ---------------------------------------------------------------------------
# Bounded two-hop correlated existence (`exists_two_hop` / `ExistsLink`): the
# whole A -> B -> C condition stays inside ONE correlated EXISTS whose B and C
# are joined to each other in the subquery, so a fan-out A -> B first hop never
# fans out the subject A.
# ---------------------------------------------------------------------------

def two_hop_link_plan: Fn() -> qb.Plan = fn() {
    let hop_pairs: Array(qb.ColumnEq) = [
        qb.column_eq(qb.column_ref("s", "owner_id"), qb.column_ref("b", "id")),
    ];
    let link_pairs: Array(qb.ColumnEq) = [
        qb.column_eq(qb.column_ref("b", "id"), qb.column_ref("c", "owner_id")),
    ];
    let link_filter: qb.Expr = qb.scalar(qb.ScalarFunction.Eq, [qb.column("c", "level"), qb.bind_int(2)]);
    let ex = qb.exists_two_hop(
        qb.source("b", "link_owner"),
        hop_pairs,
        qb.source("c", "link_target"),
        link_pairs,
        Some(link_filter),
    );
    let plan: qb.Plan = {
        revision: "test-two-hop-link",
        sources: [qb.source("s", "subjects")],
        projection: [qb.aggregate(qb.AggregateFunction.Count, qb.column("s", "id"), False, "subject_count")],
        filter: None,
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        exists: [ex],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def two_hop_link_lowers_to_inner_join_exists = fn() {
    let p = two_hop_link_plan();
    let q = qb.transform_sqlite(p);
    let expected: Array(qb.Val) = [qb.Val.Int(2)];
    assert_ok(qb.structure_ok(p), "two-hop link: the correlated link body is structurally valid")
        && assert_ok(qb.profile_accepts(p, full_profile()), "two-hop link: profile accepts the link body")
        && assert_ok(q.sql == "SELECT count(s.id) AS subject_count FROM subjects AS s WHERE EXISTS (SELECT 1 FROM link_owner AS b INNER JOIN link_target AS c ON b.id = c.owner_id WHERE s.owner_id = b.id AND c.level = ?)",
            "two-hop link: B and C are joined inside ONE correlated EXISTS; no outer fan-out join")
        && assert_ok(q.bindings == expected, "two-hop link: target filter binds in placeholder order")
};

def two_hop_link_deterministic = fn() {
    let p = two_hop_link_plan();
    let q1 = qb.transform_sqlite(p);
    let q2 = qb.transform_sqlite(p);
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

# ---------------------------------------------------------------------------
# Closed set operations (INTERSECT / EXCEPT / distinct UNION).
# ---------------------------------------------------------------------------

def set_operand_plan: Fn(String) -> qb.Plan = fn(region) {
    let plan: qb.Plan = {
        revision: "test-set-operand",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "region"))],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("o", "region"), qb.bind_string(region)])),
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        exists: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def set_ordered_operand_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-set-ordered",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "region"))],
        filter: None,
        joins: [],
        grouping: [],
        having: [],
        ordering: [qb.asc(qb.column("o", "region"))],
        limit: None,
        offset: None,
        exists: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def set_two_col_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-set-two-col",
        sources: [qb.source("o", "orders")],
        projection: [
            qb.expr_item(qb.column("o", "region")),
            qb.expr_item(qb.column("o", "customer_id")),
        ],
        filter: None,
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        exists: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def set_ok_accepts_compatible_operands = fn() {
    assert_ok(qb.set_ok(qb.SetOpKind.Intersect, set_operand_plan("east"), set_operand_plan("north")),
        "set ok: compatible single-column operands are accepted")
        && assert_ok(qb.set_ok(qb.SetOpKind.Union, set_operand_plan("east"), set_operand_plan("north")),
            "set ok: distinct Union accepted")
        && assert_ok(qb.set_ok(qb.SetOpKind.Except, set_operand_plan("east"), set_operand_plan("north")),
            "set ok: Except accepted")
};

def set_lowers_direct_and_concats_bindings = fn() {
    # SQLite-valid compound-select syntax: top-level operands are BARE
    # select-statements joined by the set keyword, NOT parenthesized terms
    # (`(SELECT ...) INTERSECT (SELECT ...)` is rejected by SQLite).
    let qi = qb.transform_sqlite_set(qb.SetOpKind.Intersect, set_operand_plan("east"), set_operand_plan("north"));
    let qu = qb.transform_sqlite_set(qb.SetOpKind.Union, set_operand_plan("east"), set_operand_plan("north"));
    let qe = qb.transform_sqlite_set(qb.SetOpKind.Except, set_operand_plan("east"), set_operand_plan("north"));
    let expected: Array(qb.Val) = [qb.Val.String("east"), qb.Val.String("north")];
    assert_ok(qi.sql == "SELECT o.region FROM orders AS o WHERE o.region = ? INTERSECT SELECT o.region FROM orders AS o WHERE o.region = ?",
        "set: INTERSECT renders as a bare executable compound select")
        && assert_ok(qu.sql == "SELECT o.region FROM orders AS o WHERE o.region = ? UNION SELECT o.region FROM orders AS o WHERE o.region = ?",
            "set: distinct UNION renders as a bare executable compound select")
        && assert_ok(qe.sql == "SELECT o.region FROM orders AS o WHERE o.region = ? EXCEPT SELECT o.region FROM orders AS o WHERE o.region = ?",
            "set: EXCEPT renders as a bare executable compound select")
        && assert_ok(qi.bindings == expected && qu.bindings == expected && qe.bindings == expected,
            "set: bindings concatenate left-to-right operand order for every set keyword")
        && assert_ok(!string.contains(qi.sql, ") INTERSECT (")
            && !string.contains(qu.sql, ") UNION (")
            && !string.contains(qe.sql, ") EXCEPT ("),
            "set: no top-level operand is wrapped in the SQLite-rejected parenthesized form")
};

def set_lowers_grouped_operands_with_filter_and_binding_order = fn() {
    # A grouped operand (projection + GROUP BY) stays a bare compound term; the
    # per-operand WHERE filters keep deterministic left-to-right bindings.
    let grouped: Fn(String) -> qb.Plan = fn(region) {
        let plan: qb.Plan = {
            revision: "test-set-grouped",
            sources: [qb.source("o", "orders")],
            projection: [
                qb.expr_item(qb.column("o", "region")),
                qb.aggregate(qb.AggregateFunction.Count, qb.column("o", "id"), False, "order_count"),
            ],
            filter: Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("o", "kind"), qb.bind_string("sensor")])),
            joins: [],
            grouping: [qb.column("o", "region")],
            having: [],
            ordering: [],
            limit: None,
            offset: None,
            exists: [],
            derived: None,
            partition: None,
            scalar_comparisons: [],
        ranked_key_comparisons: [],
        };
        plan
    };
    let q = qb.transform_sqlite_set(qb.SetOpKind.Intersect, grouped("east"), grouped("north"));
    let expected_sql = "SELECT o.region, count(o.id) AS order_count FROM orders AS o WHERE o.kind = ? GROUP BY o.region INTERSECT SELECT o.region, count(o.id) AS order_count FROM orders AS o WHERE o.kind = ? GROUP BY o.region";
    let expected: Array(qb.Val) = [qb.Val.String("sensor"), qb.Val.String("sensor")];
    assert_ok(q.sql == expected_sql,
        "set: grouped operands with per-operand filters stay bare executable compound terms")
        && assert_ok(q.bindings == expected, "set: per-operand filter bindings concatenate left-to-right in placeholder order")
        && assert_ok((array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings),
            "set: placeholder count matches binding count")
};

def set_count_wraps_derived_set = fn() {
    let q = qb.transform_sqlite_set_count(qb.SetOpKind.Union, set_operand_plan("east"), set_operand_plan("north"));
    let expected: Array(qb.Val) = [qb.Val.String("east"), qb.Val.String("north")];
    assert_ok(q.sql == "SELECT count(1) FROM (SELECT o.region FROM orders AS o WHERE o.region = ? UNION SELECT o.region FROM orders AS o WHERE o.region = ?) AS __q_set",
        "set count: the executable compound select is wrapped once as a derived table")
        && assert_ok(q.bindings == expected, "set count: bindings are the operand bindings in order")
};

def set_projection_preserved = fn() {
    # The public projection of each operand is preserved exactly: same items,
    # same order, and no helper column is introduced by the compound form.
    let left = set_operand_plan("east");
    let right = set_operand_plan("north");
    let q = qb.transform_sqlite_set(qb.SetOpKind.Union, left, right);
    assert_ok(qb.set_ok(qb.SetOpKind.Union, left, right), "set: compatible operands are accepted")
        && assert_ok(q.sql == "SELECT o.region FROM orders AS o WHERE o.region = ? UNION SELECT o.region FROM orders AS o WHERE o.region = ?",
            "set: the compound result keeps the operands' shared projection")
        && assert_ok(!string.contains(q.sql, "__q_") && !string.contains(q.sql, "AS __q_"),
            "set: no helper column is introduced into either operand")
};

def set_ok_rejects_local_ordering_and_arity_mismatch = fn() {
    assert_ok(!qb.set_ok(qb.SetOpKind.Intersect, set_operand_plan("east"), set_ordered_operand_plan()),
        "set ok: an operand with local ordering is rejected")
        && assert_ok(!qb.set_ok(qb.SetOpKind.Intersect, set_operand_plan("east"), set_two_col_plan()),
            "set ok: projection arity mismatch is rejected")
};

def set_deterministic = fn() {
    let q1 = qb.transform_sqlite_set(qb.SetOpKind.Except, set_operand_plan("east"), set_operand_plan("north"));
    let q2 = qb.transform_sqlite_set(qb.SetOpKind.Except, set_operand_plan("east"), set_operand_plan("north"));
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

# Profile that allows every operator but only the Count aggregate and no
# distinct aggregates.
def count_only_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [
            qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Aggregate,
            qb.Operator.Filter, qb.Operator.Exists, qb.Operator.Join, qb.Operator.Group, qb.Operator.Having, qb.Operator.Order, qb.Operator.Limit,
            qb.Operator.Offset, qb.Operator.Partition,
        ],
        allowed_join_kinds: [qb.JoinKind.Inner, qb.JoinKind.Left],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Substr, qb.ScalarFunction.Instr, qb.ScalarFunction.If, qb.ScalarFunction.Add, qb.ScalarFunction.Sub, qb.ScalarFunction.Lower, qb.ScalarFunction.Length, qb.ScalarFunction.JsonExtract, qb.ScalarFunction.JsonType, qb.ScalarFunction.JsonValid, qb.ScalarFunction.Eq, qb.ScalarFunction.Ne, qb.ScalarFunction.Lt, qb.ScalarFunction.Le, qb.ScalarFunction.Gt, qb.ScalarFunction.Ge, qb.ScalarFunction.And, qb.ScalarFunction.Or, qb.ScalarFunction.Not],
        allow_distinct: True,
    };
    profile
};

# ---------------------------------------------------------------------------
# Plan-level scalar aggregate comparison (query-core phase): an ordered array of
# `<outer> <op> (SELECT scalar aggregate ...)` predicates stored directly on the
# Plan; Expr stays the closed row-expression vocabulary.
# ---------------------------------------------------------------------------

def scalar_comparison_plan: Fn(Array(qb.ScalarAggregateComparison)) -> qb.Plan = fn(comparisons) {
    let plan: qb.Plan = {
        revision: "test-plan-scalar-comparison",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "region"))],
        filter: None,
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        exists: [],
        derived: None,
        partition: None,
        scalar_comparisons: comparisons,
        ranked_key_comparisons: [],
    };
    plan
};

def cmp_max_over_orders: Fn() -> qb.ScalarAggregateComparison = fn() {
    qb.scalar_aggregate_comparison(
        qb.column_ref("o", "amount"),
        qb.ScalarFunction.Gt,
        qb.scalar_subquery_spec(qb.source("i", "orders"), [], None, qb.AggregateFunction.Max, qb.column("i", "amount"), False, None),
    )
};

def cmp_min_east_orders: Fn() -> qb.ScalarAggregateComparison = fn() {
    qb.scalar_aggregate_comparison(
        qb.column_ref("o", "amount"),
        qb.ScalarFunction.Lt,
        qb.scalar_subquery_spec(
            qb.source("j", "orders"),
            [],
            Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("j", "region"), qb.bind_string("east")])),
            qb.AggregateFunction.Min,
            qb.column("j", "amount"),
            False,
            None,
        ),
    )
};

def cmp_count_orders: Fn() -> qb.ScalarAggregateComparison = fn() {
    qb.scalar_aggregate_comparison(
        qb.column_ref("o", "amount"),
        qb.ScalarFunction.Ge,
        qb.scalar_subquery_spec(qb.source("i", "orders"), [], None, qb.AggregateFunction.Count, qb.column("i", "id"), False, None),
    )
};

def cmp_invalid_outer_ref: Fn() -> qb.ScalarAggregateComparison = fn() {
    qb.scalar_aggregate_comparison(
        qb.column_ref("missing_alias", "amount"),
        qb.ScalarFunction.Gt,
        qb.scalar_subquery_spec(qb.source("i", "orders"), [], None, qb.AggregateFunction.Max, qb.column("i", "amount"), False, None),
    )
};

def cmp_invalid_op: Fn() -> qb.ScalarAggregateComparison = fn() {
    qb.scalar_aggregate_comparison(
        qb.column_ref("o", "amount"),
        qb.ScalarFunction.And,
        qb.scalar_subquery_spec(qb.source("i", "orders"), [], None, qb.AggregateFunction.Max, qb.column("i", "amount"), False, None),
    )
};

def cmp_invalid_inner_filter: Fn() -> qb.ScalarAggregateComparison = fn() {
    qb.scalar_aggregate_comparison(
        qb.column_ref("o", "amount"),
        qb.ScalarFunction.Gt,
        qb.scalar_subquery_spec(
            qb.source("i", "orders"),
            [],
            Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("ghost", "region"), qb.bind_string("east")])),
            qb.AggregateFunction.Max,
            qb.column("i", "amount"),
            False,
            None,
        ),
    )
};

def scalar_comparison_min_max_lowers_with_null_native_ops = fn() {
    let p = scalar_comparison_plan([cmp_max_over_orders()]);
    let q = qb.transform_sqlite(p);
    assert_ok(q.sql == "SELECT o.region FROM orders AS o WHERE o.amount > (SELECT max(i.amount) FROM orders AS i)",
        "plan-level comparison: an outer attribute is compared to a parenthesized max scalar subquery (NULL-native >)")
        && assert_ok(q.bindings == [], "plan-level comparison: the max subquery binds nothing")
};

def scalar_comparison_multiple_predicates_ordered_bindings = fn() {
    let p = scalar_comparison_plan([cmp_max_over_orders(), cmp_min_east_orders()]);
    let q = qb.transform_sqlite(p);
    let expected: Array(qb.Val) = [qb.Val.String("east")];
    assert_ok(q.sql == "SELECT o.region FROM orders AS o WHERE o.amount > (SELECT max(i.amount) FROM orders AS i) AND o.amount < (SELECT min(j.amount) FROM orders AS j WHERE j.region = ?)",
        "plan-level comparison: multiple predicates render in deterministic order as parenthesized scalar subqueries")
        && assert_ok(q.bindings == expected,
            "plan-level comparison: bindings follow predicate order, then inner row-filter expression order")
};

def scalar_comparison_invalid_references_rejected = fn() {
    let bad_outer = scalar_comparison_plan([cmp_invalid_outer_ref()]);
    let bad_op = scalar_comparison_plan([cmp_invalid_op()]);
    let bad_inner = scalar_comparison_plan([cmp_invalid_inner_filter()]);
    assert_ok(!qb.structure_ok(bad_outer), "plan-level comparison: an outer reference to an unknown alias is invalid")
        && assert_ok(!qb.structure_ok(bad_op), "plan-level comparison: a non-comparison operator is invalid")
        && assert_ok(!qb.structure_ok(bad_inner), "plan-level comparison: an inner row filter over an unknown alias is invalid")
};

def scalar_comparison_recursive_profile_rejection = fn() {
    let max_plan = scalar_comparison_plan([cmp_max_over_orders()]);
    let count_plan = scalar_comparison_plan([cmp_count_orders()]);
    assert_ok(qb.profile_accepts(max_plan, full_profile()), "plan-level comparison: Max accepted under the full profile")
        && assert_ok(!qb.profile_accepts(max_plan, count_only_profile()),
            "plan-level comparison: the inner aggregate is narrowed by the same profile")
        && assert_ok(qb.profile_accepts(count_plan, count_only_profile()),
            "plan-level comparison: an inner Count comparison is accepted when only Count is allowed")
};

def scalar_comparison_deterministic = fn() {
    let p = scalar_comparison_plan([cmp_max_over_orders(), cmp_min_east_orders()]);
    let q1 = qb.transform_sqlite(p);
    let q2 = qb.transform_sqlite(p);
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

# ---------------------------------------------------------------------------
# Ranked grouped-key scalar comparison (query-core phase): a separate closed
# typed spec where the inner query groups by exactly one key, orders the groups
# by ONE closed aggregate expression with a required direction and returns the
# first group's key (`LIMIT 1`).  Expr and the existing scalar-aggregate
# comparison stay unchanged.
# ---------------------------------------------------------------------------

def rank_order_call: Fn(qb.AggregateFunction, qb.Expr) -> qb.AggregateCall = fn(function, arg) {
    let call: qb.AggregateCall = {
        function: function,
        arg: arg,
        distinct: False,
        filter: None,
        alias: "__rank_order",
    };
    call
};

def ranked_plan: Fn(Array(qb.RankedKeyComparison)) -> qb.Plan = fn(comparisons) {
    let plan: qb.Plan = {
        revision: "test-ranked-comparison",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "region"))],
        filter: None,
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        exists: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: comparisons,
    };
    plan
};

def ranked_count_spec: Fn(qb.Ordering, Array(qb.Join), Option(qb.Expr)) -> qb.RankedKeySubquery = fn(direction, joins, filter) {
    qb.ranked_key_subquery_spec(
        qb.source("t", "txns"),
        joins,
        filter,
        [qb.column("t", "category")],
        rank_order_call(qb.AggregateFunction.Count, qb.column("t", "id")),
        direction,
    )
};

def ranked_avg_spec: Fn() -> qb.RankedKeySubquery = fn() {
    qb.ranked_key_subquery_spec(
        qb.source("t", "txns"),
        [],
        None,
        [qb.column("t", "category")],
        rank_order_call(qb.AggregateFunction.Avg, qb.column("t", "amount")),
        qb.Ordering.Desc,
    )
};

def ranked_cmp_eq: Fn(qb.RankedKeySubquery) -> qb.RankedKeyComparison = fn(sq) {
    qb.ranked_key_comparison(qb.column_ref("o", "id"), qb.ScalarFunction.Eq, sq)
};

def ranked_key_desc_exact_sql = fn() {
    let p = ranked_plan([ranked_cmp_eq(ranked_count_spec(qb.Ordering.Desc, [], None))]);
    let q = qb.transform_sqlite(p);
    assert_ok(qb.structure_ok(p), "ranked key: the grouped-key comparison plan is structurally valid")
        && assert_ok(q.sql == "SELECT o.region FROM orders AS o WHERE o.id = (SELECT t.category FROM txns AS t GROUP BY t.category ORDER BY count(t.id) DESC LIMIT 1)",
            "ranked key: descending aggregate rank renders as a parenthesized grouped-key scalar select")
        && assert_ok(q.bindings == [], "ranked key: no dynamic values enter the desc comparison")
};

def ranked_key_asc_exact_sql = fn() {
    let p = ranked_plan([ranked_cmp_eq(ranked_count_spec(qb.Ordering.Asc, [], None))]);
    let q = qb.transform_sqlite(p);
    assert_ok(q.sql == "SELECT o.region FROM orders AS o WHERE o.id = (SELECT t.category FROM txns AS t GROUP BY t.category ORDER BY count(t.id) ASC LIMIT 1)",
        "ranked key: ascending aggregate rank renders with ORDER BY ... ASC LIMIT 1")
};

def ranked_key_join_and_filter_binding_order = fn() {
    let filter: qb.Expr = qb.scalar(qb.ScalarFunction.Eq, [qb.column("t", "kind"), qb.bind_string("wire")]);
    let join: qb.Join = qb.join(qb.JoinKind.Inner, qb.source("k", "cats"), qb.column_ref("t", "cat_id"), qb.column_ref("k", "id"));
    let sq = ranked_count_spec(qb.Ordering.Asc, [join], Some(filter));
    let p = ranked_plan([ranked_cmp_eq(sq)]);
    let q = qb.transform_sqlite(p);
    let expected: Array(qb.Val) = [qb.Val.String("wire")];
    assert_ok(q.sql == "SELECT o.region FROM orders AS o WHERE o.id = (SELECT t.category FROM txns AS t INNER JOIN cats AS k ON t.cat_id = k.id WHERE t.kind = ? GROUP BY t.category ORDER BY count(t.id) ASC LIMIT 1)",
        "ranked key: inner joins and row filters stay inside the grouped-key subquery with deterministic clause order")
        && assert_ok(q.bindings == expected, "ranked key: the inner row-filter value binds in placeholder order")
        && assert_ok((array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings),
            "ranked key: placeholder count matches binding count")
};

def ranked_key_projection_preserved_and_deterministic = fn() {
    let p1 = ranked_plan([ranked_cmp_eq(ranked_count_spec(qb.Ordering.Desc, [], None))]);
    let p2 = ranked_plan([ranked_cmp_eq(ranked_count_spec(qb.Ordering.Desc, [], None))]);
    let q1 = qb.transform_sqlite(p1);
    let q2 = qb.transform_sqlite(p2);
    assert_ok(array.length(p1.projection) == 1 && q1.sql == "SELECT o.region FROM orders AS o WHERE o.id = (SELECT t.category FROM txns AS t GROUP BY t.category ORDER BY count(t.id) DESC LIMIT 1)",
        "ranked key: the outer projection unrelated to the grouped-key machinery is preserved exactly")
        && assert_ok(q1.sql == q2.sql && q1.bindings == q2.bindings,
            "ranked key: repeated lowering is byte-identical")
        && assert_ok(!string.contains(q1.sql, "coalesce"), "ranked key: native NULL comparison behavior (no injected coalesce)")
};

def ranked_key_recursive_profile = fn() {
    let avg_p = ranked_plan([ranked_cmp_eq(ranked_avg_spec())]);
    let count_p = ranked_plan([ranked_cmp_eq(ranked_count_spec(qb.Ordering.Desc, [], None))]);
    assert_ok(qb.profile_accepts(avg_p, full_profile()), "ranked key: Avg rank accepted under the full profile")
        && assert_ok(qb.profile_accepts(count_p, count_only_profile()),
            "ranked key: Count rank accepted when only Count is allowed")
        && assert_ok(!qb.profile_accepts(avg_p, count_only_profile()),
            "ranked key: a profile without the inner ordering aggregate rejects recursively")
};

def ranked_multi_key_spec: Fn() -> qb.RankedKeySubquery = fn() {
    qb.ranked_key_subquery_spec(
        qb.source("t", "txns"),
        [],
        None,
        [qb.column("t", "category"), qb.column("t", "kind")],
        rank_order_call(qb.AggregateFunction.Count, qb.column("t", "id")),
        qb.Ordering.Desc,
    )
};

def ranked_no_key_spec: Fn() -> qb.RankedKeySubquery = fn() {
    qb.ranked_key_subquery_spec(
        qb.source("t", "txns"),
        [],
        None,
        [],
        rank_order_call(qb.AggregateFunction.Count, qb.column("t", "id")),
        qb.Ordering.Desc,
    )
};

def ranked_leaky_key_spec: Fn() -> qb.RankedKeySubquery = fn() {
    qb.ranked_key_subquery_spec(
        qb.source("t", "txns"),
        [],
        None,
        [qb.column("o", "region")],
        rank_order_call(qb.AggregateFunction.Count, qb.column("t", "id")),
        qb.Ordering.Desc,
    )
};

def ranked_bad_order_arg_spec: Fn() -> qb.RankedKeySubquery = fn() {
    qb.ranked_key_subquery_spec(
        qb.source("t", "txns"),
        [],
        None,
        [qb.column("t", "category")],
        rank_order_call(qb.AggregateFunction.Count, qb.column("ghost", "id")),
        qb.Ordering.Desc,
    )
};

def ranked_bad_identifier_spec: Fn() -> qb.RankedKeySubquery = fn() {
    qb.ranked_key_subquery_spec(
        qb.source("t", "bad table"),
        [],
        None,
        [qb.column("t", "category")],
        rank_order_call(qb.AggregateFunction.Count, qb.column("t", "id")),
        qb.Ordering.Desc,
    )
};

def ranked_cmp_bad_outer: Fn() -> qb.RankedKeyComparison = fn() {
    qb.ranked_key_comparison(qb.column_ref("ghost", "id"), qb.ScalarFunction.Eq, ranked_count_spec(qb.Ordering.Desc, [], None))
};

def ranked_cmp_bad_op: Fn() -> qb.RankedKeyComparison = fn() {
    qb.ranked_key_comparison(qb.column_ref("o", "id"), qb.ScalarFunction.And, ranked_count_spec(qb.Ordering.Desc, [], None))
};

def ranked_key_rejections = fn() {
    assert_ok(!qb.structure_ok(ranked_plan([ranked_cmp_eq(ranked_no_key_spec())])),
        "ranked key: missing grouping (no key) is rejected")
        && assert_ok(!qb.structure_ok(ranked_plan([ranked_cmp_eq(ranked_multi_key_spec())])),
            "ranked key: multiple grouping keys are rejected")
        && assert_ok(!qb.structure_ok(ranked_plan([ranked_cmp_eq(ranked_leaky_key_spec())])),
            "ranked key: a key expression leaking an outer alias is rejected")
        && assert_ok(!qb.structure_ok(ranked_plan([ranked_cmp_eq(ranked_bad_order_arg_spec())])),
            "ranked key: an ordering aggregate argument over an unknown inner alias is rejected")
        && assert_ok(!qb.structure_ok(ranked_plan([ranked_cmp_eq(ranked_bad_identifier_spec())])),
            "ranked key: an invalid inner source identifier is rejected")
        && assert_ok(!qb.structure_ok(ranked_plan([ranked_cmp_bad_outer()])),
            "ranked key: an outer reference to an unknown alias is rejected")
        && assert_ok(!qb.structure_ok(ranked_plan([ranked_cmp_bad_op()])),
            "ranked key: a non-comparison operator is rejected")
};

