type DeviceId = struct(String);
type Identity = Schema({id: DeviceId, name: String});
type Metrics = Schema({cpu: Float, tenant: String});
type Device = Identity & Metrics;
data devices: Table(Device) = source("devices");
type Params = Schema({floor: Float});
data request: Params = input();
data top = query! {
    let a = from(devices);
    let projected = a |> filter(a.cpu > request.floor)
      |> project({id: a.id, name: a.name, cpu: a.cpu});
    projected
      |> order_by(desc(projected.cpu))
      |> take(5)
};
data summary = query! {
    let a = from(top);
    let projected = a |> project({n: count(), average: avg(a.cpu)});
    projected
};
data highest = query! {
    let a = from(top);
    let projected = a |> project({cpu: a.cpu});
    projected
      |> order_by(desc(projected.cpu))
      |> take_opt()
};
data best_device = query! {
    let a = from(top);
    let projected = a |> project({id: a.id, cpu: a.cpu});
    projected
      |> order_by(desc(projected.cpu))
      |> take_opt()
};
data average = query! {
    let a = from(top);
    let projected = a |> project({cpu: avg(a.cpu)});
    projected
      |> take_opt()
};

report report = tree! { Report [
    h1 ["设备 CPU"], UseTable(ref = top), ColumnChart(data = top, x = project!(name), value = project!(cpu))
] };
answer tree! { Answer [
    if is_empty(top) [p ["无数据"]] else [UseReport(ref = report)],
    p ["设备数：", Value(data = summary, field = project!(n))]
] };
