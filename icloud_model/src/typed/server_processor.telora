use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@registry::entity("server_processor_entity")
type Identity = struct {
    id: ComponentId
};
type SlotId = struct(Int);
@registry::dataset("source_PhysicalServerProcessor", "PhysicalServerProcessor", ["source_id"])
@registry::roles([subject, tenant, parent])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PhysicalServerProcessor__slotId",
                SlotId.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PhysicalServerProcessor.type, SlotId.type, "source_slotId")),
            "source_PhysicalServerProcessor__slotId",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
type PhysicalServerProcessor = struct {
    @m::column("tenantId")
    @g::exact("source_PhysicalServerProcessor__tenantId")
    source_tenantId: i::TenantId,
    @m::column("id")
    @g::exact("source_PhysicalServerProcessor__id")
    source_id: ComponentId,
    @m::column("slotId")
    source_slotId: SlotId,
    @m::column("frequency")
    @v::classification(
        SourcePhysicalServerProcessorFrequency_domain,
        "source_PhysicalServerProcessor__frequency"
    )
    source_frequency: Int,
    @m::column("model")
    @g::search("source_PhysicalServerProcessor__model")
    source_model: String,
    @m::column("manufacturer")
    @g::search("source_PhysicalServerProcessor__manufacturer")
    source_manufacturer: String,
    @m::column("processorType")
    @g::exact("source_PhysicalServerProcessor__processorType")
    source_processorType: String,
    @m::column("processorId")
    @g::exact("source_PhysicalServerProcessor__processorId")
    source_processorId: String,
    @m::column("parentResId")
    @g::exact("source_PhysicalServerProcessor__parentResId")
    source_parentResId: server::ServerOriginId,
    @m::column("operStatus")
    @v::classification(
        SourcePhysicalServerProcessorOperStatus_domain,
        "source_PhysicalServerProcessor__operStatus"
    )
    source_operStatus: String,
    @m::column("adminStatus")
    @v::classification(
        SourcePhysicalServerProcessorAdminStatus_domain,
        "source_PhysicalServerProcessor__adminStatus"
    )
    source_adminStatus: String,
    @m::column("name")
    @g::search("source_PhysicalServerProcessor__name")
    source_name: String,
    @m::column("projectId")
    @g::exact("source_PhysicalServerProcessor__projectId")
    source_projectId: String,
    @m::column("serialNumber")
    @g::search("source_PhysicalServerProcessor__serialNumber")
    source_serialNumber: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(PhysicalServerProcessor) = registry::dataset_of(
    PhysicalServerProcessor.type
);
def subject: m::Role(PhysicalServerProcessor) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerProcessor.type, ComponentId.type, "source_id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServerProcessor) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerProcessor.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent: m::Role(PhysicalServerProcessor) = m::role(
    dataset,
    server::origin_entity,
    "server_origin",
    False,
    [
        m::identity_part(
            m::field(
                PhysicalServerProcessor.type,
                server::ServerOriginId.type,
                "source_parentResId"
            ),
            m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id")
        )
    ]
);

def SourcePhysicalServerProcessorFrequency_domain: v::Domain(String, Int) = v::raw_ints(
    "SourcePhysicalServerProcessorFrequency",
    [-1]
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerProcessorOperStatus = enum {
    @ev::rename("0")
    @ev::description("normal", "正常")
    Normal,
    @ev::rename("1")
    @ev::description("warning", "警告")
    Warning,
    @ev::rename("2")
    @ev::description("minor", "一般")
    Minor,
    @ev::rename("3")
    @ev::description("major", "严重")
    Major,
    @ev::rename("4")
    @ev::description("critical", "紧急")
    Critical,
    @ev::rename("-1")
    @ev::description("error", "错误")
    Error,
    @ev::rename("-2")
    @ev::description("unknown", "未知")
    Unknown,
};
def SourcePhysicalServerProcessorOperStatus_domain: v::Domain(
    SourcePhysicalServerProcessorOperStatus,
    String
) = v::from_enum(
    "SourcePhysicalServerProcessorOperStatus",
    SourcePhysicalServerProcessorOperStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerProcessorAdminStatus = enum {
    @ev::rename("0")
    @ev::alias("-1")
    @ev::description("unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::description("enabled", "已启用")
    Enabled,
    @ev::rename("2")
    @ev::description("disabled", "未启用")
    Disabled,
};
def SourcePhysicalServerProcessorAdminStatus_domain: v::Domain(
    SourcePhysicalServerProcessorAdminStatus,
    String
) = v::from_enum(
    "SourcePhysicalServerProcessorAdminStatus",
    SourcePhysicalServerProcessorAdminStatus.type,
    String.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_PhysicalServer_PhysicalServerProcessor",
        r::endpoint(server::dataset.row, server::origin.id),
        r::endpoint(dataset.row, parent.id),
        cardinality
    ),
    r::relation(
        "source_PhysicalServerProcessor_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        cardinality
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerProcessor, Identity};
