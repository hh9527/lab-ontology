use ontology::knowledge_policy as knowledge_policy;
# ServerFan独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(String);
type Identity = struct { id: ComponentId };
type Row = struct {
    id: ComponentId,
    name: String,
    parent_res_id: server::ServerOriginId,
    tenant_id: i::TenantId,
    manufacturer: String,
    source_sn: String,
    source_slotId: Int,
    source_healthStatus: Int,
    source_fanName: String,
    source_projectId: String,
};
def entity: m::Entity(Identity) = m::entity("server_fan_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset("server_fan", "PhysicalServerFan", Row.type, ["id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, ComponentId.type, "id"), m::field(Identity.type, ComponentId.type, "id"))]);
def parent: m::Role(Row) = m::role(dataset, server::origin_entity, "server_origin", False, [m::identity_part(m::field(Row.type, server::ServerOriginId.type, "parent_res_id"), m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
@knowledge_policy::reverse_references(True)
type ServerFanHealthStatus = struct(String);
def health: v::Domain(ServerFanHealthStatus, Int) = v::domain("ServerFanHealthStatus", ServerFanHealthStatus.type, Int.type, [
    v::member(ServerFanHealthStatus("wire_0_92e42f8f"), [0]),
    v::member(ServerFanHealthStatus("wire_1_8d618873"), [1]),
    v::member(ServerFanHealthStatus("wire_2_d0a68914"), [2]),
    v::member(ServerFanHealthStatus("wire_3_bab86ec8"), [3]),
    v::member(ServerFanHealthStatus("wire_4_5978b238"), [4]),
    v::member(ServerFanHealthStatus("wire__1_fe93bf05"), [-1]),
    v::member(ServerFanHealthStatus("wire__2_1027a474"), [-2]),
], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [subject, parent, tenant], [
    i::exact(dataset, m::field(Row.type, ComponentId.type, "id"), "server_fan_id"),
    i::search(dataset, m::field(Row.type, String.type, "name"), "server_fan_name"),
    i::search(dataset, m::field(Row.type, String.type, "manufacturer"), "server_fan_manufacturer"),
    i::search(dataset, m::field(Row.type, String.type, "source_sn"), "server_fan__sn"),
    g::dimension(dataset, g::dimension_group("server_fan__slotId", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_slotId")), "server_fan__slotId", True, g::numeric_filters),
    i::search(dataset, m::field(Row.type, String.type, "source_fanName"), "server_fan__fanName"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "server_fan__projectId"),
], ["server_fan_count"]), [
    t::column(m::field(Row.type, ComponentId.type, "id"), "id"),
    t::column(m::field(Row.type, String.type, "name"), "name"),
    t::column(m::field(Row.type, server::ServerOriginId.type, "parent_res_id"), "parentResId"),
    t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::field(Row.type, String.type, "manufacturer"), "manufacturer"),
    t::column(m::field(Row.type, String.type, "source_sn"), "sn"),
    t::column(m::field(Row.type, Int.type, "source_slotId"), "slotId"),
    t::column(m::field(Row.type, Int.type, "source_healthStatus"), "healthStatus"),
    t::column(m::field(Row.type, String.type, "source_fanName"), "fanName"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
 ]), [
    v::bind(dataset, v::dimension_group(health, True, g::equality_filters), g::input(m::field(Row.type, Int.type, "source_healthStatus")), "server_fan__healthStatus", True, g::equality_filters),
]);
def tenant_cardinality: edsl::RelationCardinality = {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0};
def relations: Array(r::Relation) = [
    r::relation("fan_parent_server", dataset, parent, server::dataset, server::origin, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("source_PhysicalServer_PhysicalServerFan", server::dataset, server::origin, dataset, parent, tenant_cardinality),
    r::relation("source_PhysicalServerFan_X_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, tenant_cardinality),
    r::relation("fan_belongs_to_tenant", dataset, tenant, i::tenants, i::tenant_subject, tenant_cardinality),
];
pub use self::{declaration, relations};
