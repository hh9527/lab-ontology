pub def relations: Array(r::Relation) = [
    r::relation("eom__enl", domain::endpoint(EnterpriseOpticalModule.type, "if_name"), domain::endpoint(enterprise_network_ltp::EnterpriseNetworkLtp.type, "name"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("eom__eom2", domain::endpoint(EnterpriseOpticalModule.type, "obj_sys_id"), domain::endpoint(enterprise_optical_module_2_kpi::EnterpriseOpticalModule2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("eom__ne_rev", domain::endpoint(EnterpriseOpticalModule.type, "ne_res_id"), domain::endpoint(network_element::NetworkElement.type, "id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
