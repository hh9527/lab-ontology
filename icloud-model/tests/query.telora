        if entity.id == "device" {
            let dataset = match entity.dataset {
                Some(spec) => Some({...spec, grain: ["id", "tenant_id", "name"]}),
                None => fail!("device must declare its grain"),
            };
            {...entity, dataset}
        } else { entity }
    });
    bounded_sample_plan({...payload, entities})
}, "sample-to-owner relation must cover the owner's complete declared grain");

