        "group_by_identity":["device"]}"#).unwrap!())
}, "graph projection measure does not belong to its named node");

pub def filtered_alarm_count_rejects_multiplying_site_join: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"alarm","entity":"current_alarm"},
                 {"id":"site","entity":"site"}],
        "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"},
                 {"relation":"device_located_at_site","from":"device","to":"site"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"alarm","measure":"critical_alarm_count"}],
        "group_by_identity":["device"]}"#).unwrap!())
}, "graph measure source may be multiplied by a joined relation");

pub def critical_alarm_threshold_qualifies_independent_kpi_observation: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"observed","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"observed","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"observed","measure":"cpu_peak"}],
        "group_by_identity":["device"],
        "filters":[{"node":"observed","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"observed","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-01 00:00:00"}],
        "exists":[{"anchor":"device","nodes":[{"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
            "having":[{"node":"alarm","measure":"critical_alarm_count","op":"gt","kind":"int","value":2}]}]
    }"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "EXISTS (SELECT 1 FROM T_CURRENT_ALARM AS alarm")
        && string::contains(sq.sql, "device.id = alarm.MEDN AND device.tenant_id = alarm.TENANTID")
        && string::contains(sq.sql, "HAVING count(alarm.CSN) FILTER (WHERE alarm.SEVERITY =")
        && string::contains(sq.sql, "max(observed.cpuUsage) AS observed_cpu_peak")
        && string::contains(sq.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && string::contains(pg.sql, "FILTER (WHERE \"alarm\".\"SEVERITY\"")
        && sq.bindings == [qb::Val::String("2025-01-01 00:00:00"), qb::Val::String("2025-02-01 00:00:00"),
            qb::Val::String("1"), qb::Val::Int(2)] && sq.bindings == pg.bindings { True }
    else { fail!(`critical-alarm qualification lost its Model predicate, owner identity or KPI window: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

pub def critical_alarm_threshold_rejects_text_value: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"}],"edges":[],
        "select":[],"count":"device",
        "exists":[{"anchor":"device","nodes":[{"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
            "having":[{"node":"alarm","measure":"critical_alarm_count","op":"gt","kind":"text","value":"two"}]}]
    }"#).unwrap!())
}, "graph aggregate threshold does not match measure output type");

def port_kpi_intent: Fn() -> std::value::Value = fn() {
    json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "exists":[{"anchor":"device",
            "nodes":[{"id":"port","entity":"port"},{"id":"sample","entity":"interface_kpi"}],
            "edges":[{"relation":"port_belongs_to_device","from":"port","to":"device"},
                     {"relation":"interface_kpi_of_port","from":"sample","to":"port"}],
            "filters":[{"node":"port","dimension":"port_name","op":"eq","kind":"text","value":"uplink"}],
            "having":[{"node":"sample","measure":"interface_tx","op":"gt","kind":"number","value":80.0}]
        }]
    }"#).unwrap!()
};

pub def independent_kpi_qualifications_preserve_owner_grain: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[{"node":"device","dimension":"device_name"}], "count":"device",
        "group_by_identity":["device"],
        "exists":[
            {"anchor":"device", "nodes":[{"id":"cpu","entity":"device_kpi"}],
             "edges":[{"relation":"device_kpi_of_device","from":"cpu","to":"device"}],
             "filters":[
                 {"node":"cpu","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                 {"node":"cpu","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}],
             "having":[{"node":"cpu","measure":"cpu_usage","op":"gt","kind":"number","value":80.0}]},
            {"anchor":"device", "nodes":[{"id":"ports","entity":"device_kpi"}],
             "edges":[{"relation":"device_kpi_of_device","from":"ports","to":"device"}],
             "filters":[
                 {"node":"ports","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-02-01 00:00:00"},
                 {"node":"ports","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-04 00:00:00"}],
             "having":[{"node":"ports","measure":"port_count_sample_avg","op":"gt","kind":"number","value":20.0}]}
        ]
    }"#).unwrap!());
    if string::contains(query.sql, "EXISTS (SELECT 1 FROM NetworkDeviceKPI AS cpu")
        && string::contains(query.sql, "EXISTS (SELECT 1 FROM NetworkDeviceKPI AS ports")
        && string::contains(query.sql, "HAVING avg(cpu.cpuUsage) > ?3")
        && string::contains(query.sql, "HAVING avg(ports.portCount) > ?6")
        && string::contains(query.sql, "device.id = cpu.resId AND device.tenant_id = cpu.tenantId")
        && string::contains(query.sql, "device.id = ports.resId AND device.tenant_id = ports.tenantId")
        && string::contains(query.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && query.bindings == [qb::Val::String("2025-01-01 00:00:00"), qb::Val::String("2025-01-04 00:00:00"),
            qb::Val::Float(80.0), qb::Val::String("2025-02-01 00:00:00"),
            qb::Val::String("2025-02-04 00:00:00"), qb::Val::Float(20.0)] { True }
    else { fail!(`independent KPI qualification lost its identity, windows, or aggregates: \{query.sql}`, query.bindings) }
});

