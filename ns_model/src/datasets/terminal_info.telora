pub def relations: Array(r::Relation) = [
    r::relation("ti__dev_info", domain::endpoint(TerminalInfo.type, "access_device_id"), domain::endpoint(dev_info::DevInfo.type, "resid"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("ti__pe_rev", domain::endpoint(TerminalInfo.type, "access_device_id"), domain::endpoint(pon_element::PonElement.type, "id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("ti__ne_rev", domain::endpoint(TerminalInfo.type, "access_device_id"), domain::endpoint(network_element::NetworkElement.type, "id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
