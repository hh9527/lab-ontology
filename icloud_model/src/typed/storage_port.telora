type PortId = struct(
    String
);
type Identity = struct {
    id: PortId
};
# 来源 speed 为整数 Mbit/s，不把文本 maxSpeed (Gbit/s) 隐式转换为同一量。
type MegabitsPerSecond = struct(
    Int
);
type Row = struct {
    source_id: PortId,
    source_tenantId: i::TenantId,
    source_name: String,
    source_remotePortWwn: String,
    source_remoteNodeWwn: String,
    source_lostSync: String,
    source_ipv6Mask: String,
