use ontology::field_type_info as f;
use ontology::knowledge as k;
use ontology::scalars as s;
use ontology::world as w;
use std::test as test;
use std::array as array;

type Business = struct(
    String
);
type Recursive = struct {
    value: String,
    next: Option(Recursive)
};
type NamedOption(T) = enum {
    None,
    Some(T)
};
type Anonymous = struct {
    entries: Array(Option(Business)),
    time: Option(s::DateTimeUtc)
};
def project: Fn(Type) -> f::Projection = fn(ty) {
    f::generate_field_type_info(f::memorizer, ty)
};

pub def builtin_container_has_no_roots: test::Test = test::should_ok(
    fn() {
        let p = project(Array(Option(Dict(String))).type);
        p.0 == [] && p.1.text == "Array(Option(Dict(String)))" && p.1.references == []
    }
);
pub def optional_time_stops_at_named_root: test::Test = test::should_ok(
    fn() {
        let p = project(Option(s::DateTimeUtc).type);
        p.0 == [s::DateTimeUtc.type] && p.1.text == `Option(\{k::type_ref(s::DateTimeUtc.type)})` && p.1.references == [
            k::type_ref(s::DateTimeUtc.type)
        ]
    }
);
pub def named_recursive_type_is_not_expanded: test::Test = test::should_ok(
    fn() {
        let p = project(Recursive.type);
        p.0 == [Recursive.type] && p.1.text == k::type_ref(Recursive.type)
    }
);
pub def named_option_preserves_identity: test::Test = test::should_ok(
    fn() {
        let p = project(NamedOption(Business).type);
        p.0 == [NamedOption(Business).type] && p.1.text == k::type_ref(NamedOption(Business).type)
    }
);
pub def anonymous_fields_expand_to_independent_roots: test::Test = test::should_ok(
    fn() {
        let body = k::resolved(Anonymous.type);
        let p = project(body);
        p.0 == [Business.type, s::DateTimeUtc.type] && p.1.references == [
            k::type_ref(Business.type),
            k::type_ref(s::DateTimeUtc.type)
        ]
    }
);
pub def repeated_projection_is_equal: test::Test = test::should_ok(
    fn() {
        project(Array(Option(Business)).type) == project(Array(Option(Business)).type)
    }
);
use ontology::query as qb;
def profile: qb::PlanProfile = {
    allowed_operators: [],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [],
    allow_distinct: False
};
use ontology::model as m;
use ontology::field_knowledge as fk;
type Identity = struct {
    id: Business,
    time: s::DateTimeUtc
};
type Unused = struct(
    String
);
def world: w::World = w::with_entities(
    w::define("field-info", [], [], [], [], profile),
    [w::entity(m::entity("business", Identity.type))]
);
pub def automatic_types_follow_named_references: test::Test = test::should_ok(
    fn() {
        let types = w::resolved_types(world);
        array::length(types) == 3 && array::any(
            types,
            fn(t) {
                t == Business.type
            }
        ) && array::any(
            types,
            fn(t) {
                t == s::DateTimeUtc.type
            }
        ) && w::coverage(world) == []
    }
);
pub def unused_type_is_not_published: test::Test = test::should_ok(
    fn() {
        !array::any(
            w::resolved_types(world),
            fn(t) {
                t == Unused.type
            }
        )
    }
);
pub def automatic_types_keep_recursive_boundaries: test::Test = test::should_ok(
    fn() {
        fk::discover_types([Recursive.type]) == [Recursive.type]
    }
);
use std::value::{Value};
pub def publication: Value = w::publication(world, w::prepare(world));
