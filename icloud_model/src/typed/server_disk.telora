use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(
    String
);
@registry::entity("server_disk_entity")
type Identity = struct {
    id: ComponentId
};
type Gigabytes = struct(
    Int
);
@registry::dataset("source_PhysicalServerDisk", "PhysicalServerDisk", ["source_id"])
@registry::roles([subject, tenant, parent])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PhysicalServerDisk__capacity",
                Gigabytes.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PhysicalServerDisk.type, Gigabytes.type, "source_capacity")),
            "source_PhysicalServerDisk__capacity",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
type PhysicalServerDisk = struct {
    @m::column("name")
    @g::search("source_PhysicalServerDisk__name")
    source_name: String,
    @m::column("tenantId")
    @g::exact("source_PhysicalServerDisk__tenantId")
    source_tenantId: i::TenantId,
    @m::column("id")
    @g::exact("source_PhysicalServerDisk__id")
    source_id: ComponentId,
    @m::column("remainingLifespan")
    @g::exact("source_PhysicalServerDisk__remainingLifespan")
    source_remainingLifespan: String,
    @m::column("serialNumber")
    @g::search("source_PhysicalServerDisk__serialNumber")
    source_serialNumber: String,
    @m::column("interfaceType")
    @v::classification(
        SourcePhysicalServerDiskInterfaceType_domain,
        "source_PhysicalServerDisk__interfaceType"
    )
    source_interfaceType: String,
    @m::column("mediaType")
    @v::classification(
        SourcePhysicalServerDiskMediaType_domain,
        "source_PhysicalServerDisk__mediaType"
    )
    source_mediaType: String,
    @m::column("capacity")
    source_capacity: Gigabytes,
    @m::column("model")
    @g::search("source_PhysicalServerDisk__model")
    source_model: String,
    @m::column("manufacturer")
    @g::search("source_PhysicalServerDisk__manufacturer")
    source_manufacturer: String,
    @m::column("healthStatus")
    @v::classification(
        SourcePhysicalServerDiskHealthStatus_domain,
        "source_PhysicalServerDisk__healthStatus"
    )
    source_healthStatus: Int,
    @m::column("diskName")
    @g::search("source_PhysicalServerDisk__diskName")
    source_diskName: String,
    @m::column("projectId")
    @g::exact("source_PhysicalServerDisk__projectId")
    source_projectId: String,
    @m::column("parentResId")
    @g::exact("source_PhysicalServerDisk__parentResId")
    source_parentResId: server::ServerOriginId,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(PhysicalServerDisk) = registry::dataset_of(PhysicalServerDisk.type);
def subject: m::Role(PhysicalServerDisk) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerDisk.type, ComponentId.type, "source_id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServerDisk) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerDisk.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent: m::Role(PhysicalServerDisk) = m::role(
    dataset,
    server::origin_entity,
    "server_origin",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerDisk.type, server::ServerOriginId.type, "source_parentResId"),
            m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerDiskInterfaceType = enum {
    @ev::rename("SPI")
    @ev::description("SPI type", "SPI类型")
    SpiType,
    @ev::rename("PCIe")
    @ev::description("PCIe type", "PCIe类型")
    PcIeType,
    @ev::rename("AHCI")
    @ev::description("AHCI type", "AHCI类型")
    AhciType,
    @ev::rename("UHCI")
    @ev::description("UHCI type", "UHCI类型")
    UhciType,
    @ev::rename("SAS")
    @ev::description("SAS type", "SAS类型")
    SasType,
    @ev::rename("SATA")
    @ev::description("SATA type", "SATA类型")
    SataType,
    @ev::rename("USB")
    @ev::description("USB type", "USB类型")
    UsbType,
    @ev::rename("NVMe")
    @ev::description("NVMe type", "NVMe类型")
    NvMeType,
    @ev::rename("FC")
    @ev::description("FC type", "FC类型")
    FcType,
    @ev::rename("iSCSI")
    @ev::description("iSCSI type", "iSCSI类型")
    IScsiType,
    @ev::rename("FCoE")
    @ev::description("FCoE type", "FCoE类型")
    FCoEType,
    @ev::rename("NVMeOverFabrics")
    @ev::description("NVMe over Fabrics type", "NVMeOverFabrics类型")
    NvMeOverFabricsType,
    @ev::rename("SMB")
    @ev::description("SMB type", "SMB类型")
    SmbType,
    @ev::rename("NFSv3")
    @ev::description("NFSv3 type", "NFSv3类型")
    NfSv3Type,
    @ev::rename("NFSv4")
    @ev::description("NFSv4 type", "NFSv4类型")
    NfSv4Type,
    @ev::rename("HTTP")
    @ev::description("HTTP type", "HTTP类型")
    HttpType,
    @ev::rename("HTTPS")
    @ev::description("HTTPS type", "HTTPS类型")
    HttpsType,
    @ev::rename("FTP")
    @ev::description("FTP type", "FTP类型")
    FtpType,
    @ev::rename("SFTP")
    @ev::description("SFTP type", "SFTP类型")
    SftpType,
};
def SourcePhysicalServerDiskInterfaceType_domain: v::Domain(
    SourcePhysicalServerDiskInterfaceType,
    String
) = v::from_enum(
    "SourcePhysicalServerDiskInterfaceType",
    SourcePhysicalServerDiskInterfaceType.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerDiskMediaType = enum {
    @ev::rename("HDD")
    @ev::description("Hard Disk Drive", "机械硬盘")
    HardDiskDrive,
    @ev::rename("SSD")
    @ev::description("Solid State Drive", "固态硬盘")
    SolidStateDrive,
    @ev::rename("SMR")
    @ev::description("Shingled Magnetic Recording", "叠瓦式磁记录")
    ShingledMagneticRecording,
};
def SourcePhysicalServerDiskMediaType_domain: v::Domain(SourcePhysicalServerDiskMediaType, String) = v::from_enum(
    "SourcePhysicalServerDiskMediaType",
    SourcePhysicalServerDiskMediaType.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerDiskHealthStatus = enum {
    @ev::itag(0)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("warning", "警告")
    Warning,
    @ev::itag(2)
    @ev::description("average", "一般")
    Average,
    @ev::itag(3)
    @ev::description("serious", "严重")
    Serious,
    @ev::itag(4)
    @ev::description("critical", "紧急")
    Critical,
    @ev::itag(-1)
    @ev::description("wrong", "错误")
    Wrong,
    @ev::itag(-2)
    @ev::description("unknown", "未知")
    Unknown,
};
def SourcePhysicalServerDiskHealthStatus_domain: v::Domain(
    SourcePhysicalServerDiskHealthStatus,
    Int
) = v::from_enum(
    "SourcePhysicalServerDiskHealthStatus",
    SourcePhysicalServerDiskHealthStatus.type,
    Int.type,
    False
);
def declaration: t::Declaration = registry::declaration(PhysicalServerDisk.type);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_PhysicalServer_PhysicalServerDisk",
        server::dataset,
        server::origin,
        dataset,
        parent,
        cardinality
    ),
    r::relation(
        "source_PhysicalServerDisk_X_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        cardinality
    ),
];
pub use self::{declaration, relations};

pub use self::{PhysicalServerDisk, Identity};
