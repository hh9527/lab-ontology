use ontology::quantity as statistic_quantity;
use ontology::quantity as q;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::semantic as domain;
# 采样身份由资源 ID 与 UTC 采集时间组成，实体关系不代替采样 grain。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
type UpwardTraffic = struct(q::Bytes);
type DownwardTraffic = struct(q::Bytes);
type LinkUtilization = struct(q::Percent);
def cell_link_upward_traffic_statistics: samples::Group(UpwardTraffic) = samples::group("cell_link_upward_traffic", UpwardTraffic.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], None);
def cell_link_downward_traffic_statistics: samples::Group(DownwardTraffic) = samples::group("cell_link_downward_traffic", DownwardTraffic.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], None);
def cell_link_utilization_statistics: samples::Group(LinkUtilization) = samples::group("cell_link_utilization", LinkUtilization.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], None);
@domain::bind(i::DeviceById.type, "source_resId")
@domain::dataset(
    "source_NetworkCellLinkTrafficKPI",
    "NetworkCellLinkTrafficKPI",
    ["source_resId", "source_ts"]
)
@domain::metric("source_ts")
@domain::relations(source_relations)
type NetworkCellLinkTrafficKPI = struct {
    @m::column("ts")
    @g::view("source_NetworkCellLinkTrafficKPI__ts", True, g::numeric_filters)
    @g::utc_bucket_view("source_NetworkCellLinkTrafficKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkCellLinkTrafficKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkCellLinkTrafficKPI_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("cell_link_traffic_sample_count")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkCellLinkTrafficKPI__resId")
    source_resId: domain::Reference(i::DeviceById),
    @m::column("tenantId")
    @g::exact("source_NetworkCellLinkTrafficKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("projectId")
    @g::exact("source_NetworkCellLinkTrafficKPI__projectId")
    source_projectId: String,
    @m::column("srcSiteId")
    @g::exact("source_NetworkCellLinkTrafficKPI__srcSiteId")
    source_srcSiteId: String,
    @m::column("destSiteId")
    @g::exact("source_NetworkCellLinkTrafficKPI__destSiteId")
    source_destSiteId: String,
    @m::column("sourceWanlinkId")
    @g::exact("source_NetworkCellLinkTrafficKPI__sourceWanlinkId")
    source_sourceWanlinkId: String,
    @m::column("destWanlinkId")
    @g::exact("source_NetworkCellLinkTrafficKPI__destWanlinkId")
    source_destWanlinkId: String,
    @m::column("upwardTraffic")
    @g::view("source_NetworkCellLinkTrafficKPI__upwardTraffic", True, g::numeric_filters)
    @samples::field(cell_link_upward_traffic_statistics, [
        {statistic: samples::Statistic::Mean, publish: "cell_link_upward_traffic"},
        {statistic: samples::Statistic::Min, publish: "cell_link_upward_traffic_min"},
        {statistic: samples::Statistic::Max, publish: "cell_link_upward_traffic_max"}
    ])
    @domain::count("cell_link_upward_traffic_observation_count")
    @samples::valid_count("source_upwardTrafficEffcnt")
    source_upwardTraffic: UpwardTraffic,
    @m::column("downwardTraffic")
    @g::view("source_NetworkCellLinkTrafficKPI__downwardTraffic", True, g::numeric_filters)
    @samples::field(cell_link_downward_traffic_statistics, [
        {statistic: samples::Statistic::Mean, publish: "cell_link_downward_traffic"},
        {statistic: samples::Statistic::Min, publish: "cell_link_downward_traffic_min"},
        {statistic: samples::Statistic::Max, publish: "cell_link_downward_traffic_max"}
    ])
    @domain::count("cell_link_downward_traffic_observation_count")
    @samples::valid_count("source_downwardTrafficEffcnt")
    source_downwardTraffic: DownwardTraffic,
    @m::column("utilization")
    @g::view("source_NetworkCellLinkTrafficKPI__utilization", True, g::numeric_filters)
    @samples::field(cell_link_utilization_statistics, [
        {statistic: samples::Statistic::Mean, publish: "cell_link_utilization"},
        {statistic: samples::Statistic::Min, publish: "cell_link_utilization_min"},
        {statistic: samples::Statistic::Max, publish: "cell_link_utilization_max"}
    ])
    @domain::count("cell_link_utilization_observation_count")
    @samples::valid_count("source_utilizationEffcnt")
    source_utilization: LinkUtilization,
    @m::column("upwardTrafficEffcnt")
    @g::view("source_NetworkCellLinkTrafficKPI__upwardTrafficEffcnt", True, g::numeric_filters)
    source_upwardTrafficEffcnt: EffectiveCount,
    @m::column("downwardTrafficEffcnt")
    @g::view("source_NetworkCellLinkTrafficKPI__downwardTrafficEffcnt", True, g::numeric_filters)
    source_downwardTrafficEffcnt: EffectiveCount,
    @m::column("utilizationEffcnt")
    @g::view("source_NetworkCellLinkTrafficKPI__utilizationEffcnt", True, g::numeric_filters)
    source_utilizationEffcnt: EffectiveCount,
};

pub use self::{NetworkCellLinkTrafficKPI};

def source_relations: Array(r::Relation) = [
    r::relation(
        "source_EntNetworkElement_NetworkCellLinkTrafficKPI",
        i::device_subject,
        domain::endpoint(NetworkCellLinkTrafficKPI.type, "source_resId"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    )
];
