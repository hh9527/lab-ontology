# ent-1/src/bin/verify.telora
#
# Verification entry for the logistics EnterpriseKnowledge:
#   - Plan coverage (one projection per requested measure/dimension)
#   - domain filter capability (Eq/Ge/Le on the four authorized dimensions)
#   - unprojected filter dimensions still receive safe join paths
#   - ordering (measure desc + dimensions asc) and Top N
#   - non-empty bindings with stable order
#   - profile constraint (accepted by knowledge profile, rejected when a
#     required capability is removed)
#   - Query determinism (repeated lowering yields byte-identical Plan/Query)
#   - measure requires (DeliveredPackages -> Order; UnitsShipped -> Package,
#     Order) and grain-safe ProductCategory from the PackageItem grain.
#
# Any failed assertion fails loudly (fail!) so `run verify` is strict.

import "query/lib" as qb;
import "std/array" as array;
import "std/string" as string;
import "std/value" { Value };
import "ontology/edsl" as edsl;
import "@src/model" as model;

# ---------------------------------------------------------------------------
# Assertion helper.
# ---------------------------------------------------------------------------

def check: Fn(Bool, String) -> Bool = fn(cond, label) {
    if cond { 'True } else { fail!("verify check failed", label) }
};

# ---------------------------------------------------------------------------
# Structural inspection helpers.
# ---------------------------------------------------------------------------

def get_index: for(A) Fn(Array(A), Int) -> A = fn(values, i) {
    match array.get(values, i) {
        'Some(v) => v,
        'None => fail!("index out of range", i),
    }
};

def is_column: Fn(qb.Expr, String, String) -> Bool = fn(e, source, column) {
    match e {
        'Column(ref) => ref.source == source && ref.column == column,
        _ => 'False,
    }
};

def is_bind: Fn(qb.Expr) -> Bool = fn(e) {
    match e { 'Bind(_) => 'True, _ => 'False }
};

def bind_text: Fn(qb.Expr) -> String = fn(e) {
    match e {
        'Bind(val) => match val {
            'String(s) => s,
            'Int(i) => `\{i}`,
            'Float(f) => `\{f}`,
            'Bool(b) => if b { "true" } else { "false" },
        },
        _ => "",
    }
};

# substr(o.created_at, ?, ?)
def is_month_expr: Fn(qb.Expr) -> Bool = fn(e) {
    match e {
        'Scalar(call) => call.function == 'Substr
            && array.length(call.args) == 3
            && is_column(get_index(call.args, 0), "o", "created_at")
            && is_bind(get_index(call.args, 1))
            && is_bind(get_index(call.args, 2)),
        _ => 'False,
    }
};

# scalar predicate of form <op>(<base>, <bind>)
def is_pred: Fn(qb.Expr, qb.ScalarFunction, Fn(qb.Expr) -> Bool) -> Bool = fn(e, op, base_ok) {
    match e {
        'Scalar(call) => call.function == op
            && array.length(call.args) == 2
            && base_ok(get_index(call.args, 0))
            && is_bind(get_index(call.args, 1)),
        _ => 'False,
    }
};

# Flatten the AND tree into the ordered list of predicates.
def flatten_preds: Fn(qb.Expr) -> Array(qb.Expr) = fn(e) {
    match e {
        'Scalar(call) => if call.function == 'And {
            array.concat([flatten_preds(get_index(call.args, 0)), flatten_preds(get_index(call.args, 1))])
        } else {
            [e]
        },
        _ => [e],
    }
};

def aggregate_alias_count: Fn(Array(qb.SelectItem), String) -> Int = fn(items, alias) {
    array.length(array.filter(items, fn(item) {
        match item {
            'Aggregate(agg) => agg.alias == alias,
            'Expr(_) => 'False,
        }
    }))
};

def expr_item_count: Fn(Array(qb.SelectItem)) -> Int = fn(items) {
    array.length(array.filter(items, fn(item) {
        match item { 'Expr(_) => 'True, 'Aggregate(_) => 'False }
    }))
};

def join_aliases: Fn(Array(qb.Join)) -> Array(String) = fn(joins) {
    array.map(joins, fn(j) { j.source.alias })
};

# ---------------------------------------------------------------------------
# Requests.
# ---------------------------------------------------------------------------

def legal_request: edsl.QueryRequest = {
    measures: [
        { id: "OrdersCreated", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "OrderMonth", subject: "analyst", input: 'None },
        { id: "CustomerTier", subject: "analyst", input: 'None },
        { id: "OriginRegion", subject: "analyst", input: 'None },
        { id: "CarrierName", subject: "analyst", input: 'None },
        { id: "ServiceName", subject: "analyst", input: 'None },
    ],
    filters: [
        { id: "OrderMonth", subject: "analyst", op: 'Ge, input: 'Text("2026-04") },
        { id: "OrderMonth", subject: "analyst", op: 'Le, input: 'Text("2026-06") },
        { id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("Gold") },
        { id: "OriginRegion", subject: "analyst", op: 'Eq, input: 'Text("East China") },
    ],
    ordering: [
        { target: 'Measure("OrdersCreated"), direction: 'Desc },
        { target: 'Dimension("OrderMonth"), direction: 'Asc },
        { target: 'Dimension("CustomerTier"), direction: 'Asc },
        { target: 'Dimension("OriginRegion"), direction: 'Asc },
        { target: 'Dimension("CarrierName"), direction: 'Asc },
        { target: 'Dimension("ServiceName"), direction: 'Asc },
    ],
    limit: 'Some(10),
};

def unprojected_filter_request: edsl.QueryRequest = {
    measures: [
        { id: "OrdersCreated", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "OriginRegion", subject: "analyst", input: 'None },
    ],
    filters: [
        { id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("Gold") },
    ],
    ordering: [],
    limit: 'None,
};

def delivered_request: edsl.QueryRequest = {
    measures: [
        { id: "DeliveredPackages", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "OrderMonth", subject: "analyst", input: 'None },
    ],
    filters: [],
    ordering: [],
    limit: 'None,
};

def units_category_request: edsl.QueryRequest = {
    measures: [
        { id: "UnitsShipped", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "ProductCategory", subject: "analyst", input: 'None },
    ],
    filters: [],
    ordering: [],
    limit: 'None,
};

# ---------------------------------------------------------------------------
# Checks.
# ---------------------------------------------------------------------------

def check_projection: Bool = do {
    let plan: qb.Plan = edsl.lower(model.payload, legal_request);
    check(array.length(plan.projection) == 6, "projection: one per measure + five dimensions")
        && check(aggregate_alias_count(plan.projection, "OrdersCreated") == 1, "projection: OrdersCreated exactly once")
        && check(expr_item_count(plan.projection) == 5, "projection: five dimension expr items")
};

def check_sources_joins: Bool = do {
    let plan: qb.Plan = edsl.lower(model.payload, legal_request);
    let aliases = join_aliases(plan.joins);
    let has_c = array.any(aliases, fn(a) { a == "c" });
    let has_w = array.any(aliases, fn(a) { a == "w" });
    let has_r = array.any(aliases, fn(a) { a == "r" });
    let has_cr = array.any(aliases, fn(a) { a == "cr" });
    let has_sl = array.any(aliases, fn(a) { a == "sl" });
    let all_inner = array.all(plan.joins, fn(j) {
        match j.kind { 'Inner => 'True, 'Left => 'False }
    });
    check(array.length(plan.joins) == 5, "joins: five safe inner joins")
        && check(has_c && has_w && has_r && has_cr && has_sl, "joins: customers/warehouses/regions/carriers/service_levels")
        && check(all_inner, "joins: all inner")
};

def check_filter_capability: Bool = do {
    let plan: qb.Plan = edsl.lower(model.payload, legal_request);
    let preds = match plan.filter {
        'Some(e) => flatten_preds(e),
        'None => [],
    };
    let month_ge = array.any(preds, fn(p) { is_pred(p, 'Ge, is_month_expr) && bind_text(get_index((match p { 'Scalar(c) => c.args, _ => [] }), 1)) == "2026-04" });
    let month_le = array.any(preds, fn(p) { is_pred(p, 'Le, is_month_expr) && bind_text(get_index((match p { 'Scalar(c) => c.args, _ => [] }), 1)) == "2026-06" });
    let tier_eq = array.any(preds, fn(p) { is_pred(p, 'Eq, fn(e) { is_column(e, "c", "tier") }) && bind_text(get_index((match p { 'Scalar(c) => c.args, _ => [] }), 1)) == "Gold" });
    let region_eq = array.any(preds, fn(p) { is_pred(p, 'Eq, fn(e) { is_column(e, "r", "name") }) && bind_text(get_index((match p { 'Scalar(c) => c.args, _ => [] }), 1)) == "East China" });
    check(array.length(preds) == 4, "filters: four predicates in AND order")
        && check(month_ge, "filters: OrderMonth >= 2026-04")
        && check(month_le, "filters: OrderMonth <= 2026-06")
        && check(tier_eq, "filters: CustomerTier = Gold")
        && check(region_eq, "filters: OriginRegion = East China")
};

def check_unprojected_filter_path: Bool = do {
    let plan: qb.Plan = edsl.lower(model.payload, unprojected_filter_request);
    let filter_mentions_tier = match plan.filter {
        'Some(e) => array.any(flatten_preds(e), fn(p) { is_pred(p, 'Eq, fn(x) { is_column(x, "c", "tier") }) }),
        'None => 'False,
    };
    let tier_not_projected = aggregate_alias_count(plan.projection, "tier") == 0
        && !array.any(plan.projection, fn(item) {
            match item { 'Expr(e) => is_column(e, "c", "tier"), _ => 'False }
        });
    let has_c_join = array.any(join_aliases(plan.joins), fn(a) { a == "c" });
    check(filter_mentions_tier, "unprojected filter: CustomerTier predicate present")
        && check(tier_not_projected, "unprojected filter: tier not projected")
        && check(has_c_join, "unprojected filter: customers join path provided")
};

def check_ordering_limit: Bool = do {
    let plan: qb.Plan = edsl.lower(model.payload, legal_request);
    let ordering_ok = array.length(plan.ordering) == 6
        && (match get_index(plan.ordering, 0).key {
            'AggregateRef(ref) => ref.alias == "OrdersCreated",
            _ => 'False,
        })
        && (match get_index(plan.ordering, 0).direction { 'Desc => 'True, 'Asc => 'False })
        && array.all(array.map(array.enumerate(plan.ordering), fn(pair) { pair.1 }), fn(ob) {
            match ob.key { 'Expr(_) => match ob.direction { 'Asc => 'True, 'Desc => 'False }, 'AggregateRef(_) => 'True }
        });
    check(ordering_ok, "ordering: measure desc then dimension asc")
        && check(plan.limit == 'Some(10), "top n: limit is Some(10)")
        && check(plan.revision == "logistics-ontology-v1", "revision: logistics-ontology-v1")
};

def check_bindings: Bool = do {
    let plan: qb.Plan = edsl.lower(model.payload, legal_request);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = [
        'Int(1), 'Int(7),
        'Int(1), 'Int(7), 'String("2026-04"),
        'Int(1), 'Int(7), 'String("2026-06"),
        'String("Gold"), 'String("East China"),
        'Int(1), 'Int(7),
        'Int(1), 'Int(7),
        'Int(10),
    ];
    check(array.length(query.bindings) > 0, "bindings: non-empty")
        && check(query.bindings == expected, "bindings: projection/filter/grouping/ordering/limit order")
};

def check_profile_constraint: Bool = do {
    let plan: qb.Plan = edsl.lower(model.payload, legal_request);
    let accepted = qb.profile_accepts(plan, model.profile);
    let narrow: qb.PlanProfile = {
        allowed_operators: [
            'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
            'Filter, 'Group, 'Order, 'Limit,
        ],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr, 'Eq, 'Ge, 'Le, 'And],
        allow_distinct: 'False,
    };
    let rejected = !qb.profile_accepts(plan, narrow);
    check(accepted, "profile: plan accepted by knowledge profile")
        && check(rejected, "profile: plan rejected when Join capability removed")
};

def check_determinism: Bool = do {
    let plan1: qb.Plan = edsl.lower(model.payload, legal_request);
    let plan2: qb.Plan = edsl.lower(model.payload, legal_request);
    let q1: qb.Query = qb.transform_sqlite(plan1);
    let q2: qb.Query = qb.transform_sqlite(plan2);
    check(plan1 == plan2, "determinism: repeated lowering yields identical plan")
        && check(q1.sql == q2.sql && q1.bindings == q2.bindings, "determinism: byte-identical query")
};

def check_measure_requires: Bool = do {
    let delivered_plan: qb.Plan = edsl.lower(model.payload, delivered_request);
    let has_order_join = array.any(join_aliases(delivered_plan.joins), fn(a) { a == "o" });
    let delivered_query: qb.Query = qb.transform_sqlite(delivered_plan);
    let units_plan: qb.Plan = edsl.lower(model.payload, units_category_request);
    let units_aliases = join_aliases(units_plan.joins);
    let units_ok = array.any(units_aliases, fn(a) { a == "o" })
        && array.any(units_aliases, fn(a) { a == "p" })
        && array.any(units_aliases, fn(a) { a == "cat" });
    check(has_order_join, "requires: DeliveredPackages joins to Order")
        && check(array.length(delivered_query.bindings) > 0, "requires: delivered query has non-empty bindings")
        && check(units_ok, "requires: UnitsShipped joins Package, Order and Category")
};

# Capability-set probe: a single filter on (dimension, op) lowers to a Plan
# whose filter contains a predicate with the expected operator.  ProductCategory
# is probed from the PackageItem grain (UnitsShipped) where its path is safe.
# CustomerTier is a closed enum value domain and therefore supports only Eq.
def capability_ok: Fn(String, String, edsl.FilterOp, qb.ScalarFunction, String) -> Bool = fn(measure_id, dimension_id, req_op, expected_op, value) {
    let request: edsl.QueryRequest = {
        measures: [{ id: measure_id, subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: dimension_id, subject: "analyst", op: req_op, input: 'Text(value) }],
        ordering: [],
        limit: 'None,
    };
    let plan: qb.Plan = edsl.lower(model.payload, request);
    let preds = match plan.filter {
        'Some(e) => flatten_preds(e),
        'None => [],
    };
    array.any(preds, fn(p) {
        match p {
            'Scalar(call) => call.function == expected_op,
            _ => 'False,
        }
    })
};

def check_filter_capability_set: Bool = do {
    let month = capability_ok("OrdersCreated", "OrderMonth", 'Eq, 'Eq, "2026-04")
        && capability_ok("OrdersCreated", "OrderMonth", 'Ge, 'Ge, "2026-04")
        && capability_ok("OrdersCreated", "OrderMonth", 'Le, 'Le, "2026-04");
    let tier = capability_ok("OrdersCreated", "CustomerTier", 'Eq, 'Eq, "Gold");
    let region = capability_ok("OrdersCreated", "OriginRegion", 'Eq, 'Eq, "East China")
        && capability_ok("OrdersCreated", "OriginRegion", 'Ge, 'Ge, "East China")
        && capability_ok("OrdersCreated", "OriginRegion", 'Le, 'Le, "East China");
    let category = capability_ok("UnitsShipped", "ProductCategory", 'Eq, 'Eq, "电子")
        && capability_ok("UnitsShipped", "ProductCategory", 'Ge, 'Ge, "电子")
        && capability_ok("UnitsShipped", "ProductCategory", 'Le, 'Le, "电子");
    check(month, "capability set: OrderMonth supports Eq/Ge/Le")
        && check(tier, "capability set: CustomerTier supports Eq (closed enum domain)")
        && check(region, "capability set: OriginRegion supports Eq/Ge/Le")
        && check(category, "capability set: ProductCategory supports Eq/Ge/Le")
};

# Closed enum value domain: CustomerTier publishes Gold/Silver/Bronze with the
# declared stable values and display labels, discoverable from the prepared
# payload (no second hand-maintained catalog).
def check_customer_tier_domain: Bool = do {
    let tier = match array.find(model.payload.dimensions, fn(d) { d.id == "CustomerTier" }) {
        'Some(d) => d,
        'None => fail!("CustomerTier dimension missing"),
    };
    let has_gold = array.any(tier.values, fn(v) { v.variant == "Gold" && v.value == "Gold" && v.label == "Gold customer" });
    let has_silver = array.any(tier.values, fn(v) { v.variant == "Silver" && v.value == "Silver" && v.label == "Silver customer" });
    let has_bronze = array.any(tier.values, fn(v) { v.variant == "Bronze" && v.value == "Bronze" && v.label == "Bronze customer" });
    let domain_ok = array.length(tier.values) == 3 && has_gold && has_silver && has_bronze;
    let discovery_ok = array.length(edsl.dimension_domain(model.payload, "CustomerTier")) == 3;
    let ops_ok = array.length(tier.ops) == 1 && array.any(tier.ops, fn(op) { op == 'Eq });
    check(domain_ok, "CustomerTier publishes closed enum catalog Gold/Silver/Bronze with labels")
        && check(discovery_ok, "dimension_domain exposes the same catalog")
        && check(ops_ok, "CustomerTier declares only the Eq filter operation")
};

# A legal CustomerTier filter value lowers to a parameterized String binding.
def check_enum_filter_binding: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrdersCreated", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("Gold") }],
        ordering: [],
        limit: 'Some(2),
    };
    let plan: qb.Plan = edsl.lower(model.payload, request);
    let query: qb.Query = qb.transform_sqlite(plan);
    let last = match array.get(query.bindings, array.length(query.bindings) - 1) {
        'Some(v) => v,
        'None => fail!("bindings empty"),
    };
    check(array.any(query.bindings, fn(b) { match b { 'String(s) => s == "Gold", _ => 'False } }), "enum filter: Gold is a String binding")
        && check(match last { 'Int(n) => n == 2, _ => 'False }, "enum filter: limit is the final binding")
};

# ---------------------------------------------------------------------------
# Entry.
# ---------------------------------------------------------------------------

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    let c1 = check_projection;
    let c2 = check_sources_joins;
    let c3 = check_filter_capability;
    let c4 = check_unprojected_filter_path;
    let c5 = check_ordering_limit;
    let c6 = check_bindings;
    let c7 = check_profile_constraint;
    let c8 = check_determinism;
    let c9 = check_measure_requires;
    let c10 = check_filter_capability_set;
    let c11 = check_customer_tier_domain;
    let c12 = check_enum_filter_binding;
    'String("verify ok")
};
