pub def count_devices_by_tenant_including_empty_groups: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"tenant", "include_empty":true,
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"site","entity":"site"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"site_tenant","from":"site","to":"tenant"},
                 {"relation":"device_site","from":"device","to":"site"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"device",
        "filters":[{"node":"tenant","dimension":"tenant_id","op":"eq","kind":"text","value":"tenant-1"}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "LEFT JOIN sites AS site")
        && string::contains(sq.sql, "LEFT JOIN devices AS device")
        && string::contains(sq.sql, "count(device.id)")
        && string::contains(pg.sql, "LEFT JOIN \"devices\" AS \"device\"")
        && sq.bindings == [qb::Val::String("tenant-1")]
        && pg.bindings == sq.bindings {
        True
    } else { fail!("empty-child count lost outer joins or root filter binding", sq, pg) }
});

pub def count_connections_per_device_with_complete_alternative_roles: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{"op":"graph","root":"device","include_empty":true,
        "nodes":[{"id":"device","entity":"device"},{"id":"connection","entity":"connection"}],
        "edges":[{"relation":"connection_endpoint","from":"connection","to":"device"}],
        "select":[{"node":"device","dimension":"device_id"}],
        "count":"connection","group_by_identity":["device"]}"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "LEFT JOIN connections AS connection")
        && string::contains(sq.sql, "count(connection.id)")
        && string::contains(sq.sql, "connection.a_device_id = device.id AND connection.tenant_id = device.tenant_id")
        && string::contains(sq.sql, "connection.z_device_id = device.id AND connection.tenant_id = device.tenant_id")
        && string::contains(sq.sql, "GROUP BY device.id, device.tenant_id")
        && string::contains(pg.sql, "LEFT JOIN \"connections\" AS \"connection\"") { True }
    else { fail!(`composite device grouping lost A/Z owner scope: \{sq.sql} / \{pg.sql}`) }
});

