def fixture_types: Array(Type) = [
    EnumFixture.type, TextEq.type, TextNe.type, TextGt.type, TextGe.type, TextLt.type, TextLe.type, TextContains.type, TextNotContains.type, TextStartsWith.type, TextEndsWith.type, PlainInSubnet.type, ComputedInSubnet.type, PlainNotInSubnet.type, ComputedNotInSubnet.type, ClosedEq.type, ClosedNe.type, OpenEq.type, OpenNe.type
];
pub def acceptance_matrix: Value = codec::encode(array::map(fixture_types, fn(ty) { array::map(profiles, fn(p) { accepts(ty, p) }) }));


@edsl::value_type("NamedValue", String.type, [])
type NamedValue = enum { First, Second, Third };
@edsl::entity_id("fixture") @edsl::entity_source("fixture", "f")
type EnumFixture = struct {
    @edsl::column("value")
    @edsl::dimension("value", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text]) value: NamedValue,
};
pub def enum_values_match_generated_ast: test::Test = test::should_ok(fn() {
    agrees(EnumFixture.type, edsl::FilterOp::Eq, [edsl::FilterInput::Text("First"), edsl::FilterInput::Text("Second"), edsl::FilterInput::Text("Third")])
});
