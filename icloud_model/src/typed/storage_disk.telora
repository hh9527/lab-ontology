    StoragePoolCache,
};
def SourceSYSStorageDiskRole_domain: v::Domain(SourceSYSStorageDiskRole, String) = v::from_enum(
    "SourceSYSStorageDiskRole",
    SourceSYSStorageDiskRole.type,
    String.type,
