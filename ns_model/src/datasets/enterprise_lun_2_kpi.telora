use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::lun;
use crate::datasets::kpi_storage_enterprise_lun;
@domain::subject("Lun", "obj_sys_id")
@domain::dataset("enterprise-lun-2-kpi", "enterpriseLun2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseLun2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-lun-2-kpi/obj_sys_id", ids::CloudBlockLun2KpiByObjSysId.type, True, [g::Filter::Eq]), "el2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("el2_count")
    obj_sys_id: ids::CloudBlockLun2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-lun-2-kpi/obj_id", domain::Reference(ids::EnterpriseLun2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "el2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseLun2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("el2__lu", domain::endpoint(EnterpriseLun2Kpi.type, "obj_sys_id"), domain::endpoint(lun::Lun.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("el2__sel", domain::endpoint(EnterpriseLun2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_lun::KpiStorageEnterpriseLun.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
