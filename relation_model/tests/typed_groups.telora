mod fixture;
use self::fixture as f;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::quantity as q;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::test as test;
use std::value::{Value};

pub def one_measure_group_binds_twice_and_across_datasets: test::Test = test::should_ok(fn() {
    let ms = g::prepare(f::millis, [f::ms_rx, f::ms_tx]);
    let s = g::prepare(f::secs, [f::s_rx, f::s_tx]);
    array::length(ms) == 6 && array::length(s) == 6 && ms[2].local == s[2].local
        && ms[2].value == q::BytesPerSecond.type && ms[0].value == q::Bytes.type
        && array::all(ms, fn(member) { member.nullable })
});
pub def label_group_is_reused_with_capabilities_restricted: test::Test = test::should_ok(fn() {
    let ms = g::prepare(f::millis, [f::ms_label, f::ms_category, f::ms_identity]);
    let s = g::prepare(f::secs, [f::s_label, f::s_category, f::s_identity]);
    ms[0].group == s[0].group && ms[0].filters == [g::Filter::Eq]
        && ms[0].nullable && ms[2].nullable && ms[3].nullable
        && ms[2].value == f::TenantId.type && ms[3].value == f::DeviceId.type
});
pub def missing_member_mapping_is_rejected: test::Test = test::should_fail_with(fn() {
    g::checked_transfer_binding(f::millis, g::transfer, f::ms_amount, f::ms_duration, [f::names("rx")[0]])
}, "measure binding must name every member exactly once");
pub def duplicate_member_mapping_is_rejected: test::Test = test::should_fail_with(fn() {
    let first = f::names("rx")[0];
    g::checked_transfer_binding(f::millis, g::transfer, f::ms_amount, f::ms_duration, [first, first, first])
}, "measure binding must name every member exactly once");
pub def colliding_public_names_are_rejected: test::Test = test::should_fail_with(fn() {
    g::checked_prepare(f::millis, [f::ms_rx, f::ms_rx])
}, "group publish ids must be valid and unique");
pub def invalid_public_name_is_rejected: test::Test = test::should_fail_with(fn() {
    let bad = f::ms_rx.members[0] <~ {id: "rx; drop table samples_ms"};
    g::checked_prepare(f::millis, [f::ms_rx <~ {members: [bad, f::ms_rx.members[1], f::ms_rx.members[2]]}])
}, "group publish ids must be valid and unique");
pub def dimension_binding_cannot_expand_filters: test::Test = test::should_fail_with(fn() {
    g::checked_dimension(f::millis, f::category, g::checked_input(m::checked_field(f::MillisRow.type, f::Category.type, "category")),
        "class", True, [g::Filter::Contains])
}, "dimension binding cannot expand group capabilities");
pub def hidden_dimension_stays_out_of_projection: test::Test = test::should_ok(fn() {
    let hidden = g::dimension(f::millis, f::label,
        g::input(m::optional_field(f::MillisRow.type, String.type, "name")), "hidden", False, []);
    match g::query(f::millis, [hidden, f::ms_rx]).plan {
        qb::QueryPlan::Rows(plan) => array::length(plan.projection) == 3 && plan.grouping == [],
        _ => False,
    }
});
pub def preparation_rechecks_measure_recipe: test::Test = test::should_fail_with(fn() {
    let mean = f::ms_rx.members[2] <~ {aggregate: Some(qb::AggregateFunction::Max)};
    g::checked_prepare(f::millis, [f::ms_rx <~ {members: [f::ms_rx.members[0], f::ms_rx.members[1], mean]}])
}, "measure binding cannot override its group recipe");
pub def preparation_rechecks_capability_ceiling: test::Test = test::should_fail_with(fn() {
    let member = f::ms_category.members[0] <~ {filters: [g::Filter::Contains]};
    g::checked_prepare(f::millis, [f::ms_category <~ {members: [member]}])
}, "dimension binding cannot expand group capabilities");
pub def preparation_rechecks_expression_type: test::Test = test::should_fail_with(fn() {
    let forged = f::ms_amount <~ {value: q::Seconds.type};
    g::checked_transfer_binding(f::millis, g::transfer, forged, f::ms_duration, f::names("rx"))
}, "group expression witness does not match its type");
pub def preparation_rechecks_dataset_ownership: test::Test = test::should_fail_with(fn() {
    g::checked_prepare(f::millis, [f::ms_rx <~ {dataset: "other"}])
}, "group binding belongs to a different dataset");
pub def preparation_rechecks_source_ownership: test::Test = test::should_fail_with(fn() {
    g::checked_prepare(f::millis, [f::ms_rx <~ {source: "other"}])
}, "group binding belongs to a different dataset");
pub def identity_dimensions_cannot_omit_tenant: test::Test = test::should_fail_with(fn() {
    g::checked_identity_dimensions(f::millis, f::millis_role, [{member: "local", publish: "device_id"}])
}, "identity dimensions must publish the complete identity");
pub def aggregate_cannot_claim_nonnull_output: test::Test = test::should_fail_with(fn() {
    let member = f::ms_rx.members[0] <~ {nullable: False};
    g::checked_prepare(f::millis, [f::ms_rx <~ {members: [member, f::ms_rx.members[1], f::ms_rx.members[2]]}])
}, "group member result type does not match its expression");
pub def preparation_rechecks_complete_identity_dimensions: test::Test = test::should_fail_with(fn() {
    g::checked_prepare(f::millis, [f::ms_identity <~ {members: [f::ms_identity.members[1]]}])
}, "identity dimensions must preserve the complete role");
pub def preparation_rechecks_complete_measure_group: test::Test = test::should_fail_with(fn() {
    g::checked_prepare(f::millis, [f::ms_rx <~ {members: [f::ms_rx.members[0]]}])
}, "measure binding must preserve its complete group");
pub def dimension_binding_cannot_enable_projection: test::Test = test::should_fail_with(fn() {
    let hidden = f::label <~ {projectable: False};
    g::checked_dimension(f::millis, hidden, g::checked_input(m::checked_optional_field(f::MillisRow.type, String.type, "name")), "hidden", True, [])
}, "dimension binding cannot expand group capabilities");

type RuntimeCase = struct { id: String, sqlite: qb::Query, postgres: qb::Query };
def export_case: Fn(String, qb::QueryAst) -> RuntimeCase = fn(id, ast) {
    {id, sqlite: sqlite::build_query(ast), postgres: postgres::build_query(ast)}
};
pub def runtime_cases: Value = codec::encode([
    export_case("ms_grouped", g::query(f::millis, [f::ms_identity, f::ms_label, f::ms_category, f::ms_rx, f::ms_tx])),
    export_case("s_grouped", g::query(f::secs, [f::s_identity, f::s_label, f::s_category, f::s_rx, f::s_tx])),
    export_case("ms_all", g::query(f::millis, [f::ms_rx, f::ms_tx])),
    export_case("s_all", g::query(f::secs, [f::s_rx, f::s_tx])),
]);

# 同一 Group 声明进入 Graph 编译器，沿用实例、粒度与相关聚合语义。
use ontology::experimental::transform as transform;
use ontology::experimental::relations as relations;
use ontology::ontology as edsl;
use ontology::intent as intent;
use std::json as json;

def graph_profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column,
        qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate, qb::Operator::Group,
        qb::Operator::Filter, qb::Operator::Join, qb::Operator::Exists, qb::Operator::Having],
    allowed_join_kinds: [qb::JoinKind::Inner],
    allowed_aggregates: [qb::AggregateFunction::Sum, qb::AggregateFunction::Max, qb::AggregateFunction::Avg, qb::AggregateFunction::Count],
    allowed_scalars: [qb::ScalarFunction::Div, qb::ScalarFunction::Gt, qb::ScalarFunction::If,
        qb::ScalarFunction::IsNotNull, qb::ScalarFunction::And, qb::ScalarFunction::Eq], allow_distinct: True,
};
def ms_declared: transform::Declaration = transform::map_columns(transform::declare(f::millis, [f::millis_role],
    [f::ms_identity, f::ms_label, f::ms_category, f::ms_rx, f::ms_tx], []), [
    transform::column(m::optional_field(f::MillisRow.type, q::Bytes.type, "rx"), "RX_BYTES"),
    transform::column(m::field(f::MillisRow.type, q::Bytes.type, "tx"), "TX_BYTES"),
    transform::column(m::optional_field(f::MillisRow.type, q::Milliseconds.type, "elapsed_ms"), "DURATION_MS"),
]);
def s_declared: transform::Declaration = transform::map_columns(transform::declare(f::secs, [f::seconds_role],
    [f::s_identity, f::s_label, f::s_category, f::s_rx, f::s_tx], []), [
    transform::column(m::field(f::SecondsRow.type, f::TenantId.type, "tenant_key"), "TENANT_ID"),
    transform::column(m::optional_field(f::SecondsRow.type, f::DeviceId.type, "device_key"), "DEVICE_ID"),
    transform::column(m::optional_field(f::SecondsRow.type, q::Bytes.type, "bytes_in"), "INPUT_BYTES"),
    transform::column(m::field(f::SecondsRow.type, q::Bytes.type, "bytes_out"), "OUTPUT_BYTES"),
    transform::column(m::optional_field(f::SecondsRow.type, q::Seconds.type, "duration_seconds"), "DURATION_S"),
]);
def ms_payload: edsl::PreparedPayload = transform::prepare("ms-groups", [ms_declared], graph_profile).payload;
def s_payload: edsl::PreparedPayload = transform::prepare("s-groups", [s_declared], graph_profile).payload;
def graph_request: Fn(String, Bool) -> Value = fn(dataset, grouped) {
    json::parse(`{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"\{dataset}"}],"edges":[],
        "select":\{if grouped { r#"[{"node":"r","dimension":"tenant_id"},{"node":"r","dimension":"device_id"},{"node":"r","dimension":"label"},{"node":"r","dimension":"category"}]"# } else { "[]" }},
        "measures":[{"node":"r","measure":"rx_total"},{"node":"r","measure":"rx_peak"},{"node":"r","measure":"rx_mean"},
                    {"node":"r","measure":"tx_total"},{"node":"r","measure":"tx_peak"},{"node":"r","measure":"tx_mean"}]}`).unwrap!()
};
pub def graph_group_measures_keep_types_and_nullable_aggregates: test::Test = test::should_ok(fn() {
    let input = graph_request("millis", False);
    let ast = intent::query_intent_ast_factory(ms_payload)(input);
    let columns = intent::result_columns(ms_payload, input, ast);
    array::length(ms_payload.measures) == 6 && array::length(ms_payload.dimensions) == 4
        && columns == array::map(["rx_total", "rx_peak", "rx_mean", "tx_total", "tx_peak", "tx_mean"], fn(id) {
            {name: `r_\{id}`, type: intent::ResultType::Float, nullable: True}
        })
});
pub def graph_group_aggregate_capabilities_are_checked: test::Test = test::should_fail_with(fn() {
    transform::checked_prepare("no-avg", [ms_declared], graph_profile <~ {allowed_aggregates: [qb::AggregateFunction::Sum, qb::AggregateFunction::Max]})
}, "declared measure uses aggregate, filter or scalar capabilities not allowed by the query profile");
pub def graph_group_expression_capabilities_are_checked: test::Test = test::should_fail_with(fn() {
    transform::checked_prepare("no-div", [ms_declared], graph_profile <~ {allowed_scalars: [qb::ScalarFunction::IsNotNull, qb::ScalarFunction::And, qb::ScalarFunction::Eq]})
}, "declared measure uses aggregate, filter or scalar capabilities not allowed by the query profile");
pub def group_and_record_count_cannot_publish_the_same_measure: test::Test = test::should_fail_with(fn() {
    transform::checked_prepare("same-id", [ms_declared <~ {record_counts: ["rx_total"]}], graph_profile)
}, "typed transform measure ids must be unique");

# 独立 owner Dataset 与样本 Dataset 共享实体角色，相关聚合保留样本粒度。
type OwnerRow = struct { tenant: f::TenantId, device: f::DeviceId, name: String };
def owners: m::Dataset(OwnerRow) = m::dataset("owners", "owners", OwnerRow.type, ["tenant", "device"]);
def owner_role: m::Role(OwnerRow) = m::role(owners, f::device, "subject", False, [
    m::identity_part(m::field(OwnerRow.type, f::TenantId.type, "tenant"), m::field(f::Identity.type, f::TenantId.type, "tenant")),
    m::identity_part(m::field(OwnerRow.type, f::DeviceId.type, "device"), m::field(f::Identity.type, f::DeviceId.type, "local")),
]);
def owner_label: g::Binding(OwnerRow) = g::dimension(owners, f::label,
    g::input(m::field(OwnerRow.type, String.type, "name")), "owner_label", True, [g::Filter::Eq]);
def remote: transform::Declaration = s_declared <~ {groups: [g::binding_facts(f::s_rx)]};
def peer: relations::Relation = relations::relation("peer", owners, owner_role, f::secs, f::seconds_role,
    {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0});
def peer_payload: edsl::PreparedPayload = transform::build("peer-groups",
    [transform::declare(owners, [owner_role], [owner_label], []), remote], [peer], [], [], graph_profile).payload;
def exists_request: Value = json::parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"owners"}],"edges":[],
    "select":[{"node":"r","dimension":"owner_label"}],
    "exists":[{"anchor":"r","nodes":[{"id":"sample","entity":"seconds"}],
        "edges":[{"relation":"peer","from":"r","to":"sample"}],
        "having":[{"node":"sample","measure":"rx_mean","op":"Gt","value":60.0}]}]}"#).unwrap!();
pub def graph_group_measure_still_rejects_join_fanout: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(peer_payload)(json::parse(r#"{"op":"Graph","root":"r",
        "nodes":[{"id":"r","entity":"owners"},{"id":"sample","entity":"seconds"},{"id":"other","entity":"seconds"}],
        "edges":[{"relation":"peer","from":"r","to":"sample"},{"relation":"peer","from":"r","to":"other"}],"select":[],
        "measures":[{"node":"sample","measure":"rx_total"}]}"#).unwrap!())
}, "graph measure source may be multiplied by a joined relation; use correlated EXISTS for qualification");
def graph_case: Fn(String, edsl::PreparedPayload, Value) -> RuntimeCase = fn(id, payload, input) {
    export_case(id, intent::query_intent_ast_factory(payload)(input))
};
pub def graph_runtime_cases: Value = codec::encode([
    graph_case("ms_grouped", ms_payload, graph_request("millis", True)),
    graph_case("s_grouped", s_payload, graph_request("seconds", True)),
    graph_case("ms_all", ms_payload, graph_request("millis", False)),
    graph_case("s_all", s_payload, graph_request("seconds", False)),
    graph_case("ms_exists", peer_payload, exists_request),
]);
