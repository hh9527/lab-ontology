use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::enterprise_slot;
use crate::datasets::network_element;
@domain::subject("EnterpriseFrame", "frame_dn")
@domain::dataset("enterprise-frame", "EnterpriseFrame", ["frame_dn"])
@domain::relations(relations)
pub type EnterpriseFrame = struct {
    @m::column("softVersion")
    @g::field_view(g::dimension_group("enterprise-frame/soft_version", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ef_soft_version", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    soft_version: Option(String),
    @g::field_view(g::dimension_group("enterprise-frame/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ef_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: Option(String),
    @m::column("operState")
    @g::field_view(g::dimension_group("enterprise-frame/oper_state/raw", Int.type, True, [g::Filter::Eq, g::Filter::Ne]), "ef_oper_state_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::EfOperState.type, "ef_oper_state", [v::member(domains::EfOperState::Normal, [3,11,13,15,16]), v::member(domains::EfOperState::Error, [2,12,17]), v::member(domains::EfOperState::Offline, [4]), v::member(domains::EfOperState::Unknow, [1,-1])])
    oper_state: Option(Int),
    @m::column("adminState")
    @g::field_view(g::dimension_group("enterprise-frame/admin_state/raw", Int.type, True, [g::Filter::Eq, g::Filter::Ne]), "ef_admin_state_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::EfAdminState.type, "ef_admin_state", [v::member(domains::EfAdminState::Normal, [4,11]), v::member(domains::EfAdminState::Error, [2,3,12]), v::member(domains::EfAdminState::Important, [13]), v::member(domains::EfAdminState::Unknow, [1,-1])])
    admin_state: Option(Int),
    @m::column("refParentNE")
    @g::field_view(g::dimension_group("enterprise-frame/ref_parent_ne", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "ef_ref_parent_ne", True, [g::Filter::Eq])
    ref_parent_ne: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("frameDn")
    @g::field_view(g::dimension_group("enterprise-frame/frame_dn", ids::EnterpriseFrameById.type, True, [g::Filter::Eq]), "ef_frame_dn", True, [g::Filter::Eq])
    @domain::count("ef_count")
    frame_dn: ids::EnterpriseFrameById,
};

pub def relations: Array(r::Relation) = [
    r::relation("ef__es", domain::endpoint(EnterpriseFrame.type, "frame_dn"), domain::endpoint(enterprise_slot::EnterpriseSlot.type, "frame_native_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ef__ne_rev", domain::endpoint(EnterpriseFrame.type, "ref_parent_ne"), domain::endpoint(network_element::NetworkElement.type, "id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
