# Frame独立声明，保留源可空性和已声明粒度
use super::inventory as i;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
# 可空DN仅表达来源引用，不虚构Frame主键或grain
type FrameDn = struct(String);
type Reference = struct { dn: FrameDn };
def reference: m::Entity(Reference) = m::entity("frame_source_reference", Reference.type);
type Row = struct {
    name: String,
    ref_parent_ne: Option(i::DeviceId),
    tenant_id: Option(i::TenantId),
    oper_state: Option(Int),
    source_manufacturer: Option(String),
    source_softVersion: Option(String),
    source_remark: Option(String),
    source_projectId: Option(String),
    frame_dn: Option(FrameDn),
    source_adminState: Option(Int),
};
def dataset: m::Dataset(Row) = m::dataset("frame", "I_EnterpriseFrame", Row.type, []);
def device: m::Role(Row) = m::role(dataset, i::device, "device", True, [m::identity_part(m::optional_field(Row.type, i::DeviceId.type, "ref_parent_ne"), m::field(i::DeviceIdentity.type, i::DeviceId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", True, [m::identity_part(m::optional_field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
def frame_reference: m::Role(Row) = m::role(dataset, reference, "frame_reference", True, [m::identity_part(m::optional_field(Row.type, FrameDn.type, "frame_dn"), m::field(Reference.type, FrameDn.type, "dn"))]);
type FrameOperState = struct(String);
def FrameOperState_domain: v::Domain(FrameOperState, Int) = v::domain("FrameOperState", FrameOperState.type, Int.type, [
    v::member(FrameOperState("normal"), [3, 11, 13, 15, 16]),
    v::member(FrameOperState("error"), [2, 12, 17]),
    v::member(FrameOperState("wire_4_5978b238"), [4]),
    v::member(FrameOperState("wire_1_8d618873"), [1]),
    v::member(FrameOperState("wire__1_fe93bf05"), [-1]),
], False);
type FrameAdminState = struct(String);
def FrameAdminState_domain: v::Domain(FrameAdminState, Int) = v::domain("FrameAdminState", FrameAdminState.type, Int.type, [
    v::member(FrameAdminState("wire_4_5978b238"), [4]),
    v::member(FrameAdminState("wire_11_2c163c76"), [11]),
    v::member(FrameAdminState("wire_2_d0a68914"), [2]),
    v::member(FrameAdminState("wire_3_bab86ec8"), [3]),
    v::member(FrameAdminState("wire_12_5dc4ea39"), [12]),
    v::member(FrameAdminState("wire_13_c3b4db05"), [13]),
    v::member(FrameAdminState("wire_1_8d618873"), [1]),
    v::member(FrameAdminState("wire__1_fe93bf05"), [-1]),
], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [device, tenant, frame_reference], [
    i::search(dataset, m::field(Row.type, String.type, "name"), "frame_name"),
    i::search(dataset, m::optional_field(Row.type, String.type, "source_manufacturer"), "frame__manufacturer"),
    i::search(dataset, m::optional_field(Row.type, String.type, "source_softVersion"), "frame__softVersion"),
    i::search(dataset, m::optional_field(Row.type, String.type, "source_remark"), "frame__remark"),
    i::exact(dataset, m::optional_field(Row.type, String.type, "source_projectId"), "frame__projectId"),
    i::exact(dataset, m::optional_field(Row.type, FrameDn.type, "frame_dn"), "frame__frameDn"),
], []), [
    t::column(m::field(Row.type, String.type, "name"), "name"),
    t::column(m::optional_field(Row.type, i::DeviceId.type, "ref_parent_ne"), "refParentNE"),
    t::column(m::optional_field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::optional_field(Row.type, Int.type, "oper_state"), "operState"),
    t::column(m::optional_field(Row.type, String.type, "source_manufacturer"), "manufacturer"),
    t::column(m::optional_field(Row.type, String.type, "source_softVersion"), "softVersion"),
    t::column(m::optional_field(Row.type, String.type, "source_remark"), "remark"),
    t::column(m::optional_field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::optional_field(Row.type, FrameDn.type, "frame_dn"), "frameDn"),
    t::column(m::optional_field(Row.type, Int.type, "source_adminState"), "adminState"),
 ]), [
    v::bind(dataset, v::dimension_group(FrameOperState_domain, True, g::equality_filters), g::input(m::optional_field(Row.type, Int.type, "oper_state")), "frame_oper_state", True, g::equality_filters),
    v::bind(dataset, v::dimension_group(FrameAdminState_domain, True, g::equality_filters), g::input(m::optional_field(Row.type, Int.type, "source_adminState")), "frame__adminState", True, g::equality_filters),
]);
def relations: Array(r::Relation) = [
    r::relation("frame_belongs_to_device", dataset, device, i::devices, i::device_subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("source_EntNetworkElement_EnterpriseFrame", i::devices, i::device_subject, dataset, device, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("source_EnterpriseFrame_X_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
pub use self::{declaration, relations, FrameDn, Reference, reference, dataset, frame_reference};
