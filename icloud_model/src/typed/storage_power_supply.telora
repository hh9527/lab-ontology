use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储组件来源：parent 使用存储设备身份；原始文本不按单位说明隐式解析。
use super::inventory as i;
use super::storage as storage;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("StoragePowerSupply")
type StoragePowerSupplyById = struct(ComponentId);
@domain::subject("StoragePowerSupply", "source_id")
@domain::dataset("source_SYS_PowerSupply", "SYS_PowerSupply", ["source_id"])
@domain::relations(relations)
type SysPowerSupply = struct {
    @m::column("id")
    @g::exact("source_SYS_PowerSupply__id")
    source_id: StoragePowerSupplyById,
    @m::column("tenantId")
    @g::exact("source_SYS_PowerSupply__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("name")
    @g::search("source_SYS_PowerSupply__name")
    source_name: String,
    @m::column("slot")
    @g::exact("source_SYS_PowerSupply__slot")
    source_slot: String,
    @m::column("elecLabel")
    @g::search("source_SYS_PowerSupply__elecLabel")
    source_elecLabel: String,
    @m::column("parentResId")
    @g::exact("source_SYS_PowerSupply__parentResId")
    source_parentResId: domain::Reference(storage::StorageById),
    @m::column("bomCode")
    @g::search("source_SYS_PowerSupply__bomCode")
    source_bomCode: String,
    @m::column("powerMode")
    @v::classification(SourceSYSPowerSupplyPowerMode_domain, "source_SYS_PowerSupply__powerMode")
    source_powerMode: Int,
    @m::column("sn")
    @g::search("source_SYS_PowerSupply__sn")
    source_sn: String,
    @m::column("description")
    @g::search("source_SYS_PowerSupply__description")
    source_description: String,
    @m::column("boardType")
    @g::exact("source_SYS_PowerSupply__boardType")
    source_boardType: String,
    @m::column("barCode")
    @g::search("source_SYS_PowerSupply__barCode")
    source_barCode: String,
    @m::column("location")
    @g::search("source_SYS_PowerSupply__location")
    source_location: String,
    @m::column("temperature")
    @g::exact("source_SYS_PowerSupply__temperature")
    source_temperature: String,
    @m::column("productModel")
    @g::search("source_SYS_PowerSupply__productModel")
    source_productModel: String,
    @m::column("powerVersion")
    @g::search("source_SYS_PowerSupply__powerVersion")
    source_powerVersion: String,
    @m::column("produceDate")
    @g::field_view(
        g::dimension_group(
            "source_SYS_PowerSupply__produceDate",
            s::Date.type,
            True,
            g::numeric_filters
        ),
        "source_SYS_PowerSupply__produceDate",
        True,
        g::numeric_filters
    )
    source_produceDate: s::Date,
    @m::column("powerType")
    @v::classification(SourceSYSPowerSupplyPowerType_domain, "source_SYS_PowerSupply__powerType")
    source_powerType: String,
    @m::column("runningStatus")
    @v::classification(
        SourceSYSPowerSupplyRunningStatus_domain,
        "source_SYS_PowerSupply__runningStatus"
    )
    source_runningStatus: String,
    @m::column("healthStatus")
    @v::classification(
        SourceSYSPowerSupplyHealthStatus_domain,
        "source_SYS_PowerSupply__healthStatus"
    )
    source_healthStatus: String,
    @m::column("manufacturer")
    @g::search("source_SYS_PowerSupply__manufacturer")
    source_manufacturer: String,
    @m::column("projectId")
    @g::exact("source_SYS_PowerSupply__projectId")
    source_projectId: String,
};

def subject: r::Endpoint = domain::endpoint(SysPowerSupply.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(SysPowerSupply.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(SysPowerSupply.type, "source_parentResId");

@knowledge_policy::reverse_references(True)
type SourceSYSPowerSupplyPowerMode = enum {
    @ev::itag(0)
    @ev::description("Balanced mode", "均衡模式")
    BalancedMode,
    @ev::itag(1)
    @ev::description("Active power mode", "主电源模式")
    ActivePowerMode,
    @ev::itag(2)
    @ev::description("Backup power mode", "备用电源模式")
    BackupPowerMode,
};
def SourceSYSPowerSupplyPowerMode_domain: v::Domain(SourceSYSPowerSupplyPowerMode, Int) = v::from_enum(
    "SourceSYSPowerSupplyPowerMode",
    SourceSYSPowerSupplyPowerMode.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSPowerSupplyPowerType = enum {
    @ev::rename("0")
    @ev::description("DC power supply", "直流电源")
    DcPowerSupply,
    @ev::rename("1")
    @ev::description("AC power supply", "交流电源")
    AcPowerSupply,
    @ev::rename("2")
    @ev::description("High-voltage DC power supply", "高压直流电源")
    HighVoltageDcPowerSupply,
    @ev::rename("255")
    Placeholder,
};
def SourceSYSPowerSupplyPowerType_domain: v::Domain(SourceSYSPowerSupplyPowerType, String) = v::from_enum(
    "SourceSYSPowerSupplyPowerType",
    SourceSYSPowerSupplyPowerType.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSPowerSupplyRunningStatus = enum {
    @ev::rename("0")
    @ev::description("unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::description("normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("running", "运行")
    Running,
    @ev::rename("27")
    @ev::description("online", "在线")
    Online,
    @ev::rename("28")
    @ev::description("offline", "离线")
    Offline,
};
def SourceSYSPowerSupplyRunningStatus_domain: v::Domain(SourceSYSPowerSupplyRunningStatus, String) = v::from_enum(
    "SourceSYSPowerSupplyRunningStatus",
    SourceSYSPowerSupplyRunningStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSPowerSupplyHealthStatus = enum {
    @ev::rename("0")
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("Faulty", "故障")
    Faulty,
    @ev::rename("9")
    @ev::description("Inconsistent", "不一致")
    Inconsistent,
    @ev::rename("11")
    @ev::description("No Input", "无输入")
    NoInput,
    @ev::rename("19")
    @ev::description("absent", "不在位")
    Absent,
};
def SourceSYSPowerSupplyHealthStatus_domain: v::Domain(SourceSYSPowerSupplyHealthStatus, String) = v::from_enum(
    "SourceSYSPowerSupplyHealthStatus",
    SourceSYSPowerSupplyHealthStatus.type,
    String.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceAssociationSYS_PowerSupply",
        storage::subject,
        parent,
        cardinality
    ),
    r::relation(
        "source_SYS_PowerSupplyAssociationX_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{SysPowerSupply, StoragePowerSupplyById};
