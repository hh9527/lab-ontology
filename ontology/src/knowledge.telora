use crate::ontology as edsl;
use std::array as array;
use std::blame as blame;
use std::codec as codec;
use std::dict as dict;
use std::json as json;
use std::type_property as property;
use std::value::{ Value };

type LinkKind = enum { Member, Traversable, Related };
type KnowledgeLink = struct { target: edsl::KnowledgeTarget, kind: LinkKind };
type IndexEntry = struct { key: edsl::KnowledgeTarget, label: String, aliases: Array(String), summary: String };
type Point = struct {
    logical_type: Option(edsl::LogicalType),
    nullable: Bool,
    references: Array(edsl::ReferenceSpec),
    field_roles: Array(edsl::FieldRoleBrief),
    roles: Array(edsl::FieldRole),
    target: edsl::KnowledgeTarget,
    label: String,
    aliases: Array(String),
    localized: Array(edsl::LocalizedKnowledgeText),
    summary: String,
    refs: Array(KnowledgeLink),
    grain: Array(String),
    time_roles: Array(edsl::TimeRoleBrief),
    time_role: Option(edsl::TimeRoleBrief),
    dimension: Option(edsl::VisibleDimensionBrief),
    measure: Option(edsl::MeasureBrief),
    relation: Option(edsl::RelationBrief),
    metric: Option(edsl::MetricValueEntry),
    direction: Option(edsl::LinkDirection),
    guard: Option(edsl::ScopePredicate),
    entries: Option(Array(IndexEntry)),
    terminology: Option(Array(edsl::TermAnnotation)),
};
type KnowledgeIndex = struct { entries: Array(IndexEntry) };
type DocResult = enum { NotFound, Found(Point) };
type KnowledgeResponse = enum { Document(DocResult) };
type KnowledgeRequest = struct { method: String, input: Value };
type InfoInput = struct { key: String };
type Description = struct { label: String, aliases: Array(String), localized: Array(edsl::LocalizedKnowledgeText), summary: String };
type NodeLink = struct { type: LinkKind, key: String };
type Node = struct { key: String, type: edsl::KnowledgeKind, description: Description, links: Array(NodeLink), detail: Value };
type NodeResult = enum { NotFound, Found(Node) };
type NodeResponse = enum { Document(NodeResult) };
type DatasetDetail = struct { id: String, grain: Array(String), time_roles: Array(edsl::TimeRoleBrief), references: Array(edsl::ReferenceSpec), field_roles: Array(edsl::FieldRoleBrief) };
type FieldDetail = struct { id: String, dataset: String, nullable: Bool, logical_type: Option(edsl::LogicalType), roles: Array(edsl::FieldRole), reference_ids: Array(String) };
type ValueDetail = struct { id: String, dimension: String };
type BusinessLinkDetail = struct { id: String, hub: String, direction: Option(edsl::LinkDirection), guard: Option(edsl::ScopePredicate) };

def target: Fn(edsl::KnowledgeKind, String, String) -> edsl::KnowledgeTarget = fn(kind, owner, id) {
    {kind, owner, id}
};

def member: Fn(edsl::KnowledgeTarget) -> KnowledgeLink = fn(item) { {target: item, kind: LinkKind::Member} };
def traversable: Fn(edsl::KnowledgeTarget) -> KnowledgeLink = fn(item) { {target: item, kind: LinkKind::Traversable} };

def point: Fn(edsl::KnowledgeTarget, String, Array(String), String, Array(KnowledgeLink)) -> Point =
    fn(id, label, aliases, summary, refs) {
        {target: id, label, aliases, localized: [], summary, refs, grain: [], time_roles: [], time_role: None,
            references: [], field_roles: [], roles: [], nullable: False, logical_type: None,
            dimension: None, measure: None, relation: None, metric: None, direction: None, guard: None,
            entries: None, terminology: None}
    };

def syntax_target: Fn(String) -> edsl::KnowledgeTarget = fn(id) {
    target(edsl::KnowledgeKind::Schema, "", `syntax/\{id}`)
};

def syntax_points: Array(Point) = [
    point(syntax_target("model/ipv4_subnets"), "Restricted IPv4 subnet operations", [],
        "InSubnet and NotInSubnet apply only to an Ipv4 dimension that declares the operation in ops. value is a canonical IPv4 CIDR string, no kind: for example 10.4.16.0/20. Every integer mask /0..32 is supported. Host bits must be zero, never silently normalized. Input address and stored values use canonical dotted decimal without leading zeros. Whole-octet prefixes retain the trailing dot, so 10.4.0.0/16 cannot match 10.40.0.1. Lowering uses a bound half-open binary text range as prefilter, followed by a bound generated regex for partial octets. /32 uses address equality; /0 matches every non-NULL address. NotInSubnet negates the entire membership predicate over non-NULL addresses, not missing values. CIDR is a network operation argument, not an address for Eq or any_of. Typed callers use Ipv4Subnet. No Text, IPv6 or native inet conversion is implied. PostgreSQL uses COLLATE C and native regex; SQLite uses COLLATE BINARY and requires the executor to register regexp(pattern,value), returning NULL for NULL arguments and boolean membership otherwise. Generated patterns use only anchors, decimal alternatives, groups, [.] and [0-9]{1,3}. A usable range index must have the matching collation; index use is not guaranteed by semantic support. Preparation checks comparison, binary collation, conjunction, regex and negation capabilities.",
        [member(syntax_target("model/logical_types")), member(syntax_target("graph/filter"))]),
    point(syntax_target("model/logical_types"), "Logical types and field capabilities", [],
        "Physical storage is not the logical value domain. Time fields distinguish Rfc3339, Utc1, Date, LocalDateTime and EpochMillis even when their storage is String or Int. Explicit logical_type(Ipv4) uses canonical dotted-decimal String storage with four octets 0..255 and no leading zeros; it is not Text. Address Eq/Ne and IPv4 CIDR InSubnet/NotInSubnet are defined; see the linked subnet contract. No lexical ordering, Contains, IPv6 or implicit conversion to Text. Noncanonical stored addresses violate the declared storage contract; preparation does not scan data. The field's published ops may narrow the type's operations, but cannot give a type an undefined operation. Index availability and cost are field/physical capability considerations, not a reason to reinterpret address semantics. Names of fields do not infer their types; raw unknown-format source columns remain Text until their representation is established. Logical types grant no filter or projection authorization.", [member(syntax_target("model/ipv4_subnets"))]),
    point(syntax_target("model/field_roles"), "Field roles and object references", [],
        "Dataset detail.references contains named {id,fields} sets. Each complete non-NULL tuple is a trusted unique address within that dataset; fields inside a set participate together, and different sets are alternative addresses. Field detail.nullable is derived from Option(T). Any missing member makes the entire reference unavailable; NULL is not an address value. A nullable reference does not establish a total key or grain. Do not treat one member of a composite set as a complete reference. Dataset detail.field_roles contains {field,roles}; Field detail has roles and reference_ids. Appellation participates in identity display and need not be unique; Reference participates in an explicitly declared unique address; Classification describes a category; Metric describes quantitative use. Roles may overlap. Formal metric declarations also derive Metric. Roles grant no query capabilities, do not change grain or keys, and imply no default display, URL, unit or aggregate. Only fully visible references are published. Query and report consumers must respect the separately declared capabilities.", []),
    point(target(edsl::KnowledgeKind::Index, "", "index"), "Knowledge index", [],
        "The complete flat catalog of visible knowledge points. Read it through info with key \"index\" and pass each entry's opaque string key unchanged to info.",
        [member(target(edsl::KnowledgeKind::Terminology, "", "terminology"))]),
    point(target(edsl::KnowledgeKind::Terminology, "", "terminology"), "Domain terminology", [],
        "Supplemental common expressions, aliases and local names associated with the formal domain concepts already listed in Index. Derived from Model alias, localization and term annotations. A term may link to multiple nodes: the agent interprets the user's meaning and reads those nodes, then uses only Model-defined canonical business IDs in Intent. Terms are not accepted query vocabulary, automatic substitutions or additional query relationships.",
        [member(target(edsl::KnowledgeKind::Index, "", "index"))]),
    point(syntax_target("knowledge/target"), "Knowledge target", [],
        "The Index node contains one entry per visible knowledge node in detail.entries. info accepts {key:<opaque string>}; pass an index entry's key or a node link's key unchanged. Keys are path-like but opaque: do not split, decode or construct them. Names and aliases describe knowledge but are not keys.",
        [member(syntax_target("knowledge/node"))]),
    point(syntax_target("knowledge/node"), "Knowledge node contract", [],
        "Every Found node is {key,type,description,links,detail}. description is {label,aliases,localized,summary}; localized items are {locale,label,summary}. links are {type,key}, with Member for structural membership, Related for discovery-only associations and Traversable for declared relation endpoints. A link does not replace Intent validation. type determines detail: Index has entries [{key,type,description:{label,aliases,summary}}]; Terminology has entries [{term,description,key}]; Dataset has {id,grain,time_roles,references,field_roles}; Field has {id,dataset,nullable,logical_type,roles,reference_ids}; Value has {id,dimension}; Dimension, Measure and Relation preserve their corresponding Model details; TimeRole and Metric also identify their owning dataset; BusinessLink has {id,hub,direction,guard}; Schema has an empty detail object. Canonical business IDs are explicit detail fields, never inferred from a knowledge key. Unknown or hidden keys return NotFound.",
        [member(target(edsl::KnowledgeKind::Index, "", "index")), member(target(edsl::KnowledgeKind::Terminology, "", "terminology"))]),
    point(syntax_target("knowledge/request"), "Knowledge request", [],
        "The unbound knowledge service accepts exactly {method,input}. method is <domain>/info; input follows the declared info shape. A mounted service slot receives only input, without this envelope.",
        [member(syntax_target("knowledge/info"))]),
    point(syntax_target("knowledge/info"), "Knowledge info request", [],
        "info input is exactly {key:<opaque string>}. Start with key \"index\" for the complete catalog. Use keys from its entries or node links unchanged. Unknown or invisible keys return NotFound.",
        [member(syntax_target("knowledge/target")), member(target(edsl::KnowledgeKind::Index, "", "index"))]),
    point(syntax_target("intent"), "Intent syntax", [],
        "Submit {intents:[...]} with one to five independent intents. Each intent has op Graph, GraphPair or GraphUnion. Values in filters are interpreted by their declared dimension or measure; do not supply an input kind.",
        [member(syntax_target("graph")), member(syntax_target("graph_pair")), member(syntax_target("graph_union")),
            member(syntax_target("knowledge/target")), member(syntax_target("knowledge/request"))]),
    point(syntax_target("graph"), "Graph intent", [],
        "Required: op=Graph, root node id, nodes, edges, select. Optional: row_grain=Root|Association, distinct, constraints, measures, measure_having, filters, time_windows, any_of, exists, count, count_value, count_having, count_groups, include_empty, group_by_identity, top_per, top_by_measure, order_by, take. A graph must project dimensions/measures or count an explicit subject. Entity, dimension, measure and relation IDs come from domain knowledge.",
        [member(syntax_target("graph/node")), member(syntax_target("graph/edge")), member(syntax_target("graph/select")),
            member(syntax_target("graph/filter")), member(syntax_target("graph/aggregate")),
            member(syntax_target("graph/existence")), member(syntax_target("graph/order"))]),
    point(syntax_target("graph/node"), "Graph node", [],
        "Node: {id,entity}. id is a request-local node name; entity is a declared dataset ID. root names one node id.", []),
    point(syntax_target("graph/edge"), "Graph edge", [],
        "Edge or constraint: {relation,from,to}. relation is a declared relation ID; from and to name nodes. Only declared, directionally valid relations can be traversed.", []),
    point(syntax_target("graph/select"), "Graph projection", [],
        "select items are {node,dimension}; measures items are {node,measure}. count is a node id; count_value is {node,dimension}. group_by_identity is an array of node ids. Use declared IDs, not field or SQL names.", []),
    point(syntax_target("graph/filter"), "Graph filter", [],
        "filters items are {node,dimension,op,value}; any_of items are {node,dimension,values}. Operators: Eq, Ne, Gt, Ge, Lt, Le, Contains, NotContains, StartsWith, EndsWith, InSubnet, NotInSubnet. Subnet operators take a restricted canonical IPv4 CIDR network; read the shared subnet contract. The dimension declares allowed operators, logical input type and values. No kind field: use a JSON string, number or boolean compatible with the dimension. For half_open dimensions, a known concept uses its listed business ID; {\"unknown\":\"raw value\"} matches one unrecognized wire and {\"unknowns\":true} matches all unrecognized non-NULL wires. Ne takes the non-NULL complement. Consult dimension.value_contract for tagged result columns. Typed measure predicate inputs and canonical wires in info describe Model facts, not the Intent value shape. Resolve relative times before submission.", [member(syntax_target("model/ipv4_subnets"))]),
    point(syntax_target("graph/aggregate"), "Graph aggregate", [],
        "measure_having and existence having items are {node,measure,op,value}; value follows the measure output type. A measure ID selects its Model-declared aggregation, never an implicit override. If that meaning does not meet the business request, discover another declared measure or report the missing capability. Outer measure_having requires its measure in measures and either (1) group_by_identity=[root] with root-only selected dimensions, or (2) the supported contextual sample shape: root context -> owner and sample -> owner, both owner endpoints One or Optional, complete context/owner/sample identities, group_by_identity=[root,owner], and selections from context/owner only. The latter permits one optional owner -> ancestor edge with an at-most-one ancestor endpoint and ancestor selections; exactly three nodes, or four with that ancestor, and no extra edges, row count, business-link edges or include_empty. This keeps each owner's sample population separate per context identity instead of merging names or multiplying observations. Existence having is checked in its own population, not by the outer measure_having shape. count_having is {op,value} with integer value. count_groups and include_empty are booleans. Do not add identity grouping merely to bypass a rejection if it changes the requested business groups.",
        [member(syntax_target("graph/select")), member(syntax_target("graph/edge")), member(syntax_target("graph/existence"))]),
    point(syntax_target("graph/filter/capabilities"), "Declared filter capabilities", [],
        "The syntax operator vocabulary is not permission to apply every operator to every dimension. Read the dimension's filterable, ops, input_kinds and values. Eq-only is a Model capability boundary, not a missing SQL implementation. A rejected Contains cannot silently become StartsWith or Eq: these select different populations. Choose a discovered equivalent plan, ask a business clarification when appropriate, or explain the unavailable capability. Text pattern operators currently compare case-folded text; do not infer exact case-sensitive identifier semantics. Model scope and filtered-measure predicates obey the same declared capabilities.",
        [member(syntax_target("graph/filter"))]),
    point(syntax_target("graph/order/semantics"), "Ordering and aggregate meaning", [],
        "Raw order_by plus take returns the first rows in one global ordered population, not per-group Min or Max statistics. Raw take appends complete declared grain identity columns as tie breakers for deterministic selection; it does not promise a business preference among equal values. SQLite ASC places NULL first and DESC places NULL last; PostgreSQL execution equivalence must explicitly preserve that contract rather than use its opposite defaults. Consequently ASC take=1 may return a missing value whereas Min ignores NULL. Aggregate top_by_measure ranks by the selected measure's declared aggregation: highest average is not highest sample peak. Discover a declared sample summary when that is the requested meaning, and never substitute raw Top-N for a missing statistical capability without explaining the different business result.",
        [member(syntax_target("graph/order")), member(syntax_target("graph/aggregate"))]),
    point(syntax_target("graph/existence"), "Graph existence", [],
        "Use EXISTS to qualify outer rows without multiplying their grain. Complete Graph shape: {\"op\":\"Graph\",\"root\":\"outer\",\"nodes\":[{\"id\":\"outer\",\"entity\":\"<outer entity>\"}],\"edges\":[],\"select\":[{\"node\":\"outer\",\"dimension\":\"<outer dimension>\"}],\"exists\":[{\"anchor\":\"outer\",\"nodes\":[{\"id\":\"related\",\"entity\":\"<related entity>\"}],\"edges\":[{\"relation\":\"<declared relation>\",\"from\":\"related\",\"to\":\"outer\"}],\"filters\":[{\"node\":\"related\",\"dimension\":\"<related dimension>\",\"op\":\"Eq\",\"value\":\"<value>\"}]}]}. Replace placeholders using domain info; relation direction must match its declaration and may instead run from outer to related. The anchor names an outer node; inner nodes belong only to EXISTS. Other optional existence keys: constraints, time_windows, any_of, having, negated (boolean). Remove the example filter if mere existence is enough. An outer count or measure can replace select when its grain is valid.",
        [member(syntax_target("graph/edge")), member(syntax_target("graph/filter"))]),
    point(syntax_target("graph/order"), "Graph ordering and time", [],
        "Raw global Top-N Graph shape: {\"op\":\"Graph\",\"root\":\"row\",\"nodes\":[{\"id\":\"row\",\"entity\":\"<entity>\"}],\"edges\":[],\"select\":[{\"node\":\"row\",\"dimension\":\"<dimension>\"}],\"order_by\":[{\"node\":\"row\",\"dimension\":\"<ordered dimension>\",\"direction\":\"Desc\"}],\"take\":3}. Raw take requires ordered raw rows and grain-safe joins from the root; qualify multiplying paths with EXISTS (see syntax/graph/existence). Aggregate Top-N Graph shape: {\"op\":\"Graph\",\"root\":\"row\",\"nodes\":[{\"id\":\"row\",\"entity\":\"<entity>\"}],\"edges\":[],\"select\":[{\"node\":\"row\",\"dimension\":\"<group dimension>\"}],\"measures\":[{\"node\":\"row\",\"measure\":\"<measure>\"}],\"top_by_measure\":{\"node\":\"row\",\"measure\":\"<measure>\",\"direction\":\"Desc\",\"take\":3}}. This ranks visible dimension groups only when hidden identity keys do not split them and the measure source is grain-safe. Per-owner sample Top-N Graph shape: {\"op\":\"Graph\",\"root\":\"owner\",\"nodes\":[{\"id\":\"owner\",\"entity\":\"<owner entity>\"},{\"id\":\"sample\",\"entity\":\"<sample entity>\"}],\"edges\":[{\"relation\":\"<sample-to-owner relation>\",\"from\":\"sample\",\"to\":\"owner\"}],\"select\":[{\"node\":\"owner\",\"dimension\":\"<owner dimension>\"},{\"node\":\"sample\",\"dimension\":\"<sample dimension>\"}],\"top_per\":{\"owner\":\"owner\",\"sample\":\"sample\",\"rank\":\"<ordered sample dimension>\",\"take\":3}}. It requires exactly one declared sample-to-owner edge whose owner endpoint is One or Optional, a sample grain and an ordered sample rank dimension. Replace all placeholders using domain info. order_by items are {node,dimension,direction} with Asc|Desc; take is a positive bounded integer. time_windows items are {node,dimension,start,end}; end may be null or omitted for an open upper bound. Time values use the dimension's declared logical format.",
        [member(syntax_target("graph/existence")), member(syntax_target("graph/aggregate"))]),
    point(syntax_target("graph_pair"), "Graph pair", [],
        "{op:GraphPair,left,right,count_groups?}. left and right are Graph intents over the same root entity, matching selected dimensions and identity grouping. Each has exactly one measure; qualify each population inside its own graph.",
        [member(syntax_target("graph"))]),
    point(syntax_target("graph_union"), "Graph union", [],
        "{op:GraphUnion,branches:[{result_node,graph},...]}. At least two Graph branches return the same entity and selected dimensions in the same order. Each branch projects the complete result identity as raw unordered rows; union removes duplicates.",
        [member(syntax_target("graph"))]),
];

def labels: Fn(Array(edsl::LocalizedKnowledgeText)) -> Array(String) = fn(texts) {
    array::map(texts, fn(entry) { entry.label })
};

def dataset_point: Fn(edsl::PreparedPayload, edsl::DatasetBrief) -> Point = fn(payload, brief) {
    let id = target(edsl::KnowledgeKind::Dataset, "", brief.id);
    let dimensions = array::map(brief.dimension_ids, fn(name) {
        member(target(edsl::KnowledgeKind::Dimension, brief.id, name))
    });
    let fields = array::map(edsl::published_fields(payload, brief.id), fn(name) {
        member(target(edsl::KnowledgeKind::Field, brief.id, name))
    });
    let measures = array::map(brief.measure_ids, fn(name) {
        member(target(edsl::KnowledgeKind::Measure, brief.id, name))
    });
    let metrics = array::map(brief.metric_ids, fn(name) {
        member(target(edsl::KnowledgeKind::Metric, brief.id, name))
    });
    let times = array::map(brief.time_roles, fn(role) {
        member(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field))
    });
    let relations = array::map(brief.relation_ids, fn(name) {
        let declared = match array::find(payload.relations, fn(entry) { entry.id == name }) {
            Some(entry) => entry,
            None => fail!("knowledge relation disappeared from prepared model", name),
        };
        member(target(edsl::KnowledgeKind::Relation, payload.entities[declared.from].id, name))
    });
    let links = array::map(array::filter(payload.business_links, fn(link) {
        let hub = payload.entities[link.hub].id;
        let participant = payload.entities[link.participant].id;
        hub == brief.id || participant == brief.id
    }), fn(link) {
        member(target(edsl::KnowledgeKind::BusinessLink, payload.entities[link.hub].id, link.id))
    });
    let role_contract = if array::length(brief.references) > 0 || array::length(brief.field_roles) > 0 {
        [member(syntax_target("model/field_roles"))]
    } else { [] };
    let refs = array::concat([fields, dimensions, measures, metrics, times, relations, links, role_contract]);
    let item = point(id, brief.label, array::concat([brief.aliases, labels(brief.localized)]), brief.summary, refs);
    let entity = match array::find(payload.entities, fn(e) { e.id == brief.id }) {
        Some(e) => e, None => fail!("knowledge dataset disappeared from prepared model", brief.id),
    };
    let grain = match entity.dataset {
        Some(spec) => spec.grain,
        None => if entity.key_field >= 0 { [entity.fields[entity.key_field].name] } else { [] },
    };
    {...item, localized: brief.localized, grain, time_roles: brief.time_roles,
        references: brief.references, field_roles: brief.field_roles}
};

def dimension_points: Fn(edsl::PreparedPayload, String) -> Array(Point) = fn(payload, id) {
    let detail = edsl::visible_dimension_detail(payload, id);
    let parent = target(edsl::KnowledgeKind::Dataset, "", detail.dataset);
    let dimension = target(edsl::KnowledgeKind::Dimension, detail.dataset, detail.id);
    let values = array::map(detail.values, fn(value) {
        let current = target(edsl::KnowledgeKind::Value, detail.id, value.id);
        let item = point(current, value.label, array::concat([value.aliases, array::map(value.localized, fn(text) { text.label })]),
            "", [member(dimension)]);
        {...item, localized: array::map(value.localized, fn(text) {
            {locale: text.locale, label: text.label, summary: ""}
        })}
    });
    let value_refs = array::map(detail.values, fn(value) {
        member(target(edsl::KnowledgeKind::Value, detail.id, value.id))
    });
    let contracts = if detail.input_kinds == [edsl::FilterInputKind::Ipv4] {
        [member(syntax_target("graph/filter/capabilities")), member(syntax_target("model/ipv4_subnets"))]
    } else { [member(syntax_target("graph/filter/capabilities"))] };
    let base = point(dimension, detail.label, array::concat([detail.aliases, labels(detail.localized)]),
        detail.summary, array::concat([[member(parent), member(target(edsl::KnowledgeKind::Field, detail.dataset, detail.field))], value_refs, contracts]));
    array::concat([[{...base, dimension: Some(detail), localized: detail.localized}], values])
};

def measure_point: Fn(edsl::PreparedPayload, String) -> Point = fn(payload, id) {
    let detail = edsl::measure_detail(payload, id);
    let field_refs = match detail.field {
        Some(name) => [member(target(edsl::KnowledgeKind::Field, detail.dataset, name))], None => [],
    };
    let predicate_refs = match detail.predicate {
        None => [],
        Some(predicate) => do {
            let entity = match array::find(payload.entities, fn(entry) { entry.id == detail.dataset }) {
                Some(entry) => entry, None => fail!("measure predicate owner is not in the prepared model", id),
            };
            let field = match array::find(entity.fields, fn(entry) { entry.name == predicate.field }) {
                Some(entry) => entry, None => fail!("measure predicate field is not in the prepared model", id, predicate.field),
            };
            let dimension = match array::find(payload.dimensions, fn(entry) {
                entry.entity == entity.index && entry.field == field.index
            }) {
                Some(entry) => entry, None => fail!("measure predicate dimension is not in the prepared model", id, predicate.field),
            };
            let dimension_ref = target(edsl::KnowledgeKind::Dimension, detail.dataset, dimension.id);
            let business = edsl::visible_dimension_detail(payload, dimension.id);
            let value_ref = match (predicate.op, predicate.input) {
                (edsl::FilterOp::Eq, edsl::FilterInput::Text(name)) =>
                    if array::any(business.values, fn(value) { value.id == name }) {
                        [member(target(edsl::KnowledgeKind::Value, dimension.id, name))]
                    } else { [] },
                _ => [],
            };
            array::concat([[member(dimension_ref)], value_ref])
        },
    };
    let computed_refs = match detail.computed {
        Some(computed) => [member(target(edsl::KnowledgeKind::Measure, detail.dataset, computed.left)),
            member(target(edsl::KnowledgeKind::Measure, detail.dataset, computed.right))],
        None => [],
    };
    let refs = array::concat([
        [member(target(edsl::KnowledgeKind::Dataset, "", detail.dataset))],
        field_refs,
        array::map(detail.required_dataset_ids, fn(dataset) {
            member(target(edsl::KnowledgeKind::Dataset, "", dataset))
        }),
        predicate_refs, computed_refs,
    ]);
    let base = point(target(edsl::KnowledgeKind::Measure, detail.dataset, detail.id), detail.label,
        array::concat([detail.aliases, labels(detail.localized)]), detail.summary, refs);
    {...base, measure: Some(detail), localized: detail.localized}
};

def relation_point: Fn(edsl::PreparedPayload, String) -> Point = fn(payload, id) {
    let detail = edsl::relation_detail(payload, id);
    let guard_refs = match detail.guard {
        Some(guard) => [member(target(edsl::KnowledgeKind::Field, detail.from_dataset, guard.field))],
        None => [],
    };
    let base = point(target(edsl::KnowledgeKind::Relation, detail.from_dataset, detail.id), detail.label,
        array::concat([detail.aliases, labels(detail.localized)]), detail.summary,
        array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", detail.from_dataset)),
         traversable(target(edsl::KnowledgeKind::Dataset, "", detail.to_dataset))], guard_refs]));
    {...base, relation: Some(detail), localized: detail.localized}
};

def link_point: Fn(edsl::PreparedPayload, edsl::BusinessLinkEntry) -> Point = fn(payload, link) {
    let hub = payload.entities[link.hub].id;
    let participant = payload.entities[link.participant].id;
    let guard_refs = match link.guard {
        None => [],
        Some(pred) => [member(target(edsl::KnowledgeKind::Field, hub, pred.field))],
    };
    let base = point(target(edsl::KnowledgeKind::BusinessLink, hub, link.id), link.id, [], "",
        array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", hub)),
         traversable(target(edsl::KnowledgeKind::Dataset, "", participant)),
         member(target(edsl::KnowledgeKind::Relation, hub, link.a_relation)),
         member(target(edsl::KnowledgeKind::Relation, hub, link.z_relation))], guard_refs]));
    {...base, direction: Some(link.direction), guard: link.guard}
};

def dataset_members: Fn(edsl::PreparedPayload, edsl::DatasetBrief) -> Array(Point) = fn(payload, brief) {
    let entity = match array::find(payload.entities, fn(entity) { entity.id == brief.id }) {
        Some(entity) => entity, None => fail!("published dataset missing", brief.id),
    };
    let fields = array::map(edsl::published_fields(payload, brief.id), fn(name) {
        let item = point(target(edsl::KnowledgeKind::Field, brief.id, name), name, [], "",
            [member(target(edsl::KnowledgeKind::Dataset, "", brief.id))]);
        let field = match array::find(entity.fields, fn(field) { field.name == name }) {
            Some(field) => field, None => fail!("published field missing", brief.id, name),
        };
        {...item, nullable: field.nullable, logical_type: field.logical_type,
            refs: if field.logical_type != None { array::push(item.refs, member(syntax_target("model/logical_types"))) } else { item.refs },
            roles: match array::find(brief.field_roles, fn(field) { field.field == name }) {
            Some(field) => field.roles, None => [],
        }, references: array::filter(brief.references, fn(ref) { array::any(ref.fields, fn(field) { field == name }) })}
    });
    let dimensions = array::flat_map(brief.dimension_ids, fn(id) { dimension_points(payload, id) });
    let measures = array::map(brief.measure_ids, fn(id) { measure_point(payload, id) });
    let relations = array::map(array::filter(payload.relations, fn(entry) {
        entry.id != "" && payload.entities[entry.from].id == brief.id
    }), fn(entry) { relation_point(payload, entry.id) });
    let metrics = array::map(array::filter(payload.entities, fn(e) { e.id == brief.id }), fn(e) { e.metrics });
    let metric_points = array::flat_map(metrics, fn(items) { array::map(items, fn(metric) {
        let measure_refs = if array::any(brief.measure_ids, fn(id) { id == metric.id }) {
            [member(target(edsl::KnowledgeKind::Measure, brief.id, metric.id))]
        } else { [] };
        let base = point(target(edsl::KnowledgeKind::Metric, brief.id, metric.id), metric.id, [], "",
            array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", brief.id)),
                member(target(edsl::KnowledgeKind::Field, brief.id, metric.field))], measure_refs]));
        {...base, metric: Some(metric)}
    }) });
    let times = array::map(brief.time_roles, fn(role) {
        let base = point(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field), role.field, [], "",
            array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", brief.id)),
                member(target(edsl::KnowledgeKind::Field, brief.id, role.field))],
                array::map(role.dimension_ids, fn(id) {
                    member(target(edsl::KnowledgeKind::Dimension, brief.id, id))
                })]));
        {...base, time_role: Some(role)}
    });
    let links = array::map(array::filter(payload.business_links, fn(link) {
        payload.entities[link.hub].id == brief.id
    }), fn(link) { link_point(payload, link) });
    array::concat([fields, dimensions, measures, relations, metric_points, times, links])
};

def target_key: Fn(edsl::KnowledgeTarget) -> String = fn(id) {
    edsl::knowledge_key(id)
};

def visible_terms: Fn(edsl::PreparedPayload, Array(IndexEntry)) -> Array(edsl::TermAnnotation) =
    fn(payload, entries) {
        let declared = array::filter(array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::TermAnnotations.type) {
                Some(declared) => declared.entries, None => [],
            }
        }), fn(entry) { array::any(entries, fn(item) { item.key == entry.target }) });
        let aliases = array::flat_map(entries, fn(entry) {
            array::map(entry.aliases, fn(term) {
                {term, description: if entry.summary == "" { entry.label } else { entry.summary }, target: entry.key}.ty!(edsl::TermAnnotation)
            })
        });
        array::fold(array::concat([declared, aliases]), [].ty!(Array(edsl::TermAnnotation)), fn(seen, entry) {
            if array::any(seen, fn(other) { other.term == entry.term && other.target == entry.target }) { seen }
            else { array::push(seen, entry) }
        })
    };

def terminology_point: Fn(Point, Array(edsl::TermAnnotation)) -> Point = fn(item, terminology) {
    let targets = array::fold(terminology, [].ty!(Array(edsl::KnowledgeTarget)), fn(seen, entry) {
        if array::any(seen, fn(target) { target == entry.target }) { seen }
        else { array::push(seen, entry.target) }
    });
    {...item, terminology: Some(terminology), refs: array::concat([item.refs,
        array::map(targets, fn(target) { {target, kind: LinkKind::Related} })])}
};

# The root indexes every visible point; references must remain in that catalog.
def map: Fn(edsl::PreparedPayload) -> Array(Point) = fn(payload) {
    let datasets = edsl::visible_knowledge_index(payload);
    let index = index_from_model(payload);
    let base = array::concat([syntax_points,
        array::map(datasets, fn(brief) { dataset_point(payload, brief) }),
        array::flat_map(datasets, fn(brief) { dataset_members(payload, brief) }),
    ]);
    let terminology = visible_terms(payload, index.entries);
    let raw = array::map(base, fn(item) {
        if item.target.kind == edsl::KnowledgeKind::Terminology { terminology_point(item, terminology) }
        else if item.target.kind == edsl::KnowledgeKind::Index {
            {...item, entries: Some(index.entries),
                refs: array::map(array::filter(index.entries, fn(entry) { entry.key != item.target }),
                    fn(entry) { member(entry.key) })}
        }
        else { item }
    });
    let visible = dict::from_pairs(array::map(raw, fn(item) { (target_key(item.target), True) }));
    if let Some(dangling) = array::find(raw, fn(item) {
        array::any(item.refs, fn(ref) {
            dict::get(visible, target_key(ref.target)) == None
        })
    }) { fail!("knowledge point references a point outside the visible model", dangling.target) }
    else {
        let docs = array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeDocs.type) {
                Some(declared) => declared.entries, None => [],
            }
        });
        let related = array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeRelations.type) {
                Some(declared) => declared.entries, None => [],
            }
        });
        array::map(raw, fn(item) {
            let refs = array::concat([item.refs, array::map(array::filter(related, fn(ref) {
                ref.source == item.target && dict::get(visible, target_key(ref.target)) != None
            }), fn(ref) { {target: ref.target, kind: LinkKind::Related} })]);
            let summary = match array::find(docs, fn(note) { note.target == item.target }) {
                Some(note) => note.text, None => item.summary,
            };
            {...item, refs, summary}
        })
    }
};

def index_entries: Fn(Array(Point)) -> KnowledgeIndex = fn(points) {
    {entries: array::map(points, fn(item) {
        {key: item.target, label: item.label, aliases: item.aliases, summary: item.summary}
    })}
};

def index_entry: Fn(edsl::KnowledgeTarget, String, Array(String), String) -> IndexEntry = fn(key, label, aliases, summary) {
    {key, label, aliases, summary}
};

def index_from_model: Fn(edsl::PreparedPayload) -> KnowledgeIndex = fn(payload) {
    let datasets = edsl::visible_knowledge_index(payload);
    let roots = array::map(datasets, fn(brief) {
        index_entry(target(edsl::KnowledgeKind::Dataset, "", brief.id), brief.label,
            array::concat([brief.aliases, labels(brief.localized)]), brief.summary)
    });
    let members = array::flat_map(datasets, fn(brief) {
        let fields = array::map(edsl::published_fields(payload, brief.id), fn(name) {
            index_entry(target(edsl::KnowledgeKind::Field, brief.id, name), name, [], "")
        });
        let dimensions = array::flat_map(brief.dimension_ids, fn(id) {
            let detail = edsl::visible_dimension_detail(payload, id);
            array::concat([[index_entry(target(edsl::KnowledgeKind::Dimension, brief.id, id),
                detail.label, array::concat([detail.aliases, labels(detail.localized)]), detail.summary)],
                array::map(detail.values, fn(value) {
                index_entry(target(edsl::KnowledgeKind::Value, id, value.id), value.label,
                    array::concat([value.aliases, array::map(value.localized, fn(text) { text.label })]), "")
            })])
        });
        let measures = array::map(brief.measure_ids, fn(id) {
            let detail = edsl::measure_detail(payload, id);
            index_entry(target(edsl::KnowledgeKind::Measure, brief.id, id), detail.label,
                array::concat([detail.aliases, labels(detail.localized)]), detail.summary)
        });
        let relations = array::map(array::filter(payload.relations, fn(entry) {
            entry.id != "" && payload.entities[entry.from].id == brief.id
        }), fn(entry) {
            let detail = edsl::relation_detail(payload, entry.id);
            index_entry(target(edsl::KnowledgeKind::Relation, brief.id, entry.id), detail.label,
                array::concat([detail.aliases, labels(detail.localized)]), detail.summary)
        });
        let entity = match array::find(payload.entities, fn(entry) { entry.id == brief.id }) {
            Some(entry) => entry, None => fail!("knowledge dataset disappeared from prepared model", brief.id),
        };
        let metrics = array::map(entity.metrics, fn(metric) {
            index_entry(target(edsl::KnowledgeKind::Metric, brief.id, metric.id), metric.id, [], "")
        });
        let times = array::map(brief.time_roles, fn(role) {
            index_entry(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field), role.field, [], "")
        });
        let links = array::map(array::filter(payload.business_links, fn(link) {
            payload.entities[link.hub].id == brief.id
        }), fn(link) {
            index_entry(target(edsl::KnowledgeKind::BusinessLink, brief.id, link.id), link.id, [], "")
        });
        array::concat([fields, dimensions, measures, relations, metrics, times, links])
    });
    let docs = array::flat_map(payload.entities, fn(entity) {
        match property::get_type_prop(entity.entity_type, edsl::KnowledgeDocs.type) {
            Some(declared) => declared.entries, None => [],
        }
    });
    let entries = array::map(array::concat([index_entries(syntax_points).entries, roots, members]), fn(entry) {
        match array::find(docs, fn(note) { note.target == entry.key }) {
            Some(note) => {...entry, summary: note.text}, None => entry,
        }
    });
    let keys = dict::from_pairs(array::map(entries, fn(entry) { (target_key(entry.key), True) }));
    if array::length(dict::keys(keys)) != array::length(entries) {
        fail!("knowledge keys must identify exactly one visible node", entries)
    } else { {entries} }
};

def point_from_model: Fn(edsl::PreparedPayload, KnowledgeIndex, edsl::KnowledgeTarget) -> DocResult =
    fn(payload, index, key) {
        if !array::any(index.entries, fn(entry) { entry.key == key }) { DocResult::NotFound }
        else if key == target(edsl::KnowledgeKind::Index, "", "index") {
            match array::find(syntax_points, fn(item) { item.target == key }) {
                Some(item) => DocResult::Found({...item, entries: Some(index.entries),
                    refs: array::map(array::filter(index.entries, fn(entry) { entry.key != key }), fn(entry) { member(entry.key) })}),
                None => fail!("knowledge index point disappeared", key),
            }
        } else if key == target(edsl::KnowledgeKind::Terminology, "", "terminology") {
            match array::find(syntax_points, fn(item) { item.target == key }) {
                Some(item) => DocResult::Found(terminology_point(item,
                    visible_terms(payload, index.entries))),
                None => fail!("knowledge terminology point disappeared", key),
            }
        } else if key.kind == edsl::KnowledgeKind::Schema {
            match array::find(syntax_points, fn(item) { item.target == key }) {
                Some(item) => DocResult::Found(item),
                None => fail!("knowledge schema key has no point", key),
            }
        } else {
            let datasets = edsl::visible_knowledge_index(payload);
            let brief = match array::find(datasets, fn(entry) {
                if key.kind == edsl::KnowledgeKind::Dataset { entry.id == key.id }
                else if key.kind == edsl::KnowledgeKind::Value {
                    array::any(entry.dimension_ids, fn(name) { name == key.owner })
                } else { entry.id == key.owner }
            }) {
                Some(entry) => entry,
                None => fail!("knowledge key owner disappeared from prepared model", key),
            };
            let raw = if key.kind == edsl::KnowledgeKind::Dataset { dataset_point(payload, brief) }
            else { match array::find(dataset_members(payload, brief), fn(item) { item.target == key }) {
                Some(item) => item,
                None => fail!("knowledge key has no point in prepared model", key),
            } };
            let docs = array::flat_map(payload.entities, fn(entity) {
                match property::get_type_prop(entity.entity_type, edsl::KnowledgeDocs.type) {
                    Some(declared) => declared.entries, None => [],
                }
            });
            let related = array::flat_map(payload.entities, fn(entity) {
                match property::get_type_prop(entity.entity_type, edsl::KnowledgeRelations.type) {
                    Some(declared) => declared.entries, None => [],
                }
            });
            let refs = array::concat([raw.refs, array::map(array::filter(related, fn(ref) {
                ref.source == key && array::any(index.entries, fn(entry) { entry.key == ref.target })
            }), fn(ref) { {target: ref.target, kind: LinkKind::Related} })]);
            let summary = match array::find(docs, fn(note) { note.target == key }) {
                Some(note) => note.text, None => raw.summary,
            };
            DocResult::Found({...raw, refs, summary})
        }
    };

def by_target: Fn(edsl::PreparedPayload, edsl::KnowledgeTarget) -> DocResult = fn(payload, id) {
    point_from_model(payload, index_from_model(payload), id)
};

def knowledge_lookup_factory: Fn(edsl::PreparedPayload) -> Fn(edsl::KnowledgeTarget) -> DocResult = fn(payload) {
    let index = index_from_model(payload);
    fn(id) { point_from_model(payload, index, id) }
};

def decode_request: for(A: codec::Decode) Fn(Value, String) -> A = fn(value, contract) {
    match codec::decode@[A](value) {
        Ok(decoded) => decoded,
        Err(error) => raise!(blame::with_context(error,
            `see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", contract)}`)),
    }
};

def point_from_key: Fn(edsl::PreparedPayload, KnowledgeIndex, String) -> DocResult =
    fn(payload, index, key) {
        match array::find(index.entries, fn(entry) { target_key(entry.key) == key }) {
            Some(entry) => point_from_model(payload, index, entry.key),
            None => DocResult::NotFound,
        }
    };

# The caller binds a domain to its prepared model.
def serve_catalog: Fn(edsl::PreparedPayload, KnowledgeIndex, String, Value) -> KnowledgeResponse =
    fn(payload, index, domain, request) {
    if domain == "" { fail!("knowledge domain must not be empty") } else { () };
    let envelope = decode_request@[KnowledgeRequest](request, "syntax/knowledge/request");
    if envelope.method == `\{domain}/info` {
        let input = decode_request@[InfoInput](envelope.input, "syntax/knowledge/info");
        KnowledgeResponse::Document(point_from_key(payload, index, input.key))
    } else { fail!(`unknown knowledge method for domain; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/knowledge/request")}`, envelope.method, domain) }
};

def serve: Fn(edsl::PreparedPayload, String, Value) -> KnowledgeResponse = fn(payload, domain, request) {
    serve_catalog(payload, index_from_model(payload), domain, request)
};

def object_value: Fn(Array((String, Value))) -> Value = fn(fields) {
    Value::Object(dict::from_pairs(fields))
};

def public_entry: Fn(IndexEntry) -> Value = fn(entry) {
    object_value([
        ("key", Value::String(target_key(entry.key))),
        ("type", codec::encode(entry.key.kind)),
        ("description", object_value([
            ("label", Value::String(entry.label)),
            ("aliases", codec::encode(entry.aliases)),
            ("summary", Value::String(entry.summary)),
        ])),
    ])
};

def owned_detail: for(A: codec::Encode) Fn(String, A) -> Value = fn(dataset, detail) {
    match codec::encode(detail) {
        Value::Object(fields) => Value::Object(dict::merge(fields, {dataset: Value::String(dataset)})),
        other => fail!("Model knowledge detail must be a record", other),
    }
};

def node_value: Fn(Point) -> Value = fn(item) {
    let detail = match item.target.kind {
        edsl::KnowledgeKind::Index => object_value([("entries", codec::encode(array::map(
            match item.entries { Some(entries) => entries, None => [] }, public_entry)))]),
        edsl::KnowledgeKind::Terminology => object_value([("entries", codec::encode(array::map(
            match item.terminology { Some(entries) => entries, None => [] }, fn(entry) {
                object_value([
                    ("term", Value::String(entry.term)),
                    ("description", Value::String(entry.description)),
                    ("key", Value::String(target_key(entry.target))),
                ])
            })))]),
        edsl::KnowledgeKind::Dataset => codec::encode({id: item.target.id, grain: item.grain, time_roles: item.time_roles,
            references: item.references, field_roles: item.field_roles}.ty!(DatasetDetail)),
        edsl::KnowledgeKind::Field => codec::encode({id: item.target.id, dataset: item.target.owner, nullable: item.nullable, logical_type: item.logical_type, roles: item.roles,
            reference_ids: array::map(item.references, fn(ref) { ref.id })}.ty!(FieldDetail)),
        edsl::KnowledgeKind::Value => codec::encode({id: item.target.id, dimension: item.target.owner}.ty!(ValueDetail)),
        edsl::KnowledgeKind::Dimension => match item.dimension {
            Some(value) => codec::encode(value), None => object_value([]),
        },
        edsl::KnowledgeKind::Measure => match item.measure {
            Some(value) => codec::encode(value), None => object_value([]),
        },
        edsl::KnowledgeKind::Relation => match item.relation {
            Some(value) => codec::encode(value), None => object_value([]),
        },
        edsl::KnowledgeKind::Metric => match item.metric {
            Some(value) => owned_detail(item.target.owner, value), None => object_value([]),
        },
        edsl::KnowledgeKind::TimeRole => match item.time_role {
            Some(value) => owned_detail(item.target.owner, value), None => object_value([]),
        },
        edsl::KnowledgeKind::BusinessLink => codec::encode({id: item.target.id, hub: item.target.owner,
            direction: item.direction, guard: item.guard}.ty!(BusinessLinkDetail)),
        _ => object_value([]),
    };
    object_value([
        ("key", Value::String(target_key(item.target))),
        ("type", codec::encode(item.target.kind)),
        ("description", codec::encode({label: item.label, aliases: item.aliases, localized: item.localized, summary: item.summary}.ty!(Description))),
        ("links", codec::encode(array::map(item.refs, fn(ref) {
            object_value([("type", codec::encode(ref.kind)), ("key", Value::String(target_key(ref.target)))])
        }))),
        ("detail", detail),
    ])
};

def encode_response: Fn(KnowledgeResponse) -> Value = fn(response) {
    match response {
        KnowledgeResponse::Document(document) => match document {
            DocResult::Found(item) =>
                object_value([("Document", object_value([("Found", node_value(item))]))]),
            DocResult::NotFound => object_value([("Document", Value::String("NotFound"))]),
        },
    }
};

def serve_value: Fn(edsl::PreparedPayload, String, Value) -> Value = fn(payload, domain, request) {
    encode_response(serve(payload, domain, request))
};

def knowledge_service_factory: Fn(edsl::PreparedPayload, String) -> Fn(Value) -> Value =
    fn(payload, domain) {
        let index = index_from_model(payload);
        fn(request) { encode_response(serve_catalog(payload, index, domain, request)) }
    };

# The collection selects the slot; this handler receives only its input.
def knowledge_info_method_factory: Fn(edsl::PreparedPayload) -> Fn(Value) -> Value =
    fn(payload) {
        let index = index_from_model(payload);
        fn(input) {
            let request = decode_request@[InfoInput](input, "syntax/knowledge/info");
            encode_response(KnowledgeResponse::Document(point_from_key(payload,
                index, request.key)))
        }
    };

pub use self::{ LinkKind, KnowledgeLink, Point, IndexEntry, KnowledgeIndex, DocResult, KnowledgeResponse,
    Description, NodeLink, Node, NodeResult, NodeResponse, node_value,
    DatasetDetail, FieldDetail, ValueDetail, BusinessLinkDetail,
    map, index_entries, index_from_model, by_target, knowledge_lookup_factory, serve, serve_value,
    knowledge_service_factory, knowledge_info_method_factory };
