# Deliberately failing cases for scripts/test-model-diagnostics.py. The Host
# checks diagnostic subjects and rules; these are not expected-success tests.
use crate::ontology as edsl;
use crate::query as qb;
use crate::intent as intent;
use crate::sqlite as sqlite;
use std::codec as codec;
use std::value::{ Value };
use std::test as test;

@edsl::entity_source("orders", "o")
type DiagnosticOrder = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::dimension("OrderId", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Int])
    id: Int,
};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind],
    allowed_join_kinds: [], allowed_aggregates: [], allowed_scalars: [], allow_distinct: False,
};

def payload: edsl::PreparedPayload = edsl::build_root("diagnostics", [DiagnosticOrder.type], profile, fn(subject) { True });

pub def partition: test::Test = test::with_fixtures([
    "../fixtures/partition-zero.json", "../fixtures/partition-empty.json",
], fn(input) {
    test::should_ok(fn() { codec::decode@[edsl::PartitionRequest](input).unwrap!() })
});

def window_plan: Fn(Int, Bool) -> qb::Plan = fn(value, offset) {
    let source = qb::source_with_hint(qb::build_context(), "orders", "o");
    let bound = qb::page_bound(source.0, value);
    {
        revision: "diagnostic-window",
        sources: [source.1],
        projection: [qb::expr_item(qb::column(source.1, "id"))],
        filter: None, joins: [], grouping: [], ordering: [],
        limit: if offset { None } else { Some(bound.1) },
        offset: if offset { Some(bound.1) } else { None },
        exists: [], having: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    }
};

pub def limit: test::Test = test::with_fixtures(["../fixtures/negative-window.json"], fn(input) {
    test::should_ok(fn() { qb::validate_structure(window_plan(codec::decode@[Int](input).unwrap!(), False)) })
});

pub def offset: test::Test = test::with_fixtures(["../fixtures/negative-window.json"], fn(input) {
    test::should_ok(fn() { qb::validate_structure(window_plan(codec::decode@[Int](input).unwrap!(), True)) })
});

pub def missing_field: test::Test = test::with_fixtures(["../fixtures/missing-intent-field.json"], fn(input) {
    test::should_ok(fn() { intent::query_intent_lower_factory(payload, "analyst", sqlite::render_query_plan_with_context)(input) })
});

def duplicate_columns: Array(edsl::UnionColumnDecl) = [
    {field: 0, column: "id"},
    {field: 0, column: "name"},
];

def duplicate_branches: Array(edsl::UnionBranchDecl) = [
    {table: "items", alias: "i", columns: duplicate_columns, filter: None},
];

@edsl::union_source("u", duplicate_branches)
type DuplicateMapping = struct {
    @edsl::column("id")
    id: Int,
    @edsl::column("name")
    name: String,
};

pub def duplicate_mapping: test::Test = test::should_ok(fn() {
    edsl::knowledge_graph([DuplicateMapping.type])
});
