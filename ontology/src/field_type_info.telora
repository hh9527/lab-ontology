# 字段类型只展开内部结构；具名模型类型返回引用及覆盖检查所需的 Type。
use std::array as array;
use std::string as string;
use std::type_desc as td;
use std::type_memorizer as memo;
use crate::knowledge as k;

type Info = struct {
    text: String,
    references: Array(String)
};
type Projection = (Array(Type), Info);
type Memorizer = memo::TypeMemorizer(Projection);
def memorizer: Memorizer = memo::type_memorizer(compute);
def generate_field_type_info: Fn(Memorizer, Type) -> Projection = fn(m, ty) {
    memo::computed_with_type(m, ty)
};
def project: Fn(Type) -> Projection = fn(ty) {
    generate_field_type_info(memorizer, ty)
};
def combined: Fn(String, Array(Projection)) -> Projection = fn(text, children) {
    (
        array::flat_map(
            children,
            fn(c) {
                c.0
            }
        ),
        {
            text,
            references: array::flat_map(
                children,
                fn(c) {
                    c.1.references
                }
            )
        }.ty!(Info)
    )
};
def compute: Fn(Type) -> Projection = fn(ty) {
    if ty == Int.type {
        ([], {text: "Int", references: []}.ty!(Info))
    } else if ty == Float.type {
        ([], {text: "Float", references: []}.ty!(Info))
    } else if ty == Bool.type {
        ([], {text: "Bool", references: []}.ty!(Info))
    } else if ty == String.type {
        ([], {text: "String", references: []}.ty!(Info))
    } else if td::name(ty) != None {
        let address = k::type_ref(ty);
        ([ty], {text: address, references: [address]}.ty!(Info))
    } else {
        let kind = td::kind(ty);
        if kind == td::TypeDescKind::Struct {
            let fields = td::fields(ty);
            let children = array::map(
                fields,
                fn(f) {
                    project(f.ty)
                }
            );
            combined(
                `{\{string::join(array::map(array::enumerate(fields), fn(p) {
                `\{p.1.name}: \{children[p.0].1.text}`
            }), ", ")}}`,
                children
            )
        } else if kind == td::TypeDescKind::Enum && !k::inline_type(ty) {
            let variants = td::variants(ty);
            let children = array::flat_map(
                variants,
                fn(v) {
                    match v.payload {
                        Some(p) => [project(p)],
                        None => []
                    }
                }
            );
            combined(
                `Enum{\{string::join(array::map(variants, fn(v) { match v.payload {
                Some(p) => `\{v.name}(\{project(p).1.text})`, None => v.name,
            } }), ", ")}}`,
                children
            )
        } else {
            let children = array::map(td::children(ty), project);
            let name = match kind {
                td::TypeDescKind::Array => "Array",
                td::TypeDescKind::Dict => "Dict",
                td::TypeDescKind::Enum => "Option",
                td::TypeDescKind::Tuple => "Tuple",
                td::TypeDescKind::Newtype => "Newtype",
                td::TypeDescKind::Bytes => "Bytes",
                td::TypeDescKind::Never => "Never",
                td::TypeDescKind::Type => "Type",
                td::TypeDescKind::TypeOf => "TypeOf",
                td::TypeDescKind::Func => "Fn",
                _ => fail!("unsupported anonymous field type", ty),
            };
            combined(
                if children == [] {
                    name
                } else {
                    `\{name}(\{string::join(array::map(children, fn(c) { c.1.text }), ", ")})`
                },
                children
            )
        }
    }
};
pub use self::{Info, Projection, Memorizer, memorizer, generate_field_type_info};
