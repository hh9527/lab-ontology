# A/Z are physical positions; only links declared bidirectional support
# exchangeable peer traversal. Endpoint relations cover both link directions.
@edsl::entity_id("physical_link")
@edsl::entity_source("EnterprisePhysicalLink", "pl")
@edsl::native_pair("link_ne_names", "physical_link_a_ne_name", "physical_link_z_ne_name")
@edsl::guarded_business_link("physical_link_peer_device", "physical_link_a_device", "physical_link_z_device", edsl::LinkDirection::Undirected,
    {field: "direction", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("bidirectional")})
@edsl::guarded_business_link("physical_link_downstream_device", "physical_link_a_device", "physical_link_z_device", edsl::LinkDirection::Directed,
    {field: "direction", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("unidirectional")})
@edsl::dataset_description("Physical link", "Physical connection with fixed A and Z device endpoints")
@edsl::relation_description("physical_link_a_device", "A-end device", "Origin endpoint of the physical link")
@edsl::relation_description("physical_link_z_device", "Z-end device", "Peer endpoint of the physical link")
@edsl::relation_description("physical_link_attached_device", "Attached device", "Undirected physical-link participation through either complete A or Z device identity")
@edsl::relation_description("physical_link_attached_server", "Attached server", "Physical-link A or Z endpoint references the complete server identity")
@edsl::relation_description("physical_link_belongs_to_tenant", "Belongs to tenant", "Physical link tenant ownership")
@edsl::named_typed_relation_or_key("physical_link_attached_server", PhysicalLink.type, ServerDevice.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}, [
    [edsl::typed_relation_pair(edsl::model_field(PhysicalLink.type, String.type, "a_ne_res_id"), edsl::model_field(ServerDevice.type, String.type, "id"))],
    [edsl::typed_relation_pair(edsl::model_field(PhysicalLink.type, String.type, "z_ne_res_id"), edsl::model_field(ServerDevice.type, String.type, "id"))],
])
@edsl::named_typed_relation_or_key("physical_link_attached_device", PhysicalLink.type, Device.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}, [
    [edsl::typed_relation_pair(edsl::model_field(PhysicalLink.type, String.type, "a_ne_res_id"), edsl::model_field(Device.type, String.type, "id"))],
    [edsl::typed_relation_pair(edsl::model_field(PhysicalLink.type, String.type, "z_ne_res_id"), edsl::model_field(Device.type, String.type, "id"))],
])
@edsl::named_relation_key("physical_link_belongs_to_tenant", Tenant.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "tenant_id", to: "id"}))
@edsl::named_relation_key("physical_link_a_device", Device.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "a_ne_res_id", to: "id"}))
@edsl::named_relation_key("physical_link_z_device", Device.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "z_ne_res_id", to: "id"}))
type PhysicalLink = struct {
    @edsl::column("aNeResId")
    a_ne_res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("aNeName")
    @edsl::dimension("physical_link_a_ne_name", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("physical_link_a_ne_name", "A-End NE", "NE at end A, which is the name of the NE at the source end. Raw text search, not semantic ordering or identifier normalization.")
    a_ne_name: String,
    @edsl::column("zNeName")
    @edsl::dimension("physical_link_z_ne_name", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("physical_link_z_ne_name", "Z-End NE", "NE at end Z, which is the name of the NE at the destination end. Raw text search, not semantic ordering or identifier normalization.")
    z_ne_name: String,
    @edsl::column("id")
    @edsl::key()
    @edsl::dimension("physical_link_id", True, True, text_ops, text_inputs)
    @edsl::measure("physical_link_count", qb::AggregateFunction::Count, [])
    id: String,
    @edsl::column("name")
    @edsl::dimension("physical_link_name", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("physical_link_name", "Link Name", "Unique name of a network link. Raw text search, not semantic ordering or identifier normalization.")
    name: String,
    @edsl::column("linkType")
    @edsl::dimension("physical_link_type", True, True, canonical_eq_ne_ops, text_inputs)
    @edsl::canonical_values(array::concat([link_type_values, [
        {id: "wire_1_8d618873", label: "LLDP", wires: [edsl::FilterInput::Int(1)]},
        {id: "wire_2_d0a68914", label: "SBS", wires: [edsl::FilterInput::Int(2)]},
