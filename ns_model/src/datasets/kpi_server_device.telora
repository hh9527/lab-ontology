    @samples::field(samples::group("kpi-server-device/system_power", metric::KpiServerDeviceSystemPower.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("W")), [{statistic: samples::Statistic::Mean, publish: "sede_system_power"}, {statistic: samples::Statistic::Max, publish: "sede_system_power_max"}, {statistic: samples::Statistic::Min, publish: "sede_system_power_min"}])
    system_power: Option(metric::KpiServerDeviceSystemPower),
