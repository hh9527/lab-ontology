use crate::semantic as s;
use crate::preparation as preparation;
use crate::ontology as edsl;
use std::test;

@s::dataset("duplicate", "duplicate", [])
type DuplicateRole = struct {
    @edsl::field_role(edsl::FieldRole::Appellation)
    @edsl::field_role(edsl::FieldRole::Appellation)
    value: String
};
pub def duplicate_roles_are_rejected: test::Test = test::should_fail_with(
    fn() {
        preparation::prepare(DuplicateRole.type)
    },
    "duplicate field role"
);
@s::dataset("reference", "reference", [])
type DirectReferenceRole = struct {
    @edsl::field_role(edsl::FieldRole::Reference)
    value: String
};
pub def reference_requires_a_complete_identity: test::Test = test::should_fail_with(
    fn() {
        preparation::prepare(DirectReferenceRole.type)
    },
    "Reference role"
);
