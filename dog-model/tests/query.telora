def test_top_two_hop_related_aggregate = do {
    let intent = json.parse(r#"{
        "op": "top", "measures": [],
        "dimensions": ["BreedName"],
        "filters": [], "ordering": [{"target": "Measure", "id": "TreatmentCount", "direction": "Desc"}],
        "exists": [], "having": [], "limit": 1, "offset": null
    }"#) |> result.unwrap;
    check_sql("top-two-hop-related-aggregate", intent,
        "SELECT br.breed_name FROM Breeds AS br INNER JOIN Dogs AS dg ON br.breed_code = dg.breed_code INNER JOIN Treatments AS tr ON dg.dog_id = tr.dog_id GROUP BY br.breed_name ORDER BY count(tr.treatment_id) DESC LIMIT ?")
