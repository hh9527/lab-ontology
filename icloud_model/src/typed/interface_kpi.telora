use super::metric_values as metric;
use ontology::quantity as statistic_quantity;
use ontology::quantity as presentation;
use ontology::semantic as domain;
# 接口样本独立声明，保留复合采样grain与所有统计能力
use super::inventory as i;
use super::port as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::quantity::{PacketsPerSecond};
use ontology::quantity::{Percent};
@presentation::calculations(
    [
        presentation::Calculation::Compare,
        presentation::Calculation::Mean,
        presentation::Calculation::Min,
        presentation::Calculation::Max,
        presentation::Calculation::Round
    ]
)
type ReportedOctetsRate = struct(Float);
@domain::bind(p::PortById.type, "res_id")
@r::sources("interface_kpi_of_port", ["source_EnterpriseNetworkLTP_NetworkDeviceInterfaceKPI"])
@domain::dataset("interface_kpi", "NetworkDeviceInterfaceKPI", ["res_id", "tenant_id", "ts"])
@domain::metric("ts")
@domain::relations(relations)
type NetworkDeviceInterfaceKPI = struct {
    @m::column("resId")
    @g::exact("interface_kpi_res_id")
    res_id: domain::Reference(p::PortById),
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @g::view("interface_kpi_ts_raw", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("interface_kpi_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("interface_kpi_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("interface_kpi_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("interface_kpi_sample_count")
    @edsl::field_role(edsl::FieldRole::Classification)
    ts: s::DateTimeUtc,
    @m::column("ifOutPktSpeed")
    @g::view("interface_tx_sample", True, g::numeric_filters)
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_tx"}]
    )
    @samples::valid_count("source_ifOutPktSpeedEffcnt")
    @domain::count("interface_tx_observation_count")
    tx_speed: PacketsPerSecond,
    @m::column("ifOutErrors")
    @g::view("interface_out_errors_sample", True, g::numeric_filters)
    @g::statistics(
        g::numeric_group(
            "interface_out_errors",
            metric::TransmittedErrorPackets.type,
            [g::Statistic::Mean]
        ),
        [{member: g::Statistic::Mean, publish: "interface_out_errors"}]
    )
    @samples::valid_count("source_ifOutErrorsEffcnt")
    @domain::count("interface_out_errors_observation_count")
    out_errors: metric::TransmittedErrorPackets,
    @m::column("parentId")
    @g::exact("interface_kpi__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("interface_kpi__projectId")
    source_projectId: String,
    @m::column("interfaceName")
    @g::search("interface_kpi__interfaceName")
    @domain::attribute("source_interfaceName")
    source_interfaceName: String,
    @m::column("ifInBandRate")
    @g::view("interface_kpi__ifInBandRate", True, g::numeric_filters)
    @samples::field(
        metric::InboundBandwidthUtilization_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "interface_in_band_usage_avg"},
            {statistic: samples::Statistic::Max, publish: "interface_in_band_usage_max"},
            {statistic: samples::Statistic::Min, publish: "interface_in_band_usage_min"}
        ]
    )
    @samples::valid_count("source_ifInBandRateEffcnt")
    @domain::count("interface_in_band_usage_avg_observation_count")
    source_ifInBandRate: metric::InboundBandwidthUtilization,
    @m::column("ifOutBandRate")
    @g::view("interface_kpi__ifOutBandRate", True, g::numeric_filters)
    @samples::field(
        metric::OutboundBandwidthUtilization_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "interface_out_band_usage_avg"},
            {statistic: samples::Statistic::Max, publish: "interface_out_band_usage_max"},
            {statistic: samples::Statistic::Min, publish: "interface_out_band_usage_min"}
        ]
    )
    @samples::valid_count("source_ifOutBandRateEffcnt")
    @domain::count("interface_out_band_usage_avg_observation_count")
    source_ifOutBandRate: metric::OutboundBandwidthUtilization,
    @m::column("ifHCInOctetsSpeed")
    @g::view("interface_kpi__ifHCInOctetsSpeed", True, g::numeric_filters)
    @samples::field(
        octet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_rx_rate"}]
    )
    @samples::valid_count("source_ifHCInOctetsSpeedEffcnt")
    @domain::count("interface_rx_rate_observation_count")
    source_ifHCInOctetsSpeed: ReportedOctetsRate,
    @m::column("ifHCOutOctetsSpeed")
    @g::view("interface_kpi__ifHCOutOctetsSpeed", True, g::numeric_filters)
    @samples::field(
        octet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_tx_rate"}]
    )
    @samples::valid_count("source_ifHCOutOctetsSpeedEffcnt")
    @domain::count("interface_tx_rate_observation_count")
    source_ifHCOutOctetsSpeed: ReportedOctetsRate,
    @m::column("ifInPktSpeed")
    @g::view("interface_kpi__ifInPktSpeed", True, g::numeric_filters)
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_rx"}]
    )
    @samples::valid_count("source_ifInPktSpeedEffcnt")
    @domain::count("interface_rx_observation_count")
    source_ifInPktSpeed: PacketsPerSecond,
    @m::column("ifHCInMulticastPktsSpeed")
    @g::view("interface_kpi__ifHCInMulticastPktsSpeed", True, g::numeric_filters)
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_multicast_rx"}]
    )
    @samples::valid_count("source_ifHCInMulticastPktsSpeedEffcnt")
    @domain::count("interface_multicast_rx_observation_count")
    source_ifHCInMulticastPktsSpeed: PacketsPerSecond,
    @m::column("ifHCOutMulticastPktsSpeed")
    @g::view("interface_kpi__ifHCOutMulticastPktsSpeed", True, g::numeric_filters)
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_multicast_tx"}]
    )
    @samples::valid_count("source_ifHCOutMulticastPktsSpeedEffcnt")
    @domain::count("interface_multicast_tx_observation_count")
    source_ifHCOutMulticastPktsSpeed: PacketsPerSecond,
    @m::column("ifHCInBroadtPktSpeed")
    @g::view("interface_kpi__ifHCInBroadtPktSpeed", True, g::numeric_filters)
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_broadcast_rx"}]
    )
    @samples::valid_count("source_ifHCInBroadtPktSpeedEffcnt")
    @domain::count("interface_broadcast_rx_observation_count")
    source_ifHCInBroadtPktSpeed: PacketsPerSecond,
    @m::column("ifHCOutBroadPktSpeed")
    @g::view("interface_kpi__ifHCOutBroadPktSpeed", True, g::numeric_filters)
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_broadcast_tx"}]
    )
    @samples::valid_count("source_ifHCOutBroadPktSpeedEffcnt")
    @domain::count("interface_broadcast_tx_observation_count")
    source_ifHCOutBroadPktSpeed: PacketsPerSecond,
    @m::column("ifInErrors")
    @g::view("interface_kpi__ifInErrors", True, g::numeric_filters)
    @samples::field(
        metric::ReceivedErrorPackets_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_in_errors"}]
    )
    @samples::valid_count("source_ifInErrorsEffcnt")
    @domain::count("interface_in_errors_observation_count")
    source_ifInErrors: metric::ReceivedErrorPackets,
    @m::column("ifInBandRateEffcnt")
    @g::view("interface_kpi__ifInBandRateEffcnt", True, g::numeric_filters)
    source_ifInBandRateEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifOutBandRateEffcnt")
    @g::view("interface_kpi__ifOutBandRateEffcnt", True, g::numeric_filters)
    source_ifOutBandRateEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifHCInOctetsSpeedEffcnt")
    @g::view("interface_kpi__ifHCInOctetsSpeedEffcnt", True, g::numeric_filters)
    source_ifHCInOctetsSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifHCOutOctetsSpeedEffcnt")
    @g::view("interface_kpi__ifHCOutOctetsSpeedEffcnt", True, g::numeric_filters)
    source_ifHCOutOctetsSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifOutPktSpeedEffcnt")
    @g::view("interface_kpi__ifOutPktSpeedEffcnt", True, g::numeric_filters)
    source_ifOutPktSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifInPktSpeedEffcnt")
    @g::view("interface_kpi__ifInPktSpeedEffcnt", True, g::numeric_filters)
    source_ifInPktSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifHCInMulticastPktsSpeedEffcnt")
    @g::view("interface_kpi__ifHCInMulticastPktsSpeedEffcnt", True, g::numeric_filters)
    source_ifHCInMulticastPktsSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifHCOutMulticastPktsSpeedEffcnt")
    @g::view("interface_kpi__ifHCOutMulticastPktsSpeedEffcnt", True, g::numeric_filters)
    source_ifHCOutMulticastPktsSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifHCInBroadtPktSpeedEffcnt")
    @g::view("interface_kpi__ifHCInBroadtPktSpeedEffcnt", True, g::numeric_filters)
    source_ifHCInBroadtPktSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifHCOutBroadPktSpeedEffcnt")
    @g::view("interface_kpi__ifHCOutBroadPktSpeedEffcnt", True, g::numeric_filters)
    source_ifHCOutBroadPktSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifOutErrorsEffcnt")
    @g::view("interface_kpi__ifOutErrorsEffcnt", True, g::numeric_filters)
    source_ifOutErrorsEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifInErrorsEffcnt")
    @g::view("interface_kpi__ifInErrorsEffcnt", True, g::numeric_filters)
    source_ifInErrorsEffcnt: statistic_quantity::EffectiveCount,
};
def port: r::Endpoint = domain::endpoint(NetworkDeviceInterfaceKPI.type, "res_id");
def packet_statistics: samples::Group(PacketsPerSecond) = samples::group(
    "packet_statistics",
    PacketsPerSecond.type,
    samples::Statistic::Mean,
    [],
    Some("packets/s")
);
def octet_statistics: samples::Group(ReportedOctetsRate) = samples::group(
    "octet_statistics",
    ReportedOctetsRate.type,
    samples::Statistic::Mean,
    [],
    None
);
def relations: Array(r::Relation) = [
    r::relation(
        "interface_kpi_of_port",
        port,
        p::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{NetworkDeviceInterfaceKPI};
