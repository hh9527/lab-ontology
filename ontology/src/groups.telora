};

def prepare_facts: Fn(model::PreparedDataset, Array(BindingFacts)) -> Array(Member) = fn(
    dataset,
    bindings
) {
    array::flat_map(
        bindings,
        fn(binding) {
            binding.members
        }
    )
};
