use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::storage_bond_port;
use crate::datasets::kpi_storage_enterprise_bond_port;
@domain::subject("StorageBondPort", "obj_sys_id")
@domain::dataset("enterprise-bond-port-2-kpi", "enterpriseBondPort2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseBondPort2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-bond-port-2-kpi/obj_sys_id", ids::EnterpriseBondPort2KpiByObjSysId.type, True, [g::Filter::Eq]), "ebp2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("ebp2_count")
    obj_sys_id: ids::EnterpriseBondPort2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-bond-port-2-kpi/obj_id", domain::Reference(ids::EnterpriseBondPort2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "ebp2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseBondPort2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("ebp2__sbp", domain::endpoint(EnterpriseBondPort2Kpi.type, "obj_sys_id"), domain::endpoint(storage_bond_port::StorageBondPort.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ebp2__sebp", domain::endpoint(EnterpriseBondPort2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_bond_port::KpiStorageEnterpriseBondPort.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
