# Deliberately failing cases for scripts/test-model-diagnostics.py. The Host
# checks diagnostic subjects and rules; these are not expected-success tests.
import "@src/ontology" as edsl;
import "@src/query" as qb;
import "@src/intent" as intent;
import "@test/test_knowledge" { payload };
import "std/codec" as codec;
import "std/value" { Value };
import "std/test" as test;

export def partition: test.Test = test.with_fixtures([
    "../fixtures/partition-zero.json", "../fixtures/partition-empty.json",
], fn(input) {
    test.should_ok(fn() { codec.decode@[edsl.PartitionRequest](input).unwrap!() })
});

def window_plan: Fn(Int, Bool) -> qb.Plan = fn(value, offset) {
    {
        revision: "diagnostic-window",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "id"))],
        filter: None, joins: [], grouping: [], ordering: [],
        limit: if offset { None } else { Some(value) },
        offset: if offset { Some(value) } else { None },
        exists: [], having: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    }
};

export def limit: test.Test = test.with_fixtures(["../fixtures/negative-window.json"], fn(input) {
    test.should_ok(fn() { qb.validate_structure(window_plan(codec.decode@[Int](input).unwrap!(), False)) })
});

export def offset: test.Test = test.with_fixtures(["../fixtures/negative-window.json"], fn(input) {
    test.should_ok(fn() { qb.validate_structure(window_plan(codec.decode@[Int](input).unwrap!(), True)) })
});

export def missing_field: test.Test = test.with_fixtures(["../fixtures/missing-intent-field.json"], fn(input) {
    test.should_ok(fn() { intent.query_intent_lower_factory(payload, "analyst")(input) })
});

def duplicate_columns: Array(edsl.UnionColumnDecl) = [
    {field: 0, column: "id"},
    {field: 0, column: "name"},
];

def duplicate_branches: Array(edsl.UnionBranchDecl) = [
    {table: "items", alias: "i", columns: duplicate_columns, filter: None},
];

@edsl.union_source("u", duplicate_branches)
type DuplicateMapping = struct {
    @edsl.column("id")
    id: Int,
    @edsl.column("name")
    name: String,
};

export def duplicate_mapping: test.Test = test.should_ok(fn() {
    edsl.knowledge_graph([DuplicateMapping.type])
});
