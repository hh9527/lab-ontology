pub def physical_link_endpoints_are_distinct_named_relations: test::Test = test::should_ok(fn() {
    let prefix = `{"op":"exists_via","measures":[],"dimensions":["physical_link_id"],"filters":[],"ordering":[],"exists":[{"relation":"`;
    let suffix = `","target":"device","filters":[],"min_matches":null}],"limit":null,"offset":null}`;
    let a = lower_json(`\{prefix}physical_link_a_device\{suffix}`);
    let z = lower_json(`\{prefix}physical_link_z_device\{suffix}`);
    let known = edsl::dataset_relations(payload, "physical_link");
    let a_rel = edsl::relation_domain(payload, "physical_link_a_device");
    if array::length(known) == 2
        && a_rel.id == "physical_link_a_device"
        && array::length(string::split(a.sql, "pl.a_ne_res_id = d.id")) > 1
        && array::length(string::split(a.sql, "pl.z_ne_res_id")) == 1
        && array::length(string::split(z.sql, "pl.z_ne_res_id = d.id")) > 1
        && array::length(string::split(z.sql, "pl.a_ne_res_id")) == 1 {
        True
    } else {
        fail!("explicit relation must select exactly one endpoint", a.sql, z.sql)
    }
});

