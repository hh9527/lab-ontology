@edsl::entity_id("onu_kpi")
@edsl::entity_source("PonDeviceOnuKPI", "ok")
@edsl::dataset(edsl::DatasetKind::Metric, ["res_id", "tenant_id", "ts"], Some("ts"))
@edsl::dataset_description("ONU KPI samples", "UTC-sampled ONU receive-bandwidth utilization")
@edsl::relation_description("onu_kpi_of_pon_device", "Samples for ONU", "IC data link matches PonDevice.id to MetricOnu.res_id")
@edsl::named_relation_key("onu_kpi_of_pon_device", PonDevice.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0},
    edsl::DeclaredRelationKey::FieldEq({from: "res_id", to: "id"}))
@edsl::relation_description("onu_kpi_of_onu_role", "Samples for ONU child", "The same published resource ID addresses the ONU role scoped from PonDevice")
@edsl::named_relation_key("onu_kpi_of_onu_role", PonOnuRole.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0},
    edsl::DeclaredRelationKey::FieldEq({from: "res_id", to: "id"}))
type OnuKpi = struct {
    @edsl::column("resId")
    @edsl::key()
    res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("onu_kpi_ts", True, True, utc_window_ops, datetime_utc_inputs)
    ts: String,
    @edsl::column("ifInBandRate")
    @edsl::dimension("onu_receive_usage_sample", True, True, int_ops, number_inputs)
    @edsl::dimension_description("onu_receive_usage_sample", "ONU receive bandwidth utilization sample", "Source-reported receive bandwidth utilization of an ONU, in the existing percent metric scale; not device port occupancy or PON-port receive utilization.")
    @edsl::dimension_alias("onu_receive_usage_sample", "ONU接收带宽利用率")
    @edsl::measure("onu_receive_usage", qb::AggregateFunction::Avg, [])
    @edsl::metric_value("onu_receive_usage", qb::AggregateFunction::Avg, Some("%"))
    @edsl::sample_aggregate("onu_receive_usage_max", qb::AggregateFunction::Max, Some("%"))
    @edsl::sample_aggregate("onu_receive_usage_min", qb::AggregateFunction::Min, Some("%"))
