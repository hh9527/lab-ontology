# world-model/tests/query.telora
#
# Contract tests for the world_1 resolver over the ontology shared closed Intent
# protocol bound to the prepared model payload
# (`ontology/intent::query_intent_lower_factory`).  Intents use only stable
# world measure / dimension / entity ids; lowering is fully owned by ontology.
#
# Coverage: supported shapes (list / count / aggregate / top / distinct /
# exists / absence / set / compare / hidden having), exact parameterized SQL,
# binding order, repeated-lowering determinism, and structural rejection probes.

use crate::model::{ payload };
use std::test as test;
use ontology::intent as intent;
use ontology::query as qb;
use std::json as json;
use std::array as array;

pub def lowering_rejects_non_object_case: test::Test = test::should_fail_with(fn() {
    lower_text("7")
}, "intent field is not an object");

def lower_text: Fn(String) -> qb::Query = fn(text) {
    let lower = intent::query_intent_lower_factory(payload, "public");
    lower(json::parse(text).unwrap!())
};

def intent_ok_text: Fn(String) -> Bool = fn(text) {
    match json::parse(text) {
        Ok(value) => intent::query_intent_ok(payload, "public", value),
        Err(_) => False,
    }
};

def binding_count: Fn(qb::Query) -> Int = fn(q) {
    array::length(q.bindings)
};

def list_json: String = `{"op":"list","measures":[],"dimensions":["country_name"],"filters":[{"dimension":"country_continent","op":"eq","kind":"text","value":"Asia"}],"ordering":[],"limit":null,"offset":null,"output_order":[]}`;

def list_hidden_order_json: String = `{"op":"list","measures":[],"dimensions":["country_name"],"filters":[],"ordering":[{"target":"Dimension","id":"country_population","direction":"Desc"}],"limit":3,"offset":null,"output_order":[]}`;

def list_explicit_order_json: String = `{"op":"list","measures":[],"dimensions":["country_name","country_code"],"filters":[],"ordering":[],"limit":null,"offset":null,"output_order":["country_code","country_name"]}`;

def count_json: String = `{"op":"count","measures":["country_count"],"dimensions":[],"filters":[{"dimension":"country_continent","op":"eq","kind":"text","value":"Asia"}],"ordering":[],"limit":null,"offset":null}`;

def aggregate_having_json: String = `{"op":"aggregate","measures":["country_count"],"dimensions":["country_region"],"filters":[],"ordering":[],"limit":null,"offset":null,"having":[{"measure":"country_count","op":"ge","kind":"int","value":10}]}`;

def aggregate_ordered_json: String = `{"op":"aggregate","measures":["country_population_sum"],"dimensions":["country_region"],"filters":[],"ordering":[{"target":"Dimension","id":"country_region","direction":"Asc"}],"limit":null,"offset":null}`;

def aggregate_hidden_having_json: String = `{"op":"aggregate","measures":["country_count"],"dimensions":["country_region"],"filters":[],"ordering":[],"limit":null,"offset":null,"hidden_having":[{"measure":"country_population_sum","op":"ge","kind":"int","value":100000000}]}`;

def top_json: String = `{"op":"top","measures":[],"dimensions":["country_region"],"filters":[],"ordering":[{"target":"Measure","id":"country_count","direction":"Desc"}],"limit":3,"offset":null}`;

def distinct_json: String = `{"op":"distinct","measures":[],"dimensions":["country_region"],"filters":[],"ordering":[],"limit":null,"offset":null}`;

def exists_count_json: String = `{"op":"exists","measures":["country_count"],"dimensions":[],"filters":[],"ordering":[],"limit":null,"offset":null,"exists":[{"target":"city","filters":[]}]}`;

def absence_row_json: String = `{"op":"absence","measures":[],"dimensions":["country_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"exists":[{"target":"country_language","filters":[{"dimension":"language_name","op":"eq","kind":"text","value":"English"}]}]}`;

def set_intersect_json: String = `{"op":"set","kind":"intersect","branches":[{"shape":"row","measures":[],"dimensions":["country_name"],"filters":[{"dimension":"country_continent","op":"eq","kind":"text","value":"Asia"}],"ordering":[],"limit":null,"offset":null},{"shape":"row","measures":[],"dimensions":["country_name"],"filters":[{"dimension":"country_region","op":"eq","kind":"text","value":"X"}],"ordering":[],"limit":null,"offset":null}]}`;

def compare_json: String = `{"op":"compare","measures":[],"dimensions":["country_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"comparisons":[{"attribute":"country_life_expectancy","op":"gt","measure":"country_life_expectancy_avg","scope":[]}]}`;

def compare_scoped_json: String = `{"op":"compare","measures":[],"dimensions":["country_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"comparisons":[{"attribute":"country_life_expectancy","op":"gt","measure":"country_life_expectancy_avg","scope":[{"dimension":"country_continent","op":"eq","kind":"text","value":"Africa"}]}]}`;

# structural rejection fixtures (query_intent_ok == False)
def unknown_op_json: String = `{"op":"pivot","measures":[],"dimensions":[],"filters":[],"ordering":[]}`;
def bad_set_kind_json: String = `{"op":"set","kind":"merge","branches":[{"shape":"row","measures":[],"dimensions":["country_name"],"filters":[],"ordering":[],"limit":null,"offset":null},{"shape":"row","measures":[],"dimensions":["country_name"],"filters":[],"ordering":[],"limit":null,"offset":null}]}`;
def single_branch_set_json: String = `{"op":"set","kind":"intersect","branches":[{"shape":"row","measures":[],"dimensions":["country_name"],"filters":[],"ordering":[],"limit":null,"offset":null}]}`;
def missing_fields_json: String = `{"op":"list","dimensions":["country_name"]}`;
def field_filter_on_count_json: String = `{"op":"count","measures":["country_count"],"dimensions":[],"filters":[{"left":"country_name","op":"eq","right":"country_code"}],"ordering":[],"limit":null,"offset":null}`;
def non_object_intent_json: String = `"count"`;

# --- positive exact SQL -----------------------------------------------------

def test_list_filtered: Fn() -> Bool = fn() {
    let q = lower_text(list_json);
    let ok_exact = q.sql == `SELECT c.Name FROM country AS c WHERE c.Continent = ?`;
    let ok_binds = binding_count(q) == 1;
    let b0 = match q.bindings[0] { qb::Val::String(s) => s == "Asia", _ => False };
    if ok_exact && ok_binds && b0 { True } else { fail!("list filtered sql differs") }
};

def test_list_hidden_order: Fn() -> Bool = fn() {
    let q = lower_text(list_hidden_order_json);
    let ok_exact = q.sql == `SELECT c.Name FROM country AS c ORDER BY c.Population DESC LIMIT ?`;
    let ok_binds = binding_count(q) == 1;
    let b0 = match q.bindings[0] { qb::Val::Int(n) => n == 3, _ => False };
    if ok_exact && ok_binds && b0 { True } else { fail!("list hidden order sql differs") }
};

def test_list_explicit_order: Fn() -> Bool = fn() {
    let q = lower_text(list_explicit_order_json);
    let ok_exact = q.sql == `SELECT c.Code, c.Name FROM country AS c`;
    let ok_binds = binding_count(q) == 0;
    if ok_exact && ok_binds { True } else { fail!("list explicit output_order sql differs") }
};

def test_count_filtered: Fn() -> Bool = fn() {
    let q = lower_text(count_json);
    let ok_exact = q.sql == `SELECT count(c.Code) AS country_count FROM country AS c WHERE c.Continent = ?`;
    let ok_binds = binding_count(q) == 1;
    let b0 = match q.bindings[0] { qb::Val::String(s) => s == "Asia", _ => False };
    if ok_exact && ok_binds && b0 { True } else { fail!("count filtered sql differs") }
};

def test_aggregate_having: Fn() -> Bool = fn() {
    let q = lower_text(aggregate_having_json);
    let ok_exact = q.sql == `SELECT count(c.Code) AS country_count, c.Region FROM country AS c GROUP BY c.Region HAVING count(c.Code) >= ?`;
    let ok_binds = binding_count(q) == 1;
    let b0 = match q.bindings[0] { qb::Val::Int(n) => n == 10, _ => False };
    if ok_exact && ok_binds && b0 { True } else { fail!("aggregate having sql differs") }
};

def test_aggregate_ordered: Fn() -> Bool = fn() {
    let q = lower_text(aggregate_ordered_json);
    let ok_exact = q.sql == `SELECT sum(c.Population) AS country_population_sum, c.Region FROM country AS c GROUP BY c.Region ORDER BY c.Region ASC`;
    let ok_binds = binding_count(q) == 0;
    if ok_exact && ok_binds { True } else { fail!("aggregate ordered sql differs") }
};

def test_aggregate_hidden_having: Fn() -> Bool = fn() {
    let q = lower_text(aggregate_hidden_having_json);
    let ok_exact = q.sql == `SELECT count(c.Code) AS country_count, c.Region FROM country AS c GROUP BY c.Region HAVING sum(c.Population) >= ?`;
    let ok_binds = binding_count(q) == 1;
    let b0 = match q.bindings[0] { qb::Val::Int(n) => n == 100000000, _ => False };
    if ok_exact && ok_binds && b0 { True } else { fail!("aggregate hidden having sql differs") }
};

def test_top: Fn() -> Bool = fn() {
    let q = lower_text(top_json);
    let ok_exact = q.sql == `SELECT c.Region FROM country AS c GROUP BY c.Region ORDER BY count(c.Code) DESC LIMIT ?`;
    let ok_binds = binding_count(q) == 1;
    let b0 = match q.bindings[0] { qb::Val::Int(n) => n == 3, _ => False };
    if ok_exact && ok_binds && b0 { True } else { fail!("top sql differs") }
};

def test_distinct: Fn() -> Bool = fn() {
    let q = lower_text(distinct_json);
    let ok_exact = q.sql == `SELECT DISTINCT c.Region FROM country AS c`;
    let ok_binds = binding_count(q) == 0;
    if ok_exact && ok_binds { True } else { fail!("distinct sql differs") }
};

def test_exists_count: Fn() -> Bool = fn() {
    let q = lower_text(exists_count_json);
    let ok_exact = q.sql == `SELECT count(c.Code) AS country_count FROM country AS c WHERE EXISTS (SELECT 1 FROM city AS ct WHERE c.Code = ct.CountryCode)`;
    let ok_binds = binding_count(q) == 0;
    if ok_exact && ok_binds { True } else { fail!("exists count sql differs") }
};

def test_absence_row: Fn() -> Bool = fn() {
    let q = lower_text(absence_row_json);
    let ok_exact = q.sql == `SELECT c.Name FROM country AS c WHERE NOT EXISTS (SELECT 1 FROM countrylanguage AS cl WHERE c.Code = cl.CountryCode AND cl.Language = ?)`;
    let ok_binds = binding_count(q) == 1;
    let b0 = match q.bindings[0] { qb::Val::String(s) => s == "English", _ => False };
    if ok_exact && ok_binds && b0 { True } else { fail!("absence row sql differs") }
};

def test_set_intersect: Fn() -> Bool = fn() {
    let q = lower_text(set_intersect_json);
    let ok_exact = q.sql == `SELECT c.Name FROM country AS c WHERE c.Continent = ? INTERSECT SELECT c.Name FROM country AS c WHERE c.Region = ?`;
    let ok_binds = binding_count(q) == 2;
    let b0 = match q.bindings[0] { qb::Val::String(s) => s == "Asia", _ => False };
    let b1 = match q.bindings[1] { qb::Val::String(s) => s == "X", _ => False };
    if ok_exact && ok_binds && b0 && b1 { True } else { fail!("set intersect sql differs") }
};

def test_compare: Fn() -> Bool = fn() {
    let q = lower_text(compare_json);
    let ok_exact = q.sql == `SELECT c.Name FROM country AS c WHERE c.LifeExpectancy > (SELECT avg(c.LifeExpectancy) FROM country AS c)`;
    let ok_binds = binding_count(q) == 0;
    if ok_exact && ok_binds { True } else { fail!("compare sql differs") }
};

def test_compare_scoped: Fn() -> Bool = fn() {
    let q = lower_text(compare_scoped_json);
    let ok_exact = q.sql == `SELECT c.Name FROM country AS c WHERE c.LifeExpectancy > (SELECT avg(c.LifeExpectancy) FROM country AS c WHERE c.Continent = ?)`;
    let ok_binds = binding_count(q) == 1;
    let b0 = match q.bindings[0] { qb::Val::String(s) => s == "Africa", _ => False };
    if ok_exact && ok_binds && b0 { True } else { fail!("scoped compare sql differs") }
};

def test_deterministic: Fn() -> Bool = fn() {
    let a = lower_text(set_intersect_json);
    let b = lower_text(set_intersect_json);
    if a.sql == b.sql && a.bindings == b.bindings { True } else { fail!("repeated lowering is not deterministic") }
};

# --- structural rejection probes -------------------------------------------

def test_unknown_op_rejected: Fn() -> Bool = fn() {
    if !intent_ok_text(unknown_op_json) { True } else { fail!("unknown op was accepted") }
};

def test_bad_set_kind_rejected: Fn() -> Bool = fn() {
    if !intent_ok_text(bad_set_kind_json) { True } else { fail!("unknown set kind was accepted") }
};

def test_single_branch_set_rejected: Fn() -> Bool = fn() {
    if !intent_ok_text(single_branch_set_json) { True } else { fail!("single-branch set was accepted") }
};

def test_missing_fields_rejected: Fn() -> Bool = fn() {
    if !intent_ok_text(missing_fields_json) { True } else { fail!("list intent missing fields was accepted") }
};

def test_field_filter_on_count_rejected: Fn() -> Bool = fn() {
    if !intent_ok_text(field_filter_on_count_json) { True } else { fail!("field-to-field filter on count was accepted") }
};

def test_non_object_intent_rejected: Fn() -> Bool = fn() {
    if !intent_ok_text(non_object_intent_json) { True } else { fail!("non-object intent was accepted") }
};

pub def test_list_filtered_case: test::Test = test::should_ok(fn() { if test_list_filtered() { True } else { fail!("assertion failed: test_list_filtered") } });
pub def test_list_hidden_order_case: test::Test = test::should_ok(fn() { if test_list_hidden_order() { True } else { fail!("assertion failed: test_list_hidden_order") } });
pub def test_list_explicit_order_case: test::Test = test::should_ok(fn() { if test_list_explicit_order() { True } else { fail!("assertion failed: test_list_explicit_order") } });
pub def test_count_filtered_case: test::Test = test::should_ok(fn() { if test_count_filtered() { True } else { fail!("assertion failed: test_count_filtered") } });
pub def test_aggregate_having_case: test::Test = test::should_ok(fn() { if test_aggregate_having() { True } else { fail!("assertion failed: test_aggregate_having") } });
pub def test_aggregate_ordered_case: test::Test = test::should_ok(fn() { if test_aggregate_ordered() { True } else { fail!("assertion failed: test_aggregate_ordered") } });
pub def test_aggregate_hidden_having_case: test::Test = test::should_ok(fn() { if test_aggregate_hidden_having() { True } else { fail!("assertion failed: test_aggregate_hidden_having") } });
pub def test_top_case: test::Test = test::should_ok(fn() { if test_top() { True } else { fail!("assertion failed: test_top") } });
pub def test_distinct_case: test::Test = test::should_ok(fn() { if test_distinct() { True } else { fail!("assertion failed: test_distinct") } });
pub def test_exists_count_case: test::Test = test::should_ok(fn() { if test_exists_count() { True } else { fail!("assertion failed: test_exists_count") } });
pub def test_absence_row_case: test::Test = test::should_ok(fn() { if test_absence_row() { True } else { fail!("assertion failed: test_absence_row") } });
pub def test_set_intersect_case: test::Test = test::should_ok(fn() { if test_set_intersect() { True } else { fail!("assertion failed: test_set_intersect") } });
pub def test_compare_case: test::Test = test::should_ok(fn() { if test_compare() { True } else { fail!("assertion failed: test_compare") } });
pub def test_compare_scoped_case: test::Test = test::should_ok(fn() { if test_compare_scoped() { True } else { fail!("assertion failed: test_compare_scoped") } });
pub def test_deterministic_case: test::Test = test::should_ok(fn() { if test_deterministic() { True } else { fail!("assertion failed: test_deterministic") } });
pub def test_unknown_op_rejected_case: test::Test = test::should_ok(fn() { if test_unknown_op_rejected() { True } else { fail!("assertion failed: test_unknown_op_rejected") } });
pub def test_bad_set_kind_rejected_case: test::Test = test::should_ok(fn() { if test_bad_set_kind_rejected() { True } else { fail!("assertion failed: test_bad_set_kind_rejected") } });
pub def test_single_branch_set_rejected_case: test::Test = test::should_ok(fn() { if test_single_branch_set_rejected() { True } else { fail!("assertion failed: test_single_branch_set_rejected") } });
pub def test_missing_fields_rejected_case: test::Test = test::should_ok(fn() { if test_missing_fields_rejected() { True } else { fail!("assertion failed: test_missing_fields_rejected") } });
pub def test_field_filter_on_count_rejected_case: test::Test = test::should_ok(fn() { if test_field_filter_on_count_rejected() { True } else { fail!("assertion failed: test_field_filter_on_count_rejected") } });
pub def test_non_object_intent_rejected_case: test::Test = test::should_ok(fn() { if test_non_object_intent_rejected() { True } else { fail!("assertion failed: test_non_object_intent_rejected") } });
