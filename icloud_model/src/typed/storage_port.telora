use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储磁盘／端口：保留来源 grain、原始文本与明确单位，不推断额外身份或关系。
use super::inventory as i;
use super::storage as storage;
use super::fc_switch as fc;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type PortId = struct(String);
@registry::entity("storage_port_entity")
type Identity = struct {
    id: PortId
};
# 来源 speed 为整数 Mbit/s，不把文本 maxSpeed (Gbit/s) 隐式转换为同一量。
type MegabitsPerSecond = struct(Int);
@registry::dataset("source_SYS_StoragePort", "SYS_StoragePort", ["source_id"])
@registry::roles([tenant, parent, subject, fc_parent])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(SysStoragePort.type, String.type, "source_ipv4Gateway"))),
            "source_SYS_StoragePort__ipv4Gateway_ipv4",
            True,
            g::ipv4_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_SYS_StoragePort__speed",
                MegabitsPerSecond.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(SysStoragePort.type, MegabitsPerSecond.type, "source_speed")),
            "source_SYS_StoragePort__speed",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(SysStoragePort.type, String.type, "source_mgmtIp"))),
            "source_SYS_StoragePort__mgmtIp_ipv4",
            True,
            g::ipv4_filters
        ),
    ]
)
@registry::relations(relations)
type SysStoragePort = struct {
    @m::column("id")
    @g::exact("source_SYS_StoragePort__id")
    source_id: PortId,
    @m::column("tenantId")
    @g::exact("source_SYS_StoragePort__tenantId")
    source_tenantId: i::TenantId,
    @m::column("name")
    @g::search("source_SYS_StoragePort__name")
    source_name: String,
    @m::column("remotePortWwn")
    @g::search("source_SYS_StoragePort__remotePortWwn")
    source_remotePortWwn: String,
    @m::column("remoteNodeWwn")
    @g::search("source_SYS_StoragePort__remoteNodeWwn")
    source_remoteNodeWwn: String,
    @m::column("lostSync")
    @g::exact("source_SYS_StoragePort__lostSync")
    source_lostSync: String,
    @m::column("ipv6Mask")
    @g::search("source_SYS_StoragePort__ipv6Mask")
    source_ipv6Mask: String,
    @m::column("ipv4Mask")
    @g::search("source_SYS_StoragePort__ipv4Mask")
    source_ipv4Mask: String,
    @m::column("firmwareVersion")
    @g::search("source_SYS_StoragePort__firmwareVersion")
    source_firmwareVersion: String,
    @m::column("parentResId")
    @g::exact("source_SYS_StoragePort__parentResId")
    source_parentResId: String,
    @m::column("ipv6Gateway")
    @g::search("source_SYS_StoragePort__ipv6Gateway")
    source_ipv6Gateway: String,
    @m::column("ipv4Gateway")
    @g::search("source_SYS_StoragePort__ipv4Gateway")
    source_ipv4Gateway: String,
    @m::column("logicType")
    @v::classification(SourceSYSStoragePortLogicType_domain, "source_SYS_StoragePort__logicType")
    source_logicType: String,
    @m::column("maxSpeed")
    @g::exact("source_SYS_StoragePort__maxSpeed")
    source_maxSpeed: String,
    @m::column("phySlotNum")
    @g::exact("source_SYS_StoragePort__phySlotNum")
    source_phySlotNum: String,
    @m::column("location")
    @g::search("source_SYS_StoragePort__location")
    source_location: String,
    @m::column("speed")
    source_speed: MegabitsPerSecond,
    @m::column("bondName")
    @g::search("source_SYS_StoragePort__bondName")
    source_bondName: String,
    @m::column("mgmtIpv6")
    @g::search("source_SYS_StoragePort__mgmtIpv6")
    source_mgmtIpv6: String,
    @m::column("mgmtIp")
    @g::search("source_SYS_StoragePort__mgmtIp")
    source_mgmtIp: String,
    @m::column("mac")
    @g::search("source_SYS_StoragePort__mac")
    source_mac: String,
    @m::column("wwn")
    @g::search("source_SYS_StoragePort__wwn")
    source_wwn: String,
    @m::column("portType")
    @v::classification(SourceSYSStoragePortPortType_domain, "source_SYS_StoragePort__portType")
    source_portType: String,
    @m::column("healthStatus")
    @v::classification(
        SourceSYSStoragePortHealthStatus_domain,
        "source_SYS_StoragePort__healthStatus"
    )
    source_healthStatus: String,
    @m::column("runningStatus")
    @v::classification(
        SourceSYSStoragePortRunningStatus_domain,
        "source_SYS_StoragePort__runningStatus"
    )
    source_runningStatus: String,
    @m::column("connectStatus")
    @v::classification(
        SourceSYSStoragePortConnectStatus_domain,
        "source_SYS_StoragePort__connectStatus"
    )
    source_connectStatus: String,
    @m::column("portId")
    @g::exact("source_SYS_StoragePort__portId")
    source_portId: String,
};
def dataset: m::Dataset(SysStoragePort) = registry::dataset_of(SysStoragePort.type);
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def subject: m::Role(SysStoragePort) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(SysStoragePort.type, PortId.type, "source_id"),
            m::field(Identity.type, PortId.type, "id")
        )
    ]
);
def tenant: m::Role(SysStoragePort) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(SysStoragePort.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent: m::Role(SysStoragePort) = m::role(
    dataset,
    storage::entity,
    "storage_owner",
    False,
    [
        m::reference_part(
            m::field(SysStoragePort.type, String.type, "source_parentResId"),
            m::field(storage::Identity.type, storage::StorageId.type, "id")
        )
    ]
);
def fc_parent: m::Role(SysStoragePort) = m::role(
    dataset,
    fc::entity,
    "fc_owner",
    False,
    [
        m::reference_part(
            m::field(SysStoragePort.type, String.type, "source_parentResId"),
            m::field(fc::Identity.type, fc::FcSwitchId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourceSYSStoragePortLogicType = enum {
    @ev::rename("0")
    @ev::description("Host port (or service port)", "主机端口(或业务端口）")
    HostPortOrServicePort,
    @ev::rename("1")
    @ev::description("Cascade port", "级联端口")
    CascadePort,
    @ev::rename("2")
    @ev::description("Management port", "管理端口")
    ManagementPort,
    @ev::rename("3")
    @ev::description("Internal port", "内部端口")
    InternalPort,
    @ev::rename("4")
    @ev::description("Maintenance port", "维护端口")
    MaintenancePort,
    @ev::rename("5")
    @ev::description("Management (or service hybrid port)", "管理（或业务混合口)")
    ManagementOrServiceHybridPort,
    @ev::rename("6")
    @ev::description("Maintenance (or service hybrid port)", "维护(或业务混合口)")
    MaintenanceOrServiceHybridPort,
    @ev::rename("13")
    @ev::description("Container front-end port", "容器前端端口")
    ContainerFrontEndPort,
    @ev::rename("14")
    @ev::description("Container back-end port", "容器后端端口")
    ContainerBackEndPort,
};
def SourceSYSStoragePortLogicType_domain: v::Domain(SourceSYSStoragePortLogicType, String) = v::from_enum(
    "SourceSYSStoragePortLogicType",
    SourceSYSStoragePortLogicType.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSStoragePortPortType = enum {
    @ev::rename("FCoE")
    @ev::description("FCoE port", "FCoE端口")
    FCoEPort,
    @ev::rename("ETH")
    @ev::description("Ethernet port", "以太网端口")
    EthernetPort,
    @ev::rename("RoCE")
    @ev::description("RoCE port", "RoCE端口")
    RoCePort,
    @ev::rename("SAS")
    @ev::description("SAS port", "SAS端口")
    SasPort,
    @ev::rename("FC")
    @ev::description("FC port", "FC端口")
    FcPort,
};
def SourceSYSStoragePortPortType_domain: v::Domain(SourceSYSStoragePortPortType, String) = v::from_enum(
    "SourceSYSStoragePortPortType",
    SourceSYSStoragePortPortType.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
