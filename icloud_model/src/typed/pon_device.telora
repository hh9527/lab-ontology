use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# PON 独立声明：保留来源、时间假定和固有角色范围。
use super::inventory as i;
use super::site as site;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type PonId = struct(
    String
);
@registry::entity("pon_resource")
type Identity = struct {
    id: PonId
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
@registry::dataset("pon_device", "I_EntPonElement", ["id"])
@registry::roles([subject, parent, tenant, project, subnet])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("pon_create_ms_time", s::EpochMillis.type, True, g::time_filters),
            g::input(m::field(IEntPonElement.type, s::EpochMillis.type, "create_time")),
            "pon_create_ms",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(IEntPonElement.type, String.type, "source_ipAddress"))),
            "pon_device__ipAddress_ipv4",
            True,
            g::ipv4_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_device__manufactureDate_time",
                s::Date.type,
                True,
                g::time_filters
            ),
            g::input(m::field(IEntPonElement.type, s::Date.type, "source_manufactureDate")),
            "pon_device__manufactureDate",
            True,
            g::time_filters
        ),
    ]
)
@registry::relations(relations)
@registry::alternatives(alternatives)
type IEntPonElement = struct {
    @g::search("pon_alias")
    alias: String,
    @v::classification(PonClass_domain, "pon_class")
    classification: String,
    @m::column("commuState")
    @v::classification(PonCommuState_domain, "pon_commu_state")
    commu_state: String,
    @m::column("createTime")
    create_time: s::EpochMillis,
    @g::exact("pon_id")
    id: PonId,
    @g::search("pon_name")
    name: String,
    @m::column("version")
    @g::search("pon_device__version")
    source_version: String,
    @m::column("ipAddress")
    @g::search("pon_device__ipAddress")
    source_ipAddress: String,
    @m::column("mac")
    @g::search("pon_device__mac")
    source_mac: String,
    @m::column("sn")
    @g::search("pon_device__sn")
    source_sn: String,
    @m::column("manufacturer")
    @g::search("pon_device__manufacturer")
    source_manufacturer: String,
    @m::column("manufactureDate")
    source_manufactureDate: s::Date,
    @m::column("adminState")
    @v::classification(PonDeviceAdminState_domain, "pon_device__adminState")
    source_adminState: String,
    @m::column("productName")
    @g::search("pon_device__productName")
    source_productName: String,
    @m::column("refParentSubnet")
    @g::exact("pon_device__refParentSubnet")
    source_refParentSubnet: i::SiteId,
    @m::column("tenantId")
    @g::exact("pon_device__tenantId")
    source_tenantId: i::TenantId,
    @m::column("remark")
    @g::search("pon_device__remark")
    source_remark: String,
    @m::column("nePatchVersion")
    @g::search("pon_device__nePatchVersion")
    source_nePatchVersion: String,
    @m::column("neOsVersion")
    @g::search("pon_device__neOsVersion")
    source_neOsVersion: String,
    @m::column("parentOltResId")
    @g::exact("pon_device__parentOltResId")
    source_parentOltResId: PonId,
    @m::column("esn")
    @g::search("pon_device__esn")
    source_esn: String,
    @m::column("projectId")
    @g::exact("pon_device__projectId")
    source_projectId: i::SiteId,
};
def dataset: m::Dataset(IEntPonElement) = registry::dataset_of(IEntPonElement.type);
def subject: m::Role(IEntPonElement) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(IEntPonElement.type, PonId.type, "id"),
            m::field(Identity.type, PonId.type, "id")
        )
    ]
);
def parent: m::Role(IEntPonElement) = m::role(
    dataset,
    entity,
    "parent",
    False,
    [
        m::identity_part(
            m::field(IEntPonElement.type, PonId.type, "source_parentOltResId"),
            m::field(Identity.type, PonId.type, "id")
        )
    ]
);
def tenant: m::Role(IEntPonElement) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(IEntPonElement.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def project: m::Role(IEntPonElement) = m::role(
    dataset,
    site::entity,
    "project",
    False,
    [
        m::identity_part(
            m::field(IEntPonElement.type, i::SiteId.type, "source_projectId"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def subnet: m::Role(IEntPonElement) = m::role(
    dataset,
    site::entity,
    "subnet",
    False,
    [
        m::identity_part(
            m::field(IEntPonElement.type, i::SiteId.type, "source_refParentSubnet"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type PonClass = enum {
    @ev::rename("ne.category.pon.onu")
    Onu,
    @ev::rename("ne.category.pon.spl")
    @ev::description("GPON", "")
    Spl,
    @ev::rename("ne.category.olt")
    Olt,
};
def PonClass_domain: v::Domain(PonClass, String) = v::from_enum(
    "PonClass",
    PonClass.type,
    String.type,
    False
);
@knowledge_policy::reverse_references(True)
type PonCommuState = enum {
    @ev::rename("1")
    @ev::description("Online", "在线")
    Online,
    @ev::rename("0")
    @ev::alias("2")
    @ev::alias("3")
    @ev::alias("4")
    @ev::alias("14")
    @ev::alias("15")
    @ev::description("Offline", "离线")
    Offline,
};
def PonCommuState_domain: v::Domain(PonCommuState, String) = v::from_enum(
    "PonCommuState",
    PonCommuState.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type PonDeviceAdminState = enum {
    @ev::rename("Enabled")
    @ev::description("Enabled", "启用")
    Enabled,
    @ev::rename("Disabled")
    @ev::description("Disabled", "禁用")
    Disabled,
    @ev::rename("active")
    @ev::description("Active", "激活")
    Active,
    @ev::rename("deactive")
    @ev::description("Deactive", "未激活")
    Deactive,
};
def PonDeviceAdminState_domain: v::Domain(PonDeviceAdminState, String) = v::from_enum(
    "PonDeviceAdminState",
    PonDeviceAdminState.type,
    String.type,
    False
);

def declaration: t::Declaration = registry::declaration(IEntPonElement.type);
def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElementAssociationEntPonElement",
        dataset,
        subject,
        dataset,
        parent,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EntPonElementAssociationX_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
def alternatives: Array(t::Alternative) = [
    {
        id: "source_EntPonElementAssociationX_SITE_VIEW",
        cardinality: {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
        choices: [
            r::relation(
                "pon_project_site",
                dataset,
                project,
                site::dataset,
                site::subject,
                {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
            ),
            r::relation(
                "pon_subnet_site",
                dataset,
                subnet,
                site::dataset,
                site::subject,
                {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
            ),
        ]
    }
];
pub use self::{PonId, Identity, entity, dataset, subject, declaration, relations, alternatives};

pub use self::{IEntPonElement};
