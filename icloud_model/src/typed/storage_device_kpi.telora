use ontology::registry as registry;
# 独立 transform 声明；单位、grain 与关系只采用既有公开契约。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use super::storage as storage;
use super::fc_switch as fc;
use ontology::quantity::{EffectiveCount};
@registry::dataset("source_StorageDeviceKPI", "StorageDeviceKPI", ["source_resId", "source_ts"])
@registry::roles([storage_owner, fc_owner])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageDeviceKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(StorageDeviceKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_StorageDeviceKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(StorageDeviceKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_StorageDeviceKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(StorageDeviceKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_StorageDeviceKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(StorageDeviceKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_StorageDeviceKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageDeviceKPI__cpuusage",
                p::Percent.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(StorageDeviceKPI.type, p::Percent.type, "source_cpuusage")),
            "source_StorageDeviceKPI__cpuusage",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageDeviceKPI__memoryusage",
                p::Percent.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(StorageDeviceKPI.type, p::Percent.type, "source_memoryusage")),
            "source_StorageDeviceKPI__memoryusage",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageDeviceKPI__cpuusageEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(StorageDeviceKPI.type, EffectiveCount.type, "source_cpuusageEffcnt")),
            "source_StorageDeviceKPI__cpuusageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageDeviceKPI__memoryusageEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(StorageDeviceKPI.type, EffectiveCount.type, "source_memoryusageEffcnt")
            ),
            "source_StorageDeviceKPI__memoryusageEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::metric("source_ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            p::Percent_statistics,
            m::field(StorageDeviceKPI.type, p::Percent.type, "source_cpuusage"),
            [
                {statistic: samples::Statistic::Mean, publish: "storage_cpu_usage"},
                {statistic: samples::Statistic::Max, publish: "storage_cpu_sample_max"},
                {statistic: samples::Statistic::Min, publish: "storage_cpu_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            p::Percent_statistics,
            m::field(StorageDeviceKPI.type, p::Percent.type, "source_memoryusage"),
            [
                {statistic: samples::Statistic::Mean, publish: "storage_memory_usage"},
                {statistic: samples::Statistic::Max, publish: "storage_memory_usage_max"},
                {statistic: samples::Statistic::Min, publish: "storage_memory_usage_min"}
            ]
        ),
    ]
)
@registry::relations(relations)
type StorageDeviceKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_StorageDeviceKPI__resId")
    source_resId: String,
    @m::column("cpuusage")
    source_cpuusage: p::Percent,
    @m::column("memoryusage")
    source_memoryusage: p::Percent,
    @m::column("cpuusageEffcnt")
    source_cpuusageEffcnt: EffectiveCount,
    @m::column("memoryusageEffcnt")
    source_memoryusageEffcnt: EffectiveCount,
};
def dataset: m::Dataset(StorageDeviceKPI) = registry::dataset_of(StorageDeviceKPI.type);
def storage_owner: m::Role(StorageDeviceKPI) = m::role(
    dataset,
    storage::entity,
    "storage_owner",
    False,
    [
        m::reference_part(
            m::field(StorageDeviceKPI.type, String.type, "source_resId"),
            m::field(storage::Identity.type, storage::StorageId.type, "id")
        )
    ]
);
def fc_owner: m::Role(StorageDeviceKPI) = m::role(
    dataset,
    fc::entity,
    "fc_owner",
    False,
    [
        m::reference_part(
            m::field(StorageDeviceKPI.type, String.type, "source_resId"),
            m::field(fc::Identity.type, fc::FcSwitchId.type, "id")
        )
    ]
);

def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceAssociationStorageDeviceKPI",
        r::endpoint(storage::dataset.row, storage::subject.id),
        r::endpoint(dataset.row, storage_owner.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_FCSwitchDevice_StorageDeviceKPI",
        r::endpoint(fc::dataset.row, fc::subject.id),
        r::endpoint(dataset.row, fc_owner.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{StorageDeviceKPI};
