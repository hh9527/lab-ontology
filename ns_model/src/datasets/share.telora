use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::cloud_storage_share_2_kpi;
@domain::subject("Share", "share_id")
@domain::dataset("share", "SYS_Share", ["share_id"])
@domain::relations(relations)
pub type Share = struct {
    @g::field_view(g::dimension_group("share/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "sh_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("share/obj_sys_id", domain::Reference(ids::CloudStorageShare2KpiByObjSysId).type, True, [g::Filter::Eq]), "sh_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::CloudStorageShare2KpiByObjSysId)),
    @m::column("oriResId")
    @g::field_view(g::dimension_group("share/ori_res_id", String.type, True, [g::Filter::Eq]), "sh_ori_res_id", True, [g::Filter::Eq])
    ori_res_id: Option(String),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("share/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "sh_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: domain::Reference(ids::NetworkElementById),
    @m::column("fsUid")
    @g::field_view(g::dimension_group("share/fs_uid", String.type, True, [g::Filter::Eq]), "sh_fs_uid", True, [g::Filter::Eq])
    fs_uid: Option(String),
    @m::column("vstoreName")
    @g::field_view(g::dimension_group("share/vstore_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "sh_vstore_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    vstore_name: Option(String),
    @m::column("vstoreId")
    @g::field_view(g::dimension_group("share/vstore_id", String.type, True, [g::Filter::Eq]), "sh_vstore_id", True, [g::Filter::Eq])
    vstore_id: Option(String),
    @g::field_view(g::dimension_group("share/type", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "sh_type", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    type: Option(String),
    @m::column("fsId")
    @g::field_view(g::dimension_group("share/fs_id", domain::Reference(ids::FileSystemByFileSystemId).type, True, [g::Filter::Eq]), "sh_fs_id", True, [g::Filter::Eq])
    fs_id: Option(domain::Reference(ids::FileSystemByFileSystemId)),
    @m::column("sharePath")
    @g::field_view(g::dimension_group("share/share_path", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "sh_share_path", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    share_path: Option(String),
    @m::column("shareId")
    @g::field_view(g::dimension_group("share/share_id", ids::ShareById.type, True, [g::Filter::Eq]), "sh_share_id", True, [g::Filter::Eq])
    @domain::count("sh_count")
    share_id: ids::ShareById,
};

pub def relations: Array(r::Relation) = [
    r::relation("css2__sh_rev", domain::endpoint(Share.type, "obj_sys_id"), domain::endpoint(cloud_storage_share_2_kpi::CloudStorageShare2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
