def device: r::Endpoint = domain::endpoint(TCurrentAlarm.type, "device");
def server_reference: r::Endpoint = domain::endpoint(TCurrentAlarm.type, "server");
def storage_reference: r::Endpoint = domain::endpoint(TCurrentAlarm.type, "storage");
def pon_reference: r::Endpoint = domain::endpoint(TCurrentAlarm.type, "pon");
def site_reference: r::Endpoint = domain::endpoint(TCurrentAlarm.type, "strext13");
def tenant: r::Endpoint = domain::endpoint(TCurrentAlarm.type, "tenant_id");
@knowledge_policy::reverse_references(True)
@ev::order_by_itag
type AlarmSeverity = enum {
    @ev::itag(1)
    @ev::description("Critical", "紧急")
    Critical,
    @ev::itag(2)
    @ev::description("Major", "重要")
    Major,
    @ev::itag(3)
    @ev::description("Minor", "次要")
    Minor,
    @ev::itag(4)
    @ev::description("Warning", "提示")
    Warning,
};
def AlarmSeverity_domain: v::Domain(AlarmSeverity, Int) = v::from_enum(
    "AlarmSeverity",
    AlarmSeverity.type,
    Int.type,
    False
);
@knowledge_policy::reverse_references(True)
type AlarmCleared = enum {
    @ev::itag(0)
    @ev::description("Uncleared", "未清除")
    Uncleared,
    @ev::itag(1)
    @ev::description("Cleared", "已清除")
    Cleared,
};
def AlarmCleared_domain: v::Domain(AlarmCleared, Int) = v::from_enum(
    "AlarmCleared",
    AlarmCleared.type,
    Int.type,
    False
);
@knowledge_policy::reverse_references(True)
type AlarmChangeFlag = enum {
    @ev::itag(1)
    @ev::description("Add", "新增")
    Add,
    @ev::itag(2)
    @ev::description("Update", "修改")
    Update,
    @ev::itag(3)
    @ev::description("Delete", "删除")
    Delete,
};
def AlarmChangeFlag_domain: v::Domain(AlarmChangeFlag, Int) = v::from_enum(
    "AlarmChangeFlag",
    AlarmChangeFlag.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type CurrentAlarmCLEARCATEGORY = enum {
    @ev::itag(1)
    @ev::description("Auto", "可自动清除")
    Auto,
    @ev::itag(2)
    @ev::description("Manual", "不可自动清除")
    Manual,
};
def CurrentAlarmCLEARCATEGORY_domain: v::Domain(CurrentAlarmCLEARCATEGORY, Int) = v::from_enum(
    "CurrentAlarmCLEARCATEGORY",
    CurrentAlarmCLEARCATEGORY.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type CurrentAlarmACKED = enum {
