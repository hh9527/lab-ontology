use crate::ontology as edsl;
use crate::intent as intent;
use crate::query as qb;
use crate::uql as uql;
use std::array as array;
use std::codec as codec;
use std::dict as dict;
use std::json as json;
use std::string as string;
use std::test as test;
use std::value::{Value};

@edsl::entity_id("server")
@edsl::entity_source("PhysicalServer", "s")
type Server = struct {
    @edsl::column("ID")
    @edsl::key()
    @edsl::dimension("id", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Int])
    id: Int,
    @edsl::column("IP_ADDRESS")
    @edsl::logical_type(edsl::LogicalType::Ipv4)
    @edsl::dimension("ip", True, True, [edsl::FilterOp::InSubnet], [edsl::FilterInputKind::Ipv4])
    ip: Option(String),
};
def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source,
        qb::Operator::Project,
        qb::Operator::Column,
        qb::Operator::Bind,
        qb::Operator::Scalar,
        qb::Operator::Filter,
        qb::Operator::Limit,
        qb::Operator::Order
    ],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [
        qb::ScalarFunction::Eq,
        qb::ScalarFunction::And,
        qb::ScalarFunction::Ge,
        qb::ScalarFunction::Lt,
        qb::ScalarFunction::BinaryText,
        qb::ScalarFunction::RegexMatch
    ],
    allow_distinct: False,
};
def payload: edsl::PreparedPayload = edsl::build_root("uql-integration", [Server.type], profile);
def parse: Fn(String) -> Value = fn(text) {
    match json::parse(text) {
        Ok(value) => value,
        Err(error) => fail!("invalid test JSON", error),
    }
};
def input: Value = parse(
    r#"{"op":"Graph","root":"d","nodes":[{"id":"d","entity":"server"}],"edges":[],"select":[{"node":"d","dimension":"ip"}],"filters":[{"node":"d","dimension":"id","op":"Eq","value":42}],"order_by":[{"node":"d","dimension":"ip","direction":"Desc"}],"take":7}"#
);
def ast: qb::QueryAst = intent::query_intent_ast_factory(payload)(input);
def lower: Fn(Value) -> Value = intent::query_request_method_factory(payload, uql::build_query);

pub def model_lowering_renders_positional_uql_with_occurrence_bindings: test::Test = test::should_ok(
    fn() {
        let rendered = intent::query_intent_lower_factory(payload, uql::build_query)(input);
        if rendered != uql::build_query(ast) {
            fail!("intent lowering must match the direct UQL rendering", rendered)
        } else { () };
        if rendered.bindings != [qb::Val::Int(42)] {
            fail!("the filter value is the only occurrence binding", rendered.bindings)
        } else { () };
        if array::length(string::split(rendered.sql, "?")) - 1 != array::length(rendered.bindings) {
            fail!("the placeholder count must equal the bindings length", rendered.sql)
        } else { () };
        if !string::contains(rendered.sql, "`PhysicalServer` AS `s`") {
            fail!("the physical table must be aliased", rendered.sql)
        } else { () };
        if !string::contains(rendered.sql, "`s`.`IP_ADDRESS`") {
            fail!("the projected column must stay quoted", rendered.sql)
        } else { () };
        if !string::contains(rendered.sql, "`s`.`ID` = ?") {
            fail!("the filter must use a positional placeholder", rendered.sql)
        } else { () };
        if !string::contains(rendered.sql, "AS `__q_result`") {
            fail!("the final selection must wrap the business query", rendered.sql)
        } else { () };
        if !string::contains(rendered.sql, "LIMIT 7") {
            fail!("the final take renders as a literal limit", rendered.sql)
        } else { () }
    }
);

pub def batch_service_preserves_columns_and_result_bound: test::Test = test::should_ok(
    fn() {
        match lower(Value::Object({intents: Value::Array([input])})) {
            Value::Object(response) => if dict::get(response, "accepted") == Some(Value::True) && dict::get(
                response,
                "diagnostics"
            ) == Some(Value::Array([])) {
                match dict::get(response, "queries") {
                    Some(Value::Array(queries)) => if array::length(queries) == 1 {
                        match queries[0] {
                            Value::Object(query) => if dict::get(query, "columns") != Some(
                                codec::encode(intent::result_columns(payload, input, ast))
                            ) {
                                fail!("the result columns must be preserved", query)
                            } else { () };if dict::get(query, "max_rows") != Some(Value::Int(7)) {
                                fail!("the final selection bounds the delivered rows", query)
                            } else { () };if dict::get(
                                query,
                                "bindings"
                            ) != Some(codec::encode(uql::build_query(ast).bindings)) {
                                fail!("the bindings must be the occurrence expansion", query)
                            } else { () },
                            _ => fail!("the batch response query must be an object", queries[0]),
                        }
                    } else {
                        fail!("the batch must accept the single intent", queries)
                    },
                    _ => fail!("the batch response must carry queries", response),
                }
            } else {
                fail!("the batch must accept the valid intent", response)
            },
            _ => fail!("the batch response must be an object", response),
        }
    }
);

pub def batch_failure_retains_the_failing_intent_index: test::Test = test::should_ok(
    fn() {
        let invalid = parse(
            r#"{"op":"Graph","root":"d","nodes":[{"id":"d","entity":"missing"}],"edges":[],"select":[{"node":"d","dimension":"ip"}]}"#
        );
        match lower(Value::Object({intents: Value::Array([input, invalid])})) {
            Value::Object(response) => dict::get(response, "accepted") == Some(Value::False) && dict::get(
                response,
                "queries"
            ) == Some(Value::None) && (
                match dict::get(response, "diagnostics") {
                    Some(Value::Array(reports)) => array::length(reports) > 0 && array::all(
                        reports,
                        fn(report) {
                            match report {
                                Value::Object(fields) => dict::get(fields, "index") == Some(
                                    Value::Int(1)
                                ),
                                _ => False,
                            }
                        }
                    ),
                    _ => False,
                }
            ),
            _ => False,
        }
    }
);

pub def unsupported_uql_collation_is_an_indexed_batch_failure: test::Test = test::should_ok(
    fn() {
        let subnet = parse(
            r#"{"op":"Graph","root":"d","nodes":[{"id":"d","entity":"server"}],"edges":[],"select":[{"node":"d","dimension":"ip"}],"filters":[{"node":"d","dimension":"ip","op":"InSubnet","value":"192.0.2.0/24"}]}"#
        );
        match lower(Value::Object({intents: Value::Array([input, subnet])})) {
            Value::Object(response) => dict::get(response, "accepted") == Some(Value::False) && dict::get(
                response,
                "queries"
            ) == Some(Value::None) && (
                match dict::get(response, "diagnostics") {
                    Some(Value::Array(reports)) => array::any(
                        reports,
                        fn(report) {
                            match report {
                                Value::Object(fields) => dict::get(fields, "index") == Some(
                                    Value::Int(1)
                                ) && (
                                    match dict::get(fields, "diagnostic") {
                                        Some(Value::Object(diagnostic)) => dict::get(
                                            diagnostic,
                                            "message"
                                        ) == Some(
                                            Value::String(
                                                "UQL spec does not define binary text collation"
                                            )
                                        ),
                                        _ => False,
                                    }
                                ),
                                _ => False,
                            }
                        }
                    ),
                    _ => False,
                }
            ),
            _ => False,
        }
    }
);
