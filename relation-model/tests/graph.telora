}, "connection_z expects from connection to device, but d is device and peer is device; correct the node entity or choose a relation declared for these roles");

pub def either_physical_endpoint_exists_with_full_identity: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"link","entity":"connection"},{"id":"peer","entity":"device"}],
            "edges":[{"relation":"connection_endpoint","from":"link","to":"d"},
                     {"relation":"connection_z","from":"link","to":"peer"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "d.id = link.a_device_id AND d.tenant_id = link.tenant_id")
        && string::contains(sq.sql, "d.id = link.z_device_id AND d.tenant_id = link.tenant_id")
        && string::contains(sq.sql, " OR ")
        && string::contains(sq.sql, "INNER JOIN devices AS peer ON")
        && string::contains(sq.sql, "link.tenant_id = peer.tenant_id")
        && string::contains(pg.sql, "\"d\".\"id\" = \"link\".\"a_device_id\"")
        && string::contains(pg.sql, "\"d\".\"id\" = \"link\".\"z_device_id\"") {
        True
    } else { fail!("declared alternative endpoint identity lost a branch or path", sq, pg) }
});

