# A measure whose stable vocabulary id denotes DISTINCT aggregate semantics.
# The input mode is model knowledge, not a per-query caller choice.
def dataset_description: Fn(
    String,
    String
) -> Fn(td::TypeDesc, Option(DatasetDescription)) -> DatasetDescription = fn(label, summary) {
    fn(ctx, previous) {
        if label == "" || summary == "" {
            fail!("dataset description requires a label and summary")
        } else {
            let result: DatasetDescription = {label, summary};
            result
        }
    }
};

