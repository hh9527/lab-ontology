use ontology::knowledge_policy as knowledge_policy;
# ServerMemory独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(String);
type Identity = struct { id: ComponentId };
# 保留源MB编码，不自动转换为Bytes或推断二进制倍率
type Megabytes = struct(Int);
type Row = struct {
    id: ComponentId,
    name: String,
    parent_res_id: server::ServerOriginId,
    tenant_id: i::TenantId,
    source_partNumber: String,
    source_manufacturer: String,
    source_type: String,
    source_serialNumber: String,
    source_bitWidth: Int,
    source_frequency: Int,
    source_capacity: Megabytes,
    source_model: String,
    source_healthStatus: Int,
    source_memoryName: String,
    source_dn: String,
    source_projectId: String,
};
def entity: m::Entity(Identity) = m::entity("server_memory_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset("server_memory", "PhysicalServerMemory", Row.type, ["id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, ComponentId.type, "id"), m::field(Identity.type, ComponentId.type, "id"))]);
def parent: m::Role(Row) = m::role(dataset, server::origin_entity, "server_origin", False, [m::identity_part(m::field(Row.type, server::ServerOriginId.type, "parent_res_id"), m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
@knowledge_policy::reverse_references(True)
type ServerMemoryHealthStatus = struct(String);
def health: v::Domain(ServerMemoryHealthStatus, Int) = v::domain("ServerMemoryHealthStatus", ServerMemoryHealthStatus.type, Int.type, [
    v::member(ServerMemoryHealthStatus("wire_0_92e42f8f"), [0]),
    v::member(ServerMemoryHealthStatus("wire_1_8d618873"), [1]),
    v::member(ServerMemoryHealthStatus("wire_2_d0a68914"), [2]),
    v::member(ServerMemoryHealthStatus("wire_3_bab86ec8"), [3]),
    v::member(ServerMemoryHealthStatus("wire_4_5978b238"), [4]),
    v::member(ServerMemoryHealthStatus("wire__1_fe93bf05"), [-1]),
    v::member(ServerMemoryHealthStatus("wire__2_1027a474"), [-2]),
], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [subject, parent, tenant], [
    i::search(dataset, m::field(Row.type, String.type, "name"), "server_memory_name"),
    i::search(dataset, m::field(Row.type, String.type, "source_partNumber"), "server_memory__partNumber"),
    i::search(dataset, m::field(Row.type, String.type, "source_manufacturer"), "server_memory__manufacturer"),
    i::exact(dataset, m::field(Row.type, String.type, "source_type"), "server_memory__type"),
    i::search(dataset, m::field(Row.type, String.type, "source_serialNumber"), "server_memory__serialNumber"),
    g::dimension(dataset, g::dimension_group("server_memory__bitWidth", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_bitWidth")), "server_memory__bitWidth", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("server_memory__frequency", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_frequency")), "server_memory__frequency", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("server_memory__capacity", Megabytes.type, True, g::numeric_filters), g::input(m::field(Row.type, Megabytes.type, "source_capacity")), "server_memory__capacity", True, g::numeric_filters),
    i::search(dataset, m::field(Row.type, String.type, "source_model"), "server_memory__model"),
    i::search(dataset, m::field(Row.type, String.type, "source_memoryName"), "server_memory__memoryName"),
    i::exact(dataset, m::field(Row.type, String.type, "source_dn"), "server_memory__dn"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "server_memory__projectId"),
], []), [
    t::column(m::field(Row.type, ComponentId.type, "id"), "id"),
    t::column(m::field(Row.type, String.type, "name"), "name"),
    t::column(m::field(Row.type, server::ServerOriginId.type, "parent_res_id"), "parentResId"),
    t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::field(Row.type, String.type, "source_partNumber"), "partNumber"),
    t::column(m::field(Row.type, String.type, "source_manufacturer"), "manufacturer"),
    t::column(m::field(Row.type, String.type, "source_type"), "type"),
    t::column(m::field(Row.type, String.type, "source_serialNumber"), "serialNumber"),
    t::column(m::field(Row.type, Int.type, "source_bitWidth"), "bitWidth"),
    t::column(m::field(Row.type, Int.type, "source_frequency"), "frequency"),
    t::column(m::field(Row.type, Megabytes.type, "source_capacity"), "capacity"),
    t::column(m::field(Row.type, String.type, "source_model"), "model"),
    t::column(m::field(Row.type, Int.type, "source_healthStatus"), "healthStatus"),
    t::column(m::field(Row.type, String.type, "source_memoryName"), "memoryName"),
    t::column(m::field(Row.type, String.type, "source_dn"), "dn"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
 ]), [
    v::bind(dataset, v::dimension_group(health, True, g::equality_filters), g::input(m::field(Row.type, Int.type, "source_healthStatus")), "server_memory__healthStatus", True, g::equality_filters),
]);
def tenant_cardinality: edsl::RelationCardinality = {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0};
def relations: Array(r::Relation) = [
    r::relation("memory_parent_server", dataset, parent, server::dataset, server::origin, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("source_PhysicalServer_PhysicalServerMemory", server::dataset, server::origin, dataset, parent, tenant_cardinality),
    r::relation("source_PhysicalServerMemory_X_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, tenant_cardinality),
];
pub use self::{declaration, relations};
