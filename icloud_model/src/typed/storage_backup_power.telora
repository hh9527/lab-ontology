use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储组件来源：parent 使用存储设备身份；原始文本不按单位说明隐式解析。
use super::inventory as i;
use super::storage as storage;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("StorageBackupPower")
type StorageBackupPowerById = struct(ComponentId);
@domain::subject("StorageBackupPower", "source_id")
@domain::dataset("source_SYS_BackupPower", "SYS_BackupPower", ["source_id"])
@domain::relations(relations)
type SysBackupPower = struct {
    @m::column("name")
    @g::search("source_SYS_BackupPower__name")
    source_name: String,
    @m::column("id")
    @g::exact("source_SYS_BackupPower__id")
    source_id: StorageBackupPowerById,
    @m::column("tenantId")
    @g::exact("source_SYS_BackupPower__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("elecLabel")
    @g::search("source_SYS_BackupPower__elecLabel")
    source_elecLabel: String,
    @m::column("sn")
    @g::search("source_SYS_BackupPower__sn")
    source_sn: String,
    @m::column("backupPowerType")
    @g::exact("source_SYS_BackupPower__backupPowerType_raw")
    @v::map(
        SourceSYSBackupPowerBackupPowerType.type,
        "source_SYS_BackupPower__backupPowerType",
        [v::member(SourceSYSBackupPowerBackupPowerType::Bbu, ["0"])]
    )
    source_backupPowerType: String,
    @m::column("parentResId")
    @g::exact("source_SYS_BackupPower__parentResId")
    source_parentResId: domain::Reference(storage::StorageById),
    @m::column("projectId")
    @g::exact("source_SYS_BackupPower__projectId")
    source_projectId: String,
    @m::column("location")
    @g::search("source_SYS_BackupPower__location")
    source_location: String,
    @m::column("chargeTimes")
    @g::exact("source_SYS_BackupPower__chargeTimes")
    source_chargeTimes: String,
    @m::column("parentId")
    @g::exact("source_SYS_BackupPower__parentId")
    source_parentId: String,
    @m::column("controllerId")
    @g::exact("source_SYS_BackupPower__controllerId")
    source_controllerId: String,
    @m::column("firmwareVer")
    @g::search("source_SYS_BackupPower__firmwareVer")
    source_firmwareVer: String,
    @m::column("runningStatus")
    @g::exact("source_SYS_BackupPower__runningStatus_raw")
    @v::map(
        SourceSYSBackupPowerRunningStatus.type,
        "source_SYS_BackupPower__runningStatus",
        [
            v::member(SourceSYSBackupPowerRunningStatus::Unknown, ["0"]),
            v::member(SourceSYSBackupPowerRunningStatus::Normal, ["1"]),
            v::member(SourceSYSBackupPowerRunningStatus::Running, ["2"]),
            v::member(SourceSYSBackupPowerRunningStatus::Online, ["27"]),
            v::member(SourceSYSBackupPowerRunningStatus::Offline, ["28"]),
            v::member(SourceSYSBackupPowerRunningStatus::Charging, ["48"]),
            v::member(SourceSYSBackupPowerRunningStatus::ChargingComplete, ["49"]),
            v::member(SourceSYSBackupPowerRunningStatus::Discharging, ["50"])
        ]
    )
    source_runningStatus: String,
    @m::column("healthStatus")
    @g::exact("source_SYS_BackupPower__healthStatus_raw")
    @v::map(
        SourceSYSBackupPowerHealthStatus.type,
        "source_SYS_BackupPower__healthStatus",
        [
            v::member(SourceSYSBackupPowerHealthStatus::Unknown, ["0"]),
            v::member(SourceSYSBackupPowerHealthStatus::Normal, ["1"]),
            v::member(SourceSYSBackupPowerHealthStatus::Fault, ["2"]),
            v::member(SourceSYSBackupPowerHealthStatus::AboutToFail, ["3"]),
            v::member(SourceSYSBackupPowerHealthStatus::InsufficientPower, ["12"])
        ]
    )
    source_healthStatus: String,
    @m::column("manufacturedDate")
    @g::field_view(
        g::dimension_group(
            "source_SYS_BackupPower__manufacturedDate",
            s::Date.type,
            True,
            g::numeric_filters
        ),
        "source_SYS_BackupPower__manufacturedDate",
        True,
        g::numeric_filters
    )
    source_manufacturedDate: s::Date,
    @m::column("backupPowerId")
    @g::exact("source_SYS_BackupPower__backupPowerId")
    source_backupPowerId: String,
    @m::column("remainLifeDays")
    @g::exact("source_SYS_BackupPower__remainLifeDays_raw")
    @v::map_or(
        BackupPowerLifeAvailability.type,
        "source_SYS_BackupPower__remainLifeDays",
        [v::member(BackupPowerLifeAvailability::Unavailable, ["-1"])],
        BackupPowerLifeAvailability::Unknown
    )
    source_remainLifeDays: String,
};

def subject: r::Endpoint = domain::endpoint(SysBackupPower.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(SysBackupPower.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(SysBackupPower.type, "source_parentResId");

@knowledge_policy::reverse_references(True)
type SourceSYSBackupPowerBackupPowerType = enum {
    Bbu,
};

@knowledge_policy::reverse_references(True)
type SourceSYSBackupPowerRunningStatus = enum {
    @ev::description("unknown", "未知")
    Unknown,

    @ev::description("normal", "正常")
    Normal,

    @ev::description("running", "运行")
    Running,

    @ev::description("online", "在线")
    Online,

    @ev::description("offline", "离线")
    Offline,

    @ev::description("charging", "正在充电")
    Charging,

    @ev::description("charging complete", "充电完成")
    ChargingComplete,

    @ev::description("discharging", "正在放电")
    Discharging,
};

@knowledge_policy::reverse_references(True)
type SourceSYSBackupPowerHealthStatus = enum {
    @ev::description("unknown", "未知")
    Unknown,

    @ev::description("normal", "正常")
    Normal,

    @ev::description("fault", "故障")
    Fault,

    @ev::description("about to fail", "即将故障")
    AboutToFail,

    @ev::description("insufficient power", "电量不足")
    InsufficientPower,
};

type BackupPowerLifeAvailability = enum {
    Unavailable,
    Unknown,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceAssociationSYS_BackupPower",
        storage::subject,
        parent,
        cardinality
    ),
    r::relation(
        "source_SYS_BackupPowerAssociationX_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{SysBackupPower, StorageBackupPowerById};

pub use self::{
    SourceSYSBackupPowerBackupPowerType,
    SourceSYSBackupPowerRunningStatus,
    SourceSYSBackupPowerHealthStatus,
    BackupPowerLifeAvailability
};
