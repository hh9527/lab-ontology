use ontology::experimental::knowledge as knowledge;
use ontology::experimental::knowledge_policy as policy;
use ontology::experimental::scalars as s;
use std::test as test;

@knowledge::reverse_references(False)
type SharedCode = struct(String);
@knowledge::reverse_references(True)
type BusinessTime = struct(s::DateTimeUtc);
type OrdinaryCode = struct(String);
type WrappedCode = struct(BusinessTime);
@knowledge::reverse_references(True)
type OptInCode = struct(String);

pub def custom_type_can_disable_reverse_references: test::Test = test::should_ok(fn() {
    !policy::allows_reverse_references(SharedCode.type)
});
pub def ordinary_types_disable_reverse_references: test::Test = test::should_ok(fn() {
    !policy::allows_reverse_references(OrdinaryCode.type)
});
pub def policy_does_not_follow_storage: test::Test = test::should_ok(fn() {
    !policy::allows_reverse_references(WrappedCode.type) && policy::allows_reverse_references(BusinessTime.type)
});
pub def all_time_scalars_disable_reverse_references: test::Test = test::should_ok(fn() {
    !policy::allows_reverse_references(s::Date.type)
    && !policy::allows_reverse_references(s::DateTime.type)
    && !policy::allows_reverse_references(s::DateTimeUtc.type)
    && !policy::allows_reverse_references(s::EpochMillis.type)
});

# A tiny publication fixture verifies property → JSON → static JS → plugin.
use ontology::experimental::transform as t;
use ontology::experimental::world as w;
use ontology::query as qb;
use std::value::{Value};
def profile: qb::PlanProfile = {allowed_operators: [], allowed_join_kinds: [], allowed_aggregates: [], allowed_scalars: [], allow_distinct: False};
def fixture: w::World = {revision: "reference-policy", types: [
    w::type_entry(Int.type), w::type_entry(String.type), w::type_entry(Bool.type), w::type_entry(Float.type),
    w::type_entry(s::Date.type), w::type_entry(s::DateTime.type), w::type_entry(s::DateTimeUtc.type), w::type_entry(s::EpochMillis.type),
    w::type_entry(SharedCode.type), w::type_entry(OrdinaryCode.type), w::type_entry(OptInCode.type),
], datasets: [], entities: [], relations: [], alternatives: [], links: [], profile};
pub def policy_publication: Value = w::publication(fixture, w::prepare(fixture));
