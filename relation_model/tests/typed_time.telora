use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};
use std::test as test;

type Row = struct { seq: Int, instant: Option(s::Rfc3339Utc), epoch: s::EpochMillis, local_epoch: s::LocalEpochMillis, local: s::LocalDateTime, date: s::DateUtc };
def rows: m::Dataset(Row) = m::dataset("clocks", "clock_rows", Row.type, ["seq"]);
def dimensions: Array(g::Binding(Row)) = [
    g::dimension(rows, g::dimension_group("seq", Int.type, True, []), g::input(m::field(Row.type, Int.type, "seq")), "seq", True, []),
    g::dimension(rows, g::dimension_group("instant", s::Rfc3339Utc.type, True, g::time_filters), g::input(m::optional_field(Row.type, s::Rfc3339Utc.type, "instant")), "instant", True, g::time_filters),
    g::dimension(rows, g::dimension_group("epoch", s::EpochMillis.type, True, g::time_filters), g::input(m::field(Row.type, s::EpochMillis.type, "epoch")), "epoch", True, g::time_filters),
    g::dimension(rows, g::dimension_group("local_epoch", s::LocalEpochMillis.type, True, g::time_filters), g::input(m::field(Row.type, s::LocalEpochMillis.type, "local_epoch")), "local_epoch", True, g::time_filters),
    g::dimension(rows, g::dimension_group("local", s::LocalDateTime.type, True, g::time_filters), g::input(m::field(Row.type, s::LocalDateTime.type, "local")), "local", True, g::time_filters),
    g::dimension(rows, g::dimension_group("date", s::DateUtc.type, True, g::time_filters), g::input(m::field(Row.type, s::DateUtc.type, "date")), "date", True, g::time_filters),
];
def declared: t::Declaration = t::map_columns(t::declare(rows, [], dimensions, []), [t::column(m::optional_field(Row.type, s::Rfc3339Utc.type, "instant"), "UTC_TEXT")]);
def profile: qb::PlanProfile = {allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Filter], allowed_join_kinds: [], allowed_aggregates: [], allow_distinct: False, allowed_scalars: [qb::ScalarFunction::And, qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::Lt, qb::ScalarFunction::Le]};
def payload: edsl::PreparedPayload = t::prepare("clocks", [declared], profile).payload;
def ast: Fn(String) -> qb::QueryAst = fn(extra) { intent::query_intent_ast_factory(payload)(json::parse(`{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"clocks"}],"edges":[],\{extra}}`).unwrap!()) };
type RuntimeCase = struct { id: String, sqlite: qb::Query, postgres: qb::Query };
def filtered: Fn(String, String, String, String) -> RuntimeCase = fn(id, dimension, op, value) { let query = ast(`"select":[{"node":"r","dimension":"seq"}],"filters":[{"node":"r","dimension":"\{dimension}","op":"\{op}","value":\{value}}]`); {id, sqlite: sqlite::build_query(query), postgres: postgres::build_query(query)} };
def window_case: RuntimeCase = do {
    let query = ast(r#""select":[{"node":"r","dimension":"seq"}],"time_windows":[{"node":"r","dimension":"instant","start":"2024-02-29T12:00:00Z","end":"2024-03-01T00:00:00Z"}]"#);
    {id: "window", sqlite: sqlite::build_query(query), postgres: postgres::build_query(query)}
};
pub def runtime_cases: Value = codec::encode([
    window_case,
    filtered("utc_ge", "instant", "Ge", r#""2024-02-29T12:00:00Z""#),
    filtered("utc_lt", "instant", "Lt", r#""2024-03-01T00:00:00Z""#),
    filtered("epoch_ge", "epoch", "Ge", "1000"),
    filtered("local_epoch_lt", "local_epoch", "Lt", "1000"),
    filtered("local_ge", "local", "Ge", r#""2024-02-29 12:00:00""#),
    filtered("date_eq", "date", "Eq", r#""2024-02-29""#),
]);
pub def nominal_local_epoch_keeps_local_semantics: test::Test = test::should_ok(fn() { payload.entities[0].fields[3].time == Some({semantics: edsl::TimeSemantics::Local, encoding: edsl::TimeEncoding::EpochMillis}) });
pub def nullable_field_keeps_time_role: test::Test = test::should_ok(fn() { payload.entities[0].fields[1].nullable && payload.entities[0].fields[1].time == Some({semantics: edsl::TimeSemantics::Utc, encoding: edsl::TimeEncoding::Rfc3339Text}) });
pub def time_types_cannot_advertise_search: test::Test = test::should_fail_with(fn() { g::dimension_group("bad", s::Rfc3339Utc.type, True, g::text_search_filters) }, "time dimensions only support comparisons");
pub def invalid_leap_day_is_rejected: test::Test = test::should_fail(fn() { filtered("bad", "date", "Eq", r#""2023-02-29""#) });
pub def utc_offsets_are_not_canonical: test::Test = test::should_fail(fn() { filtered("bad", "instant", "Eq", r#""2024-02-29T12:00:00+00:00""#) });
pub def local_clock_rejects_utc_wire: test::Test = test::should_fail(fn() { filtered("bad", "local", "Eq", r#""2024-02-29T12:00:00Z""#) });
pub def epoch_rejects_fractional_milliseconds: test::Test = test::should_fail(fn() { filtered("bad", "epoch", "Eq", "1.5") });
pub def role_does_not_infer_time_from_integer_storage: test::Test = test::should_ok(fn() { payload.entities[0].fields[0].time == None });

pub def erased_role_cannot_change_storage: test::Test = test::should_fail_with(fn() {
    let entity = payload.entities[0];
    let fields = array::map(entity.fields, fn(field) { if field.name == "seq" { field <~ {time: Some({semantics: edsl::TimeSemantics::Utc, encoding: edsl::TimeEncoding::Rfc3339Text})} } else { field } });
    edsl::validate_transform_contract(payload <~ {entities: [entity <~ {fields}]})
}, "prepared time role disagrees with field storage or semantics");
pub def erased_role_cannot_mark_date_encoding_as_utc_instant: test::Test = test::should_fail_with(fn() {
    let entity = payload.entities[0];
    let fields = array::map(entity.fields, fn(field) { if field.name == "date" { field <~ {time: Some({semantics: edsl::TimeSemantics::Utc, encoding: edsl::TimeEncoding::DateText})} } else { field } });
    edsl::validate_transform_contract(payload <~ {entities: [entity <~ {fields}]})
}, "prepared time role disagrees with field storage or semantics");

pub def public_result_types_preserve_time_encoding: test::Test = test::should_ok(fn() {
    let input = json::parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"clocks"}],"edges":[],"select":[{"node":"r","dimension":"instant"},{"node":"r","dimension":"epoch"},{"node":"r","dimension":"local"}]}"#).unwrap!();
    let query = intent::query_intent_ast_factory(payload)(input);
    let columns = intent::result_columns(payload, input, query);
    columns == [
        {name: "r_instant", type: intent::ResultType::DatetimeUtc, nullable: True},
        {name: "r_epoch", type: intent::ResultType::EpochMillis, nullable: False},
        {name: "r_local", type: intent::ResultType::LocalDateTime, nullable: False},
    ]
});
