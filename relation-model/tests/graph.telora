pub def empty_group_count_filters_nullable_child: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"tenant", "include_empty":true,
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"device",
        "filters":[{"node":"device","dimension":"device_id","op":"eq","kind":"text","value":"device-1"}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "LEFT JOIN (SELECT * FROM devices AS device WHERE device.id = ?1) AS device")
        && string::contains(sq.sql, "ON device.tenant_id = tenant.id GROUP BY tenant.id")
        && string::contains(pg.sql, "LEFT JOIN (SELECT * FROM \"devices\" AS \"device\" WHERE \"device\".\"id\" = $1) AS \"device\"")
        && sq.bindings == [qb::Val::String("device-1")]
        && pg.bindings == sq.bindings {
        True
    } else { fail!("nullable child filter must narrow joined rows without removing empty roots", sq, pg) }
});

