use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::physical_server_fan;
use crate::datasets::kpi_server_fan;
@domain::subject("PhysicalServerFan", "obj_sys_id")
@domain::dataset("serverfan-2-kpi", "serverfan2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type Serverfan2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("serverfan-2-kpi/obj_sys_id", ids::PhysicalServerFanByObjSysId.type, True, [g::Filter::Eq]), "se_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: ids::PhysicalServerFanByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("serverfan-2-kpi/obj_id", domain::Reference(ids::KpiServerFanByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "se_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::KpiServerFanByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("se__psf", domain::endpoint(Serverfan2Kpi.type, "obj_sys_id"), domain::endpoint(physical_server_fan::PhysicalServerFan.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("se__sf", domain::endpoint(Serverfan2Kpi.type, "obj_id"), domain::endpoint(kpi_server_fan::KpiServerFan.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("se__psf_rev", domain::endpoint(Serverfan2Kpi.type, "obj_sys_id"), domain::endpoint(physical_server_fan::PhysicalServerFan.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
