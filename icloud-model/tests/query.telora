pub def qualified_interface_count_keeps_site_existence_separate_from_sample_avg: test::Test = test::should_ok(fn() {
    let q = lower_json(qualified_interface_intent);
    if array::length(string::split(q.sql, "count(p.id)")) == 2
        && array::length(string::split(q.sql, "p.tenantId = d.tenant_id")) == 2
        && array::length(string::split(q.sql, "avg(ik_qualification.ifOutErrors) < ?")) == 2
        && array::length(string::split(q.sql, "JOIN X_SITE_VIEW")) == 1
        && array::length(string::split(q.sql, "EXISTS (")) == 3
        && array::length(string::split(q.sql, "p.id = ik_qualification.resId")) == 2 {
        True
    } else { fail!("Q0111 must count interface identities after independent KPI and site qualifications", q) }
});

pub def qualified_interface_filters_raw_samples_before_avg: test::Test = test::should_ok(fn() {
    let prefix = `{"op":"qualify_metrics","measures":[],"dimensions":["port_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"interface_kpi_of_port","dataset":"interface_kpi","filters":[{"dimension":"interface_out_errors_sample","op":"lt","kind":"int","value":58}],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"interface_out_errors","op":"lt","kind":"int","value":58}}],"scope":{"ancestor_relation":"port_belongs_to_device","site_relation":"device_located_at_site","tenant_relation":"site_belongs_to_tenant","ancestor_filters":[],"site_filters":[{"dimension":"site_name","op":"eq","kind":"text","value":"Site-A"}],"tenant_filters":[{"dimension":"tenant_name","op":"eq","kind":"text","value":"Tenant-A"}]}}`;
    let q = lower_json(prefix);
    if array::length(string::split(q.sql, "ik_qualification.ifOutErrors < ?")) == 2
        && array::length(string::split(q.sql, "avg(ik_qualification.ifOutErrors) < ?")) == 2 {
        True
    } else { fail!("Q0120 requires distinct raw-sample filtering and aggregate threshold", q) }
});

pub def qualified_interface_rejects_unrelated_site_chain: test::Test = test::should_fail_with(fn() {
    lower_json(`{"op":"qualify_metrics","measures":["interface_count"],"dimensions":[],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"interface_kpi_of_port","dataset":"interface_kpi","filters":[],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"interface_out_errors","op":"lt","kind":"int","value":72}}],"scope":{"ancestor_relation":"port_belongs_to_device","site_relation":"storage_device_site","tenant_relation":"site_belongs_to_tenant","ancestor_filters":[],"site_filters":[],"tenant_filters":[]}}`)
}, "scope requires a safe ancestor and a declared site-to-tenant chain");

pub def interface_sample_top_scopes_site_and_tenant_without_sample_fanout: test::Test = test::should_ok(fn() {
    let q = lower_json(interface_sample_top_intent);
    if array::length(string::split(q.sql, "PARTITION BY p.id")) == 2
        && array::length(string::split(q.sql, "p.tenantId = d.tenant_id")) == 2
        && array::length(string::split(q.sql, "ORDER BY ik.ifOutPktSpeed DESC, ik.resId ASC, ik.tenantId ASC, ik.ts ASC")) == 2
        && array::length(string::split(q.sql, "EXISTS (SELECT 1 FROM X_SITE_VIEW AS s INNER JOIN X_TENANT_VIEW AS t")) == 2
        && array::length(string::split(q.sql, "((d.projectId = s.SITE_ID) OR (d.refParentSubnet = s.SITE_ID))")) == 2
        && array::length(string::split(q.sql, "JOIN X_SITE_VIEW")) == 1
        && array::length(string::split(q.sql, "SELECT __q_0, __q_1, __q_2, __q_3 FROM")) == 2 {
        True
    } else { fail!("interface samples must be ranked before any fan-out site relationship", q) }
});

def interface_site_scope: edsl::OwnerSiteScope = {
    ancestor_relation: "port_belongs_to_device", site_relation: "device_located_at_site",
    tenant_relation: "site_belongs_to_tenant", ancestor_filters: [], site_filters: [], tenant_filters: [],
};

def scoped_interface_plan: Fn(edsl::PreparedPayload) -> qb::Plan = fn(knowledge) {
    edsl::lower_sample_top(knowledge,
        {measures: [], dimensions: [{id: "interface_tx_sample", subject: "public", input: edsl::DimensionInput::None}],
         filters: [], ordering: [], limit: None, offset: None, partition: None},
        "port", "interface_kpi_of_port",
        {dataset: "interface_kpi", start: "2024-02-01T00:00:00Z", end: "2024-03-01T00:00:00Z"},
        "interface_tx_sample", 3, Some(interface_site_scope))
};

pub def interface_scope_rejects_missing_device_tenant_key: test::Test = test::should_fail_with(fn() {
    let relations = array::map(payload.relations, fn(relation) {
        if relation.id == "port_belongs_to_device" {
            let key = match relation.key {
                edsl::RelationKey::And(keys) => match array::get(keys, 0) {
                    Some(first) => first,
                    None => fail!("missing port ancestor key"),
                },
                _ => fail!("expected compound port ancestor key"),
            };
            {...relation, key}
        } else { relation }
    });
    scoped_interface_plan({...payload, relations})
}, "sample scope ancestor relation must cover its complete declared grain");

pub def interface_scope_rejects_device_grain_extension: test::Test = test::should_fail_with(fn() {
    let entities = array::map(payload.entities, fn(entity) {
        if entity.id == "device" {
            let dataset = match entity.dataset {
                Some(spec) => Some({...spec, grain: ["id", "tenant_id", "name"]}),
                None => fail!("device must declare its grain"),
            };
            {...entity, dataset}
        } else { entity }
    });
    scoped_interface_plan({...payload, entities})
}, "sample scope ancestor relation must cover its complete declared grain");

