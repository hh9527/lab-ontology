use ontology::registry as registry;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_device as pon;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
# TODO(#47)：CPU 百分比单位沿用已授权假定，尚未确认来源元数据。
type AssumedCpuPercent = struct(Float);
def cpu_statistics: samples::Group(AssumedCpuPercent) = samples::group(
    "assumed_pon_cpu",
    AssumedCpuPercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
# memUsage 的单位／尺度没有在旧公开契约中确认。
type ReportedMemUsage = struct(Float);
# neContrlableRate 的单位／尺度没有在旧公开契约中确认。
type ReportedNeContrlableRate = struct(Float);
# nePingRespTime 的单位／尺度没有在旧公开契约中确认。
type ReportedNePingRespTime = struct(Float);
@registry::dataset(
    "source_PonDeviceKPI",
    "PonDeviceKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@registry::roles([owner])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_PonDeviceKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_PonDeviceKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_PonDeviceKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_PonDeviceKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__cpuUsage",
                AssumedCpuPercent.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceKPI.type, AssumedCpuPercent.type, "source_cpuUsage")),
            "source_PonDeviceKPI__cpuUsage",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__memUsage",
                ReportedMemUsage.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceKPI.type, ReportedMemUsage.type, "source_memUsage")),
            "source_PonDeviceKPI__memUsage",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__onlineRate",
                p::Percent.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceKPI.type, p::Percent.type, "source_onlineRate")),
            "source_PonDeviceKPI__onlineRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__neContrlableRate",
                ReportedNeContrlableRate.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceKPI.type,
                    ReportedNeContrlableRate.type,
                    "source_neContrlableRate"
                )
            ),
            "source_PonDeviceKPI__neContrlableRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__nePingRespTime",
                ReportedNePingRespTime.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PonDeviceKPI.type, ReportedNePingRespTime.type, "source_nePingRespTime")
            ),
            "source_PonDeviceKPI__nePingRespTime",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__cpuUsageEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceKPI.type, EffectiveCount.type, "source_cpuUsageEffcnt")),
            "source_PonDeviceKPI__cpuUsageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__memUsageEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceKPI.type, EffectiveCount.type, "source_memUsageEffcnt")),
            "source_PonDeviceKPI__memUsageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__onlineRateEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceKPI.type, EffectiveCount.type, "source_onlineRateEffcnt")),
            "source_PonDeviceKPI__onlineRateEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__neContrlableRateEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PonDeviceKPI.type, EffectiveCount.type, "source_neContrlableRateEffcnt")
            ),
            "source_PonDeviceKPI__neContrlableRateEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceKPI__nePingRespTimeEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PonDeviceKPI.type, EffectiveCount.type, "source_nePingRespTimeEffcnt")
            ),
            "source_PonDeviceKPI__nePingRespTimeEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::metric("source_ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            cpu_statistics,
            m::field(PonDeviceKPI.type, AssumedCpuPercent.type, "source_cpuUsage"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_cpu_usage"},
                {statistic: samples::Statistic::Max, publish: "pon_cpu_sample_max"},
                {statistic: samples::Statistic::Min, publish: "pon_cpu_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            p::Percent_statistics,
            m::field(PonDeviceKPI.type, p::Percent.type, "source_onlineRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_online_rate_avg"},
                {statistic: samples::Statistic::Min, publish: "pon_online_rate_min"},
                {statistic: samples::Statistic::Max, publish: "pon_online_rate_max"}
            ]
        ),
    ]
)
@registry::relations(relations)
type PonDeviceKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_PonDeviceKPI__resId")
    source_resId: pon::PonId,
    @m::column("tenantId")
    @g::exact("source_PonDeviceKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_PonDeviceKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_PonDeviceKPI__projectId")
    source_projectId: String,
    @m::column("cpuUsage")
    source_cpuUsage: AssumedCpuPercent,
    @m::column("memUsage")
    source_memUsage: ReportedMemUsage,
    @m::column("onlineRate")
    source_onlineRate: p::Percent,
    @m::column("neContrlableRate")
    source_neContrlableRate: ReportedNeContrlableRate,
    @m::column("nePingRespTime")
    source_nePingRespTime: ReportedNePingRespTime,
    @m::column("cpuUsageEffcnt")
    source_cpuUsageEffcnt: EffectiveCount,
    @m::column("memUsageEffcnt")
    source_memUsageEffcnt: EffectiveCount,
    @m::column("onlineRateEffcnt")
    source_onlineRateEffcnt: EffectiveCount,
    @m::column("neContrlableRateEffcnt")
    source_neContrlableRateEffcnt: EffectiveCount,
    @m::column("nePingRespTimeEffcnt")
    source_nePingRespTimeEffcnt: EffectiveCount,
};
def dataset: m::Dataset(PonDeviceKPI) = registry::dataset_of(PonDeviceKPI.type);
def owner: m::Role(PonDeviceKPI) = m::role(
    dataset,
    pon::entity,
    "owner",
    False,
    [
        m::identity_part(
            m::field(PonDeviceKPI.type, pon::PonId.type, "source_resId"),
            m::field(pon::Identity.type, pon::PonId.type, "id")
        )
    ]
);

def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElementAssociationPonDeviceKPI",
        r::endpoint(pon::dataset.row, pon::subject.id),
        r::endpoint(dataset.row, owner.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{PonDeviceKPI};
