use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::dict as dict;
use std::value::{ Value };

def as_object: Fn(Value) -> Dict(Value) = fn(value) {
    match value {
        Value::Object(obj) => obj,
        _ => fail!("intent must be an object", value),
    }
};

def as_array: Fn(Value) -> Array(Value) = fn(value) {
    match value {
        Value::Array(items) => items,
        _ => fail!("intent field must be an array", value),
    }
};

def as_string: Fn(Value) -> String = fn(value) {
    match value {
        Value::String(text) => text,
        _ => fail!("intent field must be a string", value),
    }
};

def field: Fn(Dict(Value), String) -> Value = fn(obj, key) {
    match dict::get(obj, key) {
        Some(value) => value,
        None => fail!("intent field is missing", obj, key),
    }
};

def array_opt: Fn(Dict(Value), String) -> Array(Value) = fn(obj, key) {
    match dict::get(obj, key) {
        None => [],
        Some(Value::None) => [],
        Some(value) => as_array(value),
    }
};

def graph_keys: Fn(Dict(Value), String, Array(String)) -> () = fn(obj, context, allowed) {
    match array::find(dict::keys(obj), fn(key) {
        !array::any(allowed, fn(ok) { ok == key })
    }) {
        Some(key) => fail!("graph intent contains unsupported key", context, key),
        None => (),
    }
};

def parse_op: Fn(String) -> edsl::FilterOp = fn(op) {
    match op {
        "eq" => edsl::FilterOp::Eq,
        "ne" => edsl::FilterOp::Ne,
        "gt" => edsl::FilterOp::Gt,
        "ge" => edsl::FilterOp::Ge,
        "lt" => edsl::FilterOp::Lt,
        "le" => edsl::FilterOp::Le,
        "contains" => edsl::FilterOp::Contains,
        "not_contains" => edsl::FilterOp::NotContains,
        "starts_with" => edsl::FilterOp::StartsWith,
        "ends_with" => edsl::FilterOp::EndsWith,
        _ => fail!("unsupported filter operator", op),
    }
};

def parse_input: Fn(String, Value) -> edsl::FilterInput = fn(kind, value) {
    match kind {
        "text" => match value {
            Value::String(text) => edsl::FilterInput::Text(text),
            _ => fail!("text filter requires a string value", value),
        },
        "int" => match value {
            Value::Int(number) => edsl::FilterInput::Int(number),
            _ => fail!("int filter requires an integer value", value),
        },
        "number" => match value {
            Value::Int(number) => edsl::FilterInput::Int(number),
            Value::Float(number) => edsl::FilterInput::Number(number),
            _ => fail!("number filter requires a numeric value", value),
        },
        "bool" => match value {
            Value::True => edsl::FilterInput::Bool(True),
            Value::False => edsl::FilterInput::Bool(False),
            _ => fail!("bool filter requires a boolean value", value),
        },
        _ => fail!("unsupported filter value kind", kind),
    }
};

def parse_graph_node: Fn(Value) -> edsl::GraphNode = fn(item) {
    let obj = as_object(item);
    graph_keys(obj, "node", ["id", "entity"]);
    {id: as_string(field(obj, "id")), entity: as_string(field(obj, "entity"))}
};

def parse_graph_edge: Fn(Value) -> edsl::GraphEdge = fn(item) {
    let obj = as_object(item);
    graph_keys(obj, "edge", ["relation", "from", "to"]);
    {relation: as_string(field(obj, "relation")),
        from: as_string(field(obj, "from")), to: as_string(field(obj, "to"))}
};

def parse_graph_filter: Fn(String, Value) -> edsl::GraphFilter = fn(subject, item) {
    let obj = as_object(item);
    graph_keys(obj, "filter", ["node", "dimension", "op", "kind", "value"]);
    let request: edsl::FilterRequest = {
        id: as_string(field(obj, "dimension")), subject,
        op: parse_op(as_string(field(obj, "op"))),
        input: parse_input(as_string(field(obj, "kind")), field(obj, "value")),
    };
    {node: as_string(field(obj, "node")), request}
};

def parse_graph_any_of: Fn(Value) -> edsl::GraphAnyOf = fn(item) {
    let obj = as_object(item);
    graph_keys(obj, "any_of", ["node", "dimension", "kind", "values"]);
    let kind = as_string(field(obj, "kind"));
    {node: as_string(field(obj, "node")), dimension: as_string(field(obj, "dimension")),
        values: array::map(as_array(field(obj, "values")), fn(value) { parse_input(kind, value) })}
};

def parse_graph_having: Fn(Value) -> edsl::GraphHaving = fn(item) {
    let obj = as_object(item);
    graph_keys(obj, "aggregate threshold", ["node", "measure", "op", "kind", "value"]);
    {node: as_string(field(obj, "node")), measure: as_string(field(obj, "measure")),
        op: parse_op(as_string(field(obj, "op"))),
        threshold: parse_input(as_string(field(obj, "kind")), field(obj, "value"))}
};

def parse_graph_existence: Fn(String, Value) -> edsl::GraphExist = fn(subject, item) {
    let obj = as_object(item);
    graph_keys(obj, "existence", ["anchor", "nodes", "edges", "constraints", "filters", "any_of", "having", "negated"]);
    let negated = match dict::get(obj, "negated") {
        None => False,
        Some(Value::True) => True,
        Some(Value::False) => False,
        Some(value) => fail!("graph existence negated must be boolean", value),
    };
    {anchor: as_string(field(obj, "anchor")),
        nodes: array::map(as_array(field(obj, "nodes")), parse_graph_node),
        edges: array::map(as_array(field(obj, "edges")), parse_graph_edge),
        constraints: array::map(array_opt(obj, "constraints"), parse_graph_edge),
        filters: array::map(array_opt(obj, "filters"), fn(value) { parse_graph_filter(subject, value) }),
        any_of: array::map(array_opt(obj, "any_of"), parse_graph_any_of),
        having: array::map(array_opt(obj, "having"), parse_graph_having),
        negated}
};

def lower_graph_object: Fn(qb::BuildCtx, edsl::PreparedPayload, String, Dict(Value)) -> (qb::BuildCtx, edsl::GraphRequest, qb::Plan) = fn(ctx, payload, subject, obj) {
    if as_string(field(obj, "op")) != "graph" { fail!("aggregate pair operands must be graph intents") }
    else {
        graph_keys(obj, "request", ["op", "root", "row_grain", "distinct", "nodes", "edges", "constraints", "select", "measures", "measure_having", "filters", "any_of", "exists", "count", "count_value", "count_having", "count_groups", "include_empty", "group_by_identity", "top_per", "top_by_measure", "order_by", "take"]);
        let request: edsl::GraphRequest = {
            root: as_string(field(obj, "root")),
            row_grain: match dict::get(obj, "row_grain") {
                None => edsl::GraphRowGrain::Root,
                Some(Value::String("root")) => edsl::GraphRowGrain::Root,
                Some(Value::String("association")) => edsl::GraphRowGrain::Association,
                Some(value) => fail!("graph row_grain must be root or association", value),
            },
            distinct: match dict::get(obj, "distinct") {
                None => False,
                Some(Value::True) => True,
                Some(Value::False) => False,
                Some(value) => fail!("graph distinct must be boolean", value),
            },
            nodes: array::map(as_array(field(obj, "nodes")), parse_graph_node),
            edges: array::map(as_array(field(obj, "edges")), parse_graph_edge),
            constraints: array::map(array_opt(obj, "constraints"), parse_graph_edge),
            select: array::map(as_array(field(obj, "select")), fn(value) {
                let selection = as_object(value);
                graph_keys(selection, "projection", ["node", "dimension"]);
                let result: edsl::GraphSelect = {
                    node: as_string(field(selection, "node")),
                    dimension: as_string(field(selection, "dimension")),
                };
                result
            }),
            measures: array::map(array_opt(obj, "measures"), fn(value) {
                let selection = as_object(value);
                graph_keys(selection, "measure projection", ["node", "measure"]);
                let result: edsl::GraphMeasureSelect = {
                    node: as_string(field(selection, "node")),
                    measure: as_string(field(selection, "measure")),
                };
                result
            }),
            measure_having: array::map(array_opt(obj, "measure_having"), parse_graph_having),
            filters: array::map(array_opt(obj, "filters"), fn(value) { parse_graph_filter(subject, value) }),
            any_of: array::map(array_opt(obj, "any_of"), parse_graph_any_of),
            exists: array::map(array_opt(obj, "exists"), fn(value) { parse_graph_existence(subject, value) }),
            count: match dict::get(obj, "count") {
                None => None,
                Some(Value::None) => None,
                Some(value) => Some(as_string(value)),
            },
            count_value: match dict::get(obj, "count_value") {
                None => None,
                Some(Value::None) => None,
                Some(value) => do {
                    let selection = as_object(value);
                    graph_keys(selection, "count_value", ["node", "dimension"]);
                    Some({node: as_string(field(selection, "node")), dimension: as_string(field(selection, "dimension"))})
                },
            },
            count_having: match dict::get(obj, "count_having") {
                None => None,
                Some(Value::None) => None,
                Some(value) => do {
                    let threshold = as_object(value);
                    graph_keys(threshold, "count threshold", ["op", "value"]);
                    let count = match field(threshold, "value") {
                        Value::Int(n) => n,
                        other => fail!("graph count threshold must be an integer", other),
                    };
                    Some({op: parse_op(as_string(field(threshold, "op"))), threshold: count})
                },
            },
            count_groups: match dict::get(obj, "count_groups") {
                None => False,
                Some(Value::True) => True,
                Some(Value::False) => False,
                Some(value) => fail!("graph count_groups must be boolean", value),
            },
            include_empty: match dict::get(obj, "include_empty") {
                None => False,
                Some(Value::True) => True,
                Some(Value::False) => False,
                Some(value) => fail!("graph include_empty must be boolean", value),
            },
            group_by_identity: array::map(array_opt(obj, "group_by_identity"), as_string),
            take: match dict::get(obj, "take") {
                None => None,
                Some(Value::Int(n)) => Some(n),
                Some(value) => fail!("graph raw take must be an integer", value),
            },
            order_by: array::map(array_opt(obj, "order_by"), fn(value) {
                let order = as_object(value);
                graph_keys(order, "order", ["node", "dimension", "direction"]);
                let direction = match as_string(field(order, "direction")) {
                    "asc" => qb::Ordering::Asc,
                    "desc" => qb::Ordering::Desc,
                    other => fail!("graph order direction must be asc or desc", other),
                };
                {node: as_string(field(order, "node")),
                    dimension: as_string(field(order, "dimension")), direction}
            }),
            top_per: match dict::get(obj, "top_per") {
                None => None,
                Some(Value::None) => None,
                Some(value) => do {
                    let top = as_object(value);
                    graph_keys(top, "top-per", ["owner", "sample", "rank", "take"]);
                    let take = match field(top, "take") {
                        Value::Int(n) => n,
                        other => fail!("graph top-per take must be an integer", other),
                    };
                    Some({owner: as_string(field(top, "owner")), sample: as_string(field(top, "sample")),
                        rank: as_string(field(top, "rank")), take})
                },
            },
            top_by_measure: match dict::get(obj, "top_by_measure") {
                None => None,
                Some(Value::None) => None,
                Some(value) => do {
                    let top = as_object(value);
                    graph_keys(top, "aggregate top", ["node", "measure", "direction", "take"]);
                    let direction = match as_string(field(top, "direction")) {
                        "asc" => qb::Ordering::Asc,
                        "desc" => qb::Ordering::Desc,
                        other => fail!("graph aggregate top direction must be asc or desc", other),
                    };
                    let take = match field(top, "take") {
                        Value::Int(n) => n,
                        other => fail!("graph aggregate top take must be an integer", other),
                    };
                    Some({node: as_string(field(top, "node")), measure: as_string(field(top, "measure")),
                        direction, take})
                },
            },
        };
        let lowered = edsl::lower_graph(ctx, payload, subject, request);
        (lowered.0, request, lowered.1)
    }
};

def paired_graph_shape: Fn(edsl::GraphRequest) -> Bool = fn(request) {
    array::get(request.group_by_identity, 0) == Some(request.root)
        && array::length(request.measures) == 1 && request.count == None && request.count_value == None
        && request.count_having == None && !request.count_groups && !request.distinct
        && !request.include_empty && request.top_per == None && request.top_by_measure == None
        && array::length(request.order_by) == 0 && request.take == None
};

def paired_group_operand: Fn(qb::Plan) -> qb::Plan = fn(plan) {
    let keys = array::map(array::enumerate(plan.grouping), fn(entry) {
        qb::named_expr_item(entry.1, `__q_key_\{entry.0}`)
    });
    {...plan, projection: array::concat([plan.projection, keys])}
};

def lower_graph_pair: Fn(edsl::PreparedPayload, String, Dict(Value)) -> qb::QueryAst = fn(payload, subject, obj) {
    graph_keys(obj, "aggregate pair", ["op", "left", "right", "count_groups"]);
    let count_groups = match dict::get(obj, "count_groups") {
        None => False,
        Some(Value::True) => True,
        Some(Value::False) => False,
        Some(value) => fail!("aggregate pair count_groups must be boolean", value),
    };
    let left = lower_graph_object(qb::build_context(), payload, subject, as_object(field(obj, "left")));
    let right = lower_graph_object(qb::independent_query_scope(left.0), payload, subject, as_object(field(obj, "right")));
    if !paired_graph_shape(left.1) || !paired_graph_shape(right.1) {
        fail!("aggregate pair operands each require one measure, grouping beginning with root identity, and no row ordering or count; qualify each population inside its own graph")
    } else if left.1.root != right.1.root
        || edsl::graph_node(left.1, left.1.root).entity != edsl::graph_node(right.1, right.1.root).entity {
        fail!("aggregate pair roots must name the same entity instance on both sides", left.1.root, right.1.root)
    } else if left.1.select != right.1.select {
        fail!("aggregate pair operands must select the same dimensions in the same order", left.1.select, right.1.select)
    } else if left.1.group_by_identity != right.1.group_by_identity
        || !array::all(left.1.group_by_identity, fn(id) {
            edsl::graph_node(left.1, id).entity == edsl::graph_node(right.1, id).entity
        }) || !array::all(left.1.select, fn(item) {
            edsl::graph_node(left.1, item.node).entity == edsl::graph_node(right.1, item.node).entity
        }) {
        fail!("aggregate pair operands must use the same node instance ids and entities for every grouped and selected node; align group_by_identity and node ids", left.1.group_by_identity, right.1.group_by_identity)
    } else if left.2.grouping != right.2.grouping {
        fail!("aggregate pair operands must group by the same complete declared identities", left.1.group_by_identity)
    } else {
        let keys = array::map(array::enumerate(left.2.grouping), fn(entry) { `__q_key_\{entry.0}` });
        let visible = array::map(left.1.select, fn(item) { `\{item.node}_\{item.dimension}` });
        let left_measure = left.1.measures[0];
        let right_measure = right.1.measures[0];
        let joined: qb::JoinedGroups = {
            left: paired_group_operand(left.2), right: paired_group_operand(right.2), keys,
            left_outputs: array::push(visible, `\{left_measure.node}_\{left_measure.measure}`),
            right_outputs: [`\{right_measure.node}_\{right_measure.measure}`],
        };
        let plan = if count_groups { qb::QueryPlan::JoinedGroupCount(joined) }
            else { qb::QueryPlan::JoinedGroups(joined) };
        qb::finish(right.0, qb::validate_query_plan(plan))
    }
};

def lower_intent_ast: Fn(edsl::PreparedPayload, String, Value) -> qb::QueryAst = fn(payload, subject, intent) {
    let obj = as_object(intent);
    let op = as_string(field(obj, "op"));
    if op == "graph" {
        let lowered = lower_graph_object(qb::build_context(), payload, subject, obj);
        let request = lowered.1;
        let plan = if request.count_groups { qb::QueryPlan::GroupCount(lowered.2) }
            else if request.distinct { qb::QueryPlan::DistinctRows(lowered.2) }
            else { qb::QueryPlan::Rows(lowered.2) };
        qb::finish(lowered.0, qb::validate_query_plan(plan))
    } else if op == "graph_pair" { lower_graph_pair(payload, subject, obj) }
    else { fail!("unsupported intent op; use graph or graph_pair with named nodes and relations", op) }
};

type ToQuery = Fn(qb::QueryAst) -> qb::Query;

def query_intent_lower_factory: Fn(edsl::PreparedPayload, String, ToQuery) -> Fn(Value) -> qb::Query = fn(payload, subject, to_query) {
    fn(intent) { to_query(lower_intent_ast(payload, subject, intent)) }
};

def query_intent_ast_factory: Fn(edsl::PreparedPayload, String) -> Fn(Value) -> qb::QueryAst = fn(payload, subject) {
    fn(intent) { lower_intent_ast(payload, subject, intent) }
};

pub use self::{ ToQuery, query_intent_lower_factory, query_intent_ast_factory };
