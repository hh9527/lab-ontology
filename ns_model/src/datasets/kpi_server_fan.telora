            groups::group_9,
            m::optional_field(kpi_server_fan.type, units::Percent.type, "speed_percentage"),
            [
                {statistic: sample::Statistic::Mean, publish: "sf_speed_percentage"},
                {statistic: sample::Statistic::Max, publish: "sf_speed_percentage_max"},
                {statistic: sample::Statistic::Min, publish: "sf_speed_percentage_min"}
            ]
        )
    ]
)
@registry::metric("ts")
