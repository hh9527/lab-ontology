# RFC 0002 阶段 A：独立的对象身份、记录粒度和角色映射。
# 此入口只准备声明，不连接数据库，不授予查询或图遍历能力。
use std::array as array;
use std::dict as dict;
use std::pipeline as pipeline;
use std::type_memorizer as memo;
use std::type_desc as td;

type Entity(Identity) = struct {
    id: String,
    identity: Type
};
type Dataset(Row) = struct {
    id: String,
    source: String,
    row: Type,
    grain: Array(String)
};
type Field(Owner, Value) = struct {
    owner: Type,
    index: Int,
    value: Type,
    name: String,
    nullable: Bool
};
type IdentityPart(Row, Identity) = struct {
    row: Type,
    identity: Type,
    source: String,
    target: String,
    source_index: Int,
    target_index: Int,
    value: Type,
    nullable: Bool,
    raw: Option(Type),
};
type Role(Row) = struct {
    row: Type,
    id: String,
    entity: String,
    identity: Type,
    optional: Bool,
    parts: Array(Part),
};
type Part = struct {
    source: String,
    target: String,
    source_index: Int,
    target_index: Int,
    value: Type,
    nullable: Bool,
    raw: Option(Type)
};
type PreparedDataset = struct {
    id: String,
    source: String,
    row: Type,
    grain: Array(String),
    roles: Array(PreparedRole),
};
type PreparedRole = struct {
    row: Type,
    id: String,
    entity: String,
    identity: Type,
    optional: Bool,
    parts: Array(Part),
};

def resolved: Fn(Type) -> Type = fn(ty) {
    if td::kind(ty) == td::TypeDescKind::Ref {
        match td::resolve(ty) {
            Ok(value) => value,
            Err(error) => fail!(error.message, ty)
        }
    } else {
        ty
    }
};
# 类型的字段列表和名称索引只构造一次，局部检查复用同一份元数据。
def field_lists: memo::TypeMemorizer(Array(td::FieldDesc)) = memo::type_memorizer(td::fields);
def fields_of: Fn(Type) -> Array(td::FieldDesc) = fn(owner) {
    memo::computed_with_type(field_lists, owner)
};
def field_indexes: memo::TypeMemorizer(Dict(td::FieldDesc)) = memo::type_memorizer(
    fn(owner) {
        pipeline::run(
            pipeline::from_array(fields_of(owner)) |> pipeline::collect_dict(
                fn(field) {
                    field.name
                },
                fn(field) {
                    field
                }
            )
        )
    }
);
def field_info: Fn(Type, String) -> Option(td::FieldDesc) = fn(owner, name) {
    dict::get(memo::computed_with_type(field_indexes, owner), name)
};
def field_type: Fn(Type, String) -> Type = fn(owner, name) {
    match field_info(owner, name) {
        Some(field) => field.ty,
        None => fail!("typed model field does not exist", owner, name)
    }
};

# 只接受标量或其 newtype 包装；Option 不作为全行身份成员。
def identity_value: Fn(Type) -> Bool = fn(ty) {
    let value = resolved(ty);
    match td::kind(value) {
        td::TypeDescKind::Int => True,
        td::TypeDescKind::String => True,
        td::TypeDescKind::Newtype => identity_value(td::children(value)[0]),
        _ => False,
    }
};

def check_identity: Fn(Type) -> Bool = fn(identity) {
    let fields = fields_of(identity);
    if td::kind(resolved(identity)) != td::TypeDescKind::Struct || array::length(fields) == 0 {
        fail!("entity identity must be a nonempty record", identity)
    } else if !array::all(
        fields,
        fn(field) {
            identity_value(field.ty)
        }
    ) {
        fail!("entity identity requires non-null integer or text business values", identity)
    } else {
        True
    }
};

def identity_checks: memo::TypeMemorizer(Bool) = memo::type_memorizer(check_identity);
def validate_identity: Fn(Type) -> () = fn(identity) {
    memo::computed_with_type(identity_checks, identity);
    ()
};

# 名称和 grain 去重由 property 参数边界完成；此处仅准备 Row 的类型约束。
def prepare_dataset_row: Fn(Type, Array(String)) -> Array(Int) = fn(row, grain) {
    if td::kind(resolved(row)) != td::TypeDescKind::Struct {
        fail!("dataset row must be a record", row)
    } else {
        ()
    };
    array::map(
        grain,
        fn(name) {
            let field = match field_info(row, name) {
                Some(field) => field,
                None => fail!("dataset grain field does not exist", row, name)
            };
            if !identity_value(field.ty) {
                fail!("dataset grain must use non-null identity values", row, name)
            } else {
                field.index
            }
        }
    )
};
pub use self::{prepare_dataset_row};

def field: for(Owner, Value) Fn(TypeOf(Owner), TypeOf(Value), String) -> Field(Owner, Value) = fn(
    owner,
    value,
    name
) {
    let info = match field_info(owner, name) {
        Some(info) => info,
        None => fail!("typed model field does not exist", owner, name)
    };
    if info.ty != value {
        fail!("typed model field has a different nominal type", owner, name, value)
    } else {
        ()
    };
    {owner, index: info.index, value, name, nullable: False}
};
def optional_field: for(Owner, Value) Fn(
    TypeOf(Owner),
    TypeOf(Value),
    String
) -> Field(Owner, Value) = fn(owner, value, name) {
    let info = match field_info(owner, name) {
        Some(info) => info,
        None => fail!("typed model field does not exist", owner, name)
    };
    if info.ty != Option(Value).type {
        fail!("typed model optional field has a different nominal type", owner, name, value)
    } else {
        ()
    };
    {owner, index: info.index, value, name, nullable: True}
};

# Value 是共享的类型形参，编译期约束映射两侧的名义类型一致。
def identity_part: for(Row, Identity, Value) Fn(
    Field(Row, Value),
    Field(Identity, Value)
) -> IdentityPart(Row, Identity) = fn(source, target) {
    {
        row: source.owner,
        identity: target.owner,
        source: source.name,
        target: target.name,
        source_index: source.index,
        target_index: target.index,
        value: source.value,
        nullable: source.nullable,
        raw: None
    }
};

# 仅原始整数/文本引用可显式采用目标身份的名义类型；编码不变，不允许名义 ID 之间隐式互转。
def identity_storage: Fn(Type) -> Type = fn(ty) {
    let value = resolved(ty);
    if td::kind(value) == td::TypeDescKind::Newtype {
        identity_storage(td::children(value)[0])
    } else {
        value
    }
};
def validate_reference: Fn(Type, Type) -> () = fn(raw, target) {
    if (raw != Int.type && raw != String.type) || identity_storage(target) != raw {
        fail!(
            "explicit identity reference requires raw integer or text with unchanged storage",
            raw,
            target
        )
    } else {
        ()
    }
};
def reference_part: for(Row, Identity, Raw, Nominal) Fn(
    Field(Row, Raw),
    Field(Identity, Nominal)
) -> IdentityPart(Row, Identity) = fn(source, target) {
    validate_reference(Raw.type, Nominal.type);
    {
        row: source.owner,
        identity: target.owner,
        source: source.name,
        target: target.name,
        source_index: source.index,
        target_index: target.index,
        value: target.value,
        nullable: source.nullable,
        raw: Some(source.value)
    }
};

def role: for(Row, Identity) Fn(
    Dataset(Row),
    Entity(Identity),
    String,
    Bool,
    Array(IdentityPart(Row, Identity))
) -> Role(Row) = fn(dataset, entity, id, optional, parts) {
    if id == "" {
        fail!("role id must be nonempty", id)
    } else {
        ()
    };
    let targets = pipeline::run(
        pipeline::from_array(parts) |> pipeline::unique_by(
            fn(part) {
                part.target
            }
        ) |> pipeline::collect()
    );
    let sources = pipeline::run(
        pipeline::from_array(targets) |> pipeline::unique_by(
            fn(part) {
                part.source
            }
        ) |> pipeline::collect()
    );
    if array::length(sources) != array::length(fields_of(Identity.type)) {
        fail!("role mapping must cover the complete identity exactly once", Identity.type)
    } else {
        ()
    };
    if !optional && array::any(
        sources,
        fn(part) {
            part.nullable
        }
    ) {
        fail!("nullable identity input requires an optional role", id)
    } else {
        ()
    };
    let ordered = array::flat_map(
        fields_of(Identity.type),
        fn(field) {
            array::filter(
                sources,
                fn(part) {
                    part.target_index == field.index
                }
            )
        }
    );
    {
        row: Row.type,
        id,
        entity: entity.id,
        identity: Identity.type,
        optional,
        parts: array::map(
            ordered,
            fn(part) {
                {
                    source: part.source,
                    target: part.target,
                    source_index: part.source_index,
                    target_index: part.target_index,
                    value: part.value,
                    nullable: part.nullable,
                    raw: part.raw
                }.ty!(Part)
            }
        )
    }
};

def prepare_roles: Fn(Type, Array(PreparedRole)) -> Array(PreparedRole) = fn(row, roles) {
    pipeline::run(
        pipeline::from_array(roles) |> pipeline::unique_by(
            fn(role) {
                role.id
            }
        ) |> pipeline::map(
            fn(role) {
                if role.row != row {
                    fail!("role mapping belongs to another dataset", role.id)
                } else {
                    role
                }
            }
        ) |> pipeline::collect()
    )
};
pub use self::{
    Entity,
    Dataset,
    Field,
    IdentityPart,
    Role,
    Part,
    PreparedDataset,
    PreparedRole,
    field,
    optional_field,
    reference_part,
    identity_part,
    role,
    fields_of,
    field_info
};

pub use self::{validate_identity};

# 字段声明直接承载异名源列映射；同名列使用字段名。
pub use crate::ontology::{column};

pub use self::{prepare_roles, field_type};
