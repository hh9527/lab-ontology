pub def router_count_uses_declared_sample_averages_for_both_kpi_thresholds: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph_pair","count_groups":true,
        "left":{"op":"graph","root":"device",
            "nodes":[{"id":"device","entity":"device"},{"id":"memory","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"memory","to":"device"}],
            "select":[],"measures":[{"node":"memory","measure":"memory_usage"}],"group_by_identity":["device"],
            "filters":[{"node":"device","dimension":"device_class","op":"eq","kind":"text","value":"router"},
                       {"node":"memory","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                       {"node":"memory","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}],
            "measure_having":[{"node":"memory","measure":"memory_usage","op":"ge","kind":"number","value":47.5}]},
        "right":{"op":"graph","root":"device",
            "nodes":[{"id":"device","entity":"device"},{"id":"ports","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"ports","to":"device"}],
            "select":[],"measures":[{"node":"ports","measure":"port_count_sample_avg"}],"group_by_identity":["device"],
            "filters":[{"node":"ports","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                       {"node":"ports","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}],
            "measure_having":[{"node":"ports","measure":"port_count_sample_avg","op":"ge","kind":"number","value":48.0}]}}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "SELECT count(1) FROM (")
        && string::contains(sq.sql, "avg(memory.memUsage) AS memory_memory_usage")
        && string::contains(sq.sql, "avg(ports.portCount) AS ports_port_count_sample_avg")
        && !string::contains(sq.sql, "sum(ports.portCount)")
        && string::contains(sq.sql, "device.classification = ?1 OR device.classification = ?2")
        && string::contains(sq.sql, "__q_left.__q_key_1 = __q_right.__q_key_1")
        && string::contains(pg.sql, "avg(\"ports\".\"portCount\")")
        && array::any(sq.bindings, fn(value) { value == qb::Val::Float(47.5) })
        && array::any(sq.bindings, fn(value) { value == qb::Val::Float(48.0) })
        && sq.bindings == pg.bindings { True }
    else { fail!(`Q0091-shaped count changed declared AVG meaning or owner identity: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

pub def latest_device_kpi_returns_one_whole_sample_per_site_qualified_owner: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"sample","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"},
                  {"node":"sample","dimension":"running_port_sample"},
                  {"node":"sample","dimension":"admin_port_sample"},
                  {"node":"sample","dimension":"device_kpi_ts_raw"}],
        "filters":[{"node":"device","dimension":"device_class","op":"eq","kind":"text","value":"firewall"}],
        "exists":[{"anchor":"device","nodes":[{"id":"site","entity":"site"},{"id":"tenant","entity":"tenant"}],
            "edges":[{"relation":"device_located_at_site","from":"device","to":"site"},
                     {"relation":"device_belongs_to_tenant","from":"device","to":"tenant"}],
            "constraints":[{"relation":"site_belongs_to_tenant","from":"site","to":"tenant"}],
            "filters":[{"node":"site","dimension":"site_name","op":"eq","kind":"text","value":"site A"}]}],
        "top_per":{"owner":"device","sample":"sample","rank":"device_kpi_ts_raw","take":1}}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "sample.operStatusCount AS sample_running_port_sample")
        && string::contains(sq.sql, "sample.adminStatusCount AS sample_admin_port_sample")
        && string::contains(sq.sql, "row_number() OVER (PARTITION BY device.id, device.tenant_id ORDER BY sample.ts DESC")
        && string::contains(sq.sql, "device.classification")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM X_SITE_VIEW AS site")
        && string::contains(pg.sql, "PARTITION BY \"device\".\"id\", \"device\".\"tenant_id\"")
        && string::contains(pg.sql, "\"sample\".\"ts\" DESC NULLS LAST")
        && sq.bindings == pg.bindings { True }
    else { fail!(`latest whole KPI row lost owner partition, paired fields or site qualification: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

