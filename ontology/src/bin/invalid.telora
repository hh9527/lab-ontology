# Attempts for the next-round failure scenarios (invoked from `main` so that
# best-effort evaluation surfaces each deterministic diagnostic).
def next_cases: Array(Fn() -> qb.Plan) = [
    fn() { exists_unknown_entity },
    fn() { exists_indirect_target },
    fn() { having_unrequested_measure },
    fn() { row_partition_invalid },
    fn() { row_fanout_attribute },
    fn() { text_op_non_text_input },
    fn() { exists_zero_min },
    fn() { any_of_empty_group },
    fn() { any_of_unknown_dimension },
    fn() { any_of_wrong_input },
    fn() { any_of_unauthorized },
    fn() { union_with_exists },
    fn() { union_join_other },
];

export def main: Value = do {
    # Every case must fail atomically: a healthy result would make this entry
    # an invalid "unexpected success". main consumes the attempt results so any
    # successful case (a contract regression) fails loudly instead of
    # publishing a trusted result.
    let attempts = array.map(invalid_cases, fn(req) {
        let plan: qb.Plan = edsl.lower(knowledge.payload, req);
        let _query: qb.Query = qb.transform_sqlite(plan);
        "unexpected success"
    });
    let healthy: Bool = array.all(attempts, fn(s) { s == "unexpected success" });
    let attempts2 = array.map(next_cases, fn(make) {
        let plan: qb.Plan = make();
        let _query: qb.Query = qb.transform_sqlite(plan);
        "unexpected success"
    });
    let healthy2: Bool = array.all(attempts2, fn(s) { s == "unexpected success" });
    let combined: Bool = healthy && healthy2;
    let outcome: Value = if combined { 'String("unexpected success") } else { 'String("unexpected success") };
    outcome
};
