# Fictional EnterpriseKnowledge used only by ontology regression tests.
#
# Shared by test roots within the test module tree.
# It is deliberately domain-neutral and publishes a prepared payload consumed by
# the ontology and intent regression suites.

use crate::query as qb;
use crate::ontology as edsl;

# --- Pre-bound decorator arguments (decorator calls do not re-type literals). --

def sum_agg: qb::AggregateFunction = qb::AggregateFunction::Sum;
def count_agg: qb::AggregateFunction = qb::AggregateFunction::Count;
def add_op: qb::ComputedOp = qb::ComputedOp::Add;
def sub_op: qb::ComputedOp = qb::ComputedOp::Sub;
def flag_true: Bool = True;
def flag_false: Bool = False;
def eq_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def ge_le_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Ge, edsl::FilterOp::Le];
def text_search_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Contains, edsl::FilterOp::NotContains, edsl::FilterOp::StartsWith, edsl::FilterOp::EndsWith];
def text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def int_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];
def no_ops: Array(edsl::FilterOp) = [];
def no_kinds: Array(edsl::FilterInputKind) = [];
def safe_kind: edsl::RelationKind = edsl::RelationKind::Safe;
def fanout_kind: edsl::RelationKind = edsl::RelationKind::FanOut;

# Inherent scope of TraceHead: only rows whose kind is the stable value "run".
# The explicit Array(ScopePredicate) contract gives the record literal its
# nominal ScopePredicate identity at its construction point.
def head_scope: Array(edsl::ScopePredicate) = [{field: 1, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("run")}];

# Inherent predicates of the filtered measures: mutually exclusive conditions
# over the closed TraceKind domain (kind = "run" / kind = "skip").
def run_predicate: edsl::ScopePredicate = {field: 1, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("run")};
def skip_predicate: edsl::ScopePredicate = {field: 1, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("skip")};

# Non-Timeline conditional-count predicates over the closed ApprovalStatus
# domain (approval status), proving the capability is not keyed to
# Trace/EventType names or data shapes.
def approved_predicate: edsl::ScopePredicate = {field: 1, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("approved")};
def rejected_predicate: edsl::ScopePredicate = {field: 1, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("rejected")};

# Canonical computed dimension: Substr(created_at, 1, 7). The literals are
# lowered to bound values at plan-build time; no pre-rendered SQL is stored.
def week_builder: Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr) = fn(ctx, col) {
    let start = qb::bind(ctx, qb::Val::Int(1));
    let length = qb::bind(start.0, qb::Val::Int(7));
    (length.0, qb::substr([col, start.1, length.1]))
};

# Computed dimension built from the closed query scalars qb.ScalarFunction.Instr, qb.ScalarFunction.If, edsl.FilterOp.Gt,
# qb.ScalarFunction.Sub and qb.ScalarFunction.Substr: the first whitespace-delimited segment of a text column.
# All constants stay parameterized binds; the same expression is stable across
# projection, grouping and ordering.
def head_builder: Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr) = fn(ctx, col) {
    let sep = qb::bind(ctx, qb::Val::String(" "));
    let zero = qb::bind(sep.0, qb::Val::Int(0));
    let one = qb::bind(zero.0, qb::Val::Int(1));
    let pos = qb::instr(col, sep.1);
    let found = qb::scalar(qb::ScalarFunction::Gt, [pos, zero.1]);
    let rest = qb::sub(pos, one.1);
    (one.0, qb::scalar_if(found, qb::substr([col, one.1, rest]), col))
};

# --- Entity declarations -----------------------------------------------------

# Orders are the base grain for the order measures.
# Canonical (alphabetical) field order: 0: amount (measure),
# 1: created_at (computed dimension base), 2: customer_id (relation FK),
# 3: order_id (key), 4: region (dimension).
@edsl::entity_id("orders")
@edsl::entity_source("orders", "o")
@edsl::relation(Customer.type, safe_kind, 2, 1)
type Order = struct {
    @edsl::column("order_id")
    @edsl::key(flag_true)
    @edsl::measure("OrderCount", count_agg, requires_none)
    @edsl::dimension("OrderId", flag_true, flag_false, no_ops, no_kinds)
    order_id: Int,
    @edsl::column("customer_id")
    customer_id: Int,
    @edsl::column("amount")
    @edsl::measure("OrderAmount", sum_agg, requires_none)
    amount: Float,
    @edsl::column("region")
    @edsl::dimension("OrderRegion", flag_true, flag_true, text_search_ops, text_kinds)
    region: String,
    @edsl::column("created_at")
    @edsl::computed_dimension("OrderWeek", edsl::OutputType::Text, flag_true, flag_true, ge_le_ops, text_kinds, week_builder)
    created_at: String,
};

# Customers hold the tier/name/contact dimensions reachable from orders.
# Canonical (alphabetical) field order: 0: contact (known, not authorized),
# 1: id (key), 2: name (dimension, groupable only), 3: tier (closed enum
# dimension). CustomerCount is a measure on the customer grain that requires
# Order; the Customer->Order path is fan-out-only, so requesting it fails
# atomically.
#
# CustomerTier is a closed enum value domain: its variants declare stable
# physical values and display labels; the physical "tier" column stores the
# stable values. Filters on the CustomerTier dimension accept only members of
# this domain (Eq) and unknown values fail atomically.
type CustomerTier = enum {
    @edsl::enum_value("gold", "Gold customer")
    Gold,
    @edsl::enum_value("silver", "Silver customer")
    Silver,
    @edsl::enum_value("bronze", "Bronze customer")
    Bronze,
};

@edsl::entity_id("customers")
@edsl::entity_source("customers", "c")
@edsl::relation(Order.type, fanout_kind, 1, 2)
type Customer = struct {
    @edsl::column("contact")
    @edsl::dimension("CustomerContact", flag_false, flag_false, no_ops, no_kinds)
    contact: String,
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("CustomerCount", count_agg, requires_order)
    @edsl::measure_description("CustomerCount", "Customers with orders", "Counts customers after an explicit order existence qualification")
    id: Int,
    @edsl::column("name")
    @edsl::dimension("CustomerName", flag_true, flag_false, no_ops, no_kinds)
    name: String,
    @edsl::column("tier")
    @edsl::dimension("CustomerTier", flag_true, flag_true, eq_ops, text_kinds)
    tier: CustomerTier,
};

# Items are an item-grain entity whose measures carry Order (and Customer)
# as required entities, forcing grain-safe joins even without dimensions.
# Canonical (alphabetical) field order: 0: amount (measure), 1: id (key),
# 2: order_id (relation FK).
@edsl::entity_id("items")
@edsl::entity_source("items", "i")
@edsl::relation(Order.type, safe_kind, 2, 3)
type Item = struct {
    @edsl::column("amount")
    @edsl::measure("ItemAmount", sum_agg, requires_order)
    amount: Float,
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("ItemQty", count_agg, requires_order_customer)
    id: Int,
    @edsl::column("order_id")
    order_id: Int,
};

# Traces are a standalone grain demonstrating the closed computed-expression
# and scope mechanisms: TraceHead is a computed dimension over `label` whose
# inherent scope restricts rows to kind=run. Callers selecting TraceHead get
# the scope for free; a contradictory user filter fails atomically.
# Canonical (alphabetical) field order: 0: id (key), 1: kind (enum dimension),
# 2: label (computed dimension base), 3: owner (dimension).
type TraceKind = enum {
    @edsl::enum_value("run", "Run event")
    Run,
    @edsl::enum_value("skip", "Skip event")
    Skip,
};

@edsl::entity_id("traces")
@edsl::entity_source("traces", "t")
type Trace = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("TraceCount", count_agg, requires_none)
    @edsl::filtered_measure("TraceRunCount", count_agg, requires_none, run_predicate)
    @edsl::filtered_measure("TraceSkipCount", count_agg, requires_none, skip_predicate)
    @edsl::computed_measure("TraceTotal", add_op, "TraceRunCount", "TraceSkipCount")
    @edsl::computed_measure("TraceDelta", sub_op, "TraceRunCount", "TraceSkipCount")
    id: Int,
    @edsl::column("kind")
    @edsl::dimension("TraceKind", flag_true, flag_true, eq_ops, text_kinds)
    kind: TraceKind,
    @edsl::column("label")
    @edsl::computed_dimension("TraceHead", edsl::OutputType::Text, flag_true, flag_true, eq_ops, text_kinds, head_builder)
    @edsl::scope(head_scope)
    label: String,
    @edsl::column("owner")
    @edsl::dimension("TraceOwner", flag_true, flag_true, eq_ops, text_kinds)
    owner: String,
};

# Approvals demonstrate the conditional-count / computed-net capability in a
# non-Timeline domain (approval status), proving it is not hardcoded to
# Trace/EventType names or shapes. Both qb.ScalarFunction.Add and qb.ScalarFunction.Sub go through the public
# filtered/computed lowering path.
# Canonical (alphabetical) field order: 0: id (key), 1: status (enum
# dimension), 2: subject (dimension).
type ApprovalStatus = enum {
    @edsl::enum_value("approved", "Approved")
    Approved,
    @edsl::enum_value("rejected", "Rejected")
    Rejected,
};

@edsl::entity_id("approvals")
@edsl::entity_source("approvals", "a")
type Approval = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("ApprovalCount", count_agg, requires_none)
    @edsl::filtered_measure("ApprovalApprovedCount", count_agg, requires_none, approved_predicate)
    @edsl::filtered_measure("ApprovalRejectedCount", count_agg, requires_none, rejected_predicate)
    @edsl::computed_measure("ApprovalNet", sub_op, "ApprovalApprovedCount", "ApprovalRejectedCount")
    @edsl::computed_measure("ApprovalTotal", add_op, "ApprovalApprovedCount", "ApprovalRejectedCount")
    id: Int,
    @edsl::column("status")
    @edsl::dimension("ApprovalStatus", flag_true, flag_true, eq_ops, text_kinds)
    status: ApprovalStatus,
    @edsl::column("subject")
    @edsl::dimension("ApprovalSubject", flag_true, flag_true, eq_ops, text_kinds)
    subject: String,
};

# Device remains a plain entity used by non-JSON model checks.
@edsl::entity_id("devices")
@edsl::entity_source("devices", "d")
type Device = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("DeviceCount", count_agg, requires_none)
    id: Int,
    @edsl::column("owner")
    @edsl::dimension("DeviceOwner", flag_true, flag_true, eq_ops, text_kinds)
    owner: String,
};

# Domain-neutral one-to-many Parent -> Child pair. Both directions of the same
# foreign key are declared (Parent -> Child fan-out and Child -> Parent safe) to
# prove build_root is cycle-safe; existence filters never join the fan-out edge,
# so subject counts are not amplified by child rows.
# Canonical (alphabetical) field order: 0: id (key/measure).
@edsl::entity_id("parents")
@edsl::entity_source("parents", "p")
@edsl::relation(Child.type, fanout_kind, 0, 2)
type Parent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("ParentCount", count_agg, requires_none)
    id: Int,
};

# Canonical (alphabetical) field order: 0: id (key/measure), 1: name
# (dimension), 2: parent_id (FK to Parent).
@edsl::entity_id("children")
@edsl::entity_source("children", "k")
@edsl::relation(Parent.type, safe_kind, 2, 0)
type Child = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("ChildCount", count_agg, requires_none)
    id: Int,
    @edsl::column("name")
    @edsl::dimension("ChildName", flag_true, flag_true, text_search_ops, text_kinds)
    name: String,
    @edsl::column("parent_id")
    parent_id: Int,
};

# Domain-neutral union (multi-source) entity: two item tables with the same
# logical fields but genuinely different physical column names are merged under
# one logical alias. Branch A exposes the logical names directly; branch B maps
# group_id/item_id/owner_id to category_key/resource_key/account_key and is
# restricted to kind = retail rows by a fixed branch filter. The outer query
# treats MergedItem as one logical entity (no physical source, no join, no
# EXISTS).
# Canonical (alphabetical) field order: 0: group_id (dimension), 1: item_id
# (key/measure), 2: kind (dimension), 3: owner_id (dimension).
def merged_item_branch_a_cols: Array(edsl::UnionColumnDecl) = [
    { field: 0, column: "group_id" },
    { field: 1, column: "item_id" },
    { field: 2, column: "kind" },
    { field: 3, column: "owner_id" },
];

def merged_item_branch_b_cols: Array(edsl::UnionColumnDecl) = [
    { field: 0, column: "category_key" },
    { field: 1, column: "resource_key" },
    { field: 2, column: "kind" },
    { field: 3, column: "account_key" },
];

def merged_item_branches: Array(edsl::UnionBranchDecl) = [
    { table: "items_a", alias: "a", columns: merged_item_branch_a_cols, filter: None },
    { table: "items_b", alias: "b", columns: merged_item_branch_b_cols, filter: Some({ field: 2, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("retail") }) },
];

@edsl::entity_id("merged_items")
@edsl::union_source("u", merged_item_branches)
type MergedItem = struct {
    @edsl::column("group_id")
    @edsl::dimension("ItemGroup", flag_true, flag_true, eq_ops, int_kinds)
    group_id: Int,
    @edsl::column("item_id")
    @edsl::key(flag_true)
    @edsl::measure("ItemCount", count_agg, requires_none)
    item_id: Int,
    @edsl::column("kind")
    @edsl::dimension("ItemKind", flag_true, flag_true, eq_ops, text_kinds)
    kind: String,
    @edsl::column("owner_id")
    @edsl::dimension("ItemOwner", flag_true, flag_true, eq_ops, int_kinds)
    owner_id: Int,
};

# Sites are the stable owner (`via`) of Components: every Component belongs to
# exactly one Site through a grain-safe forward relation, and a Site may carry
# many Alarms. Component -> Site -> Alarm is the explicitly declared bounded
# two-hop correlated existence: a component row is kept when its site owns at
# least one alarm. Existence never joins the Site -> Alarm fan-out edge, so the
# component grain is never amplified.
# Canonical (alphabetical) field order: 0: id (key/measure).
@edsl::entity_id("sites")
@edsl::entity_source("sites", "s")
@edsl::relation(Alarm.type, fanout_kind, 0, 2)
type Site = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("SiteCount", count_agg, requires_none)
    id: Int,
};

# Canonical (alphabetical) field order: 0: id (key/measure), 1: site_id (FK).
@edsl::entity_id("components")
@edsl::entity_source("components", "m")
@edsl::relation(Site.type, safe_kind, 1, 0)
@edsl::exists_route(Site.type, Alarm.type)
type Component = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("ComponentCount", count_agg, requires_none)
    id: Int,
    @edsl::column("site_id")
    site_id: Int,
};

# Canonical (alphabetical) field order: 0: id (key/measure), 1: level (enum-free
# Int dimension usable as an inner existence filter), 2: site_id (FK to Site).
@edsl::entity_id("alarms")
@edsl::entity_source("alarms", "al")
type Alarm = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("AlarmCount", count_agg, requires_none)
    id: Int,
    @edsl::column("level")
    @edsl::dimension("AlarmLevel", flag_true, flag_true, eq_ops, int_kinds)
    level: Int,
    @edsl::column("site_id")
    site_id: Int,
};

# Members are the participants (filter target) of the Pair dual-endpoint hub:
# a Pair row binds two Member endpoints through its left/right role columns, and
# a hub row is kept when either endpoint matches a Member key.  Member fields
# also carry a kind attribute usable as a participant filter on the hub query.
# Canonical (alphabetical) field order: 0: id (key/measure), 1: kind
# (dimension).
@edsl::entity_id("members")
@edsl::entity_source("members", "mb")
type Member = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("MemberCount", count_agg, requires_none)
    id: Int,
    @edsl::column("kind")
    @edsl::dimension("MemberKind", flag_true, flag_true, eq_ops, text_kinds)
    kind: String,
};

# Pairs are the dual-endpoint hub and the base grain of hub queries: fields 2
# (left_member_id) and 3 (right_member_id) both reference Member's key (field 0);
# field 1 is a hub attribute.  A hub row is counted when either endpoint matches
# a Member (participant filter target); the base row is one hub, so it is never
# counted twice.  This layer provides the base->(participant) dual-end union
# slice via a correlated union EXISTS.
# Canonical (alphabetical) field order: 0: id (key/measure), 1: kind
# (dimension), 2: left_member_id, 3: right_member_id.
@edsl::entity_id("pairs")
@edsl::entity_source("pairs", "pr")
@edsl::dual_hub(Member.type, 0, 2, 3)
@edsl::peer_hub(Member.type, 0, 2, Member.type, 0, 3)
type Pair = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("PairCount", count_agg, requires_none)
    id: Int,
    @edsl::column("kind")
    @edsl::dimension("PairKind", flag_true, flag_true, eq_ops, text_kinds)
    kind: String,
    @edsl::column("left_member_id")
    left_member_id: Int,
    @edsl::column("right_member_id")
    right_member_id: Int,
};

# --- PlanProfile accepted by this knowledge ----------------------------------
def requires_none: Array(Type) = [];
def requires_order: Array(Type) = [Order.type];
def requires_order_customer: Array(Type) = [Order.type, Customer.type];

def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
        qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order,
        qb::Operator::Limit, qb::Operator::Offset, qb::Operator::Partition,
    ],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Sum, qb::AggregateFunction::Avg, qb::AggregateFunction::Min, qb::AggregateFunction::Max],
    allowed_scalars: [
        qb::ScalarFunction::Substr, qb::ScalarFunction::Instr, qb::ScalarFunction::If, qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Lower, qb::ScalarFunction::Length,
        qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not,
    ],
    allow_distinct: True,
};

# --- Authorization (fictional) -----------------------------------------------

def authorize: Fn(String) -> Bool = fn(subject) {
    subject == "analyst"
};

# --- Prepared payload (computed once at module load) -------------------------

def payload: edsl::PreparedPayload = do {
    let entity_types: Array(Type) = [
        Order.type, Customer.type, Item.type, Trace.type, Approval.type, Device.type, Parent.type, Child.type,
        MergedItem.type, Site.type, Component.type, Alarm.type, Member.type, Pair.type,
    ];
    let result: edsl::PreparedPayload = edsl::build_root(
        "fictional-v2",
        entity_types,
        profile,
        authorize,
    );
    result
};

pub use self::{
    Order,
    Customer,
    CustomerTier,
    Item,
    Trace,
    TraceKind,
    Approval,
    ApprovalStatus,
    Device,
    Parent,
    Child,
    MergedItem,
    Site,
    Component,
    Alarm,
    Member,
    Pair,
    profile,
    payload,
};
