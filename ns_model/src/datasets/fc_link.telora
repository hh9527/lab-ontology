use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
@domain::subject("FcLink", "id")
@domain::dataset("fc-link", "FcLink", ["id"])
pub type FcLink = struct {
    @g::field_view(g::dimension_group("fc-link/id", ids::FcLinkById.type, True, [g::Filter::Eq]), "fl_id", True, [g::Filter::Eq])
    @domain::count("fl_count")
    id: ids::FcLinkById,
    @g::field_view(g::dimension_group("fc-link/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "fl_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("fc-link/obj_sys_id", String.type, True, [g::Filter::Eq]), "fl_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(String),
    @m::column("fcId")
    @g::field_view(g::dimension_group("fc-link/fc_id", String.type, True, [g::Filter::Eq]), "fl_fc_id", True, [g::Filter::Eq])
    fc_id: Option(String),
    @m::column("typeId")
    @g::field_view(g::dimension_group("fc-link/type_id", String.type, True, [g::Filter::Eq]), "fl_type_id", True, [g::Filter::Eq])
    type_id: String,
    @m::column("portId")
    @g::field_view(g::dimension_group("fc-link/port_id", String.type, True, [g::Filter::Eq]), "fl_port_id", True, [g::Filter::Eq])
    port_id: Option(String),
    @m::column("nodeWwn")
    @g::field_view(g::dimension_group("fc-link/node_wwn", String.type, True, [g::Filter::Eq]), "fl_node_wwn", True, [g::Filter::Eq])
    node_wwn: Option(String),
    @m::column("portWwn")
    @g::field_view(g::dimension_group("fc-link/port_wwn", String.type, True, [g::Filter::Eq]), "fl_port_wwn", True, [g::Filter::Eq])
    port_wwn: Option(String),
    @m::column("remotePortId")
    @g::field_view(g::dimension_group("fc-link/remote_port_id", String.type, True, [g::Filter::Eq]), "fl_remote_port_id", True, [g::Filter::Eq])
    remote_port_id: Option(String),
    @m::column("remoteNodeWwn")
    @g::field_view(g::dimension_group("fc-link/remote_node_wwn", String.type, True, [g::Filter::Eq]), "fl_remote_node_wwn", True, [g::Filter::Eq])
    remote_node_wwn: Option(String),
    @m::column("remotePortWwn")
    @g::field_view(g::dimension_group("fc-link/remote_port_wwn", String.type, True, [g::Filter::Eq]), "fl_remote_port_wwn", True, [g::Filter::Eq])
    remote_port_wwn: Option(String),
};
