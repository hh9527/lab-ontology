};

@edsl::entity_source("hbk_t", "hbk")
@edsl::dual_hub(HubParticipant.type, 1, 1, 2)
type HubBadKey = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
