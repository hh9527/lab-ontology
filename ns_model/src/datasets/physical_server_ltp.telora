use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::physical_server;
use crate::datasets::enterprise_physical_link;
@domain::subject("PhysicalServerLtp", "id")
@domain::dataset("physical-server-ltp", "PhysicalServerLTP", ["id"])
@domain::relations(relations)
pub type PhysicalServerLtp = struct {
    @g::field_view(g::dimension_group("physical-server-ltp/id", ids::PhysicalServerLtpById.type, True, [g::Filter::Eq]), "psl_id", True, [g::Filter::Eq])
    @domain::count("psl_count")
    id: ids::PhysicalServerLtpById,
    @g::field_view(g::dimension_group("physical-server-ltp/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "psl_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("portType")
    @g::field_view(g::dimension_group("physical-server-ltp/port_type/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "psl_port_type_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::PslPortType.type, "psl_port_type", [v::member(domains::PslPortType::OpticalPort, ["OpticalPort"]), v::member(domains::PslPortType::ElectricalPort, ["ElectricalPort"])])
    port_type: Option(String),
    @m::column("portTechnology")
    @g::field_view(g::dimension_group("physical-server-ltp/port_technology", String.type, True, [g::Filter::Eq]), "psl_port_technology", True, [g::Filter::Eq])
    port_technology: Option(String),
    @m::column("linkStatus")
    @g::field_view(g::dimension_group("physical-server-ltp/link_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "psl_link_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::PslLinkStatus.type, "psl_link_status", [v::member(domains::PslLinkStatus::LinkUp, ["Up"]), v::member(domains::PslLinkStatus::LinkDown, ["Down"]), v::member(domains::PslLinkStatus::NoLink, ["NoLink"]), v::member(domains::PslLinkStatus::Unknown, ["Unknown"])])
    link_status: Option(String),
    @m::column("cardResId")
    @g::field_view(g::dimension_group("physical-server-ltp/card_res_id", String.type, True, [g::Filter::Eq]), "psl_card_res_id", True, [g::Filter::Eq])
    card_res_id: Option(String),
    @m::column("macAddress")
    @g::field_view(g::dimension_group("physical-server-ltp/mac_address", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "psl_mac_address", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    mac_address: Option(String),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("physical-server-ltp/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "psl_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
};

pub def relations: Array(r::Relation) = [
    r::relation("psl__ps_rev", domain::endpoint(PhysicalServerLtp.type, "parent_res_id"), domain::endpoint(physical_server::PhysicalServer.type, "ori_res_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("psl__epl", domain::endpoint(PhysicalServerLtp.type, "id"), domain::endpoint(enterprise_physical_link::EnterprisePhysicalLink.type, "a_port_dn"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
