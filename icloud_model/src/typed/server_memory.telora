use super::classifications as classes;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# ServerMemory独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("ServerMemory")
type ServerMemoryById = struct(ComponentId);
# 保留源MB编码，不自动转换为Bytes或推断二进制倍率
use ontology::quantity::{IntegerMegabytes};
@domain::subject("ServerMemory", "id")
@g::groupable(["server_memory__healthStatus", "server_memory__type"])
@domain::record_counts(["server_memory_count"])
@r::sources("memory_parent_server", ["source_PhysicalServer_PhysicalServerMemory"])
@domain::dataset("server_memory", "PhysicalServerMemory", ["id"])
@domain::relations(relations)
@v::computed(
    "server_memory__type",
    "source_type",
    classes::MemoryKind.type,
    [v::member(classes::MemoryKind::Ddr4, ["DDR4"]), v::member(classes::MemoryKind::Ddr5, ["DDR5"])],
    classes::MemoryKind::Unknown
)
type PhysicalServerMemory = struct {
    id: ServerMemoryById,
    @g::search("server_memory_name")
    @edsl::field_role(edsl::FieldRole::Appellation)
    name: String,
    @m::column("parentResId")
    parent_res_id: domain::Reference(server::ServerByOriginId),
    @m::column("tenantId")
    tenant_id: domain::Reference(i::TenantById),
    @m::column("partNumber")
    @g::search("server_memory__partNumber")
    source_partNumber: String,
    @m::column("manufacturer")
    @g::search("server_memory__manufacturer")
    source_manufacturer: String,
    @m::column("type")
    @g::exact("server_memory__type_raw")
    source_type: String,
    @m::column("serialNumber")
    @g::search("server_memory__serialNumber")
    source_serialNumber: String,
    @m::column("bitWidth")
    @g::view("server_memory__bitWidth", True, g::numeric_filters)
    source_bitWidth: Int,
    @m::column("frequency")
    @g::view("server_memory__frequency", True, g::numeric_filters)
    source_frequency: Int,
    @m::column("capacity")
    @g::view("server_memory__capacity", True, g::numeric_filters)
    source_capacity: IntegerMegabytes,
    @m::column("model")
    @g::search("server_memory__model")
    source_model: String,
    @m::column("healthStatus")
    @g::exact("server_memory__healthStatus")
    source_healthStatus: ServerMemoryHealthStatus,
    @m::column("memoryName")
    @g::search("server_memory__memoryName")
    source_memoryName: String,
    @m::column("dn")
    @g::exact("server_memory__dn")
    source_dn: String,
    @m::column("projectId")
    @g::exact("server_memory__projectId")
    source_projectId: String,
};

def subject: r::Endpoint = domain::endpoint(PhysicalServerMemory.type, "id");
def parent: r::Endpoint = domain::endpoint(PhysicalServerMemory.type, "parent_res_id");
def tenant: r::Endpoint = domain::endpoint(PhysicalServerMemory.type, "tenant_id");

@knowledge_policy::reverse_references(True)
type ServerMemoryHealthStatus = enum {
    @ev::description("normal", "正常")
    @ev::itag(0)
    Normal,
    @ev::description("warning", "警告")
    @ev::itag(1)
    Warning,
    @ev::description("average", "一般")
    @ev::itag(2)
    Average,
    @ev::description("serious", "严重")
    @ev::itag(3)
    Serious,
    @ev::description("critical", "紧急")
    @ev::itag(4)
    Critical,
    @ev::description("wrong", "错误")
    @ev::itag(-1)
    Wrong,
    @ev::description("unknown", "未知")
    @ev::itag(-2)
    Unknown,
};

def tenant_cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "memory_parent_server",
        parent,
        server::origin,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServerMemory_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerMemory, ServerMemoryById};

pub use self::{ServerMemoryHealthStatus};
