use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
use std::test as test;

type Row = struct { id: Int, a: String, z: String, number: Int };
def rows: m::Dataset(Row) = m::dataset("pairs", "pair_rows", Row.type, ["id"]);
def text: g::DimensionGroup(String) = g::dimension_group("names", String.type, True, g::equality_filters);
def first: g::Binding(Row) = g::dimension(rows, text, g::input(m::field(Row.type, String.type, "a")), "first", True, g::equality_filters);
def second: g::Binding(Row) = g::dimension(rows, text, g::input(m::field(Row.type, String.type, "z")), "second", True, g::equality_filters);
def alias: g::Binding(Row) = g::dimension(rows, text, g::input(m::field(Row.type, String.type, "a")), "alias", True, g::equality_filters);
def number: g::Binding(Row) = g::dimension(rows, g::dimension_group("number", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "number")), "number", True, g::numeric_filters);
def pair: t::NativePair(Row) = t::native_pair("az_names", first, second);
def base: t::Declaration = t::declare(rows, [], [first, second], []);
def declared: t::Declaration = t::with_native_pairs(base, [pair]);
def profile: qb::PlanProfile = {allowed_operators: [qb::Operator::Filter, qb::Operator::Source, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar], allowed_aggregates: [], allowed_join_kinds: [], allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::Ne], allow_distinct: False};
def payload: edsl::PreparedPayload = t::prepare("pairs", [declared], profile).payload;
pub def ordered_pair_is_prepared: test::Test = test::should_ok(fn() { payload.native_pairs == [{id: "az_names", entity: 0, first: "first", second: "second"}] });
pub def same_dimension_is_rejected: test::Test = test::should_fail_with(fn() { t::checked_native_pair("bad", first, first) }, "native pair requires distinct compatible plain equality dimensions");
pub def aliases_of_one_field_are_rejected: test::Test = test::should_fail_with(fn() { t::checked_native_pair("bad", first, alias) }, "native pair requires distinct compatible plain equality dimensions");
pub def incompatible_values_are_rejected: test::Test = test::should_fail_with(fn() { t::checked_native_pair("bad", first, number) }, "native pair requires distinct compatible plain equality dimensions");
pub def other_dataset_is_rejected: test::Test = test::should_fail_with(fn() { t::checked_native_pair("bad", first, second <~ {dataset: "other"}) }, "native pair requires dimensions from the same dataset");
pub def missing_binding_is_rejected: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [declared <~ {groups: [g::binding_facts(first)]}], profile) }, "native pair requires its declared dimension bindings");
pub def duplicate_ids_are_rejected: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [t::checked_with_native_pairs(base, [pair, pair])], profile) }, "duplicate native pair id");
pub def erased_binding_is_rechecked: test::Test = test::should_fail_with(fn() {
    t::checked_prepare("bad", [declared <~ {native_pairs: [declared.native_pairs[0] <~ {first: g::binding_facts(first) <~ {source: "other"}}]}], profile)
}, "native pair requires dimensions from the same dataset");
pub def equality_capability_is_required: test::Test = test::should_fail_with(fn() {
    t::checked_native_pair("bad", first, second <~ {members: [second.members[0] <~ {filters: [g::Filter::Ne]}]})
}, "native pair requires distinct compatible plain equality dimensions");
pub def computed_binding_is_rejected: test::Test = test::should_fail_with(fn() {
    t::checked_native_pair("bad", first, second <~ {members: [second.members[0] <~ {node: g::Node::Ipv4(second.members[0].node)}]})
}, "native pair requires distinct compatible plain equality dimensions");
