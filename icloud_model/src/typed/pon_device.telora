use ontology::knowledge_policy as knowledge_policy;
# PON 独立声明：保留来源、时间假定和固有角色范围。
use super::inventory as i;
use super::site as site;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type PonId = struct(
    String
);
type Identity = struct {
    id: PonId
};
def entity: m::Entity(Identity) = m::entity("pon_resource", Identity.type);
type Row = struct {
    alias: String,
    classification: String,
    commu_state: String,
    create_time: s::EpochMillis,
    id: PonId,
    name: String,
    source_version: String,
    source_ipAddress: String,
    source_mac: String,
    source_sn: String,
    source_manufacturer: String,
    source_manufactureDate: s::Date,
    source_adminState: String,
    source_productName: String,
    source_refParentSubnet: i::SiteId,
    source_tenantId: i::TenantId,
    source_remark: String,
    source_nePatchVersion: String,
    source_neOsVersion: String,
    source_parentOltResId: PonId,
    source_esn: String,
    source_projectId: i::SiteId,
};
def dataset: m::Dataset(Row) = m::dataset("pon_device", "I_EntPonElement", Row.type, ["id"]);
def subject: m::Role(Row) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(Row.type, PonId.type, "id"),
            m::field(Identity.type, PonId.type, "id")
        )
    ]
);
def parent: m::Role(Row) = m::role(
    dataset,
    entity,
    "parent",
    False,
    [
        m::identity_part(
            m::field(Row.type, PonId.type, "source_parentOltResId"),
            m::field(Identity.type, PonId.type, "id")
        )
    ]
);
def tenant: m::Role(Row) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(Row.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def project: m::Role(Row) = m::role(
    dataset,
    site::entity,
    "project",
    False,
    [
        m::identity_part(
            m::field(Row.type, i::SiteId.type, "source_projectId"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def subnet: m::Role(Row) = m::role(
    dataset,
    site::entity,
    "subnet",
    False,
    [
        m::identity_part(
            m::field(Row.type, i::SiteId.type, "source_refParentSubnet"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type PonClass = struct(
    String
);
def PonClass_domain: v::Domain(PonClass, String) = v::domain(
    "PonClass",
    PonClass.type,
    String.type,
    [
        v::member(PonClass("onu"), ["ne.category.pon.onu"]),
        v::member(PonClass("spl"), ["ne.category.pon.spl"]),
        v::member(PonClass("olt"), ["ne.category.olt"]),
    ],
    False
);
@knowledge_policy::reverse_references(True)
type PonCommuState = struct(
    String
);
def PonCommuState_domain: v::Domain(PonCommuState, String) = v::domain(
    "PonCommuState",
    PonCommuState.type,
    String.type,
    [
        v::member(PonCommuState("online"), ["1"]),
        v::member(PonCommuState("offline"), ["0", "2", "3", "4", "14", "15"]),
    ],
    False
);
@knowledge_policy::reverse_references(True)
type PonDeviceAdminState = struct(
    String
);
def PonDeviceAdminState_domain: v::Domain(PonDeviceAdminState, String) = v::domain(
    "PonDeviceAdminState",
    PonDeviceAdminState.type,
    String.type,
    [
        v::member(PonDeviceAdminState("wire_Enabled_82f10bda"), ["Enabled"]),
        v::member(PonDeviceAdminState("wire_Disabled_1ea6e007"), ["Disabled"]),
        v::member(PonDeviceAdminState("wire_active_19c13051"), ["active"]),
        v::member(PonDeviceAdminState("wire_deactive_84c7f708"), ["deactive"]),
    ],
    False
);
def unscoped: t::Declaration = t::with_domains(
    t::map_columns(
        t::declare(
            dataset,
            [subject, parent, tenant, project, subnet],
            [
                i::search(dataset, m::field(Row.type, String.type, "alias"), "pon_alias"),
                g::dimension(
                    dataset,
                    g::dimension_group(
                        "pon_create_ms_time",
                        s::EpochMillis.type,
                        True,
                        g::time_filters
                    ),
                    g::input(m::field(Row.type, s::EpochMillis.type, "create_time")),
                    "pon_create_ms",
                    True,
                    g::time_filters
                ),
                i::exact(dataset, m::field(Row.type, PonId.type, "id"), "pon_id"),
                i::search(dataset, m::field(Row.type, String.type, "name"), "pon_name"),
                i::search(
                    dataset,
                    m::field(Row.type, String.type, "source_version"),
                    "pon_device__version"
                ),
                i::search(
                    dataset,
                    m::field(Row.type, String.type, "source_ipAddress"),
                    "pon_device__ipAddress"
                ),
                g::dimension(
                    dataset,
                    g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
                    g::ipv4(g::input(m::field(Row.type, String.type, "source_ipAddress"))),
                    "pon_device__ipAddress_ipv4",
                    True,
                    g::ipv4_filters
                ),
                i::search(dataset, m::field(Row.type, String.type, "source_mac"), "pon_device__mac"),
                i::search(dataset, m::field(Row.type, String.type, "source_sn"), "pon_device__sn"),
                i::search(
                    dataset,
                    m::field(Row.type, String.type, "source_manufacturer"),
                    "pon_device__manufacturer"
                ),
                g::dimension(
                    dataset,
                    g::dimension_group(
                        "pon_device__manufactureDate_time",
                        s::Date.type,
                        True,
                        g::time_filters
                    ),
                    g::input(m::field(Row.type, s::Date.type, "source_manufactureDate")),
                    "pon_device__manufactureDate",
                    True,
                    g::time_filters
                ),
                i::search(
                    dataset,
                    m::field(Row.type, String.type, "source_productName"),
                    "pon_device__productName"
                ),
                i::exact(
                    dataset,
                    m::field(Row.type, i::SiteId.type, "source_refParentSubnet"),
                    "pon_device__refParentSubnet"
                ),
                i::exact(
                    dataset,
                    m::field(Row.type, i::TenantId.type, "source_tenantId"),
                    "pon_device__tenantId"
                ),
                i::search(
                    dataset,
                    m::field(Row.type, String.type, "source_remark"),
                    "pon_device__remark"
                ),
                i::search(
                    dataset,
                    m::field(Row.type, String.type, "source_nePatchVersion"),
                    "pon_device__nePatchVersion"
                ),
                i::search(
                    dataset,
                    m::field(Row.type, String.type, "source_neOsVersion"),
                    "pon_device__neOsVersion"
                ),
                i::exact(
                    dataset,
                    m::field(Row.type, PonId.type, "source_parentOltResId"),
                    "pon_device__parentOltResId"
                ),
                i::search(dataset, m::field(Row.type, String.type, "source_esn"), "pon_device__esn"),
                i::exact(
                    dataset,
                    m::field(Row.type, i::SiteId.type, "source_projectId"),
                    "pon_device__projectId"
                ),
            ],
            []
        ),
        [
            t::column(m::field(Row.type, String.type, "alias"), "alias"),
            t::column(m::field(Row.type, String.type, "classification"), "classification"),
            t::column(m::field(Row.type, String.type, "commu_state"), "commuState"),
            t::column(m::field(Row.type, s::EpochMillis.type, "create_time"), "createTime"),
            t::column(m::field(Row.type, PonId.type, "id"), "id"),
            t::column(m::field(Row.type, String.type, "name"), "name"),
            t::column(m::field(Row.type, String.type, "source_version"), "version"),
            t::column(m::field(Row.type, String.type, "source_ipAddress"), "ipAddress"),
            t::column(m::field(Row.type, String.type, "source_mac"), "mac"),
            t::column(m::field(Row.type, String.type, "source_sn"), "sn"),
            t::column(m::field(Row.type, String.type, "source_manufacturer"), "manufacturer"),
            t::column(m::field(Row.type, s::Date.type, "source_manufactureDate"), "manufactureDate"),
            t::column(m::field(Row.type, String.type, "source_adminState"), "adminState"),
            t::column(m::field(Row.type, String.type, "source_productName"), "productName"),
            t::column(
                m::field(Row.type, i::SiteId.type, "source_refParentSubnet"),
                "refParentSubnet"
            ),
            t::column(m::field(Row.type, i::TenantId.type, "source_tenantId"), "tenantId"),
            t::column(m::field(Row.type, String.type, "source_remark"), "remark"),
            t::column(m::field(Row.type, String.type, "source_nePatchVersion"), "nePatchVersion"),
            t::column(m::field(Row.type, String.type, "source_neOsVersion"), "neOsVersion"),
            t::column(m::field(Row.type, PonId.type, "source_parentOltResId"), "parentOltResId"),
            t::column(m::field(Row.type, String.type, "source_esn"), "esn"),
            t::column(m::field(Row.type, i::SiteId.type, "source_projectId"), "projectId"),
        ]
    ),
    [
        v::bind(
            dataset,
            v::dimension_group(PonClass_domain, True, g::equality_filters),
            g::input(m::field(Row.type, String.type, "classification")),
            "pon_class",
            True,
            g::equality_filters
        ),
        v::bind(
            dataset,
            v::dimension_group(PonCommuState_domain, True, g::equality_filters),
            g::input(m::field(Row.type, String.type, "commu_state")),
            "pon_commu_state",
            True,
            g::equality_filters
        ),
        v::bind(
            dataset,
            v::dimension_group(PonDeviceAdminState_domain, True, g::equality_filters),
            g::input(m::field(Row.type, String.type, "source_adminState")),
            "pon_device__adminState",
            True,
            g::equality_filters
        ),
    ]
);
def declaration: t::Declaration = unscoped;
def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElementAssociationEntPonElement",
        dataset,
        subject,
        dataset,
        parent,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EntPonElementAssociationX_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
def alternatives: Array(t::Alternative) = [
    {
        id: "source_EntPonElementAssociationX_SITE_VIEW",
        cardinality: {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
        choices: [
            r::relation(
                "pon_project_site",
                dataset,
                project,
                site::dataset,
                site::subject,
                {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
            ),
            r::relation(
                "pon_subnet_site",
                dataset,
                subnet,
                site::dataset,
                site::subject,
                {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
            ),
        ]
    }
];
pub use self::{PonId, Identity, entity, dataset, subject, declaration, relations, alternatives};
