# 领域枚举成员直接携带源编码；排序是领域类型的显式属性。
use std::prelude as prelude;
use std::type_property as property;
use std::type_desc as td;
use std::array as array;
use std::type_memorizer as memo;
use crate::ontology as edsl;
use crate::groups as groups;
use std::pipeline as pipeline;
use std::json as json;
use std::codec as codec;
use std::value::{Value};

@prelude::property(PropertyTarget::Variant)
type Tags = struct {
    values: Array(edsl::FilterInput),
    id: String,
    itag: Option(Int)
};
@prelude::property(PropertyTarget::Type)
type OrderByITag = struct {};
def itag: Fn(Int) -> Fn(property::VariantPropertyCtx, Option(Tags)) -> Tags = fn(value) {
    fn(ctx, previous) {
        if previous != None {
            fail!("itag must be declared once, before source aliases", ctx.name)
        } else {
            ()
        };
        {values: [edsl::FilterInput::Int(value)], id: ctx.name, itag: Some(value)}
    }
};
# 字符串源表示使用重命名；多个源表示通过 alias 补充。
def rename: Fn(String) -> Fn(property::VariantPropertyCtx, Option(Tags)) -> Tags = fn(value) {
    fn(ctx, previous) {
        match previous {
            Some(before) => if before.itag != None && array::all(
                before.values,
                fn(v) {
                    match v {
                        edsl::FilterInput::Int(_) => True,
                        _ => False
                    }
                }
            ) {
                {values: [edsl::FilterInput::Text(value)], id: ctx.name, itag: before.itag}
            } else {
                fail!("rename must be declared once, before aliases", ctx.name)
            },
            None => {values: [edsl::FilterInput::Text(value)], id: ctx.name, itag: None},
        }
    }
};
def alias: for(Wire: codec::Encode) Fn(
    Wire
) -> Fn(property::VariantPropertyCtx, Option(Tags)) -> Tags = fn(value) {
    let input = match codec::encode(value) {
        Value::String(text) => edsl::FilterInput::Text(text),
        Value::Int(number) => edsl::FilterInput::Int(number),
        _ => fail!("enum alias requires Int or String")
    };
    fn(ctx, previous) {
        match previous {
            Some(before) => {
                if !array::all(
                    before.values,
                    fn(source) {
                        match (source, input) {
                            (edsl::FilterInput::Text(_), edsl::FilterInput::Text(_)) => True,
                            (edsl::FilterInput::Int(_), edsl::FilterInput::Int(_)) => True,
                            _ => False
                        }
                    }
                ) {
                    fail!("enum alias must match primary source storage", ctx.name)
                } else {
                    ()
                };
                before <~ {values: array::push(before.values, input)}
            },
            None => fail!("enum alias requires a primary source tag", ctx.name)
        }
    }
};
@prelude::property(PropertyTarget::Variant)
type Description = struct {
    label: String,
    names: Array(String)
};
def description: Fn(
    String,
    String
) -> Fn(property::VariantPropertyCtx, Option(Description)) -> Description = fn(label, localized) {
    fn(ctx, previous) {
        {
            label,
            names: array::filter(
                [label, localized],
                fn(value) {
                    value != ""
                }
            )
        }
    }
};
def variant_names: Fn(Type, Int) -> Array(String) = fn(ty, index) {
    match property::get_variant_prop(ty, index, Description.type) {
        Some(info) => info.names,
        None => [],
    }
};
def order_by_itag: Fn(td::TypeDesc, Option(OrderByITag)) -> OrderByITag = fn(ctx, previous) {
    {}
};
def member_info: memo::TypeMemorizer(Array(edsl::CanonicalValueSpec)) = memo::type_memorizer(
    prepare_members
);
def members: Fn(Type) -> Array(edsl::CanonicalValueSpec) = fn(ty) {
    memo::computed_with_type(member_info, ty)
};
def prepare_members: Fn(Type) -> Array(edsl::CanonicalValueSpec) = fn(ty) {
    let body = groups::representation(ty);
    if td::kind(body) != td::TypeDescKind::Enum {
        fail!("tagged domain requires an enum", ty)
    } else {
        ()
    };
    array::map(
        td::variants(body),
        fn(variant) {
            if variant.payload != None {
                fail!("domain variant must not have a payload", ty, variant.name)
            } else {
                ()
            };
            let tag = match property::get_variant_prop(ty, variant.index, Tags.type) {
                Some(tag) => tag,
                None => {
                    values: [edsl::FilterInput::Text(variant.name)],
                    id: variant.name,
                    itag: None
                }.ty!(Tags),
            };
            let label = match property::get_variant_prop(ty, variant.index, Description.type) {
                Some(info) => info.label,
                None => tag.id,
            };
            {id: tag.id, label, wires: tag.values}.ty!(edsl::CanonicalValueSpec)
        }
    )
};
def storage_type: Fn(Type) -> Type = fn(ty) {
    let values = array::flat_map(
        members(ty),
        fn(member) {
            member.wires
        }
    );
    if array::length(values) == 0 {
        fail!("closed enum requires at least one variant", ty)
    } else if array::all(
        values,
        fn(value) {
            match value {
                edsl::FilterInput::Int(_) => True,
                _ => False
            }
        }
    ) {
        Int.type
    } else if array::all(
        values,
        fn(value) {
            match value {
                edsl::FilterInput::Text(_) => True,
                _ => False
            }
        }
    ) {
        String.type
    } else {
        fail!("enum source tags must use one physical storage type", ty)
    }
};
pub use self::{storage_type};
def integer_tags: Fn(Type) -> Array((String, Int)) = fn(ty) {
    let items = array::flat_map(
        td::variants(groups::representation(ty)),
        fn(v) {
            match property::get_variant_prop(ty, v.index, Tags.type) {
                Some(tag) => match tag.itag {
                    Some(value) => [(v.name, value)],
                    None => []
                },
                None => [],
            }
        }
    );
    pipeline::run(
        pipeline::from_array(items) |> pipeline::unique_by(
            fn(p) {
                json::stringify(codec::encode(p.1))
            }
        ) |> pipeline::collect()
    )
};
def itag_order: Fn(Type) -> Array(String) = fn(ty) {
    if property::get_type_prop(ty, OrderByITag.type) == None {
        []
    } else {
        let tags = integer_tags(ty);
        if array::length(tags) != array::length(td::variants(groups::representation(ty))) {
            fail!("order_by_itag requires one integer tag per variant", ty)
        } else {
            ()
        };
        let sorted = array::fold(
            tags,
            [].ty!(Array((String, Int))),
            fn(before, p) {
                array::concat(
                    [
                        array::filter(
                            before,
                            fn(b) {
                                b.1 < p.1
                            }
                        ),
                        [p],
                        array::filter(
                            before,
                            fn(b) {
                                b.1 >= p.1
                            }
                        )
                    ]
                )
            }
        );
        array::map(
            sorted,
            fn(p) {
                p.0
            }
        )
    }
};
pub use self::{integer_tags, itag_order};
pub use self::{
    Tags,
    OrderByITag,
    Description,
    itag,
    rename,
    alias,
    description,
    variant_names,
    order_by_itag,
    members
};
