# 独立 transform 声明；单位、grain 与关系只采用既有公开契约。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::samples as samples;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
type CatalogId = struct(String);
type Identity = struct { id: CatalogId };
type Row = struct {
    source_ID: CatalogId,
    source_NAME: String,
    source_CATEGORY: String,
    source_IP: String,
    source_MAC: String,
    source_CLASS_NAME: String,
};
def dataset: m::Dataset(Row) = m::dataset("source_T_DEVICE_ALL", "T_DEVICE_ALL", Row.type, ["source_ID"]);
def entity: m::Entity(Identity) = m::entity("device_catalog_entity", Identity.type);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, CatalogId.type, "source_ID"), m::field(Identity.type, CatalogId.type, "id"))]);
type SourceTDEVICEALLCATEGORY = struct(String);
def SourceTDEVICEALLCATEGORY_domain: v::Domain(SourceTDEVICEALLCATEGORY, String) = v::domain("SourceTDEVICEALLCATEGORY", SourceTDEVICEALLCATEGORY.type, String.type, [
    v::member(SourceTDEVICEALLCATEGORY("wire_STORAGE_141ae45b"), ["STORAGE"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_FW_0aa27341"), ["FW"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_AR_e0a8656f"), ["AR"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_LSW_2a4d3432"), ["LSW"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_TianGuan_22eb4636"), ["TianGuan"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_AC_b0da51ed"), ["AC"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_AP_bc7a4ff3"), ["AP"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_Collaboration_3ea905f6"), ["Collaboration"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_ONU_d0365b90"), ["ONU"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_OLT_02da0d65"), ["OLT"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_SPL_866a7941"), ["SPL"]),
    v::member(SourceTDEVICEALLCATEGORY("wire_SERVER_7eb2b745"), ["SERVER"]),
], False);
def raw: t::Declaration = t::map_columns(t::declare(dataset, [subject], [
    i::exact(dataset, m::field(Row.type, CatalogId.type, "source_ID"), "source_T_DEVICE_ALL__ID"),
    i::search(dataset, m::field(Row.type, String.type, "source_NAME"), "source_T_DEVICE_ALL__NAME"),
    i::search(dataset, m::field(Row.type, String.type, "source_IP"), "source_T_DEVICE_ALL__IP"),
    g::dimension(dataset, g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters), g::ipv4(g::input(m::field(Row.type, String.type, "source_IP"))), "source_T_DEVICE_ALL__IP_ipv4", True, g::ipv4_filters),
    i::search(dataset, m::field(Row.type, String.type, "source_MAC"), "source_T_DEVICE_ALL__MAC"),
    i::exact(dataset, m::field(Row.type, String.type, "source_CLASS_NAME"), "source_T_DEVICE_ALL__CLASS_NAME"),
], []), [
    t::column(m::field(Row.type, CatalogId.type, "source_ID"), "ID"),
    t::column(m::field(Row.type, String.type, "source_NAME"), "NAME"),
    t::column(m::field(Row.type, String.type, "source_CATEGORY"), "CATEGORY"),
    t::column(m::field(Row.type, String.type, "source_IP"), "IP"),
    t::column(m::field(Row.type, String.type, "source_MAC"), "MAC"),
    t::column(m::field(Row.type, String.type, "source_CLASS_NAME"), "CLASS_NAME"),
]);
def declaration: t::Declaration = t::with_domains(raw, [
    v::bind(dataset, v::dimension_group(SourceTDEVICEALLCATEGORY_domain, True, g::equality_filters), g::input(m::field(Row.type, String.type, "source_CATEGORY")), "source_T_DEVICE_ALL__CATEGORY", True, g::equality_filters),
]);
pub use self::{declaration};
