use ontology::registry as registry;
use ontology::groups as g;
use ontology::transform as t;
use ontology::query as q;
use ontology::knowledge as knowledge;
use std::array as array;
use std::test as test;

@registry::dataset("first", "first_rows", ["id"])
type First = struct {
    @g::exact("id")
    id: Int,
    @g::search("name")
    name: String
};
@registry::dataset("second", "second_rows", ["id"])
type Second = struct {
    @g::exact("id")
    id: Int,
    @g::search("name")
    name: Option(String)
};
def definitions: Array(t::LocalDefinition) = [
    t::initialize_dataset(First.type),
    t::initialize_dataset(Second.type)
];
def profile: q::PlanProfile = {
    allowed_operators: [
        q::Operator::Source,
        q::Operator::Column,
        q::Operator::Scalar,
        q::Operator::Bind
    ],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [q::ScalarFunction::Eq],
    allow_distinct: False
};
def combined: t::Prepared = t::build_from_definitions("local", definitions, [], [], [], profile);

pub def local_payloads_preserve_global_addresses: test::Test = test::should_ok(
    fn() {
        array::map(
            combined.payload.entities,
            fn(entity) {
                entity.id
            }
        ) == ["first", "second"] && array::map(
            combined.payload.dimensions,
            fn(item) {
                (item.id, item.entity, item.field)
            }
        ) == [("id", 0, 0), ("name", 0, 1), ("id", 1, 0), ("name", 1, 1)]
    }
);
pub def local_dimensions_use_the_assigned_source: test::Test = test::should_ok(
    fn() {
        array::all(
            array::enumerate(combined.payload.dimensions),
            fn(pair) {
                let dimension = pair.1;
                let entity = combined.payload.entities[dimension.entity];
                let base = q::column(entity.source, entity.fields[dimension.field].column);
                dimension.build(q::build_context(), base) == (q::build_context(), base)
            }
        )
    }
);

pub def local_capabilities_preserve_published_fields: test::Test = test::should_ok(
    fn() {
        let parts = array::map(
            definitions,
            fn(local) {
                local.capabilities
            }
        );
        let local: knowledge::LocalCapabilities = {
            dimensions: array::flat_map(
                parts,
                fn(part) {
                    part.dimensions
                }
            ),
            measures: array::flat_map(
                parts,
                fn(part) {
                    part.measures
                }
            )
        };
        knowledge::raw_capabilities_with_local(combined.payload, local) == knowledge::raw_capabilities(
            combined.payload
        )
    }
);
