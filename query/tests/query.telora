};

export def partition_accepts_valid_plan = do {
    qb.structure_ok(top_per_role_plan()) && qb.structure_ok(computed_partition_plan())
};

export def partition_computed_ordering_bindings_deterministic = do {
    let q = qb.transform_sqlite(computed_partition_plan());
    let q2 = qb.transform_sqlite(computed_partition_plan());
    q.sql == q2.sql && q.bindings == q2.bindings
        && (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
};

export def partition_computed_ordering_uses_bindings_not_literals = do {
    let q = qb.transform_sqlite(computed_partition_plan());
    !string.contains(q.sql, "' '") && !string.contains(q.sql, " 0")
};

export def partition_computed_ordering_profile = do {
    qb.profile_accepts(computed_partition_plan(), full_profile())
};

export def partition_deterministic = do {
    let q1 = qb.transform_sqlite(top_per_role_plan());
    let q2 = qb.transform_sqlite(top_per_role_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

# ---------------------------------------------------------------------------
# Filtered and computed aggregates.
#
# Filtered aggregates carry their own row-level predicate
# (`count(id) FILTER (WHERE type = ?)`); the global WHERE limits the whole fact
# set and is never merged into the per-aggregate predicates.
# Computed aggregates combine declared aggregate aliases with Add/Sub; operands
# must resolve to declared aggregate/computed items in the same projection and
# the dependency graph must be acyclic.
# ---------------------------------------------------------------------------

def filtered_aggregate_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-filtered-agg",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.aggregate_filtered('Count, qb.column("e", "id"), 'False,
                'Some(qb.scalar('Eq, [qb.column("e", "type"), qb.bind_string("task_started")])),
                "started_count"),
            qb.aggregate_filtered('Count, qb.column("e", "id"), 'False,
                'Some(qb.scalar('Eq, [qb.column("e", "type"), qb.bind_string("task_completed")])),
                "completed_count"),
        ],
        filter: 'Some(qb.scalar('Eq, [qb.column("e", "year"), qb.bind_int(2024)])),
        joins: [],
        grouping: [qb.column("e", "role")],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

def computed_aggregate_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-computed-agg",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.aggregate_filtered('Count, qb.column("e", "id"), 'False,
                'Some(qb.scalar('Eq, [qb.column("e", "type"), qb.bind_string("task_started")])),
                "started_count"),
            qb.aggregate_filtered('Count, qb.column("e", "id"), 'False,
                'Some(qb.scalar('Eq, [qb.column("e", "type"), qb.bind_string("task_completed")])),
                "completed_count"),
            qb.computed_item('Sub, "started_count", "completed_count", "outstanding"),
        ],
        filter: 'Some(qb.scalar('Eq, [qb.column("e", "year"), qb.bind_int(2024)])),
        joins: [],
        grouping: [qb.column("e", "role")],
        ordering: [qb.desc_aggregate("outstanding")],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

def expected_filtered_sql = "SELECT e.role, count(e.id) FILTER (WHERE e.type = ?) AS started_count, count(e.id) FILTER (WHERE e.type = ?) AS completed_count FROM events AS e WHERE e.year = ? GROUP BY e.role";

def expected_computed_sql = "SELECT e.role, count(e.id) FILTER (WHERE e.type = ?) AS started_count, count(e.id) FILTER (WHERE e.type = ?) AS completed_count, (count(e.id) FILTER (WHERE e.type = ?) - count(e.id) FILTER (WHERE e.type = ?)) AS outstanding FROM events AS e WHERE e.year = ? GROUP BY e.role ORDER BY (count(e.id) FILTER (WHERE e.type = ?) - count(e.id) FILTER (WHERE e.type = ?)) DESC";

def expected_filtered_bindings: Array(qb.Val) = [
    'String("task_started"), 'String("task_completed"), 'Int(2024),
];

def expected_computed_bindings: Array(qb.Val) = [
    'String("task_started"), 'String("task_completed"),
    'String("task_started"), 'String("task_completed"),
    'Int(2024),
    'String("task_started"), 'String("task_completed"),
];

def computed_partition_net_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-computed-partition-net",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.expr_item(qb.column("e", "command_head")),
            qb.aggregate_filtered('Count, qb.column("e", "id"), 'False,
                'Some(qb.scalar('Eq, [qb.column("e", "type"), qb.bind_string("task_started")])),
                "started_count"),
            qb.aggregate_filtered('Count, qb.column("e", "id"), 'False,
                'Some(qb.scalar('Eq, [qb.column("e", "type"), qb.bind_string("task_completed")])),
                "completed_count"),
            qb.computed_item('Sub, "started_count", "completed_count", "outstanding"),
        ],
        filter: 'Some(qb.scalar('Eq, [qb.column("e", "year"), qb.bind_int(2024)])),
        joins: [],
        grouping: [qb.column("e", "role"), qb.column("e", "command_head")],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'Some(qb.partitioned_top_n(
            [qb.column("e", "role")],
            [qb.desc_aggregate("outstanding"), qb.asc(qb.column("e", "command_head"))],
            3,
        )),
    };
    plan
};

def expected_computed_partition_sql = "SELECT __q_0, __q_1, started_count, completed_count, outstanding FROM (SELECT e.role AS __q_0, e.command_head AS __q_1, count(e.id) FILTER (WHERE e.type = ?) AS started_count, count(e.id) FILTER (WHERE e.type = ?) AS completed_count, (count(e.id) FILTER (WHERE e.type = ?) - count(e.id) FILTER (WHERE e.type = ?)) AS outstanding, row_number() OVER (PARTITION BY e.role ORDER BY (count(e.id) FILTER (WHERE e.type = ?) - count(e.id) FILTER (WHERE e.type = ?)) DESC, e.command_head ASC) AS __q_rn FROM events AS e WHERE e.year = ? GROUP BY e.role, e.command_head) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_0 ASC, outstanding DESC, __q_1 ASC";

# Manually derived from the SQL text's placeholder order (see
# partition_bindings_match_sql_placeholder_order):
#   started_count FILTER, completed_count FILTER,
#   computed left, computed right,
#   window-order computed left, window-order computed right,
#   global WHERE year, outer take
def expected_computed_partition_bindings: Array(qb.Val) = [
    'String("task_started"), 'String("task_completed"),
    'String("task_started"), 'String("task_completed"),
    'String("task_started"), 'String("task_completed"),
    'Int(2024),
    'Int(3),
];

def computed_unknown_operand_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-computed-unknown",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.computed_item('Sub, "started_count", "missing_alias", "outstanding"),
        ],
        filter: 'None,
        joins: [],
        grouping: [qb.column("e", "role")],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

def computed_cycle_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-computed-cycle",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.computed_item('Sub, "b_count", "a_count", "c_count"),
            qb.computed_item('Sub, "c_count", "a_count", "b_count"),
        ],
        filter: 'None,
        joins: [],
        grouping: [qb.column("e", "role")],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

def computed_alias_conflict_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-computed-alias-conflict",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.aggregate('Count, qb.column("e", "id"), 'False, "started_count"),
            qb.aggregate('Count, qb.column("e", "id"), 'False, "started_count"),
        ],
        filter: 'None,
        joins: [],
        grouping: [qb.column("e", "role")],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

export def filtered_aggregates_lower_with_filters = do {
    let q = qb.transform_sqlite(filtered_aggregate_plan());
    q.sql == expected_filtered_sql && q.bindings == expected_filtered_bindings
};

export def filtered_aggregates_not_merged_into_global_and = do {
    # The global WHERE limits the whole fact set; each aggregate keeps its own
    # FILTER predicate.  They are never merged into a single AND.
    let q = qb.transform_sqlite(filtered_aggregate_plan());
    string.contains(q.sql, "FILTER (WHERE e.type = ?)")
        && string.contains(q.sql, "WHERE e.year = ?")
        && !string.contains(q.sql, "AND e.type")
};

export def filtered_aggregates_binding_order = do {
    # Bindings follow placeholder order: each FILTER's `?` then the global WHERE.
    let q = qb.transform_sqlite(filtered_aggregate_plan());
    (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
        && q.bindings[0] == 'String("task_started")
        && q.bindings[2] == 'Int(2024)
};

export def computed_aggregate_lowers_with_arithmetic = do {
    let q = qb.transform_sqlite(computed_aggregate_plan());
    q.sql == expected_computed_sql && q.bindings == expected_computed_bindings
};

export def computed_aggregate_usable_in_ordering = do {
    let q = qb.transform_sqlite(computed_aggregate_plan());
    string.contains(q.sql, "ORDER BY (count(e.id) FILTER (WHERE e.type = ?) - count(e.id) FILTER (WHERE e.type = ?)) DESC")
};

export def computed_aggregate_placeholders_match_bindings = do {
    let q = qb.transform_sqlite(computed_aggregate_plan());
    (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
};

export def computed_aggregate_deterministic = do {
    let q1 = qb.transform_sqlite(computed_aggregate_plan());
    let q2 = qb.transform_sqlite(computed_aggregate_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

export def computed_aggregate_with_partition_lowers = do {
    let q = qb.transform_sqlite(computed_partition_net_plan());
    q.sql == expected_computed_partition_sql
        && q.bindings == expected_computed_partition_bindings
};

export def computed_aggregate_with_partition_profile = do {
    qb.profile_accepts(computed_partition_net_plan(), full_profile())
};

export def partition_bindings_match_sql_placeholder_order = do {
    # Independent regression assertion: the expected bindings are derived by
    # reading the SQL text's `?` placeholders left-to-right, NOT from the
    # implementation's group assembly.  The inner SQL text is
    #   SELECT <projection>, <hidden>, row_number() OVER (PARTITION BY ...
    #          ORDER BY window-order ...) FROM ... JOIN ... WHERE ... GROUP BY ...
    # so the placeholder order is: projection, hidden, window partition/order,
    # join, global filter, grouping, then the outer take.
    let q = qb.transform_sqlite(computed_partition_net_plan());
    let expected: Array(qb.Val) = [
        'String("task_started"), 'String("task_completed"),
        'String("task_started"), 'String("task_completed"),
        'String("task_started"), 'String("task_completed"),
        'Int(2024), 'Int(3),
    ];
    q.bindings == expected
        && (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
};

export def computed_rejects_unknown_operand = do {
    !qb.structure_ok(computed_unknown_operand_plan())
};

export def computed_rejects_dependency_cycle = do {
    !qb.structure_ok(computed_cycle_plan())
};

export def computed_rejects_alias_conflict = do {
    !qb.structure_ok(computed_alias_conflict_plan())
};

export def filtered_predicate_profile_reject = do {
    # Allows Eq but not the scalar itself... this profile forbids the scalar.
    let no_eq: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Aggregate, 'Filter, 'Group],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr],
        allow_distinct: 'True,
    };
    !qb.profile_accepts(filtered_aggregate_plan(), no_eq)
};

export def filtered_aggregate_consumes_filter_capability = do {
    # A profile that allows the scalar `Eq` but forbids the `Filter` operator
    # must still reject a filtered aggregate: the aggregate-local predicate is
    # a Filter capability.
    let eq_but_no_filter: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate, 'Group],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Eq],
        allow_distinct: 'True,
    };
    !qb.profile_accepts(filtered_aggregate_plan(), eq_but_no_filter)
};

export def computed_aggregates_profile_accepts = do {
    qb.profile_accepts(computed_aggregate_plan(), full_profile())
};

def computed_add_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-computed-add",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.aggregate('Count, qb.column("e", "id"), 'False, "started_count"),
            qb.aggregate('Count, qb.column("e", "id"), 'False, "completed_count"),
            qb.computed_item('Add, "started_count", "completed_count", "total_count"),
        ],
        filter: 'None,
        joins: [],
        grouping: [qb.column("e", "role")],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

export def computed_aggregate_rejects_missing_add_scalar = do {
    # A `ComputedOp.Add` aggregate consumes `ScalarFunction.Add`; a profile
    # without `Add` must reject it even though it allows `Scalar`.
    let no_add: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate, 'Group],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Eq, 'Sub],
        allow_distinct: 'True,
    };
    !qb.profile_accepts(computed_add_plan(), no_add)
};

export def computed_aggregate_rejects_missing_sub_scalar = do {
    # A `ComputedOp.Sub` aggregate consumes `ScalarFunction.Sub`; a profile
    # without `Sub` must reject it.
    let no_sub: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate, 'Filter, 'Group, 'Order],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Eq, 'Add],
        allow_distinct: 'True,
    };
    !qb.profile_accepts(computed_aggregate_plan(), no_sub)
};

export def computed_aggregate_rejects_missing_scalar_operator = do {
    let no_scalar: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Aggregate, 'Filter, 'Group, 'Order],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Eq, 'Add, 'Sub],
        allow_distinct: 'True,
    };
    !qb.profile_accepts(computed_aggregate_plan(), no_scalar)
};

# ---------------------------------------------------------------------------
# JSON codec boundary (Val <-> untagged scalar JSON).
# ---------------------------------------------------------------------------

export def json_val_int_roundtrip = do {
    val_roundtrip('Int(3))
};

export def json_val_float_roundtrip = do {
    val_roundtrip('Float(3.5))
};

export def json_val_string_roundtrip = do {
    val_roundtrip('String("abc"))
};

export def json_val_bool_roundtrip = do {
    val_roundtrip('Bool('True))
};

export def json_val_int_encodes_as_scalar_number = do {
    encode_val('Int(3)) == 'Int(3)
};

export def json_val_float_encodes_as_scalar_number = do {
    encode_val('Float(3.5)) == 'Float(3.5)
};

export def json_val_string_encodes_as_scalar_string = do {
    encode_val('String("abc")) == 'String("abc")
};

export def json_val_bool_encodes_as_scalar_bool = do {
    encode_val('Bool('True)) == 'True
};

export def json_val_no_variant_wrapper = do {
    let encoded = json.stringify(encode_val('Int(3)));
    encoded == "3"
        && json.stringify(encode_val('Float(3.5))) == "3.5"
        && json.stringify(encode_val('String("abc"))) == "\"abc\""
        && json.stringify(encode_val('Bool('True))) == "true"
};

export def json_int_float_dispatch = do {
    json_to_val("3") == 'Int(3)
        && json_to_val("3.5") == 'Float(3.5)
        && json_to_val("\"abc\"") == 'String("abc")
        && json_to_val("true") == 'Bool('True)
};

export def json_float_whole_number_dispatch_boundary = do {
    # JSON text cannot preserve a whole-number Float: "3.0" parses to a Float
    # but the compact text "3" parses to an Int.  The Int/Float dispatch follows
    # the JSON parser: "3.0" stays Float, "3" is Int.  This is a documented
    # JSON codec boundary, not a QueryBuilder lowering change.
    json_to_val("3.0") == 'Float(3.0)
};

export def json_query_bindings_are_scalar_array = do {
    query_bindings_are_scalar_array(qb.transform_sqlite(demo_plan()))
};

export def json_query_encoded_bindings_match = do {
    let expected: Array(qb.Val) = ['Int(1), 'Int(3), 'Float(100.0), 'Int(10)];
    query_encoded_bindings_match(qb.transform_sqlite(demo_plan()), expected)
};

export def json_query_roundtrip = do {
    let q = qb.transform_sqlite(demo_plan());
    let encoded = codec.encode(Value, q) |> result.unwrap;
    let decoded: qb.Query = codec.decode(qb.Query, encoded) |> result.unwrap;
    decoded == q
};

export def json_query_bindings_no_wrapper_objects = do {
    let encoded = codec.encode(Value, qb.transform_sqlite(demo_plan())) |> result.unwrap;
    let has_wrapper = match encoded {
        'Object(fields) => match dict.get(fields, "bindings") {
            'Some('Array(items)) => array.any(items, fn(item) {
                match item {
                    'Object(_) => 'True,
                    'Array(_) => 'True,
                    _ => 'False,
                }
            }),
            _ => 'True,
        },
        _ => 'True,
    };
    !has_wrapper
};

export def json_codec_does_not_change_lowering = do {
    # The untagged codec property only affects the codec boundary; Query
    # generation and determinism are unchanged.
    let q1 = qb.transform_sqlite(demo_plan());
    let q2 = qb.transform_sqlite(demo_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
        && q1.sql == "SELECT o.customer_id, substr(o.name, ?, ?), sum(o.total) AS total_sum FROM orders AS o INNER JOIN customers AS c ON o.customer_id = c.id WHERE o.total > ? GROUP BY o.customer_id ORDER BY o.customer_id ASC LIMIT ?"
};
