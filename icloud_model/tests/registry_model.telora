use crate::typed as model;
use std::array;
use std::test;

pub def all_declared_roots_are_published: test::Test = test::should_ok(fn() {
    if array::length(model::roots) != 50 || array::length(model::payload.entities) != 50 || array::length(model::payload.relations) != 123 {
        fail!("IC root or relation coverage changed")
    } else { () }
});
pub def declared_grain_fields_are_non_nullable: test::Test = test::should_ok(fn() {
    if !array::all(model::payload.entities, fn(entity) {
        array::all(entity.grain_fields, fn(index) { !entity.fields[index].nullable })
    }) { fail!("IC dataset has an incomplete grain") } else { () }
});
