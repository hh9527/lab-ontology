use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::values as v;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::intent as intent;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::codec as codec;
use std::json as json;
use std::value::{Value};
use std::test as test;
type State = struct(String);
type OtherState = struct(String);
type Row = struct { id: Int, state: Option(String), score: Option(Float) };
def rows: m::Dataset(Row) = m::dataset("filtered", "filtered_rows", Row.type, ["id"]);
def domain: v::Domain(State, String) = v::domain("State", State.type, String.type, [v::member(State("yes"), ["wire_yes", "Y"]), v::member(State("no"), ["wire_no"])], False);
def state: v::Binding(Row) = v::bind(rows, v::dimension_group(domain, True, g::equality_filters), g::input(m::optional_field(Row.type, String.type, "state")), "state", True, g::equality_filters);
def base: t::Declaration = t::with_domains(t::map_columns(t::declare(rows, [], [], ["records"]), [
    t::column(m::field(Row.type, Int.type, "id"), "ROW_ID"),
    t::column(m::optional_field(Row.type, String.type, "state"), "STATE_CODE"),
    t::column(m::optional_field(Row.type, Float.type, "score"), "RAW_SCORE"),
]), [state]);
def matched: t::FieldCount(Row) = t::filtered_count(t::field_count(rows, m::field(Row.type, Int.type, "id"), "matched"), state, State("yes"));
def scored: t::FieldCount(Row) = t::filtered_count(t::field_count(rows, m::optional_field(Row.type, Float.type, "score"), "scored"), state, State("yes"));
def declared: t::Declaration = t::with_field_counts(base, [matched, scored]);
def profile: qb::PlanProfile = {allowed_operators: [qb::Operator::Source, qb::Operator::Column, qb::Operator::Project, qb::Operator::Aggregate, qb::Operator::Group, qb::Operator::Filter, qb::Operator::Scalar, qb::Operator::Bind], allowed_aggregates: [qb::AggregateFunction::Count], allowed_join_kinds: [], allowed_scalars: [qb::ScalarFunction::Add, qb::ScalarFunction::Sub,qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::If, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::IsNotNull], allow_distinct: False};
def combined: t::ComputedCount(Row) = t::combine_counts("combined", qb::ComputedOp::Add, t::count_ref(matched), t::count_ref(scored));
def weighted: t::ComputedCount(Row) = t::combine_counts("weighted", qb::ComputedOp::Add, t::computed_count_ref(combined), t::count_ref(matched));
def difference: t::ComputedCount(Row) = t::combine_counts("difference", qb::ComputedOp::Sub, t::computed_count_ref(combined), t::computed_count_ref(weighted));
def computed: t::Declaration = t::with_computed_counts(declared, [weighted, difference, combined]);
def payload: edsl::PreparedPayload = t::prepare("computed", [computed], profile).payload;
pub def nested_count_dependencies_are_preserved: test::Test = test::should_ok(fn() { payload.measures[3].computed == Some({op: qb::ComputedOp::Add, left: "combined", right: "matched"}) });
pub def missing_operand_is_rejected: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [t::checked_with_computed_counts(declared, [combined <~ {left: combined.left <~ {id: "missing"}}])], profile) }, "computed count requires a declared count operand");
pub def cross_dataset_operand_is_rejected: test::Test = test::should_fail_with(fn() { t::checked_combine_counts("bad", qb::ComputedOp::Add, t::count_ref(matched), t::count_ref(scored) <~ {dataset: "other"}) }, "computed counts require operands from the same dataset");
pub def erased_cross_dataset_is_rechecked: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [t::checked_with_computed_counts(declared, [combined <~ {left: combined.left <~ {source: "other"}}])], profile) }, "computed count reference belongs to another dataset");
pub def cycle_is_rejected: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [t::checked_with_computed_counts(declared, [combined <~ {left: combined.result}])], profile) }, "computed measure dependency cycle");
pub def duplicate_result_is_rejected: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [t::checked_with_computed_counts(declared, [combined, combined])], profile) }, "typed transform measure ids must be unique");
type Case = struct { id: String, sqlite: qb::Query, postgres: qb::Query };
def runtime_case: Fn(String, String) -> Case = fn(id, extra) {
    let ast = intent::query_intent_ast_factory(payload)(json::parse(`{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"filtered"}],"edges":[],\{extra}}`).unwrap!());
    {id, sqlite: sqlite::build_query(ast), postgres: postgres::build_query(ast)}
};
pub def runtime_cases: Value = codec::encode([
    runtime_case("total", r#""select":[],"measures":[{"node":"r","measure":"weighted"},{"node":"r","measure":"combined"},{"node":"r","measure":"difference"}]"#),
    runtime_case("narrowed", r#""select":[],"measures":[{"node":"r","measure":"weighted"},{"node":"r","measure":"combined"},{"node":"r","measure":"difference"}],"filters":[{"node":"r","dimension":"state","op":"Eq","value":"no"}]"#),
]);
pub def arithmetic_profile_is_required: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [computed], profile <~ {allowed_scalars: [qb::ScalarFunction::Eq]}) }, "computed count arithmetic is not allowed by the query profile");
