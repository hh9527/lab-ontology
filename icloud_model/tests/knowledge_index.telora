use crate::model::{ payload };
use ontology::knowledge as knowledge;
use std::value::{ Value };
use std::array as array;
use std::test as test;

pub def cached_index_preserves_complete_catalog_order: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload, "public");
    let input = Value::Object({key: Value::Object({kind: Value::String("Schema"), owner: Value::String(""), id: Value::String("index")})});
    let cached = info(input);
    let original = knowledge::serve_value(payload, "public", "ic",
        Value::Object({method: Value::String("ic/info"), input}));
    if cached == original { True }
    else { fail!("cached index topic changed point order or content", cached, original) }
});

pub def flat_index_covers_complex_model_once_per_key: test::Test = test::should_ok(fn() {
    let points = knowledge::map(payload, "public");
    let entries = knowledge::index_entries(points).entries;
    let lightweight = knowledge::index_from_model(payload, "public").entries;
    if entries == lightweight && array::length(entries) == array::length(points) && array::length(entries) > 19
        && array::any(entries, fn(entry) { entry.key.id == "device" })
        && array::any(entries, fn(entry) { entry.key.id == "alarm_belongs_to_tenant" })
        && array::any(entries, fn(entry) { entry.key.id == "critical" })
        && array::all(entries, fn(entry) {
            array::length(array::filter(entries, fn(other) { other.key == entry.key })) == 1
        }) { True }
    else { fail!("flat IC index duplicated, omitted or changed a knowledge point") }
});
