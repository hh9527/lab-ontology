# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::transform as t;
use ontology::query as qb;
type ResourceId = struct(
    String
);
type EffectiveCount = struct(
    Int
);
# 仅沿用旧百分比尺度假定，尚未确认生产比例；不增加范围检查。
type AssumedOnlinePercent = struct(
    Float
);
def online_statistics: samples::Group(AssumedOnlinePercent) = samples::group(
    "reported_network_online",
    AssumedOnlinePercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max],
    Some("%")
);
type Row = struct {
    source_ts: s::DateTimeUtc,
    source_resId: ResourceId,
    source_tenantId: i::TenantId,
    source_parentId: String,
    source_projectId: String,
    source_deviceName: String,
    source_classification: String,
    source_onlineRate: AssumedOnlinePercent,
    source_onlineRateEffcnt: EffectiveCount,
};
def dataset: m::Dataset(Row) = m::dataset(
    "source_NetworkDeviceOnlineKPI",
    "NetworkDeviceOnlineKPI",
    Row.type,
    ["source_resId", "source_tenantId", "source_ts"]
);
def raw: t::Declaration = t::map_columns(
    t::declare(
        dataset,
        [],
        [
            g::dimension(
                dataset,
                g::dimension_group(
                    "source_NetworkDeviceOnlineKPI__ts",
                    s::DateTimeUtc.type,
                    True,
                    g::numeric_filters
                ),
                g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")),
                "source_NetworkDeviceOnlineKPI__ts",
                True,
                g::numeric_filters
            ),
            g::dimension(
                dataset,
                g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
                g::utc_bucket(
                    g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")),
                    qb::UtcBucketUnit::Hour
                ),
                "source_NetworkDeviceOnlineKPI_utc_hour",
                True,
                g::time_filters
            ),
            g::dimension(
                dataset,
                g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
                g::utc_bucket(
                    g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")),
                    qb::UtcBucketUnit::Day
                ),
                "source_NetworkDeviceOnlineKPI_utc_day",
                True,
                g::time_filters
            ),
            g::dimension(
                dataset,
                g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
                g::utc_bucket(
                    g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")),
                    qb::UtcBucketUnit::Month
                ),
                "source_NetworkDeviceOnlineKPI_utc_month",
                True,
                g::time_filters
            ),
            i::exact(
                dataset,
                m::field(Row.type, ResourceId.type, "source_resId"),
                "source_NetworkDeviceOnlineKPI__resId"
            ),
            i::exact(
                dataset,
                m::field(Row.type, i::TenantId.type, "source_tenantId"),
                "source_NetworkDeviceOnlineKPI__tenantId"
            ),
            i::exact(
                dataset,
                m::field(Row.type, String.type, "source_parentId"),
                "source_NetworkDeviceOnlineKPI__parentId"
            ),
            i::exact(
                dataset,
                m::field(Row.type, String.type, "source_projectId"),
                "source_NetworkDeviceOnlineKPI__projectId"
            ),
            i::search(
                dataset,
                m::field(Row.type, String.type, "source_deviceName"),
                "source_NetworkDeviceOnlineKPI__deviceName"
            ),
            i::exact(
                dataset,
                m::field(Row.type, String.type, "source_classification"),
                "source_NetworkDeviceOnlineKPI__classification"
            ),
            g::dimension(
                dataset,
                g::dimension_group(
                    "source_NetworkDeviceOnlineKPI__onlineRate",
                    AssumedOnlinePercent.type,
                    True,
                    g::numeric_filters
                ),
                g::input(m::field(Row.type, AssumedOnlinePercent.type, "source_onlineRate")),
                "source_NetworkDeviceOnlineKPI__onlineRate",
                True,
                g::numeric_filters
            ),
            g::dimension(
                dataset,
                g::dimension_group(
                    "source_NetworkDeviceOnlineKPI__onlineRateEffcnt",
                    EffectiveCount.type,
                    True,
                    g::numeric_filters
                ),
                g::input(m::field(Row.type, EffectiveCount.type, "source_onlineRateEffcnt")),
                "source_NetworkDeviceOnlineKPI__onlineRateEffcnt",
                True,
                g::numeric_filters
            ),
        ],
        []
    ),
    [
        t::column(m::field(Row.type, s::DateTimeUtc.type, "source_ts"), "ts"),
        t::column(m::field(Row.type, ResourceId.type, "source_resId"), "resId"),
        t::column(m::field(Row.type, i::TenantId.type, "source_tenantId"), "tenantId"),
        t::column(m::field(Row.type, String.type, "source_parentId"), "parentId"),
        t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
        t::column(m::field(Row.type, String.type, "source_deviceName"), "deviceName"),
        t::column(m::field(Row.type, String.type, "source_classification"), "classification"),
        t::column(m::field(Row.type, AssumedOnlinePercent.type, "source_onlineRate"), "onlineRate"),
        t::column(
            m::field(Row.type, EffectiveCount.type, "source_onlineRateEffcnt"),
            "onlineRateEffcnt"
        ),
    ]
);
def declaration: t::Declaration = t::with_samples(
    t::metric(raw, m::field(Row.type, s::DateTimeUtc.type, "source_ts")),
    [
        samples::bind(
            dataset,
            online_statistics,
            m::field(Row.type, AssumedOnlinePercent.type, "source_onlineRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "network_online_rate_avg"},
                {statistic: samples::Statistic::Min, publish: "network_online_rate_min"},
                {statistic: samples::Statistic::Max, publish: "network_online_rate_max"}
            ]
        ),
    ]
);
pub use self::{declaration};
