    let plan: qb.Plan = {
        revision: "test-unknown-alias",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("missing", "id"))],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: 'None,
    };
    plan
