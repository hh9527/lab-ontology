# 将独立 Entity 角色绑定为具名 Dataset 关系；只服务 transform。
use crate::model as model;
use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::codec as codec;
use std::value::{Value};
use crate::groups as g;
use std::type_desc as td;
use crate::registry_impl as registry;
use std::type_memorizer as memo;

type Endpoint = struct {
    dataset: model::PreparedDataset,
    role: String,
    binding: model::PreparedRole
};
type Guard = struct {
    row: Type,
    dataset: String,
    source: String,
    column: g::Column,
    op: edsl::FilterOp,
    input: edsl::FilterInput
};
type Relation = struct {
    key: edsl::RelationKey,
    guard: Option(Guard),
    id: String,
    from: Endpoint,
    to: Endpoint,
    cardinality: edsl::RelationCardinality
};
type Link = struct {
    guard: Option(Guard),
    id: String,
    a: Relation,
    z: Relation,
    direction: edsl::LinkDirection
};

def endpoint: Fn(Type, String) -> Endpoint = fn(row, name) {
    let dataset = registry::declaration(row).dataset;
    match array::find(
        dataset.roles,
        fn(role) {
            role.id == name
        }
    ) {
        Some(binding) => {dataset, role: name, binding},
        None => fail!("relation endpoint role does not exist", dataset.id, name)
    }
};
def relation: Fn(String, Endpoint, Endpoint, edsl::RelationCardinality) -> Relation = fn(
    id,
    from,
    to,
    cardinality
) {
    if id == "" {
        fail!("typed relation id must be nonempty")
    } else if from.binding.entity != to.binding.entity || from.binding.identity != to.binding.identity {
        fail!("relation endpoints must describe the same entity identity", id)
    } else {
        # Role 的 parts 已按同一 Identity 的字段顺序完成准备，直接配对索引。
        let parts = array::map(to.binding.parts, fn(other) {
            edsl::RelationKey::Eq({
                from: from.binding.parts[other.target_index].source_index,
                to: other.source_index
            })
        });
        let key = if array::length(parts) == 1 {
            parts[0]
        } else {
            edsl::RelationKey::And(parts)
        };
        {guard: None, id, from, to, cardinality, key}
    }
};
def guarded: for(Row, Scalar: codec::Encode) Fn(
    Relation,
    model::Field(Row, Scalar),
    edsl::FilterOp,
    Scalar
) -> Relation = fn(relation, field, op, value) {
    if relation.from.dataset.row != Row.type {
        fail!("relation guard belongs to another source row", relation.id)
    } else if op != edsl::FilterOp::Eq && op != edsl::FilterOp::Ne {
        fail!("relation guard supports only Eq or Ne", relation.id)
    } else {
        relation <~ {
            guard: Some(
                {
                    row: Row.type,
                    dataset: relation.from.dataset.id,
                    source: relation.from.dataset.source,
                    column: {
                        index: field.index,
                        name: field.name,
                        value: Scalar.type,
                        nullable: field.nullable
                    },
                    op,
                    input: scalar_input(value)
                }
            )
        }
    }
};
def link: Fn(String, Relation, Relation, edsl::LinkDirection) -> Link = fn(id, a, z, direction) {
    if id == "" || a.id == z.id || a.from.dataset.row != z.from.dataset.row || a.from.role == z.from.role || a.to.dataset.row != z.to.dataset.row || a.to.role != z.to.role {
        fail!("business link requires distinct hub roles and one explicit participant dataset", id)
    } else {
        {guard: None, id, a, z, direction}
    }
};
def guarded_link: for(Row, Scalar: codec::Encode) Fn(
    Link,
    model::Field(Row, Scalar),
    edsl::FilterOp,
    Scalar
) -> Link = fn(declared, field, op, value) {
    declared <~ {guard: guarded(declared.a, field, op, value).guard}
};
# World 的端点登记约束只在此首次解析；同一 Dataset 的所有关系复用结果。
type Owners = memo::TypeMemorizer(edsl::EntityEntry);
def owners: Fn(edsl::PreparedPayload) -> Owners = fn(payload) {
    memo::type_memorizer(fn(row) {
        match array::find(payload.entities, fn(entry) { entry.entity_type == row }) {
            Some(entry) => entry,
            None => fail!("relation endpoint dataset is not registered in World", row)
        }
    })
};
def owner: Fn(Owners, Endpoint) -> edsl::EntityEntry = fn(owners, endpoint) {
    memo::computed_with_type(owners, endpoint.dataset.row)
};
def guard: Fn(Option(Guard)) -> Option(edsl::PreparedGuard) = fn(value) {
    match value {
        None => None,
        Some(value) => Some({field: value.column.name, index: value.column.index, op: value.op, input: value.input})
    }
};
def lower: Fn(Owners, Relation) -> edsl::RelationEntry = fn(owners, declared) {
    let from = owner(owners, declared.from);
    let to = owner(owners, declared.to);
    {
        id: declared.id,
        label: declared.id,
        summary: "",
        from: from.index,
        to: to.index,
        cardinality: declared.cardinality,
        key: declared.key,
        guard: guard(declared.guard)
    }
};
def lower_all: Fn(Owners, Array(Relation)) -> Array(edsl::RelationEntry) = fn(
    owners,
    declarations
) {
    array::map(
        declarations,
        fn(declared) {
            lower(owners, declared)
        }
    )
};
def lower_alternative: Fn(
    Owners,
    String,
    Array(Relation),
    edsl::RelationCardinality
) -> edsl::RelationEntry = fn(owners, id, choices, cardinality) {
    let lowered = lower_all(owners, choices);
    lowered[0] <~ {
        id,
        label: id,
        cardinality,
        key: edsl::RelationKey::Or(
            array::map(
                lowered,
                fn(relation) {
                    relation.key
                }
            )
        )
    }
};
def lower_link: Fn(Owners, Link) -> edsl::BusinessLinkEntry = fn(owners, declared) {
    let hub = owner(owners, declared.a.from);
    let participant = owner(owners, declared.a.to);
    {
        id: declared.id,
        hub: hub.index,
        participant: participant.index,
        a_relation: declared.a.id,
        z_relation: declared.z.id,
        direction: declared.direction,
        guard: guard(declared.guard)
    }
};
pub use self::{
    Owners,
    owners,
    Guard,
    guarded_link,
    guarded,
    Endpoint,
    Relation,
    Link,
    endpoint,
    relation,
    link,
    lower,
    lower_all,
    lower_alternative,
    lower_link
};
def scalar_input: for(Scalar: codec::Encode) Fn(Scalar) -> edsl::FilterInput = fn(value) {
    match codec::encode(value) {
        Value::String(text) => edsl::FilterInput::Text(text),
        Value::Int(number) => edsl::FilterInput::Int(number),
        Value::Float(number) => edsl::FilterInput::Number(number),
        Value::True => edsl::FilterInput::Bool(True),
        Value::False => edsl::FilterInput::Bool(False),
        _ => fail!("model predicate requires a scalar literal"),
    }
};
