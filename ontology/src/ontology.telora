    fn(ctx, previous) {
        let labels = match previous { Some(p) => p.labels, None => [] };
        { labels: array::push(labels, label) }
    }
};

def relation_description: Fn(String, String, String) -> Fn(td::TypeDesc, Option(RelationDescriptions)) -> RelationDescriptions = fn(id, label, summary) {
    fn(ctx, previous) {
        if id == "" || label == "" || summary == "" { fail!("relation description requires id, label and summary") }
        else {
            let note: RelationNote = { id, label, summary };
            let notes = match previous {
                Some(p) => array::push(p.notes, note),
                None => [note],
            };
            let result: RelationDescriptions = { notes };
            result
        }
    }
};

def localized_relation: Fn(String, String, String, String) -> Fn(td::TypeDesc, Option(LocalizedRelationTexts)) -> LocalizedRelationTexts = fn(id, locale, label, summary) {
    fn(ctx, previous) {
        let notes = match previous { Some(p) => p.notes, None => [] };
        {notes: array::push(notes, {id, text: {locale, label, summary}})}
    }
};

def relation_alias: Fn(String, String) -> Fn(td::TypeDesc, Option(RelationAliasesDef)) -> RelationAliasesDef = fn(id, label) {
    fn(ctx, previous) {
        let aliases = match previous { Some(p) => p.aliases, None => [] };
        { aliases: array::push(aliases, {id, label}) }
    }
};

# Union (multi-source) entity provider: marks the annotated type as a logical
# entity backed by an ordered UNION ALL of physical branches. Mutually exclusive
# with `entity_source`; branch aliases must not collide with the union alias.
def union_source: Fn(String, Array(UnionBranchDecl)) -> Fn(td::TypeDesc, Option(UnionSourceDef)) -> UnionSourceDef = fn(u_alias, branches) {
    fn(ctx, previous) {
        let result: UnionSourceDef = { alias: u_alias, branches };
        result
    }
};

# Single-column-equality relation sugar: `from_field` is a canonical field
# index on the declaring entity, `to_field` on the target entity.
def relation: Fn(Type, RelationKind, Int, Int) -> Fn(td::TypeDesc, Option(RelationDef)) -> RelationDef = fn(target, kind, from_field, to_field) {
    fn(ctx, previous) {
        let pair: RelationPair = { from: from_field, to: to_field };
        let entry: RelationDecl = { id: "", target, kind, key: RelationKey::Eq(pair) };
        let relations = match previous {
            Some(p) => array::push(p.relations, entry),
            None => [entry],
        };
        let result: RelationDef = { relations };
        result
    }
};

# Relation with a structured key: `RelationKey.Eq(pair)`, `RelationKey.And(...)` or `RelationKey.Or(...)` over
# column-equality pairs (conjunctive/disjunctive keys). Multiple annotations
# fold by appending.
def relation_key: Fn(Type, RelationKind, RelationKey) -> Fn(td::TypeDesc, Option(RelationDef)) -> RelationDef = fn(target, kind, key) {
    fn(ctx, previous) {
        let entry: RelationDecl = { id: "", target, kind, key };
        let relations = match previous {
            Some(p) => array::push(p.relations, entry),
            None => [entry],
        };
        let result: RelationDef = { relations };
        result
    }
};

def named_relation_key: Fn(String, Type, RelationKind, RelationKey) -> Fn(td::TypeDesc, Option(RelationDef)) -> RelationDef = fn(id, target, kind, key) {
    fn(ctx, previous) {
        if id == "" { fail!("named relation requires a nonempty id") } else {
            let entry: RelationDecl = { id, target, kind, key };
            let relations = match previous {
                Some(p) => array::push(p.relations, entry),
                None => [entry],
            };
            let result: RelationDef = { relations };
            result
        }
    }
};

def named_typed_relation_key: for(Src, Dest) Fn(String, TypeOf(Src), TypeOf(Dest), RelationKind, Array(TypedRelationPair(Src, Dest))) -> Fn(td::TypeDesc, Option(RelationDef)) -> RelationDef = fn(id, source, target, kind, pairs) {
    fn(ctx, previous) {
        if ctx != source {
            fail!("typed relation source differs from the annotated entity", ctx, source)
        } else if id == "" || array::length(pairs) == 0 {
            fail!("named typed relation requires a nonempty id and key", source, target, id)
        } else {
            let keys = array::map(pairs, fn(pair) {
                RelationKey::FieldEq({from: pair.from, to: pair.to})
            });
            let key = if array::length(keys) == 1 { keys[0] } else { RelationKey::And(keys) };
            let entry: RelationDecl = {id, target, kind, key};
            let relations = match previous {
                Some(p) => array::push(p.relations, entry),
                None => [entry],
            };
            {relations}
        }
    }
};

def business_link: Fn(String, String, String, LinkDirection) -> Fn(td::TypeDesc, Option(BusinessLinkDef)) -> BusinessLinkDef = fn(id, a_relation, z_relation, direction) {
    fn(ctx, previous) {
        if id == "" || a_relation == "" || z_relation == "" || a_relation == z_relation {
            fail!("business link requires a name and two distinct endpoint relations", id, a_relation, z_relation)
        } else {
            let entry: BusinessLinkDecl = {id, a_relation, z_relation, direction};
            let links = match previous { Some(p) => array::push(p.links, entry), None => [entry] };
            {links}
        }
    }
};

def enum_value: Fn(String, String) -> Fn(property::VariantPropertyCtx, Option(EnumValueDef)) -> EnumValueDef = fn(value, label) {
    fn(ctx, previous) {
        let result: EnumValueDef = { value, label };
        result
    }
};

def canonical_values: Fn(Array(CanonicalValueSpec)) -> Fn(property::FieldPropertyCtx, Option(CanonicalValuesDef)) -> CanonicalValuesDef = fn(values) {
    fn(ctx, previous) {
        if previous != None {
            fail!("canonical value domain must be declared once per field", ctx)
        } else {
            { values }
        }
    }
};

def canonical_alias: Fn(String, String) -> Fn(property::FieldPropertyCtx, Option(CanonicalAliasesDef)) -> CanonicalAliasesDef = fn(id, label) {
    fn(ctx, previous) {
        let aliases = match previous {
            Some(p) => p.aliases,
            None => [],
        };
        {aliases: array::push(aliases, {id, label})}
    }
};

def localized_canonical_value: Fn(String, String, String) -> Fn(property::FieldPropertyCtx, Option(LocalizedCanonicalValuesDef)) -> LocalizedCanonicalValuesDef = fn(id, locale, label) {
    fn(ctx, previous) {
        let labels = match previous { Some(p) => p.labels, None => [] };
        {labels: array::push(labels, {id, locale, label})}
    }
};

def scope: Fn(Array(ScopePredicate)) -> Fn(property::FieldPropertyCtx, Option(ScopeDef)) -> ScopeDef = fn(predicates) {
    fn(ctx, previous) {
        let all = match previous {
            Some(p) => array::concat([p.predicates, predicates]),
            None => predicates,
        };
        let result: ScopeDef = { predicates: all };
        result
    }
};

def entity_scope: Fn(Array(EntityScopePredicate)) -> Fn(td::TypeDesc, Option(EntityScopeDef)) -> EntityScopeDef = fn(predicates) {
    fn(ctx, previous) {
        let all = match previous {
            Some(p) => array::concat([p.predicates, predicates]),
            None => predicates,
        };
        {predicates: all}
    }
};

def native_pair: Fn(String, String, String) -> Fn(td::TypeDesc, Option(NativePairDef)) -> NativePairDef = fn(id, first, second) {
    fn(ctx, previous) {
        let spec: NativePairSpec = { id, first, second };
        let pairs = match previous { Some(p) => array::push(p.pairs, spec), None => [spec] };
        { pairs }
    }
};

# Dual-endpoint hub declaration on the hub entity type: the hub is the base
# grain and its two role fields (`left_field`, `right_field`) reference the
# participant entity's `key_field`.  Multiple annotations fold by appending.
def dual_hub: Fn(Type, Int, Int, Int) -> Fn(td::TypeDesc, Option(DualHubDef)) -> DualHubDef = fn(participant, key_field, left_field, right_field) {
    fn(ctx, previous) {
        let spec: DualHubDecl = { participant, key_field, left_field, right_field };
        let all = match previous {
            Some(p) => array::push(p.hubs, spec),
            None => [spec],
        };
        let result: DualHubDef = { hubs: all };
        result
    }
};

# Paired-endpoint (peer) route declaration on the hub entity type.  The two hub
# role fields (`origin_field`, `peer_field`) reference the declared key fields
# (`origin_key`, `peer_key`) of the two participant entities.  When the two
# participants are the same entity the pair is symmetric and both endpoint
# assignments are allowed; otherwise each participant is pinned to its slot.
# Multiple annotations fold by appending.
def peer_hub: Fn(Type, Int, Int, Type, Int, Int) -> Fn(td::TypeDesc, Option(PeerHubDef)) -> PeerHubDef = fn(origin_participant, origin_key, origin_field, peer_participant, peer_key, peer_field) {
    fn(ctx, previous) {
        let spec: PeerHubDecl = { origin_participant, origin_key, origin_field, peer_participant, peer_key, peer_field, directed: False, field_names: None, relations: None };
        let all = match previous {
            Some(p) => array::push(p.hubs, spec),
            None => [spec],
        };
        let result: PeerHubDef = { hubs: all };
        result
    }
};

# Preserve the authored origin/peer roles even when both endpoints refer to
# the same participant entity. No endpoint-exchange branch is generated.
def directed_peer_hub: Fn(Type, Int, Int, Type, Int, Int) -> Fn(td::TypeDesc, Option(PeerHubDef)) -> PeerHubDef = fn(origin_participant, origin_key, origin_field, peer_participant, peer_key, peer_field) {
    fn(ctx, previous) {
        let spec: PeerHubDecl = { origin_participant, origin_key, origin_field, peer_participant, peer_key, peer_field, directed: True, field_names: None, relations: None };
        let all = match previous {
            Some(p) => array::push(p.hubs, spec),
            None => [spec],
        };
        { hubs: all }
    }
};

def directed_peer_hub_fields: Fn(Type, String, String, Type, String, String) -> Fn(td::TypeDesc, Option(PeerHubDef)) -> PeerHubDef = fn(origin_participant, origin_key, origin_field, peer_participant, peer_key, peer_field) {
    fn(ctx, previous) {
        let names: PeerHubFieldNames = { origin_key, origin_field, peer_key, peer_field };
        let spec: PeerHubDecl = { origin_participant, origin_key: -1, origin_field: -1, peer_participant, peer_key: -1, peer_field: -1, directed: True, field_names: Some(names), relations: None };
        let all = match previous { Some(p) => array::push(p.hubs, spec), None => [spec] };
        { hubs: all }
    }
};

def directed_peer_hub_relation_fields: Fn(Type, String, String, String, Type, String, String, String) -> Fn(td::TypeDesc, Option(PeerHubDef)) -> PeerHubDef = fn(origin_participant, origin_key, origin_field, origin_relation, peer_participant, peer_key, peer_field, peer_relation) {
    fn(ctx, previous) {
        let names: PeerHubFieldNames = { origin_key, origin_field, peer_key, peer_field };
        let relations: PeerHubRelations = { origin: origin_relation, peer: peer_relation };
        let spec: PeerHubDecl = { origin_participant, origin_key: -1, origin_field: -1, peer_participant, peer_key: -1, peer_field: -1, directed: True, field_names: Some(names), relations: Some(relations) };
        let all = match previous { Some(p) => array::push(p.hubs, spec), None => [spec] };
        { hubs: all }
    }
};

# A/Z are physical storage positions; either participant can occupy either end
# when the declared business connection is bidirectional.
def peer_hub_relation_fields: Fn(Type, String, String, String, Type, String, String, String) -> Fn(td::TypeDesc, Option(PeerHubDef)) -> PeerHubDef = fn(origin_participant, origin_key, origin_field, origin_relation, peer_participant, peer_key, peer_field, peer_relation) {
    fn(ctx, previous) {
        let names: PeerHubFieldNames = { origin_key, origin_field, peer_key, peer_field };
        let relations: PeerHubRelations = { origin: origin_relation, peer: peer_relation };
        let spec: PeerHubDecl = { origin_participant, origin_key: -1, origin_field: -1, peer_participant, peer_key: -1, peer_field: -1, directed: False, field_names: Some(names), relations: Some(relations) };
        let all = match previous { Some(p) => array::push(p.hubs, spec), None => [spec] };
        { hubs: all }
    }
};

# ---------------------------------------------------------------------------
# Prepare-time helpers.
# ---------------------------------------------------------------------------

def get_index: for(A) Fn(Array(A), Int) -> A = fn(values, i) {
    match array::get(values, i) {
        Some(v) => v,
        None => fail!("index out of range", i),
    }
};

def int_range: Fn(Int) -> Array(Int) = fn(n) {
    if n <= 0 { [] } else { array::push(int_range(n - 1), n - 1) }
};

def build_field: Fn(Type, Int, String, Type) -> FieldEntry = fn(owner, index, name, field_ty) {
    if let Some(role) = property::get_field_prop(owner, index, TimeField.type) {
        let expected = match role.encoding {
            TimeEncoding::CanonicalUtcSecondText => String.type,
            TimeEncoding::UtcEpochMillis => Int.type,
            TimeEncoding::LocalText => String.type,
            TimeEncoding::LocalEpochMillis => Int.type,
        };
        if field_ty != expected {
            fail!("time encoding disagrees with field type", name, role.encoding)
        } else { () }
    } else { () };
    let col = property::get_field_prop(owner, index, ColumnMap.type);
    let column = match col {
        Some(c) => c.column,
        None => "",
    };
    let key = property::get_field_prop(owner, index, KeyFlag.type);
    let is_key = match key {
        Some(k) => k.value,
        None => False,
    };
    let result: FieldEntry = { index, name, column, is_key, ty: field_ty };
    result
};

# Prepare one union (multi-source) entity. Logical fields are the type's
# canonical fields; each field must declare a non-empty, distinct logical column
# (the stable output name). Every branch maps the full canonical field set to
# its own physical columns with a consistent (ascending field-index) order;
# physical columns, tables and aliases must be legal identifiers. Branch aliases
# are unique and distinct from the union alias; optional fixed branch filters
# must be Eq over a valid logical field.
def branch_mapping_ok: Fn(Array(FieldEntry), UnionBranchDecl) -> Array(String) = fn(fields, branch) {
    if array::length(branch.columns) != array::length(fields) {
        fail!("union branch must map every logical field exactly once", branch.columns, fields)
    } else {
        let bad_order = array::find(branch.columns, fn(c) {
            c.field < 0 || c.field >= array::length(fields)
        });
        let mapped = array::enumerate(branch.columns);
        let bad_duplicate = array::find(mapped, fn(pair) {
            array::length(array::filter(branch.columns, fn(o) { o.field == pair.1.field })) > 1
        });
        if let Some(column) = bad_order {
            fail!("union branch column mapping is out of range", column.field, fields)
        } else if let Some(duplicate) = bad_duplicate {
            let conflicts = array::filter(branch.columns, fn(column) { column.field == duplicate.1.field });
            fail!("union branch maps the same logical field more than once",
                get_index(conflicts, 0).field, get_index(conflicts, 1).field)
        } else {
            # deterministic, consistent order: canonical field i must appear at
            # position i (an ascending, exactly-once mapping)
            let order_bad = array::any(mapped, fn(pair) { pair.1.field != pair.0 });
            let bad_col = array::find(branch.columns, fn(c) { !qb::is_sql_identifier(c.column) });
            if order_bad {
                fail!("union branch column mapping must use a consistent ascending field order", branch.columns)
            } else if let Some(column) = bad_col {
                fail!("union branch physical column is not a legal identifier", column.column)
            } else {
                array::map(branch.columns, fn(c) { c.column })
            }
        }
    }
};

def union_filter_value_ok: Fn(FieldEntry, FilterInput) -> Bool = fn(field, input) {
    match input {
        FilterInput::Text(value) => field.ty == String.type
            || array::any(value_domain(field.ty), fn(entry) { entry.value == value }),
        FilterInput::Int(_) => field.ty == Int.type,
        FilterInput::Number(_) => field.ty == Float.type,
        FilterInput::Bool(_) => field.ty == Bool.type,
    }
};

def build_union_entry: Fn(Type, Array(FieldEntry), UnionSourceDef) -> UnionEntry = fn(ty, fields, spec) {
    if array::length(spec.branches) == 0 {
        fail!("union entity must declare at least one branch", ty)
    } else if array::length(fields) == 0 {
        fail!("union entity must declare at least one logical field", ty)
    } else {
        let empty_col = array::find(fields, fn(f) { f.column == "" });
        let dup_col = array::find(fields, fn(f) {
            array::length(array::filter(fields, fn(o) { o.column == f.column })) > 1
        });
        let union_bad_id = !qb::is_sql_identifier(spec.alias);
        let alias_dup = array::find(spec.branches, fn(b) {
            array::length(array::filter(spec.branches, fn(o) { o.alias == b.alias })) > 1
        });
        let alias_clash = array::find(spec.branches, fn(b) { b.alias == spec.alias });
        let bad_table = array::find(spec.branches, fn(b) { !qb::is_sql_identifier(b.table) });
        let bad_branch_alias = array::find(spec.branches, fn(b) { !qb::is_sql_identifier(b.alias) });
        let bad_filter = array::find(spec.branches, fn(b) {
            match b.filter {
                None => False,
                Some(p) => p.op != FilterOp::Eq || p.field < 0 || p.field >= array::length(fields),
            }
        });
        let bad_filter_value = array::find(spec.branches, fn(b) {
            match b.filter {
                None => False,
                Some(p) => if p.field < 0 || p.field >= array::length(fields) { False }
                    else { !union_filter_value_ok(get_index(fields, p.field), p.input) },
            }
        });
        if empty_col != None {
            fail!("union entity fields must declare physical columns", ty)
        } else if dup_col != None {
            fail!("union entity fields must map to distinct output columns", ty)
        } else if union_bad_id {
            fail!("union alias is not a legal identifier", ty)
        } else if alias_dup != None {
            fail!("union branches must use distinct aliases", ty)
        } else if alias_clash != None {
            fail!("union branch alias must not equal the union alias", ty)
        } else if bad_table != None {
            fail!("union branch table is not a legal identifier", ty)
        } else if bad_branch_alias != None {
            fail!("union branch alias is not a legal identifier", ty)
        } else if bad_filter != None {
            fail!("union branch filter must be Eq over a valid logical field", ty)
        } else if let Some(branch) = bad_filter_value {
            fail!("union branch filter value does not match logical field", ty, branch.filter)
        } else {
            let prepared_branches = array::map(spec.branches, fn(b) {
                let columns = branch_mapping_ok(fields, b);
                let result: UnionBranchEntry = { table: b.table, alias: b.alias, columns, filter: b.filter };
                result
            });
            let result: UnionEntry = { alias: spec.alias, branches: prepared_branches };
            result
        }
    }
};

def nullable_identity_type: Fn(Type) -> Bool = fn(ty) {
    match td::kind(ty) {
        td::TypeDescKind::Enum => do {
            let variants = td::variants(ty);
            array::length(variants) == 2
                && array::any(variants, fn(v) { v.name == "None" && v.payload == None })
                && array::any(variants, fn(v) { v.name == "Some" && v.payload != None })
        },
        _ => False,
    }
};

def build_entity: Fn(Type, Int) -> EntityEntry = fn(ty, index) {
    let src = property::get_type_prop(ty, EntitySource.type);
    let union_prop = property::get_type_prop(ty, UnionSourceDef.type);
    let declared_id = property::get_type_prop(ty, EntityId.type);
    let dataset_spec = property::get_type_prop(ty, DatasetSpec.type);
    let description = property::get_type_prop(ty, DatasetDescription.type);
    let field_descs = td::fields(ty);
    let enumerated = array::enumerate(field_descs);
    let fields = array::map(enumerated, fn(pair) {
        build_field(ty, pair.1.index, pair.1.name, pair.1.ty)
    });
    let declared_keys = array::filter(fields, fn(f) { f.is_key });
    if array::length(declared_keys) > 1 {
        fail!("entity declares multiple key fields; use dataset grain for composite identity",
            ty, array::map(declared_keys, fn(f) { f.name }))
    } else { () };
    if let Some(field) = array::find(fields, fn(f) { f.is_key && nullable_identity_type(f.ty) }) {
        fail!("key identity cannot be nullable", ty, field.name)
    } else { () };
    let entity_scopes: Array(ScopePredicate) = match property::get_type_prop(ty, EntityScopeDef.type) {
        Some(declared) => array::map(declared.predicates, fn(p) {
            let field = match array::find(fields, fn(f) { f.name == p.field }) {
                Some(f) => f,
                None => fail!("entity scope references an unknown field", ty, p.field),
            };
            {field: field.index, op: p.op, input: p.input}
        }),
        None => [],
    };
    if let Some(field) = array::find(fields, fn(f) {
        f.column == "" && property::get_field_prop(ty, f.index, ColumnMap.type) == None && (f.is_key
            || property::get_field_prop(ty, f.index, TimeField.type) != None
            || match dataset_spec {
                Some(spec) => array::any(spec.grain, fn(name) { name == f.name })
                    || spec.utc_time == Some(f.name),
                None => False,
            })
    }) {
        fail!("identity or time field requires a physical column", ty, field.name)
    } else { () };
    let key_field = match array::find(fields, fn(f) { f.is_key }) {
        Some(f) => f.index,
        None => -1,
    };
    let validated_dataset = match dataset_spec {
        None => None,
        Some(spec) => do {
            if array::length(spec.grain) == 0 {
                fail!("dataset grain must name at least one field", ty)
            } else {
                array::fold(spec.grain, [], fn(seen, name) {
                    if array::any(seen, fn(existing) { existing == name }) {
                        fail!("duplicate dataset grain field", name)
                    } else if !array::any(fields, fn(field) { field.name == name }) {
                        fail!("unknown dataset grain field", name)
                    } else if array::any(fields, fn(field) { field.name == name && nullable_identity_type(field.ty) }) {
                        fail!("dataset grain identity cannot be nullable", ty, name)
                    } else {
                        array::push(seen, name)
                    }
                });
                match spec.utc_time {
                    None => match spec.kind {
                        DatasetKind::Entity => (),
                        _ => fail!("event and metric datasets require an authoritative UTC field", ty),
                    },
                    Some(time_name) => if array::any(fields, fn(field) {
                        field.name == time_name
                            && match property::get_field_prop(ty, field.index, TimeField.type) {
                                Some(role) => role.semantics == TimeSemantics::Utc
                                    && ((role.encoding == TimeEncoding::CanonicalUtcSecondText && field.ty == String.type)
                                        || (role.encoding == TimeEncoding::UtcEpochMillis && field.ty == Int.type)),
                                None => False,
                            }
                    }) {
                        ()
                    } else {
                        fail!("dataset UTC field must have the UTC time role", time_name)
                    },
                };
                Some(spec)
            }
        },
    };
    let metrics: Array(MetricValueEntry) = array::flat_map(fields, fn(field) {
        let declared = property::get_field_prop(ty, field.index, MetricValueSpec.type);
        let primary: Array(MetricValueEntry) = match declared {
            None => [],
            Some(metric) => do {
                let is_metric = match validated_dataset {
                    Some(spec) => spec.kind == DatasetKind::Metric,
                    None => False,
                };
                if !is_metric {
                    fail!("metric value requires a metric dataset", field.name)
                } else if metric.id == "" || (field.ty != Int.type && field.ty != Float.type) {
                    fail!("metric value requires an id and numeric field", field.name)
                } else {
                    let measure = property::get_field_prop(ty, field.index, MeasureDef.type);
                    match measure {
                        Some(declared) => if declared.id == metric.id && declared.aggregate == metric.aggregate
                            && declared.input == MeasureInput::All {
                            ()
                        } else {
                            fail!("metric metadata disagrees with its lowerable measure", metric.id)
                        },
                        None => fail!("metric value requires a lowerable measure", metric.id),
                    };
                    let result: MetricValueEntry = { id: metric.id, field: field.name, aggregate: metric.aggregate, unit: metric.unit, role: MetricValueRole::DeclaredMetric };
                    [result]
                }
            },
        };
        let summaries: Array(MetricValueEntry) = match property::get_field_prop(ty, field.index, SampleAggregateDef.type) {
            None => [],
            Some(extra) => do {
                let base = match declared {
                    Some(metric) => metric,
                    None => fail!("sample aggregate requires a declared metric on the same field", field.name),
                };
                array::map(extra.summaries, fn(spec) {
                    if spec.id == "" || spec.unit != base.unit {
                        fail!("sample aggregate requires an id and the original metric unit", field.name, spec.id)
                    } else {
                        let result: MetricValueEntry = { id: spec.id, field: field.name, aggregate: spec.aggregate, unit: spec.unit, role: MetricValueRole::SampleSummary };
                        result
                    }
                })
            },
        };
        array::concat([primary, summaries])
    });
    if let Some(duplicate) = array::find(metrics, fn(metric) {
        array::length(array::filter(metrics, fn(other) { other.id == metric.id })) > 1
    }) {
        fail!("duplicate metric value id", duplicate.id)
    } else { () };
    match (src, union_prop) {
        (Some(source), None) => do {
            if !qb::is_sql_identifier(source.table) {
                fail!("entity source table is not a legal identifier", ty, source.table)
            } else if let Some(field) = array::find(fields, fn(field) {
                match property::get_field_prop(ty, field.index, ColumnMap.type) {
                    Some(mapping) => !qb::is_sql_identifier(mapping.column),
                    None => False,
                }
            }) {
                fail!("entity physical column is not a legal identifier", ty, field.name, field.column)
            } else { () };
            let id = match declared_id {
                Some(e) => e.id,
                None => source.alias,
            };
            let handle = qb::source_with_hint(qb::build_context(), source.table, source.alias).1;
            let result: EntityEntry = { index, id, entity_type: ty, table: source.table, alias: source.alias, source: handle, key_field, fields, union: None, dataset: validated_dataset, metrics, description, scope: entity_scopes };
            result
        },
        (None, Some(union_def)) => do {
            if array::length(entity_scopes) > 0 { fail!("entity scope requires a physical source", ty) } else { () };
            let union = build_union_entry(ty, fields, union_def);
            let id = match declared_id {
                Some(e) => e.id,
                None => union.alias,
            };
            let handle = qb::source_with_hint(qb::build_context(), union.alias, union.alias).1;
            let result: EntityEntry = { index, id, entity_type: ty, table: "", alias: union.alias, source: handle, key_field, fields, union: Some(union), dataset: validated_dataset, metrics, description, scope: entity_scopes };
            result
        },
        _ => fail!("entity must declare exactly one of entity_source or union_source", ty),
    }
};

def check_entity_ids: Fn(Array(EntityEntry)) -> Array(EntityEntry) = fn(entities) {
    if let Some(entry) = array::find(entities, fn(e) { e.id == "" }) {
        fail!("dataset id must be nonempty", entry.index)
    } else if let Some(entry) = array::find(entities, fn(e) {
        array::length(array::filter(entities, fn(other) { other.id == e.id })) > 1
    }) {
        fail!("duplicate dataset id", entry.id)
    } else { entities }
};

def check_entity_aliases: Fn(Array(EntityEntry)) -> Array(EntityEntry) = fn(entities) {
    if let Some(entry) = array::find(entities, fn(e) { e.alias == "" }) {
        fail!("entity source alias must be nonempty", entry.id)
    } else if let Some(entry) = array::find(entities, fn(e) { !qb::is_sql_identifier(e.alias) }) {
        fail!("entity source alias is not a legal identifier", entry.id, entry.alias)
    } else if let Some(entry) = array::find(entities, fn(e) {
        array::length(array::filter(entities, fn(other) { other.alias == e.alias })) > 1
    }) {
        fail!("duplicate entity source alias", entry.alias)
    } else { entities }
};

def resolve_required: Fn(Array(EntityEntry), Array(Type)) -> Array(Int) = fn(entities, types) {
    array::map(types, fn(ty) {
        match array::find(entities, fn(e) { e.entity_type == ty }) {
            Some(e) => e.index,
            None => fail!("measure requires an entity that is not part of this knowledge", ty),
        }
    })
};

def collect_entity_measures: Fn(Array(EntityEntry), EntityEntry) -> Array(MeasureEntry) = fn(entities, entity) {
    let fields = entity.fields;
    array::flat_map(fields, fn(f) {
        let plain = match property::get_field_prop(entity.entity_type, f.index, MeasureDef.type) {
            Some(d) => do {
                let result: MeasureEntry = {
                    id: d.id,
                    entity: entity.index,
                    field: f.index,
                    aggregate: d.aggregate,
                    input: d.input,
                    alias: d.id,
                    requires: resolve_required(entities, d.requires),
                    predicate: None,
                    computed: None,
                };
                [result]
            },
            None => [],
        };
        let filtered = match property::get_field_prop(entity.entity_type, f.index, FilteredMeasureDef.type) {
            Some(d) => array::map(d.measures, fn(spec) {
                let result: MeasureEntry = {
                    id: spec.id,
                    entity: entity.index,
                    field: f.index,
                    aggregate: spec.aggregate,
                    input: MeasureInput::All,
                    alias: spec.id,
                    requires: resolve_required(entities, spec.requires),
                    predicate: Some(spec.predicate),
                    computed: None,
                };
                result
            }),
            None => [],
        };
        let sample_summaries = match property::get_field_prop(entity.entity_type, f.index, SampleAggregateDef.type) {
            Some(d) => array::map(d.summaries, fn(spec) {
                let result: MeasureEntry = {
                    id: spec.id,
                    entity: entity.index,
                    field: f.index,
                    aggregate: spec.aggregate,
                    input: MeasureInput::All,
                    alias: spec.id,
                    requires: [],
                    predicate: None,
                    computed: None,
                };
                result
            }),
            None => [],
        };
        let computed = match property::get_field_prop(entity.entity_type, f.index, ComputedMeasureDef.type) {
            Some(d) => array::map(d.measures, fn(spec) {
                let result: MeasureEntry = {
                    id: spec.id,
                    entity: entity.index,
                    field: f.index,
                    aggregate: qb::AggregateFunction::Count,
                    input: MeasureInput::All,
                    alias: spec.id,
                    requires: [],
                    predicate: None,
                    computed: Some({ op: spec.op, left: spec.left, right: spec.right }),
                };
                result
            }),
            None => [],
        };
        array::concat([plain, filtered, sample_summaries, computed])
    })
};

def measure_by_id: Fn(Array(MeasureEntry), String) -> MeasureEntry = fn(measures, id) {
    match array::find(measures, fn(m) { m.id == id }) {
        Some(m) => m,
        None => fail!("computed measure depends on an unknown measure", id),
    }
};

def field_output_type: Fn(Type) -> OutputType = fn(ty) {
    if ty == Int.type { OutputType::Integer }
    else if ty == Float.type { OutputType::Number }
    else if ty == Bool.type { OutputType::Boolean }
    else { OutputType::Text }
};

def measure_value_type: Fn(Array(EntityEntry), Array(MeasureEntry), String) -> OutputType =
    fn(entities, measures, id) {
        let entry = measure_by_id(measures, id);
        match entry.computed {
            Some(spec) => {
                let left = measure_value_type(entities, measures, spec.left);
                let right = measure_value_type(entities, measures, spec.right);
                if left == OutputType::Number || right == OutputType::Number {
                    OutputType::Number
                } else if left == OutputType::Integer && right == OutputType::Integer {
                    OutputType::Integer
                } else { fail!("computed measure requires numeric output operands", id, left, right) }
            },
            None => match entry.aggregate {
                qb::AggregateFunction::Count => OutputType::Integer,
                qb::AggregateFunction::Avg => OutputType::Number,
                qb::AggregateFunction::Sum => {
                    let entity = get_index(entities, entry.entity);
                    field_output_type(get_index(entity.fields, entry.field).ty)
                },
                qb::AggregateFunction::Min => {
                    let entity = get_index(entities, entry.entity);
                    field_output_type(get_index(entity.fields, entry.field).ty)
                },
                qb::AggregateFunction::Max => {
                    let entity = get_index(entities, entry.entity);
                    field_output_type(get_index(entity.fields, entry.field).ty)
                },
            },
        }
    };

def measure_output_type: Fn(PreparedPayload, String) -> OutputType = fn(payload, id) {
    measure_value_type(payload.entities, payload.measures, id)
};

def dimension_output_type: Fn(PreparedPayload, String) -> OutputType = fn(payload, id) {
    match array::find(payload.dimensions, fn(entry) { entry.id == id }) {
        Some(entry) => entry.output_type,
        None => fail!("unknown dimension output type", id),
    }
};

# Follow the computed-measure dependency graph; a revisit means a cycle.
def has_dep_cycle: Fn(Array(MeasureEntry), String, Array(String)) -> Bool = fn(measures, id, visited) {
    if array::any(visited, fn(v) { v == id }) {
        True
    } else {
        let direct = match array::find(measures, fn(m) { m.id == id }) {
            Some(m) => match m.computed {
                Some(spec) => [spec.left, spec.right],
                None => [],
            },
            None => [],
        };
        let new_visited = array::push(visited, id);
        array::any(direct, fn(dep) { has_dep_cycle(measures, dep, new_visited) })
    }
};

# Prepare-time measure contract: unique measure ids; computed measure operands
# must exist and share the declaring entity's grain; the dependency graph must be
# acyclic. Failures surface as prepare-time diagnostics.
def check_measure_contract: Fn(Array(EntityEntry), Array(MeasureEntry)) -> Array(MeasureEntry) = fn(entities, measures) {
    let dup = array::find(measures, fn(m) {
        array::length(array::filter(measures, fn(o) { o.id == m.id })) > 1
    });
    let ids_ok = match dup {
        Some(m) => fail!("duplicate measure id", m.id),
        None => True,
    };
    let validated = array::map(measures, fn(entry) {
        let entity = get_index(entities, entry.entity);
        let field = get_index(entity.fields, entry.field);
        if entry.computed == None && (entry.aggregate == qb::AggregateFunction::Sum
            || entry.aggregate == qb::AggregateFunction::Avg)
            && field.ty != Int.type && field.ty != Float.type {
            fail!("Sum and Avg measures require a numeric field", entity.id, entry.id, field.name)
        } else { () };
        match entry.computed {
            None => entry,
            Some(spec) => do {
                let left = measure_by_id(measures, spec.left);
                let right = measure_by_id(measures, spec.right);
                let entity_ok: Bool = if left.entity == entry.entity && right.entity == entry.entity {
                    True
                } else {
                    fail!("computed measure dependencies must share the declaring entity's grain", entry.id)
                };
                let cycle_ok: Bool = if has_dep_cycle(measures, entry.id, []) {
                    fail!("computed measure dependency cycle", entry.id)
                } else {
                    True
                };
                let result: MeasureEntry = if entity_ok && cycle_ok { entry } else { entry };
                result
            },
        }
    });
    let result: Array(MeasureEntry) = if ids_ok { validated } else { validated };
    result
};

def check_measure_descriptions: Fn(Array(EntityEntry), Array(MeasureEntry)) -> Bool = fn(entities, measures) {
    array::all(entities, fn(entity) {
        array::all(entity.fields, fn(field) {
            let notes = match property::get_field_prop(entity.entity_type, field.index, MeasureDescriptions.type) {
                Some(declared) => declared.notes,
                None => [],
            };
            if let Some(bad) = array::find(notes, fn(note) {
                note.id == "" || note.label == ""
                    || array::length(array::filter(notes, fn(other) { other.id == note.id })) != 1
                    || !array::any(measures, fn(measure) {
                        measure.id == note.id && measure.entity == entity.index && measure.field == field.index
                    })
            }) {
                fail!("measure description must name one measure on its field", entity.id, field.name, bad.id)
            } else { True }
        })
    })
};

def check_dimension_descriptions: Fn(Array(EntityEntry), Array(DimensionEntry)) -> Bool = fn(entities, dimensions) {
    array::all(entities, fn(entity) {
        array::all(entity.fields, fn(field) {
            let notes = match property::get_field_prop(entity.entity_type, field.index, DimensionDescriptions.type) {
                Some(declared) => declared.notes,
                None => [],
            };
            if let Some(bad) = array::find(notes, fn(note) {
                note.id == "" || note.label == ""
                    || array::length(array::filter(notes, fn(other) { other.id == note.id })) != 1
                    || !array::any(dimensions, fn(d) {
                        d.id == note.id && d.entity == entity.index && d.field == field.index
                    })
            }) {
                fail!("dimension description must name one dimension on its field", entity.id, field.name, bad.id)
            } else { True }
        })
    })
};

def member_aliases: Fn(Type, Int, MemberAliasKind, String) -> Array(String) = fn(owner, field, kind, id) {
    match property::get_field_prop(owner, field, MemberAliasesDef.type) {
        Some(declared) => array::map(array::filter(declared.aliases, fn(alias) { alias.kind == kind && alias.id == id }), fn(alias) { alias.label }),
        None => [],
    }
};

def relation_aliases: Fn(Type, String) -> Array(String) = fn(owner, id) {
    match property::get_type_prop(owner, RelationAliasesDef.type) {
        Some(declared) => array::map(array::filter(declared.aliases, fn(alias) { alias.id == id }), fn(alias) { alias.label }),
        None => [],
    }
};

def localized_member_texts: Fn(Type, Int, MemberAliasKind, String) -> Array(LocalizedKnowledgeText) = fn(owner, field, kind, id) {
    match property::get_field_prop(owner, field, LocalizedMemberTexts.type) {
        Some(declared) => array::map(array::filter(declared.notes, fn(note) { note.kind == kind && note.id == id }), fn(note) { note.text }),
        None => [],
    }
};

def localized_relation_texts: Fn(Type, String) -> Array(LocalizedKnowledgeText) = fn(owner, id) {
    match property::get_type_prop(owner, LocalizedRelationTexts.type) {
        Some(declared) => array::map(array::filter(declared.notes, fn(note) { note.id == id }), fn(note) { note.text }),
        None => [],
    }
};

def localized_value_labels: Fn(Type, Int) -> Array(LocalizedCanonicalValue) = fn(owner, field) {
    match property::get_field_prop(owner, field, LocalizedCanonicalValuesDef.type) {
        Some(declared) => declared.labels, None => [],
    }
};

def localized_text_valid: Fn(LocalizedKnowledgeText) -> Bool = fn(text) {
    text.locale != "" && text.label != "" && text.summary != ""
};

def check_localized_knowledge: Fn(PreparedPayload) -> Bool = fn(payload) {
    array::all(payload.entities, fn(entity) {
        let dataset_texts = match property::get_type_prop(entity.entity_type, LocalizedDatasetTexts.type) {
            Some(declared) => declared.texts, None => [],
        };
        if let Some(bad) = array::find(dataset_texts, fn(text) {
            !localized_text_valid(text)
                || array::length(array::filter(dataset_texts, fn(other) { other.locale == text.locale })) != 1
        }) { fail!("invalid localized dataset text: requires one nonempty label and summary per locale", entity.id, bad) }
        else { () };
        let relation_notes = match property::get_type_prop(entity.entity_type, LocalizedRelationTexts.type) {
            Some(declared) => declared.notes, None => [],
        };
        if let Some(bad) = array::find(relation_notes, fn(note) {
            !localized_text_valid(note.text)
                || !array::any(payload.relations, fn(rel) { rel.id == note.id && rel.id != "" && rel.from == entity.index })
                || array::length(array::filter(relation_notes, fn(other) { other.id == note.id && other.text.locale == note.text.locale })) != 1
        }) { fail!("invalid localized relation text: requires a declared relation and unique locale", entity.id, bad) }
        else { () };
        array::all(entity.fields, fn(field) {
            let value_labels = localized_value_labels(entity.entity_type, field.index);
            if let Some(bad) = array::find(value_labels, fn(label) {
                label.id == "" || label.locale == "" || label.label == ""
                    || !array::any(payload.dimensions, fn(d) {
                        d.entity == entity.index && d.field == field.index
                            && array::any(d.canonical_values, fn(value) { value.id == label.id })
                    })
                    || array::length(array::filter(value_labels, fn(other) {
                        other.id == label.id && other.locale == label.locale
                    })) != 1
            }) { fail!("invalid localized canonical value: requires a value on its field and unique nonempty locale and label", entity.id, field.name, bad) }
            else { () };
            let notes = match property::get_field_prop(entity.entity_type, field.index, LocalizedMemberTexts.type) {
                Some(declared) => declared.notes, None => [],
            };
            if let Some(bad) = array::find(notes, fn(note) {
                let target = match note.kind {
                    MemberAliasKind::Dimension => array::any(payload.dimensions, fn(d) { d.id == note.id && d.entity == entity.index && d.field == field.index }),
                    MemberAliasKind::Measure => array::any(payload.measures, fn(m) { m.id == note.id && m.entity == entity.index && m.field == field.index }),
                };
                !target || !localized_text_valid(note.text)
                    || array::length(array::filter(notes, fn(other) {
                        other.kind == note.kind && other.id == note.id && other.text.locale == note.text.locale
                    })) != 1
            }) { fail!("invalid localized member text: requires a member on its field and unique locale", entity.id, field.name, bad) }
            else { True }
        })
    })
};

def check_knowledge_aliases: Fn(PreparedPayload) -> Bool = fn(payload) {
    array::all(payload.entities, fn(entity) {
        let dataset_labels = match property::get_type_prop(entity.entity_type, DatasetAliasesDef.type) {
            Some(declared) => declared.labels,
            None => [],
        };
        let primary = match entity.description { Some(note) => note.label, None => entity.id };
        if let Some(label) = array::find(dataset_labels, fn(label) {
            label == "" || label == entity.id || label == primary
                || array::length(array::filter(dataset_labels, fn(other) { other == label })) != 1
        }) {
            fail!("invalid dataset alias: requires a distinct nonempty name", entity.id, label)
        } else { () };
        let relations = array::filter(payload.relations, fn(rel) { rel.from == entity.index && rel.id != "" });
        let relation_notes = match property::get_type_prop(entity.entity_type, RelationAliasesDef.type) {
            Some(declared) => declared.aliases,
            None => [],
        };
        if let Some(alias) = array::find(relation_notes, fn(alias) {
            let target = array::find(relations, fn(rel) { rel.id == alias.id });
            alias.label == "" || target == None
                || array::any(relations, fn(rel) { rel.id == alias.label })
                || array::length(array::filter(relation_notes, fn(other) { other.label == alias.label })) != 1
                || match target { Some(rel) => alias.label == rel.label, None => False }
        }) {
            fail!("invalid relation alias: requires a declared relation and a distinct nonempty name", entity.id, alias)
        } else { () };
        let all_member_aliases = array::flat_map(entity.fields, fn(field) {
            match property::get_field_prop(entity.entity_type, field.index, MemberAliasesDef.type) {
                Some(definition) => definition.aliases, None => [],
            }
        });
        array::all(entity.fields, fn(field) {
            let declared = match property::get_field_prop(entity.entity_type, field.index, MemberAliasesDef.type) {
                Some(definition) => definition.aliases,
                None => [],
            };
            if array::length(declared) == 0 { True } else {
                let dimensions = array::filter(payload.dimensions, fn(d) { d.entity == entity.index && d.field == field.index });
                let measures = array::filter(payload.measures, fn(m) { m.entity == entity.index && m.field == field.index });
                if let Some(alias) = array::find(declared, fn(alias) {
                    let dimension = array::find(dimensions, fn(d) { d.id == alias.id });
                    let measure = array::find(measures, fn(m) { m.id == alias.id });
                    let target_exists = match alias.kind {
                        MemberAliasKind::Dimension => dimension != None,
                        MemberAliasKind::Measure => measure != None,
                    };
                    let primary_label = match alias.kind {
                        MemberAliasKind::Dimension => if dimension == None { "" } else { dimension_detail(payload, alias.id).label },
                        MemberAliasKind::Measure => if measure == None { "" } else { measure_domain(payload, alias.id).label },
                    };
                    alias.label == "" || !target_exists || alias.label == primary_label
                        || array::any(dimensions, fn(d) { d.id == alias.label })
                        || array::any(measures, fn(m) { m.id == alias.label })
                        || array::length(array::filter(all_member_aliases, fn(other) { other.label == alias.label })) != 1
                }) {
                    fail!("invalid knowledge alias: requires one declared dimension or measure on its field and a distinct nonempty name", entity.id, field.name, alias)
                } else { True }
            }
        })
    })
};

def identity_expr: Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr) = fn(ctx, e) { (ctx, e) };

def enum_value_entry: Fn(String, String, String) -> EnumValueEntry = fn(variant, value, label) {
    let result: EnumValueEntry = { variant, value, label };
    result
};

def has_payload: Fn(Option(Type)) -> Bool = fn(payload) {
    match payload { Some(_) => True, None => False }
};

def duplicate_value: Fn(Array(EnumValueEntry)) -> Option(String) = fn(entries) {
    let values = array::map(entries, fn(e) { e.value });
    array::find(values, fn(v) {
        array::length(array::filter(values, fn(w) { w == v })) > 1
    })
};

# Build the closed value domain for a plain dimension field whose type is a
# payload-free named enum. Non-enum field types yield the empty (open) domain;
# payload-bearing enum shapes produce an explicit prepare-time diagnostic.
def value_domain: Fn(Type) -> Array(EnumValueEntry) = fn(field_ty) {
    if field_ty == Bool.type { [] } else {
        let ref_ty = field_ty;
        let resolved = match td::resolve(ref_ty) {
            Ok(t) => t,
            Err(_) => ref_ty,
        };
        match td::kind(resolved) {
            td::TypeDescKind::Enum => do {
                let vs = td::variants(ref_ty);
                if array::any(vs, fn(v) { has_payload(v.payload) }) {
                    fail!("dimension field uses an enum with payload variants; only payload-free variants are supported", field_ty)
                } else {
                    let entries = array::map(vs, fn(v) {
                        let prop = property::get_variant_prop(ref_ty, v.index, EnumValueDef.type);
                        match prop {
                            Some(spec) => enum_value_entry(v.name, spec.value, spec.label),
                            None => enum_value_entry(v.name, v.name, v.name),
                        }
                    });
                    match duplicate_value(entries) {
                        Some(value) => fail!("enum value domain contains duplicate stable values", field_ty, value),
                        None => entries,
                    }
                }
            },
            _ => [],
        }
    }
};

def canonical_domain: Fn(Type, FieldEntry) -> Array(CanonicalValueSpec) = fn(owner, field) {
    match property::get_field_prop(owner, field.index, CanonicalValuesDef.type) {
        None => [],
        Some(mapping) => do {
            let valid_field = field.ty == String.type || field.ty == Int.type;
            let nonempty = array::length(mapping.values) > 0;
            let valid_entries = array::all(mapping.values, fn(v) {
                v.id != "" && array::length(v.wires) > 0
                    && array::all(v.wires, fn(w) {
                        match w {
                            FilterInput::Text(s) => field.ty == String.type && s != "",
                            FilterInput::Int(_) => field.ty == Int.type,
                            FilterInput::Number(_) => False,
                            FilterInput::Bool(_) => False,
                        }
                    })
                    && array::length(array::filter(mapping.values, fn(other) { other.id == v.id })) == 1
                    && array::all(v.wires, fn(w) {
                        array::length(array::flat_map(mapping.values, fn(other) {
                            array::filter(other.wires, fn(candidate) { candidate == w })
                        })) == 1
                    })
            });
            if !valid_field || !nonempty || !valid_entries {
                fail!("invalid canonical value mapping: requires a String or Int field, distinct nonempty ids and disjoint typed wire sets", owner, field, mapping)
            } else {
                mapping.values
            }
        },
    }
};

def canonical_alias_domain: Fn(Type, FieldEntry, Array(CanonicalValueSpec)) -> Array(CanonicalAlias) = fn(owner, field, values) {
    match property::get_field_prop(owner, field.index, CanonicalAliasesDef.type) {
        None => [],
        Some(declared) => do {
            let valid = array::all(declared.aliases, fn(alias) {
                alias.label != "" && array::any(values, fn(value) { value.id == alias.id })
                    && array::length(array::filter(declared.aliases, fn(other) { other.label == alias.label })) == 1
                    && !array::any(values, fn(value) { value.label == alias.label || value.id == alias.label })
            });
            if !valid { fail!("invalid canonical value alias: requires an existing id and a distinct nonempty label", owner, field, declared) }
            else { declared.aliases }
        },
    }
};

def field_scope: Fn(Type, Int) -> Array(ScopePredicate) = fn(owner, index) {
    match property::get_field_prop(owner, index, ScopeDef.type) {
        Some(s) => s.predicates,
        None => [],
    }
};

def collect_entity_dimensions: Fn(EntityEntry) -> Array(DimensionEntry) = fn(entity) {
    let fields = entity.fields;
    let orphan = array::find(fields, fn(f) {
        (property::get_field_prop(entity.entity_type, f.index, CanonicalValuesDef.type) != None
            || property::get_field_prop(entity.entity_type, f.index, CanonicalAliasesDef.type) != None)
            && property::get_field_prop(entity.entity_type, f.index, DimensionDef.type) == None
    });
    let declared: Bool = match orphan {
        Some(f) => fail!("canonical value mapping requires a plain dimension on its field", entity.id, f.name),
        None => True,
    };
    let plain = array::flat_map(fields, fn(f) {
        let d = property::get_field_prop(entity.entity_type, f.index, DimensionDef.type);
        match d {
            Some(dd) => do {
                let mapped = canonical_domain(entity.entity_type, f);
                let aliases = canonical_alias_domain(entity.entity_type, f, mapped);
                let enumerated = value_domain(f.ty);
                let epoch = match property::get_field_prop(entity.entity_type, f.index, TimeField.type) {
                    Some(role) => role.encoding == TimeEncoding::LocalEpochMillis || role.encoding == TimeEncoding::UtcEpochMillis,
                    None => False,
                };
                let valid_kind = if array::length(enumerated) > 0 { FilterInputKind::Text }
                    else if f.ty == String.type { FilterInputKind::Text }
                    else if f.ty == Int.type { FilterInputKind::Int }
                    else if f.ty == Float.type { FilterInputKind::Number }
                    else if f.ty == Bool.type { FilterInputKind::Bool }
                    else { fail!("plain dimension requires a String, Int, Float, Bool or closed enum field", entity.id, f.name) };
                if epoch && (dd.input_kinds != [FilterInputKind::Int]
                    || array::any(dd.ops, fn(op) { is_text_op(op) })
                    || array::length(mapped) > 0) {
                    fail!("epoch-millisecond time dimension requires numeric filters", entity.id, f.name)
                } else if array::length(mapped) > 0 && array::length(enumerated) > 0 {
                    fail!("dimension cannot combine enum and canonical wire domains", entity.id, f.name)
                } else if array::length(mapped) > 0 && (!dd.filterable
                    || dd.input_kinds != [FilterInputKind::Text]
                    || !array::any(dd.ops, fn(op) { op == FilterOp::Eq })
                    || array::any(dd.ops, fn(op) { op != FilterOp::Eq && op != FilterOp::Ne })) {
                    fail!("canonical dimension must declare filterable Eq and optionally Ne with a text business input", entity.id, f.name)
                } else if array::length(enumerated) > 0
                    && (dd.input_kinds != [FilterInputKind::Text]
                        || array::any(dd.ops, fn(op) { op != FilterOp::Eq })) {
                    fail!("enum dimension supports only text business values and Eq filters", entity.id, f.name)
                } else if array::length(mapped) == 0 && (array::any(dd.input_kinds, fn(kind) {
                    if f.ty == Int.type || f.ty == Float.type {
                        kind != FilterInputKind::Int && kind != FilterInputKind::Number
                    } else { kind != valid_kind }
                })
                    || (valid_kind == FilterInputKind::Bool && array::any(dd.ops, fn(op) { op != FilterOp::Eq && op != FilterOp::Ne }))
                    || (valid_kind != FilterInputKind::Text && array::any(dd.ops, fn(op) { is_text_op(op) }))) {
                    fail!("plain dimension filter input or operation disagrees with field type", entity.id, f.name)
                } else {
                    let output_type = match valid_kind {
                        FilterInputKind::Text => OutputType::Text,
                        FilterInputKind::Int => OutputType::Integer,
                        FilterInputKind::Number => OutputType::Number,
                        FilterInputKind::Bool => OutputType::Boolean,
                    };
                    [dimension_entry(entity.index, f.index, dd.id, output_type, False, identity_expr, dd.authorized, dd.filterable, dd.ops, dd.input_kinds, enumerated, mapped, aliases, field_scope(entity.entity_type, f.index))]
                }
            },
            None => [],
        }
    });
    let computed = array::flat_map(fields, fn(f) {
        let d = property::get_field_prop(entity.entity_type, f.index, ComputedDimensionDef.type);
        match d {
            Some(dd) => [dimension_entry(entity.index, f.index, dd.id, dd.output_type, True, dd.build, dd.authorized, dd.filterable, dd.ops, dd.input_kinds, [], [], [], field_scope(entity.entity_type, f.index))],
            None => [],
        }
    });
    if declared { array::concat([plain, computed]) } else { [] }
};

def dimension_entry: Fn(Int, Int, String, OutputType, Bool, Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr), Bool, Bool, Array(FilterOp), Array(FilterInputKind), Array(EnumValueEntry), Array(CanonicalValueSpec), Array(CanonicalAlias), Array(ScopePredicate)) -> DimensionEntry = fn(entity, field, id, output_type, computed, build, authorized, filterable, ops, input_kinds, values, canonical_values, canonical_aliases, scope) {
    let result: DimensionEntry = { id, entity, field, output_type, computed, build, authorized, filterable, ops, input_kinds, values, canonical_values, canonical_aliases, scope };
    result
};

def check_dimension_ids: Fn(Array(DimensionEntry)) -> Array(DimensionEntry) = fn(dimensions) {
    if let Some(entry) = array::find(dimensions, fn(d) { d.id == "" }) {
        fail!("dimension id must be nonempty", entry.entity, entry.field)
    } else if let Some(entry) = array::find(dimensions, fn(d) {
        array::length(array::filter(dimensions, fn(other) { other.id == d.id })) > 1
    }) {
        fail!("duplicate dimension id", entry.id)
    } else { dimensions }
};

def resolve_relation_key: Fn(EntityEntry, EntityEntry, RelationKey) -> RelationKey = fn(from_entity, to_entity, key) {
    match key {
        RelationKey::Eq(pair) => do {
            let from_field = match array::get(from_entity.fields, pair.from) {
                Some(field) => field,
                None => fail!("unknown relation source field index", from_entity.id, pair.from),
            };
            let to_field = match array::get(to_entity.fields, pair.to) {
                Some(field) => field,
                None => fail!("unknown relation target field index", to_entity.id, pair.to),
            };
            if from_field.column == "" || to_field.column == "" {
                fail!("relation key fields require physical columns", from_entity.id, from_field.name, to_entity.id, to_field.name)
            } else if from_field.ty != to_field.ty {
                fail!("relation fields have different types", from_entity.id, from_field.name, to_entity.id, to_field.name)
            } else { RelationKey::Eq(pair) }
        },
        RelationKey::FieldEq(pair) => do {
            let from_field = match array::find(from_entity.fields, fn(field) { field.name == pair.from }) {
                Some(field) => field.index,
                None => fail!("unknown relation source field", from_entity.id, pair.from),
            };
            let to_field = match array::find(to_entity.fields, fn(field) { field.name == pair.to }) {
                Some(field) => field.index,
                None => fail!("unknown relation target field", to_entity.id, pair.to),
            };
            if get_index(from_entity.fields, from_field).column == "" || get_index(to_entity.fields, to_field).column == "" {
                fail!("relation key fields require physical columns", from_entity.id, pair.from, to_entity.id, pair.to)
            } else if get_index(from_entity.fields, from_field).ty != get_index(to_entity.fields, to_field).ty {
                fail!("relation fields have different types", pair.from, pair.to)
            } else {
            RelationKey::Eq({ from: from_field, to: to_field })
            }
        },
        RelationKey::And(keys) => if array::length(keys) == 0 {
            fail!("relation conjunction requires at least one key", from_entity.id, to_entity.id)
        } else { RelationKey::And(array::map(keys, fn(k) { resolve_relation_key(from_entity, to_entity, k) })) },
        RelationKey::Or(keys) => if array::length(keys) == 0 {
            fail!("relation disjunction requires at least one key", from_entity.id, to_entity.id)
        } else { RelationKey::Or(array::map(keys, fn(k) { resolve_relation_key(from_entity, to_entity, k) })) },
    }
};

def relation_covers_target_grain: Fn(EntityEntry, Array(RelationPair)) -> Bool = fn(target, pairs) {
    match target.dataset {
        None => False,
        Some(dataset) => array::length(dataset.grain) > 0
            && array::all(dataset.grain, fn(name) {
                match array::find(target.fields, fn(field) { field.name == name }) {
                    Some(field) => array::any(pairs, fn(pair) { pair.to == field.index }),
                    None => False,
                }
            }),
    }
};

def safe_relation_covers_target_identity: Fn(EntityEntry, Array(RelationPair)) -> Bool = fn(target, pairs) {
    match target.dataset {
        Some(_) => relation_covers_target_grain(target, pairs),
        None => target.key_field >= 0
            && array::any(pairs, fn(pair) { pair.to == target.key_field }),
    }
};

def collect_relations: Fn(Array(EntityEntry)) -> Array(RelationEntry) = fn(entities) {
    array::flat_map(entities, fn(entity) {
        let rd = property::get_type_prop(entity.entity_type, RelationDef.type);
        let decls = match rd {
            Some(d) => d.relations,
            None => [],
        };
        let descriptions = match property::get_type_prop(entity.entity_type, RelationDescriptions.type) {
            Some(d) => d.notes,
            None => [],
        };
        if let Some(bad) = array::find(descriptions, fn(note) {
            array::length(array::filter(descriptions, fn(other) { other.id == note.id })) > 1
                || !array::any(decls, fn(rel) { rel.id == note.id && rel.id != "" })
        }) {
            fail!("relation description must name one declared relation", entity.id, bad.id)
        } else { () };
        array::map(decls, fn(rel) {
            let to_index = match array::find(entities, fn(e) { e.entity_type == rel.target }) {
                Some(e) => e.index,
                None => fail!("relation target is not part of this knowledge", rel.target),
            };
            let target = get_index(entities, to_index);
            let key = resolve_relation_key(entity, target, rel.key);
            if rel.kind == RelationKind::Safe && !conjunctive_identity_key(key) {
                fail!("safe relation cannot prove a unique target across alternative keys", rel.id, entity.id, target.id)
            } else if rel.kind == RelationKind::Safe && !safe_relation_covers_target_identity(target, exists_pairs(key)) {
                let identity_fields = match target.dataset {
                    Some(dataset) => array::map(dataset.grain, fn(name) {
                        match array::find(target.fields, fn(field) { field.name == name }) {
                            Some(field) => field,
                            None => fail!("prepared dataset grain references an unknown field", target.id, name),
                        }
                    }),
                    None => if target.key_field >= 0 { [get_index(target.fields, target.key_field)] } else { [] },
                };
                let pairs = exists_pairs(key);
                match array::find(identity_fields, fn(field) {
                    !array::any(pairs, fn(pair) { pair.to == field.index })
                }) {
                    Some(field) => fail!(`safe relation must cover the target's declared identity: \{rel.id} from \{entity.id} to \{target.id} lacks target identity field \{field.name}; add its declared equality to the relation key`, rel, field),
                    None => fail!(`safe relation must cover the target's declared identity: \{target.id} has no declared key or dataset grain; declare its identity before marking \{rel.id} Safe`, rel, target.id),
                }
            } else { () };
            let result: RelationEntry = {
                id: rel.id,
                label: match array::find(descriptions, fn(note) { note.id == rel.id && rel.id != "" }) {
                    Some(note) => note.label,
                    None => "",
                },
                summary: match array::find(descriptions, fn(note) { note.id == rel.id && rel.id != "" }) {
                    Some(note) => note.summary,
                    None => "",
                },
                from: entity.index,
                to: to_index,
                kind: rel.kind,
                key,
            };
            result
        })
    })
};

def business_link_pairs: Fn(RelationKey, String) -> Array(RelationPair) = fn(key, id) {
    match key {
        RelationKey::Eq(pair) => [pair],
        RelationKey::And(parts) => array::concat(array::map(parts, fn(part) { business_link_pairs(part, id) })),
        _ => fail!("business link endpoints require conjunctions of identity equalities", id),
    }
};

def conjunctive_identity_key: Fn(RelationKey) -> Bool = fn(key) {
    match key {
        RelationKey::Eq(_) => True,
        RelationKey::And(parts) => array::length(parts) > 0
            && array::all(parts, conjunctive_identity_key),
        _ => False,
    }
};

def relation_covers_source_identity: Fn(EntityEntry, RelationKey) -> Bool = fn(source, key) {
    if !conjunctive_identity_key(key) { False }
    else {
        let pairs = exists_pairs(key);
        match source.dataset {
            Some(dataset) => array::length(dataset.grain) > 0
                && array::all(dataset.grain, fn(name) {
                    match array::find(source.fields, fn(field) { field.name == name }) {
                        Some(field) => array::any(pairs, fn(pair) { pair.from == field.index }),
                        None => False,
                    }
                }),
            None => source.key_field >= 0
                && array::any(pairs, fn(pair) { pair.from == source.key_field }),
        }
    }
};

def collect_business_links: Fn(Array(EntityEntry), Array(RelationEntry)) -> Array(BusinessLinkEntry) = fn(entities, relations) {
    let links = array::flat_map(entities, fn(hub) {
        let declarations = match property::get_type_prop(hub.entity_type, BusinessLinkDef.type) {
            Some(definition) => definition.links,
            None => [],
        };
        array::map(declarations, fn(declaration) {
            let a = match array::find(relations, fn(r) { r.id == declaration.a_relation && r.from == hub.index }) {
                Some(r) => r,
                None => fail!("business link A endpoint relation is not declared on its hub", declaration.id, declaration.a_relation),
            };
            let z = match array::find(relations, fn(r) { r.id == declaration.z_relation && r.from == hub.index }) {
                Some(r) => r,
                None => fail!("business link Z endpoint relation is not declared on its hub", declaration.id, declaration.z_relation),
            };
            if a.to != z.to || a.kind != RelationKind::Safe || z.kind != RelationKind::Safe {
                fail!("business link endpoints must identify the same unique participant entity", declaration.id)
            } else {
                let a_pairs = business_link_pairs(a.key, declaration.id);
                let z_pairs = business_link_pairs(z.key, declaration.id);
                let same_identity = array::length(a_pairs) == array::length(z_pairs)
                    && array::all(a_pairs, fn(pair) {
                        array::length(array::filter(z_pairs, fn(other) { other.to == pair.to })) == 1
                    });
                let distinct_endpoints = array::any(a_pairs, fn(pair) {
                    array::any(z_pairs, fn(other) { other.to == pair.to && other.from != pair.from })
                });
                if !same_identity || !distinct_endpoints {
                    fail!("business link endpoints must carry the same complete identity through distinct roles", declaration.id)
                } else {
                    let result: BusinessLinkEntry = {
                        id: declaration.id, hub: hub.index, participant: a.to,
                        a_relation: a.id, z_relation: z.id, direction: declaration.direction,
                    };
                    result
                }
            }
        })
    });
    if let Some(duplicate) = array::find(links, fn(entry) {
        array::length(array::filter(links, fn(other) { other.id == entry.id })) != 1
            || array::any(relations, fn(r) { r.id == entry.id })
    }) { fail!("duplicate or conflicting business link id", duplicate.id) }
    else { links }
};

# ---------------------------------------------------------------------------
# BFS path precomputation (prepare-time only).
#
# For each source entity one bounded breadth-first traversal (depth capped at
# `path_depth_cap`) records the first deterministic path (by relation
# enumeration order) to every reachable entity. A safe-only pass runs first;
# targets reached there keep a Safe path. Targets reached only when fan-out
# edges are allowed keep a FanOut path. Targets never reached are Missing.
# The work is bounded per source (not per ordered pair), so adding a few hub
# relations keeps preparation cheap and does not exhaust evaluation fuel.
# ---------------------------------------------------------------------------

def path_depth_cap: Int = 8;

type BfsState = struct { node: Int, path: Array(Int) };

def visited_at: Fn(Array(Bool), Int) -> Bool = fn(visited, i) {
    match array::get(visited, i) {
        Some(v) => v,
        None => False,
    }
};

def set_at: Fn(Array(Bool), Int, Bool) -> Array(Bool) = fn(values, index, value) {
    let enumerated = array::enumerate(values);
    array::map(enumerated, fn(pair) { if pair.0 == index { value } else { pair.1 } })
};

def empty_path_row: Fn(Int) -> Array(Option(Array(Int))) = fn(n) {
    let none: Option(Array(Int)) = None;
    array::map(int_range(n), fn(i) { none })
};

def row_set: Fn(Array(Option(Array(Int))), Int, Array(Int)) -> Array(Option(Array(Int))) = fn(row, index, path) {
    let enumerated = array::enumerate(row);
    array::map(enumerated, fn(pair) {
        if pair.0 == index { Some(path) } else { pair.1 }
    })
};

type BfsLevel = struct {
    visited: Array(Bool),
    paths: Array(Option(Array(Int))),
    next: Array(BfsState),
};

def expand_level_state: Fn(BfsLevel, BfsState, Array(RelationEntry), Bool) -> BfsLevel = fn(level, state, relations, safe_only) {
    let init: BfsLevel = { visited: level.visited, paths: level.paths, next: level.next };
    let enumerated = array::enumerate(relations);
    array::fold(enumerated, init, fn(acc, pair) {
        let rel = pair.1;
        if rel.from != state.node {
            acc
        } else if safe_only && rel.kind != RelationKind::Safe {
            acc
        } else if visited_at(acc.visited, rel.to) {
            acc
        } else {
            let new_path = array::push(state.path, pair.0);
            let new_visited = set_at(acc.visited, rel.to, True);
            let new_paths = row_set(acc.paths, rel.to, new_path);
            let next_state: BfsState = { node: rel.to, path: new_path };
            let result: BfsLevel = { visited: new_visited, paths: new_paths, next: array::push(acc.next, next_state) };
            result
        }
    })
};

def bfs_loop: Fn(Int, Array(Bool), Array(Option(Array(Int))), Array(BfsState), Array(RelationEntry), Bool, Int) -> Array(Option(Array(Int))) = fn(n, visited, paths, frontier, relations, safe_only, depth) {
    if depth >= path_depth_cap {
        paths
    } else if array::length(frontier) == 0 {
        paths
    } else {
        let empty_next: Array(BfsState) = [];
        let init_level: BfsLevel = { visited: visited, paths: paths, next: empty_next };
        let level = array::fold(frontier, init_level, fn(acc, state) {
            expand_level_state(acc, state, relations, safe_only)
        });
        bfs_loop(n, level.visited, level.paths, level.next, relations, safe_only, depth + 1)
    }
};

# Per-source bounded BFS: paths[to] is Some(seq) when `to` was reached within
# the depth cap; otherwise None. The source itself is never recorded (its own
# row cell is produced as PathResult.Safe([]) by `build_row`).
def source_paths: Fn(Int, Int, Array(RelationEntry), Bool) -> Array(Option(Array(Int))) = fn(from, n, relations, safe_only) {
    let visited: Array(Bool) = array::map(int_range(n), fn(i) { i == from });
    let init_paths = empty_path_row(n);
    let start: BfsState = { node: from, path: [] };
    bfs_loop(n, visited, init_paths, [start], relations, safe_only, 0)
};

def row_result: Fn(Array(Option(Array(Int))), Array(Option(Array(Int))), Int) -> PathResult = fn(safe_row, any_row, to) {
    match safe_row[to] {
        Some(path) => {
            let result: PathResult = PathResult::Safe(path);
            result
        },
        None => match any_row[to] {
            Some(path) => {
                let result: PathResult = PathResult::FanOut(path);
                result
            },
            None => PathResult::Missing,
        },
    }
};

def build_row: Fn(Int, Int, Array(RelationEntry)) -> Array(PathResult) = fn(from, n, relations) {
    let safe_row = source_paths(from, n, relations, True);
    let any_row = source_paths(from, n, relations, False);
    array::map(int_range(n), fn(to) {
        if to == from {
            let result: PathResult = PathResult::Safe([]);
            result
        } else {
            row_result(safe_row, any_row, to)
        }
    })
};

def build_paths: Fn(Int, Array(RelationEntry)) -> Array(Array(PathResult)) = fn(n, relations) {
    array::map(int_range(n), fn(from) { build_row(from, n, relations) })
};

# ---------------------------------------------------------------------------
# Safe-path ambiguity precomputation (prepare-time only).
#
# The path matrix records only the FIRST deterministic Safe path (by relation
# enumeration order).  Hidden join routes that must never be chosen by
# declaration order (the ranked grouped-key outer-attribute owner) additionally
# consult `ambiguous_paths`: a cell is True when the owning entity is reachable
# from the base through MORE THAN ONE distinct Safe path (parallel or otherwise
# ambiguous declared Safe routes).  Counting is bounded per source by the same
# depth cap as the path BFS and never runs on the hot path.
# ---------------------------------------------------------------------------

# Increment a path-count cell, capping at 2 (only "more than one" is needed).
def path_count_add: Fn(Array(Int), Int) -> Array(Int) = fn(counts, index) {
    let current = get_index(counts, index);
    if current >= 2 {
        counts
    } else {
        int_set_at(counts, index, current + 1)
    }
};

def int_set_at: Fn(Array(Int), Int, Int) -> Array(Int) = fn(values, index, value) {
    let enumerated = array::enumerate(values);
    array::map(enumerated, fn(pair) { if pair.0 == index { value } else { pair.1 } })
};

# Count distinct simple Safe paths from the source: `counts[to]` is the number
# of distinct Safe paths (length >= 1, <= path_depth_cap) from the source to
# entity `to`.  `path_visited` marks the nodes on the CURRENT path only, so
# parallel/diverging branches each keep their own ancestry (a diamond shape is
# counted twice).  Folded counts thread across branches.
def dfs_safe_path_counts: Fn(Array(Int), Array(Bool), Int, Array(RelationEntry), Int) -> Array(Int) = fn(counts, path_visited, node, relations, depth) {
    if depth >= path_depth_cap {
        counts
    } else {
        let enumerated = array::enumerate(relations);
        array::fold(enumerated, counts, fn(acc, pair) {
            let rel = pair.1;
            if rel.from != node || rel.kind != RelationKind::Safe || visited_at(path_visited, rel.to) {
                acc
            } else {
                let counts2 = path_count_add(acc, rel.to);
                let visited2 = set_at(path_visited, rel.to, True);
                dfs_safe_path_counts(counts2, visited2, rel.to, relations, depth + 1)
            }
        })
    }
};

# The ambiguity row of one source: cell `to` is True when entity `to` is reached
# from `from` through more than one distinct Safe path (self is never reached).
def ambiguous_source_row: Fn(Int, Int, Array(RelationEntry)) -> Array(Bool) = fn(from, n, relations) {
    let counts: Array(Int) = array::map(int_range(n), fn(i) { 0 });
    let visited: Array(Bool) = array::map(int_range(n), fn(i) { i == from });
    let counted = dfs_safe_path_counts(counts, visited, from, relations, 0);
    array::map(counted, fn(c) { c >= 2 })
};

def build_ambiguous_paths: Fn(Int, Array(RelationEntry)) -> Array(Array(Bool)) = fn(n, relations) {
    array::map(int_range(n), fn(from) { ambiguous_source_row(from, n, relations) })
};

# ---------------------------------------------------------------------------
# Dual-endpoint hub preparation.
#
# A dual hub is declared on the hub entity with two role columns referencing a
# participant/base entity's stable key.  Preparation validates roles, keys and
# uniqueness, then stores the resolved hub route on the payload.  Lowering reads
# only the prepared route and never rescans metadata.
# ---------------------------------------------------------------------------

def find_entity_index: Fn(Array(EntityEntry), Type) -> Option(Int) = fn(entities, ty) {
    match array::find(entities, fn(e) { e.entity_type == ty }) {
        Some(e) => Some(e.index),
        None => None,
    }
};

type HubResult = enum { Ok(HubRouteEntry), Err(String) };

type HubBuild = struct { routes: Array(HubRouteEntry), problems: Array(String) };

def resolve_hub_decl: Fn(Array(EntityEntry), Int, DualHubDecl) -> HubResult = fn(entities, hub, hd) {
    match find_entity_index(entities, hd.participant) {
        None => HubResult::Err("dual hub participant entity is not part of this knowledge"),
        Some(participant) => do {
            if participant == hub {
                HubResult::Err("dual hub participant must differ from the hub entity")
            } else {
                let participant_entity = get_index(entities, participant);
                let hub_entity = get_index(entities, hub);
                if hd.key_field < 0 || hd.key_field >= array::length(participant_entity.fields) {
                    HubResult::Err("dual hub participant key field is out of range")
                } else if hd.key_field != participant_entity.key_field {
                    HubResult::Err("dual hub participant key must be the participant entity's declared key")
                } else if hd.left_field < 0 || hd.left_field >= array::length(hub_entity.fields) {
                    HubResult::Err("dual hub left endpoint field is out of range")
                } else if hd.right_field < 0 || hd.right_field >= array::length(hub_entity.fields) {
                    HubResult::Err("dual hub right endpoint field is out of range")
                } else if hd.left_field == hd.right_field {
                    HubResult::Err("dual hub left and right endpoints must be distinct fields")
                } else {
                    let entry: HubRouteEntry = {
                        hub,
                        participant,
                        participant_key: hd.key_field,
                        left: hd.left_field,
                        right: hd.right_field,
                    };
                    let ok: HubResult = HubResult::Ok(entry);
                    ok
                }
            }
        },
    }
};

# Pure, deterministic hub route collection: never fails, so tests can assert
# both valid and invalid declarations.  `build_root` fails on the first problem.
def hub_build: Fn(Array(EntityEntry)) -> HubBuild = fn(entities) {
    let init: HubBuild = { routes: [], problems: [] };
    let collected = array::fold(entities, init, fn(acc, entity) {
        let dd = property::get_type_prop(entity.entity_type, DualHubDef.type);
        let specs = match dd {
            Some(d) => d.hubs,
            None => [],
        };
        array::fold(specs, acc, fn(inner_acc, spec) {
            let resolved = resolve_hub_decl(entities, entity.index, spec);
            match resolved {
                HubResult::Err(message) => do {
                    let result: HubBuild = { routes: inner_acc.routes, problems: array::push(inner_acc.problems, message) };
                    result
                },
                HubResult::Ok(entry) => do {
                    # A dual hub expresses "one participant hits either
                    # endpoint".  A hub may legitimately declare such a route for
                    # MULTIPLE participant types; only a duplicate route for the
                    # same (hub, participant) pair is ambiguous.  Expressing two
                    # mutually exclusive endpoints is the explicit `peer_hub`
                    # route, never a pair of independent dual-hub requests.
                    let dup = array::find(inner_acc.routes, fn(r) { r.hub == entry.hub && r.participant == entry.participant });
                    match dup {
                        Some(_) => do {
                            let result: HubBuild = { routes: inner_acc.routes, problems: array::push(inner_acc.problems, "dual hub is ambiguous: duplicate declarations reach the same participant from the same hub") };
                            result
                        },
                        None => do {
                            let result: HubBuild = { routes: array::push(inner_acc.routes, entry), problems: inner_acc.problems };
                            result
                        },
                    }
                },
            }
        })
    });
    collected
};

# ---------------------------------------------------------------------------
# Paired-endpoint (peer) route preparation.
#
# A peer route is declared on the hub entity with the two role fields that
# reference the key fields of two participant entities.  Preparation validates
# roles, keys, field direction and uniqueness, then stores the resolved route on
# the payload.  Lowering reads only the prepared route and never rescans
# metadata.  Multiple independent `dual_hub` declarations on one hub are already
# rejected above, so a pair can never silently compile into two independent
# EXISTS that may hit the same endpoint.
# ---------------------------------------------------------------------------

type PeerResult = enum { Ok(PeerRouteEntry), Err(String) };

type PeerBuild = struct { routes: Array(PeerRouteEntry), problems: Array(String) };

def resolve_peer_decl: Fn(Array(EntityEntry), Int, PeerHubDecl) -> PeerResult = fn(entities, hub, declaration) {
    match (find_entity_index(entities, declaration.origin_participant), find_entity_index(entities, declaration.peer_participant)) {
        (None, _) => PeerResult::Err("peer hub origin participant entity is not part of this knowledge"),
        (_, None) => PeerResult::Err("peer hub peer participant entity is not part of this knowledge"),
        (Some(origin_entity), Some(peer_entity)) => do {
            let resolved_declaration = match declaration.field_names {
                None => declaration,
                Some(names) => do {
                    let origin = get_index(entities, origin_entity);
                    let peer = get_index(entities, peer_entity);
                    let hub_entry = get_index(entities, hub);
                    let origin_key = match array::find(origin.fields, fn(f) { f.name == names.origin_key }) {
                        Some(f) => f.index, None => fail!("unknown peer hub origin participant key field", names.origin_key),
                    };
                    let origin_field = match array::find(hub_entry.fields, fn(f) { f.name == names.origin_field }) {
                        Some(f) => f.index, None => fail!("unknown peer hub origin endpoint field", names.origin_field),
                    };
                    let peer_key = match array::find(peer.fields, fn(f) { f.name == names.peer_key }) {
                        Some(f) => f.index, None => fail!("unknown peer hub peer participant key field", names.peer_key),
                    };
                    let peer_field = match array::find(hub_entry.fields, fn(f) { f.name == names.peer_field }) {
                        Some(f) => f.index, None => fail!("unknown peer hub peer endpoint field", names.peer_field),
                    };
                    {...declaration, origin_key, origin_field, peer_key, peer_field, field_names: None}
                },
            };
            let declaration = resolved_declaration;
            if origin_entity == hub {
                PeerResult::Err("peer hub origin participant must differ from the hub entity")
            } else if peer_entity == hub {
                PeerResult::Err("peer hub peer participant must differ from the hub entity")
            } else {
                let origin_entity_entry = get_index(entities, origin_entity);
                let peer_entity_entry = get_index(entities, peer_entity);
                let hub_entity = get_index(entities, hub);
                let field_count = array::length(hub_entity.fields);
                if declaration.origin_key < 0 || declaration.origin_key >= array::length(origin_entity_entry.fields) {
                    PeerResult::Err("peer hub origin participant key field is out of range")
                } else if declaration.origin_key != origin_entity_entry.key_field {
                    PeerResult::Err("peer hub origin participant key must be the participant entity's declared key")
                } else if declaration.peer_key < 0 || declaration.peer_key >= array::length(peer_entity_entry.fields) {
                    PeerResult::Err("peer hub peer participant key field is out of range")
                } else if declaration.peer_key != peer_entity_entry.key_field {
                    PeerResult::Err("peer hub peer participant key must be the participant entity's declared key")
                } else if declaration.origin_field < 0 || declaration.origin_field >= field_count {
                    PeerResult::Err("peer hub origin endpoint field is out of range")
                } else if declaration.peer_field < 0 || declaration.peer_field >= field_count {
                    PeerResult::Err("peer hub peer endpoint field is out of range")
                } else if declaration.origin_field == declaration.peer_field {
                    PeerResult::Err("peer hub origin and peer endpoints must be distinct fields")
                } else if get_index(origin_entity_entry.fields, declaration.origin_key).ty != get_index(hub_entity.fields, declaration.origin_field).ty
                    || get_index(peer_entity_entry.fields, declaration.peer_key).ty != get_index(hub_entity.fields, declaration.peer_field).ty {
                    PeerResult::Err("peer hub participant key and endpoint field types differ")
                } else {
                    let exchange = !declaration.directed;
                    let entry: PeerRouteEntry = {
                        hub,
                        origin_entity,
                        origin_key: declaration.origin_key,
                        origin_field: declaration.origin_field,
                        peer_entity,
                        peer_key: declaration.peer_key,
                        peer_field: declaration.peer_field,
                        exchange,
                        relations: declaration.relations,
                    };
                    let ok: PeerResult = PeerResult::Ok(entry);
                    ok
                }
            }
        },
    }
};

# Pure, deterministic peer route collection: never fails, so tests can assert
# both valid and invalid declarations.  `build_root` fails on the first problem.
# A hub may declare at most one paired route; more than one would be ambiguous.
def peer_build: Fn(Array(EntityEntry)) -> PeerBuild = fn(entities) {
    let init: PeerBuild = { routes: [], problems: [] };
    let collected = array::fold(entities, init, fn(acc, entity) {
        let pd = property::get_type_prop(entity.entity_type, PeerHubDef.type);
        let specs = match pd {
            Some(d) => d.hubs,
            None => [],
        };
        array::fold(specs, acc, fn(inner_acc, spec) {
            let resolved = resolve_peer_decl(entities, entity.index, spec);
            match resolved {
                PeerResult::Err(message) => do {
                    let result: PeerBuild = { routes: inner_acc.routes, problems: array::push(inner_acc.problems, message) };
                    result
                },
                PeerResult::Ok(entry) => do {
                    # Duplicate/ambiguous declaration: two paired routes for the
                    # SAME participant pair on one hub would make the lookup
                    # ambiguous.  Different participant pairs on one hub (the
                    # multi-participant physical-link shape) remain legal.
                    let dup = array::find(inner_acc.routes, fn(r) {
                        r.hub == entry.hub
                        && ((r.origin_entity == entry.origin_entity && r.peer_entity == entry.peer_entity)
                            || (r.origin_entity == entry.peer_entity && r.peer_entity == entry.origin_entity))
                    });
                    match dup {
                        Some(_) => do {
                            let result: PeerBuild = { routes: inner_acc.routes, problems: array::push(inner_acc.problems, "peer hub is ambiguous: duplicate paired-endpoint route for the same participant pair") };
                            result
                        },
                        None => do {
                            let result: PeerBuild = { routes: array::push(inner_acc.routes, entry), problems: inner_acc.problems };
                            result
                        },
                    }
                },
            }
        })
    });
    collected
};

# ---------------------------------------------------------------------------
# Root preparation.
# ---------------------------------------------------------------------------

def build_root: Fn(String, Array(Type), qb::PlanProfile, Fn(String) -> Bool) -> PreparedPayload = fn(revision, entity_types, profile, authorize) {
    let n = array::length(entity_types);
    let entities = check_entity_aliases(check_entity_ids(array::map(int_range(n), fn(i) {
        build_entity(get_index(entity_types, i), i)
    })));
    let measures_raw = array::flat_map(entities, fn(e) { collect_entity_measures(entities, e) });
    let measures = check_measure_contract(entities, measures_raw);
    let measure_columns_ok = array::all(measures, fn(measure) {
        let entity = get_index(entities, measure.entity);
        let field = get_index(entity.fields, measure.field);
        if measure.computed == None && field.column == "" {
            fail!("measure input requires a physical column", measure.id, entity.id, field.name)
        } else { True }
    });
    let descriptions_ok = check_measure_descriptions(entities, measures);
    let dimensions = check_dimension_ids(array::flat_map(entities, fn(e) { collect_entity_dimensions(e) }));
    let dimension_columns_ok = array::all(dimensions, fn(dimension) {
        let entity = get_index(entities, dimension.entity);
        let field = get_index(entity.fields, dimension.field);
        if field.column == "" {
            fail!("dimension source requires a physical column", dimension.id, entity.id, field.name)
        } else { True }
    });
    let dimension_descriptions_ok = check_dimension_descriptions(entities, dimensions);
    let native_pairs = array::flat_map(entities, fn(e) {
        let declared = match property::get_type_prop(e.entity_type, NativePairDef.type) {
            Some(definition) => definition.pairs, None => [],
        };
        array::map(declared, fn(spec) {
            let first = match array::find(dimensions, fn(d) { d.id == spec.first && d.entity == e.index }) {
                Some(d) => d, None => fail!("unknown native pair first dimension", e.id, spec),
            };
            let second = match array::find(dimensions, fn(d) { d.id == spec.second && d.entity == e.index }) {
                Some(d) => d, None => fail!("unknown native pair second dimension", e.id, spec),
            };
            if spec.id == "" || spec.first == spec.second || first.computed || second.computed
                || first.field == second.field || !first.filterable || !second.filterable
                || !array::any(first.ops, fn(op) { op == FilterOp::Eq })
                || !array::any(second.ops, fn(op) { op == FilterOp::Eq })
                || array::length(first.canonical_values) != 0 || array::length(second.canonical_values) != 0
                || get_index(e.fields, first.field).ty != get_index(e.fields, second.field).ty
                || first.input_kinds != second.input_kinds {
                fail!("native pair requires distinct compatible plain equality dimensions", e.id, spec)
            } else {
                let entry: NativePairEntry = { id: spec.id, entity: e.index, first: spec.first, second: spec.second };
                entry
            }
        })
    });
    if let Some(duplicate) = array::find(native_pairs, fn(p) {
        array::length(array::filter(native_pairs, fn(other) { other.id == p.id })) > 1
    }) { fail!("duplicate native pair id", duplicate.id) } else { () };
    let requires_disjunction = array::any(dimensions, fn(d) {
        array::any(d.canonical_values, fn(v) { array::length(v.wires) > 1 })
            || (array::length(d.canonical_values) > 1 && array::any(d.ops, fn(op) { op == FilterOp::Ne }))
    });
    let uses_canonical = array::any(dimensions, fn(d) { array::length(d.canonical_values) > 0 });
    let uses_canonical_ne = array::any(dimensions, fn(d) {
        array::length(d.canonical_values) > 0 && array::any(d.ops, fn(op) { op == FilterOp::Ne })
    });
    let profile_ok = if uses_canonical && (!array::any(profile.allowed_scalars, fn(op) { op == qb::ScalarFunction::Eq })
        || !array::any(profile.allowed_scalars, fn(op) { op == qb::ScalarFunction::If })
        || !array::any(profile.allowed_operators, fn(op) { op == qb::Operator::Scalar })
        || !array::any(profile.allowed_operators, fn(op) { op == qb::Operator::Bind })
        || !array::any(profile.allowed_operators, fn(op) { op == qb::Operator::Filter })
        || (requires_disjunction && !array::any(profile.allowed_scalars, fn(op) { op == qb::ScalarFunction::Or }))
        || (uses_canonical_ne && !array::any(profile.allowed_scalars, fn(op) { op == qb::ScalarFunction::Ne }))
        || (uses_canonical_ne && !array::any(profile.allowed_scalars, fn(op) { op == qb::ScalarFunction::And }))) {
        fail!("canonical value mapping requires Eq, If, Scalar, Bind, Filter and the declared multi-wire Or/Ne/And operations in the query profile")
    } else {
        True
    };
    let relations = collect_relations(entities);
    if let Some(duplicate) = array::find(relations, fn(rel) {
        rel.id != "" && array::length(array::filter(relations, fn(other) { other.id == rel.id })) > 1
    }) {
        fail!("duplicate named relation id", duplicate.id)
    } else { () };
    let business_links = collect_business_links(entities, relations);
    let hub_build_result = hub_build(entities);
    let hub_routes = if array::length(hub_build_result.problems) > 0 {
        fail!("invalid dual hub declaration", get_index(hub_build_result.problems, 0))
    } else {
        hub_build_result.routes
    };
    let peer_build_result = peer_build(entities);
    let peer_routes = if array::length(peer_build_result.problems) > 0 {
        fail!("invalid paired-endpoint hub declaration", get_index(peer_build_result.problems, 0))
    } else {
        peer_build_result.routes
    };
    let paths = build_paths(n, relations);
    let ambiguous_paths = build_ambiguous_paths(n, relations);
    let payload: PreparedPayload = {
        revision,
        entities,
        measures,
        dimensions,
        relations,
        business_links,
        hub_routes,
        peer_routes,
        native_pairs,
        paths,
        ambiguous_paths,
        profile,
        authorize,
    };
    let peer_identity_validated = array::all(peer_routes, fn(route) {
        match route.relations {
            None => True,
            Some(role_relations) => do {
                let origin = get_index(entities, route.origin_entity);
                let peer = get_index(entities, route.peer_entity);
                let origin_source = qb::source_with_hint(qb::build_context(), origin.table, peer_inner_alias(origin, "o"));
                let peer_source = qb::source_with_hint(origin_source.0, peer.table, peer_inner_alias(peer, "p"));
                peer_role_identity(payload, role_relations.origin, route, route.origin_entity,
                    route.origin_key, route.origin_field, origin_source.1);
                peer_role_identity(payload, role_relations.peer, route, route.peer_entity,
                    route.peer_key, route.peer_field, peer_source.1);
                True
            },
        }
    });
    let predicates_validated = array::all(measures, fn(entry) {
        match entry.predicate {
            Some(_) => do { resolve_measure_predicate_with_context(qb::build_context(), payload, entry); True },
            None => True,
        }
    });
    let dimension_scopes_validated = array::all(dimensions, fn(entry) {
        array::all(entry.scope, fn(predicate) {
            resolve_scope_with_context(qb::build_context(), payload, entry, predicate, True);
            True
        })
    });
    let entity_scopes_validated = array::all(entities, fn(entity) {
        let resolutions = array::map(entity.scope, fn(predicate) {
            let field = match array::find(entity.fields, fn(f) { f.index == predicate.field }) {
                Some(f) => f,
                None => fail!("entity scope references an unknown field", entity.id, predicate.field),
            };
            let dimension = match array::find(dimensions, fn(d) { d.entity == entity.index && d.field == field.index }) {
                Some(d) => d,
                None => fail!(`entity scope requires a declared dimension: \{entity.id} field \{field.name} index \{field.index}`),
            };
            resolve_scope_with_context(qb::build_context(), payload, dimension, predicate, False).1
        });
        match find_internal_conflict(resolutions) {
            Some(conflict) => fail!("entity scope has contradictory predicates", entity.id, conflict.field),
            None => if array::length(entity.scope) > 0
                && !qb::source_profile_accepts(entity_source_at_with_context(qb::build_context(), payload, entity, entity.alias).1, profile) {
                fail!("entity scope uses capabilities not allowed by the query profile", entity.id)
            } else { True },
        }
    });
    let aliases_ok = check_knowledge_aliases(payload);
    let localized_ok = check_localized_knowledge(payload);
    if profile_ok && peer_identity_validated && descriptions_ok && dimension_descriptions_ok && measure_columns_ok && dimension_columns_ok && predicates_validated && dimension_scopes_validated && entity_scopes_validated && aliases_ok && localized_ok { payload } else { payload }
};

# ---------------------------------------------------------------------------
# Pure contract probes (used by tests; never fail).
# ---------------------------------------------------------------------------

# Prepare only the entity/relation graph of a candidate knowledge (no measures,
# dimensions, paths or profile processing).
def knowledge_graph: Fn(Array(Type)) -> (Array(EntityEntry), Array(RelationEntry)) = fn(entity_types) {
    let n = array::length(entity_types);
    let entities = array::map(int_range(n), fn(i) {
        build_entity(get_index(entity_types, i), i)
    });
    let relations = collect_relations(entities);
    (entities, relations)
};

# Pure feasibility probe: True when a correlated existence between the two
# stable entity ids is lowerable through a declared one-hop relation in either
# direction or a dual-hub relation. Longer paths require an explicit graph Intent.
def correlation_feasible: Fn(PreparedPayload, String, String) -> Bool = fn(payload, base_id, target_id) {
    match array::find(payload.entities, fn(e) { e.id == base_id }) {
        None => False,
        Some(base) => match array::find(payload.entities, fn(e) { e.id == target_id }) {
            None => False,
            Some(t) => if base.index == t.index {
                False
            } else {
                match find_hub_route(payload, base.index, t.index) {
                    Some(_) => True,
                    None => lookup_existence_relation_opt(payload, base.index, t.index) != None,
                }
            },
        },
    }
};

# Pure probe: every filter in a correlated-existence inner list references a
# dimension declared on the target entity index (the path end). Used to assert
# that inner filters cannot reach beyond the declared path.
def filters_on_entity: Fn(PreparedPayload, Int, Array(FilterRequest)) -> Bool = fn(payload, target, filters) {
    array::all(filters, fn(req) {
        match array::find(payload.dimensions, fn(d) { d.id == req.id }) {
            Some(d) => d.entity == target,
            None => False,
        }
    })
};

# ---------------------------------------------------------------------------
# Hot-path lowering.
# ---------------------------------------------------------------------------

type ResolvedMeasure = struct {
    entry: MeasureEntry,
    distinct: Bool,
};

type ResolvedDimension = struct {
    entry: DimensionEntry,
};

type FilterResolution = struct {
    expr: qb::Expr,
    entity: Int,
    field: Int,
    op: FilterOp,
    input: FilterInput,
};


def resolve_measure_entry: Fn(PreparedPayload, MeasureRequest) -> ResolvedMeasure = fn(payload, req) {
    if !payload.authorize(req.subject) {
        fail!("subject is not authorized for measure", req.subject, req.id)
    } else {
        match array::find(payload.measures, fn(m) { m.id == req.id }) {
            Some(entry) => if req.input != entry.input {
                fail!("measure input does not match its declared ontology semantics", req.id)
            } else {
                let distinct = match entry.input { MeasureInput::Distinct => True, MeasureInput::All => False };
                let result: ResolvedMeasure = { entry, distinct };
                result
            },
            None => fail!("unknown measure", req.subject, req.id),
        }
    }
};

def resolve_measure_by_id: Fn(PreparedPayload, String, String) -> ResolvedMeasure = fn(payload, id, subject) {
    if !payload.authorize(subject) {
        fail!("subject is not authorized for measure", subject, id)
    } else {
        match array::find(payload.measures, fn(m) { m.id == id }) {
            Some(entry) => do {
                let distinct = match entry.input { MeasureInput::Distinct => True, MeasureInput::All => False };
                let result: ResolvedMeasure = { entry, distinct };
                result
            },
            None => fail!("unknown measure dependency", subject, id),
        }
    }
};

# Transitive computed-measure dependencies, dependencies before dependents.
def transitive_deps: Fn(Array(MeasureEntry), String) -> Array(String) = fn(measures, id) {
    match array::find(measures, fn(m) { m.id == id }) {
        Some(m) => match m.computed {
            Some(spec) => array::concat([
                transitive_deps(measures, spec.left),
                [spec.left],
                transitive_deps(measures, spec.right),
                [spec.right],
            ]),
            None => [],
        },
        None => [],
    }
};

type MeasureExpandState = struct {
    included: Array(String),
    resolved: Array(ResolvedMeasure),
};

def expand_measure: Fn(PreparedPayload, MeasureExpandState, MeasureRequest) -> MeasureExpandState = fn(payload, state, req) {
    let entry = resolve_measure_entry(payload, req);
    let deps = transitive_deps(payload.measures, entry.entry.id);
    let missing = array::fold(deps, [], fn(acc, id) {
        if array::any(acc, fn(a) { a == id }) || array::any(state.included, fn(a) { a == id }) {
            acc
        } else {
            array::push(acc, id)
        }
    });
    let new_resolved = array::fold(missing, state.resolved, fn(acc, id) {
        array::push(acc, resolve_measure_by_id(payload, id, req.subject))
    });
    let included2 = array::fold(missing, state.included, fn(acc, id) {
        if array::any(acc, fn(a) { a == id }) { acc } else { array::push(acc, id) }
    });
    let included3 = if array::any(included2, fn(a) { a == entry.entry.id }) { included2 } else { array::push(included2, entry.entry.id) };
    let resolved2 = array::push(new_resolved, entry);
    let result: MeasureExpandState = { included: included3, resolved: resolved2 };
    result
};

def resolve_measures: Fn(PreparedPayload, Array(MeasureRequest)) -> Array(ResolvedMeasure) = fn(payload, requests) {
    let init: MeasureExpandState = { included: [], resolved: [] };
    let final_state = array::fold(requests, init, fn(state, req) { expand_measure(payload, state, req) });
    final_state.resolved
};

def resolve_dimensions: Fn(PreparedPayload, Array(DimensionRequest)) -> Array(ResolvedDimension) = fn(payload, requests) {
    array::map(requests, fn(req) {
        if !payload.authorize(req.subject) {
            fail!("subject is not authorized for dimension", req.subject, req.id)
        } else {
            match array::find(payload.dimensions, fn(d) { d.id == req.id }) {
                Some(entry) => do {
                    if !entry.authorized {
                        fail!("dimension is not authorized", req.subject, req.id)
                    } else {
                        let result: ResolvedDimension = { entry };
                        result
                    }
                },
                None => fail!("unknown dimension", req.subject, req.id),
            }
        }
    })
};

def dimension_expr: Fn(qb::BuildCtx, PreparedPayload, DimensionEntry) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry) {
    let entity = get_index(payload.entities, entry.entity);
    let field = get_index(entity.fields, entry.field);
    let base = qb::column(entity.source, field.column);
    entry.build(ctx, base)
};

# Public discovery: the closed value domain (stable values and labels) of a
# dimension, or the empty array for an open (String/Int/Float) dimension.
# Unknown dimension ids fail atomically (closed vocabulary).
def dimension_domain: Fn(PreparedPayload, String) -> Array(EnumValueEntry) = fn(payload, id) {
    match array::find(payload.dimensions, fn(d) { d.id == id }) {
        Some(entry) => entry.values,
        None => fail!("unknown dimension", id),
    }
};

def canonical_value_domain: Fn(PreparedPayload, String) -> Array(CanonicalValueSpec) = fn(payload, id) {
    match array::find(payload.dimensions, fn(d) { d.id == id }) {
        Some(entry) => entry.canonical_values,
        None => fail!("unknown dimension", id),
    }
};

def dimension_brief: Fn(PreparedPayload, DimensionEntry) -> DimensionBrief = fn(payload, entry) {
    let entity = get_index(payload.entities, entry.entity);
    let field = get_index(entity.fields, entry.field);
    let note = match property::get_field_prop(entity.entity_type, field.index, DimensionDescriptions.type) {
        Some(declared) => array::find(declared.notes, fn(item) { item.id == entry.id }),
        None => None,
    };
    let scope: Array(DimensionScopeBrief) = array::map(entry.scope, fn(predicate) {
        {field: match array::find(entity.fields, fn(f) { f.index == predicate.field }) {
            Some(f) => f.name, None => fail!("scope references an unknown field", entity.id, predicate.field),
        }, op: predicate.op, input: predicate.input}
    });
    {id: entry.id, label: match note { Some(n) => n.label, None => entry.id },
        aliases: member_aliases(entity.entity_type, field.index, MemberAliasKind::Dimension, entry.id),
        localized: localized_member_texts(entity.entity_type, field.index, MemberAliasKind::Dimension, entry.id),
        summary: match note { Some(n) => n.summary, None => "" },
        dataset: entity.id, field: field.name, computed: entry.computed,
        authorized: entry.authorized, filterable: entry.filterable,
        ops: entry.ops, input_kinds: entry.input_kinds, values: entry.values,
        canonical_values: entry.canonical_values, canonical_aliases: entry.canonical_aliases,
        localized_values: localized_value_labels(entity.entity_type, field.index), scope}
};

def dimension_detail: Fn(PreparedPayload, String) -> DimensionBrief = fn(payload, id) {
    match array::find(payload.dimensions, fn(entry) { entry.id == id }) {
        Some(entry) => dimension_brief(payload, entry),
        None => fail!("unknown dimension knowledge point", id),
    }
};

def dimension_detail_for_subject: Fn(PreparedPayload, String, String) -> SubjectDimensionBrief = fn(payload, subject, id) {
    if !payload.authorize(subject) {
        fail!("subject is not authorized for dimension discovery", subject, id)
    } else {
        let detail = dimension_detail(payload, id);
        if !detail.authorized { fail!("dimension is not authorized for discovery", subject, id) }
        else {
            let values: Array(BusinessValueBrief) = if array::length(detail.canonical_values) > 0 {
                array::map(detail.canonical_values, fn(value) { {id: value.id, label: value.label,
                    aliases: array::map(array::filter(detail.canonical_aliases, fn(alias) { alias.id == value.id }), fn(alias) { alias.label }),
                    localized: array::map(array::filter(detail.localized_values, fn(item) { item.id == value.id }), fn(item) {
                        let result: LocalizedValueLabel = {locale: item.locale, label: item.label};
                        result
                    })} })
            } else {
                array::map(detail.values, fn(value) { {id: value.value, label: value.label, aliases: [], localized: []} })
            };
            {id: detail.id, label: detail.label, aliases: detail.aliases, localized: detail.localized, summary: detail.summary,
                dataset: detail.dataset, field: detail.field, computed: detail.computed,
                filterable: detail.filterable, ops: detail.ops,
                input_kinds: detail.input_kinds, values, scope: detail.scope}
        }
    }
};

def dataset_domain: Fn(PreparedPayload, String) -> DatasetSpec = fn(payload, id) {
    let entity = match array::find(payload.entities, fn(entry) { entry.id == id }) {
        Some(entry) => entry,
        None => fail!("unknown dataset", id),
    };
    match entity.dataset {
        Some(spec) => spec,
        None => fail!("dataset has no declared grain and time roles", id),
    }
};

# Field-level time roles are discoverable independently of a dataset's UTC clock.
def time_domain: Fn(PreparedPayload, String, String) -> TimeField = fn(payload, id, name) {
    let entity = match array::find(payload.entities, fn(entry) { entry.id == id }) {
        Some(entry) => entry,
        None => fail!("unknown time entity", id),
    };
    let field = match array::find(entity.fields, fn(entry) { entry.name == name }) {
        Some(entry) => entry,
        None => fail!("unknown time field", id, name),
    };
    match property::get_field_prop(entity.entity_type, field.index, TimeField.type) {
        Some(role) => role,
        None => fail!("field has no declared time role", id, name),
    }
};

def metric_domain: Fn(PreparedPayload, String) -> Array(MetricValueEntry) = fn(payload, id) {
    match array::find(payload.entities, fn(entry) { entry.id == id }) {
        Some(entry) => entry.metrics,
        None => fail!("unknown dataset", id),
    }
};

def measure_domain: Fn(PreparedPayload, String) -> MeasureBrief = fn(payload, id) {
    let measure = match array::find(payload.measures, fn(entry) { entry.id == id }) {
        Some(entry) => entry,
        None => fail!("unknown measure knowledge point", id),
    };
    let entity = get_index(payload.entities, measure.entity);
    let field = get_index(entity.fields, measure.field);
    let note = match property::get_field_prop(entity.entity_type, field.index, MeasureDescriptions.type) {
        Some(declared) => array::find(declared.notes, fn(item) { item.id == id }),
        None => None,
    };
    let required_dataset_ids = array::map(measure.requires, fn(index) { get_index(payload.entities, index).id });
    let predicate = match measure.predicate {
        Some(spec) => Some({field: get_index(entity.fields, spec.field).name, op: spec.op, input: spec.input}),
        None => None,
    };
    let computed = measure.computed;
    let result: MeasureBrief = {
        id,
        label: match note { Some(declared) => declared.label, None => id },
        aliases: member_aliases(entity.entity_type, field.index, MemberAliasKind::Measure, id),
        localized: localized_member_texts(entity.entity_type, field.index, MemberAliasKind::Measure, id),
        summary: match note { Some(declared) => declared.summary, None => "" },
        dataset: entity.id,
        field: if computed == None { Some(field.name) } else { None },
        aggregate: if computed == None { Some(measure.aggregate) } else { None },
        input: if computed == None { Some(measure.input) } else { None },
        required_dataset_ids,
        predicate,
        computed,
        metric: array::find(entity.metrics, fn(entry) { entry.id == id }),
    };
    result
};

def measure_domain_for_subject: Fn(PreparedPayload, String, String) -> MeasureBrief = fn(payload, subject, id) {
    if !payload.authorize(subject) {
        fail!("subject is not authorized for measure discovery", subject, id)
    } else { measure_domain(payload, id) }
};

def relation_domain: Fn(PreparedPayload, String) -> RelationEntry = fn(payload, id) {
    match array::find(payload.relations, fn(entry) { entry.id == id && entry.id != "" }) {
        Some(entry) => entry,
        None => fail!("unknown named relation", id),
    }
};

def relation_shape: Fn(RelationKey) -> RelationShape = fn(key) {
    match key {
        RelationKey::Eq(_) => RelationShape::Equality,
        RelationKey::FieldEq(_) => RelationShape::Equality,
        RelationKey::And(parts) => RelationShape::All(array::map(parts, relation_shape)),
        RelationKey::Or(parts) => RelationShape::Any(array::map(parts, relation_shape)),
    }
};

def relation_brief: Fn(PreparedPayload, RelationEntry) -> RelationBrief = fn(payload, entry) {
    {id: entry.id, label: entry.label, summary: entry.summary,
        aliases: relation_aliases(get_index(payload.entities, entry.from).entity_type, entry.id),
        localized: localized_relation_texts(get_index(payload.entities, entry.from).entity_type, entry.id),
        from_dataset: get_index(payload.entities, entry.from).id,
        to_dataset: get_index(payload.entities, entry.to).id,
        kind: entry.kind, shape: relation_shape(entry.key)}
};

def relation_detail_for_subject: Fn(PreparedPayload, String, String) -> RelationBrief = fn(payload, subject, id) {
    if !payload.authorize(subject) {
        fail!("subject is not authorized for relation discovery", subject, id)
    } else {
        relation_brief(payload, relation_domain(payload, id))
    }
};

def native_pair_domain: Fn(PreparedPayload, String) -> Array(NativePairEntry) = fn(payload, dataset_id) {
    let entity = entity_by_id(payload, dataset_id);
    array::filter(payload.native_pairs, fn(pair) { pair.entity == entity })
};

def dataset_brief: Fn(PreparedPayload, EntityEntry, Bool) -> DatasetBrief = fn(payload, entity, authorized_only) {
        let kind = match entity.dataset {
            Some(spec) => spec.kind,
            None => DatasetKind::Entity,
        };
        let description = match entity.description {
            Some(note) => note,
            None => do {
                let note: DatasetDescription = { label: entity.id, summary: "" };
                note
            },
        };
        let time_roles: Array(TimeRoleBrief) = array::flat_map(entity.fields, fn(field) {
            match property::get_field_prop(entity.entity_type, field.index, TimeField.type) {
                None => [],
                Some(role) => do {
                    let authoritative = match entity.dataset {
                        Some(spec) => spec.utc_time == Some(field.name),
                        None => False,
                    };
                    let dimension_ids = array::map(array::filter(payload.dimensions, fn(d) {
                        d.entity == entity.index && d.field == field.index
                            && (!authorized_only || d.authorized)
                    }), fn(d) { d.id });
                    if authorized_only && role.semantics != TimeSemantics::Utc
                        && array::length(dimension_ids) == 0 { [] }
                    else {
                        let brief: TimeRoleBrief = {
                            field: field.name, semantics: role.semantics,
                            encoding: role.encoding, authoritative, dimension_ids,
                        };
                        [brief]
                    }
                },
            }
        });
        let result: DatasetBrief = {
            id: entity.id,
            label: description.label,
            aliases: match property::get_type_prop(entity.entity_type, DatasetAliasesDef.type) {
                Some(declared) => declared.labels, None => [],
            },
            localized: match property::get_type_prop(entity.entity_type, LocalizedDatasetTexts.type) {
                Some(declared) => declared.texts, None => [],
            },
            summary: description.summary,
            kind,
            dimension_ids: array::map(array::filter(payload.dimensions, fn(d) {
                d.entity == entity.index && (!authorized_only || d.authorized)
            }), fn(d) { d.id }),
            measure_ids: array::map(array::filter(payload.measures, fn(m) { m.entity == entity.index }), fn(m) { m.id }),
            metric_ids: array::map(entity.metrics, fn(metric) { metric.id }),
            relation_ids: array::map(array::filter(payload.relations, fn(rel) {
                rel.id != "" && (rel.from == entity.index || rel.to == entity.index)
            }), fn(rel) { rel.id }),
            time_roles,
            scope: array::map(entity.scope, fn(predicate) {
                {field: match array::find(entity.fields, fn(f) { f.index == predicate.field }) {
                    Some(f) => f.name, None => fail!("entity scope references an unknown field", entity.id, predicate.field),
                }, op: predicate.op, input: predicate.input}
            }),
        };
        result
};

def knowledge_index: Fn(PreparedPayload) -> Array(DatasetBrief) = fn(payload) {
    array::map(payload.entities, fn(entity) { dataset_brief(payload, entity, False) })
};

def knowledge_index_for_subject: Fn(PreparedPayload, String) -> Array(DatasetBrief) = fn(payload, subject) {
    if !payload.authorize(subject) {
        fail!("subject is not authorized for knowledge discovery", subject)
    } else {
        array::map(payload.entities, fn(entity) { dataset_brief(payload, entity, True) })
    }
};

def dataset_relations: Fn(PreparedPayload, String) -> Array(RelationEntry) = fn(payload, id) {
    let dataset_index = entity_by_id(payload, id);
    array::filter(payload.relations, fn(rel) {
        rel.id != "" && (rel.from == dataset_index || rel.to == dataset_index)
    })
};




def dimension_output_with_context: Fn(qb::BuildCtx, PreparedPayload, DimensionEntry) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry) {
    let physical = dimension_expr(ctx, payload, entry);
    if array::length(entry.canonical_values) == 0 {
        physical
    } else {
        let unknown = qb::bind(physical.0, qb::Val::None);
        array::fold(entry.canonical_values, unknown, fn(state, value) {
            let compared = canonical_compare_with_context(state.0, entry, physical.1, FilterOp::Eq, FilterInput::Text(value.id));
            let label = qb::bind(compared.0, qb::Val::String(value.id));
            (label.0, qb::scalar_if(compared.1, label.1, state.1))
        })
    }
};

def dimension_outputs_with_context: Fn(qb::BuildCtx, PreparedPayload, Array(ResolvedDimension)) -> (qb::BuildCtx, Array(qb::Expr)) = fn(ctx, payload, dimensions) {
    let initial: (qb::BuildCtx, Array(qb::Expr)) = (ctx, []);
    array::fold(dimensions, initial, fn(state, dimension) {
        let next = dimension_output_with_context(state.0, payload, dimension.entry);
        (next.0, array::push(state.1, next.1))
    })
};

def filter_input_allowed: Fn(Array(FilterInputKind), FilterInput) -> Bool = fn(kinds, input) {
    let kind: FilterInputKind = match input {
        FilterInput::Text(_) => FilterInputKind::Text,
        FilterInput::Number(_) => FilterInputKind::Number,
        FilterInput::Int(_) => FilterInputKind::Int,
        FilterInput::Bool(_) => FilterInputKind::Bool,
    };
    array::any(kinds, fn(k) { k == kind })
};

# True for the text-search operations (starts-with/contains/ends-with families).
def is_text_op: Fn(FilterOp) -> Bool = fn(op) {
    match op {
        FilterOp::Contains => True,
        FilterOp::NotContains => True,
        FilterOp::StartsWith => True,
        FilterOp::EndsWith => True,
        FilterOp::Eq => False,
        FilterOp::Ne => False,
        FilterOp::Gt => False,
        FilterOp::Ge => False,
        FilterOp::Lt => False,
        FilterOp::Le => False,
    }
};

# Build the closed query expression for an open (non-enum) dimension filter.
# The caller has already validated operation support and the input kind/value.
# Comparison ops map to the closed query scalars; text ops lower through the
# closed qb.ScalarFunction.Instr/qb.ScalarFunction.Lower/qb.ScalarFunction.Length/qb.ScalarFunction.Substr/qb.ScalarFunction.Add/qb.ScalarFunction.Sub vocabulary. All runtime values
# remain parameterized binds.

# Convert a runtime filter value into the query ScalarValue used at codec
# boundaries and by HAVING thresholds.
def to_val: Fn(FilterInput) -> qb::Val = fn(input) {
    match input {
        FilterInput::Text(s) => qb::Val::String(s),
        FilterInput::Number(f) => qb::Val::Float(f),
        FilterInput::Int(i) => qb::Val::Int(i),
        FilterInput::Bool(b) => qb::Val::Bool(b),
    }
};

# Enum closed-domain filter resolution. A legal stable value keeps producing a
# parameterized binding; unknown values fail atomically with the subject, the
# dimension id and the dynamic JSON input value as evidence.


# Construction-time variant: validation precedes allocation for each request,
# and each generated predicate carries handles registered in the returned ctx.
def canonical_compare_with_context: Fn(qb::BuildCtx, DimensionEntry, qb::Expr, FilterOp, FilterInput) -> (qb::BuildCtx, qb::Expr) = fn(ctx, entry, base, op, input) {
    let id = match input {
        FilterInput::Text(value) => value,
        _ => fail!("canonical dimension requires a text business value", entry.id, input),
    };
    if op != FilterOp::Eq && op != FilterOp::Ne {
        fail!("canonical dimension supports only Eq or Ne", entry.id, op)
    } else {
        let matched = match array::find(entry.canonical_values, fn(v) { v.id == id }) {
            Some(value) => value,
            None => fail!("unknown canonical value for dimension", entry.id, input),
        };
        let scalar = if op == FilterOp::Eq { qb::ScalarFunction::Eq } else { qb::ScalarFunction::Ne };
        let wires = array::fold(matched.wires, (ctx, None), fn(state, wire) {
            let (next, bound) = qb::bind(state.0, to_val(wire));
            let term = qb::scalar(scalar, [base, bound]);
            let expr = match state.1 {
                None => term,
                Some(prev) => qb::scalar(if op == FilterOp::Eq { qb::ScalarFunction::Or } else { qb::ScalarFunction::And }, [prev, term]),
            };
            (next, Some(expr))
        });
        let compared = match wires.1 {
            Some(expr) => expr,
            None => fail!("canonical value has no physical wires", entry.id, id),
        };
        if op == FilterOp::Eq { (wires.0, compared) }
        else {
            let known = array::fold(entry.canonical_values, (wires.0, None), fn(state, value) {
                let equal = canonical_compare_with_context(state.0, entry, base, FilterOp::Eq, FilterInput::Text(value.id));
                let expr = match state.1 {
                    None => equal.1,
                    Some(prev) => qb::scalar(qb::ScalarFunction::Or, [prev, equal.1]),
                };
                (equal.0, Some(expr))
            });
            match known.1 {
                Some(domain) => (known.0, qb::scalar(qb::ScalarFunction::And, [compared, domain])),
                None => fail!("canonical dimension has no declared business values", entry.id),
            }
        }
    }
};

def open_condition_with_context: Fn(qb::BuildCtx, qb::Expr, FilterOp, qb::Expr) -> (qb::BuildCtx, qb::Expr) = fn(ctx, base, op, bound) {
    if is_text_op(op) {
        let constant = qb::bind(ctx, qb::Val::Int(if op == FilterOp::StartsWith || op == FilterOp::EndsWith { 1 } else { 0 }));
        let expr = match op {
            FilterOp::Contains => qb::scalar(qb::ScalarFunction::Gt, [qb::instr(qb::lower(base), qb::lower(bound)), constant.1]),
            FilterOp::NotContains => qb::scalar(qb::ScalarFunction::Eq, [qb::instr(base, bound), constant.1]),
            FilterOp::StartsWith => qb::scalar(qb::ScalarFunction::Eq, [qb::instr(qb::lower(base), qb::lower(bound)), constant.1]),
            FilterOp::EndsWith => do {
                let lower_base = qb::lower(base);
                let lower_bound = qb::lower(bound);
                let start = qb::add(qb::sub(qb::length(lower_base), qb::length(lower_bound)), constant.1);
                qb::scalar(qb::ScalarFunction::Eq, [qb::substr([lower_base, start]), lower_bound])
            },
            _ => fail!("invalid text filter operation", op),
        };
        (constant.0, expr)
    } else {
        let function = match op {
            FilterOp::Eq => qb::ScalarFunction::Eq,
            FilterOp::Ne => qb::ScalarFunction::Ne,
            FilterOp::Gt => qb::ScalarFunction::Gt,
            FilterOp::Ge => qb::ScalarFunction::Ge,
            FilterOp::Lt => qb::ScalarFunction::Lt,
            FilterOp::Le => qb::ScalarFunction::Le,
            _ => fail!("invalid scalar filter operation", op),
        };
        (ctx, qb::scalar(function, [base, bound]))
    }
};

def filter_value_on_base_with_context: Fn(qb::BuildCtx, DimensionEntry, qb::Expr, FilterOp, FilterInput) -> (qb::BuildCtx, qb::Expr) = fn(ctx, entry, base, op, input) {
    if array::length(entry.canonical_values) > 0 {
        canonical_compare_with_context(ctx, entry, base, op, input)
    } else if array::length(entry.values) > 0 {
        match input {
            FilterInput::Text(s) => if op != FilterOp::Eq {
                fail!("enum dimension filter supports only Eq", entry.id, op)
            } else if array::any(entry.values, fn(v) { v.value == s }) {
                let bound = qb::bind(ctx, qb::Val::String(s));
                (bound.0, qb::scalar(qb::ScalarFunction::Eq, [base, bound.1]))
            } else { fail!("unknown enum value for dimension", entry.id, s) },
            _ => fail!("invalid enum filter value for dimension", entry.id, input),
        }
    } else if is_text_op(op) && match input { FilterInput::Text(_) => False, _ => True } {
        fail!("text filter operation requires a text input value", entry.id)
    } else if !filter_input_allowed(entry.input_kinds, input) {
        fail!("invalid filter value for dimension", entry.id)
    } else {
        let bound = qb::bind(ctx, to_val(input));
        open_condition_with_context(bound.0, base, op, bound.1)
    }
};

def filter_value_with_context: Fn(qb::BuildCtx, PreparedPayload, DimensionEntry, FilterOp, FilterInput) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry, op, input) {
    let base = dimension_expr(ctx, payload, entry);
    filter_value_on_base_with_context(base.0, entry, base.1, op, input)
};

def resolve_filters_with_context: Fn(qb::BuildCtx, PreparedPayload, Array(FilterRequest)) -> (qb::BuildCtx, Array(FilterResolution)) = fn(ctx, payload, requests) {
    let initial: (qb::BuildCtx, Array(FilterResolution)) = (ctx, []);
    array::fold(requests, initial, fn(state, req) {
        if !payload.authorize(req.subject) { fail!("subject is not authorized for filter", req.subject, req.id) }
        else {
            let entry = match array::find(payload.dimensions, fn(d) { d.id == req.id }) {
                Some(d) => d,
                None => fail!("unknown filter dimension", req.subject, req.id),
            };
            if !entry.authorized { fail!("dimension is not authorized", req.subject, req.id) }
            else if !entry.filterable { fail!("dimension has no filter capability", req.subject, req.id) }
            else if !array::any(entry.ops, fn(op) { op == req.op }) { fail!("filter operation not supported for dimension", req.subject, req.id) }
            else {
                let computed = dimension_expr(state.0, payload, entry);
                let base = computed.1;
                let resolved = if array::length(entry.canonical_values) > 0 {
                    canonical_compare_with_context(computed.0, entry, base, req.op, req.input)
                } else if array::length(entry.values) > 0 {
                    match req.input {
                        FilterInput::Text(s) => if req.op != FilterOp::Eq {
                            fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op)
                        } else if array::any(entry.values, fn(v) { v.value == s }) {
                            let bound = qb::bind(computed.0, qb::Val::String(s));
                            (bound.0, qb::scalar(qb::ScalarFunction::Eq, [base, bound.1]))
                        } else { fail!("unknown enum value for dimension", req.subject, req.id, s) },
                        _ => fail!("invalid enum filter value for dimension", req.subject, req.id, req.input),
                    }
                } else if is_text_op(req.op) && match req.input { FilterInput::Text(_) => False, _ => True } {
                    fail!("text filter operation requires a text input value", req.subject, req.id)
                } else if !filter_input_allowed(entry.input_kinds, req.input) {
                    fail!("invalid filter value for dimension", req.subject, req.id)
                } else {
                    let bound = qb::bind(computed.0, to_val(req.input));
                    open_condition_with_context(bound.0, base, req.op, bound.1)
                };
                let item: FilterResolution = {expr: resolved.1, entity: entry.entity, field: entry.field, op: req.op, input: req.input};
                (resolved.0, array::push(state.1, item))
            }
        }
    })
};

def combine_filters: Fn(Array(qb::Expr)) -> Option(qb::Expr) = fn(exprs) {
    let init_none: Option(qb::Expr) = None;
    match array::fold(exprs, init_none, fn(acc, expr) {
        match acc {
            None => Some(expr),
            Some(prev) => Some(qb::scalar(qb::ScalarFunction::And, [prev, expr])),
        }
    }) {
        Some(expr) => Some(expr),
        None => None,
    }
};

# ---------------------------------------------------------------------------
# Closed OR-group (AnyOf) over one dimension.
# ---------------------------------------------------------------------------

# Left-associative Or over Eq(base, bind(value)) in request order.

# Value-level check for one AnyOf member against a resolved dimension entry:
# closed enum domains require a Text stable value; open dimensions require an
# allowed input kind.
def any_of_value_ok: Fn(DimensionEntry, FilterInput) -> Bool = fn(entry, value) {
    if array::length(entry.canonical_values) > 0 {
        match value {
            FilterInput::Text(s) => array::any(entry.canonical_values, fn(v) { v.id == s }),
            _ => False,
        }
    } else if array::length(entry.values) > 0 {
        match value {
            FilterInput::Text(s) => array::any(entry.values, fn(e) { e.value == s }),
            _ => False,
        }
    } else {
        filter_input_allowed(entry.input_kinds, value)
    }
};

# Build the OR-group expression for an already-resolved, authorized dimension.
# The dimension must support Eq and the group must be non-empty; every member is
# validated before the group is built (atomic failure, no dropped branches).

# Ordinary (subject-query) OR-group: authorization and vocabulary checks, then
# the closed OR-group expression.

# Existence inner OR-group: the dimension must belong to the related (target)
# entity so the OR-group only constrains the EXISTS inner rows.

def any_of_on_target_with_context: Fn(qb::BuildCtx, PreparedPayload, Int, AnyOfRequest) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, target, spec) {
    if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for any-of filter", spec.subject, spec.id)
    } else {
        let entry = match array::find(payload.dimensions, fn(d) { d.id == spec.id }) {
            Some(value) => value,
            None => fail!("unknown any-of dimension", spec.subject, spec.id),
        };
        if entry.entity != target { fail!("any-of inner filter must reference the target entity", spec.id) }
        else if !entry.authorized { fail!("dimension is not authorized", spec.subject, spec.id) }
        else if !entry.filterable { fail!("dimension has no filter capability", spec.subject, spec.id) }
        else if !array::any(entry.ops, fn(op) { op == FilterOp::Eq }) {
            fail!("any-of requires the Eq filter operation for dimension", spec.id)
        } else if array::length(spec.values) == 0 {
            fail!("any-of group must contain at least one value", spec.id)
        } else {
            let initial: (qb::BuildCtx, Option(qb::Expr)) = (ctx, None);
            let result = array::fold(spec.values, initial, fn(state, value) {
                if !any_of_value_ok(entry, value) {
                    fail!("any-of contains an unknown or invalid value for dimension", spec.id)
                } else {
                    let term = filter_value_with_context(state.0, payload, entry, FilterOp::Eq, value);
                    let expr = match state.1 {
                        None => term.1,
                        Some(prev) => qb::scalar(qb::ScalarFunction::Or, [prev, term.1]),
                    };
                    (term.0, Some(expr))
                }
            });
            match result.1 {
                Some(expr) => (result.0, expr),
                None => fail!("any-of group must contain at least one value", spec.id),
            }
        }
    }
};

# Append extra expressions as trailing AND terms (used for OR-group terms after
# the scopes+user filter conjunction).
def append_filter_terms: Fn(Option(qb::Expr), Array(qb::Expr)) -> Option(qb::Expr) = fn(base, extra) {
    array::fold(extra, base, fn(acc, expr) {
        match acc {
            None => Some(expr),
            Some(prev) => Some(qb::scalar(qb::ScalarFunction::And, [prev, expr])),
        }
    })
};

# ---------------------------------------------------------------------------
# Closed field-to-field predicates (same-subject attribute comparisons).
# ---------------------------------------------------------------------------

# Only the closed comparison operators are usable as field-to-field predicates;
# text search operators always need an external value and are rejected here.
def field_compare_op: Fn(FilterOp) -> Bool = fn(op) {
    match op {
        FilterOp::Eq => True,
        FilterOp::Ne => True,
        FilterOp::Gt => True,
        FilterOp::Ge => True,
        FilterOp::Lt => True,
        FilterOp::Le => True,
        FilterOp::Contains => False,
        FilterOp::NotContains => False,
        FilterOp::StartsWith => False,
        FilterOp::EndsWith => False,
    }
};

# Comparable category of a dimension: closed enums are "enum" (compared by the
# stable value domain), open dimensions by their single comparable scalar kind.
def comparable_kind: Fn(DimensionEntry) -> String = fn(entry) {
    if array::length(entry.canonical_values) > 0 || array::length(entry.values) > 0 {
        "enum"
    } else if array::any(entry.input_kinds, fn(k) { k == FilterInputKind::Int }) {
        "int"
    } else if array::any(entry.input_kinds, fn(k) { k == FilterInputKind::Number }) {
        "number"
    } else if array::any(entry.input_kinds, fn(k) { k == FilterInputKind::Text }) {
        "text"
    } else if array::any(entry.input_kinds, fn(k) { k == FilterInputKind::Bool }) {
        "bool"
    } else {
        "none"
    }
};

# Type/domain compatibility: two closed enum domains are compatible only when
# they publish the same stable value domain; open dimensions are compatible
# only when they share the same comparable scalar kind.
def field_domains_compatible: Fn(DimensionEntry, DimensionEntry) -> Bool = fn(left, right) {
    if array::length(left.canonical_values) > 0 || array::length(right.canonical_values) > 0 {
        array::length(left.canonical_values) > 0 && array::length(right.canonical_values) > 0
            && left.canonical_values == right.canonical_values
    } else if array::length(left.values) > 0 || array::length(right.values) > 0 {
        array::length(left.values) > 0 && array::length(right.values) > 0
            && left.values == right.values
    } else {
        let k_left = comparable_kind(left);
        let k_right = comparable_kind(right);
        k_left == k_right && k_left != "none"
    }
};

# Resolve one attribute side of a field-to-field predicate: a declared,
# authorized, plain (column-backed) dimension of the subject entity.  Unknown
# attributes, attributes outside the subject, computed/JSON attributes and
# unauthorized attributes fail atomically.
def resolve_field_attr: Fn(PreparedPayload, Int, String) -> DimensionEntry = fn(payload, subject, id) {
    match array::find(payload.dimensions, fn(d) { d.id == id }) {
        None => fail!("field-to-field predicate references an unknown attribute", id),
        Some(entry) => do {
            if entry.entity != subject {
                fail!("field-to-field predicate references an attribute outside the subject entity", id)
            } else if entry.computed {
                fail!("field-to-field predicate requires a plain column attribute", id)
            } else if !entry.authorized {
                fail!("field-to-field predicate references an unauthorized attribute", id)
            } else {
                entry
            }
        },
    }
};

# Resolve a field-to-field predicate to a comparison of the two validated column
# references.  The subject role must be authorized, the operator must be a
# closed comparison supported by BOTH attributes, and the two attribute
# type/domain must be compatible.  Lowering never creates a dynamic binding.
def resolve_field_filter: Fn(PreparedPayload, Int, FieldFilterRequest) -> qb::Expr = fn(payload, subject, spec) {
    if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for field-to-field predicate", spec.subject, spec.left, spec.right)
    } else if !field_compare_op(spec.op) {
        fail!("field-to-field predicate supports only comparison operators", spec.op)
    } else {
        let left = resolve_field_attr(payload, subject, spec.left);
        let right = resolve_field_attr(payload, subject, spec.right);
        if !array::any(left.ops, fn(o) { o == spec.op })
            || !array::any(right.ops, fn(o) { o == spec.op }) {
            fail!("field-to-field predicate uses an operation not supported by both attributes", spec.op)
        } else if !field_domains_compatible(left, right) {
            fail!("field-to-field predicate operands are type/domain incompatible", spec.left, spec.right)
        } else {
            let function: qb::ScalarFunction = match spec.op {
                FilterOp::Eq => qb::ScalarFunction::Eq,
                FilterOp::Ne => qb::ScalarFunction::Ne,
                FilterOp::Gt => qb::ScalarFunction::Gt,
                FilterOp::Ge => qb::ScalarFunction::Ge,
                FilterOp::Lt => qb::ScalarFunction::Lt,
                FilterOp::Le => qb::ScalarFunction::Le,
                FilterOp::Contains => fail!("field-to-field predicate supports only comparison operators", spec.op),
                FilterOp::NotContains => fail!("field-to-field predicate supports only comparison operators", spec.op),
                FilterOp::StartsWith => fail!("field-to-field predicate supports only comparison operators", spec.op),
                FilterOp::EndsWith => fail!("field-to-field predicate supports only comparison operators", spec.op),
            };
            let left_entity = get_index(payload.entities, left.entity);
            let right_entity = get_index(payload.entities, right.entity);
            let left_field = get_index(left_entity.fields, left.field);
            let right_field = get_index(right_entity.fields, right.field);
            qb::scalar(function, [qb::column(left_entity.source, left_field.column), qb::column(right_entity.source, right_field.column)])
        }
    }
};

# Pure feasibility probe for a field-to-field predicate on a subject entity.
# Returns True when the predicate would lower to a validated two-column
# comparison; False for an unauthorized role, a non-comparison operator, an
# unknown/unauthorized/non-plain/cross-entity attribute, an operator not
# supported by both attributes, or type/domain incompatibility.  Never fails.
def field_filter_ok: Fn(PreparedPayload, Int, FieldFilterRequest) -> Bool = fn(payload, subject, spec) {
    if !payload.authorize(spec.subject) {
        False
    } else if !field_compare_op(spec.op) {
        False
    } else {
        let left_opt = array::find(payload.dimensions, fn(d) { d.id == spec.left });
        let right_opt = array::find(payload.dimensions, fn(d) { d.id == spec.right });
        match (left_opt, right_opt) {
            (None, _) => False,
            (_, None) => False,
            (Some(left), Some(right)) => do {
                let sides_ok = left.entity == subject && !left.computed && left.authorized
                    && right.entity == subject && !right.computed && right.authorized;
                if !sides_ok {
                    False
                } else if !array::any(left.ops, fn(o) { o == spec.op })
                    || !array::any(right.ops, fn(o) { o == spec.op }) {
                    False
                } else if !field_domains_compatible(left, right) {
                    False
                } else {
                    True
                }
            },
        }
    }
};

# The subject entity of a request (base entity), mirroring `lower_core`: the
# first requested measure's entity when measures are present, otherwise the first
# requested dimension's entity.
def request_subject_entity: Fn(PreparedPayload, QueryRequest) -> Int = fn(payload, request) {
    let measures = resolve_measures(payload, request.measures);
    if array::length(measures) > 0 {
        get_index(measures, 0).entry.entity
    } else {
        let dimensions = resolve_dimensions(payload, request.dimensions);
        if array::length(dimensions) == 0 {
            fail!("field-to-field predicate lowering requires at least one measure or dimension")
        } else {
            get_index(dimensions, 0).entry.entity
        }
    }
};

def rebuild_plan_filter: Fn(qb::Plan, Option(qb::Expr)) -> qb::Plan = fn(plan, filter) {
    let rebuilt = plan <~ { filter };
    rebuilt
};

# Lower a request with zero or more closed field-to-field predicates on the
# request subject.  Ordinary scalar filters/scopes are lowered first (unchanged
# deterministic predicate order and bindings); the field-to-field predicates are
# appended as trailing AND terms in request order and never add bindings.
def lower_field_filtered: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(FieldFilterRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, field_filters) {
    let lowered = lower_core(ctx, payload, request, [], [], [], [], [], []);
    let plan = lowered.1;
    if array::length(field_filters) == 0 {
        lowered
    } else {
        let subject = request_subject_entity(payload, request);
        let exprs = array::map(field_filters, fn(spec) { resolve_field_filter(payload, subject, spec) });
        let filter = append_filter_terms(plan.filter, exprs);
        let rebuilt = rebuild_plan_filter(plan, filter);
        (lowered.0, qb::validate(rebuilt, payload.profile))
    }
};

# Enum closed-domain scope resolution (mirrors resolve_enum_filter). A scope
# value must be a member of the referenced dimension's stable value domain.

# Entity scopes may use private dimensions; selected member scopes require
# authorization. Both paths validate the declared filter capability and value.


def resolve_scope_with_context: Fn(qb::BuildCtx, PreparedPayload, DimensionEntry, ScopePredicate, Bool) -> (qb::BuildCtx, FilterResolution) = fn(ctx, payload, owner, predicate, require_authorized) {
    let entity = get_index(payload.entities, owner.entity);
    let field = match array::find(entity.fields, fn(f) { f.index == predicate.field }) {
        Some(f) => f,
        None => fail!("scope references an unknown field", owner.id, predicate.field),
    };
    let d = match array::find(payload.dimensions, fn(candidate) { candidate.entity == owner.entity && candidate.field == field.index }) {
        Some(entry) => entry,
        None => fail!("scope references a field with no dimension declaration", owner.id, field.name),
    };
    if require_authorized && !d.authorized {
        fail!("scope references a dimension that is not authorized", d.id)
    } else if !d.filterable {
        fail!("scope references a dimension with no filter capability", d.id)
    } else if !array::any(d.ops, fn(op) { op == predicate.op }) {
        fail!("scope uses an operation not supported by the dimension", d.id, predicate.op)
    } else if array::length(d.values) > 0 && predicate.op != FilterOp::Eq {
        fail!("scope on enum dimension supports only Eq", d.id, predicate.op)
    } else if is_text_op(predicate.op) && match predicate.input { FilterInput::Text(_) => False, _ => True } {
        fail!("scope text operation requires a text input value", d.id)
    } else if array::length(d.canonical_values) == 0 && array::length(d.values) == 0
        && !filter_input_allowed(d.input_kinds, predicate.input) {
        fail!("scope uses an invalid value for the dimension", d.id, predicate.input)
    } else {
        let resolved = filter_value_with_context(ctx, payload, d, predicate.op, predicate.input);
        let item: FilterResolution = {expr: resolved.1, entity: d.entity, field: d.field, op: predicate.op, input: predicate.input};
        (resolved.0, item)
    }
};

def resolve_request_filters_with_context: Fn(qb::BuildCtx, PreparedPayload, Array(DimensionEntry), Array(FilterRequest)) -> (qb::BuildCtx, Array(FilterResolution)) = fn(ctx, payload, dimensions, requests) {
    let initial: (qb::BuildCtx, Array(FilterResolution)) = (ctx, []);
    let scoped = array::fold(dimensions, initial, fn(state, dimension) {
        array::fold(dimension.scope, state, fn(inner, predicate) {
            let resolved = resolve_scope_with_context(inner.0, payload, dimension, predicate, True);
            (resolved.0, array::push(inner.1, resolved.1))
        })
    });
    let requested = resolve_filters_with_context(scoped.0, payload, requests);
    (requested.0, array::concat([scoped.1, requested.1]))
};

def entity_source_at_with_context: Fn(qb::BuildCtx, PreparedPayload, EntityEntry, String) -> (qb::BuildCtx, qb::Source) = fn(ctx, payload, entity, hint) {
    let allocated = qb::source_with_hint(ctx, entity.table, hint);
    let original_alias = get_index(payload.entities, entity.index).alias;
    let scopes: (qb::BuildCtx, Array(qb::Expr)) = array::fold(entity.scope, (allocated.0, []), fn(state, predicate) {
        let field = match array::find(entity.fields, fn(f) { f.index == predicate.field }) {
            Some(f) => f,
            None => fail!("entity scope references an unknown field", entity.id, predicate.field),
        };
        let dimension = match array::find(payload.dimensions, fn(d) { d.entity == entity.index && d.field == field.index }) {
            Some(d) => d,
            None => fail!("entity scope requires a declared dimension", entity.id, predicate.field, field.name, field.index),
        };
        let resolved = resolve_scope_with_context(state.0, payload, dimension, predicate, False);
        (resolved.0, array::push(state.1, retarget_inner_expr(resolved.1.expr, original_alias, allocated.1.alias)))
    });
    let source = match combine_filters(scopes.1) {
        Some(expr) => {...allocated.1, scope: Some(expr)},
        None => allocated.1,
    };
    (scopes.0, source)
};

# Two constraints on the same entity+field contradict each other only when both
# are equality constraints with different literal values.
def eq_conflict: Fn(FilterResolution, FilterResolution) -> Bool = fn(a, b) {
    a.entity == b.entity && a.field == b.field && a.op == FilterOp::Eq && b.op == FilterOp::Eq && a.input != b.input
};

def find_internal_conflict: Fn(Array(FilterResolution)) -> Option(FilterResolution) = fn(list) {
    let n = array::length(list);
    let init: Option(FilterResolution) = None;
    array::fold(int_range(n), init, fn(acc, i) {
        match acc {
            Some(_) => acc,
            None => do {
                let a = get_index(list, i);
                let inner_init: Option(FilterResolution) = None;
                array::fold(int_range(n), inner_init, fn(inner_acc, j) {
                    match inner_acc {
                        Some(_) => inner_acc,
                        None => if j > i {
                            let b = get_index(list, j);
                            if eq_conflict(a, b) { Some(b) } else { None }
                        } else {
                            None
                        },
                    }
                })
            },
        }
    })
};

def find_cross_conflict: Fn(Array(FilterResolution), Array(FilterResolution)) -> Option(FilterResolution) = fn(scopes, users) {
    let init: Option(FilterResolution) = None;
    array::fold(scopes, init, fn(acc, s) {
        match acc {
            Some(_) => acc,
            None => do {
                let found: Option(FilterResolution) = array::fold(users, None, fn(inner_acc, u) {
                    match inner_acc {
                        Some(_) => inner_acc,
                        None => if eq_conflict(s, u) { Some(u) } else { None },
                    }
                });
                found
            },
        }
    })
};

def scope_conflict: Fn(Array(FilterResolution), Array(FilterResolution)) -> Option(FilterResolution) = fn(scopes, users) {
    match find_internal_conflict(scopes) {
        Some(c) => Some(c),
        None => find_cross_conflict(scopes, users),
    }
};

# Merge member scopes (in request order, then declaration order) with user
# filters (in request order) into one deterministic left-assoc And expression.
# Mutually contradictory scope/filter constraints fail atomically.
def combined_filter: Fn(Array(FilterResolution), Array(FilterResolution)) -> Option(qb::Expr) = fn(scopes, users) {
    let conflict = scope_conflict(scopes, users);
    let exprs = array::concat([array::map(scopes, fn(s) { s.expr }), array::map(users, fn(u) { u.expr })]);
    let filtered = match conflict {
        Some(c) => fail!("conflicting scope/filter constraints", c.entity, c.field, c.input),
        None => exprs,
    };
    combine_filters(filtered)
};

# Resolve a filtered measure's inherent predicate to a parameterized expression.
# The predicate must reference a declared, authorized, filterable dimension of
# the measure's own entity; enum value, operation, input kind and scope rules
# are reused. The predicate only scopes that measure's rows (FILTER), never the
# global fact set.

def resolve_measure_predicate_with_context: Fn(qb::BuildCtx, PreparedPayload, MeasureEntry) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry) {
    match entry.predicate {
        None => fail!("measure has no inherent predicate", entry.id),
        Some(pred) => do {
            let entity = get_index(payload.entities, entry.entity);
            let field = match array::get(entity.fields, pred.field) {
                Some(value) => value,
                None => fail!("measure predicate references an unknown field", entry.id, pred.field),
            };
            let dimension = match array::find(payload.dimensions, fn(d) { d.entity == entry.entity && d.field == field.index }) {
                Some(value) => value,
                None => fail!("measure predicate references a field with no dimension declaration", entry.id, field.name),
            };
            if !dimension.authorized {
                fail!("measure predicate references a dimension that is not authorized", dimension.id)
            } else if !dimension.filterable {
                fail!("measure predicate references a dimension with no filter capability", dimension.id)
            } else if !array::any(dimension.ops, fn(op) { op == pred.op }) {
                fail!("measure predicate uses an operation not supported by the dimension", dimension.id, pred.op)
            } else {
                filter_value_with_context(ctx, payload, dimension, pred.op, pred.input)
            }
        },
    }
};


def ordering_dimension_with_context: Fn(qb::BuildCtx, PreparedPayload, String, OrderDirection) -> (qb::BuildCtx, qb::OrderBy, Int) = fn(ctx, payload, id, direction) {
    let entry = match array::find(payload.dimensions, fn(d) { d.id == id }) {
        Some(value) => value,
        None => fail!("ordering references an unknown dimension", id),
    };
    if !entry.authorized { fail!("dimension is not authorized", id) }
    else {
        let expr = dimension_output_with_context(ctx, payload, entry);
        let order = match direction {
            OrderDirection::Asc => qb::asc(expr.1),
            OrderDirection::Desc => qb::desc(expr.1),
        };
        (expr.0, order, entry.entity)
    }
};

def resolve_ordering_with_context: Fn(qb::BuildCtx, PreparedPayload, Array(OrderRequest), Array(String), Array(String)) -> (qb::BuildCtx, Array(qb::OrderBy)) = fn(ctx, payload, requests, requested_measures, requested_dimensions) {
    let initial: (qb::BuildCtx, Array(qb::OrderBy)) = (ctx, []);
    array::fold(requests, initial, fn(state, req) {
        match req.target {
            OrderTarget::Measure(id) => if !array::any(requested_measures, fn(m) { m == id }) {
                fail!("ordering target is not a requested measure", id)
            } else {
                let entry = match array::find(payload.measures, fn(m) { m.id == id }) {
                    Some(value) => value,
                    None => fail!("ordering references an unknown measure", id),
                };
                let order = match req.direction {
                    OrderDirection::Asc => qb::asc_aggregate(entry.alias),
                    OrderDirection::Desc => qb::desc_aggregate(entry.alias),
                };
                (state.0, array::push(state.1, order))
            },
            OrderTarget::Dimension(id) => if !array::any(requested_dimensions, fn(d) { d == id }) {
                fail!("ordering target is not a requested dimension", id)
            } else {
                let resolved = ordering_dimension_with_context(state.0, payload, id, req.direction);
                (resolved.0, array::push(state.1, resolved.1))
            },
        }
    })
};

# Row-level (measureless) ordering: projection and ordering are two different
# constraints.  A measureless list request may order by ANY authorized dimension
# of the base grain even when that dimension is not projected (the ordering only
# adds an ORDER BY expression; if the dimension lives on another entity the plan
# additionally joins that entity through a grain-safe path).  Returns the ORDER
# BY keys and the extra entity indexes the plan must join.  A measure ordering
# target, an unknown dimension or an unauthorized dimension fails atomically.

def resolve_row_ordering_with_context: Fn(qb::BuildCtx, PreparedPayload, Array(OrderRequest)) -> (qb::BuildCtx, Array(qb::OrderBy), Array(Int)) = fn(ctx, payload, requests) {
    let initial: (qb::BuildCtx, Array(qb::OrderBy), Array(Int)) = (ctx, [], []);
    array::fold(requests, initial, fn(state, req) {
        match req.target {
            OrderTarget::Measure(id) => fail!("row-level ordering target must be a dimension, not a measure", id),
            OrderTarget::Dimension(id) => do {
                let resolved = ordering_dimension_with_context(state.0, payload, id, req.direction);
                let extra = if array::any(state.2, fn(e) { e == resolved.2 }) { state.2 }
                    else { array::push(state.2, resolved.2) };
                (resolved.0, array::push(state.1, resolved.1), extra)
            },
        }
    })
};

def resolve_grouped_dim_orders_with_context: Fn(qb::BuildCtx, PreparedPayload, QueryRequest) -> (qb::BuildCtx, Array(qb::OrderBy)) = fn(ctx, payload, request) {
    let initial: (qb::BuildCtx, Array(qb::OrderBy)) = (ctx, []);
    array::fold(request.ordering, initial, fn(state, req) {
        match req.target {
            OrderTarget::Measure(_) => fail!("grouped dimension order targets must be requested dimensions (internal measures are passed separately)"),
            OrderTarget::Dimension(id) => if !array::any(request.dimensions, fn(d) { d.id == id }) {
                fail!("grouped dimension ordering target must be requested", id)
            } else {
                let resolved = ordering_dimension_with_context(state.0, payload, id, req.direction);
                (resolved.0, array::push(state.1, resolved.1))
            },
        }
    })
};

# A grouped dimension listing orders by its REQUESTED dimensions only (they are
# the grouping expressions); a measure ordering target must be supplied through
# the separate internal-aggregate list.  Each dimension ordering target must be
# selected (projected/grouped) so the ORDER BY stays on a grouping expression.

# Internal (non-projected) ordering aggregate: an authorized declared measure on
# the request's base entity whose aggregate value only orders the groups (and a
# Top-N limit) and is never projected.  Computed measures (whose dependencies
# must be projected) are rejected in this v1 shape; filtered measures keep their
# inherent predicate as the aggregate's FILTER.

def internal_aggregate_order_with_context: Fn(qb::BuildCtx, PreparedPayload, Int, InternalOrderRequest) -> (qb::BuildCtx, qb::OrderBy) = fn(ctx, payload, base_entity, spec) {
    if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for internal ordering measure", spec.subject, spec.measure)
    } else {
        let entry = match array::find(payload.measures, fn(m) { m.id == spec.measure }) {
            Some(value) => value,
            None => fail!("internal ordering references an unknown measure", spec.measure),
        };
        if entry.computed != None {
            fail!("internal ordering measure must be a plain or filtered measure", spec.measure)
        } else if entry.entity != base_entity {
            fail!("internal ordering measure must aggregate rows of the request base entity", spec.measure)
        } else {
            let entity = get_index(payload.entities, entry.entity);
            let field = get_index(entity.fields, entry.field);
            let filter = match entry.predicate {
                Some(_) => do {
                    let resolved = resolve_measure_predicate_with_context(ctx, payload, entry);
                    (resolved.0, Some(resolved.1))
                },
                None => (ctx, None),
            };
            let call: qb::AggregateCall = {
                function: entry.aggregate,
                arg: qb::column(entity.source, field.column),
                distinct: entry.input == MeasureInput::Distinct,
                filter: filter.1,
                alias: entry.alias,
            };
            let key: qb::OrderKey = qb::OrderKey::Aggregate(call);
            (filter.0, qb::order_by(key, to_qb_ordering(spec.direction)))
        }
    }
};

def check_limit: Fn(Option(Int)) -> Option(Int) = fn(limit) {
    match limit {
        None => None,
        Some(n) => if n > 0 { Some(n) } else { fail!("limit must be a positive integer", n) },
    }
};

# Offset must be non-negative and, when present, requires a stable deterministic
# ordering so pages repeat deterministically.
def check_offset: Fn(Option(Int), Int) -> Option(Int) = fn(offset, ordering_len) {
    match offset {
        None => None,
        Some(n) => if n < 0 {
            fail!("offset must be a non-negative integer", n)
        } else if ordering_len == 0 {
            fail!("offset requires a stable, deterministic ordering", n)
        } else {
            Some(n)
        }
    }
};

# Validate and lower a Top Per Group request. Partition dimensions must be
# selected, authorized and grain-compatible; the ordering must be stable (it
# must cover every non-partition selected dimension); global limit/offset are
# not combined. PartitionRequest construction already checks by/take locally.
# The resolved ordering is reused as the partition-internal ordering.
def check_partition: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(ResolvedDimension), Array(qb::OrderBy)) -> (qb::BuildCtx, Option(qb::PartitionedTopN)) = fn(ctx, payload, request, dimensions, ordering) {
    match request.partition {
        None => (ctx, None),
        Some(part) => do {
            let requested_dimension_ids = array::map(request.dimensions, fn(d) { d.id });
            if request.limit != None || request.offset != None {
                fail!("top per group does not combine with a global limit or offset", request.limit, request.offset, part)
            } else if array::length(request.ordering) == 0 {
                fail!("top per group requires a stable, deterministic ordering", request.ordering, part)
            } else {
                let partition_dims = array::map(part.by, fn(id) {
                    if !array::any(requested_dimension_ids, fn(d) { d == id }) {
                        fail!("partition dimension is not selected in this request", id)
                    } else {
                        match array::find(payload.dimensions, fn(d) { d.id == id }) {
                            Some(d) => if !d.authorized {
                                fail!("partition dimension is not authorized", id)
                            } else {
                                d
                            },
                            None => fail!("partition references an unknown dimension", id),
                        }
                    }
                });
                let non_partition_dims = array::filter(dimensions, fn(d) {
                    !array::any(part.by, fn(id) { id == d.entry.id })
                });
                let stable_ok = array::all(non_partition_dims, fn(d) {
                    array::any(request.ordering, fn(o) {
                        match o.target {
                            OrderTarget::Dimension(id) => id == d.entry.id,
                            OrderTarget::Measure(_) => False,
                        }
                    })
                });
                if !stable_ok {
                    fail!("partition ordering is not stable: it must cover every non-partition dimension")
                } else {
                    let partition_exprs = array::fold(partition_dims, (ctx, []), fn(state, d) {
                        let next = dimension_expr(state.0, payload, d);
                        (next.0, array::push(state.1, next.1))
                    });
                    let take = qb::take_bound(partition_exprs.0, part.take);
                    (take.0, Some(qb::partitioned_top_n_bound(partition_exprs.1, ordering, take.1)))
                }
            }
        },
    }
};

def merge_edges: Fn(Array(Int), Array(Int)) -> Array(Int) = fn(acc, seq) {
    array::fold(seq, acc, fn(edges, r) {
        if array::any(edges, fn(e) { e == r }) {
            edges
        } else {
            array::push(edges, r)
        }
    })
};

# One relation column pair becomes an equality ON atom over the two entities'
# canonical field columns (aliases come from the entity source declarations).
def pair_to_condition: Fn(PreparedPayload, Int, Int, RelationPair) -> qb::JoinCondition = fn(payload, from_entity, to_entity, pair) {
    let from_entry = get_index(payload.entities, from_entity);
    let to_entry = get_index(payload.entities, to_entity);
    let from_field = get_index(from_entry.fields, pair.from);
    let to_field = get_index(to_entry.fields, pair.to);
    qb::on_eq(qb::column_ref(from_entry.source, from_field.column), qb::column_ref(to_entry.source, to_field.column))
};

# A relation key lowers to the query public JoinCondition tree. `RelationKey.And`/`RelationKey.Or`
# nodes map to `on_and`/`on_or`; every column reference resolves to a visible
# source/join alias, so the result is a closed structured ON predicate.
def key_to_condition: Fn(PreparedPayload, Int, Int, RelationKey) -> qb::JoinCondition = fn(payload, from_entity, to_entity, key) {
    match key {
        RelationKey::Eq(pair) => pair_to_condition(payload, from_entity, to_entity, pair),
        RelationKey::FieldEq(_) => fail!("unresolved relation field key"),
        RelationKey::And(keys) => qb::on_and(array::map(keys, fn(k) { key_to_condition(payload, from_entity, to_entity, k) })),
        RelationKey::Or(keys) => qb::on_or(array::map(keys, fn(k) { key_to_condition(payload, from_entity, to_entity, k) })),
    }
};

# The relation key is prepared once, but graph instances can use the same
# entity more than once; always qualify key columns with allocated sources.
def graph_key_condition: Fn(PreparedPayload, RelationEntry, qb::Source, qb::Source, RelationKey) -> qb::JoinCondition = fn(payload, relation, from_source, to_source, key) {
    match key {
        RelationKey::Eq(pair) => do {
            let from_field = get_index(get_index(payload.entities, relation.from).fields, pair.from);
            let to_field = get_index(get_index(payload.entities, relation.to).fields, pair.to);
            qb::on_eq(qb::column_ref(from_source, from_field.column), qb::column_ref(to_source, to_field.column))
        },
        RelationKey::FieldEq(_) => fail!("unresolved graph relation key", relation.id),
        RelationKey::And(parts) => qb::on_and(array::map(parts, fn(part) { graph_key_condition(payload, relation, from_source, to_source, part) })),
        RelationKey::Or(parts) => qb::on_or(array::map(parts, fn(part) { graph_key_condition(payload, relation, from_source, to_source, part) })),
    }
};

def graph_link_joins: Fn(qb::BuildCtx, PreparedPayload, BusinessLinkEntry, qb::Source, String) -> (qb::BuildCtx, qb::Source, Array(qb::Join)) = fn(ctx, payload, link, origin, target_hint) {
    let a = relation_domain(payload, link.a_relation);
    let z = relation_domain(payload, link.z_relation);
    let hub_entry = get_index(payload.entities, link.hub);
    let peer_entry = get_index(payload.entities, link.participant);
    let hub = entity_source_at_with_context(ctx, payload, hub_entry, `\{link.id}_link`);
    let peer = entity_source_at_with_context(hub.0, payload, peer_entry, target_hint);
    let origin_a = graph_key_condition(payload, a, hub.1, origin, a.key);
    let origin_z = graph_key_condition(payload, z, hub.1, origin, z.key);
    let peer_a = graph_key_condition(payload, a, hub.1, peer.1, a.key);
    let peer_z = graph_key_condition(payload, z, hub.1, peer.1, z.key);
    let symmetric = link.direction == LinkDirection::Undirected;
    let hub_condition = if symmetric { qb::on_or([origin_a, origin_z]) } else { origin_a };
    let peer_condition = if symmetric {
        qb::on_or([qb::on_and([origin_a, peer_z]), qb::on_and([origin_z, peer_a])])
    } else { peer_z };
    (peer.0, peer.1, [qb::join_on(qb::JoinKind::Inner, hub.1, hub_condition),
        qb::join_on(qb::JoinKind::Inner, peer.1, peer_condition)])
};

type GraphInstance = struct { id: String, entity: Int, source: qb::Source };

def graph_node: Fn(GraphRequest, String) -> GraphNode = fn(request, id) {
    match array::find(request.nodes, fn(node) { node.id == id }) {
        Some(node) => node,
        None => fail!("graph edge references an unknown node", id),
    }
};

def graph_instance: Fn(Array(GraphInstance), String) -> GraphInstance = fn(instances, id) {
    match array::find(instances, fn(instance) { instance.id == id }) {
        Some(instance) => instance,
        None => fail!("graph node is not connected to the root", id),
    }
};

def graph_filters: Fn(qb::BuildCtx, PreparedPayload, Array(GraphInstance), Array(GraphFilter)) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, payload, instances, filters) {
    let built = array::fold(filters, (ctx, []), fn(state, spec) {
        let instance = graph_instance(instances, spec.node);
        let dimension = match array::find(payload.dimensions, fn(d) { d.id == spec.request.id }) {
            Some(d) => d,
            None => fail!("graph filter references an unknown dimension", spec.node, spec.request.id),
        };
        if dimension.entity != instance.entity {
            fail!("graph filter dimension does not belong to its named node", spec.node, spec.request.id)
        } else {
            let resolved = resolve_request_filters_with_context(state.0, payload, [dimension], [spec.request]);
            let original = get_index(payload.entities, instance.entity).alias;
            let expressions = array::map(resolved.1, fn(item) {
                retarget_inner_expr(item.expr, original, instance.source.alias)
            });
            (resolved.0, array::concat([state.1, expressions]))
        }
    });
    (built.0, append_filter_terms(None, built.1))
};

def graph_nullable_source: Fn(qb::BuildCtx, PreparedPayload, EntityEntry, GraphNode, Array(GraphFilter)) -> (qb::BuildCtx, qb::Source) = fn(ctx, payload, entity, node, filters) {
    let allocated = entity_source_at_with_context(ctx, payload, entity, node.id);
    let instance: GraphInstance = {id: node.id, entity: entity.index, source: allocated.1};
    let selected = array::filter(filters, fn(item) { item.node == node.id });
    let filtered = graph_filters(allocated.0, payload, [instance], selected);
    let combined = match filtered.1 {
        Some(expr) => append_filter_terms(allocated.1.scope, [expr]),
        None => allocated.1.scope,
    };
    (filtered.0, {...allocated.1, scope: combined})
};

# EXISTS correlations require equality pairs, with the outer/hop source on the
# left regardless of the declaration's physical from/to orientation.
def graph_correlation_pairs: Fn(PreparedPayload, RelationEntry, qb::Source, qb::Source, Bool, RelationKey) -> Array(qb::ColumnEq) = fn(payload, relation, outer, inner, forward, key) {
    match key {
        RelationKey::Eq(pair) => do {
            let from_field = get_index(get_index(payload.entities, relation.from).fields, pair.from);
            let to_field = get_index(get_index(payload.entities, relation.to).fields, pair.to);
            if forward {
                [qb::column_eq(qb::column_ref(outer, from_field.column), qb::column_ref(inner, to_field.column))]
            } else {
                [qb::column_eq(qb::column_ref(outer, to_field.column), qb::column_ref(inner, from_field.column))]
            }
        },
        RelationKey::And(parts) => array::concat(array::map(parts, fn(part) {
            graph_correlation_pairs(payload, relation, outer, inner, forward, part)
        })),
        RelationKey::Or(_) => fail!("unsupported graph existence key with alternative matches", relation.id),
        RelationKey::FieldEq(_) => fail!("unresolved graph existence key", relation.id),
    }
};

# Distribute declared AND/OR keys into closed correlation branches; each
# branch retains every equality declared for that alternative.
def graph_correlation_alternatives: Fn(PreparedPayload, RelationEntry, qb::Source, qb::Source, Bool, RelationKey) -> Array(Array(qb::ColumnEq)) = fn(payload, relation, outer, inner, forward, key) {
    match key {
        RelationKey::Eq(_) => [graph_correlation_pairs(payload, relation, outer, inner, forward, key)],
        RelationKey::And(parts) => array::fold(parts, [[]], fn(branches, part) {
            let next = graph_correlation_alternatives(payload, relation, outer, inner, forward, part);
            array::concat(array::map(branches, fn(branch) {
                array::map(next, fn(other) { array::concat([branch, other]) })
            }))
        }),
        RelationKey::Or(parts) => array::concat(array::map(parts, fn(part) {
            graph_correlation_alternatives(payload, relation, outer, inner, forward, part)
        })),
        RelationKey::FieldEq(_) => fail!("unresolved graph existence key", relation.id),
    }
};

def graph_link_existence: Fn(qb::BuildCtx, PreparedPayload, GraphInstance, GraphExist, BusinessLinkEntry) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, anchor, spec, link) {
    if array::length(spec.edges) == 0 { fail!("business link existence requires an edge", link.id) }
    else {
        let edge = get_index(spec.edges, 0);
        let from_anchor = edge.from == anchor.id;
        let next_id = if from_anchor { edge.to } else { edge.from };
        if !from_anchor && edge.to != anchor.id {
            fail!("graph existence edge must introduce one node connected to the root", link.id)
        } else if !from_anchor && link.direction == LinkDirection::Directed {
            fail!("directed business link cannot be traversed from Z to A", link.id)
        } else {
            let node = match array::find(spec.nodes, fn(item) { item.id == next_id }) {
                Some(item) => item,
                None => fail!("graph business link references an unknown peer node", next_id),
            };
            if node.id != next_id || anchor.entity != link.participant || entity_by_id(payload, node.entity) != link.participant {
                fail!("graph business link endpoints must both be its declared participant", link.id)
            } else {
                let hub_entry = get_index(payload.entities, link.hub);
                let peer_entry = get_index(payload.entities, link.participant);
                let hub = entity_source_at_with_context(ctx, payload, hub_entry, `\{link.id}_link`);
                let peer = entity_source_at_with_context(hub.0, payload, peer_entry, next_id);
                let a = relation_domain(payload, link.a_relation);
                let z = relation_domain(payload, link.z_relation);
                let origin_a = graph_correlation_pairs(payload, a, anchor.source, hub.1, False, a.key);
                let origin_z = graph_correlation_pairs(payload, z, anchor.source, hub.1, False, z.key);
                let symmetric = link.direction == LinkDirection::Undirected;
                let correlation = if symmetric { [origin_a, origin_z] } else { [origin_a] };
                let peer_a = graph_key_condition(payload, a, hub.1, peer.1, a.key);
                let peer_z = graph_key_condition(payload, z, hub.1, peer.1, z.key);
                let branch_a = qb::on_and(array::concat([array::map(origin_a, fn(p) { qb::on_eq(p.left, p.right) }), [peer_z]]));
                let branch_z = qb::on_and(array::concat([array::map(origin_z, fn(p) { qb::on_eq(p.left, p.right) }), [peer_a]]));
                let condition = if symmetric { qb::on_or([branch_a, branch_z]) } else { peer_z };
                let join = qb::join_on(qb::JoinKind::Inner, peer.1, condition);
                let instances: Array(GraphInstance) = [anchor, {id: node.id, entity: link.participant, source: peer.1}];
                let tail = array::filter(array::enumerate(spec.edges), fn(indexed) { indexed.0 > 0 });
                let built = array::fold(tail, (peer.0, instances, [join]), fn(state, indexed) {
                    let next_edge = indexed.1;
                    let forward = array::any(state.1, fn(item) { item.id == next_edge.from });
                    let backward = array::any(state.1, fn(item) { item.id == next_edge.to });
                    if forward == backward {
                        fail!("graph existence edge must introduce one node connected to the root", next_edge.relation)
                    } else {
                        let previous = graph_instance(state.1, if forward { next_edge.from } else { next_edge.to });
                        let new_id = if forward { next_edge.to } else { next_edge.from };
                        let new_node = match array::find(spec.nodes, fn(item) { item.id == new_id }) {
                            Some(item) => item,
                            None => fail!("graph existence edge references an unknown inner node", next_edge.relation, new_id),
                        };
                        let new_entity = entity_by_id(payload, new_node.entity);
                        match array::find(payload.business_links, fn(entry) { entry.id == next_edge.relation }) {
                            Some(next_link) => do {
                                if previous.entity != next_link.participant || new_entity != next_link.participant {
                                    fail!("graph business link endpoints must both be its declared participant", next_edge.relation)
                                } else if !forward && next_link.direction == LinkDirection::Directed {
                                    fail!("directed business link cannot be traversed from Z to A", next_edge.relation)
                                } else {
                                    let joined = graph_link_joins(state.0, payload, next_link, previous.source, new_id);
                                    let instance: GraphInstance = {id: new_id, entity: new_entity, source: joined.1};
                                    (joined.0, array::push(state.1, instance), array::concat([state.2, joined.2]))
                                }
                            },
                            None => do {
                                let relation = relation_domain(payload, next_edge.relation);
                                if (forward && (relation.from != previous.entity || relation.to != new_entity))
                                    || (!forward && (relation.to != previous.entity || relation.from != new_entity)) {
                                    let expected_from = payload.entities[relation.from].id;
                                    let expected_to = payload.entities[relation.to].id;
                                    let actual_from = if forward { payload.entities[previous.entity].id } else { new_node.entity };
                                    let actual_to = if forward { new_node.entity } else { payload.entities[previous.entity].id };
                                    fail!(`graph existence edge role or target does not match declared relation: \{next_edge.relation} expects from \{expected_from} to \{expected_to}, but \{next_edge.from} is \{actual_from} and \{next_edge.to} is \{actual_to}; correct the node entity or choose a relation declared for these roles`, next_edge)
                                } else {
                                    let source = entity_source_at_with_context(state.0, payload, get_index(payload.entities, new_entity), new_id);
                                    let condition = graph_key_condition(payload, relation,
                                        if forward { previous.source } else { source.1 },
                                        if forward { source.1 } else { previous.source }, relation.key);
                                    let next_join = qb::join_on(qb::JoinKind::Inner, source.1, condition);
                                    let instance: GraphInstance = {id: new_id, entity: new_entity, source: source.1};
                                    (source.0, array::push(state.1, instance), array::push(state.2, next_join))
                                }
                            },
                        }
                    }
                });
                let filtered = graph_filters(built.0, payload, built.1, spec.filters);
                let exists = qb::exists_path_alternatives(hub.1, correlation, built.2);
                let exists = {...exists, filter: filtered.1};
                (filtered.0, if spec.negated { qb::exists_not(exists) } else { exists })
            }
        }
    }
};

def graph_existence: Fn(qb::BuildCtx, PreparedPayload, Array(GraphInstance), GraphExist) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, instances, spec) {
    let anchor = graph_instance(instances, spec.anchor);
    let count = array::length(spec.edges);
    if count == 0 || count != array::length(spec.nodes) {
        fail!("graph existence needs one declared node per edge", spec.anchor)
    } else if array::any(spec.nodes, fn(node) {
        node.id == "" || array::any(instances, fn(existing) { existing.id == node.id })
            || array::length(array::filter(spec.nodes, fn(other) { other.id == node.id })) != 1
    }) { fail!("graph existence node ids must be distinct from outer graph instances") }
    else {
        match array::find(payload.business_links, fn(link) {
            get_index(spec.edges, 0).relation == link.id
        }) {
            Some(link) => graph_link_existence(ctx, payload, anchor, spec, link),
            None => do {
        let initial: (qb::BuildCtx, Array(GraphInstance), Array(Array(qb::ColumnEq)), Array(qb::Join)) = (ctx, [anchor], [], []);
        let built = array::fold(spec.edges, initial, fn(state, edge) {
            let forward = array::any(state.1, fn(item) { item.id == edge.from });
            let backward = array::any(state.1, fn(item) { item.id == edge.to });
            let next_id = if forward { edge.to } else { edge.from };
            let previous_id = if forward { edge.from } else { edge.to };
            if forward == backward {
                fail!("graph existence edge must introduce one node connected to the root", edge.relation)
            } else {
                let previous = graph_instance(state.1, previous_id);
                let next_node = match array::find(spec.nodes, fn(node) { node.id == next_id }) {
                    Some(node) => node,
                    None => fail!("graph existence edge references an unknown inner node", edge.relation, next_id),
                };
                let next_entity = entity_by_id(payload, next_node.entity);
                match array::find(payload.business_links, fn(link) { link.id == edge.relation }) {
                    Some(link) => do {
                        if previous.entity != link.participant || next_entity != link.participant {
                            fail!("graph business link endpoints must both be its declared participant", edge.relation)
                        } else if !forward && link.direction == LinkDirection::Directed {
                            fail!("directed business link cannot be traversed from Z to A", edge.relation)
                        } else {
                            let joined = graph_link_joins(state.0, payload, link, previous.source, next_id);
                            let instance: GraphInstance = {id: next_id, entity: next_entity, source: joined.1};
                            (joined.0, array::push(state.1, instance), state.2, array::concat([state.3, joined.2]))
                        }
                    },
                    None => do {
                        let relation = relation_domain(payload, edge.relation);
                        let valid = if forward {
                            relation.from == previous.entity && relation.to == next_entity
                        } else { relation.to == previous.entity && relation.from == next_entity };
                        if !valid {
                            let expected_from = payload.entities[relation.from].id;
                            let expected_to = payload.entities[relation.to].id;
                            let actual_from = if forward { payload.entities[previous.entity].id } else { next_node.entity };
                            let actual_to = if forward { next_node.entity } else { payload.entities[previous.entity].id };
                            fail!(`graph existence edge role or target does not match declared relation: \{edge.relation} expects from \{expected_from} to \{expected_to}, but \{edge.from} is \{actual_from} and \{edge.to} is \{actual_to}; correct the node entity or choose a relation declared for these roles`, edge)
                        }
                        else {
                            let source = entity_source_at_with_context(state.0, payload, get_index(payload.entities, next_entity), next_id);
                            let first_edge = array::length(state.2) == 0;
                            let alternatives = if first_edge {
                                graph_correlation_alternatives(payload, relation, previous.source, source.1, forward, relation.key)
                            } else { state.2 };
                            let instance: GraphInstance = {id: next_id, entity: next_entity, source: source.1};
                            let join = if first_edge { [] } else {
                                [qb::join_on(qb::JoinKind::Inner, source.1,
                                    graph_key_condition(payload, relation,
                                        if forward { previous.source } else { source.1 },
                                        if forward { source.1 } else { previous.source }, relation.key))]
                            };
                            (source.0, array::push(state.1, instance), alternatives, array::concat([state.3, join]))
                        }
                    },
                }
            }
        });
        let first = get_index(built.1, 1).source;
        let filtered = graph_filters(built.0, payload, built.1, spec.filters);
        let exists = if array::length(built.2) == 1 {
            qb::exists_path(first, get_index(built.2, 0), built.3)
        } else { qb::exists_path_alternatives(first, built.2, built.3) };
        let exists = {...exists, filter: filtered.1};
        (filtered.0, if spec.negated { qb::exists_not(exists) } else { exists })
            },
        }
    }
};

# Counting a subject is safe only if every joined instance is functionally
# determined by it. Walk the declared tree from the subject, independently of
# the root-first order used to construct the SQL joins.
def graph_count_subject_grain: Fn(PreparedPayload, GraphRequest, String) -> (Bool, Option(GraphEdge)) = fn(payload, request, subject_id) {
    let initial: (Array(String), Option(GraphEdge)) = ([subject_id], None);
    let proved = array::fold(request.nodes, initial, fn(state, node) {
        array::fold(request.edges, state, fn(step, edge) {
            let from_known = array::any(step.0, fn(id) { id == edge.from });
            let to_known = array::any(step.0, fn(id) { id == edge.to });
            if from_known == to_known { step }
            else {
                let safe = match array::find(payload.business_links, fn(link) { link.id == edge.relation }) {
                    Some(_) => False,
                    None => do {
                        let relation = relation_domain(payload, edge.relation);
                        (from_known && relation.kind == RelationKind::Safe)
                            || (to_known && relation.kind == RelationKind::FanOut
                                && relation_covers_source_identity(get_index(payload.entities, relation.from), relation.key))
                    },
                };
                (array::push(step.0, if from_known { edge.to } else { edge.from }),
                    if safe { step.1 } else { match step.1 { Some(_) => step.1, None => Some(edge) } })
            }
        })
    });
    (proved.1 == None && array::length(proved.0) == array::length(request.nodes), proved.1)
};

# The join tree is rooted by construction. Only an ancestor of the counted
# instance can narrow its LEFT JOIN lineage without filtering an unrelated branch.
def graph_count_ancestors: Fn(GraphRequest, String) -> Array(String) = fn(request, subject_id) {
    let root_path: (String, Array(String)) = (request.root, [request.root]);
    let paths = array::fold(request.edges, [root_path], fn(known, edge) {
        let from = array::find(known, fn(path) { path.0 == edge.from });
        let to = array::find(known, fn(path) { path.0 == edge.to });
        match (from, to) {
            (Some(parent), None) => array::push(known, (edge.to, array::push(parent.1, edge.to))),
            (None, Some(parent)) => array::push(known, (edge.from, array::push(parent.1, edge.from))),
            _ => known,
        }
    });
    match array::find(paths, fn(path) { path.0 == subject_id }) {
        Some(path) => path.1,
        None => [],
    }
};

def graph_count_identity_column: Fn(EntityEntry, String) -> String = fn(entity, subject_id) {
    if entity.key_field >= 0 { get_index(entity.fields, entity.key_field).column }
    else match entity.dataset {
        Some(dataset) => do {
            let first = get_index(dataset.grain, 0);
            match array::find(entity.fields, fn(field) { field.name == first }) {
                Some(field) => field.column,
                None => fail!("graph count dataset grain field has no physical column", subject_id, first),
            }
        },
        None => fail!("graph count subject requires a declared key or dataset grain", subject_id),
    }
};

# Each edge adds exactly one new instance. This makes a rooted graph explicit
# without choosing a shortest path or silently multiplying a join already used.
def lower_graph: Fn(qb::BuildCtx, PreparedPayload, String, GraphRequest) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, subject, request) {
    if !payload.authorize(subject) { fail!("subject is not authorized for graph query", subject) }
    else if array::length(request.nodes) == 0 || (array::length(request.select) == 0 && request.count == None) {
        fail!("graph requires nodes and projections or an explicit count subject")
    } else if array::any(request.nodes, fn(node) {
        node.id == "" || array::length(array::filter(request.nodes, fn(other) { other.id == node.id })) != 1
    }) { fail!("graph node instance ids must be nonempty and unique") }
    else if let Some(unknown) = array::find(request.filters, fn(item) {
        !array::any(request.nodes, fn(node) { node.id == item.node })
    }) { fail!("graph filter references an unknown node", unknown.node) }
    else if request.include_empty && (request.count == None || request.count == Some(request.root)) {
        fail!("graph include_empty requires a non-root count subject")
    } else if request.include_empty && array::any(request.edges, fn(edge) {
        array::any(payload.business_links, fn(link) { link.id == edge.relation })
    }) {
        let edge = match array::find(request.edges, fn(item) {
            array::any(payload.business_links, fn(link) { link.id == item.relation })
        }) {
            Some(item) => item,
            None => fail!("graph business link edge lookup failed after membership check"),
        };
        let subject_id = match request.count { Some(id) => id, None => request.root };
        fail!(`unsupported graph include_empty: business link \{edge.relation} between \{edge.from} and \{edge.to} needs outer-join counting semantics for \{subject_id}; do not replace it with EXISTS when zero-match groups or peer counts matter`, edge, subject_id)
    }
    else {
        let root_node = graph_node(request, request.root);
        let root_entity = entity_by_id(payload, root_node.entity);
        let root = entity_source_at_with_context(ctx, payload, get_index(payload.entities, root_entity), root_node.id);
        let initial: (qb::BuildCtx, Array(GraphInstance), Array(qb::Join)) =
            (root.0, [{id: root_node.id, entity: root_entity, source: root.1}], []);
        let built = array::fold(request.edges, initial, fn(state, edge) {
            let from_node = graph_node(request, edge.from);
            let to_node = graph_node(request, edge.to);
            if edge.from == edge.to { fail!("graph edge must connect distinct instances", edge.relation) }
            else {
                let from_entity = entity_by_id(payload, from_node.entity);
                let to_entity = entity_by_id(payload, to_node.entity);
                match array::find(payload.business_links, fn(link) { link.id == edge.relation }) {
                    Some(link) => do {
                        if from_entity != link.participant || to_entity != link.participant {
                            fail!("graph business link endpoints must both be its declared participant", edge.relation)
                        } else if array::any(state.1, fn(item) { item.id == edge.from })
                            && !array::any(state.1, fn(item) { item.id == edge.to }) {
                            let origin = graph_instance(state.1, edge.from);
                            let joined = graph_link_joins(state.0, payload, link, origin.source, edge.to);
                            let instance: GraphInstance = {id: edge.to, entity: to_entity, source: joined.1};
                            (joined.0, array::push(state.1, instance), array::concat([state.2, joined.2]))
                        } else if link.direction == LinkDirection::Undirected
                            && array::any(state.1, fn(item) { item.id == edge.to })
                            && !array::any(state.1, fn(item) { item.id == edge.from }) {
                            let origin = graph_instance(state.1, edge.to);
                            let joined = graph_link_joins(state.0, payload, link, origin.source, edge.from);
                            let instance: GraphInstance = {id: edge.from, entity: from_entity, source: joined.1};
                            (joined.0, array::push(state.1, instance), array::concat([state.2, joined.2]))
                        } else if link.direction == LinkDirection::Directed
                            && array::any(state.1, fn(item) { item.id == edge.to }) {
                            fail!("directed business link cannot be traversed from Z to A", edge.relation)
                        } else { fail!("graph business link must introduce one connected participant", edge.relation) }
                    },
                    None => do {
                let relation = relation_domain(payload, edge.relation);
                if relation.from != from_entity || relation.to != to_entity {
                    let expected_from = payload.entities[relation.from].id;
                    let expected_to = payload.entities[relation.to].id;
                    fail!(`graph edge role or target does not match declared relation: \{edge.relation} expects from \{expected_from} to \{expected_to}, but \{edge.from} is \{from_node.entity} and \{edge.to} is \{to_node.entity}; correct the node entity or choose a relation declared for these roles`, edge)
                } else if array::any(state.1, fn(item) { item.id == edge.from })
                    && array::any(state.1, fn(item) { item.id == edge.to }) {
                    fail!("graph cycles and repeated instance edges are not supported", edge.relation, edge.to)
                } else if !array::any(state.1, fn(item) { item.id == edge.from })
                    && !array::any(state.1, fn(item) { item.id == edge.to }) {
                    fail!("graph edge has no endpoint connected to the root", edge.relation)
                } else {
                    let forward = array::any(state.1, fn(item) { item.id == edge.from });
                    let new_node = if forward { to_node } else { from_node };
                    let new_entity = if forward { to_entity } else { from_entity };
                    let target = if request.include_empty {
                        graph_nullable_source(state.0, payload, get_index(payload.entities, new_entity), new_node, request.filters)
                    } else {
                        entity_source_at_with_context(state.0, payload, get_index(payload.entities, new_entity), new_node.id)
                    };
                    let from_source = if forward { graph_instance(state.1, edge.from).source } else { target.1 };
                    let to_source = if forward { target.1 } else { graph_instance(state.1, edge.to).source };
                    let condition = graph_key_condition(payload, relation, from_source, to_source, relation.key);
                    let instance: GraphInstance = {id: new_node.id, entity: new_entity, source: target.1};
                    let instances = array::push(state.1, instance);
                    let narrowed = if request.include_empty {
                        array::fold(array::filter(request.exists, fn(spec) { spec.anchor == new_node.id }),
                            (target.0, condition), fn(current, spec) {
                                let result = graph_existence(current.0, payload, instances, spec);
                                (result.0, qb::on_and([current.1, qb::on_exists(result.1)]))
                            })
                    } else { (target.0, condition) };
                    let join = qb::join_on(if request.include_empty { qb::JoinKind::Left } else { qb::JoinKind::Inner }, target.1, narrowed.1);
                    (narrowed.0, instances, array::push(state.2, join))
                }
                    },
                }
            }
        });
        if array::length(built.1) != array::length(request.nodes) {
            fail!("graph contains nodes disconnected from the root")
        } else if let Some(unknown) = array::find(request.exists, fn(item) {
            !array::any(request.nodes, fn(node) { node.id == item.anchor })
        }) {
            fail!("graph existence anchor references an unknown node", unknown.anchor)
        } else if request.include_empty && array::any(request.exists, fn(item) {
            let counted = match request.count { Some(id) => id, None => request.root };
            !array::any(graph_count_ancestors(request, counted), fn(id) { id == item.anchor })
        }) {
            fail!("unsupported graph include_empty existence outside counted instance lineage")
        } else {
            let row_projection = array::map(request.select, fn(item) {
                let instance = graph_instance(built.1, item.node);
                let dimension = match array::find(payload.dimensions, fn(d) { d.id == item.dimension }) {
                    Some(d) => d,
                    None => fail!("graph projection references an unknown dimension", item.node, item.dimension),
                };
                if dimension.entity != instance.entity {
                    fail!("graph projection dimension does not belong to its named node", item.node, item.dimension)
                } else if !dimension.authorized {
                    fail!("graph projection dimension is not authorized", item.node, item.dimension)
                } else if dimension.computed {
                    fail!("unsupported graph computed dimension projection", item.node, item.dimension)
                } else if array::length(dimension.scope) > 0 {
                    fail!("unsupported graph scoped dimension projection", item.node, item.dimension)
                } else {
                    let field = get_index(get_index(payload.entities, instance.entity).fields, dimension.field);
                    qb::named_expr_item(qb::column(instance.source, field.column), `\{item.node}_\{item.dimension}`)
                }
            });
            let projection = match request.count {
                None => row_projection,
                Some(subject_id) => {
                    let grain = if subject_id == request.root {
                        (True, None)
                    } else { graph_count_subject_grain(payload, request, subject_id) };
                    let root_count_edge: Option(GraphEdge) = if subject_id == request.root {
                        array::fold(request.edges, ([request.root], None), fn(state, edge) {
                            let safe = match array::find(payload.business_links, fn(link) { link.id == edge.relation }) {
                                Some(_) => False,
                                None => relation_domain(payload, edge.relation).kind == RelationKind::Safe,
                            };
                            (array::push(state.0, edge.to),
                                if safe && array::any(state.0, fn(id) { id == edge.from }) { state.1 }
                                else { match state.1 { Some(_) => state.1, None => Some(edge) } })
                        }).1
                    } else { None };
                    if subject_id == request.root && root_count_edge != None {
                        match root_count_edge {
                            Some(edge) => fail!(`graph count requires grain-safe forward joins: relation \{edge.relation} between \{edge.from} and \{edge.to} may multiply \{subject_id}; use correlated EXISTS if it only filters roots, or count the related instance to count its rows`,
                                subject_id, edge.relation, edge.from, edge.to),
                            None => fail!("graph count requires grain-safe forward joins", subject_id),
                        }
                    } else if subject_id != request.root && !grain.0 {
                        match grain.1 {
                            Some(edge) => fail!(`graph cannot prove the non-root count subject has one row per root relationship: relation \{edge.relation} between \{edge.from} and \{edge.to} may multiply \{subject_id}; if this edge only filters rows, use correlated EXISTS, otherwise choose a count subject whose grain stays unique`,
                                subject_id, edge.relation, edge.from, edge.to),
                            None => fail!("unsupported graph count: cannot establish a connected functional path from the count subject", subject_id),
                        }
                    } else {
                        let instance = graph_instance(built.1, subject_id);
                        let entity = get_index(payload.entities, instance.entity);
                        let column = graph_count_identity_column(entity, subject_id);
                        array::concat([row_projection, [qb::aggregate(qb::AggregateFunction::Count,
                            qb::column(instance.source, column), False, `\{subject_id}_count`)]])
                    }
                },
            };
            let grouping = match request.count {
                None => [],
                Some(_) => array::map(row_projection, fn(item) {
                    match item {
                        qb::SelectItem::NamedExpr(named) => named.expr,
                        _ => fail!("graph grouping requires a plain dimension"),
                    }
                }),
            };
            let outer_filters = if request.include_empty {
                array::filter(request.filters, fn(item) { item.node == request.root })
            } else { request.filters };
            let filtered = graph_filters(built.0, payload, built.1, outer_filters);
            let outer_exists = if request.include_empty {
                array::filter(request.exists, fn(spec) { spec.anchor == request.root })
            } else { request.exists };
            let existential = array::fold(outer_exists, (filtered.0, []), fn(state, spec) {
                let result = graph_existence(state.0, payload, built.1, spec);
                (result.0, array::push(state.1, result.1))
            });
            let sources = array::concat([[root.1], array::map(built.2, fn(join) { join.source })]);
            let plan: qb::Plan = {
                revision: payload.revision, sources, derived: None, projection, filter: filtered.1,
                exists: existential.1, joins: built.2, grouping, having: [], ordering: [],
                limit: None, offset: None, partition: None, scalar_comparisons: [], ranked_key_comparisons: [],
            };
            (existential.0, qb::validate(plan, payload.profile))
        }
    }
};

def select_join_edges: Fn(PreparedPayload, Int, Array(Int)) -> Array(Int) = fn(payload, base, targets) {
    array::fold(targets, [], fn(acc, target) {
        if target == base {
            acc
        } else {
            let row = get_index(payload.paths, base);
            let pr = get_index(row, target);
            match pr {
                PathResult::Safe(seq) => if get_index(get_index(payload.ambiguous_paths, base), target) {
                    fail!("ambiguous safe path to requested entity; select a named relation", get_index(payload.entities, base).id, get_index(payload.entities, target).id)
                } else {
                    merge_edges(acc, seq)
                },
                PathResult::FanOut(_) => fail!("path to requested entity requires a fan-out relation; use an existence filter", target),
                PathResult::Missing => do {
                    let base_entry = get_index(payload.entities, base);
                    let is_metric = match base_entry.dataset {
                        Some(spec) => spec.kind == DatasetKind::Metric,
                        None => False,
                    };
                    if is_metric {
                        fail!("metric sample grain has no declared allocation path to requested dimension", base_entry.id, get_index(payload.entities, target).id)
                    } else {
                        fail!("no safe path to requested entity", target)
                    }
                },
                PathResult::Truncated => fail!("path search was truncated", target),
            }
        }
    })
};

def select_joins_with_context: Fn(qb::BuildCtx, PreparedPayload, Int, Array(Int)) -> (qb::BuildCtx, Array(qb::Join)) = fn(ctx, payload, base, targets) {
    array::fold(select_join_edges(payload, base, targets), (ctx, []), fn(state, index) {
        let relation = get_index(payload.relations, index);
        let entity = get_index(payload.entities, relation.to);
        let source = entity_source_at_with_context(state.0, payload, entity, entity.alias);
        let kind: qb::JoinKind = match relation.kind { RelationKind::Safe => qb::JoinKind::Inner, RelationKind::FanOut => qb::JoinKind::Left };
        let join = qb::join_on(kind, source.1, key_to_condition(payload, relation.from, relation.to, relation.key));
        (source.0, array::push(state.1, join))
    })
};

def entity_by_id: Fn(PreparedPayload, String) -> Int = fn(payload, id) {
    match array::find(payload.entities, fn(e) { e.id == id }) {
        Some(e) => e.index,
        None => fail!("exists target entity is unknown", id),
    }
};

# Direction-explicit relation lookup for existence filters. Prefers a forward
# edge (base -> target); when absent, a reverse edge (target -> base) is used to
# derive the correlated existence without requiring the model to duplicate graph
# edges. Reverse lookups feed only the existence predicate, never the ordinary
# join path closure.
type RelationLookup = struct { index: Int, reversed: Bool };

# Pure one-hop lookup: Some when base and target share a declared relation in
# either direction, otherwise None. Longer paths require a named graph Intent.
def lookup_existence_relation_opt: Fn(PreparedPayload, Int, Int) -> Option(RelationLookup) = fn(payload, base_entity, target) {
    let enumerated = array::enumerate(payload.relations);
    match array::find(enumerated, fn(pair) { pair.1.from == base_entity && pair.1.to == target }) {
        Some(pair) => do {
            let result: RelationLookup = { index: pair.0, reversed: False };
            let some: Option(RelationLookup) = Some(result);
            some
        },
        None => match array::find(enumerated, fn(pair) { pair.1.from == target && pair.1.to == base_entity }) {
            Some(pair) => do {
                let result: RelationLookup = { index: pair.0, reversed: True };
                let some: Option(RelationLookup) = Some(result);
                some
            },
            None => {
                let none: Option(RelationLookup) = None;
                none
            },
        },
    }
};

# Pure declared-route lookup for a (base, target) pair. Prepare-time validation
# guarantees at most one route per pair, so the lookup is unambiguous.
# Pure declared dual-hub lookup for a (hub base entity, participant target)
# pair. Prepare-time validation guarantees at most one route per pair, so the
# lookup is unambiguous.
def find_hub_route: Fn(PreparedPayload, Int, Int) -> Option(HubRouteEntry) = fn(payload, hub_base, participant) {
    array::find(payload.hub_routes, fn(r) { r.hub == hub_base && r.participant == participant })
};

# Pure paired-endpoint route lookup for a (hub base, origin entity, peer entity)
# triple, matching the declared route in either participant order.  Prepare-time
# validation guarantees at most one peer route per hub, so the lookup is
# unambiguous.
def find_peer_route: Fn(PreparedPayload, Int, Int, Int) -> Option(PeerRouteEntry) = fn(payload, hub_base, origin_entity, peer_entity) {
    array::find(payload.peer_routes, fn(r) {
        r.hub == hub_base
        && ((r.origin_entity == origin_entity && r.peer_entity == peer_entity)
            || (r.origin_entity == peer_entity && r.peer_entity == origin_entity))
    })
};

# The participant key field index of a peer route that belongs to `entity`.
def route_key_for: Fn(PeerRouteEntry, Int) -> Int = fn(route, entity) {
    if route.origin_entity == entity { route.origin_key } else { route.peer_key }
};

# The hub endpoint field index of a peer route whose slot references `entity`.
def route_field_for: Fn(PeerRouteEntry, Int) -> Int = fn(route, entity) {
    if route.origin_entity == entity { route.origin_field } else { route.peer_field }
};

# The derived inner alias of a participant in a paired correlation.  Origin and
# peer always use DIFFERENT aliases, even when they reference the same physical
# participant table.
def peer_inner_alias: Fn(EntityEntry, String) -> String = fn(entry, suffix) {
    `\{entry.alias}_\{suffix}`
};

# Build a dimension expression over a supplied inner alias (used inside the
# paired-endpoint correlated EXISTS, where each participant has its own alias).
def dimension_expr_on_alias: Fn(qb::BuildCtx, PreparedPayload, DimensionEntry, qb::Source) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry, source) {
    let entity = get_index(payload.entities, entry.entity);
    let field = get_index(entity.fields, entry.field);
    let base = qb::column(source, field.column);
    entry.build(ctx, base)
};

# Resolve a paired-endpoint participant attribute filter dimension: the filter
# must reference a declared dimension of the participant's OWN entity.
def peer_filter_dimension: Fn(PreparedPayload, Int, FilterRequest) -> DimensionEntry = fn(payload, entity, req) {
    if !payload.authorize(req.subject) {
        fail!("subject is not authorized for paired-endpoint filter", req.subject, req.id)
    } else {
        match array::find(payload.dimensions, fn(d) { d.id == req.id }) {
            None => fail!("unknown paired-endpoint filter dimension", req.subject, req.id),
            Some(d) => if d.entity != entity {
                fail!("paired-endpoint filter must reference its own participant entity", req.subject, req.id)
            } else {
                d
            },
        }
    }
};

# Lower one closed participant attribute filter over the participant's inner
# alias (enum domain, operation and input-kind validation reused).
def peer_attr_expr: Fn(qb::BuildCtx, PreparedPayload, DimensionEntry, FilterRequest, qb::Source) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry, req, source) {
    if !entry.authorized {
        fail!("dimension is not authorized", req.subject, req.id)
    } else if !entry.filterable {
        fail!("dimension has no filter capability", req.subject, req.id)
    } else if !array::any(entry.ops, fn(op) { op == req.op }) {
        fail!("filter operation not supported for dimension", req.subject, req.id)
    } else {
        let base = dimension_expr_on_alias(ctx, payload, entry, source);
        filter_value_on_base_with_context(base.0, entry, base.1, req.op, req.input)
    }
};

# Combine one side's constraints into a single alias-local predicate: the exact
# key (when present) first, then the attribute filters in request order (AND).
# An entity-only `PeerRef` (key = None, filters = []) is allowed: the declared
# participant entity (prepared route source/table) is itself the verified
# identity/type constraint, so the side predicate is None (any participant of
# that entity set, still tied to its own endpoint role by the exchange
# equalities inside the single correlated EXISTS).
def peer_side_constraints: Fn(qb::BuildCtx, PreparedPayload, Int, qb::Source, PeerRef, String) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, payload, entity, source, ref, key_col) {
    let key_expr: (qb::BuildCtx, Option(qb::Expr)) = match ref.key {
        Some(input) => do {
            let bound = qb::bind(ctx, to_val(input));
            (bound.0, Some(qb::scalar(qb::ScalarFunction::Eq, [qb::column(source, key_col), bound.1])))
        },
        None => (ctx, None),
    };
    let initial: (qb::BuildCtx, Array(qb::Expr)) = (key_expr.0, []);
    let attr_exprs = array::fold(ref.filters, initial, fn(state, req) {
        let d = peer_filter_dimension(payload, entity, req);
        let next = peer_attr_expr(state.0, payload, d, req, source);
        (next.0, array::push(state.1, next.1))
    });
    (attr_exprs.0, append_filter_terms(key_expr.1, attr_exprs.1))
};

# A role relation must prove every field of the participant's declared grain.
# Its endpoint pair must be precisely the peer hub's authored role, and extra
# identity pairs remain correlated to that participant inside the peer EXISTS.
def peer_role_identity: Fn(PreparedPayload, String, PeerRouteEntry, Int, Int, Int, qb::Source) -> Array(qb::Expr) = fn(payload, relation_id, route, participant, key, endpoint, source) {
    let relation = relation_domain(payload, relation_id);
    let hub = get_index(payload.entities, route.hub);
    let entry = get_index(payload.entities, participant);
    if relation.from != route.hub || relation.to != participant || relation.kind != RelationKind::Safe {
        fail!("peer hub role requires its declared safe hub-to-participant relation", relation_id)
    } else {
        let pairs = exists_pairs(relation.key);
        let endpoint_pairs = array::filter(pairs, fn(pair) { pair.from == endpoint && pair.to == key });
        let grain = dataset_domain(payload, entry.id).grain;
        let complete = array::length(grain) > 0 && array::all(grain, fn(field_name) {
            match array::find(entry.fields, fn(field) { field.name == field_name }) {
                None => False,
                Some(field) => array::length(array::filter(pairs, fn(pair) { pair.to == field.index })) == 1,
            }
        });
        if array::length(endpoint_pairs) != 1 || !complete || array::length(pairs) != array::length(grain) {
            fail!("peer hub role relation must match its endpoint and full participant grain", relation_id, entry.id)
        } else {
            array::map(array::filter(pairs, fn(pair) { pair.to != key }), fn(pair) {
                qb::scalar(qb::ScalarFunction::Eq, [
                    qb::column(hub.source, get_index(hub.fields, pair.from).column),
                    qb::column(source, get_index(entry.fields, pair.to).column)])
            })
        }
    }
};

# Lower one paired-endpoint (peer) request on a hub base row.  The request names
# two participant entities; each side carries an optional exact key and zero or
# more attribute filters over its own entity.  Lowering builds a correlated
# EXISTS over TWO inner participant sources (origin and peer aliases) whose
# `WHERE` holds the two closed endpoint-exchange branches:
#   (hub.A = origin.key AND hub.B = peer.key)
#   OR (hub.B = origin.key AND hub.A = peer.key)
# followed by the alias-local participant constraints (exact key then attribute
# filters, ANDed per side; deterministic binding order: origin side first, then
# peer side).  The participant entity always selects the validated inner
# source/alias, so a hub endpoint value is only interpreted through the
# participant table the request declared.  An entity-only side (key = None,
# filters = []) is allowed: the prepared participant entity is itself the
# verified identity/type constraint.  Same-entity peers still carry the closed
# `origin.key <> peer.key` identity proof.  Self-key, cross-entity filters and
# requests without a declared peer route fail atomically; the predicate is a
# pure correlated EXISTS, so it never joins or fans out the hub base grain.
def resolve_peer: Fn(qb::BuildCtx, PreparedPayload, Int, PeerRequest) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, hub_entity, spec) {
    if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for paired-endpoint request", spec.subject, spec.origin.entity, spec.peer.entity)
    } else {
        let origin_entity = entity_by_id(payload, spec.origin.entity);
        let peer_entity = entity_by_id(payload, spec.peer.entity);
        if origin_entity == peer_entity
            && spec.origin.key != None && spec.peer.key != None
            && spec.origin.key == spec.peer.key {
            fail!("paired-endpoint request requires two distinct participants (self-pair rejected)", spec.origin.entity, spec.peer.entity)
        } else {
            match find_peer_route(payload, hub_entity, origin_entity, peer_entity) {
                None => fail!("base hub declares no paired-endpoint route for the requested participants", spec.origin.entity, spec.peer.entity),
                Some(route) => do {
                    let hub_entry = get_index(payload.entities, hub_entity);
                    let origin_entry = get_index(payload.entities, origin_entity);
                    let peer_entry = get_index(payload.entities, peer_entity);
                    if origin_entry.union != None || peer_entry.union != None {
                        fail!("paired-endpoint participants must be physical entities", spec.origin.entity, spec.peer.entity)
                    } else {
                        # The two hub role columns of the route.
                        let request_reversed = !route.exchange && route.origin_entity != origin_entity;
                        let origin_field = if request_reversed { route.peer_field } else { route.origin_field };
                        let peer_field = if request_reversed { route.origin_field } else { route.peer_field };
                        let hub_l = qb::column_ref(hub_entry.source, get_index(hub_entry.fields, origin_field).column);
                        let hub_r = qb::column_ref(hub_entry.source, get_index(hub_entry.fields, peer_field).column);
                        # Each participant contributes its own inner alias and key.
                        let origin_source = entity_source_at_with_context(qb::independent_query_scope(ctx), payload, origin_entry, peer_inner_alias(origin_entry, "o"));
                        let peer_source = entity_source_at_with_context(origin_source.0, payload, peer_entry, peer_inner_alias(peer_entry, "p"));
                        let origin_alias = origin_source.1.alias;
                        let peer_alias = peer_source.1.alias;
                        let origin_key_col = get_index(origin_entry.fields, route_key_for(route, origin_entity)).column;
                        let peer_key_col = get_index(peer_entry.fields, route_key_for(route, peer_entity)).column;
                        let origin_key_ref = qb::column_ref(origin_source.1, origin_key_col);
                        let peer_key_ref = qb::column_ref(peer_source.1, peer_key_col);
                        # Two ordered exchange branches (both always present).
                        let a_origin = qb::column_eq(hub_l, origin_key_ref);
                        let a_peer = qb::column_eq(hub_r, peer_key_ref);
                        let b_origin = qb::column_eq(hub_r, origin_key_ref);
                        let b_peer = qb::column_eq(hub_l, peer_key_ref);
                        let branch_a = qb::peer_branch(a_origin, a_peer);
                        let branch_b = qb::peer_branch(b_origin, b_peer);
                        # Participant constraints stay inside the same correlated
                        # EXISTS, each bound to its own inner alias.
                        let identity = match route.relations {
                            None => ([], []),
                            Some(relations) => (
                                peer_role_identity(payload, if request_reversed { relations.peer } else { relations.origin },
                                    route, origin_entity, route_key_for(route, origin_entity), origin_field, origin_source.1),
                                peer_role_identity(payload, if request_reversed { relations.origin } else { relations.peer },
                                    route, peer_entity, route_key_for(route, peer_entity), peer_field, peer_source.1)),
                        };
                        let origin_side = peer_side_constraints(peer_source.0, payload, origin_entity, origin_source.1, spec.origin, origin_key_col);
                        let peer_side = peer_side_constraints(origin_side.0, payload, peer_entity, peer_source.1, spec.peer, peer_key_col);
                        let origin_filter = append_filter_terms(origin_side.1, identity.0);
                        let peer_filter = append_filter_terms(peer_side.1, identity.1);
                        let corr = qb::peer_corr_roles(origin_source.1, peer_source.1, branch_a, branch_b, origin_filter, peer_filter, origin_entity == peer_entity, route.exchange);
                        (peer_side.0, qb::exists_peer(corr))
                    }
                },
            }
        }
    }
};

# Pure per-filter check for a paired-endpoint participant attribute filter.
def peer_side_filter_ok: Fn(PreparedPayload, Int, FilterRequest) -> Bool = fn(payload, entity, req) {
    if !payload.authorize(req.subject) {
        False
    } else {
        match array::find(payload.dimensions, fn(d) { d.id == req.id }) {
            None => False,
            Some(d) => do {
                if d.entity != entity {
                    False
                } else if !d.authorized {
                    False
                } else if !d.filterable {
                    False
                } else if !array::any(d.ops, fn(op) { op == req.op }) {
                    False
                } else if array::length(d.canonical_values) > 0 {
                    match (req.op, req.input) {
                        (FilterOp::Eq, FilterInput::Text(s)) => array::any(d.canonical_values, fn(v) { v.id == s }),
                        (FilterOp::Ne, FilterInput::Text(s)) => array::any(d.canonical_values, fn(v) { v.id == s }),
                        _ => False,
                    }
                } else if array::length(d.values) > 0 {
                    match (req.op, req.input) {
                        (FilterOp::Eq, FilterInput::Text(s)) => array::any(d.values, fn(v) { v.value == s }),
                        _ => False,
                    }
                } else if is_text_op(req.op) {
                    match req.input {
                        FilterInput::Text(_) => filter_input_allowed(d.input_kinds, req.input),
                        _ => False,
                    }
                } else {
                    filter_input_allowed(d.input_kinds, req.input)
                }
            },
        }
    }
};

# Pure feasibility probe for a paired-endpoint request: True when the subject
# is authorized, both participant sides are registered (entity-only sides are
# allowed: the prepared participant entity is itself the verified
# identity/type constraint), optional attribute filters over their own entity are
# valid, the participants are distinct when they share an exact key, and the
# base hub declares a peer route that can pair them.  Used by tests to assert
# deterministic rejection without a failing lowering.
def peer_request_ok: Fn(PreparedPayload, Int, PeerRequest) -> Bool = fn(payload, hub_entity, spec) {
    if !payload.authorize(spec.subject) {
        False
    } else {
        match (array::find(payload.entities, fn(e) { e.id == spec.origin.entity }), array::find(payload.entities, fn(e) { e.id == spec.peer.entity })) {
            (None, _) => False,
            (_, None) => False,
            (Some(origin_entry), Some(peer_entry)) => do {
                let origin_entity = origin_entry.index;
                let peer_entity = peer_entry.index;
                if origin_entry.union != None || peer_entry.union != None {
                    False
                } else if origin_entity == peer_entity
                    && spec.origin.key != None && spec.peer.key != None
                    && spec.origin.key == spec.peer.key {
                    False
                } else if !array::all(spec.origin.filters, fn(req) { peer_side_filter_ok(payload, origin_entity, req) })
                    || !array::all(spec.peer.filters, fn(req) { peer_side_filter_ok(payload, peer_entity, req) }) {
                    False
                } else {
                    match find_peer_route(payload, hub_entity, origin_entity, peer_entity) {
                        None => False,
                        Some(_) => True,
                    }
                }
            },
        }
    }
};

# Correlation equality for an existence relation key pair. For a forward edge
# `pair.from`/`pair.to` are on the outer/target entities; for a reverse edge the
# roles swap, keeping the outer (correlated main) column on the left.
def exists_col_eq: Fn(EntityEntry, EntityEntry, RelationPair, Bool) -> qb::ColumnEq = fn(outer_entry, target_entry, pair, reversed) {
    if reversed {
        let target_field = get_index(target_entry.fields, pair.from);
        let outer_field = get_index(outer_entry.fields, pair.to);
        qb::column_eq(qb::column_ref(outer_entry.source, outer_field.column), qb::column_ref(target_entry.source, target_field.column))
    } else {
        let outer_field = get_index(outer_entry.fields, pair.from);
        let target_field = get_index(target_entry.fields, pair.to);
        qb::column_eq(qb::column_ref(outer_entry.source, outer_field.column), qb::column_ref(target_entry.source, target_field.column))
    }
};

# The correlated EXISTS shape requires a conjunction of column equalities on the
# inner source; disjunctive relation keys cannot be expressed by EXISTS and fail
# with a deterministic diagnostic instead of guessing.
def exists_pairs: Fn(RelationKey) -> Array(RelationPair) = fn(key) {
    match key {
        RelationKey::Eq(pair) => [pair],
        RelationKey::FieldEq(_) => fail!("unresolved relation field key"),
        RelationKey::And(keys) => array::flat_map(keys, fn(k) { exists_pairs(k) }),
        RelationKey::Or(_) => fail!("exists relation key must be a conjunction of column equalities"),
    }
};

# Inner body of a correlated existence request. `target_entry` is the inner
# (exists) entity; inner filters and OR-groups must only reference that entity.
# `min_matches` groups by every inner correlation column, preserving composite
# owner identity without amplifying the outer grain.
def exists_inner_with_context: Fn(qb::BuildCtx, PreparedPayload, ExistsRequest, Int) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, payload, spec, target) {
    let inner_filters = resolve_filters_with_context(ctx, payload, spec.filters);
    let target_ok = array::all(inner_filters.1, fn(f) { f.entity == target });
    if !target_ok {
        fail!("exists inner filter must reference the target entity", spec.target)
    } else {
        let any_initial: (qb::BuildCtx, Array(qb::Expr)) = (inner_filters.0, []);
        let inner_any = array::fold(spec.any_of, any_initial, fn(state, item) {
            let resolved = any_of_on_target_with_context(state.0, payload, target, item);
            (resolved.0, array::push(state.1, resolved.1))
        });
        let inner = append_filter_terms(combine_filters(array::map(inner_filters.1, fn(f) { f.expr })), inner_any.1);
        (inner_any.0, inner)
    }
};

def build_correlated_exists_with_context: Fn(qb::BuildCtx, PreparedPayload, EntityEntry, Array(qb::ColumnEq), ExistsRequest, Int) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, target_entry, col_eqs, spec, target) {
        let inner = exists_inner_with_context(ctx, payload, spec, target);
        let allocated = entity_source_at_with_context(qb::independent_query_scope(inner.0), payload, target_entry, target_entry.alias);
        let source = allocated.1;
        match spec.min_matches {
            None => (allocated.0, qb::exists(source, col_eqs, inner.1)),
            Some(n) => do {
                if n <= 0 {
                    fail!("exists minimum matches must be a positive integer", spec.target, n)
                } else if array::length(col_eqs) == 0 {
                    fail!("grouped existence requires a relation key", spec.target)
                } else {
                    # Every inner correlation column identifies the related group.
                    # Grouping only one column would merge different tenants.
                    let corr = get_index(col_eqs, 0);
                    let grouping: Array(qb::Expr) = array::map(col_eqs, fn(pair) {
                        qb::expr_ref(pair.right)
                    });
                    let count_column = if target_entry.key_field >= 0 {
                        get_index(target_entry.fields, target_entry.key_field).column
                    } else {
                        corr.right.column
                    };
                    let count_expr: qb::Expr = qb::expr_ref({...corr.right, column: count_column});
                    let threshold = qb::bind(allocated.0, qb::Val::Int(n));
                    let having_list: Array(qb::Having) = [qb::having_call_bound(qb::HavingOp::Ge, qb::AggregateFunction::Count, count_expr, False, threshold.1)];
                    (threshold.0, qb::exists_grouped(source, col_eqs, inner.1, grouping, having_list))
                }
            },
        }
};

# Inner body of a dual-hub union existence (hub base grain).  The hub's two role
# columns (`route.left`/`route.right`) reference the participant entity's stable
# key; the correlated union EXISTS keeps the hub base grain and each hub base
# row is naturally counted at most once (no fan-out join, no unused dedup key).
# Dynamic filters stay bound and must reference the participant entity (the
# filter target).
def build_hub_union_exists: Fn(qb::BuildCtx, PreparedPayload, HubRouteEntry, ExistsRequest) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, route, spec) {
    let hub_entry = get_index(payload.entities, route.hub);
    let participant_entry = get_index(payload.entities, route.participant);
    let left_field = get_index(hub_entry.fields, route.left);
    let right_field = get_index(hub_entry.fields, route.right);
    let key_field = get_index(participant_entry.fields, route.participant_key);
    let left_hub_ref = qb::column_ref(hub_entry.source, left_field.column);
    let right_hub_ref = qb::column_ref(hub_entry.source, right_field.column);
    let participant_key_ref = qb::column_ref(participant_entry.source, key_field.column);
    let alt_left: Array(qb::ColumnEq) = [qb::column_eq(left_hub_ref, participant_key_ref)];
    let alt_right: Array(qb::ColumnEq) = [qb::column_eq(right_hub_ref, participant_key_ref)];
    let alternatives: Array(Array(qb::ColumnEq)) = [alt_left, alt_right];
    if spec.min_matches != None {
        fail!("dual hub union existence does not support minimum-match grouping in this slice", spec.target)
    } else {
        let inner = exists_inner_with_context(ctx, payload, spec, route.participant);
        let source = entity_source_at_with_context(qb::independent_query_scope(inner.0), payload, participant_entry, participant_entry.alias);
        (source.0, qb::exists_union(source.1, alternatives, inner.1))
    }
};

# Lower one correlated existence request. Rows of the base entity that have at
# least one (or, with `min_matches`, at least N) related row in the target
# entity are kept. This legacy shape resolves a dual-endpoint hub union or a
# declared one-hop relation; multi-hop paths use named graph existence.
def resolve_exists: Fn(qb::BuildCtx, PreparedPayload, Int, ExistsRequest) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, base_entity, spec) {
    let target = entity_by_id(payload, spec.target);
    if target == base_entity {
        fail!("exists target must differ from the base entity", spec.target)
    } else {
        match find_hub_route(payload, base_entity, target) {
            Some(hub_route) => do {
                build_hub_union_exists(ctx, payload, hub_route, spec)
            },
            None => match lookup_existence_relation_opt(payload, base_entity, target) {
                Some(lookup) => do {
                    let rel = get_index(payload.relations, lookup.index);
                    let pairs = exists_pairs(rel.key);
                    let base_entry = get_index(payload.entities, base_entity);
                    let target_entry = get_index(payload.entities, target);
                    let col_eqs = array::map(pairs, fn(pair) { exists_col_eq(base_entry, target_entry, pair, lookup.reversed) });
                    build_correlated_exists_with_context(ctx, payload, target_entry, col_eqs, spec, target)
                },
                None => fail!("exists target has no declared direct relation or hub route from the base entity; use a named graph for longer paths", spec.target),
            },
        }
    }
};

# Lower one aggregate-result (HAVING) predicate over a requested measure.
# Threshold values always become the trailing `?` binding via the query public
# `having` constructor.

def resolve_having_with_context: Fn(qb::BuildCtx, PreparedPayload, Array(MeasureRequest), HavingRequest) -> (qb::BuildCtx, qb::Having) = fn(ctx, payload, measure_requests, spec) {
    if !array::any(measure_requests, fn(m) { m.id == spec.measure }) {
        fail!("having references a measure that is not requested", spec.measure)
    } else if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for having measure", spec.subject, spec.measure)
    } else {
        match array::find(payload.measures, fn(m) { m.id == spec.measure }) {
            Some(entry) => {
                let op_q: qb::HavingOp = match spec.op {
                    HavingOp::Eq => qb::HavingOp::Eq,
                    HavingOp::Ne => qb::HavingOp::Ne,
                    HavingOp::Gt => qb::HavingOp::Gt,
                    HavingOp::Ge => qb::HavingOp::Ge,
                    HavingOp::Lt => qb::HavingOp::Lt,
                    HavingOp::Le => qb::HavingOp::Le,
                };
                let bound = qb::bind(ctx, to_val(spec.threshold));
                (bound.0, qb::having_bound(op_q, entry.alias, bound.1))
            },
            None => fail!("having references an unknown measure", spec.measure),
        }
    }
};

# Union (derived) branch filter: a fixed Eq over one logical field mapped to the
# branch's physical column.
def union_branch_filter_with_context: Fn(qb::BuildCtx, EntityEntry, UnionBranchEntry, qb::Source) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, entity, branch, source) {
    match branch.filter {
        None => (ctx, None),
        Some(pred) => do {
            let physical = get_index(branch.columns, pred.field);
            let bound = qb::bind(ctx, to_val(pred.input));
            let expr = qb::scalar(qb::ScalarFunction::Eq, [qb::source_column(source, physical), bound.1]);
            (bound.0, Some(expr))
        },
    }
};

# Build the query DerivedSource for a union entity: each ordered branch projects
# every logical field from its own mapped physical column under the logical
# field's stable column name (the branch output alias). All validated at prepare.
def build_union_derived_with_context: Fn(qb::BuildCtx, EntityEntry, UnionEntry) -> (qb::BuildCtx, qb::DerivedSource) = fn(ctx, entity, union) {
    let initial: (qb::BuildCtx, Array(qb::UnionBranch)) = (ctx, []);
    let branches = array::fold(union.branches, initial, fn(state, branch) {
        let source = qb::source_with_hint(state.0, branch.table, branch.alias);
        let outputs = array::map(entity.fields, fn(f) {
            let physical = get_index(branch.columns, f.index);
            qb::union_column(f.column, qb::source_column(source.1, physical))
        });
        let filter = union_branch_filter_with_context(source.0, entity, branch, source.1);
        (filter.0, array::push(state.1, qb::union_branch(source.1, outputs, filter.1)))
    });
    (branches.0, qb::derived_source(union.alias, branches.1))
};

# Resolved physical sources for one lowering: either a normal base source plus
# joins, or (for a union entity) an empty physical source set plus one derived
# UNION ALL source. `exists` plans apply only to the single-source case.
type LoweredSources = struct {
    sources: Array(qb::Source),
    derived: Option(qb::DerivedSource),
    joins: Array(qb::Join),
    exists: Array(qb::Exists),
};

# Shared lowering pipeline. Measures may be empty: the request then projects
# row-level dimension attributes (no grouping, no aggregate items) and derives
# the base entity from the first requested dimension. Existence filters keep the
# base grain; having predicates constrain aggregated results.  Paired-endpoint
# (peer) filters additionally constrain the base hub row to the two specified
# participants on its two mutually exclusive endpoints.  `absence_specs` are
# correlated anti-existence requests: they keep base rows that have NO matching
# related row in the target (lowered as `NOT EXISTS`).  `internal_orders` are
# internal (non-projected) ordering aggregates of a grouped dimension listing:
# the groups are ordered by an authorized measure that is never returned.
def lower_core: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(AnyOfRequest), Array(ExistsRequest), Array(HavingRequest), Array(PeerRequest), Array(ExistsRequest), Array(InternalOrderRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, any_of_specs, exists_specs, having_specs, peer_specs, absence_specs, internal_orders) {
    let measures = resolve_measures(payload, request.measures);
    let dimensions = resolve_dimensions(payload, request.dimensions);
    let measure_count = array::length(measures);
    let dimension_count = array::length(dimensions);
    let internal_group = array::length(internal_orders) > 0;
    if internal_group && measure_count > 0 {
        fail!("internal ordering aggregates require a measureless dimension request")
    } else if measure_count == 0 && dimension_count == 0 {
        fail!("request must select at least one measure or one dimension")
    } else if internal_group && dimension_count == 0 {
        fail!("internal ordering aggregates require at least one grouping dimension")
    } else if measure_count == 0 && request.partition != None {
        fail!("top per group requires an aggregated measure")
    } else if measure_count == 0 && array::length(having_specs) > 0 {
        fail!("having requires an aggregated measure")
    } else {
        let base_entity = if measure_count > 0 {
            let first = get_index(measures, 0).entry.entity;
            let grain_ok = array::all(measures, fn(m) { m.entry.entity == first });
            if grain_ok { first } else { fail!("requested measures are not grain-compatible") }
        } else {
            get_index(dimensions, 0).entry.entity
        };
        # Paired-endpoint (peer) requests resolve against the base hub entity's
        # declared peer route as correlated EXISTS predicates over the two
        # participant inner sources (no outer participant join, no fan-out).
        # They require a physical hub entity.
        let peer_exists_plans: (qb::BuildCtx, Array(qb::Exists)) = if array::length(peer_specs) > 0 {
            let hub_entry = get_index(payload.entities, base_entity);
            match hub_entry.union {
                None => do {
                    let initial: (qb::BuildCtx, Array(qb::Exists)) = (ctx, []);
                    array::fold(peer_specs, initial, fn(state, spec) {
                        let next = resolve_peer(state.0, payload, base_entity, spec);
                        (next.0, array::push(state.1, next.1))
                    })
                },
                Some(_) => fail!("paired-endpoint requests require a physical hub entity", base_entity),
            }
        } else {
            let empty: Array(qb::Exists) = [];
            (ctx, empty)
        };
        let scoped_initial: (qb::BuildCtx, Array(FilterResolution)) = (peer_exists_plans.0, []);
        let scoped = array::fold(dimensions, scoped_initial, fn(state, dimension) {
            array::fold(dimension.entry.scope, state, fn(inner, predicate) {
                let resolved = resolve_scope_with_context(inner.0, payload, dimension.entry, predicate, True);
                (resolved.0, array::push(inner.1, resolved.1))
            })
        });
        let scope_resolutions = scoped.1;
        let resolved_filters = resolve_filters_with_context(scoped.0, payload, request.filters);
        let filter_resolutions = resolved_filters.1;
        let any_initial: (qb::BuildCtx, Array(qb::Expr)) = (resolved_filters.0, []);
        let any_exprs = array::fold(any_of_specs, any_initial, fn(state, spec) {
            let entry = match array::find(payload.dimensions, fn(d) { d.id == spec.id }) {
                Some(value) => value,
                None => fail!("unknown any-of dimension", spec.id),
            };
            let next = any_of_on_target_with_context(state.0, payload, entry.entity, spec);
            (next.0, array::push(state.1, next.1))
        });
        let filter_expr = append_filter_terms(combined_filter(scope_resolutions, filter_resolutions), any_exprs.1);
        let any_entities = array::map(any_of_specs, fn(a) {
            match array::find(payload.dimensions, fn(d) { d.id == a.id }) {
                Some(entry) => entry.entity,
                None => fail!("unknown any-of dimension", a.id),
            }
        });
        let requested_measure_ids = array::map(request.measures, fn(m) { m.id });
        let requested_dimension_ids = array::map(request.dimensions, fn(d) { d.id });
        # An aggregated request may order only by its own selected measures and
        # dimensions (the ORDER BY references grouped expressions / projected
        # aggregate aliases).  A measureless (row-level) request treats
        # projection and ordering as two different constraints: it may order by
        # any authorized dimension of the base grain, projected or not; ordering
        # by a non-projected dimension adds a grain-safe join to its entity.
        let ordering_tuple = if measure_count > 0 {
            let orders = resolve_ordering_with_context(any_exprs.0, payload, request.ordering, requested_measure_ids, requested_dimension_ids);
            let no_extra: Array(Int) = [];
            (orders.0, orders.1, no_extra)
        } else if internal_group {
            # Grouped dimension listing: ORDER BY the internal (non-projected)
            # ordering aggregates first, then the requested-dimension ordering
            # tie-breakers (each on a grouping expression).
            let agg_initial: (qb::BuildCtx, Array(qb::OrderBy)) = (any_exprs.0, []);
            let agg_orders = array::fold(internal_orders, agg_initial, fn(state, spec) {
                let next = internal_aggregate_order_with_context(state.0, payload, base_entity, spec);
                (next.0, array::push(state.1, next.1))
            });
            let dim_orders = resolve_grouped_dim_orders_with_context(agg_orders.0, payload, request);
            let no_extra: Array(Int) = [];
            (dim_orders.0, array::concat([agg_orders.1, dim_orders.1]), no_extra)
        } else {
            resolve_row_ordering_with_context(any_exprs.0, payload, request.ordering)
        };
        let ordering = ordering_tuple.1;
        let ordering_entities = ordering_tuple.2;
        let partitioned = check_partition(ordering_tuple.0, payload, request, dimensions, ordering);
        let partition = partitioned.1;
        let limit = request.limit;
        let offset = check_offset(request.offset, array::length(request.ordering));
        let base_entry = get_index(payload.entities, base_entity);
        let source_plan = match base_entry.union {
            None => do {
                let exists_initial: (qb::BuildCtx, Array(qb::Exists)) = (partitioned.0, []);
                let exists_built = array::fold(exists_specs, exists_initial, fn(state, spec) {
                    let next = resolve_exists(state.0, payload, base_entity, spec);
                    (next.0, array::push(state.1, next.1))
                });
                let absence_built = array::fold(absence_specs, (exists_built.0, []), fn(state, spec) {
                    let next = resolve_exists(state.0, payload, base_entity, spec);
                    (next.0, array::push(state.1, next.1))
                });
                let exists_resolutions = exists_built.1;
                let absence_resolutions = absence_built.1;
                let exists_plans = exists_resolutions;
                # Anti-existence: the same resolved correlated body rendered as
                # `NOT EXISTS (...)`, keeping base rows with no matching related row.
                let absence_plans = array::map(absence_resolutions, qb::exists_not);
                let exists_targets = array::map(exists_specs, fn(spec) { entity_by_id(payload, spec.target) });
                # A measure-required entity that is also an existence target is
                # satisfied by the correlated existence predicate instead of a
                # fan-out join, so the subject measure is not amplified.
                let measure_targets = array::concat(array::map(measures, fn(m) { m.entry.requires }));
                let filtered_measure_targets = array::filter(measure_targets, fn(t) {
                    !array::any(exists_targets, fn(e) { e == t })
                });
                let dim_entities = array::map(dimensions, fn(d) { d.entry.entity });
                let scope_entities = array::map(scope_resolutions, fn(f) { f.entity });
                let filter_entities = array::map(filter_resolutions, fn(f) { f.entity });
                let targets = array::concat([filtered_measure_targets, dim_entities, scope_entities, filter_entities, any_entities, ordering_entities]);
                let base_source = entity_source_at_with_context(absence_built.0, payload, base_entry, base_entry.alias);
                let joined = select_joins_with_context(base_source.0, payload, base_entity, targets);
                let joins = joined.1;
                let join_sources = array::map(joins, fn(j) { j.source });
                let sources = array::concat([[base_source.1], join_sources]);
                let all_exists = array::concat([exists_plans, absence_plans, peer_exists_plans.1]);
                let result: LoweredSources = { sources, derived: None, joins, exists: all_exists };
                (joined.0, result)
            },
            Some(union) => do {
                if array::length(exists_specs) > 0 || array::length(absence_specs) > 0 {
                    fail!("union entity request does not support existence filters")
                } else {
                    let measure_targets = array::concat(array::map(measures, fn(m) { m.entry.requires }));
                    let dim_entities = array::map(dimensions, fn(d) { d.entry.entity });
                    let scope_entities = array::map(scope_resolutions, fn(f) { f.entity });
                    let filter_entities = array::map(filter_resolutions, fn(f) { f.entity });
                    let refs = array::concat([measure_targets, dim_entities, scope_entities, filter_entities, any_entities, ordering_entities]);
                    let refs_ok = array::all(refs, fn(t) { t == base_entity });
                    if !refs_ok {
                        fail!("union entity request cannot join or filter another entity")
                    } else {
                        let none_sources: Array(qb::Source) = [];
                        let none_joins: Array(qb::Join) = [];
                        let none_exists: Array(qb::Exists) = [];
                        let derived = build_union_derived_with_context(partitioned.0, base_entry, union);
                        let result: LoweredSources = { sources: none_sources, derived: Some(derived.1), joins: none_joins, exists: none_exists };
                        (derived.0, result)
                    }
                }
            },
        };
        let measure_initial: (qb::BuildCtx, Array(qb::SelectItem)) = (source_plan.0, []);
        let measure_items = array::fold(measures, measure_initial, fn(state, m) {
            let entity = get_index(payload.entities, m.entry.entity);
            let field = get_index(entity.fields, m.entry.field);
            let item = match m.entry.computed {
                Some(spec) => (state.0, qb::computed_item(spec.op, spec.left, spec.right, m.entry.alias)),
                None => match m.entry.predicate {
                    Some(_) => do {
                        let predicate = resolve_measure_predicate_with_context(state.0, payload, m.entry);
                        (predicate.0, qb::aggregate_filtered(m.entry.aggregate, qb::column(entity.source, field.column), m.distinct, Some(predicate.1), m.entry.alias))
                    },
                    None => (state.0, qb::aggregate(m.entry.aggregate, qb::column(entity.source, field.column), m.distinct, m.entry.alias)),
                },
            };
            (item.0, array::push(state.1, item.1))
        });
        let dimension_outputs = dimension_outputs_with_context(measure_items.0, payload, dimensions);
        let projection = array::concat([measure_items.1, array::map(dimension_outputs.1, qb::expr_item)]);
        let none_grouping: Array(qb::Expr) = [];
        let grouping = if measure_count > 0 || internal_group {
            dimension_outputs.1
        } else {
            none_grouping
        };
        let having_initial: (qb::BuildCtx, Array(qb::Having)) = (dimension_outputs.0, []);
        let having_built = array::fold(having_specs, having_initial, fn(state, spec) {
            let next = resolve_having_with_context(state.0, payload, request.measures, spec);
            (next.0, array::push(state.1, next.1))
        });
        let having_plans = having_built.1;
        let no_partition_ordering: Array(qb::OrderBy) = [];
        let limit_bound = if partition == None { match limit {
            Some(value) => do {
                let allocated = qb::page_bound(having_built.0, value);
                (allocated.0, Some(allocated.1))
            },
            None => (having_built.0, None),
        } } else { (having_built.0, None) };
        let offset_bound = if partition == None { match offset {
            Some(value) => do {
                let allocated = qb::page_bound(limit_bound.0, value);
                (allocated.0, Some(allocated.1))
            },
            None => (limit_bound.0, None),
        } } else { (limit_bound.0, None) };
        let plan: qb::Plan = {
            revision: payload.revision,
            sources: source_plan.1.sources,
            derived: source_plan.1.derived,
            projection,
            filter: filter_expr,
            exists: source_plan.1.exists,
            joins: source_plan.1.joins,
            grouping,
            having: having_plans,
            ordering: if partition == None { ordering } else { no_partition_ordering },
            limit: limit_bound.1,
            offset: offset_bound.1,
            partition,
            scalar_comparisons: [],
        ranked_key_comparisons: [],
        };
        (offset_bound.0, qb::validate(plan, payload.profile))
    }
};

def lower: Fn(qb::BuildCtx, PreparedPayload, QueryRequest) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request) {
    lower_core(ctx, payload, request, [], [], [], [], [], [])
};

# Override precisely one ambiguous Safe hop by its declared business identity.
# All other route cells retain their original ambiguity checks.
def lower_via: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, relation_id) {
    let base = if array::length(request.measures) > 0 {
        match array::find(payload.measures, fn(entry) { entry.id == get_index(request.measures, 0).id }) {
            Some(entry) => entry.entity,
            None => fail!("unknown measure", get_index(request.measures, 0).id),
        }
    } else if array::length(request.dimensions) > 0 {
        match array::find(payload.dimensions, fn(entry) { entry.id == get_index(request.dimensions, 0).id }) {
            Some(entry) => entry.entity,
            None => fail!("unknown dimension", get_index(request.dimensions, 0).id),
        }
    } else {
        fail!("named join requires a projected base dimension or measure")
    };
    let indexed = array::enumerate(payload.relations);
    let selected = match array::find(indexed, fn(pair) { pair.1.id == relation_id && pair.1.id != "" }) {
        Some(pair) => pair,
        None => fail!("unknown named relation", relation_id),
    };
    let rel = selected.1;
    if rel.from != base || rel.kind != RelationKind::Safe {
        fail!("named projection relation must be a grain-safe forward edge from the base dataset", relation_id)
    } else {
        let target = rel.to;
        let referenced = array::any(request.dimensions, fn(req) {
            array::any(payload.dimensions, fn(d) { d.id == req.id && d.entity == target })
        }) || array::any(request.filters, fn(req) {
            array::any(payload.dimensions, fn(d) { d.id == req.id && d.entity == target })
        });
        if !referenced {
            fail!("named projection relation does not serve a requested dimension or filter", relation_id)
        } else {
            let paths = array::map(array::enumerate(payload.paths), fn(source_row) {
                if source_row.0 == base {
                    array::map(array::enumerate(source_row.1), fn(cell) {
                        if cell.0 == target { PathResult::Safe([selected.0]) } else { cell.1 }
                    })
                } else { source_row.1 }
            });
            let ambiguous_paths = array::map(array::enumerate(payload.ambiguous_paths), fn(source_row) {
                if source_row.0 == base {
                    array::map(array::enumerate(source_row.1), fn(cell) {
                        if cell.0 == target { False } else { cell.1 }
                    })
                } else { source_row.1 }
            });
            let selected_payload: PreparedPayload = {...payload, paths, ambiguous_paths};
            lower(ctx, selected_payload, request)
        }
    }
};

# A named reverse fan-out is an explicit row relationship, not a Safe path.
# A single owner/target pair joins once even if multiple OR keys match it.
def lower_relation_rows: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, base_id, relation_id) {
    if array::length(request.measures) != 0 || array::length(request.dimensions) < 2
        || array::length(request.ordering) != 0 || request.offset != None || request.partition != None {
        fail!("relation rows require owner and target dimensions without measures, ordering or partition")
    } else {
        let base = entity_by_id(payload, base_id);
        let relation = relation_domain(payload, relation_id);
        if relation.to != base || relation.kind != RelationKind::FanOut {
            fail!("relation rows require a named reverse fan-out to the base dataset", relation_id, base_id)
        } else {
            let target = relation.from;
            let dimensions = resolve_dimensions(payload, request.dimensions);
            let filters = resolve_filters_with_context(qb::build_context(), payload, request.filters).1;
            let base_dimensions = array::filter(request.dimensions, fn(req) {
                array::any(payload.dimensions, fn(d) { d.id == req.id && d.entity == base })
            });
            let base_filters = array::filter(request.filters, fn(req) {
                array::any(payload.dimensions, fn(d) { d.id == req.id && d.entity == base })
            });
            if !array::all(dimensions, fn(d) { d.entry.entity == base || d.entry.entity == target })
                || !array::all(filters, fn(f) { f.entity == base || f.entity == target })
                || !array::any(dimensions, fn(d) { d.entry.entity == base })
                || !array::any(dimensions, fn(d) { d.entry.entity == target }) {
                fail!("relation rows require projected dimensions from both declared endpoints only", relation_id)
            } else {
                let lowered = lower(ctx, payload, {...request, dimensions: base_dimensions, filters: base_filters});
                let root = lowered.1;
                if array::length(root.sources) != 1 || array::length(root.joins) != 0 || root.derived != None {
                    fail!("relation rows require one physical base dataset", base_id)
                } else {
                    let target_entry = get_index(payload.entities, target);
                    let target_source = entity_source_at_with_context(lowered.0, payload, target_entry, target_entry.alias);
                    let join = qb::join_on(qb::JoinKind::Inner, target_source.1,
                        key_to_condition(payload, relation.from, relation.to, relation.key));
                    let target_requests = array::filter(request.filters, fn(spec) {
                        array::any(payload.dimensions, fn(d) { d.id == spec.id && d.entity == target })
                    });
                    let resolved = resolve_filters_with_context(target_source.0, payload, target_requests);
                    let target_filters = array::map(resolved.1, fn(f) { f.expr });
                    let outputs = dimension_outputs_with_context(resolved.0, payload, dimensions);
                    let projection = array::map(outputs.1, qb::expr_item);
                    (outputs.0, qb::validate({...root,
                        sources: array::push(root.sources, join.source),
                        joins: [join], projection,
                        filter: append_filter_terms(root.filter, target_filters),
                    }, payload.profile))
                }
            }
        }
    }
};

# A native A/Z pair is a property of its link row, not an inferred path to
# endpoint entities. Keep each ordered pairing closed before ORing them.
def lower_endpoint_pair: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, EndpointPairRequest) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, tenant_relation_id, pair) {
        let relation = relation_domain(payload, tenant_relation_id);
        if relation.kind != RelationKind::Safe {
            fail!("endpoint pair requires a named safe tenant relation", tenant_relation_id)
        } else {
            let entity = get_index(payload.entities, relation.from);
            let declared = match array::find(payload.native_pairs, fn(entry) { entry.id == pair.pair && entry.entity == entity.index }) {
                Some(entry) => entry, None => fail!("unknown native endpoint pair for link dataset", pair.pair, entity.id),
            };
            if get_index(payload.entities, relation.to).id != "tenant" {
                fail!("endpoint pair requires a declared tenant ownership relation", tenant_relation_id)
            } else {
                let lowered = lower_via(ctx, payload, request, tenant_relation_id);
                let plan = lowered.1;
                if array::length(plan.sources) != 2 || array::length(plan.joins) != 1 || plan.derived != None
                    || get_index(plan.sources, 0).alias != entity.alias {
                    fail!("endpoint pair requires the declared link-to-tenant join")
                } else {
                    let filters = resolve_filters_with_context(lowered.0, payload, [
                        {id: declared.first, subject: pair.subject, op: FilterOp::Eq, input: pair.first},
                        {id: declared.second, subject: pair.subject, op: FilterOp::Eq, input: pair.second},
                        {id: declared.first, subject: pair.subject, op: FilterOp::Eq, input: pair.second},
                        {id: declared.second, subject: pair.subject, op: FilterOp::Eq, input: pair.first},
                    ]);
                    let forward = qb::scalar(qb::ScalarFunction::And, [get_index(filters.1, 0).expr, get_index(filters.1, 1).expr]);
                    let reverse = qb::scalar(qb::ScalarFunction::And, [get_index(filters.1, 2).expr, get_index(filters.1, 3).expr]);
                    (filters.0, qb::validate({...plan, filter: append_filter_terms(plan.filter,
                        [qb::scalar(qb::ScalarFunction::Or, [forward, reverse])])}, payload.profile))
                }
            }
        }
    };

type RoleProjectionSpec = struct { relation: String, dimension: String, output: String };
type RoleFilterSpec = struct { role: String, filter: FilterRequest };

def role_key_condition: Fn(PreparedPayload, Int, Int, RelationKey, qb::Source) -> qb::JoinCondition = fn(payload, from_entity, to_entity, key, target_source) {
    match key {
        RelationKey::Eq(pair) => do {
            let source = get_index(payload.entities, from_entity);
            let target = get_index(payload.entities, to_entity);
            let left = get_index(source.fields, pair.from);
            let right = get_index(target.fields, pair.to);
            qb::on_eq(qb::column_ref(source.source, left.column), qb::column_ref(target_source, right.column))
        },
        RelationKey::And(keys) => qb::on_and(array::map(keys, fn(k) { role_key_condition(payload, from_entity, to_entity, k, target_source) })),
        RelationKey::Or(keys) => qb::on_or(array::map(keys, fn(k) { role_key_condition(payload, from_entity, to_entity, k, target_source) })),
        RelationKey::FieldEq(_) => fail!("unresolved role relation key"),
    }
};

def lower_roles: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(RoleProjectionSpec), Array(RoleFilterSpec)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, roles, role_filters) {
    if array::length(roles) == 0 || array::length(request.dimensions) == 0 || array::length(request.measures) != 0
        || array::length(request.filters) != 0 || array::length(request.ordering) != 0 {
        fail!("role projection requires base dimensions and roles without measures, filters or ordering")
    } else {
        let base = match array::find(payload.dimensions, fn(d) { d.id == get_index(request.dimensions, 0).id }) {
            Some(d) => d.entity,
            None => fail!("unknown base dimension", get_index(request.dimensions, 0).id),
        };
        let base_only = array::all(request.dimensions, fn(req) {
            array::any(payload.dimensions, fn(d) { d.id == req.id && d.entity == base })
        });
        if !base_only { fail!("role projection base dimensions must belong to one dataset") } else {
            let outputs = array::map(roles, fn(role) { role.output });
            let unique_outputs = array::all(array::enumerate(outputs), fn(indexed) {
                !array::any(array::enumerate(outputs), fn(other) { other.0 < indexed.0 && other.1 == indexed.1 })
            });
            if !unique_outputs { fail!("duplicate role projection output alias", outputs) } else {
            let lowered = lower(ctx, payload, request);
            let root = lowered.1;
            let root_names = array::flat_map(root.projection, fn(item) {
                match item {
                    qb::SelectItem::Expr(qb::Expr::Column(column)) => [column.column],
                    qb::SelectItem::NamedExpr(named) => [named.alias],
                    qb::SelectItem::Aggregate(call) => [call.alias],
                    qb::SelectItem::Computed(call) => [call.alias],
                    qb::SelectItem::Expr(_) => [],
                }
            });
            if array::any(outputs, fn(output) { array::any(root_names, fn(name) { name == output }) }) {
                fail!("role projection output conflicts with base projection", outputs, root_names)
            } else {
            let occupied = array::concat([array::map(root.sources, fn(s) { s.alias }),
                array::map(root.joins, fn(j) { j.source.alias })]);
            let addition_initial: (qb::BuildCtx, Array((qb::Join, qb::SelectItem))) =
                (qb::reserve_source_aliases(lowered.0, occupied), []);
            let additions = array::fold(array::enumerate(roles), addition_initial, fn(state, indexed) {
                let role = indexed.1;
                let relation = match array::find(payload.relations, fn(r) { r.id == role.relation && r.id != "" }) {
                    Some(r) => r,
                    None => fail!("unknown role relation", role.relation),
                };
                if relation.from != base || relation.kind != RelationKind::Safe {
                    fail!("role relation must be a grain-safe forward edge from the base dataset", role.relation)
                } else {
                    let dimension = match array::find(payload.dimensions, fn(d) { d.id == role.dimension && d.entity == relation.to }) {
                        Some(d) => d,
                        None => fail!("role dimension does not belong to relation target", role.relation, role.dimension),
                    };
                    if !dimension.authorized { fail!("role dimension is not authorized", role.dimension) } else {
                        let target = get_index(payload.entities, relation.to);
                        let allocated = entity_source_at_with_context(state.0, payload, target, `role_\{indexed.0}`);
                        let alias = allocated.1.alias;
                        let join = qb::join_on(qb::JoinKind::Inner, allocated.1, role_key_condition(payload, base, relation.to, relation.key, allocated.1));
                        let output = dimension_output_with_context(allocated.0, payload, dimension);
                        let item = qb::named_expr_item(retarget_inner_expr(output.1, target.alias, alias), role.output);
                        (output.0, array::push(state.1, (join, item)))
                    }
                }
            });
            let joins = array::map(additions.1, fn(pair) { pair.0 });
            let items = array::map(additions.1, fn(pair) { pair.1 });
            let role_initial: (qb::BuildCtx, Array(qb::Expr)) = (additions.0, []);
            let role_resolved = array::fold(role_filters, role_initial, fn(state, spec) {
                let indexed = match array::find(array::enumerate(roles), fn(pair) { pair.1.output == spec.role }) {
                    Some(pair) => pair,
                    None => fail!("role filter references an unselected role", spec.role),
                };
                let relation = match array::find(payload.relations, fn(r) { r.id == indexed.1.relation }) {
                    Some(r) => r,
                    None => fail!("unknown role relation", indexed.1.relation),
                };
                let filters = resolve_filters_with_context(state.0, payload, [spec.filter]);
                let resolved = get_index(filters.1, 0);
                if resolved.entity != relation.to {
                    fail!("role filter dimension does not belong to relation target", spec.role, spec.filter.id)
                } else {
                    let target = get_index(payload.entities, relation.to);
                    let role_join = get_index(joins, indexed.0);
                    (filters.0, array::push(state.1, retarget_inner_expr(resolved.expr, target.alias, role_join.source.alias)))
                }
            });
            let extended: qb::Plan = {...root,
                sources: array::concat([root.sources, array::map(joins, fn(j) { j.source })]),
                joins: array::concat([root.joins, joins]),
                projection: array::concat([root.projection, items]),
                filter: combine_filters(array::concat([match root.filter { Some(expr) => [expr], None => [] }, role_resolved.1])),
            };
            (role_resolved.0, qb::validate(extended, payload.profile))
            }
            }
        }
    }
};

# Additive entry: the base QueryRequest plus typed existence filters and
# aggregate-result (HAVING) predicates.
def lower_full: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(ExistsRequest), Array(HavingRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, exists_specs, having_specs) {
    lower_core(ctx, payload, request, [], exists_specs, having_specs, [], [], [])
};

# Keep a declared identity key in GROUP BY while exposing only requested
# attributes. A direct aggregate call retains HAVING after hiding the measure.
def lower_group_projection_base: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, Array(HavingRequest), Array(String), Bool, Bool, Bool) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, relation_id, having_specs, visible_dimensions, show_measure, hidden_count, all_owners) {
    if array::length(request.measures) != 1 || array::length(request.dimensions) < (if hidden_count { 1 } else { 2 })
        || (array::length(visible_dimensions) == 0 && !hidden_count)
        || (hidden_count && (!show_measure || array::length(visible_dimensions) != 0))
        || request.partition != None || array::length(request.ordering) != 0 || request.offset != None {
        fail!("group projection requires one measure, an identity and visible dimensions without ordering")
    } else {
        let dims = resolve_dimensions(payload, request.dimensions);
        let owner = get_index(dims, 0).entry.entity;
        let grouped_on_owner = array::all(dims, fn(d) { d.entry.entity == owner });
        let entity = get_index(payload.entities, owner);
        let identity = match entity.dataset {
            Some(spec) => array::all(spec.grain, fn(name) {
                array::any(entity.fields, fn(field) { field.name == name && array::any(dims, fn(d) {
                    d.entry.field == field.index && !d.entry.computed
                        && array::length(d.entry.canonical_values) == 0
                })
                })
            }),
            None => array::any(dims, fn(d) {
                d.entry.field == entity.key_field && !d.entry.computed
                    && array::length(d.entry.canonical_values) == 0
            }),
        };
        let no_omitted_scopes = array::all(dims, fn(d) { array::length(d.entry.scope) == 0 });
        let visible_valid = array::all(visible_dimensions, fn(id) {
            array::any(dims, fn(d) { d.entry.id == id && d.entry.field != entity.key_field })
        });
        let distinct_visible = array::all(array::enumerate(visible_dimensions), fn(indexed) {
            !array::any(array::enumerate(visible_dimensions), fn(other) { other.0 < indexed.0 && other.1 == indexed.1 })
        });
        if !grouped_on_owner || !identity || !visible_valid || !distinct_visible || !no_omitted_scopes {
            fail!("group projection requires the owner's full declared grain and distinct visible owner dimensions", visible_dimensions)
        } else {
            let measure = match array::find(payload.measures, fn(m) { m.id == get_index(request.measures, 0).id }) {
                Some(m) => m, None => fail!("unknown group projection measure", get_index(request.measures, 0).id),
            };
            let relation = match array::find(payload.relations, fn(r) { r.id == relation_id && r.id != "" }) {
                Some(r) => r, None => fail!("unknown group projection relation", relation_id),
            };
            let base_filters = resolve_filters_with_context(qb::build_context(), payload, request.filters).1;
            if relation.from != measure.entity || relation.to != owner
                || !array::all(base_filters, fn(f) { f.entity == measure.entity || f.entity == owner }) {
                fail!("group projection requires a named relation from filtered measure rows to the grouped owner and endpoint filters", relation_id)
            } else {
            let child_filters = array::filter(request.filters, fn(spec) {
                array::any(payload.dimensions, fn(d) { d.id == spec.id && d.entity == measure.entity })
            });
            let owner_requests = array::filter(request.filters, fn(spec) {
                array::any(payload.dimensions, fn(d) { d.id == spec.id && d.entity == owner })
            });
            let measure_request: QueryRequest = {...request, dimensions: [], filters: if all_owners { [] } else { child_filters }};
            let lowered = lower(ctx, payload, measure_request);
            let plan = lowered.1;
            if array::length(plan.sources) != 1 || array::length(plan.joins) != 0 || plan.derived != None {
                fail!("group projection measure requires a single physical source", measure.id)
            } else {
            let measure_item = get_index(plan.projection, 0);
            let aggregate = match measure_item {
                qb::SelectItem::Aggregate(call) => call,
                _ => fail!("hidden group measure must be a declared plain aggregate"),
            };
            let owner_resolved = resolve_filters_with_context(lowered.0, payload, owner_requests);
            let owner_filters = array::map(owner_resolved.1, fn(f) { f.expr });
            let having_initial: (qb::BuildCtx, Array(qb::Having)) = (owner_resolved.0, []);
            let having_built = array::fold(having_specs, having_initial, fn(state, spec) {
                let allocated = resolve_having_with_context(state.0, payload, request.measures, spec);
                let h = allocated.1;
                match h.measure {
                    qb::HavingMeasure::Ref(ref) => if ref.alias == aggregate.alias {
                        (allocated.0, array::push(state.1, {...h, measure: qb::HavingMeasure::Call(aggregate)}))
                    } else { fail!("group projection HAVING must reference its declared measure", ref.alias) },
                    qb::HavingMeasure::Call(_) => fail!("group projection requires a declared measure HAVING"),
                }
            });
            let having = having_built.1;
            let grouping = dimension_outputs_with_context(having_built.0, payload, dims);
            let visible_projection = array::map(visible_dimensions, fn(id) {
                let indexed = match array::find(array::enumerate(dims), fn(pair) { pair.1.entry.id == id }) {
                    Some(value) => value,
                    None => fail!("group projection references an unrequested dimension", id),
                };
                qb::expr_item(get_index(grouping.1, indexed.0))
            });
            let projection = if show_measure { array::push(visible_projection, measure_item) } else { visible_projection };
            let child_resolved = if all_owners { resolve_filters_with_context(grouping.0, payload, child_filters) }
                else { let empty: Array(FilterResolution) = []; (grouping.0, empty) };
            let owner_source = entity_source_at_with_context(child_resolved.0, payload, entity, entity.alias);
            let join = if all_owners {
                let child_terms = array::map(child_resolved.1, fn(f) { f.expr });
                let relation_condition = key_to_condition(payload, relation.from, relation.to, relation.key);
                let condition = if array::length(child_terms) == 0 { relation_condition }
                    else { qb::on_and(array::concat([
                        [relation_condition], array::map(child_terms, fn(expr) { qb::on_predicate(expr) })
                    ])) };
                qb::join_on(qb::JoinKind::Left, get_index(plan.sources, 0), condition)
            } else {
                qb::join_on(qb::JoinKind::Inner, owner_source.1,
                    key_to_condition(payload, relation.from, relation.to, relation.key))
            };
            let result: qb::Plan = {...plan,
                sources: if all_owners { [owner_source.1, join.source] }
                    else { array::push(plan.sources, join.source) },
                joins: [join], projection, grouping: grouping.1, having,
                filter: append_filter_terms(plan.filter, owner_filters),
            };
            (owner_source.0, qb::validate(result, payload.profile))
            }
            }
        }
    }
};

def lower_group_projection: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, Array(HavingRequest), Array(String), Bool) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, relation_id, having_specs, visible_dimensions, show_measure) {
    lower_group_projection_base(ctx, payload, request, relation_id, having_specs, visible_dimensions, show_measure, False, False)
};

# The grouped child measure is an internal witness only. Count owner identities
# whose related rows form a nonempty group satisfying the aggregate predicates.
# A zero-match owner needs a distinct all-owner/anti-existence semantics.
def lower_related_group_count_plan: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, Array(HavingRequest), Bool) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, relation_id, having_specs, all_owners) {
    if request.limit != None || request.offset != None || request.partition != None
        || array::length(request.ordering) != 0 {
        fail!("related group count cannot be ordered, paginated or partitioned")
    } else {
        let inner = lower_group_projection_base(ctx, payload, request, relation_id, having_specs, [], True, True, all_owners);
        (inner.0, qb::validate(inner.1, payload.profile))
    }
};

def lower_related_group_count: Fn(PreparedPayload, QueryRequest, String, Array(HavingRequest), Bool) -> qb::Query = fn(payload, request, relation_id, having_specs, all_owners) {
    let lowered = lower_related_group_count_plan(qb::build_context(), payload, request, relation_id, having_specs, all_owners);
    sqlite::build_query(qb::finish(lowered.0, qb::QueryPlan::GroupCount(lowered.1)))
};

def private_exists_alias: Fn(Array(qb::Source), String) -> String = fn(sources, candidate) {
    if array::any(sources, fn(source) { source.alias == candidate }) {
        private_exists_alias(sources, `\{candidate}_x`)
    } else {
        candidate
    }
};

def retarget_inner_expr: Fn(qb::Expr, String, String) -> qb::Expr = fn(expr, previous, fresh) {
    match expr {
        qb::Expr::Column(column) => qb::Expr::Column(if column.source == previous {
            {...column, source: fresh}
        } else { column }),
        qb::Expr::AllocatedBind(_) => expr,
        qb::Expr::Scalar(call) => qb::Expr::Scalar({...call,
            args: array::map(call.args, fn(arg) { retarget_inner_expr(arg, previous, fresh) })
        }),
    }
};

# Explicit one-hop business relation selection. Never falls back to a
# different edge with the same endpoint types or to an inferred route.
def lower_named_exists: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(NamedExistsRequest), Option(SiteTenantScope)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, specs, scope) {
    let lowered = lower(ctx, payload, request);
    let base_plan = lowered.1;
    if array::length(base_plan.sources) == 0 || base_plan.derived != None {
        fail!("named existence requires a physical base dataset")
    } else {
        let base_alias = get_index(base_plan.sources, 0).alias;
        let base = match array::find(payload.entities, fn(entity) { entity.alias == base_alias }) {
            Some(entity) => entity,
            None => fail!("named existence base dataset is unknown", base_alias),
        };
        let initial: (qb::BuildCtx, Array(qb::Exists)) = (lowered.0, []);
        let resolved = array::fold(specs, initial, fn(state, item) {
            if !payload.authorize(item.spec.subject) {
                fail!("named existence subject is unauthorized", item.spec.subject)
            } else {
                let target = entity_by_id(payload, item.spec.target);
                let rel = match array::find(payload.relations, fn(candidate) { candidate.id == item.relation && candidate.id != "" }) {
                    Some(candidate) => candidate,
                    None => fail!("unknown named relation", item.relation),
                };
                let reversed = rel.to == base.index && rel.from == target;
                if !(reversed || (rel.from == base.index && rel.to == target)) {
                    fail!("named relation does not connect requested datasets", item.relation, item.spec.target)
                } else {
                    let target_entry = get_index(payload.entities, target);
                    let already_joined = array::any(base_plan.joins, fn(join) { join.source.alias == target_entry.alias });
                    if already_joined {
                        let selected_join = array::any(base_plan.joins, fn(join) {
                            join.source.alias == target_entry.alias && join.kind == qb::JoinKind::Inner
                                && !reversed && join.condition == key_to_condition(payload, rel.from, rel.to, rel.key)
                        });
                        if selected_join && array::length(item.spec.filters) == 0
                            && array::length(item.spec.any_of) == 0 && item.spec.min_matches == None {
                            state
                        } else {
                            let fresh = private_exists_alias(base_plan.sources, `\{target_entry.alias}_exists`);
                            let inner_entry: EntityEntry = {...target_entry, alias: fresh,
                                source: {...target_entry.source, alias: fresh}};
                            let pairs = exists_pairs(rel.key);
                            let col_eqs = array::map(pairs, fn(pair) { exists_col_eq(base, inner_entry, pair, reversed) });
                            let existing = build_correlated_exists_with_context(state.0, payload, inner_entry, col_eqs, item.spec, target);
                            let witness = existing.1;
                            let filter = match existing.1.filter {
                                Some(expr) => Some(retarget_inner_expr(expr, target_entry.alias, fresh)),
                                None => None,
                            };
                            (existing.0, array::push(state.1, {...witness, filter}))
                        }
                    } else {
                        let pairs = exists_pairs(rel.key);
                        let col_eqs = array::map(pairs, fn(pair) { exists_col_eq(base, target_entry, pair, reversed) });
                        let existing = build_correlated_exists_with_context(state.0, payload, target_entry, col_eqs, item.spec, target);
                        (existing.0, array::push(state.1, existing.1))
                    }
                }
            }
        });
        let site_exists: (qb::BuildCtx, Array(qb::Exists)) = match scope {
            None => (resolved.0, []),
            Some(site_scope) => do {
                let next = site_tenant_scope_with_context(resolved.0, payload, base, site_scope);
                (next.0, [next.1])
            },
        };
        let updated: qb::Plan = {...base_plan, exists: array::concat([base_plan.exists, resolved.1, site_exists.1])};
        (site_exists.0, qb::validate(updated, payload.profile))
    }
};

def site_tenant_scope_with_context: Fn(qb::BuildCtx, PreparedPayload, EntityEntry, SiteTenantScope) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, owner, scope) {
    let site_relation = relation_domain(payload, scope.site_relation);
    let tenant_relation = relation_domain(payload, scope.tenant_relation);
    let site = get_index(payload.entities, site_relation.to);
    let tenant = get_index(payload.entities, tenant_relation.to);
    if site_relation.from != owner.index || site_relation.kind != RelationKind::FanOut
        || tenant_relation.from != site.index || tenant_relation.kind != RelationKind::Safe {
        fail!("site scope requires a declared owner-to-site fan-out and site-to-tenant chain")
    } else {
        let site_filters = resolve_filters_with_context(ctx, payload, scope.site_filters);
        let tenant_filters = resolve_filters_with_context(site_filters.0, payload, scope.tenant_filters);
        if !array::all(site_filters.1, fn(f) { f.entity == site.index })
            || !array::all(tenant_filters.1, fn(f) { f.entity == tenant.index }) {
            fail!("site scope filters must belong to their declared relation roles")
        } else {
            let alternatives = match site_relation.key {
                RelationKey::Or(keys) => array::map(keys, fn(key) {
                    array::map(exists_pairs(key), fn(pair) { exists_col_eq(owner, site, pair, False) })
                }),
                _ => fail!("site scope requires explicit alternative keys", scope.site_relation),
            };
            let tenant_pairs = array::map(exists_pairs(tenant_relation.key), fn(pair) {
                exists_col_eq(site, tenant, pair, False)
            });
            let filter_terms = array::concat([
                array::map(site_filters.1, fn(f) { f.expr }),
                array::map(tenant_filters.1, fn(f) { f.expr }),
            ]);
            let site_source = entity_source_at_with_context(qb::independent_query_scope(tenant_filters.0), payload, site, site.alias);
            let tenant_source = entity_source_at_with_context(site_source.0, payload, tenant, tenant.alias);
            (tenant_source.0, qb::exists_two_hop_alternatives(
                site_source.1, alternatives,
                tenant_source.1, tenant_pairs,
                combine_filters(filter_terms)))
        }
    }
};

type LinkSiteScope = struct {
    a_relation: String,
    z_relation: String,
    link_tenant_relation: String,
    device_tenant_relation: String,
    site_relation: String,
    tenant_relation: String,
    device_filters: Array(FilterRequest),
    site_filters: Array(FilterRequest),
    tenant_filters: Array(FilterRequest),
};

def endpoint_grain_complete: Fn(EntityEntry, Array(RelationPair)) -> Bool = fn(device, pairs) {
    match device.dataset {
        None => False,
        Some(dataset) => array::length(pairs) == array::length(dataset.grain)
            && relation_covers_target_grain(device, pairs),
    }
};

def endpoint_roles_distinct: Fn(EntityEntry, Array(Array(RelationPair))) -> Bool = fn(device, keys) {
    let first = array::filter(get_index(keys, 0), fn(pair) { pair.to == device.key_field });
    let second = array::filter(get_index(keys, 1), fn(pair) { pair.to == device.key_field });
    array::length(first) == 1 && array::length(second) == 1
        && get_index(first, 0).from != get_index(second, 0).from
};

# A and Z select the same Device role via two separately declared Safe keys.
# Both endpoint alternatives and Device->Site alternatives remain inside one
# EXISTS; the outer result never joins through either fan-out branch.
def lower_link_site: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, LinkSiteScope) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, scope) {
    let a = relation_domain(payload, scope.a_relation);
    let z = relation_domain(payload, scope.z_relation);
    let link = get_index(payload.entities, a.from);
    let device = get_index(payload.entities, a.to);
    let site_relation = relation_domain(payload, scope.site_relation);
    let site = get_index(payload.entities, site_relation.to);
    let tenant_relation = relation_domain(payload, scope.tenant_relation);
    let tenant = get_index(payload.entities, tenant_relation.to);
    let link_tenant = relation_domain(payload, scope.link_tenant_relation);
    let device_tenant = relation_domain(payload, scope.device_tenant_relation);
    if a.id == z.id || a.kind != RelationKind::Safe || z.kind != RelationKind::Safe
        || a.from != z.from || a.to != z.to || site_relation.from != device.index
        || site_relation.kind != RelationKind::FanOut
        || tenant_relation.from != site.index || tenant_relation.kind != RelationKind::Safe
        || link_tenant.from != link.index || device_tenant.from != device.index
        || link_tenant.to != tenant.index || device_tenant.to != tenant.index
        || link_tenant.kind != RelationKind::Safe || device_tenant.kind != RelationKind::Safe {
        fail!("link site scope requires two endpoint roles and aligned device-site-tenant relations")
    } else {
        let lt = exists_pairs(link_tenant.key);
        let dt = exists_pairs(device_tenant.key);
        let endpoint_keys = [exists_pairs(a.key), exists_pairs(z.key)];
        let complete = array::all(endpoint_keys, fn(branch) { endpoint_grain_complete(device, branch) })
            && endpoint_roles_distinct(device, endpoint_keys);
        let aligned = array::length(lt) > 0 && array::length(lt) == array::length(dt)
            && array::all(lt, fn(left) {
                array::any(dt, fn(right) { left.to == right.to
                    && array::all(endpoint_keys, fn(branch) {
                        array::any(branch, fn(pair) { pair.from == left.from && pair.to == right.from })
                    }) })
            });
        if !complete || !aligned {
            fail!("both link endpoint roles must cover complete device grain and aligned tenant identity keys")
        } else {
            let lowered = lower(ctx, payload, request);
            let plan = lowered.1;
            if array::length(plan.sources) != 1 || array::length(plan.joins) != 0 || plan.derived != None
                || get_index(plan.sources, 0).alias != link.alias {
                fail!("link site scope requires link-only result dimensions and filters")
            } else {
                let device_filters = resolve_filters_with_context(lowered.0, payload, scope.device_filters);
                let site_filters = resolve_filters_with_context(device_filters.0, payload, scope.site_filters);
                let tenant_filters = resolve_filters_with_context(site_filters.0, payload, scope.tenant_filters);
                if !array::all(device_filters.1, fn(f) { f.entity == device.index })
                    || !array::all(site_filters.1, fn(f) { f.entity == site.index })
                    || !array::all(tenant_filters.1, fn(f) { f.entity == tenant.index }) {
                    fail!("link site filters must belong to their declared relation roles")
                } else {
                    let endpoints = array::map(endpoint_keys, fn(branch) {
                        array::map(branch, fn(pair) { exists_col_eq(link, device, pair, False) })
                    });
                    let sites = match site_relation.key {
                        RelationKey::Or(keys) => array::map(keys, fn(key) {
                            array::map(exists_pairs(key), fn(pair) { exists_col_eq(device, site, pair, False) })
                        }),
                        _ => fail!("link site scope requires explicit site alternatives", scope.site_relation),
                    };
                    let tenant_pairs = array::map(exists_pairs(tenant_relation.key), fn(pair) {
                        exists_col_eq(site, tenant, pair, False)
                    });
                    let link_tenant_checks = array::map(lt, fn(pair) {
                        qb::scalar(qb::ScalarFunction::Eq, [
                            qb::column(link.source, get_index(link.fields, pair.from).column),
                            qb::column(tenant.source, get_index(tenant.fields, pair.to).column)])
                    });
                    let filter = combine_filters(array::concat([
                        link_tenant_checks,
                        array::map(device_filters.1, fn(f) { f.expr }),
                        array::map(site_filters.1, fn(f) { f.expr }),
                        array::map(tenant_filters.1, fn(f) { f.expr }),
                    ]));
                    let device_source = entity_source_at_with_context(qb::independent_query_scope(tenant_filters.0), payload, device, device.alias);
                    let site_source = entity_source_at_with_context(device_source.0, payload, site, site.alias);
                    let tenant_source = entity_source_at_with_context(site_source.0, payload, tenant, tenant.alias);
                    let qualification = qb::exists_three_hop_double_alternatives(
                        device_source.1, endpoints, site_source.1, sites,
                        tenant_source.1, tenant_pairs, filter);
                    (tenant_source.0, qb::validate({...plan, exists: array::push(plan.exists, qualification)}, payload.profile))
                }
            }
        }
    }
};

# One row per qualifying (Device, Link) association. A/Z are alternatives of
# one join, while site candidates only establish eligibility in a correlated
# EXISTS and cannot duplicate an association row.
def lower_link_device_site_rows: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, LinkSiteScope) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, scope) {
    let a = relation_domain(payload, scope.a_relation);
    let z = relation_domain(payload, scope.z_relation);
    let link = get_index(payload.entities, a.from);
    let device = get_index(payload.entities, a.to);
    let site_relation = relation_domain(payload, scope.site_relation);
    let site = get_index(payload.entities, site_relation.to);
    let tenant_relation = relation_domain(payload, scope.tenant_relation);
    let tenant = get_index(payload.entities, tenant_relation.to);
    let link_tenant = relation_domain(payload, scope.link_tenant_relation);
    let device_tenant = relation_domain(payload, scope.device_tenant_relation);
    if a.id == z.id || a.kind != RelationKind::Safe || z.kind != RelationKind::Safe
        || a.from != z.from || a.to != z.to || site_relation.from != device.index
        || site_relation.kind != RelationKind::FanOut
        || tenant_relation.from != site.index || tenant_relation.kind != RelationKind::Safe
        || link_tenant.from != link.index || device_tenant.from != device.index
        || link_tenant.to != tenant.index || device_tenant.to != tenant.index
        || link_tenant.kind != RelationKind::Safe || device_tenant.kind != RelationKind::Safe {
        fail!("link-device rows require two endpoint roles and aligned device-site-tenant relations")
    } else {
        let lt = exists_pairs(link_tenant.key);
        let dt = exists_pairs(device_tenant.key);
        let endpoint_keys = [exists_pairs(a.key), exists_pairs(z.key)];
        let complete = array::all(endpoint_keys, fn(branch) { endpoint_grain_complete(device, branch) })
            && endpoint_roles_distinct(device, endpoint_keys);
        let aligned = array::length(lt) > 0 && array::length(lt) == array::length(dt)
            && array::all(lt, fn(left) {
                array::any(dt, fn(right) { left.to == right.to
                    && array::all(endpoint_keys, fn(branch) {
                        array::any(branch, fn(pair) { pair.from == left.from && pair.to == right.from })
                    }) })
            });
        if !complete || !aligned {
            fail!("link-device rows require complete endpoint grain and aligned tenant identity keys")
        } else if array::length(request.measures) != 0 || array::length(request.dimensions) < 2
            || request.offset != None || request.partition != None {
            fail!("link-device rows require device and link dimensions without measures or partition")
        } else {
            let dimensions = resolve_dimensions(payload, request.dimensions);
            let filters = resolve_filters_with_context(qb::build_context(), payload, request.filters).1;
            let device_dimensions = array::filter(request.dimensions, fn(req) {
                array::any(payload.dimensions, fn(d) { d.id == req.id && d.entity == device.index })
            });
            let device_filters = array::filter(request.filters, fn(req) {
                array::any(payload.dimensions, fn(d) { d.id == req.id && d.entity == device.index })
            });
            if !array::all(dimensions, fn(d) { d.entry.entity == device.index || d.entry.entity == link.index })
                || !array::all(filters, fn(f) { f.entity == device.index || f.entity == link.index })
                || !array::any(dimensions, fn(d) { d.entry.entity == device.index })
                || !array::any(dimensions, fn(d) { d.entry.entity == link.index }) {
                fail!("link-device rows require projected device and link dimensions only")
            } else {
                let root_request: QueryRequest = {...request, dimensions: device_dimensions,
                    filters: device_filters, ordering: []};
                let lowered = lower(ctx, payload, root_request);
                let root = lowered.1;
                if array::length(root.sources) != 1 || array::length(root.joins) != 0
                    || root.derived != None || get_index(root.sources, 0).alias != device.alias {
                    fail!("link-device rows require a physical device base")
                } else {
                    let qualified_devices = resolve_filters_with_context(lowered.0, payload, scope.device_filters);
                    let qualified_sites = resolve_filters_with_context(qualified_devices.0, payload, scope.site_filters);
                    let qualified_tenants = resolve_filters_with_context(qualified_sites.0, payload, scope.tenant_filters);
                    if !array::all(qualified_devices.1, fn(f) { f.entity == device.index })
                        || !array::all(qualified_sites.1, fn(f) { f.entity == site.index })
                        || !array::all(qualified_tenants.1, fn(f) { f.entity == tenant.index }) {
                        fail!("link-device site filters must belong to their declared roles")
                    } else {
                        let sites = match site_relation.key {
                            RelationKey::Or(keys) => array::map(keys, fn(key) {
                                array::map(exists_pairs(key), fn(pair) { exists_col_eq(device, site, pair, False) })
                            }),
                            _ => fail!("link-device rows require explicit site alternatives", scope.site_relation),
                        };
                        let tenant_pairs = array::map(exists_pairs(tenant_relation.key), fn(pair) {
                            exists_col_eq(site, tenant, pair, False)
                        });
                        let ownership = array::concat([
                            array::map(dt, fn(pair) {
                                qb::scalar(qb::ScalarFunction::Eq, [
                                    qb::column(device.source, get_index(device.fields, pair.from).column),
                                    qb::column(tenant.source, get_index(tenant.fields, pair.to).column)])
                            }),
                            array::map(lt, fn(pair) {
                                qb::scalar(qb::ScalarFunction::Eq, [
                                    qb::column(link.source, get_index(link.fields, pair.from).column),
                                    qb::column(tenant.source, get_index(tenant.fields, pair.to).column)])
                            }),
                        ]);
                        let site_filter = combine_filters(array::concat([
                            ownership,
                            array::map(qualified_sites.1, fn(f) { f.expr }),
                            array::map(qualified_tenants.1, fn(f) { f.expr }),
                        ]));
                        let site_source = entity_source_at_with_context(qb::independent_query_scope(qualified_tenants.0), payload, site, site.alias);
                        let tenant_source = entity_source_at_with_context(site_source.0, payload, tenant, tenant.alias);
                        let qualification = qb::exists_two_hop_alternatives(
                            site_source.1, sites, tenant_source.1, tenant_pairs, site_filter);
                        let outer_ctx = qb::reserve_source_aliases(qb::independent_query_scope(tenant_source.0),
                            array::map(root.sources, fn(source) { source.alias }));
                        let link_source = entity_source_at_with_context(outer_ctx, payload, link, link.alias);
                        let join = qb::join_on(qb::JoinKind::Inner, link_source.1,
                            qb::on_or([
                                key_to_condition(payload, a.from, a.to, a.key),
                                key_to_condition(payload, z.from, z.to, z.key),
                            ]));
                        let outputs = dimension_outputs_with_context(link_source.0, payload, dimensions);
                        let projection = array::map(array::enumerate(dimensions), fn(indexed) {
                            qb::named_expr_item(get_index(outputs.1, indexed.0), indexed.1.entry.id)
                        });
                        let ordering = resolve_ordering_with_context(outputs.0, payload, request.ordering, [],
                            array::map(request.dimensions, fn(d) { d.id }));
                        let link_requests = array::filter(request.filters, fn(spec) {
                            array::any(payload.dimensions, fn(d) { d.id == spec.id && d.entity == link.index })
                        });
                        let link_resolved = resolve_filters_with_context(ordering.0, payload, link_requests);
                        let link_filters = array::map(link_resolved.1, fn(f) { f.expr });
                        (link_resolved.0, qb::validate({...root,
                            sources: array::push(root.sources, join.source), joins: [join],
                            projection, ordering: ordering.1,
                            filter: append_filter_terms(root.filter, array::concat([
                                link_filters, array::map(qualified_devices.1, fn(f) { f.expr })])),
                            exists: array::push(root.exists, qualification),
                        }, payload.profile))
                    }
                }
            }
        }
    }
};

# Child identity stays on the outer plan. A possibly non-unique contains key,
# two candidate site keys, and three declared tenant ownership roles are all
# checked inside one correlated existence condition.
def lower_child_site_scope: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, ChildSiteScope) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, scope) {
    let lowered = lower(ctx, payload, request);
    let plan = lowered.1;
    if array::length(plan.sources) != 1 || array::length(plan.joins) != 0 || plan.derived != None {
        fail!("child site scope requires a physical child root without implicit joins")
    } else {
        let child_alias = get_index(plan.sources, 0).alias;
        let child = match array::find(payload.entities, fn(e) { e.alias == child_alias }) {
            Some(e) => e, None => fail!("child site scope root is unknown", child_alias),
        };
        let count_ok = array::length(request.measures) == 0
            || (array::length(request.measures) == 1 && array::length(request.dimensions) == 0
                && array::all(request.measures, fn(req) {
                    let entry = resolve_measure_entry(payload, req).entry;
                    entry.entity == child.index && entry.field == child.key_field
                        && entry.aggregate == qb::AggregateFunction::Count
                        && entry.predicate == None && entry.computed == None
                        && array::length(entry.requires) == 0
                }));
        if !count_ok {
            fail!("child site scope supports child projection or child key count only")
        } else {
            let parent_relation = relation_domain(payload, scope.parent_relation);
            let site_relation = relation_domain(payload, scope.site_relation);
            let tenant_relation = relation_domain(payload, scope.tenant_relation);
            let child_tenant_relation = relation_domain(payload, scope.child_tenant_relation);
            let parent_tenant_relation = relation_domain(payload, scope.parent_tenant_relation);
            let parent = get_index(payload.entities, parent_relation.to);
            let site = get_index(payload.entities, site_relation.to);
            let tenant = get_index(payload.entities, tenant_relation.to);
            if parent_relation.from != child.index || parent_relation.kind != RelationKind::FanOut
                || site_relation.from != parent.index || site_relation.kind != RelationKind::FanOut
                || tenant_relation.from != site.index || tenant_relation.kind != RelationKind::Safe
                || child_tenant_relation.from != child.index || child_tenant_relation.to != tenant.index
                || child_tenant_relation.kind != RelationKind::Safe
                || parent_tenant_relation.from != parent.index || parent_tenant_relation.to != tenant.index
                || parent_tenant_relation.kind != RelationKind::Safe {
                fail!("child site scope requires a declared child-parent-site-tenant chain and both tenant ownership relations")
            } else {
                let parent_filters = resolve_filters_with_context(lowered.0, payload, scope.parent_filters);
                let site_filters = resolve_filters_with_context(parent_filters.0, payload, scope.site_filters);
                let tenant_filters = resolve_filters_with_context(site_filters.0, payload, scope.tenant_filters);
                if !array::all(parent_filters.1, fn(f) { f.entity == parent.index })
                    || !array::all(site_filters.1, fn(f) { f.entity == site.index })
                    || !array::all(tenant_filters.1, fn(f) { f.entity == tenant.index }) {
                    fail!("child site scope filters must belong to their declared relation roles")
                } else {
                    let child_pairs = array::map(exists_pairs(parent_relation.key), fn(pair) {
                        exists_col_eq(child, parent, pair, False)
                    });
                    let site_alternatives = match site_relation.key {
                        RelationKey::Or(keys) => array::map(keys, fn(key) {
                            array::map(exists_pairs(key), fn(pair) { exists_col_eq(parent, site, pair, False) })
                        }),
                        _ => fail!("child site scope requires explicit site alternatives", scope.site_relation),
                    };
                    let tenant_pairs = array::map(exists_pairs(tenant_relation.key), fn(pair) {
                        exists_col_eq(site, tenant, pair, False)
                    });
                    let alignments = array::concat([
                        array::map(exists_pairs(child_tenant_relation.key), fn(pair) {
                            exists_col_eq(child, tenant, pair, False)
                        }),
                        array::map(exists_pairs(parent_tenant_relation.key), fn(pair) {
                            exists_col_eq(parent, tenant, pair, False)
                        }),
                    ]);
                    let filters = array::concat([
                        array::map(parent_filters.1, fn(f) { f.expr }),
                        array::map(site_filters.1, fn(f) { f.expr }),
                        array::map(tenant_filters.1, fn(f) { f.expr }),
                        array::map(alignments, fn(pair) {
                            qb::scalar(qb::ScalarFunction::Eq, [
                                qb::expr_ref(pair.left),
                                qb::expr_ref(pair.right),
                            ])
                        }),
                    ]);
                    let parent_source = entity_source_at_with_context(qb::independent_query_scope(tenant_filters.0), payload, parent, parent.alias);
                    let site_source = entity_source_at_with_context(parent_source.0, payload, site, site.alias);
                    let tenant_source = entity_source_at_with_context(site_source.0, payload, tenant, tenant.alias);
                    let ex = qb::exists_three_hop_alternatives(parent_source.1, child_pairs,
                        site_source.1, site_alternatives, tenant_source.1, tenant_pairs, combine_filters(filters));
                    (tenant_source.0, qb::validate({...plan, exists: array::push(plan.exists, ex)}, payload.profile))
                }
            }
        }
    }
};

# Each qualification uses its own correlated aggregate. Independent KPI sample
# sets never join one another and therefore cannot multiply each other's rows.
def lower_timed_metric_qualifications: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(TimedMetricQualification), Option(OwnerSiteScope)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, specs, scope) {
    if array::length(specs) == 0 {
        fail!("metric qualification requires at least one condition")
    } else {
        let lowered = lower(ctx, payload, request);
        let base_plan = lowered.1;
        if array::length(base_plan.sources) == 0 || base_plan.derived != None {
            fail!("metric qualification requires a physical owner dataset")
        } else {
            let base_alias = get_index(base_plan.sources, 0).alias;
            let base = match array::find(payload.entities, fn(e) { e.alias == base_alias }) {
                Some(e) => e,
                None => fail!("metric qualification owner is unknown", base_alias),
            };
            let count_ok = array::length(request.measures) == 0 ||
                (array::length(request.measures) == 1 && array::length(request.dimensions) == 0
                    && array::all(request.measures, fn(req) {
                        let entry = resolve_measure_entry(payload, req).entry;
                        entry.entity == base.index && entry.field == base.key_field
                            && entry.aggregate == qb::AggregateFunction::Count
                            && entry.predicate == None && entry.computed == None
                            && array::length(entry.requires) == 0
                    }));
            if !count_ok {
                fail!("metric qualification supports owner projection or owner key count only")
            } else {
            let scoped_plan = match scope {
                None => lowered,
                Some(qualifier) => do {
                    let ancestor_relation = relation_domain(payload, qualifier.ancestor_relation);
                    let ancestor = get_index(payload.entities, ancestor_relation.to);
                    let scoped = owner_site_scope(lowered.0, payload, base, ancestor, qualifier);
                    let (join, ancestor_filter, site_exists) = (scoped.1, scoped.2, scoped.3);
                    let joined = array::any(base_plan.joins, fn(existing) {
                        existing.source.alias == ancestor.alias && existing.condition == join.condition
                            && existing.kind == qb::JoinKind::Inner
                    });
                    if array::length(base_plan.sources) > 2
                        || (array::length(base_plan.sources) == 2 && !joined) {
                        fail!("metric qualification scope requires only the declared safe ancestor join")
                    } else {
                        let filter = append_filter_terms(base_plan.filter, match ancestor_filter {
                            Some(expr) => [expr], None => [],
                        });
                        (scoped.0, qb::validate({...base_plan,
                            sources: if joined { base_plan.sources } else { array::push(base_plan.sources, join.source) },
                            joins: if joined { base_plan.joins } else { array::push(base_plan.joins, join) },
                            filter, exists: array::push(base_plan.exists, site_exists)}, payload.profile))
                    }
                },
            };
            let clauses_initial: (qb::BuildCtx, Array(qb::Exists)) = (scoped_plan.0, []);
            let clauses = array::fold(specs, clauses_initial, fn(state, spec) {
                let target = entity_by_id(payload, spec.dataset);
                let target_entry = get_index(payload.entities, target);
                let relation = match array::find(payload.relations, fn(r) { r.id == spec.relation && r.id != "" }) {
                    Some(r) => r,
                    None => fail!("unknown metric qualification relation", spec.relation),
                };
                if relation.from != target || relation.to != base.index || relation.kind != RelationKind::Safe {
                    fail!("metric qualification requires a named safe sample-to-owner relation", spec.relation, spec.dataset)
                } else if !relation_covers_target_grain(base, exists_pairs(relation.key)) {
                    fail!("metric qualification relation must cover the owner's complete declared grain", spec.relation, base.id)
                } else {
                    let domain = dataset_domain(payload, spec.dataset);
                    let time_name = match domain.utc_time {
                        Some(name) => name,
                        None => fail!("metric qualification dataset lacks authoritative UTC time", spec.dataset),
                    };
                    if domain.kind != DatasetKind::Metric {
                        fail!("metric qualification requires a metric dataset", spec.dataset)
                    } else {
                        let time_field = match array::find(target_entry.fields, fn(f) { f.name == time_name }) {
                            Some(f) => f,
                            None => fail!("metric qualification UTC field is missing", time_name),
                        };
                        let metric = match array::find(payload.measures, fn(m) { m.id == spec.measure && m.entity == target }) {
                            Some(m) => m,
                            None => fail!("metric qualification measure is not declared on dataset", spec.dataset, spec.measure),
                        };
                        if metric.predicate != None || metric.computed != None || array::length(metric.requires) != 0 {
                            fail!("metric qualification requires a direct dataset measure", spec.measure)
                        } else {
                            let alias = private_exists_alias(scoped_plan.1.sources, `\{target_entry.alias}_qualification`);
                            let inner_entry: EntityEntry = {...target_entry, alias,
                                source: {...target_entry.source, alias}};
                            let source = entity_source_at_with_context(qb::independent_query_scope(state.0), payload, inner_entry, alias);
                            let pairs = array::map(exists_pairs(relation.key), fn(pair) {
                                exists_col_eq(base, {...inner_entry, source: source.1}, pair, True)
                            });
                            let filters = resolve_filters_with_context(source.0, payload, spec.filters);
                            if !array::all(filters.1, fn(f) { f.entity == target }) {
                                fail!("metric qualification filters must belong to sample dataset", spec.dataset)
                            } else {
                                let filter_terms = array::map(filters.1, fn(f) {
                                    retarget_inner_expr(f.expr, target_entry.alias, alias)
                                });
                                let time_col = qb::column(source.1, time_field.column);
                                let window_values: (qb::Val, qb::Val) = match spec.window {
                                    SampleWindow::Text(bounds) => if !valid_utc_second(bounds.start)
                                        || !valid_utc_second(bounds.end) || bounds.start >= bounds.end {
                                        fail!("metric qualification requires ordered canonical UTC bounds", bounds.start, bounds.end)
                                    } else if bounds.dataset != spec.dataset
                                        || time_domain(payload, spec.dataset, time_name).encoding != TimeEncoding::CanonicalUtcSecondText {
                                        fail!("metric qualification requires a canonical UTC sample clock", spec.dataset)
                                    } else { (qb::Val::String(bounds.start), qb::Val::String(bounds.end)) },
                                    SampleWindow::Epoch(bounds) => if bounds.start >= bounds.end {
                                        fail!("metric qualification requires ordered UTC epoch-millisecond bounds", bounds.start, bounds.end)
                                    } else if bounds.dataset != spec.dataset || bounds.field != time_name
                                        || time_domain(payload, spec.dataset, time_name).encoding != TimeEncoding::UtcEpochMillis {
                                        fail!("metric qualification requires the authoritative UTC epoch-millisecond clock", spec.dataset)
                                    } else { (qb::Val::Int(bounds.start), qb::Val::Int(bounds.end)) },
                                };
                                let start_bound = qb::bind(filters.0, window_values.0);
                                let end_bound = qb::bind(start_bound.0, window_values.1);
                                let bounds = qb::scalar(qb::ScalarFunction::And, [
                                    qb::scalar(qb::ScalarFunction::Ge, [time_col, start_bound.1]),
                                    qb::scalar(qb::ScalarFunction::Lt, [time_col, end_bound.1]),
                                ]);
                                let filter = append_filter_terms(Some(bounds), filter_terms);
                                let grouping = array::map(pairs, fn(p) { qb::expr_ref(p.right) });
                                let metric_field = get_index(inner_entry.fields, metric.field);
                                let op: qb::HavingOp = match spec.op {
                                    HavingOp::Eq => qb::HavingOp::Eq,
                                    HavingOp::Ne => qb::HavingOp::Ne,
                                    HavingOp::Gt => qb::HavingOp::Gt,
                                    HavingOp::Ge => qb::HavingOp::Ge,
                                    HavingOp::Lt => qb::HavingOp::Lt,
                                    HavingOp::Le => qb::HavingOp::Le,
                                };
                                let threshold = qb::bind(end_bound.0, to_val(spec.threshold));
                                let having = [qb::having_call_bound(op, metric.aggregate,
                                    qb::column(source.1, metric_field.column), False, threshold.1)];
                                let exists = qb::exists_grouped(source.1, pairs, filter, grouping, having);
                                (threshold.0, array::push(state.1, exists))
                            }
                        }
                    }
                }
            });
            let plan = scoped_plan.1;
            (clauses.0, qb::validate({...plan, exists: array::concat([plan.exists, clauses.1])}, payload.profile))
            }
        }
    }
};

def lower_metric_qualifications: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(MetricQualification), Option(OwnerSiteScope)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, specs, scope) {
    lower_timed_metric_qualifications(ctx, payload, request, array::map(specs, fn(spec) {
        {relation: spec.relation, dataset: spec.dataset, measure: spec.measure, filters: spec.filters,
            window: SampleWindow::Text({dataset: spec.dataset, start: spec.start, end: spec.end}),
            op: spec.op, threshold: spec.threshold}
    }), scope)
};

def lower_epoch_metric_qualifications: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(EpochMetricQualification), Option(OwnerSiteScope)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, specs, scope) {
    lower_timed_metric_qualifications(ctx, payload, request, array::map(specs, fn(spec) {
        {relation: spec.relation, dataset: spec.dataset, measure: spec.measure, filters: spec.filters,
            window: SampleWindow::Epoch({dataset: spec.dataset, field: spec.field, start: spec.start, end: spec.end}),
            op: spec.op, threshold: spec.threshold}
    }), scope)
};

# A raw-sample predicate is evaluated before the sample count; qualification
# and observation use separate scoped aliases even when they share a carrier.
def timed_sample: Fn(SampleQualification) -> TimedSampleQualification = fn(spec) {
    {relation: spec.relation, dataset: spec.dataset, filters: spec.filters,
        window: SampleWindow::Text({dataset: spec.dataset, start: spec.start, end: spec.end}),
        min_matches: spec.min_matches}
};

def timed_epoch_sample: Fn(EpochSampleQualification) -> TimedSampleQualification = fn(spec) {
    {relation: spec.relation, dataset: spec.dataset, filters: spec.filters,
        window: SampleWindow::Epoch({dataset: spec.dataset, field: spec.field, start: spec.start, end: spec.end}),
        min_matches: spec.min_matches}
};

def sample_count_timed_exists: Fn(qb::BuildCtx, PreparedPayload, Array(qb::Source), EntityEntry, TimedSampleQualification, Int, qb::HavingOp) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, outer_sources, owner, spec, threshold, op) {
    let target = entity_by_id(payload, spec.dataset);
    let entry = get_index(payload.entities, target);
    let relation = relation_domain(payload, spec.relation);
    if relation.from != target || relation.to != owner.index || relation.kind != RelationKind::Safe {
        fail!("sample qualification requires a named safe sample-to-owner relation", spec.relation, spec.dataset)
    } else if !relation_covers_target_grain(owner, exists_pairs(relation.key)) {
        fail!("sample-to-owner relation must cover the owner's complete declared grain", spec.relation, owner.id)
    } else if threshold < 0 || (op == qb::HavingOp::Ge && threshold == 0) {
        fail!("sample qualification count must be positive", threshold)
    } else {
        let domain = dataset_domain(payload, spec.dataset);
        if domain.kind != DatasetKind::Metric {
            fail!("sample qualification requires a metric dataset", spec.dataset)
        } else {
            let time_name = match domain.utc_time {
                Some(name) => name,
                None => fail!("sample qualification dataset lacks authoritative UTC time", spec.dataset),
            };
            let time_field = match array::find(entry.fields, fn(f) { f.name == time_name }) {
                Some(f) => f,
                None => fail!("sample qualification UTC field is missing", time_name),
            };
            let alias = private_exists_alias(outer_sources, `\{entry.alias}_samples`);
            let inner: EntityEntry = {...entry, alias, source: {...entry.source, alias}};
            let source = entity_source_at_with_context(qb::independent_query_scope(ctx), payload, inner, alias);
            let pairs = array::map(exists_pairs(relation.key), fn(pair) {
                exists_col_eq(owner, {...inner, source: source.1}, pair, True)
            });
            let resolved = resolve_filters_with_context(source.0, payload, spec.filters);
            if !array::all(resolved.1, fn(f) { f.entity == target }) {
                fail!("sample qualification filters must belong to sample dataset", spec.dataset)
            } else {
                let filters = array::map(resolved.1, fn(f) { retarget_inner_expr(f.expr, entry.alias, alias) });
                let timestamp = qb::column(source.1, time_field.column);
                let window_values: (qb::Val, qb::Val) = match spec.window {
                    SampleWindow::Text(bounds) => if !valid_utc_second(bounds.start)
                        || !valid_utc_second(bounds.end) || bounds.start >= bounds.end {
                        fail!("sample qualification requires ordered canonical UTC bounds", bounds.start, bounds.end)
                    } else if bounds.dataset != spec.dataset
                        || time_domain(payload, spec.dataset, time_name).encoding != TimeEncoding::CanonicalUtcSecondText {
                        fail!("sample qualification requires a canonical UTC sample clock", spec.dataset)
                    } else { (qb::Val::String(bounds.start), qb::Val::String(bounds.end)) },
                    SampleWindow::Epoch(bounds) => if bounds.start >= bounds.end {
                        fail!("sample qualification requires ordered UTC epoch-millisecond bounds", bounds.start, bounds.end)
                    } else if bounds.dataset != spec.dataset || bounds.field != time_name
                        || time_domain(payload, spec.dataset, time_name).encoding != TimeEncoding::UtcEpochMillis {
                        fail!("sample qualification requires the authoritative UTC epoch-millisecond clock", spec.dataset)
                    } else { (qb::Val::Int(bounds.start), qb::Val::Int(bounds.end)) },
                };
                let start = qb::bind(resolved.0, window_values.0);
                let end = qb::bind(start.0, window_values.1);
                let bounds = qb::scalar(qb::ScalarFunction::And, [
                    qb::scalar(qb::ScalarFunction::Ge, [timestamp, start.1]),
                    qb::scalar(qb::ScalarFunction::Lt, [timestamp, end.1]),
                ]);
                let grouping = array::map(pairs, fn(p) { qb::expr_ref(p.right) });
                let count_column = if inner.key_field >= 0 {
                    get_index(inner.fields, inner.key_field).column
                } else { get_index(pairs, 0).right.column };
                let count_bound = qb::bind(end.0, qb::Val::Int(threshold));
                let having = [qb::having_call_bound(op, qb::AggregateFunction::Count,
                    qb::column(source.1, count_column), False, count_bound.1)];
                (count_bound.0, qb::exists_grouped(source.1, pairs,
                    append_filter_terms(Some(bounds), filters), grouping, having))
            }
        }
    }
};

def sample_count_exists: Fn(qb::BuildCtx, PreparedPayload, Array(qb::Source), EntityEntry, SampleQualification, Int, qb::HavingOp) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, outer_sources, owner, spec, threshold, op) {
    sample_count_timed_exists(ctx, payload, outer_sources, owner, timed_sample(spec), threshold, op)
};

def sample_qualification_exists: Fn(qb::BuildCtx, PreparedPayload, Array(qb::Source), EntityEntry, SampleQualification) -> (qb::BuildCtx, qb::Exists) =
    fn(ctx, payload, outer_sources, owner, spec) {
        sample_count_exists(ctx, payload, outer_sources, owner, spec, spec.min_matches, qb::HavingOp::Ge)
    };

def lower_sample_timed_count_ranges: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(TimedSampleCountRange)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, ranges) {
    if array::length(ranges) == 0 { fail!("sample count range requires at least one condition") }
    else {
        let lowered = lower(ctx, payload, request);
        let plan = lowered.1;
        if array::length(plan.sources) == 0 || plan.derived != None {
            fail!("sample count range requires a physical owner dataset")
        } else {
            let alias = get_index(plan.sources, 0).alias;
            let owner = match array::find(payload.entities, fn(e) { e.alias == alias }) {
                Some(e) => e,
                None => fail!("sample count range owner is unknown", alias),
            };
            let initial: (qb::BuildCtx, Array(qb::Exists)) = (lowered.0, []);
            let clauses = array::fold(ranges, initial, fn(state, range) {
                if range.min_matches < 0 || range.max_matches < 0 || range.min_matches > range.max_matches {
                    fail!("sample count range requires ordered nonnegative bounds", range.min_matches, range.max_matches)
                } else {
                    let upper = sample_count_timed_exists(state.0, payload, plan.sources, owner,
                        range.qualification, range.max_matches, qb::HavingOp::Gt);
                    if range.min_matches == 0 { (upper.0, array::push(state.1, qb::exists_not(upper.1))) }
                    else {
                        let lower = sample_count_timed_exists(upper.0, payload, plan.sources, owner,
                            range.qualification, range.min_matches, qb::HavingOp::Ge);
                        (lower.0, array::concat([state.1, [lower.1, qb::exists_not(upper.1)]]))
                    }
                }
            });
            (clauses.0, qb::validate({...plan, exists: array::concat([plan.exists, clauses.1])}, payload.profile))
        }
    }
};

def lower_sample_count_ranges: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(SampleCountRange)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, ranges) {
    lower_sample_timed_count_ranges(ctx, payload, request, array::map(ranges, fn(range) {
        {qualification: timed_sample(range.qualification), min_matches: range.min_matches, max_matches: range.max_matches}
    }))
};

def lower_sample_epoch_count_ranges: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(EpochSampleCountRange)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, ranges) {
    lower_sample_timed_count_ranges(ctx, payload, request, array::map(ranges, fn(range) {
        {qualification: timed_epoch_sample(range.qualification), min_matches: range.min_matches, max_matches: range.max_matches}
    }))
};

def lower_sample_timed_qualifications: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(TimedSampleQualification)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, specs) {
    if array::length(specs) == 0 { fail!("sample qualification requires at least one condition") }
    else {
        let lowered = lower(ctx, payload, request);
        let plan = lowered.1;
        if array::length(plan.sources) == 0 || plan.derived != None {
            fail!("sample qualification requires a physical owner dataset")
        } else {
            let alias = get_index(plan.sources, 0).alias;
            let owner = match array::find(payload.entities, fn(e) { e.alias == alias }) {
                Some(e) => e,
                None => fail!("sample qualification owner is unknown", alias),
            };
            let initial: (qb::BuildCtx, Array(qb::Exists)) = (lowered.0, []);
            let clauses = array::fold(specs, initial, fn(state, spec) {
                let next = sample_count_timed_exists(state.0, payload, plan.sources, owner, spec, spec.min_matches, qb::HavingOp::Ge);
                (next.0, array::push(state.1, next.1))
            });
            (clauses.0, qb::validate({...plan, exists: array::concat([plan.exists, clauses.1])}, payload.profile))
        }
    }
};

def lower_sample_qualifications: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(SampleQualification)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, specs) {
    lower_sample_timed_qualifications(ctx, payload, request, array::map(specs, timed_sample))
};

def lower_sample_epoch_qualifications: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(EpochSampleQualification)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, specs) {
    lower_sample_timed_qualifications(ctx, payload, request, array::map(specs, timed_epoch_sample))
};

def component_qualification_exists: Fn(qb::BuildCtx, PreparedPayload, Array(qb::Source), EntityEntry, NamedExistsRequest) -> (qb::BuildCtx, qb::Exists) =
    fn(ctx, payload, outer_sources, owner, named) {
        let spec = named.spec;
        if !payload.authorize(spec.subject) {
            fail!("component qualification subject is unauthorized", spec.subject)
        } else {
            let target = entity_by_id(payload, spec.target);
            let component = get_index(payload.entities, target);
            let relation = relation_domain(payload, named.relation);
            if relation.from != target || relation.to != owner.index || relation.kind != RelationKind::Safe {
                fail!("component qualification requires a named child-to-owner relation", named.relation, spec.target)
            } else if dataset_domain(payload, spec.target).kind == DatasetKind::Event
                && !relation_covers_target_grain(owner, exists_pairs(relation.key)) {
                fail!("event qualification relation must cover the owner's complete declared grain", named.relation, owner.id)
            } else {
                let alias = private_exists_alias(outer_sources, `\{component.alias}_component`);
                let inner: EntityEntry = {...component, alias};
                let pairs = array::map(exists_pairs(relation.key), fn(pair) { exists_col_eq(owner, inner, pair, True) });
                let existing = build_correlated_exists_with_context(ctx, payload, inner, pairs, spec, target);
                let witness = existing.1;
                let filter = match witness.filter {
                    Some(expr) => Some(retarget_inner_expr(expr, component.alias, alias)),
                    None => None,
                };
                (existing.0, {...witness, filter})
            }
        }
    };

# A non-unique component-parent reference can qualify an owner, but it cannot
# become a Safe row join. Both sides must independently resolve to the same
# tenant identity before the component is admitted into the correlated EXISTS.
def lower_timed_event_component: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, SampleWindow, String, String, String, String, String, Array(FilterRequest), Array(FilterRequest)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, window, owner_id, event_relation_id, component_relation_id,
        owner_tenant_id, component_tenant_id, owner_filters, component_filters) {
        let dataset_id = match window {
            SampleWindow::Text(bounds) => bounds.dataset,
            SampleWindow::Epoch(bounds) => bounds.dataset,
        };
        let event = get_index(payload.entities, entity_by_id(payload, dataset_id));
        let owner = get_index(payload.entities, entity_by_id(payload, owner_id));
        let event_relation = relation_domain(payload, event_relation_id);
        let component_relation = relation_domain(payload, component_relation_id);
        let component = get_index(payload.entities, component_relation.from);
        let owner_tenant = relation_domain(payload, owner_tenant_id);
        let component_tenant = relation_domain(payload, component_tenant_id);
        if dataset_domain(payload, dataset_id).kind != DatasetKind::Event
            || event_relation.from != event.index || event_relation.to != owner.index
            || event_relation.kind != RelationKind::Safe {
            fail!("event component observation requires a named safe event-to-owner relation", event_relation_id)
        } else if !relation_covers_target_grain(owner, exists_pairs(event_relation.key)) {
            fail!("event-to-owner relation must cover the owner's complete declared grain", event_relation_id, owner.id)
        } else if component_relation.to != owner.index || component_relation.kind != RelationKind::FanOut
            || owner_tenant.from != owner.index || component_tenant.from != component.index
            || owner_tenant.to != component_tenant.to || owner_tenant.kind != RelationKind::Safe
            || component_tenant.kind != RelationKind::Safe {
            fail!("event component qualification requires fan-out parent and aligned tenant ownership relations")
        } else {
            let tenant_pairs = exists_pairs(owner_tenant.key);
            let component_pairs = exists_pairs(component_tenant.key);
            let alignment = array::map(tenant_pairs, fn(left) {
                let right = match array::find(component_pairs, fn(pair) { pair.to == left.to }) {
                    Some(pair) => pair,
                    None => fail!("component tenant ownership keys do not align", owner_tenant_id, component_tenant_id),
                };
                qb::column_eq(
                    qb::column_ref(owner.source, get_index(owner.fields, left.from).column),
                    qb::column_ref(component.source, get_index(component.fields, right.from).column))
            });
            if array::length(alignment) == 0 || array::length(alignment) != array::length(component_pairs) {
                fail!("component tenant ownership keys do not align", owner_tenant_id, component_tenant_id)
            } else {
                let dimensions = resolve_dimensions(payload, request.dimensions);
                let event_dims = array::filter(request.dimensions, fn(d) {
                    array::any(payload.dimensions, fn(entry) { entry.id == d.id && entry.entity == event.index })
                });
                let owner_dims = array::filter(dimensions, fn(d) { d.entry.entity == owner.index });
                if array::length(event_dims) + array::length(owner_dims) != array::length(dimensions)
                    || (array::length(owner_dims) > 0 && (array::length(request.measures) == 0 || array::length(event_dims) > 0)) {
                    fail!("event component grouping requires owner dimensions with event measures only")
                } else { () };
                let event_request: QueryRequest = {...request, dimensions: event_dims};
                let plan = match window {
                    SampleWindow::Text(bounds) => lower_utc_window(ctx, payload, event_request, bounds),
                    SampleWindow::Epoch(bounds) => do {
                        let clock = match dataset_domain(payload, dataset_id).utc_time {
                            Some(name) => name,
                            None => fail!("event component dataset lacks authoritative UTC time", dataset_id),
                        };
                        if bounds.field != clock {
                            fail!("event component window must use the authoritative UTC clock", dataset_id, bounds.field)
                        } else { lower_utc_epoch_window(ctx, payload, event_request, bounds) }
                    },
                };
                if array::length(plan.1.sources) != 1 || array::length(plan.1.joins) != 0 || plan.1.derived != None {
                    fail!("event component observation requires event-only projections and filters")
                } else {
                    let base_plan = plan.1;
                    let owner_resolved = resolve_filters_with_context(plan.0, payload, owner_filters);
                    let component_resolved = resolve_filters_with_context(owner_resolved.0, payload, component_filters);
                    if !array::all(owner_resolved.1, fn(f) { f.entity == owner.index })
                        || !array::all(component_resolved.1, fn(f) { f.entity == component.index }) {
                        fail!("event component filters must belong to their declared owner and component roles")
                    } else {
                        let owner_source = entity_source_at_with_context(component_resolved.0, payload, owner, owner.alias);
                        let join = qb::join_on(qb::JoinKind::Inner, owner_source.1,
                            key_to_condition(payload, event.index, owner.index, event_relation.key));
                        let parent = array::map(exists_pairs(component_relation.key), fn(pair) {
                            exists_col_eq(owner, component, pair, True)
                        });
                        let component_source = entity_source_at_with_context(qb::independent_query_scope(owner_source.0), payload, component, component.alias);
                        let qualification = qb::exists(component_source.1,
                            array::concat([parent, alignment]),
                            combine_filters(array::map(component_resolved.1, fn(f) { f.expr })));
                        let visible = dimension_outputs_with_context(component_source.0, payload, owner_dims);
                        let identity = if array::length(owner_dims) == 0 { [] }
                            else { entity_grain_exprs(owner, owner_id) };
                        let hidden = array::filter(identity, fn(expr) {
                            !array::any(visible.1, fn(item) { item == expr })
                                && !array::any(plan.1.grouping, fn(item) { item == expr })
                        });
                        (visible.0, qb::validate({...base_plan, sources: array::push(base_plan.sources, join.source),
                            joins: array::push(base_plan.joins, join),
                            projection: array::concat([base_plan.projection, array::map(visible.1, qb::expr_item)]),
                            grouping: array::concat([base_plan.grouping, visible.1, hidden]),
                            filter: append_filter_terms(base_plan.filter, array::map(owner_resolved.1, fn(f) { f.expr })),
                            exists: array::push(base_plan.exists, qualification)}, payload.profile))
                    }
                }
            }
        }
    };

def lower_event_component: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, UtcWindowRequest, String, String, String, String, String, Array(FilterRequest), Array(FilterRequest)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, window, owner_id, event_relation_id, component_relation_id,
        owner_tenant_id, component_tenant_id, owner_filters, component_filters) {
        lower_timed_event_component(ctx, payload, request, SampleWindow::Text(window), owner_id, event_relation_id,
            component_relation_id, owner_tenant_id, component_tenant_id, owner_filters, component_filters)
    };

def lower_epoch_event_component: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, UtcEpochWindowRequest, String, String, String, String, String, Array(FilterRequest), Array(FilterRequest)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, window, owner_id, event_relation_id, component_relation_id,
        owner_tenant_id, component_tenant_id, owner_filters, component_filters) {
        lower_timed_event_component(ctx, payload, request, SampleWindow::Epoch(window), owner_id, event_relation_id,
            component_relation_id, owner_tenant_id, component_tenant_id, owner_filters, component_filters)
    };

def entity_grain_exprs: Fn(EntityEntry, String) -> Array(qb::Expr) = fn(entity, role) {
    let identity = match entity.dataset {
        Some(spec) => if spec.kind == DatasetKind::Entity { spec.grain }
            else { fail!("contextual observation requires declared entity grain", role) },
        None => fail!("contextual observation requires declared entity grain", role),
    };
    array::map(identity, fn(name) {
        let field = match array::find(entity.fields, fn(f) { f.name == name }) {
            Some(f) => f,
            None => fail!("prepared entity grain field is missing", role, name),
        };
        qb::column(entity.source, field.column)
    })
};

def owner_site_scope: Fn(qb::BuildCtx, PreparedPayload, EntityEntry, EntityEntry, OwnerSiteScope) -> (qb::BuildCtx, qb::Join, Option(qb::Expr), qb::Exists) =
    fn(ctx, payload, owner, ancestor, scope) {
        let ancestor_relation = relation_domain(payload, scope.ancestor_relation);
        let site_relation = relation_domain(payload, scope.site_relation);
        let tenant_relation = relation_domain(payload, scope.tenant_relation);
        let site = get_index(payload.entities, site_relation.to);
        let tenant = get_index(payload.entities, tenant_relation.to);
        if ancestor_relation.from != owner.index || ancestor_relation.to != ancestor.index
            || ancestor_relation.kind != RelationKind::Safe
            || site_relation.from != ancestor.index || site_relation.kind != RelationKind::FanOut
            || tenant_relation.from != site.index || tenant_relation.kind != RelationKind::Safe {
            fail!("sample top scope requires a safe ancestor and a declared site-to-tenant chain")
        } else if !relation_covers_target_grain(ancestor, exists_pairs(ancestor_relation.key)) {
            fail!("sample scope ancestor relation must cover its complete declared grain", scope.ancestor_relation, ancestor.id)
        } else {
            let ancestor_filters = resolve_filters_with_context(ctx, payload, scope.ancestor_filters);
            let site_filters = resolve_filters_with_context(ancestor_filters.0, payload, scope.site_filters);
            let tenant_filters = resolve_filters_with_context(site_filters.0, payload, scope.tenant_filters);
            if !array::all(ancestor_filters.1, fn(f) { f.entity == ancestor.index })
                || !array::all(site_filters.1, fn(f) { f.entity == site.index })
                || !array::all(tenant_filters.1, fn(f) { f.entity == tenant.index }) {
                fail!("sample top scope filters must belong to their declared relation roles")
            } else {
                let ancestor_source = entity_source_at_with_context(tenant_filters.0, payload, ancestor, ancestor.alias);
                let ancestor_join = qb::join_on(qb::JoinKind::Inner,
                    ancestor_source.1,
                    key_to_condition(payload, ancestor_relation.from, ancestor_relation.to, ancestor_relation.key));
                let alternatives = match site_relation.key {
                    RelationKey::Or(keys) => array::map(keys, fn(key) {
                        array::map(exists_pairs(key), fn(pair) { exists_col_eq(ancestor, site, pair, False) })
                    }),
                    _ => fail!("sample top site scope requires explicit alternative keys", scope.site_relation),
                };
                let tenant_pairs = array::map(exists_pairs(tenant_relation.key), fn(pair) {
                    exists_col_eq(site, tenant, pair, False)
                });
                let filter_terms = array::concat([
                    array::map(site_filters.1, fn(f) { f.expr }),
                    array::map(tenant_filters.1, fn(f) { f.expr }),
                ]);
                let site_source = entity_source_at_with_context(qb::independent_query_scope(ancestor_source.0), payload, site, site.alias);
                let tenant_source = entity_source_at_with_context(site_source.0, payload, tenant, tenant.alias);
                let qualification = qb::exists_two_hop_alternatives(
                    site_source.1, alternatives,
                    tenant_source.1, tenant_pairs,
                    combine_filters(filter_terms));
                (tenant_source.0, ancestor_join, combine_filters(array::map(ancestor_filters.1, fn(f) { f.expr })), qualification)
            }
        }
    };

def lower_sample_top_base: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, String, Option(SampleWindow), String, Int, Option(OwnerSiteScope)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, dataset_id, window, rank_id, take, scope) {
        let sample = get_index(payload.entities, entity_by_id(payload, dataset_id));
        let owner = get_index(payload.entities, entity_by_id(payload, owner_id));
        let relation = relation_domain(payload, relation_id);
        let spec = dataset_domain(payload, dataset_id);
        let rank = match array::find(payload.dimensions, fn(d) { d.id == rank_id }) {
            Some(d) => d,
            None => fail!("unknown sample ranking dimension", rank_id),
        };
        if spec.kind != DatasetKind::Metric || relation.from != sample.index
            || relation.to != owner.index || relation.kind != RelationKind::Safe {
            fail!("sample top requires a named grain-safe metric-to-owner relation", relation_id)
        } else if !relation_covers_target_grain(owner, exists_pairs(relation.key)) {
            fail!("sample top relation must cover the owner's complete declared grain", relation_id, owner_id)
        } else if array::length(request.measures) != 0 || array::length(request.ordering) != 0
            || request.limit != None || request.offset != None || request.partition != None {
            fail!("sample top controls ranking and cannot combine with other result stages")
        } else if !rank.authorized || rank.entity != sample.index || rank.computed
            || !array::any(request.dimensions, fn(d) { d.id == rank_id }) {
            fail!("sample ranking requires a selected raw metric dimension", rank_id)
        } else {
            let sample_dimensions = array::filter(request.dimensions, fn(d) {
                match array::find(payload.dimensions, fn(entry) { entry.id == d.id }) {
                    Some(entry) => entry.entity == sample.index,
                    None => False,
                }
            });
            if array::length(sample_dimensions) == 0 {
                fail!("sample top requires a metric sample dimension", dataset_id)
            } else {
                let remaining = array::filter(request.dimensions, fn(d) {
                    !array::any(sample_dimensions, fn(s) { s.id == d.id })
                });
                let arranged: QueryRequest = {...request, dimensions: array::concat([sample_dimensions, remaining])};
                let raw = match window {
                    Some(bounds) => match bounds {
                        SampleWindow::Text(text_bounds) => if text_bounds.dataset == dataset_id {
                            lower_utc_window(ctx, payload, arranged, text_bounds)
                        } else { fail!("sample top window must use its sample dataset", dataset_id, text_bounds.dataset) },
                        SampleWindow::Epoch(epoch_bounds) => if epoch_bounds.dataset == dataset_id {
                            lower_utc_epoch_window(ctx, payload, arranged, epoch_bounds)
                        } else { fail!("sample top window must use its sample dataset", dataset_id, epoch_bounds.dataset) },
                    },
                    None => lower(ctx, payload, arranged),
                };
                let output = array::map(request.dimensions, fn(d) { ProjectionToken::Dimension(d.id) });
                let plan = reorder_projection(payload, arranged, raw.1, output);
                let condition = key_to_condition(payload, relation.from, relation.to, relation.key);
                let joined = array::any(plan.joins, fn(j) {
                        j.source.alias == owner.alias && j.condition == condition && j.kind == qb::JoinKind::Inner
                    });
                let needs_owner = array::length(plan.sources) == 1 && array::length(plan.joins) == 0;
                if (!joined && !needs_owner) || (scope == None && array::length(plan.sources) > 2)
                    || array::length(plan.sources) > 3 {
                    fail!("sample top requires exactly the declared owner join without fan-out", relation_id)
                } else {
                    let owner_source = if joined { (raw.0, get_index(plan.sources, 1)) }
                        else { entity_source_at_with_context(raw.0, payload, owner, owner.alias) };
                    let owner_join = qb::join_on(qb::JoinKind::Inner, owner_source.1, condition);
                    let owner_sources = if joined { plan.sources } else { array::push(plan.sources, owner_join.source) };
                    let owner_joins = if joined { plan.joins } else { array::push(plan.joins, owner_join) };
                    let scoped = match scope {
                        None => (owner_source.0, owner_sources, owner_joins, plan.filter, plan.exists),
                        Some(qualifier) => do {
                            let ancestor_relation = relation_domain(payload, qualifier.ancestor_relation);
                            let ancestor = get_index(payload.entities, ancestor_relation.to);
                            let scope_result = owner_site_scope(owner_source.0, payload, owner, ancestor, qualifier);
                            let (join, ancestor_filter, site_exists) = (scope_result.1, scope_result.2, scope_result.3);
                            let ancestor_joined = array::any(owner_joins, fn(existing) {
                                existing.source.alias == ancestor.alias && existing.condition == join.condition
                                    && existing.kind == qb::JoinKind::Inner
                            });
                            if array::length(owner_sources) == 3 && !ancestor_joined {
                                fail!("sample top scope ancestor must use the named safe relation", qualifier.ancestor_relation)
                            } else { () };
                            let filter = append_filter_terms(plan.filter, match ancestor_filter {
                                Some(expr) => [expr], None => [],
                            });
                            (scope_result.0, if ancestor_joined { owner_sources } else { array::push(owner_sources, join.source) },
                                if ancestor_joined { owner_joins } else { array::push(owner_joins, join) },
                                filter, array::push(plan.exists, site_exists))
                        },
                    };
                    let owner_grain = entity_grain_exprs(owner, owner_id);
                    let sample_grain = array::map(spec.grain, fn(name) {
                        let field = match array::find(sample.fields, fn(f) { f.name == name }) {
                            Some(f) => f,
                            None => fail!("sample grain field is missing", name),
                        };
                        if !qb::is_sql_identifier(field.column) {
                            fail!("sample grain requires a mapped physical column", name)
                        } else { qb::column(sample.source, field.column) }
                    });
                    let rank_expr = dimension_expr(scoped.0, payload, rank);
                    let ordering = array::concat([
                        [qb::order_by(qb::OrderKey::Expr(rank_expr.1), qb::Ordering::Desc)],
                        array::map(sample_grain, fn(expr) {
                            qb::order_by(qb::OrderKey::Expr(expr), qb::Ordering::Asc)
                        }),
                    ]);
                    let bound = qb::take_bound(rank_expr.0, take);
                    (bound.0, qb::validate({...plan, sources: scoped.1, joins: scoped.2,
                        filter: scoped.3, exists: scoped.4,
                        partition: Some(qb::partitioned_top_n_bound(owner_grain, ordering, bound.1))}, payload.profile))
                }
            }
        }
    };

def lower_sample_top: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, UtcWindowRequest, String, Int, Option(OwnerSiteScope)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, window, rank_id, take, scope) {
        lower_sample_top_base(ctx, payload, request, owner_id, relation_id, window.dataset, Some(SampleWindow::Text(window)), rank_id, take, scope)
    };

def lower_sample_epoch_top: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, UtcEpochWindowRequest, String, Int, Option(OwnerSiteScope)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, window, rank_id, take, scope) {
        lower_sample_top_base(ctx, payload, request, owner_id, relation_id, window.dataset, Some(SampleWindow::Epoch(window)), rank_id, take, scope)
    };

def lower_latest_sample_base: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, String, Option(SampleWindow), TimeEncoding, Option(OwnerSiteScope), Option(SiteTenantScope)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, dataset_id, window, encoding, scope, site_scope) {
        let sample = get_index(payload.entities, entity_by_id(payload, dataset_id));
        let spec = dataset_domain(payload, dataset_id);
        let clock = match spec.utc_time {
            Some(name) => match array::find(sample.fields, fn(f) { f.name == name }) {
                Some(field) => field, None => fail!("latest sample requires a mapped UTC clock", dataset_id),
            },
            None => fail!("latest sample requires an authoritative UTC clock", dataset_id),
        };
        let role = match property::get_field_prop(sample.entity_type, clock.index, TimeField.type) {
            Some(value) => value, None => fail!("latest sample requires a declared UTC time role", dataset_id),
        };
        if scope != None && site_scope != None {
            fail!("latest sample cannot combine ancestor and direct site scopes")
        } else if role.semantics != TimeSemantics::Utc || role.encoding != encoding {
            fail!("latest sample requires the requested UTC time encoding", dataset_id, encoding)
        } else {
            match window {
                Some(bounds) => match bounds {
                    SampleWindow::Epoch(epoch_bounds) => if epoch_bounds.field != clock.name {
                        fail!("latest sample window must use the authoritative UTC clock", dataset_id, epoch_bounds.field)
                    } else { () },
                    SampleWindow::Text(_) => (),
                },
                None => (),
            };
            let rank = match array::find(payload.dimensions, fn(d) {
                d.entity == sample.index && !d.computed && d.field == clock.index
            }) {
                Some(d) => d, None => fail!("latest sample clock must be an exposed raw dimension", dataset_id),
            };
            let lowered = lower_sample_top_base(ctx, payload, request, owner_id, relation_id, dataset_id, window, rank.id, 1, scope);
            let plan = lowered.1;
            match site_scope {
                None => lowered,
                Some(qualifier) => do {
                    let owner = get_index(payload.entities, entity_by_id(payload, owner_id));
                    let site = site_tenant_scope_with_context(lowered.0, payload, owner, qualifier);
                    (site.0, qb::validate({...plan, exists: array::push(plan.exists, site.1)}, payload.profile))
                },
            }
        }
    };

def lower_latest_sample: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, String, Option(UtcWindowRequest), Option(OwnerSiteScope), Option(SiteTenantScope)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, dataset_id, window, scope, site_scope) {
        lower_latest_sample_base(ctx, payload, request, owner_id, relation_id, dataset_id,
            match window { Some(bounds) => Some(SampleWindow::Text(bounds)), None => None },
            TimeEncoding::CanonicalUtcSecondText, scope, site_scope)
    };

def lower_latest_epoch_sample: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, String, Option(UtcEpochWindowRequest), Option(OwnerSiteScope), Option(SiteTenantScope)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, dataset_id, window, scope, site_scope) {
        lower_latest_sample_base(ctx, payload, request, owner_id, relation_id, dataset_id,
            match window { Some(bounds) => Some(SampleWindow::Epoch(bounds)), None => None },
            TimeEncoding::UtcEpochMillis, scope, site_scope)
    };

def lower_timed_qualified_observation: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, String, Option(SampleWindow), Array(TimedSampleQualification), Array(NamedExistsRequest), Option(ComponentContextSpec), Bool) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, observation_dataset, observation, specs, components, context, require_qualification) {
        if require_qualification && array::length(specs) == 0 && array::length(components) == 0 && context == None {
            fail!("qualified observation requires a sample or component qualification or context")
        } else if context != None && array::length(components) != 0 {
            fail!("component context and component-only qualification require separate requests")
        }
        else {
            let root_id = entity_by_id(payload, observation_dataset);
            let sample_dimensions = array::filter(request.dimensions, fn(d) {
                match array::find(payload.dimensions, fn(entry) { entry.id == d.id }) {
                    Some(entry) => entry.entity == root_id,
                    None => False,
                }
            });
            let owner_dimensions = array::filter(request.dimensions, fn(d) {
                !array::any(sample_dimensions, fn(sample) { sample.id == d.id })
            });
            if array::length(request.measures) == 0 && array::length(sample_dimensions) == 0 {
                fail!("observation without a measure requires a sample dimension", observation_dataset)
            } else {
            let arranged: QueryRequest = {...request, dimensions: array::concat([sample_dimensions, owner_dimensions])};
            let raw_plan = match observation {
                None => lower(ctx, payload, arranged),
                Some(bounds) => match bounds {
                    SampleWindow::Text(text_bounds) => if text_bounds.dataset != observation_dataset {
                        fail!("observation window must use its sample dataset", observation_dataset, text_bounds.dataset)
                    } else { lower_utc_window(ctx, payload, arranged, text_bounds) },
                    SampleWindow::Epoch(epoch_bounds) => do {
                        let clock = match dataset_domain(payload, observation_dataset).utc_time {
                            Some(name) => name,
                            None => fail!("observation dataset lacks authoritative UTC time", observation_dataset),
                        };
                        if epoch_bounds.dataset != observation_dataset || epoch_bounds.field != clock {
                            fail!("observation window must use the authoritative UTC clock", observation_dataset, epoch_bounds.field)
                        } else { lower_utc_epoch_window(ctx, payload, arranged, epoch_bounds) }
                    },
                },
            };
            let output: Array(ProjectionToken) = array::concat([
                array::map(request.measures, fn(m) { ProjectionToken::Measure(m.id) }),
                array::map(request.dimensions, fn(d) { ProjectionToken::Dimension(d.id) }),
            ]);
            let plan = reorder_projection(payload, arranged, raw_plan.1, output);
            let root_alias = get_index(plan.sources, 0).alias;
            let root = match array::find(payload.entities, fn(e) { e.alias == root_alias }) {
                Some(e) => e,
                None => fail!("qualified observation root is unknown", root_alias),
            };
            let owner = get_index(payload.entities, entity_by_id(payload, owner_id));
            let relation = relation_domain(payload, relation_id);
            if relation.from != root.index || relation.to != owner.index || relation.kind != RelationKind::Safe {
                fail!("observation requires a named grain-safe sample-to-owner relation", relation_id)
            } else if !relation_covers_target_grain(owner, exists_pairs(relation.key)) {
                fail!("observation relation must cover the owner's complete declared grain", relation_id, owner_id)
            } else if root.dataset == None || dataset_domain(payload, observation_dataset).kind != DatasetKind::Metric {
                fail!("observation root must be a metric dataset", observation_dataset)
            } else {
                let condition = key_to_condition(payload, relation.from, relation.to, relation.key);
                let joined = array::any(plan.joins, fn(j) { j.source.alias == owner.alias && j.condition == condition && j.kind == qb::JoinKind::Inner });
                let conflicting = array::any(plan.sources, fn(s) { s.alias == owner.alias }) && !joined;
                if conflicting { fail!("observation owner is joined through a different relation", relation_id) }
                else {
                    let owner_source = if joined { (raw_plan.0, get_index(plan.sources, 1)) }
                        else { entity_source_at_with_context(raw_plan.0, payload, owner, owner.alias) };
                    let owner_join = qb::join_on(qb::JoinKind::Inner, owner_source.1, condition);
                    let sources = if joined { plan.sources } else { array::push(plan.sources, owner_join.source) };
                    let joins = if joined { plan.joins } else { array::push(plan.joins, owner_join) };
                    let sample_initial: (qb::BuildCtx, Array(qb::Exists)) = (owner_source.0, []);
                    let clauses = array::fold(specs, sample_initial, fn(state, spec) {
                        let next = sample_count_timed_exists(state.0, payload, sources, owner, spec, spec.min_matches, qb::HavingOp::Ge);
                        (next.0, array::push(state.1, next.1))
                    });
                    let component_initial: (qb::BuildCtx, Array(qb::Exists)) = (clauses.0, []);
                    let component_clauses = array::fold(components, component_initial, fn(state, spec) {
                        let next = component_qualification_exists(state.0, payload, sources, owner, spec);
                        (next.0, array::push(state.1, next.1))
                    });
                    let owner_dimension = array::any(request.dimensions, fn(d) {
                        match array::find(payload.dimensions, fn(entry) { entry.id == d.id }) {
                            Some(entry) => entry.entity == owner.index,
                            None => False,
                        }
                    });
                    let identity_grouping: Array(qb::Expr) = if array::length(request.measures) > 0 && (owner_dimension || context != None) {
                        entity_grain_exprs(owner, owner_id)
                    } else { [] };
                    let hidden = array::filter(identity_grouping, fn(expr) {
                        !array::any(plan.grouping, fn(group) { group == expr })
                    });
                    let qualified: qb::Plan = {...plan, sources, joins,
                        grouping: array::concat([plan.grouping, hidden]),
                        exists: array::concat([plan.exists, clauses.1, component_clauses.1])};
                    match context {
                        None => (component_clauses.0, qb::validate(qualified, payload.profile)),
                        Some(spec) => do {
                            let target = entity_by_id(payload, spec.target);
                            let child = get_index(payload.entities, target);
                            let component_relation = relation_domain(payload, spec.relation);
                            if component_relation.from != target || component_relation.to != owner.index
                                || component_relation.kind != RelationKind::Safe {
                                fail!("component context requires a named child-to-owner relation", spec.relation, spec.target)
                            } else if array::length(spec.dimensions) == 0 || array::any(sources, fn(s) { s.alias == child.alias }) {
                                fail!("component context needs visible child dimensions and a distinct source", spec.target)
                            } else {
                                let child_grain = entity_grain_exprs(child, spec.target);
                                let dims = resolve_dimensions(payload, spec.dimensions);
                                let filters = resolve_filters_with_context(component_clauses.0, payload, spec.filters);
                                if !array::all(dims, fn(d) { d.entry.entity == target && array::length(d.entry.scope) == 0 })
                                    || !array::all(filters.1, fn(f) { f.entity == target }) {
                                    fail!("component context dimensions and filters must belong to the selected child", spec.target)
                                } else {
                                    let child_source = entity_source_at_with_context(filters.0, payload, child, child.alias);
                                    let join = qb::join_on(qb::JoinKind::Inner, child_source.1,
                                        key_to_condition(payload, component_relation.from, component_relation.to, component_relation.key));
                                    let child_outputs = dimension_outputs_with_context(child_source.0, payload, dims);
                                    let child_items = array::map(array::enumerate(dims), fn(indexed) {
                                        qb::named_expr_item(get_index(child_outputs.1, indexed.0), indexed.1.entry.id)
                                    });
                                    let child_grouping = child_outputs.1;
                                    let child_hidden = array::filter(child_grain, fn(expr) {
                                        !array::any(child_grouping, fn(group) { group == expr })
                                    });
                                    let child_order = if array::length(qualified.ordering) == 0 { [] }
                                        else { array::map(child_grain, fn(expr) {
                                            qb::order_by(qb::OrderKey::Expr(expr), qb::Ordering::Asc)
                                        }) };
                                    (child_outputs.0, qb::validate({...qualified,
                                        sources: array::push(qualified.sources, join.source),
                                        joins: array::push(qualified.joins, join),
                                        projection: array::concat([qualified.projection, child_items]),
                                        filter: append_filter_terms(qualified.filter, array::map(filters.1, fn(f) { f.expr })),
                                        grouping: if array::length(request.measures) > 0 {
                                            array::concat([qualified.grouping, child_grouping, child_hidden])
                                        } else { qualified.grouping },
                                        ordering: array::concat([qualified.ordering, child_order]),
                                    }, payload.profile))
                                }
                            }
                        },
                    }
                }
            }
            }
        }
    };

def lower_qualified_observation: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, UtcWindowRequest, Array(SampleQualification), Array(NamedExistsRequest), Option(ComponentContextSpec)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, observation, specs, components, context) {
        lower_timed_qualified_observation(ctx, payload, request, owner_id, relation_id, observation.dataset, Some(SampleWindow::Text(observation)),
            array::map(specs, timed_sample), components, context, True)
    };

def lower_epoch_qualified_observation: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, UtcEpochWindowRequest, Array(EpochSampleQualification), Array(NamedExistsRequest), Option(ComponentContextSpec)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, observation, specs, components, context) {
        lower_timed_qualified_observation(ctx, payload, request, owner_id, relation_id, observation.dataset, Some(SampleWindow::Epoch(observation)),
            array::map(specs, timed_epoch_sample), components, context, True)
    };

def lower_related_observation: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, String, Option(UtcWindowRequest)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, dataset_id, window) {
        let spec = dataset_domain(payload, dataset_id);
        let clock = match spec.utc_time {
            Some(name) => name,
            None => fail!("related observation requires an authoritative UTC clock", dataset_id),
        };
        if time_domain(payload, dataset_id, clock).encoding != TimeEncoding::CanonicalUtcSecondText {
            fail!("related observation requires a canonical UTC text clock", dataset_id)
        } else { () };
        lower_timed_qualified_observation(ctx, payload, request, owner_id, relation_id, dataset_id,
            match window { Some(bounds) => Some(SampleWindow::Text(bounds)), None => None }, [], [], None, False)
    };

def peer_pair_condition: Fn(Array(qb::ColumnEq)) -> qb::Expr = fn(pairs) {
    match combine_filters(array::map(pairs, fn(pair) {
        qb::scalar(qb::ScalarFunction::Eq, [
            qb::expr_ref(pair.left),
            qb::expr_ref(pair.right)])
    })) {
        Some(expr) => expr,
        None => fail!("peer observation endpoint relation cannot be empty"),
    }
};

# A single correlated EXISTS keeps link multiplicity out of the metric samples.
# The exchange predicate ties BOTH endpoint matches to the same orientation;
# independently OR-ing owner and origin endpoint conditions is not equivalent.
def lower_peer_related_observation: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, String, Option(UtcWindowRequest), PeerObservationScope) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, dataset_id, window, scope) {
        let lowered = lower_related_observation(ctx, payload, request, owner_id, relation_id, dataset_id, window);
        let plan = lowered.1;
        let owner = get_index(payload.entities, entity_by_id(payload, owner_id));
        let hub = get_index(payload.entities, entity_by_id(payload, scope.hub));
        let origin_rel = relation_domain(payload, scope.origin_relation);
        let owner_rel = relation_domain(payload, scope.owner_relation);
        let origin = get_index(payload.entities, origin_rel.to);
        let route = match find_peer_route(payload, hub.index, origin.index, owner.index) {
            Some(value) => value,
            None => fail!("peer observation requires a declared endpoint route", scope.hub, owner_id),
        };
        let declared = match route.relations {
            Some(value) => value,
            None => fail!("peer observation requires named endpoint relations", scope.hub),
        };
        if route.origin_entity != origin.index || route.peer_entity != owner.index
            || declared.origin != scope.origin_relation || declared.peer != scope.owner_relation
            || origin_rel.from != hub.index || owner_rel.from != hub.index
            || origin_rel.kind != RelationKind::Safe || owner_rel.kind != RelationKind::Safe
            || (route.exchange && origin.index != owner.index)
            || !relation_covers_target_grain(origin, exists_pairs(origin_rel.key))
            || !relation_covers_target_grain(owner, exists_pairs(owner_rel.key)) {
            fail!("peer observation requires ordered grain-safe endpoint relations", scope.hub, scope.origin_relation, scope.owner_relation)
        } else {
            let hub_source = entity_source_at_with_context(qb::independent_query_scope(lowered.0), payload, hub, hub.alias);
            let origin_source = entity_source_at_with_context(hub_source.0, payload, origin, peer_inner_alias(origin, "o"));
            let origin_alias = origin_source.1.alias;
            let origin_a = array::map(exists_pairs(origin_rel.key), fn(pair) {
                qb::column_eq(
                    qb::column_ref(hub_source.1, get_index(hub.fields, pair.from).column),
                    qb::column_ref(origin_source.1, get_index(origin.fields, pair.to).column))
            });
            let origin_z = array::map(exists_pairs(owner_rel.key), fn(pair) {
                qb::column_eq(
                    qb::column_ref(hub_source.1, get_index(hub.fields, pair.from).column),
                    qb::column_ref(origin_source.1, get_index(origin.fields, pair.to).column))
            });
            let owner_z = array::map(exists_pairs(owner_rel.key), fn(pair) {
                exists_col_eq(owner, hub, pair, True)
            });
            let owner_a = array::map(exists_pairs(origin_rel.key), fn(pair) {
                exists_col_eq(owner, hub, pair, True)
            });
            let initial: (qb::BuildCtx, Array(qb::Expr)) = (origin_source.0, []);
            let filters = array::fold(scope.origin_filters, initial, fn(state, req) {
                let dim = peer_filter_dimension(payload, origin.index, req);
                let next = peer_attr_expr(state.0, payload, dim, req, origin_source.1);
                (next.0, array::push(state.1, next.1))
            });
            let distinct = if owner.index == origin.index {
                [qb::scalar(qb::ScalarFunction::Ne, [
                    qb::column(owner.source, get_index(owner.fields, route.peer_key).column),
                    qb::column(origin_source.1, get_index(origin.fields, route.origin_key).column)])]
            } else { [] };
            let orientation = if route.exchange {
                [qb::scalar(qb::ScalarFunction::Or, [
                    peer_pair_condition(array::concat([owner_z, origin_a])),
                    peer_pair_condition(array::concat([owner_a, origin_z]))])]
            } else { [] };
            let link_filter = combine_filters(array::concat([orientation, filters.1, distinct]));
            let exists = if route.exchange {
                let base = qb::exists_two_hop_alternatives(hub_source.1, [owner_z, owner_a],
                    origin_source.1, origin_a, link_filter);
                let link = match base.link {
                    Some(value) => {...value, pairs: [], alternatives: Some([origin_a, origin_z])},
                    None => fail!("peer observation requires a correlated link body"),
                };
                {...base, link: Some(link)}
            } else {
                qb::exists_two_hop(hub_source.1, owner_z, origin_source.1, origin_a, link_filter)
            };
            (filters.0, qb::validate({...plan, exists: array::push(plan.exists, exists)}, payload.profile))
        }
    };

def lower_related_epoch_observation: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, String, Option(UtcEpochWindowRequest)) -> (qb::BuildCtx, qb::Plan) =
    fn(ctx, payload, request, owner_id, relation_id, dataset_id, window) {
        let spec = dataset_domain(payload, dataset_id);
        let clock = match spec.utc_time {
            Some(name) => name,
            None => fail!("related observation requires an authoritative UTC clock", dataset_id),
        };
        if time_domain(payload, dataset_id, clock).encoding != TimeEncoding::UtcEpochMillis {
            fail!("related observation requires a UTC epoch-millisecond clock", dataset_id)
        } else { () };
        lower_timed_qualified_observation(ctx, payload, request, owner_id, relation_id, dataset_id,
            match window { Some(bounds) => Some(SampleWindow::Epoch(bounds)), None => None }, [], [], None, False)
    };

# Canonical UTC-second text sorts in instant order under SQLite's binary text
# ordering. Other encodings must not enter this path without an explicit model.
def utc_second_pattern: regex::Regex = regex::compile("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");

def utc_number: Fn(String) -> Int = fn(value) {
    match string::parse@[Int](value) {
        Ok(number) => number,
        Err(_) => fail!("invalid UTC numeric component", value),
    }
};

def valid_utc_second: Fn(String) -> Bool = fn(value) {
    if !regex::is_match(utc_second_pattern, value) {
        False
    } else {
        let date_time = string::split(value, "T");
        let date = string::split(get_index(date_time, 0), "-");
        let clock = string::split(get_index(date_time, 1), ":");
        let year = utc_number(get_index(date, 0));
        let month = utc_number(get_index(date, 1));
        let day = utc_number(get_index(date, 2));
        let hour = utc_number(get_index(clock, 0));
        let minute = utc_number(get_index(clock, 1));
        let seconds = string::split(get_index(clock, 2), "Z");
        let second = utc_number(get_index(seconds, 0));
        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
        let max_day = if month == 2 { if leap { 29 } else { 28 } }
            else if month == 4 || month == 6 || month == 9 || month == 11 { 30 }
            else { 31 };
        year >= 1 && month >= 1 && month <= 12 && day >= 1 && day <= max_day
            && hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59
            && second >= 0 && second <= 59
    }
};

def lower_utc_field_bounds: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, String, TimeEncoding, qb::Val, qb::Val, Option(Int)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, dataset, time_name, encoding, start, end, days) {
    let spec = dataset_domain(payload, dataset);
    let target = entity_by_id(payload, dataset);
    let dataset_entry = get_index(payload.entities, target);
    let target_dimensions = array::filter(request.dimensions, fn(d) {
        match array::find(payload.dimensions, fn(entry) { entry.id == d.id }) {
            Some(entry) => entry.entity == target,
            None => False,
        }
    });
    let other_dimensions = array::filter(request.dimensions, fn(d) {
        !array::any(target_dimensions, fn(target_d) { target_d.id == d.id })
    });
    let first_measure_on_target = match array::get(request.measures, 0) {
        None => False,
        Some(m) => match array::find(payload.measures, fn(entry) { entry.id == m.id }) {
            Some(entry) => entry.entity == target,
            None => False,
        },
    };
    if (array::length(request.measures) > 0 && !first_measure_on_target)
        || (array::length(request.measures) == 0 && array::length(target_dimensions) == 0) {
        fail!("UTC window must target the query's base dataset", dataset)
    } else { () };
    let arranged: QueryRequest = {...request, dimensions: array::concat([target_dimensions, other_dimensions])};
    let lowered = lower(ctx, payload, arranged);
    let output: Array(ProjectionToken) = array::concat([
        array::map(request.measures, fn(m) { ProjectionToken::Measure(m.id) }),
        array::map(request.dimensions, fn(d) { ProjectionToken::Dimension(d.id) }),
    ]);
    let plan = reorder_projection(payload, arranged, lowered.1, output);
    if array::length(plan.sources) == 0 || plan.derived != None
        || get_index(plan.sources, 0).alias != dataset_entry.alias {
        fail!("UTC window must target the query's base dataset", dataset)
    } else {
        let field = match array::find(dataset_entry.fields, fn(item) { item.name == time_name }) {
            Some(item) => item,
            None => fail!("unknown UTC window field", dataset, time_name),
        };
        let role = time_domain(payload, dataset, time_name);
        if role.semantics != TimeSemantics::Utc || role.encoding != encoding {
            if encoding == TimeEncoding::CanonicalUtcSecondText {
                fail!("UTC window requires a declared canonical UTC time field", dataset, time_name)
            } else {
                fail!("UTC window encoding does not match the declared UTC time field", dataset, time_name, encoding)
            }
        } else { () };
        let start_bound = qb::bind(lowered.0, start);
        let day_bound = match days {
            None => (start_bound.0, start_bound.1),
            Some(value) => do {
                let duration = qb::bind(start_bound.0, qb::Val::Int(value));
                (duration.0, qb::scalar(qb::ScalarFunction::UtcDaysAgo, [start_bound.1, duration.1]))
            },
        };
        let end_bound = qb::bind(day_bound.0, end);
        let col = qb::column(dataset_entry.source, field.column);
        let start_term = qb::scalar(qb::ScalarFunction::Ge, [col, day_bound.1]);
        let end_term = qb::scalar(qb::ScalarFunction::Lt, [col, end_bound.1]);
        let bounds = qb::scalar(qb::ScalarFunction::And, [start_term, end_term]);
        let filter = match plan.filter {
            Some(existing) => Some(qb::scalar(qb::ScalarFunction::And, [existing, bounds])),
            None => Some(bounds),
        };
        let updated: qb::Plan = {...plan, filter};
        (end_bound.0, qb::validate(updated, payload.profile))
    }
};

def lower_utc_bounds: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, String, qb::Val, qb::Val, Option(Int)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, dataset, start, end, days) {
    let spec = dataset_domain(payload, dataset);
    let time_name = match spec.utc_time {
        Some(name) => name,
        None => fail!("dataset has no authoritative UTC time field", dataset),
    };
    lower_utc_field_bounds(ctx, payload, request, dataset, time_name, TimeEncoding::CanonicalUtcSecondText, start, end, days)
};

def lower_utc_window: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, UtcWindowRequest) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, window) {
    if !valid_utc_second(window.start) || !valid_utc_second(window.end) {
        fail!("UTC window requires valid YYYY-MM-DDTHH:MM:SSZ instants", window.start, window.end)
    } else if window.start >= window.end {
        fail!("UTC window start must precede end", window.start, window.end)
    } else {
        lower_utc_bounds(ctx, payload, request, window.dataset, qb::Val::String(window.start), qb::Val::String(window.end), None)
    }
};

def lower_utc_field_window: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, UtcFieldWindowRequest) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, window) {
    if !valid_utc_second(window.start) || !valid_utc_second(window.end) {
        fail!("UTC window requires valid YYYY-MM-DDTHH:MM:SSZ instants", window.start, window.end)
    } else if window.start >= window.end {
        fail!("UTC window start must precede end", window.start, window.end)
    } else {
        lower_utc_field_bounds(ctx, payload, request, window.dataset, window.field, TimeEncoding::CanonicalUtcSecondText,
            qb::Val::String(window.start), qb::Val::String(window.end), None)
    }
};

def lower_utc_epoch_window: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, UtcEpochWindowRequest) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, window) {
    if window.start >= window.end {
        fail!("UTC epoch-millisecond window start must precede end", window.start, window.end)
    } else {
        lower_utc_field_bounds(ctx, payload, request, window.dataset, window.field, TimeEncoding::UtcEpochMillis,
            qb::Val::Int(window.start), qb::Val::Int(window.end), None)
    }
};

# Only check the supported calendar boundary; SQLite computes the actual
# shifted instant. The anchor has already passed valid_utc_second.
def utc_days_since_year_one: Fn(String) -> Int = fn(anchor) {
    let date = string::split(get_index(string::split(anchor, "T"), 0), "-");
    let year = utc_number(get_index(date, 0));
    let month = utc_number(get_index(date, 1));
    let day = utc_number(get_index(date, 2));
    let previous_year = year - 1;
    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
    let month_lengths: Array(Int) = [31, if leap { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let previous_months = array::fold(int_range(month - 1), 0, fn(acc, index) {
        acc + get_index(month_lengths, index)
    });
    previous_year * 365 + previous_year / 4 - previous_year / 100 + previous_year / 400
        + previous_months + day - 1
};

def lower_utc_days_window: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, UtcDaysWindowRequest) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, window) {
    if !valid_utc_second(window.as_of) {
        fail!("UTC relative window requires a valid YYYY-MM-DDTHH:MM:SSZ anchor", window.as_of)
    } else if window.days <= 0 || window.days > 3650 {
        fail!("UTC relative days must be between 1 and 3650", window.days)
    } else if window.days > utc_days_since_year_one(window.as_of) {
        fail!("UTC relative window begins before supported year 0001", window.as_of, window.days)
    } else {
        lower_utc_bounds(ctx, payload, request, window.dataset,
            qb::Val::String(window.as_of), qb::Val::String(window.as_of), Some(window.days))
    }
};

# Additive entry with closed OR-groups on the subject filters (AnyOf), combined
# with existence filters and HAVING predicates in a deterministic order.
def lower_any: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(AnyOfRequest), Array(ExistsRequest), Array(HavingRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, any_of_specs, exists_specs, having_specs) {
    lower_core(ctx, payload, request, any_of_specs, exists_specs, having_specs, [], [], [])
};

# Additive entry with paired-endpoint (peer) filters: the base QueryRequest plus
# one or more `PeerRequest`s that keep hub base rows whose two mutually
# exclusive endpoints are the two specified participants.  The peer predicates
# are merged with the ordinary filters (AND) in request order.
def lower_peer: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(PeerRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, peer_specs) {
    lower_core(ctx, payload, request, [], [], [], peer_specs, [], [])
};

# Grouped dimension listing with internal (non-projected) ordering aggregates.
# The request selects dimensions only (measures are empty) and, optionally,
# filters / dimension ordering tie-breakers / limit (Top N).  Each internal
# order names an authorized measure on the request base entity whose aggregate
# value orders the groups but is never projected (e.g. return only the largest
# group name, ordered by its record count).  Lowering keeps a grouped Plan whose
# projection is the dimension rows only.
def lower_internal_top: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(InternalOrderRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, internal_orders) {
    lower_core(ctx, payload, request, [], [], [], [], [], internal_orders)
};

# ---------------------------------------------------------------------------
# Closed related-aggregate references (hidden aggregate over a bounded declared
# route).  A related measure may live on the subject entity (no join) or on an
# entity reached from the subject through exactly ONE eligible declared route
# within the ontology-wide `path_depth_cap`.  The
# aggregate is used only for hidden ORDER BY/Top-N and/or hidden HAVING; it
# never enters the projection.  Grouping stays on subject dimensions so related
# rows only aggregate and never change the subject grain.  Every hop comes from
# prepared relation metadata; callers provide only the authorized measure id,
# subject and order/HAVING fields (no tables/columns/aliases/join arrays).  The
# existing direct-relation behavior is the one-hop case of this route.
# ---------------------------------------------------------------------------

# One related-aggregate route: the aggregate population entity and the ordered
# declared-relation hops from the subject to it (dependency order).
type AggregateRoute = struct {
    target: Int,
    hops: Array(Int),
};

type RelatedRouteStatus = enum {
    Same,        # aggregate population is the subject itself (no join)
    Ok(AggregateRoute),
    Missing,     # no declared route at all
    Ambiguous,   # more than one eligible bounded route
};

def connects: Fn(Int, Int, RelationEntry) -> Bool = fn(a, b, r) {
    (r.from == a && r.to == b) || (r.from == b && r.to == a)
};

# Enumerate every simple undirected traversal of declared relations from the
# subject to the aggregate population, bounded by the same cap used by prepared
# ontology paths. Entity-local visited state prevents cycles; relation order
# makes the result deterministic. Classification retains every shortest route
# for ambiguity detection instead of choosing one by declaration order; longer
# detours do not make a direct or otherwise shorter route ambiguous.
def aggregate_route_paths: Fn(Array(RelationEntry), Int, Int, Array(Bool), Array(Int), Int) -> Array(Array(Int)) =
    fn(relations, current, target, visited, path, depth) {
        if depth >= path_depth_cap {
            []
        } else {
            let enumerated = array::enumerate(relations);
            array::fold(enumerated, [], fn(acc, pair) {
                let relation = pair.1;
                let next: Option(Int) = if relation.from == current {
                    Some(relation.to)
                } else if relation.to == current {
                    Some(relation.from)
                } else {
                    None
                };
                match next {
                    None => acc,
                    Some(entity) => if visited_at(visited, entity) {
                        acc
                    } else {
                        let route = array::push(path, pair.0);
                        if entity == target {
                            array::push(acc, route)
                        } else {
                            let next_visited = set_at(visited, entity, True);
                            array::concat([acc, aggregate_route_paths(relations, entity, target, next_visited, route, depth + 1)])
                        }
                    },
                }
            })
        }
    };

def shortest_route_length: Fn(Array(Array(Int))) -> Int = fn(routes) {
    let first = array::length(get_index(routes, 0));
    array::fold(routes, first, fn(shortest, route) {
        let length = array::length(route);
        if length < shortest { length } else { shortest }
    })
};

# Pure route classifier for a related-aggregate reference: exactly one eligible
# shortest simple route within `path_depth_cap` is required. Multiple equally
# short routes are ambiguous. Never fails, so tests can assert the boundaries.
def related_route_status: Fn(PreparedPayload, Int, Int) -> RelatedRouteStatus = fn(payload, subject, target) {
    if target == subject {
        RelatedRouteStatus::Same
    } else {
        let relations = payload.relations;
        let visited: Array(Bool) = array::map(payload.entities, fn(entity) { entity.index == subject });
        let all_candidates = aggregate_route_paths(relations, subject, target, visited, [], 0);
        let candidates = if array::length(all_candidates) == 0 {
            all_candidates
        } else {
            let shortest = shortest_route_length(all_candidates);
            array::filter(all_candidates, fn(route) { array::length(route) == shortest })
        };
        let count = array::length(candidates);
        if count == 1 {
            let route: AggregateRoute = { target, hops: get_index(candidates, 0) };
            let result: RelatedRouteStatus = RelatedRouteStatus::Ok(route);
            result
        } else if count > 1 {
            RelatedRouteStatus::Ambiguous
        } else { RelatedRouteStatus::Missing }
    }
};

# Lowering-time resolver: the single eligible route or a stable attributable
# diagnostic (missing / ambiguous / unauthorized base entity).
def related_route_for: Fn(PreparedPayload, Int, Int) -> AggregateRoute = fn(payload, subject, target) {
    match related_route_status(payload, subject, target) {
        RelatedRouteStatus::Ok(route) => route,
        RelatedRouteStatus::Same => fail!("related aggregate measure lives on the subject entity and needs no route", subject),
        RelatedRouteStatus::Missing => fail!("related aggregate has no declared route from the subject entity to the aggregate entity", subject, target),
        RelatedRouteStatus::Ambiguous => fail!("related aggregate route is ambiguous: multiple bounded declared routes connect the subject and aggregate entities", subject, target),
    }
};

# Deterministic INNER join for one route hop: the prepared relation connects the
# already-visible left entity to the new right (join source) entity; forward and
# reverse declarations both map to the same column equality.
def route_hop_join: Fn(qb::BuildCtx, PreparedPayload, Int, Int, Int) -> (qb::BuildCtx, qb::Join) = fn(ctx, payload, left_entity, right_entity, rel_index) {
    let left_entry = get_index(payload.entities, left_entity);
    let right_entry = get_index(payload.entities, right_entity);
    let rel = get_index(payload.relations, rel_index);
    let from_is_left = rel.from == left_entity;
    let pairs = exists_pairs(rel.key);
    let conds = array::map(pairs, fn(pair) {
        if from_is_left {
            let left_field = get_index(left_entry.fields, pair.from);
            let right_field = get_index(right_entry.fields, pair.to);
            qb::on_eq(
                qb::column_ref(left_entry.source, left_field.column),
                qb::column_ref(right_entry.source, right_field.column),
            )
        } else {
            let right_field = get_index(right_entry.fields, pair.from);
            let left_field = get_index(left_entry.fields, pair.to);
            qb::on_eq(
                qb::column_ref(left_entry.source, left_field.column),
                qb::column_ref(right_entry.source, right_field.column),
            )
        }
    });
    let condition = if array::length(conds) == 1 {
        get_index(conds, 0)
    } else {
        qb::on_and(conds)
    };
    let source = entity_source_at_with_context(ctx, payload, right_entry, right_entry.alias);
    (source.0, qb::join_on(qb::JoinKind::Inner, source.1, condition))
};

type AggregateWalk = struct { ctx: qb::BuildCtx, current: Int, joins: Array(qb::Join) };

# Materialize the route's joins in deterministic dependency order (the hops are
# already ordered from the subject toward the aggregate population).
def aggregate_route_joins: Fn(qb::BuildCtx, PreparedPayload, Int, AggregateRoute, Array(qb::Join)) -> AggregateWalk = fn(ctx, payload, subject, route, existing) {
    let init: AggregateWalk = { ctx, current: subject, joins: existing };
    let walked = array::fold(route.hops, init, fn(acc, rel_index) {
        let rel = get_index(payload.relations, rel_index);
        let next = if rel.from == acc.current { rel.to } else { rel.from };
        let next_alias = get_index(payload.entities, next).alias;
        if array::any(acc.joins, fn(j) { j.source.alias == next_alias }) {
            {...acc, current: next}
        } else {
            let join = route_hop_join(acc.ctx, payload, acc.current, next, rel_index);
            {ctx: join.0, current: next, joins: array::push(acc.joins, join.1)}
        }
    });
    if walked.current != route.target {
        fail!("related aggregate route did not terminate at the aggregate entity", subject, route.target)
    } else {
        walked
    }
};

# A closed aggregate call for a related-measure reference.  The measure must be
# declared, plain (not computed/filtered), authorized for the subject, and --
# when it lives off the subject -- reached through exactly one eligible bounded
# declared route.
def related_measure_call: Fn(PreparedPayload, Int, String, String) -> qb::AggregateCall = fn(payload, base, subject, measure_id) {
    if !payload.authorize(subject) {
        fail!("subject is not authorized for related aggregate measure", subject, measure_id)
    } else {
        match array::find(payload.measures, fn(m) { m.id == measure_id }) {
            None => fail!("related aggregate references an unknown measure", measure_id),
            Some(entry) => do {
                if entry.computed != None {
                    fail!("related aggregate measure must be a plain measure", measure_id)
                } else if entry.predicate != None {
                    fail!("related aggregate measure must not be a filtered measure", measure_id)
                } else {
                    # When the measure lives off the subject, require exactly one
                    # eligible simple route within the ontology-wide path cap.
                    let entity_index = if entry.entity != base {
                        match related_route_status(payload, base, entry.entity) {
                            RelatedRouteStatus::Ok(_) => entry.entity,
                            RelatedRouteStatus::Same => fail!("related aggregate measure lives on the subject entity and needs no route", subject, measure_id),
                            RelatedRouteStatus::Missing => fail!("related aggregate has no declared route from the subject entity to the aggregate entity", subject, measure_id),
                            RelatedRouteStatus::Ambiguous => fail!("related aggregate route is ambiguous: multiple bounded declared routes connect the subject and aggregate entities", subject, measure_id),
                        }
                    } else {
                        entry.entity
                    };
                    let entity = get_index(payload.entities, entity_index);
                    let field = get_index(entity.fields, entry.field);
                    let call: qb::AggregateCall = {
                        function: entry.aggregate,
                        arg: qb::column(entity.source, field.column),
                        distinct: entry.input == MeasureInput::Distinct,
                        filter: None,
                        alias: entry.alias,
                    };
                    call
                }
            },
        }
    }
};

def internal_threshold_kind_ok: Fn(qb::AggregateFunction, FilterInput) -> Bool = fn(function, input) {
    match function {
        qb::AggregateFunction::Count => match input { FilterInput::Int(_) => True, _ => False },
        qb::AggregateFunction::Sum => match input { FilterInput::Int(_) => True, FilterInput::Number(_) => True, _ => False },
        qb::AggregateFunction::Avg => match input { FilterInput::Int(_) => True, FilterInput::Number(_) => True, _ => False },
        qb::AggregateFunction::Min => match input { FilterInput::Int(_) => True, FilterInput::Number(_) => True, _ => False },
        qb::AggregateFunction::Max => match input { FilterInput::Int(_) => True, FilterInput::Number(_) => True, _ => False },
    }
};

def internal_having_plan: Fn(qb::BuildCtx, PreparedPayload, Int, InternalHavingRequest) -> (qb::BuildCtx, qb::Having) = fn(ctx, payload, base, spec) {
    let call = related_measure_call(payload, base, spec.subject, spec.measure);
    if !internal_threshold_kind_ok(call.function, spec.threshold) {
        fail!("related aggregate HAVING threshold type is incompatible with the aggregate", spec.measure, spec.threshold)
    } else {
        let op: qb::HavingOp = match spec.op {
            HavingOp::Eq => qb::HavingOp::Eq,
            HavingOp::Ne => qb::HavingOp::Ne,
            HavingOp::Gt => qb::HavingOp::Gt,
            HavingOp::Ge => qb::HavingOp::Ge,
            HavingOp::Lt => qb::HavingOp::Lt,
            HavingOp::Le => qb::HavingOp::Le,
        };
        let threshold = qb::bind(ctx, to_val(spec.threshold));
        (threshold.0, qb::having_call_bound(op, call.function, call.arg, call.distinct, threshold.1))
    }
};

# Pure feasibility probe for a related-measure reference on a subject entity:
# True when the subject role is authorized and the measure is declared, plain,
# and (when it lives off the subject) reached through exactly one eligible route
# within the ontology-wide path cap. False for an unauthorized role,
# unknown/computed/filtered measure, or a missing/ambiguous route.
# Never fails.
def related_measure_ok: Fn(PreparedPayload, Int, String, String) -> Bool = fn(payload, subject, role, measure_id) {
    if !payload.authorize(role) {
        False
    } else {
        match array::find(payload.measures, fn(m) { m.id == measure_id }) {
            None => False,
            Some(entry) => do {
                if entry.computed != None || entry.predicate != None {
                    False
                } else {
                    match related_route_status(payload, subject, entry.entity) {
                        RelatedRouteStatus::Same => True,
                        RelatedRouteStatus::Ok(_) => True,
                        RelatedRouteStatus::Missing => False,
                        RelatedRouteStatus::Ambiguous => False,
                    }
                }
            },
        }
    }
};

# Lower a grouped subject listing with closed related-aggregate references.
#   request: measures empty, grouping dimensions on the subject entity;
#   internal_orders: hidden ORDER BY aggregates (Asc/Desc, Top-N via limit);
#   internal_having: hidden HAVING predicates over the related aggregates.
# Related entities (when the aggregate measure lives off the subject) are joined
# through exactly one eligible bounded declared route
# (the joins materialize in deterministic dependency order; the same route serves
# hidden ORDER BY/Top-N and hidden HAVING); grouping keeps the subject grain, so
# related rows only aggregate and never add output rows.  The projection is
# exactly the requested dimensions; hidden aggregates never appear in it.
def lower_internal_related: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(InternalOrderRequest), Array(InternalHavingRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, internal_orders, internal_having) {
    if array::length(request.measures) > 0 {
        fail!("related aggregate lowering requires a measureless request")
    } else if array::length(request.dimensions) == 0 {
        fail!("related aggregate lowering requires subject grouping dimensions")
    } else if request.partition != None {
        fail!("related aggregate lowering does not combine with top per group")
    } else {
        let dimensions = resolve_dimensions(payload, request.dimensions);
        let base = get_index(dimensions, 0).entry.entity;
        let dims_on_base = array::all(dimensions, fn(d) { d.entry.entity == base });
        if !dims_on_base {
            fail!("related aggregate lowering cannot prove subject grain: grouping dimensions must belong to the subject entity")
        } else {
            # Filter dimensions must also be subject-level (base columns), so the
            # lowering never needs an extra relation to interpret the predicate.
            let filter_resolutions = resolve_filters_with_context(ctx, payload, request.filters);
            let filters_on_base = array::all(filter_resolutions.1, fn(f) { f.entity == base });
            if !filters_on_base {
                fail!("related aggregate filters must reference the subject entity (unprovable grain)", request.filters)
            } else {
                let scope_initial: (qb::BuildCtx, Array(FilterResolution)) = (filter_resolutions.0, []);
                let scope_resolutions = array::fold(dimensions, scope_initial, fn(state, d) {
                    array::fold(d.entry.scope, state, fn(inner, p) {
                        let resolved = resolve_scope_with_context(inner.0, payload, d.entry, p, True);
                        (resolved.0, array::push(inner.1, resolved.1))
                    })
                });
                let filter_expr = combined_filter(scope_resolutions.1, filter_resolutions.1);
                let order_calls = array::map(internal_orders, fn(spec) {
                    let call = related_measure_call(payload, base, spec.subject, spec.measure);
                    let key: qb::OrderKey = qb::OrderKey::Aggregate(call);
                    qb::order_by(key, to_qb_ordering(spec.direction))
                });
                let dim_orders = resolve_grouped_dim_orders_with_context(scope_resolutions.0, payload, request);
                let ordering = array::concat([order_calls, dim_orders.1]);
                let having_initial: (qb::BuildCtx, Array(qb::Having)) = (dim_orders.0, []);
                let having_plans = array::fold(internal_having, having_initial, fn(state, spec) {
                    let next = internal_having_plan(state.0, payload, base, spec);
                    (next.0, array::push(state.1, next.1))
                });
                let ref_entities = array::concat([
                    array::map(internal_orders, fn(spec) {
                        match array::find(payload.measures, fn(m) { m.id == spec.measure }) {
                            Some(entry) => entry.entity,
                            None => fail!("related aggregate references an unknown measure", spec.measure),
                        }
                    }),
                    array::map(internal_having, fn(spec) {
                        match array::find(payload.measures, fn(m) { m.id == spec.measure }) {
                            Some(entry) => entry.entity,
                            None => fail!("related aggregate references an unknown measure", spec.measure),
                        }
                    }),
                ]);
                let related_entities = array::fold(ref_entities, [], fn(acc, entity) {
                    if entity == base || array::any(acc, fn(e) { e == entity }) {
                        acc
                    } else {
                        array::push(acc, entity)
                    }
                });
                # Resolve each off-subject aggregate population's unique eligible
                # route and materialize its joins in deterministic dependency
                # order; joins already present by source alias are reused.
                let base_entry = get_index(payload.entities, base);
                let base_source = entity_source_at_with_context(having_plans.0, payload, base_entry, base_entry.alias);
                let none_joins: Array(qb::Join) = [];
                let routed = array::fold(related_entities, (base_source.0, none_joins), fn(acc, entity) {
                    let route = related_route_for(payload, base, entity);
                    let walked = aggregate_route_joins(acc.0, payload, base, route, acc.1);
                    (walked.ctx, walked.joins)
                });
                let joins = routed.1;
                let join_sources = array::map(joins, fn(j) { j.source });
                let sources = array::concat([[base_source.1], join_sources]);
                let dimension_outputs = dimension_outputs_with_context(routed.0, payload, dimensions);
                let projection = array::map(dimension_outputs.1, qb::expr_item);
                let grouping = dimension_outputs.1;
                let limit = match request.limit {
                    Some(value) => do {
                        let allocated = qb::page_bound(dimension_outputs.0, value);
                        (allocated.0, Some(allocated.1))
                    },
                    None => (dimension_outputs.0, None),
                };
                let offset = match check_offset(request.offset, array::length(request.ordering)) {
                    Some(value) => do {
                        let allocated = qb::page_bound(limit.0, value);
                        (allocated.0, Some(allocated.1))
                    },
                    None => (limit.0, None),
                };
                let plan: qb::Plan = {
                    revision: payload.revision,
                    sources,
                    derived: None,
                    projection,
                    filter: filter_expr,
                    exists: [],
                    joins,
                    grouping,
                    having: having_plans.1,
                    ordering,
                    limit: limit.1,
                    offset: offset.1,
                    partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
                };
                (offset.0, qb::validate(plan, payload.profile))
            }
        }
    }
};

# Hidden same-source aggregate HAVING: a grouped (aggregated) request may carry
# zero or more HAVING predicates over authorized, plain measures of its proven
# base entity that are NOT projected.  The hidden measure still participates in
# grouping/HAVING validation and SQL generation but never appears in the
# projection.  Multiple predicates AND with deterministic order and binding
# order.  Computed/filtered/unknown/unauthorized/cross-entity measures and
# ungrouped requests fail atomically.
def lower_hidden_having: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(InternalHavingRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, hidden_having) {
    if array::length(request.measures) == 0 {
        fail!("hidden aggregate HAVING requires an aggregated (grouped) request with at least one measure")
    } else if array::length(request.dimensions) == 0 {
        fail!("hidden aggregate HAVING requires grouping dimensions")
    } else {
        let base = request_subject_entity(payload, request);
        let lowered = lower_core(ctx, payload, request, [], [], [], [], [], []);
        let base_plan = lowered.1;
        if array::length(hidden_having) == 0 {
            lowered
        } else {
            let initial: (qb::BuildCtx, Array(qb::Having)) = (lowered.0, []);
            let hidden = array::fold(hidden_having, initial, fn(state, spec) {
                let next = internal_having_plan(state.0, payload, base, spec);
                (next.0, array::push(state.1, next.1))
            });
            let having = array::concat([base_plan.having, hidden.1]);
            let rebuilt = base_plan <~ { having };
            (hidden.0, qb::validate(rebuilt, payload.profile))
        }
    }
};

# Pure feasibility probe for a same-source hidden HAVING measure on a subject
# entity: True when the role is authorized and the measure is declared, plain,
# and lives on the subject itself; False for unknown/computed/filtered/unauthorized
# or a cross-entity measure.  Never fails.
def same_source_having_ok: Fn(PreparedPayload, Int, String, String) -> Bool = fn(payload, subject, role, measure_id) {
    if !payload.authorize(role) {
        False
    } else {
        match array::find(payload.measures, fn(m) { m.id == measure_id }) {
            None => False,
            Some(entry) => entry.computed == None && entry.predicate == None && entry.entity == subject,
        }
    }
};

# A closed attribute-versus-scalar-aggregate comparison: keeps the base rows of
# a measureless row-level request whose outer plain attribute value satisfies a
# closed comparison against ONE scalar aggregate computed by a separately
# validated inner measure (possibly on another entity's own grain).  The ordered
# `scope_filters` narrow the INNER aggregate's own rows (each filter references a
# declared, authorized, filterable dimension of the inner measure's own entity
# and vocabulary; it is never resolved against the outer attribute entity and
# never moved into the outer plan filter).  Empty scope preserves the global
# aggregate behavior.  No natural-language quantifier ("any"/"all") is
# interpreted here.
type ScalarCompareRequest = struct {
    attribute: String,   # an authorized, plain dimension of the request base entity
    subject: String,
    op: HavingOp,
    measure: String,     # an authorized, plain (simple) declared measure
    scope_filters: Array(FilterRequest),  # ordered inner scope filters (empty = unscoped)
};

def having_op_scalar_function: Fn(HavingOp) -> qb::ScalarFunction = fn(op) {
    match op {
        HavingOp::Eq => qb::ScalarFunction::Eq,
        HavingOp::Ne => qb::ScalarFunction::Ne,
        HavingOp::Lt => qb::ScalarFunction::Lt,
        HavingOp::Le => qb::ScalarFunction::Le,
        HavingOp::Gt => qb::ScalarFunction::Gt,
        HavingOp::Ge => qb::ScalarFunction::Ge,
    }
};

# Field type category, resolved from the prepared field's Type metadata through
# std/type-desc reflection (never inferred from filterability, operator lists,
# names, key flags or sample values).  Int and Float form the intentionally
# supported closed numeric family of this public contract.
def field_is_numeric: Fn(EntityEntry, Int) -> Bool = fn(entity, field_index) {
    let field = get_index(entity.fields, field_index);
    let kind = td::kind(field.ty);
    match kind {
        td::TypeDescKind::Int => True,
        td::TypeDescKind::Float => True,
        _ => False,
    }
};

# Aggregate result category from the declared aggregate's result semantics:
# Count is integer; Sum/Avg require a numeric column and produce a numeric
# result; Min/Max preserve the comparable category of their (numeric) input
# column.  The aggregate call itself never infers from sample values.
def measure_numeric_result: Fn(PreparedPayload, MeasureEntry) -> Bool = fn(payload, entry) {
    match entry.aggregate {
        qb::AggregateFunction::Count => True,
        qb::AggregateFunction::Sum => True,
        qb::AggregateFunction::Avg => True,
        _ => field_is_numeric(get_index(payload.entities, entry.entity), entry.field),
    }
};

# Closed type compatibility for an attribute-versus-aggregate comparison: the
# outer attribute's prepared field type and the inner aggregate result must
# both be members of the numeric family.  Any other cross-category pair (text
# vs number, enum vs number, ...) is rejected.
def compare_categories_compatible: Fn(PreparedPayload, Int, DimensionEntry, MeasureEntry) -> Bool = fn(payload, base, attr, inner) {
    let base_entry = get_index(payload.entities, base);
    field_is_numeric(base_entry, attr.field) && measure_numeric_result(payload, inner)
};

# Value-level validation for one scope filter against a resolved dimension:
# enum domains accept only FilterOp.Eq over a member stable value; text search
# operators require a FilterInput.Text value and the dimension's declared input kinds; all
# other operators require an allowed input kind.
def scope_filter_value_ok: Fn(DimensionEntry, FilterOp, FilterInput) -> Bool = fn(d, op, input) {
    if array::length(d.canonical_values) > 0 {
        match (op, input) {
            (FilterOp::Eq, FilterInput::Text(s)) => array::any(d.canonical_values, fn(v) { v.id == s }),
            (FilterOp::Ne, FilterInput::Text(s)) => array::any(d.canonical_values, fn(v) { v.id == s }),
            _ => False,
        }
    } else if array::length(d.values) > 0 {
        match op {
            FilterOp::Eq => match input {
                FilterInput::Text(s) => array::any(d.values, fn(v) { v.value == s }),
                _ => False,
            },
            _ => False,
        }
    } else if is_text_op(op) {
        match input {
            FilterInput::Text(_) => filter_input_allowed(d.input_kinds, input),
            _ => False,
        }
    } else {
        filter_input_allowed(d.input_kinds, input)
    }
};

# Pure feasibility check for ONE inner scope filter: the filter must belong to
# the inner measure's own entity and vocabulary (unknown/unauthorized/
# unfilterable/cross-entity dimensions, unsupported operators and invalid
# input types are all rejected).  Never fails.
def scope_filter_ok: Fn(PreparedPayload, Int, FilterRequest) -> Bool = fn(payload, inner, spec) {
    if !payload.authorize(spec.subject) {
        False
    } else {
        match array::find(payload.dimensions, fn(d) { d.id == spec.id }) {
            None => False,
            Some(d) => d.entity == inner && d.authorized && d.filterable
                && array::any(d.ops, fn(op) { op == spec.op })
                && scope_filter_value_ok(d, spec.op, spec.input),
        }
    }
};

# Resolve ONE ordered scope filter against the inner measure's own entity.  The
# expression is built over the inner entity's own prepared alias (the scalar
# subquery's single source), so it narrows only the inner aggregate's rows and
# is never moved into the outer plan filter nor resolved against the outer
# attribute entity.  Scope filters never authorize joins, grouping, nested
# scalar comparisons, raw SQL, aliases, tables or open expressions.

# Combine the ordered scope filters into one deterministic left-associative AND
# expression (empty scope yields None, preserving the global aggregate shape).
# Binding order inside the subquery follows the filters' declared order.

def resolve_comparison_scope_with_context: Fn(qb::BuildCtx, PreparedPayload, Int, Array(FilterRequest)) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, payload, inner, scope_filters) {
    let initial: (qb::BuildCtx, Array(qb::Expr)) = (ctx, []);
    let resolved = array::fold(scope_filters, initial, fn(state, spec) {
        if !payload.authorize(spec.subject) {
            fail!("subject is not authorized for comparison scope filter", spec.subject, spec.id)
        } else {
            let dimension = match array::find(payload.dimensions, fn(d) { d.id == spec.id }) {
                Some(value) => value,
                None => fail!("comparison scope filter references an unknown dimension", spec.id),
            };
            if dimension.entity != inner {
                fail!("comparison scope filter must reference the inner measure's own entity", spec.id)
            } else if !dimension.authorized {
                fail!("comparison scope filter references a dimension that is not authorized", dimension.id)
            } else if !dimension.filterable {
                fail!("comparison scope filter references a dimension with no filter capability", dimension.id)
            } else if !array::any(dimension.ops, fn(op) { op == spec.op }) {
                fail!("comparison scope filter uses an operation not supported by the dimension", dimension.id, spec.op)
            } else {
                let next = filter_value_with_context(state.0, payload, dimension, spec.op, spec.input);
                (next.0, array::push(state.1, next.1))
            }
        }
    });
    (resolved.0, append_filter_terms(None, resolved.1))
};

# Resolve one comparison to a Plan-level scalar aggregate comparison: the outer
# side is the base entity's plain column attribute, the inner side is the
# measure's entity with its declared aggregate over the measure's column and the
# ordered inner scope filters (each against the inner measure's own entity).
def resolve_scalar_compare: Fn(qb::BuildCtx, PreparedPayload, Int, ScalarCompareRequest) -> (qb::BuildCtx, qb::ScalarAggregateComparison) = fn(ctx, payload, base, spec) {
    if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for attribute-versus-aggregate comparison", spec.subject, spec.attribute)
    } else {
        let attr = match array::find(payload.dimensions, fn(d) { d.id == spec.attribute }) {
            Some(d) => d,
            None => fail!("attribute-versus-aggregate comparison references an unknown attribute", spec.attribute),
        };
        if attr.computed {
            fail!("attribute-versus-aggregate outer attribute must be a plain column-backed dimension", spec.attribute)
        } else if !attr.authorized {
            fail!("attribute-versus-aggregate outer attribute is not authorized", spec.attribute)
        } else if attr.entity != base {
            fail!("attribute-versus-aggregate outer attribute must belong to the request base entity", spec.attribute)
        } else {
            let inner = match array::find(payload.measures, fn(m) { m.id == spec.measure }) {
                Some(m) => m,
                None => fail!("attribute-versus-aggregate comparison references an unknown measure", spec.measure),
            };
            if inner.computed != None {
                fail!("attribute-versus-aggregate inner measure must be a plain aggregate", spec.measure)
            } else if inner.predicate != None {
                fail!("attribute-versus-aggregate inner measure must be a simple aggregate", spec.measure)
            } else if !compare_categories_compatible(payload, base, attr, inner) {
                fail!("attribute-versus-aggregate comparison requires compatible numeric types on both sides", spec.attribute, spec.measure)
            } else {
                let base_entry = get_index(payload.entities, base);
                let attr_field = get_index(base_entry.fields, attr.field);
                let outer_ref = qb::column_ref(base_entry.source, attr_field.column);
                let inner_entry = get_index(payload.entities, inner.entity);
                let inner_field = get_index(inner_entry.fields, inner.field);
                let inner_filter = resolve_comparison_scope_with_context(ctx, payload, inner.entity, spec.scope_filters);
                let inner_source = entity_source_at_with_context(qb::independent_query_scope(inner_filter.0), payload, inner_entry, inner_entry.alias);
                let inner_spec = qb::scalar_subquery_spec(
                    inner_source.1,
                    [],
                    inner_filter.1,
                    inner.aggregate,
                    qb::column(inner_entry.source, inner_field.column),
                    False,
                    None,
                );
                (inner_source.0, qb::scalar_aggregate_comparison(outer_ref, having_op_scalar_function(spec.op), inner_spec))
            }
        }
    }
};

# Pure feasibility probe for one comparison: True when the role is authorized,
# the outer attribute is an authorized, plain, base-entity dimension, the inner
# measure is declared, plain and simple, AND the two sides are type-compatible
# (both members of the numeric family per prepared field Type metadata and the
# aggregate result semantics).  False otherwise; never fails.
def attribute_compare_ok: Fn(PreparedPayload, Int, String, String, String) -> Bool = fn(payload, base, role, attribute_id, measure_id) {
    if !payload.authorize(role) {
        False
    } else {
        let attr = array::find(payload.dimensions, fn(d) { d.id == attribute_id });
        let measure = array::find(payload.measures, fn(m) { m.id == measure_id });
        match (attr, measure) {
            (Some(d), Some(m)) => !d.computed && d.authorized && d.entity == base
                && m.computed == None && m.predicate == None
                && compare_categories_compatible(payload, base, d, m),
            _ => False,
        }
    }
};

# Scoped feasibility probe: like `attribute_compare_ok`, plus every ordered
# scope filter must satisfy the complete filter/ownership contract against the
# inner measure's own entity (authorization, ownership, filterability, operator
# and value/type compatibility).  Never fails; False for any violation.
def scoped_attribute_compare_ok: Fn(PreparedPayload, Int, String, String, String, Array(FilterRequest)) -> Bool = fn(payload, base, role, attribute_id, measure_id, scope_filters) {
    if !payload.authorize(role) {
        False
    } else {
        let attr = array::find(payload.dimensions, fn(d) { d.id == attribute_id });
        let measure = array::find(payload.measures, fn(m) { m.id == measure_id });
        match (attr, measure) {
            (Some(d), Some(m)) => if !(!d.computed && d.authorized && d.entity == base
                && m.computed == None && m.predicate == None
                && compare_categories_compatible(payload, base, d, m)) {
                False
            } else {
                array::all(scope_filters, fn(f) { scope_filter_ok(payload, m.entity, f) })
            },
            _ => False,
        }
    }
};

# Additive entry: a measureless row-level (listing) request whose base rows are
# kept when every ordered attribute-versus-aggregate comparison holds.  The
# requested dimensions are projected unchanged; the comparisons render as
# Plan-level scalar aggregate subqueries in WHERE with deterministic order and
# native NULL semantics.
def lower_attribute_compare: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(ScalarCompareRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, comparisons) {
    if array::length(request.measures) > 0 {
        fail!("attribute-versus-aggregate comparison requires a measureless row-level request")
    } else if array::length(request.dimensions) == 0 {
        fail!("attribute-versus-aggregate comparison requires at least one listing dimension")
    } else {
        let base = request_subject_entity(payload, request);
        let lowered = lower_core(ctx, payload, request, [], [], [], [], [], []);
        let base_plan = lowered.1;
        if array::length(comparisons) == 0 {
            lowered
        } else {
            let initial: (qb::BuildCtx, Array(qb::ScalarAggregateComparison)) = (lowered.0, []);
            let resolved = array::fold(comparisons, initial, fn(state, spec) {
                let next = resolve_scalar_compare(state.0, payload, base, spec);
                (next.0, array::push(state.1, next.1))
            });
            let rebuilt = base_plan <~ { scalar_comparisons: resolved.1, ranked_key_comparisons: [] };
            (resolved.0, qb::validate(rebuilt, payload.profile))
        }
    }
};

# Anti-existence entry: the base QueryRequest plus typed correlated-existence
# requests that must NOT match.  Each `absence_spec` resolves the same declared
# relation/route/hub shape as a positive existence and is lowered as
# `NOT EXISTS (...)`, so a base row is kept exactly when no related row (or, with
# `min_matches`, no qualifying group) satisfies the correlated body.  NULL
# semantics stay SQL-native.  Aggregate-result (HAVING) predicates are optional.
def lower_absence: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(ExistsRequest), Array(HavingRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, absence_specs, having_specs) {
    lower_core(ctx, payload, request, [], [], having_specs, [], absence_specs, [])
};

# ---------------------------------------------------------------------------
# Ranked grouped-key comparison (ontology typed entry over the query-core
# `RankedKeyComparison`).  A measureless row-level request keeps outer rows when
# `<outer attribute> <op> <grouping key of the first inner group after aggregate
# ordering>` (the inner grouped-key scalar subquery).  This is ONLY lowered to
# the new query-core grouped-key scalar spec: the ranked group is never returned
# as the outer result, the ranking measure is never projected, and no
# SQL/table/column/alias fragment is accepted.
# ---------------------------------------------------------------------------

# A closed typed request for the ranked grouped-key comparison shape:
# outer attribute id (request base entity), comparison operator, inner grouping
# dimension id, ranking measure id (inner population grain), direction, and the
# ordered inner scope filters.
type RankedKeyCompareRequest = struct {
    attribute: String,
    subject: String,
    op: HavingOp,
    group: String,           # inner grouping dimension id (inner population entity)
    measure: String,         # ranking measure id (same inner population grain)
    direction: OrderDirection,
    scope_filters: Array(FilterRequest),
};

def to_qb_ordering: Fn(OrderDirection) -> qb::Ordering = fn(direction) {
    match direction {
        OrderDirection::Asc => qb::Ordering::Asc,
        OrderDirection::Desc => qb::Ordering::Desc,
    }
};

# Type compatibility between the outer attribute and the returned grouping key:
# both are declared dimensions, so the reusable closed comparable-category check
# (`field_domains_compatible`) applies.  The ranking measure's own type is
# independent (it is only used for aggregate ordering) and is NOT part of this
# compatibility decision.
def ranked_key_categories_compatible: Fn(PreparedPayload, DimensionEntry, String) -> Bool = fn(payload, attr, group_id) {
    match array::find(payload.dimensions, fn(d) { d.id == group_id }) {
        Some(g) => field_domains_compatible(attr, g),
        None => False,
    }
};

# Resolve the inner population entity, grouping dimension, ranking measure and
# the query-core grouped-key spec.  All roles are validated atomically with
# diagnostics naming the failing role (outer key / group key / ranking measure /
# route / scope filter).
def resolve_ranked_key_compare: Fn(qb::BuildCtx, PreparedPayload, Int, RankedKeyCompareRequest) -> (qb::BuildCtx, qb::RankedKeyComparison) = fn(ctx, payload, base, spec) {
    if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for ranked grouped-key comparison", spec.subject, spec.attribute)
    } else {
        let attr = match array::find(payload.dimensions, fn(d) { d.id == spec.attribute }) {
            Some(d) => d,
            None => fail!("ranked grouped-key comparison references an unknown outer attribute", spec.attribute),
        };
        if attr.computed {
            fail!("ranked grouped-key outer attribute must be a plain column-backed dimension", spec.attribute)
        } else if !attr.authorized {
            fail!("ranked grouped-key outer attribute is not authorized", spec.attribute)
        } else {
            let group = match array::find(payload.dimensions, fn(d) { d.id == spec.group }) {
                Some(d) => d,
                None => fail!("ranked grouped-key comparison references an unknown grouping dimension", spec.group),
            };
            if group.computed {
                fail!("ranked grouped-key grouping dimension must be plain column-backed", spec.group)
            } else if !group.authorized {
                fail!("ranked grouped-key grouping dimension is not authorized", spec.group)
            } else if !field_domains_compatible(attr, group) {
                fail!("ranked grouped-key outer attribute and grouping key are type/domain incompatible", spec.attribute, spec.group)
            } else {
                let population = group.entity;
                let measure = match array::find(payload.measures, fn(m) { m.id == spec.measure }) {
                    Some(m) => m,
                    None => fail!("ranked grouped-key comparison references an unknown ranking measure", spec.measure),
                };
                if measure.computed != None {
                    fail!("ranked grouped-key ranking measure must be a plain aggregate", spec.measure)
                } else if measure.predicate != None {
                    fail!("ranked grouped-key ranking measure must be a simple aggregate", spec.measure)
                } else if measure.entity != population {
                    fail!("ranked grouped-key ranking measure must live on the inner population grain", spec.measure)
                } else if array::length(measure.requires) > 0 {
                    fail!("ranked grouped-key ranking measure requires unsupported extra entities (no safe route)", spec.measure)
                } else {
                    # The outer attribute may live on the request base entity OR on
                    # an unambiguous, grain-preserving (safe) reachable entity.  The
                    # outer ColumnRef always uses the OWNING entity's alias; the
                    # join that makes that alias visible is added by the lowering
                    # entry (reusing an existing outer join when possible).
                    let attr_entry = get_index(payload.entities, attr.entity);
                    let attr_field = get_index(attr_entry.fields, attr.field);
                    let pop_entry = get_index(payload.entities, population);
                    let group_field = get_index(pop_entry.fields, group.field);
                    let key_expr = qb::column(pop_entry.source, group_field.column);
                    let measure_field = get_index(pop_entry.fields, measure.field);
                    let order_call: qb::AggregateCall = {
                        function: measure.aggregate,
                        arg: qb::column(pop_entry.source, measure_field.column),
                        distinct: measure.input == MeasureInput::Distinct,
                        filter: None,
                        alias: "__rank_order",
                    };
                    let inner_filter = resolve_comparison_scope_with_context(ctx, payload, population, spec.scope_filters);
                    let inner_source = entity_source_at_with_context(qb::independent_query_scope(inner_filter.0), payload, pop_entry, pop_entry.alias);
                    let inner = qb::ranked_key_subquery_spec(
                        inner_source.1,
                        [],
                        inner_filter.1,
                        [key_expr],
                        order_call,
                        to_qb_ordering(spec.direction),
                    );
                    let outer_ref = qb::column_ref(attr_entry.source, attr_field.column);
                    (inner_source.0, qb::ranked_key_comparison(outer_ref, having_op_scalar_function(spec.op), inner))
                }
            }
        }
    }
};

# Route classification of the hidden ranked grouped-key outer attribute from the
# request base entity to the attribute's owning entity.
type RankedAttrRoute = enum {
    OnBase,                   # attribute belongs to the request base entity
    SafeUnique(Array(Int)),   # reachable through exactly one prepared Safe path
    Ambiguous,                # reachable through multiple declared Safe routes
    FanOut,                   # reachable only through a fan-out route
    Missing,                  # no declared route
    Truncated,                # route search was truncated
};

# Classify the route to the ranked grouped-key outer attribute's owning entity:
# base-entity attributes need no route; off-base entities are resolved through
# the prepared path matrix (a Safe path is required) and the prepared ambiguity
# matrix (more than one distinct Safe route is rejected, never chosen by
# declaration order).
def ranked_attr_route: Fn(PreparedPayload, Int, Int) -> RankedAttrRoute = fn(payload, base, target) {
    if target == base {
        RankedAttrRoute::OnBase
    } else {
        let row = get_index(payload.paths, base);
        let amb_row = get_index(payload.ambiguous_paths, base);
        match get_index(row, target) {
            PathResult::Safe(seq) => if get_index(amb_row, target) {
                RankedAttrRoute::Ambiguous
            } else {
                let result: RankedAttrRoute = RankedAttrRoute::SafeUnique(seq);
                result
            },
            PathResult::FanOut(_) => RankedAttrRoute::FanOut,
            PathResult::Missing => RankedAttrRoute::Missing,
            PathResult::Truncated => RankedAttrRoute::Truncated,
        }
    }
};

# The joins of the prepared Safe path from the request base entity to the ranked
# grouped-key outer attribute's owning entity (path order preserved).  Fan-out,
# ambiguous, missing or truncated routes are rejected deterministically with
# distinct diagnostics: only a unique grain-safe path may be materialized as
# outer joins, and a route is never chosen by declaration order.
def ranked_outer_path_joins: Fn(qb::BuildCtx, PreparedPayload, Int, Int, Array(qb::Join)) -> (qb::BuildCtx, Array(qb::Join)) = fn(ctx, payload, base, target, existing) {
    match ranked_attr_route(payload, base, target) {
        RankedAttrRoute::SafeUnique(seq) => array::fold(seq, (ctx, existing), fn(state, r_index) {
            let r = get_index(payload.relations, r_index);
            let to_entity = get_index(payload.entities, r.to);
            if array::any(state.1, fn(j) { j.source.alias == to_entity.alias }) { state }
            else {
                let source = entity_source_at_with_context(state.0, payload, to_entity, to_entity.alias);
                let kind: qb::JoinKind = match r.kind { RelationKind::Safe => qb::JoinKind::Inner, RelationKind::FanOut => qb::JoinKind::Left };
                let join = qb::join_on(kind, source.1, key_to_condition(payload, r.from, r.to, r.key));
                (source.0, array::push(state.1, join))
            }
        }),
        RankedAttrRoute::Ambiguous => fail!("ranked grouped-key outer attribute owner is reachable through multiple declared safe routes; declare a single unambiguous route to the attribute owner", target),
        RankedAttrRoute::FanOut => fail!("ranked grouped-key outer attribute reaches its entity only through a fan-out route; only a grain-safe route may be joined", target),
        RankedAttrRoute::Missing => fail!("ranked grouped-key outer attribute entity has no declared route from the request base entity", target),
        RankedAttrRoute::Truncated => fail!("ranked grouped-key outer attribute route search was truncated", target),
        RankedAttrRoute::OnBase => fail!("ranked grouped-key outer attribute belongs to the request base entity and needs no route", target),
    }
};

# Pure feasibility probe for one ranked grouped-key comparison: outer attribute /
# grouping dimension authorization, ownership and type compatibility, ranking
# measure grain and simplicity, plus every ordered scope filter's full
# filter/ownership contract against the inner population.  The outer attribute
# must live on the request base entity or be reachable from it through exactly
# one prepared Safe path whose joins a physical outer plan can carry; a fan-out,
# ambiguous, missing or truncated route, or a derived (union) base that would
# need the added join, is rejected.  Never fails.
def ranked_key_compare_ok: Fn(PreparedPayload, Int, String, String, String, String, OrderDirection, Array(FilterRequest)) -> Bool = fn(payload, base, role, attribute_id, group_id, measure_id, direction, scope_filters) {
    if !payload.authorize(role) {
        False
    } else {
        let attr = array::find(payload.dimensions, fn(d) { d.id == attribute_id });
        let group = array::find(payload.dimensions, fn(d) { d.id == group_id });
        match (attr, group) {
            (Some(a), Some(g)) => do {
                let route_ok = match ranked_attr_route(payload, base, a.entity) {
                    RankedAttrRoute::OnBase => True,
                    RankedAttrRoute::SafeUnique(_) => do {
                        # A safe parent-attribute join needs a physical outer plan;
                        # a derived (union) base cannot represent the added join.
                        let base_entry = get_index(payload.entities, base);
                        match base_entry.union { None => True, Some(_) => False }
                    },
                    RankedAttrRoute::Ambiguous => False,
                    RankedAttrRoute::FanOut => False,
                    RankedAttrRoute::Missing => False,
                    RankedAttrRoute::Truncated => False,
                };
                if !(!a.computed && a.authorized && route_ok
                    && !g.computed && g.authorized && field_domains_compatible(a, g)) {
                    False
                } else {
                    let population = g.entity;
                    match array::find(payload.measures, fn(m) { m.id == measure_id }) {
                        None => False,
                        Some(m) => if m.computed != None || m.predicate != None
                            || m.entity != population || array::length(m.requires) > 0 {
                            False
                        } else {
                            array::all(scope_filters, fn(f) { scope_filter_ok(payload, population, f) })
                        },
                    }
                }
            },
            _ => False,
        }
    }
};

# Append the needed joins after the existing outer joins, reusing any join
# already present by source alias (the existing occurrence is kept).

# The distinct off-base owning entities of the ranked grouped-key outer
# attributes, in first-use request order.  Attributes on the base entity itself
# need no route (current behavior is preserved).
def ranked_off_base_entities: Fn(PreparedPayload, Int, Array(RankedKeyCompareRequest)) -> Array(Int) = fn(payload, base, comparisons) {
    array::fold(comparisons, [], fn(acc, spec) {
        let attr = match array::find(payload.dimensions, fn(d) { d.id == spec.attribute }) {
            Some(d) => d,
            None => fail!("ranked grouped-key comparison references an unknown outer attribute", spec.attribute),
        };
        if attr.entity == base || array::any(acc, fn(e) { e == attr.entity }) {
            acc
        } else {
            array::push(acc, attr.entity)
        }
    })
};

# Additive entry: a measureless row-level (listing) request whose base rows are
# kept when every ordered ranked grouped-key comparison holds.  The requested
# dimensions are projected unchanged; each comparison renders as a Plan-level
# grouped-key scalar subquery predicate in WHERE (never changing the outer
# projection, never exposing the ranking measure).  When the hidden outer
# comparison attribute lives off the request base entity, its owning entity is
# resolved through the prepared path matrix (exactly one Safe path is required;
# a fan-out-only, ambiguous, missing or truncated route is rejected with a
# distinct diagnostic and never chosen by declaration order) and that path's
# joins are materialized in the outer plan, reusing joins already present by
# source alias; sources and joins are rebuilt consistently before validation.
# A derived (union) outer plan that would need the added join is rejected.
def lower_ranked_key_compare: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(RankedKeyCompareRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, comparisons) {
    if array::length(request.measures) > 0 {
        fail!("ranked grouped-key comparison requires a measureless row-level request")
    } else if array::length(request.dimensions) == 0 {
        fail!("ranked grouped-key comparison requires at least one listing dimension")
    } else {
        let base = request_subject_entity(payload, request);
        let lowered = lower_core(ctx, payload, request, [], [], [], [], [], []);
        let base_plan = lowered.1;
        if array::length(comparisons) == 0 {
            lowered
        } else {
            let initial: (qb::BuildCtx, Array(qb::RankedKeyComparison)) = (lowered.0, []);
            let resolved = array::fold(comparisons, initial, fn(state, spec) {
                let next = resolve_ranked_key_compare(state.0, payload, base, spec);
                (next.0, array::push(state.1, next.1))
            });
            let off_base = ranked_off_base_entities(payload, base, comparisons);
            let occupied = array::map(base_plan.sources, fn(source) { source.alias });
            let route_ctx = qb::reserve_source_aliases(qb::independent_query_scope(resolved.0), occupied);
            let routed = array::fold(off_base, (route_ctx, base_plan.joins), fn(acc, target) {
                ranked_outer_path_joins(acc.0, payload, base, target, acc.1)
            });
            let joins = routed.1;
            let sources = if array::length(joins) == array::length(base_plan.joins) {
                base_plan.sources
            } else {
                match base_plan.derived {
                    Some(_) => fail!("ranked grouped-key outer attribute join requires a physical outer plan; a derived (union) base cannot be joined safely", base),
                    None => array::concat([[get_index(base_plan.sources, 0)], array::map(joins, fn(j) { j.source })]),
                }
            };
            let rebuilt = base_plan <~ { sources, joins, ranked_key_comparisons: resolved.1 };
            (routed.0, qb::validate(rebuilt, payload.profile))
        }
    }
};

# Distinct-row entry: a measureless dimension request whose result is a set of
# mutually distinct rows (`SELECT DISTINCT`).  The request must select at least
# one dimension and no measures; it may filter, order (by a projected
# dimension) and limit/offset, but must not combine with top-per-group.  The
# returned `Query` has deterministic SQL and bindings; SQLite requires the ORDER
# BY terms of a SELECT DISTINCT to appear in the result set, so ordering
# targets must be among the requested (projected) dimensions.
def lower_distinct: Fn(PreparedPayload, QueryRequest) -> qb::Query = fn(payload, request) {
    if array::length(request.measures) > 0 {
        fail!("distinct rows requires a measureless dimension request")
    } else if array::length(request.dimensions) == 0 {
        fail!("distinct rows requires at least one dimension")
    } else if request.partition != None {
        fail!("distinct rows does not combine with top per group")
    } else {
        let requested_dimension_ids = array::map(request.dimensions, fn(d) { d.id });
        let order_ok = array::all(request.ordering, fn(o) {
            match o.target {
                OrderTarget::Measure(id) => fail!("distinct rows ordering must reference a dimension", id),
                OrderTarget::Dimension(id) => array::any(requested_dimension_ids, fn(d) { d == id }),
            }
        });
        if !order_ok {
            fail!("distinct rows ordering must reference a projected dimension")
        } else {
            let lowered = lower_core(qb::build_context(), payload, request, [], [], [], [], [], []);
            sqlite::build_query(qb::finish(lowered.0, qb::QueryPlan::DistinctRows(lowered.1)))
        }
    }
};

# One entry of an explicit projection order.  It must reference exactly one
# selected (requested) measure or dimension; every requested measure/dimension
# appears exactly once.
type ProjectionToken = enum {
    Measure(String),
    Dimension(String),
};

def occurrences: Fn(Array(String), String) -> Int = fn(items, id) {
    array::length(array::filter(items, fn(i) { i == id }))
};

# Rebuild a validated Plan's SELECT list in the caller's explicit interleaved
# order.  Only the projection order changes: grouping, ordering, filters,
# bindings and grain are untouched.  Every token must reference a requested
# measure/dimension exactly once; any remaining projection items (transitive
# dependencies of computed measures) stay projected after the ordered items.
def reorder_projection: Fn(PreparedPayload, QueryRequest, qb::Plan, Array(ProjectionToken)) -> qb::Plan = fn(payload, request, plan, order) {
    let expanded_measures = resolve_measures(payload, request.measures);
    let measure_ids = array::map(request.measures, fn(m) { m.id });
    let dimension_ids = array::map(request.dimensions, fn(d) { d.id });
    let order_m = array::map(order, fn(t) {
        match t {
            ProjectionToken::Measure(id) => [id],
            ProjectionToken::Dimension(_) => [],
        }
    });
    let order_d = array::map(order, fn(t) {
        match t {
            ProjectionToken::Dimension(id) => [id],
            ProjectionToken::Measure(_) => [],
        }
    });
    let order_measure_ids = array::concat(order_m);
    let order_dimension_ids = array::concat(order_d);
    let missing = !array::all(measure_ids, fn(id) {
        occurrences(order_measure_ids, id) == 1
    }) || !array::all(dimension_ids, fn(id) {
        occurrences(order_dimension_ids, id) == 1
    });
    let extra = !array::all(order_measure_ids, fn(id) {
        occurrences(measure_ids, id) == 1
    }) || !array::all(order_dimension_ids, fn(id) {
        occurrences(dimension_ids, id) == 1
    });
    let dup = array::any(order_measure_ids, fn(id) { occurrences(order_measure_ids, id) > 1 })
        || array::any(order_dimension_ids, fn(id) { occurrences(order_dimension_ids, id) > 1 });
    if missing {
        fail!("explicit projection order must list every requested measure and dimension exactly once", order)
    } else if extra {
        fail!("explicit projection order references an item that is not requested", order)
    } else if dup {
        fail!("explicit projection order must not repeat a measure or dimension", order)
    } else if array::length(order) != array::length(measure_ids) + array::length(dimension_ids) {
        fail!("explicit projection order must not omit any requested measure or dimension", order)
    } else {
        # The core plan projects expanded measures followed by requested dimensions.
        # Select by that Model-backed position; allocated bindings make reconstructed
        # canonical expressions intentionally unequal to the original AST nodes.
        let ordered_items: Array(qb::SelectItem) = array::map(order, fn(token) {
            match token {
                ProjectionToken::Measure(id) => do {
                    let indexed = match array::find(array::enumerate(expanded_measures), fn(pair) { pair.1.entry.id == id }) {
                        Some(value) => value,
                        None => fail!("explicit projection order references a measure that is not projected", id),
                    };
                    get_index(plan.projection, indexed.0)
                },
                ProjectionToken::Dimension(id) => do {
                    let indexed = match array::find(array::enumerate(request.dimensions), fn(pair) { pair.1.id == id }) {
                        Some(value) => value,
                        None => fail!("explicit projection order references a dimension that is not projected", id),
                    };
                    get_index(plan.projection, array::length(expanded_measures) + indexed.0)
                },
            }
        });
        # Dependency-only items that were not claimed by any token (kept so a
        # computed measure can still render) are appended after the ordered items.
        let leftover = array::map(array::filter(array::enumerate(plan.projection), fn(indexed) {
            if indexed.0 < array::length(expanded_measures) {
                let measure = get_index(expanded_measures, indexed.0);
                !array::any(order_measure_ids, fn(id) { id == measure.entry.id })
            } else {
                indexed.0 >= array::length(expanded_measures) + array::length(request.dimensions)
            }
        }), fn(indexed) { indexed.1 });
        let projection = array::concat([ordered_items, leftover]);
        let rebuilt = plan <~ { projection };
        qb::validate(rebuilt, payload.profile)
    }
};

# Lower with an explicit interleaved projection order (P1).  The request is
# otherwise lowered exactly like `lower`; the explicit order only reorders the
# SELECT columns and is validated (exactly-once coverage of every requested
# measure/dimension, no extra/hidden/duplicate references).  Omitting the order
# (empty array) keeps the default measure-then-dimension order for compat.
def lower_ordered: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(ProjectionToken)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, order) {
    let lowered = lower_core(ctx, payload, request, [], [], [], [], [], []);
    if array::length(order) == 0 {
        lowered
    } else {
        (lowered.0, reorder_projection(payload, request, lowered.1, order))
    }
};

# Closed set operations between two fully lowered ontology requests.  Each
# operand request is lowered through the normal authorized ontology pipeline;
# the two resulting Plans must have equal non-zero projection arity and
# positionally compatible projection shapes, and must carry no local
# ordering/limit/offset/partition.  The result is a closed set Query
# (INTERSECT / EXCEPT / distinct UNION).
def projection_output_types: Fn(PreparedPayload, QueryRequest, qb::Plan) -> Array(OutputType) = fn(payload, request, plan) {
    let measures = array::map(resolve_measures(payload, request.measures), fn(m) {
        measure_output_type(payload, m.entry.id)
    });
    let dimensions = array::map(resolve_dimensions(payload, request.dimensions), fn(d) { d.entry.output_type });
    let output = array::concat([measures, dimensions]);
    if array::length(output) != array::length(plan.projection) {
        fail!("set branch projection does not match its declared Model request", request)
    } else { output }
};

def validate_set_projection_types: Fn(PreparedPayload, QueryRequest, qb::Plan, QueryRequest, qb::Plan) -> Bool = fn(payload, left_request, left, right_request, right) {
    let left_types = projection_output_types(payload, left_request, left);
    let right_types = projection_output_types(payload, right_request, right);
    if left_types != right_types {
        fail!("set branches have incompatible projected Model output types", left_types, right_types)
    } else { True }
};

def lower_set: Fn(qb::SetOpKind, PreparedPayload, QueryRequest, QueryRequest) -> qb::Query = fn(kind, payload, left_req, right_req) {
    let left = lower_core(qb::build_context(), payload, left_req, [], [], [], [], [], []);
    let right = lower_core(left.0, payload, right_req, [], [], [], [], [], []);
    if validate_set_projection_types(payload, left_req, left.1, right_req, right.1) {
        let set: qb::SetPlan = {kind, left: left.1, right: right.1};
        sqlite::build_query(qb::finish(right.0, qb::QueryPlan::SetRows(set)))
    } else { fail!("invalid set projection types") }
};

# Outer count over a closed set operation: the derived set is wrapped by
# `SELECT count(1) FROM (<set>) AS __q_set`; the result exposes exactly one count
# column and none of the operand columns.
def lower_set_count: Fn(qb::SetOpKind, PreparedPayload, QueryRequest, QueryRequest) -> qb::Query = fn(kind, payload, left_req, right_req) {
    let left = lower_core(qb::build_context(), payload, left_req, [], [], [], [], [], []);
    let right = lower_core(left.0, payload, right_req, [], [], [], [], [], []);
    if validate_set_projection_types(payload, left_req, left.1, right_req, right.1) {
        let set: qb::SetPlan = {kind, left: left.1, right: right.1};
        sqlite::build_query(qb::finish(right.0, qb::QueryPlan::SetCount(set)))
    } else { fail!("invalid set projection types") }
};

# Count the number of groups of a grouped request that satisfy the given
# aggregate-result predicates (nested shape 1: count of groups over a
# `SELECT ... GROUP BY ... HAVING ...` inner query). Ordering/limit/offset/
# partition do not change a group count and are rejected deterministically.
def lower_group_count_plan: Fn(qb::BuildCtx, PreparedPayload, QueryRequest, Array(HavingRequest)) -> (qb::BuildCtx, qb::Plan) = fn(ctx, payload, request, having_specs) {
    if array::length(request.ordering) > 0 {
        fail!("group count request must not specify an ordering")
    } else if request.limit != None || request.offset != None || request.partition != None {
        fail!("group count request must not specify limit, offset or partition")
    } else if array::length(request.measures) == 0 || array::length(request.dimensions) == 0 {
        fail!("group count request must select measures and grouping dimensions")
    } else {
        let inner = lower_core(ctx, payload, request, [], [], having_specs, [], [], []);
        (inner.0, qb::validate(inner.1, payload.profile))
    }
};

def lower_group_count: Fn(PreparedPayload, QueryRequest, Array(HavingRequest)) -> qb::Query = fn(payload, request, having_specs) {
    let lowered = lower_group_count_plan(qb::build_context(), payload, request, having_specs);
    sqlite::build_query(qb::finish(lowered.0, qb::QueryPlan::GroupCount(lowered.1)))
};

