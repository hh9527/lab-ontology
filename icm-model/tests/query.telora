    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
    exists: [],
    having: [
        {measure: "NetworkIfUtilizationAvg", subject: subject, op: 'Ge, threshold: 'Number(70.0)},
    ],
    group_count: 'Some('CountGroups),
};

export def test_group_count_kpi_having = assert_intent_query(
    group_count_kpi_having_intent,
    "SELECT count(1) FROM (SELECT avg(k.ifUtilizationRate) AS NetworkIfUtilizationAvg, d.id FROM NetworkDeviceKPI AS k INNER JOIN EntNetworkElement AS d ON k.resId = d.id WHERE (k.ts >= ? AND k.ts < ?) GROUP BY d.id HAVING avg(k.ifUtilizationRate) >= ?) AS __q_count",
    ['String("2026-08-01 00:00:00"), 'String("2026-08-08 00:00:00"), 'Float(70.0)],
);

export def test_group_count_kpi_deterministic = assert_deterministic_intent(group_count_kpi_having_intent);
