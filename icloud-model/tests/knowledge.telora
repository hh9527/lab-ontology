use crate::model::{ payload };
use ontology::knowledge as knowledge;
use ontology::ontology as edsl;
use ontology::query as qb;
use std::value::{ Value };
use std::codec as codec;
use std::array as array;
use std::string as string;
use std::test as test;

pub def complex_model_knowledge_map_is_closed: test::Test = test::should_ok(fn() {
    let points = knowledge::map(payload, "public");
    let topics = knowledge::topic_index_from_points(points);
    if array::length(points) > 19 && array::length(topics) >= array::length(points)
        && array::any(topics, fn(entry) { entry.topic == "device" && entry.target.kind == edsl::KnowledgeKind::Dataset })
    { True } else { fail!("complex model has an undiscoverable or dangling knowledge point") }
});

pub def server_asset_and_site_path_are_discoverable_from_one_model: test::Test = test::should_ok(fn() {
    let asset: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
        owner: "server_device", id: "server_asset_number"};
    let relation: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "server_device", id: "server_located_at_site"};
    let server: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset,
        owner: "", id: "server_device"};
    match knowledge::by_target(payload, "public", server) {
        knowledge::DocResult::Found(point) => if array::any(point.refs, fn(ref) { ref.target == asset })
            && array::any(point.refs, fn(ref) { ref.target == relation }) {
            match knowledge::by_target(payload, "public", asset) {
                knowledge::DocResult::Found(dimension) => if dimension.dimension != None { True }
                    else { fail!("server asset dimension has no declared detail") },
                other => fail!("server asset dimension is undiscoverable", other),
            }
        } else { fail!("server document lost the asset or site relation reference") },
        other => fail!("server dataset is undiscoverable", other),
    }
});

pub def physical_link_discloses_server_participation_separately_from_network_device: test::Test = test::should_ok(fn() {
    let link: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "physical_link"};
    let server: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "physical_link", id: "physical_link_attached_server"};
    let device: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "physical_link", id: "physical_link_attached_device"};
    match knowledge::by_target(payload, "public", link) {
        knowledge::DocResult::Found(point) => if array::any(point.refs, fn(ref) { ref.target == server })
            && array::any(point.refs, fn(ref) { ref.target == device }) {
            match knowledge::by_target(payload, "public", server) {
                knowledge::DocResult::Found(relation) => if relation.relation != None { True }
                    else { fail!("server participation lacks relation detail") },
                other => fail!("server participation relation is undiscoverable", other),
            }
        } else { fail!("physical link lacks either declared participant relation") },
        other => fail!("physical-link dataset is undiscoverable", other),
    }
});

pub def undirected_peer_discloses_its_bidirectional_hub_guard: test::Test = test::should_ok(fn() {
    let target: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::BusinessLink,
        owner: "physical_link", id: "physical_link_peer_device"};
    match knowledge::by_target(payload, "public", target) {
        knowledge::DocResult::Found(point) => match point.guard {
            Some(pred) => if pred.field == "direction" && pred.op == edsl::FilterOp::Eq
                && pred.input == edsl::FilterInput::Text("bidirectional")
                && array::any(point.refs, fn(ref) { ref.target.kind == edsl::KnowledgeKind::Field
                    && ref.target.owner == "physical_link" && ref.target.id == "direction" }) { True }
            else { fail!("peer knowledge lost bidirectional hub guard", point) },
            None => fail!("peer knowledge does not disclose its direction guard"),
        },
        other => fail!("bidirectional peer link is undiscoverable", other),
    }
});

pub def peer_topic_doc_exposes_direction_guard: test::Test = test::should_ok(fn() {
    let document = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic")(
        Value::Object({topic: Value::String("physical_link_peer_device")}));
    match codec::decode@[knowledge::KnowledgeResponse](document).unwrap!() {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if point.target.kind == edsl::KnowledgeKind::BusinessLink
                && point.target.owner == "physical_link"
                && point.guard == Some({field: "direction", op: edsl::FilterOp::Eq,
                    input: edsl::FilterInput::Text("bidirectional")}) { True }
            else { fail!("peer topic lost the guarded business link", point) },
        other => fail!("peer topic did not resolve to its guarded knowledge point", other),
    }
});

pub def site_alarm_relation_discloses_its_guard: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "current_alarm", id: "alarm_site_reference"};
    match knowledge::by_target(payload, "public", id) {
        knowledge::DocResult::Found(point) => match point.relation {
            Some(detail) => match detail.guard {
                Some(guard) => if guard.field == "strext13" && guard.op == edsl::FilterOp::Ne
                    && guard.input == edsl::FilterInput::Text("3")
                    && array::any(point.refs, fn(ref) { ref.target.kind == edsl::KnowledgeKind::Field
                        && ref.target.owner == "current_alarm" && ref.target.id == "strext13" })
                    && match knowledge::by_target(payload, "public", {kind: edsl::KnowledgeKind::Field,
                        owner: "current_alarm", id: "strext13"}) {
                        knowledge::DocResult::Found(_) => True, _ => False,
                    } { True }
                    else { fail!("site-alarm relation guard changed", guard) },
                None => fail!("site-alarm relation lost its guard in discovery", detail),
            },
            None => fail!("site-alarm topic has no relation detail", point),
        },
        other => fail!("guarded relation is undiscoverable", other),
    }
});

pub def alarm_severity_discovery_covers_all_source_business_values: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
        owner: "current_alarm", id: "alarm_severity"};
    match knowledge::by_target(payload, "public", id) {
        knowledge::DocResult::Found(point) => match point.dimension {
            Some(detail) => if array::length(detail.values) == 4
                && array::all(["critical", "major", "minor", "warning"], fn(name) {
                    array::any(detail.values, fn(value) { value.id == name })
                }) && array::any(detail.ops, fn(op) { op == edsl::FilterOp::Ne }) { True }
            else { fail!("alarm severity discovery lost a source value or Ne capability", detail) },
            None => fail!("alarm severity topic has no dimension detail", point),
        },
        other => fail!("alarm severity is undiscoverable", other),
    }
});

pub def ic_device_kpi_measure_is_discoverable: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "port_count_sample_avg"};
    match knowledge::by_target(payload, "public", id) {
        knowledge::DocResult::Found(point) => if point.measure != None { True }
            else { fail!("sample aggregate has no declared measure detail", point) },
        other => fail!("model-declared sample aggregate is undiscoverable", other),
    }
});

def kpi_measure_doc: Fn(String, String) -> edsl::MeasureBrief = fn(topic, id) {
    let input = Value::Object({topic: Value::String(topic)});
    let document = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic")(input);
    match codec::decode@[knowledge::KnowledgeResponse](document).unwrap!() {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if point.target.kind != edsl::KnowledgeKind::Measure || point.target.owner != "device_kpi"
                || point.target.id != id {
                fail!("KPI topic resolved to another knowledge point", id, point.target)
            } else { match point.measure {
                Some(measure) => measure,
                None => fail!("KPI document has no measure detail", id),
            } },
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Candidates(candidates)) =>
            fail!("KPI topic has multiple knowledge targets", id, array::map(candidates, fn(item) { item.target })),
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::NotFound) =>
            fail!("KPI topic is not indexed", id),
        _ => fail!("KPI measure is not discoverable by doc.ic", id),
    }
};

pub def published_port_total_is_discoverable_as_sum: test::Test = test::should_ok(fn() {
    let measure = kpi_measure_doc("Total port count", "port_count");
    match measure.metric {
        Some(metric) => if measure.aggregate == Some(qb::AggregateFunction::Sum)
            && metric.role == edsl::MetricValueRole::DeclaredMetric { True }
        else { fail!("published port metric lost Sum role", measure) },
        None => fail!("published port metric lost its role"),
    }
});

pub def port_sample_average_is_discoverable_as_distinct_summary: test::Test = test::should_ok(fn() {
    let measure = kpi_measure_doc("Average port-count sample", "port_count_sample_avg");
    match measure.metric {
        Some(metric) => if measure.aggregate == Some(qb::AggregateFunction::Avg)
            && metric.role == edsl::MetricValueRole::SampleSummary
            && string::contains(measure.summary, "distinct from the published Sum") { True }
        else { fail!("sample port average lost Avg summary role", measure) },
        None => fail!("sample port average lost its role"),
    }
});

pub def used_port_sample_max_is_not_the_published_sum: test::Test = test::should_ok(fn() {
    let measure = kpi_measure_doc("Maximum used ports in a KPI sample", "used_port_sample_max");
    match measure.metric {
        Some(metric) => if measure.aggregate == Some(qb::AggregateFunction::Max)
            && metric.role == edsl::MetricValueRole::SampleSummary
            && string::contains(measure.summary, "distinct from the published Sum") { True }
        else { fail!("used-port Max is not described as an independent sample summary", measure) },
        None => fail!("used-port Max lost its sample summary role"),
    }
});

pub def memory_usage_is_discoverable_as_declared_average: test::Test = test::should_ok(fn() {
    let measure = kpi_measure_doc("Average memory usage", "memory_usage");
    match measure.metric {
        Some(metric) => if measure.aggregate == Some(qb::AggregateFunction::Avg)
            && metric.role == edsl::MetricValueRole::DeclaredMetric
            && string::contains(measure.summary, "eligible device KPI samples") { True }
        else { fail!("declared memory usage lost Avg role", measure) },
        None => fail!("declared memory usage lost its role"),
    }
});

pub def ambiguous_port_count_topic_returns_repairable_candidates: test::Test = test::should_ok(fn() {
    let input = Value::Object({topic: Value::String("port_count")});
    let document = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic")(input);
    match codec::decode@[knowledge::KnowledgeResponse](document).unwrap!() {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Candidates(candidates)) =>
            if array::any(candidates, fn(item) {
                item.target.kind == edsl::KnowledgeKind::Measure && item.target.owner == "device_kpi"
                    && item.target.id == "port_count" && item.label == "Total port count"
            }) && array::any(candidates, fn(item) { item.target.kind == edsl::KnowledgeKind::Metric })
                && array::any(candidates, fn(item) { item.target.kind == edsl::KnowledgeKind::Field }) { True }
            else { fail!("ambiguous topic omitted the measure label or conflicting knowledge kinds", candidates) },
        other => fail!("bare port_count must return exact-match candidates, not pick a measure", other),
    }
});
