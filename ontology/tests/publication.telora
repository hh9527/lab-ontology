use ontology::semantic as s;
use ontology::ontology as edsl;
use ontology::preparation;
use ontology::publication as p;
use ontology::query as q;
use ontology::intent;
use ontology::typed_query;
use ontology::groups as g;
use ontology::js_codec;
use ontology::enum_values as ev;
use ontology::scalars;
use ontology::quantity;
use ontology::values as v;
use std::test;
use std::codec;
use std::json;
use std::string;
use std::dict;
use std::value::{Value};

@s::dataset("reading", "readings", ["id"])
type Reading = struct {
    @g::exact("reading_id")
    id: String,
    @v::map_or(
        Kind.type,
        "kind",
        [v::member(Kind::Olt, ["olt", "ne.category.olt"]), v::member(Kind::Onu, ["onu"])],
        Kind::Unknown
    )
    kind: Option(String),
    @v::map_or(
        Kind.type,
        "peer_kind",
        [v::member(Kind::Olt, ["olt", "ne.category.olt"]), v::member(Kind::Onu, ["onu"])],
        Kind::Unknown
    )
    peer_kind: String
};
@js_codec::number_range(0.0, 100.0)
type Threshold = struct(Float);
@js_codec::number_range(10.0, 90.0)
type NarrowThreshold = struct(Threshold);
type PlainA = struct(Float);
type PlainB = struct(Float);
@ev::order_by_itag
type Kind = enum {
    @ev::itag(9)
    Olt,
    @ev::itag(1)
    Onu,
    @ev::itag(99)
    Unknown
};
def profile: q::PlanProfile = {
    allowed_operators: [
        q::Operator::Source,
        q::Operator::Column,
        q::Operator::Project,
        q::Operator::Order,
        q::Operator::Limit,
        q::Operator::Bind,
        q::Operator::Scalar,
        q::Operator::Filter
    ],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [
        q::ScalarFunction::BinaryText,
        q::ScalarFunction::Eq,
        q::ScalarFunction::Ne,
        q::ScalarFunction::IsNotNull,
        q::ScalarFunction::And,
        q::ScalarFunction::Or,
        q::ScalarFunction::Not,
        q::ScalarFunction::If
    ],
    allow_distinct: False
};
def payload: edsl::PreparedPayload = s::payload("publication-test", [Reading.type], profile);
def aliases: Array((String, typed_query::TypeRef)) = [
    ("lab::Threshold", typed_query::type_ref(Threshold.type, intent::ResultType::Float)),
    ("lab::NarrowThreshold", typed_query::type_ref(NarrowThreshold.type, intent::ResultType::Float)),
    ("lab::Kind", typed_query::type_ref(Kind.type, intent::ResultType::String)),
    ("lab::OptionalKind", typed_query::type_ref(Option(Kind).type, intent::ResultType::String)),
    ("lab::TimeZone", typed_query::type_ref(scalars::TimeZone.type, intent::ResultType::String)),
    ("lab::Percent", typed_query::type_ref(quantity::Percent.type, intent::ResultType::Float)),
    ("lab::PlainA", typed_query::type_ref(PlainA.type, intent::ResultType::Float)),
    ("lab::PlainB", typed_query::type_ref(PlainB.type, intent::ResultType::Float))
];
def program: p::Program = p::prepare(payload, "lab", aliases);
pub def runtime_contract: Value = program.contract;
def parse: Fn(String) -> Value = fn(text) {
    json::parse(text).unwrap!()
};
def verify: Fn(Fn() -> Bool) -> test::Test = fn(check) {
    test::should_ok(
        fn() {
            if check() {
                ()
            } else {
                fail!("publication assertion failed")
            }
        }
    )
};
def graph: Value = parse(
    r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[{"node":"r","dimension":"reading_id"}],"order_by":[{"node":"r","dimension":"reading_id","direction":"Asc"}],"take":5}"#
);
type Batch = struct {
    intents: Array(Value)
};
def batch: Value = codec::encode({intents: [graph]}.ty!(Batch));
def field: Fn(Value, String) -> Value = fn(value, name) {
    match value {
        Value::Object(fields) => match dict::get(fields, name) {
            Some(value) => value,
            None => fail!("missing field", name)
        },
        _ => fail!("expected object")
    }
};
type Request = struct {
    method: String,
    input: Value
};
def request: Fn(String, Value) -> Value = fn(method, input) {
    codec::encode({method, input}.ty!(Request))
};

pub def contract_and_dispatch_share_published_identity: test::Test = verify(
    fn() {
        let contract = codec::decode@[p::Contract](program.contract).unwrap!();
        contract.abi_version == "dari-model/v3" && contract.datasets[0].symbol == "lab::reading" && contract.types[
            0
        ].name == "lab::Threshold" && p::dispatch(program, request("contract", parse("null"))) == program.contract && string::contains(
            contract.codec_module,
            "createCodecs"
        )
    }
);
pub def namespace_changes_contract_identity: test::Test = verify(
    fn() {
        let other = p::prepare(payload, "other", []);
        codec::decode@[p::Contract](program.contract).unwrap!().contract_id != codec::decode@[
            p::Contract
        ](other.contract).unwrap!().contract_id
    }
);
pub def preparation_and_author_roots_agree: test::Test = verify(
    fn() {
        let mapped = preparation::payload(
            "publication-test",
            [preparation::mapping("reading", Reading.type)],
            [],
            profile
        );
        program.contract == p::prepare(mapped, "lab", aliases).contract
    }
);
pub def check_type_is_not_a_public_method: test::Test = test::should_fail_with(
    fn() {
        p::dispatch(program, request("check_type", batch))
    },
    "unknown model publication method"
);
type Receipt = struct {
    contractId: String,
    inputDigest: String,
    consumedStepIds: Array(String)
};
pub def proof_covers_intent_and_contract: test::Test = verify(
    fn() {
        let contract = codec::decode@[p::Contract](program.contract).unwrap!();
        let member = contract.datasets[0].members[0].symbol;
        let input = parse(
            `{"intent":{"root":"r","nodes":[{"id":"r","dataset":"lab::reading"}],"steps":[{"id":"p","kind":"project","body":{"kind":"record","fields":[{"name":"id","value":{"kind":"member","node":"r","member":"\{member}"}}]}},{"id":"o","kind":"order_by","body":{"terms":[{"direction":"Asc","value":{"kind":"output","name":"id"}}]}},{"id":"t","kind":"take","body":{"count":5}}]}}`
        );
        let checked = p::dispatch(program, request("transform", input));
        let receipt = codec::decode@[Receipt](field(checked, "receipt")).unwrap!();
        receipt.contractId == contract.contract_id && receipt.consumedStepIds == ["p", "o", "t"] && field(
            checked,
            "container"
        ) == codec::encode("table")
    }
);
pub def unknown_method_is_rejected: test::Test = test::should_fail_with(
    fn() {
        p::dispatch(program, request("unknown", parse("null")))
    },
    "unknown model publication method"
);
pub def conflicting_type_codecs_are_rejected: test::Test = test::should_fail_with(
    fn() {
        p::prepare(
            payload,
            "lab",
            [
                (
                    "lab::A",
                    typed_query::type_ref(Kind.type, intent::ResultType::String) <~ {
                        logical: "ambiguous"
                    }
                ),
                (
                    "lab::B",
                    typed_query::type_ref(Threshold.type, intent::ResultType::Int) <~ {
                        logical: "ambiguous"
                    }
                )
            ]
        );
        ()
    },
    "conflicting codec descriptors"
);
