pub def physical_link_projects_both_endpoint_roles: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"list_roles","measures":[],"dimensions":["physical_link_id"],"filters":[],"ordering":[],"roles":[{"relation":"physical_link_a_device","dimension":"device_name","output":"a_device_name"},{"relation":"physical_link_z_device","dimension":"device_name","output":"z_device_name"}],"limit":null,"offset":null}`);
    if array::length(string::split(q.sql, "pl.a_ne_res_id = role_0.id")) > 1
        && array::length(string::split(q.sql, "pl.z_ne_res_id = role_1.id")) > 1
        && array::length(string::split(q.sql, "role_0.name AS a_device_name")) > 1
        && array::length(string::split(q.sql, "role_1.name AS z_device_name")) > 1 {
