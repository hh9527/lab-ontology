use crate::model::{ payload };
use ontology::intent::{ query_intent_ast_factory };
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use ontology::query as qb;
use std::array as array;
use std::json as json;
use std::string as string;
use std::test as test;

def lower: Fn(std::value::Value) -> qb::Query = fn(value) {
    sqlite::build_query(query_intent_ast_factory(payload, "public")(value))
};

pub def raw_kpi_trend_orders_by_declared_utc_clock: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{
        "op":"graph", "root":"sample",
        "nodes":[{"id":"sample","entity":"device_kpi"},{"id":"owner","entity":"device"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"owner"}],
        "select":[{"node":"owner","dimension":"device_name"},
                  {"node":"sample","dimension":"device_kpi_ts_raw"},
                  {"node":"sample","dimension":"port_count_sample"}],
        "filters":[{"node":"sample","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-01 00:00:00"}],
        "order_by":[{"node":"sample","dimension":"device_kpi_ts_raw","direction":"asc"}]
    }"#).unwrap!();
    let sqlite_query = lower(intent);
    let pg_query = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sqlite_query.sql, "ORDER BY sample.ts ASC")
        && string::contains(pg_query.sql, "ORDER BY \"sample\".\"ts\" ASC")
        && string::contains(sqlite_query.sql, "sample.resId = owner.id")
        && string::contains(sqlite_query.sql, "sample.tenantId = owner.tenant_id")
        && sqlite_query.bindings == [qb::Val::String("2025-01-01 00:00:00"), qb::Val::String("2025-02-01 00:00:00")]
        && pg_query.bindings == sqlite_query.bindings { True }
    else { fail!(`raw trend lost named owner, time ordering or window: \{sqlite_query.sql} / \{pg_query.sql}`, sqlite_query.bindings, pg_query.bindings) }
});

pub def named_server_alarm_qualifies_raw_memory_trend: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"sample",
        "nodes":[{"id":"sample","entity":"server_kpi"},{"id":"server","entity":"server_device"}],
        "edges":[{"relation":"server_kpi_of_server","from":"sample","to":"server"}],
        "select":[{"node":"server","dimension":"server_name"},
                  {"node":"sample","dimension":"server_memory_sample"},
                  {"node":"sample","dimension":"server_kpi_ts_raw"}],
        "filters":[{"node":"server","dimension":"server_class","op":"eq","kind":"text","value":"subrack"},
                   {"node":"sample","dimension":"server_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"server_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-31 00:00:00"}],
        "exists":[{"anchor":"server","nodes":[{"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"server_current_alarm","from":"alarm","to":"server"}],
            "filters":[{"node":"alarm","dimension":"alarm_name","op":"eq","kind":"text","value":"linkDown"}]}],
        "order_by":[{"node":"sample","dimension":"server_kpi_ts_raw","direction":"asc"}]}
    "#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "sample.resId = server.id AND sample.tenantId = server.tenantId")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM T_CURRENT_ALARM AS alarm")
        && string::contains(sq.sql, "server.id = alarm.MEDN AND server.tenantId = alarm.TENANTID")
        && !string::contains(sq.sql, "JOIN T_CURRENT_ALARM")
        && string::contains(sq.sql, "ORDER BY sample.ts ASC")
        && string::contains(pg.sql, "ORDER BY \"sample\".\"ts\" ASC")
        && sq.bindings == pg.bindings { True }
    else { fail!("server trend lost independent alarm qualification or complete owner identity", sq, pg) }
});

pub def server_kpi_cannot_borrow_network_kpi_ownership: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"sample",
        "nodes":[{"id":"sample","entity":"server_kpi"},{"id":"server","entity":"server_device"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"server"}],
        "select":[{"node":"sample","dimension":"server_memory_sample"}]}
    "#).unwrap!())
}, "device_kpi_of_device");

pub def global_raw_top_qualifies_frame_without_multiplying_kpi_rows: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"sample",
        "nodes":[{"id":"sample","entity":"device_kpi"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"},
                  {"node":"sample","dimension":"used_port_sample"}],
        "filters":[{"node":"device","dimension":"device_class","op":"eq","kind":"text","value":"WAC"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}],
        "exists":[{"anchor":"device","nodes":[{"id":"frame","entity":"frame"}],
            "edges":[{"relation":"frame_belongs_to_device","from":"frame","to":"device"}],
            "filters":[{"node":"frame","dimension":"frame_oper_state","op":"eq","kind":"text","value":"normal"}]}],
        "order_by":[{"node":"sample","dimension":"used_port_sample","direction":"desc"}],
        "take":2}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "EXISTS (SELECT 1 FROM I_EnterpriseFrame AS frame")
        && !string::contains(sq.sql, "JOIN I_EnterpriseFrame")
        && string::contains(sq.sql, "ORDER BY sample.portUsedCount DESC")
        && string::contains(sq.sql, "sample.resId ASC")
        && string::contains(sq.sql, "LIMIT ?")
        && sq.bindings == pg.bindings
        && array::length(sq.bindings) > 0
        && sq.bindings[array::length(sq.bindings) - 1] == qb::Val::Int(2) { True }
    else { fail!("global raw TOP changed sample grain, order or bound", sq, pg) }
});

pub def global_raw_top_rejects_joined_frame_fanout: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"sample",
        "nodes":[{"id":"sample","entity":"device_kpi"},{"id":"device","entity":"device"},
                 {"id":"frame","entity":"frame"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"device"},
                 {"relation":"frame_belongs_to_device","from":"frame","to":"device"}],
        "select":[{"node":"sample","dimension":"used_port_sample"}],
        "order_by":[{"node":"sample","dimension":"used_port_sample","direction":"desc"}],
        "take":2}"#).unwrap!())
}, "graph raw take requires grain-safe joins from the root");

pub def global_raw_top_rejects_unbounded_take: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"sample",
        "nodes":[{"id":"sample","entity":"device_kpi"}],"edges":[],
        "select":[{"node":"sample","dimension":"used_port_sample"}],
        "order_by":[{"node":"sample","dimension":"used_port_sample","direction":"desc"}],
        "take":1001}"#).unwrap!())
}, "partition take must be a positive integer within the cap");

