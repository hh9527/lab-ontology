use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::pon_element;
use crate::datasets::enterprise_ap;
use crate::datasets::enterprise_storage;
use crate::datasets::fc_switch_device;
use crate::datasets::fusion_storage_device;
use crate::datasets::huawei_storage_device;
use crate::datasets::physical_server;
@domain::subject("Alarm", "csn")
@domain::dataset("alarm-record", "AlarmRecord", ["csn"])
# Alarm integer clocks use the reviewed EpochMillis convention.
@domain::relations(relations)
pub type AlarmRecord = struct {
    @g::field_view(g::dimension_group("alarm-record/csn", ids::AlarmByCsn.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "ar_csn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @domain::count("ar_count")
    csn: ids::AlarmByCsn,
    @g::field_view(g::dimension_group("alarm-record/cleared/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ar_cleared_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::ArCleared.type, "ar_cleared", [v::member(domains::ArCleared::Uncleared, ["0"]), v::member(domains::ArCleared::Cleared, ["1"])])
    cleared: Option(String),
    @m::column("clearUtc")
    @g::field_view(g::dimension_group("alarm-record/clear_utc", s::EpochMillis.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "ar_clear_ms", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    clear_utc: Option(s::EpochMillis),
    @g::field_view(g::dimension_group("alarm-record/acked/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ar_acked_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::ArAcked.type, "ar_acked", [v::member(domains::ArAcked::Unacknowledged, ["0"]), v::member(domains::ArAcked::Acknowledged, ["1"])])
    acked: Option(String),
    @m::column("occurUtc")
    @g::field_view(g::dimension_group("alarm-record/occur_utc", s::EpochMillis.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "ar_occur_ms", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    occur_utc: Option(s::EpochMillis),
    @m::column("meDn")
    @g::field_view(g::dimension_group("alarm-record/me_dn", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "ar_object_id", True, [g::Filter::Eq])
    me_dn: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("meName")
    @g::field_view(g::dimension_group("alarm-record/me_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ar_object_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    me_name: Option(String),
    @m::column("meType")
    @g::field_view(g::dimension_group("alarm-record/me_type", String.type, True, [g::Filter::Eq]), "ar_object_type", True, [g::Filter::Eq])
    me_type: Option(String),
    @m::column("eventType")
    @g::field_view(g::dimension_group("alarm-record/event_type/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ar_event_type_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::ArEventType.type, "ar_event_type", [v::member(domains::ArEventType::CommunicationAlarm, ["1"]), v::member(domains::ArEventType::EquipmentAlarm, ["2"]), v::member(domains::ArEventType::ProcessingErrorAlarm, ["3"]), v::member(domains::ArEventType::QualityOfServiceAlarm, ["4"]), v::member(domains::ArEventType::EnvironmentalAlarm, ["5"]), v::member(domains::ArEventType::IntegrityAlarm, ["6"]), v::member(domains::ArEventType::OperationAlarm, ["7"]), v::member(domains::ArEventType::PhysicalResourceAlarm, ["8"]), v::member(domains::ArEventType::SecurityAlarm, ["9"]), v::member(domains::ArEventType::TimeDomainAlarm, ["10"]), v::member(domains::ArEventType::PropertyChange, ["11"]), v::member(domains::ArEventType::ObjectCreation, ["12"]), v::member(domains::ArEventType::ObjectDelete, ["13"]), v::member(domains::ArEventType::RelationshipChange, ["14"]), v::member(domains::ArEventType::StateChange, ["15"]), v::member(domains::ArEventType::RouteChange, ["16"]), v::member(domains::ArEventType::ProtectionSwitching, ["17"]), v::member(domains::ArEventType::OverLimit, ["18"]), v::member(domains::ArEventType::FileTransferStatus, ["19"]), v::member(domains::ArEventType::BackupStatus, ["20"]), v::member(domains::ArEventType::HeartBeat, ["21"])])
    event_type: Option(String),
    @m::column("alarmId")
    @g::field_view(g::dimension_group("alarm-record/alarm_id", String.type, True, [g::Filter::Eq]), "ar_alarm_id", True, [g::Filter::Eq])
    alarm_id: Option(String),
    @m::column("alarmName")
    @g::field_view(g::dimension_group("alarm-record/alarm_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ar_alarm_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    alarm_name: Option(String),
    @g::field_view(g::dimension_group("alarm-record/severity/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ar_severity_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::ArSeverity.type, "ar_severity", [v::member(domains::ArSeverity::Critical, ["1"]), v::member(domains::ArSeverity::Major, ["2"]), v::member(domains::ArSeverity::Minor, ["3"]), v::member(domains::ArSeverity::Warning, ["4"]), v::member(domains::ArSeverity::Unknown, ["_default"])])
    severity: Option(String),
    @g::field_view(g::dimension_group("alarm-record/moi", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ar_location_info", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    moi: Option(String),
    @m::column("originSystemName")
    @g::field_view(g::dimension_group("alarm-record/origin_system_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ar_origin_system", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    origin_system_name: Option(String),
    @g::field_view(g::dimension_group("alarm-record/address", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ar_address", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    address: Option(String),
    @g::field_view(g::dimension_group("alarm-record/manufacturer", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ar_manufacturer", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    manufacturer: Option(String),
};

pub def relations: Array(r::Relation) = [
    r::relation("ar__pone", domain::endpoint(AlarmRecord.type, "me_dn"), domain::endpoint(pon_element::PonElement.type, "native_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("ar__ea_rev", domain::endpoint(AlarmRecord.type, "me_dn"), domain::endpoint(enterprise_ap::EnterpriseAp.type, "id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("ar__enst_rev", domain::endpoint(AlarmRecord.type, "me_dn"), domain::endpoint(enterprise_storage::EnterpriseStorage.type, "obj_sys_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("ar__fsd_rev", domain::endpoint(AlarmRecord.type, "me_dn"), domain::endpoint(fc_switch_device::FcSwitchDevice.type, "obj_sys_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}),
    r::relation("ar__fustde_rev", domain::endpoint(AlarmRecord.type, "me_dn"), domain::endpoint(fusion_storage_device::FusionStorageDevice.type, "obj_sys_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("ar__hsd_rev", domain::endpoint(AlarmRecord.type, "me_dn"), domain::endpoint(huawei_storage_device::HuaweiStorageDevice.type, "obj_sys_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("ar__ps_rev", domain::endpoint(AlarmRecord.type, "me_dn"), domain::endpoint(physical_server::PhysicalServer.type, "ori_res_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
