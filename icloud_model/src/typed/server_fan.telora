use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# ServerFan独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("ServerFan")
type ServerFanById = struct(ComponentId);
@domain::subject("ServerFan", "id")
@domain::dataset("server_fan", "PhysicalServerFan", ["id"])
@domain::record_counts(["server_fan_count"])
@domain::relations(relations)
type PhysicalServerFan = struct {
    @g::exact("server_fan_id")
    id: ServerFanById,
    @g::search("server_fan_name")
    name: String,
    @m::column("parentResId")
    parent_res_id: domain::Reference(server::ServerByOriginId),
    @m::column("tenantId")
    tenant_id: domain::Reference(i::TenantById),
    @g::search("server_fan_manufacturer")
    manufacturer: String,
    @m::column("sn")
    @g::search("server_fan__sn")
    source_sn: String,
    @m::column("slotId")
    @g::field_view(
        g::dimension_group("server_fan__slotId", Int.type, True, g::numeric_filters),
        "server_fan__slotId",
        True,
        g::numeric_filters
    )
    source_slotId: Int,
    @m::column("healthStatus")
    @v::classification(health, "server_fan__healthStatus")
    source_healthStatus: Int,
    @m::column("fanName")
    @g::search("server_fan__fanName")
    source_fanName: String,
    @m::column("projectId")
    @g::exact("server_fan__projectId")
    source_projectId: String,
};

def subject: r::Endpoint = domain::endpoint(PhysicalServerFan.type, "id");
def parent: r::Endpoint = domain::endpoint(PhysicalServerFan.type, "parent_res_id");
def tenant: r::Endpoint = domain::endpoint(PhysicalServerFan.type, "tenant_id");

@knowledge_policy::reverse_references(True)
type ServerFanHealthStatus = enum {
    @ev::itag(0)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("warning", "警告")
    Warning,
    @ev::itag(2)
    @ev::description("average", "一般")
    Average,
    @ev::itag(3)
    @ev::description("serious", "严重")
    Serious,
    @ev::itag(4)
    @ev::description("critical", "紧急")
    Critical,
    @ev::itag(-1)
    @ev::description("wrong", "错误")
    Wrong,
    @ev::itag(-2)
    @ev::description("unknown", "未知")
    Unknown,
};
def health: v::Domain(ServerFanHealthStatus, Int) = v::from_enum(
    "ServerFanHealthStatus",
    ServerFanHealthStatus.type,
    Int.type,
    False
);
def tenant_cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "fan_parent_server",
        parent,
        server::origin,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_PhysicalServerFan",
        server::origin,
        parent,
        tenant_cardinality
    ),
    r::relation(
        "source_PhysicalServerFan_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "fan_belongs_to_tenant",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerFan, ServerFanById};
