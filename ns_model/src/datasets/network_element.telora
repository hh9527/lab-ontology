@domain::subject("NetworkElement", "id")
@domain::dataset("network-element", "EntNetworkElement", ["id"])
@domain::relations(relations)
pub type NetworkElement = struct {
    @g::field_view(g::dimension_group("network-element/id", ids::NetworkElementById.type, True, [g::Filter::Eq]), "ne_id", True, [g::Filter::Eq])
    @domain::count("ne_count")
    id: ids::NetworkElementById,
    @g::field_view(g::dimension_group("network-element/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: Option(String),
    @g::field_view(g::dimension_group("network-element/classification/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ne_classification_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map_or(domains::NeClassification.type, "ne_classification", [v::member(domains::NeClassification::Switch, ["ne.category.switch"]), v::member(domains::NeClassification::Wac, ["ne.category.ac"]), v::member(domains::NeClassification::Router, ["ne.category.router"]), v::member(domains::NeClassification::Firewall, ["ne.category.firewall"]), v::member(domains::NeClassification::Fatap, ["ne.category.fatap"]), v::member(domains::NeClassification::Printer, ["ne.category.printer"]), v::member(domains::NeClassification::Ups, ["ne.category.ups"]), v::member(domains::NeClassification::Lb, ["ne.category.lb"]), v::member(domains::NeClassification::Others, ["ne.category.unknown"]), v::member(domains::NeClassification::Fitap, ["ne.category.fitap"])], domains::NeClassification::Unknown)
    classification: Option(String),
    @m::column("commuState")
    @g::field_view(g::dimension_group("network-element/commu_state/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ne_communication_state_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::NeCommunicationState.type, "ne_communication_state", [v::member(domains::NeCommunicationState::Online, ["0","online"]), v::member(domains::NeCommunicationState::Offline, ["1","offline"]), v::member(domains::NeCommunicationState::Other, ["other"])])
    commu_state: Option(String),
    @m::column("typeId")
    @g::field_view(g::dimension_group("network-element/type_id", String.type, True, [g::Filter::Eq]), "ne_type_id", True, [g::Filter::Eq])
    type_id: String,
    @m::column("productName")
    @g::field_view(g::dimension_group("network-element/product_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_product_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    product_name: Option(String),
    @g::field_view(g::dimension_group("network-element/manufacturer", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_manufacturer", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    manufacturer: Option(String),
    @g::field_view(g::dimension_group("network-element/sn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_sn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    sn: Option(String),
    @g::field_view(g::dimension_group("network-element/mac", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_mac", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    mac: Option(String),
    @m::column("ipAddress")
    @g::field_view(g::dimension_group("network-element/ip_address", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_ip_address", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ip_address: Option(String),
    @g::field_view(g::dimension_group("network-element/location", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_location", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    location: Option(String),
    @g::field_view(g::dimension_group("network-element/remark", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_remark", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    remark: Option(String),
    @m::column("neOsVersion")
    @g::field_view(g::dimension_group("network-element/ne_os_version", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_os_version", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ne_os_version: Option(String),
    @m::column("nePatchVersion")
    @g::field_view(g::dimension_group("network-element/ne_patch_version", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ne_patch_version", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ne_patch_version: Option(String),
    @m::column("refParentNE")
    @g::field_view(g::dimension_group("network-element/ref_parent_ne", String.type, True, [g::Filter::Eq]), "ne_parent_ne_id", True, [g::Filter::Eq])
    ref_parent_ne: Option(String),
    @m::column("refParentSubnet")
    @g::field_view(g::dimension_group("network-element/ref_parent_subnet", domain::Reference(ids::SubnetById).type, True, [g::Filter::Eq]), "ne_parent_subnet_id", True, [g::Filter::Eq])
    ref_parent_subnet: Option(domain::Reference(ids::SubnetById)),
};

pub def relations: Array(r::Relation) = [
    r::relation("ne_located_in_subnet", domain::endpoint(NetworkElement.type, "ref_parent_subnet"), domain::endpoint(subnet::Subnet.type, "id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ne__alarm_record", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(alarm_record::AlarmRecord.type, "me_dn"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne__ne2kpi", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(network_element_2_kpi::NetworkElement2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ne__ne2kpifan", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(network_element_2_kpi_fan::NetworkElement2KpiFan.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ne__ne2kpifatap", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(network_element_2_kpi_fatap::NetworkElement2KpiFatap.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ne__remote_ne", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(remote_network_element::RemoteNetworkElement.type, "ref_parent_ne"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ne__frame", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(enterprise_frame::EnterpriseFrame.type, "ref_parent_ne"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne__ltp", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(enterprise_network_ltp::EnterpriseNetworkLtp.type, "ref_parent_ne"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne__optical_module", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(enterprise_optical_module::EnterpriseOpticalModule.type, "ne_res_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne__slot", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(enterprise_slot::EnterpriseSlot.type, "ref_parent_ne"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne__plink_a", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(enterprise_physical_link::EnterprisePhysicalLink.type, "a_ne_res_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne__plink_z", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(enterprise_physical_link::EnterprisePhysicalLink.type, "z_ne_res_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne__terminal", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(terminal_info::TerminalInfo.type, "access_device_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ne__ea_rev", domain::endpoint(NetworkElement.type, "id"), domain::endpoint(enterprise_ap::EnterpriseAp.type, "ref_parent_ne"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
