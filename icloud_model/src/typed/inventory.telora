use super::site as site;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 首批独立声明：Tenant 与 EntNetworkElement，保留现有 transform 名称和源编码。
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;

type TenantId = struct(String);
type DeviceId = struct(String);
type SiteId = struct(String);
@domain::entity_by("Tenant")
type TenantById = struct(TenantId);
@domain::entity_by("Device")
type DeviceById = struct(DeviceId);
@knowledge_policy::reverse_references(True)
type DeviceClass = enum {
    @ev::description("无线控制器", "无线控制器")
    Wac,

    @ev::description("交换机", "交换机")
    Lsw,

    @ev::description("路由器", "路由器")
    Router,

    @ev::description("防火墙", "防火墙")
    Firewall,

    @ev::description("无线接入点", "无线接入点")
    Ap,

    @ev::description("天关", "天关")
    Tianguan,

    @ev::description("打印机", "打印机")
    Printer,

    @ev::description("不间断电源", "不间断电源")
    Ups,

    @ev::description("负载均衡器", "负载均衡器")
    Lb,

    @ev::description("其他设备", "其他设备")
    Others,
    Unknown,
};
@knowledge_policy::reverse_references(True)
type DeviceCommuState = enum {
    Online,

    Offline,

    Other,
};

@edsl::reference("id", ["id"])
@domain::subject("Device", "id")
@domain::dataset("device", "I_EntNetworkElement", ["id"])
@domain::record_counts(["device_count"])
type IEntNetworkElement = struct {
    @edsl::field_role(edsl::FieldRole::Appellation)
    @g::search("device_alias")
    alias: String,
    @edsl::field_role(edsl::FieldRole::Classification)
    @g::exact("device_class_raw")
    @v::map_or(
        DeviceClass.type,
        "device_class",
        [
            v::member(DeviceClass::Wac, ["ne.category.ac", "AC", "WAC"]),
            v::member(DeviceClass::Lsw, ["ne.category.switch", "LSW"]),
            v::member(DeviceClass::Router, ["ne.category.router", "AR"]),
            v::member(DeviceClass::Firewall, ["ne.category.firewall", "FW"]),
            v::member(DeviceClass::Ap, ["ne.category.fatap", "AP"]),
            v::member(DeviceClass::Tianguan, ["TianGuan"]),
            v::member(DeviceClass::Printer, ["ne.category.printer", "printer"]),
            v::member(DeviceClass::Ups, ["ne.category.ups", "ups"]),
            v::member(DeviceClass::Lb, ["ne.category.lb", "lb"]),
            v::member(DeviceClass::Others, ["ne.category.unknown"])
        ],
        DeviceClass::Unknown
    )
    classification: String,
    @m::column("commuState")
    @g::exact("device_commu_state_raw")
    @v::map(
        DeviceCommuState.type,
        "device_commu_state",
        [
            v::member(DeviceCommuState::Online, ["0", "online"]),
            v::member(DeviceCommuState::Offline, ["1", "offline"]),
            v::member(DeviceCommuState::Other, ["other"])
        ]
    )
    commu_state: String,
    @g::exact("device_id")
    id: DeviceById,
    @m::column("tenantId")
    @g::exact("device_tenant_id")
    tenant_id: domain::Reference(TenantById),
    @m::column("projectId")
    project_id: domain::Reference(site::SiteById),
    @m::column("refParentSubnet")
    ref_parent_subnet: domain::Reference(site::SiteById),
    @edsl::field_role(edsl::FieldRole::Appellation)
    @g::search("device_name")
    name: String,
    # 沿用现有 Local 毫秒假定，未在本次迁移中确认生产时钟单位。
    @m::column("createTime")
    @g::epoch_millis("device_create_ms")
    create_time: s::EpochMillis,
    @g::search("device_mac")
    mac: String,
    @m::column("ipAddress")
    @g::search("device_ip_address")
    @g::ipv4_view("device_ip_address_ipv4")
    ip_address: String,
    @edsl::field_role(edsl::FieldRole::Classification)
    @g::search("device_manufacturer")
    manufacturer: String,
    @m::column("location")
    @g::search("device__location")
    source_location: String,
    @m::column("typeId")
    @g::exact("device__typeId")
    source_typeId: String,
    @m::column("version")
    @g::search("device__version")
    source_version: String,
    @m::column("timeZone")
    @g::exact("device__timeZone")
    source_timeZone: s::TimeZone,
    @m::column("sn")
    @g::search("device__sn")
    source_sn: String,
    @m::column("productName")
    @g::search("device__productName")
    source_productName: String,
    @m::column("language")
    @g::exact("device__language")
    source_language: String,
    @m::column("remark")
    @g::search("device__remark")
    source_remark: String,
    @m::column("neOsVersion")
    @g::search("device__neOsVersion")
    source_neOsVersion: String,
    @m::column("nePatchVersion")
    @g::search("device__nePatchVersion")
    source_nePatchVersion: String,
};

@domain::subject("Tenant", "id")
@domain::dataset("tenant", "X_TENANT_VIEW", ["id"])
@domain::record_counts(["tenant_count"])
@domain::relations(relations)
type XTenantView = struct {
    @m::column("TENANT_ID")
    @g::exact("tenant_id")
    id: TenantById,
    @m::column("TENANT_NAME")
    @g::search("tenant_name")
    name: String,
    @m::column("INDUSTRY")
    @g::exact("tenant_industry")
    industry: String,
    # 沿用现有 Local 毫秒假定，不从整数编码推断 UTC。
    @m::column("TENANT_ACCESS_TIME")
    @g::epoch_millis("tenant_access_ms")
    access_time: s::EpochMillis,
};

def tenant_subject: r::Endpoint = domain::endpoint(XTenantView.type, "id");
def device_subject: r::Endpoint = domain::endpoint(IEntNetworkElement.type, "id");
def device_tenant: r::Endpoint = domain::endpoint(IEntNetworkElement.type, "tenant_id");

def relations: Array(r::Relation) = [
    r::relation(
        "device_belongs_to_tenant",
        device_tenant,
        tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntNetworkElement_X_TENANT_VIEW",
        device_tenant,
        tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{
    IEntNetworkElement,
    XTenantView,
    TenantId,
    DeviceId,
    DeviceById,
    TenantById,
    device_subject,
    tenant_subject,
    device_tenant,
    relations,
    SiteId,
    DeviceClass
};

pub use self::{DeviceCommuState};
