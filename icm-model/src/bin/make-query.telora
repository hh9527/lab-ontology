# bin/make-query Telora entry (icm-model.a3)
#
# The Host adapter `bin/make-query` invokes this entry with eval-with and one
# named source "input" holding an intent JSON file.  This module decodes the
# intent (an `Intent` = ontology QueryRequest fields plus optional `any_of` /
# `exists` / `having` / `group_count` envelope fields; `measures` may be empty
# for row projection) and lowers it to a single parameterized Query encoded as
# the sole stdout Value.
#
# The Host adapter captures this entry's stdout in `icm-eval/ok.json` and
# stderr in `icm-eval/diagnostic.jsonl`, then reports the Telora exit code.
# On success stdout is exactly one Query value; on failure no partial Query is
# emitted and deterministic diagnostics are written to stderr.

import "@src/query" as facade;
import "ontology/edsl" as edsl;
import "ontology/query" as qb;
import "std/codec" as codec;
import "std/dict" as dict;
import "std/entry" as entry;
import "std/result" as result;
import "std/value" {Value};

def config: entry.ContextConfig = {sources: ["input"], envs: [], args: 'False};

# Number of Intent envelope-only keys present in the raw object.  A valid full
# Intent envelope carries all of them (arrays may be empty; group_count may be
# null); a plain QueryRequest shorthand carries none.  Any other combination is
# a malformed / partial envelope and fails deterministically below, so a lenient
# QueryRequest decode can never silently drop exists/having/group_count.
def envelope_key_count: Fn(Value) -> Int = fn(raw) {
    match raw {
        'Object(obj) => {
            let key_present: Fn(String) -> Bool = fn(name) {
                match dict.get(obj, name) {
                    'Some(_) => 'True,
                    'None => 'False,
                }
            };
            let any_of: Bool = key_present("any_of");
            let exists: Bool = key_present("exists");
            let having: Bool = key_present("having");
            let group_count: Bool = key_present("group_count");
            let step1: Int = if any_of { 1 } else { 0 };
            let step2: Int = if exists { step1 + 1 } else { step1 };
            let step3: Int = if having { step2 + 1 } else { step2 };
            let step4: Int = if group_count { step3 + 1 } else { step3 };
            step4
        },
        _ => 0,
    }
};

def evaluate: Fn(entry.Context) -> Value = fn(ctx) {
    let raw: Value = match dict.get(ctx.sources, "input") {
        'Some(value) => value,
        'None => fail!("make-query: missing input source"),
    };
    let present: Int = envelope_key_count(raw);
    let intent: facade.Intent = if present == 0 {
        # Plain QueryRequest shorthand (no envelope fields present).
        let request: edsl.QueryRequest = codec.decode(edsl.QueryRequest, raw)
            |> result.unwrap;
        facade.intent_from_request(request)
    } else if present == 4 {
        # Full Intent envelope.  Any structural/type mismatch is a deterministic
        # failure; it is never silently downgraded to a QueryRequest.
        match codec.decode(facade.Intent, raw) {
            'Ok(value) => value,
            'Err(_) => fail!("make-query: invalid intent envelope", raw),
        }
    } else {
        fail!("make-query: partial intent envelope", raw)
    };
    let query: qb.Query = facade.make_intent_query(intent);
    codec.encode(Value, query) |> result.unwrap
};

export def main = entry.main(config, evaluate);
