# 声明入口与局部发布边界共用的名称约束。
use crate::query as q;
use std::pipeline as pipeline;

def name: Fn(String) -> () = fn(value) {
    if value == "" {
        fail!("property name must be nonempty")
    } else {
        ()
    }
};
def publish_name: Fn(String) -> () = fn(value) {
    if !q::is_sql_identifier(value) {
        fail!("property publish name must be a valid identifier", value)
    } else {
        ()
    }
};
def unique: Fn(Array(String)) -> () = fn(values) {
    pipeline::run(
        pipeline::from_array(values) |> pipeline::unique_by(
            fn(value) {
                value
            }
        ) |> pipeline::collect()
    );
    ()
};
pub use self::{name, publish_name, unique};
