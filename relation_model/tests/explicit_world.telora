use crate::typed_relations as original;
use crate::explicit_world::{model_world};
use ontology::world as world;
use ontology::model as m;
use std::array as array;
use std::codec as codec;
use std::value::{Value};

type Nested = struct { payload: Array(Option(original::DeviceId)) };
type Tree = enum { Leaf(original::DeviceId), Children(Array(Tree)) };
type UnusedId = struct(String);
type UnusedIdentity = struct { id: UnusedId };
def extra_world: world::World = model_world <~ {
    entities: array::push(model_world.entities, world::entity(m::entity("unbound_entity", UnusedIdentity.type))),
};
type Report = struct {
    valid: Array(world::Issue),
    checked: Bool,
    missing_entity: Array(world::Issue),
    duplicate_entity: Array(world::Issue),
    missing_dataset: Array(world::Issue),
    duplicate_dataset: Array(world::Issue),
    missing_relation: Array(world::Issue),
    duplicate_relation: Array(world::Issue),
    conflicting_dataset: Array(world::Issue),
    missing_role: Array(world::Issue),
    recursive_and_unreferenced: Array(world::Issue),
};
def issues: Value = codec::encode({
    valid: world::coverage(model_world),
    checked: world::self_check(model_world),
    missing_entity: world::coverage(model_world <~ {entities: array::filter(model_world.entities, fn(e) { e.id != original::device.id })}),
    duplicate_entity: world::coverage(model_world <~ {entities: [world::entity(original::device), world::entity(original::device)]}),
    missing_dataset: world::coverage(model_world <~ {datasets: array::filter(model_world.datasets, fn(d) { d.dataset.id != original::devices.id })}),
    duplicate_dataset: world::coverage(model_world <~ {datasets: array::push(model_world.datasets, model_world.datasets[0])}),
    missing_relation: world::coverage(model_world <~ {relations: array::filter(model_world.relations, fn(r) { r.id != original::connection_a.id })}),
    duplicate_relation: world::coverage(model_world <~ {relations: array::push(model_world.relations, model_world.relations[0])}),
    conflicting_dataset: world::coverage(model_world <~ {datasets: array::map(model_world.datasets, fn(d) {
        if d.dataset.id == original::devices.id { d <~ {dataset: d.dataset <~ {source: "other_devices"}} } else { d }
    })}),
    missing_role: world::coverage(model_world <~ {datasets: array::map(model_world.datasets, fn(d) {
        if d.dataset.id == original::devices.id { d <~ {dataset: d.dataset <~ {roles: []}} } else { d }
    })}),
    recursive_and_unreferenced: world::coverage(extra_world),
}.ty!(Report));
def extra_publication: Value = world::publication(extra_world, world::prepare(extra_world));
pub use self::{issues, extra_publication};
