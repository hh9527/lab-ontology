use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# ServerMemory独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(
    String
);
@registry::entity("server_memory_entity")
type Identity = struct {
    id: ComponentId
};
# 保留源MB编码，不自动转换为Bytes或推断二进制倍率
type Megabytes = struct(
    Int
);
@registry::dataset("server_memory", "PhysicalServerMemory", ["id"])
@registry::roles([subject, parent, tenant])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("server_memory__bitWidth", Int.type, True, g::numeric_filters),
            g::input(m::field(PhysicalServerMemory.type, Int.type, "source_bitWidth")),
            "server_memory__bitWidth",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_memory__frequency", Int.type, True, g::numeric_filters),
            g::input(m::field(PhysicalServerMemory.type, Int.type, "source_frequency")),
            "server_memory__frequency",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_memory__capacity", Megabytes.type, True, g::numeric_filters),
            g::input(m::field(PhysicalServerMemory.type, Megabytes.type, "source_capacity")),
            "server_memory__capacity",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
type PhysicalServerMemory = struct {
    id: ComponentId,
    @g::search("server_memory_name")
    name: String,
    @m::column("parentResId")
    parent_res_id: server::ServerOriginId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @m::column("partNumber")
    @g::search("server_memory__partNumber")
    source_partNumber: String,
    @m::column("manufacturer")
    @g::search("server_memory__manufacturer")
    source_manufacturer: String,
    @m::column("type")
    @g::exact("server_memory__type")
    source_type: String,
    @m::column("serialNumber")
    @g::search("server_memory__serialNumber")
    source_serialNumber: String,
    @m::column("bitWidth")
    source_bitWidth: Int,
    @m::column("frequency")
    source_frequency: Int,
    @m::column("capacity")
    source_capacity: Megabytes,
    @m::column("model")
    @g::search("server_memory__model")
    source_model: String,
    @m::column("healthStatus")
    @v::classification(health, "server_memory__healthStatus")
    source_healthStatus: Int,
    @m::column("memoryName")
    @g::search("server_memory__memoryName")
    source_memoryName: String,
    @m::column("dn")
    @g::exact("server_memory__dn")
    source_dn: String,
    @m::column("projectId")
    @g::exact("server_memory__projectId")
    source_projectId: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(PhysicalServerMemory) = registry::dataset_of(PhysicalServerMemory.type);
def subject: m::Role(PhysicalServerMemory) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerMemory.type, ComponentId.type, "id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def parent: m::Role(PhysicalServerMemory) = m::role(
    dataset,
    server::origin_entity,
    "server_origin",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerMemory.type, server::ServerOriginId.type, "parent_res_id"),
            m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServerMemory) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerMemory.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type ServerMemoryHealthStatus = enum {
    @ev::itag(0)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("warning", "警告")
    Warning,
    @ev::itag(2)
    @ev::description("average", "一般")
    Average,
    @ev::itag(3)
    @ev::description("serious", "严重")
    Serious,
    @ev::itag(4)
    @ev::description("critical", "紧急")
    Critical,
    @ev::itag(-1)
    @ev::description("wrong", "错误")
    Wrong,
    @ev::itag(-2)
    @ev::description("unknown", "未知")
    Unknown,
};
def health: v::Domain(ServerMemoryHealthStatus, Int) = v::from_enum(
    "ServerMemoryHealthStatus",
    ServerMemoryHealthStatus.type,
    Int.type,
    False
);
def declaration: t::Declaration = registry::declaration(PhysicalServerMemory.type);
def tenant_cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "memory_parent_server",
        dataset,
        parent,
        server::dataset,
        server::origin,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_PhysicalServerMemory",
        server::dataset,
        server::origin,
        dataset,
        parent,
        tenant_cardinality
    ),
    r::relation(
        "source_PhysicalServerMemory_X_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        tenant_cardinality
    ),
];
pub use self::{declaration, relations};

pub use self::{PhysicalServerMemory, Identity};
