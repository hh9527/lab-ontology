use crate::model::{ payload, Tenant, Site, Device, Connection, Route };
use ontology::intent::{ query_intent_ast_factory };
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::json as json;
use std::string as string;
use std::test as test;
use std::array as array;
use std::value::{ Value };

def lower: Fn(Value) -> qb::QueryAst = query_intent_ast_factory(payload, "resolver");

@edsl::entity_id("foreign_link")
@edsl::entity_source("foreign_links", "foreign_link")
@edsl::business_link("foreign_peer", "connection_a", "connection_z", edsl::LinkDirection::Undirected)
type ForeignLink = struct {
    @edsl::column("id")
    @edsl::key(True)
    id: String,
};

@edsl::entity_id("same_endpoint_link")
@edsl::entity_source("same_endpoint_links", "same_endpoint_link")
@edsl::business_link("same_endpoint_peer", "same_endpoint_a", "same_endpoint_z", edsl::LinkDirection::Undirected)
@edsl::named_typed_relation_key("same_endpoint_a", SameEndpointLink.type, Device.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(SameEndpointLink.type, String.type, "device_id"), edsl::model_field(Device.type, String.type, "id")),
    edsl::typed_relation_pair(edsl::model_field(SameEndpointLink.type, String.type, "tenant_id"), edsl::model_field(Device.type, String.type, "tenant_id")),
])
@edsl::named_typed_relation_key("same_endpoint_z", SameEndpointLink.type, Device.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(SameEndpointLink.type, String.type, "device_id"), edsl::model_field(Device.type, String.type, "id")),
    edsl::typed_relation_pair(edsl::model_field(SameEndpointLink.type, String.type, "tenant_id"), edsl::model_field(Device.type, String.type, "tenant_id")),
])
type SameEndpointLink = struct {
    @edsl::column("device_id")
    device_id: String,
    @edsl::column("id")
    @edsl::key(True)
    id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

pub def rejects_foreign_hub_endpoint: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid", [Tenant.type, Site.type, Device.type, Connection.type, Route.type, ForeignLink.type],
        payload.profile, fn(subject) { subject == "resolver" })
}, "business link A endpoint relation is not declared on its hub");

pub def rejects_same_endpoint_twice: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid", [Tenant.type, Site.type, Device.type, Connection.type, Route.type, SameEndpointLink.type],
        payload.profile, fn(subject) { subject == "resolver" })
}, "business link endpoints must carry the same complete identity through distinct roles");

pub def declared_business_links: test::Test = test::should_ok(fn() {
    let symmetric = array::find(payload.business_links, fn(link) { link.id == "connected_device" });
    let directed = array::find(payload.business_links, fn(link) { link.id == "upstream_device" });
    match (symmetric, directed) {
        (Some(a), Some(b)) => if a.direction == edsl::LinkDirection::Undirected
            && b.direction == edsl::LinkDirection::Directed
            && a.participant == b.participant { True }
            else { fail!("business direction was not preserved in prepared Model") },
        _ => fail!("missing prepared business link"),
    }
});

pub def undirected_business_link: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"a",
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"connected_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, " OR ")
        && string::contains(sq.sql, "a_device_id") && string::contains(sq.sql, "z_device_id")
        && string::contains(sq.sql, "tenant_id") && string::contains(pg.sql, " OR ") {
        True
    } else { fail!("bidirectional link did not bind both complete endpoint identities", sq.sql, pg.sql) }
});

pub def undirected_business_link_from_z: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"z",
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"connected_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, " OR ") && string::contains(sql, "connected_device_link") {
        True
    } else { fail!("undirected link should be traversable from either device", sql) }
});

pub def directed_business_link: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"a",
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"upstream_device","from":"a","to":"z"}],
        "select":[{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "a_device_id") && string::contains(sql, "z_device_id")
        && !string::contains(sql, " OR ") {
        True
    } else { fail!("directed link must retain A-to-Z orientation", sql) }
});

pub def directed_business_link_rejects_reverse: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"z",
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"upstream_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"}]
    }"#).unwrap!())
}, "directed business link cannot be traversed from Z to A");

pub def count_devices_with_business_peer: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"peer","entity":"device"}],
            "edges":[{"relation":"connected_device","from":"d","to":"peer"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "count(d.id)")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM connections")
        && string::contains(sq.sql, " OR ") && string::contains(sq.sql, "tenant_id")
        && string::contains(pg.sql, "EXISTS (SELECT 1 FROM \"connections\"") {
        True
    } else { fail!("business peer existence must preserve device grain and both identities", sq.sql, pg.sql) }
});

pub def directed_business_peer_exists: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"peer","entity":"device"}],
            "edges":[{"relation":"upstream_device","from":"d","to":"peer"}]}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "routes AS upstream_device_link") && !string::contains(sql, " OR ") {
        True
    } else { fail!("directed peer existence changed orientation", sql) }
});

pub def directed_business_peer_exists_rejects_reverse: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"z", "nodes":[{"id":"z","entity":"device"}],
        "edges":[], "select":[], "count":"z",
        "exists":[{"anchor":"z","nodes":[{"id":"a","entity":"device"}],
            "edges":[{"relation":"upstream_device","from":"a","to":"z"}]}]
    }"#).unwrap!())
}, "directed business link cannot be traversed from Z to A");

pub def scoped_peer_filter_keeps_distinct_bindings: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
        "filters":[{"node":"d","dimension":"device_id","op":"eq","kind":"text","value":"origin"}],
        "exists":[{"anchor":"d","nodes":[{"id":"peer","entity":"device"}],
            "edges":[{"relation":"connected_device","from":"d","to":"peer"}],
            "filters":[{"node":"peer","dimension":"device_id","op":"eq","kind":"text","value":"target"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "d.id = ?1") && string::contains(sq.sql, "peer.id = ?2")
        && string::contains(pg.sql, "\"d\".\"id\" = $1")
        && string::contains(pg.sql, "\"peer\".\"id\" = $2")
        && sq.bindings == [qb::Val::String("origin"), qb::Val::String("target")]
        && pg.bindings == sq.bindings {
        True
    } else { fail!("graph peer filter lost role aliases or binding order", sq, pg) }
});

pub def peer_site_exists_at_device_grain: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"peer","entity":"device"},{"id":"site","entity":"site"}],
            "edges":[{"relation":"connected_device","from":"d","to":"peer"},
                     {"relation":"device_site","from":"peer","to":"site"}],
            "filters":[{"node":"site","dimension":"site_id","op":"eq","kind":"text","value":"site-1"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "EXISTS (SELECT 1 FROM connections AS connected_device_link")
        && string::contains(sq.sql, "JOIN sites AS site")
        && string::contains(sq.sql, "peer.site_id = site.id")
        && string::contains(sq.sql, "site.id = ?1")
        && string::contains(pg.sql, "JOIN \"sites\" AS \"site\"") {
        True
    } else { fail!("peer site constraint escaped its correlated EXISTS", sq, pg) }
});

pub def later_business_link_in_existence: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[{"node":"d","dimension":"device_id"}],
        "exists":[{"anchor":"d","nodes":[{"id":"tenant","entity":"tenant"},
            {"id":"other","entity":"device"},{"id":"peer","entity":"device"}],
            "edges":[{"relation":"device_tenant","from":"d","to":"tenant"},
                     {"relation":"device_tenant","from":"other","to":"tenant"},
                     {"relation":"connected_device","from":"other","to":"peer"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "JOIN devices AS other")
        && string::contains(sq.sql, "JOIN connections AS connected_device_link")
        && string::contains(sq.sql, "JOIN devices AS peer")
        && string::contains(sq.sql, "peer.id")
        && string::contains(pg.sql, "JOIN \"connections\" AS \"connected_device_link\"") {
        True
    } else { fail!("later business link lost the correlated path", sq.sql, pg.sql) }
});

pub def later_directed_link_rejects_reverse: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[{"node":"d","dimension":"device_id"}],
        "exists":[{"anchor":"d","nodes":[{"id":"tenant","entity":"tenant"},
            {"id":"other","entity":"device"},{"id":"peer","entity":"device"}],
            "edges":[{"relation":"device_tenant","from":"d","to":"tenant"},
                     {"relation":"device_tenant","from":"other","to":"tenant"},
                     {"relation":"upstream_device","from":"peer","to":"other"}]}]
    }"#).unwrap!())
}, "directed business link cannot be traversed from Z to A");

pub def filter_rejects_wrong_instance_type: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[{"node":"d","dimension":"device_id"}],
        "filters":[{"node":"d","dimension":"site_id","op":"eq","kind":"text","value":"site-1"}]
    }"#).unwrap!())
}, "graph filter dimension does not belong to its named node");

pub def role_distinct_join: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"link",
        "nodes":[{"id":"link","entity":"connection"},{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"connection_a","from":"link","to":"a"},{"relation":"connection_z","from":"link","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "a_device_id") && string::contains(sq.sql, "z_device_id")
        && string::contains(sq.sql, " AS a") && string::contains(sq.sql, " AS z")
        && string::contains(pg.sql, " AS \"a\"") && string::contains(pg.sql, " AS \"z\"")
        && string::contains(sq.sql, "tenant_id") && string::contains(pg.sql, "tenant_id") {
        True
    } else { fail!("graph did not retain both endpoint identities", sq.sql, pg.sql) }
});

pub def two_hop: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"},{"id":"s","entity":"site"},{"id":"t","entity":"tenant"}],
        "edges":[{"relation":"device_site","from":"d","to":"s"},{"relation":"site_tenant","from":"s","to":"t"}],
        "select":[{"node":"d","dimension":"device_id"},{"node":"t","dimension":"tenant_id"}]
    }"#).unwrap!());
    let query = sqlite::build_query(ast);
    if string::contains(query.sql, "JOIN sites") && string::contains(query.sql, "JOIN tenants") {
        True
    } else { fail!("two-hop graph did not lower", query.sql) }
});

pub def reverse_navigation_preserves_role: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"},{"id":"link","entity":"connection"}],
        "edges":[{"relation":"connection_a","from":"link","to":"d"}],
        "select":[{"node":"d","dimension":"device_id"}]
    }"#).unwrap!());
    let query = sqlite::build_query(ast);
    if string::contains(query.sql, "link.a_device_id = d.id")
        && string::contains(query.sql, "link.tenant_id = d.tenant_id") {
        True
    } else { fail!("reverse navigation lost the declared endpoint role", query.sql) }
});

pub def two_hop_exists_keeps_device_grain: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"}], "edges":[],
        "select":[{"node":"d","dimension":"device_id"}],
        "exists":[{"anchor":"d","nodes":[{"id":"s","entity":"site"},{"id":"t","entity":"tenant"}],
            "edges":[{"relation":"device_site","from":"d","to":"s"},
                     {"relation":"site_tenant","from":"s","to":"t"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "EXISTS (SELECT 1 FROM sites AS s INNER JOIN tenants AS t")
        && string::contains(sq.sql, "d.site_id = s.id")
        && string::contains(pg.sql, "EXISTS (SELECT 1 FROM \"sites\" AS \"s\"") {
        True
    } else { fail!("two-hop existence altered root grain", sq.sql, pg.sql) }
});

pub def branching_exists_keeps_device_grain: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"s","entity":"site"},{"id":"t","entity":"tenant"}],
            "edges":[{"relation":"device_site","from":"d","to":"s"},
                     {"relation":"device_tenant","from":"d","to":"t"}],
            "filters":[{"node":"s","dimension":"site_id","op":"eq","kind":"text","value":"site-1"},
                       {"node":"t","dimension":"tenant_id","op":"eq","kind":"text","value":"tenant-1"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "EXISTS (SELECT 1 FROM sites AS s INNER JOIN tenants AS t")
        && string::contains(sq.sql, "d.tenant_id = t.id")
        && string::contains(sq.sql, "s.id = ?1") && string::contains(sq.sql, "t.id = ?2")
        && string::contains(pg.sql, "JOIN \"tenants\" AS \"t\"") {
        True
    } else { fail!("branching existence did not keep its root correlation", sq, pg) }
});

pub def branching_exists_rejects_disconnected_edge: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[{"node":"d","dimension":"device_id"}],
        "exists":[{"anchor":"d","nodes":[{"id":"s","entity":"site"},{"id":"t","entity":"tenant"}],
            "edges":[{"relation":"site_tenant","from":"s","to":"t"},
                     {"relation":"device_site","from":"d","to":"s"}]}]
    }"#).unwrap!())
}, "graph existence edge must introduce one node connected to the root");

pub def reverse_exists_keeps_tenant_identity: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"}], "edges":[],
        "select":[{"node":"d","dimension":"device_id"}],
        "exists":[{"anchor":"d","nodes":[{"id":"link","entity":"connection"}],
            "edges":[{"relation":"connection_a","from":"link","to":"d"}]}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "d.id = link.a_device_id")
        && string::contains(sql, "d.tenant_id = link.tenant_id") {
        True
    } else { fail!("reverse existence dropped endpoint identity", sql) }
});

pub def exists_wrong_role: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"}], "edges":[],
        "select":[{"node":"d","dimension":"device_id"}],
        "exists":[{"anchor":"d","nodes":[{"id":"t","entity":"tenant"}],
            "edges":[{"relation":"connection_a","from":"t","to":"d"}]}]
    }"#).unwrap!())
}, "graph existence edge role or target does not match declared relation");

pub def three_hop_exists: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}], "edges":[],
        "select":[{"node":"d","dimension":"device_id"}],
        "exists":[{"anchor":"d","nodes":[{"id":"s","entity":"site"},{"id":"t","entity":"tenant"},{"id":"d2","entity":"device"}],
            "edges":[{"relation":"device_site","from":"d","to":"s"},
                     {"relation":"site_tenant","from":"s","to":"t"},
                     {"relation":"device_tenant","from":"d2","to":"t"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "FROM sites AS s")
        && string::contains(sq.sql, "JOIN tenants AS t")
        && string::contains(sq.sql, "JOIN devices AS d2")
        && string::contains(pg.sql, "JOIN \"devices\" AS \"d2\"") {
        True
    } else { fail!("three-hop existence did not stay correlated", sq.sql, pg.sql) }
});

pub def absence_is_correlated: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}], "edges":[],
        "select":[{"node":"d","dimension":"device_id"}],
        "exists":[{"anchor":"d","negated":true,"nodes":[{"id":"link","entity":"connection"}],
            "edges":[{"relation":"connection_z","from":"link","to":"d"}]}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "NOT EXISTS (SELECT 1 FROM connections AS link")
        && string::contains(sql, "d.id = link.z_device_id") {
        True
    } else { fail!("graph absence did not preserve Z role", sql) }
});

pub def count_device_with_connection_exists: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}], "edges":[],
        "select":[], "count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"link","entity":"connection"}],
            "edges":[{"relation":"connection_a","from":"link","to":"d"}]}]
    }"#).unwrap!());
    let query = sqlite::build_query(ast);
    if string::contains(query.sql, "count(d.id)")
        && string::contains(query.sql, "EXISTS (SELECT 1 FROM connections AS link") {
        True
    } else { fail!("graph count lost root grain", query.sql) }
});

pub def count_device_with_safe_site: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"},{"id":"s","entity":"site"}],
        "edges":[{"relation":"device_site","from":"d","to":"s"}],
        "select":[], "count":"d"
    }"#).unwrap!());
    let query = sqlite::build_query(ast);
    if string::contains(query.sql, "count(d.id)") && string::contains(query.sql, "JOIN sites") {
        True
    } else { fail!("safe site join should preserve device grain", query.sql) }
});

pub def count_devices_by_tenant_with_proven_child_grain: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"tenant",
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"device"
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "count(device.id)")
        && string::contains(sq.sql, "GROUP BY tenant.id")
        && string::contains(sq.sql, "device.tenant_id = tenant.id")
        && string::contains(pg.sql, "GROUP BY \"tenant\".\"id\"") {
        True
    } else { fail!("tenant/device count lost explicit child grain", sq, pg) }
});

pub def grouped_count_rejects_nonroot_dimension: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"tenant",
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"device","dimension":"device_id"}], "count":"device"
    }"#).unwrap!())
}, "graph count grouping dimensions must belong to the root");

pub def count_rejects_shared_tenant_as_site_identity: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"site",
        "nodes":[{"id":"site","entity":"site"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"site_tenant_devices","from":"site","to":"device"}],
        "select":[{"node":"site","dimension":"site_id"}], "count":"device"
    }"#).unwrap!())
}, "graph cannot prove the non-root count subject has one row per root relationship");

pub def count_rejects_reverse_safe_fanout: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"},{"id":"link","entity":"connection"}],
        "edges":[{"relation":"connection_a","from":"link","to":"d"}],
        "select":[], "count":"d"
    }"#).unwrap!())
}, "graph count requires grain-safe forward joins; use existence for fan-out edges");

pub def wrong_role: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"link",
        "nodes":[{"id":"link","entity":"connection"},{"id":"s","entity":"site"}],
        "edges":[{"relation":"connection_a","from":"link","to":"s"}],
        "select":[{"node":"s","dimension":"site_id"}]
    }"#).unwrap!())
}, "graph edge role or target does not match declared relation");

pub def disconnected: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"},{"id":"s","entity":"site"}],
        "edges":[], "select":[{"node":"d","dimension":"device_id"}]
    }"#).unwrap!())
}, "graph contains nodes disconnected from the root");

pub def missing_relation: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d",
        "nodes":[{"id":"d","entity":"device"},{"id":"s","entity":"site"}],
        "edges":[{"relation":"guessed_shortest_path","from":"d","to":"s"}],
        "select":[{"node":"s","dimension":"site_id"}]
    }"#).unwrap!())
}, "unknown named relation");
