        "op":"graph", "root":"reading", "nodes":[{"id":"reading","entity":"reading"}],
        "edges":[], "select":[], "count":"reading"
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "count(reading.reading_id)") {
        True
    } else { fail!("root dataset count has no single-column key", sql) }
});

pub def root_count_rejects_missing_identity: test::Test = test::should_fail_with(fn() {
    lower_count_grain(json::parse(r#"{
