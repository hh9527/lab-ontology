# RFC 0002 的 transform 实验：显式 Entity／Dataset／Role 决定连接键。
use ontology::model as m;
use ontology::registry as registry;
use std::array as array;
use ontology::groups as g;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;

type TenantId = struct(String);
type SiteId = struct(String);
type DeviceId = struct(String);
type ConnectionId = struct(String);
type RouteId = struct(String);
@registry::entity("tenant_entity")
type TenantIdentity = struct {
    local: TenantId
};
@registry::entity("site_entity")
type SiteIdentity = struct {
    tenant: TenantId,
    local: SiteId
};
@registry::entity("device_entity")
type DeviceIdentity = struct {
    tenant: TenantId,
    local: DeviceId
};
@registry::entity("connection_entity")
type ConnectionIdentity = struct {
    tenant: TenantId,
    local: ConnectionId
};
@registry::entity("route_entity")
type RouteIdentity = struct {
    tenant: TenantId,
    local: RouteId
};
@registry::dataset("tenant", "tenants", ["id"])
@registry::roles([tenant_subject])
@registry::groups([id_dimension(tenants, TenantId.type, "id", "tenant_id")])
@registry::record_counts([])
@registry::relations(declarations)
@registry::alternatives(alternatives)
@registry::links([connected, upstream])
type TenantRow = struct {
    id: TenantId
};
@registry::dataset("site", "sites", ["id", "tenant_id"])
@registry::roles([site_subject, tenant_role(sites, "tenant", "tenant_id")])
@registry::groups([id_dimension(sites, SiteId.type, "id", "site_id")])
@registry::record_counts([])
type SiteRow = struct {
    id: SiteId,
    tenant_id: TenantId
};
@registry::dataset("device", "devices", ["id", "tenant_id"])
@registry::roles([device_subject, device_site, tenant_role(devices, "tenant", "tenant_id")])
@registry::groups([id_dimension(devices, DeviceId.type, "id", "device_id")])
@registry::record_counts(["device_count"])
type DeviceRow = struct {
    id: DeviceId,
    site_id: SiteId,
    tenant_id: TenantId
};
@registry::dataset("connection", "connections", ["id", "tenant_id"])
@registry::roles([connection_subject, a, z])
@registry::record_counts([])
type ConnectionRow = struct {
    a_device_id: DeviceId,
    id: ConnectionId,
    tenant_id: TenantId,
    z_device_id: DeviceId
};
@registry::dataset("route", "routes", ["id", "tenant_id"])
@registry::roles([route_subject, route_a, route_z])
@registry::record_counts([])
type RouteRow = struct {
    a_device_id: DeviceId,
    id: RouteId,
    tenant_id: TenantId,
    z_device_id: DeviceId
};

def tenant: m::Entity(TenantIdentity) = registry::entity_of(TenantIdentity.type);
def site: m::Entity(SiteIdentity) = registry::entity_of(SiteIdentity.type);
def device: m::Entity(DeviceIdentity) = registry::entity_of(DeviceIdentity.type);
def connection: m::Entity(ConnectionIdentity) = registry::entity_of(ConnectionIdentity.type);
def route: m::Entity(RouteIdentity) = registry::entity_of(RouteIdentity.type);
def tenants: m::Dataset(TenantRow) = registry::dataset_of(TenantRow.type);
def sites: m::Dataset(SiteRow) = registry::dataset_of(SiteRow.type);
def devices: m::Dataset(DeviceRow) = registry::dataset_of(DeviceRow.type);
def connections: m::Dataset(ConnectionRow) = registry::dataset_of(ConnectionRow.type);
def routes: m::Dataset(RouteRow) = registry::dataset_of(RouteRow.type);

def tenant_role: for(Row) Fn(m::Dataset(Row), String, String) -> m::Role(Row) = fn(
    dataset,
    id,
    field
) {
    m::role(
        dataset,
        tenant,
        id,
        False,
        [
            m::identity_part(
                m::field(Row.type, TenantId.type, field),
                m::field(TenantIdentity.type, TenantId.type, "local")
            )
        ]
    )
};
def scoped_role: for(Row, Identity, Local) Fn(
    m::Dataset(Row),
    m::Entity(Identity),
    TypeOf(Local),
    String,
    String
) -> m::Role(Row) = fn(dataset, entity, local, id, field) {
    m::role(
        dataset,
        entity,
        id,
        False,
        [
            m::identity_part(
                m::field(Row.type, TenantId.type, "tenant_id"),
                m::field(Identity.type, TenantId.type, "tenant")
            ),
            m::identity_part(
                m::field(Row.type, local, field),
                m::field(Identity.type, local, "local")
            ),
        ]
    )
};
def tenant_subject: m::Role(TenantRow) = tenant_role(tenants, "subject", "id");
def site_subject: m::Role(SiteRow) = scoped_role(sites, site, SiteId.type, "subject", "id");
def device_subject: m::Role(DeviceRow) = scoped_role(
    devices,
    device,
    DeviceId.type,
    "subject",
    "id"
);
def device_site: m::Role(DeviceRow) = scoped_role(devices, site, SiteId.type, "site", "site_id");
def connection_subject: m::Role(ConnectionRow) = scoped_role(
    connections,
    connection,
    ConnectionId.type,
    "subject",
    "id"
);
def route_subject: m::Role(RouteRow) = scoped_role(routes, route, RouteId.type, "subject", "id");
def a: m::Role(ConnectionRow) = scoped_role(connections, device, DeviceId.type, "a", "a_device_id");
def z: m::Role(ConnectionRow) = scoped_role(connections, device, DeviceId.type, "z", "z_device_id");
def route_a: m::Role(RouteRow) = scoped_role(routes, device, DeviceId.type, "a", "a_device_id");
def route_z: m::Role(RouteRow) = scoped_role(routes, device, DeviceId.type, "z", "z_device_id");
def many_optional: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def many_many: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Many0
};
def connection_a: r::Relation = r::relation(
    "connection_a",
    r::endpoint(ConnectionRow.type, "a"),
    r::endpoint(DeviceRow.type, "subject"),
    many_optional
);
def connection_z: r::Relation = r::relation(
    "connection_z",
    r::endpoint(ConnectionRow.type, "z"),
    r::endpoint(DeviceRow.type, "subject"),
    many_optional
);
def upstream_a: r::Relation = r::relation(
    "route_a",
    r::endpoint(RouteRow.type, "a"),
    r::endpoint(DeviceRow.type, "subject"),
    many_optional
);
def upstream_z: r::Relation = r::relation(
    "route_z",
    r::endpoint(RouteRow.type, "z"),
    r::endpoint(DeviceRow.type, "subject"),
    many_optional
);
def declarations: Array(r::Relation) = [
    r::relation(
        "site_tenant",
        r::endpoint(SiteRow.type, "tenant"),
        r::endpoint(TenantRow.type, "subject"),
        many_optional
    ),
    r::relation(
        "site_tenant_devices",
        r::endpoint(SiteRow.type, "tenant"),
        r::endpoint(DeviceRow.type, "tenant"),
        many_many
    ),
    r::relation(
        "device_tenant",
        r::endpoint(DeviceRow.type, "tenant"),
        r::endpoint(TenantRow.type, "subject"),
        many_optional
    ),
    r::relation(
        "device_site",
        r::endpoint(DeviceRow.type, "site"),
        r::endpoint(SiteRow.type, "subject"),
        many_optional
    ),
    connection_a,
    connection_z,
    upstream_a,
    upstream_z
];
def connected: r::Link = r::link(
    "connected_device",
    connection_a,
    connection_z,
    edsl::LinkDirection::Undirected
);
def upstream: r::Link = r::link(
    "upstream_device",
    upstream_a,
    upstream_z,
    edsl::LinkDirection::Directed
);

# 输入名义类型与发布名在绑定中显式给出，不读取旧模型注解。
def id_dimension: for(Row, Value) Fn(
    m::Dataset(Row),
    TypeOf(Value),
    String,
    String
) -> g::Binding(Row) = fn(dataset, value, field, publish) {
    g::dimension(
        dataset,
        g::dimension_group("identity_value", value, True, [g::Filter::Eq]),
        g::input(m::field(Row.type, value, field)),
        publish,
        True,
        [g::Filter::Eq]
    )
};
def root_types: Array(Type) = [
    TenantRow.type,
    SiteRow.type,
    DeviceRow.type,
    ConnectionRow.type,
    RouteRow.type,
    TenantIdentity.type,
    SiteIdentity.type,
    DeviceIdentity.type,
    ConnectionIdentity.type,
    RouteIdentity.type
];
def dataset_types: Array(Type) = [
    TenantRow.type,
    SiteRow.type,
    DeviceRow.type,
    ConnectionRow.type,
    RouteRow.type
];
def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source,
        qb::Operator::Project,
        qb::Operator::Column,
        qb::Operator::Bind,
        qb::Operator::Scalar,
        qb::Operator::Aggregate,
        qb::Operator::Filter,
        qb::Operator::Exists,
        qb::Operator::Join,
        qb::Operator::Group
    ],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count],
    allowed_scalars: [
        qb::ScalarFunction::Eq,
        qb::ScalarFunction::And,
        qb::ScalarFunction::IsNotNull
    ],
    allow_distinct: True,
};
def alternatives: Array(registry::Alternative) = [
    {id: "connection_endpoint", choices: [connection_a, connection_z], cardinality: many_many},
];
def payload: edsl::PreparedPayload = registry::payload("typed-relation-v1", root_types, profile);

pub use self::{
    TenantId,
    SiteId,
    DeviceId,
    TenantIdentity,
    SiteIdentity,
    DeviceIdentity,
    TenantRow,
    SiteRow,
    DeviceRow,
    ConnectionRow,
    RouteRow,
    tenant,
    site,
    device,
    tenants,
    sites,
    devices,
    connections,
    routes,
    tenant_subject,
    site_subject,
    device_subject,
    device_site,
    a,
    z,
    route_a,
    route_z,
    many_optional,
    many_many,
    connection_a,
    connection_z,
    upstream_a,
    upstream_z,
    declarations,
    alternatives,
    profile,
    root_types,
    connected,
    upstream,
    payload
};
pub use self::{ConnectionId, RouteId, ConnectionIdentity, RouteIdentity, connection, route};
