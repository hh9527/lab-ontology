        uql::render_expr_with_context(
            qb::scalar(
                qb::ScalarFunction::UtcTimeBucket(
                    {unit: qb::UtcBucketUnit::Week, encoding: qb::UtcBucketEncoding::DateTimeUtc}
                ),
                [id]
            ),
