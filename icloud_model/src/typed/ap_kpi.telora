use ontology::quantity as presentation;
use ontology::semantic as domain;
# 保留暂定租户／资源／UTC 样本身份，生产唯一性仍待 #51 确认。
use super::inventory as i;
use super::ap_quantities as a;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::quantity as q;
use ontology::samples as samples;
use ontology::values as v;
use ontology::query as qb;
type ResourceId = struct(String);
@domain::subject("Device", "source_resId")
@domain::dataset(
    "source_NetworkAPKPI",
    "NetworkAPKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
type NetworkAPKPI = struct {
    @m::column("ts")
    @g::field_view(
        g::dimension_group("source_NetworkAPKPI__ts", s::DateTimeUtc.type, True, g::numeric_filters),
        "source_NetworkAPKPI__ts",
        True,
        g::numeric_filters
    )
    @g::utc_bucket_view("source_NetworkAPKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkAPKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkAPKPI_utc_month", qb::UtcBucketUnit::Month)
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkAPKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkAPKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_NetworkAPKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_NetworkAPKPI__projectId")
    source_projectId: String,
    @m::column("hwCurrAssStationCount")
    @g::field_view(
        g::dimension_group(
            "source_NetworkAPKPI__hwCurrAssStationCount",
            q::Count.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkAPKPI__hwCurrAssStationCount",
        True,
        g::numeric_filters
    )
    @samples::field(
        a::count_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_associated_terminals"},
            {statistic: samples::Statistic::Max, publish: "ap_associated_terminals_max"},
            {statistic: samples::Statistic::Min, publish: "ap_associated_terminals_min"}
        ]
    )
    source_hwCurrAssStationCount: q::Count,
    @m::column("hwApEthportUpRate")
    @g::field_view(
        g::dimension_group(
            "source_NetworkAPKPI__hwApEthportUpRate",
            a::KilobitsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkAPKPI__hwApEthportUpRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        a::rate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_uplink_tx_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_uplink_tx_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_uplink_tx_rate_min"}
        ]
    )
    source_hwApEthportUpRate: a::KilobitsPerSecond,
    @m::column("hwApEthportDownRate")
    @g::field_view(
        g::dimension_group(
            "source_NetworkAPKPI__hwApEthportDownRate",
            a::KilobitsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkAPKPI__hwApEthportDownRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        a::rate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_uplink_rx_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_uplink_rx_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_uplink_rx_rate_min"}
        ]
    )
    source_hwApEthportDownRate: a::KilobitsPerSecond,
    @m::column("hwAPUpPortPER")
    @g::field_view(
        g::dimension_group(
            "source_NetworkAPKPI__hwAPUpPortPER",
            p::Percent.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkAPKPI__hwAPUpPortPER",
        True,
        g::numeric_filters
    )
    @samples::field(
        p::Percent_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_uplink_packet_error_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_uplink_packet_error_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_uplink_packet_error_rate_min"}
        ]
    )
    @presentation::field_unit("%", "ratio", 0.01)
    source_hwAPUpPortPER: p::Percent,
    @m::column("hwCurrAssStationCountEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkAPKPI__hwCurrAssStationCountEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkAPKPI__hwCurrAssStationCountEffcnt",
        True,
        g::numeric_filters
    )
    source_hwCurrAssStationCountEffcnt: a::EffectiveCount,
    @m::column("hwApEthportUpRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkAPKPI__hwApEthportUpRateEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkAPKPI__hwApEthportUpRateEffcnt",
        True,
        g::numeric_filters
    )
    source_hwApEthportUpRateEffcnt: a::EffectiveCount,
    @m::column("hwApEthportDownRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkAPKPI__hwApEthportDownRateEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkAPKPI__hwApEthportDownRateEffcnt",
        True,
        g::numeric_filters
    )
    source_hwApEthportDownRateEffcnt: a::EffectiveCount,
    @m::column("hwAPUpPortPEREffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkAPKPI__hwAPUpPortPEREffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkAPKPI__hwAPUpPortPEREffcnt",
        True,
        g::numeric_filters
    )
    source_hwAPUpPortPEREffcnt: a::EffectiveCount,
};

pub use self::{NetworkAPKPI};
