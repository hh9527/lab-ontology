# 语义成员完整列出；内部结构和内置类型不列为 World 成员。
use crate::typed_relations as original;
use ontology::world as world;

def model_world: world::World = world::define(
    "typed-relation-v1",
    original::datasets,
    original::declarations,
    original::alternatives,
    [original::connected, original::upstream],
    original::profile
);
pub use self::{model_world};
