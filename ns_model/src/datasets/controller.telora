use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::enterprise_controller_2_kpi;
@domain::subject("Controller", "id")
@domain::dataset("controller", "SYS_Controller", ["id"])
@domain::relations(relations)
pub type Controller = struct {
    @g::field_view(g::dimension_group("controller/id", ids::ControllerById.type, True, [g::Filter::Eq]), "co_id", True, [g::Filter::Eq])
    @domain::count("co_count")
    id: ids::ControllerById,
    @g::field_view(g::dimension_group("controller/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "co_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("controller/obj_sys_id", domain::Reference(ids::EnterpriseController2KpiByObjSysId).type, True, [g::Filter::Eq]), "co_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::EnterpriseController2KpiByObjSysId)),
    @m::column("parentType")
    @g::field_view(g::dimension_group("controller/parent_type", String.type, True, [g::Filter::Eq]), "co_parent_type", True, [g::Filter::Eq])
    parent_type: Option(String),
    @m::column("oriResId")
    @g::field_view(g::dimension_group("controller/ori_res_id", String.type, True, [g::Filter::Eq]), "co_ori_res_id", True, [g::Filter::Eq])
    ori_res_id: Option(String),
    @m::column("bomId")
    @g::field_view(g::dimension_group("controller/bom_id", String.type, True, [g::Filter::Eq]), "co_bom_id", True, [g::Filter::Eq])
    bom_id: Option(String),
    @m::column("barCode")
    @g::field_view(g::dimension_group("controller/bar_code", String.type, True, [g::Filter::Eq]), "co_bar_code", True, [g::Filter::Eq])
    bar_code: Option(String),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("controller/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "co_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("memorySize")
    @g::field_view(g::dimension_group("controller/memory_size", String.type, True, [g::Filter::Eq]), "co_memory_size", True, [g::Filter::Eq])
    memory_size: Option(String),
    @m::column("softVer")
    @g::field_view(g::dimension_group("controller/soft_ver", String.type, True, [g::Filter::Eq]), "co_soft_ver", True, [g::Filter::Eq])
    soft_ver: Option(String),
    @g::field_view(g::dimension_group("controller/location", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "co_location", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    location: Option(String),
    @m::column("controllerId")
    @g::field_view(g::dimension_group("controller/controller_id", String.type, True, [g::Filter::Eq]), "co_controller_id", True, [g::Filter::Eq])
    controller_id: Option(String),
    @m::column("healthStatus")
    @g::field_view(g::dimension_group("controller/health_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "co_health_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::CoHealthStatus.type, "co_health_status", [v::member(domains::CoHealthStatus::Unknown, ["0"]), v::member(domains::CoHealthStatus::Normal, ["1"]), v::member(domains::CoHealthStatus::Faulty, ["2"]), v::member(domains::CoHealthStatus::Inconsistent, ["9"])])
    health_status: Option(String),
    @m::column("runningStatus")
    @g::field_view(g::dimension_group("controller/running_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "co_running_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::CoRunningStatus.type, "co_running_status", [v::member(domains::CoRunningStatus::Unknown, ["0"]), v::member(domains::CoRunningStatus::Online, ["1","27"]), v::member(domains::CoRunningStatus::Running, ["2"]), v::member(domains::CoRunningStatus::Offline, ["28"])])
    running_status: Option(String),
    @g::field_view(g::dimension_group("controller/role/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "co_role_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::CoRole.type, "co_role", [v::member(domains::CoRole::RegularMember, ["0"]), v::member(domains::CoRole::ClusterMaster, ["1"]), v::member(domains::CoRole::ClusterStandby, ["2"])])
    role: Option(String),
};

pub def relations: Array(r::Relation) = [
    r::relation("ec2__co_rev", domain::endpoint(Controller.type, "obj_sys_id"), domain::endpoint(enterprise_controller_2_kpi::EnterpriseController2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
