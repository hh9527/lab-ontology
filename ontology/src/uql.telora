# UQL renderer: shared QueryAst vocabulary, ANSI queries and spec-listed functions.
# Ported from Semora 0ca8adf; see ontology/docs/UQL.md for execution assumptions.
use std::array as array;
use std::string as string;
use crate::query as qb;

# The render context carries the immutable builder bindings plus the
# occurrence-order expansion that becomes the positional bindings array: every
# rendered `?` appends its handle's value, so the array length always equals
# the `?` count, repeated references repeat their value, and handles that
# never appear in the SQL never enter the array.
type RenderCtx = struct {
    builder_bindings: Array(qb::Val),
    occurrences: Array(qb::Val),
    reserved_aliases: Array(String),
    next_alias: Int,
};

type Emitted = struct { sql: String, ctx: RenderCtx };

def context: Fn(Array(String), Array(qb::Val)) -> RenderCtx = fn(reserved, bindings) {
    {builder_bindings: bindings, occurrences: [], reserved_aliases: reserved, next_alias: 0}
};

pub def internal_alias: Fn(RenderCtx) -> (String, RenderCtx) = fn(ctx) {
    let candidate = `__q_\{ctx.next_alias}`;
    let next: RenderCtx = {...ctx, next_alias: ctx.next_alias + 1};
    if array::any(
        ctx.reserved_aliases,
        fn(name) {
            name == candidate
        }
    ) {
        internal_alias(next)
    } else {
        (candidate, {...next, reserved_aliases: array::push(next.reserved_aliases, candidate)})
    }
};

# UQL temporal functions carry no timezone argument; executors interpret them
# as UTC. The bucket matrix: DateTimeUtc keeps the datetime logical type
# (`time_floor` for hours, `CAST(date_trunc … AS TIMESTAMP)` for day/month),
# Date uses date_trunc's DATE result directly, and EpochMillis buckets sit
# inside the calendar-range guard CASE. The epoch form restates the value
# inside the guard and the offset arithmetic; every restatement renders its
# own positional `?` so the occurrence expansion stays exact.
def utc_bucket_sql: Fn(qb::UtcBucketSpec, qb::Expr, RenderCtx) -> Emitted = fn(spec, value, ctx) {
    match spec.encoding {
        qb::UtcBucketEncoding::DateTimeUtc => do {
            let rendered = emit_expr(value, ctx);
            let sql = match spec.unit {
                qb::UtcBucketUnit::Year => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Quarter => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Week => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Hour => `time_floor(CAST(\{rendered.sql} AS TIMESTAMP), 'PT1H')`,
                qb::UtcBucketUnit::Day => `CAST(date_trunc('day', CAST(\{rendered.sql} AS TIMESTAMP)) AS TIMESTAMP)`,
                qb::UtcBucketUnit::Month => `CAST(date_trunc('month', CAST(\{rendered.sql} AS TIMESTAMP)) AS TIMESTAMP)`,
            };
            {sql, ctx: rendered.ctx}
        },
        qb::UtcBucketEncoding::Date => do {
            let rendered = emit_expr(value, ctx);
            let sql = match spec.unit {
                qb::UtcBucketUnit::Year => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Quarter => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Week => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Hour => fail!("UQL date buckets support day and month units only", spec),
                qb::UtcBucketUnit::Day => `date_trunc('day', CAST(\{rendered.sql} AS TIMESTAMP))`,
                qb::UtcBucketUnit::Month => `date_trunc('month', CAST(\{rendered.sql} AS TIMESTAMP))`,
            };
            {sql, ctx: rendered.ctx}
        },
        qb::UtcBucketEncoding::EpochMillis => do {
            let lower = emit_expr(value, ctx);
            let upper = emit_expr(value, lower.ctx);
            let offset = emit_expr(value, upper.ctx);
            let inner = emit_expr(value, offset.ctx);
            let bucket = match spec.unit {
                qb::UtcBucketUnit::Year => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Quarter => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Week => fail!("UQL buckets support hour, day and month units only", spec),
                qb::UtcBucketUnit::Hour =>
                    `CAST((\{offset.sql} - mod(mod(\{inner.sql}, 3600000) + 3600000, 3600000)) AS BIGINT)`,
                qb::UtcBucketUnit::Day =>
                    `CAST((\{offset.sql} - mod(mod(\{inner.sql}, 86400000) + 86400000, 86400000)) AS BIGINT)`,
                qb::UtcBucketUnit::Month => do {
                    # Whole-day timestampadd plus a month-truncated timestampdiff keeps
                    # 32-bit INT counts and fractional months out of the arithmetic; the
                    # epoch anchor is the typed literal and the truncation result is CAST
                    # back to TIMESTAMP before the difference is taken.
                    let origin = "TIMESTAMP '1970-01-01 00:00:00'";
                    let days = `CAST((\{offset.sql} - mod(mod(\{inner.sql}, 86400000) + 86400000, 86400000)) / 86400000 AS INTEGER)`;
                    `CAST(timestampdiff('SECOND', \{origin}, CAST(date_trunc('month', timestampadd('DAY', \{days}, \{origin})) AS TIMESTAMP)) AS BIGINT) * 1000`
                },
            };
            {sql: `CASE WHEN \{lower.sql} >= -62135596800000 AND \{upper.sql} < 253402300800000 THEN \{bucket} ELSE NULL END`,
                ctx: inner.ctx}
        },
    }
};

# timestamp_format format strings carry no T/Z literals, so the shifted
# timestamp is restated twice and the date/time halves are joined by concat;
# concat propagates NULL from any argument, keeping NULL timestamps NULL.
# Text order inside one timestampadd is days-then-timestamp, so the arguments
# render in that order and every restatement renders its own positional `?`.
def utc_days_ago_sql: Fn(Array(qb::Expr), RenderCtx) -> Emitted = fn(args, ctx) {
    let days_first = emit_expr(args[1], ctx);
    let time_first = emit_expr(args[0], days_first.ctx);
    let days_second = emit_expr(args[1], time_first.ctx);
    let time_second = emit_expr(args[0], days_second.ctx);
    let first = `timestampadd('DAY', (0 - CAST(\{days_first.sql} AS INTEGER)), CAST(\{time_first.sql} AS TIMESTAMP))`;
    let second = `timestampadd('DAY', (0 - CAST(\{days_second.sql} AS INTEGER)), CAST(\{time_second.sql} AS TIMESTAMP))`;
    {sql: `concat(timestamp_format(\{first}, '%Y-%m-%d'), 'T', timestamp_format(\{second}, '%H:%i:%s'), 'Z')`,
        ctx: time_second.ctx}
};

# OQ-5: the engine's lower() folds A-Z only, matching the AST contract.

# The AST ordering contract (ascending puts NULL first, descending last) is
# expressed with the engine's native NULLS FIRST/LAST spelling.
def ordered_sql: Fn(String, qb::Ordering) -> String = fn(value, direction) {
    match direction {
        qb::Ordering::Asc => `\{value} ASC NULLS FIRST`,
        qb::Ordering::Desc => `\{value} DESC NULLS LAST`,
    }
};

def scalar_sql: Fn(qb::ScalarFunction, Array(String)) -> String = fn(function, parts) {
    match function {
        qb::ScalarFunction::Substr => `substr(\{string::join(parts, ", ")})`,
        qb::ScalarFunction::Instr => `instr(\{parts[0]}, \{parts[1]})`,
        qb::ScalarFunction::BinaryText => fail!("UQL spec does not define binary text collation"),
        qb::ScalarFunction::RegexMatch => `(regexp_count(\{parts[0]}, \{parts[1]}) > 0)`,
        qb::ScalarFunction::If => `CASE WHEN \{parts[0]} THEN \{parts[1]} ELSE \{parts[2]} END`,
        qb::ScalarFunction::Add => `(\{parts[0]} + \{parts[1]})`,
        qb::ScalarFunction::Sub => `(\{parts[0]} - \{parts[1]})`,
        qb::ScalarFunction::Div => `(\{parts[0]} / \{parts[1]})`,
        # OQ-5: the engine's lower() folds A-Z only, matching the AST contract.
        qb::ScalarFunction::Lower => `lower(\{parts[0]})`,
        qb::ScalarFunction::Length => `char_length(\{parts[0]})`,
        # Both temporal functions restate subexpressions, so they render through
        # the occurrence-aware emitters in emit_expr, never through this
        # string-combining path.
        qb::ScalarFunction::UtcDaysAgo => fail!("UtcDaysAgo requires occurrence-order rendering"),
        qb::ScalarFunction::UtcTimeBucket(_) => fail!("UtcTimeBucket requires occurrence-order rendering"),
        qb::ScalarFunction::ZonedTimeBucket(_) => fail!("UQL does not define region timezone buckets"),
        qb::ScalarFunction::EpochMillisToUtc => fail!("UQL does not define epoch millis to timestamp conversion"),
        qb::ScalarFunction::Eq => `\{parts[0]} = \{parts[1]}`,
        qb::ScalarFunction::Ne => `\{parts[0]} <> \{parts[1]}`,
        qb::ScalarFunction::Lt => `\{parts[0]} < \{parts[1]}`,
        qb::ScalarFunction::Le => `\{parts[0]} <= \{parts[1]}`,
        qb::ScalarFunction::Gt => `\{parts[0]} > \{parts[1]}`,
        qb::ScalarFunction::Ge => `\{parts[0]} >= \{parts[1]}`,
        qb::ScalarFunction::And => `(\{parts[0]} AND \{parts[1]})`,
        qb::ScalarFunction::Or => `(\{parts[0]} OR \{parts[1]})`,
        qb::ScalarFunction::Not => `NOT (\{parts[0]})`,
        qb::ScalarFunction::IsNotNull => `\{parts[0]} IS NOT NULL`,
    }
};

type Arguments = struct {
    sql: Array(String),
    ctx: RenderCtx
};

# The build context owns placeholder assignment; rendering only resolves
# handles, emitting a bare `?` and appending the handle's value to the
# occurrence expansion.
pub def emit_expr: Fn(qb::Expr, RenderCtx) -> Emitted = fn(expr, ctx) {
    match expr {
        qb::Expr::Parameter(_) => fail!(
            "symbolic query parameters require binding before this dialect"
        ),
        qb::Expr::Column(ref) => if qb::is_sql_identifier(ref.source) && qb::is_sql_identifier(
            ref.column
        ) {
            {sql: `\`\{ref.source}\`.\`\{ref.column}\``, ctx}
        } else {
            fail!("invalid UQL column identifier", ref)
        },
        qb::Expr::AllocatedBind(binding) => if binding.index > 0 && binding.index <= array::length(
            ctx.builder_bindings
        ) {
            {
                sql: "?",
                ctx: {...ctx, occurrences: array::push(ctx.occurrences, ctx.builder_bindings[binding.index - 1])}
            }
        } else {
            fail!("binding handle is not registered in builder context", binding)
        },
        qb::Expr::Scalar(call) => match call.function {
            qb::ScalarFunction::UtcDaysAgo => utc_days_ago_sql(call.args, ctx),
            qb::ScalarFunction::UtcTimeBucket(spec) => utc_bucket_sql(spec, call.args[0], ctx),
            _ => do {
                let initial: Arguments = {sql: [], ctx};
                let args = array::fold(
                    call.args,
                    initial,
                    fn(state, arg) {
                        let rendered = emit_expr(arg, state.ctx);
                        {sql: array::push(state.sql, rendered.sql), ctx: rendered.ctx}
                    }
                );
                {sql: scalar_sql(call.function, args.sql), ctx: args.ctx}
            },
        },
    }
};

pub def render_expr_with_context: Fn(qb::Expr, qb::BuildCtx) -> qb::Query = fn(expr, builder) {
    let emitted = emit_expr(expr, context([], builder.bindings));
    {sql: emitted.sql, bindings: emitted.ctx.occurrences}
};

def quoted: Fn(String) -> String = fn(identifier) {
    if qb::is_sql_identifier(identifier) {
        `\`\{identifier}\``
    } else {
        fail!("invalid UQL identifier", identifier)
    }
};

def render_exprs: Fn(Array(qb::Expr), RenderCtx) -> Emitted = fn(exprs, ctx) {
    let initial: Arguments = {sql: [], ctx};
    let parts = array::fold(
        exprs,
        initial,
        fn(state, expr) {
            let value = emit_expr(expr, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        }
    );
    {sql: string::join(parts.sql, ", "), ctx: parts.ctx}
};

def render_source: Fn(qb::Source, RenderCtx) -> Emitted = fn(source, ctx) {
    let table = quoted(source.table);
    let alias = quoted(source.alias);
    match source.scope {
        None => {sql: `\{table} AS \{alias}`, ctx},
        Some(expr) => {
            let predicate = emit_expr(expr, ctx);
            {
                sql: `(SELECT * FROM \{table} AS \{alias} WHERE \{predicate.sql}) AS \{alias}`,
                ctx: predicate.ctx
            }
        },
    }
};

def render_branch: Fn(qb::UnionBranch, RenderCtx) -> Emitted = fn(branch, ctx) {
    let initial: Arguments = {sql: [], ctx};
    let items = array::fold(
        branch.outputs,
        initial,
        fn(state, item) {
            let value = emit_expr(item.expr, state.ctx);
            {sql: array::push(state.sql, `\{value.sql} AS \{quoted(item.name)}`), ctx: value.ctx}
        }
    );
    let source = render_source(branch.source, items.ctx);
    let filtered: Emitted = match branch.filter {
        Some(expr) => {
            let value = emit_expr(expr, source.ctx);
            {sql: ` WHERE \{value.sql}`, ctx: value.ctx}
        },
        None => {sql: "", ctx: source.ctx},
    };
    {
        sql: `SELECT \{string::join(items.sql, ", ")} FROM \{source.sql}\{filtered.sql}`,
        ctx: filtered.ctx
    }
};

def render_from: Fn(qb::Plan, RenderCtx) -> Emitted = fn(plan, ctx) {
    match plan.derived {
        None => render_source(plan.sources[0], ctx),
        Some(derived) => {
            let initial: Arguments = {sql: [], ctx};
            let branches = array::fold(
                derived.branches,
                initial,
                fn(state, branch) {
                    let value = render_branch(branch, state.ctx);
                    {sql: array::push(state.sql, value.sql), ctx: value.ctx}
                }
            );
            {
                sql: `(\{string::join(branches.sql, " UNION ALL ")}) AS \{quoted(derived.alias)}`,
                ctx: branches.ctx
            }
        },
    }
};

def column_sql: Fn(qb::ColumnRef) -> String = fn(ref) {
    `\{quoted(ref.source)}.\{quoted(ref.column)}`
};

def render_on: Fn(qb::JoinCondition, RenderCtx) -> Emitted = fn(condition, ctx) {
    match condition {
        qb::JoinCondition::Eq(eq) => {sql: `\{column_sql(eq.left)} = \{column_sql(eq.right)}`, ctx},
        qb::JoinCondition::Predicate(expr) => emit_expr(expr, ctx),
        qb::JoinCondition::Exists(ex) => render_exists(ex, ctx),
        qb::JoinCondition::And(items) => {
            let initial: Arguments = {sql: [], ctx};
            let parts = array::fold(
                items,
                initial,
                fn(state, item) {
                    let value = render_on(item, state.ctx);
                    {sql: array::push(state.sql, value.sql), ctx: value.ctx}
                }
            );
            {sql: `(\{string::join(parts.sql, " AND ")})`, ctx: parts.ctx}
        },
        qb::JoinCondition::Or(items) => {
            let initial: Arguments = {sql: [], ctx};
            let parts = array::fold(
                items,
                initial,
                fn(state, item) {
                    let value = render_on(item, state.ctx);
                    {sql: array::push(state.sql, value.sql), ctx: value.ctx}
                }
            );
            {sql: `(\{string::join(parts.sql, " OR ")})`, ctx: parts.ctx}
        },
    }
};

def render_join: Fn(qb::Join, RenderCtx) -> Emitted = fn(join, ctx) {
    let source = render_source(join.source, ctx);
    let on = render_on(join.condition, source.ctx);
    let kind = match join.kind {
        qb::JoinKind::Inner => "INNER JOIN",
        qb::JoinKind::Left => "LEFT JOIN",
    };
    {sql: `\{kind} \{source.sql} ON \{on.sql}`, ctx: on.ctx}
};

def aggregate: Fn(qb::AggregateCall, RenderCtx) -> Emitted = fn(call, ctx) {
    if call.function == qb::AggregateFunction::Latest {
        let arg = emit_expr(call.arg, ctx);
        let time = match call.latest {
            Some(order) => order.time,
            None => fail!("Latest ordering is required")
        };
        {
            sql: `max(CASE WHEN \{quoted(time.source)}.\`__latest_row\` = 1 AND \{quoted(time.source)}.\{quoted(time.column)} IS NOT NULL THEN \{arg.sql} END)`,
            ctx: arg.ctx
        }
    } else {
        # The spec has no aggregate-level FILTER clause; the local predicate folds
        # into a CASE without ELSE, and the closed aggregate set ignores its NULLs,
        # which is exactly the FILTER semantics. The CASE text places the
        # predicate before the aggregate argument, so the predicate renders first
        # and every positional `?` is pushed in text order.
        let distinct = if call.distinct {
            "DISTINCT "
        } else {
            ""
        };
        let filtered: Emitted = match call.filter {
            Some(expr) => {
                let value = emit_expr(expr, ctx);
                let arg = emit_expr(call.arg, value.ctx);
                {sql: `CASE WHEN \{value.sql} THEN \{arg.sql} ELSE NULL END`, ctx: arg.ctx}
            },
            None => emit_expr(call.arg, ctx),
        };
        {sql: `\{qb::aggregate_name(call.function)}(\{distinct}\{filtered.sql})`, ctx: filtered.ctx}
    }
};

def measure: Fn(qb::Plan, String, RenderCtx) -> Emitted = fn(plan, name, ctx) {
    let found = qb::computed_operand(plan, name);
    match found {
        Some(qb::SelectItem::Aggregate(call)) => aggregate(call, ctx),
        Some(qb::SelectItem::Computed(ca)) => {
            let left = measure(plan, ca.left, ctx);
            let right = measure(plan, ca.right, left.ctx);
            let op = match ca.op {
                qb::ComputedOp::Add => "+",
                qb::ComputedOp::Sub => "-"
            };
            {sql: `(\{left.sql} \{op} \{right.sql})`, ctx: right.ctx}
        },
        _ => fail!("UQL measure references an undeclared aggregate", name),
    }
};

def select_item: Fn(qb::SelectItem, qb::Plan, RenderCtx) -> Emitted = fn(item, plan, ctx) {
    match item {
        qb::SelectItem::Expr(expr) => emit_expr(expr, ctx),
        qb::SelectItem::NamedExpr(named) => {
            let value = emit_expr(named.expr, ctx);
            {sql: `\{value.sql} AS \{quoted(named.alias)}`, ctx: value.ctx}
        },
        qb::SelectItem::Aggregate(call) => {
            let value = aggregate(call, ctx);
            {sql: `\{value.sql} AS \{quoted(call.alias)}`, ctx: value.ctx}
        },
        qb::SelectItem::Computed(ca) => {
            let value = measure(plan, ca.alias, ctx);
            {sql: `\{value.sql} AS \{quoted(ca.alias)}`, ctx: value.ctx}
        },
    }
};

def order_key: Fn(qb::OrderKey, qb::Plan, RenderCtx) -> Emitted = fn(key, plan, ctx) {
    match key {
        qb::OrderKey::Expr(expr) => emit_expr(expr, ctx),
        qb::OrderKey::AggregateRef(ref) => measure(plan, ref.alias, ctx),
        qb::OrderKey::Aggregate(call) => aggregate(call, ctx),
    }
};

def order_item: Fn(qb::OrderBy, qb::Plan, RenderCtx) -> Emitted = fn(item, plan, ctx) {
    let key = order_key(item.key, plan, ctx);
    {sql: ordered_sql(key.sql, item.direction), ctx: key.ctx}
};

def having_item: Fn(qb::Having, qb::Plan, RenderCtx) -> Emitted = fn(item, plan, ctx) {
    let value = match item.measure {
        qb::HavingMeasure::Ref(ref) => measure(plan, ref.alias, ctx),
        qb::HavingMeasure::Call(call) => aggregate(call, ctx),
    };
    let op = match item.op {
        qb::HavingOp::Eq => "=",
        qb::HavingOp::Ne => "<>",
        qb::HavingOp::Lt => "<",
        qb::HavingOp::Le => "<=",
        qb::HavingOp::Gt => ">",
        qb::HavingOp::Ge => ">=",
    };
    let threshold = emit_expr(item.threshold, value.ctx);
    {sql: `\{value.sql} \{op} \{threshold.sql}`, ctx: threshold.ctx}
};

def pair_sql: Fn(qb::ColumnEq) -> String = fn(pair) {
    `\{column_sql(pair.left)} = \{column_sql(pair.right)}`
};

def correlations: Fn(qb::Exists) -> String = fn(ex) {
    match ex.alternatives {
        Some(branches) => {
            let sql = array::map(
                branches,
                fn(branch) {
                    `(\{string::join(array::map(branch, pair_sql), " AND ")})`
                }
            );
            `(\{string::join(sql, " OR ")})`
        },
        None => string::join(array::map(ex.pairs, pair_sql), " AND "),
    }
};

def exists_having: Fn(qb::Having, RenderCtx) -> Emitted = fn(item, ctx) {
    match item.measure {
        qb::HavingMeasure::Call(call) => {
            let value = aggregate(call, ctx);
            let op = match item.op {
                qb::HavingOp::Eq => "=",
                qb::HavingOp::Ne => "<>",
                qb::HavingOp::Lt => "<",
                qb::HavingOp::Le => "<=",
                qb::HavingOp::Gt => ">",
                qb::HavingOp::Ge => ">=",
            };
            let threshold = emit_expr(item.threshold, value.ctx);
            {sql: `\{value.sql} \{op} \{threshold.sql}`, ctx: threshold.ctx}
        },
        qb::HavingMeasure::Ref(_) => fail!("EXISTS HAVING requires a direct aggregate", item),
    }
};

def render_peer: Fn(qb::PeerCorr, RenderCtx) -> Emitted = fn(corr, ctx) {
    let origin = render_source(corr.origin, ctx);
    let peer = render_source(corr.peer, origin.ctx);
    let first = `(\{pair_sql(corr.branch_a.origin)} AND \{pair_sql(corr.branch_a.peer)})`;
    let second = `(\{pair_sql(corr.branch_b.origin)} AND \{pair_sql(corr.branch_b.peer)})`;
    let exchange = if corr.exchange {
        `(\{first} OR \{second})`
    } else {
        first
    };
    let distinct = if corr.distinct_keys {
        ` AND \{column_sql(corr.branch_a.origin.right)} <> \{column_sql(corr.branch_a.peer.right)}`
    } else {
        ""
    };
    let origin_filter: Emitted = match corr.origin_filter {
        Some(expr) => emit_expr(expr, peer.ctx),
        None => {sql: "", ctx: peer.ctx},
    };
    let peer_filter: Emitted = match corr.peer_filter {
        Some(expr) => emit_expr(expr, origin_filter.ctx),
        None => {sql: "", ctx: origin_filter.ctx},
    };
    let origin_sql = if corr.origin_filter != None {
        ` AND \{origin_filter.sql}`
    } else {
        ""
    };
    let peer_sql = if corr.peer_filter != None {
        ` AND \{peer_filter.sql}`
    } else {
        ""
    };
    {
        sql: `SELECT 1 FROM \{origin.sql}, \{peer.sql} WHERE \{exchange}\{distinct}\{origin_sql}\{peer_sql}`,
        ctx: peer_filter.ctx
    }
};

def render_link: Fn(qb::Exists, qb::ExistsLink, RenderCtx) -> Emitted = fn(ex, link, ctx) {
    let hop = render_source(ex.source, ctx);
    let next = render_source(link.source, hop.ctx);
    let tail: Emitted = match link.tail {
        Some(item) => {
            let source = render_source(item.source, next.ctx);
            {
                sql: ` INNER JOIN \{source.sql} ON \{string::join(array::map(item.pairs, pair_sql), " AND ")}`,
                ctx: source.ctx
            }
        },
        None => {sql: "", ctx: next.ctx},
    };
    let filtered: Emitted = match link.filter {
        Some(expr) => emit_expr(expr, tail.ctx),
        None => {sql: "", ctx: tail.ctx},
    };
    let on = match link.alternatives {
        Some(branches) => `(\{string::join(array::map(branches, fn(branch) {
            `(\{string::join(array::map(branch, pair_sql), " AND ")})`
        }), " OR ")})`,
        None => string::join(array::map(link.pairs, pair_sql), " AND "),
    };
    let where_filter = if link.filter != None {
        ` AND \{filtered.sql}`
    } else {
        ""
    };
    {
        sql: `SELECT 1 FROM \{hop.sql} INNER JOIN \{next.sql} ON \{on}\{tail.sql} WHERE \{correlations(ex)}\{where_filter}`,
        ctx: filtered.ctx
    }
};

def render_exists: Fn(qb::Exists, RenderCtx) -> Emitted = fn(ex, ctx) {
    let prefix = if ex.negated {
        "NOT EXISTS"
    } else {
        "EXISTS"
    };
    match ex.peer {
        Some(corr) => {
            let body = render_peer(corr, ctx);
            {sql: `\{prefix} (\{body.sql})`, ctx: body.ctx}
        },
        None => match ex.link {
            Some(link) => {
                let body = render_link(ex, link, ctx);
                {sql: `\{prefix} (\{body.sql})`, ctx: body.ctx}
            },
            None => {
                let source = render_source(ex.source, ctx);
                let initial_path: Arguments = {sql: [], ctx: source.ctx};
                let path = array::fold(
                    ex.path,
                    initial_path,
                    fn(state, join) {
                        let rendered = render_join(join, state.ctx);
                        {sql: array::push(state.sql, rendered.sql), ctx: rendered.ctx}
                    }
                );
                let path_sql = if array::length(ex.path) > 0 {
                    ` \{string::join(path.sql, " ")}`
                } else {
                    ""
                };
                let filter: Emitted = match ex.filter {
                    Some(expr) => emit_expr(expr, path.ctx),
                    None => {sql: "", ctx: path.ctx},
                };
                let grouping = render_exprs(ex.grouping, filter.ctx);
                let initial: Arguments = {sql: [], ctx: grouping.ctx};
                let having = array::fold(
                    ex.having,
                    initial,
                    fn(state, item) {
                        let value = exists_having(item, state.ctx);
                        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
                    }
                );
                let filter_sql = if ex.filter != None {
                    ` AND \{filter.sql}`
                } else {
                    ""
                };
                let group_sql = if array::length(ex.grouping) > 0 {
                    ` GROUP BY \{grouping.sql}`
                } else {
                    ""
                };
                let having_sql = if array::length(ex.having) > 0 {
                    ` HAVING \{string::join(having.sql, " AND ")}`
                } else {
                    ""
                };
                {
                    sql: `\{prefix} (SELECT 1 FROM \{source.sql}\{path_sql} WHERE \{correlations(ex)}\{filter_sql}\{group_sql}\{having_sql})`,
                    ctx: having.ctx
                }
            },
        },
    }
};

def comparison_op: Fn(qb::ScalarFunction) -> String = fn(op) {
    match op {
        qb::ScalarFunction::Eq => "=",
        qb::ScalarFunction::Ne => "<>",
        qb::ScalarFunction::Lt => "<",
        qb::ScalarFunction::Le => "<=",
        qb::ScalarFunction::Gt => ">",
        qb::ScalarFunction::Ge => ">=",
        _ => fail!("invalid scalar comparison operator", op),
    }
};

def render_scalar_comparison: Fn(qb::ScalarAggregateComparison, RenderCtx) -> Emitted = fn(cmp, ctx) {
    let sq = cmp.inner;
    let call: qb::AggregateCall = {
        function: sq.function,
        arg: sq.arg,
        distinct: sq.distinct,
        filter: sq.agg_filter,
        alias: "__scalar_value",
        latest: None,
    };
    let value = aggregate(call, ctx);
    let source = render_source(sq.source, value.ctx);
    let initial: Arguments = {sql: [], ctx: source.ctx};
    let joins = array::fold(
        sq.joins,
        initial,
        fn(state, join) {
            let emitted = render_join(join, state.ctx);
            {sql: array::push(state.sql, emitted.sql), ctx: emitted.ctx}
        }
    );
    let filtered: Emitted = match sq.filter {
        Some(expr) => emit_expr(expr, joins.ctx),
        None => {sql: "", ctx: joins.ctx},
    };
    let join_sql = if array::length(sq.joins) > 0 {
        ` \{string::join(joins.sql, " ")}`
    } else {
        ""
    };
    let filter_sql = if sq.filter != None {
        ` WHERE \{filtered.sql}`
    } else {
        ""
    };
    {
        sql: `\{column_sql(cmp.outer)} \{comparison_op(cmp.op)} (SELECT \{value.sql} FROM \{source.sql}\{join_sql}\{filter_sql})`,
        ctx: filtered.ctx
    }
};

# Direct grouped-key scalar subquery: rendering keeps key, source, joins,
# filter and ordering aligned with the SQL text occurrence order. The key is
# restated in both the SELECT list and GROUP BY; every restatement renders its
# own positional `?`, so a bind-bearing key expands once per occurrence.
def render_ranked_comparison: Fn(qb::RankedKeyComparison, RenderCtx) -> Emitted = fn(cmp, ctx) {
    let sq = cmp.inner;
    let key = render_exprs(sq.keys, ctx);
    let source = render_source(sq.source, key.ctx);
    let initial: Arguments = {sql: [], ctx: source.ctx};
    let joins = array::fold(
        sq.joins,
        initial,
        fn(state, join) {
            let emitted = render_join(join, state.ctx);
            {sql: array::push(state.sql, emitted.sql), ctx: emitted.ctx}
        }
    );
    let filtered: Emitted = match sq.filter {
        Some(expr) => emit_expr(expr, joins.ctx),
        None => {sql: "", ctx: joins.ctx},
    };
    let grouped = render_exprs(sq.keys, filtered.ctx);
    let ordering = aggregate(sq.order, grouped.ctx);
    let direction = ordered_sql(ordering.sql, sq.direction);
    let join_sql = if array::length(sq.joins) > 0 {
        ` \{string::join(joins.sql, " ")}`
    } else {
        ""
    };
    let filter_sql = if sq.filter != None {
        ` WHERE \{filtered.sql}`
    } else {
        ""
    };
    {
        sql: `\{column_sql(cmp.outer)} \{comparison_op(cmp.op)} (SELECT \{key.sql} FROM \{source.sql}\{join_sql}\{filter_sql} GROUP BY \{grouped.sql} ORDER BY \{direction} LIMIT 1)`,
        ctx: ordering.ctx
    }
};

def render_where: Fn(qb::Plan, RenderCtx) -> Emitted = fn(plan, ctx) {
    let filtered: Emitted = match plan.filter {
        Some(expr) => emit_expr(expr, ctx),
        None => {sql: "", ctx},
    };
    let initial: Arguments = {
        sql: if plan.filter != None {
            [filtered.sql]
        } else {
            []
        },
        ctx: filtered.ctx
    };
    let exists_terms = array::fold(
        plan.exists,
        initial,
        fn(state, ex) {
            let value = render_exists(ex, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        }
    );
    let scalar_terms = array::fold(
        plan.scalar_comparisons,
        exists_terms,
        fn(state, cmp) {
            let value = render_scalar_comparison(cmp, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        }
    );
    let terms = array::fold(
        plan.ranked_key_comparisons,
        scalar_terms,
        fn(state, cmp) {
            let value = render_ranked_comparison(cmp, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        }
    );
    let sql = if array::length(terms.sql) > 0 {
        ` WHERE \{string::join(terms.sql, " AND ")}`
    } else {
        ""
    };
    {sql, ctx: terms.ctx}
};

def plan_aliases: Fn(qb::Plan) -> Array(String) = fn(plan) {
    let derived_aliases = match plan.derived {
        Some(derived) => array::concat(
            [
                [derived.alias],
                array::map(
                    derived.branches,
                    fn(branch) {
                        branch.source.alias
                    }
                )
            ]
        ),
        None => [],
    };
    array::concat(
        [
            array::map(
                plan.sources,
                fn(source) {
                    source.alias
                }
            ),
            array::map(
                plan.joins,
                fn(join) {
                    join.source.alias
                }
            ),
            array::concat(
                array::map(
                    plan.projection,
                    fn(item) {
                        match item {
                            qb::SelectItem::Expr(_) => [],
                            qb::SelectItem::NamedExpr(named) => [named.alias],
                            qb::SelectItem::Aggregate(call) => [call.alias],
                            qb::SelectItem::Computed(ca) => [ca.alias],
                        }
                    }
                )
            ),
            array::map(
                plan.exists,
                fn(ex) {
                    ex.source.alias
                }
            ),
            array::concat(
                array::map(
                    plan.scalar_comparisons,
                    fn(cmp) {
                        array::concat(
                            [
                                [cmp.inner.source.alias],
                                array::map(
                                    cmp.inner.joins,
                                    fn(join) {
                                        join.source.alias
                                    }
                                )
                            ]
                        )
                    }
                )
            ),
            array::concat(
                array::map(
                    plan.ranked_key_comparisons,
                    fn(cmp) {
                        array::concat(
                            [
                                [cmp.inner.source.alias],
                                array::map(
                                    cmp.inner.joins,
                                    fn(join) {
                                        join.source.alias
                                    }
                                )
                            ]
                        )
                    }
                )
            ),
            array::concat(
                array::map(
                    plan.exists,
                    fn(ex) {
                        match ex.peer {
                            Some(corr) => [corr.peer.alias],
                            None => match ex.link {
                                Some(link) => match link.tail {
                                    Some(tail) => [link.source.alias, tail.source.alias],
                                    None => [link.source.alias],
                                },
                                None => array::map(
                                    ex.path,
                                    fn(join) {
                                        join.source.alias
                                    }
                                ),
                            },
                        }
                    }
                )
            ),
            derived_aliases,
        ]
    )
};

type PartitionItem = struct {
    sql: String,
    alias: String,
    ctx: RenderCtx
};
type ExprBinding = struct {
    expr: qb::Expr,
    alias: String
};
type PartitionItems = struct {
    sql: Array(String),
    aliases: Array(String),
    expressions: Array(ExprBinding),
    ctx: RenderCtx
};

def partition_item: Fn(qb::SelectItem, qb::Plan, RenderCtx) -> PartitionItem = fn(item, plan, ctx) {
    match item {
        qb::SelectItem::Expr(expr) => {
            let emitted = emit_expr(expr, ctx);
            let allocated = internal_alias(emitted.ctx);
            {
                sql: `\{emitted.sql} AS \{quoted(allocated.0)}`,
                alias: allocated.0,
                ctx: allocated.1
            }
        },
        qb::SelectItem::NamedExpr(named) => {
            let emitted = emit_expr(named.expr, ctx);
            {
                sql: `\{emitted.sql} AS \{quoted(named.alias)}`,
                alias: named.alias,
                ctx: emitted.ctx
            }
        },
        qb::SelectItem::Aggregate(call) => {
            let emitted = aggregate(call, ctx);
            {
                sql: `\{emitted.sql} AS \{quoted(call.alias)}`,
                alias: call.alias,
                ctx: emitted.ctx
            }
        },
        qb::SelectItem::Computed(ca) => {
            let emitted = measure(plan, ca.alias, ctx);
            {
                sql: `\{emitted.sql} AS \{quoted(ca.alias)}`,
                alias: ca.alias,
                ctx: emitted.ctx
            }
        },
    }
};

def find_expression: Fn(qb::Expr, Array(ExprBinding)) -> Option(ExprBinding) = fn(expr, expressions) {
    array::find(
        expressions,
        fn(item) {
            item.expr == expr
        }
    )
};

type PartitionKeys = struct {
    hidden: Array(String),
    outer: Array(String),
    expressions: Array(ExprBinding),
    ctx: RenderCtx
};

# Unprojected partition keys materialize as hidden `__q_pk_<i>` columns and
# unprojected partition ordering keys as `__q_ok_<j>`, so the outer ORDER BY
# stays deterministic (§7.6). Projected keys keep their projection alias.
def partition_key: Fn(qb::Expr, Int, PartitionKeys) -> PartitionKeys = fn(expr, index, state) {
    match find_expression(expr, state.expressions) {
        Some(found) => {
            hidden: state.hidden,
            outer: array::push(state.outer, found.alias),
            expressions: state.expressions,
            ctx: state.ctx
        },
        None => {
            let emitted = emit_expr(expr, state.ctx);
            {
                hidden: array::push(state.hidden, `\{emitted.sql} AS \`__q_pk_\{index}\``),
                outer: array::push(state.outer, `__q_pk_\{index}`),
                expressions: state.expressions,
                ctx: emitted.ctx
            }
        },
    }
};

def partition_order_key: Fn(qb::OrderBy, Int, PartitionKeys) -> PartitionKeys = fn(item, index, state) {
    match item.key {
        qb::OrderKey::Expr(expr) => match find_expression(expr, state.expressions) {
            Some(found) => {
                hidden: state.hidden,
                outer: array::push(state.outer, found.alias),
                expressions: state.expressions,
                ctx: state.ctx
            },
            None => {
                let emitted = emit_expr(expr, state.ctx);
                {
                    hidden: array::push(state.hidden, `\{emitted.sql} AS \`__q_ok_\{index}\``),
                    outer: array::push(state.outer, `__q_ok_\{index}`),
                    expressions: state.expressions,
                    ctx: emitted.ctx
                }
            },
        },
        qb::OrderKey::AggregateRef(ref) => {
            {
                hidden: state.hidden,
                outer: array::push(state.outer, ref.alias),
                expressions: state.expressions,
                ctx: state.ctx
            }
        },
        qb::OrderKey::Aggregate(_) => fail!(
            "partition ordering requires a projected aggregate",
            item
        ),
    }
};

# Partitioned Top-N (§7.6): the inner query numbers rows over the partition,
# the outer query keeps `__q_rn <= take` and orders deterministically by the
# hidden keys. Window PARTITION BY/ORDER BY and GROUP BY restate their
# expressions (never aliases), so every restatement binds its own positional
# `?` (§4.2).
def emit_partitioned: Fn(qb::Plan, qb::PartitionedTopN, RenderCtx) -> Emitted = fn(plan, pt, ctx) {
    let selected_initial: PartitionItems = {sql: [], aliases: [], expressions: [], ctx};
    let selected = array::fold(
        plan.projection,
        selected_initial,
        fn(state, item) {
            let emitted = partition_item(item, plan, state.ctx);
            let expressions = match item {
                qb::SelectItem::Expr(expr) => array::push(
                    state.expressions,
                    {expr, alias: emitted.alias}
                ),
                qb::SelectItem::NamedExpr(named) => array::push(
                    state.expressions,
                    {expr: named.expr, alias: emitted.alias}
                ),
                _ => state.expressions,
            };
            {
                sql: array::push(state.sql, emitted.sql),
                aliases: array::push(state.aliases, emitted.alias),
                expressions,
                ctx: emitted.ctx
            }
        }
    );
    let key_initial: PartitionKeys = {
        hidden: [],
        outer: [],
        expressions: selected.expressions,
        ctx: selected.ctx
    };
    let partition = array::fold(
        array::enumerate(pt.partition_by),
        key_initial,
        fn(state, pair) {
            partition_key(pair.1, pair.0, state)
        }
    );
    let order_initial: PartitionKeys = {
        hidden: [],
        outer: [],
        expressions: partition.expressions,
        ctx: partition.ctx
    };
    let ordered = array::fold(
        array::enumerate(pt.order_by),
        order_initial,
        fn(state, pair) {
            partition_order_key(pair.1, pair.0, state)
        }
    );
    let window_partition = render_exprs(pt.partition_by, ordered.ctx);
    let window_initial: Arguments = {sql: [], ctx: window_partition.ctx};
    let window_order = array::fold(
        pt.order_by,
        window_initial,
        fn(state, item) {
            let rendered = order_key(item.key, plan, state.ctx);
            {
                sql: array::push(state.sql, ordered_sql(rendered.sql, item.direction)),
                ctx: rendered.ctx
            }
        }
    );
    let source = render_from(plan, window_order.ctx);
    let join_initial: Arguments = {sql: [], ctx: source.ctx};
    let joins = array::fold(
        plan.joins,
        join_initial,
        fn(state, join) {
            let rendered = render_join(join, state.ctx);
            {sql: array::push(state.sql, rendered.sql), ctx: rendered.ctx}
        }
    );
    let where_clause = render_where(plan, joins.ctx);
    let grouping = render_exprs(plan.grouping, where_clause.ctx);
    let having_initial: Arguments = {sql: [], ctx: grouping.ctx};
    let having = array::fold(
        plan.having,
        having_initial,
        fn(state, item) {
            let rendered = having_item(item, plan, state.ctx);
            {sql: array::push(state.sql, rendered.sql), ctx: rendered.ctx}
        }
    );
    let take = emit_expr(pt.take, having.ctx);
    let hidden = array::concat([partition.hidden, ordered.hidden]);
    let row_number = `row_number() OVER (PARTITION BY \{window_partition.sql} ORDER BY \{string::join(window_order.sql, ", ")}) AS \`__q_rn\``;
    let inner_items = array::concat([selected.sql, hidden, [row_number]]);
    let join_sql = if array::length(plan.joins) > 0 {
        ` \{string::join(joins.sql, " ")}`
    } else {
        ""
    };
    let group_sql = if array::length(plan.grouping) > 0 {
        ` GROUP BY \{grouping.sql}`
    } else {
        ""
    };
    let having_sql = if array::length(plan.having) > 0 {
        ` HAVING \{string::join(having.sql, " AND ")}`
    } else {
        ""
    };
    let inner_sql = `SELECT \{string::join(inner_items, ", ")} FROM \{source.sql}\{join_sql}\{where_clause.sql}\{group_sql}\{having_sql}`;
    let outer_columns = array::map(
        selected.aliases,
        fn(name) {
            `\`__q_partitioned\`.\{quoted(name)}`
        }
    );
    let partition_order = array::map(
        partition.outer,
        fn(name) {
            ordered_sql(`\`__q_partitioned\`.\{quoted(name)}`, qb::Ordering::Asc)
        }
    );
    let ranked_order = array::map(
        array::enumerate(pt.order_by),
        fn(pair) {
            ordered_sql(`\`__q_partitioned\`.\{quoted(ordered.outer[pair.0])}`, pair.1.direction)
        }
    );
    let outer_order = string::join(array::concat([partition_order, ranked_order]), ", ");
    {
        sql: `SELECT \{string::join(outer_columns, ", ")} FROM (\{inner_sql}) AS \`__q_partitioned\` WHERE \`__q_partitioned\`.\`__q_rn\` <= \{take.sql} ORDER BY \{outer_order}`,
        ctx: take.ctx
    }
};

def emit_rows: Fn(qb::Plan, Bool, RenderCtx) -> Emitted = fn(raw, distinct, ctx) {
    emit_rows_from(raw, distinct, ctx, None, None)
};

# The optional selection take upgrades a bare OFFSET to the single-layer
# `LIMIT <take> OFFSET ?` shape: the delivered rows are an ordered prefix of
# the complete business query and the final LIMIT position stays a literal.
def emit_rows_from: Fn(qb::Plan, Bool, RenderCtx, Option(String), Option(Int)) -> Emitted = fn(
    raw,
    distinct,
    ctx,
    override,
    selection_take
) {
    let plan = if distinct {
        qb::validate_distinct_plan(raw)
    } else {
        qb::validate_structure(raw)
    };
    if override == None && array::length(qb::latest_calls(plan)) > 0 {
        let stage = qb::latest_stage(plan);
        let input = emit_rows(stage.input, False, ctx);
        let partition = if array::length(stage.partition) == 0 {
            ""
        } else {
            `PARTITION BY \{string::join(array::map(stage.partition, quoted), ", ")} `
        };
        let orders = array::map(
            array::enumerate(stage.order),
            fn(pair) {
                ordered_sql(
                    quoted(pair.1),
                    if pair.0 == 0 {
                        qb::Ordering::Desc
                    } else {
                        qb::Ordering::Asc
                    }
                )
            }
        );
        let source = `(SELECT \`__latest_input\`.*, row_number() OVER (\{partition}ORDER BY \{string::join(orders, ", ")}) AS \`__latest_row\` FROM (\{input.sql}) AS \`__latest_input\`) AS \`__latest_stage\``;
        emit_rows_from(stage.output, distinct, input.ctx, Some(source), selection_take)
    } else {
        match plan.partition {
            Some(pt) => emit_partitioned(plan, pt, ctx),
            None => {
                let select_initial: Arguments = {sql: [], ctx};
                let selected = array::fold(
                    plan.projection,
                    select_initial,
                    fn(state, item) {
                        let value = select_item(item, plan, state.ctx);
                        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
                    }
                );
                let source = match override {
                    Some(sql) => {sql, ctx: selected.ctx}.ty!(Emitted),
                    None => render_from(plan, selected.ctx)
                };
                let join_initial: Arguments = {sql: [], ctx: source.ctx};
                let joins = array::fold(
                    plan.joins,
                    join_initial,
                    fn(state, join) {
                        let value = render_join(join, state.ctx);
                        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
                    }
                );
                let where_clause = render_where(plan, joins.ctx);
                let grouping = render_exprs(plan.grouping, where_clause.ctx);
                let having_initial: Arguments = {sql: [], ctx: grouping.ctx};
                let having = array::fold(
                    plan.having,
                    having_initial,
                    fn(state, item) {
                        let value = having_item(item, plan, state.ctx);
                        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
                    }
                );
                let ordering_initial: Arguments = {sql: [], ctx: having.ctx};
                let ordering = array::fold(
                    plan.ordering,
                    ordering_initial,
                    fn(state, item) {
                        let value = order_item(item, plan, state.ctx);
                        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
                    }
                );
                let prefix = if distinct {
                    "SELECT DISTINCT"
                } else {
                    "SELECT"
                };
                let join_sql = if array::length(plan.joins) > 0 {
                    ` \{string::join(joins.sql, " ")}`
                } else {
                    ""
                };
                let where_sql = where_clause.sql;
                let group_sql = if array::length(plan.grouping) > 0 {
                    ` GROUP BY \{grouping.sql}`
                } else {
                    ""
                };
                let having_sql = if array::length(plan.having) > 0 {
                    ` HAVING \{string::join(having.sql, " AND ")}`
                } else {
                    ""
                };
                let order_sql = if array::length(plan.ordering) > 0 {
                    ` ORDER BY \{string::join(ordering.sql, ", ")}`
                } else {
                    ""
                };
                let body = `\{prefix} \{string::join(selected.sql, ", ")} FROM \{source.sql}\{join_sql}\{where_sql}\{group_sql}\{having_sql}\{order_sql}`;
                # A bare OFFSET is not a spec-listed form: it is fail-closed
                # unless the selection take supplies the single-layer
                # `LIMIT <take> OFFSET ?` shape.
                match (plan.limit, plan.offset) {
                    (None, None) => {sql: body, ctx: ordering.ctx},
                    (Some(local), None) => {
                        let limited = emit_expr(local, ordering.ctx);
                        {sql: `\{body} LIMIT \{limited.sql}`, ctx: limited.ctx}
                    },
                    (Some(local), Some(shift)) => {
                        let limited = emit_expr(local, ordering.ctx);
                        let skipped = emit_expr(shift, limited.ctx);
                        {
                            sql: `\{body} LIMIT \{limited.sql} OFFSET \{skipped.sql}`,
                            ctx: skipped.ctx
                        }
                    },
                    (None, Some(shift)) => match selection_take {
                        None => fail!(
                            "UQL OFFSET requires a LIMIT or a final output cap",
                            plan
                        ),
                        Some(value) => {
                            let skipped = emit_expr(shift, ordering.ctx);
                            {
                                sql: `\{body} LIMIT \{value} OFFSET \{skipped.sql}`,
                                ctx: skipped.ctx
                            }
                        },
                    },
                }
            },
        }
    }
};

def emit_set: Fn(qb::SetPlan, RenderCtx) -> Emitted = fn(set, ctx) {
    let operands = qb::validate_set_operands(set.kind, set.operands);
    let rendered = array::fold(
        operands,
        ([], ctx),
        fn(state, plan) {
            let part = emit_rows(plan, False, state.1);
            (array::push(state.0, part.sql), part.ctx)
        }
    );
    let op = qb::set_op_sql(set.kind);
    {sql: string::join(rendered.0, ` \{op} `), ctx: rendered.1}
};

def count_over: Fn(Emitted) -> Emitted = fn(inner) {
    {sql: `SELECT count(1) FROM (\{inner.sql}) AS \`__q_count\``, ctx: inner.ctx}
};

# Aligned pair queries: `__q_left`/`__q_right` are the fixed semantic
# aliases, identity keys align through the spec's NULL-safe `<=>`, and the
# ranked shape appends `comparison_value` as the first ordering key.
def emit_joined_groups: Fn(qb::JoinedGroups, Bool, RenderCtx) -> Emitted = fn(joined, count, ctx) {
    let left = emit_rows(joined.left, False, ctx);
    let right = emit_rows(joined.right, False, left.ctx);
    let outputs = array::map(
        joined.outputs,
        fn(item) {
            let alias = match item.side {
                qb::PairSide::Left => "__q_left",
                qb::PairSide::Right => "__q_right"
            };
            `\{quoted(alias)}.\{quoted(item.column)} AS \{quoted(item.alias)}`
        }
    );
    let keys = array::map(
        joined.keys,
        fn(name) {
            `\`__q_left\`.\{quoted(name)} <=> \`__q_right\`.\{quoted(name)}`
        }
    );
    let selected = if count {
        "count(1)"
    } else {
        string::join(outputs, ", ")
    };
    let ranking: (String, String, RenderCtx) = match joined.rank {
        None => ("", "", right.ctx),
        Some(rank) => do {
            let left_measure = `\`__q_left\`.\{quoted(rank.left_measure)}`;
            let right_measure = `\`__q_right\`.\{quoted(rank.right_measure)}`;
            let a = if rank.first == qb::PairSide::Left {
                left_measure
            } else {
                right_measure
            };
            let b = if rank.first == qb::PairSide::Left {
                right_measure
            } else {
                left_measure
            };
            let first = `CAST(\{a} AS DOUBLE)`;
            let second = `CAST(\{b} AS DOUBLE)`;
            let expression = match rank.op {
                qb::PairRankOp::Subtract => `(\{first} - \{second})`,
                qb::PairRankOp::Ratio => `(\{first} / NULLIF(\{second}, 0))`,
                qb::PairRankOp::GrowthRate => `((\{first} - \{second}) / NULLIF(\{second}, 0))`,
            };
            let guard = match rank.op {
                qb::PairRankOp::Subtract => "",
                qb::PairRankOp::Ratio => ` AND \{b} <> 0`,
                qb::PairRankOp::GrowthRate => ` AND \{b} > 0`,
            };
            let ties = array::map(
                joined.keys,
                fn(name) {
                    ordered_sql(`\`__q_left\`.\{quoted(name)}`, qb::Ordering::Asc)
                }
            );
            let take = emit_expr(rank.take, right.ctx);
            (
                `, \{expression} AS \`comparison_value\``,
                ` WHERE \{left_measure} IS NOT NULL AND \{right_measure} IS NOT NULL\{guard} ORDER BY \{ordered_sql(`\`comparison_value\``, rank.direction)}, \{string::join(ties, ", ")} LIMIT \{take.sql}`,
                take.ctx
            )
        },
    };
    {
        sql: `SELECT \{selected}\{ranking.0} FROM (\{left.sql}) AS \`__q_left\` INNER JOIN (\{right.sql}) AS \`__q_right\` ON \{string::join(keys, " AND ")}\{ranking.1}`,
        ctx: ranking.2
    }
};

# Materialize the same validated AST boundary as the PostgreSQL renderer.
# The final selection wraps the rendered query: the take bound at intent time
# is a literal (it never occupies a placeholder), and the ordering keys render
# through the same occurrence expansion so a bound key pushes its own `?`.
def render_selection: Fn(Emitted, qb::ResultSelection, Option(Array(String))) -> Emitted = fn(
    query,
    selection,
    columns
) {
    let take = qb::public_take(selection.take);
    let projected = match columns {
        Some(names) => string::join(array::map(names, quoted), ", "),
        None => "*",
    };
    let order_initial: Arguments = {sql: [], ctx: query.ctx};
    let ordering = array::fold(
        selection.order_by,
        order_initial,
        fn(state, item) {
            let key = emit_expr(item.key, state.ctx);
            {sql: array::push(state.sql, ordered_sql(key.sql, item.direction)), ctx: key.ctx}
        }
    );
    let order_sql = if array::length(ordering.sql) > 0 {
        ` ORDER BY \{string::join(ordering.sql, ", ")}`
    } else {
        ""
    };
    {
        sql: `SELECT \{projected} FROM (\{query.sql}) AS \`__q_result\`\{order_sql} LIMIT \{take}`,
        ctx: ordering.ctx
    }
};

pub def build_query: Fn(qb::QueryAst) -> qb::Query = fn(ast) {
    let raw = ast.plan;
    let builder = ast.ctx;
    let plan = qb::validate_query_plan(qb::validate_contextual_pagination(raw, builder));
    let reserved = match plan {
        qb::QueryPlan::Rows(rows) => plan_aliases(rows),
        qb::QueryPlan::DistinctRows(rows) => plan_aliases(rows),
        qb::QueryPlan::GroupCount(rows) => plan_aliases(rows),
        qb::QueryPlan::SetRows(set) => array::flat_map(set.operands, plan_aliases),
        qb::QueryPlan::SetCount(set) => array::flat_map(set.operands, plan_aliases),
        qb::QueryPlan::JoinedGroups(joined) => array::concat(
            [plan_aliases(joined.left), plan_aliases(joined.right)]
        ),
        qb::QueryPlan::JoinedGroupCount(joined) => array::concat(
            [plan_aliases(joined.left), plan_aliases(joined.right)]
        ),
    };
    let ctx = context(reserved, builder.bindings);
    # Rows plans whose only pagination is a bare OFFSET upgrade it to the
    # single-layer `LIMIT <take> OFFSET ?` shape inside emit_rows_from, so
    # the selection must not wrap them a second time. In that single-layer
    # shape the selection's own order_by is dropped and the plan ordering
    # stands: the shared intent layer never combines a plan offset with a
    # final selection, so this is a defensive path, not a reachable contract.
    let selection_take: Option(Int) = match ast.selection {
        Some(selection) => Some(qb::public_take(selection.take)),
        None => None,
    };
    let single_layer = match (plan, selection_take) {
        (qb::QueryPlan::Rows(rows), Some(_)) => rows.limit == None && rows.offset != None,
        (qb::QueryPlan::DistinctRows(rows), Some(_)) => rows.limit == None && rows.offset != None,
        _ => False,
    };
    let rendered = match plan {
        qb::QueryPlan::Rows(rows) => emit_rows_from(rows, False, ctx, None, selection_take),
        qb::QueryPlan::DistinctRows(rows) => emit_rows_from(rows, True, ctx, None, selection_take),
        qb::QueryPlan::GroupCount(rows) => count_over(emit_rows(rows, False, ctx)),
        qb::QueryPlan::SetRows(set) => emit_set(set, ctx),
        qb::QueryPlan::SetCount(set) => count_over(emit_set(set, ctx)),
        qb::QueryPlan::JoinedGroups(joined) => emit_joined_groups(joined, False, ctx),
        qb::QueryPlan::JoinedGroupCount(joined) => emit_joined_groups(joined, True, ctx),
    };
    let selected: Emitted = match (ast.selection, single_layer) {
        (Some(selection), False) => render_selection(rendered, selection, ast.output_columns),
        (_, True) => rendered,
        (None, False) => rendered,
    };
    {sql: selected.sql, bindings: selected.ctx.occurrences}
};
