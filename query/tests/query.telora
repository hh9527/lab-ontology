# query/tests/query.telora
#
# Public contract checks for the QueryBuilder package: closed operator
# vocabulary, profile coverage, structural validity, deterministic SQLite
# lowering, binding order, and the untagged-scalar JSON codec boundary of
# `Val`/`Query`.  `check @test/query` evaluates every exported def;
# any failure makes the check exit non-zero.

import "std/array" as array;
import "std/string" as string;
import "std/codec" as codec;
import "std/dict" as dict;
import "std/json" as json;
import "std/result" as result;
import "std/value" { Value };
import "@src/lib" as qb;

# ---------------------------------------------------------------------------
# JSON codec boundary helpers (Val <-> untagged scalar JSON).
# ---------------------------------------------------------------------------

def encode_val: Fn(qb.Val) -> Value = fn(val) {
    codec.encode(Value, val) |> result.unwrap
};

def decode_val: Fn(Value) -> qb.Val = fn(value) {
    codec.decode(qb.Val, value) |> result.unwrap
};

def val_roundtrip: Fn(qb.Val) -> Bool = fn(val) {
    decode_val(encode_val(val)) == val
};

# Parse a JSON scalar text and decode it back to a Val (dispatch check).
def json_to_val: Fn(String) -> qb.Val = fn(text) {
    let parsed = json.parse(text) |> result.unwrap;
    decode_val(parsed)
};

# A scalar JSON value: String/Int/Float/True/False.  Any Array/Object or
# wrapper object (e.g. {"Int": 3}) is not a native scalar.
def is_scalar_value: Fn(Value) -> Bool = fn(value) {
    match value {
        'String(_) => 'True,
        'Int(_) => 'True,
        'Float(_) => 'True,
        'True => 'True,
        'False => 'True,
        _ => 'False,
    }
};

# Encode a Query across the codec boundary and check that `bindings` is a
# native scalar array with no variant wrappers.
def query_bindings_are_scalar_array: Fn(qb.Query) -> Bool = fn(query) {
    let encoded = codec.encode(Value, query) |> result.unwrap;
    match encoded {
        'Object(fields) => match dict.get(fields, "bindings") {
            'Some('Array(items)) => array.all(items, is_scalar_value),
            _ => 'False,
        },
        _ => 'False,
    }
};

def query_encoded_bindings_match: Fn(qb.Query, Array(qb.Val)) -> Bool = fn(query, expected) {
    let encoded = codec.encode(Value, query) |> result.unwrap;
    match encoded {
        'Object(fields) => match dict.get(fields, "bindings") {
            'Some('Array(items)) => array.map(items, decode_val) == expected,
            _ => 'False,
        },
        _ => 'False,
    }
};


def full_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [
            'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
            'Filter, 'Join, 'Group, 'Order, 'Limit,
        ],
        allowed_join_kinds: ['Inner, 'Left],
        allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
        allowed_scalars: ['Substr, 'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not],
        allow_distinct: 'True,
    };
    profile
};

def simple_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Bind, 'Order],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr],
        allow_distinct: 'True,
    };
    profile
};

def no_distinct_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Aggregate],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr],
        allow_distinct: 'False,
    };
    profile
};

def restricted_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Bind, 'Scalar, 'Order],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr],
        allow_distinct: 'True,
    };
    profile
};

def demo_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-demo",
        sources: [qb.source("o", "orders")],
        projection: [
            qb.expr_item(qb.column("o", "customer_id")),
            qb.expr_item(qb.substr([qb.column("o", "name"), qb.bind_int(1), qb.bind_int(3)])),
            qb.aggregate('Sum, qb.column("o", "total"), 'False, "total_sum"),
        ],
        filter: 'Some(qb.scalar('Gt, [qb.column("o", "total"), qb.bind_float(100.0)])),
        joins: [
            qb.join(
                'Inner,
                qb.source("c", "customers"),
                qb.column_ref("o", "customer_id"),
                qb.column_ref("c", "id"),
            ),
        ],
        grouping: [qb.column("o", "customer_id")],
        ordering: [qb.asc(qb.column("o", "customer_id"))],
        limit: 'Some(10),
    };
    plan
};

def simple_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-simple",
        sources: [qb.source("orders", "orders")],
        projection: [
            qb.expr_item(qb.column("orders", "id")),
            qb.expr_item(qb.bind_string("x")),
        ],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [qb.asc(qb.column("orders", "id"))],
        limit: 'None,
    };
    plan
};

def distinct_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-distinct",
        sources: [qb.source("o", "orders")],
        projection: [qb.aggregate('Count, qb.column("o", "customer_id"), 'True, "customers")],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: 'None,
    };
    plan
};

