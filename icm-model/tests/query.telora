# ---------------------------------------------------------------------------
# 37. Structured time provenance contract: time windows compiled from relative
#     phrases must carry an explicit reference moment, and every declared
#     window lowers to the same half-open absolute [start, end) filters.
#     'Direct (user-supplied absolute bounds) and 'FixedWindow with an explicit
#     reference both compile; a FixedWindow/Calendar without a reference fails
#     deterministically in validate_time_window.
# ---------------------------------------------------------------------------

def time_window_intent: Fn(facade.TimeWindowKind, Option(String)) -> facade.Intent = fn(kind, reference) {
    {
        measures: [request_measure("ServerCpuUsageAvg")],
        dimensions: [],
        filters: [],
        any_of: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
        exists: [],
        having: [],
        group_count: 'None,
        time_windows: 'Some([{
            dimension: "ServerKpiTime",
            subject: "analyst",
            kind: kind,
            start: "2026-08-01 00:00:00",
            end: "2026-08-08 00:00:00",
            reference: reference,
        }]),
    }
};

def time_window_sql: String = "SELECT avg(k.cpuUsage) AS ServerCpuUsageAvg FROM ServerDeviceKPI AS k WHERE (k.ts >= ? AND k.ts < ?)";
def time_window_bindings: Array(ScalarValue) = ['String("2026-08-01 00:00:00"), 'String("2026-08-08 00:00:00")];

def assert_context_intent_query: Fn(facade.Intent, Option(String), String, Array(ScalarValue)) -> Bool = fn(
    intent, trusted, expected_sql, expected_bindings
) {
    let query: qb.Query = facade.make_intent_query_context(intent, trusted);
    if query.sql != expected_sql {
        fail!("context query.sql mismatch", query.sql, expected_sql)
    } else if query.bindings != expected_bindings {
        fail!("context query.bindings mismatch", query.bindings, expected_bindings)
    } else {
        'True
    }
};

def assert_deterministic_context_intent: Fn(facade.Intent, Option(String)) -> Bool = fn(intent, trusted) {
    let first: qb.Query = facade.make_intent_query_context(intent, trusted);
    let second: qb.Query = facade.make_intent_query_context(intent, trusted);
    if first == second { 'True } else {
        fail!("context intent query is not deterministic")
    }
};

# Positive: user-supplied absolute bounds (Direct) compile without any context.
export def test_time_window_direct_absolute = assert_intent_query(
    time_window_intent('Direct, 'None),
    time_window_sql,
    time_window_bindings,
);

# Positive: fixed-duration window with an explicit trusted Host context compiles.
export def test_time_window_fixed_with_trusted_context = assert_context_intent_query(
    time_window_intent('FixedWindow, 'Some("2026-08-08 00:00:00")),
    'Some("2026-08-08 00:00:00"),
    time_window_sql,
    time_window_bindings,
);

export def test_time_window_fixed_trusted_deterministic = assert_deterministic_context_intent(
    time_window_intent('FixedWindow, 'Some("2026-08-08 00:00:00")),
    'Some("2026-08-08 00:00:00"),
);

# Trust boundary: an Intent self-reported reference is NOT trusted on its own.
export def test_time_context_trust_boundary = do {
    let forged: facade.Intent = time_window_intent('FixedWindow, 'Some("2026-08-08 00:00:00"));
    let no_context: Bool = facade.time_context_ok(forged.time_windows, 'None);
    let _a: Bool = if no_context == 'False {
        'True
    } else {
        fail!("forged self-reported reference without trusted context must not be trusted")
    };
    let consistent: Bool = facade.time_context_ok(forged.time_windows, 'Some("2026-08-08 00:00:00"));
    let _b: Bool = if consistent { 'True } else {
        fail!("matching trusted context must be accepted")
    };
    let mismatched: Bool = facade.time_context_ok(forged.time_windows, 'Some("2026-08-09 00:00:00"));
    let _c: Bool = if mismatched == 'False {
        'True
    } else {
        fail!("mismatched trusted context must be rejected")
    };
    'True
};

# ---------------------------------------------------------------------------
# 38. Model-declared two-hop correlated existence (exists_route): a KPI fact
#     (ServerDeviceKPI) reaches alarm through its unique owner device with a
#     grain-safe join + correlated EXISTS; no fan-out JOIN to alarm, so the
#     sample grain/count is never amplified.
# ---------------------------------------------------------------------------

def two_hop_kpi_intent: facade.Intent = {
    measures: [request_measure("ServerCpuUsageAvg")],
    dimensions: [],
    filters: [],
    any_of: [],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
    exists: [
        {
            target: "alarm",
