# Public type and module contract checks for the EnterpriseKnowledge eDSL.
# Evaluated by `check @test/ontology`; any broken contract fails loudly.

import "query/lib" as qb;
import "std/array" as array;
import "std/string" as string;
import "@src/edsl" as edsl;
import "@src/knowledge" as knowledge;

def check: Fn(Bool, String) -> Bool = fn(cond, label) {
    if cond { 'True } else { fail!("ontology contract check failed", label) }
};

def option_unwrap: for(A) Fn(Option(A)) -> A = fn(value) {
    match value { 'Some(v) => v, 'None => fail!("expected a value") }
};

def get_index: for(A) Fn(Array(A), Int) -> A = fn(values, i) {
    match array.get(values, i) {
        'Some(v) => v,
        'None => fail!("index out of range", i),
    }
};

def is_head_expr: Fn(qb.Expr) -> Bool = fn(e) {
    match e {
        'Scalar(call) => call.function == 'If && array.length(call.args) == 3,
        _ => 'False,
    }
};

def is_eq_bind: Fn(qb.Expr, String, qb.Val) -> Bool = fn(e, column, value) {
    match e {
        'Scalar(call) => call.function == 'Eq
            && array.length(call.args) == 2
            && (match array.get(call.args, 0) |> option_unwrap {
                'Column(ref) => ref.source == "t" && ref.column == column,
                _ => 'False,
            })
            && (match array.get(call.args, 1) |> option_unwrap { 'Bind(v) => v == value, _ => 'False }),
        _ => 'False,
    }
};

def main_request: Fn() -> edsl.QueryRequest = fn() {
    let request: edsl.QueryRequest = {
        measures: [
            { id: "OrderAmount", subject: "analyst", input: 'All },
        ],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [
            { target: 'Measure("OrderAmount"), direction: 'Desc },
            { target: 'Dimension("OrderRegion"), direction: 'Asc },
        ],
        limit: 'Some(3),
        offset: 'None,
        partition: 'None,
    };
    request
};

# Plan / PlanProfile / Query are owned by query: the eDSL does not
# define alternatives and the knowledge profile is a qb.PlanProfile.
def plan_ownership_ok: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, main_request());
    let validated: qb.Plan = qb.validate(plan, knowledge.profile);
    check(array.length(validated.sources) >= 1, "plan is a query Plan and validates")
};

# The request vocabulary is closed and typed: ordering targets distinguish
# Measure and Dimension variants; ids are the declared business vocabulary.
def request_vocabulary_ok: Bool = do {
    let target: edsl.OrderTarget = 'Measure("OrderAmount");
    let target2: edsl.OrderTarget = 'Dimension("OrderRegion");
    let ok1 = match target { 'Measure(id) => id == "OrderAmount", 'Dimension(_) => 'False };
    let ok2 = match target2 { 'Dimension(id) => id == "OrderRegion", 'Measure(_) => 'False };
    check(ok1 && ok2, "ordering targets distinguish closed Measure/Dimension variants")
};

# Business vocabulary ids in the prepared payload are valid SQL output
# identifiers (aliases are derived from them at prepare time).
def vocabulary_identifiers_ok: Bool = do {
    let p = knowledge.payload;
    let measure_ok = array.all(p.measures, fn(m) { qb.is_sql_identifier(m.alias) });
    let dim_ok = array.all(p.dimensions, fn(d) { qb.is_sql_identifier(d.id) });
    check(measure_ok, "measure aliases are valid SQL identifiers")
        && check(dim_ok, "dimension ids are valid SQL identifiers")
};

# Prepared behavior is cross-module: the payload published by the knowledge
# module is consumed here with its closures intact.
def prepared_cross_module_ok: Bool = do {
    let p = knowledge.payload;
    let auth_ok = p.authorize("analyst") && !p.authorize("nobody");
    let week = match array.find(p.dimensions, fn(d) { d.id == "OrderWeek" }) {
        'Some(d) => d,
        'None => fail!("OrderWeek missing from prepared dimensions"),
    };
    let expr = edsl.dimension_expr(p, week);
    let computed_ok = match expr {
        'Scalar(call) => call.function == 'Substr,
        _ => 'False,
    };
    check(auth_ok, "published authorization closure works cross-module")
        && check(computed_ok, "published computed-dimension closure works cross-module")
};

# The knowledge declares a closed set of entities explicitly on the root; the
# payload contains exactly those entities and their facts, including the
# vocabulary-vs-authorization separation and measure required entities.
def root_explicit_entities_ok: Bool = do {
    let p = knowledge.payload;
    let contact = array.find(p.dimensions, fn(d) { d.id == "CustomerContact" });
    let contact_known = match contact {
        'Some(d) => !d.authorized && !d.filterable,
        'None => 'False,
    };
    let item_amount = array.find(p.measures, fn(m) { m.id == "ItemAmount" });
    let item_requires_order = match item_amount {
        'Some(m) => m.requires == [0],
        'None => 'False,
    };
    check(array.length(p.entities) == 5, "root explicitly lists five entity types")
        && check(array.length(p.measures) == 15, "fifteen measures collected from properties")
        && check(array.length(p.dimensions) == 11, "eleven dimensions collected from properties")
        && check(array.length(p.relations) == 3, "three relations collected from properties")
        && check(contact_known, "known-but-unauthorized dimension stays in the closed vocabulary")
        && check(item_requires_order, "measure required entities resolved to entity indexes")
};

# A lower request produces a Plan whose Query is deterministic and
# parameterized (bindings non-empty when filters/limit present).
def parameterized_query_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [{ id: "OrderRegion", subject: "analyst", op: 'Eq, input: 'Text("west") }],
        ordering: [],
        limit: 'Some(2),
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let query: qb.Query = qb.transform_sqlite(plan);
    check(array.length(query.bindings) == 2, "filter value and limit are parameterized bindings")
        && check(!qb.is_sql_identifier("1abc"), "identifier lexical rule still applies")
};

# Closed enum value domains: the CustomerTier dimension publishes a closed
# catalog (stable values and labels) discoverable from the payload, while open
# String dimensions keep an empty domain.
def enum_domain_ok: Bool = do {
    let p = knowledge.payload;
    let tier = match array.find(p.dimensions, fn(d) { d.id == "CustomerTier" }) {
        'Some(d) => d,
        'None => fail!("CustomerTier dimension missing"),
    };
    let values = tier.values;
    let domain_ok = array.length(values) == 3
        && array.any(values, fn(v) { v.variant == "Gold" && v.value == "gold" && v.label == "Gold customer" })
        && array.any(values, fn(v) { v.variant == "Silver" && v.value == "silver" && v.label == "Silver customer" })
        && array.any(values, fn(v) { v.variant == "Bronze" && v.value == "bronze" && v.label == "Bronze customer" });
    let region = match array.find(p.dimensions, fn(d) { d.id == "OrderRegion" }) {
        'Some(d) => d,
        'None => fail!("OrderRegion dimension missing"),
    };
    check(domain_ok, "CustomerTier dimension publishes its closed enum value domain")
        && check(array.length(region.values) == 0, "open String dimension has an empty value domain")
};

# A legal enum stable value produces a parameterized binding; the closed
# domain does not change projection/grouping of the underlying column.
def enum_filter_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CustomerTier", subject: "analyst", input: 'None }],
        filters: [{ id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("gold") }],
        ordering: [{ target: 'Dimension("CustomerTier"), direction: 'Asc }],
        limit: 'Some(3),
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let filter_ok = match plan.filter {
        'Some('Scalar(call)) => call.function == 'Eq
            && array.length(call.args) == 2
            && (match call.args[0] { 'Column(ref) => ref.source == "c" && ref.column == "tier", _ => 'False })
            && (match call.args[1] { 'Bind('String("gold")) => 'True, _ => 'False }),
        _ => 'False,
    };
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("gold"), 'Int(3)];
    check(filter_ok, "legal enum value lowers to Eq on the tier column with a bind")
        && check(query.bindings == expected, "enum filter binding is the stable value followed by the limit")
};

# Public discovery helper: dimension_domain exposes the closed catalog for an
# enum dimension and the empty domain for an open dimension.
def dimension_domain_helper_ok: Bool = do {
    let values = edsl.dimension_domain(knowledge.payload, "CustomerTier");
    let region_values = edsl.dimension_domain(knowledge.payload, "OrderRegion");
    check(array.length(values) == 3, "dimension_domain exposes the enum closed catalog")
        && check(array.length(region_values) == 0, "dimension_domain exposes the open domain as empty")
};

# Pagination lowers to the standard Plan.offset: a request with stable ordering
# and a non-negative offset keeps limit, sets offset, and appends the offset as
# the last ordered binding. Finite results are business semantics, not proof of
# full coverage.
def pagination_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'Some(5),
        offset: 'Some(20),
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let query: qb.Query = qb.transform_sqlite(plan);
    let offset_ok = plan.offset == 'Some(20);
    let last_ok = match array.get(query.bindings, array.length(query.bindings) - 1) {
        'Some(v) => v == 'Int(20),
        'None => 'False,
    };
    check(offset_ok, "pagination: offset lowers to Plan.offset")
        && check(last_ok, "pagination: offset is the last ordered binding")
};

# Computed dimensions can safely use the closed query scalars ('If/'Instr) and
# participate in projection and grouping with arity-validated expressions.
def computed_dimension_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "TraceCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "TraceHead", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let proj_ok = array.any(plan.projection, fn(item) {
        match item { 'Expr(e) => is_head_expr(e), 'Aggregate(_) => 'False, 'Computed(_) => 'False }
    });
    let group_ok = array.length(plan.grouping) == 1 && is_head_expr(array.get(plan.grouping, 0) |> option_unwrap);
    check(proj_ok, "computed dimension: new-scalar expression in projection")
        && check(group_ok, "computed dimension: same expression in grouping")
};

# Generic domain scope: a dimension member declares its inherent row range as
# typed predicates; the prepared payload publishes them, and selecting the
# member merges the scope before user filters, both parameterized.
def scope_ok: Bool = do {
    let p = knowledge.payload;
    let head = match array.find(p.dimensions, fn(d) { d.id == "TraceHead" }) {
        'Some(d) => d,
        'None => fail!("TraceHead dimension missing"),
    };
    let declared_ok = array.length(head.scope) == 1
        && get_index(head.scope, 0).field == 1
        && get_index(head.scope, 0).op == 'Eq
        && get_index(head.scope, 0).input == 'Text("run");
    let request: edsl.QueryRequest = {
        measures: [{ id: "TraceCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "TraceHead", subject: "analyst", input: 'None }],
        filters: [{ id: "TraceOwner", subject: "analyst", op: 'Eq, input: 'Text("alice") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let merged_ok = match plan.filter {
        'Some('Scalar(call)) => call.function == 'And
            && array.length(call.args) == 2
            && is_eq_bind(array.get(call.args, 0) |> option_unwrap, "kind", 'String("run"))
            && is_eq_bind(array.get(call.args, 1) |> option_unwrap, "owner", 'String("alice")),
        _ => 'False,
    };
    check(declared_ok, "scope: inherent scope predicate published on the member")
        && check(merged_ok, "scope: scope merges before the user filter, both parameterized")
};

# Top Per Group lowers to the standard Plan.partition: per-partition top N with
# a stable ordering; global limit/offset/ordering are not combined.
def top_per_group_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
            { id: "OrderWeek", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [
            { target: 'Measure("OrderAmount"), direction: 'Desc },
            { target: 'Dimension("OrderWeek"), direction: 'Asc },
        ],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let part_ok = match plan.partition {
        'Some(p) => p.take == 2
            && array.length(p.partition_by) == 1
            && array.length(p.order_by) == 2,
        'None => 'False,
    };
    let no_global = array.length(plan.ordering) == 0 && plan.limit == 'None && plan.offset == 'None;
    check(part_ok, "top per group: partition lowers to Plan.partition")
        && check(no_global, "top per group: no global limit/offset/ordering combined")
};

# Filtered and computed measures are part of the prepared knowledge and lower
# through the public Plan: filtered aggregates carry their inherent predicate,
# computed measures combine declared dependencies.
def filtered_computed_measures_ok: Bool = do {
    let p = knowledge.payload;
    let run = match array.find(p.measures, fn(m) { m.id == "TraceRunCount" }) {
        'Some(m) => m.predicate,
        'None => fail!("TraceRunCount missing"),
    };
    let delta = match array.find(p.measures, fn(m) { m.id == "TraceDelta" }) {
        'Some(m) => m.computed,
        'None => fail!("TraceDelta missing"),
    };
    let pred_ok = match run {
        'Some(pred) => pred.field == 1 && pred.op == 'Eq && pred.input == 'Text("run"),
        'None => 'False,
    };
    let total = match array.find(p.measures, fn(m) { m.id == "TraceTotal" }) {
        'Some(m) => m.computed,
        'None => fail!("TraceTotal missing"),
    };
    let computed_ok = match delta {
        'Some(spec) => spec.op == 'Sub && spec.left == "TraceRunCount" && spec.right == "TraceSkipCount",
        'None => 'False,
    };
    let total_ok = match total {
        'Some(spec) => spec.op == 'Add && spec.left == "TraceRunCount" && spec.right == "TraceSkipCount",
        'None => 'False,
    };
    let request: edsl.QueryRequest = {
        measures: [{ id: "TraceDelta", subject: "analyst", input: 'All }],
        dimensions: [{ id: "TraceOwner", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let deps_projected = array.any(plan.projection, fn(item) {
        match item { 'Aggregate(agg) => agg.alias == "TraceRunCount" || agg.alias == "TraceSkipCount", _ => 'False }
    });
    let computed_projected = array.any(plan.projection, fn(item) {
        match item { 'Computed(c) => c.alias == "TraceDelta" && c.op == 'Sub, _ => 'False }
    });
    check(pred_ok, "filtered measure: inherent predicate published on the measure entry")
        && check(computed_ok && total_ok, "computed measure: 'Sub and 'Add dependency specs published")
        && check(deps_projected && computed_projected, "computed measure: dependencies and computed item are projected")
};

# The non-Timeline Approval example declares mutually exclusive conditional
# counts plus Add/Sub composition through the same public path.
def approval_measures_ok: Bool = do {
    let p = knowledge.payload;
    let net = match array.find(p.measures, fn(m) { m.id == "ApprovalNet" }) {
        'Some(m) => m.computed,
        'None => fail!("ApprovalNet missing"),
    };
    let spec_ok = match net {
        'Some(spec) => spec.op == 'Sub && spec.left == "ApprovalApprovedCount" && spec.right == "ApprovalRejectedCount",
        'None => 'False,
    };
    let request: edsl.QueryRequest = {
        measures: [{ id: "ApprovalTotal", subject: "analyst", input: 'All }],
        dimensions: [{ id: "ApprovalStatus", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let total_ok = array.any(plan.projection, fn(item) {
        match item { 'Computed(c) => c.alias == "ApprovalTotal" && c.op == 'Add, _ => 'False }
    });
    check(spec_ok, "approval: non-Timeline computed net spec published")
        && check(total_ok, "approval: non-Timeline Add composition lowers")
};

export {
    plan_ownership_ok,
    request_vocabulary_ok,
    vocabulary_identifiers_ok,
    prepared_cross_module_ok,
    root_explicit_entities_ok,
    parameterized_query_ok,
    enum_domain_ok,
    enum_filter_ok,
    dimension_domain_helper_ok,
    pagination_ok,
    computed_dimension_ok,
    scope_ok,
    top_per_group_ok,
    filtered_computed_measures_ok,
    approval_measures_ok,
};
