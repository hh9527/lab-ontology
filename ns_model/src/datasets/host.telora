    @v::map(domains::HoRunningStatus.type, "ho_running_status", [v::member(domains::HoRunningStatus::Normal, ["1"])])
    running_status: Option(String),
    @m::column("ipAddress")
    @g::field_view(g::dimension_group("host/ip_address", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ho_ip_address", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ip_address: Option(String),
    @g::field_view(g::dimension_group("host/initiatornum", Int.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "ho_initiatornum", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    initiatornum: Option(Int),
