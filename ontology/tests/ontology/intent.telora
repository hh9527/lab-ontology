pub def computed_measure_references_its_declared_operands: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Measure, owner: "approvals", id: "ApprovalTotal"};
    match knowledge::by_target(payload, id) {
        knowledge::DocResult::Found(point) => if array::any(point.refs, fn(ref) {
            ref.target.kind == edsl::KnowledgeKind::Measure && ref.target.owner == "approvals"
                && ref.target.id == "ApprovalApprovedCount"
        }) && array::any(point.refs, fn(ref) {
            ref.target.kind == edsl::KnowledgeKind::Measure && ref.target.owner == "approvals"
                && ref.target.id == "ApprovalRejectedCount"
        }) { True } else { fail!("computed knowledge lost its declared measure operands", point) },
        other => fail!("computed measure is not discoverable", other),
    }
});

pub def key_backed_dataset_publishes_its_identity_grain: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "customers"};
    match knowledge::by_target(payload, id) {
        knowledge::DocResult::Found(point) => if point.grain == ["id"] { True }
            else { fail!("key-backed dataset did not publish its identity", point.grain) },
        other => fail!("customer dataset is not discoverable", other),
    }
});

type CatalogEntry = struct { key: String, type: edsl::KnowledgeKind, label: String, from: Option(String), to: Option(String) };
type CatalogDetail = struct { entries: Array(CatalogEntry), total: Int, revision: Option(String) };

def catalog_entry_type: Fn(CatalogEntry) -> Value = fn(entry) {
    match codec::encode(entry) {
        Value::Object(fields) => match dict::get(fields, "type") {
            Some(value) => value, None => fail!("catalog entry has no type", entry),
        },
        other => fail!("catalog entry must be an object", other),
    }
};

def discover_entries: Fn(Fn(Value) -> Value, String) -> Array(CatalogEntry) = fn(info, key) {
    let response = codec::decode@[knowledge::NodeResponse](info(Value::Object({key: Value::String(key)}))).unwrap!();
    match response {
        knowledge::NodeResponse::Document(knowledge::NodeResult::Found(node)) => {
            let detail = codec::decode@[knowledge::IndexDetail](node.detail).unwrap!();
            array::map(detail.schemas, fn(schema) {
                {key: schema, type: edsl::KnowledgeKind::Schema, label: schema, from: None, to: None}.ty!(CatalogEntry)
            })
        },
        other => fail!("discovery directory is not addressable", key, other),
    }
};

pub def intent_syntax_is_discoverable_and_cross_referenced: test::Test = test::should_ok(fn() {
    let indexed = knowledge::index_entries(knowledge::map(payload)).entries;
    let root = knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Schema, owner: "", id: "syntax/intent"});
    let filter = knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Schema, owner: "", id: "syntax/graph/filter"});
    let info = knowledge::knowledge_info_method_factory(payload);
    let discovered = discover_entries(info, "index");
    let syntax_key = edsl::knowledge_key({kind: edsl::KnowledgeKind::Schema, owner: "", id: "syntax/intent"});
    let filter_key = match array::find(discovered, fn(entry) {
        entry.key == edsl::knowledge_key({kind: edsl::KnowledgeKind::Schema, owner: "", id: "syntax/graph/filter"})
    }) {
        Some(entry) => entry.key,
        None => fail!("filter syntax is absent from directory discovery", discovered),
    };
    let info_response = info(Value::Object({key: Value::String(filter_key)}));
    if !array::any(indexed, fn(entry) { entry.key.id == "syntax/intent" }) {
        fail!("Intent syntax is absent from the knowledge index")
    } else if !array::any(discovered, fn(entry) { entry.key == syntax_key })
        || !string::contains(json::stringify(info_response), "No kind field") {
        fail!("Intent syntax is absent from directory discovery or info", discovered, info_response)
    } else {
        match (root, filter) {
            (knowledge::DocResult::Found(a), knowledge::DocResult::Found(b)) =>
                if array::any(a.refs, fn(ref) { ref.target.id == "syntax/graph" })
                    && string::contains(b.summary, "No kind field")
                    && string::contains(b.summary, "Model facts, not the Intent value shape") { True }
                else { fail!("Intent syntax links or filter contract are missing", a, b) },
            _ => fail!("Intent syntax topics cannot be resolved", root, filter),
        }
    }
});

pub def knowledge_target_round_trips_through_both_info_entries: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let first = codec::decode@[knowledge::NodeResponse](info(json::parse(r#"{"key":"Dataset/orders"}"#).unwrap!())).unwrap!();
    let returned = match first {
        knowledge::NodeResponse::Document(knowledge::NodeResult::Found(point)) => point.key,
        other => fail!("dataset topic did not resolve to a target", other),
    };
    let input = json::parse(`{"key":\{json::stringify(codec::encode(returned))}}`).unwrap!();
    let direct = codec::decode@[knowledge::NodeResponse](info(input)).unwrap!();
    let service = knowledge::knowledge_service_factory(payload, "test");
    let wrapped = json::parse(`{"method":"test/info","input":\{json::stringify(input)}}`).unwrap!();
    let via_service = codec::decode@[knowledge::NodeResponse](service(wrapped)).unwrap!();
    match (direct, via_service) {
        (knowledge::NodeResponse::Document(knowledge::NodeResult::Found(a)),
            knowledge::NodeResponse::Document(knowledge::NodeResult::Found(b))) =>
            if a.key == returned && b.key == returned { True }
            else { fail!("returned target changed while resolving info", returned, a, b) },
        _ => fail!("returned target could not be reused with info", direct, via_service),
    }
});

pub def invalid_knowledge_key_points_to_its_declared_shape: test::Test = test::should_fail_with(fn() {
    knowledge::knowledge_info_method_factory(payload)(
        json::parse(r#"{"key":123}"#).unwrap!())
}, "$.key: expected String; see info key");

pub def top_and_existence_repair_topics_are_discoverable: test::Test = test::should_ok(fn() {
    let indexed = knowledge::index_entries(knowledge::map(payload)).entries;
    let order = knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Schema, owner: "", id: "syntax/graph/order"});
    let existence = knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Schema, owner: "", id: "syntax/graph/existence"});
    match (order, existence) {
        (knowledge::DocResult::Found(top), knowledge::DocResult::Found(exists)) =>
            if array::any(indexed, fn(entry) { entry.key.id == "syntax/graph/order" })
                && array::any(indexed, fn(entry) { entry.key.id == "syntax/graph/existence" })
                && string::contains(top.summary, "Raw global Top-N Graph shape")
                && string::contains(top.summary, "Aggregate Top-N Graph shape")
                && string::contains(top.summary, "Per-owner sample Top-N")
                && string::contains(exists.summary, "Complete Graph shape")
                && string::contains(exists.summary, "relation direction must match its declaration")
                && array::any(top.refs, fn(ref) { ref.target.id == "syntax/graph/existence" }) { True }
            else { fail!("Top-N and EXISTS knowledge does not expose linked repair shapes", top, exists) },
        _ => fail!("Top-N or EXISTS repair topic is missing", order, existence),
    }
});

pub def discovered_filter_operator_is_accepted_by_intent: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload)(json::parse(r#"{
        "key":"Dimension/orders/OrderRegion"
    }"#).unwrap!());
    let result = query_request_method_factory(payload, sqlite::build_query)(json::parse(r#"{
        "intents":[{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],
            "edges":[],"select":[],"count":"a",
            "filters":[{"node":"a","dimension":"OrderRegion","op":"Eq","value":"east"}]}]
    }"#).unwrap!());
    if string::contains(json::stringify(info), "\"ops\":[\"Eq\"")
        && batch_field(result, "accepted") == Value::True { True }
    else { fail!("info operator spelling does not lower as an Intent", info, result) }
});

pub def time_window_shape_diagnostic_links_its_contract: test::Test = test::should_ok(fn() {
    let result = query_request_method_factory(payload, sqlite::build_query)(json::parse(r#"{
        "intents":[{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],
            "edges":[],"select":[],"count":"a",
            "time_windows":[{"node":"a","dimension":"OrderDate","start":"2024-01-01","bogus":1}]}]
    }"#).unwrap!());
    let reports = match batch_field(result, "diagnostics") {
        Value::Array(items) => items,
        other => fail!("time-window error returned no diagnostics", other),
    };
    let diagnostic = codec::decode@[diagnostics::Diagnostic](batch_field(reports[0], "diagnostic")).unwrap!();
    match knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Schema, owner: "", id: "syntax/graph/order"}) {
        knowledge::DocResult::Found(point) =>
            if batch_field(result, "accepted") == Value::False
                && string::contains(diagnostic.message, "$.bogus: unknown field; see info key")
                && string::contains(point.summary, "time_windows items are {node,dimension,start,end}") { True }
            else { fail!("time-window diagnostic does not lead to its contract", diagnostic, point) },
        other => fail!("time-window syntax topic is missing", other),
    }
});

