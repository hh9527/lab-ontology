# IC 独立声明迁移入口；尚未切换 MainService。
pub mod inventory;
mod profile;
pub mod site;
pub mod port;
pub mod interface_kpi;
pub mod server;
pub mod server_kpi;
pub mod server_fan;
pub mod server_psu;
pub mod server_memory;
pub mod storage;
pub mod frame;
pub mod network_slot;
pub mod pon_device;
pub mod pon_onu;
pub mod pon_olt;
use std::array as array;
use ontology::experimental::model as m;
use self::inventory as inventory;
use self::profile as profile;
use ontology::experimental::transform as t;
use ontology::experimental::relations as r;
use ontology::ontology as edsl;
def payload: edsl::PreparedPayload = t::build("icloud-typed-v1", [
    inventory::device_declaration <~ {dataset: m::prepare(inventory::devices, [
        inventory::device_subject, inventory::device_tenant, site::project, site::subnet,
    ])},
    inventory::tenant_declaration,
    site::declaration,
    port::declaration,
    interface_kpi::declaration,
    server::declaration,
    server_kpi::declaration,
    server_fan::declaration,
    server_psu::declaration,
    server_memory::declaration,
    storage::declaration,
    frame::declaration,
    network_slot::declaration,
    pon_device::declaration,
    pon_onu::declaration,
    pon_olt::declaration,
], array::concat([inventory::relations, site::relations, port::relations, interface_kpi::relations, server::relations, server_kpi::relations, server_fan::relations, server_psu::relations, server_memory::relations, storage::relations, frame::relations, network_slot::relations, pon_device::relations, [r::relation("pon_onu_parent_olt", pon_onu::dataset, pon_onu::parent, pon_olt::dataset, pon_olt::subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional})]]), array::concat([site::alternatives, server::alternatives, storage::alternatives, pon_device::alternatives]), [], profile::profile).payload;
pub use self::{payload};
