        payload.profile, fn(subject) { subject == "resolver" })
}, "business link A endpoint relation is not declared on its hub");

pub def rejects_same_endpoint_twice: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid", [Tenant.type, Site.type, Device.type, Connection.type, Route.type, SameEndpointLink.type],
        payload.profile, fn(subject) { subject == "resolver" })
}, "business link endpoints must carry the same complete identity through distinct roles");

pub def declared_business_links: test::Test = test::should_ok(fn() {
    let symmetric = array::find(payload.business_links, fn(link) { link.id == "connected_device" });
    let directed = array::find(payload.business_links, fn(link) { link.id == "upstream_device" });
    match (symmetric, directed) {
        (Some(a), Some(b)) => if a.direction == edsl::LinkDirection::Undirected
            && b.direction == edsl::LinkDirection::Directed
            && a.participant == b.participant { True }
            else { fail!("business direction was not preserved in prepared Model") },
        _ => fail!("missing prepared business link"),
    }
});

pub def undirected_business_link: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"a",
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"connected_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, " OR ")
        && string::contains(sq.sql, "a_device_id") && string::contains(sq.sql, "z_device_id")
        && string::contains(sq.sql, "tenant_id") && string::contains(pg.sql, " OR ") {
        True
    } else { fail!("bidirectional link did not bind both complete endpoint identities", sq.sql, pg.sql) }
});

pub def undirected_business_link_from_z: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"z",
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"connected_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, " OR ") && string::contains(sql, "connected_device_link") {
        True
    } else { fail!("undirected link should be traversable from either device", sql) }
});

pub def directed_business_link: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"a",
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"upstream_device","from":"a","to":"z"}],
        "select":[{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "a_device_id") && string::contains(sql, "z_device_id")
        && !string::contains(sql, " OR ") {
        True
    } else { fail!("directed link must retain A-to-Z orientation", sql) }
});

pub def directed_business_link_rejects_reverse: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"z",
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
