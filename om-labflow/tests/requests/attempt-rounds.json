{
  "measures": [{"id": "EventCount", "input": "all"}],
  "dimensions": [{"id": "AttemptId"}],
  "filters": [
    {"id": "EventType", "op": "eq", "value": "task_started"},
    {"id": "AtTime", "op": "le", "value": 1750000000000}
  ],
  "ordering": [{"target": {"kind": "measure", "id": "EventCount"}, "direction": "desc"}],
  "limit": 10
}
