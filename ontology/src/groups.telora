# 显式严格构造，用于诊断和检查需要立即拒绝的调用方。
def checked_input: for(Row, Value) Fn(model::Field(Row, Value)) -> Expr(Row, Value) = fn(field) {
    if field.owner != Row.type || field.value != Value.type {
        fail!("group input witness does not match its type", field.name)
    } else {
        let verified = if field.nullable {
            model::checked_optional_field(Row.type, Value.type, field.name)
        } else {
            model::checked_field(Row.type, Value.type, field.name)
        };
        checked(
            {
                row: Row.type,
                value: Value.type,
                nullable: verified.nullable,
                node: Node::Column(
                    {name: verified.name, value: Value.type, nullable: verified.nullable}
                )
            }
        )
    }
};
def checked_dimension_group: for(Value) Fn(
    String,
    TypeOf(Value),
    Bool,
    Array(Filter)
) -> DimensionGroup(Value) = fn(id, value, projectable, filters) {
    validate_filters(Value.type, filters);
    if id == "" {
        fail!("group id must be nonempty", id)
    } else {
        {id, value, projectable, filters}
    }
};
def checked_dimension: for(Row, Value) Fn(
    model::Dataset(Row),
    DimensionGroup(Value),
    Expr(Row, Value),
    String,
    Bool,
    Array(Filter)
) -> Binding(Row) = fn(dataset, group, source, publish, projectable, filters) {
    model::checked_prepare(dataset, []);
    validate_filters(Value.type, group.filters);
    validate_filters(Value.type, filters);
    let valid = checked(source);
    if group.id == "" || group.value != Value.type {
        fail!("dimension group witness does not match its type", group.id)
    } else if (projectable && !group.projectable) || !array::all(
        filters,
        fn(op) {
            array::any(
                group.filters,
                fn(allowed) {
                    allowed == op
                }
            )
        }
    ) {
        fail!("dimension binding cannot expand group capabilities", publish)
    } else {
        {
            row: Row.type,
            dataset: dataset.id,
            source: dataset.source,
            contract: BindingContract::Dimension,
            members: [
                {
                    group: group.id,
                    local: "value",
                    id: publish,
                    node: valid.node,
                    value: valid.value,
                    nullable: valid.nullable,
                    aggregate: None,
                    projectable,
                    filters,
                    kind: MemberKind::Dimension(
                        {projectable: group.projectable, filters: group.filters}
                    )
                }
            ]
        }
    }
};
def checked_seconds: for(Row) Fn(Expr(Row, quantity::Milliseconds)) -> Expr(Row, quantity::Seconds) = fn(
    source
) {
    let valid = checked(source);
    {
        row: Row.type,
        value: quantity::Seconds.type,
        nullable: valid.nullable,
        node: Node::Seconds(valid.node)
    }
};
def checked_rate: for(Row) Fn(
    Expr(Row, quantity::Bytes),
    Expr(Row, quantity::Seconds)
) -> Expr(Row, quantity::BytesPerSecond) = fn(amount, duration) {
    {
        row: Row.type,
        value: quantity::BytesPerSecond.type,
        nullable: True,
        node: Node::Rate({amount: checked(amount).node, duration: checked(duration).node})
    }
};
def checked_ipv4: for(Row) Fn(Expr(Row, String)) -> Expr(Row, scalars::Ipv4) = fn(source) {
    {
        row: Row.type,
        value: scalars::Ipv4.type,
        nullable: True,
        node: Node::Ipv4(checked(source).node)
    }
};
def checked_utc_bucket: for(Row, Time) Fn(Expr(Row, Time), qb::UtcBucketUnit) -> Expr(Row, Time) = fn(
    input,
    unit
) {
    let source = checked(input);
    bucket_encoding(Time.type, unit);
    {
        row: Row.type,
        value: Time.type,
        nullable: True,
        node: Node::UtcBucket({input: source.node, unit})
    }
};
def checked_numeric_group: for(Value) Fn(
    String,
    TypeOf(Value),
    Array(Statistic)
) -> NumericGroup(Value) = fn(id, value, members) {
    validate_numeric(id, value, members);
    {id, value, members}
};
def checked_numeric_binding: for(Row, Value) Fn(
    model::Dataset(Row),
    NumericGroup(Value),
    Expr(Row, Value),
    Array(StatisticName)
) -> Binding(Row) = fn(dataset, group, source, names) {
    model::checked_prepare(dataset, []);
    let input = checked(source);
    validate_numeric(group.id, group.value, group.members);
    if group.value != Value.type {
        fail!("numeric group type witness does not match its parameter", group.id)
    } else if array::length(names) != array::length(group.members) || !array::all(
        group.members,
        fn(member) {
            array::length(
                array::filter(
                    names,
                    fn(name) {
                        name.member == member
                    }
                )
            ) == 1
        }
    ) {
        fail!("numeric binding must name every statistic exactly once", group.id)
    } else {
        let members = array::map(
            group.members,
            fn(member) {
                let name = match array::find(
                    names,
                    fn(name) {
                        name.member == member
                    }
                ) {
                    Some(name) => name.publish,
                    None => fail!("missing numeric statistic name", group.id)
                };
                {
                    group: group.id,
                    local: statistic_name(member),
                    id: name,
                    node: input.node,
                    value: Value.type,
                    nullable: True,
                    aggregate: Some(statistic_function(member)),
                    projectable: True,
                    filters: [],
                    kind: MemberKind::Numeric(member)
                }.ty!(Member)
            }
        );
        {
            row: Row.type,
            dataset: dataset.id,
            source: dataset.source,
            contract: BindingContract::Numeric(
                {id: group.id, value: group.value, members: group.members}
            ),
            members
        }
    }
};
def checked_transfer_binding: for(Row) Fn(
    model::Dataset(Row),
    MeasureGroup,
    Expr(Row, quantity::Bytes),
    Expr(Row, quantity::Seconds),
    Array(Rename)
) -> Binding(Row) = fn(dataset, group, amount, elapsed, names) {
    model::checked_prepare(dataset, []);
    let quantity = checked(amount);
    let speed = checked_rate(quantity, elapsed);
    if group.id == "" || array::length(group.members) == 0 {
        fail!("measure group must declare members", group.id)
    } else if array::length(names) != array::length(group.members) || !array::all(
        group.members,
        fn(member) {
            array::length(
                array::filter(
                    group.members,
                    fn(other) {
                        other == member
                    }
                )
            ) == 1 && array::length(
                array::filter(
                    names,
                    fn(name) {
                        name.member == member
                    }
                )
            ) == 1
        }
    ) {
        fail!("measure binding must name every member exactly once", group.id)
    } else {
        let members = array::map(
            group.members,
            fn(member) {
                let name = match array::find(
                    names,
                    fn(name) {
                        name.member == member
                    }
                ) {
                    Some(value) => value,
                    None => fail!("measure binding is missing a member", group.id),
                };
                let recipe: Recipe = match member {
                    TransferMember::AmountTotal => {
                        local: "amount_total",
                        node: quantity.node,
                        value: quantity.value,
                        function: qb::AggregateFunction::Sum
                    },
                    TransferMember::RatePeak => {
                        local: "rate_peak",
                        node: speed.node,
                        value: speed.value,
                        function: qb::AggregateFunction::Max
                    },
                    TransferMember::RateMean => {
                        local: "rate_mean",
                        node: speed.node,
                        value: speed.value,
                        function: qb::AggregateFunction::Avg
                    },
                };
                {
                    group: group.id,
                    local: recipe.local,
                    id: name.publish,
                    node: recipe.node,
                    value: recipe.value,
                    nullable: True,
                    aggregate: Some(recipe.function),
                    projectable: True,
                    filters: [],
                    kind: MemberKind::Transfer(member)
                }.ty!(Member)
            }
        );
        {
            row: Row.type,
            dataset: dataset.id,
            source: dataset.source,
            contract: BindingContract::Transfer(group),
            members
        }
    }
};
def checked_identity_dimensions: for(Row) Fn(
    model::Dataset(Row),
    model::Role(Row),
    Array(IdentityName)
) -> Binding(Row) = fn(dataset, role, names) {
    let verified = model::checked_prepare(dataset, [role]);
    if array::length(names) != array::length(role.parts) || !array::all(
        role.parts,
        fn(part) {
            array::length(
                array::filter(
                    names,
                    fn(name) {
                        name.member == part.target
                    }
                )
            ) == 1
        }
    ) {
        fail!("identity dimensions must publish the complete identity", role.id)
    } else {
        let parts = array::map(
            role.parts,
            fn(part) {
                {name: part.source, value: part.value, nullable: part.nullable}.ty!(Column)
            }
        );
        let members = array::map(
            role.parts,
            fn(part) {
                let name = match array::find(
                    names,
                    fn(name) {
                        name.member == part.target
                    }
                ) {
                    Some(value) => value,
                    None => fail!("identity dimension name is missing", part.target),
                };
                {
                    group: `identity_\{role.entity}`,
                    local: part.target,
                    id: name.publish,
                    node: Node::Identity(
                        {
                            column: {name: part.source, value: part.value, nullable: part.nullable},
                            parts
                        }
                    ),
                    value: part.value,
                    nullable: array::any(
                        parts,
                        fn(part) {
                            part.nullable
                        }
                    ),
                    aggregate: None,
                    projectable: True,
                    filters: [Filter::Eq],
                    kind: MemberKind::Dimension({projectable: True, filters: [Filter::Eq]})
                }.ty!(Member)
            }
        );
        {
            row: Row.type,
            dataset: dataset.id,
            source: dataset.source,
            contract: BindingContract::Identity(verified.roles[0]),
            members
        }
    }
};
def checked_prepare: for(Row) Fn(model::Dataset(Row), Array(Binding(Row))) -> Array(Member) = fn(
    dataset,
    bindings
) {
    validate_facts(model::checked_prepare(dataset, []), array::map(bindings, binding_facts))
};
