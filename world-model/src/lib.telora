mod model;

import "@src/model" { payload };
import "ontology/intent" as intent;
import "ontology/query" as qb;
import "std/transform-service" as service;
import "std/codec" as codec;
import "std/value" { Value };

type MainService = struct { lower: Fn(Value) -> qb.Query };
impl service.TransformService for MainService {
    init: fn(ctx) {
        { lower: intent.query_intent_lower_factory(payload, "public") }.ty!(Self)
    },
    transform: fn(self, input) {
        codec.encode(self.lower(input))
    },
};
export { MainService };
