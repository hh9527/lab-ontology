use std::string as string;
use std::test as test;
use crate::query as qb;
use crate::postgres as pg;

pub def nested_json_bind_order: test::Test = test::should_ok(fn() {
    let path = qb::json_path([qb::JsonPathSegment::Key("a.b"), qb::JsonPathSegment::FromEnd(1)]);
    let predicate = qb::scalar(qb::ScalarFunction::Eq, [
        qb::json_extract(qb::column("MixedAlias", "PayloadJSON"), path, qb::JsonScalarKind::Int),
        qb::bind_int(20),
    ]);
    let query = pg::render_expr(predicate, 4);
    if query.sql == `(json_extract_path_text("MixedAlias"."PayloadJSON"::json, VARIADIC ARRAY[$4::text, $5::text]))::bigint = $6`
        && query.bindings == [qb::Val::String("a.b"), qb::Val::String("-1"), qb::Val::Int(20)] {
        True
    } else { fail!("PostgreSQL JSON expression must number path and filter bindings in SQL order", query) }
});

pub def root_path_has_no_binding: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::json_type(qb::bind_string("42"), qb::json_path([])), 1);
    if query.bindings == [qb::Val::String("42")]
        && string::contains(query.sql, "VARIADIC ARRAY[]::text[]")
        && string::contains(query.sql, "json_typeof(") {
        True
    } else { fail!("root path must not add phantom placeholders", query) }
});

pub def repeated_operand_uses_one_binding: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::json_valid(qb::bind_string("{\"x\":1}")), 1);
    if query.bindings == [qb::Val::String("{\"x\":1}")]
        && string::contains(query.sql, "$1 IS NULL")
        && string::contains(query.sql, "pg_input_is_valid($1::text, 'json')") {
        True
    } else { fail!("a repeated PG placeholder must not duplicate the binding", query) }
});

pub def ascii_only_case_fold: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::lower(qb::bind_string("ABCÉ")), 2);
    if query.sql == "translate($2, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')"
        && query.bindings == [qb::Val::String("ABCÉ")] {
        True
    } else { fail!("PG lower must preserve SQLite ASCII-only semantics", query) }
});

pub def invalid_column_identifier: test::Test = test::should_fail_with(fn() {
    pg::render_expr(qb::column("e", "invalid\"name"), 1)
}, "invalid PostgreSQL column identifier");

pub def invalid_placeholder_start: test::Test = test::should_fail_with(fn() {
    pg::render_expr(qb::bind_int(3), 0)
}, "PostgreSQL placeholder index must be positive");
