# om-labflow 公共 typed/dynamic query facade
#
# 两层入口：
# - typed：`build_from_request(payload, request)` 直接消费 ontology QueryRequest；
# - dynamic：`build_from_value(payload, raw)` 从公共业务词汇的 JSON Value 解码为
#   QueryRequest，再走 typed 路径。
#
# 动态请求 JSON 使用业务词汇，不暴露表名、列名、alias、join 或 SQL 片段。
# 任何解码、授权、grain、路径或 profile 失败都原子失败，不发布部分 Query。
#
# dynamic 入口的授权主体固定为 `analyst`：公共 JSON 不再接受 `subject` key，
# 显式提供 `subject` 会按未知 key 拒绝。typed 入口保留 QueryRequest.subject，
# 由调用者显式提供并经过同一 authorize 检查。
#
# 本模块是 crate 的公共 facade；`src/facade.telora` 仅为兼容性 re-export。

import "std/value" { Value };
import "std/dict" as dict;
import "std/array" as array;
import "std/codec" as codec;
import "std/result" as result;
import "ontology/edsl" as edsl;
import "query/lib" as qb;

# ---------------------------------------------------------------------------
# typed 路径
# ---------------------------------------------------------------------------

def build_from_request: Fn(edsl.PreparedPayload, edsl.QueryRequest) -> qb.Query = fn(payload, request) {
    qb.transform_sqlite(edsl.lower(payload, request))
};

def encode_query: Fn(qb.Query) -> Value = fn(query) {
    codec.encode(Value, query) |> result.unwrap
};

# ---------------------------------------------------------------------------
# dynamic 请求解码（Value -> QueryRequest）
# ---------------------------------------------------------------------------

def get_string: Fn(Dict(Value), String) -> Option(String) = fn(obj, key) {
    match dict.get(obj, key) {
        'Some('String(text)) => 'Some(text),
        _ => 'None,
    }
};

# 每个 JSON object 只接受声明过的 key；未知 key 属于未知词汇，整体拒绝。
# `subject` 不属于顶层合法 key：dynamic 入口固定使用 `analyst`，显式提交的
# `subject` 会被当作未知 key 拒绝。
def is_known_top_key: Fn(String) -> Bool = fn(key) {
    key == "measures" || key == "dimensions" || key == "filters" || key == "ordering" || key == "limit"
};

def is_known_measure_key: Fn(String) -> Bool = fn(key) { key == "id" || key == "input" };

def is_known_dimension_key: Fn(String) -> Bool = fn(key) { key == "id" };

def is_known_filter_key: Fn(String) -> Bool = fn(key) { key == "id" || key == "op" || key == "value" };

def is_known_ordering_key: Fn(String) -> Bool = fn(key) { key == "target" || key == "direction" };

def is_known_target_key: Fn(String) -> Bool = fn(key) { key == "kind" || key == "id" };

def keys_allowed: Fn(Dict(Value), Fn(String) -> Bool) -> Bool = fn(obj, allowed) {
    array.all(dict.keys(obj), allowed)
};

def decode_measure: Fn(String, Value) -> Option(edsl.MeasureRequest) = fn(subject, raw) {
    match raw {
        'Object(obj) => {
            let keys_ok = keys_allowed(obj, is_known_measure_key);
            let id = get_string(obj, "id");
            let input = match dict.get(obj, "input") {
                'None => 'Some('All),
                'Some('String("all")) => 'Some('All),
                'Some('String("distinct")) => 'Some('Distinct),
                _ => 'None,
            };
            match (id, input, keys_ok) {
                ('Some(id), 'Some(input), 'True) => 'Some({ id, subject, input }),
                _ => 'None,
            }
        },
        _ => 'None,
    }
};

def decode_measures: Fn(String, Value) -> Option(Array(edsl.MeasureRequest)) = fn(subject, raw) {
    match raw {
        'Array(items) => array.fold(items, 'Some([]), fn(acc, item) {
            match (acc, decode_measure(subject, item)) {
                ('Some(list), 'Some(entry)) => 'Some(array.push(list, entry)),
                _ => 'None,
            }
        }),
        _ => 'None,
    }
};

def decode_dimension: Fn(String, Value) -> Option(edsl.DimensionRequest) = fn(subject, raw) {
    match raw {
        'Object(obj) => {
            let keys_ok = keys_allowed(obj, is_known_dimension_key);
            let id = get_string(obj, "id");
            match (id, keys_ok) {
                ('Some(id), 'True) => 'Some({ id, subject, input: 'None }),
                _ => 'None,
            }
        },
        _ => 'None,
    }
};

def decode_dimensions: Fn(String, Value) -> Option(Array(edsl.DimensionRequest)) = fn(subject, raw) {
    match raw {
        'Array(items) => array.fold(items, 'Some([]), fn(acc, item) {
            match (acc, decode_dimension(subject, item)) {
                ('Some(list), 'Some(entry)) => 'Some(array.push(list, entry)),
                _ => 'None,
            }
        }),
        _ => 'None,
    }
};

def decode_filter_op: Fn(Value) -> Option(edsl.FilterOp) = fn(raw) {
    match raw {
        'String("eq") => 'Some('Eq),
        'String("ge") => 'Some('Ge),
        'String("le") => 'Some('Le),
        _ => 'None,
    }
};

def decode_filter_input: Fn(Value) -> Option(edsl.FilterInput) = fn(raw) {
    match raw {
        'String(text) => 'Some('Text(text)),
        'Int(value) => 'Some('Int(value)),
        'Float(value) => 'Some('Number(value)),
        _ => 'None,
    }
};

def decode_filter: Fn(String, Value) -> Option(edsl.FilterRequest) = fn(subject, raw) {
    match raw {
        'Object(obj) => {
            let keys_ok = keys_allowed(obj, is_known_filter_key);
            let id = get_string(obj, "id");
            let op = match dict.get(obj, "op") {
                'Some(op_raw) => decode_filter_op(op_raw),
                _ => 'None,
            };
            let input = match dict.get(obj, "value") {
                'Some(value_raw) => decode_filter_input(value_raw),
                _ => 'None,
            };
            match (id, op, input, keys_ok) {
                ('Some(id), 'Some(op), 'Some(input), 'True) => 'Some({ id, subject, op, input }),
                _ => 'None,
            }
        },
        _ => 'None,
    }
};

def decode_filters: Fn(String, Value) -> Option(Array(edsl.FilterRequest)) = fn(subject, raw) {
    match raw {
        'Array(items) => array.fold(items, 'Some([]), fn(acc, item) {
            match (acc, decode_filter(subject, item)) {
                ('Some(list), 'Some(entry)) => 'Some(array.push(list, entry)),
                _ => 'None,
            }
        }),
        _ => 'None,
    }
};

def decode_ordering: Fn(Value) -> Option(edsl.OrderRequest) = fn(raw) {
    match raw {
        'Object(obj) => {
            let keys_ok = keys_allowed(obj, is_known_ordering_key);
            let direction = match dict.get(obj, "direction") {
                'Some('String("asc")) => 'Some('Asc),
                'Some('String("desc")) => 'Some('Desc),
                _ => 'None,
            };
            let target = match dict.get(obj, "target") {
                'Some('Object(target_obj)) => {
                    let target_keys_ok = keys_allowed(target_obj, is_known_target_key);
                    let kind = get_string(target_obj, "kind");
                    let id = get_string(target_obj, "id");
                    match (kind, id, target_keys_ok) {
                        ('Some("measure"), 'Some(id), 'True) => 'Some('Measure(id)),
                        ('Some("dimension"), 'Some(id), 'True) => 'Some('Dimension(id)),
                        _ => 'None,
                    }
                },
                _ => 'None,
            };
            match (target, direction, keys_ok) {
                ('Some(target), 'Some(direction), 'True) => 'Some({ target, direction }),
                _ => 'None,
            }
        },
        _ => 'None,
    }
};

def decode_ordering_list: Fn(Value) -> Option(Array(edsl.OrderRequest)) = fn(raw) {
    match raw {
        'Array(items) => array.fold(items, 'Some([]), fn(acc, item) {
            match (acc, decode_ordering(item)) {
                ('Some(list), 'Some(entry)) => 'Some(array.push(list, entry)),
                _ => 'None,
            }
        }),
        _ => 'None,
    }
};

# 纯解码：形状非法返回 'None，不产生诊断。调用者决定如何报告。
def decode_request: Fn(Value) -> Option(edsl.QueryRequest) = fn(raw) {
    match raw {
        'Object(obj) => do {
            let keys_ok = keys_allowed(obj, is_known_top_key);
            let keys_checked = if keys_ok { 0 } else { return 'None; };
            # dynamic 入口固定授权主体；typed 入口才需要调用者显式传 subject。
            let subject = "analyst";
            let measures = match dict.get(obj, "measures") {
                'None => 'Some([].ty!(Array(edsl.MeasureRequest))),
                'Some(value) => decode_measures(subject, value),
            };
            let measures = match measures {
                'Some(value) => value,
                'None => { return 'None; },
            };
            let dimensions = match dict.get(obj, "dimensions") {
                'None => 'Some([].ty!(Array(edsl.DimensionRequest))),
                'Some(value) => decode_dimensions(subject, value),
            };
            let dimensions = match dimensions {
                'Some(value) => value,
                'None => { return 'None; },
            };
            let filters = match dict.get(obj, "filters") {
                'None => 'Some([].ty!(Array(edsl.FilterRequest))),
                'Some(value) => decode_filters(subject, value),
            };
            let filters = match filters {
                'Some(value) => value,
                'None => { return 'None; },
            };
            let ordering = match dict.get(obj, "ordering") {
                'None => 'Some([].ty!(Array(edsl.OrderRequest))),
                'Some(value) => decode_ordering_list(value),
            };
            let ordering = match ordering {
                'Some(value) => value,
                'None => { return 'None; },
            };
            let limit = match dict.get(obj, "limit") {
                'None => 'Some('None),
                'Some('None) => 'Some('None),
                'Some('Int(value)) => 'Some('Some(value)),
                _ => { return 'None; },
            };
            let limit = match limit {
                'Some(value) => value,
                'None => { return 'None; },
            };
            'Some({ measures, dimensions, filters, ordering, limit })
        },
        _ => 'None,
    }
};

# dynamic 路径：解码失败时带来源原子失败。
def build_from_value: Fn(edsl.PreparedPayload, Value) -> qb.Query = fn(payload, raw) {
    let request = match decode_request(raw) {
        'Some(request) => request,
        'None => fail!("invalid query request", raw),
    };
    build_from_request(payload, request)
};

export { build_from_request, build_from_value, encode_query, decode_request };
