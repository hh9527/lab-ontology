# om-labflow 私有领域模型
#
# 本模块只声明 Timeline schema version 2（events.sqlite）中可安全暴露给
# QueryBuilder 的实体、指标、维度、枚举值域与关系。物理 mapping 与公共查询面
# 分离：调用者只接触 knowledge/facade 中的业务词汇，不接触这里的列名。
#
# 注意：同一个字段最多声明一个 measure（同型 property 按 fold 取最后一项）。
# 需要在同一列上提供多个聚合时，声明映射到同一物理列的额外字段。

import "ontology/edsl" as edsl;
import "query/lib" as qb;

# ---------------------------------------------------------------------------
# 常用能力组合
# ---------------------------------------------------------------------------

def flag_true: Bool = 'True;
def flag_false: Bool = 'False;

# 具名聚合函数（闭包化 decorator 实参不能使用 singleton 字面量）
def count_agg: qb.AggregateFunction = 'Count;
def sum_agg: qb.AggregateFunction = 'Sum;
def avg_agg: qb.AggregateFunction = 'Avg;
def max_agg: qb.AggregateFunction = 'Max;
def min_agg: qb.AggregateFunction = 'Min;

# 关系种类
def safe_kind: edsl.RelationKind = 'Safe;

# 文本维度的筛选能力：等值
def eq_ops: Array(edsl.FilterOp) = ['Eq];
# 数值维度的范围筛选：>= 与 <=
def ge_le_ops: Array(edsl.FilterOp) = ['Ge, 'Le];
# 数值维度同时支持等值与范围
def eq_ge_le_ops: Array(edsl.FilterOp) = ['Eq, 'Ge, 'Le];

def text_kinds: Array(edsl.FilterInputKind) = ['Text];
def int_kinds: Array(edsl.FilterInputKind) = ['Int];
def int_number_kinds: Array(edsl.FilterInputKind) = ['Int, 'Number];

# 指标不需要额外必需实体
def no_types: Array(Type) = [];

# CommandHead：command 的第一个空白分隔片段（例如把
# `./bin/telora -C query run main` 投影为 `./bin/telora`）。
# 语义只是“首个空白分隔片段”，不是完整 shell lexer；不会归一化 `./` 前缀，
# 因此 `./bin/telora` 与 `bin/telora` 保持为不同成员。用封闭原语
# Instr/If/Sub/Substr 组合，全部常量保持为参数化 Bind。
def head_builder: Fn(qb.Expr) -> qb.Expr = fn(command) {
    let sep: qb.Expr = qb.bind_string(" ");
    let pos: qb.Expr = qb.instr(command, sep);
    let found: qb.Expr = qb.scalar('Gt, [pos, qb.bind_int(0)]);
    let rest: qb.Expr = qb.sub(pos, qb.bind_int(1));
    qb.scalar_if(found, qb.substr([command, qb.bind_int(1), rest]), command)
};

# CommandHead 的固有 scope：只覆盖 shell action 事件，调用者无需每次手工
# 重复 EventType=action、Action=shell。field 索引是 TimelineEvent 的规范字段
# 顺序（字段名排序，从 0 开始）：event_type = 11，action = 0。
def command_head_scope: Array(edsl.ScopePredicate) = [
    { field: 11, op: 'Eq, input: 'Text("action") },
    { field: 0, op: 'Eq, input: 'Text("shell") },
];

# Host 等待集合：host_request_opened / host_request_resolved 各自动计数，
# 净额用受限计算指标（'Sub）表达。field 索引是 TimelineEvent 的规范字段
# 顺序（字段名排序，从 0 开始）：event_type = 11。
def host_request_opened_pred: edsl.ScopePredicate = { field: 11, op: 'Eq, input: 'Text("host_request_opened") };
def host_request_resolved_pred: edsl.ScopePredicate = { field: 11, op: 'Eq, input: 'Text("host_request_resolved") };

# 任务轮数净额：task_started / task_completed 各自动计数，Outstanding =
# Started - Completed（尚未配对完成的轮数）。两个 EventType 条件只进入各自
# 聚合的 FILTER，不会展平成互斥的全局 AND。
def task_started_pred: edsl.ScopePredicate = { field: 11, op: 'Eq, input: 'Text("task_started") };
def task_completed_pred: edsl.ScopePredicate = { field: 11, op: 'Eq, input: 'Text("task_completed") };

# 受限计算指标运算符（ComputedOp）
def sub_op: qb.ComputedOp = 'Sub;

# ---------------------------------------------------------------------------
# 封闭值域：任务类别
# ---------------------------------------------------------------------------

type TaskKind = enum {
    @edsl.enum_value("artifact", "Artifact task")
    'Artifact,
    @edsl.enum_value("problem", "Problem task")
    'Problem,
};

# ---------------------------------------------------------------------------
# 封闭值域：事件类型（Timeline schema version 2 的全部合法 type）
# ---------------------------------------------------------------------------

type EventType = enum {
    @edsl.enum_value("thinking", "Thinking span")
    'Thinking,
    @edsl.enum_value("action", "Tool action")
    'Action,
    @edsl.enum_value("reply", "Assistant reply")
    'Reply,
    @edsl.enum_value("session_started", "Session started")
    'SessionStarted,
    @edsl.enum_value("session_ended", "Session ended")
    'SessionEnded,
    @edsl.enum_value("turn_started", "Turn started")
    'TurnStarted,
    @edsl.enum_value("turn_ended", "Turn ended")
    'TurnEnded,
    @edsl.enum_value("task_started", "Task started")
    'TaskStarted,
    @edsl.enum_value("task_completed", "Task completed")
    'TaskCompleted,
    @edsl.enum_value("artifact_refreshed", "Artifact refreshed")
    'ArtifactRefreshed,
    @edsl.enum_value("artifact_deleted", "Artifact deleted")
    'ArtifactDeleted,
    @edsl.enum_value("host_request_opened", "Host request opened")
    'HostRequestOpened,
    @edsl.enum_value("host_request_resolved", "Host request resolved")
    'HostRequestResolved,
    @edsl.enum_value("dag_revised", "DAG revised")
    'DagRevised,
};

# ---------------------------------------------------------------------------
# Timeline 事件实体（events.sqlite 的 timeline 表）
#
# 每行是一个 Timeline 事件。`at` 与 `duration` 的单位均为毫秒。
# 字段名排序后的索引（从 0 开始）用于 relation 声明，不要凭书写顺序推断。
# ---------------------------------------------------------------------------

@edsl.entity_source("timeline", "t")
type TimelineEvent = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("EventCount", count_agg, no_types)
    @edsl.filtered_measure("HostRequestOpenedCount", count_agg, no_types, host_request_opened_pred)
    @edsl.filtered_measure("HostRequestResolvedCount", count_agg, no_types, host_request_resolved_pred)
    @edsl.computed_measure("HostRequestNet", sub_op, "HostRequestOpenedCount", "HostRequestResolvedCount")
    @edsl.filtered_measure("TaskStartedCount", count_agg, no_types, task_started_pred)
    @edsl.filtered_measure("TaskCompletedCount", count_agg, no_types, task_completed_pred)
    @edsl.computed_measure("TaskOutstanding", sub_op, "TaskStartedCount", "TaskCompletedCount")
    id: String,

    @edsl.column("execution")
    @edsl.dimension("Execution", flag_true, flag_true, eq_ops, text_kinds)
    execution: String,

    @edsl.column("session")
    @edsl.dimension("Session", flag_true, flag_true, eq_ops, text_kinds)
    session: String,

    @edsl.column("turn")
    @edsl.dimension("Turn", flag_true, flag_true, eq_ops, text_kinds)
    turn: String,

    @edsl.column("role")
    @edsl.dimension("Role", flag_true, flag_true, eq_ops, text_kinds)
    role: String,

    @edsl.column("task_kind")
    @edsl.dimension("TaskKind", flag_true, flag_true, eq_ops, text_kinds)
    task_kind: TaskKind,

    @edsl.column("task_id")
    @edsl.dimension("TaskId", flag_true, flag_true, eq_ops, text_kinds)
    task_id: String,

    @edsl.column("artifact")
    @edsl.dimension("Artifact", flag_true, flag_true, eq_ops, text_kinds)
    artifact: String,

    @edsl.column("dag_revision")
    @edsl.dimension("DagRevision", flag_true, flag_true, eq_ops, text_kinds)
    dag_revision: String,

    @edsl.column("type")
    @edsl.dimension("EventType", flag_true, flag_true, eq_ops, text_kinds)
    event_type: EventType,

    @edsl.column("at")
    @edsl.dimension("AtTime", flag_true, flag_true, ge_le_ops, int_kinds)
    @edsl.measure("AtMax", max_agg, no_types)
    at: Int,

    @edsl.column("duration")
    @edsl.dimension("Duration", flag_true, flag_true, eq_ge_le_ops, int_number_kinds)
    @edsl.measure("DurationSum", sum_agg, no_types)
    duration: Int,

    @edsl.column("duration")
    @edsl.measure("DurationMax", max_agg, no_types)
    duration_max: Int,

    @edsl.column("duration")
    @edsl.measure("DurationAvg", avg_agg, no_types)
    duration_avg: Int,

    @edsl.column("tokens")
    @edsl.measure("TokenSum", sum_agg, no_types)
    tokens: Int,

    @edsl.column("action")
    @edsl.dimension("Action", flag_true, flag_true, eq_ops, text_kinds)
    action: String,

    @edsl.column("success")
    @edsl.dimension("Success", flag_true, flag_true, eq_ops, int_kinds)
    success: Int,

    @edsl.column("command")
    @edsl.dimension("Command", flag_true, flag_true, eq_ops, text_kinds)
    command: String,

    @edsl.column("command")
    @edsl.computed_dimension("CommandHead", flag_true, flag_true, eq_ops, text_kinds, head_builder)
    @edsl.scope(command_head_scope)
    command_head: String,

    @edsl.column("exit_code")
    @edsl.dimension("ExitCode", flag_true, flag_true, eq_ops, int_kinds)
    exit_code: Int,

    @edsl.column("input_tokens")
    @edsl.measure("InputTokenSum", sum_agg, no_types)
    input_tokens: Int,

    @edsl.column("output_tokens")
    @edsl.measure("OutputTokenSum", sum_agg, no_types)
    output_tokens: Int,

    @edsl.column("reasoning_tokens")
    @edsl.measure("ReasoningTokenSum", sum_agg, no_types)
    reasoning_tokens: Int,

    @edsl.column("cache_read_tokens")
    @edsl.measure("CacheReadTokenSum", sum_agg, no_types)
    cache_read_tokens: Int,

    @edsl.column("cache_write_tokens")
    @edsl.measure("CacheWriteTokenSum", sum_agg, no_types)
    cache_write_tokens: Int,

    @edsl.column("payload_json")
    @edsl.json_dimension("AttemptId", flag_true, flag_true, eq_ops, text_kinds, "$.attempt_id")
    @edsl.json_dimension("TaskCompletionStatus", flag_true, flag_true, eq_ops, text_kinds, "$.status")
    payload_json: String,
};

# ---------------------------------------------------------------------------
# Action path 实体（events.sqlite 的 action_paths 表）
#
# 一个 action 事件可有多个 path。以 ActionPath 为 grain 的查询可以安全地
# 经 event_id -> timeline.id 到达 TimelineEvent（Safe 方向）；反向会扩张
# grain，被知识层拒绝。
# ---------------------------------------------------------------------------

@edsl.entity_source("action_paths", "ap")
@edsl.relation(TimelineEvent, safe_kind, 0, 14)
type ActionPath = struct {
    @edsl.column("event_id")
    event_id: String,

    @edsl.column("path")
    @edsl.dimension("Path", flag_true, flag_true, eq_ops, text_kinds)
    @edsl.measure("PathCount", count_agg, no_types)
    path: String,
};

export { TimelineEvent, ActionPath, TaskKind, EventType };
