pub def onu_alias_is_discoverable_without_changing_business_value: test::Test = test::should_ok(fn() {
    let detail = edsl::dimension_detail_for_subject(payload, "public", "pon_class");
    let internal = edsl::dimension_detail(payload, "pon_class");
    let onu = array::find(detail.values, fn(value) { value.id == "onu" });
    match onu {
        Some(value) => if value.label == "ONU" && value.aliases == ["光猫"]
            && array::length(internal.canonical_aliases) == 1
            && array::any(internal.canonical_values, fn(v) { v.id == "spl" && v.label == "GPON" }) { True }
            else { fail!("ONU alias must point to the same stable business value", detail, internal) },
        None => fail!("ONU alias has no business value", detail),
    }
});

