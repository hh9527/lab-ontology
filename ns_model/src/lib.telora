# NS 统一模型发布入口
pub mod model;
pub mod units;
pub mod identities;
pub mod metric_values;
pub mod domains;
pub mod datasets;
mod profile;
use ontology::publication;
use std::transform_service as service;
use std::value::{Value};
def program: publication::Program = publication::stage(model::revision, model::roots, model::plan_profile, "ns", []);
type ModelService = struct { program: publication::Program };
impl service::TransformService for ModelService {
    init: fn(ctx) { {program}.ty!(Self) },
    transform: fn(self, input) { publication::dispatch(self.program, input) },
};
@service::collection
pub type MainService = struct {
    @service::slot("ontology/model")
    model: ModelService,
};
