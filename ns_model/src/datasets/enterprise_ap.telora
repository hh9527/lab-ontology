@domain::subject("NetworkElement", "id")
@domain::dataset("enterprise-ap", "EnterpriseAP", ["id"])
@domain::relations(relations)
pub type EnterpriseAp = struct {
    @m::column("productName")
    @g::field_view(g::dimension_group("enterprise-ap/product_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ea_product_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    product_name: Option(String),
    @g::field_view(g::dimension_group("enterprise-ap/location", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ea_location", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    location: Option(String),
    @m::column("refParentSubnet")
    @g::field_view(g::dimension_group("enterprise-ap/ref_parent_subnet", domain::Reference(ids::SubnetById).type, True, [g::Filter::Eq]), "ea_ref_parent_subnet", True, [g::Filter::Eq])
    ref_parent_subnet: Option(domain::Reference(ids::SubnetById)),
    @g::field_view(g::dimension_group("enterprise-ap/id", ids::NetworkElementById.type, True, [g::Filter::Eq]), "ea_id", True, [g::Filter::Eq])
    @domain::count("ea_count")
    id: ids::NetworkElementById,
    @m::column("typeId")
    @g::field_view(g::dimension_group("enterprise-ap/type_id", String.type, True, [g::Filter::Eq]), "ea_type_id", True, [g::Filter::Eq])
    type_id: Option(String),
    @m::column("refParentNE")
    @g::field_view(g::dimension_group("enterprise-ap/ref_parent_ne", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "ea_ref_parent_ne", True, [g::Filter::Eq])
    ref_parent_ne: Option(domain::Reference(ids::NetworkElementById)),
    @g::field_view(g::dimension_group("enterprise-ap/version", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ea_version", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    version: Option(String),
    @m::column("ipAddress")
    @g::field_view(g::dimension_group("enterprise-ap/ip_address", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ea_ip_address", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ip_address: Option(String),
    @g::field_view(g::dimension_group("enterprise-ap/sn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ea_sn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    sn: Option(String),
    @g::field_view(g::dimension_group("enterprise-ap/manufacturer", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ea_manufacturer", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    manufacturer: Option(String),
    @g::field_view(g::dimension_group("enterprise-ap/mac", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ea_mac", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    mac: Option(String),
    @m::column("commuState")
    @g::field_view(g::dimension_group("enterprise-ap/commu_state/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ea_commu_state_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::EaCommunicationState.type, "ea_commu_state", [v::member(domains::EaCommunicationState::Offline, ["1","4","offline"]), v::member(domains::EaCommunicationState::Other, ["2","3","5","6","7","9","10","11","12","13","14","15","other"]), v::member(domains::EaCommunicationState::Online, ["8","online"])])
    commu_state: Option(String),
    @g::field_view(g::dimension_group("enterprise-ap/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ea_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
