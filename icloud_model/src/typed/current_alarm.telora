def dataset: m::Dataset(Row) = m::dataset("current_alarm", "T_CURRENT_ALARM", Row.type, ["csn"]);
def device: m::Role(Row) = m::role(dataset, i::device, "device", False, [m::reference_part(m::field(Row.type, String.type, "res_id"), m::field(i::DeviceIdentity.type, i::DeviceId.type, "id"))]);
def server_reference: m::Role(Row) = m::role(dataset, server::entity, "server", False, [m::reference_part(m::field(Row.type, String.type, "res_id"), m::field(server::Identity.type, server::ServerId.type, "id"))]);
def storage_reference: m::Role(Row) = m::role(dataset, storage::entity, "storage", False, [m::reference_part(m::field(Row.type, String.type, "res_id"), m::field(storage::Identity.type, storage::StorageId.type, "id"))]);
def pon_reference: m::Role(Row) = m::role(dataset, pon::entity, "pon", False, [m::reference_part(m::field(Row.type, String.type, "res_id"), m::field(pon::Identity.type, pon::PonId.type, "id"))]);
def site_reference: m::Role(Row) = m::role(dataset, site::entity, "site", False, [m::reference_part(m::field(Row.type, String.type, "strext13"), m::field(site::Identity.type, i::SiteId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
@knowledge_policy::reverse_references(True)
type AlarmSeverity = struct(String);
def AlarmSeverity_domain: v::Domain(AlarmSeverity, Int) = v::ordered(v::domain("AlarmSeverity", AlarmSeverity.type, Int.type, [
    v::member(AlarmSeverity("critical"), [1]),
    v::member(AlarmSeverity("major"), [2]),
    v::member(AlarmSeverity("minor"), [3]),
    v::member(AlarmSeverity("warning"), [4]),
], False), [AlarmSeverity("critical"), AlarmSeverity("major"), AlarmSeverity("minor"), AlarmSeverity("warning")]);
@knowledge_policy::reverse_references(True)
