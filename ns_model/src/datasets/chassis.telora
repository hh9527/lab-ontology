use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::enterprise_enclosure_2_kpi;
@domain::subject("Chassis", "id")
@domain::dataset("chassis", "SYS_Chassis", ["id"])
@domain::relations(relations)
pub type Chassis = struct {
    @g::field_view(g::dimension_group("chassis/id", ids::ChassisById.type, True, [g::Filter::Eq]), "ch_id", True, [g::Filter::Eq])
    @domain::count("ch_count")
    id: ids::ChassisById,
    @g::field_view(g::dimension_group("chassis/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ch_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("chassis/obj_sys_id", domain::Reference(ids::EnterpriseEnclosure2KpiByObjSysId).type, True, [g::Filter::Eq]), "ch_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::EnterpriseEnclosure2KpiByObjSysId)),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("chassis/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "ch_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("logicType")
    @g::field_view(g::dimension_group("chassis/logic_type/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ch_logic_type_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::ChLogicType.type, "ch_logic_type", [v::member(domains::ChLogicType::CascadingEnclosureDiskEnclosure, ["0"]), v::member(domains::ChLogicType::ControlEnclosure, ["1"]), v::member(domains::ChLogicType::DataSwitch, ["2"]), v::member(domains::ChLogicType::ManagementSwitch, ["3"]), v::member(domains::ChLogicType::ManagementServer, ["4"])])
    logic_type: Option(String),
    @g::field_view(g::dimension_group("chassis/wwn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ch_wwn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    wwn: Option(String),
    @g::field_view(g::dimension_group("chassis/temperature", String.type, True, [g::Filter::Eq]), "ch_temperature", True, [g::Filter::Eq])
    temperature: Option(String),
    @m::column("barCode")
    @g::field_view(g::dimension_group("chassis/bar_code", String.type, True, [g::Filter::Eq]), "ch_bar_code", True, [g::Filter::Eq])
    bar_code: Option(String),
    @m::column("bomId")
    @g::field_view(g::dimension_group("chassis/bom_id", String.type, True, [g::Filter::Eq]), "ch_bom_id", True, [g::Filter::Eq])
    bom_id: Option(String),
    @g::field_view(g::dimension_group("chassis/slot", String.type, True, [g::Filter::Eq]), "ch_slot", True, [g::Filter::Eq])
    slot: Option(String),
    @g::field_view(g::dimension_group("chassis/sn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "ch_sn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    sn: Option(String),
    @m::column("healthStatus")
    @g::field_view(g::dimension_group("chassis/health_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ch_health_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::ChHealthStatus.type, "ch_health_status", [v::member(domains::ChHealthStatus::Unknown, ["0"]), v::member(domains::ChHealthStatus::Normal, ["1"]), v::member(domains::ChHealthStatus::Faulty, ["2"])])
    health_status: Option(String),
    @m::column("runningStatus")
    @g::field_view(g::dimension_group("chassis/running_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ch_running_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::ChRunningStatus.type, "ch_running_status", [v::member(domains::ChRunningStatus::Value0, ["0"]), v::member(domains::ChRunningStatus::Value1, ["1"]), v::member(domains::ChRunningStatus::Value2, ["2"]), v::member(domains::ChRunningStatus::Value5, ["5"]), v::member(domains::ChRunningStatus::Value27, ["27"]), v::member(domains::ChRunningStatus::Value28, ["28"])])
    running_status: Option(String),
};

pub def relations: Array(r::Relation) = [
    r::relation("ee2__ch_rev", domain::endpoint(Chassis.type, "obj_sys_id"), domain::endpoint(enterprise_enclosure_2_kpi::EnterpriseEnclosure2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
