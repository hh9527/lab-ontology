use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::serverpartition_2_kpi;
@domain::subject("KpiServerPartition", "obj_id")
@domain::dataset("kpi-server-partition", "kpi_server_partition", ["obj_id","ts"])
@domain::metric("ts")
@domain::relations(relations)
pub type KpiServerPartition = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-server-partition/obj_id", domain::Reference(ids::KpiServerPartitionByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "sepa_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::KpiServerPartitionByObjId),
    @m::column("TS")
    @g::field_view(g::dimension_group("kpi-server-partition/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "sepa_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("sepa_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("sepa_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("sepa_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("DISKUSAGERATE")
    @g::field_view(g::dimension_group("kpi-server-partition/disk_usage_rate", metric::KpiServerPartitionDiskUsageRate.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sepa_disk_usage_rate_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-server-partition/disk_usage_rate", metric::KpiServerPartitionDiskUsageRate.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "sepa_disk_usage_rate"}, {statistic: samples::Statistic::Max, publish: "sepa_disk_usage_rate_max"}, {statistic: samples::Statistic::Min, publish: "sepa_disk_usage_rate_min"}])
    disk_usage_rate: Option(metric::KpiServerPartitionDiskUsageRate),
    @m::column("DISKUSEDCAPACITY")
    @g::field_view(g::dimension_group("kpi-server-partition/disk_used_capacity", metric::KpiServerPartitionDiskUsedCapacity.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sepa_disk_used_capacity_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-server-partition/disk_used_capacity", metric::KpiServerPartitionDiskUsedCapacity.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("GB")), [{statistic: samples::Statistic::Mean, publish: "sepa_disk_used_capacity"}, {statistic: samples::Statistic::Max, publish: "sepa_disk_used_capacity_max"}, {statistic: samples::Statistic::Min, publish: "sepa_disk_used_capacity_min"}])
    disk_used_capacity: Option(metric::KpiServerPartitionDiskUsedCapacity),
    @m::column("DISKTOTALCAPACITY")
    @g::field_view(g::dimension_group("kpi-server-partition/disk_total_capacity", metric::KpiServerPartitionDiskTotalCapacity.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sepa_disk_total_capacity_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-server-partition/disk_total_capacity", metric::KpiServerPartitionDiskTotalCapacity.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("GB")), [{statistic: samples::Statistic::Mean, publish: "sepa_disk_total_capacity"}, {statistic: samples::Statistic::Max, publish: "sepa_disk_total_capacity_max"}, {statistic: samples::Statistic::Min, publish: "sepa_disk_total_capacity_min"}])
    disk_total_capacity: Option(metric::KpiServerPartitionDiskTotalCapacity),
};

pub def relations: Array(r::Relation) = [
    r::relation("sepa__serverpartition_2_rev", domain::endpoint(KpiServerPartition.type, "obj_id"), domain::endpoint(serverpartition_2_kpi::Serverpartition2Kpi.type, "obj_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
