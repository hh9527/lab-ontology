# A small, deliberately incomplete model of real iMaster Cloud knowledge.
# The acceptance contract in docs/DOMAIN.md records what must NOT be inferred
# from these physical relationships until ontology has explicit semantics.

use ontology::ontology as edsl;
use ontology::query as qb;

def yes: Bool = True;
def text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def utc_window_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ge, edsl::FilterOp::Lt];
def canonical_eq_ne_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne];
def device_name_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Contains];
def link_text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Contains];
def text_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def int_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Gt, edsl::FilterOp::Ge, edsl::FilterOp::Lt];
def int_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];
def bool_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne];
def bool_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Bool];
def none_required: Array(Type) = [];
def online_value: edsl::CanonicalValueSpec = { id: "online", label: "Online", wires: [edsl::FilterInput::Text("0"), edsl::FilterInput::Text("online")] };
def offline_value: edsl::CanonicalValueSpec = { id: "offline", label: "Offline", wires: [edsl::FilterInput::Text("1"), edsl::FilterInput::Text("offline")] };
def other_value: edsl::CanonicalValueSpec = { id: "other", label: "Other", wires: [edsl::FilterInput::Text("other")] };
def communication_values: Array(edsl::CanonicalValueSpec) = [online_value, offline_value, other_value];
def storage_normal_value: edsl::CanonicalValueSpec = { id: "normal", label: "Normal", wires: [edsl::FilterInput::Text("1")] };
def storage_running_values: Array(edsl::CanonicalValueSpec) = [storage_normal_value];
def fc_switch_value: edsl::CanonicalValueSpec = { id: "fc_switch_device", label: "FC switch device", wires: [edsl::FilterInput::Text("FCSwitchDevice")] };
def storage_subclass_values: Array(edsl::CanonicalValueSpec) = [
    {id: "enterprise_flash_storage_device", label: "Enterprise flash storage device", wires: [edsl::FilterInput::Text("EnterpriseStorage")]},
    {id: "distributed_storage_device", label: "Distributed storage device", wires: [edsl::FilterInput::Text("FusionStorageDevice")]},
    {id: "lenovo_smis_storage_device", label: "Lenovo SMIS storage device", wires: [edsl::FilterInput::Text("SmisStorageDevice")]},
    {id: "huawei_smis_storage_device", label: "Huawei SMIS storage device", wires: [edsl::FilterInput::Text("HuaweiSmisStorageDevice")]},
    {id: "data_protection_appliance_and_backup_cluster_storage_device", label: "Data protection appliance and backup cluster storage device", wires: [edsl::FilterInput::Text("SYS_ProtectDevice")]},
    {id: "mobile_specification_dsm_and_dfs_storage_device", label: "Mobile specification DSM and DFS storage device", wires: [edsl::FilterInput::Text("DsmStorageDevice")]},
    {id: "hpe_storage_device", label: "HPE storage device", wires: [edsl::FilterInput::Text("HPEStorageDevice")]},
    {id: "vsp_storage_device", label: "VSP storage device", wires: [edsl::FilterInput::Text("VSPStorageDevice")]},
    fc_switch_value,
];
def wac_value: edsl::CanonicalValueSpec = { id: "WAC", label: "Wireless access controller", wires: [edsl::FilterInput::Text("ne.category.ac"), edsl::FilterInput::Text("AC"), edsl::FilterInput::Text("WAC")] };
def lsw_value: edsl::CanonicalValueSpec = { id: "LSW", label: "Network switch", wires: [edsl::FilterInput::Text("ne.category.switch"), edsl::FilterInput::Text("LSW")] };
def router_value: edsl::CanonicalValueSpec = { id: "router", label: "Network router", wires: [edsl::FilterInput::Text("ne.category.router"), edsl::FilterInput::Text("AR")] };
def firewall_value: edsl::CanonicalValueSpec = { id: "firewall", label: "Network firewall", wires: [edsl::FilterInput::Text("ne.category.firewall"), edsl::FilterInput::Text("FW")] };
def ap_value: edsl::CanonicalValueSpec = { id: "AP", label: "Wireless access point", wires: [edsl::FilterInput::Text("ne.category.fatap"), edsl::FilterInput::Text("AP")] };
def device_class_values: Array(edsl::CanonicalValueSpec) = [wac_value, lsw_value, router_value, firewall_value, ap_value];
def huawei_value: edsl::CanonicalValueSpec = { id: "Huawei", label: "Huawei", wires: [edsl::FilterInput::Text("2011"), edsl::FilterInput::Text("Huawei"), edsl::FilterInput::Text("huawei technologies co., ltd")] };
def manufacturer_values: Array(edsl::CanonicalValueSpec) = [huawei_value];
def critical_value: edsl::CanonicalValueSpec = { id: "critical", label: "Critical", wires: [edsl::FilterInput::Text("1")] };
def major_value: edsl::CanonicalValueSpec = { id: "major", label: "Major", wires: [edsl::FilterInput::Text("2")] };
def minor_value: edsl::CanonicalValueSpec = { id: "minor", label: "Minor", wires: [edsl::FilterInput::Text("3")] };
def warning_value: edsl::CanonicalValueSpec = { id: "warning", label: "Warning", wires: [edsl::FilterInput::Text("4")] };
def alarm_severity_values: Array(edsl::CanonicalValueSpec) = [critical_value, major_value, minor_value, warning_value];
def critical_alarm_predicate: edsl::ScopePredicate = {field: "severity", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("critical")};
def major_alarm_predicate: edsl::ScopePredicate = {field: "severity", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("major")};
def uncleared_value: edsl::CanonicalValueSpec = { id: "uncleared", label: "Uncleared", wires: [edsl::FilterInput::Int(0)] };
def cleared_value: edsl::CanonicalValueSpec = { id: "cleared", label: "Cleared", wires: [edsl::FilterInput::Int(1)] };
def alarm_cleared_values: Array(edsl::CanonicalValueSpec) = [uncleared_value, cleared_value];
def alarm_change_values: Array(edsl::CanonicalValueSpec) = [
    {id: "add", label: "Add", wires: [edsl::FilterInput::Int(1)]},
    {id: "update", label: "Update", wires: [edsl::FilterInput::Int(2)]},
    {id: "delete", label: "Delete", wires: [edsl::FilterInput::Int(3)]},
];
def site_online_value: edsl::CanonicalValueSpec = { id: "online", label: "Online site", wires: [edsl::FilterInput::Text("onlineSite")] };
def site_offline_value: edsl::CanonicalValueSpec = { id: "offline", label: "Offline site", wires: [edsl::FilterInput::Text("offlineSite")] };
def site_type_values: Array(edsl::CanonicalValueSpec) = [site_online_value, site_offline_value];
def subrack_value: edsl::CanonicalValueSpec = { id: "subrack", label: "Subrack server", wires: [edsl::FilterInput::Text("ne.category.server.subrack")] };
def kunlun_value: edsl::CanonicalValueSpec = { id: "kunlun", label: "Kunlun server", wires: [edsl::FilterInput::Text("ne.category.server.kunlun")] };
def rack_server_value: edsl::CanonicalValueSpec = { id: "rack", label: "Rack server", wires: [edsl::FilterInput::Text("ne.category.server.rack")] };
def taishan_server_value: edsl::CanonicalValueSpec = { id: "taishan", label: "Taishan server", wires: [edsl::FilterInput::Text("ne.category.server.taishan")] };
def enclosure_value: edsl::CanonicalValueSpec = { id: "enclosure", label: "Enclosure server", wires: [edsl::FilterInput::Text("ne.category.server.enclosure")] };
def server_class_values: Array(edsl::CanonicalValueSpec) = [subrack_value, kunlun_value, rack_server_value, taishan_server_value, enclosure_value];
def manual_link_value: edsl::CanonicalValueSpec = { id: "manual", label: "Manually created", wires: [edsl::FilterInput::Int(99)] };
def link_type_values: Array(edsl::CanonicalValueSpec) = [manual_link_value];
def link_direction_values: Array(edsl::CanonicalValueSpec) = [
    {id: "bidirectional", label: "Bidirectional", wires: [edsl::FilterInput::Text("bidirectional")]},
    {id: "unidirectional", label: "Unidirectional", wires: [edsl::FilterInput::Text("unidirectional")]},
];
def psu_unknown_value: edsl::CanonicalValueSpec = { id: "unknown", label: "Unknown", wires: [edsl::FilterInput::Int(-2)] };
def psu_warning_value: edsl::CanonicalValueSpec = { id: "warning", label: "Warning", wires: [edsl::FilterInput::Int(1)] };
def psu_health_values: Array(edsl::CanonicalValueSpec) = [psu_unknown_value, psu_warning_value];
def fault_value: edsl::CanonicalValueSpec = { id: "fault", label: "Fault", wires: [edsl::FilterInput::Int(2), edsl::FilterInput::Int(3)] };
def physical_link_status_values: Array(edsl::CanonicalValueSpec) = [fault_value];
def frame_normal_value: edsl::CanonicalValueSpec = { id: "normal", label: "Normal", wires: [edsl::FilterInput::Int(3), edsl::FilterInput::Int(11), edsl::FilterInput::Int(13), edsl::FilterInput::Int(15), edsl::FilterInput::Int(16)] };
def frame_error_value: edsl::CanonicalValueSpec = { id: "error", label: "Fault", wires: [edsl::FilterInput::Int(2), edsl::FilterInput::Int(12), edsl::FilterInput::Int(17)] };
def frame_oper_values: Array(edsl::CanonicalValueSpec) = [frame_normal_value, frame_error_value];
def onu_class_value: edsl::CanonicalValueSpec = { id: "onu", label: "ONU", wires: [edsl::FilterInput::Text("ne.category.pon.onu")] };
def gpon_class_value: edsl::CanonicalValueSpec = { id: "spl", label: "GPON", wires: [edsl::FilterInput::Text("ne.category.pon.spl")] };
def pon_class_values: Array(edsl::CanonicalValueSpec) = [onu_class_value, gpon_class_value];
def pon_online_value: edsl::CanonicalValueSpec = { id: "online", label: "Online", wires: [edsl::FilterInput::Text("1")] };
def pon_offline_value: edsl::CanonicalValueSpec = { id: "offline", label: "Offline", wires: [edsl::FilterInput::Text("0"), edsl::FilterInput::Text("2"), edsl::FilterInput::Text("3"), edsl::FilterInput::Text("4"), edsl::FilterInput::Text("14"), edsl::FilterInput::Text("15")] };
def pon_commu_values: Array(edsl::CanonicalValueSpec) = [pon_online_value, pon_offline_value];
def olt_class_value: edsl::CanonicalValueSpec = { id: "olt", label: "OLT", wires: [edsl::FilterInput::Text("ne.category.olt")] };
def olt_class_values: Array(edsl::CanonicalValueSpec) = [olt_class_value];
def event_kind: edsl::DatasetKind = edsl::DatasetKind::Event;
def entity_kind: edsl::DatasetKind = edsl::DatasetKind::Entity;
def metric_kind: edsl::DatasetKind = edsl::DatasetKind::Metric;
def device_grain: Array(String) = ["id", "tenant_id"];
def frame_grain: Array(String) = ["id", "tenant_id"];
def no_time: Option(String) = None;
def alarm_grain: Array(String) = ["csn"];
def alarm_time: Option(String) = Some("occur_utc");
def kpi_grain: Array(String) = ["res_id", "tenant_id", "ts"];
def kpi_time: Option(String) = Some("ts");
def port_grain: Array(String) = ["id"];
def interface_kpi_grain: Array(String) = ["res_id", "tenant_id", "ts"];
def packet_unit: Option(String) = Some("packets/s");
def number_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Number];
def avg_agg: qb::AggregateFunction = qb::AggregateFunction::Avg;
def sum_agg: qb::AggregateFunction = qb::AggregateFunction::Sum;
def percent_unit: Option(String) = Some("%");
def no_unit: Option(String) = None;
def utc_role: edsl::TimeSemantics = edsl::TimeSemantics::Utc;
def local_role: edsl::TimeSemantics = edsl::TimeSemantics::Local;
def utc_seconds: edsl::TimeEncoding = edsl::TimeEncoding::CanonicalUtcSecondText;
def local_text: edsl::TimeEncoding = edsl::TimeEncoding::LocalText;
def local_epoch_millis: edsl::TimeEncoding = edsl::TimeEncoding::LocalEpochMillis;

@edsl::entity_id("device")
@edsl::entity_source("I_EntNetworkElement", "d")
@edsl::dataset(entity_kind, device_grain, no_time)
@edsl::dataset_description("Network device", "Network resource identified within its tenant")
@edsl::relation_description("device_belongs_to_tenant", "Belongs to tenant", "Device tenant identity")
@edsl::relation_alias("device_belongs_to_tenant", "所属租户")
@edsl::localized_relation("device_belongs_to_tenant", "en", "Belongs to tenant", "Device tenant identity")
@edsl::localized_relation("device_belongs_to_tenant", "zh", "所属租户", "设备所属租户的身份")
@edsl::named_relation_key("device_belongs_to_tenant", Tenant.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "tenant_id", to: "id" }))
@edsl::relation_description("device_located_at_site", "Located at site", "Either project or parent subnet identifies the site")
@edsl::named_relation_key("device_located_at_site", Site.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::Or([
        edsl::RelationKey::FieldEq({ from: "project_id", to: "site_id" }),
        edsl::RelationKey::FieldEq({ from: "ref_parent_subnet", to: "site_id" }),
    ]))
type Device = struct {
    @edsl::column("alias")
    @edsl::dimension("device_alias", yes, yes, text_ops, text_inputs)
    alias: String,
    @edsl::column("classification")
    @edsl::dimension("device_class", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(device_class_values)
    classification: String,
    @edsl::column("commu_state")
    @edsl::dimension("device_commu_state", yes, yes, text_ops, text_inputs)
    @edsl::dimension_description("device_commu_state", "Device communication state", "Business communication state; offline includes both legacy and current wire values.")
    @edsl::canonical_values(communication_values)
    commu_state: String,
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::measure("device_count", qb::AggregateFunction::Count, none_required)
    @edsl::dimension("device_id", yes, yes, text_ops, text_inputs)
    id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
    @edsl::column("projectId")
    project_id: String,
    @edsl::column("refParentSubnet")
    ref_parent_subnet: String,
    @edsl::column("name")
    @edsl::dimension("device_name", yes, yes, device_name_ops, text_inputs)
    name: String,
    @edsl::column("createTime")
    @edsl::time_field(local_role, local_epoch_millis)
    @edsl::dimension("device_create_ms", yes, yes, int_ops, int_inputs)
    create_time: Int,
    @edsl::column("mac")
    @edsl::dimension("device_mac", yes, yes, text_ops, text_inputs)
    mac: String,
    @edsl::column("ipAddress")
    @edsl::dimension("device_ip_address", yes, yes,
        [edsl::FilterOp::Eq, edsl::FilterOp::StartsWith], text_inputs)
    ip_address: String,
    @edsl::column("manufacturer")
    @edsl::dimension("device_manufacturer", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(manufacturer_values)
    manufacturer: String,
};

@edsl::entity_id("tenant")
@edsl::entity_source("X_TENANT_VIEW", "t")
@edsl::dataset(entity_kind, ["id"], no_time)
@edsl::dataset_description("Tenant", "Tenant identity, name and local access time")
type Tenant = struct {
    @edsl::column("TENANT_ID")
    @edsl::key(yes)
    @edsl::dimension("tenant_id", yes, yes, text_ops, text_inputs)
    @edsl::measure("tenant_count", qb::AggregateFunction::Count, none_required)
    id: String,
    @edsl::column("TENANT_NAME")
    @edsl::dimension("tenant_name", yes, yes, text_ops, text_inputs)
    name: String,
    @edsl::column("INDUSTRY")
    @edsl::dimension("tenant_industry", yes, yes, text_ops, text_inputs)
    industry: String,
    @edsl::column("TENANT_ACCESS_TIME")
    @edsl::time_field(local_role, local_epoch_millis)
    @edsl::dimension("tenant_access_ms", yes, yes, int_ops, int_inputs)
    access_time: Int,
};

@edsl::entity_id("site")
@edsl::entity_source("X_SITE_VIEW", "s")
@edsl::dataset_description("Site", "Governance site referenced by network devices")
@edsl::relation_description("site_belongs_to_tenant", "Belongs to tenant", "Site and tenant share the tenant identity")
@edsl::named_relation_key("site_belongs_to_tenant", Tenant.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "tenant_id", to: "id" }))
type Site = struct {
    @edsl::column("SITE_ID")
    @edsl::key(yes)
    @edsl::dimension("site_id", yes, yes, text_ops, text_inputs)
    site_id: String,
    @edsl::column("SITE_NAME")
    @edsl::dimension("site_name", yes, yes, text_ops, text_inputs)
    site_name: String,
    @edsl::column("SITE_TYPE")
    @edsl::dimension("site_type", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(site_type_values)
    site_type: String,
    @edsl::column("TENANT_ID")
    tenant_id: String,
};

@edsl::entity_id("port")
@edsl::entity_source("I_EnterpriseNetworkLTP", "p")
@edsl::dataset(entity_kind, port_grain, no_time)
@edsl::dataset_description("Network interface", "Interface owned by a network device")
@edsl::relation_description("port_belongs_to_device", "Belongs to device", "Declared parent device of the interface")
@edsl::named_relation_key("port_belongs_to_device", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({ from: "ref_parent_ne", to: "id" }),
        edsl::RelationKey::FieldEq({ from: "tenant_id", to: "tenant_id" }),
    ]))
type Port = struct {
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::measure("interface_count", qb::AggregateFunction::Count, none_required)
    id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("refParentNE")
    ref_parent_ne: String,
    @edsl::column("name")
    @edsl::dimension("port_name", yes, yes, text_ops, text_inputs)
    name: String,
};

@edsl::entity_id("interface_kpi")
@edsl::entity_source("NetworkDeviceInterfaceKPI", "ik")
@edsl::dataset(metric_kind, interface_kpi_grain, kpi_time)
@edsl::dataset_description("Interface KPI samples", "UTC samples of interface packet rate and output errors")
@edsl::relation_description("interface_kpi_of_port", "Samples for interface", "KPI resource ID identifies its interface")
@edsl::named_relation_key("interface_kpi_of_port", Port.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "res_id", to: "id" }))
type InterfaceKpi = struct {
    @edsl::column("resId")
    res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(utc_role, utc_seconds)
    @edsl::dimension("interface_kpi_ts_raw", yes, yes, utc_window_ops, text_inputs)
    ts: String,
    @edsl::column("ifOutPktSpeed")
    @edsl::dimension("interface_tx_sample", yes, yes, [], number_inputs)
    @edsl::measure("interface_tx", avg_agg, none_required)
    @edsl::metric_value("interface_tx", avg_agg, packet_unit)
    tx_speed: Float,
    @edsl::column("ifOutErrors")
    @edsl::dimension("interface_out_errors_sample", yes, yes, int_ops, int_inputs)
    @edsl::measure("interface_out_errors", avg_agg, none_required)
    out_errors: Int,
};

# IC publishes these entity/contains relationships but has no connected
# production SQL mapping for PhysicalServer yet. These are pressure fixtures.
@edsl::entity_id("server_device")
@edsl::entity_source("PhysicalServer", "sv")
@edsl::dataset(entity_kind, ["id", "tenant_id"], no_time)
@edsl::dataset_description("Physical server", "Server identity and site/tenant ownership")
@edsl::relation_description("server_located_at_site", "Located at site", "Parent subnet or project identifies the site")
@edsl::named_relation_key("server_located_at_site", Site.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::Or([
        edsl::RelationKey::FieldEq({ from: "ref_parent_subnet", to: "site_id" }),
        edsl::RelationKey::FieldEq({ from: "project_id", to: "site_id" }),
    ]))
@edsl::relation_description("server_belongs_to_tenant", "Belongs to tenant", "Server tenant identity")
@edsl::named_relation_key("server_belongs_to_tenant", Tenant.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "tenant_id", to: "id" }))
type ServerDevice = struct {
    @edsl::column("id")
    @edsl::key(yes)
    id: String,
    @edsl::column("name")
    @edsl::dimension("server_name", yes, yes, text_ops, text_inputs)
    name: String,
    @edsl::column("assetNumber")
    @edsl::dimension("server_asset_number", yes, yes, text_ops, text_inputs)
    asset_number: String,
    @edsl::column("ipAddress")
    @edsl::dimension("server_ip_address", yes, yes, text_ops, text_inputs)
    ip_address: String,
    @edsl::column("oriResId")
    ori_res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("refParentSubnet")
    ref_parent_subnet: String,
    @edsl::column("projectId")
    project_id: String,
    @edsl::column("classification")
    @edsl::dimension("server_class", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(server_class_values)
    classification: String,
    @edsl::column("manufacturer")
    @edsl::dimension("server_manufacturer", yes, yes, text_ops, text_inputs)
    manufacturer: String,
};

@edsl::entity_id("server_fan")
@edsl::entity_source("PhysicalServerFan", "sf")
@edsl::dataset(entity_kind, ["id"], no_time)
@edsl::dataset_description("Server fan", "Physical fan identity, not its display name")
@edsl::relation_description("fan_parent_server", "Contained by server", "Parent resource and matching tenant identify the server container")
@edsl::named_relation_key("fan_parent_server", ServerDevice.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({ from: "parent_res_id", to: "ori_res_id" }),
        edsl::RelationKey::FieldEq({ from: "tenant_id", to: "tenant_id" }),
    ]))
@edsl::relation_description("fan_belongs_to_tenant", "Belongs to tenant", "Fan tenant identity")
@edsl::named_relation_key("fan_belongs_to_tenant", Tenant.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "tenant_id", to: "id" }))
type ServerFan = struct {
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::measure("server_fan_count", qb::AggregateFunction::Count, none_required)
    @edsl::dimension("server_fan_id", yes, yes, text_ops, text_inputs)
    id: String,
    @edsl::column("name")
    @edsl::dimension("server_fan_name", yes, yes, text_ops, text_inputs)
    name: String,
    @edsl::column("parentResId")
    parent_res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("manufacturer")
    @edsl::dimension("server_fan_manufacturer", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(manufacturer_values)
    manufacturer: String,
};

@edsl::entity_id("server_psu")
@edsl::entity_source("PhysicalServerPSU", "psu")
@edsl::dataset(entity_kind, ["id", "tenant_id"], no_time)
@edsl::dataset_description("Server power supply", "Power supply identity and owning tenant")
@edsl::relation_description("psu_parent_server", "Contained by server", "Parent resource and matching tenant identify the server container")
@edsl::named_relation_key("psu_parent_server", ServerDevice.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({ from: "parent_res_id", to: "ori_res_id" }),
        edsl::RelationKey::FieldEq({ from: "tenant_id", to: "tenant_id" }),
    ]))
@edsl::relation_description("psu_belongs_to_tenant", "Belongs to tenant", "Power supply tenant identity")
@edsl::named_relation_key("psu_belongs_to_tenant", Tenant.type, edsl::RelationKind::Safe,
