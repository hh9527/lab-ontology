pub def component_alarm_named_graph: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph", "root":"component", "nodes":[{"id":"component","entity":"components"}],
        "edges":[], "select":[], "count":"component",
        "exists":[{"anchor":"component","nodes":[{"id":"site","entity":"sites"},{"id":"alarm","entity":"alarms"}],
            "edges":[{"relation":"component_site","from":"component","to":"site"},
                     {"relation":"site_alarms","from":"site","to":"alarm"}],
            "filters":[{"node":"alarm","dimension":"AlarmLevel","op":"Eq","value":2}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "count(component.id)")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM sites AS site INNER JOIN alarms AS alarm")
        && string::contains(sq.sql, "alarm.level = ?1")
        && string::contains(pg.sql, "INNER JOIN \"alarms\" AS \"alarm\"")
        && sq.bindings == [qb::Val::Int(2)] && pg.bindings == sq.bindings {
        True
    } else { fail!("component/alarm graph lost correlation or binding", sq, pg) }
});

pub def component_alarm_rejects_undeclared_edge: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph", "root":"component", "nodes":[{"id":"component","entity":"components"}],
        "edges":[], "select":[], "count":"component",
        "exists":[{"anchor":"component","nodes":[{"id":"alarm","entity":"alarms"}],
            "edges":[{"relation":"component_alarms","from":"component","to":"alarm"}]}]
    }"#).unwrap!())
}, "unknown named relation");

pub def backend_is_bound_at_factory_creation: test::Test = test::should_ok(fn() {
    let input = json::parse(r#"{
        "op":"Graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"alarms"}],
        "edges":[], "select":[{"node":"alarm","dimension":"AlarmLevel"}],
        "filters":[{"node":"alarm","dimension":"AlarmLevel","op":"Eq","value":42}]
    }"#).unwrap!();
    let sq = query_intent_lower_factory(payload, sqlite::build_query)(input);
    let pg = query_intent_lower_factory(payload, postgres::build_query)(input);
    if sq.bindings == [qb::Val::Int(42)] && pg.bindings == sq.bindings
        && string::contains(sq.sql, "?1") && string::contains(pg.sql, "$1") {
        True
    } else { fail!("backend selection changed graph lowering or bindings", sq, pg) }
});

def batch_field: Fn(Value, String) -> Value = fn(value, key) {
    match value {
        Value::Object(obj) => match dict::get(obj, key) {
            Some(found) => found,
            None => fail!("batch response omitted a field", key),
        },
        _ => fail!("batch response is not an object", value),
    }
};

pub def batch_single_query_matches_direct_lowering: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"Graph","root":"order","nodes":[{"id":"order","entity":"orders"}],
        "edges":[],"select":[{"node":"order","dimension":"OrderId"}],
        "filters":[{"node":"order","dimension":"OrderRegion","op":"Eq","value":"east"}]}"#).unwrap!();
    let direct = query_intent_lower_factory(payload, sqlite::build_query)(intent);
    let result = query_request_method_factory(payload, sqlite::build_query)(
        Value::Object({"intents": Value::Array([intent])}));
    let queries = match batch_field(result, "queries") {
        Value::Array(items) => items,
        other => fail!("valid batch omitted queries", other),
    };
    if batch_field(result, "accepted") == Value::True
        && batch_field(result, "diagnostics") == Value::Array([])
        && array::length(queries) == 1
        && queries[0] == codec::encode(direct) { True }
    else { fail!("single batch query differs from direct lowering", result, direct) }
});

pub def batch_queries_keep_order_and_independent_bindings: test::Test = test::should_ok(fn() {
    let result = query_request_method_factory(payload, sqlite::build_query)(json::parse(r#"{
        "intents":[
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[{"node":"a","dimension":"OrderId"}],
             "filters":[{"node":"a","dimension":"OrderRegion","op":"Eq","value":"east"}]},
            {"op":"Graph","root":"b","nodes":[{"id":"b","entity":"orders"}],"edges":[],
             "select":[{"node":"b","dimension":"OrderId"}],
             "filters":[{"node":"b","dimension":"OrderRegion","op":"Eq","value":"west"}]}
        ]
    }"#).unwrap!());
    let queries = match batch_field(result, "queries") {
        Value::Array(items) => items,
        other => fail!("valid batch omitted queries", other),
    };
    if batch_field(result, "accepted") == Value::True && array::length(queries) == 2
        && batch_field(queries[0], "bindings") == Value::Array([Value::String("east")])
        && batch_field(queries[1], "bindings") == Value::Array([Value::String("west")])
        && string::contains(json::stringify(queries[0]), "?1")
        && string::contains(json::stringify(queries[1]), "?1") { True }
    else { fail!("batch queries lost order or independent bindings", result) }
});

pub def batch_keeps_success_warnings_at_top_level: test::Test = test::should_ok(fn() {
    let result = query_request_method_factory(payload, fn(ast) {
        let notice: Option(Int) = warn!("review this aggregate grain");
        sqlite::build_query(ast)
    })(json::parse(r#"{"intents":[
        {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],
         "edges":[],"select":[{"node":"a","dimension":"OrderId"}]},
        {"op":"Graph","root":"b","nodes":[{"id":"b","entity":"orders"}],
         "edges":[],"select":[{"node":"b","dimension":"OrderId"}]}
    ]}"#).unwrap!());
    let reports = match batch_field(result, "diagnostics") {
        Value::Array(items) => items,
        other => fail!("successful batch omitted warnings", other),
    };
    let warning = batch_field(reports[0], "diagnostic");
    let locations = match batch_field(warning, "locs") {
        Value::Array(items) => items,
        other => fail!("warning omitted ordered locations", other),
    };
    if batch_field(result, "accepted") == Value::True
        && array::length(reports) == 2
        && batch_field(reports[0], "index") == Value::Int(0)
        && batch_field(reports[1], "index") == Value::Int(1)
        && batch_field(warning, "severity") == Value::String("Warning")
        && batch_field(warning, "message") == Value::String("review this aggregate grain")
        && array::length(locations) == 1
        && match warning {
            Value::Object(obj) => dict::get(obj, "labels") == None && dict::get(obj, "notes") == None,
            _ => False,
        } {
        True
    } else { fail!("batch lost indexed success warnings", result) }
});

pub def batch_collects_multiple_failures_without_partial_queries: test::Test = test::should_ok(fn() {
    let result = query_request_method_factory(payload, sqlite::build_query)(json::parse(r#"{
        "intents":[
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[{"node":"a","dimension":"OrderId"}]},
            {"op":"Graph","root":"bad","nodes":[{"id":"bad","entity":"missing_entity"}],"edges":[],
             "select":[{"node":"bad","dimension":"OrderId"}]},
            {"op":"Graph","root":"b","nodes":[{"id":"b","entity":"orders"}],"edges":[],
             "select":[{"node":"b","dimension":"OrderId"}]},
            {"op":"Graph","root":"c","nodes":[{"id":"c","entity":"orders"},{"id":"d","entity":"customers"}],
             "edges":[{"relation":"missing_relation","from":"c","to":"d"}],
             "select":[{"node":"c","dimension":"OrderId"}]}
        ]
    }"#).unwrap!());
    let reports = match batch_field(result, "diagnostics") {
        Value::Array(items) => items,
        other => fail!("failed batch omitted diagnostics", other),
    };
    if batch_field(result, "accepted") == Value::False && batch_field(result, "queries") == Value::None
        && array::length(reports) == 2
        && batch_field(reports[0], "index") == Value::Int(1)
        && batch_field(reports[1], "index") == Value::Int(3)
        && string::contains(json::stringify(batch_field(reports[0], "diagnostic")), "missing_entity")
        && string::contains(json::stringify(batch_field(reports[1], "diagnostic")), "missing_relation") { True }
    else { fail!("batch did not retain both indexed diagnostics", result) }
});

pub def batch_diagnostics_name_offending_ids: test::Test = test::should_ok(fn() {
    let result = query_request_method_factory(payload, sqlite::build_query)(json::parse(r#"{
        "intents":[
            {"root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],"select":[]},
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[{"node":"a","dimension":"MissingDimension"}]},
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[],"measures":[{"node":"a","measure":"MissingMeasure"}]}
        ]
    }"#).unwrap!());
    let reports = match batch_field(result, "diagnostics") {
        Value::Array(items) => items,
        other => fail!("failed batch omitted diagnostics", other),
    };
    if batch_field(result, "accepted") == Value::False
        && array::length(reports) == 3
        && string::contains(json::stringify(batch_field(reports[0], "diagnostic")), "intent field is missing: op")
        && string::contains(json::stringify(batch_field(reports[1], "diagnostic")), "MissingDimension")
        && string::contains(json::stringify(batch_field(reports[2], "diagnostic")), "MissingMeasure") {
        True
    } else { fail!("diagnostics omitted the IDs needed to repair each intent", result) }
});

pub def batch_parser_diagnostics_offer_local_repairs: test::Test = test::should_ok(fn() {
    let result = query_request_method_factory(payload, sqlite::build_query)(json::parse(r#"{
        "intents":[
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[],"count":"a","bogus_key":true},
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[],"count":"a","filters":[{"node":"a","dimension":"OrderRegion","op":"Eq","value":"east","foo":1}]},
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[{"node":"a"}]},
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[],"count":"a","filters":[{"node":"a","dimension":"OrderRegion","op":"eq","value":"east"}]},
            {"op":"Graph","root":"a","nodes":[{"id":"a","entity":"orders"}],"edges":[],
             "select":[],"count":"a","filters":[{"node":"a","dimension":"OrderRegion","op":"Eq","kind":"weird","value":"east"}]}
        ]
    }"#).unwrap!());
    let reports = match batch_field(result, "diagnostics") {
        Value::Array(items) => items,
        other => fail!("parser batch omitted diagnostics", other),
    };
    if batch_field(result, "accepted") == Value::False
        && array::length(reports) == 5
        && string::contains(json::stringify(batch_field(reports[0], "diagnostic")), "$.bogus_key: unknown field; see info key")
        && string::contains(json::stringify(batch_field(reports[1], "diagnostic")), "$.foo: unknown field; see info key")
        && string::contains(json::stringify(batch_field(reports[2], "diagnostic")), "$[0].dimension: missing required field; see info key")
        && string::contains(json::stringify(batch_field(reports[3], "diagnostic")), "unsupported filter operator eq; see info key")
        && string::contains(json::stringify(batch_field(reports[4], "diagnostic")), "$.kind: unknown field; see info key")
        && !string::contains(json::stringify(Value::Array(reports)), "allowed keys:")
        && !string::contains(json::stringify(Value::Array(reports)), "allowed operators:") {
        True
    } else { fail!("parser diagnostics did not name local fixes", result) }
});

pub def codec_partial_inputs_preserve_input_locations: test::Test =
    test::with_fixtures(["../fixtures/codec-partial-filter.json"], fn(input) { test::should_ok(fn() {
    let result = query_request_method_factory(payload, sqlite::build_query)(input);
    let reports = match batch_field(result, "diagnostics") {
        Value::Array(items) => items,
        other => fail!("partial filter decoding returned no diagnostics", other),
    };
    let first = codec::decode@[diagnostics::Diagnostic](batch_field(reports[0], "diagnostic")).unwrap!();
    let second = codec::decode@[diagnostics::Diagnostic](batch_field(reports[1], "diagnostic")).unwrap!();
    let third = codec::decode@[diagnostics::Diagnostic](batch_field(reports[2], "diagnostic")).unwrap!();
    let fourth = codec::decode@[diagnostics::Diagnostic](batch_field(reports[3], "diagnostic")).unwrap!();
    let fifth = codec::decode@[diagnostics::Diagnostic](batch_field(reports[4], "diagnostic")).unwrap!();
    let has_input = fn(report: diagnostics::Diagnostic, line: Int) {
        array::any(report.locs, fn(loc) {
            string::contains(loc.source, "@test-ctx/")
                && loc.start.line == line && loc.start.offset < loc.end.offset
        })
    };
    if batch_field(result, "accepted") == Value::False && array::length(reports) == 5
        && has_input(first, 6) && has_input(second, 11)
        && has_input(third, 16) && has_input(fourth, 21) && has_input(fifth, 24)
        && string::contains(first.message, "$.op: expected String; see info key")
        && string::contains(second.message, "OrderRegion")
        && string::contains(third.message, "OrderRegion")
        && string::contains(fourth.message, "OrderCount")
        && string::contains(fifth.message, "$.entity: missing required field; see info key") { True }
    else { fail!("two-stage parsing lost an invalid input location", result) }
}) });

pub def batch_rejects_empty_and_over_limit: test::Test = test::should_ok(fn() {
    let lower = query_request_method_factory(payload, sqlite::build_query);
    let empty = diagnostics::with_diagnostics(lower)(json::parse(r#"{"intents":[]}"#).unwrap!());
    let too_many = diagnostics::with_diagnostics(lower)(json::parse(r#"{"intents":[{},{},{},{},{},{}]}"#).unwrap!());
    match (empty, too_many) {
        (Err(a), Err(b)) => if array::length(a) > 0 && array::length(b) > 0 { True }
            else { fail!("batch bounds produced no diagnostics") },
        _ => fail!("batch bounds were accepted"),
    }
});

pub def raw_global_take_uses_bound_limit_and_identity_tie_breaker: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"alarms"}],
        "edges":[], "select":[{"node":"alarm","dimension":"AlarmLevel"}],
        "order_by":[{"node":"alarm","dimension":"AlarmLevel","direction":"Desc"}],
        "take":2
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "ORDER BY alarm.level DESC, alarm.id ASC")
        && string::contains(sq.sql, "LIMIT ?1")
        && string::contains(pg.sql, "\"alarm\".\"id\" ASC")
        && string::contains(pg.sql, "LIMIT $1")
        && sq.bindings == [qb::Val::Int(2)] && pg.bindings == sq.bindings { True }
    else { fail!("raw take lost bound or common ordering semantics", sq, pg) }
});

pub def raw_global_take_requires_order: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"alarms"}],
        "edges":[], "select":[{"node":"alarm","dimension":"AlarmLevel"}], "take":2
    }"#).unwrap!())
}, "graph raw take requires ordered raw rows");

pub def legacy_op_is_rejected: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"list", "measures":[], "dimensions":["ComponentId"], "filters":[]
    }"#).unwrap!())
}, "unsupported intent op list; use Graph, GraphPair or GraphUnion with named nodes and relations");

pub def lowercase_graph_op_is_rejected: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"graph","root":"a","nodes":[{"id":"a","entity":"orders"}],
        "edges":[],"select":[],"count":"a"
    }"#).unwrap!())
}, "unsupported intent op graph; use Graph, GraphPair or GraphUnion with named nodes and relations");

pub def graph_union_uses_one_query_and_shared_bindings: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"GraphUnion","branches":[
            {"result_node":"first","graph":{"op":"Graph","root":"first",
                "nodes":[{"id":"first","entity":"orders"}],"edges":[],
                "select":[{"node":"first","dimension":"OrderId"},{"node":"first","dimension":"OrderRegion"}],
                "filters":[{"node":"first","dimension":"OrderRegion","op":"Eq","value":"east"}]}},
            {"result_node":"second","graph":{"op":"Graph","root":"second",
                "nodes":[{"id":"second","entity":"orders"}],"edges":[],
                "select":[{"node":"second","dimension":"OrderId"},{"node":"second","dimension":"OrderRegion"}],
                "filters":[{"node":"second","dimension":"OrderRegion","op":"Eq","value":"west"}]}}
        ]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, " UNION ") && string::contains(pg.sql, " UNION ")
        && string::contains(sq.sql, "?1") && string::contains(sq.sql, "?2")
        && string::contains(pg.sql, "$1") && string::contains(pg.sql, "$2")
        && sq.bindings == [qb::Val::String("east"), qb::Val::String("west")]
        && pg.bindings == sq.bindings { True }
    else { fail!("graph union lost a branch or its parameter bindings", sq, pg) }
});

pub def graph_union_requires_complete_identity: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"GraphUnion","branches":[
            {"result_node":"a","graph":{"op":"Graph","root":"a",
                "nodes":[{"id":"a","entity":"orders"}],"edges":[],
                "select":[{"node":"a","dimension":"OrderRegion"}]}},
            {"result_node":"b","graph":{"op":"Graph","root":"b",
                "nodes":[{"id":"b","entity":"orders"}],"edges":[],
                "select":[{"node":"b","dimension":"OrderRegion"}]}}
        ]
    }"#).unwrap!())
}, "graph union branch must project every field of its complete result identity");

pub def graph_union_rejects_mismatched_result_shape: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"GraphUnion","branches":[
            {"result_node":"a","graph":{"op":"Graph","root":"a",
                "nodes":[{"id":"a","entity":"orders"}],"edges":[],
                "select":[{"node":"a","dimension":"OrderId"},{"node":"a","dimension":"OrderRegion"}]}},
            {"result_node":"b","graph":{"op":"Graph","root":"b",
                "nodes":[{"id":"b","entity":"orders"}],"edges":[],
                "select":[{"node":"b","dimension":"OrderId"}]}}
        ]
    }"#).unwrap!())
}, "graph union branch 2 must select the same result dimensions in the same order as branch 1");

pub def graph_union_accepts_three_branches_in_both_dialects: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"GraphUnion","branches":[
            {"result_node":"a","graph":{"op":"Graph","root":"a",
                "nodes":[{"id":"a","entity":"orders"}],"edges":[],
                "select":[{"node":"a","dimension":"OrderId"}],
                "filters":[{"node":"a","dimension":"OrderRegion","op":"Eq","value":"east"}]}},
            {"result_node":"b","graph":{"op":"Graph","root":"b",
                "nodes":[{"id":"b","entity":"orders"}],"edges":[],
                "select":[{"node":"b","dimension":"OrderId"}],
                "filters":[{"node":"b","dimension":"OrderRegion","op":"Eq","value":"west"}]}},
            {"result_node":"c","graph":{"op":"Graph","root":"c",
                "nodes":[{"id":"c","entity":"orders"}],"edges":[],
                "select":[{"node":"c","dimension":"OrderId"}],
                "filters":[{"node":"c","dimension":"OrderRegion","op":"Eq","value":"north"}]}}
        ]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    let counted = match ast.plan {
        qb::QueryPlan::SetRows(set) => qb::finish(ast.ctx, qb::QueryPlan::SetCount(set)),
        _ => fail!("three-way union did not produce a set plan"),
    };
    let sq_count = sqlite::build_query(counted);
    let pg_count = postgres::build_query(counted);
    if string::contains(sq.sql, " UNION ") && string::contains(pg.sql, " UNION ")
        && string::contains(sq.sql, "?3") && string::contains(pg.sql, "$3")
        && sq.bindings == [qb::Val::String("east"), qb::Val::String("west"), qb::Val::String("north")]
        && pg.bindings == sq.bindings
        && string::contains(sq_count.sql, "SELECT count(1) FROM (")
        && string::contains(pg_count.sql, "SELECT count(1) FROM (")
        && string::contains(sq_count.sql, "?3") && string::contains(pg_count.sql, "$3")
        && sq_count.bindings == sq.bindings && pg_count.bindings == pg.bindings { True }
    else { fail!("three-way union or set count lost a branch or its binding", sq, pg, sq_count, pg_count) }
});

pub def graph_union_diagnoses_third_branch_shape: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"GraphUnion","branches":[
            {"result_node":"a","graph":{"op":"Graph","root":"a",
                "nodes":[{"id":"a","entity":"orders"}],"edges":[],
                "select":[{"node":"a","dimension":"OrderId"}]}},
            {"result_node":"b","graph":{"op":"Graph","root":"b",
                "nodes":[{"id":"b","entity":"orders"}],"edges":[],
                "select":[{"node":"b","dimension":"OrderId"}]}},
            {"result_node":"c","graph":{"op":"Graph","root":"c",
                "nodes":[{"id":"c","entity":"orders"}],"edges":[],
                "select":[{"node":"c","dimension":"OrderId"},{"node":"c","dimension":"OrderRegion"}]}}
        ]
    }"#).unwrap!())
}, "graph union branch 3 must select the same result dimensions in the same order as branch 1");

pub def graph_union_does_not_bypass_branch_relation_validation: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"GraphUnion","branches":[
            {"result_node":"a","graph":{"op":"Graph","root":"a",
                "nodes":[{"id":"a","entity":"orders"}],"edges":[],
                "select":[{"node":"a","dimension":"OrderId"}]}},
            {"result_node":"b","graph":{"op":"Graph","root":"b",
                "nodes":[{"id":"b","entity":"orders"},{"id":"customer","entity":"customers"}],
                "edges":[{"relation":"undeclared_relation","from":"b","to":"customer"}],
                "select":[{"node":"b","dimension":"OrderId"}]}}
        ]
    }"#).unwrap!())
}, "unknown named relation");

@edsl::value_type("OrderedSeverity", Int.type, ordered_values)
@edsl::canonical_order(["urgent", "urgent"])
type OrderedSeverityValueType = struct {};
