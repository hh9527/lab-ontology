# RFC 0002 阶段 B：封闭表达式、可复用模板和显式绑定。
use crate::experimental::model as model;
use crate::experimental::quantity as quantity;
use crate::query as qb;
use std::array as array;
use std::type_desc as td;

type Column = struct { name: String, value: Type, nullable: Bool };
type RateInputs = struct { amount: Node, duration: Node };
type IdentityInput = struct { column: Column, parts: Array(Column) };
type Node = enum {
    Column(Column),
    Seconds(Node),
    Rate(RateInputs),
    Identity(IdentityInput),
};
type Shape = struct { value: Type, nullable: Bool };
type Expr(Row, Value) = struct { row: Type, value: Type, nullable: Bool, node: Node };

def column_shape: Fn(Type, Column) -> Shape = fn(row, column) {
    let actual = match array::find(td::fields(row), fn(field) { field.name == column.name }) {
        Some(field) => field.ty, None => fail!("group input field does not exist", column.name),
    };
    let valid = if column.nullable {
        let variants = td::variants(actual);
        array::length(variants) == 2
            && array::any(variants, fn(v) { v.name == "None" && v.payload == None })
            && array::any(variants, fn(v) { v.name == "Some" && v.payload == Some(column.value) })
    } else { actual == column.value };
    if !valid { fail!("group input field has incompatible type", column.name) }
    else { {value: column.value, nullable: column.nullable} }
};
def shape: Fn(Type, Node) -> Shape = fn(row, node) {
    match node {
        Node::Column(column) => column_shape(row, column),
        Node::Seconds(input) => {
            let source = shape(row, input);
            if source.value != quantity::Milliseconds.type { fail!("seconds conversion requires milliseconds", source.value) }
            else { {value: quantity::Seconds.type, nullable: source.nullable} }
        },
        Node::Rate(inputs) => {
            let amount = shape(row, inputs.amount);
            let duration = shape(row, inputs.duration);
            if amount.value != quantity::Bytes.type || duration.value != quantity::Seconds.type {
                fail!("rate expression requires bytes and seconds", amount.value, duration.value)
            } else { {value: quantity::BytesPerSecond.type, nullable: True} }
        },
        Node::Identity(input) => {
            let value = column_shape(row, input.column);
            array::map(input.parts, fn(part) { column_shape(row, part) });
            if array::length(input.parts) == 0 || !array::any(input.parts, fn(part) { part == input.column }) {
                fail!("identity dimension must include its complete role", input.column.name)
            } else { {value: value.value, nullable: array::any(input.parts, fn(part) { part.nullable })} }
        },
    }
};
def checked: for(Row, Value) Fn(Expr(Row, Value)) -> Expr(Row, Value) = fn(expr) {
    let actual = shape(Row.type, expr.node);
    if expr.row != Row.type || expr.value != Value.type || actual.value != Value.type || actual.nullable != expr.nullable {
        fail!("group expression witness does not match its type", expr.value)
    } else { expr }
};
def input: for(Row, Value) Fn(model::Field(Row, Value)) -> Expr(Row, Value) = fn(field) {
    if field.owner != Row.type || field.value != Value.type { fail!("group input witness does not match its type", field.name) }
    else {
        let verified = if field.nullable { model::optional_field(Row.type, Value.type, field.name) }
            else { model::field(Row.type, Value.type, field.name) };
        checked({row: Row.type, value: Value.type, nullable: verified.nullable,
            node: Node::Column({name: verified.name, value: Value.type, nullable: verified.nullable})})
    }
};
def seconds: for(Row) Fn(Expr(Row, quantity::Milliseconds)) -> Expr(Row, quantity::Seconds) = fn(source) {
    let valid = checked(source);
    {row: Row.type, value: quantity::Seconds.type, nullable: valid.nullable, node: Node::Seconds(valid.node)}
};
def rate: for(Row) Fn(Expr(Row, quantity::Bytes), Expr(Row, quantity::Seconds)) -> Expr(Row, quantity::BytesPerSecond) = fn(amount, duration) {
    {row: Row.type, value: quantity::BytesPerSecond.type, nullable: True,
        node: Node::Rate({amount: checked(amount).node, duration: checked(duration).node})}
};

type Filter = enum { Eq, Contains };
type DimensionPolicy = struct { projectable: Bool, filters: Array(Filter) };
type MemberKind = enum { Dimension(DimensionPolicy), Transfer(TransferMember) };
type BindingContract = enum { Dimension, Transfer(MeasureGroup), Identity(model::PreparedRole) };
type DimensionGroup(Value) = struct { id: String, value: Type, projectable: Bool, filters: Array(Filter) };
def dimension_group: for(Value) Fn(String, TypeOf(Value), Bool, Array(Filter)) -> DimensionGroup(Value) = fn(id, value, projectable, filters) {
    if id == "" { fail!("group id must be nonempty", id) }
    else { {id, value, projectable, filters} }
};
type Member = struct {
    group: String, local: String, id: String, node: Node, value: Type, nullable: Bool,
    aggregate: Option(qb::AggregateFunction), projectable: Bool, filters: Array(Filter),
    kind: MemberKind,
};
type Binding(Row) = struct { row: Type, dataset: String, source: String, contract: BindingContract, members: Array(Member) };
type BindingFacts = struct { row: Type, dataset: String, source: String, contract: BindingContract, members: Array(Member) };
def binding_facts: for(Row) Fn(Binding(Row)) -> BindingFacts = fn(binding) {
    {row: binding.row, dataset: binding.dataset, source: binding.source, contract: binding.contract, members: binding.members}
};
def binding_roles: Fn(BindingFacts) -> Array(model::PreparedRole) = fn(binding) {
    match binding.contract { BindingContract::Identity(role) => [role], _ => [] }
};
def dimension: for(Row, Value) Fn(model::Dataset(Row), DimensionGroup(Value), Expr(Row, Value), String, Bool, Array(Filter)) -> Binding(Row) = fn(dataset, group, source, publish, projectable, filters) {
    model::prepare(dataset, []);
    let valid = checked(source);
    if group.id == "" || group.value != Value.type { fail!("dimension group witness does not match its type", group.id) }
    else if (projectable && !group.projectable) || !array::all(filters, fn(op) { array::any(group.filters, fn(allowed) { allowed == op }) }) {
        fail!("dimension binding cannot expand group capabilities", publish)
    } else {
        {row: Row.type, dataset: dataset.id, source: dataset.source, contract: BindingContract::Dimension, members: [{group: group.id, local: "value", id: publish,
            node: valid.node, value: valid.value, nullable: valid.nullable,
            aggregate: None, projectable, filters, kind: MemberKind::Dimension({projectable: group.projectable, filters: group.filters})}]}
    }
};

# 先实验有明确输入签名的流量模板；绑定没有修改聚合算子的入口。
type TransferMember = enum { AmountTotal, RatePeak, RateMean };
type MeasureGroup = struct { id: String, members: Array(TransferMember) };
def transfer: MeasureGroup = {id: "transfer", members: [TransferMember::AmountTotal, TransferMember::RatePeak, TransferMember::RateMean]};
type Rename = struct { member: TransferMember, publish: String };
type Recipe = struct { local: String, node: Node, value: Type, function: qb::AggregateFunction };
def transfer_binding: for(Row) Fn(model::Dataset(Row), MeasureGroup, Expr(Row, quantity::Bytes), Expr(Row, quantity::Seconds), Array(Rename)) -> Binding(Row) = fn(dataset, group, amount, elapsed, names) {
    model::prepare(dataset, []);
    let quantity = checked(amount);
    let speed = rate(quantity, elapsed);
    if group.id == "" || array::length(group.members) == 0 { fail!("measure group must declare members", group.id) }
    else if array::length(names) != array::length(group.members)
        || !array::all(group.members, fn(member) {
            array::length(array::filter(group.members, fn(other) { other == member })) == 1
                && array::length(array::filter(names, fn(name) { name.member == member })) == 1
        }) { fail!("measure binding must name every member exactly once", group.id) }
    else {
        let members = array::map(group.members, fn(member) {
            let name = match array::find(names, fn(name) { name.member == member }) {
                Some(value) => value, None => fail!("measure binding is missing a member", group.id),
            };
            let recipe: Recipe = match member {
                TransferMember::AmountTotal => {local: "amount_total", node: quantity.node, value: quantity.value, function: qb::AggregateFunction::Sum},
                TransferMember::RatePeak => {local: "rate_peak", node: speed.node, value: speed.value, function: qb::AggregateFunction::Max},
                TransferMember::RateMean => {local: "rate_mean", node: speed.node, value: speed.value, function: qb::AggregateFunction::Avg},
            };
            {group: group.id, local: recipe.local, id: name.publish, node: recipe.node,
                value: recipe.value, nullable: True, aggregate: Some(recipe.function), projectable: True, filters: [], kind: MemberKind::Transfer(member)}.ty!(Member)
        });
        {row: Row.type, dataset: dataset.id, source: dataset.source, contract: BindingContract::Transfer(group), members}
    }
};

type IdentityName = struct { member: String, publish: String };
def identity_dimensions: for(Row) Fn(model::Dataset(Row), model::Role(Row), Array(IdentityName)) -> Binding(Row) = fn(dataset, role, names) {
    let verified = model::prepare(dataset, [role]);
    if array::length(names) != array::length(role.parts) || !array::all(role.parts, fn(part) {
        array::length(array::filter(names, fn(name) { name.member == part.target })) == 1
    }) { fail!("identity dimensions must publish the complete identity", role.id) }
    else {
        let parts = array::map(role.parts, fn(part) { {name: part.source, value: part.value, nullable: part.nullable}.ty!(Column) });
        let members = array::map(role.parts, fn(part) {
            let name = match array::find(names, fn(name) { name.member == part.target }) {
                Some(value) => value, None => fail!("identity dimension name is missing", part.target),
            };
            {group: `identity_\{role.entity}`, local: part.target, id: name.publish,
                node: Node::Identity({column: {name: part.source, value: part.value, nullable: part.nullable}, parts}),
                value: part.value, nullable: array::any(parts, fn(part) { part.nullable }),
                aggregate: None, projectable: True, filters: [Filter::Eq],
                kind: MemberKind::Dimension({projectable: True, filters: [Filter::Eq]})}.ty!(Member)
        });
        {row: Row.type, dataset: dataset.id, source: dataset.source, contract: BindingContract::Identity(verified.roles[0]), members}
    }
};

def validate_member_contract: Fn(Member) -> () = fn(member) {
    match member.kind {
        MemberKind::Dimension(policy) => {
            if member.aggregate != None || (member.projectable && !policy.projectable)
                || !array::all(member.filters, fn(op) { array::any(policy.filters, fn(allowed) { allowed == op }) }) {
                fail!("dimension binding cannot expand group capabilities", member.id)
            } else { () }
        },
        MemberKind::Transfer(recipe) => {
            let valid = match recipe {
                TransferMember::AmountTotal => member.local == "amount_total" && member.aggregate == Some(qb::AggregateFunction::Sum) && member.value == quantity::Bytes.type,
                TransferMember::RatePeak => member.local == "rate_peak" && member.aggregate == Some(qb::AggregateFunction::Max) && member.value == quantity::BytesPerSecond.type,
                TransferMember::RateMean => member.local == "rate_mean" && member.aggregate == Some(qb::AggregateFunction::Avg) && member.value == quantity::BytesPerSecond.type,
            };
            let rate_node = match member.node { Node::Rate(_) => True, _ => False };
            if !valid
                || (recipe != TransferMember::AmountTotal && !rate_node) {
                fail!("measure binding cannot override its group recipe", member.id)
            } else { () }
        },
    }
};

# 声明公开且可手写；组合与编译边界重新检查所有节点和发布名称。
def validate_binding_contract: Fn(model::PreparedDataset, BindingFacts) -> () = fn(dataset, binding) {
    match binding.contract {
        BindingContract::Dimension => {
            if array::length(binding.members) != 1 || binding.members[0].local != "value" {
                fail!("dimension binding must publish its declared member", binding.dataset)
            } else { () }
        },
        BindingContract::Transfer(group) => {
            if group.id == "" || array::length(group.members) == 0 || array::length(binding.members) != array::length(group.members) || !array::all(group.members, fn(recipe) {
                array::length(array::filter(group.members, fn(other) { other == recipe })) == 1
                    && array::length(array::filter(binding.members, fn(member) {
                        member.group == group.id && member.kind == MemberKind::Transfer(recipe)
                    })) == 1
            }) { fail!("measure binding must preserve its complete group", group.id) }
            else { () }
        },
        BindingContract::Identity(role) => {
            model::validate_prepared(dataset <~ {roles: [role]});
            let parts = array::map(role.parts, fn(part) { {name: part.source, value: part.value, nullable: part.nullable}.ty!(Column) });
            if array::length(binding.members) != array::length(parts) || !array::all(role.parts, fn(part) {
                array::length(array::filter(binding.members, fn(member) {
                    member.local == part.target && member.group == `identity_\{role.entity}`
                        && member.node == Node::Identity({column: {name: part.source, value: part.value, nullable: part.nullable}, parts})
                        && member.aggregate == None
                })) == 1
            }) { fail!("identity dimensions must preserve the complete role", role.id) }
            else { () }
        },
    }
};
def prepare_facts: Fn(model::PreparedDataset, Array(BindingFacts)) -> Array(Member) = fn(dataset, bindings) {
    model::validate_prepared(dataset);
    let members = array::flat_map(bindings, fn(binding) {
        if binding.row != dataset.row || binding.dataset != dataset.id || binding.source != dataset.source { fail!("group binding belongs to a different dataset", binding.dataset) }
        else { validate_binding_contract(dataset, binding); binding.members }
    });
    array::map(members, fn(member) {
        validate_member_contract(member);
        let actual = shape(dataset.row, member.node);
        if member.group == "" || member.local == "" { fail!("group and local member ids must be nonempty", member.id) }
        else if !qb::is_sql_identifier(member.id) || array::length(array::filter(members, fn(other) { other.id == member.id })) != 1 {
            fail!("group publish ids must be valid and unique", member.id)
        } else if member.value != actual.value || (member.aggregate == None && member.nullable != actual.nullable)
            || (member.aggregate != None && !member.nullable) {
            fail!("group member result type does not match its expression", member.id)
        } else if member.aggregate != None && member.filters != [] {
            fail!("measure filters require an aggregate predicate contract", member.id)
        } else { member }
    })
};
def prepare: for(Row) Fn(model::Dataset(Row), Array(Binding(Row))) -> Array(Member) = fn(dataset, bindings) {
    prepare_facts(model::prepare(dataset, []), array::map(bindings, binding_facts))
};

def lower: Fn(qb::BuildCtx, qb::Source, Node) -> (qb::BuildCtx, qb::Expr) = fn(ctx, source, node) {
    match node {
        Node::Column(column) => (ctx, qb::column(source, column.name)),
        Node::Seconds(input) => {
            let lowered = lower(ctx, source, input);
            let divisor = qb::bind(lowered.0, qb::Val::Float(1000.0));
            (divisor.0, qb::scalar(qb::ScalarFunction::Div, [lowered.1, divisor.1]))
        },
        Node::Rate(inputs) => {
            let amount = lower(ctx, source, inputs.amount);
            let duration = lower(amount.0, source, inputs.duration);
            let zero = qb::bind(duration.0, qb::Val::Float(0.0));
            let one = qb::bind(zero.0, qb::Val::Float(1.0));
            let missing = qb::bind(one.0, qb::Val::None);
            let real_amount = qb::scalar(qb::ScalarFunction::Div, [amount.1, one.1]);
            let positive = qb::scalar(qb::ScalarFunction::Gt, [duration.1, zero.1]);
            (missing.0, qb::scalar_if(positive, qb::scalar(qb::ScalarFunction::Div, [real_amount, duration.1]), missing.1))
        },
        Node::Identity(input) => {
            let present = array::map(input.parts, fn(part) { qb::scalar(qb::ScalarFunction::IsNotNull, [qb::column(source, part.name)]) });
            let condition = array::fold(present, present[0], fn(all, part) { qb::scalar(qb::ScalarFunction::And, [all, part]) });
            let missing = qb::bind(ctx, qb::Val::None);
            (missing.0, qb::scalar_if(condition, qb::column(source, input.column.name), missing.1))
        },
    }
};

# 本阶段只有单 Dataset 聚合；没有隐式连接，也不自动投影未授权维度。
type LoweredGroup = struct { ctx: qb::BuildCtx, projection: Array(qb::SelectItem), grouping: Array(qb::Expr) };
def query: for(Row) Fn(model::Dataset(Row), Array(Binding(Row))) -> qb::QueryAst = fn(dataset, bindings) {
    let members = prepare(dataset, bindings);
    let visible = array::filter(members, fn(member) { member.projectable });
    if array::length(visible) == 0 { fail!("group query requires a projected member", dataset.id) }
    else {
        let source = qb::source_with_hint(qb::build_context(), dataset.source, "sample");
        let lowered = array::fold(visible, {ctx: source.0, projection: [], grouping: []}.ty!(LoweredGroup), fn(state, member) {
            let expr = lower(state.ctx, source.1, member.node);
            let item = match member.aggregate {
                None => qb::named_expr_item(expr.1, member.id),
                Some(function) => qb::aggregate(function, expr.1, False, member.id),
            };
            {ctx: expr.0, projection: array::push(state.projection, item), grouping:
                if member.aggregate == None { array::push(state.grouping, expr.1) } else { state.grouping }}
        });
        let plan: qb::Plan = {revision: "typed-groups", sources: [source.1], derived: None,
            projection: lowered.projection, internal_measures: [], filter: None, exists: [], joins: [],
            grouping: if array::any(visible, fn(member) { member.aggregate != None }) { lowered.grouping } else { [] },
            having: [], ordering: [], limit: None, offset: None, partition: None,
            scalar_comparisons: [], ranked_key_comparisons: []};
        qb::finish(lowered.ctx, qb::validate_query_plan(qb::QueryPlan::Rows(plan)))
    }
};

pub use self::{Column, Node, Shape, Expr, input, seconds, rate, Filter,
    DimensionGroup, dimension_group, dimension, MeasureGroup, TransferMember, transfer,
    Rename, transfer_binding, Member, Binding, prepare, query};
pub use self::{identity_dimensions, IdentityName};
pub use self::{BindingFacts, binding_facts, binding_roles, prepare_facts};
