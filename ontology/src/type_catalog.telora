# 知识、查询目录和 codec 共用的类型登记；存储表示另由具体成员声明。
use std::type_desc as td;
use std::type_memorizer as memo;
use std::array;
use crate::knowledge as k;

type Description = struct {
    ty: Type,
    body: Type,
    name: Option(String),
    kind: td::TypeDescKind,
    children: Array(Type),
    fields: Array(td::FieldDesc),
    variants: Array(td::VariantDesc),
    optional: Option(Type)
};
def catalog: memo::TypeMemorizer(Description) = memo::type_memorizer(
    fn(ty) {
        let body = k::resolved(ty);
        let kind = td::kind(body);
        let variants = if kind == td::TypeDescKind::Enum {
            td::variants(body)
        } else {
            []
        };
        let optional = if array::length(variants) == 2 && array::any(
            variants,
            fn(v) {
                v.name == "None" && v.payload == None
            }
        ) {
            match array::find(
                variants,
                fn(v) {
                    v.name == "Some"
                }
            ) {
                Some(v) => v.payload,
                None => None
            }
        } else {
            None
        };
        {
            ty,
            body,
            name: td::name(ty),
            kind,
            children: td::children(ty),
            fields: if kind == td::TypeDescKind::Struct {
                td::fields(body)
            } else {
                []
            },
            variants,
            optional
        }.ty!(Description)
    }
);
def describe: Fn(Type) -> Description = fn(ty) {
    memo::computed_with_type(catalog, ty)
};
pub use self::{Description, describe};
