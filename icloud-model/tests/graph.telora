use crate::model::{ payload };
use ontology::intent::{ query_intent_ast_factory };
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use ontology::query as qb;
use std::array as array;
use std::json as json;
use std::string as string;
use std::test as test;

def lower: Fn(std::value::Value) -> qb::Query = fn(value) {
    sqlite::build_query(query_intent_ast_factory(payload, "public")(value))
};

pub def raw_kpi_trend_orders_by_declared_utc_clock: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{
        "op":"graph", "root":"sample",
        "nodes":[{"id":"sample","entity":"device_kpi"},{"id":"owner","entity":"device"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"owner"}],
        "select":[{"node":"owner","dimension":"device_name"},
                  {"node":"sample","dimension":"device_kpi_ts_raw"},
                  {"node":"sample","dimension":"port_count_sample"}],
        "filters":[{"node":"sample","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-01 00:00:00"}],
        "order_by":[{"node":"sample","dimension":"device_kpi_ts_raw","direction":"asc"}]
    }"#).unwrap!();
    let sqlite_query = lower(intent);
    let pg_query = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sqlite_query.sql, "ORDER BY sample.ts ASC")
        && string::contains(pg_query.sql, "ORDER BY \"sample\".\"ts\" ASC")
        && string::contains(sqlite_query.sql, "sample.resId = owner.id")
        && string::contains(sqlite_query.sql, "sample.tenantId = owner.tenant_id")
        && sqlite_query.bindings == [qb::Val::String("2025-01-01 00:00:00"), qb::Val::String("2025-02-01 00:00:00")]
        && pg_query.bindings == sqlite_query.bindings { True }
    else { fail!(`raw trend lost named owner, time ordering or window: \{sqlite_query.sql} / \{pg_query.sql}`, sqlite_query.bindings, pg_query.bindings) }
});

pub def raw_trend_rejects_unprojected_order: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"sample",
        "nodes":[{"id":"sample","entity":"device_kpi"}],"edges":[],
        "select":[{"node":"sample","dimension":"port_count_sample"}],
        "order_by":[{"node":"sample","dimension":"device_kpi_ts_raw","direction":"asc"}]}"#).unwrap!())
}, "graph order requires a projected dimension on the named node");

pub def raw_trend_rejects_invalid_direction: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"sample",
        "nodes":[{"id":"sample","entity":"device_kpi"}],"edges":[],"select":[],
        "order_by":[{"node":"sample","dimension":"device_kpi_ts_raw","direction":"sideways"}]}"#).unwrap!())
}, "graph order direction must be asc or desc");

pub def raw_trend_rejects_aggregate_grain_order: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"sample",
        "nodes":[{"id":"sample","entity":"device_kpi"}],"edges":[],
        "select":[{"node":"sample","dimension":"device_kpi_ts_raw"}],"count":"sample",
        "order_by":[{"node":"sample","dimension":"device_kpi_ts_raw","direction":"asc"}]}"#).unwrap!())
}, "graph dimension order requires raw rows");

pub def site_device_value_set_requires_explicit_distinct: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"site","distinct":true,
        "nodes":[{"id":"site","entity":"site"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_located_at_site","from":"device","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"},
                  {"node":"device","dimension":"device_name"}],
        "filters":[{"node":"site","dimension":"site_type","op":"eq","kind":"text","value":"offline"}]
    }"#).unwrap!();
    let sqlite_query = lower(intent);
    let pg_query = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sqlite_query.sql, "SELECT DISTINCT site.SITE_NAME AS site_site_name, device.name AS device_device_name")
        && string::contains(pg_query.sql, "SELECT DISTINCT \"site\".\"SITE_NAME\"")
        && string::contains(sqlite_query.sql, "device.projectId = site.SITE_ID")
        && string::contains(sqlite_query.sql, "device.refParentSubnet = site.SITE_ID")
        && sqlite_query.bindings == pg_query.bindings { True }
    else { fail!(`site-device value-set semantics lost: \{sqlite_query.sql} / \{pg_query.sql}`) }
});

pub def site_device_rows_do_not_implicitly_deduplicate: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{"op":"graph","root":"site",
        "nodes":[{"id":"site","entity":"site"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_located_at_site","from":"device","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"},
                  {"node":"device","dimension":"device_name"}]}
    "#).unwrap!());
    if string::contains(query.sql, "SELECT site.SITE_NAME")
        && !string::contains(query.sql, "SELECT DISTINCT") { True }
    else { fail!("graph row semantics unexpectedly deduplicated visible values", query.sql) }
});

pub def distinct_rejects_counted_identity: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"device","distinct":true,
        "nodes":[{"id":"device","entity":"device"}],"edges":[],
        "select":[{"node":"device","dimension":"device_name"}],"count":"device"}"#).unwrap!())
}, "graph distinct requires raw projected rows");

pub def distinct_rejects_non_boolean_flag: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"device","distinct":"yes",
        "nodes":[{"id":"device","entity":"device"}],"edges":[],
        "select":[{"node":"device","dimension":"device_name"}]}"#).unwrap!())
}, "graph distinct must be boolean");

pub def alarm_severity_counts_keep_independent_aggregate_scopes: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"alarm","measure":"critical_alarm_count"},
                    {"node":"alarm","measure":"major_alarm_count"}],
        "group_by_identity":["device"]}"#).unwrap!();
    let sqlite_query = lower(intent);
    let pg_query = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sqlite_query.sql, "count(alarm.CSN) FILTER (WHERE")
        && string::contains(sqlite_query.sql, "alarm.SEVERITY = ?1")
        && string::contains(sqlite_query.sql, "alarm.SEVERITY = ?2")
        && string::contains(sqlite_query.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && !string::contains(sqlite_query.sql, " WHERE alarm.SEVERITY")
        && string::contains(pg_query.sql, "FILTER (WHERE")
        && sqlite_query.bindings == [qb::Val::String("1"), qb::Val::String("2")]
        && pg_query.bindings == sqlite_query.bindings { True }
    else { fail!(`filtered event counts changed sample population: \{sqlite_query.sql} / \{pg_query.sql}`) }
});

pub def filtered_alarm_count_rejects_wrong_named_owner: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"}],"edges":[],
        "select":[{"node":"device","dimension":"device_name"}],
