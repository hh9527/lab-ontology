use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# NetworkSlot独立声明，保留源可空性和已声明粒度
use super::inventory as i;
use super::frame as frame;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type SlotId = struct(
    String
);
@registry::entity("slot_entity")
type Identity = struct {
    id: SlotId
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
@registry::dataset("network_slot", "I_EnterpriseSlot", ["id"])
@registry::roles([subject, tenant, frame_reference])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("slot_is_daughter_card", Bool.type, True, g::equality_filters),
            g::input(m::field(IEnterpriseSlot.type, Bool.type, "is_daughter_card")),
            "slot_is_daughter_card",
            True,
            g::equality_filters
        ),
    ]
)
@registry::record_counts(["slot_count"])
@registry::relations(relations)
type IEnterpriseSlot = struct {
    @g::exact("slot_id")
    id: SlotId,
    @g::search("slot_name")
    name: String,
    @m::column("isDaughterCard")
    is_daughter_card: Bool,
    @m::column("productName")
    @g::search("network_slot__productName")
    source_productName: String,
    @m::column("frameNativeId")
    @g::exact("network_slot__frameNativeId")
    source_frameNativeId: frame::FrameDn,
    @m::column("manufacturer")
    @g::search("network_slot__manufacturer")
    source_manufacturer: String,
    @m::column("hardVersion")
    @g::search("network_slot__hardVersion")
    source_hardVersion: String,
    @m::column("softVersion")
    @g::search("network_slot__softVersion")
    source_softVersion: String,
    @m::column("sn")
    @g::search("network_slot__sn")
    source_sn: String,
    @m::column("tenantId")
    @g::exact("network_slot__tenantId")
    source_tenantId: i::TenantId,
    @m::column("refParentNE")
    @g::exact("network_slot__refParentNE")
    source_refParentNE: i::DeviceId,
    @m::column("operstatus")
    @v::classification(NetworkSlotOperstatus_domain, "network_slot__operstatus")
    source_operstatus: Int,
    @m::column("adminstatus")
    @v::classification(NetworkSlotAdminstatus_domain, "network_slot__adminstatus")
    source_adminstatus: Int,
    @m::column("projectId")
    @g::exact("network_slot__projectId")
    source_projectId: String,
};
def dataset: m::Dataset(IEnterpriseSlot) = registry::dataset_of(IEnterpriseSlot.type);
def subject: m::Role(IEnterpriseSlot) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(IEnterpriseSlot.type, SlotId.type, "id"),
            m::field(Identity.type, SlotId.type, "id")
        )
    ]
);
def tenant: m::Role(IEnterpriseSlot) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(IEnterpriseSlot.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def frame_reference: m::Role(IEnterpriseSlot) = m::role(
    dataset,
    frame::reference,
    "frame_reference",
    False,
    [
        m::identity_part(
            m::field(IEnterpriseSlot.type, frame::FrameDn.type, "source_frameNativeId"),
            m::field(frame::Reference.type, frame::FrameDn.type, "dn")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type NetworkSlotOperstatus = enum {
    @ev::itag(3)
    @ev::itag(11)
    @ev::itag(13)
    @ev::itag(15)
    @ev::itag(16)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(2)
    @ev::itag(5)
    @ev::itag(12)
    @ev::itag(17)
    @ev::description("faulty", "故障")
    Faulty,
    @ev::itag(4)
    @ev::description("offline", "离线")
    Offline,
    @ev::itag(1)
    @ev::itag(-1)
    @ev::description("unknow", "未知")
    Unknown,
};
def NetworkSlotOperstatus_domain: v::Domain(NetworkSlotOperstatus, Int) = v::from_enum(
    "NetworkSlotOperstatus",
    NetworkSlotOperstatus.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type NetworkSlotAdminstatus = enum {
    @ev::itag(4)
    @ev::itag(11)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(2)
    @ev::itag(3)
    @ev::itag(12)
    @ev::description("faulty", "故障")
    Faulty,
    @ev::itag(13)
    @ev::description("loopback", "回环")
    Loopback,
    @ev::itag(1)
    @ev::itag(-1)
    @ev::description("unknow", "未知")
    Unknown,
};
def NetworkSlotAdminstatus_domain: v::Domain(NetworkSlotAdminstatus, Int) = v::from_enum(
    "NetworkSlotAdminstatus",
    NetworkSlotAdminstatus.type,
    Int.type,
    False
);
def relations: Array(r::Relation) = [
    r::relation(
        "source_EnterpriseFrame_EnterpriseSlot",
        r::endpoint(frame::dataset.row, frame::frame_reference.id),
        r::endpoint(dataset.row, frame_reference.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EnterpriseSlot_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{IEnterpriseSlot, Identity};
