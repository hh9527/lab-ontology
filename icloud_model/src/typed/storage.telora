type StorageId = struct(String);
type Identity = struct { id: StorageId };
# 保留来源0..1尺度说明，不把范围说明当作已验证生产约束
type Fraction = struct(Float);
type Megabytes = struct(Float);
# 来源未在当前公共契约明确单位，不默认与MB互换
type ReportedCapacity = struct(Float);
type Row = struct {
    id: StorageId,
    name: String,
    tenant_id: i::TenantId,
    parent_res_id: i::SiteId,
    project_id: i::SiteId,
    running_status: String,
    sub_class_name: String,
    source_usedCapacityRate: Fraction,
    source_totalStoragePoolCapacity: Megabytes,
    source_unUsedCapacity: Megabytes,
    source_nativeId: String,
    source_createTime: s::EpochMillis,
    source_regionId: String,
    source_belongSeries: String,
    source_powerStatus: String,
    source_classification: String,
    source_hotPatchVersion: String,
    source_deviceType: String,
    source_healthStatus: String,
    source_connectStatus: Int,
    source_usedCapacity: ReportedCapacity,
    source_totalCapacity: ReportedCapacity,
    source_manufacturer: String,
    source_sn: String,
    source_productmodel: String,
    source_location: String,
    source_ipAddress: String,
    source_version: String,
};
def entity: m::Entity(Identity) = m::entity("storage_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset("storage_device", "HuaweiStorageDevice", Row.type, ["id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, StorageId.type, "id"), m::field(Identity.type, StorageId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
def parent_site: m::Role(Row) = m::role(dataset, site::entity, "parent_site", False, [m::identity_part(m::field(Row.type, i::SiteId.type, "parent_res_id"), m::field(site::Identity.type, i::SiteId.type, "id"))]);
def project_site: m::Role(Row) = m::role(dataset, site::entity, "project_site", False, [m::identity_part(m::field(Row.type, i::SiteId.type, "project_id"), m::field(site::Identity.type, i::SiteId.type, "id"))]);
type StorageRunningStatus = struct(String);
