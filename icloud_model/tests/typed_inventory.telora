use crate::typed::{payload};
use crate::typed::inventory as inventory;
use crate::model as baseline;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};
use std::test as test;

def base_entity: Fn(String) -> edsl::EntityEntry = fn(id) { match array::find(baseline::payload.entities, fn(entry) { entry.id == id }) { Some(entry) => entry, None => fail!("baseline entity missing", id) } };
pub def physical_sources_fields_and_grains_match_the_baseline: test::Test = test::should_ok(fn() {
    array::all(payload.entities, fn(entity) { let previous = base_entity(entity.id); entity.table == previous.table && entity.fields == array::map(previous.fields, fn(field) {
        # 显式复合 grain 已给出完整样本身份，不把 res_id 单列当成唯一键
        match entity.dataset {
            Some(spec) => if array::length(spec.grain) > 1 { field <~ {is_key: False} } else { field },
            None => field,
        }
    }) && match (entity.dataset, previous.dataset) {
        (Some(current), None) => current.kind == edsl::DatasetKind::Entity && current.utc_time == None && current.grain == array::map(array::filter(previous.fields, fn(field) { field.is_key }), fn(field) { field.name }),
        _ => entity.dataset == previous.dataset,
    } })
});
pub def all_current_dimension_contracts_are_preserved: test::Test = test::should_ok(fn() {
    array::all(payload.entities, fn(entity) {
        let previous = base_entity(entity.id);
        let expected = array::filter(baseline::payload.dimensions, fn(dimension) { dimension.entity == previous.index });
        let actual = array::filter(payload.dimensions, fn(dimension) { dimension.entity == entity.index });
        array::length(expected) == array::length(actual) && array::all(expected, fn(old) {
            match array::find(actual, fn(value) { value.id == old.id }) {
                None => False,
                Some(value) => value.ty == old.ty && value.half_open == old.half_open && value.output_type == old.output_type && value.field == old.field
                    && value.computed == old.computed && value.authorized == old.authorized && value.projectable == old.projectable
                    && value.filterable == old.filterable && value.ops == old.ops && value.input_kinds == old.input_kinds
                    && value.utc_bucket == old.utc_bucket && value.scope == old.scope && value.canonical_order == old.canonical_order
                    && array::map(value.canonical_values, fn(member) { (member.id, member.wires) }) == array::map(old.canonical_values, fn(member) { (member.id, member.wires) }),
            }
        })
    })
});
pub def all_current_record_measures_are_preserved: test::Test = test::should_ok(fn() {
    array::all(payload.entities, fn(entity) {
        let expected = array::filter(baseline::payload.measures, fn(measure) { measure.entity == base_entity(entity.id).index });
        let actual = array::filter(payload.measures, fn(measure) { measure.entity == entity.index });
        array::length(expected) == array::length(actual) && array::all(expected, fn(old) { array::any(actual, fn(value) { value.id == old.id && value.field == old.field && value.aggregate == old.aggregate && value.input == old.input && value.requires == old.requires && value.predicate == old.predicate && value.computed == old.computed && value.row_expression == None }) })
    })
});
pub def every_relation_between_migrated_datasets_is_preserved: test::Test = test::should_ok(fn() {
    let expected = array::filter(baseline::payload.relations, fn(relation) { relation.from < 11 && relation.to < 11 });
    array::length(expected) == array::length(payload.relations) && array::all(expected, fn(old) { array::any(payload.relations, fn(value) { value.id == old.id && value.from == old.from && value.to == old.to && value.cardinality == old.cardinality && value.key == old.key && value.guard == old.guard }) })
});
pub def device_identity_is_id_only: test::Test = test::should_ok(fn() { inventory::device_subject.parts == [{source: "id", target: "id", value: inventory::DeviceId.type, nullable: False}] });
pub def sample_roles_units_and_statistics_are_preserved: test::Test = test::should_ok(fn() {
    array::all(payload.entities, fn(entity) { entity.sample_measures == base_entity(entity.id).sample_measures })
});
pub def backend_capability_profile_is_preserved: test::Test = test::should_ok(fn() { payload.profile == baseline::payload.profile });

type Pair = struct { id: String, typed: qb::Query, baseline: qb::Query, postgres: qb::Query, columns: Array(intent::ResultColumn), baseline_columns: Array(intent::ResultColumn) };
def pair: Fn(String, Value) -> Pair = fn(id, request) {
    let actual = intent::query_intent_ast_factory(payload)(request);
    let expected = intent::query_intent_ast_factory(baseline::payload)(request);
    {id, typed: sqlite::build_query(actual), baseline: sqlite::build_query(expected), postgres: postgres::build_query(actual),
        columns: intent::result_columns(payload, request, actual), baseline_columns: intent::result_columns(baseline::payload, request, expected)}
};
def device_case: Fn(String, String) -> Pair = fn(id, extra) { pair(id, json::parse(`{"op":"Graph","root":"d","nodes":[{"id":"d","entity":"device"}],"edges":[],\{extra}}`).unwrap!()) };
def join_case: Fn(String) -> Pair = fn(relation) { pair(relation, json::parse(`{"op":"Graph","root":"d","nodes":[{"id":"d","entity":"device"},{"id":"t","entity":"tenant"}],"edges":[{"relation":"\{relation}","from":"d","to":"t"}],"select":[{"node":"d","dimension":"device_id"},{"node":"t","dimension":"tenant_name"}]}`).unwrap!()) };
pub def runtime_cases: Value = codec::encode(array::concat([
    array::map(payload.dimensions, fn(dimension) {
        let entity = payload.entities[dimension.entity];
        pair(`project_\{dimension.id}`, json::parse(`{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"\{entity.id}"}],"edges":[],"select":[{"node":"r","dimension":"\{dimension.id}"}]}`).unwrap!())
    }),
    [pair("site_online", json::parse(r#"{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"site"}],"edges":[],"select":[{"node":"s","dimension":"site_id"}],"filters":[{"node":"s","dimension":"site_type","op":"Eq","value":"online"}]}"#).unwrap!()),
     join_case("device_belongs_to_tenant"), join_case("source_EntNetworkElement_X_TENANT_VIEW"),
     device_case("known", r#""select":[{"node":"d","dimension":"device_id"}],"filters":[{"node":"d","dimension":"device_class","op":"Eq","value":"lb"}]"#),
     device_case("unknown_collision", r#""select":[{"node":"d","dimension":"device_id"}],"filters":[{"node":"d","dimension":"device_class","op":"Eq","value":{"unknown":"router"}}]"#),
     device_case("unknowns", r#""select":[{"node":"d","dimension":"device_id"}],"filters":[{"node":"d","dimension":"device_class","op":"Eq","value":{"unknowns":true}}]"#),
     device_case("offline", r#""select":[{"node":"d","dimension":"device_id"}],"filters":[{"node":"d","dimension":"device_commu_state","op":"Eq","value":"offline"}]"#),
     device_case("subnet", r#""select":[{"node":"d","dimension":"device_id"}],"filters":[{"node":"d","dimension":"device_ip_address_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#),
     device_case("count", r#""select":[],"measures":[{"node":"d","measure":"device_count"}]"#),
     device_case("group_class", r#""select":[{"node":"d","dimension":"device_class"}],"measures":[{"node":"d","measure":"device_count"}]"#),
     pair("tenant_count", json::parse(r#"{"op":"Graph","root":"t","nodes":[{"id":"t","entity":"tenant"}],"edges":[],"select":[],"measures":[{"node":"t","measure":"tenant_count"}]}"#).unwrap!()),
    ],
]));
pub def site_relation_cases: Value = codec::encode(array::concat([array::map(["device_located_at_site", "source_EntNetworkElement_X_SITE_VIEW"], fn(relation) {
    pair(relation, json::parse(`{"op":"Graph","root":"d","nodes":[{"id":"d","entity":"device"},{"id":"s","entity":"site"}],"edges":[{"relation":"\{relation}","from":"d","to":"s"}],"select":[{"node":"d","dimension":"device_id"},{"node":"s","dimension":"site_id"}]}`).unwrap!())
}), array::map(["site_belongs_to_tenant", "source_X_TENANT_VIEW_X_SITE_VIEW"], fn(relation) {
    let source = if relation == "site_belongs_to_tenant" { "s" } else { "t" };
    let target = if source == "s" { "t" } else { "s" };
    pair(relation, json::parse(`{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"site"},{"id":"t","entity":"tenant"}],"edges":[{"relation":"\{relation}","from":"\{source}","to":"\{target}"}],"select":[{"node":"s","dimension":"site_id"},{"node":"t","dimension":"tenant_name"}]}`).unwrap!())
})]));
pub def physical_schema: Value = codec::encode(array::map(payload.entities, fn(entity) { (entity.table, array::map(entity.fields, fn(field) { field.column })) }));

def port_case: Fn(String, String) -> Pair = fn(id, extra) { pair(id, json::parse(`{"op":"Graph","root":"p","nodes":[{"id":"p","entity":"port"}],"edges":[],\{extra}}`).unwrap!()) };
pub def port_cases: Value = codec::encode(array::concat([
    [port_case("port_count", r#""select":[],"measures":[{"node":"p","measure":"interface_count"}]"#),
     port_case("port_up", r#""select":[{"node":"p","dimension":"port_name"}],"filters":[{"node":"p","dimension":"port_oper_status","op":"Eq","value":"up"}]"#),
     port_case("port_admin", r#""select":[{"node":"p","dimension":"port_name"}],"filters":[{"node":"p","dimension":"port__adminState","op":"Eq","value":"wire_test_35f03aff"}]"#),
     port_case("port_type", r#""select":[{"node":"p","dimension":"port_name"}],"filters":[{"node":"p","dimension":"port__ifType","op":"Eq","value":"wire_65635_bc384e3d"}]"#),
     port_case("port_bandwidth", r#""select":[{"node":"p","dimension":"port_name"}],"filters":[{"node":"p","dimension":"port__bandwidth","op":"Gt","value":1000.5}]"#),
     port_case("port_subnet", r#""select":[{"node":"p","dimension":"port_name"}],"filters":[{"node":"p","dimension":"port__ipAddress_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#)],
    array::map(["port_belongs_to_device", "source_EntNetworkElement_EnterpriseNetworkLTP"], fn(relation) {
        let source = if relation == "port_belongs_to_device" { "p" } else { "d" };
        let target = if source == "p" { "d" } else { "p" };
        pair(relation, json::parse(`{"op":"Graph","root":"p","nodes":[{"id":"p","entity":"port"},{"id":"d","entity":"device"}],"edges":[{"relation":"\{relation}","from":"\{source}","to":"\{target}"}],"select":[{"node":"p","dimension":"port_name"},{"node":"d","dimension":"device_id"}]}`).unwrap!())
    }),
    [pair("source_EnterpriseNetworkLTP_X_TENANT_VIEW", json::parse(r#"{"op":"Graph","root":"p","nodes":[{"id":"p","entity":"port"},{"id":"t","entity":"tenant"}],"edges":[{"relation":"source_EnterpriseNetworkLTP_X_TENANT_VIEW","from":"p","to":"t"}],"select":[{"node":"p","dimension":"port_name"},{"node":"t","dimension":"tenant_name"}]}"#).unwrap!())],
]));

def kpi_case: Fn(String, String) -> Pair = fn(id, extra) { pair(id, json::parse(`{"op":"Graph","root":"k","nodes":[{"id":"k","entity":"interface_kpi"}],"edges":[],\{extra}}`).unwrap!()) };
pub def kpi_cases: Value = codec::encode(array::concat([
    array::map(array::filter(payload.measures, fn(measure) { payload.entities[measure.entity].id == "interface_kpi" }), fn(measure) {
        kpi_case(`measure_\{measure.id}`, `"select":[],"measures":[{"node":"k","measure":"\{measure.id}"}]`)
    }),
    [kpi_case("kpi_window", r#""select":[],"measures":[{"node":"k","measure":"interface_tx"}],"time_windows":[{"node":"k","dimension":"interface_kpi_ts_raw","start":"2024-03-01T00:00:00Z","end":"2024-03-02T00:00:00Z"}]"#),
     kpi_case("kpi_day", r#""select":[{"node":"k","dimension":"interface_kpi_utc_day"}],"measures":[{"node":"k","measure":"interface_tx"}]"#)],
    array::map(["interface_kpi_of_port", "source_EnterpriseNetworkLTP_NetworkDeviceInterfaceKPI"], fn(relation) {
        let source = if relation == "interface_kpi_of_port" { "k" } else { "p" };
        let target = if source == "k" { "p" } else { "k" };
        pair(relation, json::parse(`{"op":"Graph","root":"k","nodes":[{"id":"k","entity":"interface_kpi"},{"id":"p","entity":"port"}],"edges":[{"relation":"\{relation}","from":"\{source}","to":"\{target}"}],"select":[{"node":"p","dimension":"port_name"}],"measures":[{"node":"k","measure":"interface_tx"}]}`).unwrap!())
    }),
]));
pub def server_relation_projection_requires_association_grain: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"v","nodes":[{"id":"v","entity":"server_device"},{"id":"t","entity":"tenant"}],"edges":[{"relation":"server_belongs_to_tenant","from":"v","to":"t"}],"select":[{"node":"v","dimension":"server_name"},{"node":"t","dimension":"tenant_name"}]}"#).unwrap!())
}, "graph raw projection crosses a multiplying relation");
def server_case: Fn(String, String) -> Pair = fn(id, extra) { pair(id, json::parse(`{"op":"Graph","root":"v","nodes":[{"id":"v","entity":"server_device"}],"edges":[],\{extra}}`).unwrap!()) };
pub def server_cases: Value = codec::encode(array::concat([
    [server_case("server_class_filter", r#""select":[{"node":"v","dimension":"server_name"}],"filters":[{"node":"v","dimension":"server_class","op":"Eq","value":"rack"}]"#),
     server_case("server_health_filter", r#""select":[{"node":"v","dimension":"server_name"}],"filters":[{"node":"v","dimension":"server_health","op":"Eq","value":"error"}]"#),
     server_case("server_connect_filter", r#""select":[{"node":"v","dimension":"server_name"}],"filters":[{"node":"v","dimension":"server_device__connectStatus","op":"Eq","value":"wire_5_c6f5830f"}]"#),
     server_case("server_subnet", r#""select":[{"node":"v","dimension":"server_name"}],"filters":[{"node":"v","dimension":"server_ip_address_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#),
     server_case("server_window", r#""select":[{"node":"v","dimension":"server_name"}],"time_windows":[{"node":"v","dimension":"server_device__createTime","start":0,"end":2000}]"#)],
    array::map(["server_belongs_to_tenant", "source_PhysicalServer_X_TENANT_VIEW"], fn(relation) {
        pair(relation, json::parse(`{"op":"Graph","root":"v","row_grain":"Association","nodes":[{"id":"v","entity":"server_device"},{"id":"t","entity":"tenant"}],"edges":[{"relation":"\{relation}","from":"v","to":"t"}],"select":[{"node":"v","dimension":"server_name"},{"node":"t","dimension":"tenant_name"}]}`).unwrap!())
    }),
    array::map(["server_located_at_site", "source_PhysicalServer_X_SITE_VIEW"], fn(relation) {
        pair(relation, json::parse(`{"op":"Graph","root":"v","row_grain":"Association","nodes":[{"id":"v","entity":"server_device"},{"id":"s","entity":"site"}],"edges":[{"relation":"\{relation}","from":"v","to":"s"}],"select":[{"node":"v","dimension":"server_name"},{"node":"s","dimension":"site_id"}]}`).unwrap!())
    }),
]));
def server_kpi_case: Fn(String, String) -> Pair = fn(id, extra) { pair(id, json::parse(`{"op":"Graph","root":"k","nodes":[{"id":"k","entity":"server_kpi"}],"edges":[],\{extra}}`).unwrap!()) };
pub def server_kpi_cases: Value = codec::encode(array::concat([
    array::map(array::filter(payload.measures, fn(measure) { payload.entities[measure.entity].id == "server_kpi" }), fn(measure) {
        server_kpi_case(`measure_\{measure.id}`, `"select":[],"measures":[{"node":"k","measure":"\{measure.id}"}]`)
    }),
    [server_kpi_case("server_latest_window", r#""select":[],"measures":[{"node":"k","measure":"server_cpu_latest"},{"node":"k","measure":"server_memory_latest"}],"time_windows":[{"node":"k","dimension":"server_kpi_ts_raw","start":"2024-03-01T00:00:00Z","end":"2024-03-02T00:00:00Z"}]"#),
     server_kpi_case("server_latest_tie", r#""select":[],"measures":[{"node":"k","measure":"server_cpu_latest"},{"node":"k","measure":"server_memory_latest"}],"filters":[{"node":"k","dimension":"server_kpi__parentId","op":"Eq","value":"sv1"}],"time_windows":[{"node":"k","dimension":"server_kpi_ts_raw","start":"2024-03-01T00:00:00Z","end":"2024-03-02T00:00:00Z"}]"#)],
    array::map(["server_kpi_of_server", "source_PhysicalServer_ServerDeviceKPI"], fn(relation) {
        let source = if relation == "server_kpi_of_server" { "k" } else { "v" };
        let target = if source == "k" { "v" } else { "k" };
        pair(relation, json::parse(`{"op":"Graph","root":"k","nodes":[{"id":"k","entity":"server_kpi"},{"id":"v","entity":"server_device"}],"edges":[{"relation":"\{relation}","from":"\{source}","to":"\{target}"}],"select":[{"node":"v","dimension":"server_name"}],"measures":[{"node":"k","measure":"server_cpu_usage"},{"node":"k","measure":"server_cpu_latest"},{"node":"k","measure":"server_memory_latest"}]}`).unwrap!())
    }),
]));
def component_case: Fn(String, String, String) -> Pair = fn(id, entity, extra) { pair(id, json::parse(`{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"\{entity}"}],"edges":[],\{extra}}`).unwrap!()) };
pub def component_cases: Value = codec::encode(array::concat([
    [component_case("fan_health_filter", "server_fan", r#""select":[{"node":"c","dimension":"server_fan_id"}],"filters":[{"node":"c","dimension":"server_fan__healthStatus","op":"Eq","value":"wire__1_fe93bf05"}]"#),
     component_case("psu_health_filter", "server_psu", r#""select":[{"node":"c","dimension":"server_psu__name"}],"filters":[{"node":"c","dimension":"server_psu_health","op":"Eq","value":"warning"}]"#),
     component_case("memory_health_filter", "server_memory", r#""select":[{"node":"c","dimension":"server_memory_name"}],"filters":[{"node":"c","dimension":"server_memory__healthStatus","op":"Eq","value":"wire__2_1027a474"}]"#),
     component_case("fan_count", "server_fan", r#""select":[],"measures":[{"node":"c","measure":"server_fan_count"}]"#)],
    array::map([
        ("fan_parent_server", "server_fan", "server_device", "server_name", False),
        ("source_PhysicalServer_PhysicalServerFan", "server_fan", "server_device", "server_name", True),
        ("fan_belongs_to_tenant", "server_fan", "tenant", "tenant_name", False),
        ("source_PhysicalServerFan_X_TENANT_VIEW", "server_fan", "tenant", "tenant_name", False),
        ("psu_parent_server", "server_psu", "server_device", "server_name", False),
        ("source_PhysicalServer_PhysicalServerPSU", "server_psu", "server_device", "server_name", True),
        ("psu_belongs_to_tenant", "server_psu", "tenant", "tenant_name", False),
        ("source_PhysicalServerPSU_X_TENANT_VIEW", "server_psu", "tenant", "tenant_name", False),
        ("memory_parent_server", "server_memory", "server_device", "server_name", False),
        ("source_PhysicalServer_PhysicalServerMemory", "server_memory", "server_device", "server_name", True),
        ("source_PhysicalServerMemory_X_TENANT_VIEW", "server_memory", "tenant", "tenant_name", False),
    ], fn(spec) {
        let dimension = if spec.1 == "server_fan" { "server_fan_name" } else if spec.1 == "server_psu" { "server_psu__name" } else { "server_memory_name" };
        let source = if spec.4 { "o" } else { "c" };
        let target = if spec.4 { "c" } else { "o" };
        let grain = if spec.2 == "tenant" { r#""row_grain":"Association","# } else { "" };
        pair(spec.0, json::parse(`{"op":"Graph","root":"c",\{grain}"nodes":[{"id":"c","entity":"\{spec.1}"},{"id":"o","entity":"\{spec.2}"}],"edges":[{"relation":"\{spec.0}","from":"\{source}","to":"\{target}"}],"select":[{"node":"c","dimension":"\{dimension}"},{"node":"o","dimension":"\{spec.3}"}]}`).unwrap!())
    }),
    [pair("fan_count_for_server", json::parse(r#"{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"server_fan"},{"id":"v","entity":"server_device"}],"edges":[{"relation":"fan_parent_server","from":"c","to":"v"}],"select":[],"measures":[{"node":"c","measure":"server_fan_count"}],"filters":[{"node":"v","dimension":"server_name","op":"Eq","value":"sv1"}]}"#).unwrap!()),
     pair("memory_server_sample_rows", json::parse(r#"{"op":"Graph","root":"c","row_grain":"Association","nodes":[{"id":"c","entity":"server_memory"},{"id":"v","entity":"server_device"},{"id":"k","entity":"server_kpi"}],"edges":[{"relation":"memory_parent_server","from":"c","to":"v"},{"relation":"server_kpi_of_server","from":"k","to":"v"}],"select":[{"node":"c","dimension":"server_memory_name"},{"node":"v","dimension":"server_name"},{"node":"k","dimension":"server_cpu_sample"}]}"#).unwrap!())],
]));
pub def component_projection_does_not_reinterpret_server_samples_as_component_values: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"server_memory"},{"id":"v","entity":"server_device"},{"id":"k","entity":"server_kpi"}],"edges":[{"relation":"memory_parent_server","from":"c","to":"v"},{"relation":"server_kpi_of_server","from":"k","to":"v"}],"select":[{"node":"c","dimension":"server_memory_name"},{"node":"k","dimension":"server_cpu_sample"}]}"#).unwrap!())
}, "graph raw projection crosses a multiplying relation");
def storage_case: Fn(String, String) -> Pair = fn(id, extra) { pair(id, json::parse(`{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"storage_device"}],"edges":[],\{extra}}`).unwrap!()) };
pub def storage_cases: Value = codec::encode(array::concat([
    array::map([
        ("storage_running_status", "normal"), ("storage_device_subclass", "fc_switch_device"),
        ("storage_device__powerStatus", "wire_poweron_719ada0e"), ("storage_device__classification", "wire_HuaweiStorage_314c393a"),
        ("storage_device__deviceType", "wire_fcswitch_a16c3357"), ("storage_device__healthStatus", "wire_2_8807c846"),
        ("storage_device__connectStatus", "wire_9_cfd024ae"),
    ], fn(spec) { storage_case(`filter_\{spec.0}`, `"select":[{"node":"s","dimension":"storage_device_id"}],"filters":[{"node":"s","dimension":"\{spec.0}","op":"Eq","value":"\{spec.1}"}]`) }),
    [storage_case("storage_counts", r#""select":[],"measures":[{"node":"s","measure":"storage_device_count"},{"node":"s","measure":"storage_device_named_count"}]"#),
     storage_case("storage_distinct_names", r#""select":[],"count_value":{"node":"s","dimension":"storage_device__name"}"#),
     storage_case("storage_fraction", r#""select":[{"node":"s","dimension":"storage_device_id"}],"filters":[{"node":"s","dimension":"storage_device__usedCapacityRate","op":"Gt","value":0.4}]"#),
     storage_case("storage_capacity", r#""select":[{"node":"s","dimension":"storage_device_id"}],"filters":[{"node":"s","dimension":"storage_device__totalStoragePoolCapacity","op":"Gt","value":100.5}]"#),
     storage_case("storage_subnet", r#""select":[{"node":"s","dimension":"storage_device_id"}],"filters":[{"node":"s","dimension":"storage_device__ipAddress_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#),
     storage_case("storage_window", r#""select":[{"node":"s","dimension":"storage_device_id"}],"time_windows":[{"node":"s","dimension":"storage_device__createTime","start":0,"end":2000}]"#)],
    array::map([
        ("storage_device_belongs_to_tenant", "tenant", "tenant_name"),
        ("source_HuaweiStorageDeviceAssociationX_TENANT_VIEW", "tenant", "tenant_name"),
        ("storage_device_site", "site", "site_id"),
        ("source_HuaweiStorageDeviceAssociationX_SITE_VIEW", "site", "site_id"),
    ], fn(spec) { pair(spec.0, json::parse(`{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"storage_device"},{"id":"o","entity":"\{spec.1}"}],"edges":[{"relation":"\{spec.0}","from":"s","to":"o"}],"select":[{"node":"s","dimension":"storage_device_id"},{"node":"o","dimension":"\{spec.2}"}]}`).unwrap!()) }),
]));
pub def physical_affinities: Value = codec::encode(array::map(payload.entities, fn(entity) { (entity.table, array::map(entity.fields, fn(field) {
    (field.column, if field.ty == Int.type || field.ty == Bool.type { "INTEGER" } else if field.ty == Float.type { "REAL" } else { "TEXT" })
})) }));
# 一次初始化输出全部对照请求与物理 schema，避免每组查询重复准备旧模型
