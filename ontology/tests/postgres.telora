use std::string as string;
use std::test as test;
use crate::query as qb;
use crate::postgres as pg;
use crate::sqlite as sqlite;

pub def aliases_and_bindings_materialize_in_both_dialects: test::Test = test::should_ok(
    fn() {
        let first = qb::source_with_hint(qb::build_context(), "teams", "t");
        let second = qb::source_with_hint(first.0, "members", "t");
        let bound = qb::bind(second.0, qb::Val::Int(7));
        let plan: qb::Plan = {
            revision: "constructed",
            sources: [first.1],
            joins: [
                qb::join(
                    qb::JoinKind::Inner,
                    second.1,
                    qb::source_column_ref(first.1, "id"),
                    qb::source_column_ref(second.1, "team_id")
                )
            ],
            projection: [qb::named_expr_item(qb::source_column(second.1, "name"), "name")],
            filter: Some(
                qb::scalar(qb::ScalarFunction::Eq, [qb::source_column(second.1, "id"), bound.1])
            ),
            grouping: [],
            having: [],
            ordering: [],
            limit: None,
            offset: None,
            exists: [],
            derived: None,
            internal_measures: [],
            partition: None,
            scalar_comparisons: [],
            ranked_key_comparisons: [],
        };
        let ast = qb::QueryPlan::Rows(plan);
        let finished = qb::finish(bound.0, ast);
        let sqlite_query = sqlite::build_query(finished);
        let postgres = pg::build_query(finished);
        let set: qb::SetPlan = {kind: qb::SetOpKind::UnionAll, operands: [plan, plan]};
        let union = qb::finish(bound.0, qb::QueryPlan::SetRows(set));
        let union = union <~ {
            selection: Some({
                order_by: [{key: qb::Expr::Column({source: "__q_result", column: "name"}), direction: qb::Ordering::Asc}],
                take: 2
            }.ty!(qb::ResultSelection))
        };
        let sqlite_union = sqlite::build_query(union);
        let postgres_union = pg::build_query(union);
        let count = qb::finish(bound.0, qb::QueryPlan::SetCount(set));
        let sqlite_count = sqlite::build_query(count);
        let postgres_count = pg::build_query(count);
        if !string::contains(sqlite_count.sql, " UNION ALL ") ||
            !string::contains(postgres_count.sql, " UNION ALL ") ||
            !string::contains(sqlite_union.sql, " UNION ALL ") ||
            !string::contains(postgres_union.sql, " UNION ALL ") ||
            !string::contains(sqlite_union.sql, "LIMIT 2") ||
            !string::contains(postgres_union.sql, "LIMIT 2") ||
            sqlite_union.bindings != sqlite_query.bindings || postgres_union.bindings != postgres.bindings {
            fail!("UNION ALL must preserve both branches and shared bindings");
        } else {
            ()
        };
        if first.1.alias == "t" && second.1.alias == "t_2" && string::contains(
            sqlite_query.sql,
            "members AS t_2 ON t.id = t_2.team_id"
        ) && string::contains(sqlite_query.sql, "t_2.id = ?1") && string::contains(
            postgres.sql,
            "\"members\" AS \"t_2\" ON \"t\".\"id\" = \"t_2\".\"team_id\""
        ) && string::contains(postgres.sql, "\"t_2\".\"id\" = $1") && sqlite_query.bindings == [
            qb::Val::Int(7)
        ] && postgres.bindings == sqlite_query.bindings {
            True
        } else {
            fail!(
                "constructed AST must preserve aliases and bindings in both dialects",
                sqlite_query,
                postgres
            )
        }
    }
);

pub def unrelated_internal_measure_is_rejected: test::Test = test::should_fail_with(
    fn() {
        let source = qb::source_with_hint(qb::build_context(), "alarms", "alarm");
        let plan: qb::Plan = {
            revision: "internal-boundary",
            sources: [source.1],
            derived: None,
            joins: [],
            exists: [],
            filter: None,
            grouping: [],
            having: [],
            ordering: [],
            projection: [qb::expr_item(qb::column(source.1, "id"))],
            internal_measures: [
                qb::aggregate(
                    qb::AggregateFunction::Count,
                    qb::column(source.1, "id"),
                    False,
                    "hidden_count"
                )
            ],
            limit: None,
            offset: None,
            partition: None,
            scalar_comparisons: [],
            ranked_key_comparisons: [],
        };
        qb::validate_structure(plan)
    },
    "internal measure must be referenced by a projected computed measure"
);

pub def internal_operand_cannot_become_public_having_target: test::Test = test::should_fail_with(
    fn() {
        let source = qb::source_with_hint(qb::build_context(), "alarms", "alarm");
        let bound = qb::bind(source.0, qb::Val::Int(2));
        let plan: qb::Plan = {
            revision: "private-operand",
            sources: [source.1],
            derived: None,
            joins: [],
            exists: [],
            filter: None,
            grouping: [],
            ordering: [],
            projection: [
                qb::computed_item(
                    qb::ComputedOp::Add,
                    "hidden_count",
                    "hidden_count",
                    "double_count"
                )
            ],
            internal_measures: [
                qb::aggregate(
                    qb::AggregateFunction::Count,
                    qb::column(source.1, "id"),
                    False,
                    "hidden_count"
                )
            ],
            having: [qb::having_bound(qb::HavingOp::Gt, "hidden_count", bound.1)],
            limit: None,
            offset: None,
            partition: None,
            scalar_comparisons: [],
            ranked_key_comparisons: [],
        };
        qb::validate_structure(plan)
    },
    "plan HAVING references an unprojected or unknown aggregate"
);

pub def repeated_binding_uses_one_placeholder: test::Test = test::should_ok(
    fn() {
        let bound = qb::bind(qb::build_context(), qb::Val::Int(3));
        let expr = qb::scalar(qb::ScalarFunction::Eq, [bound.1, bound.1]);
        let postgres = pg::render_expr_with_context(expr, bound.0);
        if postgres.sql == "$1 = $1" && postgres.bindings == [qb::Val::Int(3)] {
            True
        } else {
            fail!("binding handle must survive repeated use", postgres)
        }
    }
);
