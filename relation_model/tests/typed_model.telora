mod fixture;
use self::fixture as f;
use ontology::model as model;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::test as test;

pub def nominal_ids_keep_their_payload_codec: test::Test = test::should_ok(fn() {
    let id = codec::decode@[f::DeviceId](json::parse("\"D1\"").unwrap!()).unwrap!();
    id.0 == "D1" && json::stringify(codec::encode(id)) == "\"D1\""
        && f::DeviceId.type != f::TenantId.type && f::DeviceId.type != String.type
});

pub def tenant_is_part_of_the_identity: test::Test = test::should_ok(fn() {
    let left: f::DeviceIdentity = {tenant: f::TenantId("T1"), local: f::DeviceId("D1")};
    let right: f::DeviceIdentity = {tenant: f::TenantId("T2"), local: f::DeviceId("D1")};
    left != right && left.local == right.local
});

pub def checked_identity_constructor_rejects_empty_id: test::Test = test::should_fail_with(fn() {
    f::DeviceId("")
}, "device id must be nonempty");

pub def checked_identity_codec_rejects_empty_id: test::Test = test::should_ok(fn() {
    match codec::decode@[f::DeviceId](json::parse("\"\"").unwrap!()) {
        Err(_) => True, Ok(_) => False,
    }
});

pub def one_entity_is_described_by_inventory_and_samples: test::Test = test::should_ok(fn() {
    let inventory = model::prepare(f::inventory, [f::device_role, f::site_role]);
    let samples = model::prepare(f::samples, [f::sample_role]);
    inventory.roles[0].entity == samples.roles[0].entity
        && inventory.roles[0].identity == samples.roles[0].identity
        && array::length(inventory.grain) == 2 && array::length(samples.grain) == 3
        && samples.roles[0].parts[1].source == "owner"
});

pub def nullable_site_is_an_explicit_optional_role: test::Test = test::should_ok(fn() {
    let inventory = model::prepare(f::inventory, [f::site_role]);
    inventory.roles[0].optional && inventory.roles[0].parts[1].nullable
        && !inventory.roles[0].parts[0].nullable
});

pub def same_entity_has_distinct_endpoint_roles: test::Test = test::should_ok(fn() {
    let connections = model::prepare(f::connections, [f::endpoint("a"), f::endpoint("z")]);
    connections.roles[0].entity == connections.roles[1].entity
        && connections.roles[0].id != connections.roles[1].id
        && connections.roles[0].parts[1].source == "a"
        && connections.roles[1].parts[1].source == "z"
});

pub def dataset_without_entity_is_valid: test::Test = test::should_ok(fn() {
    array::length(model::prepare(f::samples, []).roles) == 0
});

pub def incomplete_identity_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_role(f::inventory, f::device, "device", False, [f::inventory_parts[1]])
}, "role mapping must cover the complete identity exactly once");

pub def duplicate_identity_member_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_role(f::inventory, f::device, "device", False, [f::inventory_parts[0], f::inventory_parts[0]])
}, "role mapping must cover the complete identity exactly once");

pub def wrong_nominal_field_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_field(f::Inventory.type, f::SiteId.type, "device")
}, "typed model field has a different nominal type");

pub def nonexistent_field_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_field(f::Inventory.type, f::DeviceId.type, "missing")
}, "typed model field does not exist");

pub def optional_field_cannot_be_required: test::Test = test::should_fail_with(fn() {
    model::checked_prepare(f::inventory, [f::site_role <~ {optional: False}])
}, "nullable identity input requires an optional role");

pub def duplicate_role_id_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_prepare(f::inventory, [f::device_role, f::device_role])
}, "dataset repeats an entity role id");

pub def conflicting_entity_identity_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_prepare(f::inventory, [f::device_role, f::site_role <~ {entity: "device"}])
}, "entity id has conflicting identity types");

pub def forged_row_witness_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_prepare(f::inventory <~ {row: f::Sample.type}, [f::device_role])
}, "dataset row witness does not match its type");

pub def forged_mapping_is_rechecked: test::Test = test::should_fail_with(fn() {
    let first = f::device_role.parts[0];
    let second = f::device_role.parts[1] <~ {source: "site"};
    model::checked_prepare(f::inventory, [f::device_role <~ {parts: [first, second]}])
}, "role mapping has incompatible field types");

pub def nullable_grain_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_dataset("bad", "devices", f::Inventory.type, ["tenant", "site"])
}, "dataset grain must use non-null identity values");

pub def duplicate_grain_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_dataset("bad", "devices", f::Inventory.type, ["device", "device"])
}, "dataset grain repeats a field");

type BadIdentity = struct { local: Option(f::DeviceId) };
pub def nullable_entity_identity_is_rejected: test::Test = test::should_fail_with(fn() {
    model::checked_entity("bad", BadIdentity.type)
}, "entity identity requires non-null integer or text business values");
