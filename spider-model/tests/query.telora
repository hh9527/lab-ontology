def test_students_exact_enrolments_having = do {
    # "恰好 N 个" maps to HAVING eq N (a bare number is not widened to a lower
    # bound): assert the threshold is an equality with a single binding.
    let q = run_text(students_exact_enrolments_having_json);
    let ok_having = contains_literal(q.sql, "HAVING count(");
    let no_ge = !contains_literal(q.sql, ">= ?");
    let ok_binds = binding_count(q) == 1;
    let no_alias = !contains_literal(q.sql, "AS enrolment_count");
    if ok_having && no_ge && ok_binds && no_alias { 'True } else { fail!("exact-count HAVING (eq N) was not preserved as equality", q.sql) }
};

def test_string_fidelity_case = do {
    # String filter values must be preserved verbatim as bindings: casing is
    # never normalized, guessed or rewritten by the domain layer.
    let upper_text: String = `{"measures":[],"dimensions":[{"id":"student_first_name"}],"distinct":false,"column_order":[],"filters":[{"id":"student_first_name","op":"eq","value":"MiXeD"}],"field_filters":[],"exists":[],"absence":[],"order":[],"having":[],"limit":null,"offset":null}`;
    let lower_text: String = `{"measures":[],"dimensions":[{"id":"student_first_name"}],"distinct":false,"column_order":[],"filters":[{"id":"student_first_name","op":"eq","value":"mixed"}],"field_filters":[],"exists":[],"absence":[],"order":[],"having":[],"limit":null,"offset":null}`;
    let q1 = run_text(upper_text);
    let q2 = run_text(lower_text);
    let same_sql = q1.sql == q2.sql;
    let no_lit = !contains_literal(q1.sql, "MiXeD") && !contains_literal(q2.sql, "mixed");
    let preserved = binding_count(q1) == 1 && binding_count(q2) == 1 && q1.bindings[0] != q2.bindings[0];
    if same_sql && no_lit && preserved {
        'True
    } else {
        fail!("string filter values were not preserved verbatim")
    }
};

def test_string_fidelity_unknown_spelling = do {
    # Unknown/suspected-misspelled strings are queried verbatim (never silently
    # corrected or replaced from modeling data).
    let text: String = `{"measures":[],"dimensions":[{"id":"student_last_name"}],"distinct":false,"column_order":[],"filters":[{"id":"student_last_name","op":"eq","value":"UnknowN-SpelING"}],"field_filters":[],"exists":[],"absence":[],"order":[],"having":[],"limit":null,"offset":null}`;
    let q = run_text(text);
    let no_lit = !contains_literal(q.sql, "UnknowN-SpelING");
    let ok_binds = binding_count(q) == 1;
    if no_lit && ok_binds {
        'True
    } else {
        fail!("unknown-spelling string value was not preserved verbatim")
    }
};

# --- parameter binding / determinism / synonyms ----------------------------

def test_two_bindings_parameterized = do {
    let q = run_text(two_bindings_json);
    let ok_binds = binding_count(q) == 2;
    let no_a = !contains_literal(q.sql, "AAA");
    let no_b = !contains_literal(q.sql, "BBB");
    let ordered = q.bindings[0] != q.bindings[1];
    if ok_binds && no_a && no_b && ordered { 'True } else { fail!("two-binding parameterization failed", q.sql) }
};

def test_related_aggregate_deterministic = do {
    let a = run_text(semester_top_enrolments_json);
    let b = run_text(semester_top_enrolments_json);
    if a.sql == b.sql && a.bindings == b.bindings { 'True } else { fail!("related aggregate lowering is not deterministic") }
};

def test_synonym_consistency_supported = do {
    let s1: String = `{"measures":[],"dimensions":[{"id":"student_first_name"}],"distinct":false,"column_order":[],"filters":[{"id":"student_last_name","op":"eq","value":"AAA"}],"field_filters":[],"exists":[],"absence":[],"order":[],"having":[],"limit":null,"offset":null}`;
    let s2: String = `{"limit":null,"offset":null,"order":[],"having":[],"absence":[],"exists":[],"field_filters":[],"filters":[{"id":"student_last_name","op":"eq","value":"AAA"}],"distinct":false,"column_order":[],"dimensions":[{"id":"student_first_name"}],"measures":[]}`;
    let a = run_text(s1);
    let b = run_text(s1);
    let c = run_text(s2);
    let same_repeat = a.sql == b.sql && a.bindings == b.bindings;
    let same_synonym = a.sql == c.sql && a.bindings == c.bindings;
    if same_repeat && same_synonym { 'True } else { fail!("synonymous supported intents are not consistent") }
};

def test_synonym_consistency_unsupported = do {
    let s1: String = `{"measures":[],"dimensions":[{"id":"section_name"}],"distinct":false,"column_order":[],"filters":[],"field_filters":[],"exists":[{"target":"transcript","filters":[{"id":"transcript_date","op":"eq","value":"2020-01-01"}]}],"absence":[],"order":[],"having":[],"limit":null,"offset":null}`;
    let s2: String = `{"measures":[],"dimensions":[{"id":"section_name"}],"distinct":false,"column_order":[],"filters":[],"field_filters":[],"exists":[{"target":"transcript","filters":[{"id":"transcript_date","op":"ge","value":"2020-01-01"},{"id":"transcript_date","op":"le","value":"2020-01-01"}]}],"absence":[],"order":[],"having":[],"limit":null,"offset":null}`;
    let p1a = problem_text(s1);
    let p1b = problem_text(s1);
    let p2 = problem_text(s2);
    let same_repeat = p1a == p1b;
    let same_synonym = p1a == p2;
    let is_unsupported = match p1a {
        'Some(msg) => contains_literal(msg, "unsupported"),
        'None => 'False,
    };
    if same_repeat && same_synonym && is_unsupported { 'True } else { fail!("synonymous unreachable existence intents are not consistent") }
};

