    let ok_binds = binding_count(q) == 2;
    let first_is_english = match q.bindings[0] {
        'String(s) => s == "English",
        _ => 'False,
    };
    let second_is_five = match q.bindings[1] {
        'Int(n) => n == 5,
        _ => 'False,
    };
    let no_sort_col = !contains_literal(q.sql, "SELECT ct.Name, ct.Population");
    let no_cl_join = !contains_literal(q.sql, "JOIN countrylanguage");
    if ok_exact && ok_binds && first_is_english && second_is_five && no_sort_col && no_cl_join { 'True } else { fail!("related_hidden_row_order exact sql differs") }
};

