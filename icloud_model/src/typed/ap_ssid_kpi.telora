use ontology::registry as registry;
# SSID 样本独立声明：显式保留连接终端原始样本之和，不解释为去重终端数。
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::quantity as q;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
type SsidId = struct(
    String
);
# 来源字节数保留 Int，不能直接用 Float 表示的通用 Bytes 改变公开类型或精度。
type ByteCount = struct(
    Int
);
@registry::dataset("ap_radio_ssid_kpi", "NetworkApRadioSsidKPI", ["res_id", "tenant_id", "ts"])
@registry::roles([device])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "ap_ssid_sample_time",
                s::DateTimeUtc.type,
                True,
                [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
            ),
            g::input(m::field(NetworkApRadioSsidKPI.type, s::DateTimeUtc.type, "ts")),
            "ap_ssid_sample_time",
            True,
            [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkApRadioSsidKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "ap_radio_ssid_kpi_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkApRadioSsidKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "ap_radio_ssid_kpi_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkApRadioSsidKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "ap_radio_ssid_kpi_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "ap_ssid_connected_terminals_raw",
                q::Count.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkApRadioSsidKPI.type, q::Count.type, "connected_terminals")),
            "ap_ssid_connected_terminals_raw",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "ap_radio_ssid_kpi__hwSsidAirportRecvBytes",
                ByteCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkApRadioSsidKPI.type,
                    ByteCount.type,
                    "source_hwSsidAirportRecvBytes"
                )
            ),
            "ap_radio_ssid_kpi__hwSsidAirportRecvBytes",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "ap_radio_ssid_kpi__hwSsidAirportTransmitBytes",
                ByteCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkApRadioSsidKPI.type,
                    ByteCount.type,
                    "source_hwSsidAirportTransmitBytes"
                )
            ),
            "ap_radio_ssid_kpi__hwSsidAirportTransmitBytes",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "ap_radio_ssid_kpi__hwSsidAirportRecvBytesEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkApRadioSsidKPI.type,
                    Int.type,
                    "source_hwSsidAirportRecvBytesEffcnt"
                )
            ),
            "ap_radio_ssid_kpi__hwSsidAirportRecvBytesEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "ap_radio_ssid_kpi__hwSsidAirportTransmitBytesEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkApRadioSsidKPI.type,
                    Int.type,
                    "source_hwSsidAirportTransmitBytesEffcnt"
                )
            ),
            "ap_radio_ssid_kpi__hwSsidAirportTransmitBytesEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "ap_radio_ssid_kpi__connectedTerminalsEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(NetworkApRadioSsidKPI.type, Int.type, "source_connectedTerminalsEffcnt")
            ),
            "ap_radio_ssid_kpi__connectedTerminalsEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::metric("ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            terminal_statistics,
            m::field(NetworkApRadioSsidKPI.type, q::Count.type, "connected_terminals"),
            [
                {statistic: samples::Statistic::Sum, publish: "ap_ssid_connected_terminals"},
                {
                    statistic: samples::Statistic::Mean,
                    publish: "ap_ssid_connected_terminals_sample_avg"
                }
            ]
        ),
        samples::bind(
            dataset,
            byte_statistics,
            m::field(NetworkApRadioSsidKPI.type, ByteCount.type, "source_hwSsidAirportRecvBytes"),
            [
                {statistic: samples::Statistic::Mean, publish: "ap_ssid_receive_bytes"},
                {statistic: samples::Statistic::Max, publish: "ap_ssid_receive_bytes_max"},
                {statistic: samples::Statistic::Min, publish: "ap_ssid_receive_bytes_min"}
            ]
        ),
        samples::bind(
            dataset,
            byte_statistics,
            m::field(
                NetworkApRadioSsidKPI.type,
                ByteCount.type,
                "source_hwSsidAirportTransmitBytes"
            ),
            [
                {statistic: samples::Statistic::Mean, publish: "ap_ssid_transmit_bytes"},
                {statistic: samples::Statistic::Max, publish: "ap_ssid_transmit_bytes_max"},
                {statistic: samples::Statistic::Min, publish: "ap_ssid_transmit_bytes_min"}
            ]
        ),
    ]
)
@registry::relations(relations)
type NetworkApRadioSsidKPI = struct {
    @m::column("resId")
    @g::exact("ap_ssid_id")
    res_id: SsidId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @m::column("parentId")
    parent_id: i::DeviceId,
    ts: s::DateTimeUtc,
    @m::column("connectedTerminals")
    connected_terminals: q::Count,
    @m::column("projectId")
    @g::exact("ap_radio_ssid_kpi__projectId")
    source_projectId: String,
    @m::column("ssidName")
    @g::search("ap_radio_ssid_kpi__ssidName")
    source_ssidName: String,
    @m::column("hwSsidAirportRecvBytes")
    source_hwSsidAirportRecvBytes: ByteCount,
    @m::column("hwSsidAirportTransmitBytes")
    source_hwSsidAirportTransmitBytes: ByteCount,
    @m::column("hwSsidAirportRecvBytesEffcnt")
    source_hwSsidAirportRecvBytesEffcnt: Int,
    @m::column("hwSsidAirportTransmitBytesEffcnt")
    source_hwSsidAirportTransmitBytesEffcnt: Int,
    @m::column("connectedTerminalsEffcnt")
    source_connectedTerminalsEffcnt: Int,
};
def dataset: m::Dataset(NetworkApRadioSsidKPI) = registry::dataset_of(NetworkApRadioSsidKPI.type);
def device: m::Role(NetworkApRadioSsidKPI) = m::role(
    dataset,
    i::device,
    "device",
    False,
    [
        m::identity_part(
            m::field(NetworkApRadioSsidKPI.type, i::DeviceId.type, "parent_id"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def terminal_statistics: samples::Group(q::Count) = samples::group(
    "ssid_terminals",
    q::Count.type,
    samples::Statistic::Sum,
    [samples::Statistic::Mean],
    None
);
def byte_statistics: samples::Group(ByteCount) = samples::group(
    "ssid_bytes",
    ByteCount.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("byte")
);
def declaration: t::Declaration = registry::declaration(NetworkApRadioSsidKPI.type);
def relations: Array(r::Relation) = [
    r::relation(
        "ap_ssid_kpi_of_device",
        dataset,
        device,
        i::devices,
        i::device_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntNetworkElement_NetworkApRadioSsidKPI",
        i::devices,
        i::device_subject,
        dataset,
        device,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{declaration, relations};

pub use self::{NetworkApRadioSsidKPI};
