# Construction contracts shared by direct calls, updates and decoding.
use crate::ontology as edsl;
use crate::query as qb;
use std::test as test;
use std::codec as codec;
use std::dict as dict;
use std::value::{ Value };

def replace_field: Fn(Value, String, Value) -> Value = fn(encoded, key, value) {
    match encoded {
        Value::Object(fields) => Value::Object(dict::merge(fields, dict::from_pairs([(key, value)]))),
        _ => fail!("expected encoded object"),
    }
};

def candidate: Fn(Option(Int), Option(Int)) -> Unchecked(edsl::QueryRequest) = fn(limit, offset) {
    { measures: [], dimensions: [], filters: [], ordering: [], limit, offset, partition: None }
};
def request: Fn(Option(Int), Option(Int)) -> edsl::QueryRequest = fn(limit, offset) {
    candidate(limit, offset)
};

pub def request_valid_boundaries: test::Test = test::should_ok(fn() {
    let a = request(None, None);
    let b = request(Some(1), Some(0));
    if a.limit == None && b.offset == Some(0) { True } else { fail!("request boundary mismatch") }
});

pub def request_rejects_limit: test::Test = test::should_fail_with(fn() {
    request(Some(0), None)
}, "limit must be a positive integer");

pub def request_rejects_negative_offset: test::Test = test::should_fail_with(fn() {
    request(None, Some(-1))
}, "offset must be a non-negative integer");

pub def request_update_rechecks: test::Test = test::should_fail_with(fn() {
    request(Some(1), None) <~ { offset: Some(-1) }
}, "offset must be a non-negative integer");

pub def request_unchecked_retains_fields_before_completion: test::Test = test::should_ok(fn() {
    let draft = candidate(Some(0), Some(-1));
    if draft.limit == Some(0) && draft.offset == Some(-1) { True } else { fail!("candidate fields changed") }
});

pub def request_update_retains_fields: test::Test = test::should_ok(fn() {
    let original = request(Some(7), Some(3));
    let updated = original <~ { ordering: [] };
    if updated == original { True } else { fail!("request update lost fields") }
});

pub def request_decode_rejects_numeric_violation: test::Test = test::should_ok(fn() {
    let encoded = replace_field(codec::encode(request(Some(1), None)),
        "limit", codec::encode(Some(0)));
    match codec::decode@[edsl::QueryRequest](encoded) {
        Err(_) => True,
        Ok(_) => fail!("invalid request decoded"),
    }
});

pub def request_codec_roundtrip: test::Test = test::should_ok(fn() {
    let original = request(Some(1), Some(0));
    let decoded = codec::decode@[edsl::QueryRequest](codec::encode(original)).unwrap!();
    if decoded == original { True } else { fail!("request codec mismatch") }
});

def scalar_candidate: Fn(Array(qb::Expr)) -> Unchecked(qb::ScalarCall) = fn(args) {
    { function: qb::ScalarFunction::Length, args }
};

pub def scalar_direct_rejects: test::Test = test::should_fail_with(fn() {
    let call: qb::ScalarCall = { function: qb::ScalarFunction::Length, args: [] };
    call
}, "invalid scalar call arity");

pub def scalar_update_rechecks: test::Test = test::should_fail_with(fn() {
    let call: qb::ScalarCall = scalar_candidate([qb::bind(qb::build_context(), qb::Val::String("text")).1]);
    call <~ { args: [] }
}, "invalid scalar call arity");

pub def scalar_unchecked_rejects_on_completion: test::Test = test::should_fail_with(fn() {
    let call: qb::ScalarCall = scalar_candidate([]);
    call
}, "invalid scalar call arity");

pub def scalar_decode_rejects: test::Test = test::should_ok(fn() {
    let valid: qb::ScalarCall = scalar_candidate([qb::bind(qb::build_context(), qb::Val::String("text")).1]);
    let encoded = replace_field(codec::encode(valid), "args", Value::Array([]));
    match codec::decode@[qb::ScalarCall](encoded) {
        Err(_) => True,
        Ok(_) => fail!("invalid scalar decoded"),
    }
});

pub def scalar_codec_roundtrip: test::Test = test::should_ok(fn() {
    let original: qb::ScalarCall = scalar_candidate([qb::bind(qb::build_context(), qb::Val::String("text")).1]);
    let decoded = codec::decode@[qb::ScalarCall](codec::encode(original)).unwrap!();
    if decoded == original { True } else { fail!("scalar codec mismatch") }
});
