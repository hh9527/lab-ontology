use ontology::knowledge_policy as knowledge_policy;
# ServerPsu独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(String);
type Identity = struct { id: ComponentId };
type Row = struct {
    id: ComponentId,
    parent_res_id: server::ServerOriginId,
    tenant_id: i::TenantId,
    manufacturer: String,
    health_status: Int,
    source_name: String,
    source_redundancyMode: String,
    source_workMode: String,
    source_ratedPower: Int,
    source_sn: String,
    source_slotId: Int,
    source_psuName: String,
    source_projectId: String,
    source_resId: String,
};
def entity: m::Entity(Identity) = m::entity("server_psu_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset("server_psu", "PhysicalServerPSU", Row.type, ["id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, ComponentId.type, "id"), m::field(Identity.type, ComponentId.type, "id"))]);
def parent: m::Role(Row) = m::role(dataset, server::origin_entity, "server_origin", False, [m::identity_part(m::field(Row.type, server::ServerOriginId.type, "parent_res_id"), m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
@knowledge_policy::reverse_references(True)
type ServerPsuHealth = struct(String);
def health: v::Domain(ServerPsuHealth, Int) = v::domain("ServerPsuHealth", ServerPsuHealth.type, Int.type, [
    v::member(ServerPsuHealth("unknown"), [-2]),
    v::member(ServerPsuHealth("warning"), [1]),
    v::member(ServerPsuHealth("wire_0_92e42f8f"), [0]),
    v::member(ServerPsuHealth("wire_2_d0a68914"), [2]),
    v::member(ServerPsuHealth("wire_3_bab86ec8"), [3]),
    v::member(ServerPsuHealth("wire_4_5978b238"), [4]),
    v::member(ServerPsuHealth("wire__1_fe93bf05"), [-1]),
], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [subject, parent, tenant], [
    i::search(dataset, m::field(Row.type, String.type, "manufacturer"), "server_psu_manufacturer"),
    i::search(dataset, m::field(Row.type, String.type, "source_name"), "server_psu__name"),
    i::exact(dataset, m::field(Row.type, String.type, "source_redundancyMode"), "server_psu__redundancyMode"),
    i::exact(dataset, m::field(Row.type, String.type, "source_workMode"), "server_psu__workMode"),
    g::dimension(dataset, g::dimension_group("server_psu__ratedPower", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_ratedPower")), "server_psu__ratedPower", True, g::numeric_filters),
    i::search(dataset, m::field(Row.type, String.type, "source_sn"), "server_psu__sn"),
    g::dimension(dataset, g::dimension_group("server_psu__slotId", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_slotId")), "server_psu__slotId", True, g::numeric_filters),
    i::search(dataset, m::field(Row.type, String.type, "source_psuName"), "server_psu__psuName"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "server_psu__projectId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_resId"), "server_psu__resId"),
], []), [
    t::column(m::field(Row.type, ComponentId.type, "id"), "id"),
    t::column(m::field(Row.type, server::ServerOriginId.type, "parent_res_id"), "parentResId"),
    t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::field(Row.type, String.type, "manufacturer"), "manufacturer"),
    t::column(m::field(Row.type, Int.type, "health_status"), "healthStatus"),
    t::column(m::field(Row.type, String.type, "source_name"), "name"),
    t::column(m::field(Row.type, String.type, "source_redundancyMode"), "redundancyMode"),
    t::column(m::field(Row.type, String.type, "source_workMode"), "workMode"),
    t::column(m::field(Row.type, Int.type, "source_ratedPower"), "ratedPower"),
    t::column(m::field(Row.type, String.type, "source_sn"), "sn"),
    t::column(m::field(Row.type, Int.type, "source_slotId"), "slotId"),
    t::column(m::field(Row.type, String.type, "source_psuName"), "psuName"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::field(Row.type, String.type, "source_resId"), "resId"),
 ]), [
    v::bind(dataset, v::dimension_group(health, True, g::equality_filters), g::input(m::field(Row.type, Int.type, "health_status")), "server_psu_health", True, g::equality_filters),
]);
def tenant_cardinality: edsl::RelationCardinality = {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0};
def relations: Array(r::Relation) = [
    r::relation("psu_parent_server", dataset, parent, server::dataset, server::origin, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("source_PhysicalServer_PhysicalServerPSU", server::dataset, server::origin, dataset, parent, tenant_cardinality),
    r::relation("source_PhysicalServerPSU_X_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, tenant_cardinality),
    r::relation("psu_belongs_to_tenant", dataset, tenant, i::tenants, i::tenant_subject, tenant_cardinality),
];
pub use self::{declaration, relations};
