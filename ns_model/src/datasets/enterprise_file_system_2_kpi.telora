use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::file_system;
use crate::datasets::kpi_storage_enterprise_file_system;
@domain::subject("FileSystem", "obj_sys_id")
@domain::dataset("enterprise-file-system-2-kpi", "enterpriseFileSystem2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseFileSystem2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-file-system-2-kpi/obj_sys_id", ids::CloudBlockFileSystem2KpiByObjSysId.type, True, [g::Filter::Eq]), "efs2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("efs2_count")
    obj_sys_id: ids::CloudBlockFileSystem2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-file-system-2-kpi/obj_id", domain::Reference(ids::EnterpriseFileSystem2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "efs2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseFileSystem2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("efs2__fs", domain::endpoint(EnterpriseFileSystem2Kpi.type, "obj_sys_id"), domain::endpoint(file_system::FileSystem.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("efs2__sefs", domain::endpoint(EnterpriseFileSystem2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_file_system::KpiStorageEnterpriseFileSystem.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
