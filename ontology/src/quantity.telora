@unit("Gbit/s", "bit_rate", 1000000000.0)
type TextGigabitsPerSecond = struct(String);
type KiB = struct(Float);
type MiB = struct(Float);
type GiB = struct(Float);
# Reported counts do not imply interval deltas or additive counter semantics.
@calculations([Calculation::Compare, Calculation::Mean, Calculation::Min, Calculation::Max, Calculation::Round])
type MeanReportedCount = struct(Float);
@calculations([Calculation::Compare, Calculation::Mean, Calculation::Min, Calculation::Max, Calculation::Round])
@mean_result(MeanReportedCount.type)
type ReportedCount = struct(Int);
@calculations([Calculation::Compare, Calculation::Min, Calculation::Max, Calculation::Round,
    Calculation::Sum, Calculation::Add, Calculation::Subtract])
type EffectiveCount = struct(Int);
@unit("bit/s", "bit_rate", 1.0)
@linear
type BitsPerSecond = struct(Float);
@linear
type MeanCount = struct(Float);
@linear
@mean_result(MeanCount.type)
type Count = struct(Int);
@unit("byte", "data_size", 1.0)
@calculations(
    [
        Calculation::Compare,
        Calculation::Mean,
        Calculation::Min,
        Calculation::Max,
        Calculation::Round,
        Calculation::Difference,
        Calculation::Ratio,
        Calculation::GrowthRate,
        Calculation::Sum,
        Calculation::Add,
        Calculation::Subtract
    ]
)
type Bytes = struct(Float);
@unit("byte", "data_size", 1.0)
@linear
@mean_result(Bytes.type)
type IntegerBytes = struct(Int);
@unit("s", "time", 1.0)
@linear
type Seconds = struct(Float);
@unit("ms", "time", 0.001)
@linear
type Milliseconds = struct(Float);
@unit("byte/s", "data_rate", 1.0)
@linear
type BytesPerSecond = struct(Float);

def seconds: Fn(Milliseconds) -> Seconds = fn(value) {
    Seconds(value.0 / 1000.0)
};
def add_bytes: Fn(Bytes, Bytes) -> Bytes = fn(left, right) {
    Bytes(left.0 + right.0)
};

# 非正时长没有速率；缺失结果由调用方显式处理，不能冒充零速率。
def rate: Fn(Bytes, Seconds) -> Option(BytesPerSecond) = fn(amount, duration) {
    if duration.0 > 0.0 {
        Some(BytesPerSecond(amount.0 / duration.0))
    } else {
        None
    }
};

# 逐样本速率的平均值与累计量／累计时长是两个独立业务口径。
type Sample = struct {
    amount: Bytes,
    duration: Seconds
};
def mean_rate: Fn(Array(Sample)) -> Option(BytesPerSecond) = fn(samples) {
    let rates = array::fold(
        samples,
        [].ty!(Array(BytesPerSecond)),
        fn(values, sample) {
            match rate(sample.amount, sample.duration) {
                Some(value) => array::push(values, value),
                None => values,
            }
        }
    );
    if array::length(rates) == 0 {
        None
    } else {
        let sum = array::fold(
            rates,
            0.0,
            fn(total, value) {
                total + value.0
            }
        );
        # 同时累计 Float 个数，避免依赖隐式 Int -> Float 转换。
        let count = array::fold(
            rates,
            0.0,
            fn(total, value) {
                total + 1.0
            }
        );
        Some(BytesPerSecond(sum / count))
    }
};
def weighted_rate: Fn(Array(Sample)) -> Option(BytesPerSecond) = fn(samples) {
    let valid = array::filter(
        samples,
        fn(sample) {
            sample.duration.0 > 0.0
        }
    );
    let amount = array::fold(
        valid,
        Bytes(0.0),
        fn(total, sample) {
            add_bytes(total, sample.amount)
        }
    );
    let duration = array::fold(
        valid,
        0.0,
        fn(total, sample) {
            total + sample.duration.0
        }
    );
    rate(amount, Seconds(duration))
};

