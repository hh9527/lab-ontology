pub mod model;
# 开发审计通过 @src/source_audit 显式访问，不参与服务初始化
pub mod typed;

use crate::model::{ payload };
use ontology::intent as intent;
use ontology::sqlite as sqlite;
use std::transform_service as service;
use std::http as http;
use std::value::{ Value };

type QueryService = struct { lower: Fn(Value) -> Value };
impl service::TransformService for QueryService {
    init: fn(ctx) {
        { lower: intent::query_request_method_factory(payload, sqlite::build_query) }.ty!(Self)
    },
    transform: fn(self, input) { self.lower(input) },
};

@service::collection
pub type MainService = struct {
    @service::slot("ic/transform") @http::post("/ic/transform") query: QueryService,
};
