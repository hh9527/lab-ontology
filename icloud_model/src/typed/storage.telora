]), [t::field_count(dataset, m::field(Row.type, String.type, "name"), "storage_device_named_count")]);
def cardinality: edsl::RelationCardinality = {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional};
def relations: Array(r::Relation) = [
    r::relation("storage_device_belongs_to_tenant", dataset, tenant, i::tenants, i::tenant_subject, cardinality),
    r::relation("source_HuaweiStorageDeviceAssociationX_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, cardinality),
];
def alternatives: Array(t::Alternative) = [
    {id: "storage_device_site", cardinality, choices: [r::relation("storage_device_site_parent", dataset, parent_site, site::dataset, site::subject, cardinality), r::relation("storage_device_site_project", dataset, project_site, site::dataset, site::subject, cardinality)]},
    {id: "source_HuaweiStorageDeviceAssociationX_SITE_VIEW", cardinality, choices: [r::relation("source_HuaweiStorageDeviceAssociationX_SITE_VIEW_parent", dataset, parent_site, site::dataset, site::subject, cardinality), r::relation("source_HuaweiStorageDeviceAssociationX_SITE_VIEW_project", dataset, project_site, site::dataset, site::subject, cardinality)]},
];
pub use self::{StorageId, Identity, entity, dataset, subject, declaration, relations, alternatives};
