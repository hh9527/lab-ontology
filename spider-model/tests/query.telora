};

def test_field_filter_illegal_pair = do {
    let text: String = `{"measures":[],"dimensions":[{"id":"student_id"}],"distinct":false,"column_order":[],"filters":[],"field_filters":[{"left":"student_first_name","right":"student_current_address","op":"eq"}],"exists":[],"absence":[],"order":[],"having":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "unsupported") {
            'True
        } else {
            fail!("illegal field-to-field pair should be unsupported", msg)
        },
        'None => fail!("type-incompatible field-to-field pair was accepted"),
    }
};

def test_related_aggregate_no_relation = do {
    # Section has no declared direct relation to transcripts, so an internal
    # ordering measure on transcripts is rejected, not approximated.
    let text: String = `{"measures":[],"dimensions":[{"id":"section_name"}],"distinct":false,"column_order":[],"filters":[],"field_filters":[],"exists":[],"absence":[],"order":[{"measure":"transcript_count","dimension":null,"direction":"desc"}],"having":[],"limit":1,"offset":null}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "unsupported") {
            'True
        } else {
            fail!("related aggregate without a direct relation should be unsupported", msg)
        },
        'None => fail!("related aggregate without a direct relation was accepted"),
    }
};

def test_ordering_unselected_measure = do {
    let text: String = `{"measures":[{"id":"student_count","mode":"all"}],"dimensions":[],"distinct":false,"column_order":[],"filters":[],"field_filters":[],"exists":[],"absence":[],"order":[{"measure":"student_current_address_count","dimension":null,"direction":"desc"}],"having":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "unsupported") {
            'True
        } else {
            fail!("ordering by an unreturned aggregate should be unsupported", msg)
        },
        'None => fail!("ordering by an unselected measure was accepted"),
    }
};

def test_offset_without_ordering = do {
    let text: String = `{"measures":[{"id":"student_count","mode":"all"}],"dimensions":[],"distinct":false,"column_order":[],"filters":[],"field_filters":[],"exists":[],"absence":[],"order":[],"having":[],"limit":null,"offset":5}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("offset without ordering was accepted"),
    }
};

def test_nonpositive_limit = do {
    let text: String = `{"measures":[],"dimensions":[{"id":"address_city"}],"distinct":false,"column_order":[],"filters":[],"field_filters":[],"exists":[],"absence":[],"order":[],"having":[],"limit":0,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("non-positive limit was accepted"),
    }
};

