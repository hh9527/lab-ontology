use ontology::semantic as domain;
# 服务器采样独立声明，Latest 采用权威UTC时钟与完整采样grain
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::quantity::{Percent, Watts};
@domain::subject("Server", "res_id")
@domain::dataset("server_kpi", "ServerDeviceKPI", ["res_id", "tenant_id", "ts"])
@domain::metric("ts")
@domain::relations(relations)
type ServerDeviceKPI = struct {
    @m::column("resId")
    res_id: domain::Reference(server::ServerById),
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @g::field_view(
        g::dimension_group(
            "server_kpi_ts_raw",
            s::DateTimeUtc.type,
            True,
            [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
        ),
        "server_kpi_ts_raw",
        True,
        [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
    )
    @g::utc_bucket_view("server_kpi_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("server_kpi_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("server_kpi_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("memUsage")
    @g::field_view(
        g::dimension_group("server_memory_sample", Percent.type, True, g::numeric_filters),
        "server_memory_sample",
        True,
        g::numeric_filters
    )
    @samples::field(
        statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "server_memory_usage"},
            {statistic: samples::Statistic::Latest, publish: "server_memory_latest"},
            {statistic: samples::Statistic::Max, publish: "server_memory_sample_max"},
            {statistic: samples::Statistic::Min, publish: "server_memory_sample_min"}
        ]
    )
    mem_usage: Percent,
    @m::column("cpuUsage")
    @g::field_view(
        g::dimension_group("server_cpu_sample", Percent.type, True, g::numeric_filters),
        "server_cpu_sample",
        True,
        g::numeric_filters
    )
    @samples::field(
        statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "server_cpu_usage"},
            {statistic: samples::Statistic::Latest, publish: "server_cpu_latest"},
            {statistic: samples::Statistic::Max, publish: "server_cpu_peak"},
            {statistic: samples::Statistic::Min, publish: "server_cpu_sample_min"}
        ]
    )
    cpu_usage: Percent,
    @m::column("averagePower")
    @g::field_view(
        g::dimension_group("server_average_power_sample", Watts.type, True, g::numeric_filters),
        "server_average_power_sample",
        True,
        g::numeric_filters
    )
    @samples::field(
        power_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "server_average_power"},
            {statistic: samples::Statistic::Max, publish: "server_average_power_max"},
            {statistic: samples::Statistic::Min, publish: "server_average_power_min"}
        ]
    )
    average_power: Watts,
    @m::column("parentId")
    @g::exact("server_kpi__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("server_kpi__projectId")
    source_projectId: String,
    @m::column("systemPower")
    @g::field_view(
        g::dimension_group("server_kpi__systemPower", Watts.type, True, g::numeric_filters),
        "server_kpi__systemPower",
        True,
        g::numeric_filters
    )
    @samples::field(
        power_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "server_system_power"},
            {statistic: samples::Statistic::Max, publish: "server_system_power_max"},
            {statistic: samples::Statistic::Min, publish: "server_system_power_min"}
        ]
    )
    source_systemPower: Watts,
    @m::column("peakPower")
    @g::field_view(
        g::dimension_group("server_kpi__peakPower", Watts.type, True, g::numeric_filters),
        "server_kpi__peakPower",
        True,
        g::numeric_filters
    )
    @samples::field(
        power_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "server_peak_power"},
            {statistic: samples::Statistic::Max, publish: "server_peak_power_max"},
            {statistic: samples::Statistic::Min, publish: "server_peak_power_min"}
        ]
    )
    source_peakPower: Watts,
    @m::column("cpuUsageEffcnt")
    @g::field_view(
        g::dimension_group("server_kpi__cpuUsageEffcnt", Int.type, True, g::numeric_filters),
        "server_kpi__cpuUsageEffcnt",
        True,
        g::numeric_filters
    )
    source_cpuUsageEffcnt: Int,
    @m::column("memUsageEffcnt")
    @g::field_view(
        g::dimension_group("server_kpi__memUsageEffcnt", Int.type, True, g::numeric_filters),
        "server_kpi__memUsageEffcnt",
        True,
        g::numeric_filters
    )
    source_memUsageEffcnt: Int,
    @m::column("systemPowerEffcnt")
    @g::field_view(
        g::dimension_group("server_kpi__systemPowerEffcnt", Int.type, True, g::numeric_filters),
        "server_kpi__systemPowerEffcnt",
        True,
        g::numeric_filters
    )
    source_systemPowerEffcnt: Int,
    @m::column("averagePowerEffcnt")
    @g::field_view(
        g::dimension_group("server_kpi__averagePowerEffcnt", Int.type, True, g::numeric_filters),
        "server_kpi__averagePowerEffcnt",
        True,
        g::numeric_filters
    )
    source_averagePowerEffcnt: Int,
    @m::column("peakPowerEffcnt")
    @g::field_view(
        g::dimension_group("server_kpi__peakPowerEffcnt", Int.type, True, g::numeric_filters),
        "server_kpi__peakPowerEffcnt",
        True,
        g::numeric_filters
    )
    source_peakPowerEffcnt: Int,
};
def owner: r::Endpoint = domain::endpoint(ServerDeviceKPI.type, "res_id");
def statistics: samples::Group(Percent) = samples::group(
    "server_percent",
    Percent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Latest, samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
def power_statistics: samples::Group(Watts) = samples::group(
    "server_power",
    Watts.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("W")
);
def relations: Array(r::Relation) = [
    r::relation(
        "server_kpi_of_server",
        owner,
        server::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_ServerDeviceKPI",
        server::subject,
        owner,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{ServerDeviceKPI};
