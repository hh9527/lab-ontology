pub def frame_context_pairs_independent_device_kpi_and_alarm_measures: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph_pair",
        "left":{"op":"graph","root":"frame",
            "nodes":[{"id":"frame","entity":"frame"},{"id":"device","entity":"device"},
                     {"id":"kpi","entity":"device_kpi"}],
            "edges":[{"relation":"frame_belongs_to_device","from":"frame","to":"device"},
                     {"relation":"device_kpi_of_device","from":"kpi","to":"device"}],
            "select":[{"node":"frame","dimension":"frame_name"},{"node":"device","dimension":"device_name"}],
            "measures":[{"node":"kpi","measure":"port_count"}],"group_by_identity":["frame","device"],
            "filters":[{"node":"kpi","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                       {"node":"kpi","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-01 00:00:00"}],
            "measure_having":[{"node":"kpi","measure":"port_count","op":"gt","kind":"int","value":10}]},
        "right":{"op":"graph","root":"frame",
            "nodes":[{"id":"frame","entity":"frame"},{"id":"device","entity":"device"},
                     {"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"frame_belongs_to_device","from":"frame","to":"device"},
                     {"relation":"device_current_alarm","from":"alarm","to":"device"}],
            "select":[{"node":"frame","dimension":"frame_name"},{"node":"device","dimension":"device_name"}],
            "measures":[{"node":"alarm","measure":"critical_or_major_alarm_count"}],
            "group_by_identity":["frame","device"],
            "measure_having":[{"node":"alarm","measure":"critical_or_major_alarm_count","op":"gt","kind":"int","value":2}]}}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "sum(kpi.portCount) AS kpi_port_count")
        && string::contains(sq.sql, "AS alarm_critical_or_major_alarm_count")
        && string::contains(sq.sql, "HAVING sum(kpi.portCount) >")
        && string::contains(sq.sql, "HAVING (count(alarm.CSN)")
        && string::contains(sq.sql, "__q_left.__q_key_4 = __q_right.__q_key_4")
        && string::contains(sq.sql, "__q_left.__q_key_5 = __q_right.__q_key_5")
        && !string::contains(sq.sql, "kpi.resId = alarm.MEDN")
        && string::contains(pg.sql, "sum(\"kpi\".\"portCount\")")
        && sq.bindings == pg.bindings { True }
    else { fail!(`contextual KPI/alarm pair lost separate populations or either identity: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

