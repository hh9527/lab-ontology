# Time inputs are normalized against the Model's logical time role before binding.
use crate::ontology as edsl;
use std::array as array;

type TimeValue = enum {
    Date(String),
    LocalDateTime(String),
    Utc1(String),
    Rfc3339(String),
    EpochMillis(Int),
};

type Window = struct { start: TimeValue, end: Option(TimeValue) };

def input: Fn(edsl::TimeField, TimeValue, String) -> edsl::FilterInput = fn(role, value, dimension) {
    match (role.encoding, value) {
        (edsl::TimeEncoding::DateText, TimeValue::Date(text)) =>
            if edsl::calendar_date(text) { edsl::FilterInput::Date(text) }
            else { fail!("invalid calendar date boundary", dimension, text) },
        (edsl::TimeEncoding::Rfc3339Text, TimeValue::Rfc3339(text)) =>
            if edsl::canonical_rfc3339(text) { edsl::FilterInput::Rfc3339(text) }
            else { fail!("invalid canonical RFC3339 UTC second value", dimension, text) },
        (edsl::TimeEncoding::CanonicalUtcSecondText, TimeValue::Utc1(text)) =>
            if edsl::canonical_utc_second(text) { edsl::FilterInput::Utc1(text) }
            else { fail!("invalid canonical UTC second boundary", dimension, text) },
        (edsl::TimeEncoding::EpochMillis, TimeValue::EpochMillis(ms)) =>
            edsl::FilterInput::EpochMillis(ms),
        (edsl::TimeEncoding::LocalText, TimeValue::LocalDateTime(text)) =>
            if edsl::canonical_utc_second(text) { edsl::FilterInput::LocalDateTime(text) }
            else { fail!("invalid local datetime boundary", dimension, text) },
        _ => fail!("time boundary does not match declared field encoding", dimension, role, value),
    }
};

def before: Fn(TimeValue, TimeValue, String) -> Bool = fn(start, end, dimension) {
    match (start, end) {
        (TimeValue::EpochMillis(a), TimeValue::EpochMillis(b)) => a < b,
        (TimeValue::Utc1(a), TimeValue::Utc1(b)) => a < b,
        (TimeValue::Rfc3339(a), TimeValue::Rfc3339(b)) => a < b,
        (TimeValue::Date(a), TimeValue::Date(b)) => if edsl::calendar_date(a) && edsl::calendar_date(b) { a < b }
            else { fail!("invalid calendar date boundary", dimension, a, b) },
        # A local clock cannot be compared across daylight-saving transitions
        # without a zone and ambiguity policy supplied by the caller.
        (TimeValue::LocalDateTime(_), TimeValue::LocalDateTime(_)) =>
            fail!("local time window requires externally resolved instant boundaries", dimension),
        _ => fail!("time window boundaries have different logical types", dimension, start, end),
    }
};

def window_filters: Fn(edsl::PreparedPayload, String, Window) -> Array(edsl::FilterRequest) =
    fn(payload, dimension, window) {
        let detail = edsl::visible_dimension_detail(payload, dimension);
        if !detail.filterable || !array::any(detail.ops, fn(op) { op == edsl::FilterOp::Ge }) {
            fail!("time dimension does not support lower-bound range filters", dimension)
        } else {
            let role = edsl::time_domain(payload, detail.dataset, detail.field);
            let start = input(role, window.start, dimension);
            let lower: edsl::FilterRequest = {id: dimension, op: edsl::FilterOp::Ge, input: start};
            match window.end {
                None => [lower],
                Some(end) => if !array::any(detail.ops, fn(op) { op == edsl::FilterOp::Lt }) {
                    fail!("time dimension does not support upper-bound range filters", dimension)
                } else if !before(window.start, end, dimension) {
                    fail!("time window start must precede end", dimension, window)
                } else {
                    [lower, {id: dimension, op: edsl::FilterOp::Lt,
                        input: input(role, end, dimension)}]
                },
            }
        }
    };

pub use self::{TimeValue, Window, window_filters};
