        && array::length(string::split(q.sql, "INNER JOIN X_TENANT_VIEW AS t ON s.TENANT_ID = t.TENANT_ID")) == 2
        && array::length(string::split(q.sql, "sf.parentResId = sv.oriResId")) == 2
        && array::length(string::split(q.sql, "sf.tenantId = t.TENANT_ID")) == 2
        && array::length(string::split(q.sql, "sv.tenantId = t.TENANT_ID")) == 2
        && q.bindings == [qb::Val::String("Huawei"), qb::Val::String("ne.category.server.subrack"),
            qb::Val::String("Site-A"), qb::Val::String("Tenant-A"), qb::Val::Int(1000)] {
        True
    } else { fail!("Q0190 must qualify fan identities through declared three-hop ownership", q) }
});

pub def server_fan_site_scope_counts_fans_not_parent_names: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"qualify_child_site","measures":["server_fan_count"],"dimensions":[],"filters":[],"ordering":[],"limit":null,"offset":null,"parent_relation":"fan_parent_server","site_relation":"server_located_at_site","tenant_relation":"site_belongs_to_tenant","child_tenant_relation":"fan_belongs_to_tenant","parent_tenant_relation":"server_belongs_to_tenant","parent_filters":[{"dimension":"server_manufacturer","op":"eq","kind":"text","value":"Huawei"}],"site_filters":[{"dimension":"site_name","op":"eq","kind":"text","value":"Site-A"}],"tenant_filters":[{"dimension":"tenant_name","op":"eq","kind":"text","value":"Tenant-A"}]}`);
    if array::length(string::split(q.sql, "count(sf.id)")) == 2
        && array::length(string::split(q.sql, "JOIN PhysicalServer")) == 1
        && array::length(string::split(q.sql, "EXISTS (")) == 2 {
        True
    } else { fail!("fan qualification must count child IDs without joining parents into the outer query", q) }
});

