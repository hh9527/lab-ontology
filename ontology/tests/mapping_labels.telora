use ontology::values as v;
use ontology::enum_values as ev;
use std::test;

type Kind = enum {
    @ev::description("WAC", "无线控制器")
    Wac,
    Router
};
def mapped: v::Domain(Kind, String) = v::domain("kind", Kind.type, String.type, [v::member(Kind::Wac, ["ac", "wac"]), v::member(Kind::Router, ["router"])], False);
pub def descriptions_preserve_business_id_and_wire: test::Test = test::should_ok(fn() {
    let values = mapped.definition.values;
    if values[0].id != "Wac" || values[0].label != "WAC" || values[1].label != "Router" {
        fail!("mapping must preserve business ids and explicit display labels")
    } else { () }
});
