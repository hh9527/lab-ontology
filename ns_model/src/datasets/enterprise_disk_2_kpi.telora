use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::storage_disk;
use crate::datasets::kpi_storage_enterprise_disk;
@domain::subject("StorageDisk", "obj_sys_id")
@domain::dataset("enterprise-disk-2-kpi", "enterpriseDisk2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseDisk2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-disk-2-kpi/obj_sys_id", ids::CloudBlockDisk2KpiByObjSysId.type, True, [g::Filter::Eq]), "ed2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("ed2_count")
    obj_sys_id: ids::CloudBlockDisk2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-disk-2-kpi/obj_id", domain::Reference(ids::EnterpriseDisk2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "ed2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseDisk2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("ed2__sd", domain::endpoint(EnterpriseDisk2Kpi.type, "obj_sys_id"), domain::endpoint(storage_disk::StorageDisk.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ed2__sed", domain::endpoint(EnterpriseDisk2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_disk::KpiStorageEnterpriseDisk.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
