# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::samples as samples;
use ontology::experimental::transform as t;
use ontology::query as qb;
type ResourceId = struct(String);
type EffectiveCount = struct(Int);
type Row = struct {
    source_ts: s::DateTimeUtc,
    source_resId: ResourceId,
    source_tenantId: i::TenantId,
    source_parentId: String,
    source_projectId: String,
    source_cpuUsage: p::Percent,
    source_memUsage: p::Percent,
    source_hwEntityTemperature: p::DegreesCelsius,
    source_cpuUsageEffcnt: EffectiveCount,
    source_memUsageEffcnt: EffectiveCount,
    source_hwEntityTemperatureEffcnt: EffectiveCount,
};
def dataset: m::Dataset(Row) = m::dataset("source_NetworkDeviceBoardKPI", "NetworkDeviceBoardKPI", Row.type, ["source_resId", "source_tenantId", "source_ts"]);
def raw: t::Declaration = t::map_columns(t::declare(dataset, [], [
    g::dimension(dataset, g::dimension_group("source_NetworkDeviceBoardKPI__ts", s::DateTimeUtc.type, True, g::numeric_filters), g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), "source_NetworkDeviceBoardKPI__ts", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Hour), "source_NetworkDeviceBoardKPI_utc_hour", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Day), "source_NetworkDeviceBoardKPI_utc_day", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Month), "source_NetworkDeviceBoardKPI_utc_month", True, g::time_filters),
    i::exact(dataset, m::field(Row.type, ResourceId.type, "source_resId"), "source_NetworkDeviceBoardKPI__resId"),
    i::exact(dataset, m::field(Row.type, i::TenantId.type, "source_tenantId"), "source_NetworkDeviceBoardKPI__tenantId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_parentId"), "source_NetworkDeviceBoardKPI__parentId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "source_NetworkDeviceBoardKPI__projectId"),
    g::dimension(dataset, g::dimension_group("source_NetworkDeviceBoardKPI__cpuUsage", p::Percent.type, True, g::numeric_filters), g::input(m::field(Row.type, p::Percent.type, "source_cpuUsage")), "source_NetworkDeviceBoardKPI__cpuUsage", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkDeviceBoardKPI__memUsage", p::Percent.type, True, g::numeric_filters), g::input(m::field(Row.type, p::Percent.type, "source_memUsage")), "source_NetworkDeviceBoardKPI__memUsage", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkDeviceBoardKPI__hwEntityTemperature", p::DegreesCelsius.type, True, g::numeric_filters), g::input(m::field(Row.type, p::DegreesCelsius.type, "source_hwEntityTemperature")), "source_NetworkDeviceBoardKPI__hwEntityTemperature", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkDeviceBoardKPI__cpuUsageEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_cpuUsageEffcnt")), "source_NetworkDeviceBoardKPI__cpuUsageEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkDeviceBoardKPI__memUsageEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_memUsageEffcnt")), "source_NetworkDeviceBoardKPI__memUsageEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkDeviceBoardKPI__hwEntityTemperatureEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_hwEntityTemperatureEffcnt")), "source_NetworkDeviceBoardKPI__hwEntityTemperatureEffcnt", True, g::numeric_filters),
], []), [
    t::column(m::field(Row.type, s::DateTimeUtc.type, "source_ts"), "ts"),
    t::column(m::field(Row.type, ResourceId.type, "source_resId"), "resId"),
    t::column(m::field(Row.type, i::TenantId.type, "source_tenantId"), "tenantId"),
    t::column(m::field(Row.type, String.type, "source_parentId"), "parentId"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::field(Row.type, p::Percent.type, "source_cpuUsage"), "cpuUsage"),
    t::column(m::field(Row.type, p::Percent.type, "source_memUsage"), "memUsage"),
    t::column(m::field(Row.type, p::DegreesCelsius.type, "source_hwEntityTemperature"), "hwEntityTemperature"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_cpuUsageEffcnt"), "cpuUsageEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_memUsageEffcnt"), "memUsageEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_hwEntityTemperatureEffcnt"), "hwEntityTemperatureEffcnt"),
]);
def declaration: t::Declaration = t::with_samples(t::metric(raw, m::field(Row.type, s::DateTimeUtc.type, "source_ts")), [
    samples::bind(dataset, p::Percent_statistics, m::field(Row.type, p::Percent.type, "source_cpuUsage"), [{statistic: samples::Statistic::Mean, publish: "board_cpu_usage"}, {statistic: samples::Statistic::Max, publish: "board_cpu_usage_max"}, {statistic: samples::Statistic::Min, publish: "board_cpu_usage_min"}]),
    samples::bind(dataset, p::Percent_statistics, m::field(Row.type, p::Percent.type, "source_memUsage"), [{statistic: samples::Statistic::Mean, publish: "board_memory_usage"}, {statistic: samples::Statistic::Max, publish: "board_memory_usage_max"}, {statistic: samples::Statistic::Min, publish: "board_memory_usage_min"}]),
    samples::bind(dataset, p::DegreesCelsius_statistics, m::field(Row.type, p::DegreesCelsius.type, "source_hwEntityTemperature"), [{statistic: samples::Statistic::Mean, publish: "board_temperature"}, {statistic: samples::Statistic::Max, publish: "board_temperature_max"}, {statistic: samples::Statistic::Min, publish: "board_temperature_min"}]),
]);
pub use self::{declaration};
