@domain::relations(relations)
pub type Lun = struct {
    @g::field_view(g::dimension_group("lun/id", ids::LunById.type, True, [g::Filter::Eq]), "lu_id", True, [g::Filter::Eq])
    @domain::count("lu_count")
    id: ids::LunById,
