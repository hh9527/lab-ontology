use std::string as string;
use std::test as test;
use crate::query as qb;
use crate::postgres as pg;

pub def source_hint_allocates_stable_join_aliases: test::Test = test::should_ok(fn() {
    let first = qb::source_with_hint(qb::build_context(), "table1", "t");
    let second = qb::source_with_hint(first.0, "table2", "t");
    let third = qb::source_with_hint(second.0, "table3", "t");
    let plan: qb::Plan = {
        revision: "alias-allocation", sources: [first.1],
        joins: [qb::join(qb::JoinKind::Inner, second.1,
            qb::column_ref(first.1.alias, "id"), qb::column_ref(second.1.alias, "parent_id")),
            qb::join(qb::JoinKind::Inner, third.1,
            qb::column_ref(second.1.alias, "id"), qb::column_ref(third.1.alias, "parent_id"))],
        projection: [qb::expr_item(qb::column(third.1.alias, "id"))],
        filter: None, grouping: [], having: [], ordering: [], limit: None, offset: None,
        exists: [], derived: None, partition: None, scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if first.1.alias == "t" && second.1.alias == "t_2" && third.1.alias == "t_3"
        && string::contains(query.sql, "SELECT \"t_3\".\"id\" FROM \"table1\" AS \"t\"")
        && string::contains(query.sql, "\"t\".\"id\" = \"t_2\".\"parent_id\"")
        && string::contains(query.sql, "\"t_2\".\"id\" = \"t_3\".\"parent_id\"") {
        True
    } else { fail!("source hints must allocate stable reusable aliases", query) }
});

pub def projected_columns_allocate_from_source_handle: test::Test = test::should_ok(fn() {
    let root = qb::source_with_hint(qb::build_context(), "teams", "t");
    let child = qb::source_with_hint(root.0, "members", "t");
    let first = qb::project_column(child.0, root.1, "name", "display");
    let second = qb::project_column(first.0, child.1, "name", "display");
    let plan: qb::Plan = {
        revision: "allocated-projection", sources: [root.1],
        projection: [first.1, second.1],
        joins: [qb::join(qb::JoinKind::Inner, child.1,
            qb::source_column_ref(root.1, "id"), qb::source_column_ref(child.1, "team_id"))],
        filter: None, grouping: [], having: [], ordering: [], limit: None, offset: None,
        exists: [], derived: None, partition: None, scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if string::contains(query.sql, "\"t\".\"name\" AS \"display\", \"t_2\".\"name\" AS \"display_2\"")
        && string::contains(query.sql, "\"t\".\"id\" = \"t_2\".\"team_id\"") {
        True
    } else { fail!("constructed source/column symbols must survive PostgreSQL materialization", query) }
});

pub def allocated_binding_reuses_physical_placeholder: test::Test = test::should_ok(fn() {
    let first = qb::bind(qb::build_context(), qb::Val::Int(1));
    let second = qb::bind(first.0, qb::Val::Int(2));
    let expr = qb::scalar(qb::ScalarFunction::And, [
        qb::scalar(qb::ScalarFunction::Eq, [first.1, second.1]),
        qb::scalar(qb::ScalarFunction::Eq, [first.1, second.1]),
    ]);
    let query = pg::render_expr_with_context(expr, second.0);
    if query.sql == "($1 = $2 AND $1 = $2)" && query.bindings == [qb::Val::Int(1), qb::Val::Int(2)] {
        True
    } else { fail!("binding handles must retain their physical placeholder across reuse", query) }
});

pub def constructed_rows_preserve_binding_handles: test::Test = test::should_ok(fn() {
    let root = qb::source_with_hint(qb::build_context(), "events", "e");
    let bound = qb::bind(root.0, qb::Val::Int(7));
    let predicate = qb::scalar(qb::ScalarFunction::Eq, [
        qb::source_column(root.1, "kind"), bound.1,
    ]);
    let plan: qb::Plan = {
        revision: "constructed-rows", sources: [root.1], joins: [],
        projection: [qb::expr_item(bound.1)], filter: Some(predicate),
        grouping: [], having: [], ordering: [], limit: None, offset: None,
        exists: [], derived: None, partition: None, scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_query_plan_with_context(qb::QueryPlan::Rows(plan), bound.0);
    let set: qb::SetPlan = {kind: qb::SetOpKind::Union, left: plan, right: plan};
    let union = pg::render_query_plan_with_context(qb::QueryPlan::SetRows(set), bound.0);
    if query.sql == "SELECT $1 FROM \"events\" AS \"e\" WHERE \"e\".\"kind\" = $1"
        && query.bindings == [qb::Val::Int(7)]
        && string::contains(union.sql, "WHERE \"e\".\"kind\" = $1 UNION SELECT $1")
        && union.bindings == [qb::Val::Int(7)] { True }
    else { fail!("full AST materialization must keep construction-time bindings", query, union) }
});

pub def constructed_query_rejects_unregistered_binding: test::Test = test::should_fail_with(fn() {
    let allocated = qb::bind(qb::build_context(), qb::Val::Int(7));
    let plan: qb::Plan = {
        revision: "missing-binding", sources: [qb::source("e", "events")], joins: [],
        projection: [qb::expr_item(allocated.1)], filter: None,
        grouping: [], having: [], ordering: [], limit: None, offset: None,
        exists: [], derived: None, partition: None, scalar_comparisons: [], ranked_key_comparisons: [],
    };
    pg::render_query_plan_with_context(qb::QueryPlan::Rows(plan), qb::build_context())
}, "binding handle is not registered in builder context");

pub def constructed_having_uses_existing_binding_handle: test::Test = test::should_ok(fn() {
    let bound = qb::bind(qb::build_context(), qb::Val::Int(2));
    let plan: qb::Plan = {
        revision: "constructed-having", sources: [qb::source("e", "events")], joins: [],
        projection: [qb::aggregate(qb::AggregateFunction::Count, qb::column("e", "id"), False, "hits")],
        filter: Some(qb::scalar(qb::ScalarFunction::Gt, [qb::column("e", "id"), bound.1])),
        grouping: [], having: [qb::having_bound(qb::HavingOp::Gt, "hits", bound.1)],
        ordering: [], limit: None, offset: None, exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_query_plan_with_context(qb::QueryPlan::Rows(plan), bound.0);
    if string::contains(query.sql, "WHERE \"e\".\"id\" > $1 HAVING count(\"e\".\"id\") > $1")
        && query.bindings == [qb::Val::Int(2)] { True }
    else { fail!("HAVING must reuse its constructed binding handle", query) }
});

pub def nested_json_bind_order: test::Test = test::should_ok(fn() {
    let path = qb::json_path([qb::JsonPathSegment::Key("a.b"), qb::JsonPathSegment::FromEnd(1)]);
    let predicate = qb::scalar(qb::ScalarFunction::Eq, [
        qb::json_extract(qb::column("MixedAlias", "PayloadJSON"), path, qb::JsonScalarKind::Int),
        qb::bind_int(20),
    ]);
    let query = pg::render_expr(predicate, 4);
    if query.sql == `(json_extract_path_text("MixedAlias"."PayloadJSON"::json, VARIADIC ARRAY[$4::text, $5::text]))::bigint = $6`
        && query.bindings == [qb::Val::String("a.b"), qb::Val::String("-1"), qb::Val::Int(20)] {
        True
    } else { fail!("PostgreSQL JSON expression must number path and filter bindings in SQL order", query) }
});

pub def root_path_has_no_binding: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::json_type(qb::bind_string("42"), qb::json_path([])), 1);
    if query.bindings == [qb::Val::String("42")]
        && string::contains(query.sql, "VARIADIC ARRAY[]::text[]")
        && string::contains(query.sql, "json_typeof(") {
        True
    } else { fail!("root path must not add phantom placeholders", query) }
});

pub def repeated_operand_uses_one_binding: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::json_valid(qb::bind_string("{\"x\":1}")), 1);
    if query.bindings == [qb::Val::String("{\"x\":1}")]
        && string::contains(query.sql, "$1 IS NULL")
        && string::contains(query.sql, "pg_input_is_valid($1::text, 'json')") {
        True
    } else { fail!("a repeated PG placeholder must not duplicate the binding", query) }
});

pub def ascii_only_case_fold: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::lower(qb::bind_string("ABCÉ")), 2);
    if query.sql == "translate($2, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')"
        && query.bindings == [qb::Val::String("ABCÉ")] {
        True
    } else { fail!("PG lower must preserve SQLite ASCII-only semantics", query) }
});

pub def invalid_column_identifier: test::Test = test::should_fail_with(fn() {
    pg::render_expr(qb::column("e", "invalid\"name"), 1)
}, "invalid PostgreSQL column identifier");

pub def invalid_placeholder_start: test::Test = test::should_fail_with(fn() {
    pg::render_expr(qb::bind_int(3), 0)
}, "PostgreSQL placeholder index must be positive");

pub def internal_alias_skips_reserved_names: test::Test = test::should_ok(fn() {
    let first = pg::internal_alias(pg::context(1, ["__q_0", "__q_2"]));
    let second = pg::internal_alias(first.1);
    if first.0 == "__q_1" && second.0 == "__q_3" { True }
    else { fail!("immutable context must allocate collision-free internal aliases") }
});

pub def rows_assign_resources_in_sql_order: test::Test = test::should_ok(fn() {
    let base: qb::Plan = {
        revision: "pg-rows",
        sources: [qb::scoped_source("Mixed", "Orders", qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("Mixed", "Role"), qb::bind_string("root")]))],
        projection: [qb::expr_item(qb::bind_string("project")), qb::expr_item(qb::column("Mixed", "Id"))],
        joins: [qb::join_on(qb::JoinKind::Left,
            qb::scoped_source("Child", "Customers", qb::scalar(qb::ScalarFunction::Eq,
                [qb::column("Child", "Role"), qb::bind_string("joined")])),
            qb::on_and([
                qb::on_eq(qb::column_ref("Mixed", "Id"), qb::column_ref("Child", "OwnerId")),
                qb::on_predicate(qb::scalar(qb::ScalarFunction::Eq,
                    [qb::column("Child", "Level"), qb::bind_int(7)])),
            ]))],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("Mixed", "Role"), qb::bind_string("root")])),
        grouping: [], having: [],
        ordering: [qb::asc(qb::column("Mixed", "Id"))],
        limit: None, offset: Some(2),
        exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(base, False);
    if query.bindings == [qb::Val::String("project"), qb::Val::String("root"),
        qb::Val::String("joined"), qb::Val::Int(7), qb::Val::String("root"), qb::Val::Int(2)]
        && string::contains(query.sql, "SELECT $1, \"Mixed\".\"Id\" FROM (SELECT * FROM \"Orders\" AS \"Mixed\" WHERE \"Mixed\".\"Role\" = $2) AS \"Mixed\"")
        && string::contains(query.sql, "LEFT JOIN (SELECT * FROM \"Customers\" AS \"Child\" WHERE \"Child\".\"Role\" = $3) AS \"Child\" ON (\"Mixed\".\"Id\" = \"Child\".\"OwnerId\" AND \"Child\".\"Level\" = $4)")
        && string::contains(query.sql, "WHERE \"Mixed\".\"Role\" = $5 ORDER BY \"Mixed\".\"Id\" ASC NULLS FIRST OFFSET $6")
        && !string::contains(query.sql, "LIMIT -1") { True }
    else { fail!("Rows materialization must thread the context in SQL order", query) }
});

pub def grouped_rows_reexpand_measure_with_fresh_bindings: test::Test = test::should_ok(fn() {
    let local = qb::scalar(qb::ScalarFunction::Eq,
        [qb::column("e", "kind"), qb::bind_string("active")]);
    let plan: qb::Plan = {
        revision: "pg-grouped",
        sources: [qb::source("e", "Events")], joins: [],
        projection: [qb::expr_item(qb::column("e", "category")),
            qb::aggregate_filtered(qb::AggregateFunction::Count, qb::column("e", "id"),
                False, Some(local), "hits")],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "category"), qb::bind_string("A")])),
        grouping: [qb::column("e", "category")],
        having: [qb::having(qb::HavingOp::Gt, "hits", qb::Val::Int(1))],
        ordering: [qb::desc_aggregate("hits")], limit: Some(5), offset: None,
        exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::String("active"), qb::Val::String("A"),
        qb::Val::String("active"), qb::Val::Int(1), qb::Val::String("active"), qb::Val::Int(5)]
        && string::contains(query.sql, "count(\"e\".\"id\") FILTER (WHERE \"e\".\"kind\" = $1) AS \"hits\"")
        && string::contains(query.sql, "HAVING count(\"e\".\"id\") FILTER (WHERE \"e\".\"kind\" = $3) > $4")
        && string::contains(query.sql, "ORDER BY count(\"e\".\"id\") FILTER (WHERE \"e\".\"kind\" = $5) DESC NULLS LAST LIMIT $6") {
        True
    } else { fail!("measure expansion must allocate fresh bindings in each SQL position", query) }
});

pub def derived_union_threads_context_across_branches: test::Test = test::should_ok(fn() {
    let branch_a = qb::union_branch(qb::scoped_source("a", "ItemsA",
        qb::scalar(qb::ScalarFunction::Eq, [qb::column("a", "role"), qb::bind_string("scope-a")])),
        [qb::union_column("id", qb::column("a", "id")),
            qb::union_column("tag", qb::bind_string("tag-a"))], None);
    let branch_b = qb::union_branch(qb::source("b", "ItemsB"),
        [qb::union_column("id", qb::column("b", "id")),
            qb::union_column("tag", qb::bind_string("tag-b"))],
        Some(qb::scalar(qb::ScalarFunction::Gt,
            [qb::column("b", "id"), qb::bind_int(10)])));
    let plan: qb::Plan = {
        revision: "pg-union-source", sources: [],
        derived: Some(qb::derived_source("u", [branch_a, branch_b])),
        projection: [qb::expr_item(qb::bind_string("outer")), qb::expr_item(qb::column("u", "id"))],
        joins: [], filter: Some(qb::scalar(qb::ScalarFunction::Gt,
            [qb::column("u", "id"), qb::bind_int(1)])),
        grouping: [], having: [], ordering: [qb::asc(qb::column("u", "id"))],
        limit: None, offset: None, exists: [], partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::String("outer"), qb::Val::String("tag-a"),
        qb::Val::String("scope-a"), qb::Val::String("tag-b"), qb::Val::Int(10), qb::Val::Int(1)]
        && string::contains(query.sql, "SELECT \"a\".\"id\" AS \"id\", $2 AS \"tag\" FROM (SELECT * FROM \"ItemsA\" AS \"a\" WHERE \"a\".\"role\" = $3) AS \"a\"")
        && string::contains(query.sql, "UNION ALL SELECT \"b\".\"id\" AS \"id\", $4 AS \"tag\" FROM \"ItemsB\" AS \"b\" WHERE \"b\".\"id\" > $5")
        && string::contains(query.sql, ") AS \"u\" WHERE \"u\".\"id\" > $6") {
        True
    } else { fail!("UNION ALL branches must share the immutable resource context", query) }
});

pub def group_count_allocates_wrapper_alias: test::Test = test::should_ok(fn() {
    let plan: qb::Plan = {
        revision: "pg-group-count", sources: [qb::source("__q_0", "Events")],
        projection: [qb::expr_item(qb::column("__q_0", "category")),
            qb::aggregate(qb::AggregateFunction::Count, qb::column("__q_0", "id"), False, "hits")],
        joins: [], filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("__q_0", "category"), qb::bind_string("A")])),
        grouping: [qb::column("__q_0", "category")], having: [], ordering: [],
        limit: None, offset: None, exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_group_count_candidate(plan);
    if query.bindings == [qb::Val::String("A")]
        && string::contains(query.sql, "FROM \"Events\" AS \"__q_0\" WHERE \"__q_0\".\"category\" = $1")
        && string::contains(query.sql, ") AS \"__q_1\"") {
        True
    } else { fail!("wrapper alias must avoid source aliases using the same context", query) }
});

def set_operand: Fn(String) -> qb::Plan = fn(status) {
    {
        revision: "pg-set", sources: [qb::source("__q_0", "Events")],
        projection: [qb::expr_item(qb::column("__q_0", "id"))],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("__q_0", "status"), qb::bind_string(status)])),
        joins: [], grouping: [], having: [], ordering: [],
        limit: None, offset: None, exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    }
};

pub def set_branches_share_binding_and_alias_context: test::Test = test::should_ok(fn() {
    let set: qb::SetPlan = {kind: qb::SetOpKind::Intersect,
        left: set_operand("left"), right: set_operand("right")};
    let rows = pg::render_set_candidate(set, False);
    let count = pg::render_set_candidate(set, True);
    if rows.bindings == [qb::Val::String("left"), qb::Val::String("right")]
        && string::contains(rows.sql, "WHERE \"__q_0\".\"status\" = $1 INTERSECT SELECT")
        && string::contains(rows.sql, "WHERE \"__q_0\".\"status\" = $2")
        && count.bindings == rows.bindings
        && string::contains(count.sql, ") AS \"__q_1\"") {
        True
    } else { fail!("set branches and outer count must share one immutable context", rows, count) }
});

pub def unified_query_plan_entry_covers_all_shapes: test::Test = test::should_ok(fn() {
    let rows = pg::render_query_plan_candidate(qb::QueryPlan::Rows(set_operand("left")));
    let distinct = pg::render_query_plan_candidate(qb::QueryPlan::DistinctRows(set_operand("left")));
    let set: qb::SetPlan = {kind: qb::SetOpKind::Intersect,
        left: set_operand("left"), right: set_operand("right")};
    let set_rows = pg::render_query_plan_candidate(qb::QueryPlan::SetRows(set));
    let set_count = pg::render_query_plan_candidate(qb::QueryPlan::SetCount(set));
    let grouped: qb::Plan = {
        revision: "pg-group", sources: [qb::source("e", "Events")],
        projection: [qb::expr_item(qb::column("e", "status")),
            qb::aggregate(qb::AggregateFunction::Count, qb::column("e", "id"), False, "hits")],
        filter: None, exists: [], joins: [], grouping: [qb::column("e", "status")],
        having: [], ordering: [], limit: None, offset: None, derived: None,
        partition: None, scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let group_count = pg::render_query_plan_candidate(qb::QueryPlan::GroupCount(grouped));
    if string::contains(rows.sql, "SELECT \"__q_0\".\"id\" FROM")
        && string::contains(distinct.sql, "SELECT DISTINCT \"__q_0\".\"id\"")
        && set_rows.bindings == [qb::Val::String("left"), qb::Val::String("right")]
        && string::contains(set_rows.sql, " INTERSECT ")
        && string::contains(set_count.sql, "SELECT count(1) FROM (")
        && string::contains(group_count.sql, "SELECT count(1) FROM (") {
        True
    } else { fail!("PG QueryPlan entry must dispatch all five validated shapes",
        rows, distinct, set_rows, set_count, group_count) }
});

def exists_outer: Fn(qb::Exists) -> qb::Plan = fn(ex) {
    {
        revision: "pg-exists", sources: [qb::source("o", "Orders")],
        projection: [qb::expr_item(qb::column("o", "id"))],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("o", "role"), qb::bind_string("root")])),
        exists: [ex], joins: [], grouping: [], having: [],
        ordering: [qb::asc(qb::column("o", "id"))],
        limit: None, offset: None, derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    }
};

pub def grouped_exists_threads_source_and_having_bindings: test::Test = test::should_ok(fn() {
    let ex = qb::exists_grouped(qb::scoped_source("e", "Events",
        qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "scope"), qb::bind_string("private")])),
        [qb::column_eq(qb::column_ref("o", "id"), qb::column_ref("e", "owner_id"))],
        Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "kind"), qb::bind_string("alert")])),
        [qb::column("e", "owner_id")],
        [qb::having_call(qb::HavingOp::Gt, qb::AggregateFunction::Count,
            qb::column("e", "id"), False, qb::Val::Int(1))]);
    let query = pg::render_rows_candidate(exists_outer(ex), False);
    if query.bindings == [qb::Val::String("root"), qb::Val::String("private"),
        qb::Val::String("alert"), qb::Val::Int(1)]
        && string::contains(query.sql, "WHERE \"o\".\"role\" = $1 AND EXISTS (SELECT 1 FROM (SELECT * FROM \"Events\" AS \"e\" WHERE \"e\".\"scope\" = $2) AS \"e\"")
        && string::contains(query.sql, "WHERE \"o\".\"id\" = \"e\".\"owner_id\" AND \"e\".\"kind\" = $3 GROUP BY \"e\".\"owner_id\" HAVING count(\"e\".\"id\") > $4)") {
        True
    } else { fail!("correlated grouped EXISTS must thread the shared context", query) }
});

pub def negated_or_exists_preserves_predicate: test::Test = test::should_ok(fn() {
    let ex = qb::exists_not(qb::exists_union(qb::source("e", "Events"), [
        [qb::column_eq(qb::column_ref("o", "left_id"), qb::column_ref("e", "owner_id"))],
        [qb::column_eq(qb::column_ref("o", "right_id"), qb::column_ref("e", "owner_id"))],
    ], Some(qb::scalar(qb::ScalarFunction::Eq,
        [qb::column("e", "kind"), qb::bind_string("blocked")]))));
    let query = pg::render_rows_candidate(exists_outer(ex), False);
    if query.bindings == [qb::Val::String("root"), qb::Val::String("blocked")]
        && string::contains(query.sql, "NOT EXISTS (SELECT 1 FROM \"Events\" AS \"e\" WHERE ((\"o\".\"left_id\" = \"e\".\"owner_id\") OR (\"o\".\"right_id\" = \"e\".\"owner_id\")) AND \"e\".\"kind\" = $2)") {
        True
    } else { fail!("NOT EXISTS must keep OR correlation and inner binding", query) }
});

pub def linked_exists_threads_all_inner_sources: test::Test = test::should_ok(fn() {
    let ex = qb::exists_two_hop(
        qb::scoped_source("h", "Hops", qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("h", "kind"), qb::bind_string("first")])),
        [qb::column_eq(qb::column_ref("o", "id"), qb::column_ref("h", "owner_id"))],
        qb::scoped_source("l", "Links", qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("l", "kind"), qb::bind_string("second")])),
        [qb::column_eq(qb::column_ref("h", "id"), qb::column_ref("l", "hop_id"))],
        Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("l", "state"), qb::bind_string("active")])));
    let query = pg::render_rows_candidate(exists_outer(ex), False);
    if query.bindings == [qb::Val::String("root"), qb::Val::String("first"),
        qb::Val::String("second"), qb::Val::String("active")]
        && string::contains(query.sql, "INNER JOIN (SELECT * FROM \"Links\" AS \"l\" WHERE \"l\".\"kind\" = $3) AS \"l\" ON \"h\".\"id\" = \"l\".\"hop_id\"")
        && string::contains(query.sql, "WHERE \"o\".\"id\" = \"h\".\"owner_id\" AND \"l\".\"state\" = $4") {
        True
    } else { fail!("linked EXISTS must retain one correlated body and binding order", query) }
});

pub def peer_exists_threads_sources_and_filters: test::Test = test::should_ok(fn() {
    let origin_key = qb::column_ref("a", "id");
    let peer_key = qb::column_ref("b", "id");
    let first = qb::peer_branch(
        qb::column_eq(qb::column_ref("o", "left_id"), origin_key),
        qb::column_eq(qb::column_ref("o", "right_id"), peer_key));
    let second = qb::peer_branch(
        qb::column_eq(qb::column_ref("o", "right_id"), origin_key),
        qb::column_eq(qb::column_ref("o", "left_id"), peer_key));
    let corr = qb::peer_corr_roles(
        qb::scoped_source("a", "People", qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("a", "scope"), qb::bind_string("a-scope")])),
        qb::scoped_source("b", "People", qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("b", "scope"), qb::bind_string("b-scope")])),
        first, second,
        Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("a", "role"), qb::bind_string("origin")])),
        Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("b", "role"), qb::bind_string("peer")])), True, True);
    let query = pg::render_rows_candidate(exists_outer(qb::exists_not(qb::exists_peer(corr))), False);
    if query.bindings == [qb::Val::String("root"), qb::Val::String("a-scope"),
        qb::Val::String("b-scope"), qb::Val::String("origin"), qb::Val::String("peer")]
        && string::contains(query.sql, "NOT EXISTS (SELECT 1 FROM")
        && string::contains(query.sql, "\"a\".\"id\" <> \"b\".\"id\"")
        && string::contains(query.sql, "\"a\".\"role\" = $4 AND \"b\".\"role\" = $5") {
        True
    } else { fail!("peer EXISTS must retain identity and ordered source/filter bindings", query) }
});

pub def scalar_comparison_threads_inner_clause_bindings: test::Test = test::should_ok(fn() {
    let inner = qb::scalar_subquery_spec(
        qb::scoped_source("e", "Events", qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "scope"), qb::bind_string("private")])),
        [qb::join_on(qb::JoinKind::Inner, qb::source("t", "Tags"),
            qb::on_and([qb::on_eq(qb::column_ref("e", "id"), qb::column_ref("t", "event_id")),
                qb::on_predicate(qb::scalar(qb::ScalarFunction::Eq,
                    [qb::column("t", "kind"), qb::bind_string("primary")]))]))],
        Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "status"), qb::bind_string("active")])),
        qb::AggregateFunction::Sum, qb::scalar(qb::ScalarFunction::Add,
            [qb::column("e", "amount"), qb::bind_int(2)]), False,
        Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "kind"), qb::bind_string("sale")])));
    let plan: qb::Plan = {
        revision: "pg-scalar", sources: [qb::source("o", "Orders")],
        projection: [qb::expr_item(qb::column("o", "id"))],
        filter: None, exists: [], joins: [], grouping: [], having: [], ordering: [],
        limit: None, offset: None, derived: None, partition: None,
        scalar_comparisons: [qb::scalar_aggregate_comparison(qb::column_ref("o", "total"),
            qb::ScalarFunction::Gt, inner)], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::Int(2), qb::Val::String("sale"),
        qb::Val::String("private"), qb::Val::String("primary"), qb::Val::String("active")]
        && string::contains(query.sql, "\"o\".\"total\" > (SELECT sum(")
        && string::contains(query.sql, "\"e\".\"scope\" = $3")
        && string::contains(query.sql, "\"t\".\"kind\" = $4")
        && string::contains(query.sql, "WHERE \"e\".\"status\" = $5)") {
        True
    } else { fail!("scalar subquery must allocate bindings in rendered SQL order", query) }
});

pub def ranked_key_groups_projected_parameterized_expression: test::Test = test::should_ok(fn() {
    let ordering: qb::AggregateCall = {
        function: qb::AggregateFunction::Sum, arg: qb::column("e", "amount"),
        distinct: False,
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "kind"), qb::bind_string("sale")])),
        alias: "rank",
    };
    let inner = qb::ranked_key_subquery_spec(
        qb::scoped_source("e", "Events", qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "scope"), qb::bind_string("private")])),
        [qb::join_on(qb::JoinKind::Inner, qb::source("t", "Tags"),
            qb::on_and([qb::on_eq(qb::column_ref("e", "id"), qb::column_ref("t", "event_id")),
                qb::on_predicate(qb::scalar(qb::ScalarFunction::Eq,
                    [qb::column("t", "kind"), qb::bind_string("primary")]))]))],
        Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "status"), qb::bind_string("active")])),
        [qb::scalar(qb::ScalarFunction::Add,
            [qb::column("e", "category"), qb::bind_int(0)])],
        ordering, qb::Ordering::Desc);
    let plan: qb::Plan = {
        revision: "pg-ranked", sources: [qb::source("o", "Orders")],
        projection: [qb::expr_item(qb::column("o", "id"))],
        filter: None, exists: [], joins: [], grouping: [], having: [], ordering: [],
        limit: None, offset: None, derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [qb::ranked_key_comparison(
            qb::column_ref("o", "category"), qb::ScalarFunction::Eq, inner)],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::Int(0), qb::Val::String("private"),
        qb::Val::String("primary"), qb::Val::String("active"), qb::Val::String("sale")]
        && string::contains(query.sql, "SELECT (\"e\".\"category\" + $1)")
        && string::contains(query.sql, "GROUP BY 1 ORDER BY sum(\"e\".\"amount\") FILTER (WHERE \"e\".\"kind\" = $5) DESC NULLS LAST LIMIT 1") {
        True
    } else { fail!("ranked key must group the projected expression without duplicate binding", query) }
});

pub def partitioned_rows_allocate_hidden_columns_and_take: test::Test = test::should_ok(fn() {
    let plan: qb::Plan = {
        revision: "pg-partition", sources: [qb::source("e", "Events")],
        projection: [qb::expr_item(qb::column("e", "id"))],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "status"), qb::bind_string("active")])),
        exists: [], joins: [], grouping: [], having: [], ordering: [],
        limit: None, offset: None, derived: None,
        partition: Some(qb::partitioned_top_n([qb::column("e", "category")],
            [qb::desc(qb::column("e", "score"))], 2)),
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::String("active"), qb::Val::Int(2)]
        && string::contains(query.sql, "\"e\".\"category\" AS \"__q_1\"")
        && string::contains(query.sql, "\"e\".\"score\" AS \"__q_2\"")
        && string::contains(query.sql, "row_number() OVER (PARTITION BY \"e\".\"category\" ORDER BY \"e\".\"score\" DESC NULLS LAST) AS \"__q_3\"")
        && string::contains(query.sql, "WHERE \"__q_4\".\"__q_3\" <= $2 ORDER BY \"__q_4\".\"__q_1\" ASC NULLS FIRST, \"__q_4\".\"__q_2\" DESC NULLS LAST") {
        True
    } else { fail!("partitioned rows must keep base projection and hidden ordering separate", query) }
});

pub def partitioned_grouped_measure_keeps_outer_projection: test::Test = test::should_ok(fn() {
    let plan: qb::Plan = {
        revision: "pg-group-partition", sources: [qb::source("e", "Events")],
        projection: [qb::named_expr_item(qb::column("e", "category"), "category"),
            qb::named_expr_item(qb::column("e", "kind"), "kind"),
            qb::aggregate(qb::AggregateFunction::Sum, qb::column("e", "amount"), False, "total")],
        filter: None, exists: [], joins: [],
        grouping: [qb::column("e", "category"), qb::column("e", "kind")],
        having: [], ordering: [], limit: None, offset: None, derived: None,
        partition: Some(qb::partitioned_top_n([qb::column("e", "category")],
            [qb::desc_aggregate("total"), qb::asc(qb::column("e", "kind"))], 1)),
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::Int(1)]
        && string::contains(query.sql, "row_number() OVER (PARTITION BY \"e\".\"category\" ORDER BY sum(\"e\".\"amount\") DESC NULLS LAST, \"e\".\"kind\" ASC NULLS FIRST)")
        && string::contains(query.sql, "GROUP BY \"e\".\"category\", \"e\".\"kind\"")
        && string::contains(query.sql, "ORDER BY \"__q_1\".\"category\" ASC NULLS FIRST, \"__q_1\".\"total\" DESC NULLS LAST, \"__q_1\".\"kind\" ASC NULLS FIRST") {
        True
    } else { fail!("grouped partition must rank aggregates and expose only declared columns", query) }
});

pub def partitioned_grouping_reuses_parameterized_key: test::Test = test::should_ok(fn() {
    let key = qb::scalar(qb::ScalarFunction::Add,
        [qb::column("e", "category"), qb::bind_int(0)]);
    let plan: qb::Plan = {
        revision: "pg-param-group", sources: [qb::source("e", "Events")],
        projection: [qb::named_expr_item(key, "category"),
            qb::aggregate(qb::AggregateFunction::Sum, qb::column("e", "amount"), False, "total")],
        filter: None, exists: [], joins: [], grouping: [key], having: [], ordering: [],
        limit: None, offset: None, derived: None,
        partition: Some(qb::partitioned_top_n([key], [qb::desc_aggregate("total")], 1)),
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::Int(0), qb::Val::Int(1)]
        && string::contains(query.sql, "SELECT (\"e\".\"category\" + $1) AS \"category\"")
        && string::contains(query.sql, "OVER (PARTITION BY (\"e\".\"category\" + $1) ORDER BY")
        && string::contains(query.sql, "GROUP BY (\"e\".\"category\" + $1)") {
        True
    } else { fail!("parameterized grouping key must share one PG placeholder across clauses", query) }
});
