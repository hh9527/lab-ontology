# om-labflow 知识目录（知识发现）
#
#   bin/telora -C om-labflow run probe
#
# 输出 payload 中可用的业务词汇：指标、维度、封闭值域与关系。供查询设计指南
# 与调用者核对公共查询面，不读取任何数据库。

import "std/value" { Value };
import "std/array" as array;
import "std/codec" as codec;
import "std/result" as result;
import "ontology/edsl" as edsl;
import "query/lib" as qb;
import "@src/knowledge" { payload };
import "@src/query" as facade;

type CatalogMeasure = struct { id: String, aggregate: String };
type CatalogDimension = struct { id: String, filterable: Bool, computed: Bool, values: Array(String) };
type CatalogRelation = struct { from: String, to: String, kind: String };
type CatalogEntity = struct { alias: String, table: String };

type Catalog = struct {
    revision: String,
    entities: Array(CatalogEntity),
    measures: Array(CatalogMeasure),
    dimensions: Array(CatalogDimension),
    relations: Array(CatalogRelation),
};

def entity_alias: Fn(Int) -> String = fn(index) {
    match array.get(payload.entities, index) {
        'Some(entity) => entity.alias,
        'None => "?",
    }
};

def kind_text: Fn(edsl.RelationKind) -> String = fn(kind) {
    match kind {
        'Safe => "safe",
        'FanOut => "fan_out",
    }
};

def catalog: Catalog = {
    revision: payload.revision,
    entities: array.map(payload.entities, fn(entity) {
        { alias: entity.alias, table: entity.table }
    }),
    measures: array.map(payload.measures, fn(measure) {
        { id: measure.id, aggregate: qb.aggregate_name(measure.aggregate) }
    }),
    dimensions: array.map(payload.dimensions, fn(dimension) {
        {
            id: dimension.id,
            filterable: dimension.filterable,
            computed: dimension.computed,
            values: array.map(dimension.values, fn(value) { value.value }),
        }
    }),
    relations: array.map(payload.relations, fn(relation) {
        {
            from: entity_alias(relation.from),
            to: entity_alias(relation.to),
            kind: kind_text(relation.kind),
        }
    }),
};

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    codec.encode(Value, catalog) |> result.unwrap
};
