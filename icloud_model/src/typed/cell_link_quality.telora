use ontology::semantic as domain;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
type ResourceId = struct(String);
use ontology::quantity::{EffectiveCount};
# packetLoss 的单位／尺度没有在旧公开契约中确认。
type ReportedPacketLoss = struct(Float);
# jitter 的单位／尺度没有在旧公开契约中确认。
type ReportedJitter = struct(Float);
# delay 的单位／尺度没有在旧公开契约中确认。
type ReportedDelay = struct(Float);
# lqm 的单位／尺度没有在旧公开契约中确认。
type ReportedLqm = struct(Float);
@domain::subject("CellLink", "source_resId")
@domain::dataset("source_NetworkCellLinkQualityKPI", "NetworkCellLinkQualityKPI", ["source_resId"])
type NetworkCellLinkQualityKPI = struct {
    @m::column("ts")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__ts",
            s::DateTimeUtc.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__ts",
        True,
        g::numeric_filters
    )
    @g::utc_bucket_view("source_NetworkCellLinkQualityKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkCellLinkQualityKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkCellLinkQualityKPI_utc_month", qb::UtcBucketUnit::Month)
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkCellLinkQualityKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkCellLinkQualityKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("projectId")
    @g::exact("source_NetworkCellLinkQualityKPI__projectId")
    source_projectId: String,
    @m::column("srcSiteId")
    @g::exact("source_NetworkCellLinkQualityKPI__srcSiteId")
    source_srcSiteId: String,
    @m::column("destSiteId")
    @g::exact("source_NetworkCellLinkQualityKPI__destSiteId")
    source_destSiteId: String,
    @m::column("sourceWanlinkId")
    @g::exact("source_NetworkCellLinkQualityKPI__sourceWanlinkId")
    source_sourceWanlinkId: String,
    @m::column("destWanlinkId")
    @g::exact("source_NetworkCellLinkQualityKPI__destWanlinkId")
    source_destWanlinkId: String,
    @m::column("packetLoss")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__packetLoss",
            ReportedPacketLoss.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__packetLoss",
        True,
        g::numeric_filters
    )
    source_packetLoss: ReportedPacketLoss,
    @m::column("jitter")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__jitter",
            ReportedJitter.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__jitter",
        True,
        g::numeric_filters
    )
    source_jitter: ReportedJitter,
    @m::column("delay")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__delay",
            ReportedDelay.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__delay",
        True,
        g::numeric_filters
    )
    source_delay: ReportedDelay,
    @m::column("lqm")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__lqm",
            ReportedLqm.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__lqm",
        True,
        g::numeric_filters
    )
    source_lqm: ReportedLqm,
    @m::column("packetLossEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__packetLossEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__packetLossEffcnt",
        True,
        g::numeric_filters
    )
    source_packetLossEffcnt: EffectiveCount,
    @m::column("jitterEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__jitterEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__jitterEffcnt",
        True,
        g::numeric_filters
    )
    source_jitterEffcnt: EffectiveCount,
    @m::column("delayEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__delayEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__delayEffcnt",
        True,
        g::numeric_filters
    )
    source_delayEffcnt: EffectiveCount,
    @m::column("lqmEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkCellLinkQualityKPI__lqmEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkCellLinkQualityKPI__lqmEffcnt",
        True,
        g::numeric_filters
    )
    source_lqmEffcnt: EffectiveCount,
};

pub use self::{NetworkCellLinkQualityKPI};
