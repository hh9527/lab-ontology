pub def alarm_window_uses_authoritative_utc_clock: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"alarm",
        "nodes":[{"id":"alarm","entity":"current_alarm"}],"edges":[],"select":[],
        "measures":[{"node":"alarm","measure":"alarm_count"}],
        "filters":[{"node":"alarm","dimension":"alarm_occur_utc_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"alarm","dimension":"alarm_occur_utc_raw","op":"lt","kind":"text","value":"2025-01-02 00:00:00"}]}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "alarm.OCCURUTC >= ?1")
        && string::contains(sq.sql, "alarm.OCCURUTC < ?2")
        && string::contains(pg.sql, "\"alarm\".\"OCCURUTC\" >= $1")
        && sq.bindings == [qb::Val::String("2025-01-01 00:00:00"), qb::Val::String("2025-01-02 00:00:00")]
        && pg.bindings == sq.bindings { True }
    else { fail!("alarm window lost its authoritative UTC field or bound parameters", sq, pg) }
});

