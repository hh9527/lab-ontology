use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器独立声明，主身份与来源资源身份显式分开
use super::inventory as i;
use super::site as site;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ServerId = struct(String);
type ServerOriginId = struct(String);
@domain::entity_by("Server")
type ServerById = struct(ServerId);
# 来源资源身份用于部件parentResId，不宣称它与ServerId是同一编码
@domain::entity_by("Server")
type ServerByOriginId = struct(ServerOriginId);
@domain::subject("Server", "id")
@domain::dataset("server_device", "PhysicalServer", ["id"])
@domain::relations(relations)
@domain::alternatives(alternatives)
type PhysicalServer = struct {
    id: ServerById,
    @g::search("server_name")
    name: String,
    @m::column("assetNumber")
    @g::search("server_asset_number")
    asset_number: String,
    @m::column("ipAddress")
    @g::search("server_ip_address")
    @g::ipv4_view("server_ip_address_ipv4")
    ip_address: String,
    @m::column("oriResId")
    ori_res_id: domain::Reference(ServerByOriginId),
    @m::column("tenantId")
    tenant_id: domain::Reference(i::TenantById),
    @m::column("refParentSubnet")
    ref_parent_subnet: domain::Reference(site::SiteById),
    @m::column("projectId")
    project_id: domain::Reference(site::SiteById),
    @g::exact("server_class_raw")
    @v::map(
        ServerClass.type,
        "server_class",
        [
            v::member(ServerClass::Subrack, ["ne.category.server.subrack"]),
            v::member(ServerClass::Kunlun, ["ne.category.server.kunlun"]),
            v::member(ServerClass::Rack, ["ne.category.server.rack"]),
            v::member(ServerClass::Taishan, ["ne.category.server.taishan"]),
            v::member(ServerClass::Heterogeneous, ["ne.category.server.heterogeneous"]),
            v::member(ServerClass::Enclosure, ["ne.category.server.enclosure"]),
            v::member(ServerClass::NeCategoryServerChassis, ["ne.category.server.chassis"]),
            v::member(ServerClass::NeCategoryServerHighdensity, ["ne.category.server.highdensity"]),
            v::member(
                ServerClass::NeCategoryServerLitechassisserver,
                ["ne.category.server.litechassisserver"]
            ),
            v::member(ServerClass::NeCategoryServerOther, ["ne.category.server.other"]),
            v::member(ServerClass::NeCategoryServerBlade, ["ne.category.server.blade"]),
            v::member(ServerClass::NeCategoryServerSwitch, ["ne.category.server.switch"]),
            v::member(ServerClass::NeCategoryServerEdge, ["ne.category.server.edge"])
        ]
    )
    classification: String,
    @m::column("healthStatus")
    @g::exact("server_health_raw")
    @v::map(
        ServerHealth.type,
        "server_health",
        [
            v::member(ServerHealth::Normal, [0]),
            v::member(ServerHealth::Warning, [1]),
            v::member(ServerHealth::Minor, [2]),
            v::member(ServerHealth::Major, [3]),
            v::member(ServerHealth::Critical, [4]),
            v::member(ServerHealth::Error, [-1]),
            v::member(ServerHealth::Unknown, [-2])
        ]
    )
    health_status: Int,
    @g::search("server_manufacturer")
    manufacturer: String,
    @m::column("createTime")
    @g::field_view(
        g::dimension_group(
            "server_device__createTime",
            s::EpochMillis.type,
            True,
            g::numeric_filters
        ),
        "server_device__createTime",
        True,
        g::numeric_filters
    )
    source_createTime: s::EpochMillis,
    @m::column("bmcHostName")
    @g::search("server_device__bmcHostName")
    source_bmcHostName: String,
    @m::column("serviceDuration")
    @g::field_view(
        g::dimension_group("server_device__serviceDuration", Int.type, True, g::numeric_filters),
        "server_device__serviceDuration",
        True,
        g::numeric_filters
    )
    source_serviceDuration: Int,
    @m::column("serviceStartTime")
    @g::field_view(
        g::dimension_group("server_device__serviceStartTime", Int.type, True, g::numeric_filters),
        "server_device__serviceStartTime",
        True,
        g::numeric_filters
    )
    source_serviceStartTime: Int,
    @m::column("assetManager")
    @g::exact("server_device__assetManager")
    source_assetManager: String,
    @m::column("biosVersion")
    @g::search("server_device__biosVersion")
    source_biosVersion: String,
    @m::column("mac")
    @g::search("server_device__mac")
    source_mac: String,
    @m::column("connectStatus")
    @g::exact("server_device__connectStatus_raw")
    @v::map(
        ServerDeviceConnectStatus.type,
        "server_device__connectStatus",
        [
            v::member(ServerDeviceConnectStatus::Online, [1]),
            v::member(ServerDeviceConnectStatus::Offline, [3]),
            v::member(ServerDeviceConnectStatus::SnmpUnreachable, [4]),
            v::member(ServerDeviceConnectStatus::RedfishUnreachable, [5])
        ]
    )
    source_connectStatus: Int,
    @m::column("productName")
    @g::search("server_device__productName")
    source_productName: String,
    @m::column("location")
    @g::search("server_device__location")
    source_location: String,
    @m::column("sn")
    @g::search("server_device__sn")
    source_sn: String,
    @m::column("version")
    @g::search("server_device__version")
    source_version: String,
};

def subject: r::Endpoint = domain::endpoint(PhysicalServer.type, "id");
def tenant: r::Endpoint = domain::endpoint(PhysicalServer.type, "tenant_id");
def subnet: r::Endpoint = domain::endpoint(PhysicalServer.type, "ref_parent_subnet");
def project: r::Endpoint = domain::endpoint(PhysicalServer.type, "project_id");
def origin: r::Endpoint = domain::endpoint(PhysicalServer.type, "ori_res_id");
@knowledge_policy::reverse_references(True)
type ServerClass = enum {
    @ev::description("Tiangong chassis server", "天工机框服务器")
    Subrack,

    @ev::description("KunLun server", "昆仑服务器")
    Kunlun,

    @ev::description("Rack server", "机架服务器")
    Rack,

    @ev::description("TaiShan server", "Taishan服务器")
    Taishan,

    @ev::description("Heterogeneous server", "异构服务器")
    Heterogeneous,

    @ev::description("Cabinet", "机柜")
    Enclosure,

    @ev::description("Blade server", "刀片服务器")
    NeCategoryServerChassis,

    @ev::description("High-density server", "高密服务器")
    NeCategoryServerHighdensity,

    @ev::description("Lightweight chassis server", "轻量型机框服务器")
    NeCategoryServerLitechassisserver,

    @ev::description("Other server", "其他服务器")
    NeCategoryServerOther,

    @ev::description("Blade", "刀片")
    NeCategoryServerBlade,

    @ev::description("Switch board", "交换板")
    NeCategoryServerSwitch,

    @ev::description("Intelligent edge station", "智能小站")
    NeCategoryServerEdge,
};

@knowledge_policy::reverse_references(True)
type ServerHealth = enum {
    @ev::itag(0)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("warning", "警告")
    Warning,
    @ev::itag(2)
    @ev::description("minor", "一般")
    Minor,
    @ev::itag(3)
    @ev::description("major", "严重")
    Major,
    @ev::itag(4)
    @ev::description("critical", "紧急")
    Critical,
    @ev::itag(-1)
    @ev::description("error", "错误")
    Error,
    @ev::itag(-2)
    @ev::description("unknown", "未知")
    Unknown,
};

@knowledge_policy::reverse_references(True)
type ServerDeviceConnectStatus = enum {
    @ev::itag(1)
    @ev::description("Online", "在线")
    Online,
    @ev::itag(3)
    @ev::description("Offline", "离线")
    Offline,
    @ev::itag(4)
    @ev::description("SNMP unreachable", "SNMP不可达")
    SnmpUnreachable,
    @ev::itag(5)
    @ev::description("Redfish unreachable", "Redfish不可达")
    RedfishUnreachable,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "server_belongs_to_tenant",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
def alternatives: Array(domain::Alternative) = [
    {
        id: "server_located_at_site",
        cardinality,
        choices: [
            r::relation("server_located_at_site_subnet", subnet, site::subject, cardinality),
            r::relation("server_located_at_site_project", project, site::subject, cardinality)
        ]
    },
    {
        id: "source_PhysicalServer_X_SITE_VIEW",
        cardinality,
        choices: [
            r::relation(
                "source_PhysicalServer_X_SITE_VIEW_subnet",
                subnet,
                site::subject,
                cardinality
            ),
            r::relation(
                "source_PhysicalServer_X_SITE_VIEW_project",
                project,
                site::subject,
                cardinality
            )
        ]
    },
];
pub use self::{
    relations,
    alternatives,
    ServerId,
    ServerOriginId,
    ServerById,
    subject,
    ServerByOriginId,
    origin
};

pub use self::{PhysicalServer};

pub use self::{ServerClass, ServerHealth, ServerDeviceConnectStatus};
