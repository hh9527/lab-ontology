pub def count_devices_with_business_peer: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"peer","entity":"device"}],
            "edges":[{"relation":"connected_device","from":"d","to":"peer"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "count(d.id)")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM connections")
        && string::contains(sq.sql, " OR ") && string::contains(sq.sql, "tenant_id")
        && string::contains(pg.sql, "EXISTS (SELECT 1 FROM \"connections\"") {
        True
    } else { fail!("business peer existence must preserve device grain and both identities", sq.sql, pg.sql) }
});

