use super::metric_values as metric;
use ontology::quantity as presentation;
use ontology::semantic as domain;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
type ResourceId = struct(String);
use ontology::quantity::{EffectiveCount};
@domain::subject("Board", "source_resId")
@domain::dataset(
    "source_NetworkDeviceBoardKPI",
    "NetworkDeviceBoardKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
type NetworkDeviceBoardKPI = struct {
    @m::column("ts")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceBoardKPI__ts",
            s::DateTimeUtc.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceBoardKPI__ts",
        True,
        g::numeric_filters
    )
    @g::utc_bucket_view("source_NetworkDeviceBoardKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkDeviceBoardKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkDeviceBoardKPI_utc_month", qb::UtcBucketUnit::Month)
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkDeviceBoardKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkDeviceBoardKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_NetworkDeviceBoardKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_NetworkDeviceBoardKPI__projectId")
    source_projectId: String,
    @m::column("cpuUsage")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceBoardKPI__cpuUsage",
            metric::CpuUtilization.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceBoardKPI__cpuUsage",
        True,
        g::numeric_filters
    )
    @samples::field(
        metric::cpu_summary,
        [
            {statistic: samples::Statistic::Mean, publish: "board_cpu_usage"},
            {statistic: samples::Statistic::Max, publish: "board_cpu_usage_max"},
            {statistic: samples::Statistic::Min, publish: "board_cpu_usage_min"}
        ]
    )
    @presentation::field_unit("%", "ratio", 0.01)
    source_cpuUsage: metric::CpuUtilization,
    @m::column("memUsage")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceBoardKPI__memUsage",
            metric::MemoryUtilization.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceBoardKPI__memUsage",
        True,
        g::numeric_filters
    )
    @samples::field(
        metric::memory_summary,
        [
            {statistic: samples::Statistic::Mean, publish: "board_memory_usage"},
            {statistic: samples::Statistic::Max, publish: "board_memory_usage_max"},
            {statistic: samples::Statistic::Min, publish: "board_memory_usage_min"}
        ]
    )
    @presentation::field_unit("%", "ratio", 0.01)
    source_memUsage: metric::MemoryUtilization,
    @m::column("hwEntityTemperature")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceBoardKPI__hwEntityTemperature",
            p::DegreesCelsius.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceBoardKPI__hwEntityTemperature",
        True,
        g::numeric_filters
    )
    @samples::field(
        p::DegreesCelsius_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "board_temperature"},
            {statistic: samples::Statistic::Max, publish: "board_temperature_max"},
            {statistic: samples::Statistic::Min, publish: "board_temperature_min"}
        ]
    )
    source_hwEntityTemperature: p::DegreesCelsius,
    @m::column("cpuUsageEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceBoardKPI__cpuUsageEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceBoardKPI__cpuUsageEffcnt",
        True,
        g::numeric_filters
    )
    source_cpuUsageEffcnt: EffectiveCount,
    @m::column("memUsageEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceBoardKPI__memUsageEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceBoardKPI__memUsageEffcnt",
        True,
        g::numeric_filters
    )
    source_memUsageEffcnt: EffectiveCount,
    @m::column("hwEntityTemperatureEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceBoardKPI__hwEntityTemperatureEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceBoardKPI__hwEntityTemperatureEffcnt",
        True,
        g::numeric_filters
    )
    source_hwEntityTemperatureEffcnt: EffectiveCount,
};

pub use self::{NetworkDeviceBoardKPI};
