@edsl::reference("id", ["id"])
type Device = struct {
    @edsl::column("alias")
    @edsl::dimension("device_alias", True, True, search_text_ops, text_inputs)
    @edsl::field_role(edsl::FieldRole::Appellation)
    @edsl::dimension_description("device_alias", "Alias", "Device alias. Raw text search, not semantic ordering or identifier normalization.")
    alias: String,
    @edsl::column("classification")
    @edsl::dimension("device_class", True, True, canonical_eq_ne_ops, text_inputs)
    @edsl::field_role(edsl::FieldRole::Classification)
    @edsl::canonical_values(device_class_values)
    @edsl::half_open()
    classification: String,
    @edsl::column("commuState")
    @edsl::dimension("device_commu_state", True, True, canonical_eq_ne_ops, text_inputs)
    @edsl::dimension_description("device_commu_state", "Device communication state", "Business communication state; offline includes both legacy and current wire values.")
    @edsl::canonical_values(communication_values)
    commu_state: String,
    @edsl::column("id")
    @edsl::key()
    @edsl::measure("device_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("device_id", True, True, text_ops, text_inputs)
    id: String,
    @edsl::column("tenantId")
    @edsl::dimension("device_tenant_id", True, True, text_ops, text_inputs)
    tenant_id: String,
    @edsl::column("projectId")
    project_id: String,
    @edsl::column("refParentSubnet")
    ref_parent_subnet: String,
    @edsl::column("name")
    @edsl::dimension("device_name", True, True, search_text_ops, text_inputs)
    @edsl::field_role(edsl::FieldRole::Appellation)
    @edsl::dimension_description("device_name", "Device Name", "Name of a resource, which is usually used for resource search. Raw text search, not semantic ordering or identifier normalization.")
    name: String,
    @edsl::column("createTime")
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("device_create_ms", True, True, int_ops, epoch_inputs)
    # TODO: Confirm source integer clock unit; provisionally use Unix epoch milliseconds.
    create_time: Int,
    @edsl::column("mac")
    @edsl::dimension("device_mac", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("device_mac", "MAC Address", "MAC address, which uniquely identifies a network interface card (NIC) on a device. Raw text search, not semantic ordering or identifier normalization.")
    mac: String,
    @edsl::column("ipAddress")
    @edsl::dimension("device_ip_address", True, True,
        search_text_ops, text_inputs)
    @edsl::dimension_description("device_ip_address", "IP Address", "IP address that is usually expressed in dotted decimal notation. Literal address-text search, not network membership or address normalization.")
    @edsl::computed_dimension("device_ip_address_ipv4", edsl::OutputType::Text, True, True,
        ipv4_ops, ipv4_inputs, edsl::canonical_ipv4_view)
    @edsl::dimension_description("device_ip_address_ipv4", "IP Address (IPv4 view)",
        "Explicit canonical IPv4 view of device_ip_address. Only four decimal octets 0..255 without leading zeros are retained; NULL, IPv6 and other representations produce NULL. No normalization or assertion about all source rows is made. InSubnet/NotInSubnet use CIDR with zero host bits, /0..32; complements exclude NULL and non-IPv4 values. Use device_ip_address for raw text search or non-IPv4 values. This validated computed view does not promise source-column index access.")
    ip_address: String,
    @edsl::column("manufacturer")
    @edsl::dimension("device_manufacturer", True, True, search_text_ops, text_inputs)
    @edsl::field_role(edsl::FieldRole::Classification)
    @edsl::dimension_description("device_manufacturer", "Vendor", "Vendor. Raw text search, not semantic ordering or identifier normalization.")
    manufacturer: String,
    @edsl::column("location")
    @edsl::dimension("device__location", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("device__location", "Position", "Location of a device, which can be a physical or logical location. Raw text search, not semantic ordering or identifier normalization.")
    source_location: String,
