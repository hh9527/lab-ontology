use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::serverinterface_2_kpi;
@domain::subject("KpiServerInterface", "obj_id")
@domain::dataset("kpi-server-interface", "kpi_server_interface", ["obj_id","ts"])
@domain::metric("ts")
@domain::relations(relations)
pub type KpiServerInterface = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-server-interface/obj_id", domain::Reference(ids::KpiServerInterfaceByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "si_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::KpiServerInterfaceByObjId),
    @m::column("TS")
    @g::field_view(g::dimension_group("kpi-server-interface/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "si_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("si_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("si_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("si_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("BANDWIDTHUSAGE")
    @g::field_view(g::dimension_group("kpi-server-interface/bandwidth_usage", metric::KpiServerInterfaceBandwidthUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "si_bandwidth_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-server-interface/bandwidth_usage", metric::KpiServerInterfaceBandwidthUsage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "si_bandwidth_usage"}, {statistic: samples::Statistic::Max, publish: "si_bandwidth_usage_max"}, {statistic: samples::Statistic::Min, publish: "si_bandwidth_usage_min"}])
    bandwidth_usage: Option(metric::KpiServerInterfaceBandwidthUsage),
};

pub def relations: Array(r::Relation) = [
    r::relation("si__ser_rev", domain::endpoint(KpiServerInterface.type, "obj_id"), domain::endpoint(serverinterface_2_kpi::Serverinterface2Kpi.type, "obj_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
