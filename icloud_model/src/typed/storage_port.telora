@knowledge_policy::reverse_references(True)
type SourceSYSStoragePortConnectStatus = enum {
    @ev::rename("up")
    @ev::description("connected", "已连接")
    Connected,
    @ev::rename("down")
    @ev::description("disconnected", "未连接")
    Disconnected,
};
def SourceSYSStoragePortConnectStatus_domain: v::Domain(SourceSYSStoragePortConnectStatus, String) = v::from_enum(
    "SourceSYSStoragePortConnectStatus",
    SourceSYSStoragePortConnectStatus.type,
    String.type,
    False
);
def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceAssociationSYS_StoragePort",
        r::endpoint(storage::dataset.row, storage::subject.id),
        r::endpoint(dataset.row, parent.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_SYS_StoragePortAssociationX_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_FCSwitchDevice_SYS_StoragePort",
        r::endpoint(fc::dataset.row, fc::subject.id),
        r::endpoint(dataset.row, fc_parent.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{SysStoragePort, Identity};
