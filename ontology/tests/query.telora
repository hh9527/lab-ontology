        qb.union_column("group_id", qb.column("b", "group_id")),
        qb.union_column("item_id", qb.column("b", "item_id")),
    ], Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("b", "kind"), qb.bind_string("y")])))
};

def union_filtered_outer_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-union-filtered-outer",
        sources: [],
