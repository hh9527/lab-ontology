    @edsl.column("classification")
    @edsl.dimension("ServerClassification", flag_true, flag_true, text_eq_ops, text_kinds)
    classification: String,

    @edsl.column("commuState")
    @edsl.dimension("ServerCommuState", flag_true, flag_true, eq_only_ops, text_kinds)
    commu_state: CommuStateCode,

    @edsl.column("firmwareVersion")
    @edsl.dimension("ServerFirmwareVersion", flag_true, flag_true, text_eq_ops, text_kinds)
    firmware_version: String,

    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.dimension("ServerDeviceId", flag_true, flag_true, text_eq_ops, text_kinds)
    @edsl.measure("ServerDeviceCount", count_agg, no_types)
    id: String,

    @edsl.column("ipAddress")
    @edsl.dimension("ServerIp", flag_true, flag_true, text_eq_ops, text_kinds)
    ip_address: String,

    @edsl.column("location")
    @edsl.dimension("ServerLocation", flag_true, flag_true, text_eq_ops, text_kinds)
    location: String,

    @edsl.column("mac")
    @edsl.dimension("ServerMac", flag_true, flag_true, text_eq_ops, text_kinds)
    mac: String,

    @edsl.column("manufacturer")
    @edsl.computed_dimension("ServerManufacturer", flag_true, flag_true, text_eq_ops, text_kinds, manu_norm)
    manufacturer: String,

    @edsl.column("name")
    @edsl.dimension("ServerName", flag_true, flag_true, text_eq_ops, text_kinds)
    name: String,

    @edsl.column("oriResId")
    ori_id: String,

    @edsl.column("productName")
    @edsl.dimension("ServerModel", flag_true, flag_true, text_eq_ops, text_kinds)
    model: String,

    @edsl.column("projectId")
    project_id: String,

    @edsl.column("refParentSubnet")
    site_key: String,

    @edsl.column("serviceDuration")
    @edsl.dimension("ServerServiceDuration", flag_true, flag_true, int_eq_range_ops, int_kinds)
    service_duration: Int,

    @edsl.column("sn")
    @edsl.dimension("ServerSn", flag_true, flag_true, text_eq_ops, text_kinds)
    sn: String,

    @edsl.column("tenantId")
    tenant_key: String,

    @edsl.column("version")
    @edsl.dimension("ServerVersion", flag_true, flag_true, text_eq_ops, text_kinds)
    version: String,
};

# ---------------------------------------------------------------------------
# Storage devices
# ---------------------------------------------------------------------------

# canonical indices: commu_state=0, health_status=1, hot_patch_version=2,
# id=3, ip_address=4, location=5, manufacturer=6, model=7, name=8,
# project_id=9, ref_parent_subnet=10, running_status=11, site_key=12, sn=13,
# sub_class=14, tenant_key=15, total_capacity=16, used_capacity_rate=17
@edsl.entity_source("HuaweiStorageDevice", "d")
@edsl.entity_id("storage_device")
