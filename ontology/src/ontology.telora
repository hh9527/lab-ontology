type LocalizedKnowledgeText = struct {
    locale: String,
    label: String,
    summary: String
};
type KnowledgeKind = enum {
    Index,
    Ty,
    Schema,
    Dataset,
    Field,
    Dimension,
    Measure,
    Value,
    Relation,
    BusinessLink,
    TimeRole
};
type KnowledgeTarget = struct {
    kind: KnowledgeKind,
    owner: String,
    id: String
};
def knowledge_key: Fn(KnowledgeTarget) -> String = fn(target) {
    if target.kind == KnowledgeKind::Index {
        "index"
    } else {
        let kind = match codec::encode(target.kind) {
            Value::String(name) => name,
            other => fail!("knowledge type must encode as a name", other),
        };
        let owner = uri::encode_component(target.owner);
        let id = if target.kind != KnowledgeKind::Schema {
            uri::encode_component(target.id)
        } else {
            string::join(array::map(string::split(target.id, "/"), uri::encode_component), "/")
        };
        if owner == "" || target.kind == KnowledgeKind::Relation {
            `\{kind}/\{id}`
        } else {
            `\{kind}/\{owner}/\{id}`
        }
    }
};
type KnowledgeAddress = struct {
    node: String,
    member: Option(String)
};
# Stable two-part identities; IDs are independently URI encoded once.
def knowledge_role: Fn(KnowledgeKind) -> String = fn(kind) {
    match kind {
        KnowledgeKind::Dataset => "datasets",
        KnowledgeKind::Field => "fields",
        KnowledgeKind::Dimension => "dimensions",
        KnowledgeKind::Measure => "measures",
        KnowledgeKind::Ty => "types",
        KnowledgeKind::Value => "values",
        KnowledgeKind::Relation => "relations",
        KnowledgeKind::TimeRole => "time_roles",
        KnowledgeKind::BusinessLink => "business_links",
        _ => "index",
    }
};
def knowledge_address: Fn(KnowledgeTarget) -> KnowledgeAddress = fn(target) {
    let role = knowledge_role(target.kind);
    let id = uri::encode_component(target.id);
    let owner = uri::encode_component(target.owner);
    if target.kind == KnowledgeKind::Index {
        {node: "index", member: None}
    } else if target.kind == KnowledgeKind::Dataset || target.kind == KnowledgeKind::Ty || target.kind == KnowledgeKind::Relation {
        {node: `\{role}/\{id}`, member: None}
    } else {
        let root = if target.kind == KnowledgeKind::Value {
            "types"
        } else {
            "datasets"
        };
        {node: `\{root}/\{owner}`, member: Some(`\{role}/\{id}`)}
    }
};

def knowledge_key_hint: Fn(KnowledgeKind, String, String) -> String = fn(kind, owner, id) {
    let key: KnowledgeTarget = {kind, owner, id};
    let address = knowledge_address(key);
    let ref = match address.member {
        Some(member) => `\{address.node}#\{member}`,
        None => address.node
    };
    json::stringify(Value::String(ref))
};
