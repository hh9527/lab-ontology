@domain::dataset("enterprise-optical-module", "EnterpriseOpticalModule", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseOpticalModule = struct {
    @m::column("objSysId")
    @g::field_view(g::dimension_group("enterprise-optical-module/obj_sys_id", ids::EnterpriseOpticalModuleById.type, True, [g::Filter::Eq]), "eom_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("eom_count")
    obj_sys_id: ids::EnterpriseOpticalModuleById,
    @g::field_view(g::dimension_group("enterprise-optical-module/version", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "eom_version", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    version: Option(String),
    @m::column("vendorPn")
