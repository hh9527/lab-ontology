use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器独立声明，主身份与来源资源身份显式分开
use super::inventory as i;
use super::site as site;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ServerId = struct(String);
type ServerOriginId = struct(String);
@registry::entity("server_entity")
type Identity = struct {
    id: ServerId
};
# 来源资源身份用于部件parentResId，不宣称它与ServerId是同一编码
@registry::entity("server_source_resource")
type OriginIdentity = struct {
    id: ServerOriginId
};
@registry::dataset("server_device", "PhysicalServer", ["id"])
@registry::roles([subject, tenant, subnet, project, origin])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "server_device__createTime",
                s::EpochMillis.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PhysicalServer.type, s::EpochMillis.type, "source_createTime")),
            "server_device__createTime",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_device__serviceDuration", Int.type, True, g::numeric_filters),
            g::input(m::field(PhysicalServer.type, Int.type, "source_serviceDuration")),
            "server_device__serviceDuration",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "server_device__serviceStartTime",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PhysicalServer.type, Int.type, "source_serviceStartTime")),
            "server_device__serviceStartTime",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(PhysicalServer.type, String.type, "ip_address"))),
            "server_ip_address_ipv4",
            True,
            g::ipv4_filters
        ),
    ]
)
@registry::relations(relations)
@registry::alternatives(alternatives)
type PhysicalServer = struct {
    id: ServerId,
    @g::search("server_name")
    name: String,
    @m::column("assetNumber")
    @g::search("server_asset_number")
    asset_number: String,
    @m::column("ipAddress")
    @g::search("server_ip_address")
    ip_address: String,
    @m::column("oriResId")
    ori_res_id: ServerOriginId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @m::column("refParentSubnet")
    ref_parent_subnet: i::SiteId,
    @m::column("projectId")
    project_id: i::SiteId,
    @v::classification(ServerClass_domain, "server_class")
    classification: String,
    @m::column("healthStatus")
    @v::classification(ServerHealth_domain, "server_health")
    health_status: Int,
    @g::search("server_manufacturer")
    manufacturer: String,
    @m::column("createTime")
    source_createTime: s::EpochMillis,
    @m::column("bmcHostName")
    @g::search("server_device__bmcHostName")
    source_bmcHostName: String,
    @m::column("serviceDuration")
    source_serviceDuration: Int,
    @m::column("serviceStartTime")
    source_serviceStartTime: Int,
    @m::column("assetManager")
    @g::exact("server_device__assetManager")
    source_assetManager: String,
    @m::column("biosVersion")
    @g::search("server_device__biosVersion")
    source_biosVersion: String,
    @m::column("mac")
    @g::search("server_device__mac")
    source_mac: String,
    @m::column("connectStatus")
    @v::classification(ServerDeviceConnectStatus_domain, "server_device__connectStatus")
    source_connectStatus: Int,
    @m::column("productName")
    @g::search("server_device__productName")
    source_productName: String,
    @m::column("location")
    @g::search("server_device__location")
    source_location: String,
    @m::column("sn")
    @g::search("server_device__sn")
    source_sn: String,
    @m::column("version")
    @g::search("server_device__version")
    source_version: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def origin_entity: m::Entity(OriginIdentity) = registry::entity_of(OriginIdentity.type);
def dataset: m::Dataset(PhysicalServer) = registry::dataset_of(PhysicalServer.type);
def subject: m::Role(PhysicalServer) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServer.type, ServerId.type, "id"),
            m::field(Identity.type, ServerId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServer) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServer.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def subnet: m::Role(PhysicalServer) = m::role(
    dataset,
    site::entity,
    "subnet",
    False,
    [
        m::identity_part(
            m::field(PhysicalServer.type, i::SiteId.type, "ref_parent_subnet"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def project: m::Role(PhysicalServer) = m::role(
    dataset,
    site::entity,
    "project",
    False,
    [
        m::identity_part(
            m::field(PhysicalServer.type, i::SiteId.type, "project_id"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def origin: m::Role(PhysicalServer) = m::role(
    dataset,
    origin_entity,
    "origin",
    False,
    [
        m::identity_part(
            m::field(PhysicalServer.type, ServerOriginId.type, "ori_res_id"),
            m::field(OriginIdentity.type, ServerOriginId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type ServerClass = enum {
    @ev::rename("ne.category.server.subrack")
    @ev::description("Tiangong chassis server", "天工机框服务器")
    Subrack,
    @ev::rename("ne.category.server.kunlun")
    @ev::description("KunLun server", "昆仑服务器")
    Kunlun,
    @ev::rename("ne.category.server.rack")
    @ev::description("Rack server", "机架服务器")
    Rack,
    @ev::rename("ne.category.server.taishan")
    @ev::description("TaiShan server", "Taishan服务器")
    Taishan,
    @ev::rename("ne.category.server.heterogeneous")
    @ev::description("Heterogeneous server", "异构服务器")
    Heterogeneous,
    @ev::rename("ne.category.server.enclosure")
    @ev::description("Cabinet", "机柜")
    Enclosure,
    @ev::rename("ne.category.server.chassis")
    @ev::description("Blade server", "刀片服务器")
    NeCategoryServerChassis,
    @ev::rename("ne.category.server.highdensity")
    @ev::description("High-density server", "高密服务器")
    NeCategoryServerHighdensity,
    @ev::rename("ne.category.server.litechassisserver")
    @ev::description("Lightweight chassis server", "轻量型机框服务器")
    NeCategoryServerLitechassisserver,
    @ev::rename("ne.category.server.other")
    @ev::description("Other server", "其他服务器")
    NeCategoryServerOther,
    @ev::rename("ne.category.server.blade")
    @ev::description("Blade", "刀片")
    NeCategoryServerBlade,
    @ev::rename("ne.category.server.switch")
    @ev::description("Switch board", "交换板")
    NeCategoryServerSwitch,
    @ev::rename("ne.category.server.edge")
    @ev::description("Intelligent edge station", "智能小站")
    NeCategoryServerEdge,
};
def ServerClass_domain: v::Domain(ServerClass, String) = v::from_enum(
    "ServerClass",
    ServerClass.type,
    String.type,
    False
);
@knowledge_policy::reverse_references(True)
type ServerHealth = enum {
    @ev::itag(0)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("warning", "警告")
    Warning,
    @ev::itag(2)
    @ev::description("minor", "一般")
    Minor,
    @ev::itag(3)
    @ev::description("major", "严重")
    Major,
    @ev::itag(4)
    @ev::description("critical", "紧急")
    Critical,
    @ev::itag(-1)
    @ev::description("error", "错误")
    Error,
    @ev::itag(-2)
    @ev::description("unknown", "未知")
    Unknown,
};
def ServerHealth_domain: v::Domain(ServerHealth, Int) = v::from_enum(
    "ServerHealth",
    ServerHealth.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type ServerDeviceConnectStatus = enum {
    @ev::itag(1)
    @ev::description("Online", "在线")
    Online,
    @ev::itag(3)
    @ev::description("Offline", "离线")
    Offline,
    @ev::itag(4)
    @ev::description("SNMP unreachable", "SNMP不可达")
    SnmpUnreachable,
    @ev::itag(5)
    @ev::description("Redfish unreachable", "Redfish不可达")
    RedfishUnreachable,
};
def ServerDeviceConnectStatus_domain: v::Domain(ServerDeviceConnectStatus, Int) = v::from_enum(
    "ServerDeviceConnectStatus",
    ServerDeviceConnectStatus.type,
    Int.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "server_belongs_to_tenant",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
def alternatives: Array(registry::Alternative) = [
    {
        id: "server_located_at_site",
        cardinality,
        choices: [
            r::relation(
                "server_located_at_site_subnet",
                r::endpoint(dataset.row, subnet.id),
                r::endpoint(site::dataset.row, site::subject.id),
                cardinality
            ),
            r::relation(
                "server_located_at_site_project",
                r::endpoint(dataset.row, project.id),
                r::endpoint(site::dataset.row, site::subject.id),
                cardinality
            )
        ]
    },
    {
        id: "source_PhysicalServer_X_SITE_VIEW",
        cardinality,
        choices: [
            r::relation(
                "source_PhysicalServer_X_SITE_VIEW_subnet",
                r::endpoint(dataset.row, subnet.id),
                r::endpoint(site::dataset.row, site::subject.id),
                cardinality
            ),
            r::relation(
                "source_PhysicalServer_X_SITE_VIEW_project",
                r::endpoint(dataset.row, project.id),
                r::endpoint(site::dataset.row, site::subject.id),
                cardinality
            )
        ]
    },
];
pub use self::{
    relations,
    alternatives,
    ServerId,
    ServerOriginId,
    Identity,
    entity,
    dataset,
    subject,
    OriginIdentity,
    origin_entity,
    origin
};

pub use self::{PhysicalServer};
