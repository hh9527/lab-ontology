use crate::ontology as edsl;
use std::array as array;
use crate::query as qb;
use std::blame as blame;
use std::codec as codec;
use std::dict as dict;
use std::json as json;
use std::string as string;
use std::type_property as property;
use std::value::{Value};

type LinkKind = enum {
    Member,
    Traversable,
    Related
};
type KnowledgeLink = struct {
    target: edsl::KnowledgeTarget,
    kind: LinkKind
};
type IndexEntry = struct {
    key: edsl::KnowledgeTarget,
    label: String,
    aliases: Array(String),
    summary: String,
    from: Option(edsl::KnowledgeTarget),
    to: Option(edsl::KnowledgeTarget)
};
type Point = struct {
    terms: Array(edsl::TermAnnotation),
    value_type: Option(edsl::ValueTypeBrief),
    value: Option(edsl::CanonicalValueSpec),
    logical_type: Option(edsl::LogicalType),
    nullable: Bool,
    references: Array(edsl::ReferenceSpec),
    field_roles: Array(edsl::FieldRoleBrief),
    roles: Array(edsl::FieldRole),
    target: edsl::KnowledgeTarget,
    label: String,
    aliases: Array(String),
    localized: Array(edsl::LocalizedKnowledgeText),
    summary: String,
    refs: Array(KnowledgeLink),
    grain: Array(String),
    time_roles: Array(edsl::TimeRoleBrief),
    time_role: Option(edsl::TimeRoleBrief),
    dimension: Option(edsl::VisibleDimensionBrief),
    measure: Option(edsl::MeasureBrief),
    relation: Option(edsl::RelationBrief),
    direction: Option(edsl::LinkDirection),
    guard: Option(edsl::ScopePredicate),
    entries: Option(Array(IndexEntry)),
    revision: String,
};
type KnowledgeIndex = struct {
    entries: Array(IndexEntry),
    targets: Dict(edsl::KnowledgeTarget),
    points: Dict(Point),
    datasets: Dict(edsl::DatasetBrief),
    summaries: Dict(String),
    related: Dict(Array(KnowledgeLink)),
    terms: Dict(Array(edsl::TermAnnotation))
};
type DocResult = enum {
    NotFound,
    Found(Point)
};
type KnowledgeResponse = enum {
    Document(DocResult)
};
type KnowledgeRequest = struct {
    method: String,
    input: Value
};
type InfoInput = struct {
    key: String
};
type TermText = struct {
    term: String,
    description: String
};
type Description = struct {
    label: String,
    aliases: Array(String),
    localized: Array(edsl::LocalizedKnowledgeText),
    summary: String,
    terms: Array(TermText)
};
type NodeAddress = edsl::KnowledgeAddress;
type NodeLink = struct {
    type: LinkKind,
    key: String,
    role: String
};
type Node = struct {
    key: String,
    address: NodeAddress,
    type: edsl::KnowledgeKind,
    description: Description,
    links: Array(NodeLink),
    detail: Value
};
type NodeResult = enum {
    NotFound,
    Found(Node)
};
type NodeResponse = enum {
    Document(NodeResult)
};
type DatasetDetail = struct {
    id: String,
    grain: Array(String),
    time_roles: Array(edsl::TimeRoleBrief),
    references: Array(edsl::ReferenceSpec),
    field_roles: Array(edsl::FieldRoleBrief)
};
type FieldDetail = struct {
    id: String,
    dataset: String,
    nullable: Bool,
    logical_type: Option(edsl::LogicalType),
    roles: Array(edsl::FieldRole),
    reference_ids: Array(String)
};
type ValueDetail = struct {
    id: String,
    ty: String,
    wires: Array(edsl::FilterInput)
};
type TypeValueDetail = struct {
    id: String,
    label: String,
    aliases: Array(String),
    localized: Array(edsl::LocalizedValueLabel),
    wires: Array(edsl::FilterInput)
};
type ValueTypeDetail = struct {
    id: String,
    label: String,
    summary: String,
    storage: String,
    half_open: Bool,
    values: Array(TypeValueDetail),
    canonical_order: Array(String)
};
type BusinessLinkDetail = struct {
    id: String,
    hub: String,
    direction: Option(edsl::LinkDirection),
    guard: Option(edsl::ScopePredicate)
};
type DatasetTerm = struct {
    name: String,
    doc: String,
    aliases: Array(String)
};
type DimensionTerm = struct {
    dataset: String,
    name: String,
    doc: String,
    aliases: Array(String)
};
type MeasureTerm = struct {
    dataset: String,
    name: String,
    doc: String,
    aliases: Array(String)
};
type ValueTerm = struct {
    ty: String,
    name: String,
    doc: String,
    aliases: Array(String)
};
type RelationTerm = struct {
    name: String,
    doc: String,
    aliases: Array(String)
};
type LinkEntry = struct {
    source: String,
    target: String,
    kind: LinkKind
};
type LinksIndex = struct {
    revision: String,
    links: Array(LinkEntry)
};
type TerminologyIndex = struct {
    revision: String,
    datasets: Array(DatasetTerm),
    dimensions: Array(DimensionTerm),
    measures: Array(MeasureTerm),
    rels: Array(RelationTerm),
    types: Array(DatasetTerm),
    values: Array(ValueTerm)
};
type DiscoveryInput = struct {};
type KnowledgeRoot = struct {
    discover: Fn() -> DiscoveryDetail,
    nodes: Fn() -> Array(Value),
    complete: Bool
};
type ModelRoots = struct {
    lowering: edsl::PreparedPayload,
    knowledge: KnowledgeRoot
};

def target: Fn(edsl::KnowledgeKind, String, String) -> edsl::KnowledgeTarget = fn(kind, owner, id) {
    {kind, owner, id}
};

def member: Fn(edsl::KnowledgeTarget) -> KnowledgeLink = fn(item) {
    {target: item, kind: LinkKind::Member}
};
def traversable: Fn(edsl::KnowledgeTarget) -> KnowledgeLink = fn(item) {
    {target: item, kind: LinkKind::Traversable}
};

def point: Fn(edsl::KnowledgeTarget, String, Array(String), String, Array(KnowledgeLink)) -> Point = fn(
    id,
    label,
    aliases,
    summary,
    refs
) {
    {
        target: id,
        label,
        aliases,
        localized: [],
        summary,
        refs,
        terms: [],
        grain: [],
        time_roles: [],
        time_role: None,
        references: [],
        field_roles: [],
        roles: [],
        nullable: False,
        logical_type: None,
        dimension: None,
        measure: None,
        relation: None,
        direction: None,
        guard: None,
        entries: None,
        revision: "",
        value_type: None,
        value: None
    }
};

def type_target: Fn(String) -> edsl::KnowledgeTarget = fn(id) {
    target(edsl::KnowledgeKind::Ty, "", id)
};

def input_type_ref: Fn(edsl::FilterInputKind) -> KnowledgeLink = fn(kind) {
    match codec::encode(kind) {
        Value::String(name) => member(type_target(name)),
        other => fail!("logical input type must encode as a name", other),
    }
};

def type_points: Array(Point) = array::map(
    [
        (
            edsl::FilterInputKind::Text,
            "JSON string; literal text comparisons and pattern searches only where the dimension declares them. Text is not an address or a temporal value."
        ),
        (
            edsl::FilterInputKind::Int,
            "JSON integer; exact integral values, with Model-declared comparison operations. Units and business meaning come from the field or measure."
        ),
        (
            edsl::FilterInputKind::Number,
            "JSON number; numeric values with Model-declared comparisons. Units and permitted aggregations come from the Model."
        ),
        (
            edsl::FilterInputKind::Bool,
            "JSON boolean true or false; not a string or integer flag. Model declarations map physical representations."
        ),
        (
            edsl::FilterInputKind::Ipv4,
            "Canonical dotted-decimal JSON string: four octets 0..255 without leading zeros. Eq/Ne compare addresses; InSubnet/NotInSubnet take canonical CIDR networks /0..32. No lexical order, text pattern search or implicit IPv6 conversion. Raw unknown-format addresses remain Text. A validated IPv4 view can return NULL for invalid source values."
        ),
        (
            edsl::FilterInputKind::DateTimeUtc,
            "JSON string expressing a UTC instant as YYYY-MM-DDTHH:MM:SS.SSSZ, for example 2024-03-01T00:00:00.001Z. Inputs accept whole seconds or 1..3 fractional digits and normalize to fixed three-digit UTC milliseconds; offsets and finer precision are outside this domain. Not arbitrary Text or an unzoned local datetime."
        ),
        (
            edsl::FilterInputKind::EpochMillis,
            "JSON integer representing milliseconds since the Unix epoch. The unit is milliseconds, distinct from seconds, Number and arbitrary Int."
        ),
        (
            edsl::FilterInputKind::Date,
            "JSON string YYYY-MM-DD expressing a calendar date without timezone, without a time of day. Not an instant or arbitrary Text."
        ),
        (
            edsl::FilterInputKind::DateTime,
            "JSON string YYYY-MM-DD HH:MM:SS expressing a local calendar datetime without an embedded zone. The value carries neither a timezone nor an ambiguity policy; database session timezone does not establish its business timezone."
        ),
    ],
    fn(entry) {
        let name = match codec::encode(entry.0) {
            Value::String(name) => name,
            other => fail!("logical input type must encode as a name", other),
        };
        point(type_target(name), name, [], entry.1, [])
    }
);

def value_type_points: Fn(edsl::PreparedPayload) -> Array(Point) = fn(payload) {
    array::flat_map(
        edsl::visible_value_types(payload),
        fn(spec) {
            let parent = type_target(spec.id);
            let values = array::map(
                spec.values,
                fn(value) {
                    let current = target(edsl::KnowledgeKind::Value, spec.id, value.id);
                    let base = point(
                        current,
                        value.label,
                        array::concat(
                            [
                                value.aliases,
                                array::map(
                                    value.localized,
                                    fn(text) {
                                        text.label
                                    }
                                )
                            ]
                        ),
                        "",
                        []
                    );
                    {
                        ...base,
                        value: array::find(
                            spec.mapping,
                            fn(mapping) {
                                mapping.id == value.id
                            }
                        ),
                        localized: array::map(
                            value.localized,
                            fn(text) {
                                {locale: text.locale, label: text.label, summary: ""}
                            }
                        )
                    }
                }
            );
            let base = point(
                parent,
                spec.label,
                [],
                spec.summary,
                array::map(
                    values,
                    fn(value) {
                        member(value.target)
                    }
                )
            );
            array::concat([[{...base, value_type: Some(spec)}], values])
        }
    )
};

def index_point: Fn(edsl::PreparedPayload) -> Point = fn(payload) {
    {
        ...point(
            target(edsl::KnowledgeKind::Index, "", "index"),
            "Knowledge index",
            [],
            "Visible domain knowledge, stable identities, types, relationships and declared business constraints.",
            array::map(
                type_points,
                fn(item) {
                    member(item.target)
                }
            )
        ),
        entries: None,
        revision: payload.revision
    }
};

def labels: Fn(Array(edsl::LocalizedKnowledgeText)) -> Array(String) = fn(texts) {
    array::map(
        texts,
        fn(entry) {
            entry.label
        }
    )
};

def dataset_point: Fn(edsl::PreparedPayload, edsl::DatasetBrief) -> Point = fn(payload, brief) {
    let id = target(edsl::KnowledgeKind::Dataset, "", brief.id);
    let dimensions = array::map(
        brief.dimension_ids,
        fn(name) {
            member(target(edsl::KnowledgeKind::Dimension, brief.id, name))
        }
    );
    let fields = array::map(
        edsl::published_fields(payload, brief.id),
        fn(name) {
            member(target(edsl::KnowledgeKind::Field, brief.id, name))
        }
    );
    let measures = array::map(
        brief.measure_ids,
        fn(name) {
            member(target(edsl::KnowledgeKind::Measure, brief.id, name))
        }
    );
    let times = array::map(
        brief.time_roles,
        fn(role) {
            member(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field))
        }
    );
    let relations = array::map(
        brief.relation_ids,
        fn(name) {
            let declared = match array::find(
                payload.relations,
                fn(entry) {
                    entry.id == name
                }
            ) {
                Some(entry) => entry,
                None => fail!("knowledge relation disappeared from prepared model", name),
            };
            member(target(edsl::KnowledgeKind::Relation, payload.entities[declared.from].id, name))
        }
    );
    let links = array::map(
        array::filter(
            payload.business_links,
            fn(link) {
                let hub = payload.entities[link.hub].id;
                let participant = payload.entities[link.participant].id;
                hub == brief.id || participant == brief.id
            }
        ),
        fn(link) {
            member(
                target(edsl::KnowledgeKind::BusinessLink, payload.entities[link.hub].id, link.id)
            )
        }
    );
    let refs = array::concat([fields, dimensions, measures, times, relations, links]);
    let item = point(
        id,
        brief.label,
        array::concat([brief.aliases, labels(brief.localized)]),
        brief.summary,
        refs
    );
    let entity = match array::find(
        payload.entities,
        fn(e) {
            e.id == brief.id
        }
    ) {
        Some(e) => e,
        None => fail!("knowledge dataset disappeared from prepared model", brief.id),
    };
    let grain = match entity.dataset {
        Some(spec) => spec.grain,
        None => if entity.key_field >= 0 {
            [entity.fields[entity.key_field].name]
        } else {
            []
        },
    };
    {
        ...item,
        localized: brief.localized,
        grain,
        time_roles: brief.time_roles,
        references: brief.references,
        field_roles: brief.field_roles
    }
};

def dimension_point: Fn(edsl::PreparedPayload, String) -> Point = fn(payload, id) {
    let detail = edsl::visible_dimension_detail(payload, id);
    let dimension = target(edsl::KnowledgeKind::Dimension, detail.dataset, detail.id);
    let value_refs = array::map(
        detail.values,
        fn(value) {
            member(target(edsl::KnowledgeKind::Value, detail.ty, value.id))
        }
    );
    let contracts = array::map(detail.input_kinds, input_type_ref);
    let base = point(
        dimension,
        detail.label,
        array::concat([detail.aliases, labels(detail.localized)]),
        detail.summary,
        array::concat(
            [
                [
                    member(target(edsl::KnowledgeKind::Field, detail.dataset, detail.field)),
                    member(type_target(detail.ty))
                ],
                value_refs,
                contracts
            ]
        )
    );
    {...base, dimension: Some(detail), localized: detail.localized}
};

def measure_point: Fn(edsl::PreparedPayload, String) -> Point = fn(payload, id) {
    let detail = edsl::measure_detail(payload, id);
    let field_refs = match detail.field {
        Some(name) => [member(target(edsl::KnowledgeKind::Field, detail.dataset, name))],
        None => [],
    };
    let predicate_refs = match detail.predicate {
        None => [],
        Some(predicate) => do {
            let entity = match array::find(
                payload.entities,
                fn(entry) {
                    entry.id == detail.dataset
                }
            ) {
                Some(entry) => entry,
                None => fail!("measure predicate owner is not in the prepared model", id),
            };
            let field = match array::find(
                entity.fields,
                fn(entry) {
                    entry.name == predicate.field
                }
            ) {
                Some(entry) => entry,
                None => fail!(
                    "measure predicate field is not in the prepared model",
                    id,
                    predicate.field
                ),
            };
            let dimension = match array::find(
                payload.dimensions,
                fn(entry) {
                    entry.entity == entity.index && entry.field == field.index
                }
            ) {
                Some(entry) => entry,
                None => fail!(
                    "measure predicate dimension is not in the prepared model",
                    id,
                    predicate.field
                ),
            };
            let dimension_ref = target(edsl::KnowledgeKind::Dimension, detail.dataset, dimension.id);
            let business = edsl::visible_dimension_detail(payload, dimension.id);
            let value_ref = match (predicate.op, predicate.input) {
                (edsl::FilterOp::Eq, edsl::FilterInput::Text(name)) => if array::any(
                    business.values,
                    fn(value) {
                        value.id == name
                    }
                ) {
                    [member(target(edsl::KnowledgeKind::Value, dimension.ty, name))]
                } else {
                    []
                },
                _ => [],
            };
            array::concat([[member(dimension_ref)], value_ref])
        },
    };
    let computed_refs = match detail.computed {
        Some(computed) => [
            member(target(edsl::KnowledgeKind::Measure, detail.dataset, computed.left)),
            member(target(edsl::KnowledgeKind::Measure, detail.dataset, computed.right))
        ],
        None => [],
    };
    let latest_refs = if detail.aggregate == Some(qb::AggregateFunction::Latest) {
        let dataset = edsl::dataset_domain(payload, detail.dataset);
        array::concat(
            [
                match dataset.utc_time {
                    Some(name) => [
                        member(target(edsl::KnowledgeKind::TimeRole, detail.dataset, name))
                    ],
                    None => [],
                },
                array::map(
                    dataset.grain,
                    fn(name) {
                        member(target(edsl::KnowledgeKind::Field, detail.dataset, name))
                    }
                )
            ]
        )
    } else {
        []
    };
    let refs = array::concat(
        [
            field_refs,
            array::map(
                detail.required_dataset_ids,
                fn(dataset) {
                    member(target(edsl::KnowledgeKind::Dataset, "", dataset))
                }
            ),
            predicate_refs,
            computed_refs,
            latest_refs,
        ]
    );
    let base = point(
        target(edsl::KnowledgeKind::Measure, detail.dataset, detail.id),
        detail.label,
        array::concat([detail.aliases, labels(detail.localized)]),
        detail.summary,
        refs
    );
    {
        ...base,
        measure: Some(detail),
        localized: detail.localized,
        grain: if detail.aggregate == Some(qb::AggregateFunction::Latest) {
            edsl::dataset_domain(payload, detail.dataset).grain
        } else {
            []
        }
    }
};

def relation_point: Fn(edsl::PreparedPayload, String) -> Point = fn(payload, id) {
    let detail = edsl::relation_detail(payload, id);
    let guard_refs = match detail.guard {
        Some(guard) => [
            member(target(edsl::KnowledgeKind::Field, detail.from_dataset, guard.field))
        ],
        None => [],
    };
    let base = point(
        target(edsl::KnowledgeKind::Relation, detail.from_dataset, detail.id),
        detail.label,
        array::concat([detail.aliases, labels(detail.localized)]),
        detail.summary,
        array::concat(
            [
                [
                    member(target(edsl::KnowledgeKind::Dataset, "", detail.from_dataset)),
                    traversable(target(edsl::KnowledgeKind::Dataset, "", detail.to_dataset))
                ],
                guard_refs
            ]
        )
    );
    {...base, relation: Some(detail), localized: detail.localized}
};

def link_point: Fn(edsl::PreparedPayload, edsl::BusinessLinkEntry) -> Point = fn(payload, link) {
    let hub = payload.entities[link.hub].id;
    let participant = payload.entities[link.participant].id;
    let guard_refs = match link.guard {
        None => [],
        Some(pred) => [member(target(edsl::KnowledgeKind::Field, hub, pred.field))],
    };
    let note = match property::get_type_prop(
        payload.entities[link.hub].entity_type,
        edsl::BusinessLinkDescriptions.type
    ) {
        Some(descriptions) => array::find(
            descriptions.notes,
            fn(note) {
                note.id == link.id
            }
        ),
        None => None,
    };
    let base = point(
        target(edsl::KnowledgeKind::BusinessLink, hub, link.id),
        match note {
            Some(value) => value.label,
            None => link.id
        },
        [],
        match note {
            Some(value) => value.summary,
            None => ""
        },
        array::concat(
            [
                [
                    member(target(edsl::KnowledgeKind::Dataset, "", hub)),
                    traversable(target(edsl::KnowledgeKind::Dataset, "", participant)),
                    member(target(edsl::KnowledgeKind::Relation, hub, link.a_relation)),
                    member(target(edsl::KnowledgeKind::Relation, hub, link.z_relation))
                ],
                guard_refs
            ]
        )
    );
    {...base, direction: Some(link.direction), guard: link.guard}
};

def field_point: Fn(edsl::PreparedPayload, edsl::DatasetBrief, String) -> Point = fn(
    payload,
    brief,
    name
) {
    let entity = match array::find(
        payload.entities,
        fn(entity) {
            entity.id == brief.id
        }
    ) {
        Some(entity) => entity,
        None => fail!("published dataset missing", brief.id),
    };
    let item = point(target(edsl::KnowledgeKind::Field, brief.id, name), name, [], "", []);
    let field = match array::find(
        entity.fields,
        fn(field) {
            field.name == name
        }
    ) {
        Some(field) => field,
        None => fail!("published field missing", brief.id, name),
    };
    {
        ...item,
        nullable: field.nullable,
        logical_type: field.logical_type,
        refs: match field.logical_type {
            Some(kind) => match codec::encode(kind) {
                Value::String(name) => array::push(item.refs, member(type_target(name))),
                other => fail!("logical field type must encode as a name", other),
            },
            None => item.refs,
        },
        roles: match array::find(
            brief.field_roles,
            fn(field) {
                field.field == name
            }
        ) {
            Some(field) => field.roles,
            None => [],
        },
        references: array::filter(
            brief.references,
            fn(ref) {
                array::any(
                    ref.fields,
                    fn(field) {
                        field == name
                    }
                )
            }
        )
    }
};

def time_role_point: Fn(edsl::DatasetBrief, edsl::TimeRoleBrief) -> Point = fn(brief, role) {
    let base = point(
        target(edsl::KnowledgeKind::TimeRole, brief.id, role.field),
        role.field,
        [],
        "",
        array::concat(
            [
                [member(target(edsl::KnowledgeKind::Field, brief.id, role.field))],
                array::map(
                    role.dimension_ids,
                    fn(id) {
                        member(target(edsl::KnowledgeKind::Dimension, brief.id, id))
                    }
                ),
                [
                    match codec::encode(role.logical_type) {
                        Value::String(name) => member(type_target(name)),
                        other => fail!("time logical type must encode as a name", other),
                    }
                ]
            ]
        )
    );
    {...base, time_role: Some(role)}
};

def dataset_members: Fn(edsl::PreparedPayload, edsl::DatasetBrief) -> Array(Point) = fn(
    payload,
    brief
) {
    let fields = array::map(
        edsl::published_fields(payload, brief.id),
        fn(name) {
            field_point(payload, brief, name)
        }
    );
    let dimensions = array::map(
        brief.dimension_ids,
        fn(id) {
            dimension_point(payload, id)
        }
    );
    let measures = array::map(
        brief.measure_ids,
        fn(id) {
            measure_point(payload, id)
        }
    );
    let relations = array::map(
        array::filter(
            payload.relations,
            fn(entry) {
                entry.id != "" && payload.entities[entry.from].id == brief.id
            }
        ),
        fn(entry) {
            relation_point(payload, entry.id)
        }
    );
    let times = array::map(
        brief.time_roles,
        fn(role) {
            time_role_point(brief, role)
        }
    );
    let links = array::map(
        array::filter(
            payload.business_links,
            fn(link) {
                payload.entities[link.hub].id == brief.id
            }
        ),
        fn(link) {
            link_point(payload, link)
        }
    );
    array::concat([fields, dimensions, measures, relations, times, links])
};

def target_key: Fn(edsl::KnowledgeTarget) -> String = fn(id) {
    edsl::knowledge_key(id)
};

def target_role: Fn(edsl::KnowledgeKind) -> String = edsl::knowledge_role;
def target_address: Fn(edsl::KnowledgeTarget) -> NodeAddress = edsl::knowledge_address;

def visible_terms: Fn(edsl::PreparedPayload, Array(IndexEntry)) -> Array(edsl::TermAnnotation) = fn(
    payload,
    entries
) {
    let declared = array::filter(
        array::flat_map(
            edsl::knowledge_annotation_types(payload),
            fn(ty) {
                match property::get_type_prop(ty, edsl::TermAnnotations.type) {
                    Some(declared) => declared.entries,
                    None => [],
                }
            }
        ),
        fn(entry) {
            array::any(
                entries,
                fn(item) {
                    item.key == entry.target
                }
            )
        }
    );
    let aliases = array::flat_map(
        entries,
        fn(entry) {
            array::map(
                entry.aliases,
                fn(term) {
                    {
                        term,
                        description: if entry.summary == "" {
                            entry.label
                        } else {
                            entry.summary
                        },
                        target: entry.key
                    }.ty!(edsl::TermAnnotation)
                }
            )
        }
    );
    array::fold(
        array::concat([declared, aliases]),
        [].ty!(Array(edsl::TermAnnotation)),
        fn(seen, entry) {
            if array::any(
                seen,
                fn(other) {
                    other.term == entry.term && other.target == entry.target
                }
            ) {
                seen
            } else {
                array::push(seen, entry)
            }
        }
    )
};

# Materialize the same nodes as the public, cached lookup path.
def map: Fn(edsl::PreparedPayload) -> Array(Point) = fn(payload) {
    let index = index_from_model(payload);
    let declared_terms = array::flat_map(
        edsl::knowledge_annotation_types(payload),
        fn(ty) {
            match property::get_type_prop(ty, edsl::TermAnnotations.type) {
                Some(spec) => spec.entries,
                None => [],
            }
        }
    );
    let datasets = edsl::visible_knowledge_index(payload);
    let domain = array::concat(
        [
            array::map(
                datasets,
                fn(brief) {
                    dataset_point(payload, brief)
                }
            ),
            array::flat_map(
                datasets,
                fn(brief) {
                    dataset_members(payload, brief)
                }
            ),
        ]
    );
    let docs = array::flat_map(
        edsl::knowledge_annotation_types(payload),
        fn(ty) {
            match property::get_type_prop(ty, edsl::KnowledgeDocs.type) {
                Some(declared) => declared.entries,
                None => [],
            }
        }
    );
    let related = array::flat_map(
        edsl::knowledge_annotation_types(payload),
        fn(ty) {
            match property::get_type_prop(ty, edsl::KnowledgeRelations.type) {
                Some(declared) => declared.entries,
                None => [],
            }
        }
    );
    let keys = dict::from_pairs(
        array::map(
            index.entries,
            fn(entry) {
                (target_key(entry.key), True)
            }
        )
    );
    let raw = array::concat(
        [
            type_points,
            array::map(
                domain,
                fn(item) {
                    let refs = array::concat(
                        [
                            item.refs,
                            array::map(
                                array::filter(
                                    related,
                                    fn(ref) {
                                        ref.source == item.target && dict::get(
                                            keys,
                                            target_key(ref.target)
                                        ) != None
                                    }
                                ),
                                fn(ref) {
                                    {target: ref.target, kind: LinkKind::Related}
                                }
                            )
                        ]
                    );
                    let summary = match array::find(
                        docs,
                        fn(note) {
                            note.target == item.target
                        }
                    ) {
                        Some(note) => note.text,
                        None => item.summary,
                    };
                    {...item, refs, summary}
                }
            ),
            array::map(
                dict::keys(index.points),
                fn(key) {
                    match dict::get(index.points, key) {
                        Some(item) => item,
                        None => fail!("cached knowledge point disappeared", key),
                    }
                }
            )
        ]
    );
    let visible = dict::from_pairs(
        array::map(
            raw,
            fn(item) {
                (target_key(item.target), True)
            }
        )
    );
    if let Some(dangling) = array::find(
        raw,
        fn(item) {
            array::any(
                item.refs,
                fn(ref) {
                    dict::get(visible, target_key(ref.target)) == None
                }
            )
        }
    ) {
        fail!("knowledge point references a point outside the visible model", dangling.target)
    } else {
        array::map(
            raw,
            fn(item) {
                {
                    ...item,
                    terms: array::filter(
                        declared_terms,
                        fn(term) {
                            term.target == item.target
                        }
                    )
                }
            }
        )
    }
};

def index_entries: Fn(Array(Point)) -> KnowledgeIndex = fn(points) {
    {
        entries: array::map(
            points,
            fn(item) {
                {
                    key: item.target,
                    label: item.label,
                    aliases: item.aliases,
                    summary: item.summary,
                    from: None,
                    to: None
                }
            }
        ),
        targets: {},
        points: {},
        datasets: {},
        summaries: {},
        related: {},
        terms: {}
    }
};

# Request-local materialization for a host-owned knowledge index. This path
# builds each published point directly, without preparing the lookup catalog.
def export_points: Fn(edsl::PreparedPayload) -> Array(Point) = fn(payload) {
    let datasets = edsl::visible_knowledge_index(payload);
    let raw = array::concat(
        [
            [index_point(payload)],
            type_points,
            value_type_points(payload),
            array::flat_map(
                datasets,
                fn(brief) {
                    array::concat(
                        [[dataset_point(payload, brief)], dataset_members(payload, brief)]
                    )
                }
            )
        ]
    );
    let keys = dict::from_pairs(
        array::map(
            raw,
            fn(item) {
                (target_key(item.target), True)
            }
        )
    );
    if array::length(dict::keys(keys)) != array::length(raw) {
        fail!("knowledge keys must identify exactly one visible node")
    } else {
        ()
    };
    array::map(raw, export_decorator(payload, keys))
};

def export_decorator: Fn(edsl::PreparedPayload, Dict(Bool)) -> Fn(Point) -> Point = fn(
    payload,
    keys
) {
    let annotation_types = edsl::knowledge_annotation_types(payload);
    let docs = array::flat_map(
        annotation_types,
        fn(ty) {
            match property::get_type_prop(ty, edsl::KnowledgeDocs.type) {
                Some(spec) => spec.entries,
                None => [],
            }
        }
    );
    let entity_docs = array::flat_map(
        payload.entities,
        fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeDocs.type) {
                Some(spec) => spec.entries,
                None => [],
            }
        }
    );
    let related = array::flat_map(
        payload.entities,
        fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeRelations.type) {
                Some(spec) => spec.entries,
                None => [],
            }
        }
    );
    let terms = array::flat_map(
        annotation_types,
        fn(ty) {
            match property::get_type_prop(ty, edsl::TermAnnotations.type) {
                Some(spec) => spec.entries,
                None => [],
            }
        }
    );
    fn(item) {
        let cached = item.target.kind == edsl::KnowledgeKind::Index || item.target.kind == edsl::KnowledgeKind::Value || item.value_type != None;
        let primitive = item.target.kind == edsl::KnowledgeKind::Ty && item.value_type == None;
        let summary = if primitive {
            item.summary
        } else {
            match array::find(
                if cached {
                    docs
                } else {
                    entity_docs
                },
                fn(note) {
                    note.target == item.target
                }
            ) {
                Some(note) => note.text,
                None => item.summary,
            }
        };
        let refs = if cached || primitive {
            item.refs
        } else {
            array::concat(
                [
                    item.refs,
                    array::map(
                        array::filter(
                            related,
                            fn(ref) {
                                ref.source == item.target && dict::get(keys, target_key(ref.target)) != None
                            }
                        ),
                        fn(ref) {
                            {target: ref.target, kind: LinkKind::Related}
                        }
                    )
                ]
            )
        };
        let enriched = {
            ...item,
            summary,
            refs,
            terms: if item.target.kind == edsl::KnowledgeKind::Index || item.target.kind == edsl::KnowledgeKind::Schema {
                []
            } else {
                array::filter(
                    terms,
                    fn(term) {
                        term.target == item.target
                    }
                )
            }
        };
        if array::any(
            enriched.refs,
            fn(ref) {
                dict::get(keys, target_key(ref.target)) == None
            }
        ) {
            fail!("knowledge point references a point outside the visible model", enriched.target)
        } else {
            enriched
        }
    }
};

# Build the visibility set from identities, without materializing domain details.
def export_keys: Fn(edsl::PreparedPayload, Array(edsl::DatasetBrief), Array(Point)) -> Dict(Bool) = fn(
    payload,
    datasets,
    typed
) {
    let identities = array::concat(
        [
            [target(edsl::KnowledgeKind::Index, "", "index")],
            array::map(
                array::concat([type_points, typed]),
                fn(item) {
                    item.target
                }
            ),
            array::flat_map(
                datasets,
                fn(brief) {
                    array::concat(
                        [
                            [target(edsl::KnowledgeKind::Dataset, "", brief.id)],
                            array::map(
                                edsl::published_fields(payload, brief.id),
                                fn(id) {
                                    target(edsl::KnowledgeKind::Field, brief.id, id)
                                }
                            ),
                            array::map(
                                brief.dimension_ids,
                                fn(id) {
                                    target(edsl::KnowledgeKind::Dimension, brief.id, id)
                                }
                            ),
                            array::map(
                                brief.measure_ids,
                                fn(id) {
                                    target(edsl::KnowledgeKind::Measure, brief.id, id)
                                }
                            ),
                            array::map(
                                brief.time_roles,
                                fn(role) {
                                    target(edsl::KnowledgeKind::TimeRole, brief.id, role.field)
                                }
                            ),
                        ]
                    )
                }
            ),
            array::map(
                array::filter(
                    payload.relations,
                    fn(rel) {
                        rel.id != ""
                    }
                ),
                fn(rel) {
                    target(edsl::KnowledgeKind::Relation, payload.entities[rel.from].id, rel.id)
                }
            ),
            array::map(
                payload.business_links,
                fn(link) {
                    target(
                        edsl::KnowledgeKind::BusinessLink,
                        payload.entities[link.hub].id,
                        link.id
                    )
                }
            ),
        ]
    );
    let keys = dict::from_pairs(
        array::map(
            identities,
            fn(id) {
                (target_key(id), True)
            }
        )
    );
    if array::length(dict::keys(keys)) != array::length(identities) {
        fail!("knowledge keys must identify exactly one visible node")
    } else {
        keys
    }
};

# Encode one dataset at a time so the response does not retain both the full
# rich Point graph and the serialized Node graph within the request heap.
def export_nodes: Fn(edsl::PreparedPayload) -> Array(Value) = fn(payload) {
    let datasets = edsl::visible_knowledge_index(payload);
    let typed = value_type_points(payload);
    let keys = export_keys(payload, datasets, typed);
    let decorate = export_decorator(payload, keys);
    array::concat(
        [
            array::map(
                array::concat([[index_point(payload)], type_points, typed]),
                fn(item) {
                    node_value(decorate(item))
                }
            ),
            array::flat_map(
                datasets,
                fn(brief) {
                    array::map(
                        array::concat(
                            [[dataset_point(payload, brief)], dataset_members(payload, brief)]
                        ),
                        fn(item) {
                            node_value(decorate(item))
                        }
                    )
                }
            ),
        ]
    )
};

def index_entry: Fn(edsl::KnowledgeTarget, String, Array(String), String) -> IndexEntry = fn(
    key,
    label,
    aliases,
    summary
) {
    {key, label, aliases, summary, from: None, to: None}
};

def index_from_model: Fn(edsl::PreparedPayload) -> KnowledgeIndex = fn(payload) {
    let datasets = edsl::visible_knowledge_index(payload);
    let roots = array::map(
        datasets,
        fn(brief) {
            index_entry(
                target(edsl::KnowledgeKind::Dataset, "", brief.id),
                brief.label,
                array::concat([brief.aliases, labels(brief.localized)]),
                brief.summary
            )
        }
    );
    let members = array::flat_map(
        datasets,
        fn(brief) {
            let fields = array::map(
                edsl::published_fields(payload, brief.id),
                fn(name) {
                    index_entry(target(edsl::KnowledgeKind::Field, brief.id, name), name, [], "")
                }
            );
            let dimensions = array::map(
                array::filter(
                    payload.dimensions,
                    fn(entry) {
                        entry.authorized && payload.entities[entry.entity].id == brief.id
                    }
                ),
                fn(entry) {
                    let detail = edsl::dimension_brief(payload, entry);
                    index_entry(
                        target(edsl::KnowledgeKind::Dimension, brief.id, entry.id),
                        detail.label,
                        array::concat([detail.aliases, labels(detail.localized)]),
                        detail.summary
                    )
                }
            );
            let measures = array::map(
                brief.measure_ids,
                fn(id) {
                    let detail = edsl::measure_detail(payload, id);
                    index_entry(
                        target(edsl::KnowledgeKind::Measure, brief.id, id),
                        detail.label,
                        array::concat([detail.aliases, labels(detail.localized)]),
                        detail.summary
                    )
                }
            );
            let relations = array::map(
                array::filter(
                    payload.relations,
                    fn(entry) {
                        entry.id != "" && payload.entities[entry.from].id == brief.id
                    }
                ),
                fn(entry) {
                    let detail = edsl::relation_detail(payload, entry.id);
                    {
                        ...index_entry(
                            target(edsl::KnowledgeKind::Relation, brief.id, entry.id),
                            detail.label,
                            array::concat([detail.aliases, labels(detail.localized)]),
                            detail.summary
                        ),
                        from: Some(
                            target(
                                edsl::KnowledgeKind::Dataset,
                                "",
                                payload.entities[entry.from].id
                            )
                        ),
                        to: Some(
                            target(edsl::KnowledgeKind::Dataset, "", payload.entities[entry.to].id)
                        )
                    }
                }
            );
            let times = array::map(
                brief.time_roles,
                fn(role) {
                    index_entry(
                        target(edsl::KnowledgeKind::TimeRole, brief.id, role.field),
                        role.field,
                        [],
                        ""
                    )
                }
            );
            let links = array::map(
                array::filter(
                    payload.business_links,
                    fn(link) {
                        payload.entities[link.hub].id == brief.id
                    }
                ),
                fn(link) {
                    let detail = link_point(payload, link);
                    {
                        ...index_entry(detail.target, detail.label, detail.aliases, detail.summary),
                        from: Some(target(edsl::KnowledgeKind::Dataset, "", brief.id)),
                        to: Some(
                            target(
                                edsl::KnowledgeKind::Dataset,
                                "",
                                payload.entities[link.participant].id
                            )
                        )
                    }
                }
            );
            array::concat([fields, dimensions, measures, relations, times, links])
        }
    );
    let docs = array::flat_map(
        edsl::knowledge_annotation_types(payload),
        fn(ty) {
            match property::get_type_prop(ty, edsl::KnowledgeDocs.type) {
                Some(declared) => declared.entries,
                None => [],
            }
        }
    );
    let typed = value_type_points(payload);
    let entries = array::map(
        array::concat(
            [index_entries(type_points).entries, index_entries(typed).entries, roots, members]
        ),
        fn(entry) {
            match array::find(
                docs,
                fn(note) {
                    note.target == entry.key
                }
            ) {
                Some(note) => {...entry, summary: note.text},
                None => entry,
            }
        }
    );
    let keys = dict::from_pairs(
        array::map(
            entries,
            fn(entry) {
                (target_key(entry.key), True)
            }
        )
    );
    if array::length(dict::keys(keys)) != array::length(entries) {
        fail!("knowledge keys must identify exactly one visible node", entries)
    } else {
        let root = index_point(payload);
        let catalog = array::concat([entries, index_entries([root]).entries]);
        let summaries = array::fold(
            array::flat_map(
                payload.entities,
                fn(entity) {
                    match property::get_type_prop(entity.entity_type, edsl::KnowledgeDocs.type) {
                        Some(declared) => declared.entries,
                        None => [],
                    }
                }
            ),
            {}.ty!(Dict(String)),
            fn(seen, note) {
                let key = target_key(note.target);
                if dict::get(seen, key) != None {
                    seen
                } else {
                    dict::merge(seen, dict::from_pairs([(key, note.text)]))
                }
            }
        );
        let related = array::fold(
            array::flat_map(
                payload.entities,
                fn(entity) {
                    match property::get_type_prop(entity.entity_type, edsl::KnowledgeRelations.type) {
                        Some(declared) => declared.entries,
                        None => [],
                    }
                }
            ),
            {}.ty!(Dict(Array(KnowledgeLink))),
            fn(seen, ref) {
                if dict::get(keys, target_key(ref.target)) == None {
                    seen
                } else {
                    let key = target_key(ref.source);
                    let refs = match dict::get(seen, key) {
                        Some(items) => items,
                        None => []
                    };
                    dict::merge(
                        seen,
                        dict::from_pairs(
                            [
                                (
                                    key,
                                    array::push(refs, {target: ref.target, kind: LinkKind::Related})
                                )
                            ]
                        )
                    )
                }
            }
        );
        let terms = array::fold(
            array::flat_map(
                edsl::knowledge_annotation_types(payload),
                fn(ty) {
                    match property::get_type_prop(ty, edsl::TermAnnotations.type) {
                        Some(spec) => spec.entries,
                        None => [],
                    }
                }
            ),
            {}.ty!(Dict(Array(edsl::TermAnnotation))),
            fn(seen, term) {
                let key = target_key(term.target);
                let items = match dict::get(seen, key) {
                    Some(items) => items,
                    None => []
                };
                dict::merge(seen, dict::from_pairs([(key, array::push(items, term))]))
            }
        );
        {
            entries: catalog,
            datasets: dict::from_pairs(
                array::map(
                    datasets,
                    fn(brief) {
                        (brief.id, brief)
                    }
                )
            ),
            summaries,
            related,
            terms,
            targets: dict::from_pairs(
                array::map(
                    catalog,
                    fn(entry) {
                        (target_key(entry.key), entry.key)
                    }
                )
            ),
            points: dict::from_pairs(
                array::map(
                    array::concat([[root], typed]),
                    fn(item) {
                        let summary = match array::find(
                            docs,
                            fn(note) {
                                note.target == item.target
                            }
                        ) {
                            Some(note) => note.text,
                            None => item.summary,
                        };
                        (target_key(item.target), {...item, summary})
                    }
                )
            )
        }
    }
};

def distinct_text: Fn(Array(String)) -> Array(String) = fn(items) {
    array::fold(
        items,
        [].ty!(Array(String)),
        fn(seen, item) {
            if item == "" || array::any(
                seen,
                fn(other) {
                    other == item
                }
            ) {
                seen
            } else {
                array::push(seen, item)
            }
        }
    )
};

def terminology_entry: Fn(IndexEntry, Array(edsl::TermAnnotation), Array(String)) -> DatasetTerm = fn(
    entry,
    terms,
    localized_docs
) {
    let matching = array::filter(
        terms,
        fn(term) {
            term.target == entry.key
        }
    );
    let aliases = distinct_text(
        array::concat(
            [
                [entry.label],
                entry.aliases,
                array::map(
                    matching,
                    fn(term) {
                        term.term
                    }
                )
            ]
        )
    );
    {
        name: entry.key.id,
        doc: string::join(
            distinct_text(
                array::concat(
                    [
                        [entry.summary],
                        localized_docs,
                        array::map(
                            matching,
                            fn(term) {
                                term.description
                            }
                        )
                    ]
                )
            ),
            "\n"
        ),
        aliases: array::filter(
            aliases,
            fn(alias) {
                alias != entry.key.id
            }
        )
    }
};

def terminology_from_catalog: Fn(edsl::PreparedPayload, KnowledgeIndex) -> TerminologyIndex = fn(
    payload,
    index
) {
    let terms = visible_terms(payload, index.entries);
    let datasets = edsl::visible_knowledge_index(payload);
    {
        revision: payload.revision,
        types: array::map(
            array::filter(
                index.entries,
                fn(entry) {
                    entry.key.kind == edsl::KnowledgeKind::Ty && dict::get(
                        index.points,
                        target_key(entry.key)
                    ) != None
                }
            ),
            fn(entry) {
                terminology_entry(entry, terms, [])
            }
        ),
        datasets: array::map(
            array::filter(
                index.entries,
                fn(entry) {
                    entry.key.kind == edsl::KnowledgeKind::Dataset
                }
            ),
            fn(entry) {
                let brief = match array::find(
                    datasets,
                    fn(brief) {
                        brief.id == entry.key.id
                    }
                ) {
                    Some(brief) => brief,
                    None => fail!("terminology dataset disappeared", entry.key),
                };
                terminology_entry(
                    entry,
                    terms,
                    array::map(
                        brief.localized,
                        fn(text) {
                            text.summary
                        }
                    )
                )
            }
        ),
        dimensions: array::map(
            array::filter(
                index.entries,
                fn(entry) {
                    entry.key.kind == edsl::KnowledgeKind::Dimension
                }
            ),
            fn(entry) {
                let detail = edsl::visible_dimension_detail(payload, entry.key.id);
                let text = terminology_entry(
                    entry,
                    terms,
                    array::map(
                        detail.localized,
                        fn(text) {
                            text.summary
                        }
                    )
                );
                {dataset: entry.key.owner, name: text.name, doc: text.doc, aliases: text.aliases}.ty!(
                    DimensionTerm
                )
            }
        ),
        measures: array::map(
            array::filter(
                index.entries,
                fn(entry) {
                    entry.key.kind == edsl::KnowledgeKind::Measure
                }
            ),
            fn(entry) {
                let detail = edsl::measure_detail(payload, entry.key.id);
                let text = terminology_entry(
                    entry,
                    terms,
                    array::map(
                        detail.localized,
                        fn(text) {
                            text.summary
                        }
                    )
                );
                {dataset: entry.key.owner, name: text.name, doc: text.doc, aliases: text.aliases}.ty!(
                    MeasureTerm
                )
            }
        ),
        values: array::map(
            array::filter(
                index.entries,
                fn(entry) {
                    entry.key.kind == edsl::KnowledgeKind::Value
                }
            ),
            fn(entry) {
                let text = terminology_entry(entry, terms, []);
                {ty: entry.key.owner, name: text.name, doc: text.doc, aliases: text.aliases}.ty!(
                    ValueTerm
                )
            }
        ),
        rels: array::map(
            array::filter(
                index.entries,
                fn(entry) {
                    entry.key.kind == edsl::KnowledgeKind::Relation
                }
            ),
            fn(entry) {
                let detail = edsl::relation_detail(payload, entry.key.id);
                let text = terminology_entry(
                    entry,
                    terms,
                    array::map(
                        detail.localized,
                        fn(text) {
                            text.summary
                        }
                    )
                );
                {name: text.name, doc: text.doc, aliases: text.aliases}.ty!(RelationTerm)
            }
        )
    }
};

def terminology_from_model: Fn(edsl::PreparedPayload) -> TerminologyIndex = fn(payload) {
    terminology_from_catalog(payload, index_from_model(payload))
};

def links_from_model: Fn(edsl::PreparedPayload) -> LinksIndex = fn(payload) {
    {
        revision: payload.revision,
        links: array::flat_map(
            map(payload),
            fn(item) {
                let unique = array::fold(
                    item.refs,
                    {}.ty!(Dict(KnowledgeLink)),
                    fn(seen, ref) {
                        let key = json::stringify(codec::encode((target_key(ref.target), ref.kind)));
                        if dict::get(seen, key) != None {
                            seen
                        } else {
                            dict::merge(seen, dict::from_pairs([(key, ref)]))
                        }
                    }
                );
                array::map(
                    dict::values(unique),
                    fn(ref) {
                        {
                            source: target_key(item.target),
                            target: target_key(ref.target),
                            kind: ref.kind
                        }.ty!(LinkEntry)
                    }
                )
            }
        )
    }.ty!(LinksIndex)
};

def raw_point_from_model: Fn(
    edsl::PreparedPayload,
    KnowledgeIndex,
    edsl::KnowledgeTarget
) -> DocResult = fn(payload, index, key) {
    if dict::get(index.targets, target_key(key)) != Some(key) {
        DocResult::NotFound
    } else if let Some(item) = dict::get(index.points, target_key(key)) {
        DocResult::Found(item)
    } else if key.kind == edsl::KnowledgeKind::Ty {
        match array::find(
            type_points,
            fn(item) {
                item.target == key
            }
        ) {
            Some(item) => DocResult::Found(item),
            None => fail!("knowledge data type disappeared", key),
        }
    } else {
        let owner = if key.kind == edsl::KnowledgeKind::Dataset {
            key.id
        } else {
            key.owner
        };
        let brief = match dict::get(index.datasets, owner) {
            Some(entry) => entry,
            None => fail!("knowledge key owner disappeared from prepared model", key),
        };
        let raw = match key.kind {
            edsl::KnowledgeKind::Dataset => dataset_point(payload, brief),
            edsl::KnowledgeKind::Field => field_point(payload, brief, key.id),
            edsl::KnowledgeKind::Dimension => dimension_point(payload, key.id),
            edsl::KnowledgeKind::Measure => measure_point(payload, key.id),
            edsl::KnowledgeKind::Relation => relation_point(payload, key.id),
            edsl::KnowledgeKind::TimeRole => match array::find(
                brief.time_roles,
                fn(role) {
                    role.field == key.id
                }
            ) {
                Some(role) => time_role_point(brief, role),
                None => fail!("knowledge time role disappeared", key),
            },
            edsl::KnowledgeKind::BusinessLink => match array::find(
                payload.business_links,
                fn(link) {
                    link.id == key.id && payload.entities[link.hub].id == key.owner
                }
            ) {
                Some(link) => link_point(payload, link),
                None => fail!("knowledge business link disappeared", key),
            },
            _ => fail!("knowledge key has no point in prepared model", key),
        };
        let refs = array::concat(
            [
                raw.refs,
                match dict::get(index.related, target_key(key)) {
                    Some(items) => items,
                    None => [],
                }
            ]
        );
        let summary = match dict::get(index.summaries, target_key(key)) {
            Some(text) => text,
            None => raw.summary,
        };
        DocResult::Found({...raw, refs, summary})
    }
};

def point_from_model: Fn(edsl::PreparedPayload, KnowledgeIndex, edsl::KnowledgeTarget) -> DocResult = fn(
    payload,
    index,
    key
) {
    match raw_point_from_model(payload, index, key) {
        DocResult::NotFound => DocResult::NotFound,
        DocResult::Found(item) => {
            let terms = if key.kind == edsl::KnowledgeKind::Index || key.kind == edsl::KnowledgeKind::Schema {
                []
            } else {
                match dict::get(index.terms, target_key(key)) {
                    Some(items) => items,
                    None => [],
                }
            };
            DocResult::Found({...item, terms})
        },
    }
};

def by_target: Fn(edsl::PreparedPayload, edsl::KnowledgeTarget) -> DocResult = fn(payload, id) {
    point_from_model(payload, index_from_model(payload), id)
};

def knowledge_lookup_factory: Fn(edsl::PreparedPayload) -> Fn(edsl::KnowledgeTarget) -> DocResult = fn(
    payload
) {
    let index = index_from_model(payload);
    fn(id) {
        point_from_model(payload, index, id)
    }
};

def decode_request: for(A: codec::Decode) Fn(Value, String) -> A = fn(value, contract) {
    match codec::decode@[A](value) {
        Ok(decoded) => decoded,
        Err(error) => raise!(blame::with_context(error, `contract \{contract}`)),
    }
};

def point_from_key: Fn(edsl::PreparedPayload, KnowledgeIndex, String) -> DocResult = fn(
    payload,
    index,
    key
) {
    match dict::get(index.targets, key) {
        Some(target) => point_from_model(payload, index, target),
        None => DocResult::NotFound,
    }
};

# The caller binds a domain to its prepared model.
def serve_catalog: Fn(edsl::PreparedPayload, KnowledgeIndex, String, Value) -> KnowledgeResponse = fn(
    payload,
    index,
    domain,
    request
) {
    if domain == "" {
        fail!("knowledge domain must not be empty")
    } else {
        ()
    };
    let envelope = decode_request@[KnowledgeRequest](request, "syntax/knowledge/request");
    if envelope.method == `\{domain}/info` {
        let input = decode_request@[InfoInput](envelope.input, "syntax/knowledge/info");
        KnowledgeResponse::Document(point_from_key(payload, index, input.key))
    } else {
        fail!(`unknown knowledge method for domain`, envelope.method, domain)
    }
};

def serve: Fn(edsl::PreparedPayload, String, Value) -> KnowledgeResponse = fn(
    payload,
    domain,
    request
) {
    serve_catalog(payload, index_from_model(payload), domain, request)
};

def object_value: Fn(Array((String, Value))) -> Value = fn(fields) {
    Value::Object(dict::from_pairs(fields))
};

type LatestSelection = struct {
    time_order: String,
    null_time: String,
    null_value: String,
    tie_order: String,
    tie_nulls: String,
    clock: Array(String),
    grain: Array(String)
};

type KeyPattern = struct {
    kind: edsl::KnowledgeKind,
    pattern: String
};
type VocabularyEntry = struct {
    kind: edsl::KnowledgeKind,
    group: String,
    owner: Option(String),
    require: Option(String)
};
type IndexDetail = struct {
    revision: String,
    key_patterns: Array(KeyPattern),
    encoding: String
};
type DiscoveryDetail = struct {
    addressing: String,
    knowledge_contract: String,
    intent_contract: String,
    revision: String,
    roots: Array(String),
    key_patterns: Array(KeyPattern),
    vocabulary: Array(VocabularyEntry)
};
def vocabulary: Array(VocabularyEntry) = [
    {kind: edsl::KnowledgeKind::Dataset, group: "datasets", owner: None, require: None},
    {
        kind: edsl::KnowledgeKind::Dimension,
        group: "dimensions",
        owner: Some("dataset"),
        require: None
    },
    {kind: edsl::KnowledgeKind::Measure, group: "measures", owner: Some("dataset"), require: None},
    {kind: edsl::KnowledgeKind::Relation, group: "rels", owner: None, require: None},
    {kind: edsl::KnowledgeKind::Ty, group: "types", owner: None, require: Some("storage")},
    {kind: edsl::KnowledgeKind::Value, group: "values", owner: Some("ty"), require: None},
    {
        kind: edsl::KnowledgeKind::BusinessLink,
        group: "business_links",
        owner: Some("hub"),
        require: None
    },
];
def key_patterns: Array(KeyPattern) = array::map(
    [
        (edsl::KnowledgeKind::Dataset, "Dataset/{dataset}"),
        (edsl::KnowledgeKind::Field, "Field/{dataset}/{field}"),
        (edsl::KnowledgeKind::Dimension, "Dimension/{dataset}/{dimension}"),
        (edsl::KnowledgeKind::Measure, "Measure/{dataset}/{measure}"),
        (edsl::KnowledgeKind::Relation, "Relation/{relation}"),
        (edsl::KnowledgeKind::Ty, "Ty/{ty}"),
        (edsl::KnowledgeKind::Value, "Value/{ty}/{value}"),
        (edsl::KnowledgeKind::TimeRole, "TimeRole/{dataset}/{field}"),
        (edsl::KnowledgeKind::BusinessLink, "BusinessLink/{hub}/{link}"),
    ],
    fn(entry) {
        {kind: entry.0, pattern: entry.1}
    }
);

def owned_detail: for(A: codec::Encode) Fn(String, A) -> Value = fn(dataset, detail) {
    match codec::encode(detail) {
        Value::Object(fields) => Value::Object(
            dict::merge(fields, {dataset: Value::String(dataset)})
        ),
        other => fail!("Model knowledge detail must be a record", other),
    }
};

def primitive_detail: Fn(String) -> Value = fn(id) {
    let ordered = id == "Int" || id == "Number" || id == "DateTimeUtc" || id == "Date" || id == "DateTime" || id == "EpochMillis";
    let ops = array::concat(
        [
            ["Eq", "Ne"],
            if ordered {
                ["Gt", "Ge", "Lt", "Le"]
            } else {
                []
            },
            if id == "Text" {
                ["Contains", "NotContains", "StartsWith", "EndsWith"]
            } else {
                []
            },
            if id == "Ipv4" {
                ["InSubnet", "NotInSubnet"]
            } else {
                []
            }
        ]
    );
    object_value(
        [
            ("id", Value::String(id)),
            ("operations", codec::encode(ops)),
            ("nullable_comparison", Value::String("NonNullPopulation"))
        ]
    )
};

def node_value: Fn(Point) -> Value = fn(item) {
    let detail = match item.target.kind {
        edsl::KnowledgeKind::Index => codec::encode(
            {
                revision: item.revision,
                key_patterns,
                encoding: "Each canonical name is encoded once as a URI component. Knowledge keys are complete stable identities; link keys identify nodes in the same publication."
            }.ty!(IndexDetail)
        ),
        edsl::KnowledgeKind::Dataset => codec::encode(
            {
                id: item.target.id,
                grain: item.grain,
                time_roles: item.time_roles,
                references: item.references,
                field_roles: item.field_roles
            }.ty!(DatasetDetail)
        ),
        edsl::KnowledgeKind::Field => codec::encode(
            {
                id: item.target.id,
                dataset: item.target.owner,
                nullable: item.nullable,
                logical_type: item.logical_type,
                roles: item.roles,
                reference_ids: array::map(
                    item.references,
                    fn(ref) {
                        ref.id
                    }
                )
            }.ty!(FieldDetail)
        ),
        edsl::KnowledgeKind::Ty => match item.value_type {
            Some(spec) => codec::encode(
                {
                    id: spec.id,
                    label: spec.label,
                    summary: spec.summary,
                    storage: spec.storage,
                    half_open: spec.half_open,
                    canonical_order: spec.canonical_order,
                    values: array::map(
                        spec.values,
                        fn(value) {
                            let wires = match array::find(
                                spec.mapping,
                                fn(member) {
                                    member.id == value.id
                                }
                            ) {
                                Some(member) => member.wires,
                                None => [],
                            };
                            {
                                id: value.id,
                                label: value.label,
                                aliases: value.aliases,
                                localized: value.localized,
                                wires
                            }.ty!(TypeValueDetail)
                        }
                    )
                }.ty!(ValueTypeDetail)
            ),
            None => primitive_detail(item.target.id),
        },
        edsl::KnowledgeKind::Value => codec::encode(
            {
                id: item.target.id,
                ty: item.target.owner,
                wires: match item.value {
                    Some(value) => value.wires,
                    None => []
                }
            }.ty!(ValueDetail)
        ),
        edsl::KnowledgeKind::Dimension => match item.dimension {
            Some(value) => codec::encode(value),
            None => object_value([]),
        },
        edsl::KnowledgeKind::Measure => match item.measure {
            Some(value) => if value.aggregate == Some(qb::AggregateFunction::Latest) {
                match codec::encode(value) {
                    Value::Object(fields) => Value::Object(
                        dict::merge(
                            fields,
                            {
                                selection: codec::encode(
                                    {
                                        time_order: "Desc",
                                        null_time: "Excluded",
                                        null_value: "Preserved",
                                        tie_order: "Asc",
                                        tie_nulls: "First",
                                        clock: array::map(
                                            array::filter(
                                                item.refs,
                                                fn(ref) {
                                                    ref.target.kind == edsl::KnowledgeKind::TimeRole
                                                }
                                            ),
                                            fn(ref) {
                                                target_key(ref.target)
                                            }
                                        ),
                                        grain: array::map(
                                            item.grain,
                                            fn(name) {
                                                target_key(
                                                    target(
                                                        edsl::KnowledgeKind::Field,
                                                        value.dataset,
                                                        name
                                                    )
                                                )
                                            }
                                        )
                                    }.ty!(LatestSelection)
                                )
                            }
                        )
                    ),
                    other => fail!("measure detail must be a record", other),
                }
            } else {
                codec::encode(value)
            },
            None => object_value([]),
        },
        edsl::KnowledgeKind::Relation => match item.relation {
            Some(value) => codec::encode(value),
            None => object_value([]),
        },
        edsl::KnowledgeKind::TimeRole => match item.time_role {
            Some(value) => owned_detail(item.target.owner, value),
            None => object_value([]),
        },
        edsl::KnowledgeKind::BusinessLink => codec::encode(
            {
                id: item.target.id,
                hub: item.target.owner,
                direction: item.direction,
                guard: item.guard
            }.ty!(BusinessLinkDetail)
        ),
        _ => object_value([]),
    };
    object_value(
        [
            ("key", Value::String(target_key(item.target))),
            ("address", codec::encode(target_address(item.target))),
            ("type", codec::encode(item.target.kind)),
            (
                "description",
                codec::encode(
                    {
                        label: item.label,
                        aliases: item.aliases,
                        localized: item.localized,
                        summary: item.summary,
                        terms: array::map(
                            item.terms,
                            fn(term) {
                                {term: term.term, description: term.description}.ty!(TermText)
                            }
                        )
                    }.ty!(Description)
                )
            ),
            (
                "links",
                codec::encode(
                    array::map(
                        item.refs,
                        fn(ref) {
                            object_value(
                                [
                                    ("type", codec::encode(ref.kind)),
                                    ("key", Value::String(target_key(ref.target))),
                                    ("role", Value::String(target_role(ref.target.kind)))
                                ]
                            )
                        }
                    )
                )
            ),
            ("detail", detail),
        ]
    )
};

def encode_response: Fn(KnowledgeResponse) -> Value = fn(response) {
    match response {
        KnowledgeResponse::Document(document) => match document {
            DocResult::Found(item) => object_value(
                [("Document", object_value([("Found", node_value(item))]))]
            ),
            DocResult::NotFound => object_value([("Document", Value::String("NotFound"))]),
        },
    }
};

def serve_value: Fn(edsl::PreparedPayload, String, Value) -> Value = fn(payload, domain, request) {
    encode_response(serve(payload, domain, request))
};

def knowledge_service_factory: Fn(edsl::PreparedPayload, String) -> Fn(Value) -> Value = fn(
    payload,
    domain
) {
    let index = index_from_model(payload);
    fn(request) {
        encode_response(serve_catalog(payload, index, domain, request))
    }
};

# The collection selects the slot; this handler receives only its input.
def knowledge_info_method_factory: Fn(edsl::PreparedPayload) -> Fn(Value) -> Value = fn(payload) {
    let index = index_from_model(payload);
    fn(input) {
        let request = decode_request@[InfoInput](input, "syntax/knowledge/info");
        encode_response(KnowledgeResponse::Document(point_from_key(payload, index, request.key)))
    }
};

def discovery_keys: Fn(edsl::PreparedPayload) -> Array(String) = fn(payload) {
    let datasets = edsl::visible_knowledge_index(payload);
    let visible = dict::from_pairs(
        array::map(
            datasets,
            fn(dataset) {
                (dataset.id, True)
            }
        )
    );
    array::concat(
        [
            array::map(
                datasets,
                fn(dataset) {
                    target_key(target(edsl::KnowledgeKind::Dataset, "", dataset.id))
                }
            ),
            array::map(
                array::filter(
                    payload.relations,
                    fn(relation) {
                        relation.id != "" && dict::get(visible, payload.entities[relation.from].id) != None
                    }
                ),
                fn(relation) {
                    target_key(target(edsl::KnowledgeKind::Relation, "", relation.id))
                }
            ),
        ]
    )
};

def discovery_detail: Fn(edsl::PreparedPayload) -> DiscoveryDetail = fn(payload) {
    {
        addressing: "node-member-uri-v1",
        knowledge_contract: "ontology-knowledge-v3",
        intent_contract: "ontology-intent-v1",
        revision: payload.revision,
        roots: discovery_keys(payload),
        key_patterns,
        vocabulary
    }
};

def model_roots: Fn(edsl::PreparedPayload) -> ModelRoots = fn(payload) {
    {
        lowering: payload,
        knowledge: {
            complete: True,
            discover: fn() {
                discovery_detail(payload)
            },
            nodes: fn() {
                export_nodes(payload)
            },
        }
    }
};

def knowledge_root_value: Fn(KnowledgeRoot) -> Value = fn(root) {
    object_value(
        [
            ("format", Value::String("ontology-knowledge-export-v1")),
            ("discovery", codec::encode(root.discover())),
            ("complete", codec::encode(root.complete)),
            ("nodes", Value::Array(root.nodes()))
        ]
    )
};

# Only capture the prepared lowering model during init. Materialize knowledge
# when the host asks for it; the host owns the resulting data and its indexes.
def knowledge_root_method_factory: Fn(KnowledgeRoot) -> Fn(Value) -> Value = fn(root) {
    fn(input) {
        let request = decode_request@[DiscoveryInput](input, "syntax/knowledge/discovery");
        knowledge_root_value(root)
    }
};

def knowledge_discovery_method_factory: Fn(edsl::PreparedPayload) -> Fn(Value) -> Value = fn(
    payload
) {
    let response = codec::encode(discovery_detail(payload));
    fn(input) {
        let request = decode_request@[DiscoveryInput](input, "syntax/knowledge/discovery");
        response
    }
};

