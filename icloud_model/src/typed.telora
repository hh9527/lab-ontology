# IC 独立声明迁移入口；尚未切换 MainService。
pub mod inventory;
mod profile;
pub mod site;
pub mod port;
pub mod interface_kpi;
pub mod server;
pub mod server_kpi;
pub mod server_fan;
pub mod server_psu;
pub mod server_memory;
use std::array as array;
use ontology::experimental::model as m;
use self::inventory as inventory;
use self::profile as profile;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
def payload: edsl::PreparedPayload = t::build("icloud-typed-v1", [
    inventory::device_declaration <~ {dataset: m::prepare(inventory::devices, [
        inventory::device_subject, inventory::device_tenant, site::project, site::subnet,
    ])},
    inventory::tenant_declaration,
    site::declaration,
    port::declaration,
    interface_kpi::declaration,
    server::declaration,
    server_kpi::declaration,
    server_fan::declaration,
    server_psu::declaration,
    server_memory::declaration,
], array::concat([inventory::relations, site::relations, port::relations, interface_kpi::relations, server::relations, server_kpi::relations, server_fan::relations, server_psu::relations, server_memory::relations]), array::concat([site::alternatives, server::alternatives]), [], profile::profile).payload;
pub use self::{payload};
