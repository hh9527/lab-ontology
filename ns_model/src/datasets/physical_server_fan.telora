    @g::field_view(g::dimension_group("physical-server-fan/fan_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "psf_fan_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    fan_name: Option(String),
};

pub def relations: Array(r::Relation) = [
    r::relation("psf__ps_rev", domain::endpoint(PhysicalServerFan.type, "parent_res_id"), domain::endpoint(physical_server::PhysicalServer.type, "ori_res_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("psf__se", domain::endpoint(PhysicalServerFan.type, "obj_sys_id"), domain::endpoint(serverfan_2_kpi::Serverfan2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("psf__se_rev", domain::endpoint(PhysicalServerFan.type, "obj_sys_id"), domain::endpoint(serverfan_2_kpi::Serverfan2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
