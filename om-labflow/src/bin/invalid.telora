# om-labflow 非法场景演示
#
#   bin/telora -C om-labflow run invalid --best-effort
#
# 每个 case_* 都是独立的失败根：grain 冲突、未知词汇、封闭值域外枚举值、
# 非法 limit、未授权 subject、未请求排序目标、动态 JSON 形状非法、显式
# subject、非法 EventType、offset 缺排序、负 offset、CommandHead 与用户
# 筛选冲突、Top Per Group 非法组合（与 limit 组合、非正 take、partition
# 维度未选择）、JSON 词汇泄露（物理列名、raw 函数名、path key）。它们不
# 发布部分 Query；命令以诊断失败、非零退出且不产生任何 Entry 输出。

import "std/value" { Value };
import "std/json" as json;
import "std/result" as result;
import "ontology/edsl" as edsl;
import "@src/knowledge" { payload };
import "@src/query" as facade;

# 1. grain 冲突：事件 grain 的 EventCount 与路径 grain 的 PathCount 混用
def case_grain_conflict = do {
    let request: edsl.QueryRequest = {
        measures: [
            { id: "EventCount", subject: "analyst", input: 'All },
            { id: "PathCount", subject: "analyst", input: 'All },
        ],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 2. 事件 grain 指标 + 只能经 FanOut 到达的 Path 维度
def case_fanout_dimension = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "Path", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 3. 未知指标词汇
def case_unknown_measure = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "BogusCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 4. 未知维度词汇
def case_unknown_dimension = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "BogusDim", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 5. 封闭值域外的枚举筛选值（TaskKind）
def case_unknown_enum_value = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: "TaskKind", subject: "analyst", op: 'Eq, input: 'Text("platinum") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 5b. EventType 是封闭业务词汇：schema v2 之外的值必须原子失败
def case_illegal_event_type = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: "EventType", subject: "analyst", op: 'Eq, input: 'Text("not_a_real_event") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 6. 非正 limit
def case_non_positive_limit = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'Some(0),
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 7. 未授权 subject
def case_unauthorized_subject = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "guest", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 8. 排序目标未在请求中选择
def case_unrequested_order = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "DurationSum", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [{ target: 'Measure("EventCount"), direction: 'Desc }],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 9. 动态 JSON 形状非法（Bool 不能作为筛选值；subject 固定，不需要也不能提交）
def case_bad_dynamic_json = do {
    let raw = json.parse(r#"{"filters": [{"id": "Success", "op": "eq", "value": true}]}"#) |> result.unwrap;
    facade.build_from_value(payload, raw)
};

# 10. dynamic 入口固定 subject=analyst：显式 subject 是未知顶层 key
def case_explicit_subject_dynamic = do {
    let raw = json.parse(r#"{"subject": "analyst", "measures": [{"id": "EventCount"}]}"#) |> result.unwrap;
    facade.build_from_value(payload, raw)
};

# 11. 封闭值域外的 EventType 值经 dynamic 路径同样原子失败
def case_illegal_event_type_dynamic = do {
    let raw = json.parse(r#"{"measures": [{"id": "EventCount"}], "filters": [{"id": "EventType", "op": "eq", "value": "not_a_real_event"}]}"#) |> result.unwrap;
    facade.build_from_value(payload, raw)
};

# 12. offset 存在但请求没有稳定排序：结构校验原子拒绝
def case_offset_without_ordering = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CommandHead", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'Some(3),
        offset: 'Some(3),
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 13. 负 offset：结构校验原子拒绝
def case_negative_offset = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CommandHead", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("EventCount"), direction: 'Desc }],
        limit: 'Some(3),
        offset: 'Some(-1),
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 14. CommandHead 固有 scope（EventType=action、Action=shell）与用户筛选冲突：
#     用户显式筛选 EventType=thinking 与 scope 的 EventType=action 互斥，原子失败。
def case_command_head_scope_conflict = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CommandHead", subject: "analyst", input: 'None }],
        filters: [{ id: "EventType", subject: "analyst", op: 'Eq, input: 'Text("thinking") }],
        ordering: [],
        limit: 'Some(3),
        offset: 'None,
        partition: 'None,
    };
    edsl.lower(payload, request)
};

# 15. Top Per Group 与全局 limit 组合：v1 原子拒绝，不静默改变语义。
def case_partition_with_limit = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "CommandHead", subject: "analyst", input: 'None },
            { id: "Role", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [
            { target: 'Measure("EventCount"), direction: 'Desc },
            { target: 'Dimension("CommandHead"), direction: 'Asc },
        ],
        limit: 'Some(10),
        offset: 'None,
        partition: 'Some({ by: ["Role"], take: 3 }),
    };
    edsl.lower(payload, request)
};

# 16. Top Per Group 的 take 非正：原子拒绝。
def case_partition_bad_take = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "CommandHead", subject: "analyst", input: 'None },
            { id: "Role", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [
            { target: 'Measure("EventCount"), direction: 'Desc },
            { target: 'Dimension("CommandHead"), direction: 'Asc },
        ],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["Role"], take: 0 }),
    };
    edsl.lower(payload, request)
};

# 17. Top Per Group 的 partition 维度未在请求中选择：原子拒绝。
def case_partition_unselected_by = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "EventCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CommandHead", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("EventCount"), direction: 'Desc }],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["Role"], take: 3 }),
    };
    edsl.lower(payload, request)
};

# 18. dynamic 请求不得提交物理列名 payload_json：未知业务 Dimension，原子失败。
def case_json_physical_column = do {
    let raw = json.parse(r#"{"measures": [{"id": "EventCount"}], "dimensions": [{"id": "payload_json"}]}"#) |> result.unwrap;
    facade.build_from_value(payload, raw)
};

# 19. dynamic 请求不得提交 raw JSON 表达式/函数名：未知业务 Dimension，原子失败。
def case_json_raw_function = do {
    let raw = json.parse(r#"{"measures": [{"id": "EventCount"}], "dimensions": [{"id": "json_extract(payload_json, '$.status')"}]}"#) |> result.unwrap;
    facade.build_from_value(payload, raw)
};

# 20. dynamic 请求不得在 dimension 对象内提交 path key：未知 key，解码拒绝。
def case_json_path_key = do {
    let raw = json.parse(r#"{"measures": [{"id": "EventCount"}], "dimensions": [{"id": "AttemptId", "path": "$.attempt_id"}]}"#) |> result.unwrap;
    facade.build_from_value(payload, raw)
};

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    # 本入口只用于演示失败；正常路径请使用 run query 或 run verify。
    let ignored_grain = case_grain_conflict;
    let ignored_fanout = case_fanout_dimension;
    let ignored_measure = case_unknown_measure;
    let ignored_dimension = case_unknown_dimension;
    let ignored_enum = case_unknown_enum_value;
    let ignored_event_type = case_illegal_event_type;
    let ignored_limit = case_non_positive_limit;
    let ignored_subject = case_unauthorized_subject;
    let ignored_order = case_unrequested_order;
    let ignored_json = case_bad_dynamic_json;
    let ignored_explicit_subject = case_explicit_subject_dynamic;
    let ignored_illegal_event_type_dynamic = case_illegal_event_type_dynamic;
    let ignored_offset_no_order = case_offset_without_ordering;
    let ignored_negative_offset = case_negative_offset;
    let ignored_scope_conflict = case_command_head_scope_conflict;
    let ignored_partition_limit = case_partition_with_limit;
    let ignored_partition_take = case_partition_bad_take;
    let ignored_partition_by = case_partition_unselected_by;
    let ignored_json_column = case_json_physical_column;
    let ignored_json_function = case_json_raw_function;
    let ignored_json_path = case_json_path_key;
    'String("invalid cases")
};
