use crate::model::{ payload };
use ontology::knowledge as knowledge;
use ontology::ontology as edsl;
use std::value::{ Value };
use std::codec as codec;
use std::array as array;
use std::test as test;

pub def ic_peer_link_exposes_both_declared_endpoint_roles: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::BusinessLink,
        owner: "physical_link", id: "physical_link_peer_device"};
    match knowledge::by_target(payload, "public", id) {
        knowledge::DocResult::Found(point) => if point.direction == Some(edsl::LinkDirection::Undirected)
            && array::any(point.refs, fn(ref) {
                ref.target.kind == edsl::KnowledgeKind::Relation && ref.target.id == "physical_link_a_device"
            })
            && array::any(point.refs, fn(ref) {
                ref.target.kind == edsl::KnowledgeKind::Relation && ref.target.id == "physical_link_z_device"
            }) { True }
            else { fail!("peer knowledge lost direction or a declared endpoint role", point) },
        other => fail!("IC peer business link is not discoverable", other),
    }
});

pub def ic_undirected_link_participation_is_discoverable: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "physical_link", id: "physical_link_attached_device"};
    match knowledge::by_target(payload, "public", id) {
        knowledge::DocResult::Found(point) => match point.relation {
            Some(relation) => if relation.from_dataset == "physical_link"
                && relation.to_dataset == "device"
                && relation.kind == edsl::RelationKind::FanOut
                && match relation.shape {
                    edsl::RelationShape::Any(branches) => array::length(branches) == 2
                        && array::all(branches, fn(branch) {
                            match branch {
                                edsl::RelationShape::All(keys) => array::length(keys) == 2,
                                _ => False,
                            }
                        }),
                    _ => False,
                } { True }
            else { fail!("link participation knowledge lost either complete endpoint", relation) },
            None => fail!("link participation has no declared relation detail"),
        },
        other => fail!("IC link participation relation is not discoverable", other),
    }
});

pub def on_demand_relation_matches_full_catalog: test::Test = test::should_ok(fn() {
    let request = Value::Object({target: Value::Object({kind: Value::String("relation"),
        owner: Value::String("physical_link"), id: Value::String("physical_link_attached_device")})});
    let response = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic")(request);
    match codec::decode@[knowledge::KnowledgeResponse](response).unwrap!() {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(item)) =>
            match item.relation {
                Some(relation) => match relation.shape {
                    edsl::RelationShape::Any(branches) => if array::length(branches) == 2
                        && array::any(item.refs, fn(ref) {
                            ref.target.kind == edsl::KnowledgeKind::Dataset && ref.target.id == "device"
                        }) { True }
                        else { fail!("on-demand relation lost an endpoint or branch", item) },
                    _ => fail!("on-demand relation lost its OR branches", item),
                },
                None => fail!("on-demand relation lost its details", item),
            },
        other => fail!("on-demand relation returned a non-document", other),
    }
});
