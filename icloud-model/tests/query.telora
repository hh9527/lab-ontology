pub def physical_link_endpoints_are_distinct_named_relations: test::Test = test::should_ok(fn() {
    let prefix = `{"op":"exists_via","measures":[],"dimensions":["physical_link_id"],"filters":[],"ordering":[],"exists":[{"relation":"`;
    let suffix = `","target":"device","filters":[],"min_matches":null}],"limit":null,"offset":null}`;
    let a = lower_json(`\{prefix}physical_link_a_device\{suffix}`);
    let z = lower_json(`\{prefix}physical_link_z_device\{suffix}`);
    let known = edsl::dataset_relations(payload, "physical_link");
    let a_rel = edsl::relation_domain(payload, "physical_link_a_device");
    if array::length(known) == 3
        && a_rel.id == "physical_link_a_device"
        && array::length(string::split(a.sql, "pl.a_ne_res_id = d.id")) > 1
        && array::length(string::split(a.sql, "pl.z_ne_res_id")) == 1
        && array::length(string::split(z.sql, "pl.z_ne_res_id = d.id")) > 1
        && array::length(string::split(z.sql, "pl.a_ne_res_id")) == 1 {
        True
    } else {
        fail!("explicit relation must select exactly one endpoint", a.sql, z.sql)
    }
});

pub def relation_discovery_explains_roles_and_alternatives: test::Test = test::should_ok(fn() {
    let a = edsl::relation_detail_for_subject(payload, "public", "physical_link_a_device");
    let z = edsl::relation_detail_for_subject(payload, "public", "physical_link_z_device");
    let site = edsl::relation_detail_for_subject(payload, "public", "device_located_at_site");
    let composite = edsl::RelationShape::All([edsl::RelationShape::Equality, edsl::RelationShape::Equality]);
    let alternatives = edsl::RelationShape::Any([edsl::RelationShape::Equality, edsl::RelationShape::Equality]);
    if a.id == "physical_link_a_device" && a.label == "A-end device"
        && z.label == "Z-end device" && a.from_dataset == "physical_link"
        && a.to_dataset == "device" && z.from_dataset == "physical_link"
        && z.to_dataset == "device" && a.kind == edsl::RelationKind::Safe
        && z.kind == edsl::RelationKind::Safe && a.shape == composite && z.shape == composite
        && site.from_dataset == "device" && site.to_dataset == "site"
        && site.kind == edsl::RelationKind::FanOut && site.shape == alternatives { True }
    else { fail!("relation discovery lost direction, role or key shape", a, z, site) }
});

