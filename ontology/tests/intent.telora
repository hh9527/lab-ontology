# Cross-model checks for the model-derived intent lowering factory.

import "@src/intent" { query_intent_lower_factory };
import "@src/knowledge" { payload };
import "@src/query" as qb;
import "std/array" as array;
import "std/json" as json;
import "std/result" as result;
import "std/value" { Value };

def lower_intent: Fn(Value) -> qb.Query = query_intent_lower_factory(payload, "analyst");

def parse: Fn(String) -> Value = fn(source) {
    json.parse(source) |> result.unwrap
};

def assert_query: Fn(String, Value, Int) -> Bool = fn(label, intent, expected_bindings) {
    let query = lower_intent(intent);
    if query.sql != "" && array.length(query.bindings) == expected_bindings {
        'True
    } else {
        fail!("derived intent lowering mismatch", label, query.sql, query.bindings)
    }
};

export def count_members = assert_query(
    "count-members",
    parse(r#"{
        "op": "count",
        "measures": ["MemberCount"],
        "dimensions": [],
        "filters": [],
        "ordering": [],
        "exists": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#),
    0,
);

export def filtered_members = assert_query(
    "filtered-members",
    parse(r#"{
        "op": "list",
        "measures": [],
        "dimensions": ["MemberKind"],
        "filters": [
            {"dimension": "MemberKind", "op": "eq", "kind": "text", "value": "staff"}
        ],
        "ordering": [],
        "exists": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#),
    1,
);

export def deterministic = do {
    let intent = parse(r#"{
        "op": "list",
        "measures": [],
        "dimensions": ["MemberKind"],
        "filters": [
            {"dimension": "MemberKind", "op": "eq", "kind": "text", "value": "staff"}
        ],
        "ordering": [],
        "exists": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#);
    let first = lower_intent(intent);
    let second = lower_intent(intent);
    if first == second {
        'True
    } else {
        fail!("derived intent lowering is not deterministic", first, second)
    }
};
