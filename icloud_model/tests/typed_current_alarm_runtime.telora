        alarm_case(`project_\{dimension.id}`, `"select":[{"node":"a","dimension":"\{dimension.id}"}]`)
    }),
    array::flat_map(array::filter(payload.dimensions, fn(dimension) { payload.entities[dimension.entity].id == "current_alarm" && array::length(dimension.canonical_values) > 0 }), fn(dimension) {
