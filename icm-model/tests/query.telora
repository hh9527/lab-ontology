# ---------------------------------------------------------------------------
# 31. Capability-source audit: every public dimension comes from an explicit
#     declaration (spot-check the required surface), and no internal-only
#     attribute (mount keys / project ids / implementation fields) leaks into
#     the public vocabulary through name inference or coverage-driven padding.
# ---------------------------------------------------------------------------

def has_dimension_id: Fn(Array(edsl.DimensionEntry), String) -> Bool = fn(dims, id) {
    array.any(dims, fn(d) { d.id == id })
};
def has_measure_id: Fn(Array(edsl.MeasureEntry), String) -> Bool = fn(measures, id) {
    array.any(measures, fn(m) { m.id == id })
};

def capability_source_audit = do {
    let dims: Array(edsl.DimensionEntry) = model.payload.dimensions;
    let measures: Array(edsl.MeasureEntry) = model.payload.measures;
    let required_dims: Array(String) = [
        "NetworkDeviceName", "NetworkDeviceType", "NetworkDeviceLocation",
        "PonDeviceClassification", "ServerName", "ServerVersion",
        "ServerFirmwareVersion", "StorageName", "StorageRunningStatus",
        "StorageHealthStatus", "TerminalName", "TerminalAccessDeviceId",
        "CollabName", "SiteName", "SiteId", "TenantName", "TenantId",
        "AlarmSeverity", "AlarmType",
    ];
    let missing = array.find(required_dims, fn(id) { !has_dimension_id(dims, id) });
    if missing != 'None {
        fail!("declared dimension missing from the public vocabulary", missing)
    } else {
        let internal_names: Array(String) = [
            "ServerOriResId", "StorageParentResId", "ServerProjectId",
            "NetworkProjectId", "PonProjectId", "StorageProjectId",
            "TenantKey", "SiteKey", "AlarmStrext13",
        ];
        let leaked = array.find(internal_names, fn(id) {
            has_dimension_id(dims, id) || has_measure_id(measures, id)
        });
        if leaked != 'None {
            fail!("internal-only attribute leaked as a public capability", leaked)
        } else {
            'True
        }
    }
};
export def test_capability_source_audit = capability_source_audit;

