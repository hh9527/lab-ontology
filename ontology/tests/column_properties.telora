use ontology::model as m;
use ontology::transform as t;
use ontology::query as q;
use std::test as test;
use std::array as array;

type Row = struct {
    id: Int,
    @m::column("READING")
    reading: Option(Int),
    label: String
};
def dataset: m::Dataset(Row) = m::dataset("readings", "reading_rows", Row.type, ["id"]);
def declared: t::Declaration = t::declare(dataset, [], [], []);
def profile: q::PlanProfile = {
    allowed_operators: [q::Operator::Source],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [],
    allow_distinct: False
};
def prepare: Fn(t::Declaration) -> t::Prepared = fn(declaration) {
    t::checked_build("column-properties", [declaration], [], [], [], profile)
};
pub def properties_and_same_name_defaults_preserve_optional_fields: test::Test = test::should_ok(
    fn() {
        let fields = prepare(declared).payload.entities[0].fields;
        array::map(
            fields,
            fn(field) {
                field.column
            }
        ) == ["id", "label", "READING"] && array::any(
            fields,
            fn(field) {
                field.name == "reading" && field.nullable
            }
        )
    }
);

type Collision = struct {
    @m::column("name")
    id: Int,
    name: String
};
pub def property_cannot_collide_with_a_default_column: test::Test = test::should_fail_with(
    fn() {
        prepare(t::declare(m::dataset("collision", "collisions", Collision.type, []), [], [], []));
        True
    },
    "typed column mappings collide on a physical column"
);

type CaseCollision = struct {
    @m::column("ID")
    value: Int,
    id: Int
};
pub def physical_column_collision_is_case_insensitive: test::Test = test::should_fail_with(
    fn() {
        prepare(
            t::declare(
                m::dataset("case_collision", "collisions", CaseCollision.type, []),
                [],
                [],
                []
            )
        );
        True
    },
    "typed column mappings collide on a physical column"
);
pub def explicit_mapping_cannot_override_a_conflicting_property: test::Test = test::should_fail_with(
    fn() {
        prepare(
            t::map_columns(
                declared,
                [t::column(m::optional_field(Row.type, Int.type, "reading"), "OTHER")]
            )
        );
        True
    },
    "typed column mapping conflicts with field property"
);
pub def equal_explicit_mapping_and_property_are_consistent: test::Test = test::should_ok(
    fn() {
        let prepared = prepare(
            t::map_columns(
                declared,
                [t::column(m::optional_field(Row.type, Int.type, "reading"), "READING")]
            )
        );
        array::any(
            prepared.payload.entities[0].fields,
            fn(field) {
                field.name == "reading" && field.column == "READING"
            }
        )
    }
);
