# ent-1/src/bin/main.telora
#
# Legal scenario entry: OrdersCreated filtered to 2026-04..2026-06, Gold
# customers and the East China region, grouped by OrderMonth/CustomerTier/
# OriginRegion/CarrierName/ServiceName, ordered by the count descending with
# dimensions ascending as stable tie-breakers, Top 10.
#
# The full chain is exercised:
#   plan  = edsl.lower(knowledge.payload, request)
#   query = qb.transform_sqlite(plan)
# The eDSL validates the Plan against the knowledge PlanProfile inside lower.

import "query/lib" as qb;
import "std/array" as array;
import "std/value" { Value };
import "ontology/edsl" as edsl;
import "@src/model" as model;

def val_to_value: Fn(qb.Val) -> Value = fn(v) {
    match v {
        'String(s) => 'String(s),
        'Int(i) => 'Int(i),
        'Float(f) => 'Float(f),
        'Bool(b) => if b { 'True } else { 'False },
        'None => 'None,
    }
};

def legal_request: edsl.QueryRequest = {
    measures: [
        { id: "OrdersCreated", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "OrderMonth", subject: "analyst", input: 'None },
        { id: "CustomerTier", subject: "analyst", input: 'None },
        { id: "OriginRegion", subject: "analyst", input: 'None },
        { id: "CarrierName", subject: "analyst", input: 'None },
        { id: "ServiceName", subject: "analyst", input: 'None },
    ],
    filters: [
        { id: "OrderMonth", subject: "analyst", op: 'Ge, input: 'Text("2026-04") },
        { id: "OrderMonth", subject: "analyst", op: 'Le, input: 'Text("2026-06") },
        { id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("Gold") },
        { id: "OriginRegion", subject: "analyst", op: 'Eq, input: 'Text("East China") },
    ],
    ordering: [
        { target: 'Measure("OrdersCreated"), direction: 'Desc },
        { target: 'Dimension("OrderMonth"), direction: 'Asc },
        { target: 'Dimension("CustomerTier"), direction: 'Asc },
        { target: 'Dimension("OriginRegion"), direction: 'Asc },
        { target: 'Dimension("CarrierName"), direction: 'Asc },
        { target: 'Dimension("ServiceName"), direction: 'Asc },
    ],
    limit: 'Some(10),
    offset: 'None,
    partition: 'None,
};

export def main: Value = do {
    let plan: qb.Plan = edsl.lower(model.payload, legal_request);
    let validated: qb.Plan = qb.validate(plan, model.profile);
    let query: qb.Query = qb.transform_sqlite(validated);
    let binding_values: Array(Value) = array.map(query.bindings, val_to_value);
    let obj: Dict(Value) = {
        revision: 'String(plan.revision),
        sql: 'String(query.sql),
        bindings: 'Array(binding_values),
    };
    'Object(obj)
};
