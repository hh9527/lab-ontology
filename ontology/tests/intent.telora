# Cross-model checks for the model-derived intent lowering factory.
#
# The factory is bound only to a `PreparedPayload` and a caller subject.  These
# checks drive it over TWO structurally different domain-neutral prepared models
# (the fictional enterprise `@src/test_knowledge` payload and a local org teams /
# members model) and assert exact SQL, bindings and determinism for the closed
# intent shapes: list, count, field-to-field predicates, hidden row ordering,
# selected HAVING, hidden HAVING, related existence/absence, related hidden
# ordering (top), distinct, set combination and set count.
#
# `query_intent_ok` is the pure contract probe used for the rejection checks;
# the real lowering rejects the same shapes atomically with `fail!` and never
# emits a partial Query.

import "@src/edsl" as edsl;
import "std/test" as test;
import "@src/intent" { query_intent_lower_factory, query_intent_ok };
import "@src/test_knowledge" { payload, profile };
import "@src/query" as qb;
import "std/array" as array;
import "std/json" as json;
import "std/result" as result;
import "std/value" { Value };

# ---------------------------------------------------------------------------
# Second structurally different prepared model (domain-neutral "org" model).
# ---------------------------------------------------------------------------

def count_agg: qb.AggregateFunction = qb.AggregateFunction.Count;
def sum_agg: qb.AggregateFunction = qb.AggregateFunction.Sum;
def flag_true: Bool = True;
def eq_ops: Array(edsl.FilterOp) = [edsl.FilterOp.Eq];
def ge_ops: Array(edsl.FilterOp) = [edsl.FilterOp.Eq, edsl.FilterOp.Ge, edsl.FilterOp.Le];
def text_kinds: Array(edsl.FilterInputKind) = [edsl.FilterInputKind.Text];
def int_kinds: Array(edsl.FilterInputKind) = [edsl.FilterInputKind.Int];
def no_requires: Array(Type) = [];
def fanout_kind: edsl.RelationKind = edsl.RelationKind.FanOut;

# Canonical field order (alphabetical): 0 code, 1 headcount, 2 id, 3 owner_id,
# 4 region, 5 zone.
@edsl.entity_id("org_teams")
@edsl.entity_source("org_teams", "t")
type OrgTeam = struct {
    @edsl.column("code")
    @edsl.dimension("OrgCode", flag_true, flag_true, eq_ops, text_kinds)
    code: String,
    @edsl.column("headcount")
    @edsl.measure("TeamHeadSum", sum_agg, no_requires)
    headcount: Int,
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("TeamCount", count_agg, no_requires)
    id: Int,
    @edsl.column("owner_id")
    @edsl.distinct_measure("UniqueTeamOwnerCount", count_agg, no_requires)
    owner_id: Int,
    @edsl.column("region")
    @edsl.dimension("OrgRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
    @edsl.column("zone")
    @edsl.dimension("OrgZone", flag_true, flag_true, eq_ops, text_kinds)
    zone: String,
};

# Canonical field order: 0 id, 1 team_id.  Members declare the reverse fan-out
# relation to their team, so teams reach members through the prepared direction.
@edsl.entity_id("org_members")
@edsl.entity_source("org_members", "m")
@edsl.relation(OrgTeam, fanout_kind, 1, 2)
type OrgMember = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("OrgMemberCount", count_agg, no_requires)
    id: Int,
    @edsl.column("team_id")
    team_id: Int,
};

def org_entity_types: Array(Type) = [OrgTeam, OrgMember];

def org_authorize: Fn(String) -> Bool = fn(subject) { subject == "analyst" };

def org_payload: edsl.PreparedPayload = do {
    let result: edsl.PreparedPayload = edsl.build_root("org-v1", org_entity_types, profile, org_authorize);
    result
};

# ---------------------------------------------------------------------------
# Factories and helpers.
# ---------------------------------------------------------------------------

def lower_knowledge: Fn(Value) -> qb.Query = query_intent_lower_factory(payload, "analyst");
def lower_org: Fn(Value) -> qb.Query = query_intent_lower_factory(org_payload, "analyst");

def parse: Fn(String) -> Value = fn(source) {
    json.parse(source) |> result.unwrap
};

def assert_knowledge: Fn(String, Value, String, Array(qb.Val)) -> Bool = fn(label, intent, expected_sql, expected) {
    let query = lower_knowledge(intent);
    if query.sql == expected_sql && query.bindings == expected {
        True
    } else {
        fail!("derived knowledge intent mismatch", label, query.sql, query.bindings, expected_sql, expected)
    }
};

def assert_org: Fn(String, Value, String, Array(qb.Val)) -> Bool = fn(label, intent, expected_sql, expected) {
    let query = lower_org(intent);
    if query.sql == expected_sql && query.bindings == expected {
        True
    } else {
        fail!("derived org intent mismatch", label, query.sql, query.bindings, expected_sql, expected)
    }
};

# ---------------------------------------------------------------------------
# Positive shapes on the knowledge model.
# ---------------------------------------------------------------------------

def count_members = assert_knowledge(
    "count-members",
    parse(r#"{
        "op": "count",
        "measures": ["MemberCount"],
        "dimensions": [],
        "filters": [],
        "ordering": [],
        "exists": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT count(mb.id) AS MemberCount FROM members AS mb",
    [],
);

def filtered_members = assert_knowledge(
    "filtered-members",
    parse(r#"{
        "op": "list",
        "measures": [],
        "dimensions": ["MemberKind"],
        "filters": [
            {"dimension": "MemberKind", "op": "eq", "kind": "text", "value": "staff"}
        ],
        "ordering": [],
        "exists": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT mb.kind FROM members AS mb WHERE mb.kind = ?",
    [qb.Val.String("staff")],
);

def knowledge_distinct = assert_knowledge(
    "knowledge-distinct",
    parse(r#"{
        "op": "distinct",
        "measures": [],
        "dimensions": ["MemberKind"],
        "filters": [],
        "ordering": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT DISTINCT mb.kind FROM members AS mb",
    [],
);

# ---------------------------------------------------------------------------
# Positive shapes on the org model.
# ---------------------------------------------------------------------------

def org_field_to_field = assert_org(
    "org-field-to-field",
    parse(r#"{
        "op": "list",
        "measures": [],
        "dimensions": ["OrgRegion"],
        "filters": [
            {"left": "OrgCode", "op": "eq", "right": "OrgZone"}
        ],
        "ordering": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT t.region FROM org_teams AS t WHERE t.code = t.zone",
    [],
);

def org_hidden_row_ordering = assert_org(
    "org-hidden-row-ordering",
    parse(r#"{
        "op": "list",
        "measures": [],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [
            {"target": "Dimension", "id": "OrgZone", "direction": "Asc"}
        ],
        "limit": null,
        "offset": null
    }"#),
    "SELECT t.region FROM org_teams AS t ORDER BY t.zone ASC",
    [],
);

def org_selected_having = assert_org(
    "org-selected-having",
    parse(r#"{
        "op": "aggregate",
        "measures": ["TeamCount"],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [],
        "having": [
            {"measure": "TeamCount", "op": "ge", "kind": "int", "value": 2}
        ],
        "exists": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT count(t.id) AS TeamCount, t.region FROM org_teams AS t GROUP BY t.region HAVING count(t.id) >= ?",
    [qb.Val.Int(2)],
);

def org_model_declared_distinct_measure = assert_org(
    "org-model-declared-distinct-measure",
    parse(r#"{
        "op": "count",
        "measures": ["UniqueTeamOwnerCount"],
        "dimensions": [],
        "filters": [],
        "ordering": [],
        "having": [],
        "exists": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT count(DISTINCT t.owner_id) AS UniqueTeamOwnerCount FROM org_teams AS t",
    [],
);

def org_measure_dimension_output_order = assert_org(
    "org-measure-dimension-output-order",
    parse(r#"{
        "op": "aggregate",
        "measures": ["TeamCount"],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [],
        "having": [],
        "exists": [],
        "output_order": [
            {"kind": "dimension", "id": "OrgRegion"},
            {"kind": "measure", "id": "TeamCount"}
        ],
        "limit": null,
        "offset": null
    }"#),
    "SELECT t.region, count(t.id) AS TeamCount FROM org_teams AS t GROUP BY t.region",
    [],
);

def org_hidden_having = assert_org(
    "org-hidden-having",
    parse(r#"{
        "op": "aggregate",
        "measures": ["TeamCount"],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [],
        "having": [],
        "hidden_having": [
            {"measure": "TeamHeadSum", "op": "ge", "kind": "int", "value": 5}
        ],
        "exists": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT count(t.id) AS TeamCount, t.region FROM org_teams AS t GROUP BY t.region HAVING sum(t.headcount) >= ?",
    [qb.Val.Int(5)],
);

def org_related_exists = assert_org(
    "org-related-exists",
    parse(r#"{
        "op": "exists",
        "measures": [],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [],
        "exists": [
            {"target": "org_members", "filters": [], "min_matches": null}
        ],
        "having": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT t.region FROM org_teams AS t WHERE EXISTS (SELECT 1 FROM org_members AS m WHERE t.id = m.team_id)",
    [],
);

def org_related_absence = assert_org(
    "org-related-absence",
    parse(r#"{
        "op": "absence",
        "measures": [],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [],
        "exists": [
            {"target": "org_members", "filters": [], "min_matches": null}
        ],
        "having": [],
        "limit": null,
        "offset": null
    }"#),
    "SELECT t.region FROM org_teams AS t WHERE NOT EXISTS (SELECT 1 FROM org_members AS m WHERE t.id = m.team_id)",
    [],
);

def org_related_hidden_ordering = assert_org(
    "org-related-hidden-ordering",
    parse(r#"{
        "op": "top",
        "measures": [],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [
            {"target": "Measure", "id": "OrgMemberCount", "direction": "Desc"}
        ],
        "limit": 1,
        "offset": null
    }"#),
    "SELECT t.region FROM org_teams AS t INNER JOIN org_members AS m ON t.id = m.team_id GROUP BY t.region ORDER BY count(m.id) DESC LIMIT ?",
    [qb.Val.Int(1)],
);

def org_set_intersect = assert_org(
    "org-set-intersect",
    parse(r#"{
        "op": "set",
        "kind": "intersect",
        "branches": [
            {
                "shape": "row",
                "measures": [],
                "dimensions": ["OrgRegion"],
                "filters": [
                    {"dimension": "OrgRegion", "op": "eq", "kind": "text", "value": "north"}
                ],
                "ordering": [],
                "limit": null,
                "offset": null
            },
            {
                "shape": "row",
                "measures": [],
                "dimensions": ["OrgRegion"],
                "filters": [
                    {"dimension": "OrgRegion", "op": "eq", "kind": "text", "value": "south"}
                ],
                "ordering": [],
                "limit": null,
                "offset": null
            }
        ]
    }"#),
    "SELECT t.region FROM org_teams AS t WHERE t.region = ? INTERSECT SELECT t.region FROM org_teams AS t WHERE t.region = ?",
    [qb.Val.String("north"), qb.Val.String("south")],
);

def org_set_count = assert_org(
    "org-set-count",
    parse(r#"{
        "op": "set_count",
        "kind": "intersect",
        "branches": [
            {
                "shape": "row",
                "measures": [],
                "dimensions": ["OrgRegion"],
                "filters": [
                    {"dimension": "OrgRegion", "op": "eq", "kind": "text", "value": "north"}
                ],
                "ordering": [],
                "limit": null,
                "offset": null
            },
            {
                "shape": "row",
                "measures": [],
                "dimensions": ["OrgRegion"],
                "filters": [
                    {"dimension": "OrgRegion", "op": "eq", "kind": "text", "value": "south"}
                ],
                "ordering": [],
                "limit": null,
                "offset": null
            }
        ]
    }"#),
    "SELECT count(1) FROM (SELECT t.region FROM org_teams AS t WHERE t.region = ? INTERSECT SELECT t.region FROM org_teams AS t WHERE t.region = ?) AS __q_set",
    [qb.Val.String("north"), qb.Val.String("south")],
);

# ---------------------------------------------------------------------------
# Determinism: repeated lowering is byte-identical across both models.
# ---------------------------------------------------------------------------

def deterministic_knowledge = do {
    let intent = parse(r#"{
        "op": "list",
        "measures": [],
        "dimensions": ["MemberKind"],
        "filters": [
            {"dimension": "MemberKind", "op": "eq", "kind": "text", "value": "staff"}
        ],
        "ordering": [],
        "exists": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#);
    let first = lower_knowledge(intent);
    let second = lower_knowledge(intent);
    if first == second {
        True
    } else {
        fail!("knowledge intent lowering is not deterministic", first, second)
    }
};

def deterministic_org = do {
    let intent = parse(r#"{
        "op": "aggregate",
        "measures": ["TeamCount"],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [],
        "having": [],
        "hidden_having": [
            {"measure": "TeamHeadSum", "op": "ge", "kind": "int", "value": 5}
        ],
        "exists": [],
        "limit": null,
        "offset": null
    }"#);
    let first = lower_org(intent);
    let second = lower_org(intent);
    if first.sql == second.sql && first.bindings == second.bindings {
        True
    } else {
        fail!("org intent lowering is not deterministic", first, second)
    }
};

# ---------------------------------------------------------------------------
# Rejection probes (pure `query_intent_ok`, never fails).
# ---------------------------------------------------------------------------

def valid_knowledge_intent: Value = parse(r#"{
    "op": "list",
    "measures": [],
    "dimensions": ["MemberKind"],
    "filters": [],
    "ordering": [],
    "exists": [],
    "having": [],
    "limit": null,
    "offset": null
}"#);

def rejects_unauthorized_subject = do {
    if !query_intent_ok(payload, "outsider", valid_knowledge_intent) {
        True
    } else {
        fail!("intent probe: an unauthorized subject should be rejected")
    }
};

def rejects_unknown_op = do {
    let intent = parse(r#"{"op": "wizard", "measures": [], "dimensions": [], "filters": [], "ordering": []}"#);
    if !query_intent_ok(payload, "analyst", intent) {
        True
    } else {
        fail!("intent probe: an unsupported op should be rejected")
    }
};

def rejects_malformed_measures = do {
    let intent = parse(r#"{"op": "count", "measures": "MemberCount", "dimensions": [], "filters": [], "ordering": []}"#);
    if !query_intent_ok(payload, "analyst", intent) {
        True
    } else {
        fail!("intent probe: a malformed measures field should be rejected")
    }
};

def rejects_field_predicate_outside_list = do {
    # field-to-field predicates are a row-level list shape; using one inside an
    # aggregate shape is rejected by the structural probe (and by lowering).
    let intent = parse(r#"{
        "op": "aggregate",
        "measures": ["TeamCount"],
        "dimensions": ["OrgRegion"],
        "filters": [
            {"left": "OrgCode", "op": "eq", "right": "OrgZone"}
        ],
        "ordering": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#);
    if !query_intent_ok(org_payload, "analyst", intent) {
        True
    } else {
        fail!("intent probe: a field-to-field predicate outside the list shape should be rejected")
    }
};

def rejects_unsupported_set_kind = do {
    let intent = parse(r#"{"op": "set", "kind": "fuzzy", "branches": []}"#);
    if !query_intent_ok(payload, "analyst", intent) {
        True
    } else {
        fail!("intent probe: an unsupported set kind should be rejected")
    }
};

def positive_control_intents = do {
    if query_intent_ok(payload, "analyst", valid_knowledge_intent)
        && query_intent_ok(org_payload, "analyst", parse(r#"{
            "op": "list",
            "measures": [],
            "dimensions": ["OrgRegion"],
            "filters": [
                {"left": "OrgCode", "op": "eq", "right": "OrgZone"}
            ],
            "ordering": [],
            "limit": null,
            "offset": null
        }"#)) {
        True
    } else {
        fail!("intent probe: valid intents should be accepted")
    }
};

export def count_members_case = test.should_ok(fn() { if count_members { True } else { fail!("assertion failed: count_members") } });
export def filtered_members_case = test.should_ok(fn() { if filtered_members { True } else { fail!("assertion failed: filtered_members") } });
export def knowledge_distinct_case = test.should_ok(fn() { if knowledge_distinct { True } else { fail!("assertion failed: knowledge_distinct") } });
export def org_field_to_field_case = test.should_ok(fn() { if org_field_to_field { True } else { fail!("assertion failed: org_field_to_field") } });
export def org_hidden_row_ordering_case = test.should_ok(fn() { if org_hidden_row_ordering { True } else { fail!("assertion failed: org_hidden_row_ordering") } });
export def org_selected_having_case = test.should_ok(fn() { if org_selected_having { True } else { fail!("assertion failed: org_selected_having") } });
export def org_model_declared_distinct_measure_case = test.should_ok(fn() { if org_model_declared_distinct_measure { True } else { fail!("assertion failed: org_model_declared_distinct_measure") } });
export def org_measure_dimension_output_order_case = test.should_ok(fn() { if org_measure_dimension_output_order { True } else { fail!("assertion failed: org_measure_dimension_output_order") } });
export def org_hidden_having_case = test.should_ok(fn() { if org_hidden_having { True } else { fail!("assertion failed: org_hidden_having") } });
export def org_related_exists_case = test.should_ok(fn() { if org_related_exists { True } else { fail!("assertion failed: org_related_exists") } });
export def org_related_absence_case = test.should_ok(fn() { if org_related_absence { True } else { fail!("assertion failed: org_related_absence") } });
export def org_related_hidden_ordering_case = test.should_ok(fn() { if org_related_hidden_ordering { True } else { fail!("assertion failed: org_related_hidden_ordering") } });
export def org_set_intersect_case = test.should_ok(fn() { if org_set_intersect { True } else { fail!("assertion failed: org_set_intersect") } });
export def org_set_count_case = test.should_ok(fn() { if org_set_count { True } else { fail!("assertion failed: org_set_count") } });
export def deterministic_knowledge_case = test.should_ok(fn() { if deterministic_knowledge { True } else { fail!("assertion failed: deterministic_knowledge") } });
export def deterministic_org_case = test.should_ok(fn() { if deterministic_org { True } else { fail!("assertion failed: deterministic_org") } });
export def rejects_unauthorized_subject_case = test.should_ok(fn() { if rejects_unauthorized_subject { True } else { fail!("assertion failed: rejects_unauthorized_subject") } });
export def rejects_unknown_op_case = test.should_ok(fn() { if rejects_unknown_op { True } else { fail!("assertion failed: rejects_unknown_op") } });
export def rejects_malformed_measures_case = test.should_ok(fn() { if rejects_malformed_measures { True } else { fail!("assertion failed: rejects_malformed_measures") } });
export def rejects_field_predicate_outside_list_case = test.should_ok(fn() { if rejects_field_predicate_outside_list { True } else { fail!("assertion failed: rejects_field_predicate_outside_list") } });
export def rejects_unsupported_set_kind_case = test.should_ok(fn() { if rejects_unsupported_set_kind { True } else { fail!("assertion failed: rejects_unsupported_set_kind") } });
export def positive_control_intents_case = test.should_ok(fn() { if positive_control_intents { True } else { fail!("assertion failed: positive_control_intents") } });
