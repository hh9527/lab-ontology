use ontology::semantic as domain;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
type ResourceId = struct(String);
use ontology::quantity::{EffectiveCount};
# 仅沿用旧百分比尺度假定，尚未确认生产比例；不增加范围检查。
type AssumedOnlinePercent = struct(Float);
def online_statistics: samples::Group(AssumedOnlinePercent) = samples::group(
    "reported_network_online",
    AssumedOnlinePercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max],
    Some("%")
);
@domain::subject("Device", "source_resId")
@domain::dataset(
    "source_NetworkDeviceOnlineKPI",
    "NetworkDeviceOnlineKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
type NetworkDeviceOnlineKPI = struct {
    @m::column("ts")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceOnlineKPI__ts",
            s::DateTimeUtc.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceOnlineKPI__ts",
        True,
        g::numeric_filters
    )
    @g::utc_bucket_view("source_NetworkDeviceOnlineKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkDeviceOnlineKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkDeviceOnlineKPI_utc_month", qb::UtcBucketUnit::Month)
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkDeviceOnlineKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkDeviceOnlineKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_NetworkDeviceOnlineKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_NetworkDeviceOnlineKPI__projectId")
    source_projectId: String,
    @m::column("deviceName")
    @g::search("source_NetworkDeviceOnlineKPI__deviceName")
    source_deviceName: String,
    @m::column("classification")
    @v::classification(i::classes, "source_NetworkDeviceOnlineKPI__classification")
    source_classification: String,
    @m::column("onlineRate")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceOnlineKPI__onlineRate",
            AssumedOnlinePercent.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceOnlineKPI__onlineRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        online_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "network_online_rate_avg"},
            {statistic: samples::Statistic::Min, publish: "network_online_rate_min"},
            {statistic: samples::Statistic::Max, publish: "network_online_rate_max"}
        ]
    )
    source_onlineRate: AssumedOnlinePercent,
    @m::column("onlineRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkDeviceOnlineKPI__onlineRateEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkDeviceOnlineKPI__onlineRateEffcnt",
        True,
        g::numeric_filters
    )
    source_onlineRateEffcnt: EffectiveCount,
};

pub use self::{NetworkDeviceOnlineKPI};
