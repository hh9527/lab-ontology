def first_token_ordering_plan: Fn() -> qb.Plan = fn() {
    let segment = first_token_expr(qb.column("c", "command"));
    let plan: qb.Plan = {
        revision: "test-first-token-order",
        sources: [qb.source("c", "commands")],
        projection: [qb.expr_item(qb.column("c", "id"))],
