# Dataset semantics are declared independently of the physical source. Grain
# fields identify one logical row; time names the authoritative UTC instant.
type DatasetKind = enum {
    Entity,
    Event,
    Metric
};
type TimeSemantics = enum {
    Utc,
    Local,
    Date
};
type TimeLogicalType = enum {
    DateTime,
    Date,
    DateTimeUtc,
    EpochMillis
};
type TimeEncoding = enum {
    EpochMillis,
    LocalText,
    DateText,
    Rfc3339Text
};
@prelude::property(PropertyTarget::Field)
type TimeField = struct {
    semantics: TimeSemantics,
    encoding: TimeEncoding
};

# Roles describe business use; they do not grant query access or define grain.
type FieldRole = enum {
    Appellation,
    Reference,
    Classification,
    Metric
};
@prelude::property(PropertyTarget::Field)
type FieldRolesDef = struct {
    roles: Array(FieldRole)
};
type ReferenceSpec = struct {
    id: String,
    fields: Array(String)
};
@prelude::property(PropertyTarget::Type)
type ReferencesDef = struct {
    references: Array(ReferenceSpec)
};

def field_role: Fn(
    FieldRole
) -> Fn(property::FieldPropertyCtx, Option(FieldRolesDef)) -> FieldRolesDef = fn(role) {
    fn(ctx, previous) {
        let roles = match previous {
            Some(declared) => declared.roles,
            None => []
        };
        {roles: array::push(roles, role)}
    }
};

# Every complete set is a trusted unique address within the declaring type.
def reference: Fn(String, Array(String)) -> Fn(td::TypeDesc, Option(ReferencesDef)) -> ReferencesDef = fn(
    id,
    fields
) {
    contract::name(id);
    if fields == [] {
        fail!("reference requires a nonempty field set", id)
    } else {
        ()
    };
    contract::unique(fields);
    fn(ctx, previous) {
        let references = match previous {
            Some(declared) => declared.references,
            None => []
        };
        let declared_fields = td::fields(ctx);
        array::map(
            fields,
            fn(name) {
                if !array::any(
                    declared_fields,
                    fn(field) {
                        field.name == name
                    }
                ) {
                    fail!("unknown reference field", ctx, id, name)
                } else {
                    ()
                }
            }
        );
        array::map(
            references,
            fn(other) {
                if other.id == id {
                    fail!("duplicate reference id", ctx, id)
                } else if array::length(other.fields) == array::length(fields) && array::all(
                    fields,
                    fn(name) {
                        array::any(
                            other.fields,
                            fn(field) {
                                field == name
                            }
                        )
                    }
                ) {
                    fail!("duplicate reference field set", ctx, id)
                } else {
                    ()
                }
            }
        );
        {references: array::push(references, {id, fields})}
    }
};
