@registry::dataset(
    "kpi-storage-enterprise-front-port",
    "kpi_storage_enterpriseFrontPort",
    ["obj_id", "ts"]
)
@registry::roles([role_264])
@registry::groups(
    [
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseFrontPort.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "sefp_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseFrontPort.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "sefp_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseFrontPort.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "sefp_utc_month",
            True,
            g::time_filters
        )
    ]
)
