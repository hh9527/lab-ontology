use crate::typed::{payload};
use crate::typed::inventory as inventory;
use crate::model as baseline;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};

type Pair = struct {
    id: String,
    typed: qb::Query,
    baseline: qb::Query,
    postgres: qb::Query,
    columns: Array(intent::ResultColumn),
    baseline_columns: Array(intent::ResultColumn)
};
def pair: Fn(String, Value) -> Pair = fn(id, request) {
    let actual = intent::query_intent_ast_factory(payload)(request);
    let expected = intent::query_intent_ast_factory(baseline::payload)(request);
    {
        id,
        typed: sqlite::build_query(actual),
        baseline: sqlite::build_query(expected),
        postgres: postgres::build_query(actual),
        columns: intent::result_columns(payload, request, actual),
        baseline_columns: intent::result_columns(baseline::payload, request, expected)
    }
};
def link_case: Fn(String, String) -> Pair = fn(id, extra) {
    pair(
        id,
        json::parse(
            `{"op":"Graph","root":"l","nodes":[{"id":"l","entity":"physical_link"}],"edges":[],\{extra}}`
        ).unwrap!()
    )
};
def cases: Array(Pair) = array::concat(
    [
        array::map(
            array::filter(
                payload.dimensions,
                fn(dimension) {
                    payload.entities[dimension.entity].id == "physical_link"
                }
            ),
            fn(dimension) {
                link_case(
                    `project_\{dimension.id}`,
                    `"select":[{"node":"l","dimension":"\{dimension.id}"}]`
                )
            }
        ),
        array::flat_map(
            array::filter(
                payload.dimensions,
                fn(dimension) {
                    payload.entities[dimension.entity].id == "physical_link" && array::length(
                        dimension.canonical_values
                    ) > 0
                }
            ),
            fn(dimension) {
                array::flat_map(
                    dimension.canonical_values,
                    fn(member) {
                        array::map(
                            ["Eq", "Ne"],
                            fn(op) {
                                link_case(
                                    `filter_\{dimension.id}_\{member.id}_\{op}`,
                                    `"select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"\{dimension.id}","op":"\{op}","value":"\{member.id}"}]`
                                )
                            }
                        )
                    }
                )
            }
        ),
        [
            link_case(
                "count",
                r#""select":[],"measures":[{"node":"l","measure":"physical_link_count"}]"#
            ),
            link_case(
                "name_pairs",
                r#""select":[{"node":"l","dimension":"physical_link_a_ne_name"},{"node":"l","dimension":"physical_link_z_ne_name"}]"#
            ),
            link_case(
                "window",
                r#""select":[],"measures":[{"node":"l","measure":"physical_link_count"}],"time_windows":[{"node":"l","dimension":"physical_link__createTime","start":2000,"end":5000}]"#
            ),
            link_case(
                "status_groups",
                r#""select":[{"node":"l","dimension":"physical_link_status"}],"measures":[{"node":"l","measure":"physical_link_count"}]"#
            ),
            link_case(
                "physical_link_a_port_ip_ipv4_InSubnet",
                r#""select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"physical_link_a_port_ip_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#
            ),
            link_case(
                "physical_link_a_port_ip_ipv4_NotInSubnet",
                r#""select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"physical_link_a_port_ip_ipv4","op":"NotInSubnet","value":"192.0.2.0/24"}]"#
            ),
            link_case(
                "physical_link_a_ne_ip_ipv4_InSubnet",
                r#""select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"physical_link_a_ne_ip_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#
            ),
            link_case(
                "physical_link_a_ne_ip_ipv4_NotInSubnet",
                r#""select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"physical_link_a_ne_ip_ipv4","op":"NotInSubnet","value":"192.0.2.0/24"}]"#
            ),
            link_case(
                "physical_link__zPortIp_ipv4_InSubnet",
                r#""select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"physical_link__zPortIp_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#
            ),
            link_case(
                "physical_link__zPortIp_ipv4_NotInSubnet",
                r#""select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"physical_link__zPortIp_ipv4","op":"NotInSubnet","value":"192.0.2.0/24"}]"#
            ),
            link_case(
                "physical_link__zNeIp_ipv4_InSubnet",
                r#""select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"physical_link__zNeIp_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#
            ),
            link_case(
                "physical_link__zNeIp_ipv4_NotInSubnet",
                r#""select":[{"node":"l","dimension":"physical_link_id"}],"filters":[{"node":"l","dimension":"physical_link__zNeIp_ipv4","op":"NotInSubnet","value":"192.0.2.0/24"}]"#
            ),
            pair(
                "physical_link_a_device",
                json::parse(
                    r#"{"op":"Graph","root":"l","nodes":[{"id":"l","entity":"physical_link"},{"id":"p","entity":"device"}],"edges":[{"relation":"physical_link_a_device","from":"l","to":"p"}],"select":[{"node":"l","dimension":"physical_link_id"},{"node":"p","dimension":"device_id"}]}"#
                ).unwrap!()
            ),
            pair(
                "physical_link_z_device",
                json::parse(
                    r#"{"op":"Graph","root":"l","nodes":[{"id":"l","entity":"physical_link"},{"id":"p","entity":"device"}],"edges":[{"relation":"physical_link_z_device","from":"l","to":"p"}],"select":[{"node":"l","dimension":"physical_link_id"},{"node":"p","dimension":"device_id"}]}"#
                ).unwrap!()
            ),
            pair(
                "physical_link_belongs_to_tenant",
                json::parse(
                    r#"{"op":"Graph","root":"l","nodes":[{"id":"l","entity":"physical_link"},{"id":"p","entity":"tenant"}],"edges":[{"relation":"physical_link_belongs_to_tenant","from":"l","to":"p"}],"select":[{"node":"l","dimension":"physical_link_id"},{"node":"p","dimension":"tenant_id"}]}"#
                ).unwrap!()
            ),
            pair(
                "physical_link_attached_device",
                json::parse(
                    r#"{"op":"Graph","root":"l","nodes":[{"id":"l","entity":"physical_link"},{"id":"p","entity":"device"}],"edges":[{"relation":"physical_link_attached_device","from":"l","to":"p"}],"select":[{"node":"l","dimension":"physical_link_id"},{"node":"p","dimension":"device_id"}],"row_grain":"Association"}"#
                ).unwrap!()
            ),
            pair(
                "physical_link_attached_server",
                json::parse(
                    r#"{"op":"Graph","root":"l","nodes":[{"id":"l","entity":"physical_link"},{"id":"p","entity":"server_device"}],"edges":[{"relation":"physical_link_attached_server","from":"l","to":"p"}],"select":[{"node":"l","dimension":"physical_link_id"},{"node":"p","dimension":"server_name"}],"row_grain":"Association"}"#
                ).unwrap!()
            ),
            pair(
                "peer",
                json::parse(
                    r#"{"op":"Graph","root":"a","row_grain":"Association","distinct":true,"nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],"edges":[{"relation":"physical_link_peer_device","from":"a","to":"z"}],"select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]}"#
                ).unwrap!()
            ),
            pair(
                "reverse_peer",
                json::parse(
                    r#"{"op":"Graph","root":"z","row_grain":"Association","distinct":true,"nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],"edges":[{"relation":"physical_link_peer_device","from":"a","to":"z"}],"select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]}"#
                ).unwrap!()
            ),
            pair(
                "downstream",
                json::parse(
                    r#"{"op":"Graph","root":"a","row_grain":"Association","distinct":true,"nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],"edges":[{"relation":"physical_link_downstream_device","from":"a","to":"z"}],"select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]}"#
                ).unwrap!()
            ),
        ],
    ]
);
type Fixture = struct {
    cases: Array(Pair),
    schema: Value
};
pub def runtime_fixture: Value = codec::encode(
    {
        cases,
        schema: codec::encode(
            array::map(
                payload.entities,
                fn(entity) {
                    (
                        entity.id,
                        entity.table,
                        array::map(
                            entity.fields,
                            fn(field) {
                                (
                                    field.name,
                                    field.column,
                                    if field.ty == Int.type || field.ty == Bool.type {
                                        "INTEGER"
                                    } else if field.ty == Float.type {
                                        "REAL"
                                    } else {
                                        "TEXT"
                                    }
                                )
                            }
                        )
                    )
                }
            )
        )
    }.ty!(Fixture)
);
