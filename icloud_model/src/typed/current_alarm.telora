# 算术组合不推断业务人口；这个结果是分数，不能当作告警数。
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def source_cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    domain::guarded(
        r::relation("alarm_site_reference", site_reference, site::subject, cardinality),
        "strext13",
        edsl::FilterOp::Ne,
        "3"
    ),
    r::relation("alarm_belongs_to_tenant", tenant, i::tenant_subject, cardinality),
    r::relation("server_current_alarm", server_reference, server::subject, cardinality),
    r::relation("device_current_alarm", device, i::device_subject, cardinality),
    r::relation(
        "source_EntNetworkElement_T_CURRENT_ALARM",
        i::device_subject,
        device,
        source_cardinality
    ),
    r::relation(
        "source_X_TENANT_VIEW_T_CURRENT_ALARM",
        i::tenant_subject,
        tenant,
        source_cardinality
    ),
    r::relation(
        "source_X_SITE_VIEW_T_CURRENT_ALARM",
        site::subject,
        site_reference,
        source_cardinality
    ),
    r::relation(
        "source_PhysicalServer_T_CURRENT_ALARM",
        server::subject,
        server_reference,
        source_cardinality
    ),
    r::relation(
        "source_HuaweiStorageDeviceAggregationT_CURRENT_ALARM",
        storage::subject,
        storage_reference,
        source_cardinality
    ),
    r::relation(
        "source_EntPonElementAssociationT_CURRENT_ALARM",
        pon::subject,
        pon_reference,
        source_cardinality
    ),
];
pub use self::{TCurrentAlarm, relations};
