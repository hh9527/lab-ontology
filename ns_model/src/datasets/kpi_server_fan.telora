        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_server_fan.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "sf_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_server_fan.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "sf_utc_month",
            True,
            g::time_filters
        )
    ]
)
@registry::reported_samples(
    [
        sample::bind(
            dataset,
            groups::group_29,
            m::optional_field(kpi_server_fan.type, units::RevolutionsPerMinute.type, "speed"),
            [
                {statistic: sample::Statistic::Mean, publish: "sf_speed"},
                {statistic: sample::Statistic::Max, publish: "sf_speed_max"},
                {statistic: sample::Statistic::Min, publish: "sf_speed_min"}
            ]
        ),
        sample::bind(
