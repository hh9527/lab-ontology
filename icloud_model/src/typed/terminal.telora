@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementBlockStatus = enum {
    @ev::itag(0)
    @ev::description("Not blocked", "未阻断")
    NotBlocked,
    @ev::itag(1)
    @ev::description("MAC blocked", "mac阻断")
    MacBlocked,
    @ev::itag(2)
    @ev::description("Port shutdown", "端口shutdown")
    PortShutdown,
};
def SourceEntTerminalElementBlockStatus_domain: v::Domain(SourceEntTerminalElementBlockStatus, Int) = v::from_enum(
    "SourceEntTerminalElementBlockStatus",
    SourceEntTerminalElementBlockStatus.type,
    Int.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_EntTerminalElement_EntNetworkElement",
        r::endpoint(dataset.row, device.id),
        r::endpoint(i::devices.row, i::device_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EntTerminalElement_EntPonElement",
        r::endpoint(dataset.row, pon.id),
        r::endpoint(pons::dataset.row, pons::subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EntTerminalElement_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        cardinality
    ),
];
def alternatives: Array(registry::Alternative) = [
    {
        id: "source_EntTerminalElement_X_SITE_VIEW",
        cardinality,
        choices: [
            r::relation(
                "terminal_site",
                r::endpoint(dataset.row, site.id),
                r::endpoint(sites::dataset.row, sites::subject.id),
                cardinality
            ),
            r::relation(
                "terminal_project",
                r::endpoint(dataset.row, project.id),
                r::endpoint(sites::dataset.row, sites::subject.id),
                cardinality
            ),
        ]
    }
];
pub use self::{relations, alternatives};

pub use self::{EntTerminalElement, Identity};
