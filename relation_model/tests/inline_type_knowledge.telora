# 知识导出夹具：复用已有 payload，仅扩展反射声明以覆盖非 SQL 容器类型。
use crate::typed_relations as model;
use ontology::experimental::knowledge as knowledge;
use std::array as array;
use std::value::{Value};
use ontology::experimental::transform as transform;

type Business = struct(Int);
type NamedArray = struct(Array(Int));
type NamedOption(T) = enum {None, Some(T)};
type Metadata = struct {
    id: model::TenantId,
    integer: Int, decimal: Float, flag: Bool, text: String,
    optional: Option(Int), array: Array(Float), dictionary: Dict(Bool),
    nested: Array(Option(Dict(Business))),
    business: Business, named_array: NamedArray, named_option: NamedOption(Int),
};

def prepared: transform::Prepared = model::prepared <~ {
    declarations: array::map(array::enumerate(model::prepared.declarations), fn(pair) {
        if pair.0 == 0 { pair.1 <~ {dataset: pair.1.dataset <~ {row: Metadata.type}} }
        else { pair.1 }
    })
};

pub def publication: Value = knowledge::export(prepared);
pub def javascript_publication: Value = knowledge::publication(prepared);
