# Development audit: export the prepared model, not a second parse of source.
use crate::model::{ payload };
use ontology::ontology as edsl;
use std::array as array;
use std::codec as codec;
use std::type_property as property;
use std::value::{ Value };

def scalar_name: Fn(Type) -> String = fn(ty) {
    if ty == String.type { "String" }
    else if ty == Int.type { "Int" }
    else if ty == Float.type { "Float" }
    else if ty == Bool.type { "Bool" }
    else { "Unsupported" }
};

type Equality = struct { from_column: String, to_column: String };
type Key = enum { Eq(Equality), And(Array(Key)), Or(Array(Key)) };
type Field = struct {
    nullable: Bool,
    name: String, column: String, scalar: String, is_key: Bool,
    time: Option(edsl::TimeField),
};
type Dataset = struct { id: String, table: String, fields: Array(Field) };
type Relation = struct {
    id: String, from_dataset: String, to_dataset: String,
    from_table: String, to_table: String,
    cardinality: edsl::RelationCardinality, key: Key,
};
type Dimension = struct {
    id: String, dataset: String, column: String, computed: Bool,
    authorized: Bool, filterable: Bool, ops: Array(edsl::FilterOp), input_kinds: Array(edsl::FilterInputKind),
    half_open: Bool,
    values: Array(edsl::CanonicalValueSpec),
};
type Report = struct {
    revision: String,
    datasets: Array(Dataset), relations: Array(Relation), dimensions: Array(Dimension),
};
def column: Fn(edsl::EntityEntry, Int) -> String = fn(entity, index) {
    match array::find(entity.fields, fn(field) { field.index == index }) {
        Some(field) => field.column,
        None => fail!("prepared field index missing", entity.id, index),
    }
};
def key: Fn(edsl::RelationEntry, edsl::RelationKey) -> Key = fn(relation, value) {
    match value {
        edsl::RelationKey::Eq(pair) => {
            let from = payload.entities[relation.from];
            let to = payload.entities[relation.to];
            Key::Eq({
                from_column: column(from, pair.from),
                to_column: column(to, pair.to),
            })
        },
        edsl::RelationKey::And(parts) => Key::And(array::map(parts, fn(part) { key(relation, part) })),
        edsl::RelationKey::Or(parts) => Key::Or(array::map(parts, fn(part) { key(relation, part) })),
    }
};

pub def report: Value = codec::encode({
    revision: payload.revision,
    datasets: array::map(payload.entities, fn(entity) {
        {
            id: entity.id,
            table: entity.table,
            fields: array::map(entity.fields, fn(field) {
                {
                    name: field.name, column: field.column, scalar: scalar_name(field.ty), nullable: field.nullable,
                    is_key: field.is_key,
                    time: property::get_field_prop(entity.entity_type, field.index, edsl::TimeField.type),
                }.ty!(Field)
            }),
        }.ty!(Dataset)
    }),
    relations: array::map(payload.relations, fn(relation) {
        {
            id: relation.id,
            from_dataset: payload.entities[relation.from].id,
            to_dataset: payload.entities[relation.to].id,
            from_table: payload.entities[relation.from].table,
            to_table: payload.entities[relation.to].table,
            cardinality: relation.cardinality,
            key: key(relation, relation.key),
        }.ty!(Relation)
    }),
    dimensions: array::map(payload.dimensions, fn(dimension) {
        {
            id: dimension.id,
            dataset: payload.entities[dimension.entity].id,
            column: column(payload.entities[dimension.entity], dimension.field),
            computed: dimension.computed,
            authorized: dimension.authorized, filterable: dimension.filterable,
            ops: dimension.ops, input_kinds: dimension.input_kinds,
            half_open: dimension.half_open,
            values: dimension.canonical_values,
        }.ty!(Dimension)
    }),
}.ty!(Report));
