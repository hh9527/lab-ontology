pub def zoned_time_bucket_is_rejected: test::Test = test::should_fail_with(
    fn() {
        uql::render_expr_with_context(
            qb::scalar(
                qb::ScalarFunction::ZonedTimeBucket(qb::UtcBucketUnit::Day),
                [id, needle.1]
            ),
            cap.0
        )
    },
