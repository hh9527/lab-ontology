use ontology::js_codec as js;
use ontology::enum_values as ev;
use ontology::intent as intent;
use ontology::values as v;
use std::test as test;

type Duplicate = enum {
    @ev::itag(1)
    First,
    @ev::itag(1)
    Second,
};
type MissingTag = enum {
    One
};
type Payload = enum {
    Known,
    Unknown(String)
};
type Mapped = enum {
    First,
    Second,
    Unknown
};

@ev::order_by_itag
type OrderedFallback = enum {
    @ev::itag(10)
    Known,
    @ev::itag(99)
    Unknown,
};
pub def fallback_variant_participates_in_business_order: test::Test = test::should_ok(
    fn() {
        v::map_or(
            OrderedFallback.type,
            "ordered_classification",
            [v::member(OrderedFallback::Known, ["known"])],
            OrderedFallback::Unknown
        );
        True
    }
);

pub def duplicate_integer_tag_is_rejected: test::Test = test::should_fail(
    fn() {
        js::source(Duplicate.type, intent::ResultType::Int)
    }
);
pub def missing_integer_tag_is_rejected: test::Test = test::should_fail(
    fn() {
        js::source(MissingTag.type, intent::ResultType::Int)
    }
);
pub def enum_payload_is_rejected: test::Test = test::should_fail(
    fn() {
        js::source(Payload.type, intent::ResultType::String)
    }
);
pub def duplicate_source_mapping_is_rejected: test::Test = test::should_fail(
    fn() {
        v::map_or(
            Mapped.type,
            "classification",
            [v::member(Mapped::First, ["one"]), v::member(Mapped::Second, ["one"])],
            Mapped::Unknown
        )
    }
);
