# 领域枚举成员直接携带源编码；排序是领域类型的显式属性。
use std::prelude as prelude;
use std::type_property as property;
use std::type_desc as td;
use std::array as array;
use crate::ontology as edsl;
use crate::groups as groups;

@prelude::property(PropertyTarget::Variant)
type Tags = struct {
    values: Array(edsl::FilterInput),
    id: String
};
@prelude::property(PropertyTarget::Type)
type OrderByITag = struct {};
def tags: Fn(Array(edsl::FilterInput)) -> Fn(property::VariantPropertyCtx, Option(Tags)) -> Tags = fn(
    values
) {
    fn(ctx, previous) {
        let before = match previous {
            Some(p) => p.values,
            None => []
        };
        {values: array::concat([before, values]), id: ctx.name}
    }
};
def itag: Fn(Int) -> Fn(property::VariantPropertyCtx, Option(Tags)) -> Tags = fn(value) {
    tags([edsl::FilterInput::Int(value)])
};
# 字符串源表示使用重命名；多个源表示通过 alias 补充。
def rename: Fn(String) -> Fn(property::VariantPropertyCtx, Option(Tags)) -> Tags = fn(value) {
    fn(ctx, previous) {
        match previous {
            Some(_) => fail!("rename must be declared once, before aliases", ctx.name),
            None => {values: [edsl::FilterInput::Text(value)], id: ctx.name},
        }
    }
};
def alias: Fn(String) -> Fn(property::VariantPropertyCtx, Option(Tags)) -> Tags = fn(value) {
    fn(ctx, previous) {
        match previous {
            Some(p) => {
                if !array::all(
                    p.values,
                    fn(v) {
                        match v {
                            edsl::FilterInput::Text(_) => True,
                            _ => False
                        }
                    }
                ) {
                    fail!("string alias requires rename", ctx.name)
                } else {
                    ()
                };
                p <~ {values: array::push(p.values, edsl::FilterInput::Text(value))}
            },
            None => fail!("string alias requires rename", ctx.name),
        }
    }
};
@prelude::property(PropertyTarget::Variant)
type Description = struct {
    label: String,
    names: Array(String)
};
def description: Fn(
    String,
    String
) -> Fn(property::VariantPropertyCtx, Option(Description)) -> Description = fn(label, localized) {
    fn(ctx, previous) {
        {
            label,
            names: array::filter(
                [label, localized],
                fn(value) {
                    value != ""
                }
            )
        }
    }
};
def variant_names: Fn(Type, Int) -> Array(String) = fn(ty, index) {
    match property::get_variant_prop(ty, index, Description.type) {
        Some(info) => info.names,
        None => [],
    }
};
def order_by_itag: Fn(td::TypeDesc, Option(OrderByITag)) -> OrderByITag = fn(ctx, previous) {
    {}
};
def members: Fn(Type) -> Array(edsl::CanonicalValueSpec) = fn(ty) {
    let body = groups::representation(ty);
    if td::kind(body) != td::TypeDescKind::Enum {
        fail!("tagged domain requires an enum", ty)
    } else {
        ()
    };
    array::map(
        td::variants(body),
        fn(variant) {
            if variant.payload != None {
                fail!("domain variant must not have a payload", ty, variant.name)
            } else {
                ()
            };
            let tag = match property::get_variant_prop(ty, variant.index, Tags.type) {
                Some(tag) => tag,
                None => fail!("domain variant requires source tags", ty, variant.name),
            };
            let label = match property::get_variant_prop(ty, variant.index, Description.type) {
                Some(info) => info.label,
                None => tag.id,
            };
            {id: tag.id, label, wires: tag.values}.ty!(edsl::CanonicalValueSpec)
        }
    )
};
pub use self::{
    Tags,
    OrderByITag,
    Description,
    itag,
    rename,
    alias,
    description,
    variant_names,
    order_by_itag,
    members
};
