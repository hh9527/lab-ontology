pub def relations: Array(r::Relation) = [
    r::relation("ea__ar", domain::endpoint(EnterpriseAp.type, "id"), domain::endpoint(alarm_record::AlarmRecord.type, "me_dn"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ea__ne", domain::endpoint(EnterpriseAp.type, "ref_parent_ne"), domain::endpoint(network_element::NetworkElement.type, "id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ea__ea2", domain::endpoint(EnterpriseAp.type, "obj_sys_id"), domain::endpoint(enterprise_ap_2_kpi::EnterpriseAp2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ea__epl", domain::endpoint(EnterpriseAp.type, "id"), domain::endpoint(enterprise_physical_link::EnterprisePhysicalLink.type, "z_ne_res_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ea__epl_2", domain::endpoint(EnterpriseAp.type, "id"), domain::endpoint(enterprise_physical_link::EnterprisePhysicalLink.type, "a_ne_res_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("ea__subnet", domain::endpoint(EnterpriseAp.type, "ref_parent_subnet"), domain::endpoint(subnet::Subnet.type, "id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
