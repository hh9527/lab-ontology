use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@registry::entity("server_network_adapter_entity")
type Identity = struct {
    id: ComponentId
};
@registry::dataset(
    "source_PhysicalServerNetworkAdapter",
    "PhysicalServerNetworkAdapter",
    ["source_id"]
)
@registry::roles([subject, tenant, parent])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PhysicalServerNetworkAdapter__createTime",
                s::EpochMillis.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PhysicalServerNetworkAdapter.type,
                    s::EpochMillis.type,
                    "source_createTime"
                )
            ),
            "source_PhysicalServerNetworkAdapter__createTime",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
type PhysicalServerNetworkAdapter = struct {
    @m::column("name")
    @g::search("source_PhysicalServerNetworkAdapter__name")
    source_name: String,
    @m::column("tenantId")
    @g::exact("source_PhysicalServerNetworkAdapter__tenantId")
    source_tenantId: i::TenantId,
    @m::column("id")
    @g::exact("source_PhysicalServerNetworkAdapter__id")
    source_id: ComponentId,
    @m::column("parentResId")
    @g::exact("source_PhysicalServerNetworkAdapter__parentResId")
    source_parentResId: server::ServerOriginId,
    @m::column("position")
    @g::search("source_PhysicalServerNetworkAdapter__position")
    source_position: String,
    @m::column("cardModel")
    @g::exact("source_PhysicalServerNetworkAdapter__cardModel")
    source_cardModel: String,
    @m::column("cardManufacturer")
    @g::search("source_PhysicalServerNetworkAdapter__cardManufacturer")
    source_cardManufacturer: String,
    @m::column("cardName")
    @g::search("source_PhysicalServerNetworkAdapter__cardName")
    source_cardName: String,
    @m::column("healthState")
    @v::classification(
        SourcePhysicalServerNetworkAdapterHealthState_domain,
        "source_PhysicalServerNetworkAdapter__healthState"
    )
    source_healthState: String,
    @m::column("driverVersion")
    @g::search("source_PhysicalServerNetworkAdapter__driverVersion")
    source_driverVersion: String,
    @m::column("driverName")
    @g::search("source_PhysicalServerNetworkAdapter__driverName")
    source_driverName: String,
    @m::column("createTime")
    source_createTime: s::EpochMillis,
    @m::column("nativeId")
    @g::exact("source_PhysicalServerNetworkAdapter__nativeId")
    source_nativeId: String,
    @m::column("projectId")
    @g::exact("source_PhysicalServerNetworkAdapter__projectId")
    source_projectId: String,
    @m::column("model")
    @g::search("source_PhysicalServerNetworkAdapter__model")
    source_model: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(PhysicalServerNetworkAdapter) = registry::dataset_of(
    PhysicalServerNetworkAdapter.type
);
def subject: m::Role(PhysicalServerNetworkAdapter) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerNetworkAdapter.type, ComponentId.type, "source_id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServerNetworkAdapter) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerNetworkAdapter.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent: m::Role(PhysicalServerNetworkAdapter) = m::role(
    dataset,
    server::origin_entity,
    "server_origin",
    False,
    [
        m::identity_part(
            m::field(
                PhysicalServerNetworkAdapter.type,
                server::ServerOriginId.type,
                "source_parentResId"
            ),
            m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerNetworkAdapterHealthState = enum {
    @ev::rename("OK")
    @ev::description("normal", "正常")
    Normal,
    @ev::rename("Warning")
    @ev::description("warning", "警告")
    Warning,
    @ev::rename("Critical")
    @ev::description("critical", "紧急")
    Critical,
    @ev::rename("Unknown")
    @ev::description("unknown", "未知")
    Unknown,
};
def SourcePhysicalServerNetworkAdapterHealthState_domain: v::Domain(
    SourcePhysicalServerNetworkAdapterHealthState,
    String
) = v::from_enum(
    "SourcePhysicalServerNetworkAdapterHealthState",
    SourcePhysicalServerNetworkAdapterHealthState.type,
    String.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_PhysicalServer_PhysicalServerNetworkAdapter",
        r::endpoint(server::dataset.row, server::origin.id),
        r::endpoint(dataset.row, parent.id),
        cardinality
    ),
    r::relation(
        "source_PhysicalServerNetworkAdapter_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerNetworkAdapter, Identity};
