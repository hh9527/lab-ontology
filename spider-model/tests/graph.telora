use crate::model::{ payload };
use ontology::intent::{ query_intent_ast_factory };
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::json as json;
use std::string as string;
use std::test as test;

pub def student_program_existence: test::Test = test::should_ok(fn() {
    let lower = query_intent_ast_factory(payload, "public");
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"student", "nodes":[{"id":"student","entity":"student"}],
        "edges":[], "select":[], "count":"student",
        "exists":[{"anchor":"student","nodes":[{"id":"en","entity":"student_enrolment"},{"id":"program","entity":"degree_program"}],
            "edges":[{"relation":"student_enrolments","from":"student","to":"en"},
                     {"relation":"enrolment_program","from":"en","to":"program"}]}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "count(student.student_id)")
        && string::contains(sql, "EXISTS (SELECT 1 FROM student_enrolment AS en INNER JOIN degree_programs AS program") {
        True
    } else { fail!("student/program existence must preserve student grain", sql) }
});

pub def student_address_roles: test::Test = test::should_ok(fn() {
    let lower = query_intent_ast_factory(payload, "public");
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"student",
        "nodes":[{"id":"student","entity":"student"},{"id":"current","entity":"current_address"},{"id":"permanent","entity":"permanent_address"}],
        "edges":[{"relation":"student_current_address","from":"student","to":"current"},
                 {"relation":"student_permanent_address","from":"student","to":"permanent"}],
        "select":[{"node":"student","dimension":"student_id"}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "current_address_id") && string::contains(sql, "permanent_address_id") {
        True
    } else { fail!("student address roles were conflated", sql) }
});

pub def enrolments_per_student: test::Test = test::should_ok(fn() {
    let lower = query_intent_ast_factory(payload, "public");
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"student",
        "nodes":[{"id":"student","entity":"student"},{"id":"enrolment","entity":"student_enrolment"}],
        "edges":[{"relation":"student_enrolments","from":"student","to":"enrolment"}],
        "select":[{"node":"student","dimension":"student_id"}], "count":"enrolment"
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "count(enrolment.student_enrolment_id)")
        && string::contains(sql, "GROUP BY student.student_id") {
        True
    } else { fail!("enrolment count must follow declared child identity", sql) }
});

pub def enrolments_per_department_including_empty: test::Test = test::should_ok(fn() {
    let lower = query_intent_ast_factory(payload, "public");
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"department", "include_empty":true,
        "nodes":[{"id":"department","entity":"department"},
                 {"id":"program","entity":"degree_program"},
                 {"id":"enrolment","entity":"student_enrolment"}],
        "edges":[{"relation":"degree_program_department","from":"program","to":"department"},
                 {"relation":"enrolment_program","from":"enrolment","to":"program"}],
        "select":[{"node":"department","dimension":"department_name"}], "count":"enrolment"
    }"#).unwrap!());
    let sq = sqlite::build_query(ast).sql;
    let pg = postgres::build_query(ast).sql;
    if string::contains(sq, "LEFT JOIN degree_programs AS program ON program.department_id = department.department_id")
        && string::contains(sq, "LEFT JOIN student_enrolment AS enrolment ON enrolment.degree_program_id = program.degree_program_id")
        && string::contains(sq, "count(enrolment.student_enrolment_id)")
        && string::contains(sq, "GROUP BY department.department_name")
        && string::contains(pg, "LEFT JOIN \"degree_programs\" AS \"program\"")
        && string::contains(pg, "LEFT JOIN \"student_enrolment\" AS \"enrolment\"") {
        True
    } else { fail!("department enrolment count lost a declared role or empty group", sq, pg) }
});

pub def sibling_enrolments_cannot_multiply_department_count: test::Test = test::should_fail_with(fn() {
    let lower = query_intent_ast_factory(payload, "public");
    lower(json::parse(r#"{
        "op":"graph", "root":"department",
        "nodes":[{"id":"department","entity":"department"},
                 {"id":"program","entity":"degree_program"},
                 {"id":"enrolment","entity":"student_enrolment"},
                 {"id":"sibling","entity":"student_enrolment"}],
        "edges":[{"relation":"degree_program_department","from":"program","to":"department"},
                 {"relation":"enrolment_program","from":"enrolment","to":"program"},
                 {"relation":"enrolment_program","from":"sibling","to":"program"}],
        "select":[{"node":"department","dimension":"department_name"}], "count":"enrolment"
    }"#).unwrap!())
}, "relation enrolment_program between sibling and program may multiply enrolment; if this edge only filters rows, use correlated EXISTS");
