use ontology::registry as registry;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
type ResourceId = struct(
    String
);
use ontology::quantity::{EffectiveCount};
# packetLoss 的单位／尺度没有在旧公开契约中确认。
type ReportedPacketLoss = struct(
    Float
);
# jitter 的单位／尺度没有在旧公开契约中确认。
type ReportedJitter = struct(
    Float
);
# delay 的单位／尺度没有在旧公开契约中确认。
type ReportedDelay = struct(
    Float
);
# lqm 的单位／尺度没有在旧公开契约中确认。
type ReportedLqm = struct(
    Float
);
@registry::dataset(
    "source_NetworkCellLinkQualityKPI",
    "NetworkCellLinkQualityKPI",
    ["source_resId"]
)
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkCellLinkQualityKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_NetworkCellLinkQualityKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkCellLinkQualityKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_NetworkCellLinkQualityKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkCellLinkQualityKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_NetworkCellLinkQualityKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkCellLinkQualityKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_NetworkCellLinkQualityKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__packetLoss",
                ReportedPacketLoss.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkCellLinkQualityKPI.type,
                    ReportedPacketLoss.type,
                    "source_packetLoss"
                )
            ),
            "source_NetworkCellLinkQualityKPI__packetLoss",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__jitter",
                ReportedJitter.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkCellLinkQualityKPI.type, ReportedJitter.type, "source_jitter")),
            "source_NetworkCellLinkQualityKPI__jitter",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__delay",
                ReportedDelay.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkCellLinkQualityKPI.type, ReportedDelay.type, "source_delay")),
            "source_NetworkCellLinkQualityKPI__delay",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__lqm",
                ReportedLqm.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkCellLinkQualityKPI.type, ReportedLqm.type, "source_lqm")),
            "source_NetworkCellLinkQualityKPI__lqm",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__packetLossEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkCellLinkQualityKPI.type,
                    EffectiveCount.type,
                    "source_packetLossEffcnt"
                )
            ),
            "source_NetworkCellLinkQualityKPI__packetLossEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__jitterEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(NetworkCellLinkQualityKPI.type, EffectiveCount.type, "source_jitterEffcnt")
            ),
            "source_NetworkCellLinkQualityKPI__jitterEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__delayEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(NetworkCellLinkQualityKPI.type, EffectiveCount.type, "source_delayEffcnt")
            ),
            "source_NetworkCellLinkQualityKPI__delayEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkQualityKPI__lqmEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(NetworkCellLinkQualityKPI.type, EffectiveCount.type, "source_lqmEffcnt")
            ),
            "source_NetworkCellLinkQualityKPI__lqmEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
type NetworkCellLinkQualityKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkCellLinkQualityKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkCellLinkQualityKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("projectId")
    @g::exact("source_NetworkCellLinkQualityKPI__projectId")
    source_projectId: String,
    @m::column("srcSiteId")
    @g::exact("source_NetworkCellLinkQualityKPI__srcSiteId")
    source_srcSiteId: String,
    @m::column("destSiteId")
    @g::exact("source_NetworkCellLinkQualityKPI__destSiteId")
    source_destSiteId: String,
    @m::column("sourceWanlinkId")
    @g::exact("source_NetworkCellLinkQualityKPI__sourceWanlinkId")
    source_sourceWanlinkId: String,
    @m::column("destWanlinkId")
    @g::exact("source_NetworkCellLinkQualityKPI__destWanlinkId")
    source_destWanlinkId: String,
    @m::column("packetLoss")
    source_packetLoss: ReportedPacketLoss,
    @m::column("jitter")
    source_jitter: ReportedJitter,
    @m::column("delay")
    source_delay: ReportedDelay,
    @m::column("lqm")
    source_lqm: ReportedLqm,
    @m::column("packetLossEffcnt")
    source_packetLossEffcnt: EffectiveCount,
    @m::column("jitterEffcnt")
    source_jitterEffcnt: EffectiveCount,
    @m::column("delayEffcnt")
    source_delayEffcnt: EffectiveCount,
    @m::column("lqmEffcnt")
    source_lqmEffcnt: EffectiveCount,
};
def dataset: m::Dataset(NetworkCellLinkQualityKPI) = registry::dataset_of(
    NetworkCellLinkQualityKPI.type
);

pub use self::{NetworkCellLinkQualityKPI};
