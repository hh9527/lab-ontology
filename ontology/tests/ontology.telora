@edsl::entity_source("dense_leaf_6", "l6")
@edsl::relation(DenseHub.type, safe_kind, 0, 0)
@edsl::relation(DenseL1.type, fanout_kind, 0, 0)
type DenseL6 = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

def dense_entity_types: Array(Type) = [DenseHub.type, DenseL1.type, DenseL2.type, DenseL3.type, DenseL4.type, DenseL5.type, DenseL6.type];

def dense_authorize: Fn(String) -> Bool = fn(subject) { True };

def check_dense_relation_prepare_bounded: Fn() -> Bool = fn() {
    let dense: edsl::PreparedPayload = edsl::build_root("dense-v1", dense_entity_types, knowledge::profile, dense_authorize);
    check(array::length(dense.entities) == 7, "dense graph: hub/leaf entities prepare within the evaluation budget")
        && check(array::length(dense.paths) == 7 && array::all(dense.paths, fn(row) { array::length(row) == 7 }),
            "dense graph: per-source bounded path rows stay complete and deterministic")
};

# ---------------------------------------------------------------------------
# Spider evaluation feedback: query shapes to review (generic, domain-neutral).
#
# 1. Projection and ordering are two different constraints: a measureless list
#    may order by an authorized dimension that is not projected.
# 2. Result-set distinct dimension rows (SELECT DISTINCT) across multi-dimension,
#    filter, ordering and limit boundaries.
# 3. Subjects with NO matching related row lower to a closed NOT EXISTS (NULL
#    semantics stay SQL-native).
# 4. Subjects having separate related rows satisfying A and B are two correlated
#    EXISTS predicates, never a same-row `A AND B`.
# 5. Cross-relation dimension projection without a measure keeps the row shape
#    (no fictional COUNT, no GROUP BY).
# 6. Output column order is the public contract: requested measures first (in
#    request order), then requested dimensions (in request order).
# ---------------------------------------------------------------------------

def row_order_unprojected_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "OrderRegion", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [{ target: edsl::OrderTarget::Dimension("CustomerTier"), direction: edsl::OrderDirection::Asc }],
    limit: Some(5),
    offset: None,
    partition: None,
};

def check_row_order_unprojected_dimension: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower(knowledge::payload, row_order_unprojected_request);
    let proj_only_region = array::length(plan.projection) == 1
        && (match get_index(plan.projection, 0) { qb::SelectItem::Expr(e) => is_column(e, "o", "region"), _ => False });
    let order_ok = array::length(plan.ordering) == 1
        && (match get_index(plan.ordering, 0).key { qb::OrderKey::Expr(e) => is_column(e, "c", "tier"), _ => False })
        && (match get_index(plan.ordering, 0).direction { qb::Ordering::Asc => True, qb::Ordering::Desc => False });
    let join_ok = array::length(plan.joins) == 1
        && get_index(plan.joins, 0).source.alias == "c"
        && get_index(plan.joins, 0).source.table == "customers";
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::Int(5)];
    check(proj_only_region, "row order: only the requested dimension is projected (C not forced into the output)")
        && check(order_ok, "row order: ordering references the authorized, unprojected dimension")
        && check(join_ok, "row order: the ordering dimension's entity is reached through a safe path")
        && check(query.sql == "SELECT o.region FROM orders AS o INNER JOIN customers AS c ON o.customer_id = c.id ORDER BY c.tier ASC LIMIT ?"
            && query.bindings == expected, "row order: ordering by an unprojected dimension keeps deterministic SQL and bindings")
};

def distinct_rows_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [
        { id: "OrderRegion", subject: "analyst", input: edsl::DimensionInput::None },
        { id: "CustomerTier", subject: "analyst", input: edsl::DimensionInput::None },
    ],
    filters: [],
    ordering: [{ target: edsl::OrderTarget::Dimension("OrderRegion"), direction: edsl::OrderDirection::Asc }],
    limit: None,
    offset: None,
    partition: None,
};

def distinct_json_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [
        { id: "DeviceChannel", subject: "analyst", input: edsl::DimensionInput::None },
        { id: "DeviceOwner", subject: "analyst", input: edsl::DimensionInput::None },
    ],
    filters: [{ id: "DeviceChannel", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("api") }],
    ordering: [{ target: edsl::OrderTarget::Dimension("DeviceChannel"), direction: edsl::OrderDirection::Asc }],
    limit: Some(20),
    offset: None,
    partition: None,
};

def check_distinct_rows: Fn() -> Bool = fn() {
    let q1: qb::Query = edsl::lower_distinct(knowledge::payload, distinct_rows_request);
    let expected_sql1 = "SELECT DISTINCT o.region, c.tier FROM orders AS o INNER JOIN customers AS c ON o.customer_id = c.id ORDER BY o.region ASC";
    let q2: qb::Query = edsl::lower_distinct(knowledge::payload, distinct_json_request);
    let expected_b: Array(qb::Val) = [qb::Val::String("$.channel"), qb::Val::String("$.channel"), qb::Val::String("api"), qb::Val::String("$.channel"), qb::Val::Int(20)];
    check(q1.sql == expected_sql1 && array::length(q1.bindings) == 0,
        "distinct rows: mutually distinct multi-dimension rows with deterministic SQL and no bindings")
        && check(string::contains(q2.sql, "SELECT DISTINCT json_extract(d.attributes_json, ?), d.owner"),
            "distinct rows: distinct applies across dimensions/filter/order/limit")
        && check(string::contains(q2.sql, "WHERE json_extract(d.attributes_json, ?) = ?")
            && q2.bindings == expected_b, "distinct rows: filter and limit stay parameterized in placeholder order")
};

def component_count_request: edsl::QueryRequest = {
    measures: [{ id: "ComponentCount", subject: "analyst", input: edsl::MeasureInput::All }],
    dimensions: [],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def no_alarm_spec: edsl::ExistsRequest = {
    target: "alarms",
    subject: "analyst",
    filters: [],
    any_of: [],
    min_matches: None,
};

def check_absence_not_exists: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_absence(knowledge::payload, component_count_request, [no_alarm_spec], []);
    let negated = array::length(plan.exists) == 1 && get_index(plan.exists, 0).negated;
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(m.id) AS ComponentCount FROM components AS m INNER JOIN sites AS s ON m.site_id = s.id WHERE NOT EXISTS (SELECT 1 FROM alarms AS al WHERE s.id = al.site_id)";
    check(negated, "absence: the correlated body is lowered in its negated structural form")
        && check(query.sql == expected_sql, "absence: zero-match subjects lower to a single NOT EXISTS with the owner join")
        && check(!string::contains(query.sql, "WHERE EXISTS"), "absence: no positive existence form is emitted")
};

def alarm_a_spec: edsl::ExistsRequest = {
    target: "alarms",
    subject: "analyst",
    filters: [{ id: "AlarmLevel", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Int(1) }],
    any_of: [],
    min_matches: None,
};

def alarm_b_spec: edsl::ExistsRequest = {
    target: "alarms",
    subject: "analyst",
    filters: [{ id: "AlarmLevel", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Int(3) }],
    any_of: [],
    min_matches: None,
};

def check_separate_exists_rows: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_full(knowledge::payload, component_count_request, [alarm_a_spec, alarm_b_spec], []);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::Int(1), qb::Val::Int(3)];
    let two_subqueries = string::contains(query.sql,
        "al.level = ?) AND EXISTS (SELECT 1 FROM alarms AS al WHERE s.id = al.site_id AND al.level = ?)");
    check(array::length(plan.exists) == 2, "separate exists: A and B lower to two correlated EXISTS predicates")
        && check(two_subqueries, "separate exists: A and B are two independent subqueries (may be satisfied by different rows)")
        && check(query.bindings == expected, "separate exists: bindings keep request order")
};

def cross_relation_list_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [
        { id: "OrderRegion", subject: "analyst", input: edsl::DimensionInput::None },
        { id: "CustomerTier", subject: "analyst", input: edsl::DimensionInput::None },
    ],
    filters: [{ id: "OrderRegion", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("east") }],
    ordering: [{ target: edsl::OrderTarget::Dimension("OrderRegion"), direction: edsl::OrderDirection::Asc }],
    limit: Some(25),
    offset: None,
    partition: None,
};

def check_cross_relation_measureless_shape: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower(knowledge::payload, cross_relation_list_request);
    let only_exprs = array::all(plan.projection, fn(i) { is_expr_item(i) });
    let no_group = array::length(plan.grouping) == 0;
    let no_count = expr_item_count(plan.projection) == 2;
    let query: qb::Query = qb::transform_sqlite(plan);
    check(only_exprs && no_group && no_count, "cross-relation measureless: no fictional COUNT and no GROUP BY are introduced")
        && check(string::contains(query.sql, "FROM orders AS o INNER JOIN customers AS c"), "cross-relation measureless: dimensions project across a safe join")
};

def check_projection_order_contract: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower(knowledge::payload, main_request);
    let kinds: Array(String) = array::map(plan.projection, fn(item) {
        match item {
            qb::SelectItem::Aggregate(agg) => agg.alias,
            qb::SelectItem::Computed(c) => c.alias,
            qb::SelectItem::Expr(_) => "expr",
            qb::SelectItem::NamedExpr(named) => named.alias,
        }
    });
    let expected: Array(String) = ["OrderAmount", "OrderCount", "expr", "expr", "expr"];
    check(kinds == expected, "output order: requested measures precede requested dimensions, each in request order")
};

# ---------------------------------------------------------------------------
# Spider round 3: internal (non-projected) ordering aggregate.
#
# A grouped dimension listing may ORDER BY an aggregate of the base entity (e.g.
# the record count of each group) and take Top N while RETURNING only the
# dimension (e.g. only the group name).  The ordering aggregate is internal:
# it never appears in the projection.
# ---------------------------------------------------------------------------

def internal_top_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "DeviceOwner", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [{ target: edsl::OrderTarget::Dimension("DeviceOwner"), direction: edsl::OrderDirection::Asc }],
    limit: Some(1),
    offset: None,
    partition: None,
};

def check_internal_top_group: Fn() -> Bool = fn() {
    let internal: Array(edsl::InternalOrderRequest) = [
        { measure: "DeviceCount", subject: "analyst", direction: edsl::OrderDirection::Desc },
    ];
    let plan: qb::Plan = edsl::lower_internal_top(knowledge::payload, internal_top_request, internal);
    let grouped = array::length(plan.grouping) == 1 && is_column(get_expr(plan.grouping, 0), "d", "owner");
    let only_dim_projected = array::length(plan.projection) == 1
        && (match get_index(plan.projection, 0) { qb::SelectItem::Expr(e) => is_column(e, "d", "owner"), _ => False });
    let order_ok = array::length(plan.ordering) == 2
        && (match get_index(plan.ordering, 0).key { qb::OrderKey::Aggregate(_) => True, _ => False })
        && (match get_index(plan.ordering, 0).direction { qb::Ordering::Desc => True, qb::Ordering::Asc => False })
        && (match get_index(plan.ordering, 1).key { qb::OrderKey::Expr(e) => is_column(e, "d", "owner"), _ => False });
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::Int(1)];
    check(grouped, "internal top: the request is grouped by its selected dimension")
        && check(only_dim_projected, "internal top: only the dimension is returned; the aggregate is not projected")
        && check(order_ok, "internal top: ordering is the internal aggregate DESC then the dimension tie-breaker ASC")
        && check(query.sql == "SELECT d.owner FROM devices AS d GROUP BY d.owner ORDER BY count(d.id) DESC, d.owner ASC LIMIT ?"
            && query.bindings == expected, "internal top: SQL returns only the group column ordered by the internal aggregate")
};

# ---------------------------------------------------------------------------
# Spider round 3: existence/filter along relations while returning only subject
# dimensions (no link-count measure is needed to choose the entry/path).
# One-hop existence (either direction, fan-out allowed) and the declared
# two-hop route both keep the subject grain as pure correlated EXISTS/owner-join
# predicates; the projection stays the requested subject dimensions only.
# ---------------------------------------------------------------------------

def customer_tier_existence_list_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "CustomerTier", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def has_order_spec: edsl::ExistsRequest = {
    target: "orders",
    subject: "analyst",
    filters: [],
    any_of: [],
    min_matches: None,
};

def check_measureless_existence_returns_subject_dims: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_full(knowledge::payload, customer_tier_existence_list_request, [has_order_spec], []);
    let only_tier = array::length(plan.projection) == 1
        && (match get_index(plan.projection, 0) { qb::SelectItem::Expr(e) => is_column(e, "c", "tier"), _ => False });
    let query: qb::Query = qb::transform_sqlite(plan);
    check(only_tier, "measureless existence: only the subject dimension is returned (no link-count measure added)")
        && check(array::length(plan.exists) == 1 && array::length(plan.joins) == 0 && array::length(plan.grouping) == 0,
            "measureless existence: the related-record proof is a correlated EXISTS predicate, not a join/count/group")
        && check(query.sql == "SELECT c.tier FROM customers AS c WHERE EXISTS (SELECT 1 FROM orders AS o WHERE c.id = o.customer_id)",
            "measureless existence: existence filter over a direct (reverse, fan-out) relation keeps the subject rows")
};

# ---------------------------------------------------------------------------
# Closed field-to-field predicates (same-subject attribute comparison).
# Domain-neutral synthetic fixture: two text attributes (color/shade), one int
# attribute (score), one unauthorized attribute (secret) on the subject, and a
# separate entity carrying a foreign text attribute.
# ---------------------------------------------------------------------------

def ff_eq_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne];
def ff_text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def ff_int_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];
def flag_false: Bool = False;

@edsl::entity_id("ff_subjects")
@edsl::entity_source("ff_subjects", "fs")
type FfSubject = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("color")
    @edsl::dimension("FfColor", flag_true, flag_true, ff_eq_ops, ff_text_kinds)
    color: String,
    @edsl::column("shade")
    @edsl::dimension("FfShade", flag_true, flag_true, ff_eq_ops, ff_text_kinds)
    shade: String,
    @edsl::column("score")
    @edsl::dimension("FfScore", flag_true, flag_true, ff_eq_ops, ff_int_kinds)
    score: Int,
    @edsl::column("secret")
    @edsl::dimension("FfSecret", flag_false, flag_false, ff_eq_ops, ff_text_kinds)
    secret: String,
};

@edsl::entity_id("ff_others")
@edsl::entity_source("ff_others", "fo")
type FfOtherEntity = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("tag")
    @edsl::dimension("FfTag", flag_true, flag_true, ff_eq_ops, ff_text_kinds)
    tag: String,
};

def ff_entity_types: Array(Type) = [FfSubject.type, FfOtherEntity.type];

def ff_authorize: Fn(String) -> Bool = fn(subject) { True };

def ff_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("ff-v1", ff_entity_types, knowledge::profile, ff_authorize)
};

def ff_list_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "FfColor", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def ff_subject_index: Fn() -> Int = fn() {
    match array::find(ff_payload().entities, fn(e) { e.id == "ff_subjects" }) {
        Some(e) => e.index,
        None => fail!("ff_subjects entity missing"),
    }
};

def check_field_to_field_success: Fn() -> Bool = fn() {
    let ff: edsl::FieldFilterRequest = {
        subject: "analyst",
        op: edsl::FilterOp::Eq,
        left: "FfColor",
        right: "FfShade",
    };
    let plan: qb::Plan = edsl::lower_field_filtered(ff_payload(), ff_list_request, [ff]);
    let query: qb::Query = qb::transform_sqlite(plan);
    check(string::contains(query.sql, "WHERE fs.color = fs.shade"),
        "field-to-field: comparing two subject attributes lowers to two column references")
        && check(array::length(query.bindings) == 0, "field-to-field: no dynamic binding is produced")
        && check(array::length(plan.projection) == 1, "field-to-field: hidden comparison never adds a projection column")
};

def check_field_to_field_combination_and_determinism: Fn() -> Bool = fn() {
    let combined_request: edsl::QueryRequest = {
        measures: [],
        dimensions: [{ id: "FfColor", subject: "analyst", input: edsl::DimensionInput::None }],
        filters: [{ id: "FfColor", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("red") }],
        ordering: [],
        limit: None,
        offset: None,
        partition: None,
    };
    let ff: edsl::FieldFilterRequest = {
        subject: "analyst",
        op: edsl::FilterOp::Ne,
        left: "FfColor",
        right: "FfShade",
    };
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_field_filtered(ff_payload(), combined_request, [ff]));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_field_filtered(ff_payload(), combined_request, [ff]));
    let expected: Array(qb::Val) = [qb::Val::String("red")];
    check(string::contains(q1.sql, "WHERE (fs.color = ? AND fs.color != fs.shade)"),
        "field-to-field: combined with an ordinary scalar filter keeps deterministic predicate order")
        && check(q1.bindings == expected, "field-to-field: scalar filter bindings are unchanged; no field-to-field bindings")
        && check(q1.sql == q2.sql && q1.bindings == q2.bindings,
            "field-to-field: repeated lowering is byte-identical")
};

def check_field_to_field_rejections: Fn() -> Bool = fn() {
    let subject = ff_subject_index();
    let unknown: edsl::FieldFilterRequest = { subject: "analyst", op: edsl::FilterOp::Eq, left: "FfColor", right: "NoSuchAttr" };
    let unauthorized: edsl::FieldFilterRequest = { subject: "analyst", op: edsl::FilterOp::Eq, left: "FfColor", right: "FfSecret" };
    let cross_entity: edsl::FieldFilterRequest = { subject: "analyst", op: edsl::FilterOp::Eq, left: "FfColor", right: "FfTag" };
    let type_mismatch: edsl::FieldFilterRequest = { subject: "analyst", op: edsl::FilterOp::Eq, left: "FfColor", right: "FfScore" };
    let illegal_op: edsl::FieldFilterRequest = { subject: "analyst", op: edsl::FilterOp::Contains, left: "FfColor", right: "FfShade" };
    let ok: edsl::FieldFilterRequest = { subject: "analyst", op: edsl::FilterOp::Eq, left: "FfColor", right: "FfShade" };
    check(!edsl::field_filter_ok(ff_payload(), subject, unknown), "field-to-field: unknown attribute is rejected")
        && check(!edsl::field_filter_ok(ff_payload(), subject, unauthorized), "field-to-field: unauthorized attribute is rejected")
        && check(!edsl::field_filter_ok(ff_payload(), subject, cross_entity), "field-to-field: cross-entity attribute reference is rejected")
        && check(!edsl::field_filter_ok(ff_payload(), subject, type_mismatch), "field-to-field: type/domain mismatch is rejected")
        && check(!edsl::field_filter_ok(ff_payload(), subject, illegal_op), "field-to-field: text/illegal operator is rejected")
        && check(edsl::field_filter_ok(ff_payload(), subject, ok), "field-to-field: same-subject compatible Eq is feasible")
};

# ---------------------------------------------------------------------------
# Related-aggregate references (hidden aggregate over a directly-related entity).
# Synthetic domain-neutral fixture: subject -> event (one-to-many) with a count
# measure on the event side; a reverse-declared pair; and an ambiguous pair.
# ---------------------------------------------------------------------------

@edsl::entity_id("rl_subjects")
@edsl::entity_source("rl_subjects", "rs")
@edsl::relation(RlEvent.type, fanout_kind, 0, 1)
type RlSubject = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("region")
    @edsl::dimension("RlRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
};

@edsl::entity_id("rl_events")
@edsl::entity_source("rl_events", "re")
type RlEvent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("RlEventCount", count_agg, no_requires)
    id: Int,
    @edsl::column("subject_id")
    subject_id: Int,
};

# Reverse-declared relation: the child declares the safe link to the subject, so
# subject grouping must join through the prepared reverse direction.
@edsl::entity_id("rl_rev_subjects")
@edsl::entity_source("rl_rev_subjects", "rv")
type RlRevSubject = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("region")
    @edsl::dimension("RlRevRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
};

@edsl::entity_id("rl_rev_events")
@edsl::entity_source("rl_rev_events", "rt")
@edsl::relation(RlRevSubject.type, safe_kind, 1, 0)
type RlRevEvent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("RlRevEventCount", count_agg, no_requires)
    id: Int,
    @edsl::column("subject_id")
    subject_id: Int,
};

# Ambiguous pair: two declared relations between the subject and the event
# entity, so a related-aggregate reference cannot pick a unique path.
@edsl::entity_id("rl_amb")
@edsl::entity_source("rl_amb", "am")
@edsl::relation(RlEvent.type, fanout_kind, 0, 1)
@edsl::relation(RlEvent.type, fanout_kind, 0, 1)
type RlAmbSubject = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("region")
    @edsl::dimension("RlAmbRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
};

def rl_entity_types: Array(Type) = [RlSubject.type, RlEvent.type, RlRevSubject.type, RlRevEvent.type, RlAmbSubject.type];

def rl_authorize: Fn(String) -> Bool = fn(subject) { subject == "analyst" };

def rl_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("rl-v1", rl_entity_types, knowledge::profile, rl_authorize)
};

def rl_subject_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "RlRegion", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [{ target: edsl::OrderTarget::Dimension("RlRegion"), direction: edsl::OrderDirection::Asc }],
    limit: Some(1),
    offset: None,
    partition: None,
};

def rl_subject_entity_index: Fn() -> Int = fn() {
    match array::find(rl_payload().entities, fn(e) { e.id == "rl_subjects" }) {
        Some(e) => e.index,
        None => fail!("rl_subjects entity missing"),
    }
};

def check_related_aggregate_ordering_top_n: Fn() -> Bool = fn() {
    let internal: Array(edsl::InternalOrderRequest) = [
        { measure: "RlEventCount", subject: "analyst", direction: edsl::OrderDirection::Desc },
    ];
    let plan: qb::Plan = edsl::lower_internal_related(rl_payload(), rl_subject_request, internal, []);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::Int(1)];
    let expected_sql = "SELECT rs.region FROM rl_subjects AS rs INNER JOIN rl_events AS re ON rs.id = re.subject_id GROUP BY rs.region ORDER BY count(re.id) DESC, rs.region ASC LIMIT ?";
    check(array::length(plan.projection) == 1 && array::length(plan.grouping) == 1,
        "related aggregate: projection and grouping stay on the subject dimension")
        && check(query.sql == expected_sql, "related aggregate: hidden related-count ordering with Top-N")
        && check(query.bindings == expected, "related aggregate: hidden ordering adds no binding; Top-N limit binds once")
};

def check_related_aggregate_having: Fn() -> Bool = fn() {
    let having_req: edsl::QueryRequest = {
        measures: [],
        dimensions: [{ id: "RlRegion", subject: "analyst", input: edsl::DimensionInput::None }],
        filters: [],
        ordering: [],
        limit: None,
        offset: None,
        partition: None,
    };
    let having: Array(edsl::InternalHavingRequest) = [
        { measure: "RlEventCount", subject: "analyst", op: edsl::HavingOp::Ge, threshold: edsl::FilterInput::Int(2) },
    ];
    let plan: qb::Plan = edsl::lower_internal_related(rl_payload(), having_req, [], having);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::Int(2)];
    let expected_sql = "SELECT rs.region FROM rl_subjects AS rs INNER JOIN rl_events AS re ON rs.id = re.subject_id GROUP BY rs.region HAVING count(re.id) >= ?";
    check(query.sql == expected_sql, "related aggregate: hidden related-count HAVING with a typed threshold")
        && check(query.bindings == expected, "related aggregate: HAVING threshold is the single ordered binding")
};

def check_related_aggregate_reverse_relation: Fn() -> Bool = fn() {
    let request: edsl::QueryRequest = {
        measures: [],
        dimensions: [{ id: "RlRevRegion", subject: "analyst", input: edsl::DimensionInput::None }],
        filters: [],
        ordering: [],
        limit: None,
        offset: None,
        partition: None,
    };
    let internal: Array(edsl::InternalOrderRequest) = [
        { measure: "RlRevEventCount", subject: "analyst", direction: edsl::OrderDirection::Desc },
    ];
    let plan: qb::Plan = edsl::lower_internal_related(rl_payload(), request, internal, []);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT rv.region FROM rl_rev_subjects AS rv INNER JOIN rl_rev_events AS rt ON rv.id = rt.subject_id GROUP BY rv.region ORDER BY count(rt.id) DESC";
    check(query.sql == expected_sql, "related aggregate: reverse-declared relation joins through the prepared direction")
};

def check_related_aggregate_deterministic_and_rejections: Fn() -> Bool = fn() {
    let internal: Array(edsl::InternalOrderRequest) = [
        { measure: "RlEventCount", subject: "analyst", direction: edsl::OrderDirection::Desc },
    ];
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_internal_related(rl_payload(), rl_subject_request, internal, []));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_internal_related(rl_payload(), rl_subject_request, internal, []));
    let subject = rl_subject_entity_index();
    let rev_subject = entity_id_index(rl_payload().entities, "rl_rev_subjects");
    let amb_subject = entity_id_index(rl_payload().entities, "rl_amb");
    check(q1.sql == q2.sql && q1.bindings == q2.bindings, "related aggregate: repeated lowering is byte-identical")
        && check(edsl::related_measure_ok(rl_payload(), subject, "analyst", "RlEventCount"), "related aggregate probe: forward measure is feasible")
        && check(edsl::related_measure_ok(rl_payload(), rev_subject, "analyst", "RlRevEventCount"), "related aggregate probe: reverse-declared measure is feasible")
        && check(!edsl::related_measure_ok(rl_payload(), subject, "outsider", "RlEventCount"), "related aggregate probe: unauthorized subject role is rejected")
        && check(!edsl::related_measure_ok(rl_payload(), subject, "analyst", "MissingMeasure"), "related aggregate probe: unknown measure is rejected")
        && check(!edsl::related_measure_ok(rl_payload(), rev_subject, "analyst", "RlEventCount"), "related aggregate probe: no declared relation is rejected")
        && check(!edsl::related_measure_ok(rl_payload(), amb_subject, "analyst", "RlEventCount"), "related aggregate probe: ambiguous relation is rejected")
};

# ---------------------------------------------------------------------------
# Related-aggregate over a unique bounded declared route (ontology feedback).
#
# RmSubject -> RmIntermediate -> RmEvent: the hidden aggregate population is
# reached through exactly one eligible route of TWO declared relations (the
# intermediate hop is declared on RmSubject, the event hop on RmIntermediate),
# while grouping stays exactly on the subject dimension RmRegion.  A fan-out
# direction is allowed inside the route; the aggregate measure stays hidden.
# The same route serves hidden ORDER BY/Top-N and hidden HAVING.
#
# Route probes cover a shorter direct route alongside a longer detour, a unique
# three-hop route, a missing subject and unauthorized/unknown roles.
# ---------------------------------------------------------------------------

@edsl::entity_id("rm_subjects")
@edsl::entity_source("rm_subjects", "rms")
@edsl::relation(RmIntermediate.type, safe_kind, 1, 0)
type RmSubject = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("intermediate_id")
    intermediate_id: Int,
    @edsl::column("region")
    @edsl::dimension("RmRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
};

@edsl::entity_id("rm_intermediates")
@edsl::entity_source("rm_intermediates", "rmi")
@edsl::relation(RmEvent.type, fanout_kind, 0, 1)
type RmIntermediate = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_id("rm_events")
@edsl::entity_source("rm_events", "rme")
type RmEvent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("RmEventCount", count_agg, no_requires)
    id: Int,
    @edsl::column("intermediate_id")
    intermediate_id: Int,
};

# A direct relation and a longer two-hop detour both exist. The unique shortest
# route is selected; the detour must not manufacture ambiguity.
@edsl::entity_id("rm_amb_subjects")
@edsl::entity_source("rm_amb_subjects", "rmas")
@edsl::relation(RmEvent.type, safe_kind, 0, 0)
@edsl::relation(RmIntermediate.type, safe_kind, 2, 0)
type RmAmbSubject = struct {
    @edsl::column("event_id")
    event_id: Int,
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("intermediate_id")
    intermediate_id: Int,
    @edsl::column("region")
    @edsl::dimension("RmAmbRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
};

# Deep unique route: the event population is reached through three relations
# (deep_mid -> intermediate -> event), exercising the shared bounded path cap.
@edsl::entity_id("rm_deep_subjects")
@edsl::entity_source("rm_deep_subjects", "rmds")
@edsl::relation(RmDeepMid.type, safe_kind, 0, 0)
type RmDeepSubject = struct {
    @edsl::column("deep_mid_id")
    deep_mid_id: Int,
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("region")
    @edsl::dimension("RmDeepRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
};

@edsl::entity_id("rm_deep_mids")
@edsl::entity_source("rm_deep_mids", "rmdm")
@edsl::relation(RmIntermediate.type, safe_kind, 1, 0)
type RmDeepMid = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("intermediate_id")
    intermediate_id: Int,
};

# Missing: no declared route from this subject to any aggregate population.
@edsl::entity_id("rm_missing_subjects")
@edsl::entity_source("rm_missing_subjects", "rmms")
type RmMissingSubject = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("region")
    @edsl::dimension("RmMissingRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
};

def rm_entity_types: Array(Type) = [
    RmSubject.type, RmIntermediate.type, RmEvent.type,
    RmAmbSubject.type, RmDeepSubject.type, RmDeepMid.type, RmMissingSubject.type,
];

def rm_authorize: Fn(String) -> Bool = fn(subject) { subject == "analyst" };

def rm_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("rm-v1", rm_entity_types, knowledge::profile, rm_authorize)
};

def rm_subject_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "RmRegion", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [{ target: edsl::OrderTarget::Dimension("RmRegion"), direction: edsl::OrderDirection::Asc }],
    limit: Some(1),
    offset: None,
    partition: None,
};

def check_related_two_hop_ordering_top_n: Fn() -> Bool = fn() {
    # Hidden count ordering over the two-hop population with Top-N: exact SQL,
    # both route joins, subject-only grouping and projection, and the measure
    # never appears in the projection.
    let internal: Array(edsl::InternalOrderRequest) = [
        { measure: "RmEventCount", subject: "analyst", direction: edsl::OrderDirection::Desc },
    ];
    let plan: qb::Plan = edsl::lower_internal_related(rm_payload(), rm_subject_request, internal, []);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT rms.region FROM rm_subjects AS rms INNER JOIN rm_intermediates AS rmi ON rms.intermediate_id = rmi.id INNER JOIN rm_events AS rme ON rmi.id = rme.intermediate_id GROUP BY rms.region ORDER BY count(rme.id) DESC, rms.region ASC LIMIT ?";
    let expected: Array(qb::Val) = [qb::Val::Int(1)];
    let join_count = array::length(plan.joins) == 2;
    let only_region_projected = array::length(plan.projection) == 1
        && (match get_index(plan.projection, 0) { qb::SelectItem::Expr(e) => is_column(e, "rms", "region"), _ => False });
    let grouped_by_region = array::length(plan.grouping) == 1
        && is_column(get_expr(plan.grouping, 0), "rms", "region");
    check(query.sql == expected_sql, "related two-hop: hidden count ordering over the two-hop route with Top-N renders exact SQL")
        && check(query.bindings == expected, "related two-hop: the Top-N limit binds once")
        && check(join_count, "related two-hop: exactly the two route joins are materialized")
        && check(only_region_projected, "related two-hop: the projection is only the subject grouping dimension")
        && check(grouped_by_region, "related two-hop: grouping stays exactly on the subject dimension")
};

def check_related_two_hop_having: Fn() -> Bool = fn() {
    # Hidden aggregate HAVING over the SAME two-hop route: exact SQL, joins and
    # the typed threshold binding; the hidden measure is not projected.
    let request: edsl::QueryRequest = {
        measures: [],
        dimensions: [{ id: "RmRegion", subject: "analyst", input: edsl::DimensionInput::None }],
        filters: [],
        ordering: [],
        limit: None,
        offset: None,
        partition: None,
    };
    let having: Array(edsl::InternalHavingRequest) = [
        { measure: "RmEventCount", subject: "analyst", op: edsl::HavingOp::Ge, threshold: edsl::FilterInput::Int(2) },
    ];
    let plan: qb::Plan = edsl::lower_internal_related(rm_payload(), request, [], having);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT rms.region FROM rm_subjects AS rms INNER JOIN rm_intermediates AS rmi ON rms.intermediate_id = rmi.id INNER JOIN rm_events AS rme ON rmi.id = rme.intermediate_id GROUP BY rms.region HAVING count(rme.id) >= ?";
    let expected: Array(qb::Val) = [qb::Val::Int(2)];
    let hidden_not_projected = !array::any(plan.projection, fn(item) {
        match item {
            qb::SelectItem::Aggregate(agg) => agg.alias == "RmEventCount",
            qb::SelectItem::Computed(c) => c.alias == "RmEventCount",
            qb::SelectItem::NamedExpr(_) => False,
            qb::SelectItem::Expr(_) => False,
        }
    });
    check(query.sql == expected_sql, "related two-hop: hidden aggregate HAVING over the same two-hop route renders exact SQL")
        && check(query.bindings == expected, "related two-hop: the HAVING threshold is the single ordered binding")
        && check(hidden_not_projected, "related two-hop: the hidden measure never appears in the projection")
};

def check_related_two_hop_determinism: Fn() -> Bool = fn() {
    let internal: Array(edsl::InternalOrderRequest) = [
        { measure: "RmEventCount", subject: "analyst", direction: edsl::OrderDirection::Desc },
    ];
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_internal_related(rm_payload(), rm_subject_request, internal, []));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_internal_related(rm_payload(), rm_subject_request, internal, []));
    check(q1.sql == q2.sql && q1.bindings == q2.bindings,
        "related two-hop: repeated lowering is byte-identical")
};

def check_related_two_hop_rejection_probes: Fn() -> Bool = fn() {
    let p = rm_payload();
    let subject = entity_id_index(p.entities, "rm_subjects");
    let amb = entity_id_index(p.entities, "rm_amb_subjects");
    let deep = entity_id_index(p.entities, "rm_deep_subjects");
    let events = entity_id_index(p.entities, "rm_events");
    let missing = entity_id_index(p.entities, "rm_missing_subjects");
    let deep_path_len = match get_index(get_index(p.paths, deep), events) {
        edsl::PathResult::Safe(seq) => array::length(seq),
        edsl::PathResult::FanOut(seq) => array::length(seq),
        _ => 0,
    };
    let deep_request: edsl::QueryRequest = {
        measures: [],
        dimensions: [{ id: "RmDeepRegion", subject: "analyst", input: edsl::DimensionInput::None }],
        filters: [],
        ordering: [],
        limit: None,
        offset: None,
        partition: None,
    };
    let deep_order: Array(edsl::InternalOrderRequest) = [
        { measure: "RmEventCount", subject: "analyst", direction: edsl::OrderDirection::Desc },
    ];
    let deep_query = qb::transform_sqlite(edsl::lower_internal_related(p, deep_request, deep_order, []));
    let deep_sql = "SELECT rmds.region FROM rm_deep_subjects AS rmds INNER JOIN rm_deep_mids AS rmdm ON rmds.deep_mid_id = rmdm.id INNER JOIN rm_intermediates AS rmi ON rmdm.intermediate_id = rmi.id INNER JOIN rm_events AS rme ON rmi.id = rme.intermediate_id GROUP BY rmds.region ORDER BY count(rme.id) DESC";
    check(edsl::related_measure_ok(p, subject, "analyst", "RmEventCount"), "related two-hop probe: a unique two-hop route is feasible")
        && check(edsl::related_measure_ok(p, amb, "analyst", "RmEventCount"), "related bounded-route probe: a direct route wins over a longer detour")
        && check(edsl::related_measure_ok(p, deep, "analyst", "RmEventCount"), "related bounded-route probe: a unique three-hop route is feasible")
        && check(deep_query.sql == deep_sql && deep_query.bindings == [], "related bounded-route probe: three-hop hidden ordering renders exact SQL")
        && check(!edsl::related_measure_ok(p, missing, "analyst", "RmEventCount"), "related two-hop probe: a missing route is rejected")
        && check(!edsl::related_measure_ok(p, subject, "outsider", "RmEventCount"), "related two-hop probe: an unauthorized role is rejected")
        && check(!edsl::related_measure_ok(p, subject, "analyst", "MissingMeasure"), "related two-hop probe: an unknown measure is rejected")
        && check(deep_path_len == 3, "related bounded-route probe: the prepared route contains three relations")
};

# ---------------------------------------------------------------------------
# Closed set operations (INTERSECT / EXCEPT / distinct UNION) over two lowered
# ontology requests with compatible projections (synthetic/domain-neutral).
# ---------------------------------------------------------------------------

def set_region_east: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "OrderRegion", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [{ id: "OrderRegion", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("east") }],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def set_region_north: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "OrderRegion", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [{ id: "OrderRegion", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("north") }],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def check_set_intersect_direct: Fn() -> Bool = fn() {
    let q: qb::Query = edsl::lower_set(qb::SetOpKind::Intersect, knowledge::payload, set_region_east, set_region_north);
    let expected: Array(qb::Val) = [qb::Val::String("east"), qb::Val::String("north")];
    let expected_sql = "SELECT o.region FROM orders AS o WHERE o.region = ? INTERSECT SELECT o.region FROM orders AS o WHERE o.region = ?";
    check(q.sql == expected_sql, "set ops: direct INTERSECT keeps both operand queries as bare executable compound terms")
        && check(q.bindings == expected, "set ops: bindings concatenate left-to-right operand order")
        && check(!string::contains(q.sql, ") INTERSECT ("), "set ops: no SQLite-rejected top-level operand parentheses")
};

def check_set_union_and_except_keywords: Fn() -> Bool = fn() {
    let union_q: qb::Query = edsl::lower_set(qb::SetOpKind::Union, knowledge::payload, set_region_east, set_region_north);
    let except_q: qb::Query = edsl::lower_set(qb::SetOpKind::Except, knowledge::payload, set_region_east, set_region_north);
    check(string::contains(union_q.sql, " UNION "), "set ops: distinct UNION uses the set-union keyword between bare operands")
        && check(string::contains(except_q.sql, " EXCEPT "), "set ops: EXCEPT lowers to the set keyword")
        && check(!string::contains(union_q.sql, "UNION ALL"), "set ops: distinct UNION is not UNION ALL")
        && check(!string::contains(union_q.sql, ") UNION (") && !string::contains(except_q.sql, ") EXCEPT ("),
            "set ops: operands are never wrapped in the SQLite-rejected parenthesized form")
};

def check_set_outer_count: Fn() -> Bool = fn() {
    let q: qb::Query = edsl::lower_set_count(qb::SetOpKind::Intersect, knowledge::payload, set_region_east, set_region_north);
    let expected: Array(qb::Val) = [qb::Val::String("east"), qb::Val::String("north")];
    check(string::contains(q.sql, "SELECT count(1) FROM (SELECT o.region FROM orders AS o WHERE o.region = ? INTERSECT SELECT o.region FROM orders AS o WHERE o.region = ?) AS __q_set"),
        "set ops: outer count wraps the executable compound select once as a derived table")
        && check(q.bindings == expected, "set ops: outer count keeps operand bindings in order")
};

def check_set_deterministic: Fn() -> Bool = fn() {
    let q1: qb::Query = edsl::lower_set(qb::SetOpKind::Intersect, knowledge::payload, set_region_east, set_region_north);
    let q2: qb::Query = edsl::lower_set(qb::SetOpKind::Intersect, knowledge::payload, set_region_east, set_region_north);
    let c1: qb::Query = edsl::lower_set_count(qb::SetOpKind::Union, knowledge::payload, set_region_east, set_region_north);
    let c2: qb::Query = edsl::lower_set_count(qb::SetOpKind::Union, knowledge::payload, set_region_east, set_region_north);
    q1.sql == q2.sql && q1.bindings == q2.bindings
        && c1.sql == c2.sql && c1.bindings == c2.bindings
};

# ---------------------------------------------------------------------------
# Hidden same-source aggregate HAVING.
# ---------------------------------------------------------------------------

def hidden_having_request: edsl::QueryRequest = {
    measures: [{ id: "OrderAmount", subject: "analyst", input: edsl::MeasureInput::All }],
    dimensions: [{ id: "OrderRegion", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def check_hidden_having_same_source: Fn() -> Bool = fn() {
    let hidden: Array(edsl::InternalHavingRequest) = [
        { measure: "OrderCount", subject: "analyst", op: edsl::HavingOp::Ge, threshold: edsl::FilterInput::Int(2) },
    ];
    let plan: qb::Plan = edsl::lower_hidden_having(knowledge::payload, hidden_having_request, hidden);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::Int(2)];
    let hidden_not_projected = !array::any(plan.projection, fn(item) {
        match item {
            qb::SelectItem::Aggregate(agg) => agg.alias == "OrderCount",
            qb::SelectItem::Computed(c) => c.alias == "OrderCount",
            qb::SelectItem::NamedExpr(_) => False,
            qb::SelectItem::Expr(_) => False,
        }
    });
    check(hidden_not_projected, "hidden having: the hidden measure never appears in the projection")
        && check(string::contains(query.sql, "GROUP BY o.region HAVING count(o.order_id) >= ?"),
            "hidden having: hidden same-source aggregate HAVING lowers over the grouped request")
        && check(query.bindings == expected, "hidden having: threshold enters ordered bindings")
};

def check_hidden_having_determinism_and_probe: Fn() -> Bool = fn() {
    let hidden: Array(edsl::InternalHavingRequest) = [
        { measure: "OrderCount", subject: "analyst", op: edsl::HavingOp::Gt, threshold: edsl::FilterInput::Int(1) },
    ];
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_hidden_having(knowledge::payload, hidden_having_request, hidden));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_hidden_having(knowledge::payload, hidden_having_request, hidden));
    let orders = entity_id_index(knowledge::payload.entities, "orders");
    let customers = entity_id_index(knowledge::payload.entities, "customers");
    check(q1.sql == q2.sql && q1.bindings == q2.bindings, "hidden having: repeated lowering is byte-identical")
        && check(edsl::same_source_having_ok(knowledge::payload, orders, "analyst", "OrderCount"), "hidden having probe: same-source measure is feasible")
        && check(!edsl::same_source_having_ok(knowledge::payload, orders, "outsider", "OrderCount"), "hidden having probe: unauthorized subject is rejected")
        && check(!edsl::same_source_having_ok(knowledge::payload, orders, "analyst", "MissingMeasure"), "hidden having probe: unknown measure is rejected")
        && check(!edsl::same_source_having_ok(knowledge::payload, customers, "analyst", "OrderCount"), "hidden having probe: cross-entity measure is rejected")
};

# ---------------------------------------------------------------------------
# Attribute versus scalar aggregate subquery (ontology phase).
# ---------------------------------------------------------------------------

def attribute_compare_listing_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "OrderRegion", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def check_attribute_vs_scalar_aggregate: Fn() -> Bool = fn() {
    # Numeric outer attribute (OrderId, Int key/plain dimension) vs numeric
    # aggregate result (sum(OrderAmount), Float): the one type-compatible shape
    # the public contract supports as a positive case.
    let orders = entity_id_index(knowledge::payload.entities, "orders");
    let spec: edsl::ScalarCompareRequest = {
        attribute: "OrderId",
        subject: "analyst",
        op: edsl::HavingOp::Gt,
        measure: "OrderAmount",
        scope_filters: [],
    };
    let plan: qb::Plan = edsl::lower_attribute_compare(knowledge::payload, attribute_compare_listing_request, [spec]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [];
    check(array::length(plan.scalar_comparisons) == 1, "attribute compare: exactly one Plan-level comparison predicate")
        && check(array::length(plan.projection) == 1 && expr_item_count(plan.projection) == 1,
            "attribute compare: the outer listing projection keeps the requested dimension only")
        && check(string::contains(query.sql, "SELECT o.region FROM orders AS o WHERE o.order_id > (SELECT sum(o.amount) FROM orders AS o)"),
            "attribute compare: numeric outer attribute is compared to a parenthesized numeric scalar aggregate subquery")
        && check(query.bindings == expected, "attribute compare: no dynamic values enter the comparison")
};

def check_attribute_vs_scalar_aggregate_probe_and_determinism: Fn() -> Bool = fn() {
    let orders = entity_id_index(knowledge::payload.entities, "orders");
    let customers = entity_id_index(knowledge::payload.entities, "customers");
    let spec: edsl::ScalarCompareRequest = {
        attribute: "OrderId",
        subject: "analyst",
        op: edsl::HavingOp::Gt,
        measure: "OrderAmount",
        scope_filters: [],
    };
    let p1: qb::Plan = edsl::lower_attribute_compare(knowledge::payload, attribute_compare_listing_request, [spec]);
    let p2: qb::Plan = edsl::lower_attribute_compare(knowledge::payload, attribute_compare_listing_request, [spec]);
    let q1: qb::Query = qb::transform_sqlite(p1);
    let q2: qb::Query = qb::transform_sqlite(p2);
    check(q1.sql == q2.sql && q1.bindings == q2.bindings, "attribute compare: repeated lowering is byte-identical")
        && check(edsl::attribute_compare_ok(knowledge::payload, orders, "analyst", "OrderId", "OrderAmount"),
            "attribute compare probe: a numeric outer attribute and a numeric aggregate result are feasible")
        && check(edsl::attribute_compare_ok(knowledge::payload, orders, "analyst", "OrderId", "OrderCount"),
            "attribute compare probe: Count's integer result is part of the numeric family")
        && check(!edsl::attribute_compare_ok(knowledge::payload, orders, "outsider", "OrderId", "OrderAmount"),
            "attribute compare probe: an unauthorized role is rejected")
        && check(!edsl::attribute_compare_ok(knowledge::payload, orders, "analyst", "MissingAttribute", "OrderAmount"),
            "attribute compare probe: an unknown attribute is rejected")
        && check(!edsl::attribute_compare_ok(knowledge::payload, customers, "analyst", "OrderRegion", "OrderAmount"),
            "attribute compare probe: an attribute off the base entity is rejected")
        && check(!edsl::attribute_compare_ok(knowledge::payload, orders, "analyst", "OrderRegion", "OrderAmount"),
            "attribute compare probe: text-vs-number (OrderRegion vs sum) is type-incompatible and rejected")
        && check(!edsl::attribute_compare_ok(knowledge::payload, customers, "analyst", "CustomerTier", "CustomerCount"),
            "attribute compare probe: enum-text-vs-number (CustomerTier vs count) is type-incompatible and rejected")
        && check(!edsl::attribute_compare_ok(knowledge::payload, orders, "analyst", "OrderId", "MissingMeasure"),
            "attribute compare probe: an unknown measure is rejected")
};

# ---------------------------------------------------------------------------
# Scoped attribute-versus-scalar-aggregate comparisons (ontology feedback).
#
# `ScalarCompareRequest.scope_filters` narrows the INNER measure's own rows with
# an ordered list of closed `FilterRequest` values resolved against the inner
# measure's entity and vocabulary.  The scalar inner plan stays flat and
# non-recursive: no joins, grouping, nested comparisons, raw SQL, aliases,
# tables or open expressions are introduced.  Empty scope preserves the global
# aggregate behavior.
# ---------------------------------------------------------------------------

def sc_avg_agg: qb::AggregateFunction = qb::AggregateFunction::Avg;
def sc_max_agg: qb::AggregateFunction = qb::AggregateFunction::Max;
def sc_min_agg: qb::AggregateFunction = qb::AggregateFunction::Min;
def sc_sum_agg: qb::AggregateFunction = qb::AggregateFunction::Sum;
def sc_int_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];

@edsl::entity_id("sc_accounts")
@edsl::entity_source("sc_accounts", "sa")
type ScAccount = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::dimension("ScAccountId", flag_true, flag_true, eq_ops, sc_int_kinds)
    id: Int,
    @edsl::column("kind")
    @edsl::dimension("ScAccountKind", flag_true, flag_true, eq_ops, text_kinds)
    kind: String,
};

@edsl::entity_id("sc_txns")
@edsl::entity_source("sc_txns", "st")
type ScTxn = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("ScTxnCount", count_agg, no_requires)
    id: Int,
    @edsl::column("account_id")
    account_id: Int,
    @edsl::column("amount_avg")
    @edsl::measure("ScTxnAvg", sc_avg_agg, no_requires)
    amount_avg: Float,
    @edsl::column("amount_max")
    @edsl::measure("ScTxnMax", sc_max_agg, no_requires)
    amount_max: Float,
    @edsl::column("amount_min")
    @edsl::measure("ScTxnMin", sc_min_agg, no_requires)
    amount_min: Float,
    @edsl::column("category")
    @edsl::dimension("ScTxnCategory", flag_true, flag_true, eq_ops, text_kinds)
    category: String,
    @edsl::column("status")
    @edsl::dimension("ScTxnStatus", flag_true, flag_true, eq_ops, text_kinds)
    status: String,
    @edsl::column("secret")
    @edsl::dimension("ScTxnSecret", flag_false, flag_true, eq_ops, text_kinds)
    secret: String,
    @edsl::column("ref")
    @edsl::dimension("ScTxnRef", flag_true, flag_false, eq_ops, text_kinds)
    ref: String,
};

def sc_entity_types: Array(Type) = [ScAccount.type, ScTxn.type];

def sc_authorize: Fn(String) -> Bool = fn(subject) { subject == "analyst" };

def sc_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("sc-v1", sc_entity_types, knowledge::profile, sc_authorize)
};

def sc_listing_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "ScAccountId", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def sc_account_index: Fn() -> Int = fn() {
    match array::find(sc_payload().entities, fn(e) { e.id == "sc_accounts" }) {
        Some(e) => e.index,
        None => fail!("sc_accounts entity missing"),
    }
};

def sc_txn_index: Fn() -> Int = fn() {
    match array::find(sc_payload().entities, fn(e) { e.id == "sc_txns" }) {
        Some(e) => e.index,
        None => fail!("sc_txns entity missing"),
    }
};

def sc_compare_spec: Fn(String, Array(edsl::FilterRequest)) -> edsl::ScalarCompareRequest = fn(measure, scope_filters) {
    let spec: edsl::ScalarCompareRequest = {
        attribute: "ScAccountId",
        subject: "analyst",
        op: edsl::HavingOp::Gt,
        measure: measure,
        scope_filters: scope_filters,
    };
    spec
};

def sc_two_scope_spec: edsl::ScalarCompareRequest = sc_compare_spec("ScTxnAvg", [
    { id: "ScTxnCategory", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("travel") },
    { id: "ScTxnStatus", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("cleared") },
]);

def sc_empty_scope_spec: edsl::ScalarCompareRequest = sc_compare_spec("ScTxnAvg", []);

def check_scoped_attribute_compare_positive: Fn() -> Bool = fn() {
    # Numeric outer attribute (ScAccountId, Int) compared with a filtered
    # numeric avg aggregate over the inner entity, with TWO ordered scope
    # filters (AND, deterministic declared order, exact SQL/bindings).
    let plan: qb::Plan = edsl::lower_attribute_compare(sc_payload(), sc_listing_request, [sc_two_scope_spec]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::String("travel"), qb::Val::String("cleared")];
    let expected_sql = "SELECT sa.id FROM sc_accounts AS sa WHERE sa.id > (SELECT avg(st.amount_avg) FROM sc_txns AS st WHERE (st.category = ? AND st.status = ?))";
    check(array::length(plan.scalar_comparisons) == 1, "scoped compare: exactly one Plan-level comparison predicate")
        && check(array::length(plan.projection) == 1 && expr_item_count(plan.projection) == 1,
            "scoped compare: the exact outer projection is preserved (listing dimension only)")
        && check(query.sql == expected_sql, "scoped compare: inner scope filters AND inside the scalar subquery in declared order")
        && check(query.bindings == expected, "scoped compare: scope filter values bind in declared order inside the subquery")
        && check(array::length(plan.joins) == 0 && array::length(plan.exists) == 0,
            "scoped compare: the scalar inner plan stays flat (no joins/EXISTS)")
        && check(!string::contains(query.sql, "coalesce"), "scoped compare: native NULL semantics (no injected coalesce)")
};

def check_scoped_attribute_compare_min_max: Fn() -> Bool = fn() {
    # Filtered min/max aggregates are also expressible through the same scoped
    # shape.
    let max_spec = sc_compare_spec("ScTxnMax", [
        { id: "ScTxnCategory", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("travel") },
    ]);
    let min_spec = sc_compare_spec("ScTxnMin", [
        { id: "ScTxnStatus", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("cleared") },
    ]);
    let max_q: qb::Query = qb::transform_sqlite(edsl::lower_attribute_compare(sc_payload(), sc_listing_request, [max_spec]));
    let min_q: qb::Query = qb::transform_sqlite(edsl::lower_attribute_compare(sc_payload(), sc_listing_request, [min_spec]));
    let expected_max: Array(qb::Val) = [qb::Val::String("travel")];
    let expected_min: Array(qb::Val) = [qb::Val::String("cleared")];
    check(string::contains(max_q.sql, "sa.id > (SELECT max(st.amount_max) FROM sc_txns AS st WHERE st.category = ?)"),
        "scoped compare: filtered max aggregate renders with its single scope filter")
        && check(string::contains(min_q.sql, "sa.id > (SELECT min(st.amount_min) FROM sc_txns AS st WHERE st.status = ?)"),
            "scoped compare: filtered min aggregate renders with its single scope filter")
        && check(max_q.bindings == expected_max && min_q.bindings == expected_min,
            "scoped compare: min/max scope bindings keep declared order")
};

def check_scoped_attribute_compare_empty_and_determinism: Fn() -> Bool = fn() {
    let accounts = sc_account_index();
    let p1: qb::Plan = edsl::lower_attribute_compare(sc_payload(), sc_listing_request, [sc_empty_scope_spec]);
    let p2: qb::Plan = edsl::lower_attribute_compare(sc_payload(), sc_listing_request, [sc_empty_scope_spec]);
    let q1: qb::Query = qb::transform_sqlite(p1);
    let q2: qb::Query = qb::transform_sqlite(p2);
    let expected_sql = "SELECT sa.id FROM sc_accounts AS sa WHERE sa.id > (SELECT avg(st.amount_avg) FROM sc_txns AS st)";
    let expected: Array(qb::Val) = [];
    check(q1.sql == expected_sql && q1.bindings == expected,
        "scoped compare: empty scope preserves the global (unscoped) aggregate behavior")
        && check(edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", []),
            "scoped compare probe: empty-scope scoped probe is feasible (compatible with the unscoped probe)")
        && check(edsl::attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg"),
            "scoped compare: the existing unscoped probe stays useful")
        && check(q1.sql == q2.sql && q1.bindings == q2.bindings,
            "scoped compare: repeated lowering is byte-identical")
};

def check_scoped_attribute_compare_profile_and_projection: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_attribute_compare(sc_payload(), sc_listing_request, [sc_two_scope_spec]);
    let narrow: qb::PlanProfile = {
        allowed_operators: [
            qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
            qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order, qb::Operator::Limit,
            qb::Operator::Offset, qb::Operator::Partition,
        ],
        allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
        allowed_aggregates: [qb::AggregateFunction::Count],
        allowed_scalars: [qb::ScalarFunction::Substr, qb::ScalarFunction::Instr, qb::ScalarFunction::If, qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Lower, qb::ScalarFunction::Length, qb::ScalarFunction::JsonExtract, qb::ScalarFunction::JsonType, qb::ScalarFunction::JsonValid, qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not],
        allow_distinct: True,
    };
    check(qb::profile_accepts(plan, knowledge::profile), "scoped compare: the full profile accepts the scoped plan")
        && check(!qb::profile_accepts(plan, narrow),
            "scoped compare: a profile without the Avg aggregate rejects the scoped plan recursively")
        && check(array::length(plan.projection) == 1,
            "scoped compare: the exact projection stays the requested listing dimension")
};

def check_scoped_attribute_compare_rejections: Fn() -> Bool = fn() {
    let accounts = sc_account_index();
    let txns = sc_txn_index();
    # Scope filter owned by the OUTER (base) entity rather than the inner
    # measure's entity: rejected (never resolved against the outer attribute
    # entity, never moved into the outer plan filter).
    let outer_owned: Array(edsl::FilterRequest) = [
        { id: "ScAccountId", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Int(7) },
    ];
    # Cross-entity scope: a dimension of a third/unrelated entity.
    let cross_owned: Array(edsl::FilterRequest) = [
        { id: "OrderRegion", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("east") },
    ];
    let unknown: Array(edsl::FilterRequest) = [
        { id: "MissingDim", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("x") },
    ];
    let unauthorized: Array(edsl::FilterRequest) = [
        { id: "ScTxnSecret", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("x") },
    ];
    let unfilterable: Array(edsl::FilterRequest) = [
        { id: "ScTxnRef", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("x") },
    ];
    let bad_op: Array(edsl::FilterRequest) = [
        { id: "ScTxnCategory", subject: "analyst", op: edsl::FilterOp::Contains, input: edsl::FilterInput::Text("travel") },
    ];
    let bad_input: Array(edsl::FilterRequest) = [
        { id: "ScTxnCategory", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Int(5) },
    ];
    let outer_role: Array(edsl::FilterRequest) = [
        { id: "ScTxnCategory", subject: "outsider", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("travel") },
    ];
    check(!edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", outer_owned),
        "scoped compare probe: a scope filter owned by the outer base entity (not the inner entity) is rejected")
        && check(!edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", cross_owned),
            "scoped compare probe: a cross-entity scope dimension is rejected")
        && check(!edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", unknown),
            "scoped compare probe: an unknown scope dimension is rejected")
        && check(!edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", unauthorized),
            "scoped compare probe: an unauthorized scope dimension is rejected")
        && check(!edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", unfilterable),
            "scoped compare probe: an unfilterable scope dimension is rejected")
        && check(!edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", bad_op),
            "scoped compare probe: an unsupported scope filter operator is rejected")
        && check(!edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", bad_input),
            "scoped compare probe: an invalid scope filter input type is rejected")
        && check(!edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", outer_role),
            "scoped compare probe: an unauthorized scope filter subject is rejected")
        && check(edsl::scoped_attribute_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnAvg", [
            { id: "ScTxnCategory", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("travel") },
            { id: "ScTxnStatus", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("cleared") },
        ]),
        "scoped compare probe: two inner-entity scope filters on the same measure are feasible")
};

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Ranked grouped-key comparison (ontology typed entry).
#
# `lower_ranked_key_compare` exposes the query-core `RankedKeyComparison`: outer
# detail rows are kept when their attribute equals (or otherwise compares to)
# the grouping key of the FIRST inner group after aggregate ordering, rendered
# as `(SELECT <key> ... GROUP BY <key> ORDER BY <agg> <dir> LIMIT 1)`.  The
# ranking measure is never projected; the outer projection is unchanged.
# ---------------------------------------------------------------------------

def sc_ranked_kind_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "ScAccountKind", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def sc_ranked_txn_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "ScTxnCategory", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def sc_ranked_spec: Fn(String, String, edsl::OrderDirection, Array(edsl::FilterRequest)) -> edsl::RankedKeyCompareRequest = fn(measure, group, direction, scope) {
    let spec: edsl::RankedKeyCompareRequest = {
        attribute: "ScAccountKind",
        subject: "analyst",
        op: edsl::HavingOp::Eq,
        group: group,
        measure: measure,
        direction: direction,
        scope_filters: scope,
    };
    spec
};

def sc_ranked_self_spec: Fn(String, edsl::OrderDirection, Array(edsl::FilterRequest)) -> edsl::RankedKeyCompareRequest = fn(measure, direction, scope) {
    let spec: edsl::RankedKeyCompareRequest = {
        attribute: "ScTxnCategory",
        subject: "analyst",
        op: edsl::HavingOp::Eq,
        group: "ScTxnCategory",
        measure: measure,
        direction: direction,
        scope_filters: scope,
    };
    spec
};

def check_ranked_key_positive: Fn() -> Bool = fn() {
    # Multi-entity positive: outer account kind rows are filtered by the related
    # txn category whose max(amount_max) ranks first (DESC).  The outer
    # projection is only the requested listing dimension.
    let spec = sc_ranked_spec("ScTxnMax", "ScTxnCategory", edsl::OrderDirection::Desc, []);
    let plan: qb::Plan = edsl::lower_ranked_key_compare(sc_payload(), sc_ranked_kind_request, [spec]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [];
    let expected_sql = "SELECT sa.kind FROM sc_accounts AS sa WHERE sa.kind = (SELECT st.category FROM sc_txns AS st GROUP BY st.category ORDER BY max(st.amount_max) DESC LIMIT 1)";
    check(array::length(plan.ranked_key_comparisons) == 1, "ranked key: exactly one Plan-level grouped-key comparison predicate")
        && check(array::length(plan.projection) == 1 && expr_item_count(plan.projection) == 1,
            "ranked key: the exact outer projection is preserved (only the listing dimension)")
        && check(query.sql == expected_sql, "ranked key: outer detail rows compare to the first group key after max aggregate ranking")
        && check(query.bindings == expected, "ranked key: the max-rank comparison binds no dynamic values")
        && check(!string::contains(query.sql, "coalesce"), "ranked key: native NULL comparison behavior")
};

def check_ranked_key_scoped_and_min_asc: Fn() -> Bool = fn() {
    # Scoped positive: an ordered inner scope filter narrows the ranked groups
    # (deterministic AND inside the subquery).  Ascending min-rank direct-source
    # positive is also covered.
    let scoped = sc_ranked_spec("ScTxnMin", "ScTxnCategory", edsl::OrderDirection::Asc, [
        { id: "ScTxnStatus", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("cleared") },
    ]);
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_ranked_key_compare(sc_payload(), sc_ranked_kind_request, [scoped]));
    let expected1: Array(qb::Val) = [qb::Val::String("cleared")];
    let self_spec = sc_ranked_self_spec("ScTxnCount", edsl::OrderDirection::Desc, []);
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_ranked_key_compare(sc_payload(), sc_ranked_txn_request, [self_spec]));
    check(q1.sql == "SELECT sa.kind FROM sc_accounts AS sa WHERE sa.kind = (SELECT st.category FROM sc_txns AS st WHERE st.status = ? GROUP BY st.category ORDER BY min(st.amount_min) ASC LIMIT 1)"
            && q1.bindings == expected1,
        "ranked key: a scoped ascending min-rank grouped-key subquery keeps deterministic clause and binding order")
        && check(q2.sql == "SELECT st.category FROM sc_txns AS st WHERE st.category = (SELECT st.category FROM sc_txns AS st GROUP BY st.category ORDER BY count(st.id) DESC LIMIT 1)",
            "ranked key: a direct-source (same-grain) rank comparison lowers without any extra machinery")
        && check(array::length(q2.bindings) == 0, "ranked key: the direct-source count-rank comparison binds nothing")
};

def check_ranked_key_rejections: Fn() -> Bool = fn() {
    let accounts = sc_account_index();
    let txns = sc_txn_index();
    let incompatible = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "ScAccountId", "ScTxnCategory", "ScTxnMax", edsl::OrderDirection::Desc, []);
    let bad_grain = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "ScAccountKind", "ScAccountKind", "ScTxnMax", edsl::OrderDirection::Desc, []);
    let bad_attr = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "MissingAttr", "ScTxnCategory", "ScTxnMax", edsl::OrderDirection::Desc, []);
    let bad_group = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "ScAccountKind", "MissingGroup", "ScTxnMax", edsl::OrderDirection::Desc, []);
    let bad_measure = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "ScAccountKind", "ScTxnCategory", "MissingMeasure", edsl::OrderDirection::Desc, []);
    let unauthorized_group = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "ScAccountKind", "ScTxnSecret", "ScTxnMax", edsl::OrderDirection::Desc, []);
    let bad_scope_owner = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "ScAccountKind", "ScTxnCategory", "ScTxnMax", edsl::OrderDirection::Desc, [
        { id: "ScAccountKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("premium") },
    ]);
    let bad_scope_value = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "ScAccountKind", "ScTxnCategory", "ScTxnMax", edsl::OrderDirection::Desc, [
        { id: "ScTxnCategory", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Int(3) },
    ]);
    let ok = edsl::ranked_key_compare_ok(sc_payload(), accounts, "analyst", "ScAccountKind", "ScTxnCategory", "ScTxnMax", edsl::OrderDirection::Desc, []);
    check(!incompatible, "ranked key probe: incompatible outer-key/group-key types are rejected")
        && check(!bad_grain, "ranked key probe: a ranking measure off the inner population grain is rejected")
        && check(!bad_attr, "ranked key probe: an unknown outer attribute is rejected")
        && check(!bad_group, "ranked key probe: an unknown grouping dimension is rejected")
        && check(!bad_measure, "ranked key probe: an unknown ranking measure is rejected")
        && check(!unauthorized_group, "ranked key probe: an unauthorized grouping dimension is rejected")
        && check(!bad_scope_owner, "ranked key probe: a scope filter owned outside the inner population is rejected")
        && check(!bad_scope_value, "ranked key probe: an invalid scope filter input type is rejected")
        && check(ok, "ranked key probe: a compatible multi-entity max-rank comparison is feasible")
};

def check_ranked_key_determinism_profile_and_compat: Fn() -> Bool = fn() {
    let spec = sc_ranked_spec("ScTxnMax", "ScTxnCategory", edsl::OrderDirection::Desc, []);
    let p1: qb::Plan = edsl::lower_ranked_key_compare(sc_payload(), sc_ranked_kind_request, [spec]);
    let p2: qb::Plan = edsl::lower_ranked_key_compare(sc_payload(), sc_ranked_kind_request, [spec]);
    let q1: qb::Query = qb::transform_sqlite(p1);
    let q2: qb::Query = qb::transform_sqlite(p2);
    let narrow: qb::PlanProfile = {
        allowed_operators: [
            qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
            qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order, qb::Operator::Limit,
            qb::Operator::Offset, qb::Operator::Partition,
        ],
        allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
        allowed_aggregates: [qb::AggregateFunction::Count],
        allowed_scalars: [qb::ScalarFunction::Substr, qb::ScalarFunction::Instr, qb::ScalarFunction::If, qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Lower, qb::ScalarFunction::Length, qb::ScalarFunction::JsonExtract, qb::ScalarFunction::JsonType, qb::ScalarFunction::JsonValid, qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not],
        allow_distinct: True,
    };
    check(q1.sql == q2.sql && q1.bindings == q2.bindings, "ranked key: repeated lowering is byte-identical")
        && check(qb::profile_accepts(p1, knowledge::profile), "ranked key: the full profile accepts the ranked comparison")
        && check(!qb::profile_accepts(p1, narrow), "ranked key: a profile without the inner ranking aggregate rejects recursively")
        && check(array::length(p1.scalar_comparisons) == 0, "ranked key: existing scalar aggregate comparisons stay unchanged (none injected)")
};

# ---------------------------------------------------------------------------
# Ranked grouped-key comparison with the hidden outer attribute on a safely
# reachable PARENT entity (ontology feedback: materialize the ranked outer
# join).  RkLine is the detail-grain base; its Safe owner RkParent carries the
# compared zone attribute; the inner population RkEvent is unrelated and only
# supplies the ranked grouping key.  Lowering must add exactly the prepared
# safe-path join so the owning alias is visible, without touching the original
# detail grain or projection.
# ---------------------------------------------------------------------------

@edsl::entity_id("rk_lines")
@edsl::entity_source("rk_lines", "rl")
@edsl::relation(RkParent.type, safe_kind, 2, 0)
type RkLine = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("label")
    @edsl::dimension("RkLineLabel", flag_true, flag_true, eq_ops, text_kinds)
    label: String,
    @edsl::column("parent_id")
    parent_id: Int,
};

@edsl::entity_id("rk_parents")
@edsl::entity_source("rk_parents", "rp")
type RkParent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("zone")
    @edsl::dimension("RkParentZone", flag_true, flag_true, eq_ops, text_kinds)
    zone: String,
};

@edsl::entity_id("rk_events")
@edsl::entity_source("rk_events", "re")
type RkEvent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("RkEventCount", count_agg, no_requires)
    id: Int,
    @edsl::column("zone")
    @edsl::dimension("RkEventZone", flag_true, flag_true, eq_ops, text_kinds)
    zone: String,
};

def rk_entity_types: Array(Type) = [RkLine.type, RkParent.type, RkEvent.type];

def rk_authorize: Fn(String) -> Bool = fn(subject) { True };

def rk_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("rk-v1", rk_entity_types, knowledge::profile, rk_authorize)
};

def rk_line_listing_request: edsl::QueryRequest = {
    measures: [],
    dimensions: [{ id: "RkLineLabel", subject: "analyst", input: edsl::DimensionInput::None }],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def check_ranked_key_outer_parent_join: Fn() -> Bool = fn() {
    # Detail-grain base (rk_lines) whose hidden outer comparison attribute
    # (RkParentZone) lives on its safely reachable parent (rk_parents).  The
    # prepared Safe path's join must be materialized in the outer plan so the
    # owning alias rp is visible; the exact projection (only the requested
    # listing dimension) and the detail grain are preserved, and neither the
    # comparison attribute nor the ranking measure is exposed.
    let spec: edsl::RankedKeyCompareRequest = {
        attribute: "RkParentZone",
        subject: "analyst",
        op: edsl::HavingOp::Eq,
        group: "RkEventZone",
        measure: "RkEventCount",
        direction: edsl::OrderDirection::Desc,
        scope_filters: [],
    };
    let plan: qb::Plan = edsl::lower_ranked_key_compare(rk_payload(), rk_line_listing_request, [spec]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT rl.label FROM rk_lines AS rl INNER JOIN rk_parents AS rp ON rl.parent_id = rp.id WHERE rp.zone = (SELECT re.zone FROM rk_events AS re GROUP BY re.zone ORDER BY count(re.id) DESC LIMIT 1)";
    let expected: Array(qb::Val) = [];
    let join_ok = array::length(plan.joins) == 1
        && (match get_index(plan.joins, 0).kind { qb::JoinKind::Inner => True, qb::JoinKind::Left => False })
        && get_index(plan.joins, 0).source.alias == "rp"
        && get_index(plan.joins, 0).source.table == "rk_parents";
    let lines = entity_id_index(rk_payload().entities, "rk_lines");
    check(query.sql == expected_sql, "ranked outer join: exact SQL materializes the safe-path parent join for the hidden comparison attribute")
        && check(query.bindings == expected, "ranked outer join: no dynamic values are bound")
        && check(join_ok, "ranked outer join: the outer plan carries exactly the prepared safe-path parent join")
        && check(array::length(plan.ranked_key_comparisons) == 1, "ranked outer join: exactly one grouped-key comparison predicate")
        && check(array::length(plan.projection) == 1
            && (match get_index(plan.projection, 0) { qb::SelectItem::Expr(e) => is_column(e, "rl", "label"), _ => False }),
            "ranked outer join: the original detail-grain projection is preserved (no attribute or ranking measure exposed)")
        && check(array::length(plan.grouping) == 0, "ranked outer join: the detail grain is not grouped")
        && check(edsl::ranked_key_compare_ok(rk_payload(), lines, "analyst", "RkParentZone", "RkEventZone", "RkEventCount", edsl::OrderDirection::Desc, []),
            "ranked outer join probe: an attribute on a safely reachable parent is feasible")
};

# ---------------------------------------------------------------------------
# Ranked grouped-key comparison route-rejection boundary (ontology feedback:
# close ranked outer-route safety).  Synthetic domain-neutral fixtures only.
#
# 1. A fan-out-only route to the attribute owner must be rejected (a join would
#    amplify the detail grain).
# 2. Parallel / otherwise ambiguous Safe routes to the attribute owner must be
#    rejected: the route is never chosen by declaration order.
# 3. A missing/undeclared route to the attribute owner must be rejected.
# 4. A derived (union) outer plan that would need the added safe join must be
#    rejected (non-physical outer plan).
# The pure probe asserts every rejection without failing; lowering rejects each
# shape with its own diagnostic and never emits a partial plan.
# ---------------------------------------------------------------------------

@edsl::entity_id("rk_fan_lines")
@edsl::entity_source("rk_fan_lines", "rfl")
@edsl::relation(RkFanParent.type, fanout_kind, 2, 0)
type RkFanLine = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("label")
    @edsl::dimension("RkFanLineLabel", flag_true, flag_true, eq_ops, text_kinds)
    label: String,
    @edsl::column("parent_id")
    parent_id: Int,
};

@edsl::entity_id("rk_fan_parents")
@edsl::entity_source("rk_fan_parents", "rfp")
type RkFanParent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("zone")
    @edsl::dimension("RkFanParentZone", flag_true, flag_true, eq_ops, text_kinds)
    zone: String,
};

def rk_fan_entity_types: Array(Type) = [RkFanLine.type, RkFanParent.type, RkEvent.type];

def rk_fan_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("rk-fan-v1", rk_fan_entity_types, knowledge::profile, rk_authorize)
};

@edsl::entity_id("rk_amb_lines")
@edsl::entity_source("rk_amb_lines", "ral")
@edsl::relation(RkAmbParent.type, safe_kind, 2, 0)
@edsl::relation(RkAmbParent.type, safe_kind, 3, 0)
type RkAmbLine = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("label")
    @edsl::dimension("RkAmbLineLabel", flag_true, flag_true, eq_ops, text_kinds)
    label: String,
    @edsl::column("primary_parent_id")
    primary_parent_id: Int,
    @edsl::column("secondary_parent_id")
    secondary_parent_id: Int,
};

@edsl::entity_id("rk_amb_parents")
@edsl::entity_source("rk_amb_parents", "rap")
type RkAmbParent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("zone")
    @edsl::dimension("RkAmbParentZone", flag_true, flag_true, eq_ops, text_kinds)
    zone: String,
};

def rk_amb_entity_types: Array(Type) = [RkAmbLine.type, RkAmbParent.type, RkEvent.type];

def rk_amb_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("rk-amb-v1", rk_amb_entity_types, knowledge::profile, rk_authorize)
};

def rk_union_branch_a_cols: Array(edsl::UnionColumnDecl) = [
    { field: 0, column: "id" },
    { field: 1, column: "label" },
    { field: 2, column: "parent_id" },
];

def rk_union_branch_b_cols: Array(edsl::UnionColumnDecl) = [
    { field: 0, column: "key" },
    { field: 1, column: "name" },
    { field: 2, column: "owner_id" },
];

def rk_union_branches: Array(edsl::UnionBranchDecl) = [
    { table: "rk_union_a", alias: "ua", columns: rk_union_branch_a_cols, filter: None },
    { table: "rk_union_b", alias: "ub", columns: rk_union_branch_b_cols, filter: None },
];

# A derived (union) base entity: it declares a Safe relation to a parent owner,
# but the outer plan is a derived UNION ALL with no physical source/join slot,
# so a ranked parent-attribute join cannot be represented.
@edsl::entity_id("rk_union_lines")
@edsl::union_source("u", rk_union_branches)
@edsl::relation(RkUnionParent.type, safe_kind, 2, 0)
type RkUnionLine = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("label")
    @edsl::dimension("RkUnionLabel", flag_true, flag_true, eq_ops, text_kinds)
    label: String,
    @edsl::column("parent_id")
    parent_id: Int,
};

@edsl::entity_id("rk_union_parents")
@edsl::entity_source("rk_union_parents", "rup")
type RkUnionParent = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("zone")
    @edsl::dimension("RkUnionParentZone", flag_true, flag_true, eq_ops, text_kinds)
    zone: String,
};

def rk_union_entity_types: Array(Type) = [RkUnionLine.type, RkUnionParent.type, RkEvent.type];

def rk_union_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("rk-union-v1", rk_union_entity_types, knowledge::profile, rk_authorize)
};

def check_ranked_key_fanout_route_rejected: Fn() -> Bool = fn() {
    # The attribute owner is reachable only through a fan-out route; a hidden
    # outer comparison join would multiply the detail grain.  The pure probe
    # rejects it, and lowering fails with the fan-out diagnostic (no partial
    # plan, no silent grain amplification).
    let p = rk_fan_payload();
    let lines = entity_id_index(p.entities, "rk_fan_lines");
    let parents = entity_id_index(p.entities, "rk_fan_parents");
    let path_is_fanout = match get_index(get_index(p.paths, lines), parents) {
        edsl::PathResult::FanOut(_) => True,
        _ => False,
    };
    let probe_rejects = !edsl::ranked_key_compare_ok(p, lines, "analyst", "RkFanParentZone", "RkEventZone", "RkEventCount", edsl::OrderDirection::Desc, []);
    let probe_control = edsl::ranked_key_compare_ok(p, lines, "analyst", "RkFanLineLabel", "RkEventZone", "RkEventCount", edsl::OrderDirection::Desc, []);
    check(path_is_fanout, "ranked route rejection: the owner is reachable only through a fan-out route")
        && check(probe_rejects, "ranked route rejection probe: an attribute on a fan-out-only owner is rejected")
        && check(probe_control, "ranked route rejection probe: an attribute on the base entity itself stays feasible")
};

def check_ranked_key_ambiguous_route_rejected: Fn() -> Bool = fn() {
    # Two parallel Safe routes connect the detail base to the same attribute
    # owner.  The path matrix still records a first Safe path, but the route is
    # never chosen by declaration order: the prepared ambiguity matrix flags it
    # and both the probe and lowering reject it.
    let p = rk_amb_payload();
    let lines = entity_id_index(p.entities, "rk_amb_lines");
    let parents = entity_id_index(p.entities, "rk_amb_parents");
    let path_is_safe = match get_index(get_index(p.paths, lines), parents) {
        edsl::PathResult::Safe(_) => True,
        _ => False,
    };
    let amb_flag = get_index(get_index(p.ambiguous_paths, lines), parents);
    let probe_rejects = !edsl::ranked_key_compare_ok(p, lines, "analyst", "RkAmbParentZone", "RkEventZone", "RkEventCount", edsl::OrderDirection::Desc, []);
    let probe_control = edsl::ranked_key_compare_ok(p, lines, "analyst", "RkAmbLineLabel", "RkEventZone", "RkEventCount", edsl::OrderDirection::Desc, []);
    check(path_is_safe && amb_flag, "ranked route rejection: the ambiguity matrix flags parallel safe routes to the owner")
        && check(probe_rejects, "ranked route rejection probe: an attribute on an ambiguously reachable owner is rejected")
        && check(probe_control, "ranked route rejection probe: an attribute on the base entity itself stays feasible")
};

def check_ranked_key_missing_route_rejected: Fn() -> Bool = fn() {
    # Missing/undeclared route: the attribute owner (rk_events) is unrelated to
    # the detail base (rk_lines).  The probe rejects it; lowering fails with the
    # missing-route diagnostic instead of guessing a path.
    let p = rk_payload();
    let lines = entity_id_index(p.entities, "rk_lines");
    let events = entity_id_index(p.entities, "rk_events");
    let path_missing = match get_index(get_index(p.paths, lines), events) {
        edsl::PathResult::Missing => True,
        _ => False,
    };
    let probe_rejects = !edsl::ranked_key_compare_ok(p, lines, "analyst", "RkEventZone", "RkEventZone", "RkEventCount", edsl::OrderDirection::Desc, []);
    check(path_missing, "ranked route rejection: the attribute owner has no declared route from the detail base")
        && check(probe_rejects, "ranked route rejection probe: an attribute on an unreachable owner is rejected")
};

def check_ranked_key_derived_plan_join_rejected: Fn() -> Bool = fn() {
    # A derived (union) base entity declares a Safe route to the attribute owner,
    # but the outer plan is a derived UNION ALL with no physical source/join
    # slot: the added ranked join cannot be represented safely, so the probe
    # rejects the off-base attribute even though the route is Safe and unique.
    let p = rk_union_payload();
    let union_lines = entity_id_index(p.entities, "rk_union_lines");
    let union_parents = entity_id_index(p.entities, "rk_union_parents");
    let base_is_union = match get_index(p.entities, union_lines).union {
        Some(_) => True,
        None => False,
    };
    let safe_route = match get_index(get_index(p.paths, union_lines), union_parents) {
        edsl::PathResult::Safe(_) => True,
        _ => False,
    };
    let probe_rejects = !edsl::ranked_key_compare_ok(p, union_lines, "analyst", "RkUnionParentZone", "RkEventZone", "RkEventCount", edsl::OrderDirection::Desc, []);
    let probe_base_attr = edsl::ranked_key_compare_ok(p, union_lines, "analyst", "RkUnionLabel", "RkEventZone", "RkEventCount", edsl::OrderDirection::Desc, []);
    check(base_is_union && safe_route, "ranked route rejection: a derived union base has a unique Safe route to the owner")
        && check(probe_rejects, "ranked route rejection probe: a derived outer plan that would need the added join is rejected")
        && check(probe_base_attr, "ranked route rejection probe: an attribute on the derived base entity itself stays feasible")
};

# Explicit projection order (integrated feedback P1).
#
# Final column order is a result contract: the caller may interleave selected
# measures and dimensions explicitly.  `lower_ordered` keeps the default
# lowering otherwise; it only reorders the SELECT list and validates that every
# requested measure/dimension appears exactly once (no omission/duplicate/hidden
# reference).  Omitting the order preserves the default measure-then-dimension
# behaviour.
# ---------------------------------------------------------------------------

def projection_labels: Fn(qb::Plan) -> Array(String) = fn(plan) {
    array::map(plan.projection, fn(item) {
        match item {
            qb::SelectItem::Aggregate(agg) => agg.alias,
            qb::SelectItem::Computed(c) => c.alias,
            qb::SelectItem::NamedExpr(named) => named.alias,
            qb::SelectItem::Expr(expr) => match expr {
                qb::Expr::Column(ref) => `col:\{ref.column}`,
                _ => "expr",
            },
        }
    })
};

def check_explicit_projection_order: Fn() -> Bool = fn() {
    let order: Array(edsl::ProjectionToken) = [
        edsl::ProjectionToken::Dimension("OrderRegion"),
        edsl::ProjectionToken::Measure("OrderAmount"),
        edsl::ProjectionToken::Dimension("CustomerTier"),
        edsl::ProjectionToken::Measure("OrderCount"),
        edsl::ProjectionToken::Dimension("OrderWeek"),
    ];
    let plan: qb::Plan = edsl::lower_ordered(knowledge::payload, main_request, order);
    let labels = projection_labels(plan);
    let query: qb::Query = qb::transform_sqlite(plan);
    check(labels == ["col:region", "OrderAmount", "col:tier", "OrderCount", "expr"],
        "explicit projection order: SELECT columns follow the interleaved caller order")
        && check(array::length(plan.ordering) == 2 && plan.limit == Some(5),
            "explicit projection order: filters/grouping/ordering/limit are unchanged")
        && check(string::contains(query.sql, "o.region") && string::contains(query.sql, "c.tier"),
            "explicit projection order: lowered SQL keeps deterministic SQL/bindings")
};

def check_default_projection_order_compat: Fn() -> Bool = fn() {
    let default_plan: qb::Plan = edsl::lower(knowledge::payload, main_request);
    let ordered_default: qb::Plan = edsl::lower_ordered(knowledge::payload, main_request, []);
    let labels_default = projection_labels(default_plan);
    check(ordered_default == default_plan, "explicit projection order: empty order keeps the default plan")
        && check(labels_default == ["OrderAmount", "OrderCount", "col:region", "expr", "col:tier"],
            "explicit projection order: default order is measures then dimensions (compat)")
};

