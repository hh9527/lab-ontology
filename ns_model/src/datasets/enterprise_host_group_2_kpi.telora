use crate::datasets::storage_host_group;
use crate::datasets::kpi_storage_enterprise_host_group;
@domain::subject("StorageHostGroup", "obj_sys_id")
@domain::dataset("enterprise-host-group-2-kpi", "enterpriseHostGroup2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseHostGroup2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-host-group-2-kpi/obj_sys_id", ids::EnterpriseHostGroup2KpiByObjSysId.type, True, [g::Filter::Eq]), "ehg2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("ehg2_count")
    obj_sys_id: ids::EnterpriseHostGroup2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-host-group-2-kpi/obj_id", domain::Reference(ids::EnterpriseHostGroup2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "ehg2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseHostGroup2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("ehg2__shg", domain::endpoint(EnterpriseHostGroup2Kpi.type, "obj_sys_id"), domain::endpoint(storage_host_group::StorageHostGroup.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ehg2__sehg", domain::endpoint(EnterpriseHostGroup2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_host_group::KpiStorageEnterpriseHostGroup.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
