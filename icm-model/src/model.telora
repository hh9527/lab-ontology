# ICM EnterpriseKnowledge (icm-model.a3)
#
# This module declares the ICM business knowledge on top of the ontology eDSL:
# device kinds, governance views (site/tenant), current alarms, KPI fact tables
# and the sub-part tables used by the query families that the eDSL can lower.
#
# Supported surface (all lowered through the closed ontology eDSL):
#   - aggregated count / KPI aggregate queries, grouped and paginated;
#   - measure-less row projection / listing / attribute requests;
#   - filters: equality, ordering comparisons and text pattern ops
#     (contains / starts-with / ends-with / not-contains);
#   - correlated existence (EXISTS, incl. reverse derivation and
#     min_matches grouped existence) over device->alarm;
#   - model-declared two-hop correlated existence (exists_route): KPI sample and
#     device sub-part entities reach alarm through their unique owner device via
#     a grain-safe owner join + correlated EXISTS (no fan-out amplification);
#   - group predicates (HAVING) and nested "count of groups passing HAVING";
#   - OR-group value filters (AnyOf) on subject and inside EXISTS;
#   - count(DISTINCT ...) measures (distinct affected-device reference count);
#   - Top Per Group (partitioned top N) and deterministic ordering/pagination;
#   - unified five-domain device counting over a derived UNION ALL source.
#
# Intentional boundaries (deterministic diagnostics from the ontology/query
# layers, no raw SQL escape):
#   - measure hosts stay on a single entity grain; KPI aggregates are declared
#     on the sample table and reach the device by a safe N:1 join (per-device
#     aggregates over samples are expressed by grouping on a device dimension);
#   - time windows are closed/open text bounds supplied as bindings (relative
#     windows are computed by the caller, never by the SQL engine);
#   - row-level DISTINCT, dual-key OR joins to the site view, multi-hop role
#     joins and metric tables reached through a fan-out path are not modelled.
#   Field decorator ordering is irrelevant to the codec; relation field indices
#   follow the canonical (alphabetically sorted) field order of each struct.

import "ontology/edsl" as edsl;
import "ontology/query" as qb;

# ---------------------------------------------------------------------------
# Shared declaration helpers
# ---------------------------------------------------------------------------

def flag_true: Bool = 'True;
def flag_false: Bool = 'False;
def no_types: Array(Type) = [];
def safe_kind: edsl.RelationKind = 'Safe;
def fanout_kind: edsl.RelationKind = 'FanOut;

def count_agg: qb.AggregateFunction = 'Count;
def avg_agg: qb.AggregateFunction = 'Avg;
def max_agg: qb.AggregateFunction = 'Max;
def sum_agg: qb.AggregateFunction = 'Sum;
def min_agg: qb.AggregateFunction = 'Min;

# Text comparison / pattern operators (open-text dimensions).
def text_eq_ops: Array(edsl.FilterOp) = ['Eq, 'Ne, 'Contains, 'NotContains, 'StartsWith, 'EndsWith];
def text_range_ops: Array(edsl.FilterOp) = ['Gt, 'Ge, 'Lt, 'Le];
def text_time_ops: Array(edsl.FilterOp) = ['Eq, 'Gt, 'Ge, 'Lt, 'Le];
# Closed enum / status dimensions support equality only (ontology contract).
def eq_only_ops: Array(edsl.FilterOp) = ['Eq];
# Numeric comparison operators.
def int_eq_ops: Array(edsl.FilterOp) = ['Eq, 'Ne, 'Gt, 'Ge, 'Lt, 'Le];
def int_eq_range_ops: Array(edsl.FilterOp) = ['Eq, 'Ne, 'Gt, 'Ge, 'Lt, 'Le];
def float_eq_range_ops: Array(edsl.FilterOp) = ['Eq, 'Ne, 'Gt, 'Ge, 'Lt, 'Le];

def text_kinds: Array(edsl.FilterInputKind) = ['Text];
def int_kinds: Array(edsl.FilterInputKind) = ['Int];
def number_kinds: Array(edsl.FilterInputKind) = ['Number];

# Manufacturer value normalisation (domain-declared, stable aliases): known
# Huawei spellings found in the data are normalised to the canonical value so an
# Eq filter on the canonical value is correct for every stored form.  Unknown
# manufacturers pass through unchanged.
def manu_norm: Fn(qb.Expr) -> qb.Expr = fn(col) {
    let lower_col: qb.Expr = qb.lower(col);
    let canonical: qb.Expr = qb.bind_string("huawei");
    let is_plain: qb.Expr = qb.scalar('Eq, [lower_col, qb.bind_string("huawei")]);
    let is_full: qb.Expr = qb.scalar('Eq, [lower_col, qb.bind_string("huawei technologies co., ltd")]);
    let is_code: qb.Expr = qb.scalar('Eq, [lower_col, qb.bind_string("2011")]);
    qb.scalar_if(
        is_plain,
        canonical,
        qb.scalar_if(is_full, canonical, qb.scalar_if(is_code, canonical, col)),
    )
};

# Network element classification alias normalisation: the physical column keeps
# both canonical tags and vendor/display aliases (e.g. 'LSW', 'AC', 'WAC', 'AR',
# 'AP').  The computed dimension maps every stored form to its canonical
# ne.category value so an Eq filter on the canonical value is correct for all
# rows.  Rows that do not match any known alias pass through unchanged.
def net_classify: Fn(qb.Expr) -> qb.Expr = fn(col) {
    let is_lsw: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("LSW")]);
    let is_ac: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("AC")]);
    let is_wac: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("WAC")]);
    let is_ar: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("AR")]);
    let is_ap: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("AP")]);
    qb.scalar_if(
        is_lsw,
        qb.bind_string("ne.category.switch"),
        qb.scalar_if(
            is_ac,
            qb.bind_string("ne.category.ac"),
            qb.scalar_if(
                is_wac,
                qb.bind_string("ne.category.ac"),
                qb.scalar_if(
                    is_ar,
                    qb.bind_string("ne.category.router"),
                    qb.scalar_if(is_ap, qb.bind_string("ne.category.fatap"), col),
                ),
            ),
        ),
    )
};

# PON device classification normalisation.  The physical column may store the
# abstract values 'olt'/'onu', their capitalised forms, or the dotted
# vendor/display forms ('ne.category.olt', 'ne.category.onu',
# 'ne.category.pon.onu', 'ne.category.pon.spl' for GPON).  The computed
# dimension maps every known form to one canonical business value ('olt' /
# 'onu' / 'gpon') so an Eq filter on the canonical value is correct for every
# stored form.  Rows that match no known alias pass through unchanged.
def pon_classify: Fn(qb.Expr) -> qb.Expr = fn(col) {
    let is_olt: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("olt")]);
    let is_OLT: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("OLT")]);
    let is_ne_olt: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("ne.category.olt")]);
    let is_onu: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("onu")]);
    let is_ONU: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("ONU")]);
    let is_ne_onu: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("ne.category.onu")]);
    let is_ne_pon_onu: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("ne.category.pon.onu")]);
    let is_spl: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("spl")]);
    let is_SPL: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("SPL")]);
    let is_gpon: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("GPON")]);
    let is_ne_pon_spl: qb.Expr = qb.scalar('Eq, [col, qb.bind_string("ne.category.pon.spl")]);
    let olt: qb.Expr = qb.bind_string("olt");
    let onu: qb.Expr = qb.bind_string("onu");
    let gpon: qb.Expr = qb.bind_string("gpon");
    qb.scalar_if(
        is_olt, olt,
        qb.scalar_if(
            is_OLT, olt,
            qb.scalar_if(
                is_ne_olt, olt,
                qb.scalar_if(
                    is_onu, onu,
                    qb.scalar_if(
                        is_ONU, onu,
                        qb.scalar_if(
                            is_ne_onu, onu,
                            qb.scalar_if(
                                is_ne_pon_onu, onu,
                                qb.scalar_if(
                                    is_spl, gpon,
                                    qb.scalar_if(
                                        is_SPL, gpon,
                                        qb.scalar_if(
                                            is_gpon, gpon,
                                            qb.scalar_if(is_ne_pon_spl, gpon, col),
                                        ),
                                    ),
                                ),
                            ),
                        ),
                    ),
                ),
            ),
        ),
    )
};

# ---------------------------------------------------------------------------
# Closed status value domains (business value -> storage value compilation).
#
# Communication / running / health statuses are stored as short codes ('0' /
# '1').  These enum types declare the source-field storage values as the enum
# stable values (used internally by lowering) and the business labels as the
# enum labels.  The public contract (DOMAIN.md section 3) exposes only the
# business labels; the model/query facade compiles each accepted business value
# to its storage code before lowering, so the SQL binding is always the real
# storage value.  Unknown business values are rejected deterministically and no
# display label is ever bound against the coded column.
# ---------------------------------------------------------------------------

type CommuStateCode = enum {
    @edsl.enum_value("0", "在线")
    'Online,
    @edsl.enum_value("1", "离线")
    'Offline,
};

# Storage running / health status: only the complete mapping is published
# ('1' = 正常).  Other stored codes have no complete public mapping, so this
# dimension is narrowed to the documented value and unknown inputs are rejected.
type StorageNormalState = enum {
    @edsl.enum_value("1", "正常")
    'Normal,
};

# ---------------------------------------------------------------------------
# Governance views
# ---------------------------------------------------------------------------

# canonical indices: industry=0, tenant_id=1, tenant_name=2
@edsl.entity_source("X_TENANT_VIEW", "t")
@edsl.entity_id("tenant")
type Tenant = struct {
    @edsl.column("INDUSTRY")
    @edsl.dimension("TenantIndustry", flag_true, flag_true, text_eq_ops, text_kinds)
    industry: String,

    @edsl.column("TENANT_ID")
    @edsl.key(flag_true)
    @edsl.measure("TenantCount", count_agg, no_types)
    @edsl.dimension("TenantId", flag_true, flag_true, text_eq_ops, text_kinds)
    tenant_id: String,

    @edsl.column("TENANT_NAME")
    @edsl.dimension("TenantName", flag_true, flag_true, text_eq_ops, text_kinds)
    tenant_name: String,
};

# canonical indices: site_id=0, site_name=1, tenant_id=2
@edsl.entity_source("X_SITE_VIEW", "s")
@edsl.entity_id("site")
@edsl.relation(Tenant, safe_kind, 2, 1)
type Site = struct {
    @edsl.column("SITE_ID")
    @edsl.key(flag_true)
    @edsl.measure("SiteCount", count_agg, no_types)
    @edsl.dimension("SiteId", flag_true, flag_true, text_eq_ops, text_kinds)
    site_id: String,

    @edsl.column("SITE_NAME")
    @edsl.dimension("SiteName", flag_true, flag_true, text_eq_ops, text_kinds)
    site_name: String,

    @edsl.column("TENANT_ID")
    tenant_id: String,
};

# canonical indices: acked=0, alarm_name=1, alarm_time=2, alarm_type=3,
# cleared=4, csn=5, medn=6, probable_cause=7, res_name=8, severity=9,
# source=10, strext13=11, tenant=12
@edsl.entity_source("T_CURRENT_ALARM", "a")
@edsl.entity_id("alarm")
@edsl.relation(NetDevice, safe_kind, 6, 3)
@edsl.relation(PonDevice, safe_kind, 6, 2)
@edsl.relation(ServerDevice, safe_kind, 6, 6)
@edsl.relation(StorageDevice, safe_kind, 6, 3)
@edsl.relation(TerminalDevice, safe_kind, 6, 7)
@edsl.relation(CollabDevice, safe_kind, 6, 5)
@edsl.exists_route(NetDevice, NetPort)
@edsl.exists_route(NetDevice, NetOptical)
@edsl.exists_route(ServerDevice, ServerPsu)
@edsl.exists_route(ServerDevice, ServerOptical)
@edsl.exists_route(ServerDevice, ServerDisk)
@edsl.exists_route(ServerDevice, ServerFan)
@edsl.exists_route(ServerDevice, ServerMemory)
@edsl.exists_route(ServerDevice, ServerProcessor)
@edsl.exists_route(ServerDevice, ServerNic)
@edsl.exists_route(ServerDevice, ServerPort)
@edsl.exists_route(StorageDevice, StorageController)
@edsl.exists_route(StorageDevice, StorageChassis)
@edsl.exists_route(StorageDevice, StorageBackupPower)
@edsl.exists_route(StorageDevice, StorageDisk)
@edsl.exists_route(StorageDevice, StorageFan)
@edsl.exists_route(StorageDevice, StoragePort)
@edsl.exists_route(StorageDevice, StoragePsu)
type Alarm = struct {
    @edsl.column("ACKED")
    @edsl.dimension("AlarmAcked", flag_true, flag_true, int_eq_ops, int_kinds)
    acked: Int,

    @edsl.column("ALARMNAME")
    @edsl.dimension("AlarmName", flag_true, flag_true, text_eq_ops, text_kinds)
    alarm_name: String,

    @edsl.column("ALARMTIME")
    @edsl.dimension("AlarmTime", flag_true, flag_true, text_time_ops, text_kinds)
    alarm_time: String,

    @edsl.column("ALARMTYPE")
    @edsl.dimension("AlarmType", flag_true, flag_true, text_eq_ops, text_kinds)
    alarm_type: String,

    @edsl.column("CLEARED")
    @edsl.dimension("AlarmCleared", flag_true, flag_true, int_eq_ops, int_kinds)
    cleared: Int,

    @edsl.column("CSN")
    @edsl.key(flag_true)
    @edsl.measure("AlarmCount", count_agg, no_types)
    csn: Int,

    @edsl.column("MEDN")
    @edsl.measure("AlarmDeviceRefCount", count_agg, no_types)
    medn: String,

    @edsl.column("PROBABLECAUSE")
    @edsl.dimension("AlarmProbableCause", flag_true, flag_true, text_eq_ops, text_kinds)
    probable_cause: String,

    @edsl.column("RESNAME")
    @edsl.dimension("AlarmResName", flag_true, flag_true, text_eq_ops, text_kinds)
    res_name: String,

    @edsl.column("SEVERITY")
    @edsl.dimension("AlarmSeverity", flag_true, flag_true, int_eq_ops, int_kinds)
    severity: Int,

    @edsl.column("SOURCE")
    @edsl.dimension("AlarmSource", flag_true, flag_true, text_eq_ops, text_kinds)
    source: String,

    @edsl.column("STREXT13")
    strext13: String,

    @edsl.column("TENANT")
    @edsl.dimension("AlarmTenant", flag_true, flag_true, text_eq_ops, text_kinds)
    tenant: String,
};

# ---------------------------------------------------------------------------
# Network devices
# ---------------------------------------------------------------------------

# canonical indices: alias=0, classification=1, commu_state=2, id=3,
# ip_address=4, language=5, location=6, mac=7, manufacturer=8, model=9,
# name=10, os_version=11, patch_version=12, project_id=13, site_key=14,
# sn=15, tenant_key=16, version=17
@edsl.entity_source("EntNetworkElement", "d")
@edsl.entity_id("net_device")
@edsl.relation(Tenant, safe_kind, 16, 1)
@edsl.relation(Site, safe_kind, 14, 0)
type NetDevice = struct {
    @edsl.column("alias")
    @edsl.dimension("NetworkDeviceAlias", flag_true, flag_true, text_eq_ops, text_kinds)
    alias: String,

    @edsl.column("classification")
    @edsl.computed_dimension("NetworkDeviceType", flag_true, flag_true, text_eq_ops, text_kinds, net_classify)
    classification: String,

    @edsl.column("commuState")
    @edsl.dimension("NetworkDeviceCommuState", flag_true, flag_true, eq_only_ops, text_kinds)
    commu_state: CommuStateCode,

    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.dimension("NetworkDeviceId", flag_true, flag_true, text_eq_ops, text_kinds)
    @edsl.measure("NetworkDeviceCount", count_agg, no_types)
    id: String,

    @edsl.column("ipAddress")
    @edsl.dimension("NetworkDeviceIp", flag_true, flag_true, text_eq_ops, text_kinds)
    ip_address: String,

    @edsl.column("language")
    @edsl.dimension("NetworkDeviceLanguage", flag_true, flag_true, text_eq_ops, text_kinds)
    language: String,

    @edsl.column("location")
    @edsl.dimension("NetworkDeviceLocation", flag_true, flag_true, text_eq_ops, text_kinds)
    location: String,

    @edsl.column("mac")
    @edsl.dimension("NetworkDeviceMac", flag_true, flag_true, text_eq_ops, text_kinds)
    mac: String,

    @edsl.column("manufacturer")
    @edsl.computed_dimension("NetworkDeviceManufacturer", flag_true, flag_true, text_eq_ops, text_kinds, manu_norm)
    manufacturer: String,

    @edsl.column("name")
    @edsl.dimension("NetworkDeviceName", flag_true, flag_true, text_eq_ops, text_kinds)
    name: String,

    @edsl.column("neOsVersion")
    @edsl.dimension("NetworkDeviceOsVersion", flag_true, flag_true, text_eq_ops, text_kinds)
    os_version: String,

    @edsl.column("nePatchVersion")
    @edsl.dimension("NetworkDevicePatchVersion", flag_true, flag_true, text_eq_ops, text_kinds)
    patch_version: String,

    @edsl.column("productName")
    @edsl.dimension("NetworkDeviceModel", flag_true, flag_true, text_eq_ops, text_kinds)
    model: String,

    @edsl.column("projectId")
    project_id: String,

    @edsl.column("refParentSubnet")
    site_key: String,

    @edsl.column("sn")
    @edsl.dimension("NetworkDeviceSn", flag_true, flag_true, text_eq_ops, text_kinds)
    sn: String,

    @edsl.column("tenantId")
    tenant_key: String,

    @edsl.column("version")
    @edsl.dimension("NetworkDeviceVersion", flag_true, flag_true, text_eq_ops, text_kinds)
    version: String,
};

# ---------------------------------------------------------------------------
# PON devices
# ---------------------------------------------------------------------------

# canonical indices: classification=0, commu_state=1, id=2, ip_address=3,
# location=4, manufacturer=5, name=6, os_version=7, parent_olt=8, project_id=9,
# site_key=10, sn=11, tenant_key=12
@edsl.entity_source("EntPonElement", "d")
@edsl.entity_id("pon_device")
@edsl.relation(Tenant, safe_kind, 12, 1)
@edsl.relation(Site, safe_kind, 10, 0)
type PonDevice = struct {
    @edsl.column("classification")
    @edsl.computed_dimension("PonDeviceClassification", flag_true, flag_true, text_eq_ops, text_kinds, pon_classify)
    classification: String,

    @edsl.column("commuState")
    @edsl.dimension("PonDeviceCommuState", flag_true, flag_true, eq_only_ops, text_kinds)
    commu_state: CommuStateCode,

    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.dimension("PonDeviceId", flag_true, flag_true, text_eq_ops, text_kinds)
    @edsl.measure("PonDeviceCount", count_agg, no_types)
    id: String,

    @edsl.column("ipAddress")
    @edsl.dimension("PonDeviceIp", flag_true, flag_true, text_eq_ops, text_kinds)
    ip_address: String,

    @edsl.column("location")
    @edsl.dimension("PonDeviceLocation", flag_true, flag_true, text_eq_ops, text_kinds)
    location: String,

    @edsl.column("manufacturer")
    @edsl.computed_dimension("PonDeviceManufacturer", flag_true, flag_true, text_eq_ops, text_kinds, manu_norm)
    manufacturer: String,

    @edsl.column("name")
    @edsl.dimension("PonDeviceName", flag_true, flag_true, text_eq_ops, text_kinds)
    name: String,

    @edsl.column("neOsVersion")
    @edsl.dimension("PonDeviceOsVersion", flag_true, flag_true, text_eq_ops, text_kinds)
    os_version: String,

    @edsl.column("parentOltResId")
    @edsl.dimension("PonDeviceParentOlt", flag_true, flag_true, text_eq_ops, text_kinds)
    parent_olt: String,

    @edsl.column("projectId")
    project_id: String,

    @edsl.column("refParentSubnet")
    site_key: String,

    @edsl.column("sn")
    @edsl.dimension("PonDeviceSn", flag_true, flag_true, text_eq_ops, text_kinds)
    sn: String,

    @edsl.column("tenantId")
    tenant_key: String,
};

