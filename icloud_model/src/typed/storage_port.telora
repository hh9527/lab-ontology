    source_mac: String,
    source_wwn: String,
    source_portType: String,
    source_healthStatus: String,
    source_runningStatus: String,
    source_connectStatus: String,
    source_portId: String,
};
def dataset: m::Dataset(Row) = m::dataset(
    "source_SYS_StoragePort",
    "SYS_StoragePort",
    Row.type,
    ["source_id"]
);
def entity: m::Entity(Identity) = m::entity("storage_port_entity", Identity.type);
def subject: m::Role(Row) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(Row.type, PortId.type, "source_id"),
            m::field(Identity.type, PortId.type, "id")
        )
    ]
);
def tenant: m::Role(Row) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(Row.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent: m::Role(Row) = m::role(
    dataset,
    storage::entity,
    "storage_owner",
    False,
    [
        m::reference_part(
            m::field(Row.type, String.type, "source_parentResId"),
            m::field(storage::Identity.type, storage::StorageId.type, "id")
        )
    ]
);
def fc_parent: m::Role(Row) = m::role(
    dataset,
    fc::entity,
    "fc_owner",
    False,
    [
        m::reference_part(
            m::field(Row.type, String.type, "source_parentResId"),
            m::field(fc::Identity.type, fc::FcSwitchId.type, "id")
        )
    ]
);
