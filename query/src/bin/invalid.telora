# query/src/bin/invalid.telora
#
# Demonstrates that an illegal Plan produces Host diagnostics and no Query.
# The ordering references the aggregate measure "order_count", but no
# AggregateCall with that alias is projected, so structural validation inside
# transform_sqlite rejects the plan.  Running with --best-effort reports the
# diagnostics, exits non-zero and publishes no output (no partial Query is
# ever produced).

import "std/value" { Value };
import "@src/lib" as qb;

def invalid_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "invalid-1",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "customer_id"))],
        filter: 'None,
        joins: [],
        grouping: [qb.column("o", "customer_id")],
        ordering: [qb.desc_aggregate("order_count")],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    let plan = invalid_plan();
    let query = qb.transform_sqlite(plan);
    let result: Value = 'Object({
        unreachable: 'False,
        sql: 'String(query.sql),
    });
    result
};
