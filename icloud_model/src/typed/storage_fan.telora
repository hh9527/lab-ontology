use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储组件来源：parent 使用存储设备身份；原始文本不按单位说明隐式解析。
use super::inventory as i;
use super::storage as storage;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("StorageFan")
type StorageFanById = struct(ComponentId);
@domain::subject("StorageFan", "source_id")
@domain::dataset("source_SYS_Fan", "SYS_Fan", ["source_id"])
@domain::relations(relations)
type SysFan = struct {
    @m::column("id")
    @g::exact("source_SYS_Fan__id")
    source_id: StorageFanById,
    @m::column("tenantId")
    @g::exact("source_SYS_Fan__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("projectId")
    @g::exact("source_SYS_Fan__projectId")
    source_projectId: String,
    @m::column("name")
    @g::search("source_SYS_Fan__name")
    source_name: String,
    @m::column("elecLabel")
    @g::search("source_SYS_Fan__elecLabel")
    source_elecLabel: String,
    @m::column("parentResId")
    @g::exact("source_SYS_Fan__parentResId")
    source_parentResId: domain::Reference(storage::StorageById),
    @m::column("type")
    @g::exact("source_SYS_Fan__type")
    source_type: String,
    @m::column("slot")
    @g::exact("source_SYS_Fan__slot")
    source_slot: String,
    @m::column("location")
    @g::search("source_SYS_Fan__location")
    source_location: String,
    @m::column("description")
    @g::search("source_SYS_Fan__description")
    source_description: String,
    @m::column("boardType")
    @g::exact("source_SYS_Fan__boardType")
    source_boardType: String,
    @m::column("bomId")
    @g::search("source_SYS_Fan__bomId")
    source_bomId: String,
    @m::column("barCode")
    @g::search("source_SYS_Fan__barCode")
    source_barCode: String,
    @m::column("runningStatus")
    @v::classification(SourceSYSFanRunningStatus_domain, "source_SYS_Fan__runningStatus")
    source_runningStatus: String,
    @m::column("healthStatus")
    @v::classification(SourceSYSFanHealthStatus_domain, "source_SYS_Fan__healthStatus")
    source_healthStatus: String,
    @m::column("runLevel")
    @v::classification(SourceSYSFanRunLevel_domain, "source_SYS_Fan__runLevel")
    source_runLevel: String,
};

def subject: r::Endpoint = domain::endpoint(SysFan.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(SysFan.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(SysFan.type, "source_parentResId");

@knowledge_policy::reverse_references(True)
type SourceSYSFanRunningStatus = enum {
    @ev::rename("0")
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("Running", "运行")
    Running,
    @ev::rename("3")
    @ev::description("Not Running", "未运行")
    NotRunning,
    @ev::rename("8")
    @ev::description("Sleep", "休眠")
    Sleep,
    @ev::rename("27")
    @ev::description("Online", "在线")
    Online,
    @ev::rename("28")
    @ev::description("Offline", "离线")
    Offline,
};
def SourceSYSFanRunningStatus_domain: v::Domain(SourceSYSFanRunningStatus, String) = v::from_enum(
    "SourceSYSFanRunningStatus",
    SourceSYSFanRunningStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSFanHealthStatus = enum {
    @ev::rename("0")
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("Faulty", "故障")
    Faulty,
};
def SourceSYSFanHealthStatus_domain: v::Domain(SourceSYSFanHealthStatus, String) = v::from_enum(
    "SourceSYSFanHealthStatus",
    SourceSYSFanHealthStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSFanRunLevel = enum {
    @ev::rename("0")
    @ev::description("Low", "低")
    Low,
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("High", "高")
    High,
};
def SourceSYSFanRunLevel_domain: v::Domain(SourceSYSFanRunLevel, String) = v::from_enum(
    "SourceSYSFanRunLevel",
    SourceSYSFanRunLevel.type,
    String.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceAssociationSYS_Fan",
        storage::subject,
        parent,
        cardinality
    ),
    r::relation(
        "source_SYS_FanAssociationX_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{SysFan, StorageFanById};
