# ICM model contract tests (icm-model.a3)
#
# These tests drive the dynamic query facade with typed ontology QueryRequests
# and assert the exact lowerings (SQL text + binding order) and determinism.
# Failure behaviour (unknown vocabulary, illegal enums, type errors, grain
# amplification, unsupported target attributes) is covered by the invalid
# intent fixtures under icm-model/testdata/err-*.json and is exercised through
# the fixed-file `bin/make-query check` protocol.

import "@src/model" as model;
import "@src/query" as facade;
import "ontology/edsl" as edsl;
import "ontology/query" as qb;
import "std/value" {ScalarValue};

def subject: String = "analyst";

# ---------------------------------------------------------------------------
# Request builder helpers
# ---------------------------------------------------------------------------

def request_measure: Fn(String) -> edsl.MeasureRequest = fn(id) {
    {id: id, subject: subject, input: 'All}
};

def request_dimension: Fn(String) -> edsl.DimensionRequest = fn(id) {
    {id: id, subject: subject, input: 'None}
};

def filter_eq_text: Fn(String, String) -> edsl.FilterRequest = fn(id, value) {
    {id: id, subject: subject, op: 'Eq, input: 'Text(value)}
};

def filter_eq_int: Fn(String, Int) -> edsl.FilterRequest = fn(id, value) {
    {id: id, subject: subject, op: 'Eq, input: 'Int(value)}
};

# ---------------------------------------------------------------------------
# Assertion helpers (fail the module on mismatch so `check` reports an error)
# ---------------------------------------------------------------------------

def assert_query: Fn(edsl.QueryRequest, String, Array(ScalarValue)) -> Bool = fn(
    request, expected_sql, expected_bindings
) {
    let query: qb.Query = facade.make_query(request);
    if query.sql != expected_sql {
        fail!("query.sql mismatch", query.sql, expected_sql)
    } else if query.bindings != expected_bindings {
        fail!("query.bindings mismatch", query.bindings, expected_bindings)
    } else {
        'True
    }
};

def assert_deterministic: Fn(edsl.QueryRequest) -> Bool = fn(request) {
    let first: qb.Query = facade.make_query(request);
    let second: qb.Query = facade.make_query(request);
    if first == second { 'True } else {
        fail!("query is not deterministic")
    }
};

# ---------------------------------------------------------------------------
# 1. Legal intent: alarm count restricted by device and alarm attributes
# ---------------------------------------------------------------------------

def alarm_count_request: edsl.QueryRequest = {
    measures: [request_measure("AlarmCount")],
    dimensions: [],
    filters: [
        filter_eq_int("AlarmSeverity", 4),
        filter_eq_text("NetworkDeviceName", "core-01"),
    ],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

export def test_alarm_count = assert_query(
    alarm_count_request,
    "SELECT count(a.CSN) AS AlarmCount FROM T_CURRENT_ALARM AS a INNER JOIN EntNetworkElement AS d ON a.MEDN = d.id WHERE (a.SEVERITY = ? AND d.name = ?)",
    ['Int(4), 'String("core-01")],
);

export def test_alarm_count_deterministic = assert_deterministic(alarm_count_request);

# ---------------------------------------------------------------------------
# 2. Legal intent: grouped sub-part count (storage controller by device name)
# ---------------------------------------------------------------------------

def controller_request: edsl.QueryRequest = {
    measures: [request_measure("StorageControllerCount")],
    dimensions: [request_dimension("StorageName")],
    filters: [
        filter_eq_text("StorageSubClass", "HuaweiSmisStorageDevice"),
    ],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

export def test_grouped_subpart_count = assert_query(
    controller_request,
    "SELECT count(p.id) AS StorageControllerCount, d.name FROM SYS_Controller AS p INNER JOIN HuaweiStorageDevice AS d ON p.parentResId = d.id WHERE d.subClassName = ? GROUP BY d.name",
    ['String("HuaweiSmisStorageDevice")],
);

# ---------------------------------------------------------------------------
# 3. Legal intent: KPI aggregate joined to the device table
# ---------------------------------------------------------------------------

def server_cpu_request: edsl.QueryRequest = {
    measures: [request_measure("ServerCpuUsageAvg")],
    dimensions: [],
    filters: [
        filter_eq_text("ServerName", "server-01"),
    ],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

export def test_kpi_aggregate = assert_query(
    server_cpu_request,
    "SELECT avg(k.cpuUsage) AS ServerCpuUsageAvg FROM ServerDeviceKPI AS k INNER JOIN PhysicalServer AS d ON k.resId = d.id WHERE d.name = ?",
    ['String("server-01")],
);

# ---------------------------------------------------------------------------
# 4. Legal intent: ordering + pagination (binding order limit after filter)
# ---------------------------------------------------------------------------

def paged_server_request: edsl.QueryRequest = {
    measures: [request_measure("ServerDeviceCount")],
    dimensions: [request_dimension("ServerName")],
    filters: [
        filter_eq_text("ServerClassification", "ne.category.server.rack"),
    ],
    ordering: [
        {target: 'Dimension("ServerName"), direction: 'Asc},
    ],
    limit: 'Some(10),
    offset: 'Some(5),
    partition: 'None,
};

export def test_ordering_and_pagination = assert_query(
    paged_server_request,
    "SELECT count(d.id) AS ServerDeviceCount, d.name FROM PhysicalServer AS d WHERE d.classification = ? GROUP BY d.name ORDER BY d.name ASC LIMIT ? OFFSET ?",
    ['String("ne.category.server.rack"), 'Int(10), 'Int(5)],
);

# ---------------------------------------------------------------------------
# 5. Legal intent: trend shape (per timestamp rows ordered by time)
# ---------------------------------------------------------------------------

def pon_trend_request: edsl.QueryRequest = {
    measures: [request_measure("PonPortIfOutBandRateAvg")],
    dimensions: [
        request_dimension("PonDeviceName"),
        request_dimension("PonPortKpiTime"),
    ],
    filters: [
        filter_eq_text("PonDeviceIp", "10.4.153.218"),
    ],
    ordering: [
        {target: 'Dimension("PonPortKpiTime"), direction: 'Asc},
    ],
    limit: 'Some(1000),
    offset: 'None,
    partition: 'None,
};

export def test_trend_lowering = assert_query(
    pon_trend_request,
    "SELECT avg(k.ifOutBandRate) AS PonPortIfOutBandRateAvg, d.name, k.ts FROM PonDevicePonPortKPI AS k INNER JOIN EntPonElement AS d ON k.parentId = d.id WHERE d.ipAddress = ? GROUP BY d.name, k.ts ORDER BY k.ts ASC LIMIT ?",
    ['String("10.4.153.218"), 'Int(1000)],
);

# ---------------------------------------------------------------------------
# 6. Legal intent: Top Per Group (partition) with stable ordering
# ---------------------------------------------------------------------------

def server_cpu_top_request: edsl.QueryRequest = {
    measures: [request_measure("ServerCpuUsageAvg")],
    dimensions: [
        request_dimension("ServerName"),
        request_dimension("ServerKpiTime"),
    ],
    filters: [],
    ordering: [
        {target: 'Measure("ServerCpuUsageAvg"), direction: 'Desc},
        {target: 'Dimension("ServerKpiTime"), direction: 'Asc},
    ],
    limit: 'None,
    offset: 'None,
    partition: 'Some({by: ["ServerName"], take: 3}),
};

export def test_top_per_group = assert_query(
    server_cpu_top_request,
    "SELECT ServerCpuUsageAvg, __q_1, __q_2 FROM (SELECT avg(k.cpuUsage) AS ServerCpuUsageAvg, d.name AS __q_1, k.ts AS __q_2, row_number() OVER (PARTITION BY d.name ORDER BY avg(k.cpuUsage) DESC, k.ts ASC) AS __q_rn FROM ServerDeviceKPI AS k INNER JOIN PhysicalServer AS d ON k.resId = d.id GROUP BY d.name, k.ts) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_1 ASC, ServerCpuUsageAvg DESC, __q_2 ASC",
    ['Int(3)],
);

