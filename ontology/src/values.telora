# 可复用业务值域与源编码映射；只准备 transform 所需的离散值语义。
use crate::model as m;
use crate::property_contract as contract;
use crate::enum_values as ev;
use std::type_property as property;
use std::prelude as prelude;
use std::fmt as fmt;
use crate::groups as g;
use crate::ontology as edsl;
use crate::query as qb;
use std::dict as dict;
use std::pipeline as pipeline;
use std::json as json;
use std::array as array;
use std::codec as codec;
use std::type_desc as td;
use std::value::{Value};

type Member(Business, Wire) = struct {
    value: Business,
    wires: Array(Wire)
};
type DefinitionInput = struct {
    id: String,
    value: Type,
    wire: Type,
    values: Array(edsl::CanonicalValueSpec),
    half_open: Bool,
    order: Array(String)
};
type Definition = struct {
    bindings: Dict(Array(qb::Val)),
    id: String,
    value: Type,
    wire: Type,
    values: Array(edsl::CanonicalValueSpec),
    half_open: Bool,
    order: Array(String)
};
type Domain(Business, Wire) = struct {
    definition: Definition
};
type DimensionGroup(Business, Wire) = struct {
    definition: Definition,
    projectable: Bool,
    filters: Array(g::Filter)
};
type Binding(Row) = struct {
    row: Type,
    dataset: String,
    source: String,
    column: g::Column,
    nullable: Bool,
    definition: Definition,
    group_projectable: Bool,
    group_filters: Array(g::Filter),
    id: String,
    projectable: Bool,
    filters: Array(g::Filter)
};
type BindingFacts = struct {
    row: Type,
    dataset: String,
    source: String,
    column: g::Column,
    nullable: Bool,
    definition: Definition,
    group_projectable: Bool,
    group_filters: Array(g::Filter),
    id: String,
    projectable: Bool,
    filters: Array(g::Filter)
};
def member: for(Business, Wire) Fn(Business, Array(Wire)) -> Member(Business, Wire) = fn(
    value,
    wires
) {
    {value, wires}
};
def valid_business_type: Fn(Type) -> Bool = fn(value) {
    let storage = g::representation(value);
    storage == String.type || (
        storage != Bool.type && td::kind(storage) == td::TypeDescKind::Enum && array::all(
            td::variants(storage),
            fn(variant) {
                variant.payload == None
            }
        )
    )
};
def prepare_definition: Fn(DefinitionInput) -> Definition = fn(definition) {
    let storage = g::representation(definition.wire);
    if definition.id == "" {
        fail!("business domain requires a name and text-valued business type", definition.id)
    } else if storage != Int.type && storage != String.type {
        fail!("business domain wire must use integer or text storage", definition.id)
    } else if definition.half_open && storage != String.type {
        fail!("half-open business domain requires text wire storage", definition.id)
    } else if array::length(definition.values) == 0 {
        fail!("business domain must declare known members", definition.id)
    } else {
        ()
    };
    let bindings = pipeline::run(
        pipeline::from_array(definition.values) |> pipeline::unique_by(
            fn(value) {
                value.id
            }
        ) |> pipeline::map(
            fn(value) {
                if value.id == "" || value.wires == [] {
                    fail!(
                        "business domain member ids must be nonempty and have wire values",
                        definition.id,
                        value.id
                    )
                } else {
                    ()
                };
                (
                    value.id,
                    array::map(
                        value.wires,
                        fn(wire) {
                            match wire {
                                edsl::FilterInput::Text(text) => if storage == String.type && text != "" {
                                    qb::Val::String(text)
                                } else {
                                    fail!(
                                        "business domain wire does not match its declared type",
                                        definition.id,
                                        value.id
                                    )
                                },
                                edsl::FilterInput::Int(number) => if storage == Int.type {
                                    qb::Val::Int(number)
                                } else {
                                    fail!(
                                        "business domain wire does not match its declared type",
                                        definition.id,
                                        value.id
                                    )
                                },
                                _ => fail!(
                                    "business domain wire does not match its declared type",
                                    definition.id,
                                    value.id
                                )
                            }
                        }
                    )
                )
            }
        ) |> pipeline::collect_dict(
            fn(member) {
                member.0
            },
            fn(member) {
                member.1
            }
        )
    );
    # wire 的跨成员唯一性属于 Domain 首次形成完整集合时的约束。
    let wires = array::flat_map(
        definition.values,
        fn(value) {
            value.wires
        }
    );
    pipeline::run(
        pipeline::from_array(wires) |> pipeline::unique_by(
            fn(wire) {
                json::stringify(codec::encode(wire))
            }
        ) |> pipeline::collect()
    );
    prepare_order(
        {
            id: definition.id,
            value: definition.value,
            wire: definition.wire,
            values: definition.values,
            half_open: definition.half_open,
            order: definition.order,
            bindings
        }
    )
};

def prepare_order: Fn(Definition) -> Definition = fn(definition) {
    if definition.half_open && definition.order != [] {
        fail!("half-open business domain cannot declare a closed order", definition.id)
    } else if definition.order != [] && (
        array::length(definition.order) != array::length(definition.values) || !array::all(
            definition.values,
            fn(value) {
                array::length(
                    array::filter(
                        definition.order,
                        fn(id) {
                            id == value.id
                        }
                    )
                ) == 1
            }
        )
    ) {
        fail!("business domain order must name every known member exactly once", definition.id)
    } else {
        definition
    }
};
def domain: for(Business: codec::Encode, Wire: codec::Encode) Fn(
    String,
    TypeOf(Business),
    TypeOf(Wire),
    Array(Member(Business, Wire)),
    Bool
) -> Domain(Business, Wire) = fn(id, business, wire, members, half_open) {
    if !valid_business_type(business) {
        fail!("business domain requires a text-valued business type", id)
    } else {
        ()
    };
    let values = array::map(
        members,
        fn(member) {
            let name = match codec::encode(member.value) {
                Value::String(value) => value,
                _ => fail!("business value must encode to a text id", id)
            };
            let wires = array::map(
                member.wires,
                fn(value) {
                    match codec::encode(value) {
                        Value::String(text) => edsl::FilterInput::Text(text),
                        Value::Int(number) => edsl::FilterInput::Int(number),
                        _ => fail!("business wire must encode to integer or text", id),
                    }
                }
            );
            {id: name, label: name, wires}.ty!(edsl::CanonicalValueSpec)
        }
    );
    {definition: prepare_definition({id, value: business, wire, values, half_open, order: []})}
};
def ordered: for(Business: codec::Encode, Wire) Fn(
    Domain(Business, Wire),
    Array(Business)
) -> Domain(Business, Wire) = fn(domain, order) {
    let ids = array::map(
        order,
        fn(value) {
            match codec::encode(value) {
                Value::String(id) => id,
                _ => fail!("business order requires text ids", domain.definition.id)
            }
        }
    );
    {definition: prepare_order(domain.definition <~ {order: ids})}
};
def validate_filters: Fn(Array(g::Filter)) -> () = fn(filters) {
    if !array::all(
        filters,
        fn(op) {
            (op == g::Filter::Eq || op == g::Filter::Ne) && array::length(
                array::filter(
                    filters,
                    fn(other) {
                        other == op
                    }
                )
            ) == 1
        }
    ) {
        fail!("business domain filters support distinct Eq and Ne only")
    } else {
        ()
    }
};
def dimension_group: for(Business, Wire) Fn(
    Domain(Business, Wire),
    Bool,
    Array(g::Filter)
) -> DimensionGroup(Business, Wire) = fn(domain, projectable, filters) {
    validate_filters(filters);
    {definition: domain.definition, projectable, filters}
};
def bind: for(Row, Business, Wire) Fn(
    m::Dataset(Row),
    DimensionGroup(Business, Wire),
    g::Expr(Row, Wire),
    String,
    Bool,
    Array(g::Filter)
) -> Binding(Row) = fn(dataset, group, source, id, projectable, filters) {
    contract::publish_name(id);
    if (projectable && !group.projectable) || !array::all(
        filters,
        fn(op) {
            array::any(
                group.filters,
                fn(allowed) {
                    allowed == op
                }
            )
        }
    ) {
        fail!("business binding cannot expand group capabilities", id)
    } else {
        ()
    };
    let column = match source.node {
        g::Node::Column(column) => column,
        _ => fail!("business binding requires a direct column", id)
    };
    {
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        column,
        nullable: source.nullable,
        definition: group.definition,
        group_projectable: group.projectable,
        group_filters: group.filters,
        id,
        projectable,
        filters
    }
};
def binding_facts: for(Row) Fn(Binding(Row)) -> BindingFacts = fn(binding) {
    {
        row: binding.row,
        dataset: binding.dataset,
        source: binding.source,
        column: binding.column,
        nullable: binding.nullable,
        definition: binding.definition,
        group_projectable: binding.group_projectable,
        group_filters: binding.group_filters,
        id: binding.id,
        projectable: binding.projectable,
        filters: binding.filters
    }
};
# 名义业务成员条件；仅支持直接列，源编码由已声明值域解析。
type MemberPredicate = struct {
    binding: BindingFacts,
    wires: Array(qb::Val),
    member: String
};
def member_predicate: for(Row, Business: codec::Encode) Fn(
    Binding(Row),
    Business
) -> MemberPredicate = fn(binding, member) {
    let id = match codec::encode(member) {
        Value::String(value) => value,
        _ => fail!("business predicate member must encode to text", binding.id)
    };
    if !array::any(
        binding.filters,
        fn(op) {
            op == g::Filter::Eq
        }
    ) {
        fail!("business predicate requires equality filter capability", binding.id)
    } else {
        ()
    };
    match dict::get(binding.definition.bindings, id) {
        None => fail!("business predicate requires a declared member", binding.id, id),
        Some(wires) => {binding: binding_facts(binding), member: id, wires}
    }
};
def prepare_predicate: Fn(
    m::PreparedDataset,
    Array(BindingFacts),
    MemberPredicate
) -> edsl::PreparedMeasurePredicate = fn(dataset, declared, predicate) {
    if !array::any(
        declared,
        fn(binding) {
            binding == predicate.binding
        }
    ) {
        fail!("business predicate requires its declared dimension binding", predicate.binding.id)
    } else {
        {
            scope: lower_predicate(predicate),
            wires: predicate.wires,
            column: predicate.binding.column.name
        }
    }
};
def lower_predicate: Fn(MemberPredicate) -> edsl::ScopePredicate = fn(predicate) {
    {
        field: predicate.binding.column.name,
        op: edsl::FilterOp::Eq,
        input: edsl::FilterInput::Text(predicate.member)
    }
};
pub use self::{
    MemberPredicate,
    member_predicate,
    prepare_predicate,
    lower_predicate,
    Member,
    Definition,
    Domain,
    DimensionGroup,
    Binding,
    BindingFacts,
    member,
    domain,
    ordered,
    dimension_group,
    bind,
    binding_facts
};

# 显式严格构造，用于诊断和检查需要立即拒绝的调用方。
# 编码来自 variant property；Domain 只是 transform 的准备描述。
def from_enum: for(Business, Wire) Fn(
    String,
    TypeOf(Business),
    TypeOf(Wire),
    Bool
) -> Domain(Business, Wire) = fn(id, business, wire, half_open) {
    let values = ev::members(business);
    let order = if property::get_type_prop(business, ev::OrderByITag.type) != None {
        if wire != Int.type {
            fail!("order_by_itag requires integer storage", id)
        } else {
            ()
        };
        let tagged = array::map(
            values,
            fn(value) {
                if array::length(value.wires) != 1 {
                    fail!("ordered variant requires exactly one integer tag", id, value.id)
                } else {
                    ()
                };
                match value.wires[0] {
                    edsl::FilterInput::Int(tag) => (tag, value.id),
                    _ => fail!("ordered variant requires exactly one integer tag", id, value.id),
                }
            }
        );
        let sorted = array::fold(
            tagged,
            [].ty!(Array((Int, String))),
            fn(items, item) {
                array::concat(
                    [
                        array::filter(
                            items,
                            fn(p) {
                                p.0 < item.0
                            }
                        ),
                        [item],
                        array::filter(
                            items,
                            fn(p) {
                                p.0 >= item.0
                            }
                        )
                    ]
                )
            }
        );
        array::map(
            sorted,
            fn(item) {
                item.1
            }
        )
    } else {
        []
    };
    {definition: prepare_definition({id, value: business, wire, values, half_open, order})}
};
pub use self::{from_enum};
# 源字段的已知原始值是局部约束，不为它们制造领域类型。
def raw_ints: Fn(String, Array(Int)) -> Domain(String, Int) = fn(id, values) {
    domain(
        id,
        String.type,
        Int.type,
        array::map(
            values,
            fn(value) {
                member(fmt::to_string(value), [value])
            }
        ),
        False
    )
};
def raw_texts: Fn(String, Array(String)) -> Domain(String, String) = fn(id, values) {
    domain(
        id,
        String.type,
        String.type,
        array::map(
            values,
            fn(value) {
                member(value, [value])
            }
        ),
        False
    )
};
pub use self::{raw_ints, raw_texts};

# 字段上的业务值域声明同时支撑 transform 与知识发布。
@prelude::property(PropertyTarget::Field)
type FieldDomains = struct {
    dimensions: Array(FieldDomain)
};
type FieldDomain = struct {
    definition: Definition,
    id: String,
    projectable: Bool,
    filters: Array(g::Filter)
};
def field_domain: for(Business, Wire) Fn(
    Domain(Business, Wire),
    String,
    Bool,
    Array(g::Filter)
) -> Fn(property::FieldPropertyCtx, Option(FieldDomains)) -> FieldDomains = fn(
    domain,
    id,
    projectable,
    filters
) {
    contract::publish_name(id);
    validate_filters(filters);
    fn(ctx, previous) {
        if ctx.ty != Wire.type && ctx.ty != Option(Wire).type {
            fail!("field domain has incompatible storage type", ctx.name)
        } else {
            ()
        };
        let before = match previous {
            Some(p) => p.dimensions,
            None => []
        };
        {
            dimensions: array::push(
                before,
                {definition: domain.definition, id, projectable, filters}.ty!(FieldDomain)
            )
        }
    }
};
def classification: for(Business, Wire) Fn(
    Domain(Business, Wire),
    String
) -> Fn(property::FieldPropertyCtx, Option(FieldDomains)) -> FieldDomains = fn(domain, id) {
    field_domain(domain, id, True, g::equality_filters)
};
def field_bindings: Fn(m::PreparedDataset) -> Array(BindingFacts) = fn(dataset) {
    array::flat_map(
        m::fields_of(dataset.row),
        fn(field) {
            match property::get_field_prop(dataset.row, field.index, FieldDomains.type) {
                None => [],
                Some(declared) => array::map(
                    declared.dimensions,
                    fn(spec) {
                        let nullable = field.ty != spec.definition.wire;
                        let column: g::Column = {
                            index: field.index,
                            name: field.name,
                            value: spec.definition.wire,
                            nullable
                        };
                        {
                            row: dataset.row,
                            dataset: dataset.id,
                            source: dataset.source,
                            column,
                            nullable,
                            definition: spec.definition,
                            group_projectable: spec.projectable,
                            group_filters: spec.filters,
                            id: spec.id,
                            projectable: spec.projectable,
                            filters: spec.filters
                        }.ty!(BindingFacts)
                    }
                )
            }
        }
    )
};
pub use self::{FieldDomains, FieldDomain, field_domain, classification, field_bindings};

# 字段 property 是已验证边界；引用只按字段索引与发布名定位。
def dimension_of: for(Row, Wire) Fn(m::Dataset(Row), m::Field(Row, Wire), String) -> Binding(Row) = fn(
    dataset,
    field,
    id
) {
    let dimensions = match property::get_field_prop(Row.type, field.index, FieldDomains.type) {
        Some(value) => value.dimensions,
        None => []
    };
    let spec = match array::find(
        dimensions,
        fn(value) {
            value.id == id
        }
    ) {
        Some(value) => value,
        None => fail!("field has no declared domain dimension", field.name, id)
    };
    {
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        column: {
            index: field.index,
            name: field.name,
            value: spec.definition.wire,
            nullable: field.nullable
        },
        nullable: field.nullable,
        definition: spec.definition,
        group_projectable: spec.projectable,
        group_filters: spec.filters,
        id: spec.id,
        projectable: spec.projectable,
        filters: spec.filters
    }
};
pub use self::{dimension_of};
