    @g::field_view(g::dimension_group("kpi-server-device/gpu_temperature_avg", metric::KpiServerDeviceGpuTemperatureAvg.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sede_gpu_temperature_avg_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
