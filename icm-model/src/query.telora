# ICM dynamic query facade (icm-model.a3)
#
# The facade turns a typed ontology request into a parameterized QueryBuilder
# Query through the model knowledge payload.  It is the single dynamic-query
# entry consumed by bin/make-query and by contract tests.
#
# `Intent` is the wire format used by bin/make-query: it mirrors the ontology
# QueryRequest fields and additionally carries:
#   - any_of: OR-group value filters (ontology lower_any);
#   - exists: correlated existence predicates (optional min_matches / any_of);
#   - having: group predicates;
#   - group_count: optional mode switching lowering to the nested
#     "count of groups passing HAVING" shape (ontology lower_group_count).
# A request whose `measures` is empty is a measure-less row projection /
# listing request.

import "@src/model" as model;
import "ontology/edsl" as edsl;
import "ontology/query" as qb;
import "std/array" as array;

# Marker for the nested "count of groups passing HAVING" lowering.
type GroupCountMode = enum { 'CountGroups };

# Generic time-window provenance contract (applies to KPI sampling and alarm
# time dimensions alike).
#   - 'Direct:        the caller/user supplied the absolute [start, end) bounds
#                     directly; no external reference moment is needed.
#   - 'FixedWindow:   the bounds were converted from a fixed-duration relative
#                     phrase ("近7天"/"最近30天").
#   - 'Calendar:      the bounds were converted from a natural calendar period
#                     ("本月"/"昨天"/"今天").
# Trust boundary: the report reference moment is NOT taken from the Intent.  It
# must be injected by the Host/caller as an external, Resolver-unwritable
# context (`trusted` passed to make_intent_query_context / apply_time_windows).
# The optional `reference` on a TimeWindowSpec is only an untrusted self-report;
# a relative (FixedWindow/Calendar) window fails deterministically when no
# trusted context is provided, even if it carries a self-reported reference, and
# when a trusted context is present any self-report must equal it.  Direct
# absolute bounds never need a context.
type TimeWindowKind = enum { 'Direct, 'FixedWindow, 'Calendar };

type TimeWindowSpec = struct {
    dimension: String,
    subject: String,
    kind: TimeWindowKind,
    start: String,
    end: String,
    reference: Option(String),
};

type Intent = struct {
    measures: Array(edsl.MeasureRequest),
    dimensions: Array(edsl.DimensionRequest),
    filters: Array(edsl.FilterRequest),
    any_of: Array(edsl.AnyOfRequest),
    ordering: Array(edsl.OrderRequest),
    limit: Option(Int),
    offset: Option(Int),
    partition: Option(edsl.PartitionRequest),
    exists: Array(edsl.ExistsRequest),
    having: Array(edsl.HavingRequest),
    group_count: Option(GroupCountMode),
    # Optional provenance of time-dimension windows.  Absent/null means every
    # time-dimension filter in `filters` is a directly supplied absolute bound.
    time_windows: Option(Array(TimeWindowSpec)),
    # Optional paired-endpoint (peer) filters over a dual-end hub base (e.g.
    # "links between two specified devices"); lower via ontology lower_peer.
    peers: Option(Array(edsl.PeerRequest)),
};

def intent_to_request: Fn(Intent) -> edsl.QueryRequest = fn(intent) {
    let request: edsl.QueryRequest = {
        measures: intent.measures,
        dimensions: intent.dimensions,
        filters: intent.filters,
        ordering: intent.ordering,
        limit: intent.limit,
        offset: intent.offset,
        partition: intent.partition,
    };
    request
};

def intent_from_request: Fn(edsl.QueryRequest) -> Intent = fn(request) {
    let intent: Intent = {
        measures: request.measures,
        dimensions: request.dimensions,
        filters: request.filters,
        any_of: [],
        ordering: request.ordering,
        limit: request.limit,
        offset: request.offset,
        partition: request.partition,
        exists: [],
        having: [],
        group_count: 'None,
        time_windows: 'None,
        peers: 'None,
    };
    intent
};

# Shape validation of one time window (deterministic; no partial output).
# NOTE: the window's own `reference`, if present, is an *untrusted* self-report.
# Trust comes only from the external Host-injected context checked by
# `time_context_ok`; a self-reported reference never enables compilation alone.
def validate_time_window: Fn(TimeWindowSpec) -> Bool = fn(window) {
    if window.start >= window.end {
        fail!("time window start must be strictly before its end", window.dimension, window.start, window.end)
    } else {
        match window.kind {
            'Direct => 'True,
            'FixedWindow => 'True,
            'Calendar => 'True,
        }
    }
};

# Trust-boundary check for relative time windows.  A relative window
# (FixedWindow/Calendar) only compiles when an external trusted reference is
# injected by the Host/caller (trusted != 'None); an Intent-embedded self-report
# without that external context is not trusted.  When the trusted context is
# present, any self-reported reference must be strictly equal to it.  This is a
# pure decision predicate (testable); apply_time_windows fails on False.
def time_context_ok: Fn(Option(Array(TimeWindowSpec)), Option(String)) -> Bool = fn(windows, trusted) {
    match windows {
        'None => 'True,
        'Some(ws) => array.all(ws, fn(w) {
            match w.kind {
                'Direct => 'True,
                'FixedWindow => match trusted {
                    'Some(c) => match w.reference {
                        'Some(r) => r == c,
                        'None => 'True,
                    },
                    'None => 'False,
                },
                'Calendar => match trusted {
                    'Some(c) => match w.reference {
                        'Some(r) => r == c,
                        'None => 'True,
                    },
                    'None => 'False,
                },
            }
        }),
    }
};

# Compile one validated time window into the two half-open absolute text filters
# (Ge start / Lt end) on its declared time dimension.  Bounds stay parameterised.
def time_window_to_filters: Fn(TimeWindowSpec) -> Array(edsl.FilterRequest) = fn(window) {
    let lo: edsl.FilterRequest = {
        id: window.dimension,
        subject: window.subject,
        op: 'Ge,
        input: 'Text(window.start),
    };
    let hi: edsl.FilterRequest = {
        id: window.dimension,
        subject: window.subject,
        op: 'Lt,
        input: 'Text(window.end),
    };
    [lo, hi]
};

# --- unified-device vocabulary routing ------------------------------------
# Requests that reference the unified five-domain device entity are lowered
# against `device_payload`; everything else uses the main `payload`.

def request_uses_device_measure: Fn(edsl.MeasureRequest) -> Bool = fn(m) {
    m.id == "DeviceCount"
};
def request_uses_device_dimension: Fn(edsl.DimensionRequest) -> Bool = fn(d) {
    d.id == "DeviceTenantId" || d.id == "DeviceSiteId"
};
def request_uses_device_filter: Fn(edsl.FilterRequest) -> Bool = fn(f) {
    f.id == "DeviceTenantId" || f.id == "DeviceSiteId"
};
def request_uses_device_order: Fn(edsl.OrderRequest) -> Bool = fn(o) {
    match o.target {
        'Dimension(name) => name == "DeviceTenantId" || name == "DeviceSiteId",
        'Measure(_) => 'False,
    }
};
def request_uses_device_having: Fn(edsl.HavingRequest) -> Bool = fn(h) {
    h.measure == "DeviceCount"
};
def intent_uses_device: Fn(Intent) -> Bool = fn(intent) {
    array.any(intent.measures, request_uses_device_measure)
        || array.any(intent.dimensions, request_uses_device_dimension)
        || array.any(intent.filters, request_uses_device_filter)
        || array.any(intent.ordering, request_uses_device_order)
        || array.any(intent.having, request_uses_device_having)
};

def select_payload: Fn(Intent) -> edsl.PreparedPayload = fn(intent) {
    if intent_uses_device(intent) {
        model.device_payload
    } else {
        model.payload
    }
};

# ---------------------------------------------------------------------------
# Alarm-anchored requests and site/tenant governance dimensions.
#
# The alarm table references devices of several domains through one MEDN key.
# Routing an alarm-anchored request to the governance (site/tenant) object
# would have to map every alarm to exactly one device domain; the knowledge
# layer resolves the join deterministically to a single device table, which
# silently narrows the object domain and misanswers alarms of other domains.
#
# Policy (deterministic, no silent narrowing):
#   - when the base object is the alarm entity and the request references a
#     governance dimension (SiteName/SiteId/TenantName/TenantId/TenantIndustry),
#     the request must carry an explicit device anchor whose dimensions belong
#     to exactly one device domain that the governance route may use; v1 allows
#     the network-device domain only (the deterministic route).  Requests with
#     no anchor, or with anchors from other/multiple device domains, are
#     rejected with a deterministic diagnostic.  These queries should be
#     expressed device-side (device measure/dimension + exists(alarm)) after
#     domain clarification.
#   - all other alarm-anchored requests (alarm filters/lists/counts using the
#     alarm's own dimensions, or per-device-domain filters) keep working.
# ---------------------------------------------------------------------------

def governance_dim_ids: Array(String) = ["SiteName", "SiteId", "TenantName", "TenantId", "TenantIndustry"];

def is_governance_dim: Fn(String) -> Bool = fn(id) {
    array.any(governance_dim_ids, fn(g) { g == id })
};

def entity_index_by_id: Fn(Array(edsl.EntityEntry), String) -> Option(Int) = fn(entities, id) {
    match array.find(entities, fn(e) { e.id == id }) {
        'Some(e) => 'Some(e.index),
        'None => 'None,
    }
};

def dimension_entity_of: Fn(Array(edsl.DimensionEntry), String) -> Option(Int) = fn(dims, id) {
    match array.find(dims, fn(d) { d.id == id }) {
        'Some(d) => 'Some(d.entity),
        'None => 'None,
    }
};

def referenced_dimension_ids: Fn(Intent) -> Array(String) = fn(intent) {
    let from_dims = array.map(intent.dimensions, fn(d) { d.id });
    let from_filters = array.map(intent.filters, fn(f) { f.id });
    let from_any = array.map(intent.any_of, fn(a) { a.id });
    let from_ordering = array.flat_map(intent.ordering, fn(o) {
        match o.target {
            'Dimension(id) => [id],
            'Measure(_) => [],
        }
    });
    array.concat([from_dims, from_filters, from_any, from_ordering])
};

def guard_alarm_site_tenant: Fn(Intent, edsl.PreparedPayload) -> Bool = fn(intent, payload) {
    let first_measure = array.get(intent.measures, 0);
    let first_dim = array.get(intent.dimensions, 0);
    let base_entity = match first_measure {
        'Some(m) => match array.find(payload.measures, fn(me) { me.id == m.id }) {
            'Some(me) => 'Some(me.entity),
            'None => 'None,
        },
        'None => match first_dim {
            'Some(d) => dimension_entity_of(payload.dimensions, d.id),
            'None => 'None,
        },
    };
    let alarm_entity = entity_index_by_id(payload.entities, "alarm");
    match (base_entity, alarm_entity) {
        ('Some(b), 'Some(a)) => if b != a {
            'True
        } else {
            let referenced = referenced_dimension_ids(intent);
            if !array.any(referenced, is_governance_dim) {
                'True
            } else {
                let net_entity = entity_index_by_id(payload.entities, "net_device");
                let non_gov_entities = array.flat_map(referenced, fn(id) {
                    if is_governance_dim(id) {
                        []
                    } else {
                        match dimension_entity_of(payload.dimensions, id) {
                            'Some(e) => if e == a { [] } else { [e] },
                            'None => [],
                        }
                    }
                });
                let anchors = array.fold(non_gov_entities, [], fn(acc, e) {
                    if array.any(acc, fn(x) { x == e }) { acc } else { array.push(acc, e) }
                });
                match net_entity {
                    'Some(n) => if array.length(anchors) == 0 {
                        fail!(
                            "alarm-anchored site/tenant query requires an explicit device-domain anchor",
                            intent,
                        )
                    } else if array.all(anchors, fn(e) { e == n }) {
                        'True
                    } else {
                        fail!(
                            "alarm-anchored site/tenant query is ambiguous across device domains; anchor a single device domain (network supported in v1) or query device-side",
                            intent,
                        )
                    },
                    'None => fail!("alarm-anchored site/tenant query requires an explicit device-domain anchor", intent),
                }
            }
        },
        _ => 'True,
    }
};

# ---------------------------------------------------------------------------
# Business status value -> storage code compilation (three-layer mapping).
#
# The public contract (DOMAIN.md section 3) exposes only *business* status
# values ("在线"/"离线"/"正常").  The Resolver never sees storage codes and
# does not choose which representation to send.  This layer deterministically
# compiles each business value on a status dimension to the storage text the
# source column stores before lowering, so the final SQL binding is the true
# storage value.  Unknown business values are rejected deterministically, as
# are non-text inputs; wrong operators and wrong types keep their
# ontology-level rejections (status enum dimensions support Eq with Text).
# ---------------------------------------------------------------------------

def commu_dim_ids: Array(String) = [
    "NetworkDeviceCommuState",
    "PonDeviceCommuState",
    "ServerCommuState",
    "StorageCommuState",
    "TerminalCommuState",
    "CollabCommuState",
];

def run_health_dim_ids: Array(String) = [
    "StorageRunningStatus",
    "StorageHealthStatus",
];

def is_commu_dim: Fn(String) -> Bool = fn(id) { array.any(commu_dim_ids, fn(d) { d == id }) };
def is_run_health_dim: Fn(String) -> Bool = fn(id) { array.any(run_health_dim_ids, fn(d) { d == id }) };
def is_status_dim: Fn(String) -> Bool = fn(id) { is_commu_dim(id) || is_run_health_dim(id) };

def commu_storage_code: Fn(String) -> Option(String) = fn(business) {
    if business == "在线" { 'Some("0") }
    else if business == "离线" { 'Some("1") }
    else { 'None }
};
def normal_storage_code: Fn(String) -> Option(String) = fn(business) {
    if business == "正常" { 'Some("1") }
    else { 'None }
};
def status_storage_code: Fn(String, String) -> Option(String) = fn(dim, business) {
    if is_commu_dim(dim) {
        commu_storage_code(business)
    } else if is_run_health_dim(dim) {
        normal_storage_code(business)
    } else {
        'None
    }
};

def map_status_filter: Fn(edsl.FilterRequest) -> edsl.FilterRequest = fn(filter) {
    if is_status_dim(filter.id) {
        match filter.input {
            'Text(business) => match status_storage_code(filter.id, business) {
                'Some(code) => do {
                    let mapped: edsl.FilterRequest = {
                        id: filter.id,
                        subject: filter.subject,
                        op: filter.op,
                        input: 'Text(code),
                    };
                    mapped
                },
                'None => fail!("unknown business value for status dimension", filter.id, business),
            },
            _ => fail!("status dimension filter input must be text", filter.id, filter.input),
        }
    } else {
        filter
    }
};

def map_status_any_of_value: Fn(String, edsl.FilterInput) -> edsl.FilterInput = fn(dim, value) {
    if is_status_dim(dim) {
        match value {
            'Text(business) => match status_storage_code(dim, business) {
                'Some(code) => 'Text(code),
                'None => fail!("unknown business value for status dimension", dim, business),
            },
            _ => fail!("status dimension filter input must be text", dim, value),
        }
    } else {
        value
    }
};

def map_status_any_of: Fn(edsl.AnyOfRequest) -> edsl.AnyOfRequest = fn(any_of) {
    if is_status_dim(any_of.id) {
        let values = array.map(any_of.values, fn(v) { map_status_any_of_value(any_of.id, v) });
        let mapped: edsl.AnyOfRequest = {
            id: any_of.id,
            subject: any_of.subject,
            values,
        };
        mapped
    } else {
        any_of
    }
};

def map_status_exists: Fn(edsl.ExistsRequest) -> edsl.ExistsRequest = fn(exists) {
    let filters = array.map(exists.filters, map_status_filter);
    let any_of = array.map(exists.any_of, map_status_any_of);
    let mapped: edsl.ExistsRequest = {
        target: exists.target,
        subject: exists.subject,
        filters,
        any_of,
        min_matches: exists.min_matches,
    };
    mapped
};

def normalize_status_intent: Fn(Intent) -> Intent = fn(intent) {
    let mapped: Intent = {
        measures: intent.measures,
        dimensions: intent.dimensions,
        filters: array.map(intent.filters, map_status_filter),
        any_of: array.map(intent.any_of, map_status_any_of),
        ordering: intent.ordering,
        limit: intent.limit,
        offset: intent.offset,
        partition: intent.partition,
        exists: array.map(intent.exists, map_status_exists),
        having: intent.having,
        group_count: intent.group_count,
        time_windows: intent.time_windows,
        peers: intent.peers,
    };
    mapped
};

# Compile the declared time-window provenance into ordinary half-open absolute
# time filters.  `trusted` is the external, Resolver-unwritable reference
# context injected by the Host/caller.  Relative (FixedWindow/Calendar) windows
# require a trusted context (and, when they self-report a reference, it must
# equal the trusted value); otherwise compilation fails deterministically.
# Only after this trust check do the absolute bounds enter the request as
# Ge/Lt parameterised filters.
def apply_time_windows: Fn(Intent, Option(String)) -> Intent = fn(intent, trusted) {
    match intent.time_windows {
        'None => intent,
        'Some(windows) => do {
            if !time_context_ok(intent.time_windows, trusted) {
                fail!(
                    "relative time window requires an external trusted report reference (Host-injected context); Intent self-reported reference is not trusted",
                    intent,
                )
            } else {
                let _validated: Array(Bool) = array.map(windows, validate_time_window);
                let extra = array.flat_map(windows, time_window_to_filters);
                let mapped: Intent = {
                    measures: intent.measures,
                    dimensions: intent.dimensions,
                    filters: array.concat([intent.filters, extra]),
                    any_of: intent.any_of,
                    ordering: intent.ordering,
                    limit: intent.limit,
                    offset: intent.offset,
                    partition: intent.partition,
                    exists: intent.exists,
                    having: intent.having,
                    group_count: intent.group_count,
                    time_windows: 'None,
                    peers: intent.peers,
                };
                mapped
            }
        }
    }
};

# Lower a plain QueryRequest (measure-less or aggregated) to a Query.
# The plain request carries no trusted time context, so relative time windows
# cannot be present (they would fail deterministically at apply_time_windows).
def make_query: Fn(edsl.QueryRequest) -> qb.Query = fn(request) {
    let intent: Intent = apply_time_windows(normalize_status_intent(intent_from_request(request)), 'None);
    let payload: edsl.PreparedPayload = select_payload(intent);
    let _guarded: Bool = guard_alarm_site_tenant(intent, payload);
    let plan: qb.Plan = edsl.lower(payload, intent_to_request(intent));
    qb.transform_sqlite(plan)
};

# Lower a full Intent without a trusted time context (used by callers that do
# not have a Host-injected reference; relative windows fail deterministically).
def make_intent_query: Fn(Intent) -> qb.Query = fn(intent) {
    make_intent_query_context(intent, 'None)
};

# ---------------------------------------------------------------------------
# Peer-mode geometry validation.
#
# The peer slice ("two specified participants at the two ends of the same hub
# row") lowers through ontology `lower_peer`.  A participant side may be
# entity-only (key = 'None, filters = []), attribute-filtered, exact-key, or a
# key+attribute mix - all the same peer semantics family (type-only pairs like
# "a network device and a storage device at opposite ends" are entity-only
# PeerRequests).  Before lowering we deterministically reject every peer-mode
# shape that cannot be expressed by a single PeerRequest, so user constraints
# are never silently dropped:
#   - any non-empty any_of / exists / having list;
#   - an active group_count mode;
#   - a peers list that is not exactly one PeerRequest;
#   - self-pair (same entity and same exact key);
#   - unsupported participant pairs (terminal/collab/unknown entities, or a
#     device-id participant paired with a port-DN participant).
# Ordinary base filters, ordering, limit and offset are preserved as plain
# QueryRequest fields.  `peer_mode_issue` is a pure decision predicate so
# contract tests can assert each rejection without triggering a failure.
# ---------------------------------------------------------------------------

def is_device_peer_entity: Fn(String) -> Bool = fn(entity) {
    entity == "net_device" || entity == "pon_device"
        || entity == "server_device" || entity == "storage_device"
};

# Participant-pair surface of the peer routes declared on the physical-link hub
# (keep aligned with the @edsl.peer_hub declarations in @src/model).  The four
# device domains pair on device keys (aNeResId/zNeResId); network ports pair
# only with ports on port DNs (aPortDn/zPortDn); terminal/collaboration devices
# have no declared peer route.
def peer_pair_supported: Fn(String, String) -> Bool = fn(origin, peer) {
    let port_side: Bool = origin == "net_port" || peer == "net_port";
    if port_side {
        origin == "net_port" && peer == "net_port"
    } else {
        is_device_peer_entity(origin) && is_device_peer_entity(peer)
    }
};

def peer_request_self_pair: Fn(edsl.PeerRequest) -> Bool = fn(peer) {
    peer.origin.entity == peer.peer.entity
        && peer.origin.key != 'None && peer.peer.key != 'None
        && peer.origin.key == peer.peer.key
};

def peer_mode_issue: Fn(Intent) -> Option(String) = fn(intent) {
    match intent.peers {
        'None => 'None,
        'Some(peers) => do {
            let count: Int = array.length(peers);
            if count == 0 {
                'None
            } else if count != 1 {
                'Some("peer mode requires exactly one PeerRequest")
            } else if array.length(intent.any_of) != 0 {
                'Some("peer mode does not combine with subject any_of groups")
            } else if array.length(intent.exists) != 0 {
                'Some("peer mode does not combine with correlated existence filters")
            } else if array.length(intent.having) != 0 {
                'Some("peer mode does not combine with having group predicates")
            } else if intent.group_count != 'None {
                'Some("peer mode does not combine with count-of-groups mode")
            } else {
                let peer: edsl.PeerRequest = peers[0];
                if peer_request_self_pair(peer) {
                    'Some("peer origin and peer participant must be distinct (self-pair rejected)")
                } else if !peer_pair_supported(peer.origin.entity, peer.peer.entity) {
                    'Some(
                        `unsupported peer participant pair for the physical-link hub (\{peer.origin.entity}, \{peer.peer.entity})`,
                    )
                } else {
                    'None
                }
            }
        }
    }
};

# Lower a full Intent with an external trusted report reference context.
# `trusted` must come from a Resolver-unwritable source (Host/injected context);
# relative time windows compile only under this context.
def make_intent_query_context: Fn(Intent, Option(String)) -> qb.Query = fn(intent, trusted) {
    let normalized: Intent = apply_time_windows(normalize_status_intent(intent), trusted);
    let payload: edsl.PreparedPayload = select_payload(normalized);
    let _guarded: Bool = guard_alarm_site_tenant(normalized, payload);
    let peer_list: Array(edsl.PeerRequest) = match normalized.peers {
        'None => [],
        'Some(peers) => peers,
    };
    if array.length(peer_list) > 0 {
        # Peer mode: geometry is validated before lowering.  A non-'None issue
        # is a deterministic rejection - never a silent drop of any_of/exists/
        # having/group_count or of extra peer requests.
        match peer_mode_issue(normalized) {
            'Some(reason) => fail!(
                "peer intent rejected before lowering (exactly one PeerRequest; no any_of/exists/having/group_count combination; supported participant pair)",
                reason,
                normalized,
            ),
            'None => {
                let plan: qb.Plan = edsl.lower_peer(
                    payload,
                    intent_to_request(normalized),
                    peer_list,
                );
                qb.transform_sqlite(plan)
            }
        }
    } else {
        match normalized.group_count {
            'Some('CountGroups) => edsl.lower_group_count(
                payload,
                intent_to_request(normalized),
                normalized.having,
            ),
            _ => {
                let plan: qb.Plan = edsl.lower_any(
                    payload,
                    intent_to_request(normalized),
                    normalized.any_of,
                    normalized.exists,
                    normalized.having,
                );
                qb.transform_sqlite(plan)
            }
        }
    }
};

# ---------------------------------------------------------------------------
# Request-scoped time-source authorization.
#
# A Resolver must not be able to disguise a relative window as an ordinary
# absolute time filter.  The Host's per-request time_context (version 2)
# declares which absolute text values were *directly* present in the request
# (`direct_bounds`) plus the trusted report reference.  A plain time filter is
# only authorized when its value is among the Host-declared direct bounds for
# that time dimension.  Without declared direct bounds, a request that filters
# a time dimension fails deterministically (the Host must supply request-scoped
# direct bounds); requests without time conditions are unaffected.
# ---------------------------------------------------------------------------

def time_dimension_ids: Array(String) = [
    "NetworkKpiTime", "NetOnlineKpiTime", "ApRadioKpiTime",
    "ServerKpiTime", "PonKpiTime", "OnuKpiTime", "PonPortKpiTime",
    "StorageKpiTime", "AlarmTime",
];

def is_time_dimension: Fn(String) -> Bool = fn(id) {
    array.any(time_dimension_ids, fn(d) { d == id })
};

# One absolute text value the request itself directly provided for a time
# dimension (Host-declared, Resolver-unwritable).
type DirectBoundSpec = struct {
    dimension: String,
    value: String,
};

# Pure decision predicate: are the request's time-dimension filters authorized
# by the Host-declared direct bounds?  (Testable; authorize_time_context fails
# on False.)
def time_filters_authorized: Fn(Array(edsl.FilterRequest), Option(Array(DirectBoundSpec))) -> Bool = fn(
    filters, direct_bounds
) {
    let time_filters = array.filter(filters, fn(f) { is_time_dimension(f.id) });
    if array.length(time_filters) == 0 {
        'True
    } else {
        match direct_bounds {
            'None => 'False,
            'Some(bounds) => array.all(time_filters, fn(f) {
                match f.input {
                    'Text(value) => array.any(bounds, fn(b) {
                        b.dimension == f.id && b.value == value
                    }),
                    _ => 'True,
                }
            }),
        }
    }
};

# Deterministic authorization: fail when a time-dimension filter is not a
# Host-declared directly-provided absolute bound (or no direct bounds were
# declared for this request).
def authorize_time_context: Fn(Array(edsl.FilterRequest), Option(Array(DirectBoundSpec))) -> Bool = fn(
    filters, direct_bounds
) {
    if time_filters_authorized(filters, direct_bounds) {
        'True
    } else {
        fail!(
            "time filter is not declared as a directly provided absolute bound in the request-scoped Host time context (report_reference/direct_bounds); Resolver may not fabricate absolute bounds",
            filters,
        )
    }
};

# Direct-bound membership helper for a single absolute text value.
def bound_contains: Fn(Array(DirectBoundSpec), String, String) -> Bool = fn(bounds, dimension, value) {
    array.any(bounds, fn(b) { b.dimension == dimension && b.value == value })
};

# Pure decision predicate over the whole request-scoped time authorization:
#   - plain time-dimension filters must be Host-declared direct bounds;
#   - 'Direct time windows (user-supplied absolute window) must also have both
#     bounds declared as direct input;
#   - 'FixedWindow / 'Calendar windows require the trusted report reference.
def time_context_authorized: Fn(Intent, Option(String), Option(Array(DirectBoundSpec))) -> Bool = fn(
    intent, trusted, direct_bounds
) {
    if !time_filters_authorized(intent.filters, direct_bounds) {
        'False
    } else {
        match intent.time_windows {
            'None => 'True,
            'Some(windows) => array.all(windows, fn(w) {
                match w.kind {
                    'Direct => match direct_bounds {
                        'Some(bounds) =>
                            bound_contains(bounds, w.dimension, w.start)
                                && bound_contains(bounds, w.dimension, w.end),
                        'None => 'False,
                    },
                    'FixedWindow => match trusted {
                        'Some(_) => 'True,
                        'None => 'False,
                    },
                    'Calendar => match trusted {
                        'Some(_) => 'True,
                        'None => 'False,
                    },
                }
            }),
        }
    }
};

# Deterministic request-scoped authorization (fails on unauthorized time use).
def authorize_request_time: Fn(Intent, Option(String), Option(Array(DirectBoundSpec))) -> Bool = fn(
    intent, trusted, direct_bounds
) {
    if time_context_authorized(intent, trusted, direct_bounds) {
        'True
    } else {
        fail!(
            "request time use is not authorized by the request-scoped Host time context (direct bounds and/or trusted report reference); Resolver may not fabricate or disguise relative/absolute time input",
            intent,
        )
    }
};

export {
    Intent,
    GroupCountMode,
    TimeWindowKind,
    TimeWindowSpec,
    DirectBoundSpec,
    intent_to_request,
    intent_from_request,
    validate_time_window,
    time_context_ok,
    time_window_to_filters,
    apply_time_windows,
    is_time_dimension,
    time_filters_authorized,
    authorize_time_context,
    time_context_authorized,
    authorize_request_time,
    make_query,
    make_intent_query,
    make_intent_query_context,
    peer_pair_supported,
    peer_request_self_pair,
    peer_mode_issue,
};
