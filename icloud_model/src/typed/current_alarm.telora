@registry::event("occur_utc")
@registry::field_counts([total, opened, critical, major])
@registry::computed_counts([severe, weighted_score])
@registry::relations(relations)
type TCurrentAlarm = struct {
    @m::column("CSN")
    csn: Int,
    @m::column("OCCURUTC")
    occur_utc: s::EpochMillis,
    @m::column("ARRIVEUTC")
    arrive_utc: s::EpochMillis,
    @m::column("OCCURTIME")
    occur_time: s::EpochMillis,
    @m::column("MEDN")
    res_id: String,
    @m::column("STREXT13")
    strext13: String,
    @m::column("ALARMNAME")
    alarm_name: String,
    @m::column("SEVERITY")
    @v::classification(AlarmSeverity_domain, "alarm_severity")
    severity: Int,
    @m::column("CLEARED")
    @v::classification(AlarmCleared_domain, "alarm_cleared")
    cleared: Int,
    @m::column("CHANGEFLAG")
    @v::classification(AlarmChangeFlag_domain, "alarm_change_flag")
    change_flag: Int,
    @m::column("TENANTID")
    tenant_id: i::TenantId,
    @m::column("CLEARUSER")
    source_CLEARUSER: String,
    @m::column("CLEARUTC")
    source_CLEARUTC: s::EpochMillis,
    @m::column("CLEARCATEGORY")
    @v::classification(CurrentAlarmCLEARCATEGORY_domain, "current_alarm__CLEARCATEGORY")
    source_CLEARCATEGORY: Int,
    @m::column("ACKED")
    @v::classification(CurrentAlarmACKED_domain, "current_alarm__ACKED")
    source_ACKED: Int,
    @m::column("ACKUSER")
    source_ACKUSER: String,
    @m::column("ACKUTC")
    source_ACKUTC: s::EpochMillis,
    @m::column("LATESTOCCURUTC")
    source_LATESTOCCURUTC: s::EpochMillis,
    @m::column("MENAME")
    source_MENAME: String,
    @m::column("METYPE")
    source_METYPE: String,
    @m::column("ORIGINSYSTEMTYPE")
    source_ORIGINSYSTEMTYPE: String,
    @m::column("MOI")
    source_MOI: String,
    @m::column("IDENTIFIER")
    source_IDENTIFIER: Int,
    @m::column("SUBCSN")
    source_SUBCSN: Int,
    @m::column("EVENTTYPE")
    @v::classification(CurrentAlarmEVENTTYPE_domain, "current_alarm__EVENTTYPE")
    source_EVENTTYPE: Int,
    @m::column("PROBABLECAUSE")
    source_PROBABLECAUSE: String,
    @m::column("AFFECTEDSERVICE")
    source_AFFECTEDSERVICE: String,
    @m::column("ADDITIONALINFORMATION")
    source_ADDITIONALINFORMATION: String,
    @m::column("COMMENT")
    source_COMMENT: String,
    @m::column("TENANT")
    source_TENANT: String,
    @m::column("ORIGINSYSTEMNAME")
    source_ORIGINSYSTEMNAME: String,
    @m::column("REGION")
    source_REGION: String,
    @m::column("MANUFACTURER")
    source_MANUFACTURER: String,
    @m::column("DOMAIN")
    source_DOMAIN: String,
    @m::column("MOC")
    source_MOC: String,
    @m::column("MECATEGORY")
    source_MECATEGORY: String,
    @m::column("VERSION")
    source_VERSION: Int,
    @m::column("LOCATION")
    source_LOCATION: String,
    @m::column("CLEARTIME")
    source_CLEARTIME: s::EpochMillis,
    @m::column("LATESTOCCURTIME")
    source_LATESTOCCURTIME: s::EpochMillis,
    @m::column("PRODUCTNAME")
    source_PRODUCTNAME: String,
    @m::column("ENDUTC")
    source_ENDUTC: s::EpochMillis,
    @m::column("MODN")
    source_MODN: String,
    @m::column("MONAME")
    source_MONAME: String,
    @m::column("COMMENTUTC")
    source_COMMENTUTC: s::EpochMillis,
    @m::column("COMMENTUSER")
    source_COMMENTUSER: String,
};
def dataset: m::Dataset(TCurrentAlarm) = registry::dataset_of(TCurrentAlarm.type);
def device: m::Role(TCurrentAlarm) = m::role(
    dataset,
    i::device,
    "device",
    False,
    [
        m::reference_part(
            m::field(TCurrentAlarm.type, String.type, "res_id"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def server_reference: m::Role(TCurrentAlarm) = m::role(
    dataset,
    server::entity,
    "server",
    False,
    [
        m::reference_part(
            m::field(TCurrentAlarm.type, String.type, "res_id"),
            m::field(server::Identity.type, server::ServerId.type, "id")
        )
    ]
);
def storage_reference: m::Role(TCurrentAlarm) = m::role(
    dataset,
    storage::entity,
    "storage",
    False,
    [
        m::reference_part(
            m::field(TCurrentAlarm.type, String.type, "res_id"),
            m::field(storage::Identity.type, storage::StorageId.type, "id")
        )
    ]
);
def pon_reference: m::Role(TCurrentAlarm) = m::role(
    dataset,
    pon::entity,
    "pon",
    False,
    [
        m::reference_part(
            m::field(TCurrentAlarm.type, String.type, "res_id"),
            m::field(pon::Identity.type, pon::PonId.type, "id")
        )
    ]
);
def site_reference: m::Role(TCurrentAlarm) = m::role(
    dataset,
    site::entity,
    "site",
    False,
    [
        m::reference_part(
            m::field(TCurrentAlarm.type, String.type, "strext13"),
            m::field(site::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def tenant: m::Role(TCurrentAlarm) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(TCurrentAlarm.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
@ev::order_by_itag
type AlarmSeverity = enum {
    @ev::itag(1)
    @ev::description("Critical", "紧急")
    Critical,
    @ev::itag(2)
    @ev::description("Major", "重要")
    Major,
    @ev::itag(3)
    @ev::description("Minor", "次要")
    Minor,
    @ev::itag(4)
    @ev::description("Warning", "提示")
    Warning,
};
def AlarmSeverity_domain: v::Domain(AlarmSeverity, Int) = v::from_enum(
    "AlarmSeverity",
    AlarmSeverity.type,
    Int.type,
    False
);
@knowledge_policy::reverse_references(True)
type AlarmCleared = enum {
    @ev::itag(0)
    @ev::description("Uncleared", "未清除")
    Uncleared,
    @ev::itag(1)
    @ev::description("Cleared", "已清除")
    Cleared,
};
def AlarmCleared_domain: v::Domain(AlarmCleared, Int) = v::from_enum(
    "AlarmCleared",
    AlarmCleared.type,
    Int.type,
    False
);
@knowledge_policy::reverse_references(True)
type AlarmChangeFlag = enum {
    @ev::itag(1)
    @ev::description("Add", "新增")
    Add,
    @ev::itag(2)
    @ev::description("Update", "修改")
    Update,
    @ev::itag(3)
    @ev::description("Delete", "删除")
    Delete,
};
def AlarmChangeFlag_domain: v::Domain(AlarmChangeFlag, Int) = v::from_enum(
    "AlarmChangeFlag",
    AlarmChangeFlag.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type CurrentAlarmCLEARCATEGORY = enum {
    @ev::itag(1)
    @ev::description("Auto", "可自动清除")
    Auto,
    @ev::itag(2)
    @ev::description("Manual", "不可自动清除")
    Manual,
};
def CurrentAlarmCLEARCATEGORY_domain: v::Domain(CurrentAlarmCLEARCATEGORY, Int) = v::from_enum(
    "CurrentAlarmCLEARCATEGORY",
    CurrentAlarmCLEARCATEGORY.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type CurrentAlarmACKED = enum {
    @ev::itag(0)
    @ev::description("unconfirmed", "未确认")
    Unconfirmed,
    @ev::itag(1)
    @ev::description("confirmed", "已确认")
    Confirmed,
};
def CurrentAlarmACKED_domain: v::Domain(CurrentAlarmACKED, Int) = v::from_enum(
    "CurrentAlarmACKED",
    CurrentAlarmACKED.type,
    Int.type,
    False
);

