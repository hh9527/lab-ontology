use ontology::scalars as s;
use ontology::shared_types as shared;
use ontology::js_codec as js;
use ontology::intent as intent;
use std::string as string;
use std::test as test;

type SiteTimeZone = struct(s::TimeZone);
pub def timezone_is_shared_identity: test::Test = test::should_ok(fn(){
    shared::direct(s::TimeZone.type) == Some("TimeZone") && shared::semantic(SiteTimeZone.type) == Some("TimeZone")
});
pub def timezone_codec_retains_iana_contract: test::Test = test::should_ok(fn(){
    string::contains(js::source(s::TimeZone.type,intent::ResultType::String),"primary[\"TimeZone\"]") && string::contains(js::source(SiteTimeZone.type,intent::ResultType::String),"primary[\"TimeZone\"]")
});
pub def timezone_is_not_an_instant: test::Test = test::should_ok(fn(){
    s::time_role(s::TimeZone.type) == None
});
