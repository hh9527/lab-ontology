            union_a_filtered_branch(),
            union_b_filtered_branch(),
        ])),
        projection: [
            qb.expr_item(qb.column("u", "owner_id")),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("u", "item_id"), False, "item_count"),
        ],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("u", "owner_id"), qb.bind_string("root")])),
        exists: [],
        joins: [],
        grouping: [qb.column("u", "owner_id")],
        having: [qb.having(qb.HavingOp.Gt, "item_count", qb.Val.Int(3))],
        ordering: [],
        limit: None,
        offset: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def expected_union_filtered_sql = "SELECT u.owner_id, count(u.item_id) AS item_count FROM (SELECT a.owner_id AS owner_id, a.group_id AS group_id, a.item_id AS item_id FROM items_a AS a WHERE a.kind = ? UNION ALL SELECT b.owner_id AS owner_id, b.group_id AS group_id, b.item_id AS item_id FROM items_b AS b WHERE b.kind = ?) AS u WHERE u.owner_id = ? GROUP BY u.owner_id HAVING count(u.item_id) > ?";

def expected_union_filtered_bindings: Array(qb.Val) = [qb.Val.String("x"), qb.Val.String("y"), qb.Val.String("root"), qb.Val.Int(3)];

def union_all_binding_order_is_fixed = fn() {
    let q1 = qb.transform_sqlite(union_filtered_outer_plan());
    let q2 = qb.transform_sqlite(union_filtered_outer_plan());
    q1.sql == expected_union_filtered_sql
        && q1.bindings == expected_union_filtered_bindings
        && (array.length(string.split(q1.sql, "?")) - 1) == array.length(q1.bindings)
        && q1.sql == q2.sql
        && q1.bindings == q2.bindings
};

