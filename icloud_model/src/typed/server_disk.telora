use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("ServerDisk")
type ServerDiskById = struct(ComponentId);
type Gigabytes = struct(Int);
@domain::subject("ServerDisk", "source_id")
@domain::dataset("source_PhysicalServerDisk", "PhysicalServerDisk", ["source_id"])
@domain::relations(relations)
type PhysicalServerDisk = struct {
    @m::column("name")
    @g::search("source_PhysicalServerDisk__name")
    source_name: String,
    @m::column("tenantId")
    @g::exact("source_PhysicalServerDisk__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("id")
    @g::exact("source_PhysicalServerDisk__id")
    source_id: ServerDiskById,
    @m::column("remainingLifespan")
    @g::exact("source_PhysicalServerDisk__remainingLifespan")
    source_remainingLifespan: String,
    @m::column("serialNumber")
    @g::search("source_PhysicalServerDisk__serialNumber")
    source_serialNumber: String,
    @m::column("interfaceType")
    @g::exact("source_PhysicalServerDisk__interfaceType_raw")
    @v::map(
        SourcePhysicalServerDiskInterfaceType.type,
        "source_PhysicalServerDisk__interfaceType",
        [
            v::member(SourcePhysicalServerDiskInterfaceType::SpiType, ["SPI"]),
            v::member(SourcePhysicalServerDiskInterfaceType::PcIeType, ["PCIe"]),
            v::member(SourcePhysicalServerDiskInterfaceType::AhciType, ["AHCI"]),
            v::member(SourcePhysicalServerDiskInterfaceType::UhciType, ["UHCI"]),
            v::member(SourcePhysicalServerDiskInterfaceType::SasType, ["SAS"]),
            v::member(SourcePhysicalServerDiskInterfaceType::SataType, ["SATA"]),
            v::member(SourcePhysicalServerDiskInterfaceType::UsbType, ["USB"]),
            v::member(SourcePhysicalServerDiskInterfaceType::NvMeType, ["NVMe"]),
            v::member(SourcePhysicalServerDiskInterfaceType::FcType, ["FC"]),
            v::member(SourcePhysicalServerDiskInterfaceType::IScsiType, ["iSCSI"]),
            v::member(SourcePhysicalServerDiskInterfaceType::FCoEType, ["FCoE"]),
            v::member(
                SourcePhysicalServerDiskInterfaceType::NvMeOverFabricsType,
                ["NVMeOverFabrics"]
            ),
            v::member(SourcePhysicalServerDiskInterfaceType::SmbType, ["SMB"]),
            v::member(SourcePhysicalServerDiskInterfaceType::NfSv3Type, ["NFSv3"]),
            v::member(SourcePhysicalServerDiskInterfaceType::NfSv4Type, ["NFSv4"]),
            v::member(SourcePhysicalServerDiskInterfaceType::HttpType, ["HTTP"]),
            v::member(SourcePhysicalServerDiskInterfaceType::HttpsType, ["HTTPS"]),
            v::member(SourcePhysicalServerDiskInterfaceType::FtpType, ["FTP"]),
            v::member(SourcePhysicalServerDiskInterfaceType::SftpType, ["SFTP"])
        ]
    )
    source_interfaceType: String,
    @m::column("mediaType")
    @g::exact("source_PhysicalServerDisk__mediaType_raw")
    @v::map(
        SourcePhysicalServerDiskMediaType.type,
        "source_PhysicalServerDisk__mediaType",
        [
            v::member(SourcePhysicalServerDiskMediaType::HardDiskDrive, ["HDD"]),
            v::member(SourcePhysicalServerDiskMediaType::SolidStateDrive, ["SSD"]),
            v::member(SourcePhysicalServerDiskMediaType::ShingledMagneticRecording, ["SMR"])
        ]
    )
    source_mediaType: String,
    @m::column("capacity")
    @g::field_view(
        g::dimension_group(
            "source_PhysicalServerDisk__capacity",
            Gigabytes.type,
            True,
            g::numeric_filters
        ),
        "source_PhysicalServerDisk__capacity",
        True,
        g::numeric_filters
    )
    source_capacity: Gigabytes,
    @m::column("model")
    @g::search("source_PhysicalServerDisk__model")
    source_model: String,
    @m::column("manufacturer")
    @g::search("source_PhysicalServerDisk__manufacturer")
    source_manufacturer: String,
    @m::column("healthStatus")
    @g::exact("source_PhysicalServerDisk__healthStatus_raw")
    @v::map(
        SourcePhysicalServerDiskHealthStatus.type,
        "source_PhysicalServerDisk__healthStatus",
        [
            v::member(SourcePhysicalServerDiskHealthStatus::Normal, [0]),
            v::member(SourcePhysicalServerDiskHealthStatus::Warning, [1]),
            v::member(SourcePhysicalServerDiskHealthStatus::Average, [2]),
            v::member(SourcePhysicalServerDiskHealthStatus::Serious, [3]),
            v::member(SourcePhysicalServerDiskHealthStatus::Critical, [4]),
            v::member(SourcePhysicalServerDiskHealthStatus::Wrong, [-1]),
            v::member(SourcePhysicalServerDiskHealthStatus::Unknown, [-2])
        ]
    )
    source_healthStatus: Int,
    @m::column("diskName")
    @g::search("source_PhysicalServerDisk__diskName")
    source_diskName: String,
    @m::column("projectId")
    @g::exact("source_PhysicalServerDisk__projectId")
    source_projectId: String,
    @m::column("parentResId")
    @g::exact("source_PhysicalServerDisk__parentResId")
    source_parentResId: domain::Reference(server::ServerByOriginId),
};

def subject: r::Endpoint = domain::endpoint(PhysicalServerDisk.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(PhysicalServerDisk.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(PhysicalServerDisk.type, "source_parentResId");

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerDiskInterfaceType = enum {
    @ev::description("SPI type", "SPI类型")
    SpiType,

    @ev::description("PCIe type", "PCIe类型")
    PcIeType,

    @ev::description("AHCI type", "AHCI类型")
    AhciType,

    @ev::description("UHCI type", "UHCI类型")
    UhciType,

    @ev::description("SAS type", "SAS类型")
    SasType,

    @ev::description("SATA type", "SATA类型")
    SataType,

    @ev::description("USB type", "USB类型")
    UsbType,

    @ev::description("NVMe type", "NVMe类型")
    NvMeType,

    @ev::description("FC type", "FC类型")
    FcType,

    @ev::description("iSCSI type", "iSCSI类型")
    IScsiType,

    @ev::description("FCoE type", "FCoE类型")
    FCoEType,

    @ev::description("NVMe over Fabrics type", "NVMeOverFabrics类型")
    NvMeOverFabricsType,

    @ev::description("SMB type", "SMB类型")
    SmbType,

    @ev::description("NFSv3 type", "NFSv3类型")
    NfSv3Type,

    @ev::description("NFSv4 type", "NFSv4类型")
    NfSv4Type,

    @ev::description("HTTP type", "HTTP类型")
    HttpType,

    @ev::description("HTTPS type", "HTTPS类型")
    HttpsType,

    @ev::description("FTP type", "FTP类型")
    FtpType,

    @ev::description("SFTP type", "SFTP类型")
    SftpType,
};

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerDiskMediaType = enum {
    @ev::description("Hard Disk Drive", "机械硬盘")
    HardDiskDrive,

    @ev::description("Solid State Drive", "固态硬盘")
    SolidStateDrive,

    @ev::description("Shingled Magnetic Recording", "叠瓦式磁记录")
    ShingledMagneticRecording,
};

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerDiskHealthStatus = enum {
    @ev::itag(0)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("warning", "警告")
    Warning,
    @ev::itag(2)
    @ev::description("average", "一般")
    Average,
    @ev::itag(3)
    @ev::description("serious", "严重")
    Serious,
    @ev::itag(4)
    @ev::description("critical", "紧急")
    Critical,
    @ev::itag(-1)
    @ev::description("wrong", "错误")
    Wrong,
    @ev::itag(-2)
    @ev::description("unknown", "未知")
    Unknown,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation("source_PhysicalServer_PhysicalServerDisk", server::origin, parent, cardinality),
    r::relation(
        "source_PhysicalServerDisk_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerDisk, ServerDiskById};

pub use self::{
    SourcePhysicalServerDiskInterfaceType,
    SourcePhysicalServerDiskMediaType,
    SourcePhysicalServerDiskHealthStatus
};
