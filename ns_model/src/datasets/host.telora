    r::relation("eh2__ho_rev", domain::endpoint(Host.type, "obj_sys_id"), domain::endpoint(enterprise_host_2_kpi::EnterpriseHost2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
