pub def union_typed_filters_prepare: test::Test = test::should_ok(fn() {
    let payload = edsl::build_root("union-filter-types-v1", [GoodUnionInt.type, GoodUnionEnum.type], knowledge::profile,
        fn(subject) { subject == "analyst" });
    let request: edsl::QueryRequest = {
        measures: [], dimensions: [{id: "GoodUnionId", subject: "analyst", input: edsl::DimensionInput::None}],
        filters: [], ordering: [], limit: None, offset: None, partition: None,
    };
    let q = qb::transform_sqlite(edsl::lower(payload, request));
    if array::length(payload.entities) == 2
        && string::contains(q.sql, "WHERE uig.id = ?")
        && q.bindings == [qb::Val::Int(1)] { True }
    else { fail!("valid union filter must lower with a typed binding", q) }
});

@edsl::entity_source("time_discovery_fixture", "tdf")
@edsl::dataset(edsl::DatasetKind::Event, ["id"], Some("occurred"))
type TimeDiscoveryFixture = struct {
    @edsl::column("id")
    @edsl::key(True)
    id: Int,
    @edsl::column("occurred")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::CanonicalUtcSecondText)
    occurred: String,
    @edsl::column("received")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::CanonicalUtcSecondText)
    received: String,
    @edsl::column("local_ms")
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::LocalEpochMillis)
    @edsl::dimension("HiddenTimeMs", False, True, [edsl::FilterOp::Ge], [edsl::FilterInputKind::Int])
    local_ms: Int,
};

pub def subject_time_discovery_preserves_clock_without_hidden_dimension: test::Test = test::should_ok(fn() {
    let payload = edsl::build_root("time-discovery-v1", [TimeDiscoveryFixture.type], knowledge::profile,
        fn(subject) { subject == "analyst" });
    let full = get_index(edsl::knowledge_index(payload), 0);
    let scoped = get_index(edsl::knowledge_index_for_subject(payload, "analyst"), 0);
    let clock = match array::get(scoped.time_roles, 0) {
        Some(role) => role.field == "occurred" && role.authoritative
            && role.semantics == edsl::TimeSemantics::Utc
            && array::length(role.dimension_ids) == 0,
        None => False,
    };
    let received = array::any(scoped.time_roles, fn(role) {
        role.field == "received" && !role.authoritative && array::length(role.dimension_ids) == 0
    });
    if array::length(full.time_roles) == 3 && array::length(scoped.time_roles) == 2
        && clock && received && array::length(scoped.dimension_ids) == 0 { True }
    else { fail!("subject time discovery must omit hidden dimensions but retain the dataset clock", full, scoped) }
});

