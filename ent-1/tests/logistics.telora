# ent-1/tests/logistics.telora
#
# Public contract checks for the logistics EnterpriseKnowledge.
# Evaluated by `check @test/logistics`; any broken contract fails loudly.

import "query/lib" as qb;
import "std/array" as array;
import "ontology/edsl" as edsl;
import "@src/model" as model;

def check: Fn(Bool, String) -> Bool = fn(cond, label) {
    if cond { 'True } else { fail!("logistics contract check failed", label) }
};

# The prepared payload owns a query Plan: revision is fixed and the
# legal request lowers through the eDSL hot path and validates.
def root_revision_and_lowering_ok: Bool = do {
    let p = model.payload;
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrdersCreated", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderMonth", subject: "analyst", input: 'None }],
        filters: [{ id: "OrderMonth", subject: "analyst", op: 'Ge, input: 'Text("2026-04") }],
        ordering: [{ target: 'Measure("OrdersCreated"), direction: 'Desc }],
        limit: 'Some(3),
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(p, request);
    let validated: qb.Plan = qb.validate(plan, p.profile);
    check(p.revision == "logistics-ontology-v1", "revision is logistics-ontology-v1")
        && check(array.length(validated.sources) >= 1, "plan is a query Plan and validates")
};

# The knowledge declares the ten logistics entities explicitly on the root.
def entity_count_ok: Bool = do {
    let p = model.payload;
    check(array.length(p.entities) == 10, "ten entities declared on the root")
};

# The closed vocabulary contains the three measures and the seven authorized
# or known dimensions, all as valid SQL output identifiers.
def vocabulary_ok: Bool = do {
    let p = model.payload;
    let measure_ids = array.map(p.measures, fn(m) { m.id });
    let has_measures = array.all([
        "OrdersCreated", "DeliveredPackages", "UnitsShipped",
    ], fn(id) { array.any(measure_ids, fn(m) { m == id }) });
    let dim_ids = array.map(p.dimensions, fn(d) { d.id });
    let has_dims = array.all([
        "OrderMonth", "CustomerTier", "OriginRegion",
        "CarrierName", "ServiceName", "ProductCategory", "DeliveryException",
    ], fn(id) { array.any(dim_ids, fn(d) { d == id }) });
    let ids_ok = array.all(p.measures, fn(m) { qb.is_sql_identifier(m.alias) })
        && array.all(p.dimensions, fn(d) { qb.is_sql_identifier(d.id) });
    check(has_measures, "three measures in the closed vocabulary")
        && check(has_dims, "seven dimensions in the closed vocabulary")
        && check(ids_ok, "measure aliases and dimension ids are valid SQL identifiers")
};

# DeliveryException is a closed-vocabulary dimension without granted
# capability: it is present but unauthorized and not filterable.
def no_capability_dimension_ok: Bool = do {
    let p = model.payload;
    let entry = match array.find(p.dimensions, fn(d) { d.id == "DeliveryException" }) {
        'Some(d) => d,
        'None => fail!("DeliveryException missing from dimensions"),
    };
    check(!entry.authorized, "DeliveryException is not authorized")
        && check(!entry.filterable, "DeliveryException has no filter capability")
};

# Grain-safe capabilities match the DOMAIN: ProductCategory is safe from the
# PackageItem grain (UnitsShipped) and CarrierName/ServiceName are groupable
# but not filterable.
def capability_flags_ok: Bool = do {
    let p = model.payload;
    let carrier = match array.find(p.dimensions, fn(d) { d.id == "CarrierName" }) {
        'Some(d) => d,
        'None => fail!("CarrierName missing from dimensions"),
    };
    let category = match array.find(p.dimensions, fn(d) { d.id == "ProductCategory" }) {
        'Some(d) => d,
        'None => fail!("ProductCategory missing from dimensions"),
    };
    let units = match array.find(p.measures, fn(m) { m.id == "UnitsShipped" }) {
        'Some(m) => m,
        'None => fail!("UnitsShipped missing from measures"),
    };
    let delivered = match array.find(p.measures, fn(m) { m.id == "DeliveredPackages" }) {
        'Some(m) => m,
        'None => fail!("DeliveredPackages missing from measures"),
    };
    let order_idx = match array.find(p.entities, fn(e) { e.entity_type == model.Order }) {
        'Some(e) => e.index,
        'None => -1,
    };
    let package_idx = match array.find(p.entities, fn(e) { e.entity_type == model.Package }) {
        'Some(e) => e.index,
        'None => -1,
    };
    check(!carrier.filterable, "CarrierName is not filterable")
        && check(category.authorized, "ProductCategory is authorized")
        && check(array.any(units.requires, fn(i) { i == package_idx }), "UnitsShipped requires Package")
        && check(array.any(units.requires, fn(i) { i == order_idx }), "UnitsShipped requires Order")
        && check(array.any(delivered.requires, fn(i) { i == order_idx }), "DeliveredPackages requires Order")
};

# Filter capabilities: OrderMonth, OriginRegion and ProductCategory expose the
# standard Eq/Ge/Le set; CustomerTier is a closed enum value domain and
# therefore only Eq (DOMAIN).
def filter_capability_set_ok: Bool = do {
    let p = model.payload;
    let ops_has = fn(entry, op) {
        array.any(entry.ops, fn(candidate) { candidate == op })
    };
    let month = match array.find(p.dimensions, fn(d) { d.id == "OrderMonth" }) {
        'Some(d) => d,
        'None => fail!("OrderMonth missing from dimensions"),
    };
    let tier = match array.find(p.dimensions, fn(d) { d.id == "CustomerTier" }) {
        'Some(d) => d,
        'None => fail!("CustomerTier missing from dimensions"),
    };
    let region = match array.find(p.dimensions, fn(d) { d.id == "OriginRegion" }) {
        'Some(d) => d,
        'None => fail!("OriginRegion missing from dimensions"),
    };
    let category = match array.find(p.dimensions, fn(d) { d.id == "ProductCategory" }) {
        'Some(d) => d,
        'None => fail!("ProductCategory missing from dimensions"),
    };
    let month_ok = ops_has(month, 'Eq) && ops_has(month, 'Ge) && ops_has(month, 'Le);
    let tier_ok = ops_has(tier, 'Eq) && !ops_has(tier, 'Ge) && !ops_has(tier, 'Le);
    let region_ok = ops_has(region, 'Eq) && ops_has(region, 'Ge) && ops_has(region, 'Le);
    let category_ok = ops_has(category, 'Eq) && ops_has(category, 'Ge) && ops_has(category, 'Le);
    check(month_ok, "OrderMonth filter ops are Eq/Ge/Le")
        && check(tier_ok, "CustomerTier filter ops are Eq only (closed enum domain)")
        && check(region_ok, "OriginRegion filter ops are Eq/Ge/Le")
        && check(category_ok, "ProductCategory filter ops are Eq/Ge/Le")
};

# The CustomerTier closed enum value domain: the prepared payload publishes the
# stable values and labels Gold/Silver/Bronze, discoverable via
# payload.dimensions[i].values and edsl.dimension_domain (no second copy).
def customer_tier_domain_ok: Bool = do {
    let p = model.payload;
    let tier = match array.find(p.dimensions, fn(d) { d.id == "CustomerTier" }) {
        'Some(d) => d,
        'None => fail!("CustomerTier missing from dimensions"),
    };
    let values = tier.values;
    let domain_ok = array.length(values) == 3
        && array.any(values, fn(v) { v.variant == "Gold" && v.value == "Gold" && v.label == "Gold customer" })
        && array.any(values, fn(v) { v.variant == "Silver" && v.value == "Silver" && v.label == "Silver customer" })
        && array.any(values, fn(v) { v.variant == "Bronze" && v.value == "Bronze" && v.label == "Bronze customer" });
    let discovery_ok = array.length(edsl.dimension_domain(p, "CustomerTier")) == 3;
    check(domain_ok, "CustomerTier publishes closed enum catalog with stable values and labels")
        && check(discovery_ok, "dimension_domain exposes the same catalog")
};

# The prepared payload's authorization closure works.
def authorization_ok: Bool = do {
    let p = model.payload;
    check(p.authorize("analyst"), "authorize accepts the analyst subject")
        && check(!p.authorize("outsider"), "authorize rejects unknown subjects")
};

# The published computed-dimension closure works cross-module.
def computed_dimension_ok: Bool = do {
    let p = model.payload;
    let month = match array.find(p.dimensions, fn(d) { d.id == "OrderMonth" }) {
        'Some(d) => d,
        'None => fail!("OrderMonth missing from dimensions"),
    };
    let expr = edsl.dimension_expr(p, month);
    match expr {
        'Scalar(call) => check(call.function == 'Substr && array.length(call.args) == 3, "OrderMonth builds substr(created_at, ?, ?)"),
        _ => check('False, "OrderMonth is a computed dimension"),
    }
};

export {
    root_revision_and_lowering_ok,
    entity_count_ok,
    vocabulary_ok,
    no_capability_dimension_ok,
    capability_flags_ok,
    filter_capability_set_ok,
    customer_tier_domain_ok,
    authorization_ok,
    computed_dimension_ok,
};
