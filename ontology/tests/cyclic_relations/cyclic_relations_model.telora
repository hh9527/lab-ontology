# Reciprocal relations use nominal Type identity, not declaration order.
use crate::ontology as edsl;

# Package is deliberately declared after Order. The reverse edge is explicit:
# Safe/FanOut describe grain, rather than automatically inferred inverses.
@edsl::entity_source("orders", "o")
@edsl::typed_relation(Order.type, Package.type, edsl::RelationKind::FanOut, edsl::typed_relation_pair(
    edsl::model_field(Order.type, Int.type, "id"), edsl::model_field(Package.type, Int.type, "order_id")))
type Order = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
};

@edsl::entity_source("packages", "p")
@edsl::typed_relation(Package.type, Order.type, edsl::RelationKind::Safe, edsl::typed_relation_pair(
    edsl::model_field(Package.type, Int.type, "order_id"), edsl::model_field(Order.type, Int.type, "id")))
type Package = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
    @edsl::column("order_id")
    order_id: Int,
};

@edsl::entity_source("unrelated", "u")
type Unrelated = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
};

pub use self::{ Order, Package, Unrelated };
