use crate::model::{ payload };
use ontology::knowledge as knowledge;
use std::value::{ Value };
use std::test as test;

pub def info_rejects_obsolete_pagination_fields: test::Test = test::should_fail_with(fn() {
    let info = knowledge::knowledge_info_method_factory(payload, "public");
    info(Value::Object({offset: Value::Int(-1), limit: Value::Int(3)}))
}, "$.limit: unknown field; see info key");
