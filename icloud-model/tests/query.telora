        && array::length(string::split(q.sql, "a.CLEARED = ?")) > 1
        && array::length(string::split(q.sql, "GROUP BY a.TENANTID")) > 1
        && q.bindings == [qb::Val::Int(0), qb::Val::Int(5)] {
        True
    } else { fail!("Q0442 must count qualifying tenant identity groups", q) }
});

