use ontology::semantic as domain;
# 接口样本独立声明，保留复合采样grain与所有统计能力
use super::inventory as i;
use super::port as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
type PacketsPerSecond = struct(Float);
use ontology::quantity::{Percent};
# TODO(#51) 源单位冲突尚未解决，保留既有byte/s契约，不执行任何换算
type ReportedOctetsRate = struct(Float);
@domain::subject("Port", "res_id")
@domain::dataset("interface_kpi", "NetworkDeviceInterfaceKPI", ["res_id", "tenant_id", "ts"])
@domain::metric("ts")
@domain::relations(relations)
type NetworkDeviceInterfaceKPI = struct {
    @m::column("resId")
    @g::exact("interface_kpi_res_id")
    res_id: domain::Reference(p::PortById),
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @g::field_view(
        g::dimension_group(
            "interface_kpi_ts_raw",
            s::DateTimeUtc.type,
            True,
            [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
        ),
        "interface_kpi_ts_raw",
        True,
        [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
    )
    @g::utc_bucket_view("interface_kpi_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("interface_kpi_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("interface_kpi_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("ifOutPktSpeed")
    @g::field_view(
        g::dimension_group("interface_tx_sample", PacketsPerSecond.type, True, g::numeric_filters),
        "interface_tx_sample",
        True,
        g::numeric_filters
    )
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_tx"}]
    )
    tx_speed: PacketsPerSecond,
    @m::column("ifOutErrors")
    @g::field_view(
        g::dimension_group("interface_out_errors_sample", Int.type, True, g::numeric_filters),
        "interface_out_errors_sample",
        True,
        g::numeric_filters
    )
    @g::statistics(
        g::numeric_group("interface_out_errors", Int.type, [g::Statistic::Mean]),
        [{member: g::Statistic::Mean, publish: "interface_out_errors"}]
    )
    out_errors: Int,
    @m::column("parentId")
    @g::exact("interface_kpi__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("interface_kpi__projectId")
    source_projectId: String,
    @m::column("interfaceName")
    @g::search("interface_kpi__interfaceName")
    source_interfaceName: String,
    @m::column("ifInBandRate")
    @g::field_view(
        g::dimension_group("interface_kpi__ifInBandRate", Percent.type, True, g::numeric_filters),
        "interface_kpi__ifInBandRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        usage_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "interface_in_band_usage_avg"},
            {statistic: samples::Statistic::Max, publish: "interface_in_band_usage_max"},
            {statistic: samples::Statistic::Min, publish: "interface_in_band_usage_min"}
        ]
    )
    source_ifInBandRate: Percent,
    @m::column("ifOutBandRate")
    @g::field_view(
        g::dimension_group("interface_kpi__ifOutBandRate", Percent.type, True, g::numeric_filters),
        "interface_kpi__ifOutBandRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        usage_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "interface_out_band_usage_avg"},
            {statistic: samples::Statistic::Max, publish: "interface_out_band_usage_max"},
            {statistic: samples::Statistic::Min, publish: "interface_out_band_usage_min"}
        ]
    )
    source_ifOutBandRate: Percent,
    @m::column("ifHCInOctetsSpeed")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCInOctetsSpeed",
            ReportedOctetsRate.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCInOctetsSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        octet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_rx_rate"}]
    )
    source_ifHCInOctetsSpeed: ReportedOctetsRate,
    @m::column("ifHCOutOctetsSpeed")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCOutOctetsSpeed",
            ReportedOctetsRate.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCOutOctetsSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        octet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_tx_rate"}]
    )
    source_ifHCOutOctetsSpeed: ReportedOctetsRate,
    @m::column("ifInPktSpeed")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifInPktSpeed",
            PacketsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifInPktSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_rx"}]
    )
    source_ifInPktSpeed: PacketsPerSecond,
    @m::column("ifHCInMulticastPktsSpeed")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCInMulticastPktsSpeed",
            PacketsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCInMulticastPktsSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_multicast_rx"}]
    )
    source_ifHCInMulticastPktsSpeed: PacketsPerSecond,
    @m::column("ifHCOutMulticastPktsSpeed")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCOutMulticastPktsSpeed",
            PacketsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCOutMulticastPktsSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_multicast_tx"}]
    )
    source_ifHCOutMulticastPktsSpeed: PacketsPerSecond,
    @m::column("ifHCInBroadtPktSpeed")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCInBroadtPktSpeed",
            PacketsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCInBroadtPktSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_broadcast_rx"}]
    )
    source_ifHCInBroadtPktSpeed: PacketsPerSecond,
    @m::column("ifHCOutBroadPktSpeed")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCOutBroadPktSpeed",
            PacketsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCOutBroadPktSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        packet_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_broadcast_tx"}]
    )
    source_ifHCOutBroadPktSpeed: PacketsPerSecond,
    @m::column("ifInErrors")
    @g::field_view(
        g::dimension_group("interface_kpi__ifInErrors", Int.type, True, g::numeric_filters),
        "interface_kpi__ifInErrors",
        True,
        g::numeric_filters
    )
    @samples::field(
        error_statistics,
        [{statistic: samples::Statistic::Mean, publish: "interface_in_errors"}]
    )
    source_ifInErrors: Int,
    @m::column("ifInBandRateEffcnt")
    @g::field_view(
        g::dimension_group("interface_kpi__ifInBandRateEffcnt", Int.type, True, g::numeric_filters),
        "interface_kpi__ifInBandRateEffcnt",
        True,
        g::numeric_filters
    )
    source_ifInBandRateEffcnt: Int,
    @m::column("ifOutBandRateEffcnt")
    @g::field_view(
        g::dimension_group("interface_kpi__ifOutBandRateEffcnt", Int.type, True, g::numeric_filters),
        "interface_kpi__ifOutBandRateEffcnt",
        True,
        g::numeric_filters
    )
    source_ifOutBandRateEffcnt: Int,
    @m::column("ifHCInOctetsSpeedEffcnt")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCInOctetsSpeedEffcnt",
            Int.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCInOctetsSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_ifHCInOctetsSpeedEffcnt: Int,
    @m::column("ifHCOutOctetsSpeedEffcnt")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCOutOctetsSpeedEffcnt",
            Int.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCOutOctetsSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_ifHCOutOctetsSpeedEffcnt: Int,
    @m::column("ifOutPktSpeedEffcnt")
    @g::field_view(
        g::dimension_group("interface_kpi__ifOutPktSpeedEffcnt", Int.type, True, g::numeric_filters),
        "interface_kpi__ifOutPktSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_ifOutPktSpeedEffcnt: Int,
    @m::column("ifInPktSpeedEffcnt")
    @g::field_view(
        g::dimension_group("interface_kpi__ifInPktSpeedEffcnt", Int.type, True, g::numeric_filters),
        "interface_kpi__ifInPktSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_ifInPktSpeedEffcnt: Int,
    @m::column("ifHCInMulticastPktsSpeedEffcnt")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCInMulticastPktsSpeedEffcnt",
            Int.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCInMulticastPktsSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_ifHCInMulticastPktsSpeedEffcnt: Int,
    @m::column("ifHCOutMulticastPktsSpeedEffcnt")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCOutMulticastPktsSpeedEffcnt",
            Int.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCOutMulticastPktsSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_ifHCOutMulticastPktsSpeedEffcnt: Int,
    @m::column("ifHCInBroadtPktSpeedEffcnt")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCInBroadtPktSpeedEffcnt",
            Int.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCInBroadtPktSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_ifHCInBroadtPktSpeedEffcnt: Int,
    @m::column("ifHCOutBroadPktSpeedEffcnt")
    @g::field_view(
        g::dimension_group(
            "interface_kpi__ifHCOutBroadPktSpeedEffcnt",
            Int.type,
            True,
            g::numeric_filters
        ),
        "interface_kpi__ifHCOutBroadPktSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_ifHCOutBroadPktSpeedEffcnt: Int,
    @m::column("ifOutErrorsEffcnt")
    @g::field_view(
        g::dimension_group("interface_kpi__ifOutErrorsEffcnt", Int.type, True, g::numeric_filters),
        "interface_kpi__ifOutErrorsEffcnt",
        True,
        g::numeric_filters
    )
    source_ifOutErrorsEffcnt: Int,
    @m::column("ifInErrorsEffcnt")
    @g::field_view(
        g::dimension_group("interface_kpi__ifInErrorsEffcnt", Int.type, True, g::numeric_filters),
        "interface_kpi__ifInErrorsEffcnt",
        True,
        g::numeric_filters
    )
    source_ifInErrorsEffcnt: Int,
};
def port: r::Endpoint = domain::endpoint(NetworkDeviceInterfaceKPI.type, "res_id");
def packet_statistics: samples::Group(PacketsPerSecond) = samples::group(
    "packet_statistics",
    PacketsPerSecond.type,
    samples::Statistic::Mean,
    [],
    Some("packets/s")
);
def usage_statistics: samples::Group(Percent) = samples::group(
    "usage_statistics",
    Percent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
def octet_statistics: samples::Group(ReportedOctetsRate) = samples::group(
    "octet_statistics",
    ReportedOctetsRate.type,
    samples::Statistic::Mean,
    [],
    Some("byte/s")
);
def error_statistics: samples::Group(Int) = samples::group(
    "error_statistics",
    Int.type,
    samples::Statistic::Mean,
    [],
    None
);
def relations: Array(r::Relation) = [
    r::relation(
        "interface_kpi_of_port",
        port,
        p::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EnterpriseNetworkLTP_NetworkDeviceInterfaceKPI",
        p::subject,
        port,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{NetworkDeviceInterfaceKPI};
