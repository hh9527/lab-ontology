mod model;

use crate::model::{ payload };
use ontology::intent as intent;
use ontology::knowledge as knowledge;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use std::transform_service as service;
use std::codec as codec;
use std::value::{ Value };

type QueryService = struct { lower: Fn(Value) -> qb::Query };
impl service::TransformService for QueryService {
    init: fn(ctx) {
        { lower: intent::query_intent_lower_factory(payload, "resolver", sqlite::build_query) }.ty!(Self)
    },
    transform: fn(self, input) {
        codec::encode(self.lower(input))
    },
};
type DocService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for DocService {
    init: fn(ctx) {
        { handle: knowledge::knowledge_info_method_factory(payload, "resolver") }.ty!(Self)
    },
    transform: fn(self, input) { self.handle(input) },
};
type IndexService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for IndexService {
    init: fn(ctx) {
        { handle: knowledge::knowledge_index_method_factory(payload, "resolver") }.ty!(Self)
    },
    transform: fn(self, input) { self.handle(input) },
};
@service::collection
pub type MainService = struct {
    @service::slot("dog/transform") query: QueryService,
    @service::slot("dog/info") doc: DocService,
    @service::slot("dog/index") index: IndexService,
};
