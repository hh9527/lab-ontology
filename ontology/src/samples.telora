# 已上报样本的统计模板；不把 gauge 或速率自动解释成可累加量。
use crate::model as m;
use crate::groups as g;
use crate::scalars as s;
use crate::quantity as q;
use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::prelude as prelude;
use std::type_property as property;

# 样本契约附着于实际字段；注册时无需再手写 dataset/field/bind。
type FieldSample = struct {
    value: Type,
    nullable: Bool,
    group: String,
    primary: Statistic,
    summaries: Array(Statistic),
    unit: Option(String),
    names: Array(Name)
};
@prelude::property(PropertyTarget::Field)
type FieldSamples = struct {
    bindings: Array(FieldSample)
};
def field: for(Value) Fn(
    Group(Value),
    Array(Name)
) -> Fn(property::FieldPropertyCtx, Option(FieldSamples)) -> FieldSamples = fn(group, names) {
    prepare_names(group.id, group.primary, group.summaries, names);
    fn(ctx, previous) {
        if ctx.ty != Value.type && ctx.ty != Option(Value).type {
            fail!("sample field has a different nominal type", ctx.name, group.id)
        } else {
            ()
        };
        let before = match previous {
            Some(spec) => spec.bindings,
            None => []
        };
        {
            bindings: array::push(
                before,
                {
                    value: group.value,
                    nullable: ctx.ty != Value.type,
                    group: group.id,
                    primary: group.primary,
                    summaries: group.summaries,
                    unit: group.unit,
                    names
                }.ty!(FieldSample)
            )
        }
    }
};
def field_bindings: Fn(m::PreparedDataset) -> Array(BindingFacts) = fn(dataset) {
    array::flat_map(
        m::fields_of(dataset.row),
        fn(field) {
            match property::get_field_prop(dataset.row, field.index, FieldSamples.type) {
                None => [],
                Some(spec) => array::map(
                    spec.bindings,
                    fn(binding) {
                        {
                            measures: prepare_measures(
                                field.name,
                                binding.primary,
                                binding.unit,
                                binding.names
                            ),
                            index: field.index,
                            row: dataset.row,
                            dataset: dataset.id,
                            source: dataset.source,
                            field: field.name,
                            value: binding.value,
                            nullable: binding.nullable,
                            group: binding.group,
                            primary: binding.primary,
                            summaries: binding.summaries,
                            unit: binding.unit,
                            names: binding.names
                        }.ty!(BindingFacts)
                    }
                )
            }
        }
    )
};
pub use self::{FieldSamples, FieldSample, field, field_bindings};

type Statistic = enum {
    Mean,
    Min,
    Max,
    Latest,
    Sum
};
type Group(Value) = struct {
    id: String,
    value: Type,
    primary: Statistic,
    summaries: Array(Statistic),
    unit: Option(String)
};
type Name = struct {
    statistic: Statistic,
    publish: String
};
type Binding(Row) = struct {
    measures: Array(edsl::SampleMeasureEntry),
    index: Int,
    row: Type,
    dataset: String,
    source: String,
    field: String,
    value: Type,
    nullable: Bool,
    group: String,
    primary: Statistic,
    summaries: Array(Statistic),
    unit: Option(String),
    names: Array(Name)
};
type BindingFacts = struct {
    measures: Array(edsl::SampleMeasureEntry),
    index: Int,
    row: Type,
    dataset: String,
    source: String,
    field: String,
    value: Type,
    nullable: Bool,
    group: String,
    primary: Statistic,
    summaries: Array(Statistic),
    unit: Option(String),
    names: Array(Name)
};
def prepare_group: Fn(String, Type, Statistic, Array(Statistic), Option(String)) -> () = fn(
    id,
    value,
    primary,
    summaries,
    unit
) {
    let storage = g::representation(value);
    let members = array::concat([[primary], summaries]);
    match q::calculation_policy(value) {
        None => (),
        Some(allowed) => do { array::map(members, fn(member) {
            let operation = match member {
                Statistic::Mean => Some(q::Calculation::Mean),
                Statistic::Min => Some(q::Calculation::Min),
                Statistic::Max => Some(q::Calculation::Max),
                Statistic::Sum => Some(q::Calculation::Sum),
                Statistic::Latest => None,
            };
            match operation {
                Some(op) => if !array::any(allowed, fn(item) {item == op}) {fail!("sample statistic exceeds type calculation capabilities", id, member)} else { () },
                None => (),
            }
        }); () },
    };
    if id == "" || (storage != Int.type && storage != Float.type) || s::time_role(value) != None {
        fail!("sample group requires a name and numeric sample type", id)
    } else if array::any(
        members,
        fn(member) {
            member == Statistic::Sum
        }
    ) && value != q::Count.type && value != q::Bytes.type {
        fail!("sample Sum requires an explicitly additive quantity type", id)
    } else if unit == Some("") {
        fail!("sample group unit cannot be empty", id)
    } else if array::any(
        members,
        fn(member) {
            array::length(
                array::filter(
                    members,
                    fn(other) {
                        other == member
                    }
                )
            ) != 1
        }
    ) {
        fail!("sample group statistics must be distinct", id)
    } else {
        ()
    }
};
def prepare_names: Fn(String, Statistic, Array(Statistic), Array(Name)) -> () = fn(
    id,
    primary,
    summaries,
    names
) {
    let members = array::concat([[primary], summaries]);
    if array::length(names) != array::length(members) || !array::all(
        members,
        fn(member) {
            array::length(
                array::filter(
                    names,
                    fn(name) {
                        name.statistic == member
                    }
                )
            ) == 1
        }
    ) {
        fail!("sample binding must name every statistic exactly once", id)
    } else if array::any(
        names,
        fn(name) {
            !qb::is_sql_identifier(name.publish)
        }
    ) {
        fail!("sample binding public names must be SQL identifiers", id)
    } else {
        ()
    }
};
def group: for(Value) Fn(
    String,
    TypeOf(Value),
    Statistic,
    Array(Statistic),
    Option(String)
) -> Group(Value) = fn(id, value, primary, summaries, unit) {
    prepare_group(id, value, primary, summaries, unit);
    {id, value, primary, summaries, unit}
};
def bind: for(Row, Value) Fn(
    m::Dataset(Row),
    Group(Value),
    m::Field(Row, Value),
    Array(Name)
) -> Binding(Row) = fn(dataset, group, field, names) {
    prepare_names(group.id, group.primary, group.summaries, names);
    {
        measures: prepare_measures(field.name, group.primary, group.unit, names),
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        index: field.index,
        field: field.name,
        value: group.value,
        nullable: field.nullable,
        group: group.id,
        primary: group.primary,
        summaries: group.summaries,
        unit: group.unit,
        names
    }
};
def binding_facts: for(Row) Fn(Binding(Row)) -> BindingFacts = fn(binding) {
    {
        measures: binding.measures,
        row: binding.row,
        dataset: binding.dataset,
        source: binding.source,
        index: binding.index,
        field: binding.field,
        value: binding.value,
        nullable: binding.nullable,
        group: binding.group,
        primary: binding.primary,
        summaries: binding.summaries,
        unit: binding.unit,
        names: binding.names
    }
};
def prepare_bindings: Fn(m::PreparedDataset, Array(BindingFacts)) -> () = fn(dataset, bindings) {
    array::map(
        bindings,
        fn(binding) {
            if binding.row != dataset.row {
                fail!("sample binding belongs to another dataset", binding.group)
            } else {
                ()
            }
        }
    );
    ()
};
pub use self::{prepare_bindings};
def prepare_measures: Fn(
    String,
    Statistic,
    Option(String),
    Array(Name)
) -> Array(edsl::SampleMeasureEntry) = fn(field, primary, unit, names) {
    array::map(
        names,
        fn(name) {
            {
                id: name.publish,
                field,
                unit,
                aggregate: match name.statistic {
                    Statistic::Sum => qb::AggregateFunction::Sum,
                    Statistic::Mean => qb::AggregateFunction::Avg,
                    Statistic::Min => qb::AggregateFunction::Min,
                    Statistic::Max => qb::AggregateFunction::Max,
                    Statistic::Latest => qb::AggregateFunction::Latest
                },
                role: if name.statistic == primary {
                    edsl::SampleMeasureRole::Primary
                } else {
                    edsl::SampleMeasureRole::SampleSummary
                }
            }
        }
    )
};
def lower: Fn(Array(BindingFacts)) -> Array(edsl::SampleMeasureEntry) = fn(bindings) {
    array::flat_map(
        bindings,
        fn(binding) {
            binding.measures
        }
    )
};

pub use self::{Statistic, Group, Name, Binding, BindingFacts, group, bind, binding_facts, lower};

# 显式严格构造，用于诊断和检查需要立即拒绝的调用方。
