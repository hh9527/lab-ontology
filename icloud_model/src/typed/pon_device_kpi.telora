use ontology::semantic as domain;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_device as pon;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
# TODO(#47)：CPU 百分比单位沿用已授权假定，尚未确认来源元数据。
type AssumedCpuPercent = struct(Float);
def cpu_statistics: samples::Group(AssumedCpuPercent) = samples::group(
    "assumed_pon_cpu",
    AssumedCpuPercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
# memUsage 的单位／尺度没有在旧公开契约中确认。
type ReportedMemUsage = struct(Float);
# neContrlableRate 的单位／尺度没有在旧公开契约中确认。
type ReportedNeContrlableRate = struct(Float);
# nePingRespTime 的单位／尺度没有在旧公开契约中确认。
type ReportedNePingRespTime = struct(Float);
@domain::subject("PonElement", "source_resId")
@domain::dataset(
    "source_PonDeviceKPI",
    "PonDeviceKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
@domain::relations(relations)
type PonDeviceKPI = struct {
    @m::column("ts")
    @g::field_view(
        g::dimension_group("source_PonDeviceKPI__ts", s::DateTimeUtc.type, True, g::numeric_filters),
        "source_PonDeviceKPI__ts",
        True,
        g::numeric_filters
    )
    @g::utc_bucket_view("source_PonDeviceKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_PonDeviceKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_PonDeviceKPI_utc_month", qb::UtcBucketUnit::Month)
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_PonDeviceKPI__resId")
    source_resId: domain::Reference(pon::PonElementById),
    @m::column("tenantId")
    @g::exact("source_PonDeviceKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_PonDeviceKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_PonDeviceKPI__projectId")
    source_projectId: String,
    @m::column("cpuUsage")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__cpuUsage",
            AssumedCpuPercent.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__cpuUsage",
        True,
        g::numeric_filters
    )
    @samples::field(
        cpu_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "pon_cpu_usage"},
            {statistic: samples::Statistic::Max, publish: "pon_cpu_sample_max"},
            {statistic: samples::Statistic::Min, publish: "pon_cpu_sample_min"}
        ]
    )
    source_cpuUsage: AssumedCpuPercent,
    @m::column("memUsage")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__memUsage",
            ReportedMemUsage.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__memUsage",
        True,
        g::numeric_filters
    )
    source_memUsage: ReportedMemUsage,
    @m::column("onlineRate")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__onlineRate",
            p::Percent.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__onlineRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        p::Percent_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "pon_online_rate_avg"},
            {statistic: samples::Statistic::Min, publish: "pon_online_rate_min"},
            {statistic: samples::Statistic::Max, publish: "pon_online_rate_max"}
        ]
    )
    source_onlineRate: p::Percent,
    @m::column("neContrlableRate")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__neContrlableRate",
            ReportedNeContrlableRate.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__neContrlableRate",
        True,
        g::numeric_filters
    )
    source_neContrlableRate: ReportedNeContrlableRate,
    @m::column("nePingRespTime")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__nePingRespTime",
            ReportedNePingRespTime.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__nePingRespTime",
        True,
        g::numeric_filters
    )
    source_nePingRespTime: ReportedNePingRespTime,
    @m::column("cpuUsageEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__cpuUsageEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__cpuUsageEffcnt",
        True,
        g::numeric_filters
    )
    source_cpuUsageEffcnt: EffectiveCount,
    @m::column("memUsageEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__memUsageEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__memUsageEffcnt",
        True,
        g::numeric_filters
    )
    source_memUsageEffcnt: EffectiveCount,
    @m::column("onlineRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__onlineRateEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__onlineRateEffcnt",
        True,
        g::numeric_filters
    )
    source_onlineRateEffcnt: EffectiveCount,
    @m::column("neContrlableRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__neContrlableRateEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__neContrlableRateEffcnt",
        True,
        g::numeric_filters
    )
    source_neContrlableRateEffcnt: EffectiveCount,
    @m::column("nePingRespTimeEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_PonDeviceKPI__nePingRespTimeEffcnt",
            EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_PonDeviceKPI__nePingRespTimeEffcnt",
        True,
        g::numeric_filters
    )
    source_nePingRespTimeEffcnt: EffectiveCount,
};
def owner: r::Endpoint = domain::endpoint(PonDeviceKPI.type, "source_resId");

def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElementAssociationPonDeviceKPI",
        pon::subject,
        owner,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{PonDeviceKPI};
