@domain::relations(relations)
pub type CloudBlockPool2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("cloud-block-pool-2-kpi/obj_sys_id", ids::CloudBlockPool2KpiByObjSysId.type, True, [g::Filter::Eq]), "cbp2_obj_sys_id", True, [g::Filter::Eq])
