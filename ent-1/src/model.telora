# ent-1/src/model.telora
#
# Logistics fulfillment EnterpriseKnowledge (A3 private model).
#
# Implements the requirements in goals/ent-1.md using the ontology eDSL:
# nominal entity structs with member/type typed properties, an explicit
# ontology root (build_root) and a prepared EnterpriseKnowledge payload.
# All Plan/PlanProfile/Query types are owned by query; lowering is
# the eDSL hot path.  No shared algorithm, Plan builder, pre-rendered SQL or
# parallel fact directory is reimplemented here.

import "query/lib" as qb;
import "ontology/edsl" as edsl;

# ---------------------------------------------------------------------------
# Pre-bound decorator arguments (decorator calls do not re-type literals).
# ---------------------------------------------------------------------------

def count_agg: qb.AggregateFunction = 'Count;
def flag_true: Bool = 'True;
def flag_false: Bool = 'False;
def eq_ge_le_ops: Array(edsl.FilterOp) = ['Eq, 'Ge, 'Le];
def eq_ops: Array(edsl.FilterOp) = ['Eq];
def text_kinds: Array(edsl.FilterInputKind) = ['Text];
def no_ops: Array(edsl.FilterOp) = [];
def no_kinds: Array(edsl.FilterInputKind) = [];
def safe_kind: edsl.RelationKind = 'Safe;
def fanout_kind: edsl.RelationKind = 'FanOut;

# Canonical computed dimension for OrderMonth: substr(created_at, 1, 7).
# Literals 1/7 become bound values at plan-build time; no pre-rendered SQL.
def month_builder: Fn(qb.Expr) -> qb.Expr = fn(col) {
    qb.substr([col, qb.bind_int(1), qb.bind_int(7)])
};

# ---------------------------------------------------------------------------
# Entity declarations.
#
# Canonical member index is the compiler-normalized (alphabetical) field
# order, 0-based.  Relation decorators reference these indexes.
# ---------------------------------------------------------------------------

# Order: base grain for OrdersCreated / OrderMonth / most filters.
# Canonical field order: carrier_id=0, created_at=1, customer_id=2,
# id=3, service_level_id=4, warehouse_id=5.
@edsl.entity_source("orders", "o")
@edsl.relation(Customer, safe_kind, 2, 0)       # o.customer_id = c.id
@edsl.relation(Warehouse, safe_kind, 5, 0)      # o.warehouse_id = w.id
@edsl.relation(Carrier, safe_kind, 0, 0)        # o.carrier_id = cr.id
@edsl.relation(ServiceLevel, safe_kind, 4, 0)   # o.service_level_id = sl.id
@edsl.relation(Package, fanout_kind, 3, 2)      # o.id -> p.order_id (expands grain)
type Order = struct {
    @edsl.column("carrier_id")
    carrier_id: Int,
    @edsl.column("created_at")
    @edsl.computed_dimension("OrderMonth", flag_true, flag_true, eq_ge_le_ops, text_kinds, month_builder)
    created_at: String,
    @edsl.column("customer_id")
    customer_id: Int,
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("OrdersCreated", count_agg, requires_none)
    id: Int,
    @edsl.column("service_level_id")
    service_level_id: Int,
    @edsl.column("warehouse_id")
    warehouse_id: Int,
};

# CustomerTier is a closed business enum. Its stable external/physical values
# are the same-named Strings ("Gold"/"Silver"/"Bronze") stored in the physical
# "tier" column; the display labels are "Gold customer"/"Silver customer"/
# "Bronze customer". The eDSL closed enum value domain publishes these as the
# dimension's value catalog (DimensionEntry.values / dimension_domain).
type CustomerTier = enum {
    @edsl.enum_value("Gold", "Gold customer")
    'Gold,
    @edsl.enum_value("Silver", "Silver customer")
    'Silver,
    @edsl.enum_value("Bronze", "Bronze customer")
    'Bronze,
};

# Customer: holds CustomerTier (closed enum value domain; Eq-only filter).
# Canonical field order: id=0, tier=1.
@edsl.entity_source("customers", "c")
type Customer = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
    @edsl.column("tier")
    @edsl.dimension("CustomerTier", flag_true, flag_true, eq_ops, text_kinds)
    tier: CustomerTier,
};

# Warehouse: joins Order to Region.
# Canonical field order: id=0, region_id=1.
@edsl.entity_source("warehouses", "w")
@edsl.relation(Region, safe_kind, 1, 0)         # w.region_id = r.id
type Warehouse = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
    @edsl.column("region_id")
    region_id: Int,
};

# Region: holds OriginRegion.
# Canonical field order: id=0, name=1.
@edsl.entity_source("regions", "r")
type Region = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
    @edsl.column("name")
    @edsl.dimension("OriginRegion", flag_true, flag_true, eq_ge_le_ops, text_kinds)
    name: String,
};

# Carrier: holds CarrierName (groupable only, no filter capability).
# Canonical field order: id=0, name=1.
@edsl.entity_source("carriers", "cr")
type Carrier = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
    @edsl.column("name")
    @edsl.dimension("CarrierName", flag_true, flag_false, no_ops, no_kinds)
    name: String,
};

# ServiceLevel: holds ServiceName (groupable only, no filter capability).
# Canonical field order: id=0, name=1.
@edsl.entity_source("service_levels", "sl")
type ServiceLevel = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
    @edsl.column("name")
    @edsl.dimension("ServiceName", flag_true, flag_false, no_ops, no_kinds)
    name: String,
};

# Package: Package grain; DeliveredPackages requires Order.
# DeliveryException is a closed-vocabulary dimension without capability:
# authorized='False keeps it referenceable (typed requests can name it) but
# any grouping/sorting/filtering use fails atomically.
# Canonical field order: exception=0, id=1, order_id=2.
@edsl.entity_source("packages", "p")
@edsl.relation(Order, safe_kind, 2, 3)          # p.order_id = o.id
@edsl.relation(PackageItem, fanout_kind, 1, 1)  # p.id -> pi.package_id (expands grain)
type Package = struct {
    @edsl.column("exception")
    @edsl.dimension("DeliveryException", flag_false, flag_false, no_ops, no_kinds)
    exception: String,
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("DeliveredPackages", count_agg, requires_order)
    id: Int,
    @edsl.column("order_id")
    order_id: Int,
};

# PackageItem: PackageItem grain; UnitsShipped requires Package and Order.
# Canonical field order: id=0, package_id=1, product_id=2.
@edsl.entity_source("package_items", "pi")
@edsl.relation(Package, safe_kind, 1, 1)        # pi.package_id = p.id
@edsl.relation(Product, safe_kind, 2, 0)        # pi.product_id = pr.id
type PackageItem = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("UnitsShipped", count_agg, requires_package_order)
    id: Int,
    @edsl.column("package_id")
    package_id: Int,
    @edsl.column("product_id")
    product_id: Int,
};

# Product: joins PackageItem to Category.
# Canonical field order: category_id=0, id=1.
@edsl.entity_source("products", "pr")
@edsl.relation(Category, safe_kind, 0, 0)       # pr.category_id = cat.id
type Product = struct {
    @edsl.column("category_id")
    category_id: Int,
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
};

# Category: holds ProductCategory (reachable from Order grain only via
# fan-out, so rejected there; safe from PackageItem grain).
# Canonical field order: id=0, name=1.
@edsl.entity_source("categories", "cat")
type Category = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    id: Int,
    @edsl.column("name")
    @edsl.dimension("ProductCategory", flag_true, flag_true, eq_ge_le_ops, text_kinds)
    name: String,
};

# ---------------------------------------------------------------------------
# Measure requirement constants (must follow the entity declarations they
# reference).
# ---------------------------------------------------------------------------

def requires_none: Array(Type) = [];
def requires_order: Array(Type) = [Order];
def requires_package_order: Array(Type) = [Package, Order];

# ---------------------------------------------------------------------------
# PlanProfile accepted by this knowledge.
# ---------------------------------------------------------------------------

def profile: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Join, 'Group, 'Order, 'Limit,
    ],
    allowed_join_kinds: ['Inner],
    allowed_aggregates: ['Count],
    allowed_scalars: ['Substr, 'Eq, 'Ge, 'Le, 'And],
    allow_distinct: 'False,
};

# ---------------------------------------------------------------------------
# Authorization (fixed subject used by the public facade).
# ---------------------------------------------------------------------------

def authorize: Fn(String) -> Bool = fn(subject) {
    subject == "analyst"
};

# ---------------------------------------------------------------------------
# Prepared EnterpriseKnowledge (computed once at module load).
# ---------------------------------------------------------------------------

def payload: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [
        Order, Customer, Warehouse, Region, Carrier, ServiceLevel,
        Package, PackageItem, Product, Category,
    ];
    let result: edsl.PreparedPayload = edsl.build_root(
        "logistics-ontology-v1",
        entity_types,
        profile,
        authorize,
    );
    result
};

export {
    Order,
    Customer,
    CustomerTier,
    Warehouse,
    Region,
    Carrier,
    ServiceLevel,
    Package,
    PackageItem,
    Product,
    Category,
    profile,
    authorize,
    payload,
};
