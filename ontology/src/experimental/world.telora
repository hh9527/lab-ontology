# 显式模型边界实验：具名定义由应用提供，检查引用覆盖，不补全成员。
use crate::experimental::model as m;
use crate::experimental::transform as t;
use crate::experimental::relations as r;
use crate::experimental::groups as g;
use crate::experimental::knowledge as k;
use crate::query as qb;
use std::array as array;
use std::type_desc as td;
use std::build as build;
use std::value::{Value};

def type_entry: Fn(Type) -> Type = fn(ty) { ty };

type Entity = struct { id: String, identity: Type };
def entity: for(I) Fn(m::Entity(I)) -> Entity = fn(value) { {id: value.id, identity: value.identity} };
type World = struct {
    revision: String, types: Array(Type), entities: Array(Entity), datasets: Array(t::Declaration),
    relations: Array(r::Relation), alternatives: Array(t::Alternative), links: Array(r::Link), profile: qb::PlanProfile,
};
type Issue = struct { code: String, path: String, message: String };
def issue: Fn(String, String, String) -> Array(Issue) = fn(code, path, message) { [{code, path, message}] };
def builtin: Fn(Type) -> Bool = fn(ty) { ty == Int.type || ty == Float.type || ty == Bool.type || ty == String.type };
def named: Fn(Type) -> Bool = fn(ty) { !builtin(ty) && td::name(ty) != None };
# 只展开定义内部的结构；到另一个具名类型即停止，不发现或收集模型节点。
def reference_issues: Fn(World, Type, String) -> Array(Issue) = fn(world, ty, path) {
    if builtin(ty) { [] }
    else if named(ty) {
        if array::any(world.types, fn(provided) { provided == ty }) { [] }
        else { issue("missing_type", path, `type \{k::type_id(ty)} is not provided`) }
    } else { array::flat_map(k::type_dependencies(ty), fn(child) { reference_issues(world, child, path) }) }
};
def binding_types: Fn(g::BindingFacts) -> Array(Type) = fn(binding) {
    array::concat([[binding.row], array::flat_map(binding.members, fn(member) {
        array::concat([[member.value], k::expression_types(member.node)])
    }), match binding.contract {
        g::BindingContract::DeferredDimension(group) => [group.value],
        g::BindingContract::Numeric(group) => [group.value],
        g::BindingContract::Identity(role) => [role.identity],
        _ => [],
    }])
};
def role_issues: Fn(World, m::PreparedRole, String) -> Array(Issue) = fn(world, role, path) {
    array::concat([
        if array::any(world.entities, fn(entity) { entity.id == role.entity && entity.identity == role.identity }) { [] }
        else { issue("missing_entity", path, `entity \{role.entity} with this identity is not provided`) },
        reference_issues(world, role.identity, path),
        array::flat_map(role.parts, fn(part) {
            array::concat([reference_issues(world, part.value, path), match part.raw {
                Some(raw) => reference_issues(world, raw, path), None => [],
            }])
        })
    ])
};
def endpoint_issues: Fn(World, r::Endpoint, String) -> Array(Issue) = fn(world, endpoint, path) {
    match array::find(world.datasets, fn(d) { d.dataset.id == endpoint.dataset.id }) {
        None => issue("missing_dataset", path, `dataset \{endpoint.dataset.id} is not provided`),
        Some(d) => if d.dataset.row != endpoint.dataset.row || d.dataset.source != endpoint.dataset.source || d.dataset.grain != endpoint.dataset.grain {
            issue("conflicting_dataset", path, "endpoint differs from the provided dataset")
        } else { match array::find(d.dataset.roles, fn(role) { role.id == endpoint.role }) {
            None => issue("missing_role", path, `role \{endpoint.role} is not provided`),
            Some(role) => if array::any(endpoint.dataset.roles, fn(other) { other == role }) { [] }
                else { issue("conflicting_role", path, "endpoint differs from the provided role") },
        } },
    }
};
def relation_reference: Fn(World, r::Relation, String) -> Array(Issue) = fn(world, relation, path) {
    if array::any(world.relations, fn(provided) { provided == relation }) { [] }
    else { issue("missing_relation", path, `relation \{relation.id} is not provided with this definition`) }
};
# 数组成员检查仅用于独立自检；后续可用 telora typeid 索引替换。
def coverage: Fn(World) -> Array(Issue) = fn(world) {
    array::concat([
        array::flat_map(array::enumerate(world.types), fn(pair) {
            let path = `types[\{pair.0}]`;
            array::concat([
                if !named(pair.1) { issue("invalid_type_entry", path, "provide named model types; builtins and structures are internal") } else { [] },
                if array::any(array::enumerate(world.types), fn(other) { other.0 < pair.0 && other.1 == pair.1 }) {
                    issue("duplicate_type", path, "type is provided more than once")
                } else { [] },
                array::flat_map(k::type_dependencies(pair.1), fn(child) { reference_issues(world, child, path) })
            ])
        }),
        array::flat_map(array::enumerate(world.entities), fn(pair) {
            let path = `entities/\{pair.1.id}`;
            array::concat([reference_issues(world, pair.1.identity, path),
                if array::any(array::enumerate(world.entities), fn(other) { other.0 < pair.0 && other.1.id == pair.1.id }) {
                    issue("duplicate_entity", path, "entity id is provided more than once")
                } else { [] }])
        }),
        array::flat_map(array::enumerate(world.datasets), fn(pair) {
            let d = pair.1;
            let path = `datasets/\{d.dataset.id}`;
            let used = array::concat([[d.dataset.row], array::flat_map(d.groups, binding_types),
                array::flat_map(d.domains, fn(b) { array::concat([[b.definition.value, b.definition.wire], k::expression_types(b.node)]) }),
                array::map(d.samples, fn(b) { b.value }), array::map(d.columns, fn(c) { c.value }),
                array::map(d.scope, fn(s) { s.column.value }), array::map(d.field_counts, fn(c) { c.value }),
                array::flat_map(d.native_pairs, fn(p) { array::concat([binding_types(p.first), binding_types(p.second)]) })]);
            array::concat([
                if array::any(array::enumerate(world.datasets), fn(other) { other.0 < pair.0 && other.1.dataset.id == d.dataset.id }) {
                    issue("duplicate_dataset", path, "dataset id is provided more than once")
                } else { [] },
                array::flat_map(used, fn(ty) { reference_issues(world, ty, path) }),
                array::flat_map(array::concat([d.dataset.roles, array::flat_map(d.groups, g::binding_roles)]), fn(role) {
                    role_issues(world, role, `\{path}/roles/\{role.id}`)
                })
            ])
        }),
        array::flat_map(array::enumerate(world.relations), fn(pair) {
            let relation = pair.1;
            let path = `relations/\{relation.id}`;
            array::concat([
                if array::any(array::enumerate(world.relations), fn(other) { other.0 < pair.0 && other.1.id == relation.id }) {
                    issue("duplicate_relation", path, "relation id is provided more than once")
                } else { [] },
                endpoint_issues(world, relation.from, `\{path}/from`), endpoint_issues(world, relation.to, `\{path}/to`),
                match relation.guard { Some(guard) => reference_issues(world, guard.column.value, path), None => [] }
            ])
        }),
        array::flat_map(world.alternatives, fn(a) { array::flat_map(a.choices, fn(choice) { relation_reference(world, choice, `alternatives/\{a.id}`) }) }),
        array::flat_map(world.links, fn(link) { array::concat([
            relation_reference(world, link.a, `links/\{link.id}/a`), relation_reference(world, link.z, `links/\{link.id}/z`),
            match link.guard { Some(guard) => reference_issues(world, guard.column.value, `links/\{link.id}`), None => [] }
        ]) })
    ])
};
def self_check: Fn(World) -> Bool = fn(world) {
    let issues = coverage(world);
    if issues != [] { fail!("explicit world does not cover its definitions", issues) } else { () };
    array::map(world.entities, fn(entity) { m::validate_identity(entity.identity) });
    t::self_check(world.revision, world.datasets, world.relations, world.alternatives, world.links, world.profile)
};
# 结构投影可重复，不使用全局 visited；静态 JS 按结构标识整理节点。
def local_structure: Fn(Type) -> Array(Type) = fn(ty) {
    if builtin(ty) || named(ty) { [] }
    else { array::concat([[ty], array::flat_map(k::type_dependencies(ty), local_structure)]) }
};
def knowledge_types: Fn(World) -> Array(Type) = fn(world) {
    array::concat([[type_entry(Int.type), type_entry(Float.type), type_entry(Bool.type), type_entry(String.type)], array::flat_map(world.types, fn(ty) {
        array::concat([[ty], array::flat_map(k::type_dependencies(ty), local_structure)])
    })])
};
def prepare: Fn(World) -> t::Prepared = fn(world) {
    t::build(world.revision, world.datasets, world.relations, world.alternatives, world.links, world.profile)
        <~ {relations: world.relations}
};
def publication: Fn(World, t::Prepared) -> Value = fn(world, prepared) {
    k::publication_from(prepared, knowledge_types(world), array::map(world.entities, fn(entity) { (entity.id, entity.identity) }))
};
def stage: for(B) Fn(World, Fn(crate::ontology::PreparedPayload) -> B) -> B = fn(world, program) {
    build::stage(fn() {
        let prepared = prepare(world);
        {runtime: prepared.payload, information: {"ontology.knowledge": publication(world, prepared)}}
    }, program)
};
pub use self::{type_entry, Entity, entity, World, Issue, coverage, self_check, prepare, publication, stage};
