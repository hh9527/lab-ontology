# 33. Location concepts are not interchangeable: device asset location
#     (ServerLocation -> d.location), site name (SiteName -> s.SITE_NAME) and
#     site id (SiteId -> s.SITE_ID) lower to distinct source fields; the model
#     never rewrites one into the other.
# ---------------------------------------------------------------------------

def location_filter_intent: Fn(String, String) -> facade.Intent = fn(id, value) {
    {
        measures: [request_measure("ServerDeviceCount")],
        dimensions: [],
        filters: [filter_eq_text(id, value)],
        any_of: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
        exists: [],
        having: [],
        group_count: 'None,
        time_windows: 'None,
    }
};

export def test_location_vs_site_not_interchangeable = do {
    let asset = facade.make_intent_query(location_filter_intent("ServerLocation", "Beijing-A1-Rack01"));
    let _a: Bool = if asset.sql == "SELECT count(d.id) AS ServerDeviceCount FROM PhysicalServer AS d WHERE d.location = ?" {
        'True
    } else {
        fail!("ServerLocation must filter the device's own location column", asset.sql)
    };
    let site_name = facade.make_intent_query(location_filter_intent("SiteName", "北京总部"));
    let _b: Bool = if site_name.sql == "SELECT count(d.id) AS ServerDeviceCount FROM PhysicalServer AS d INNER JOIN X_SITE_VIEW AS s ON d.refParentSubnet = s.SITE_ID WHERE s.SITE_NAME = ?" {
        'True
    } else {
        fail!("SiteName must filter the site-view site name", site_name.sql)
    };
    let site_id = facade.make_intent_query(location_filter_intent("SiteId", "site-01"));
    let _c: Bool = if site_id.sql == "SELECT count(d.id) AS ServerDeviceCount FROM PhysicalServer AS d INNER JOIN X_SITE_VIEW AS s ON d.refParentSubnet = s.SITE_ID WHERE s.SITE_ID = ?" {
        'True
    } else {
        fail!("SiteId must filter the site-view site id", site_id.sql)
    };
    'True
};

export def test_location_dims_deterministic = do {
    let _d1: Bool = assert_deterministic_intent(location_filter_intent("ServerLocation", "Beijing-A1-Rack01"));
    let _d2: Bool = assert_deterministic_intent(location_filter_intent("SiteName", "北京总部"));
    let _d3: Bool = assert_deterministic_intent(location_filter_intent("SiteId", "site-01"));
    'True
};

