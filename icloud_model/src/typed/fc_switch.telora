use ontology::quantity as presentation;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# FC 交换机来源：分类不隐含范围过滤，容量字段不作未声明的单位换算。
use super::inventory as i;
use super::site as site;
use super::current_alarm as alarm;
use super::physical_link as link;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
type FcSwitchId = struct(String);
@domain::entity_by("FcSwitch")
type FcSwitchById = struct(FcSwitchId);
use ontology::quantity::{Ratio, Megabytes};
type PortCount = struct(Int);
@domain::subject("FcSwitch", "source_id")
@domain::dataset("source_FCSwitchDevice", "FCSwitchDevice", ["source_id"])
@domain::relations(relations)
@domain::alternatives(alternatives)
type FCSwitchDevice = struct {
    @m::column("usedCapacityRate")
    @g::field_view(
        g::dimension_group(
            "source_FCSwitchDevice__usedCapacityRate",
            Ratio.type,
            True,
            g::numeric_filters
        ),
        "source_FCSwitchDevice__usedCapacityRate",
        True,
        g::numeric_filters
    )
    @presentation::field_unit("1", "ratio", 1.0)
    source_usedCapacityRate: Ratio,
    @m::column("totalStoragePoolCapacity")
    @g::field_view(
        g::dimension_group(
            "source_FCSwitchDevice__totalStoragePoolCapacity",
            Megabytes.type,
            True,
            g::numeric_filters
        ),
        "source_FCSwitchDevice__totalStoragePoolCapacity",
        True,
        g::numeric_filters
    )
    source_totalStoragePoolCapacity: Megabytes,
    @m::column("unUsedCapacity")
    @g::field_view(
        g::dimension_group(
            "source_FCSwitchDevice__unUsedCapacity",
            Megabytes.type,
            True,
            g::numeric_filters
        ),
        "source_FCSwitchDevice__unUsedCapacity",
        True,
        g::numeric_filters
    )
    source_unUsedCapacity: Megabytes,
    @m::column("subClassName")
    @g::exact("source_FCSwitchDevice__subClassName_raw")
    @v::map(
        SourceFCSwitchDeviceSubClassName.type,
        "source_FCSwitchDevice__subClassName",
        [
            v::member(
                SourceFCSwitchDeviceSubClassName::EnterpriseFlashStorageDevice,
                ["EnterpriseStorage"]
            ),
            v::member(
                SourceFCSwitchDeviceSubClassName::DistributedStorageDevice,
                ["FusionStorageDevice"]
            ),
            v::member(
                SourceFCSwitchDeviceSubClassName::LenovoSmisStorageDevice,
                ["SmisStorageDevice"]
            ),
            v::member(
                SourceFCSwitchDeviceSubClassName::HuaweiSmisStorageDevice,
                ["HuaweiSmisStorageDevice"]
            ),
            v::member(
                SourceFCSwitchDeviceSubClassName::DataProtectionApplianceAndBackupClusterStorageDevice,
                ["SYS_ProtectDevice"]
            ),
            v::member(
                SourceFCSwitchDeviceSubClassName::MobileSpecificationDsmAndDfsStorageDevice,
                ["DsmStorageDevice"]
            ),
            v::member(SourceFCSwitchDeviceSubClassName::HpeStorageDevice, ["HPEStorageDevice"]),
            v::member(SourceFCSwitchDeviceSubClassName::VspStorageDevice, ["VSPStorageDevice"]),
            v::member(SourceFCSwitchDeviceSubClassName::FcSwitchDevice, ["FCSwitchDevice"])
        ]
    )
    source_subClassName: String,
    @m::column("nativeId")
    @g::exact("source_FCSwitchDevice__nativeId")
    source_nativeId: String,
    @m::column("name")
    @g::search("source_FCSwitchDevice__name")
    source_name: String,
    @m::column("createTime")
    @g::field_view(
        g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::numeric_filters),
        "source_FCSwitchDevice__createTime",
        True,
        g::numeric_filters
    )
    source_createTime: s::EpochMillis,
    @m::column("regionId")
    @g::exact("source_FCSwitchDevice__regionId")
    source_regionId: String,
    @m::column("tenantId")
    @g::exact("source_FCSwitchDevice__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("id")
    @g::exact("source_FCSwitchDevice__id")
    source_id: FcSwitchById,
    @m::column("belongSeries")
    @g::search("source_FCSwitchDevice__belongSeries")
    source_belongSeries: String,
    @m::column("projectId")
    @g::exact("source_FCSwitchDevice__projectId")
    source_projectId: domain::Reference(site::SiteById),
    @m::column("powerStatus")
    @g::exact("source_FCSwitchDevice__powerStatus_raw")
    @v::map(
        SourceFCSwitchDevicePowerStatus.type,
        "source_FCSwitchDevice__powerStatus",
        [
            v::member(SourceFCSwitchDevicePowerStatus::PowerOff, ["poweroff"]),
            v::member(SourceFCSwitchDevicePowerStatus::PowerOn, ["poweron"])
        ]
    )
    source_powerStatus: String,
    @m::column("classification")
    @g::exact("source_FCSwitchDevice__classification_raw")
    @v::map(
        SourceFCSwitchDeviceClassification.type,
        "source_FCSwitchDevice__classification",
        [
            v::member(SourceFCSwitchDeviceClassification::HuaweiStorageDevice, ["HuaweiStorage"]),
            v::member(SourceFCSwitchDeviceClassification::FibreChannelSwitch, ["FcSwitch"]),
            v::member(
                SourceFCSwitchDeviceClassification::ThirdPartyStorageDevice,
                ["ThirdPartyStorage"]
            )
        ]
    )
    source_classification: String,
    @m::column("hotPatchVersion")
    @g::search("source_FCSwitchDevice__hotPatchVersion")
    source_hotPatchVersion: String,
    @m::column("deviceType")
    @g::exact("source_FCSwitchDevice__deviceType_raw")
    @v::map(
        SourceFCSwitchDeviceDeviceType.type,
        "source_FCSwitchDevice__deviceType",
        [
            v::member(SourceFCSwitchDeviceDeviceType::StorageDevice, ["storage"]),
            v::member(SourceFCSwitchDeviceDeviceType::FcSwitch, ["fcswitch"])
        ]
    )
    source_deviceType: String,
    @m::column("parentResId")
    @g::exact("source_FCSwitchDevice__parentResId")
    source_parentResId: domain::Reference(site::SiteById),
    @m::column("runningStatus")
    @g::exact("source_FCSwitchDevice__runningStatus_raw")
    @v::map(
        SourceFCSwitchDeviceRunningStatus.type,
        "source_FCSwitchDevice__runningStatus",
        [
            v::member(SourceFCSwitchDeviceRunningStatus::Normal, ["1"]),
            v::member(SourceFCSwitchDeviceRunningStatus::NotRunning, ["3"]),
            v::member(SourceFCSwitchDeviceRunningStatus::PoweringOn, ["12"]),
            v::member(SourceFCSwitchDeviceRunningStatus::PoweringOff, ["47"]),
            v::member(SourceFCSwitchDeviceRunningStatus::Upgrading, ["51"])
        ]
    )
    source_runningStatus: String,
    @m::column("healthStatus")
    @g::exact("source_FCSwitchDevice__healthStatus_raw")
    @v::map(
        SourceFCSwitchDeviceHealthStatus.type,
        "source_FCSwitchDevice__healthStatus",
        [
            v::member(SourceFCSwitchDeviceHealthStatus::Normal, ["1"]),
            v::member(SourceFCSwitchDeviceHealthStatus::Faulty, ["2"])
        ]
    )
    source_healthStatus: String,
    @m::column("connectStatus")
    @g::exact("source_FCSwitchDevice__connectStatus_raw")
    @v::map(
        SourceFCSwitchDeviceConnectStatus.type,
        "source_FCSwitchDevice__connectStatus",
        [
            v::member(SourceFCSwitchDeviceConnectStatus::Offline, [0]),
            v::member(SourceFCSwitchDeviceConnectStatus::Online, [1]),
            v::member(SourceFCSwitchDeviceConnectStatus::Disconnected, [9])
        ]
    )
    source_connectStatus: Int,
    @m::column("usedCapacity")
    @g::field_view(
        g::dimension_group(
            "source_FCSwitchDevice__usedCapacity",
            Megabytes.type,
            True,
            g::numeric_filters
        ),
        "source_FCSwitchDevice__usedCapacity",
        True,
        g::numeric_filters
    )
    source_usedCapacity: Megabytes,
    @m::column("totalCapacity")
    @g::field_view(
        g::dimension_group(
            "source_FCSwitchDevice__totalCapacity",
            Megabytes.type,
            True,
            g::numeric_filters
        ),
        "source_FCSwitchDevice__totalCapacity",
        True,
        g::numeric_filters
    )
    source_totalCapacity: Megabytes,
    @m::column("manufacturer")
    @g::search("source_FCSwitchDevice__manufacturer")
    source_manufacturer: String,
    @m::column("sn")
    @g::search("source_FCSwitchDevice__sn")
    source_sn: String,
    @m::column("productmodel")
    @g::search("source_FCSwitchDevice__productmodel")
    source_productmodel: String,
    @m::column("location")
    @g::search("source_FCSwitchDevice__location")
    source_location: String,
    @m::column("ipAddress")
    @g::search("source_FCSwitchDevice__ipAddress")
    @g::ipv4_view("source_FCSwitchDevice__ipAddress_ipv4")
    source_ipAddress: String,
    @m::column("version")
    @g::search("source_FCSwitchDevice__version")
    source_version: String,
    @m::column("serialNum")
    @g::search("source_FCSwitchDevice__serialNum")
    source_serialNum: String,
    @m::column("virtualFabricId")
    @g::exact("source_FCSwitchDevice__virtualFabricId")
    source_virtualFabricId: String,
    @m::column("portNum")
    @g::field_view(
        g::dimension_group(
            "source_FCSwitchDevice__portNum",
            PortCount.type,
            True,
            g::numeric_filters
        ),
        "source_FCSwitchDevice__portNum",
        True,
        g::numeric_filters
    )
    source_portNum: PortCount,
    @m::column("domainId")
    @g::exact("source_FCSwitchDevice__domainId")
    source_domainId: String,
    @m::column("fabricWwn")
    @g::search("source_FCSwitchDevice__fabricWwn")
    source_fabricWwn: String,
    @m::column("wwn")
    @g::search("source_FCSwitchDevice__wwn")
    source_wwn: String,
};

def subject: r::Endpoint = domain::endpoint(FCSwitchDevice.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(FCSwitchDevice.type, "source_tenantId");
def parent_site: r::Endpoint = domain::endpoint(FCSwitchDevice.type, "source_parentResId");
def project_site: r::Endpoint = domain::endpoint(FCSwitchDevice.type, "source_projectId");
def alarm_reference: r::Endpoint = domain::endpoint(alarm::TCurrentAlarm.type, "fc_alarm_reference");
def a_reference: r::Endpoint = domain::endpoint(link::EnterprisePhysicalLink.type, "fc_a_reference");
def z_reference: r::Endpoint = domain::endpoint(link::EnterprisePhysicalLink.type, "fc_z_reference");

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceSubClassName = enum {
    @ev::description("Enterprise flash storage device", "闪存存储设备")
    EnterpriseFlashStorageDevice,

    @ev::description("Distributed storage device", "分布式存储设备")
    DistributedStorageDevice,

    @ev::description("Lenovo SMIS storage device", "联想SISM存储设备")
    LenovoSmisStorageDevice,

    @ev::description("Huawei SMIS storage device", "华为SMIS存储设备")
    HuaweiSmisStorageDevice,

    @ev::description(
        "Data protection appliance and backup cluster storage device",
        "数据保护一体机、备份集群存储设备"
    )
    DataProtectionApplianceAndBackupClusterStorageDevice,

    @ev::description("Mobile specification DSM and DFS storage device", "移动规范DSM、DFS存储设备")
    MobileSpecificationDsmAndDfsStorageDevice,

    @ev::description("HPE storage device", "HP存储设备")
    HpeStorageDevice,

    @ev::description("VSP storage device", "VSP存储设备")
    VspStorageDevice,

    @ev::description("FC switch device", "FC交换机")
    FcSwitchDevice,
};

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDevicePowerStatus = enum {
    @ev::description("power off", "下电")
    PowerOff,

    @ev::description("power on", "上电")
    PowerOn,
};

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceClassification = enum {
    @ev::description("Huawei Storage Device", "华为存储设备")
    HuaweiStorageDevice,

    @ev::description("Fibre Channel Switch", "交换机")
    FibreChannelSwitch,

    @ev::description("Third-Party Storage Device", "三方存储设备")
    ThirdPartyStorageDevice,
};

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceDeviceType = enum {
    @ev::description("storage device", "存储设备")
    StorageDevice,

    @ev::description("FC switch", "FC交换机")
    FcSwitch,
};

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceRunningStatus = enum {
    @ev::description("Normal", "正常")
    Normal,

    @ev::description("Not Running", "未运行")
    NotRunning,

    @ev::description("Powering On", "正在上电")
    PoweringOn,

    @ev::description("Powering Off", "正在下电")
    PoweringOff,

    @ev::description("Upgrading", "正在升级")
    Upgrading,
};

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceHealthStatus = enum {
    @ev::description("Normal", "正常")
    Normal,

    @ev::description("Faulty", "故障")
    Faulty,
};

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceConnectStatus = enum {
    @ev::itag(0)
    @ev::description("offline", "离线")
    Offline,
    @ev::itag(1)
    @ev::description("online", "在线")
    Online,
    @ev::itag(9)
    @ev::description("Disconnected", "连接失败")
    Disconnected,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_FCSwitchDevice_EnterprisePhysicalLink_a",
        subject,
        a_reference,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_FCSwitchDevice_EnterprisePhysicalLink_z",
        subject,
        z_reference,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_FCSwitchDevice_T_CURRENT_ALARM",
        subject,
        alarm_reference,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation("source_FCSwitchDevice_X_TENANT_VIEW", tenant, i::tenant_subject, cardinality),
];
def alternatives: Array(domain::Alternative) = [
    {
        id: "source_FCSwitchDevice_X_SITE_VIEW",
        cardinality,
        choices: [
            r::relation("fc_parent_site", parent_site, site::subject, cardinality),
            r::relation("fc_project_site", project_site, site::subject, cardinality),
        ]
    }
];
pub use self::{
    FcSwitchId,
    FcSwitchById,
    FCSwitchDevice,
    subject,
    alarm_reference,
    a_reference,
    z_reference,
    relations,
    alternatives
};

pub use self::{
    SourceFCSwitchDeviceSubClassName,
    SourceFCSwitchDevicePowerStatus,
    SourceFCSwitchDeviceClassification,
    SourceFCSwitchDeviceDeviceType,
    SourceFCSwitchDeviceRunningStatus,
    SourceFCSwitchDeviceHealthStatus,
    SourceFCSwitchDeviceConnectStatus
};
