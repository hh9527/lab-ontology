use dog_model::model as dog;
use spider_model::model as spider;
use world_model::model as world;
use ontology::intent as intent;
use ontology::knowledge as knowledge;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use std::codec as codec;
use std::transform_service as service;
use std::value::{ Value };

type DogQueryService = struct { lower: Fn(Value) -> qb::Query };
impl service::TransformService for DogQueryService {
    init: fn(ctx) { {lower: intent::query_request_lower_factory(dog::payload, "resolver", sqlite::build_query)}.ty!(Self) },
    transform: fn(self, input) { codec::encode(self.lower(input)) },
};

type SpiderQueryService = struct { lower: Fn(Value) -> qb::Query };
impl service::TransformService for SpiderQueryService {
    init: fn(ctx) { {lower: intent::query_request_lower_factory(spider::payload, "public", sqlite::build_query)}.ty!(Self) },
    transform: fn(self, input) { codec::encode(self.lower(input)) },
};

type WorldQueryService = struct { lower: Fn(Value) -> qb::Query };
impl service::TransformService for WorldQueryService {
    init: fn(ctx) { {lower: intent::query_request_lower_factory(world::payload, "public", sqlite::build_query)}.ty!(Self) },
    transform: fn(self, input) { codec::encode(self.lower(input)) },
};

type DogInfoService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for DogInfoService {
    init: fn(ctx) { {handle: knowledge::knowledge_info_method_factory(dog::payload, "resolver")}.ty!(Self) },
    transform: fn(self, input) { self.handle(input) },
};

type DogIndexService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for DogIndexService {
    init: fn(ctx) { {handle: knowledge::knowledge_index_method_factory(dog::payload, "resolver")}.ty!(Self) },
    transform: fn(self, input) { self.handle(input) },
};

type SpiderInfoService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for SpiderInfoService {
    init: fn(ctx) { {handle: knowledge::knowledge_info_method_factory(spider::payload, "public")}.ty!(Self) },
    transform: fn(self, input) { self.handle(input) },
};

type SpiderIndexService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for SpiderIndexService {
    init: fn(ctx) { {handle: knowledge::knowledge_index_method_factory(spider::payload, "public")}.ty!(Self) },
    transform: fn(self, input) { self.handle(input) },
};

type WorldInfoService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for WorldInfoService {
    init: fn(ctx) { {handle: knowledge::knowledge_info_method_factory(world::payload, "public")}.ty!(Self) },
    transform: fn(self, input) { self.handle(input) },
};

type WorldIndexService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for WorldIndexService {
    init: fn(ctx) { {handle: knowledge::knowledge_index_method_factory(world::payload, "public")}.ty!(Self) },
    transform: fn(self, input) { self.handle(input) },
};

@service::collection
pub type MainService = struct {
    @service::slot("dog/transform") dog_query: DogQueryService,
    @service::slot("dog/index") dog_index: DogIndexService,
    @service::slot("dog/info") dog_info: DogInfoService,
    @service::slot("spider/transform") spider_query: SpiderQueryService,
    @service::slot("spider/index") spider_index: SpiderIndexService,
    @service::slot("spider/info") spider_info: SpiderInfoService,
    @service::slot("world/transform") world_query: WorldQueryService,
    @service::slot("world/index") world_index: WorldIndexService,
    @service::slot("world/info") world_info: WorldInfoService,
};
