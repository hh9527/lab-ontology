@registry::dataset(
    "kpi-storage-cloud-block-server",
    "kpi_storage_cloudBlockServer",
    ["obj_id", "ts"]
)
@registry::roles([role_228])
@registry::groups(
    [
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_cloudBlockServer.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "scbs_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_cloudBlockServer.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "scbs_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_cloudBlockServer.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "scbs_utc_month",
            True,
            g::time_filters
        )
    ]
)
