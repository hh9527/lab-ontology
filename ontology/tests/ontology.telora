    {table: "union_float_rows", alias: "ufi", columns: union_single_float_column, filter: Some(union_int_on_float)},
];
def union_good_int_branches: Array(edsl::UnionBranchDecl) = [
    {table: "union_int_rows", alias: "uig", columns: union_single_int_column, filter: Some(union_int_on_int)},
];
def union_bad_enum_branches: Array(edsl::UnionBranchDecl) = [
    {table: "union_state_rows", alias: "use", columns: union_single_state_column, filter: Some(union_unknown_state)},
];
def union_good_enum_branches: Array(edsl::UnionBranchDecl) = [
    {table: "union_state_rows", alias: "usg", columns: union_single_state_column, filter: Some(union_known_state)},
];

