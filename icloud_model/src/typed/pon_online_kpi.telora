use ontology::registry as registry;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_device as pon;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::transform as t;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
# 仅沿用旧百分比尺度假定，尚未确认生产比例；不增加范围检查。
type AssumedOnlinePercent = struct(
    Float
);
def online_statistics: samples::Group(AssumedOnlinePercent) = samples::group(
    "reported_network_online",
    AssumedOnlinePercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max],
    Some("%")
);
@registry::dataset(
    "source_PonDeviceOnlineKPI",
    "PonDeviceOnlineKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@registry::roles([owner])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceOnlineKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceOnlineKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_PonDeviceOnlineKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceOnlineKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_PonDeviceOnlineKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceOnlineKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_PonDeviceOnlineKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceOnlineKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_PonDeviceOnlineKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceOnlineKPI__onlineRate",
                AssumedOnlinePercent.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PonDeviceOnlineKPI.type, AssumedOnlinePercent.type, "source_onlineRate")
            ),
            "source_PonDeviceOnlineKPI__onlineRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceOnlineKPI__onlineRateEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PonDeviceOnlineKPI.type, EffectiveCount.type, "source_onlineRateEffcnt")
            ),
            "source_PonDeviceOnlineKPI__onlineRateEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::metric("source_ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            online_statistics,
            m::field(PonDeviceOnlineKPI.type, AssumedOnlinePercent.type, "source_onlineRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_online_table_rate_avg"},
                {statistic: samples::Statistic::Min, publish: "pon_online_table_rate_min"},
                {statistic: samples::Statistic::Max, publish: "pon_online_table_rate_max"}
            ]
        ),
    ]
)
@registry::relations(relations)
type PonDeviceOnlineKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_PonDeviceOnlineKPI__resId")
    source_resId: pon::PonId,
    @m::column("tenantId")
    @g::exact("source_PonDeviceOnlineKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_PonDeviceOnlineKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_PonDeviceOnlineKPI__projectId")
    source_projectId: String,
    @m::column("onlineRate")
    source_onlineRate: AssumedOnlinePercent,
    @m::column("onlineRateEffcnt")
    source_onlineRateEffcnt: EffectiveCount,
};
def dataset: m::Dataset(PonDeviceOnlineKPI) = registry::dataset_of(PonDeviceOnlineKPI.type);
def owner: m::Role(PonDeviceOnlineKPI) = m::role(
    dataset,
    pon::entity,
    "owner",
    False,
    [
        m::identity_part(
            m::field(PonDeviceOnlineKPI.type, pon::PonId.type, "source_resId"),
            m::field(pon::Identity.type, pon::PonId.type, "id")
        )
    ]
);

def declaration: t::Declaration = registry::declaration(PonDeviceOnlineKPI.type);
def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElement_PonDeviceOnlineKPI",
        pon::dataset,
        pon::subject,
        dataset,
        owner,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{declaration, relations};

pub use self::{PonDeviceOnlineKPI};
