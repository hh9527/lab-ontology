pub def integer_json_value_is_accepted_by_number_dimension: test::Test = test::should_ok(fn() {
    let numeric = edsl::build_root("numeric", [NumericSample.type], payload.profile);
    let ast = query_intent_ast_factory(numeric)(json::parse(r#"{
        "op":"Graph","root":"n","nodes":[{"id":"n","entity":"numeric_samples"}],
        "edges":[],"select":[],"count":"n",
        "filters":[{"node":"n","dimension":"sample_amount","op":"Ge","value":5}]
    }"#).unwrap!());
    let query = sqlite::build_query(ast);
    if query.bindings == [qb::Val::Int(5)] { True }
    else { fail!("number dimension did not accept an integer JSON value", query) }
});

