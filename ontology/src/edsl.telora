# EnterpriseKnowledge eDSL core (domain-independent).
#
# Provides:
#   - typed-property carriers for declaring enterprise knowledge on nominal
#     entity structs (physical columns, keys, measures, dimensions, computed
#     dimensions, entity sources, relations);
#   - one-time root preparation (build_root) that collects the property facts,
#     validates them, precomputes safe paths, and publishes a PreparedPayload;
#   - a hot-path lowering (lower) that turns a typed QueryRequest into a
#     query Plan and validates it against the knowledge's PlanProfile.
#
# All Plan/PlanProfile/Query types come from this crate's query module.

import "@src/query" as qb;
import "std/array" as array;
import "std/type-desc" as td;
import "std/type-property" as property;

# ---------------------------------------------------------------------------
# Property carriers (declared on entity structs and their fields).
# ---------------------------------------------------------------------------

# Member-level: physical column mapping for a field.
@property('Field)
type ColumnMap = struct { column: String };

# Member-level: marks a field as the entity key.
@property('Field)
type KeyFlag = struct { value: Bool };

# Member-level: measure declaration (aggregate over a field at the entity's
# natural grain). The id is the stable business vocabulary id (exchange
# protocol); the aggregate output alias is derived from it at prepare time.
# `requires` lists additional entities the measure semantics need (beyond its
# own grain), reached only through grain-safe paths.
@property('Field)
type MeasureDef = struct {
    id: String,
    aggregate: qb.AggregateFunction,
    requires: Array(Type),
};

# Member-level: filtered measure declaration. Adds a domain-declared inherent
# predicate to the aggregate: only rows matching the predicate count into this
# measure. The predicate references a declared, authorized, filterable dimension
# of the same entity (reusing enum value, operation, input kind and scope
# validation). The inherent predicate and user global filters keep separate
# semantics and are never flattened into one global AND. Multiple annotations
# fold by appending (composable).
@property('Field)
type FilteredMeasureDef = struct { measures: Array(FilteredMeasureSpec) };

type FilteredMeasureSpec = struct {
    id: String,
    aggregate: qb.AggregateFunction,
    requires: Array(Type),
    predicate: ScopePredicate,
};

# Member-level: computed measure declaration. Combines two already-declared
# measures (plain, filtered, or computed) with a restricted 'Add/'Sub. The
# dependencies must exist and share the declaring entity's grain; the dependency
# graph must be acyclic. Multiple annotations fold by appending.
@property('Field)
type ComputedMeasureDef = struct { measures: Array(ComputedMeasureSpec) };

type ComputedMeasureSpec = struct {
    id: String,
    op: qb.ComputedOp,
    left: String,
    right: String,
};

# Member-level: plain dimension declaration over a field. `authorized` is the
# query/projection authorization status: an unauthorized dimension still
# belongs to the closed vocabulary (typed requests may reference it) but any
# grouping/sorting/filtering use fails atomically. `filterable` independently
# controls whether a filter capability exists for an authorized dimension.
@property('Field)
type DimensionDef = struct {
    id: String,
    authorized: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
};

# Member-level: computed dimension declaration. The builder receives the base
# field's column expression and returns the canonical computed expression
# (e.g. Substr(column, 1, 7)); literals are lowered to bound values at build
# time, never pre-rendered SQL. Builders may use any closed query scalar
# (including 'Instr, 'If, 'Add, 'Sub) and are validated by arity checks.
@property('Field)
type ComputedDimensionDef = struct {
    id: String,
    authorized: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
    build: Fn(qb.Expr) -> qb.Expr,
};

# Member-level: JSON-backed dimension declaration. The annotated field's physical
# column is the JSON document; the fixed `path` (declared by the domain model
# author) becomes a String binding through query's JsonExtract. Dynamic requests
# only see the business Dimension id and never carry the path. Multiple
# annotations fold by appending.
@property('Field)
type JsonDimensionDef = struct { dimensions: Array(JsonDimensionSpec) };

type JsonDimensionSpec = struct {
    id: String,
    authorized: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
    path: String,
};

# Member-level: inherent row-range scope of a dimension member. Predicates
# reference canonical field indexes of the member's own entity; the scope is
# merged with user filters in deterministic order at lowering time. Dynamic
# values stay parameterized; contradictory scope/filter constraints fail.
@property('Field)
type ScopeDef = struct { predicates: Array(ScopePredicate) };

# Type-level: entity base data source.
@property('Type)
type EntitySource = struct { table: String, alias: String };

# Type-level: stable business id of an entity (used by existence filters and
# row-level targets). Falls back to the source alias when absent.
@property('Type)
type EntityId = struct { id: String };

# Union (multi-source) entity declaration. An entity declared only with
# `union_source` (and no `entity_source`) is a logical entity whose rows are the
# UNION ALL of an ordered list of physical branches. Every branch maps each
# canonical logical field (by index) to that branch's physical column; all
# branches must map the full logical field set with a consistent order. Optional
# `filter` is a fixed, closed row filter over one logical field (Eq). No raw
# SQL/Expr/fragment is accepted.
type UnionColumnDecl = struct {
    field: Int,
    column: String,
};

type UnionBranchDecl = struct {
    table: String,
    alias: String,
    columns: Array(UnionColumnDecl),
    filter: Option(ScopePredicate),
};

@property('Type)
type UnionSourceDef = struct {
    alias: String,
    branches: Array(UnionBranchDecl),
};

# Type-level: relation declarations from this entity to target entities.
@property('Type)
type RelationDef = struct { relations: Array(RelationDecl) };

# A single column-equality key between two entities: `from`/`to` are canonical
# field indexes of the declaring (from) entity and the target (to) entity.
type RelationPair = struct { from: Int, to: Int };

# Relation key: a closed conjunction/disjunction tree over column-equality
# pairs. `'And`/`'Or` arrays must be non-empty. It lowers to the query public
# JoinCondition tree via `join_on`/`on_eq`/`on_and`/`on_or`; no raw SQL.
type RelationKey = enum {
    'Eq(RelationPair),
    'And(Array(RelationKey)),
    'Or(Array(RelationKey)),
};

type RelationDecl = struct {
    target: Type,
    kind: RelationKind,
    key: RelationKey,
};

# Variant-level: stable external/physical value and display label for a
# payload-free enum variant. When a plain dimension field is typed with a
# named enum, its variants (with or without this annotation) form the closed
# value domain: the stable value is used for filtering bindings and the label
# for discovery. Variants without the annotation use the variant name as both
# stable value and label.
@property('Variant)
type EnumValueDef = struct { value: String, label: String };

# ---------------------------------------------------------------------------
# Public request vocabulary.
# ---------------------------------------------------------------------------

type RelationKind = enum { 'Safe, 'FanOut };

# Filter operations. Comparison ops map to the closed query scalars
# ('Eq/'Ne/'Gt/'Ge/'Lt/'Le); text ops ('Contains/'NotContains/'StartsWith/
# 'EndsWith) lower through the closed 'Instr/'Lower/'Length/'Substr/'Add/'Sub
# vocabulary and always keep the runtime value in a parameterized Bind.
type FilterOp = enum {
    'Eq, 'Ne, 'Gt, 'Ge, 'Lt, 'Le,
    'Contains, 'NotContains, 'StartsWith, 'EndsWith,
};

type FilterInputKind = enum { 'Text, 'Number, 'Int };

type FilterInput = enum {
    'Text(String),
    'Number(Float),
    'Int(Int),
};

# A member's inherent row-range scope predicate: a constraint on one field of
# the member's own entity (canonical field index, filter op, literal value).
# Scope predicates always lower to parameterized bindings.
type ScopePredicate = struct {
    field: Int,
    op: FilterOp,
    input: FilterInput,
};

type OrderDirection = enum { 'Asc, 'Desc };

type OrderTarget = enum {
    'Measure(String),
    'Dimension(String),
};

type MeasureInput = enum { 'All, 'Distinct };

type DimensionInput = enum { 'None };

type MeasureRequest = struct {
    id: String,
    subject: String,
    input: MeasureInput,
};

type DimensionRequest = struct {
    id: String,
    subject: String,
    input: DimensionInput,
};

type FilterRequest = struct {
    id: String,
    subject: String,
    op: FilterOp,
    input: FilterInput,
};

# A closed OR-group over a single dimension: a base row matches when its value
# equals any of the listed values (lowered to the query `Or(Eq(...), ...)`).
# Values keep request order and become parameterized bindings; there is no raw
# Expr/SQL/column/alias escape.
type AnyOfRequest = struct {
    id: String,
    subject: String,
    values: Array(FilterInput),
};

type OrderRequest = struct {
    target: OrderTarget,
    direction: OrderDirection,
};

# Restricted Top Per Group request: partition the aggregated result by a set of
# selected dimensions and keep the top `take` rows per partition under a stable
# ordering. v1 does not combine with a global limit or offset.
type PartitionRequest = struct {
    by: Array(String),   # dimension ids defining the partitions
    take: Int,           # positive integer with an upper bound (max_partition_take)
};

type QueryRequest = struct {
    measures: Array(MeasureRequest),
    dimensions: Array(DimensionRequest),
    filters: Array(FilterRequest),
    ordering: Array(OrderRequest),
    limit: Option(Int),
    offset: Option(Int),
    partition: Option(PartitionRequest),
};

# Existence filter request: keeps the base grain while restricting to base rows
# that have at least one related row in the target entity (or, when
# `min_matches` is set, at least `min_matches` related rows). The target is a
# stable entity id related to the base entity; the relation may be declared in
# either direction (a reverse existence is derived without duplicating edges)
# and fan-out relations are allowed (existence never amplifies the subject
# grain). `filters` constrain the related rows and are parameterized bindings.
type ExistsRequest = struct {
    target: String,
    subject: String,
    filters: Array(FilterRequest),
    any_of: Array(AnyOfRequest),
    min_matches: Option(Int),
};

# Aggregate-result (HAVING) predicate over a requested measure alias.
type HavingOp = enum { 'Eq, 'Ne, 'Gt, 'Ge, 'Lt, 'Le };

type HavingRequest = struct {
    measure: String,
    subject: String,
    op: HavingOp,
    threshold: FilterInput,
};

# ---------------------------------------------------------------------------
# Prepared payload types.
# ---------------------------------------------------------------------------

type FieldEntry = struct {
    index: Int,
    name: String,
    column: String,
    is_key: Bool,
    ty: Type,
};

# One member of a closed enum value domain. `value` is the stable
# external/physical value used for filter bindings; `label` is the display
# label; `variant` is the canonical enum variant name.
type EnumValueEntry = struct {
    variant: String,
    value: String,
    label: String,
};

# Prepared union (derived) branch: physical source, ordered per-field physical
# column names (aligned to the canonical logical field order), and an optional
# fixed row filter over one logical field.
type UnionBranchEntry = struct {
    table: String,
    alias: String,
    columns: Array(String),
    filter: Option(ScopePredicate),
};

# Prepared union (derived) source: the logical alias and ordered branches.
type UnionEntry = struct {
    alias: String,
    branches: Array(UnionBranchEntry),
};

type EntityEntry = struct {
    index: Int,
    id: String,
    entity_type: Type,
    table: String,
    alias: String,
    key_field: Int,
    fields: Array(FieldEntry),
    union: Option(UnionEntry),
};

# Prepared dependency spec of a computed measure: operands are business measure
# ids resolved at lowering time against the prepared measures.
type ComputedMeasureEntry = struct {
    op: qb.ComputedOp,
    left: String,
    right: String,
};

type MeasureEntry = struct {
    id: String,
    entity: Int,
    field: Int,
    aggregate: qb.AggregateFunction,
    alias: String,
    requires: Array(Int),
    predicate: Option(ScopePredicate),
    computed: Option(ComputedMeasureEntry),
};

type DimensionEntry = struct {
    id: String,
    entity: Int,
    field: Int,
    computed: Bool,
    build: Fn(qb.Expr) -> qb.Expr,
    authorized: Bool,
    filterable: Bool,
    ops: Array(FilterOp),
    input_kinds: Array(FilterInputKind),
    values: Array(EnumValueEntry),
    scope: Array(ScopePredicate),
};

type RelationEntry = struct {
    from: Int,
    to: Int,
    kind: RelationKind,
    key: RelationKey,
};

type PathResult = enum {
    'Safe(Array(Int)),
    'FanOut(Array(Int)),
    'Missing,
    'Truncated,
};

type PreparedPayload = struct {
    revision: String,
    entities: Array(EntityEntry),
    measures: Array(MeasureEntry),
    dimensions: Array(DimensionEntry),
    relations: Array(RelationEntry),
    paths: Array(Array(PathResult)),
    profile: qb.PlanProfile,
    authorize: Fn(String) -> Bool,
};

# ---------------------------------------------------------------------------
# Provider factories (used as decorators by the knowledge author).
# ---------------------------------------------------------------------------

def column: Fn(String) -> Fn(property.FieldPropertyCtx, Option(ColumnMap)) -> ColumnMap = fn(column) {
    fn(ctx, previous) {
        let result: ColumnMap = { column };
        result
    }
};

def key: Fn(Bool) -> Fn(property.FieldPropertyCtx, Option(KeyFlag)) -> KeyFlag = fn(value) {
    fn(ctx, previous) {
        let result: KeyFlag = { value };
        result
    }
};

def measure: Fn(String, qb.AggregateFunction, Array(Type)) -> Fn(property.FieldPropertyCtx, Option(MeasureDef)) -> MeasureDef = fn(id, aggregate, requires) {
    fn(ctx, previous) {
        let result: MeasureDef = { id, aggregate, requires };
        result
    }
};

def filtered_measure: Fn(String, qb.AggregateFunction, Array(Type), ScopePredicate) -> Fn(property.FieldPropertyCtx, Option(FilteredMeasureDef)) -> FilteredMeasureDef = fn(id, aggregate, requires, predicate) {
    fn(ctx, previous) {
        let spec: FilteredMeasureSpec = { id, aggregate, requires, predicate };
        let all = match previous {
            'Some(p) => array.push(p.measures, spec),
            'None => [spec],
        };
        let result: FilteredMeasureDef = { measures: all };
        result
    }
};

def computed_measure: Fn(String, qb.ComputedOp, String, String) -> Fn(property.FieldPropertyCtx, Option(ComputedMeasureDef)) -> ComputedMeasureDef = fn(id, op, left, right) {
    fn(ctx, previous) {
        let spec: ComputedMeasureSpec = { id, op, left, right };
        let all = match previous {
            'Some(p) => array.push(p.measures, spec),
            'None => [spec],
        };
        let result: ComputedMeasureDef = { measures: all };
        result
    }
};

def dimension: Fn(String, Bool, Bool, Array(FilterOp), Array(FilterInputKind)) -> Fn(property.FieldPropertyCtx, Option(DimensionDef)) -> DimensionDef = fn(id, authorized, filterable, ops, input_kinds) {
    fn(ctx, previous) {
        let result: DimensionDef = { id, authorized, filterable, ops, input_kinds };
        result
    }
};

def computed_dimension: Fn(String, Bool, Bool, Array(FilterOp), Array(FilterInputKind), Fn(qb.Expr) -> qb.Expr) -> Fn(property.FieldPropertyCtx, Option(ComputedDimensionDef)) -> ComputedDimensionDef = fn(id, authorized, filterable, ops, input_kinds, build) {
    fn(ctx, previous) {
        let result: ComputedDimensionDef = { id, authorized, filterable, ops, input_kinds, build };
        result
    }
};

def json_dimension: Fn(String, Bool, Bool, Array(FilterOp), Array(FilterInputKind), String) -> Fn(property.FieldPropertyCtx, Option(JsonDimensionDef)) -> JsonDimensionDef = fn(id, authorized, filterable, ops, input_kinds, path) {
    fn(ctx, previous) {
        let spec: JsonDimensionSpec = { id, authorized, filterable, ops, input_kinds, path };
        let all = match previous {
            'Some(p) => array.push(p.dimensions, spec),
            'None => [spec],
        };
        let result: JsonDimensionDef = { dimensions: all };
        result
    }
};

# Prepared build closure for a JSON dimension: json_extract(column, fixed path).
# The path is a String capture that query lowers to a `?` binding, never into SQL
# text or an identifier.
def json_builder: Fn(String) -> Fn(qb.Expr) -> qb.Expr = fn(path) {
    fn(col) { qb.json_extract(col, path) }
};

def entity_source: Fn(String, String) -> Fn(td.TypeDesc, Option(EntitySource)) -> EntitySource = fn(table, alias) {
    fn(ctx, previous) {
        let result: EntitySource = { table, alias };
        result
    }
};

def entity_id: Fn(String) -> Fn(td.TypeDesc, Option(EntityId)) -> EntityId = fn(id) {
    fn(ctx, previous) {
        let result: EntityId = { id };
        result
    }
};

# Union (multi-source) entity provider: marks the annotated type as a logical
# entity backed by an ordered UNION ALL of physical branches. Mutually exclusive
# with `entity_source`; branch aliases must not collide with the union alias.
def union_source: Fn(String, Array(UnionBranchDecl)) -> Fn(td.TypeDesc, Option(UnionSourceDef)) -> UnionSourceDef = fn(u_alias, branches) {
    fn(ctx, previous) {
        let result: UnionSourceDef = { alias: u_alias, branches };
        result
    }
};

# Single-column-equality relation sugar: `from_field` is a canonical field
# index on the declaring entity, `to_field` on the target entity.
def relation: Fn(Type, RelationKind, Int, Int) -> Fn(td.TypeDesc, Option(RelationDef)) -> RelationDef = fn(target, kind, from_field, to_field) {
    fn(ctx, previous) {
        let pair: RelationPair = { from: from_field, to: to_field };
        let entry: RelationDecl = { target, kind, key: 'Eq(pair) };
        let relations = match previous {
            'Some(p) => array.push(p.relations, entry),
            'None => [entry],
        };
        let result: RelationDef = { relations };
        result
    }
};

# Relation with a structured key: `'Eq(pair)`, `'And(...)` or `'Or(...)` over
# column-equality pairs (conjunctive/disjunctive keys). Multiple annotations
# fold by appending.
def relation_key: Fn(Type, RelationKind, RelationKey) -> Fn(td.TypeDesc, Option(RelationDef)) -> RelationDef = fn(target, kind, key) {
    fn(ctx, previous) {
        let entry: RelationDecl = { target, kind, key };
        let relations = match previous {
            'Some(p) => array.push(p.relations, entry),
            'None => [entry],
        };
        let result: RelationDef = { relations };
        result
    }
};

def enum_value: Fn(String, String) -> Fn(property.VariantPropertyCtx, Option(EnumValueDef)) -> EnumValueDef = fn(value, label) {
    fn(ctx, previous) {
        let result: EnumValueDef = { value, label };
        result
    }
};

def scope: Fn(Array(ScopePredicate)) -> Fn(property.FieldPropertyCtx, Option(ScopeDef)) -> ScopeDef = fn(predicates) {
    fn(ctx, previous) {
        let all = match previous {
            'Some(p) => array.concat([p.predicates, predicates]),
            'None => predicates,
        };
        let result: ScopeDef = { predicates: all };
        result
    }
};

# ---------------------------------------------------------------------------
# Prepare-time helpers.
# ---------------------------------------------------------------------------

def get_index: for(A) Fn(Array(A), Int) -> A = fn(values, i) {
    match array.get(values, i) {
        'Some(v) => v,
        'None => fail!("index out of range", i),
    }
};

def int_range: Fn(Int) -> Array(Int) = fn(n) {
    if n <= 0 { [] } else { array.push(int_range(n - 1), n - 1) }
};

def build_field: Fn(Type, Int, String, Type) -> FieldEntry = fn(owner, index, name, field_ty) {
    let col = property.get_field_prop(owner, index, ColumnMap);
    let column = match col {
        'Some(c) => c.column,
        'None => "",
    };
    let key = property.get_field_prop(owner, index, KeyFlag);
    let is_key = match key {
        'Some(k) => k.value,
        'None => 'False,
    };
    let result: FieldEntry = { index, name, column, is_key, ty: field_ty };
    result
};

# Prepare one union (multi-source) entity. Logical fields are the type's
# canonical fields; each field must declare a non-empty, distinct logical column
# (the stable output name). Every branch maps the full canonical field set to
# its own physical columns with a consistent (ascending field-index) order;
# physical columns, tables and aliases must be legal identifiers. Branch aliases
# are unique and distinct from the union alias; optional fixed branch filters
# must be Eq over a valid logical field.
def branch_mapping_ok: Fn(Array(FieldEntry), UnionBranchDecl) -> Array(String) = fn(fields, branch) {
    if array.length(branch.columns) != array.length(fields) {
        fail!("union branch must map every logical field exactly once")
    } else {
        let bad_order = array.find(branch.columns, fn(c) {
            c.field < 0 || c.field >= array.length(fields)
        });
        let mapped = array.enumerate(branch.columns);
        let bad_duplicate = array.find(mapped, fn(pair) {
            array.length(array.filter(branch.columns, fn(o) { o.field == pair.1.field })) > 1
        });
        if bad_order != 'None {
            fail!("union branch column mapping is out of range")
        } else if bad_duplicate != 'None {
            fail!("union branch maps the same logical field more than once")
        } else {
            # deterministic, consistent order: canonical field i must appear at
            # position i (an ascending, exactly-once mapping)
            let order_bad = array.any(mapped, fn(pair) { pair.1.field != pair.0 });
            let bad_col = array.find(branch.columns, fn(c) { !qb.is_sql_identifier(c.column) });
            if order_bad {
                fail!("union branch column mapping must use a consistent ascending field order")
            } else if bad_col != 'None {
                fail!("union branch physical column is not a legal identifier")
            } else {
                array.map(branch.columns, fn(c) { c.column })
            }
        }
    }
};

def build_union_entry: Fn(Type, Array(FieldEntry), UnionSourceDef) -> UnionEntry = fn(ty, fields, spec) {
    if array.length(spec.branches) == 0 {
        fail!("union entity must declare at least one branch", ty)
    } else if array.length(fields) == 0 {
        fail!("union entity must declare at least one logical field", ty)
    } else {
        let empty_col = array.find(fields, fn(f) { f.column == "" });
        let dup_col = array.find(fields, fn(f) {
            array.length(array.filter(fields, fn(o) { o.column == f.column })) > 1
        });
        let union_bad_id = !qb.is_sql_identifier(spec.alias);
        let alias_dup = array.find(spec.branches, fn(b) {
            array.length(array.filter(spec.branches, fn(o) { o.alias == b.alias })) > 1
        });
        let alias_clash = array.find(spec.branches, fn(b) { b.alias == spec.alias });
        let bad_table = array.find(spec.branches, fn(b) { !qb.is_sql_identifier(b.table) });
        let bad_branch_alias = array.find(spec.branches, fn(b) { !qb.is_sql_identifier(b.alias) });
        let bad_filter = array.find(spec.branches, fn(b) {
            match b.filter {
                'None => 'False,
                'Some(p) => p.op != 'Eq || p.field < 0 || p.field >= array.length(fields),
            }
        });
        if empty_col != 'None {
            fail!("union entity fields must declare physical columns", ty)
        } else if dup_col != 'None {
            fail!("union entity fields must map to distinct output columns", ty)
        } else if union_bad_id {
            fail!("union alias is not a legal identifier", ty)
        } else if alias_dup != 'None {
            fail!("union branches must use distinct aliases", ty)
        } else if alias_clash != 'None {
            fail!("union branch alias must not equal the union alias", ty)
        } else if bad_table != 'None {
            fail!("union branch table is not a legal identifier", ty)
        } else if bad_branch_alias != 'None {
            fail!("union branch alias is not a legal identifier", ty)
        } else if bad_filter != 'None {
            fail!("union branch filter must be Eq over a valid logical field", ty)
        } else {
            let prepared_branches = array.map(spec.branches, fn(b) {
                let columns = branch_mapping_ok(fields, b);
                let result: UnionBranchEntry = { table: b.table, alias: b.alias, columns, filter: b.filter };
                result
            });
            let result: UnionEntry = { alias: spec.alias, branches: prepared_branches };
            result
        }
    }
};

def build_entity: Fn(Type, Int) -> EntityEntry = fn(ty, index) {
    let src = property.get_type_prop(ty, EntitySource);
    let union_prop = property.get_type_prop(ty, UnionSourceDef);
    let declared_id = property.get_type_prop(ty, EntityId);
    let field_descs = td.fields(ty);
    let enumerated = array.enumerate(field_descs);
    let fields = array.map(enumerated, fn(pair) {
        build_field(ty, pair.1.index, pair.1.name, pair.1.ty)
    });
    let key_field = match array.find(fields, fn(f) { f.is_key }) {
        'Some(f) => f.index,
        'None => -1,
    };
    match (src, union_prop) {
        ('Some(source), 'None) => do {
            let id = match declared_id {
                'Some(e) => e.id,
                'None => source.alias,
            };
            let result: EntityEntry = { index, id, entity_type: ty, table: source.table, alias: source.alias, key_field, fields, union: 'None };
            result
        },
        ('None, 'Some(union_def)) => do {
            let union = build_union_entry(ty, fields, union_def);
            let id = match declared_id {
                'Some(e) => e.id,
                'None => union.alias,
            };
            let result: EntityEntry = { index, id, entity_type: ty, table: "", alias: union.alias, key_field, fields, union: 'Some(union) };
            result
        },
        _ => fail!("entity must declare exactly one of entity_source or union_source", ty),
    }
};

def resolve_required: Fn(Array(EntityEntry), Array(Type)) -> Array(Int) = fn(entities, types) {
    array.map(types, fn(ty) {
        match array.find(entities, fn(e) { e.entity_type == ty }) {
            'Some(e) => e.index,
            'None => fail!("measure requires an entity that is not part of this knowledge", ty),
        }
    })
};

def collect_entity_measures: Fn(Array(EntityEntry), EntityEntry) -> Array(MeasureEntry) = fn(entities, entity) {
    let fields = entity.fields;
    array.flat_map(fields, fn(f) {
        let plain = match property.get_field_prop(entity.entity_type, f.index, MeasureDef) {
            'Some(d) => do {
                let result: MeasureEntry = {
                    id: d.id,
                    entity: entity.index,
                    field: f.index,
                    aggregate: d.aggregate,
                    alias: d.id,
                    requires: resolve_required(entities, d.requires),
                    predicate: 'None,
                    computed: 'None,
                };
                [result]
            },
            'None => [],
        };
        let filtered = match property.get_field_prop(entity.entity_type, f.index, FilteredMeasureDef) {
            'Some(d) => array.map(d.measures, fn(spec) {
                let result: MeasureEntry = {
                    id: spec.id,
                    entity: entity.index,
                    field: f.index,
                    aggregate: spec.aggregate,
                    alias: spec.id,
                    requires: resolve_required(entities, spec.requires),
                    predicate: 'Some(spec.predicate),
                    computed: 'None,
                };
                result
            }),
            'None => [],
        };
        let computed = match property.get_field_prop(entity.entity_type, f.index, ComputedMeasureDef) {
            'Some(d) => array.map(d.measures, fn(spec) {
                let result: MeasureEntry = {
                    id: spec.id,
                    entity: entity.index,
                    field: f.index,
                    aggregate: 'Count,
                    alias: spec.id,
                    requires: [],
                    predicate: 'None,
                    computed: 'Some({ op: spec.op, left: spec.left, right: spec.right }),
                };
                result
            }),
            'None => [],
        };
        array.concat([plain, filtered, computed])
    })
};

def measure_by_id: Fn(Array(MeasureEntry), String) -> MeasureEntry = fn(measures, id) {
    match array.find(measures, fn(m) { m.id == id }) {
        'Some(m) => m,
        'None => fail!("computed measure depends on an unknown measure", id),
    }
};

# Follow the computed-measure dependency graph; a revisit means a cycle.
def has_dep_cycle: Fn(Array(MeasureEntry), String, Array(String)) -> Bool = fn(measures, id, visited) {
    if array.any(visited, fn(v) { v == id }) {
        'True
    } else {
        let direct = match array.find(measures, fn(m) { m.id == id }) {
            'Some(m) => match m.computed {
                'Some(spec) => [spec.left, spec.right],
                'None => [],
            },
            'None => [],
        };
        let new_visited = array.push(visited, id);
        array.any(direct, fn(dep) { has_dep_cycle(measures, dep, new_visited) })
    }
};

# Prepare-time measure contract: unique measure ids; computed measure operands
# must exist and share the declaring entity's grain; the dependency graph must be
# acyclic. Failures surface as prepare-time diagnostics.
def check_measure_contract: Fn(Array(MeasureEntry)) -> Array(MeasureEntry) = fn(measures) {
    let dup = array.find(measures, fn(m) {
        array.length(array.filter(measures, fn(o) { o.id == m.id })) > 1
    });
    let ids_ok = match dup {
        'Some(m) => fail!("duplicate measure id", m.id),
        'None => 'True,
    };
    let validated = array.map(measures, fn(entry) {
        match entry.computed {
            'None => entry,
            'Some(spec) => do {
                let left = measure_by_id(measures, spec.left);
                let right = measure_by_id(measures, spec.right);
                let entity_ok: Bool = if left.entity == entry.entity && right.entity == entry.entity {
                    'True
                } else {
                    fail!("computed measure dependencies must share the declaring entity's grain", entry.id)
                };
                let cycle_ok: Bool = if has_dep_cycle(measures, entry.id, []) {
                    fail!("computed measure dependency cycle", entry.id)
                } else {
                    'True
                };
                let result: MeasureEntry = if entity_ok && cycle_ok { entry } else { entry };
                result
            },
        }
    });
    let result: Array(MeasureEntry) = if ids_ok { validated } else { validated };
    result
};

def identity_expr: Fn(qb.Expr) -> qb.Expr = fn(e) { e };

def enum_value_entry: Fn(String, String, String) -> EnumValueEntry = fn(variant, value, label) {
    let result: EnumValueEntry = { variant, value, label };
    result
};

def has_payload: Fn(Option(Type)) -> Bool = fn(payload) {
    match payload { 'Some(_) => 'True, 'None => 'False }
};

def duplicate_value: Fn(Array(EnumValueEntry)) -> Option(String) = fn(entries) {
    let values = array.map(entries, fn(e) { e.value });
    array.find(values, fn(v) {
        array.length(array.filter(values, fn(w) { w == v })) > 1
    })
};

# Build the closed value domain for a plain dimension field whose type is a
# payload-free named enum. Non-enum field types yield the empty (open) domain;
# payload-bearing enum shapes produce an explicit prepare-time diagnostic.
def value_domain: Fn(Type) -> Array(EnumValueEntry) = fn(field_ty) {
    let ref_ty = field_ty;
    let resolved = match td.resolve(ref_ty) {
        'Ok(t) => t,
        'Err(_) => ref_ty,
    };
    match td.kind(resolved) {
        'Enum => do {
            let vs = td.variants(ref_ty);
            if array.any(vs, fn(v) { has_payload(v.payload) }) {
                fail!("dimension field uses an enum with payload variants; only payload-free variants are supported", field_ty)
            } else {
                let entries = array.map(vs, fn(v) {
                    let prop = property.get_variant_prop(ref_ty, v.index, EnumValueDef);
                    match prop {
                        'Some(spec) => enum_value_entry(v.name, spec.value, spec.label),
                        'None => enum_value_entry(v.name, v.name, v.name),
                    }
                });
                match duplicate_value(entries) {
                    'Some(value) => fail!("enum value domain contains duplicate stable values", field_ty, value),
                    'None => entries,
                }
            }
        },
        _ => [],
    }
};

def field_scope: Fn(Type, Int) -> Array(ScopePredicate) = fn(owner, index) {
    match property.get_field_prop(owner, index, ScopeDef) {
        'Some(s) => s.predicates,
        'None => [],
    }
};

def collect_entity_dimensions: Fn(EntityEntry) -> Array(DimensionEntry) = fn(entity) {
    let fields = entity.fields;
    let plain = array.flat_map(fields, fn(f) {
        let d = property.get_field_prop(entity.entity_type, f.index, DimensionDef);
        match d {
            'Some(dd) => [dimension_entry(entity.index, f.index, dd.id, 'False, identity_expr, dd.authorized, dd.filterable, dd.ops, dd.input_kinds, value_domain(f.ty), field_scope(entity.entity_type, f.index))],
            'None => [],
        }
    });
    let computed = array.flat_map(fields, fn(f) {
        let d = property.get_field_prop(entity.entity_type, f.index, ComputedDimensionDef);
        match d {
            'Some(dd) => [dimension_entry(entity.index, f.index, dd.id, 'True, dd.build, dd.authorized, dd.filterable, dd.ops, dd.input_kinds, [], field_scope(entity.entity_type, f.index))],
            'None => [],
        }
    });
    let json = array.flat_map(fields, fn(f) {
        let d = property.get_field_prop(entity.entity_type, f.index, JsonDimensionDef);
        match d {
            'Some(dd) => array.map(dd.dimensions, fn(spec) {
                dimension_entry(entity.index, f.index, spec.id, 'True, json_builder(spec.path), spec.authorized, spec.filterable, spec.ops, spec.input_kinds, [], field_scope(entity.entity_type, f.index))
            }),
            'None => [],
        }
    });
    array.concat([plain, computed, json])
};

def dimension_entry: Fn(Int, Int, String, Bool, Fn(qb.Expr) -> qb.Expr, Bool, Bool, Array(FilterOp), Array(FilterInputKind), Array(EnumValueEntry), Array(ScopePredicate)) -> DimensionEntry = fn(entity, field, id, computed, build, authorized, filterable, ops, input_kinds, values, scope) {
    let result: DimensionEntry = { id, entity, field, computed, build, authorized, filterable, ops, input_kinds, values, scope };
    result
};

def collect_relations: Fn(Array(EntityEntry)) -> Array(RelationEntry) = fn(entities) {
    array.flat_map(entities, fn(entity) {
        let rd = property.get_type_prop(entity.entity_type, RelationDef);
        let decls = match rd {
            'Some(d) => d.relations,
            'None => [],
        };
        array.map(decls, fn(rel) {
            let to_index = match array.find(entities, fn(e) { e.entity_type == rel.target }) {
                'Some(e) => e.index,
                'None => fail!("relation target is not part of this knowledge", rel.target),
            };
            let result: RelationEntry = {
                from: entity.index,
                to: to_index,
                kind: rel.kind,
                key: rel.key,
            };
            result
        })
    })
};

# ---------------------------------------------------------------------------
# BFS path precomputation (prepare-time only).
# ---------------------------------------------------------------------------

type BfsState = struct { node: Int, path: Array(Int) };

type SearchResult = enum {
    'Found(Array(Int)),
    'Truncated,
    'Missing,
};

type ExpandContinue = struct { visited: Array(Bool), states: Array(BfsState) };

type ExpandResult = enum {
    'Found(Array(Int)),
    'Continue(ExpandContinue),
};

def visited_at: Fn(Array(Bool), Int) -> Bool = fn(visited, i) {
    match array.get(visited, i) {
        'Some(v) => v,
        'None => 'False,
    }
};

def set_at: Fn(Array(Bool), Int, Bool) -> Array(Bool) = fn(values, index, value) {
    let enumerated = array.enumerate(values);
    array.map(enumerated, fn(pair) { if pair.0 == index { value } else { pair.1 } })
};

def outgoing_indexes: Fn(Int, Array(RelationEntry), Bool) -> Array(Int) = fn(node, relations, safe_only) {
    let enumerated = array.enumerate(relations);
    array.flat_map(enumerated, fn(pair) {
        let r = pair.1;
        if r.from == node && (safe_only == 'False || r.kind == 'Safe) {
            [pair.0]
        } else {
            []
        }
    })
};

def has_unvisited_successor: Fn(Array(Bool), Array(BfsState), Array(RelationEntry), Bool) -> Bool = fn(visited, frontier, relations, safe_only) {
    array.any(frontier, fn(state) {
        let outs = outgoing_indexes(state.node, relations, safe_only);
        array.any(outs, fn(r_idx) {
            let r = get_index(relations, r_idx);
            !visited_at(visited, r.to)
        })
    })
};

def expand_state: Fn(Int, Array(Bool), BfsState, Array(RelationEntry), Bool) -> ExpandResult = fn(to, visited, state, relations, safe_only) {
    let outs = outgoing_indexes(state.node, relations, safe_only);
    let init_cont: ExpandContinue = { visited: visited, states: [] };
    let init: ExpandResult = 'Continue(init_cont);
    array.fold(outs, init, fn(acc, r_idx) {
        match acc {
            'Found(_) => acc,
            'Continue(cont) => do {
                let r = get_index(relations, r_idx);
                if !visited_at(cont.visited, r.to) {
                    let new_visited = set_at(cont.visited, r.to, 'True);
                    let new_path = array.push(state.path, r_idx);
                    if r.to == to {
                        let found: ExpandResult = 'Found(new_path);
                        found
                    } else {
                        let next_state: BfsState = { node: r.to, path: new_path };
                        let new_cont: ExpandContinue = { visited: new_visited, states: array.push(cont.states, next_state) };
                        let result: ExpandResult = 'Continue(new_cont);
                        result
                    }
                } else {
                    acc
                }
            },
        }
    })
};

def expand_frontier: Fn(Int, Array(Bool), Array(BfsState), Array(RelationEntry), Bool) -> ExpandResult = fn(to, visited, frontier, relations, safe_only) {
    let init_cont: ExpandContinue = { visited: visited, states: [] };
    let init: ExpandResult = 'Continue(init_cont);
    array.fold(frontier, init, fn(acc, state) {
        match acc {
            'Found(_) => acc,
            'Continue(cont) => do {
                let expanded = expand_state(to, cont.visited, state, relations, safe_only);
                match expanded {
                    'Found(path) => 'Found(path),
                    'Continue(new_cont) => do {
                        let merged: ExpandContinue = {
                            visited: new_cont.visited,
                            states: array.concat([cont.states, new_cont.states]),
                        };
                        let result: ExpandResult = 'Continue(merged);
                        result
                    },
                }
            },
        }
    })
};

def search_loop: Fn(Int, Array(Bool), Array(BfsState), Array(RelationEntry), Bool, Int) -> SearchResult = fn(to, visited, frontier, relations, safe_only, depth) {
    if depth >= 8 {
        if has_unvisited_successor(visited, frontier, relations, safe_only) { 'Truncated } else { 'Missing }
    } else {
        let expanded = expand_frontier(to, visited, frontier, relations, safe_only);
        match expanded {
            'Found(path) => 'Found(path),
            'Continue(cont) => do {
                if array.length(cont.states) == 0 {
                    'Missing
                } else {
                    search_loop(to, cont.visited, cont.states, relations, safe_only, depth + 1)
                }
            },
        }
    }
};

def search: Fn(Int, Int, Int, Array(RelationEntry), Bool) -> SearchResult = fn(from, to, n, relations, safe_only) {
    let visited: Array(Bool) = array.map(int_range(n), fn(i) { i == from });
    let start: BfsState = { node: from, path: [] };
    search_loop(to, visited, [start], relations, safe_only, 0)
};

def classify_path: Fn(Int, Int, Int, Array(RelationEntry)) -> PathResult = fn(from, to, n, relations) {
    if from == to {
        'Safe([])
    } else {
        match search(from, to, n, relations, 'True) {
            'Found(path) => 'Safe(path),
            _ => match search(from, to, n, relations, 'False) {
                'Found(path) => 'FanOut(path),
                'Truncated => 'Truncated,
                'Missing => 'Missing,
            },
        }
    }
};

def build_paths: Fn(Int, Array(RelationEntry)) -> Array(Array(PathResult)) = fn(n, relations) {
    array.map(int_range(n), fn(from) {
        array.map(int_range(n), fn(to) {
            classify_path(from, to, n, relations)
        })
    })
};

# ---------------------------------------------------------------------------
# Root preparation.
# ---------------------------------------------------------------------------

def build_root: Fn(String, Array(Type), qb.PlanProfile, Fn(String) -> Bool) -> PreparedPayload = fn(revision, entity_types, profile, authorize) {
    let n = array.length(entity_types);
    let entities = array.map(int_range(n), fn(i) {
        build_entity(get_index(entity_types, i), i)
    });
    let measures_raw = array.flat_map(entities, fn(e) { collect_entity_measures(entities, e) });
    let measures = check_measure_contract(measures_raw);
    let dimensions = array.flat_map(entities, fn(e) { collect_entity_dimensions(e) });
    let relations = collect_relations(entities);
    let paths = build_paths(n, relations);
    let payload: PreparedPayload = {
        revision,
        entities,
        measures,
        dimensions,
        relations,
        paths,
        profile,
        authorize,
    };
    payload
};

# ---------------------------------------------------------------------------
# Hot-path lowering.
# ---------------------------------------------------------------------------

type ResolvedMeasure = struct {
    entry: MeasureEntry,
    distinct: Bool,
};

type ResolvedDimension = struct {
    entry: DimensionEntry,
};

type FilterResolution = struct {
    expr: qb.Expr,
    entity: Int,
    field: Int,
    op: FilterOp,
    input: FilterInput,
};

def to_bind: Fn(FilterInput) -> qb.Expr = fn(input) {
    match input {
        'Text(s) => qb.bind_string(s),
        'Number(f) => qb.bind_float(f),
        'Int(i) => qb.bind_int(i),
    }
};

def resolve_measure_entry: Fn(PreparedPayload, MeasureRequest) -> ResolvedMeasure = fn(payload, req) {
    if !payload.authorize(req.subject) {
        fail!("subject is not authorized for measure", req.subject, req.id)
    } else {
        match array.find(payload.measures, fn(m) { m.id == req.id }) {
            'Some(entry) => do {
                let distinct = match req.input { 'Distinct => 'True, 'All => 'False };
                let result: ResolvedMeasure = { entry, distinct };
                result
            },
            'None => fail!("unknown measure", req.subject, req.id),
        }
    }
};

def resolve_measure_by_id: Fn(PreparedPayload, String, String) -> ResolvedMeasure = fn(payload, id, subject) {
    if !payload.authorize(subject) {
        fail!("subject is not authorized for measure", subject, id)
    } else {
        match array.find(payload.measures, fn(m) { m.id == id }) {
            'Some(entry) => do {
                let result: ResolvedMeasure = { entry, distinct: 'False };
                result
            },
            'None => fail!("unknown measure dependency", subject, id),
        }
    }
};

# Transitive computed-measure dependencies, dependencies before dependents.
def transitive_deps: Fn(Array(MeasureEntry), String) -> Array(String) = fn(measures, id) {
    match array.find(measures, fn(m) { m.id == id }) {
        'Some(m) => match m.computed {
            'Some(spec) => array.concat([
                transitive_deps(measures, spec.left),
                [spec.left],
                transitive_deps(measures, spec.right),
                [spec.right],
            ]),
            'None => [],
        },
        'None => [],
    }
};

type MeasureExpandState = struct {
    included: Array(String),
    resolved: Array(ResolvedMeasure),
};

def expand_measure: Fn(PreparedPayload, MeasureExpandState, MeasureRequest) -> MeasureExpandState = fn(payload, state, req) {
    let entry = resolve_measure_entry(payload, req);
    let deps = transitive_deps(payload.measures, entry.entry.id);
    let missing = array.fold(deps, [], fn(acc, id) {
        if array.any(acc, fn(a) { a == id }) || array.any(state.included, fn(a) { a == id }) {
            acc
        } else {
            array.push(acc, id)
        }
    });
    let new_resolved = array.fold(missing, state.resolved, fn(acc, id) {
        array.push(acc, resolve_measure_by_id(payload, id, req.subject))
    });
    let included2 = array.fold(missing, state.included, fn(acc, id) {
        if array.any(acc, fn(a) { a == id }) { acc } else { array.push(acc, id) }
    });
    let included3 = if array.any(included2, fn(a) { a == entry.entry.id }) { included2 } else { array.push(included2, entry.entry.id) };
    let resolved2 = array.push(new_resolved, entry);
    let result: MeasureExpandState = { included: included3, resolved: resolved2 };
    result
};

def resolve_measures: Fn(PreparedPayload, Array(MeasureRequest)) -> Array(ResolvedMeasure) = fn(payload, requests) {
    let init: MeasureExpandState = { included: [], resolved: [] };
    let final_state = array.fold(requests, init, fn(state, req) { expand_measure(payload, state, req) });
    final_state.resolved
};

def resolve_dimensions: Fn(PreparedPayload, Array(DimensionRequest)) -> Array(ResolvedDimension) = fn(payload, requests) {
    array.map(requests, fn(req) {
        if !payload.authorize(req.subject) {
            fail!("subject is not authorized for dimension", req.subject, req.id)
        } else {
            match array.find(payload.dimensions, fn(d) { d.id == req.id }) {
                'Some(entry) => do {
                    if !entry.authorized {
                        fail!("dimension is not authorized", req.subject, req.id)
                    } else {
                        let result: ResolvedDimension = { entry };
                        result
                    }
                },
                'None => fail!("unknown dimension", req.subject, req.id),
            }
        }
    })
};

def dimension_expr: Fn(PreparedPayload, DimensionEntry) -> qb.Expr = fn(payload, entry) {
    let entity = get_index(payload.entities, entry.entity);
    let field = get_index(entity.fields, entry.field);
    let base = qb.column(entity.alias, field.column);
    entry.build(base)
};

# Public discovery: the closed value domain (stable values and labels) of a
# dimension, or the empty array for an open (String/Int/Float) dimension.
# Unknown dimension ids fail atomically (closed vocabulary).
def dimension_domain: Fn(PreparedPayload, String) -> Array(EnumValueEntry) = fn(payload, id) {
    match array.find(payload.dimensions, fn(d) { d.id == id }) {
        'Some(entry) => entry.values,
        'None => fail!("unknown dimension", id),
    }
};

def filter_input_allowed: Fn(Array(FilterInputKind), FilterInput) -> Bool = fn(kinds, input) {
    let kind: FilterInputKind = match input {
        'Text(_) => 'Text,
        'Number(_) => 'Number,
        'Int(_) => 'Int,
    };
    array.any(kinds, fn(k) { k == kind })
};

# True for the text-search operations (starts-with/contains/ends-with families).
def is_text_op: Fn(FilterOp) -> Bool = fn(op) {
    match op {
        'Contains => 'True,
        'NotContains => 'True,
        'StartsWith => 'True,
        'EndsWith => 'True,
        'Eq => 'False,
        'Ne => 'False,
        'Gt => 'False,
        'Ge => 'False,
        'Lt => 'False,
        'Le => 'False,
    }
};

# Build the closed query expression for an open (non-enum) dimension filter.
# The caller has already validated operation support and the input kind/value.
# Comparison ops map to the closed query scalars; text ops lower through the
# closed 'Instr/'Lower/'Length/'Substr/'Add/'Sub vocabulary. All runtime values
# remain parameterized binds.
def open_condition_expr: Fn(qb.Expr, FilterOp, qb.Expr) -> qb.Expr = fn(base, op, bound) {
    match op {
        'Eq => qb.scalar('Eq, [base, bound]),
        'Ne => qb.scalar('Ne, [base, bound]),
        'Gt => qb.scalar('Gt, [base, bound]),
        'Ge => qb.scalar('Ge, [base, bound]),
        'Lt => qb.scalar('Lt, [base, bound]),
        'Le => qb.scalar('Le, [base, bound]),
        # case-insensitive containment
        'Contains => qb.scalar('Gt, [qb.instr(qb.lower(base), qb.lower(bound)), qb.bind_int(0)]),
        # case-sensitive negation (query public contract)
        'NotContains => qb.scalar('Eq, [qb.instr(base, bound), qb.bind_int(0)]),
        # case-insensitive prefix
        'StartsWith => qb.scalar('Eq, [qb.instr(qb.lower(base), qb.lower(bound)), qb.bind_int(1)]),
        # case-insensitive suffix
        'EndsWith => do {
            let lower_base = qb.lower(base);
            let lower_bound = qb.lower(bound);
            let start = qb.add(qb.sub(qb.length(lower_base), qb.length(lower_bound)), qb.bind_int(1));
            qb.scalar('Eq, [qb.substr([lower_base, start]), lower_bound])
        },
    }
};

# Convert a runtime filter value into the query ScalarValue used at codec
# boundaries and by HAVING thresholds.
def to_val: Fn(FilterInput) -> qb.Val = fn(input) {
    match input {
        'Text(s) => 'String(s),
        'Number(f) => 'Float(f),
        'Int(i) => 'Int(i),
    }
};

# Enum closed-domain filter resolution. A legal stable value keeps producing a
# parameterized binding; unknown values fail atomically with the subject, the
# dimension id and the dynamic JSON input value as evidence.
def resolve_enum_filter: Fn(PreparedPayload, DimensionEntry, FilterRequest) -> FilterResolution = fn(payload, entry, req) {
    let base = dimension_expr(payload, entry);
    match req.op {
        'Eq => match req.input {
            'Text(s) => if array.any(entry.values, fn(v) { v.value == s }) {
                let expr = qb.scalar('Eq, [base, qb.bind_string(s)]);
                let result: FilterResolution = { expr, entity: entry.entity, field: entry.field, op: req.op, input: req.input };
                result
            } else {
                fail!("unknown enum value for dimension", req.subject, req.id, s)
            },
            _ => fail!("invalid enum filter value for dimension", req.subject, req.id, req.input),
        },
        'Ne => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
        'Gt => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
        'Ge => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
        'Lt => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
        'Le => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
        'Contains => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
        'NotContains => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
        'StartsWith => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
        'EndsWith => fail!("enum dimension filter supports only Eq", req.subject, req.id, req.op),
    }
};

def resolve_filters: Fn(PreparedPayload, Array(FilterRequest)) -> Array(FilterResolution) = fn(payload, requests) {
    array.map(requests, fn(req) {
        if !payload.authorize(req.subject) {
            fail!("subject is not authorized for filter", req.subject, req.id)
        } else {
            match array.find(payload.dimensions, fn(d) { d.id == req.id }) {
                'None => fail!("unknown filter dimension", req.subject, req.id),
                'Some(entry) => do {
                    if !entry.authorized {
                        fail!("dimension is not authorized", req.subject, req.id)
                    } else if !entry.filterable {
                        fail!("dimension has no filter capability", req.subject, req.id)
                    } else if !array.any(entry.ops, fn(op) { op == req.op }) {
                        fail!("filter operation not supported for dimension", req.subject, req.id)
                    } else if array.length(entry.values) > 0 {
                        resolve_enum_filter(payload, entry, req)
                    } else if is_text_op(req.op) {
                        match req.input {
                            'Text(_) => if !filter_input_allowed(entry.input_kinds, req.input) {
                                fail!("invalid filter value for dimension", req.subject, req.id)
                            } else {
                                let base = dimension_expr(payload, entry);
                                let bound = to_bind(req.input);
                                let expr = open_condition_expr(base, req.op, bound);
                                let result: FilterResolution = { expr, entity: entry.entity, field: entry.field, op: req.op, input: req.input };
                                result
                            },
                            _ => fail!("text filter operation requires a text input value", req.subject, req.id),
                        }
                    } else if !filter_input_allowed(entry.input_kinds, req.input) {
                        fail!("invalid filter value for dimension", req.subject, req.id)
                    } else {
                        let base = dimension_expr(payload, entry);
                        let bound = to_bind(req.input);
                        let expr = open_condition_expr(base, req.op, bound);
                        let result: FilterResolution = { expr, entity: entry.entity, field: entry.field, op: req.op, input: req.input };
                        result
                    }
                },
            }
        }
    })
};

def combine_filters: Fn(Array(qb.Expr)) -> Option(qb.Expr) = fn(exprs) {
    let init_none: Option(qb.Expr) = 'None;
    match array.fold(exprs, init_none, fn(acc, expr) {
        match acc {
            'None => 'Some(expr),
            'Some(prev) => 'Some(qb.scalar('And, [prev, expr])),
        }
    }) {
        'Some(expr) => 'Some(expr),
        'None => 'None,
    }
};

# ---------------------------------------------------------------------------
# Closed OR-group (AnyOf) over one dimension.
# ---------------------------------------------------------------------------

# Left-associative Or over Eq(base, bind(value)) in request order.
def or_eq_terms: Fn(qb.Expr, Array(FilterInput)) -> qb.Expr = fn(base, values) {
    let init: Option(qb.Expr) = 'None;
    let folded = array.fold(values, init, fn(acc, value) {
        let term = qb.scalar('Eq, [base, to_bind(value)]);
        match acc {
            'None => 'Some(term),
            'Some(prev) => 'Some(qb.scalar('Or, [prev, term])),
        }
    });
    match folded {
        'Some(expr) => expr,
        'None => fail!("any-of group must contain at least one value"),
    }
};

# Value-level check for one AnyOf member against a resolved dimension entry:
# closed enum domains require a Text stable value; open dimensions require an
# allowed input kind.
def any_of_value_ok: Fn(DimensionEntry, FilterInput) -> Bool = fn(entry, value) {
    if array.length(entry.values) > 0 {
        match value {
            'Text(s) => array.any(entry.values, fn(e) { e.value == s }),
            _ => 'False,
        }
    } else {
        filter_input_allowed(entry.input_kinds, value)
    }
};

# Build the OR-group expression for an already-resolved, authorized dimension.
# The dimension must support Eq and the group must be non-empty; every member is
# validated before the group is built (atomic failure, no dropped branches).
def build_any_of: Fn(PreparedPayload, DimensionEntry, AnyOfRequest) -> qb.Expr = fn(payload, entry, spec) {
    if array.length(spec.values) == 0 {
        fail!("any-of group must contain at least one value", spec.id)
    } else if !array.any(entry.ops, fn(op) { op == 'Eq }) {
        fail!("any-of requires the Eq filter operation for dimension", spec.id)
    } else {
        let values_ok = array.all(spec.values, fn(v) { any_of_value_ok(entry, v) });
        if !values_ok {
            fail!("any-of contains an unknown or invalid value for dimension", spec.id)
        } else {
            let base = dimension_expr(payload, entry);
            or_eq_terms(base, spec.values)
        }
    }
};

# Ordinary (subject-query) OR-group: authorization and vocabulary checks, then
# the closed OR-group expression.
def any_of_expr: Fn(PreparedPayload, AnyOfRequest) -> qb.Expr = fn(payload, spec) {
    if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for any-of filter", spec.subject, spec.id)
    } else {
        match array.find(payload.dimensions, fn(d) { d.id == spec.id }) {
            'None => fail!("unknown any-of dimension", spec.subject, spec.id),
            'Some(entry) => do {
                if !entry.authorized {
                    fail!("dimension is not authorized", spec.subject, spec.id)
                } else if !entry.filterable {
                    fail!("dimension has no filter capability", spec.subject, spec.id)
                } else {
                    build_any_of(payload, entry, spec)
                }
            },
        }
    }
};

# Existence inner OR-group: the dimension must belong to the related (target)
# entity so the OR-group only constrains the EXISTS inner rows.
def any_of_on_target: Fn(PreparedPayload, Int, AnyOfRequest) -> qb.Expr = fn(payload, target, spec) {
    if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for any-of filter", spec.subject, spec.id)
    } else {
        match array.find(payload.dimensions, fn(d) { d.id == spec.id }) {
            'None => fail!("unknown any-of dimension", spec.subject, spec.id),
            'Some(entry) => if entry.entity == target {
                if !entry.authorized {
                    fail!("dimension is not authorized", spec.subject, spec.id)
                } else if !entry.filterable {
                    fail!("dimension has no filter capability", spec.subject, spec.id)
                } else {
                    build_any_of(payload, entry, spec)
                }
            } else {
                fail!("any-of inner filter must reference the target entity", spec.id)
            },
        }
    }
};

# Append extra expressions as trailing AND terms (used for OR-group terms after
# the scopes+user filter conjunction).
def append_filter_terms: Fn(Option(qb.Expr), Array(qb.Expr)) -> Option(qb.Expr) = fn(base, extra) {
    array.fold(extra, base, fn(acc, expr) {
        match acc {
            'None => 'Some(expr),
            'Some(prev) => 'Some(qb.scalar('And, [prev, expr])),
        }
    })
};

# Enum closed-domain scope resolution (mirrors resolve_enum_filter). A scope
# value must be a member of the referenced dimension's stable value domain.
def resolve_enum_scope: Fn(PreparedPayload, DimensionEntry, ScopePredicate) -> FilterResolution = fn(payload, entry, predicate) {
    let base = dimension_expr(payload, entry);
    match predicate.op {
        'Eq => match predicate.input {
            'Text(s) => if array.any(entry.values, fn(v) { v.value == s }) {
                let expr = qb.scalar('Eq, [base, qb.bind_string(s)]);
                let result: FilterResolution = { expr, entity: entry.entity, field: entry.field, op: predicate.op, input: predicate.input };
                result
            } else {
                fail!("scope references an unknown enum value for dimension", entry.id, s)
            },
            _ => fail!("scope uses an invalid enum value for dimension", entry.id, predicate.input),
        },
        'Ne => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
        'Gt => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
        'Ge => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
        'Lt => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
        'Le => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
        'Contains => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
        'NotContains => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
        'StartsWith => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
        'EndsWith => fail!("scope on enum dimension supports only Eq", entry.id, predicate.op),
    }
};

# Resolve one inherent scope predicate of a selected dimension member. The
# predicate must reference a declared, authorized, filterable dimension of the
# member's own entity; unsupported ops or input kinds fail atomically.
def resolve_scope: Fn(PreparedPayload, DimensionEntry, ScopePredicate) -> FilterResolution = fn(payload, owner, predicate) {
    let entity = get_index(payload.entities, owner.entity);
    let field = match array.get(entity.fields, predicate.field) {
        'Some(f) => f,
        'None => fail!("scope references an unknown field", owner.id, predicate.field),
    };
    match array.find(payload.dimensions, fn(d) { d.entity == owner.entity && d.field == field.index }) {
        'None => fail!("scope references a field with no dimension declaration", owner.id, field.name),
        'Some(d) => do {
            if !d.authorized {
                fail!("scope references a dimension that is not authorized", d.id)
            } else if !d.filterable {
                fail!("scope references a dimension with no filter capability", d.id)
            } else if !array.any(d.ops, fn(op) { op == predicate.op }) {
                fail!("scope uses an operation not supported by the dimension", d.id, predicate.op)
            } else if array.length(d.values) > 0 {
                resolve_enum_scope(payload, d, predicate)
            } else if is_text_op(predicate.op) {
                match predicate.input {
                    'Text(_) => if !filter_input_allowed(d.input_kinds, predicate.input) {
                        fail!("scope uses an invalid value for the dimension", d.id, predicate.input)
                    } else {
                        let base = dimension_expr(payload, d);
                        let bound = to_bind(predicate.input);
                        let expr = open_condition_expr(base, predicate.op, bound);
                        let result: FilterResolution = { expr, entity: d.entity, field: d.field, op: predicate.op, input: predicate.input };
                        result
                    },
                    _ => fail!("scope text operation requires a text input value", d.id),
                }
            } else if !filter_input_allowed(d.input_kinds, predicate.input) {
                fail!("scope uses an invalid value for the dimension", d.id, predicate.input)
            } else {
                let base = dimension_expr(payload, d);
                let bound = to_bind(predicate.input);
                let expr = open_condition_expr(base, predicate.op, bound);
                let result: FilterResolution = { expr, entity: d.entity, field: d.field, op: predicate.op, input: predicate.input };
                result
            }
        },
    }
};

# Two constraints on the same entity+field contradict each other only when both
# are equality constraints with different literal values.
def eq_conflict: Fn(FilterResolution, FilterResolution) -> Bool = fn(a, b) {
    a.entity == b.entity && a.field == b.field && a.op == 'Eq && b.op == 'Eq && a.input != b.input
};

def find_internal_conflict: Fn(Array(FilterResolution)) -> Option(FilterResolution) = fn(list) {
    let n = array.length(list);
    let init: Option(FilterResolution) = 'None;
    array.fold(int_range(n), init, fn(acc, i) {
        match acc {
            'Some(_) => acc,
            'None => do {
                let a = get_index(list, i);
                let inner_init: Option(FilterResolution) = 'None;
                array.fold(int_range(n), inner_init, fn(inner_acc, j) {
                    match inner_acc {
                        'Some(_) => inner_acc,
                        'None => if j > i {
                            let b = get_index(list, j);
                            if eq_conflict(a, b) { 'Some(b) } else { 'None }
                        } else {
                            'None
                        },
                    }
                })
            },
        }
    })
};

def find_cross_conflict: Fn(Array(FilterResolution), Array(FilterResolution)) -> Option(FilterResolution) = fn(scopes, users) {
    let init: Option(FilterResolution) = 'None;
    array.fold(scopes, init, fn(acc, s) {
        match acc {
            'Some(_) => acc,
            'None => do {
                let found: Option(FilterResolution) = array.fold(users, 'None, fn(inner_acc, u) {
                    match inner_acc {
                        'Some(_) => inner_acc,
                        'None => if eq_conflict(s, u) { 'Some(u) } else { 'None },
                    }
                });
                found
            },
        }
    })
};

def scope_conflict: Fn(Array(FilterResolution), Array(FilterResolution)) -> Option(FilterResolution) = fn(scopes, users) {
    match find_internal_conflict(scopes) {
        'Some(c) => 'Some(c),
        'None => find_cross_conflict(scopes, users),
    }
};

# Merge member scopes (in request order, then declaration order) with user
# filters (in request order) into one deterministic left-assoc And expression.
# Mutually contradictory scope/filter constraints fail atomically.
def combined_filter: Fn(Array(FilterResolution), Array(FilterResolution)) -> Option(qb.Expr) = fn(scopes, users) {
    let conflict = scope_conflict(scopes, users);
    let exprs = array.concat([array.map(scopes, fn(s) { s.expr }), array.map(users, fn(u) { u.expr })]);
    let filtered = match conflict {
        'Some(c) => fail!("conflicting scope/filter constraints", c.entity, c.field, c.input),
        'None => exprs,
    };
    combine_filters(filtered)
};

# Resolve a filtered measure's inherent predicate to a parameterized expression.
# The predicate must reference a declared, authorized, filterable dimension of
# the measure's own entity; enum value, operation, input kind and scope rules
# are reused. The predicate only scopes that measure's rows (FILTER), never the
# global fact set.
def resolve_measure_predicate: Fn(PreparedPayload, MeasureEntry) -> qb.Expr = fn(payload, entry) {
    match entry.predicate {
        'None => fail!("measure has no inherent predicate", entry.id),
        'Some(pred) => do {
            let entity = get_index(payload.entities, entry.entity);
            let field = match array.get(entity.fields, pred.field) {
                'Some(f) => f,
                'None => fail!("measure predicate references an unknown field", entry.id, pred.field),
            };
            match array.find(payload.dimensions, fn(d) { d.entity == entry.entity && d.field == field.index }) {
                'None => fail!("measure predicate references a field with no dimension declaration", entry.id, field.name),
                'Some(d) => do {
                    if !d.authorized {
                        fail!("measure predicate references a dimension that is not authorized", d.id)
                    } else if !d.filterable {
                        fail!("measure predicate references a dimension with no filter capability", d.id)
                    } else if !array.any(d.ops, fn(op) { op == pred.op }) {
                        fail!("measure predicate uses an operation not supported by the dimension", d.id, pred.op)
                    } else if array.length(d.values) > 0 {
                        match pred.op {
                            'Eq => match pred.input {
                                'Text(s) => if array.any(d.values, fn(v) { v.value == s }) {
                                    qb.scalar('Eq, [dimension_expr(payload, d), qb.bind_string(s)])
                                } else {
                                    fail!("measure predicate references an unknown enum value for dimension", d.id, s)
                                },
                                _ => fail!("measure predicate uses an invalid enum value for dimension", d.id, pred.input),
                            },
                            'Ne => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                            'Gt => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                            'Ge => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                            'Lt => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                            'Le => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                            'Contains => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                            'NotContains => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                            'StartsWith => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                            'EndsWith => fail!("measure predicate on enum dimension supports only Eq", d.id, pred.op),
                        }
                    } else if is_text_op(pred.op) {
                        match pred.input {
                            'Text(_) => if !filter_input_allowed(d.input_kinds, pred.input) {
                                fail!("measure predicate uses an invalid value for the dimension", d.id, pred.input)
                            } else {
                                let base = dimension_expr(payload, d);
                                let bound = to_bind(pred.input);
                                open_condition_expr(base, pred.op, bound)
                            },
                            _ => fail!("measure predicate text operation requires a text input value", d.id),
                        }
                    } else if !filter_input_allowed(d.input_kinds, pred.input) {
                        fail!("measure predicate uses an invalid value for the dimension", d.id, pred.input)
                    } else {
                        let base = dimension_expr(payload, d);
                        let bound = to_bind(pred.input);
                        open_condition_expr(base, pred.op, bound)
                    }
                },
            }
        },
    }
};

def resolve_ordering: Fn(PreparedPayload, Array(OrderRequest), Array(String), Array(String)) -> Array(qb.OrderBy) = fn(payload, requests, requested_measures, requested_dimensions) {
    array.map(requests, fn(req) {
        match req.target {
            'Measure(id) => do {
                if !array.any(requested_measures, fn(m) { m == id }) {
                    fail!("ordering target is not a requested measure", id)
                } else {
                    match array.find(payload.measures, fn(m) { m.id == id }) {
                        'Some(entry) => match req.direction {
                            'Asc => qb.asc_aggregate(entry.alias),
                            'Desc => qb.desc_aggregate(entry.alias),
                        },
                        'None => fail!("ordering references an unknown measure", id),
                    }
                }
            },
            'Dimension(id) => do {
                if !array.any(requested_dimensions, fn(d) { d == id }) {
                    match array.find(payload.dimensions, fn(d) { d.id == id }) {
                        'Some(entry) => if !entry.authorized {
                            fail!("dimension is not authorized", id)
                        } else {
                            fail!("ordering target is not a requested dimension", id)
                        },
                        'None => fail!("ordering target is not a requested dimension", id),
                    }
                } else {
                    match array.find(payload.dimensions, fn(d) { d.id == id }) {
                        'Some(entry) => do {
                            if !entry.authorized {
                                fail!("dimension is not authorized", id)
                            } else {
                                let expr = dimension_expr(payload, entry);
                                match req.direction {
                                    'Asc => qb.asc(expr),
                                    'Desc => qb.desc(expr),
                                }
                            }
                        },
                        'None => fail!("ordering references an unknown dimension", id),
                    }
                }
            },
        }
    })
};

def check_limit: Fn(Option(Int)) -> Option(Int) = fn(limit) {
    match limit {
        'None => 'None,
        'Some(n) => if n > 0 { 'Some(n) } else { fail!("limit must be a positive integer", n) },
    }
};

# Offset must be non-negative and, when present, requires a stable deterministic
# ordering so pages repeat deterministically.
def check_offset: Fn(Option(Int), Int) -> Option(Int) = fn(offset, ordering_len) {
    match offset {
        'None => 'None,
        'Some(n) => if n < 0 {
            fail!("offset must be a non-negative integer", n)
        } else if ordering_len == 0 {
            fail!("offset requires a stable, deterministic ordering", n)
        } else {
            'Some(n)
        }
    }
};

# Validate and lower a Top Per Group request. Partition dimensions must be
# selected, authorized and grain-compatible; the ordering must be stable (it
# must cover every non-partition selected dimension); `take` must be a positive
# integer within the query upper bound; global limit/offset are not combined.
# The resolved ordering is reused as the partition-internal ordering.
def check_partition: Fn(PreparedPayload, QueryRequest, Array(ResolvedDimension), Array(qb.OrderBy)) -> Option(qb.PartitionedTopN) = fn(payload, request, dimensions, ordering) {
    match request.partition {
        'None => 'None,
        'Some(part) => do {
            let requested_dimension_ids = array.map(request.dimensions, fn(d) { d.id });
            if array.length(part.by) == 0 {
                fail!("partition must name at least one dimension")
            } else if part.take <= 0 || part.take > qb.max_partition_take {
                fail!("partition take must be a positive integer within the upper bound", part.take)
            } else if request.limit != 'None || request.offset != 'None {
                fail!("top per group does not combine with a global limit or offset")
            } else if array.length(request.ordering) == 0 {
                fail!("top per group requires a stable, deterministic ordering")
            } else {
                let partition_dims = array.map(part.by, fn(id) {
                    if !array.any(requested_dimension_ids, fn(d) { d == id }) {
                        fail!("partition dimension is not selected in this request", id)
                    } else {
                        match array.find(payload.dimensions, fn(d) { d.id == id }) {
                            'Some(d) => if !d.authorized {
                                fail!("partition dimension is not authorized", id)
                            } else {
                                d
                            },
                            'None => fail!("partition references an unknown dimension", id),
                        }
                    }
                });
                let non_partition_dims = array.filter(dimensions, fn(d) {
                    !array.any(part.by, fn(id) { id == d.entry.id })
                });
                let stable_ok = array.all(non_partition_dims, fn(d) {
                    array.any(request.ordering, fn(o) {
                        match o.target {
                            'Dimension(id) => id == d.entry.id,
                            'Measure(_) => 'False,
                        }
                    })
                });
                if !stable_ok {
                    fail!("partition ordering is not stable: it must cover every non-partition dimension")
                } else {
                    let partition_exprs = array.map(partition_dims, fn(d) { dimension_expr(payload, d) });
                    'Some(qb.partitioned_top_n(partition_exprs, ordering, part.take))
                }
            }
        },
    }
};

def merge_edges: Fn(Array(Int), Array(Int)) -> Array(Int) = fn(acc, seq) {
    array.fold(seq, acc, fn(edges, r) {
        if array.any(edges, fn(e) { e == r }) {
            edges
        } else {
            array.push(edges, r)
        }
    })
};

# One relation column pair becomes an equality ON atom over the two entities'
# canonical field columns (aliases come from the entity source declarations).
def pair_to_condition: Fn(PreparedPayload, Int, Int, RelationPair) -> qb.JoinCondition = fn(payload, from_entity, to_entity, pair) {
    let from_entry = get_index(payload.entities, from_entity);
    let to_entry = get_index(payload.entities, to_entity);
    let from_field = get_index(from_entry.fields, pair.from);
    let to_field = get_index(to_entry.fields, pair.to);
    qb.on_eq(qb.column_ref(from_entry.alias, from_field.column), qb.column_ref(to_entry.alias, to_field.column))
};

# A relation key lowers to the query public JoinCondition tree. `'And`/`'Or`
# nodes map to `on_and`/`on_or`; every column reference resolves to a visible
# source/join alias, so the result is a closed structured ON predicate.
def key_to_condition: Fn(PreparedPayload, Int, Int, RelationKey) -> qb.JoinCondition = fn(payload, from_entity, to_entity, key) {
    match key {
        'Eq(pair) => pair_to_condition(payload, from_entity, to_entity, pair),
        'And(keys) => qb.on_and(array.map(keys, fn(k) { key_to_condition(payload, from_entity, to_entity, k) })),
        'Or(keys) => qb.on_or(array.map(keys, fn(k) { key_to_condition(payload, from_entity, to_entity, k) })),
    }
};

def select_joins: Fn(PreparedPayload, Int, Array(Int)) -> Array(qb.Join) = fn(payload, base, targets) {
    let edges = array.fold(targets, [], fn(acc, target) {
        if target == base {
            acc
        } else {
            let row = get_index(payload.paths, base);
            let pr = get_index(row, target);
            match pr {
                'Safe(seq) => merge_edges(acc, seq),
                'FanOut(_) => fail!("path to requested entity requires a fan-out relation; use an existence filter", target),
                'Missing => fail!("no safe path to requested entity", target),
                'Truncated => fail!("path search was truncated", target),
            }
        }
    });
    array.map(edges, fn(r_index) {
        let r = get_index(payload.relations, r_index);
        let to_entity = get_index(payload.entities, r.to);
        let kind: qb.JoinKind = match r.kind { 'Safe => 'Inner, 'FanOut => 'Left };
        qb.join_on(
            kind,
            qb.source(to_entity.alias, to_entity.table),
            key_to_condition(payload, r.from, r.to, r.key),
        )
    })
};

def entity_by_id: Fn(PreparedPayload, String) -> Int = fn(payload, id) {
    match array.find(payload.entities, fn(e) { e.id == id }) {
        'Some(e) => e.index,
        'None => fail!("exists target entity is unknown", id),
    }
};

# Direction-explicit relation lookup for existence filters. Prefers a forward
# edge (base -> target); when absent, a reverse edge (target -> base) is used to
# derive the correlated existence without requiring the model to duplicate graph
# edges. Reverse lookups feed only the existence predicate, never the ordinary
# join path closure.
type RelationLookup = struct { index: Int, reversed: Bool };

def lookup_existence_relation: Fn(PreparedPayload, Int, Int) -> RelationLookup = fn(payload, base_entity, target) {
    let enumerated = array.enumerate(payload.relations);
    let forward = array.find(enumerated, fn(pair) { pair.1.from == base_entity && pair.1.to == target });
    match forward {
        'Some(pair) => do {
            let result: RelationLookup = { index: pair.0, reversed: 'False };
            result
        },
        'None => match array.find(enumerated, fn(pair) { pair.1.from == target && pair.1.to == base_entity }) {
            'Some(pair) => do {
                let result: RelationLookup = { index: pair.0, reversed: 'True };
                result
            },
            'None => fail!("exists target is not directly related to the base entity"),
        },
    }
};

# Correlation equality for an existence relation key pair. For a forward edge
# `pair.from`/`pair.to` are on the base/target entities; for a reverse edge the
# roles swap, keeping the outer (base) column on the left of the ColumnEq.
def exists_col_eq: Fn(EntityEntry, EntityEntry, RelationPair, Bool) -> qb.ColumnEq = fn(base_entry, target_entry, pair, reversed) {
    if reversed {
        let target_field = get_index(target_entry.fields, pair.from);
        let base_field = get_index(base_entry.fields, pair.to);
        qb.column_eq(qb.column_ref(base_entry.alias, base_field.column), qb.column_ref(target_entry.alias, target_field.column))
    } else {
        let base_field = get_index(base_entry.fields, pair.from);
        let target_field = get_index(target_entry.fields, pair.to);
        qb.column_eq(qb.column_ref(base_entry.alias, base_field.column), qb.column_ref(target_entry.alias, target_field.column))
    }
};

# The correlated EXISTS shape requires a conjunction of column equalities on the
# inner source; disjunctive relation keys cannot be expressed by EXISTS and fail
# with a deterministic diagnostic instead of guessing.
def exists_pairs: Fn(RelationKey) -> Array(RelationPair) = fn(key) {
    match key {
        'Eq(pair) => [pair],
        'And(keys) => array.flat_map(keys, fn(k) {
            match k {
                'Eq(pair) => [pair],
                _ => fail!("exists relation key must be a conjunction of column equalities"),
            }
        }),
        'Or(_) => fail!("exists relation key must be a conjunction of column equalities"),
    }
};

# Lower one correlated existence request. Rows of the base entity that have at
# least one (or, with `min_matches`, at least N) related row in the target
# entity are kept; the relation may be declared in either direction and fan-out
# relations are allowed because existence never amplifies the subject grain.
# Inner filters constrain the related rows and are parameterized bindings.
def resolve_exists: Fn(PreparedPayload, Int, ExistsRequest) -> qb.Exists = fn(payload, base_entity, spec) {
    let target = entity_by_id(payload, spec.target);
    if target == base_entity {
        fail!("exists target must differ from the base entity", spec.target)
    } else {
        let lookup = lookup_existence_relation(payload, base_entity, target);
        let rel = get_index(payload.relations, lookup.index);
        let pairs = exists_pairs(rel.key);
        let base_entry = get_index(payload.entities, base_entity);
        let target_entry = get_index(payload.entities, target);
        let col_eqs = array.map(pairs, fn(pair) { exists_col_eq(base_entry, target_entry, pair, lookup.reversed) });
        let inner_filters = resolve_filters(payload, spec.filters);
        let target_ok = array.all(inner_filters, fn(f) { f.entity == target });
        if !target_ok {
            fail!("exists inner filter must reference the target entity", spec.target)
        } else {
            let inner_any = array.map(spec.any_of, fn(a) { any_of_on_target(payload, target, a) });
            let inner = append_filter_terms(combine_filters(array.map(inner_filters, fn(f) { f.expr })), inner_any);
            let source = qb.source(target_entry.alias, target_entry.table);
            match spec.min_matches {
                'None => qb.exists(source, col_eqs, inner),
                'Some(n) => do {
                    if n <= 0 {
                        fail!("exists minimum matches must be a positive integer", spec.target, n)
                    } else if array.length(col_eqs) != 1 {
                        fail!("grouped existence requires a single-pair relation key", spec.target)
                    } else {
                        # the inner correlation column identifies the related subject's group
                        let corr = get_index(col_eqs, 0);
                        let grouping: Array(qb.Expr) = [qb.column(corr.right.source, corr.right.column)];
                        let count_column = if target_entry.key_field >= 0 {
                            get_index(target_entry.fields, target_entry.key_field).column
                        } else {
                            corr.right.column
                        };
                        let count_expr: qb.Expr = qb.column(corr.right.source, count_column);
                        let threshold_v: qb.Val = 'Int(n);
                        let having_list: Array(qb.Having) = [qb.having_call('Ge, 'Count, count_expr, 'False, threshold_v)];
                        qb.exists_grouped(source, col_eqs, inner, grouping, having_list)
                    }
                },
            }
        }
    }
};

# Lower one aggregate-result (HAVING) predicate over a requested measure.
# Threshold values always become the trailing `?` binding via the query public
# `having` constructor.
def resolve_having: Fn(PreparedPayload, Array(MeasureRequest), HavingRequest) -> qb.Having = fn(payload, measure_requests, spec) {
    if !array.any(measure_requests, fn(m) { m.id == spec.measure }) {
        fail!("having references a measure that is not requested", spec.measure)
    } else if !payload.authorize(spec.subject) {
        fail!("subject is not authorized for having measure", spec.subject, spec.measure)
    } else {
        match array.find(payload.measures, fn(m) { m.id == spec.measure }) {
            'Some(entry) => do {
                let op_q: qb.HavingOp = match spec.op {
                    'Eq => 'Eq,
                    'Ne => 'Ne,
                    'Gt => 'Gt,
                    'Ge => 'Ge,
                    'Lt => 'Lt,
                    'Le => 'Le,
                };
                let val_q: qb.Val = to_val(spec.threshold);
                qb.having(op_q, entry.alias, val_q)
            },
            'None => fail!("having references an unknown measure", spec.measure),
        }
    }
};

# Union (derived) branch filter: a fixed Eq over one logical field mapped to the
# branch's physical column.
def union_branch_filter: Fn(EntityEntry, UnionBranchEntry) -> Option(qb.Expr) = fn(entity, branch) {
    match branch.filter {
        'None => 'None,
        'Some(pred) => do {
            let physical = get_index(branch.columns, pred.field);
            let expr = qb.scalar('Eq, [qb.column(branch.alias, physical), to_bind(pred.input)]);
            'Some(expr)
        },
    }
};

# Build the query DerivedSource for a union entity: each ordered branch projects
# every logical field from its own mapped physical column under the logical
# field's stable column name (the branch output alias). All validated at prepare.
def build_union_derived: Fn(EntityEntry, UnionEntry) -> qb.DerivedSource = fn(entity, union) {
    let branches = array.map(union.branches, fn(branch) {
        let outputs = array.map(entity.fields, fn(f) {
            let physical = get_index(branch.columns, f.index);
            qb.union_column(f.column, qb.column(branch.alias, physical))
        });
        qb.union_branch(qb.source(branch.alias, branch.table), outputs, union_branch_filter(entity, branch))
    });
    qb.derived_source(union.alias, branches)
};

# Resolved physical sources for one lowering: either a normal base source plus
# joins, or (for a union entity) an empty physical source set plus one derived
# UNION ALL source. `exists` plans apply only to the single-source case.
type LoweredSources = struct {
    sources: Array(qb.Source),
    derived: Option(qb.DerivedSource),
    joins: Array(qb.Join),
    exists: Array(qb.Exists),
};

# Shared lowering pipeline. Measures may be empty: the request then projects
# row-level dimension attributes (no grouping, no aggregate items) and derives
# the base entity from the first requested dimension. Existence filters keep the
# base grain; having predicates constrain aggregated results.
def lower_core: Fn(PreparedPayload, QueryRequest, Array(AnyOfRequest), Array(ExistsRequest), Array(HavingRequest)) -> qb.Plan = fn(payload, request, any_of_specs, exists_specs, having_specs) {
    let measures = resolve_measures(payload, request.measures);
    let dimensions = resolve_dimensions(payload, request.dimensions);
    let measure_count = array.length(measures);
    let dimension_count = array.length(dimensions);
    if measure_count == 0 && dimension_count == 0 {
        fail!("request must select at least one measure or one dimension")
    } else if measure_count == 0 && request.partition != 'None {
        fail!("top per group requires an aggregated measure")
    } else if measure_count == 0 && array.length(having_specs) > 0 {
        fail!("having requires an aggregated measure")
    } else {
        let base_entity = if measure_count > 0 {
            let first = get_index(measures, 0).entry.entity;
            let grain_ok = array.all(measures, fn(m) { m.entry.entity == first });
            if grain_ok { first } else { fail!("requested measures are not grain-compatible") }
        } else {
            get_index(dimensions, 0).entry.entity
        };
        let scope_resolutions = array.flat_map(dimensions, fn(d) {
            array.map(d.entry.scope, fn(p) { resolve_scope(payload, d.entry, p) })
        });
        let filter_resolutions = resolve_filters(payload, request.filters);
        let any_exprs = array.map(any_of_specs, fn(a) { any_of_expr(payload, a) });
        let filter_expr = append_filter_terms(combined_filter(scope_resolutions, filter_resolutions), any_exprs);
        let any_entities = array.map(any_of_specs, fn(a) {
            match array.find(payload.dimensions, fn(d) { d.id == a.id }) {
                'Some(entry) => entry.entity,
                'None => fail!("unknown any-of dimension", a.id),
            }
        });
        let requested_measure_ids = array.map(request.measures, fn(m) { m.id });
        let requested_dimension_ids = array.map(request.dimensions, fn(d) { d.id });
        let ordering = resolve_ordering(payload, request.ordering, requested_measure_ids, requested_dimension_ids);
        let partition = check_partition(payload, request, dimensions, ordering);
        let limit = check_limit(request.limit);
        let offset = check_offset(request.offset, array.length(request.ordering));
        let base_entry = get_index(payload.entities, base_entity);
        let source_plan = match base_entry.union {
            'None => do {
                let exists_plans = array.map(exists_specs, fn(spec) { resolve_exists(payload, base_entity, spec) });
                let exists_targets = array.map(exists_specs, fn(spec) { entity_by_id(payload, spec.target) });
                # A measure-required entity that is also an existence target is
                # satisfied by the correlated existence predicate instead of a
                # fan-out join, so the subject measure is not amplified.
                let measure_targets = array.concat(array.map(measures, fn(m) { m.entry.requires }));
                let filtered_measure_targets = array.filter(measure_targets, fn(t) {
                    !array.any(exists_targets, fn(e) { e == t })
                });
                let dim_entities = array.map(dimensions, fn(d) { d.entry.entity });
                let scope_entities = array.map(scope_resolutions, fn(f) { f.entity });
                let filter_entities = array.map(filter_resolutions, fn(f) { f.entity });
                let targets = array.concat([filtered_measure_targets, dim_entities, scope_entities, filter_entities, any_entities]);
                let joins = select_joins(payload, base_entity, targets);
                let join_sources = array.map(joins, fn(j) { j.source });
                let sources = array.concat([[qb.source(base_entry.alias, base_entry.table)], join_sources]);
                let result: LoweredSources = { sources, derived: 'None, joins, exists: exists_plans };
                result
            },
            'Some(union) => do {
                if array.length(exists_specs) > 0 {
                    fail!("union entity request does not support existence filters")
                } else {
                    let measure_targets = array.concat(array.map(measures, fn(m) { m.entry.requires }));
                    let dim_entities = array.map(dimensions, fn(d) { d.entry.entity });
                    let scope_entities = array.map(scope_resolutions, fn(f) { f.entity });
                    let filter_entities = array.map(filter_resolutions, fn(f) { f.entity });
                    let refs = array.concat([measure_targets, dim_entities, scope_entities, filter_entities, any_entities]);
                    let refs_ok = array.all(refs, fn(t) { t == base_entity });
                    if !refs_ok {
                        fail!("union entity request cannot join or filter another entity")
                    } else {
                        let none_sources: Array(qb.Source) = [];
                        let none_joins: Array(qb.Join) = [];
                        let none_exists: Array(qb.Exists) = [];
                        let result: LoweredSources = { sources: none_sources, derived: 'Some(build_union_derived(base_entry, union)), joins: none_joins, exists: none_exists };
                        result
                    }
                }
            },
        };
        let measure_items = array.map(measures, fn(m) {
            let entity = get_index(payload.entities, m.entry.entity);
            let field = get_index(entity.fields, m.entry.field);
            match m.entry.computed {
                'Some(spec) => qb.computed_item(spec.op, spec.left, spec.right, m.entry.alias),
                'None => match m.entry.predicate {
                    'Some(_) => qb.aggregate_filtered(m.entry.aggregate, qb.column(entity.alias, field.column), m.distinct, 'Some(resolve_measure_predicate(payload, m.entry)), m.entry.alias),
                    'None => qb.aggregate(m.entry.aggregate, qb.column(entity.alias, field.column), m.distinct, m.entry.alias),
                },
            }
        });
        let dimension_items = array.map(dimensions, fn(d) {
            qb.expr_item(dimension_expr(payload, d.entry))
        });
        let projection = array.concat([measure_items, dimension_items]);
        let none_grouping: Array(qb.Expr) = [];
        let grouping = if measure_count > 0 {
            array.map(dimensions, fn(d) { dimension_expr(payload, d.entry) })
        } else {
            none_grouping
        };
        let having_plans = array.map(having_specs, fn(spec) { resolve_having(payload, request.measures, spec) });
        let no_partition_ordering: Array(qb.OrderBy) = [];
        let plan: qb.Plan = {
            revision: payload.revision,
            sources: source_plan.sources,
            derived: source_plan.derived,
            projection,
            filter: filter_expr,
            exists: source_plan.exists,
            joins: source_plan.joins,
            grouping,
            having: having_plans,
            ordering: if partition == 'None { ordering } else { no_partition_ordering },
            limit: if partition == 'None { limit } else { 'None },
            offset: if partition == 'None { offset } else { 'None },
            partition,
        };
        qb.validate(plan, payload.profile)
    }
};

def lower: Fn(PreparedPayload, QueryRequest) -> qb.Plan = fn(payload, request) {
    lower_core(payload, request, [], [], [])
};

# Additive entry: the base QueryRequest plus typed existence filters and
# aggregate-result (HAVING) predicates.
def lower_full: Fn(PreparedPayload, QueryRequest, Array(ExistsRequest), Array(HavingRequest)) -> qb.Plan = fn(payload, request, exists_specs, having_specs) {
    lower_core(payload, request, [], exists_specs, having_specs)
};

# Additive entry with closed OR-groups on the subject filters (AnyOf), combined
# with existence filters and HAVING predicates in a deterministic order.
def lower_any: Fn(PreparedPayload, QueryRequest, Array(AnyOfRequest), Array(ExistsRequest), Array(HavingRequest)) -> qb.Plan = fn(payload, request, any_of_specs, exists_specs, having_specs) {
    lower_core(payload, request, any_of_specs, exists_specs, having_specs)
};

# Count the number of groups of a grouped request that satisfy the given
# aggregate-result predicates (nested shape 1: count of groups over a
# `SELECT ... GROUP BY ... HAVING ...` inner query). Ordering/limit/offset/
# partition do not change a group count and are rejected deterministically.
def lower_group_count: Fn(PreparedPayload, QueryRequest, Array(HavingRequest)) -> qb.Query = fn(payload, request, having_specs) {
    if array.length(request.ordering) > 0 {
        fail!("group count request must not specify an ordering")
    } else if request.limit != 'None || request.offset != 'None || request.partition != 'None {
        fail!("group count request must not specify limit, offset or partition")
    } else if array.length(request.measures) == 0 || array.length(request.dimensions) == 0 {
        fail!("group count request must select measures and grouping dimensions")
    } else {
        let inner = lower_core(payload, request, [], [], having_specs);
        qb.count_groups(inner, payload.profile)
    }
};

