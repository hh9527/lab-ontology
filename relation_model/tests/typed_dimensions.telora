use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::quantity as q;
use ontology::experimental::transform as transform;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::intent as intent;
use ontology::sqlite as sqlite;
use std::json as json;
use std::codec as codec;
use std::value::{Value};
use std::test as test;

type Tenant = struct(String);
type Device = struct(String);
type Identity = struct { tenant: Tenant, device: Device };
type Row = struct { seq: Int, tenant: Tenant, device: Option(Device), amount: Option(q::Bytes), ms: Option(q::Milliseconds) };
def dataset: m::Dataset(Row) = m::dataset("samples", "samples", Row.type, ["seq"]);
def entity: m::Entity(Identity) = m::entity("device", Identity.type);
def role: m::Role(Row) = m::role(dataset, entity, "device", True, [
    m::identity_part(m::field(Row.type, Tenant.type, "tenant"), m::field(Identity.type, Tenant.type, "tenant")),
    m::identity_part(m::optional_field(Row.type, Device.type, "device"), m::field(Identity.type, Device.type, "device")),
]);
def seconds: g::Expr(Row, q::Seconds) = g::seconds(g::input(m::optional_field(Row.type, q::Milliseconds.type, "ms")));
def rate: g::Expr(Row, q::BytesPerSecond) = g::rate(g::input(m::optional_field(Row.type, q::Bytes.type, "amount")), seconds);
def duration: g::Binding(Row) = g::dimension(dataset, g::dimension_group("duration", q::Seconds.type, True, [g::Filter::Eq]), seconds, "seconds", True, [g::Filter::Eq]);
def speed: g::Binding(Row) = g::dimension(dataset, g::dimension_group("speed", q::BytesPerSecond.type, True, [g::Filter::Eq]), rate, "rate", True, [g::Filter::Eq]);
def identity: g::Binding(Row) = g::identity_dimensions(dataset, role, [{member: "tenant", publish: "tenant"}, {member: "device", publish: "device"}]);
def declared: transform::Declaration = transform::map_columns(transform::declare(dataset, [role], [duration, speed, identity], ["records"]), [
    transform::column(m::field(Row.type, Int.type, "seq"), "ROW_NO"),
    transform::column(m::field(Row.type, Tenant.type, "tenant"), "TENANT_ID"),
    transform::column(m::optional_field(Row.type, Device.type, "device"), "DEVICE_ID"),
    transform::column(m::optional_field(Row.type, q::Bytes.type, "amount"), "BYTES"),
    transform::column(m::optional_field(Row.type, q::Milliseconds.type, "ms"), "ELAPSED_MS"),
]);
def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Aggregate, qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Filter],
    allowed_join_kinds: [], allowed_aggregates: [qb::AggregateFunction::Count],
    allowed_scalars: [qb::ScalarFunction::Div, qb::ScalarFunction::Gt, qb::ScalarFunction::If, qb::ScalarFunction::Eq, qb::ScalarFunction::IsNotNull, qb::ScalarFunction::And], allow_distinct: False,
};
def payload: edsl::PreparedPayload = transform::prepare("dimensions", [declared], profile).payload;
def request: Value = json::parse(r#"{"op":"Graph","root":"renamed","nodes":[{"id":"renamed","entity":"samples"}],"edges":[],
    "select":[{"node":"renamed","dimension":"seconds"},{"node":"renamed","dimension":"rate"},{"node":"renamed","dimension":"tenant"},{"node":"renamed","dimension":"device"}]}"#).unwrap!();
def filtered: Value = json::parse(r#"{"op":"Graph","root":"filtered","nodes":[{"id":"filtered","entity":"samples"}],"edges":[],
    "select":[{"node":"filtered","dimension":"seconds"},{"node":"filtered","dimension":"rate"}],
    "filters":[{"node":"filtered","dimension":"rate","op":"Eq","value":50.0}]}"#).unwrap!();
pub def computed_dimensions_preserve_result_types_and_nullable_identity: test::Test = test::should_ok(fn() {
    let ast = intent::query_intent_ast_factory(payload)(request);
    intent::result_columns(payload, request, ast) == [
        {name: "renamed_seconds", type: intent::ResultType::Float, nullable: True},
        {name: "renamed_rate", type: intent::ResultType::Float, nullable: True},
        {name: "renamed_tenant", type: intent::ResultType::String, nullable: True},
        {name: "renamed_device", type: intent::ResultType::String, nullable: True},
    ]
});
pub def computed_projection_checks_scalar_capabilities: test::Test = test::should_fail_with(fn() {
    transform::checked_prepare("no-div", [declared], profile <~ {allowed_scalars: [qb::ScalarFunction::Eq]})
}, "declared dimension projection uses capabilities not allowed by the query profile");
pub def filter_only_computation_checks_scalar_capabilities: test::Test = test::should_fail_with(fn() {
    let binding = g::checked_dimension(dataset, g::checked_dimension_group("duration", q::Seconds.type, False, [g::Filter::Eq]), seconds, "seconds", False, [g::Filter::Eq]);
    transform::checked_prepare("no-filter-div", [transform::checked_declare(dataset, [], [binding], [])], profile <~ {allowed_scalars: [qb::ScalarFunction::Eq]})
}, "declared dimension filter uses capabilities not allowed by the query profile");
type RuntimeCase = struct {id: String, query: qb::Query};
def runtime_case: Fn(String, Value) -> RuntimeCase = fn(id, input) {
    {id, query: sqlite::build_query(intent::query_intent_ast_factory(payload)(input))}
};
def count_request: Value = json::parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"samples"}],"edges":[],
    "select":[],"measures":[{"node":"r","measure":"records"}]}"#).unwrap!();
pub def mapped_record_count_preserves_integer_nonnull_result: test::Test = test::should_ok(fn() {
    let ast = intent::query_intent_ast_factory(payload)(count_request);
    intent::result_columns(payload, count_request, ast) == [{name: "r_records", type: intent::ResultType::Int, nullable: False}]
});
pub def runtime_cases: Value = codec::encode([runtime_case("projection", request), runtime_case("filter", filtered), runtime_case("count", count_request)]);
