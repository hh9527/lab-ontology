    @v::map(domains::LuRunningStatus.type, "lu_running_status", [v::member(domains::LuRunningStatus::Value27, ["27"]), v::member(domains::LuRunningStatus::Value28, ["28"]), v::member(domains::LuRunningStatus::Value44, ["44"]), v::member(domains::LuRunningStatus::Value53, ["53"]), v::member(domains::LuRunningStatus::Value106, ["106"])])
    running_status: Option(String),
    @g::field_view(g::dimension_group("lun/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "lu_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("lun/obj_sys_id", domain::Reference(ids::CloudBlockLun2KpiByObjSysId).type, True, [g::Filter::Eq]), "lu_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::CloudBlockLun2KpiByObjSysId)),
