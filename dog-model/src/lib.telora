mod model;

use crate::model::{ payload };
use ontology::intent as intent;
use ontology::query as qb;
use std::transform_service as service;
use std::codec as codec;
use std::value::{ Value };

type MainService = struct { lower: Fn(Value) -> qb::Query };
impl service::TransformService for MainService {
    init: fn(ctx) {
        { lower: intent::query_intent_lower_factory(payload, "resolver") }.ty!(Self)
    },
    transform: fn(self, input) {
        codec::encode(self.lower(input))
    },
};
pub use self::{ MainService };
