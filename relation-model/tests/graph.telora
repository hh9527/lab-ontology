pub def disconnected_directed_existence_rejects_missing_anchor: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
