# canonical indices: asset_number=0, bios_version=1, bmc_hostname=2,
# classification=3, commu_state=4, firmware_version=5, id=6, ip_address=7,
# location=8, mac=9, manufacturer=10, model=11, name=12, ori_id=13,
# project_id=14, service_duration=15, site_key=16, sn=17, tenant_key=18,
# version=19
@edsl.entity_source("PhysicalServer", "d")
@edsl.entity_id("server_device")
@edsl.relation(Tenant, safe_kind, 18, 1)
@edsl.relation(Site, safe_kind, 16, 0)
