# ent-1/tests/query-surface.telora
#
# Public query facade contract checks.  The facade must:
#   - load and expose the public vocabulary captured from the prepared root;
#   - lower typed Requests deterministically;
#   - decode the fixed JSON Value shape through lower_value;
#   - prove that lower and lower_value produce the same Query for the same
#     intent;
#   - produce codec/JSON-encodable results.
# Evaluated by `check @test/query-surface`; any broken contract fails loudly.

import "query/lib" as qb;
import "std/array" as array;
import "std/codec" as codec;
import "std/json" as json;
import "std/result" as result;
import "std/string" as string;
import "std/value" { Value };
import "@src/query" as query;
import "@src/model" as model;

def check: Fn(Bool, String) -> Bool = fn(cond, label) {
    if cond { 'True } else { fail!("query-surface contract check failed", label) }
};

def generic_request: query.Request = {
    measures: ["OrdersCreated"],
    dimensions: ["OrderMonth"],
    filters: [
        { dimension: "CustomerTier", op: 'Eq, value: 'String("Gold") },
    ],
    ordering: [
        { target: 'Measure("OrdersCreated"), direction: 'Desc },
        { target: 'Dimension("OrderMonth"), direction: 'Asc },
    ],
    limit: 'Some(5),
};

# The filter scalar boundary is untagged native JSON: 'String("Gold") encodes
# as "Gold", 'Int(3) as 3, 'Number(3.5) as 3.5 (mirroring query's
# Val). Telora internally keeps the closed nominal enum; round-trip and
# Int/Float dispatch must hold across codec.encode / codec.decode.
def filter_value_untagged_scalar_ok: Bool = do {
    let s: query.FilterValue = 'String("Gold");
    let i: query.FilterValue = 'Int(3);
    let f: query.FilterValue = 'Number(3.5);
    let s_enc = codec.encode(Value, s) |> result.unwrap;
    let i_enc = codec.encode(Value, i) |> result.unwrap;
    let f_enc = codec.encode(Value, f) |> result.unwrap;
    let enc_ok = s_enc == 'String("Gold") && i_enc == 'Int(3) && f_enc == 'Float(3.5);
    let s_dec: query.FilterValue = codec.decode(query.FilterValue, 'String("Gold")) |> result.unwrap;
    let i_dec: query.FilterValue = codec.decode(query.FilterValue, 'Int(3)) |> result.unwrap;
    let f_dec: query.FilterValue = codec.decode(query.FilterValue, 'Float(3.5)) |> result.unwrap;
    let dec_ok = s_dec == s && i_dec == i && f_dec == f;
    let text = json.stringify(s_enc);
    check(enc_ok, "filter scalar encodes as untagged native scalar")
        && check(dec_ok, "filter scalar decodes from untagged native scalar")
        && check(text == "\"Gold\"", "filter string value JSON text has no variant wrapper")
};

# The public vocabulary is captured from the prepared ontology root (no
# second hand-maintained copy).
def vocabulary_captured_from_root: Bool = do {
    let expected_measures = array.map(model.payload.measures, fn(m) { m.id });
    let expected_dims = array.map(
        array.filter(model.payload.dimensions, fn(d) { d.authorized }),
        fn(d) { d.id },
    );
    let measures_ok = query.measures == expected_measures;
    let dims_ok = query.dimensions == expected_dims;
    let contains = array.any(query.dimensions, fn(id) { id == "OrderMonth" });
    check(measures_ok, "vocabulary measures captured from the prepared root")
        && check(dims_ok, "vocabulary dimensions captured from the prepared root")
        && check(contains, "vocabulary includes an authorized dimension")
};

# The typed entry lowers to a parameterized Query with a stable revision.
def lower_typed_ok: Bool = do {
    let q1 = query.lower(generic_request);
    let q2 = query.lower(generic_request);
    check(q1.sql == q2.sql && q1.bindings == q2.bindings, "lower is deterministic")
        && check(array.length(q1.bindings) > 0, "lower returns non-empty bindings")
};

# The dynamic entry decodes the fixed Value shape and returns a ValueQuery.
def lower_value_ok: Bool = do {
    let encoded: Value = codec.encode(Value, generic_request) |> result.unwrap;
    let vq = query.lower_value(encoded);
    match vq.intent {
        'Object(_) => check('True, "lower_value intent is an object"),
        _ => check('False, "lower_value intent is an object"),
    }
};

# lower and lower_value agree on the same intent.
def lower_and_lower_value_agree: Bool = do {
    let encoded: Value = codec.encode(Value, generic_request) |> result.unwrap;
    let typed: Value = codec.encode(Value, query.lower(generic_request)) |> result.unwrap;
    let vq = query.lower_value(encoded);
    check(vq.query == typed, "lower and lower_value produce the same Query")
};

# The normalized intent decodes back to the same typed Request.
def normalized_intent_roundtrip: Bool = do {
    let encoded: Value = codec.encode(Value, generic_request) |> result.unwrap;
    let vq = query.lower_value(encoded);
    let back: query.Request = codec.decode(query.Request, vq.intent) |> result.unwrap;
    check(back == generic_request, "normalized intent round-trips to the typed Request")
};

# The Query and ValueQuery results are codec/JSON encodable.
def results_encodable: Bool = do {
    let encoded: Value = codec.encode(Value, generic_request) |> result.unwrap;
    let vq = query.lower_value(encoded);
    let q_ok = match codec.encode(Value, query.lower(generic_request)) {
        'Ok(_) => 'True,
        'Err(_) => 'False,
    };
    check(q_ok, "Query encodes to Value")
        && check(vq.query == vq.query, "ValueQuery is a total struct")
};

# The facade exposes precise nominal types; no erased public boundary.
def surface_types_precise: Bool = do {
    let op: query.Order = { target: 'Measure("OrdersCreated"), direction: 'Desc };
    let ok = match op.target { 'Measure(id) => id == "OrdersCreated", 'Dimension(_) => 'False };
    check(ok, "ordering target is a closed typed variant")
};

# Positive Top N: a positive limit lowers and its value is a binding.
def positive_top_n_ok: Bool = do {
    let request: query.Request = {
        measures: ["OrdersCreated"],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'Some(7),
    };
    let q = query.lower(request);
    let last = match array.get(q.bindings, array.length(q.bindings) - 1) {
        'Some(v) => v,
        'None => fail!("bindings empty"),
    };
    let limit_ok = match last { 'Int(n) => n == 7, _ => 'False };
    check(limit_ok, "positive Top N appears as the final binding")
};

# Authorized filter capabilities through the facade: OrderMonth, OriginRegion
# and ProductCategory expose Eq/Ge/Le; CustomerTier is a closed enum value
# domain and therefore only Eq.
def filter_capability_set_ok: Bool = do {
    let probe = fn(measure_id, dimension_id, op, value) {
        let request: query.Request = {
            measures: [measure_id],
            dimensions: [],
            filters: [{ dimension: dimension_id, op, value: 'String(value) }],
            ordering: [],
            limit: 'None,
        };
        let query = query.lower(request);
        array.length(query.bindings) > 0
    };
    let month = probe("OrdersCreated", "OrderMonth", 'Eq, "2026-04")
        && probe("OrdersCreated", "OrderMonth", 'Ge, "2026-04")
        && probe("OrdersCreated", "OrderMonth", 'Le, "2026-04");
    let tier = probe("OrdersCreated", "CustomerTier", 'Eq, "Gold");
    let region = probe("OrdersCreated", "OriginRegion", 'Eq, "East China")
        && probe("OrdersCreated", "OriginRegion", 'Ge, "East China")
        && probe("OrdersCreated", "OriginRegion", 'Le, "East China");
    let category = probe("UnitsShipped", "ProductCategory", 'Eq, "电子")
        && probe("UnitsShipped", "ProductCategory", 'Ge, "电子")
        && probe("UnitsShipped", "ProductCategory", 'Le, "电子");
    check(month, "facade filter capability: OrderMonth Eq/Ge/Le")
        && check(tier, "facade filter capability: CustomerTier Eq (closed enum domain)")
        && check(region, "facade filter capability: OriginRegion Eq/Ge/Le")
        && check(category, "facade filter capability: ProductCategory Eq/Ge/Le")
};

# The facade exposes the CustomerTier closed enum catalog from the same
# prepared root (stable values and labels), without a second hand-maintained
# copy.
def customer_tier_domain_ok: Bool = do {
    let values = query.customer_tier_domain;
    let has = fn(variant, value, label) {
        array.any(values, fn(v) { v.variant == variant && v.value == value && v.label == label })
    };
    check(array.length(values) == 3
        && has("Gold", "Gold", "Gold customer")
        && has("Silver", "Silver", "Silver customer")
        && has("Bronze", "Bronze", "Bronze customer"),
        "facade exposes the CustomerTier closed catalog from the prepared root")
};

# Negative dynamic-boundary guarantees (static counterpart of the repeatable
# best-effort probes in src/bin/invalid.telora).  The closed enum domain must
# exclude unknown values and only declare Eq; therefore lower_value(CustomerTier
# = Diamond) fails with "unknown enum value for dimension" and
# lower_value(CustomerTier Ge Gold) fails with "filter operation not supported"
# -- out-of-band, never a partial ValueQuery.
def negative_boundary_guarantees: Bool = do {
    let values = query.customer_tier_domain;
    let value_set = array.map(values, fn(v) { v.value });
    let diamond_excluded = !array.any(value_set, fn(v) { v == "Diamond" })
        && !array.any(value_set, fn(v) { v == "diamond" });
    let tier = match array.find(model.payload.dimensions, fn(d) { d.id == "CustomerTier" }) {
        'Some(d) => d,
        'None => fail!("CustomerTier missing from dimensions"),
    };
    let ops_eq_only = array.length(tier.ops) == 1 && array.any(tier.ops, fn(op) { op == 'Eq });
    check(diamond_excluded, "negative boundary: Diamond is not a member of the closed domain")
        && check(ops_eq_only, "negative boundary: CustomerTier declares only Eq (Ge/Le rejected)")
};

export {
    vocabulary_captured_from_root,
    lower_typed_ok,
    lower_value_ok,
    lower_and_lower_value_agree,
    normalized_intent_roundtrip,
    results_encodable,
    surface_types_precise,
    filter_value_untagged_scalar_ok,
    filter_capability_set_ok,
    customer_tier_domain_ok,
    negative_boundary_guarantees,
    positive_top_n_ok,
};
