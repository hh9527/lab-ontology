def computed_aggregate_rejects_missing_add_scalar = fn() {
    # A `ComputedOp.Add` aggregate consumes `ScalarFunction.Add`; a profile
    # without `Add` must reject it even though it allows `Scalar`.
    let no_add: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Aggregate, qb.Operator.Group],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Eq, qb.ScalarFunction.Sub],
        allow_distinct: True,
    };
    !qb.profile_accepts(computed_add_plan(), no_add)
};

def computed_aggregate_rejects_missing_sub_scalar = fn() {
    # A `ComputedOp.Sub` aggregate consumes `ScalarFunction.Sub`; a profile
    # without `Sub` must reject it.
    let no_sub: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Aggregate, qb.Operator.Filter, qb.Operator.Group, qb.Operator.Order],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Eq, qb.ScalarFunction.Add],
        allow_distinct: True,
    };
    !qb.profile_accepts(computed_aggregate_plan(), no_sub)
};

def computed_aggregate_rejects_missing_scalar_operator = fn() {
    let no_scalar: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Aggregate, qb.Operator.Filter, qb.Operator.Group, qb.Operator.Order],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Eq, qb.ScalarFunction.Add, qb.ScalarFunction.Sub],
        allow_distinct: True,
    };
    !qb.profile_accepts(computed_aggregate_plan(), no_scalar)
};

# ---------------------------------------------------------------------------
# SQLite JSON1 v1 (JsonExtract / JsonType / JsonValid).
#
# The JSON path is always a literal string Bind, so it enters `?`/bindings and
# never the SQL text.  Arity is fixed (Extract/Type = 2, Valid = 1); the second
# argument of Extract/Type must be a string Bind in structural validation.
# ---------------------------------------------------------------------------

def json_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-json",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "id")),
            qb.expr_item(qb.json_extract(qb.column("e", "payload"), "$.attempt_id")),
            qb.expr_item(qb.json_extract(qb.column("e", "payload"), "$.status")),
            qb.expr_item(qb.json_type(qb.column("e", "payload"), "$.amount")),
            qb.expr_item(qb.json_valid(qb.column("e", "payload"))),
        ],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [
            qb.json_extract(qb.column("e", "payload"), "$.status"),
            qb.bind_string("ok"),
        ])),
        joins: [],
        grouping: [qb.json_extract(qb.column("e", "payload"), "$.attempt_id")],
        ordering: [qb.asc(qb.json_extract(qb.column("e", "payload"), "$.attempt_id"))],
        limit: None,
        offset: None,
        exists: [],
        having: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def expected_json_sql = "SELECT e.id, json_extract(e.payload, ?), json_extract(e.payload, ?), json_type(e.payload, ?), json_valid(e.payload) FROM events AS e WHERE json_extract(e.payload, ?) = ? GROUP BY json_extract(e.payload, ?) ORDER BY json_extract(e.payload, ?) ASC";

def expected_json_bindings: Array(qb.Val) = [
    qb.Val.String("$.attempt_id"), qb.Val.String("$.status"), qb.Val.String("$.amount"),
    qb.Val.String("$.status"), qb.Val.String("ok"),
    qb.Val.String("$.attempt_id"), qb.Val.String("$.attempt_id"),
];

def json_partition_plan: Fn() -> qb.Plan = fn() {
    let attempt = qb.json_extract(qb.column("e", "payload"), "$.attempt_id");
    let plan: qb.Plan = {
        revision: "test-json-partition",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.expr_item(attempt),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("e", "id"), False, "uses"),
        ],
        filter: None,
        joins: [],
        grouping: [qb.column("e", "role"), attempt],
        ordering: [],
        limit: None,
        offset: None,
        exists: [],
        having: [],
        derived: None,
        partition: Some(qb.partitioned_top_n(
            [qb.column("e", "role")],
            [qb.desc_aggregate("uses"), qb.asc(attempt)],
            3,
        )),
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def expected_json_partition_sql = "SELECT __q_0, __q_1, uses FROM (SELECT e.role AS __q_0, json_extract(e.payload, ?) AS __q_1, count(e.id) AS uses, row_number() OVER (PARTITION BY e.role ORDER BY count(e.id) DESC, json_extract(e.payload, ?) ASC) AS __q_rn FROM events AS e GROUP BY e.role, json_extract(e.payload, ?)) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_0 ASC, uses DESC, __q_1 ASC";

def expected_json_partition_bindings: Array(qb.Val) = [
    qb.Val.String("$.attempt_id"), qb.Val.String("$.attempt_id"),
    qb.Val.String("$.attempt_id"), qb.Val.Int(3),
];

# A minimal plan exposing a single expression, for structural rejection tests.
def json_probe_plan: Fn(qb.Expr) -> qb.Plan = fn(probe) {
    let plan: qb.Plan = {
        revision: "test-json-probe",
        sources: [qb.source("e", "events")],
        projection: [qb.expr_item(probe)],
        filter: None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: None,
        offset: None,
        exists: [],
        having: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def json_lowers_across_projection_filter_grouping_ordering = fn() {
    let q = qb.transform_sqlite(json_plan());
    q.sql == expected_json_sql && q.bindings == expected_json_bindings
};

def json_path_stays_in_bindings_not_sql = fn() {
