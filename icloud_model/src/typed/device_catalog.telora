use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 独立 transform 声明；单位、grain 与关系只采用既有公开契约。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
type CatalogId = struct(String);
@domain::entity_by("DeviceCatalog")
type DeviceCatalogById = struct(CatalogId);
@domain::subject("DeviceCatalog", "source_ID")
@domain::dataset("source_T_DEVICE_ALL", "T_DEVICE_ALL", ["source_ID"])
type TDeviceAll = struct {
    @m::column("ID")
    @g::exact("source_T_DEVICE_ALL__ID")
    source_ID: DeviceCatalogById,
    @m::column("NAME")
    @g::search("source_T_DEVICE_ALL__NAME")
    source_NAME: String,
    @m::column("CATEGORY")
    @g::exact("source_T_DEVICE_ALL__CATEGORY_raw")
    @v::map(
        SourceTDEVICEALLCATEGORY.type,
        "source_T_DEVICE_ALL__CATEGORY",
        [
            v::member(SourceTDEVICEALLCATEGORY::StorageDevice, ["STORAGE"]),
            v::member(SourceTDEVICEALLCATEGORY::Firewall, ["FW"]),
            v::member(SourceTDEVICEALLCATEGORY::RouterDevice, ["AR"]),
            v::member(SourceTDEVICEALLCATEGORY::SwitchDevice, ["LSW"]),
            v::member(SourceTDEVICEALLCATEGORY::TianGuan, ["TianGuan"]),
            v::member(SourceTDEVICEALLCATEGORY::AcDevice, ["AC"]),
            v::member(SourceTDEVICEALLCATEGORY::ApDevice, ["AP"]),
            v::member(SourceTDEVICEALLCATEGORY::CollaborationDevice, ["Collaboration"]),
            v::member(SourceTDEVICEALLCATEGORY::OnuDevice, ["ONU"]),
            v::member(SourceTDEVICEALLCATEGORY::OltDevice, ["OLT"]),
            v::member(SourceTDEVICEALLCATEGORY::OpticalSplitter, ["SPL"]),
            v::member(SourceTDEVICEALLCATEGORY::Server, ["SERVER"])
        ]
    )
    source_CATEGORY: String,
    @m::column("IP")
    @g::search("source_T_DEVICE_ALL__IP")
    @g::ipv4_view("source_T_DEVICE_ALL__IP_ipv4")
    source_IP: String,
    @m::column("MAC")
    @g::search("source_T_DEVICE_ALL__MAC")
    source_MAC: String,
    @m::column("CLASS_NAME")
    @g::exact("source_T_DEVICE_ALL__CLASS_NAME")
    source_CLASS_NAME: String,
};

def subject: r::Endpoint = domain::endpoint(TDeviceAll.type, "source_ID");

@knowledge_policy::reverse_references(True)
type SourceTDEVICEALLCATEGORY = enum {
    @ev::description("storage device", "存储设备")
    StorageDevice,

    @ev::description("Firewall", "防火墙")
    Firewall,

    @ev::description("router device", "路由器设备")
    RouterDevice,

    @ev::description("switch device", "交换机设备")
    SwitchDevice,

    @ev::description("Tian Guan", "天关设备")
    TianGuan,

    @ev::description("AC device", "AC设备")
    AcDevice,

    @ev::description("AP device", "AP设备")
    ApDevice,

    @ev::description("Collaboration device", "协作设备")
    CollaborationDevice,

    @ev::description("onu device", "ONU设备")
    OnuDevice,

    @ev::description("OLT device", "OLT设备")
    OltDevice,

    @ev::description("optical splitter", "SPL分光器设备")
    OpticalSplitter,

    @ev::description("server", "服务器")
    Server,
};

pub use self::{TDeviceAll, DeviceCatalogById};

pub use self::{SourceTDEVICEALLCATEGORY};
