pub def device_to_kpi_preserves_tenant_key: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"list","measures":[],"dimensions":["device_kpi_ts_raw","device_name"],"filters":[{"dimension":"device_name","op":"eq","kind":"text","value":"Device-A"}],"ordering":[],"limit":null,"offset":null}`);
    if array::length(string::split(q.sql, "NetworkDeviceKPI")) > 1
        && array::length(string::split(q.sql, "k.resId = d.id")) > 1
        && array::length(string::split(q.sql, "k.tenantId = d.tenant_id")) > 1
        && q.bindings == [qb::Val::String("Device-A")] {
        True
    } else {
        fail!("KPI access must retain both owner keys", q)
    }
});

pub def pon_port_peak_is_distinct_from_published_average: test::Test = test::should_ok(fn() {
    let metrics = edsl::metric_domain(payload, "pon_port_kpi");
    let avg = array::any(metrics, fn(m) { m.id == "pon_port_receive_usage" && m.aggregate == qb::AggregateFunction::Avg });
    let peak = array::any(metrics, fn(m) { m.id == "pon_port_receive_sample_max" && m.aggregate == qb::AggregateFunction::Max });
    if avg && peak { True } else { fail!("PON port Avg and raw-sample Max must remain separate", metrics) }
});

pub def pon_port_peak_uses_device_identity_and_utc_bounds: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_related","dataset":"pon_port_kpi","owner":"pon_device","relation":"pon_port_kpi_of_device","measures":["pon_port_receive_sample_max"],"dimensions":["pon_name"],"filters":[{"dimension":"pon_class","op":"eq","kind":"text","value":"spl"},{"dimension":"pon_commu_state","op":"eq","kind":"text","value":"offline"}],"ordering":[],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"limit":null,"offset":null}`);
    if string::contains(q.sql, "max(ppk.ifInBandRate)")
        && string::contains(q.sql, "ppk.parentId = pd.id")
        && string::contains(q.sql, "GROUP BY pd.name, pd.id")
        && q.bindings == [qb::Val::String("ne.category.pon.spl"), qb::Val::String("0"), qb::Val::String("2"), qb::Val::String("3"), qb::Val::String("4"), qb::Val::String("14"), qb::Val::String("15"), qb::Val::String("2024-02-01T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z")] { True }
    else { fail!("PON peak must use the published device link and the complete device ID", q) }
});

