use ontology::quantity as statistic_quantity;
use ontology::quantity as q;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::semantic as domain;
# 采样身份由资源 ID 与 UTC 采集时间组成，实体关系不代替采样 grain。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
type PacketLoss = struct(q::Percent);
type LinkJitter = struct(q::Milliseconds);
type LinkDelay = struct(q::Milliseconds);
@q::calculations(
    [
        q::Calculation::Compare,
        q::Calculation::Mean,
        q::Calculation::Min,
        q::Calculation::Max,
        q::Calculation::Round
    ]
)
type LinkQuality = struct(Float);
def cell_link_packet_loss_statistics: samples::Group(PacketLoss) = samples::group("cell_link_packet_loss", PacketLoss.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], None);
def cell_link_jitter_statistics: samples::Group(LinkJitter) = samples::group("cell_link_jitter", LinkJitter.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], None);
def cell_link_delay_statistics: samples::Group(LinkDelay) = samples::group("cell_link_delay", LinkDelay.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], None);
def cell_link_lqm_statistics: samples::Group(LinkQuality) = samples::group("cell_link_lqm", LinkQuality.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], None);
@domain::bind(i::DeviceById.type, "source_resId")
@domain::dataset(
    "source_NetworkCellLinkQualityKPI",
    "NetworkCellLinkQualityKPI",
    ["source_resId", "source_ts"]
)
@domain::metric("source_ts")
@domain::relations(source_relations)
type NetworkCellLinkQualityKPI = struct {
    @m::column("ts")
    @g::view("source_NetworkCellLinkQualityKPI__ts", True, g::numeric_filters)
    @g::utc_bucket_view("source_NetworkCellLinkQualityKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkCellLinkQualityKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkCellLinkQualityKPI_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("cell_link_quality_sample_count")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkCellLinkQualityKPI__resId")
    source_resId: domain::Reference(i::DeviceById),
    @m::column("tenantId")
    @g::exact("source_NetworkCellLinkQualityKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("projectId")
    @g::exact("source_NetworkCellLinkQualityKPI__projectId")
    source_projectId: String,
    @m::column("srcSiteId")
    @g::exact("source_NetworkCellLinkQualityKPI__srcSiteId")
    source_srcSiteId: String,
    @m::column("destSiteId")
    @g::exact("source_NetworkCellLinkQualityKPI__destSiteId")
    source_destSiteId: String,
    @m::column("sourceWanlinkId")
    @g::exact("source_NetworkCellLinkQualityKPI__sourceWanlinkId")
    source_sourceWanlinkId: String,
    @m::column("destWanlinkId")
    @g::exact("source_NetworkCellLinkQualityKPI__destWanlinkId")
    source_destWanlinkId: String,
    @m::column("packetLoss")
    @g::view("source_NetworkCellLinkQualityKPI__packetLoss", True, g::numeric_filters)
    @samples::field(cell_link_packet_loss_statistics, [
        {statistic: samples::Statistic::Mean, publish: "cell_link_packet_loss"},
        {statistic: samples::Statistic::Min, publish: "cell_link_packet_loss_min"},
        {statistic: samples::Statistic::Max, publish: "cell_link_packet_loss_max"}
    ])
    @domain::count("cell_link_packet_loss_observation_count")
    @samples::valid_count("source_packetLossEffcnt")
    source_packetLoss: PacketLoss,
    @m::column("jitter")
    @g::view("source_NetworkCellLinkQualityKPI__jitter", True, g::numeric_filters)
    @samples::field(cell_link_jitter_statistics, [
        {statistic: samples::Statistic::Mean, publish: "cell_link_jitter"},
        {statistic: samples::Statistic::Min, publish: "cell_link_jitter_min"},
        {statistic: samples::Statistic::Max, publish: "cell_link_jitter_max"}
    ])
    @domain::count("cell_link_jitter_observation_count")
    @samples::valid_count("source_jitterEffcnt")
    source_jitter: LinkJitter,
    @m::column("delay")
    @g::view("source_NetworkCellLinkQualityKPI__delay", True, g::numeric_filters)
    @samples::field(cell_link_delay_statistics, [
        {statistic: samples::Statistic::Mean, publish: "cell_link_delay"},
        {statistic: samples::Statistic::Min, publish: "cell_link_delay_min"},
        {statistic: samples::Statistic::Max, publish: "cell_link_delay_max"}
    ])
    @domain::count("cell_link_delay_observation_count")
    @samples::valid_count("source_delayEffcnt")
    source_delay: LinkDelay,
    @m::column("lqm")
    @g::view("source_NetworkCellLinkQualityKPI__lqm", True, g::numeric_filters)
    @samples::field(cell_link_lqm_statistics, [
        {statistic: samples::Statistic::Mean, publish: "cell_link_lqm"},
        {statistic: samples::Statistic::Min, publish: "cell_link_lqm_min"},
        {statistic: samples::Statistic::Max, publish: "cell_link_lqm_max"}
    ])
    @domain::count("cell_link_lqm_observation_count")
    @samples::valid_count("source_lqmEffcnt")
    source_lqm: LinkQuality,
    @m::column("packetLossEffcnt")
    @g::view("source_NetworkCellLinkQualityKPI__packetLossEffcnt", True, g::numeric_filters)
    source_packetLossEffcnt: EffectiveCount,
    @m::column("jitterEffcnt")
    @g::view("source_NetworkCellLinkQualityKPI__jitterEffcnt", True, g::numeric_filters)
    source_jitterEffcnt: EffectiveCount,
    @m::column("delayEffcnt")
    @g::view("source_NetworkCellLinkQualityKPI__delayEffcnt", True, g::numeric_filters)
    source_delayEffcnt: EffectiveCount,
    @m::column("lqmEffcnt")
    @g::view("source_NetworkCellLinkQualityKPI__lqmEffcnt", True, g::numeric_filters)
    source_lqmEffcnt: EffectiveCount,
};

pub use self::{NetworkCellLinkQualityKPI};

def source_relations: Array(r::Relation) = [
    r::relation(
        "source_EntNetworkElement_NetworkCellLinkQualityKPI",
        i::device_subject,
        domain::endpoint(NetworkCellLinkQualityKPI.type, "source_resId"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    )
];
