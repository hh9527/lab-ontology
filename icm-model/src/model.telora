# ---------------------------------------------------------------------------
# Unified device entity (five domains that carry site + tenant keys)
# ---------------------------------------------------------------------------
#
# A restricted cross-domain device source over the five physical device tables
# that each expose a stable device id, a site key and a tenant key:
#   EntNetworkElement     id / refParentSubnet / tenantId
#   EntPonElement         id / refParentSubnet / tenantId
#   PhysicalServer        id / refParentSubnet / tenantId
#   HuaweiStorageDevice   id / refParentSubnet / tenantId
#   EntTerminalElement    resId / siteId / tenantId
#
# EntCollaborationElement is excluded: it has no site key (do not fake a site,
# borrow tenant as site, or silently fill nulls).  UNION ALL counts rows of
# these five sources.  The logical fields are stable identifiers (device id,
# site id, tenant id); the outer plan never joins governance views, so only
# these stable ids are published as dimensions (not SiteName/TenantName).
#
# Capability boundary (public contract in docs/DOMAIN.md section 4.1): the
# unified device source is a plain cross-domain object count over stable ids.
# It does NOT carry alarm/KPI/sub-part relations and does NOT support related
# existence filters (e.g. "unified devices that have a matching alarm"), so
# requests mixing DeviceCount with alarm existence/HAVING, or with
# SiteName/TenantName display dimensions, are deterministically rejected by the
# ontology layer.  Such generic-device questions must first be narrowed to a
# concrete domain (after user clarification) or answered with the
# alarm-anchored AlarmDeviceRefCount (Distinct) measure; the model never
# silently substitutes a single domain.

def device_net_cols: Array(edsl.UnionColumnDecl) = [
    {field: 0, column: "id"},
    {field: 1, column: "refParentSubnet"},
    {field: 2, column: "tenantId"},
];
def device_pon_cols: Array(edsl.UnionColumnDecl) = [
    {field: 0, column: "id"},
    {field: 1, column: "refParentSubnet"},
    {field: 2, column: "tenantId"},
];
def device_server_cols: Array(edsl.UnionColumnDecl) = [
    {field: 0, column: "id"},
    {field: 1, column: "refParentSubnet"},
    {field: 2, column: "tenantId"},
];
def device_storage_cols: Array(edsl.UnionColumnDecl) = [
    {field: 0, column: "id"},
    {field: 1, column: "refParentSubnet"},
    {field: 2, column: "tenantId"},
];
def device_terminal_cols: Array(edsl.UnionColumnDecl) = [
    {field: 0, column: "resId"},
    {field: 1, column: "siteId"},
    {field: 2, column: "tenantId"},
];
def device_branches: Array(edsl.UnionBranchDecl) = [
    {table: "EntNetworkElement", alias: "n", columns: device_net_cols, filter: 'None},
    {table: "EntPonElement", alias: "p", columns: device_pon_cols, filter: 'None},
    {table: "PhysicalServer", alias: "s", columns: device_server_cols, filter: 'None},
    {table: "HuaweiStorageDevice", alias: "g", columns: device_storage_cols, filter: 'None},
    {table: "EntTerminalElement", alias: "t", columns: device_terminal_cols, filter: 'None},
];

@edsl.entity_id("device")
@edsl.union_source("u", device_branches)
type Device = struct {
    @edsl.column("device_id")
    @edsl.key(flag_true)
    @edsl.measure("DeviceCount", count_agg, no_types)
    device_id: String,

    @edsl.column("site_id")
    @edsl.dimension("DeviceSiteId", flag_true, flag_true, text_eq_ops, text_kinds)
    site_id: String,

    @edsl.column("tenant_id")
    @edsl.dimension("DeviceTenantId", flag_true, flag_true, text_eq_ops, text_kinds)
    tenant_id: String,
};
# canonical indices: device_id=0, site_id=1, tenant_id=2

