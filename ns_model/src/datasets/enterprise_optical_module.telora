    vendor_sn: Option(String),
    @m::column("vendorName")
    @g::field_view(g::dimension_group("enterprise-optical-module/vendor_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "eom_vendor_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    vendor_name: Option(String),
    @m::column("neResId")
