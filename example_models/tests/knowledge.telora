use dog_model::model as dog;
use spider_model::model as spider;
use world_model::model as world;
use ontology::knowledge as knowledge;
use ontology::ontology as edsl;
use std::array as array;
use std::codec as codec;
use std::test as test;
use std::value::{ Value };

def keys: Fn(edsl::PreparedPayload) -> Value = fn(payload) {
    codec::encode(array::map(knowledge::index_from_model(payload).entries,
        fn(entry) { edsl::knowledge_key(entry.key) }))
};

pub def dog_keys: Value = keys(dog::payload);
pub def spider_keys: Value = keys(spider::payload);
pub def world_keys: Value = keys(world::payload);

pub def all_examples_publish_schema_roots_and_direct_members: test::Test = test::should_ok(fn() {
    array::all([dog::payload, spider::payload, world::payload], fn(payload) {
        let index = knowledge::index_from_model(payload);
        let root = knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Index, owner: "", id: "index"});
        match root {
            knowledge::DocResult::Found(point) => match point.entries {
                Some(entries) => array::length(entries) > 0 && array::length(point.refs) == 0
                    && array::all(entries, fn(entry) { entry.key.kind == edsl::KnowledgeKind::Schema }),
                None => False,
            },
            _ => False,
        }
    })
});
