pub def relations: Array(r::Relation) = [
    r::relation("cbl2__lu_rev", domain::endpoint(Lun.type, "obj_sys_id"), domain::endpoint(cloud_block_lun_2_kpi::CloudBlockLun2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("el2__lu_rev", domain::endpoint(Lun.type, "obj_sys_id"), domain::endpoint(enterprise_lun_2_kpi::EnterpriseLun2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
