use ontology::model as m;
use ontology::registry as registry;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as sample;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use crate::units as units;

use crate::identities as ids;
use crate::groups as groups;
use crate::domains as domains;
use crate::datasets::serversensor_2_kpi as serversensor_2_kpi;
@registry::relations(relations)
@registry::dataset("kpi-server-sensor", "kpi_server_sensor", ["obj_id", "ts"])
@registry::roles([role_186])
@registry::groups(
    [
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_server_sensor.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "ss_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_server_sensor.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "ss_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_server_sensor.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "ss_utc_month",
            True,
            g::time_filters
        )
    ]
)
@registry::reported_samples(
    [
        sample::bind(
            dataset,
            groups::group_17,
            m::optional_field(
                kpi_server_sensor.type,
                units::DegreesCelsius.type,
                "sensor_temperature"
            ),
            [
                {statistic: sample::Statistic::Mean, publish: "ss_sensor_temperature"},
                {statistic: sample::Statistic::Max, publish: "ss_sensor_temperature_max"},
                {statistic: sample::Statistic::Min, publish: "ss_sensor_temperature_min"}
            ]
        )
    ]
)
@registry::metric("ts")
pub type kpi_server_sensor = struct {
    @m::column("OBJ_ID")
    @g::field_view(
        groups::group_3,
        "ss_obj_id",
        True,
        [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]
    )
    obj_id: Int,
    @m::column("TS")
    @g::field_view(
        groups::group_6,
        "ss_sample_time",
        True,
        [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
    )
    ts: s::DateTimeUtc,
    @m::column("SENSORTEMPERATURE")
    @g::field_view(
        groups::group_16,
        "ss_sensor_temperature_raw",
        True,
        [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]
    )
    sensor_temperature: Option(units::DegreesCelsius)
};
pub def dataset: m::Dataset(kpi_server_sensor) = registry::dataset_of(kpi_server_sensor.type);
pub def role_186: m::Role(kpi_server_sensor) = m::role(
    dataset,
    ids::entity_80,
    "role_186",
    False,
    [
        m::reference_part(
            m::field(kpi_server_sensor.type, Int.type, "obj_id"),
            m::field(ids::Identity80.type, ids::Key80_0.type, "k0")
        )
    ]
);

pub def relations: Array(r::Relation) = [
    r::relation(
        "ss__serversensor_2_rev",
        r::endpoint(kpi_server_sensor.type, "role_186"),
        r::endpoint(serversensor_2_kpi::serversensor2kpi.type, "role_187"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}
    )
];
