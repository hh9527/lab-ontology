# world-model/src/bin/make-query.telora
#
# Deterministic entry used by the Host adapter `bin/world-make-query check`.
# The lowering capability is the ontology shared closed Intent protocol bound to
# the world_1 prepared payload: `ontology/intent::query_intent_lower_factory`.

import "ontology/intent" as intent;
import "@src/model" { payload };
import "std/dict" as dict;
import "std/entry" as entry;
import "std/codec" as codec;
import "std/value" { Value };

def config: entry.ContextConfig = {
    sources: ["input"],
    envs: [],
    args: False,
};

export def main = entry.main(config, fn(ctx) {
    let raw: Value = match dict.get(ctx.sources, "input") {
        Some(value) => value,
        None => fail!("missing input source"),
    };
    let lower = intent.query_intent_lower_factory(payload, "public");
    let query = lower(raw);
    codec.encode(Value, query)
});
