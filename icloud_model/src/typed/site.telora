# 站点独立声明，保留设备定位的两个备选身份角色
use super::inventory as i;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
type Identity = struct { id: i::SiteId };
type SiteType = struct(String);
type Row = struct {
    site_id: i::SiteId, site_name: String, site_type: String, tenant_id: i::TenantId,
    source_PARENT_SITE_ID: String, source_SITE_ALIAS: String,
    # 保留基线 UTC 毫秒假定，尚未确认生产单位
    source_CREATE_TIME: s::EpochMillis,
};
def entity: m::Entity(Identity) = m::entity("site_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset("site", "X_SITE_VIEW", Row.type, ["site_id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, i::SiteId.type, "site_id"), m::field(Identity.type, i::SiteId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
def project: m::Role(i::DeviceRow) = m::role(i::devices, entity, "project_site", False, [m::identity_part(m::field(i::DeviceRow.type, i::SiteId.type, "project_id"), m::field(Identity.type, i::SiteId.type, "id"))]);
def subnet: m::Role(i::DeviceRow) = m::role(i::devices, entity, "subnet_site", False, [m::identity_part(m::field(i::DeviceRow.type, i::SiteId.type, "ref_parent_subnet"), m::field(Identity.type, i::SiteId.type, "id"))]);
def types: v::Domain(SiteType, String) = v::domain("SiteType", SiteType.type, String.type, [v::member(SiteType("online"), ["onlineSite"]), v::member(SiteType("offline"), ["offlineSite"])], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [subject, tenant], [
    i::exact(dataset, m::field(Row.type, i::SiteId.type, "site_id"), "site_id"),
    i::search(dataset, m::field(Row.type, String.type, "site_name"), "site_name"),
    i::exact(dataset, m::field(Row.type, String.type, "source_PARENT_SITE_ID"), "site__PARENT_SITE_ID"),
    i::search(dataset, m::field(Row.type, String.type, "source_SITE_ALIAS"), "site__SITE_ALIAS"),
    g::dimension(dataset, g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::time_filters), g::input(m::field(Row.type, s::EpochMillis.type, "source_CREATE_TIME")), "site__CREATE_TIME", True, g::time_filters),
], []), [
    t::column(m::field(Row.type, i::SiteId.type, "site_id"), "SITE_ID"),
    t::column(m::field(Row.type, String.type, "site_name"), "SITE_NAME"),
    t::column(m::field(Row.type, String.type, "site_type"), "SITE_TYPE"),
    t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "TENANT_ID"),
    t::column(m::field(Row.type, String.type, "source_PARENT_SITE_ID"), "PARENT_SITE_ID"),
    t::column(m::field(Row.type, String.type, "source_SITE_ALIAS"), "SITE_ALIAS"),
    t::column(m::field(Row.type, s::EpochMillis.type, "source_CREATE_TIME"), "CREATE_TIME"),
]), [v::bind(dataset, v::dimension_group(types, True, g::equality_filters), g::input(m::field(Row.type, String.type, "site_type")), "site_type", True, g::equality_filters)]);
def cardinality: edsl::RelationCardinality = {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional};
def relations: Array(r::Relation) = [
    r::relation("site_belongs_to_tenant", dataset, tenant, i::tenants, i::tenant_subject, cardinality),
    r::relation("source_X_TENANT_VIEW_X_SITE_VIEW", i::tenants, i::tenant_subject, dataset, tenant, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
def alternatives: Array(t::Alternative) = [
    {id: "device_located_at_site", cardinality, choices: [r::relation("device_project_site", i::devices, project, dataset, subject, cardinality), r::relation("device_subnet_site", i::devices, subnet, dataset, subject, cardinality)]},
    {id: "source_EntNetworkElement_X_SITE_VIEW", cardinality, choices: [r::relation("source_device_project_site", i::devices, project, dataset, subject, cardinality), r::relation("source_device_subnet_site", i::devices, subnet, dataset, subject, cardinality)]},
];
pub use self::{declaration, relations, alternatives, project, subnet};
