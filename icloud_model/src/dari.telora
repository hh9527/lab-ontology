# IC 的模型配置与服务入口；发布协议由 ontology::publication 提供。
use icloud_model::typed;
use ontology::publication;
use ontology::typed_query;
use ontology::intent;
use ontology::sqlite;
use std::transform_service as service;
use std::value::{Value};
# 模型公开别名引用同一份业务类型定义。
def input_declarations: Array((String, typed_query::TypeRef)) = [
    (
        "ic::AlarmSeverity",
        typed_query::type_ref(typed::current_alarm::AlarmSeverity.type, intent::ResultType::String)
    ),
    (
        "ic::DeviceClass",
        typed_query::type_ref(typed::inventory::DeviceClass.type, intent::ResultType::String)
    )
];

def program: publication::Program = publication::stage(typed::payload, "ic", input_declarations, sqlite::build_query);
type Check = struct { program: publication::Program };
impl service::TransformService for Check {
    init: fn(ctx) { {program}.ty!(Self) },
    transform: fn(self, input) { publication::dispatch(self.program, input) },
};
@service::collection
pub type MainService = struct {
    @service::slot("ontology/dari")
    check: Check,
};
