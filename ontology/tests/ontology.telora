pub def dimension_discovery_explains_computation_and_scope: test::Test = test::should_ok(fn() {
    let computed = edsl::dimension_detail_for_subject(knowledge::payload, "analyst", "OrderWeek");
    let tier = edsl::dimension_detail_for_subject(knowledge::payload, "analyst", "CustomerTier");
    let scoped = edsl::dimension_detail(knowledge::payload, "TraceHead");
    let tier_ok = array::any(tier.values, fn(value) { value.id == "gold" && value.label == "Gold customer" });
    let scoped_ok = match array::get(scoped.scope, 0) {
        Some(p) => p.field == "kind" && p.op == edsl::FilterOp::Eq
            && p.input == edsl::FilterInput::Text("run"),
        None => False,
    };
    if computed.dataset == "orders" && computed.field == "created_at"
        && computed.computed && computed.filterable
        && computed.ops == [edsl::FilterOp::Ge, edsl::FilterOp::Le]
        && computed.input_kinds == [edsl::FilterInputKind::Text]
        && array::length(computed.scope) == 0 && scoped_ok && tier_ok { True }
    else { fail!("dimension discovery lost computed, enum or scoped semantics", computed, tier, scoped) }
});

