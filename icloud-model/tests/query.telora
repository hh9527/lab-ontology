pub def communication_dimension_detail_is_discoverable: test::Test = test::should_ok(fn() {
    let detail = edsl::dimension_detail_for_subject(payload, "public", "device_commu_state");
    let offline = array::find(detail.values, fn(value) { value.id == "offline" });
    let internal = edsl::dimension_detail(payload, "device_commu_state");
    let mapping = array::find(internal.canonical_values, fn(value) { value.id == "offline" });
    match offline {
        Some(value) => if detail.dataset == "device" && detail.field == "commu_state"
            && detail.label == "Device communication state"
            && value.label == "Offline" && detail.filterable && !detail.computed
            && detail.ops == eq_only && detail.input_kinds == text_only
            && array::length(detail.values) == 3
            && match mapping { Some(raw) => array::length(raw.wires) == 2, None => False } { True }
            else { fail!("communication detail lost business semantics", detail) },
        None => fail!("communication detail lost offline", detail),
    }
});

