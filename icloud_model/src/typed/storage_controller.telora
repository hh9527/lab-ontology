use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储组件来源：parent 使用存储设备身份；原始文本不按单位说明隐式解析。
use super::inventory as i;
use super::storage as storage;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("StorageController")
type StorageControllerById = struct(ComponentId);
type CpuCount = struct(Int);
@domain::subject("StorageController", "source_id")
@domain::dataset("source_SYS_Controller", "SYS_Controller", ["source_id"])
@domain::relations(relations)
type SysController = struct {
    @m::column("tenantId")
    @g::exact("source_SYS_Controller__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("id")
    @g::exact("source_SYS_Controller__id")
    source_id: StorageControllerById,
    # TODO：沿用旧 UTC 毫秒假定，来源整数时钟单位尚待确认。
    @m::column("createTime")
    @g::field_view(
        g::dimension_group(
            "source_SYS_Controller__createTime",
            s::EpochMillis.type,
            True,
            g::numeric_filters
        ),
        "source_SYS_Controller__createTime",
        True,
        g::numeric_filters
    )
    source_createTime: s::EpochMillis,
    @m::column("name")
    @g::search("source_SYS_Controller__name")
    source_name: String,
    @m::column("parentId")
    @g::exact("source_SYS_Controller__parentId")
    source_parentId: String,
    @m::column("model")
    @g::search("source_SYS_Controller__model")
    source_model: String,
    @m::column("temperature")
    @g::exact("source_SYS_Controller__temperature")
    source_temperature: String,
    @m::column("cpuCount")
    @g::field_view(
        g::dimension_group(
            "source_SYS_Controller__cpuCount",
            CpuCount.type,
            True,
            g::numeric_filters
        ),
        "source_SYS_Controller__cpuCount",
        True,
        g::numeric_filters
    )
    source_cpuCount: CpuCount,
    @m::column("oriResId")
    @g::exact("source_SYS_Controller__oriResId")
    source_oriResId: String,
    @m::column("bomId")
    @g::search("source_SYS_Controller__bomId")
    source_bomId: String,
    @m::column("barCode")
    @g::search("source_SYS_Controller__barCode")
    source_barCode: String,
    @m::column("parentResId")
    @g::exact("source_SYS_Controller__parentResId")
    source_parentResId: domain::Reference(storage::StorageById),
    @m::column("memorySize")
    @g::exact("source_SYS_Controller__memorySize")
    source_memorySize: String,
    @m::column("softVer")
    @g::search("source_SYS_Controller__softVer")
    source_softVer: String,
    @m::column("location")
    @g::search("source_SYS_Controller__location")
    source_location: String,
    @m::column("healthStatus")
    @v::classification(
        SourceSYSControllerHealthStatus_domain,
        "source_SYS_Controller__healthStatus"
    )
    source_healthStatus: String,
    @m::column("runningStatus")
    @v::classification(
        SourceSYSControllerRunningStatus_domain,
        "source_SYS_Controller__runningStatus"
    )
    source_runningStatus: String,
    @m::column("role")
    @v::classification(SourceSYSControllerRole_domain, "source_SYS_Controller__role")
    source_role: String,
};

def subject: r::Endpoint = domain::endpoint(SysController.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(SysController.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(SysController.type, "source_parentResId");

@knowledge_policy::reverse_references(True)
type SourceSYSControllerHealthStatus = enum {
    @ev::rename("0")
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("Faulty", "故障")
    Faulty,
    @ev::rename("9")
    @ev::description("Inconsistent", "不一致")
    Inconsistent,
};
def SourceSYSControllerHealthStatus_domain: v::Domain(SourceSYSControllerHealthStatus, String) = v::from_enum(
    "SourceSYSControllerHealthStatus",
    SourceSYSControllerHealthStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSControllerRunningStatus = enum {
    @ev::rename("0")
    @ev::description("unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::alias("27")
    @ev::description("online", "在线")
    Online,
    @ev::rename("2")
    @ev::description("running", "运行")
    Running,
    @ev::rename("28")
    @ev::description("offline", "离线")
    Offline,
};
def SourceSYSControllerRunningStatus_domain: v::Domain(SourceSYSControllerRunningStatus, String) = v::from_enum(
    "SourceSYSControllerRunningStatus",
    SourceSYSControllerRunningStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSControllerRole = enum {
    @ev::rename("0")
    @ev::description("Regular Member", "普通成员")
    RegularMember,
    @ev::rename("1")
    @ev::description("Cluster Master", "集群主")
    ClusterMaster,
    @ev::rename("2")
    @ev::description("Cluster Standby", "集群备")
    ClusterStandby,
};
def SourceSYSControllerRole_domain: v::Domain(SourceSYSControllerRole, String) = v::from_enum(
    "SourceSYSControllerRole",
    SourceSYSControllerRole.type,
    String.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceAssociationSYS_Controller",
        storage::subject,
        parent,
        cardinality
    ),
    r::relation(
        "source_SYS_ControllerAssociationX_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{SysController, StorageControllerById};
