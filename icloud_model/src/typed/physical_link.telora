use super::fc_switch as fc_switch;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 物理链路：A/Z 是固定物理位置，业务方向由显式条件决定。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
type LinkId = struct(String);
@domain::entity_by("PhysicalLink")
type PhysicalLinkById = struct(LinkId);
@domain::subject("PhysicalLink", "id")
@domain::dataset("physical_link", "EnterprisePhysicalLink", ["id"])
@domain::record_counts(["physical_link_count"])
@domain::native_pairs(
    [{name: "link_ne_names", left: "physical_link_a_ne_name", right: "physical_link_z_ne_name"}]
)
@domain::relations(relations)
@domain::alternatives(alternatives)
@domain::links(links)
type EnterprisePhysicalLink = struct {
    @m::column("aNeResId")
    @domain::targets(
        [
            {name: "fc_a_reference", identity: fc_switch::FcSwitchById.type}.ty!(
                domain::ReferenceTarget
            ),
            {name: "a_device", identity: i::DeviceById.type}.ty!(domain::ReferenceTarget),
            {name: "a_server", identity: server::ServerById.type}.ty!(domain::ReferenceTarget)
        ]
    )
    a_ne_res_id: domain::Reference(String),
    @m::column("tenantId")
    tenant_id: domain::Reference(i::TenantById),
    @m::column("aNeName")
    @g::search("physical_link_a_ne_name")
    a_ne_name: String,
    @m::column("zNeName")
    @g::search("physical_link_z_ne_name")
    z_ne_name: String,
    @g::exact("physical_link_id")
    id: PhysicalLinkById,
    @g::search("physical_link_name")
    name: String,
    @m::column("linkType")
    @v::classification(PhysicalLinkType_domain, "physical_link_type")
    link_type: Int,
    @v::classification(PhysicalLinkDirection_domain, "physical_link_direction")
    direction: String,
    @m::column("linkStatus")
    @v::classification(PhysicalLinkStatus_domain, "physical_link_status")
    link_status: Int,
    @m::column("zNeResId")
    @domain::targets(
        [
            {name: "fc_z_reference", identity: fc_switch::FcSwitchById.type}.ty!(
                domain::ReferenceTarget
            ),
            {name: "z_device", identity: i::DeviceById.type}.ty!(domain::ReferenceTarget),
            {name: "z_server", identity: server::ServerById.type}.ty!(domain::ReferenceTarget)
        ]
    )
    z_ne_res_id: domain::Reference(String),
    @m::column("aPortIp")
    @g::search("physical_link_a_port_ip")
    @g::ipv4_view("physical_link_a_port_ip_ipv4")
    a_port_ip: String,
    @m::column("zPortName")
    @g::search("physical_link_z_port_name")
    z_port_name: String,
    @m::column("aNeIp")
    @g::search("physical_link_a_ne_ip")
    @g::ipv4_view("physical_link_a_ne_ip_ipv4")
    a_ne_ip: String,
    @m::column("alias")
    @g::search("physical_link__alias")
    source_alias: String,
    @m::column("aEndME")
    @g::exact("physical_link__aEndME")
    source_aEndME: String,
    @m::column("zEndME")
    @g::exact("physical_link__zEndME")
    source_zEndME: String,
    @m::column("createTime")
    @g::field_view(
        g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::time_filters),
        "physical_link__createTime",
        True,
        g::time_filters
    )
    source_createTime: s::EpochMillis,
    @m::column("speed")
    @g::exact("physical_link__speed")
    source_speed: String,
    @m::column("projectId")
    @g::exact("physical_link__projectId")
    source_projectId: String,
    @m::column("zPortIp")
    @g::search("physical_link__zPortIp")
    @g::ipv4_view("physical_link__zPortIp_ipv4")
    source_zPortIp: String,
    @m::column("zPortAlias")
    @g::search("physical_link__zPortAlias")
    source_zPortAlias: String,
    @m::column("zPortDn")
    @g::exact("physical_link__zPortDn")
    source_zPortDn: String,
    @m::column("zNeIp")
    @g::search("physical_link__zNeIp")
    @g::ipv4_view("physical_link__zNeIp_ipv4")
    source_zNeIp: String,
    @m::column("aPortAlias")
    @g::search("physical_link__aPortAlias")
    source_aPortAlias: String,
    @m::column("aPortName")
    @g::search("physical_link__aPortName")
    source_aPortName: String,
    @m::column("aPortDn")
    @g::exact("physical_link__aPortDn")
    source_aPortDn: String,
};

def subject: r::Endpoint = domain::endpoint(EnterprisePhysicalLink.type, "id");
def tenant: r::Endpoint = domain::endpoint(EnterprisePhysicalLink.type, "tenant_id");
def a_device: r::Endpoint = domain::endpoint(EnterprisePhysicalLink.type, "a_device");
def z_device: r::Endpoint = domain::endpoint(EnterprisePhysicalLink.type, "z_device");
def a_server: r::Endpoint = domain::endpoint(EnterprisePhysicalLink.type, "a_server");
def z_server: r::Endpoint = domain::endpoint(EnterprisePhysicalLink.type, "z_server");
@knowledge_policy::reverse_references(True)
type PhysicalLinkType = enum {
    @ev::itag(99)
    @ev::description("ManuallyCreate", "手动创建")
    Manual,
    @ev::itag(1)
    Lldp,
    @ev::itag(2)
    Sbs,
    @ev::itag(3)
    Mac,
    @ev::itag(4)
    Cdp,
    @ev::itag(5)
    Ip,
    @ev::itag(6)
    EthTrunk,
    @ev::itag(7)
    Csp,
    @ev::itag(8)
    @ev::description("ServerInternal", "服务器内部发现")
    ServerInternal,
    @ev::itag(9)
    @ev::description("Search", "纤缆搜索")
    FiberSearch,
    @ev::itag(10)
    Fc,
    @ev::itag(11)
    @ev::description("PlanImport", "规划导入")
    PlanImport,
    @ev::itag(12)
    @ev::description("AID", "空口发现")
    Aid,
    @ev::itag(13)
    Omci,
    @ev::itag(100)
    @ev::description("DcnNorth", "北向导入")
    DcnNorth,
};
def PhysicalLinkType_domain: v::Domain(PhysicalLinkType, Int) = v::from_enum(
    "PhysicalLinkType",
    PhysicalLinkType.type,
    Int.type,
    False
);
@knowledge_policy::reverse_references(True)
type PhysicalLinkDirection = enum {
    @ev::rename("bidirectional")
    @ev::description("Bidirectional", "双向")
    Bidirectional,
    @ev::rename("unidirectional")
    @ev::description("Unidirectional", "单向")
    Unidirectional,
};
def PhysicalLinkDirection_domain: v::Domain(PhysicalLinkDirection, String) = v::from_enum(
    "PhysicalLinkDirection",
    PhysicalLinkDirection.type,
    String.type,
    False
);
@knowledge_policy::reverse_references(True)
type PhysicalLinkStatus = enum {
    @ev::itag(2)
    @ev::itag(3)
    @ev::description("FAULT", "故障")
    Fault,
    @ev::itag(0)
    @ev::description("NORMAL", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("UNKNOWN", "未知")
    Unknown,
    @ev::itag(4)
    @ev::description("OFFLINE", "离线")
    Offline,
    @ev::itag(5)
    @ev::description("UNMANAGE", "未管理")
    Unmanage,
};
def PhysicalLinkStatus_domain: v::Domain(PhysicalLinkStatus, Int) = v::from_enum(
    "PhysicalLinkStatus",
    PhysicalLinkStatus.type,
    Int.type,
    False
);

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def many_many: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Many0
};
def a: r::Relation = r::relation("physical_link_a_device", a_device, i::device_subject, cardinality);
def z: r::Relation = r::relation("physical_link_z_device", z_device, i::device_subject, cardinality);
def relations: Array(r::Relation) = [
    a,
    z,
    r::relation("physical_link_belongs_to_tenant", tenant, i::tenant_subject, cardinality)
];
def alternatives: Array(domain::Alternative) = [
    {id: "physical_link_attached_device", choices: [a, z], cardinality: many_many},
    {
        id: "physical_link_attached_server",
        choices: [
            r::relation("link_a_server", a_server, server::subject, cardinality),
            r::relation("link_z_server", z_server, server::subject, cardinality)
        ],
        cardinality: many_many
    },
];
def links: Array(r::Link) = [
    r::guarded_link(
        r::link("physical_link_peer_device", a, z, edsl::LinkDirection::Undirected),
        m::field(EnterprisePhysicalLink.type, String.type, "direction"),
        edsl::FilterOp::Eq,
        "bidirectional"
    ),
    r::guarded_link(
        r::link("physical_link_downstream_device", a, z, edsl::LinkDirection::Directed),
        m::field(EnterprisePhysicalLink.type, String.type, "direction"),
        edsl::FilterOp::Eq,
        "unidirectional"
    ),
];
pub use self::{EnterprisePhysicalLink, relations, alternatives, links};

pub use self::{PhysicalLinkById};
