# PON 样本的公共量类型与统计模板，不准备模型或知识。
use ontology::experimental::samples as samples;
type Percent = struct(Float);
type Dbm = struct(Float);
type DegreesCelsius = struct(Float);
type BitsPerSecond = struct(Float);
def Percent_statistics: samples::Group(Percent) = samples::group("onu_Percent", Percent.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%"));
def Dbm_statistics: samples::Group(Dbm) = samples::group("onu_Dbm", Dbm.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("dBm"));
def DegreesCelsius_statistics: samples::Group(DegreesCelsius) = samples::group("onu_DegreesCelsius", DegreesCelsius.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("degC"));
def BitsPerSecond_statistics: samples::Group(BitsPerSecond) = samples::group("onu_BitsPerSecond", BitsPerSecond.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("bit/s"));
pub use self::{Percent, Dbm, DegreesCelsius, BitsPerSecond, Percent_statistics, Dbm_statistics, DegreesCelsius_statistics, BitsPerSecond_statistics};
