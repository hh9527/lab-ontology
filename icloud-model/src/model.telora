    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({ from: "res_id", to: "id" }),
        edsl::RelationKey::FieldEq({ from: "tenant_id", to: "tenant_id" }),
    ]))
@edsl::named_relation_key("device_current_alarm", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({ from: "res_id", to: "id" }),
        edsl::RelationKey::FieldEq({ from: "tenant_id", to: "tenant_id" }),
    ]))
type CurrentAlarm = struct {
    @edsl::column("CSN")
    @edsl::key(yes)
    @edsl::dimension("alarm_csn", yes, yes, int_ops, int_inputs)
    @edsl::measure("alarm_count", qb::AggregateFunction::Count, none_required)
    @edsl::filtered_measure("critical_alarm_count", qb::AggregateFunction::Count, none_required, critical_alarm_predicate)
    @edsl::filtered_measure("major_alarm_count", qb::AggregateFunction::Count, none_required, major_alarm_predicate)
    @edsl::computed_measure("critical_or_major_alarm_count", qb::ComputedOp::Add, "critical_alarm_count", "major_alarm_count")
    @edsl::computed_measure("weighted_severe_alarm_score", qb::ComputedOp::Add, "critical_or_major_alarm_count", "critical_alarm_count")
    @edsl::measure_description("critical_alarm_count", "Critical alarm count", "Counts only alarm events whose declared severity is critical")
    @edsl::measure_description("major_alarm_count", "Major alarm count", "Counts only alarm events whose declared severity is major")
    @edsl::measure_description("critical_or_major_alarm_count", "Critical or major alarm count", "Sum of the mutually exclusive critical and major event populations")
    @edsl::measure_description("weighted_severe_alarm_score", "Weighted severe alarm score", "Weights critical events twice and major events once; this score is not an alarm count")
    @edsl::measure_description("alarm_count", "Alarm count", "Count of alarm events at the declared event grain")
    csn: Int,
    @edsl::column("OCCURUTC")
    @edsl::time_field(utc_role, utc_seconds)
    @edsl::dimension("alarm_occur_utc_raw", yes, yes, utc_window_ops, text_inputs)
    occur_utc: String,
    @edsl::column("ARRIVEUTC")
    @edsl::time_field(utc_role, utc_seconds)
    arrive_utc: String,
    @edsl::column("OCCUR_TIME")
    @edsl::time_field(local_role, local_text)
    occur_time: String,
    @edsl::column("MEDN")
    res_id: String,
    @edsl::column("STREXT13")
    strext13: String,
    @edsl::column("ALARMNAME")
    @edsl::dimension("alarm_name", yes, yes, text_ops, text_inputs)
    alarm_name: String,
    @edsl::column("SEVERITY")
    @edsl::dimension("alarm_severity", yes, yes, canonical_eq_ne_ops, text_inputs)
    @edsl::canonical_values(alarm_severity_values)
    @edsl::canonical_order(["critical", "major", "minor", "warning"])
    severity: String,
    @edsl::column("CLEARED")
    @edsl::dimension("alarm_cleared", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(alarm_cleared_values)
    cleared: Int,
    @edsl::column("CHANGEFLAG")
    @edsl::dimension("alarm_change_flag", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(alarm_change_values)
    change_flag: Int,
    @edsl::column("TENANTID")
    @edsl::dimension("alarm_tenant_id", yes, yes, text_ops, text_inputs)
    tenant_id: String,
};

# A/Z are physical positions; only links declared bidirectional support
# exchangeable peer traversal. Endpoint relations cover both link directions.
@edsl::entity_id("physical_link")
@edsl::entity_source("EnterprisePhysicalLink", "pl")
@edsl::native_pair("link_ne_names", "physical_link_a_ne_name", "physical_link_z_ne_name")
@edsl::guarded_business_link("physical_link_peer_device", "physical_link_a_device", "physical_link_z_device", edsl::LinkDirection::Undirected,
    {field: "direction", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("bidirectional")})
@edsl::guarded_business_link("physical_link_downstream_device", "physical_link_a_device", "physical_link_z_device", edsl::LinkDirection::Directed,
    {field: "direction", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("unidirectional")})
@edsl::dataset_description("Physical link", "Physical connection with fixed A and Z device endpoints")
@edsl::relation_description("physical_link_a_device", "A-end device", "Origin endpoint of the physical link")
@edsl::relation_description("physical_link_z_device", "Z-end device", "Peer endpoint of the physical link")
@edsl::relation_description("physical_link_attached_device", "Attached device", "Undirected physical-link participation through either complete A or Z device identity")
@edsl::relation_description("physical_link_attached_server", "Attached server", "Physical-link A or Z endpoint references the complete server identity")
@edsl::relation_description("physical_link_belongs_to_tenant", "Belongs to tenant", "Physical link tenant ownership")
@edsl::named_relation_key("physical_link_attached_server", ServerDevice.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::Or([
        edsl::RelationKey::And([
            edsl::RelationKey::FieldEq({from: "a_ne_res_id", to: "id"}),
            edsl::RelationKey::FieldEq({from: "tenant_id", to: "tenant_id"}),
        ]),
        edsl::RelationKey::And([
            edsl::RelationKey::FieldEq({from: "z_ne_res_id", to: "id"}),
            edsl::RelationKey::FieldEq({from: "tenant_id", to: "tenant_id"}),
        ]),
    ]))
@edsl::named_relation_key("physical_link_attached_device", Device.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::Or([
        edsl::RelationKey::And([
            edsl::RelationKey::FieldEq({from: "a_ne_res_id", to: "id"}),
            edsl::RelationKey::FieldEq({from: "tenant_id", to: "tenant_id"}),
        ]),
        edsl::RelationKey::And([
            edsl::RelationKey::FieldEq({from: "z_ne_res_id", to: "id"}),
            edsl::RelationKey::FieldEq({from: "tenant_id", to: "tenant_id"}),
        ]),
    ]))
@edsl::named_typed_relation_key("physical_link_belongs_to_tenant", PhysicalLink.type, Tenant.type,
    edsl::RelationKind::Safe, [edsl::typed_relation_pair(
        edsl::model_field(PhysicalLink.type, String.type, "tenant_id"),
        edsl::model_field(Tenant.type, String.type, "id"))])
@edsl::named_typed_relation_key("physical_link_a_device", PhysicalLink.type, Device.type, edsl::RelationKind::Safe, [
        edsl::typed_relation_pair(
            edsl::model_field(PhysicalLink.type, String.type, "a_ne_res_id"),
            edsl::model_field(Device.type, String.type, "id")),
        edsl::typed_relation_pair(
            edsl::model_field(PhysicalLink.type, String.type, "tenant_id"),
            edsl::model_field(Device.type, String.type, "tenant_id")),
    ])
@edsl::named_typed_relation_key("physical_link_z_device", PhysicalLink.type, Device.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(
        edsl::model_field(PhysicalLink.type, String.type, "z_ne_res_id"),
        edsl::model_field(Device.type, String.type, "id")),
    edsl::typed_relation_pair(
        edsl::model_field(PhysicalLink.type, String.type, "tenant_id"),
        edsl::model_field(Device.type, String.type, "tenant_id")),
    ])
type PhysicalLink = struct {
    @edsl::column("aNeResId")
    a_ne_res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("aNeName")
    @edsl::dimension("physical_link_a_ne_name", yes, yes, text_ops, text_inputs)
    a_ne_name: String,
    @edsl::column("zNeName")
    @edsl::dimension("physical_link_z_ne_name", yes, yes, text_ops, text_inputs)
    z_ne_name: String,
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::dimension("physical_link_id", yes, yes, text_ops, text_inputs)
    @edsl::measure("physical_link_count", qb::AggregateFunction::Count, none_required)
    id: String,
    @edsl::column("name")
    @edsl::dimension("physical_link_name", yes, yes, text_ops, text_inputs)
    name: String,
    @edsl::column("linkType")
