# 服务器采样独立声明，Latest 采用权威UTC时钟与完整采样grain
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
type Percent = struct(
    Float
);
type Watts = struct(
    Float
);
# averagePower 未在当前公共契约声明单位，保留来源值而不隐式换算
type ReportedAveragePower = struct(
    Float
);
type Row = struct {
    res_id: server::ServerId,
    tenant_id: i::TenantId,
    ts: s::DateTimeUtc,
    mem_usage: Percent,
    cpu_usage: Percent,
    average_power: ReportedAveragePower,
    source_parentId: String,
    source_projectId: String,
    source_systemPower: Watts,
    source_peakPower: Watts,
    source_cpuUsageEffcnt: Int,
    source_memUsageEffcnt: Int,
    source_systemPowerEffcnt: Int,
    source_averagePowerEffcnt: Int,
    source_peakPowerEffcnt: Int,
};
def dataset: m::Dataset(Row) = m::dataset(
    "server_kpi",
    "ServerDeviceKPI",
    Row.type,
    ["res_id", "tenant_id", "ts"]
);
def owner: m::Role(Row) = m::role(
    dataset,
    server::entity,
    "server",
    False,
    [
        m::identity_part(
            m::field(Row.type, server::ServerId.type, "res_id"),
            m::field(server::Identity.type, server::ServerId.type, "id")
        )
    ]
);
def statistics: samples::Group(Percent) = samples::group(
    "server_percent",
    Percent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Latest, samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
def declaration: t::Declaration = t::with_samples(
    t::metric(
        t::map_columns(
            t::declare(
                dataset,
                [owner],
                [
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_kpi_ts_raw",
                            s::DateTimeUtc.type,
                            True,
                            [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
                        ),
                        g::input(m::field(Row.type, s::DateTimeUtc.type, "ts")),
                        "server_kpi_ts_raw",
                        True,
                        [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_memory_sample",
                            Percent.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Percent.type, "mem_usage")),
                        "server_memory_sample",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_cpu_sample",
                            Percent.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Percent.type, "cpu_usage")),
                        "server_cpu_sample",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_average_power_sample",
                            ReportedAveragePower.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, ReportedAveragePower.type, "average_power")),
                        "server_average_power_sample",
                        True,
                        g::numeric_filters
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_parentId"),
                        "server_kpi__parentId"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_projectId"),
                        "server_kpi__projectId"
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_kpi__systemPower",
                            Watts.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Watts.type, "source_systemPower")),
                        "server_kpi__systemPower",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_kpi__peakPower",
                            Watts.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Watts.type, "source_peakPower")),
                        "server_kpi__peakPower",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_kpi__cpuUsageEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_cpuUsageEffcnt")),
                        "server_kpi__cpuUsageEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_kpi__memUsageEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_memUsageEffcnt")),
                        "server_kpi__memUsageEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_kpi__systemPowerEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_systemPowerEffcnt")),
                        "server_kpi__systemPowerEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_kpi__averagePowerEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_averagePowerEffcnt")),
                        "server_kpi__averagePowerEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "server_kpi__peakPowerEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_peakPowerEffcnt")),
                        "server_kpi__peakPowerEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "utc_bucket",
                            s::DateTimeUtc.type,
                            True,
                            [
                                g::Filter::Eq,
                                g::Filter::Ne,
                                g::Filter::Lt,
                                g::Filter::Le,
                                g::Filter::Gt,
                                g::Filter::Ge
                            ]
                        ),
                        g::utc_bucket(
                            g::input(m::field(Row.type, s::DateTimeUtc.type, "ts")),
                            qb::UtcBucketUnit::Hour
                        ),
                        "server_kpi_utc_hour",
                        True,
                        [
                            g::Filter::Eq,
                            g::Filter::Ne,
                            g::Filter::Lt,
                            g::Filter::Le,
                            g::Filter::Gt,
                            g::Filter::Ge
                        ]
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "utc_bucket",
                            s::DateTimeUtc.type,
                            True,
                            [
                                g::Filter::Eq,
                                g::Filter::Ne,
                                g::Filter::Lt,
                                g::Filter::Le,
                                g::Filter::Gt,
                                g::Filter::Ge
                            ]
                        ),
                        g::utc_bucket(
                            g::input(m::field(Row.type, s::DateTimeUtc.type, "ts")),
                            qb::UtcBucketUnit::Day
                        ),
                        "server_kpi_utc_day",
                        True,
                        [
                            g::Filter::Eq,
                            g::Filter::Ne,
                            g::Filter::Lt,
                            g::Filter::Le,
                            g::Filter::Gt,
                            g::Filter::Ge
                        ]
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "utc_bucket",
                            s::DateTimeUtc.type,
                            True,
                            [
                                g::Filter::Eq,
                                g::Filter::Ne,
                                g::Filter::Lt,
                                g::Filter::Le,
                                g::Filter::Gt,
                                g::Filter::Ge
                            ]
                        ),
                        g::utc_bucket(
                            g::input(m::field(Row.type, s::DateTimeUtc.type, "ts")),
                            qb::UtcBucketUnit::Month
                        ),
                        "server_kpi_utc_month",
                        True,
                        [
                            g::Filter::Eq,
                            g::Filter::Ne,
                            g::Filter::Lt,
                            g::Filter::Le,
                            g::Filter::Gt,
                            g::Filter::Ge
                        ]
                    ),
                ],
                []
            ),
            [
                t::column(m::field(Row.type, server::ServerId.type, "res_id"), "resId"),
                t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
                t::column(m::field(Row.type, s::DateTimeUtc.type, "ts"), "ts"),
                t::column(m::field(Row.type, Percent.type, "mem_usage"), "memUsage"),
                t::column(m::field(Row.type, Percent.type, "cpu_usage"), "cpuUsage"),
                t::column(
                    m::field(Row.type, ReportedAveragePower.type, "average_power"),
                    "averagePower"
                ),
                t::column(m::field(Row.type, String.type, "source_parentId"), "parentId"),
                t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
                t::column(m::field(Row.type, Watts.type, "source_systemPower"), "systemPower"),
                t::column(m::field(Row.type, Watts.type, "source_peakPower"), "peakPower"),
                t::column(m::field(Row.type, Int.type, "source_cpuUsageEffcnt"), "cpuUsageEffcnt"),
                t::column(m::field(Row.type, Int.type, "source_memUsageEffcnt"), "memUsageEffcnt"),
                t::column(
                    m::field(Row.type, Int.type, "source_systemPowerEffcnt"),
                    "systemPowerEffcnt"
                ),
                t::column(
                    m::field(Row.type, Int.type, "source_averagePowerEffcnt"),
                    "averagePowerEffcnt"
                ),
                t::column(m::field(Row.type, Int.type, "source_peakPowerEffcnt"), "peakPowerEffcnt"),
            ]
        ),
        m::field(Row.type, s::DateTimeUtc.type, "ts")
    ),
    [
        samples::bind(
            dataset,
            statistics,
            m::field(Row.type, Percent.type, "mem_usage"),
            [
                {statistic: samples::Statistic::Mean, publish: "server_memory_usage"},
                {statistic: samples::Statistic::Latest, publish: "server_memory_latest"},
                {statistic: samples::Statistic::Max, publish: "server_memory_sample_max"},
                {statistic: samples::Statistic::Min, publish: "server_memory_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            statistics,
            m::field(Row.type, Percent.type, "cpu_usage"),
            [
                {statistic: samples::Statistic::Mean, publish: "server_cpu_usage"},
                {statistic: samples::Statistic::Latest, publish: "server_cpu_latest"},
                {statistic: samples::Statistic::Max, publish: "server_cpu_peak"},
                {statistic: samples::Statistic::Min, publish: "server_cpu_sample_min"}
            ]
        ),
    ]
);
def relations: Array(r::Relation) = [
    r::relation(
        "server_kpi_of_server",
        dataset,
        owner,
        server::dataset,
        server::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_ServerDeviceKPI",
        server::dataset,
        server::subject,
        dataset,
        owner,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{declaration, relations};
