# Complete typed identities and semantic roles share the prepared declaration.
use crate::semantic as s;
use crate::preparation as preparation;
use crate::transform as transform;
use crate::ontology as edsl;
use crate::knowledge as k;
use std::array;
use std::test;

@s::entity_by("Item")
type Identity = struct {
    tenant: String,
    local: String
};
@s::dataset("objects", "objects", ["tenant", "local"])
@s::role("scoped", Identity.type, {tenant: "tenant", local: "local"})
@edsl::reference("scoped", ["tenant", "local"])
type Row = struct {
    tenant: String,
    local: String,
    @edsl::field_role(edsl::FieldRole::Appellation)
    name: String,
    @edsl::field_role(edsl::FieldRole::Appellation)
    @edsl::field_role(edsl::FieldRole::Classification)
    category: String,
    @edsl::field_role(edsl::FieldRole::Metric)
    amount: Float,
    unclassified_number: Int
};
def local: transform::LocalDefinition = preparation::local_definition(
    preparation::mapping("objects", Row.type)
);
def roles: Fn(String) -> Array(edsl::FieldRole) = fn(name) {
    let entity = local.payload.entities[0];
    let field = match array::find(
        entity.fields,
        fn(field) {
            field.name == name
        }
    ) {
        Some(field) => field,
        None => fail!("missing field")
    };
    k::field_business_roles(local.declaration, entity, field, entity.references)
};
def verify: Fn(Fn() -> Bool) -> test::Test = fn(check) {
    test::should_ok(
        fn() {
            if check() {
                ()
            } else {
                fail!("role assertion failed")
            }
        }
    )
};
pub def appellation_does_not_promise_identity: test::Test = verify(
    fn() {
        roles("name") == [edsl::FieldRole::Appellation]
    }
);
pub def roles_can_overlap: test::Test = verify(
    fn() {
        roles("category") == [edsl::FieldRole::Appellation, edsl::FieldRole::Classification]
    }
);
pub def reference_keeps_all_parts: test::Test = verify(
    fn() {
        let refs = local.payload.entities[0].references;
        array::any(
            refs,
            fn(r) {
                r.id == "scoped" && r.fields == ["tenant", "local"]
            }
        ) && roles("tenant") == [edsl::FieldRole::Reference] && roles("local") == [
            edsl::FieldRole::Reference
        ]
    }
);
pub def numeric_storage_does_not_imply_metric: test::Test = verify(
    fn() {
        roles("amount") == [edsl::FieldRole::Metric] && roles("unclassified_number") == []
    }
);
