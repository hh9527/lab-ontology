    cpu_usage: Option(metric::KpiServerDeviceCpuUsage),
    @m::column("MEMUSAGE")
    @g::field_view(g::dimension_group("kpi-server-device/mem_usage", metric::KpiServerDeviceMemUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sede_mem_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
