export def first_token_lowerings_to_guarded_substr = do {
    let q = qb.transform_sqlite(first_token_plan());
    q.sql == expected_first_token_sql && q.bindings == expected_first_token_bindings
};

export def first_token_dynamic_values_stay_in_bindings = do {
    # The separator, guard and offsets are all `?` placeholders: no literal
    # space, 0 or 1 is embedded in the SQL text.
    let q = qb.transform_sqlite(first_token_plan());
    !string.contains(q.sql, "' '")
        && !string.contains(q.sql, " 1")
        && !string.contains(q.sql, " 0")
};

export def first_token_else_returns_original_value = do {
    # No delimiter, empty input and NULL input all select the ELSE branch,
    # which returns the original column value.
    let q = qb.transform_sqlite(first_token_plan());
    string.contains(q.sql, "ELSE c.command")
};

export def first_token_segment_excludes_delimiter = do {
    let q = qb.transform_sqlite(first_token_plan());
    string.contains(q.sql, "substr(c.command, ?, (instr(c.command, ?) - ?))")
};

export def first_token_guards_with_instr_gt_zero = do {
    let q = qb.transform_sqlite(first_token_plan());
    string.contains(q.sql, "instr(c.command, ?) > ?")
};

export def first_token_usable_in_projection_grouping_ordering = do {
    let projected = qb.transform_sqlite(first_token_plan());
    let ordered = qb.transform_sqlite(first_token_ordering_plan());
    string.contains(projected.sql, "CASE WHEN instr(c.command, ?)")
        && string.contains(projected.sql, "GROUP BY CASE WHEN")
        && string.contains(ordered.sql, "ORDER BY CASE WHEN instr(c.command, ?)")
};

export def first_token_placeholders_match_bindings = do {
    let q = qb.transform_sqlite(first_token_plan());
    (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
};

export def first_token_profile_accepts = do {
    qb.profile_accepts(first_token_plan(), full_profile())
};

export def first_token_profile_rejects_without_scalars = do {
    # `restricted_profile` allows only `Substr`, so Instr/If/Sub/Gt are rejected.
    !qb.profile_accepts(first_token_plan(), restricted_profile())
};

export def first_token_rejects_bad_instr_arity = do {
    !qb.structure_ok(bad_instr_arity_plan())
};

export def first_token_rejects_bad_if_arity = do {
    !qb.structure_ok(bad_if_arity_plan())
};

export def first_token_rejects_bad_sub_arity = do {
    !qb.structure_ok(bad_sub_arity_plan())
};

# ---------------------------------------------------------------------------
# Safe pagination: non-negative offset with mandatory stable ordering.
# ---------------------------------------------------------------------------

def paged_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-paged",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "id"))],
        filter: 'Some(qb.scalar('Gt, [qb.column("o", "total"), qb.bind_float(50.0)])),
        joins: [],
        grouping: [],
