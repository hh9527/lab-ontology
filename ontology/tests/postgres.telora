use std::string as string;
use std::test as test;
use crate::query as qb;
use crate::postgres as pg;
use crate::sqlite as sqlite;

pub def aliases_and_bindings_materialize_in_both_dialects: test::Test = test::should_ok(fn() {
    let first = qb::source_with_hint(qb::build_context(), "teams", "t");
    let second = qb::source_with_hint(first.0, "members", "t");
    let bound = qb::bind(second.0, qb::Val::Int(7));
    let plan: qb::Plan = {
        revision: "constructed", sources: [first.1],
        joins: [qb::join(qb::JoinKind::Inner, second.1,
            qb::source_column_ref(first.1, "id"), qb::source_column_ref(second.1, "team_id"))],
        projection: [qb::expr_item(qb::source_column(second.1, "name"))],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::source_column(second.1, "id"), bound.1])),
        grouping: [], having: [], ordering: [], limit: None, offset: None,
        exists: [], derived: None, partition: None, scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let ast = qb::QueryPlan::Rows(plan);
    let sqlite = sqlite::render_query_plan_with_context(ast, bound.0);
    let postgres = pg::render_query_plan_with_context(ast, bound.0);
    if first.1.alias == "t" && second.1.alias == "t_2"
        && string::contains(sqlite.sql, "members AS t_2 ON t.id = t_2.team_id")
        && string::contains(sqlite.sql, "t_2.id = ?1")
        && string::contains(postgres.sql, "\"members\" AS \"t_2\" ON \"t\".\"id\" = \"t_2\".\"team_id\"")
        && string::contains(postgres.sql, "\"t_2\".\"id\" = $1")
        && sqlite.bindings == [qb::Val::Int(7)] && postgres.bindings == sqlite.bindings { True }
    else { fail!("constructed AST must preserve aliases and bindings in both dialects", sqlite, postgres) }
});

pub def repeated_binding_uses_one_placeholder: test::Test = test::should_ok(fn() {
    let bound = qb::bind(qb::build_context(), qb::Val::Int(3));
    let expr = qb::scalar(qb::ScalarFunction::Eq, [bound.1, bound.1]);
    let postgres = pg::render_expr_with_context(expr, bound.0);
    if postgres.sql == "$1 = $1" && postgres.bindings == [qb::Val::Int(3)] { True }
    else { fail!("binding handle must survive repeated use", postgres) }
});
