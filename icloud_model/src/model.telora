@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "memory_usage"}, {kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_memory_sample_min"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "memory_usage"}, {kind: edsl::KnowledgeKind::Dimension, owner: "device_kpi", id: "device_memory_sample"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_online_rate_avg"}, {kind: edsl::KnowledgeKind::Dimension, owner: "device_kpi", id: "device_kpi__onlineRate"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_online_rate_avg"}, {kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_online_rate_min"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_online_rate_min"}, {kind: edsl::KnowledgeKind::Dimension, owner: "device_kpi", id: "device_kpi__onlineRate"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_online_rate_avg"}, {kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_online_rate_max"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_online_rate_max"}, {kind: edsl::KnowledgeKind::Dimension, owner: "device_kpi", id: "device_kpi__onlineRate"})
@edsl::related_to({kind: edsl::KnowledgeKind::Dimension, owner: "device_kpi", id: "device_kpi__ifUtilizationRate"}, {kind: edsl::KnowledgeKind::Dimension, owner: "interface_kpi", id: "interface_kpi__ifInBandRate"})
@edsl::related_to({kind: edsl::KnowledgeKind::Dimension, owner: "device_kpi", id: "device_kpi__ifUtilizationRate"}, {kind: edsl::KnowledgeKind::Dimension, owner: "pon_port_kpi", id: "pon_port_receive_sample"})
type DeviceKpi = struct {
    @edsl::column("resId")
    @edsl::key()
    @edsl::dimension("device_kpi_res_id", True, True, text_ops, text_inputs)
    @edsl::measure("device_kpi_sample_count", qb::AggregateFunction::Count, [])
    @edsl::measure_description("device_kpi_sample_count", "Eligible KPI sample count", "Counts sample rows satisfying the intent's explicit sample predicate and time window")
    res_id: String,
    @edsl::column("tenantId")
    @edsl::dimension("device_kpi_tenant_id", True, True, text_ops, text_inputs)
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("device_kpi_ts_raw", True, True, utc_window_ops, datetime_utc_inputs)
    ts: String,
    @edsl::column("cpuUsage")
    @edsl::measure("cpu_usage", qb::AggregateFunction::Avg, [])
    @edsl::dimension("device_cpu_sample", True, True, int_ops, number_inputs)
    @edsl::dimension_description("device_cpu_sample", "Device CPU utilization sample", "One source-reported CPU sample in percent. Project with sample time for trends; filter before counting qualifying sample rows. Not a period average or peak.")
    @edsl::dimension_alias("device_cpu_sample", "设备CPU使用率采样值")
    @edsl::metric_value("cpu_usage", qb::AggregateFunction::Avg, Some("%"))
    @edsl::sample_aggregate("cpu_peak", qb::AggregateFunction::Max, Some("%"))
    @edsl::sample_aggregate("device_cpu_sample_min", qb::AggregateFunction::Min, Some("%"))
    @edsl::measure_description("cpu_usage", "Average device CPU utilization", "Arithmetic mean of eligible CPU samples in percent, not a peak or time-weighted mean. NULL is ignored; an all-NULL population has no value. Percentage samples are not declared additive.")
    @edsl::measure_description("cpu_peak", "Peak device CPU utilization sample", "Maximum eligible raw CPU sample in percent, not maximum of period averages; NULL is ignored.")
    @edsl::measure_description("device_cpu_sample_min", "Minimum device CPU utilization sample", "Minimum eligible raw CPU sample in percent; ignores NULL, unlike raw ascending Top-1.")
    @edsl::measure_alias("cpu_usage", "设备CPU平均使用率")
    @edsl::measure_alias("cpu_peak", "设备CPU使用率峰值")
    @edsl::measure_alias("device_cpu_sample_min", "设备CPU最低使用率")
    cpu_usage: Float,
    @edsl::column("memUsage")
    @edsl::measure("memory_usage", qb::AggregateFunction::Avg, [])
    @edsl::dimension("device_memory_sample", True, True, int_ops, number_inputs)
    @edsl::dimension_description("device_memory_sample", "Device memory utilization sample", "One source-reported memory sample in percent. Project with sample time for trends; filter before counting qualifying sample rows. Not a period average or peak.")
    @edsl::dimension_alias("device_memory_sample", "设备内存使用率采样值")
    @edsl::metric_value("memory_usage", qb::AggregateFunction::Avg, Some("%"))
    @edsl::sample_aggregate("memory_peak", qb::AggregateFunction::Max, Some("%"))
    @edsl::sample_aggregate("device_memory_sample_min", qb::AggregateFunction::Min, Some("%"))
    @edsl::measure_description("memory_usage", "Average device memory utilization", "Arithmetic mean of eligible memory samples in percent, not a peak or time-weighted mean. NULL is ignored; an all-NULL population has no value. Percentage samples are not declared additive.")
    @edsl::measure_description("memory_peak", "Peak device memory utilization sample", "Maximum eligible raw memory sample in percent, not maximum of period averages; NULL is ignored.")
    @edsl::measure_description("device_memory_sample_min", "Minimum device memory utilization sample", "Minimum eligible raw memory sample in percent; ignores NULL, unlike raw ascending Top-1.")
    @edsl::measure_alias("memory_usage", "设备内存平均使用率")
    @edsl::measure_alias("memory_peak", "设备内存使用率峰值")
    @edsl::measure_alias("device_memory_sample_min", "设备内存最低使用率")
    mem_usage: Float,
    @edsl::column("portCount")
    @edsl::dimension("port_count_sample", True, True, int_ops, int_inputs)
    @edsl::measure("port_count", qb::AggregateFunction::Sum, [])
    @edsl::measure_description("port_count", "Total port count", "Sum of declared device port-count samples")
    @edsl::metric_value("port_count", qb::AggregateFunction::Sum, None)
    @edsl::sample_aggregate("port_count_peak", qb::AggregateFunction::Max, None)
    @edsl::measure_description("port_count_peak", "Peak sample port count", "Maximum raw port count in the selected samples")
    @edsl::sample_aggregate("port_count_sample_avg", qb::AggregateFunction::Avg, None)
    @edsl::measure_description("port_count_sample_avg", "Average port-count sample", "Mean raw portCount per eligible KPI sample; distinct from the published Sum of port-count samples")
    port_count: Int,
    @edsl::column("portUsedCount")
    @edsl::dimension("used_port_sample", True, True, int_ops, int_inputs)
    @edsl::measure("used_port_count", qb::AggregateFunction::Sum, [])
    @edsl::metric_value("used_port_count", qb::AggregateFunction::Sum, None)
    @edsl::sample_aggregate("used_port_sample_avg", qb::AggregateFunction::Avg, None)
    @edsl::sample_aggregate("used_port_sample_max", qb::AggregateFunction::Max, None)
    @edsl::measure_description("used_port_sample_max", "Maximum used ports in a KPI sample", "Maximum raw used-port count in the eligible samples; distinct from the published Sum")
    port_used_count: Int,
    @edsl::column("operStatusCount")
    @edsl::dimension("running_port_sample", True, True, int_ops, int_inputs)
    @edsl::measure("running_port_count", qb::AggregateFunction::Sum, [])
    @edsl::metric_value("running_port_count", qb::AggregateFunction::Sum, None)
    @edsl::sample_aggregate("running_port_sample_avg", qb::AggregateFunction::Avg, None)
    oper_status_count: Int,
    @edsl::column("adminStatusCount")
    @edsl::dimension("admin_port_sample", True, True, int_ops, int_inputs)
    admin_status_count: Int,
    @edsl::column("parentId")
    @edsl::dimension("device_kpi__parentId", True, True, text_ops, text_inputs)
    @edsl::dimension_description("device_kpi__parentId", "Parent Resource ID", "Parent resource ID.")
    source_parentId: String,
    @edsl::column("projectId")
    @edsl::dimension("device_kpi__projectId", True, True, text_ops, text_inputs)
    @edsl::dimension_description("device_kpi__projectId", "Project ID", "Project ID, which is required only in the OP scenario.")
    source_projectId: String,
    @edsl::column("deviceName")
    @edsl::dimension("device_kpi__deviceName", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("device_kpi__deviceName", "Device Name", "Device name. Raw text search, not semantic ordering or identifier normalization.")
    source_deviceName: String,
    @edsl::column("classification")
    @edsl::dimension("device_kpi__classification", True, True, text_ops, text_inputs)
    @edsl::dimension_description("device_kpi__classification", "Device Type", "Device type.")
    source_classification: String,
    @edsl::column("onlineRate")
    @edsl::dimension("device_kpi__onlineRate", True, True, int_ops, number_inputs)
    @edsl::dimension_description("device_kpi__onlineRate", "Device Online Rate", "Device online rate.")
    @edsl::dimension_alias("device_kpi__onlineRate", "设备在线率采样值")
    @edsl::measure("device_online_rate_avg", qb::AggregateFunction::Avg, [])
    @edsl::metric_value("device_online_rate_avg", qb::AggregateFunction::Avg, None)
    @edsl::sample_aggregate("device_online_rate_min", qb::AggregateFunction::Min, None)
    @edsl::measure_description("device_online_rate_min", "Minimum reported online-rate sample (NetworkDeviceKPI)", "Minimum eligible stored onlineRate sample from NetworkDeviceKPI in its source scale; ignores NULL and an all-NULL population has no value. Not a minimum of period averages or proof of continuous availability or SLA compliance. Missing observations are not covered. No rescaling, time weighting, onlineRateEffcnt weighting or inferred validity filtering.")
    @edsl::measure_alias("device_online_rate_min", "设备在线率最低采样值")
    @edsl::sample_aggregate("device_online_rate_max", qb::AggregateFunction::Max, None)
    @edsl::measure_description("device_online_rate_max", "Maximum reported device online-rate sample", "Maximum eligible stored onlineRate sample in its source scale; ignores NULL and an all-NULL population has no value. Not a maximum of period averages or evidence of continuous availability. No rescaling, time weighting or onlineRateEffcnt weighting.")
    @edsl::measure_alias("device_online_rate_max", "设备在线率最大采样值")
    @edsl::measure_description("device_online_rate_avg", "Average reported device online rate", "Arithmetic mean of eligible stored onlineRate samples in their source scale; NULL is ignored and an all-NULL population has no value. Not a time-weighted online rate or weighted by onlineRateEffcnt. Source does not establish numeric scale, numerator or denominator; do not rescale or infer a formula.")
    @edsl::measure_alias("device_online_rate_avg", "设备平均在线率")
    source_onlineRate: Float,
    @edsl::column("ifUtilizationRate")
    @edsl::dimension("device_kpi__ifUtilizationRate", True, True, int_ops, number_inputs)
    @edsl::dimension_description("device_kpi__ifUtilizationRate", "Device-level port usage sample (source reported)", "Device-level port usage, described by the source as percentage of all online ports on a device. The source does not define numerator, denominator or numeric scale; do not infer used/total or online/total from sibling counters. Not interface or PON-port bandwidth utilization. Preserve the reported value without rescaling.")
    @edsl::dimension_alias("device_kpi__ifUtilizationRate", "设备级端口占比")
    @edsl::dimension_alias("device_kpi__ifUtilizationRate", "端口利用率")
    @edsl::measure("device_port_usage_avg", qb::AggregateFunction::Avg, [])
    @edsl::metric_value("device_port_usage_avg", qb::AggregateFunction::Avg, None)
    @edsl::sample_aggregate("device_port_usage_max", qb::AggregateFunction::Max, None)
    @edsl::sample_aggregate("device_port_usage_min", qb::AggregateFunction::Min, None)
    @edsl::measure_description("device_port_usage_avg", "Average reported device port usage", "Arithmetic mean of eligible ifUtilizationRate samples in their source scale. Does not establish a port-count formula, time-weighted ratio or bandwidth statistic; NULL is ignored.")
    @edsl::measure_description("device_port_usage_max", "Maximum reported device port usage sample", "Maximum eligible ifUtilizationRate sample in its source scale. Device-level port usage, not bandwidth; NULL is ignored.")
    @edsl::measure_description("device_port_usage_min", "Minimum reported device port usage sample", "Minimum eligible ifUtilizationRate sample in its source scale. Device-level port usage, not bandwidth; NULL is ignored, unlike raw ascending Top-1.")
    source_ifUtilizationRate: Float,
    @edsl::column("cpuUsageEffcnt")
    @edsl::dimension("device_kpi__cpuUsageEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("device_kpi__cpuUsageEffcnt", "Valid CPU Usage Count", "Number of times that valid CPU usage statistics are collected.")
    source_cpuUsageEffcnt: Int,
    @edsl::column("memUsageEffcnt")
    @edsl::dimension("device_kpi__memUsageEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("device_kpi__memUsageEffcnt", "Valid Memory Usage Count", "Number of times that valid memory usage statistics are collected.")
    source_memUsageEffcnt: Int,
    @edsl::column("onlineRateEffcnt")
    @edsl::dimension("device_kpi__onlineRateEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("device_kpi__onlineRateEffcnt", "Valid Device Online Rate Count", "Number of times that valid statistics on the device online rate are collected.")
    source_onlineRateEffcnt: Int,
    @edsl::column("ifUtilizationRateEffcnt")
    @edsl::dimension("device_kpi__ifUtilizationRateEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("device_kpi__ifUtilizationRateEffcnt", "Valid Port Usage Count", "Number of times that valid port usage statistics are collected.")
    source_ifUtilizationRateEffcnt: Int,
    @edsl::column("portCountEffcnt")
    @edsl::dimension("device_kpi__portCountEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("device_kpi__portCountEffcnt", "Valid Count of Total Ports", "Number of times that valid statistics on the total number of ports are collected.")
    source_portCountEffcnt: Int,
    @edsl::column("portUsedCountEffcnt")
    @edsl::dimension("device_kpi__portUsedCountEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("device_kpi__portUsedCountEffcnt", "Valid Count of Occupied Ports", "Number of times that valid statistics on the number of occupied ports are collected.")
    source_portUsedCountEffcnt: Int,
    @edsl::column("operStatusCountEffcnt")
    @edsl::dimension("device_kpi__operStatusCountEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("device_kpi__operStatusCountEffcnt", "Valid Count of Running Ports", "Number of times that valid statistics on the number of running ports are collected.")
    source_operStatusCountEffcnt: Int,
    @edsl::column("adminStatusCountEffcnt")
    @edsl::dimension("device_kpi__adminStatusCountEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("device_kpi__adminStatusCountEffcnt", "Valid Administrative-State Port Count", "Number of times that valid statistics on the number of ports in the administrative state are collected.")
    source_adminStatusCountEffcnt: Int,
};

# Original server KPI relation declares resId = id.
@edsl::entity_id("server_kpi")
@edsl::entity_source("ServerDeviceKPI", "sk")
@edsl::dataset_description("Server KPI samples", "UTC samples of server memory usage")
@edsl::relation_description("server_kpi_of_server", "Samples for server", "Resource ID identifies the server sample owner")
@edsl::dataset(edsl::DatasetKind::Metric, kpi_grain, Some("ts"))
@edsl::named_relation_key("server_kpi_of_server", ServerDevice.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "res_id", to: "id"}))
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "server_kpi", id: "server_cpu_usage"}, {kind: edsl::KnowledgeKind::Measure, owner: "server_kpi", id: "server_cpu_peak"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "server_kpi", id: "server_cpu_usage"}, {kind: edsl::KnowledgeKind::Measure, owner: "server_kpi", id: "server_cpu_sample_min"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "server_kpi", id: "server_memory_usage"}, {kind: edsl::KnowledgeKind::Measure, owner: "server_kpi", id: "server_memory_sample_max"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "server_kpi", id: "server_memory_usage"}, {kind: edsl::KnowledgeKind::Measure, owner: "server_kpi", id: "server_memory_sample_min"})
type ServerKpi = struct {
    @edsl::column("resId")
    @edsl::key()
    res_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("server_kpi_ts_raw", True, True, utc_window_ops, datetime_utc_inputs)
    ts: String,
    @edsl::column("memUsage")
    @edsl::dimension("server_memory_sample", True, True, int_ops, number_inputs)
    @edsl::dimension_description("server_memory_sample", "Server memory utilization sample", "One source-reported server memory sample in percent; project with time for trends or filter before counting qualifying samples.")
    @edsl::measure("server_memory_usage", qb::AggregateFunction::Avg, [])
    @edsl::metric_value("server_memory_usage", qb::AggregateFunction::Avg, Some("%"))
    @edsl::sample_aggregate("server_memory_sample_max", qb::AggregateFunction::Max, Some("%"))
    @edsl::sample_aggregate("server_memory_sample_min", qb::AggregateFunction::Min, Some("%"))
    @edsl::measure_description("server_memory_usage", "Average server memory utilization", "Arithmetic mean of eligible memory samples in percent, not peak or time-weighted usage. NULL is ignored; percentage samples are not declared additive.")
    @edsl::measure_description("server_memory_sample_min", "Minimum server memory utilization sample", "Minimum eligible raw server memory sample in percent; ignores NULL, unlike raw ascending Top-1.")
    @edsl::measure_description("server_memory_sample_max", "Peak server memory utilization", "Maximum of eligible raw server memory KPI samples; not the maximum of daily or monthly averages")
    mem_usage: Float,
    @edsl::column("cpuUsage")
    @edsl::dimension("server_cpu_sample", True, True, int_ops, number_inputs)
    @edsl::dimension_description("server_cpu_sample", "Server CPU utilization sample", "One source-reported server CPU sample in percent; project with time for trends or filter before counting qualifying samples.")
    @edsl::measure("server_cpu_usage", qb::AggregateFunction::Avg, [])
    @edsl::metric_value("server_cpu_usage", qb::AggregateFunction::Avg, Some("%"))
    @edsl::sample_aggregate("server_cpu_peak", qb::AggregateFunction::Max, Some("%"))
    @edsl::sample_aggregate("server_cpu_sample_min", qb::AggregateFunction::Min, Some("%"))
    @edsl::measure_description("server_cpu_usage", "Average server CPU utilization", "Arithmetic mean of eligible CPU samples in percent, not peak or time-weighted usage. NULL is ignored; percentage samples are not declared additive.")
    @edsl::measure_description("server_cpu_peak", "Peak server CPU utilization sample", "Maximum eligible raw server CPU sample in percent, not maximum of period averages; NULL is ignored.")
    @edsl::measure_description("server_cpu_sample_min", "Minimum server CPU utilization sample", "Minimum eligible raw server CPU sample in percent; ignores NULL, unlike raw ascending Top-1.")
    cpu_usage: Float,
    @edsl::column("averagePower")
    @edsl::dimension("server_average_power_sample", True, True, int_ops, number_inputs)
    average_power: Float,
    @edsl::column("parentId")
    @edsl::dimension("server_kpi__parentId", True, True, text_ops, text_inputs)
    @edsl::dimension_description("server_kpi__parentId", "Parent ID", "Parent ID.")
    source_parentId: String,
    @edsl::column("projectId")
    @edsl::dimension("server_kpi__projectId", True, True, text_ops, text_inputs)
    @edsl::dimension_description("server_kpi__projectId", "Project ID", "Project ID.")
    source_projectId: String,
    @edsl::column("systemPower")
    @edsl::dimension("server_kpi__systemPower", True, True, int_ops, number_inputs)
    @edsl::dimension_description("server_kpi__systemPower", "Device Power", "Device power, in W.")
    source_systemPower: Float,
    @edsl::column("peakPower")
    @edsl::dimension("server_kpi__peakPower", True, True, int_ops, number_inputs)
    @edsl::dimension_description("server_kpi__peakPower", "Peak Power", "Peak power of a device, in W.")
    source_peakPower: Float,
    @edsl::column("cpuUsageEffcnt")
    @edsl::dimension("server_kpi__cpuUsageEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("server_kpi__cpuUsageEffcnt", "Valid Average CPU Usage Count", "Number of times that valid statistics on the average CPU usage are collected.")
    source_cpuUsageEffcnt: Int,
    @edsl::column("memUsageEffcnt")
    @edsl::dimension("server_kpi__memUsageEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("server_kpi__memUsageEffcnt", "Valid Average Memory Usage Count", "Number of times that valid statistics on the average memory usage are collected.")
    source_memUsageEffcnt: Int,
    @edsl::column("systemPowerEffcnt")
    @edsl::dimension("server_kpi__systemPowerEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("server_kpi__systemPowerEffcnt", "Valid Device Power Count", "Number of times that valid statistics on the device power are collected.")
    source_systemPowerEffcnt: Int,
    @edsl::column("averagePowerEffcnt")
    @edsl::dimension("server_kpi__averagePowerEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("server_kpi__averagePowerEffcnt", "Valid Average Power Count", "Number of times that valid statistics on the average power are collected.")
    source_averagePowerEffcnt: Int,
    @edsl::column("peakPowerEffcnt")
    @edsl::dimension("server_kpi__peakPowerEffcnt", True, True, int_ops, int_inputs)
    @edsl::dimension_description("server_kpi__peakPowerEffcnt", "Valid Peak Power Count", "Number of times that valid statistics on the peak power are collected.")
    source_peakPowerEffcnt: Int,
};

# ic's GovernanceCurrentAlarm is an EventSet, not an entity. This carrier
# declares the original physical link and the raw alarm-name event attribute.
@edsl::entity_id("current_alarm")
@edsl::entity_source("T_CURRENT_ALARM", "a")
@edsl::dataset_description("Current alarm", "One alarm event per serial number with UTC occurrence time")
@edsl::relation_description("device_current_alarm", "Alarm of device", "MEDN identifies the affected device")
@edsl::relation_description("server_current_alarm", "Alarm of server", "MEDN identifies the affected server")
@edsl::relation_description("alarm_belongs_to_tenant", "Belongs to tenant", "Matches an alarm tenant reference to an existing Tenant entity; raw non-null references may be orphaned")
@edsl::relation_description("alarm_site_reference", "Alarm site reference", "STREXT13 names a site except for system alarm marker 3")
@edsl::dataset(edsl::DatasetKind::Event, alarm_grain, Some("occur_utc"))
@edsl::named_guarded_relation_key("alarm_site_reference", Site.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "strext13", to: "site_id"}),
    {field: "strext13", op: edsl::FilterOp::Ne, input: edsl::FilterInput::Text("3")})
@edsl::named_relation_key("alarm_belongs_to_tenant", Tenant.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "tenant_id", to: "id"}))
@edsl::named_relation_key("server_current_alarm", ServerDevice.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "res_id", to: "id"}))
@edsl::named_relation_key("device_current_alarm", Device.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::FieldEq({from: "res_id", to: "id"}))
type CurrentAlarm = struct {
    @edsl::column("CSN")
    @edsl::key()
    @edsl::dimension("alarm_csn", True, True, int_ops, int_inputs)
    @edsl::measure("alarm_count", qb::AggregateFunction::Count, [])
    @edsl::filtered_measure("critical_alarm_count", qb::AggregateFunction::Count, [], critical_alarm_predicate)
    @edsl::filtered_measure("major_alarm_count", qb::AggregateFunction::Count, [], major_alarm_predicate)
    @edsl::computed_measure("critical_or_major_alarm_count", qb::ComputedOp::Add, "critical_alarm_count", "major_alarm_count")
    @edsl::computed_measure("weighted_severe_alarm_score", qb::ComputedOp::Add, "critical_or_major_alarm_count", "critical_alarm_count")
    @edsl::measure_description("critical_alarm_count", "Critical alarm count", "Counts only alarm events whose declared severity is critical")
    @edsl::measure_description("major_alarm_count", "Major alarm count", "Counts only alarm events whose declared severity is major")
    @edsl::measure_description("critical_or_major_alarm_count", "Critical or major alarm count", "Sum of the mutually exclusive critical and major event populations")
    @edsl::measure_description("weighted_severe_alarm_score", "Weighted severe alarm score", "Weights critical events twice and major events once; this score is not an alarm count")
    @edsl::measure_description("alarm_count", "Alarm count", "Count of alarm events at the declared event grain")
    csn: Int,
    @edsl::column("OCCURUTC")
    # TODO: Confirm OCCURUTC epoch unit; assume milliseconds consistently with ACKUTC and ARRIVEUTC metadata.
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("alarm_occur_utc_raw", True, True, int_ops, epoch_inputs)
    @edsl::dimension_description("alarm_occur_utc_raw", "Alarm occurrence UTC time", "Alarm occurrence UTC instant in Unix epoch milliseconds.")
    occur_utc: Int,
    @edsl::column("ARRIVEUTC")
    # TODO: Confirm ARRIVEUTC epoch representation; source specifies millisecond precision.
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::EpochMillis)
    arrive_utc: Int,
    @edsl::column("OCCURTIME")
    # TODO: Confirm OCCURTIME unit and whether it uses a special wall-clock encoding; provisionally use standard Unix epoch milliseconds.
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::EpochMillis)
    occur_time: Int,
    @edsl::column("MEDN")
    res_id: String,
    @edsl::column("STREXT13")
    strext13: String,
    @edsl::column("ALARMNAME")
    @edsl::dimension("alarm_name", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("alarm_name", "Alarm Name", "Name of an alarm, which briefly describes the fault symptom of the alarm. Raw text search, not semantic ordering or identifier normalization.")
    alarm_name: String,
    @edsl::column("SEVERITY")
    @edsl::dimension("alarm_severity", True, True, canonical_eq_ne_ops, text_inputs)
    @edsl::canonical_values(alarm_severity_values)
    @edsl::canonical_order(["critical", "major", "minor", "warning"])
    severity: Int,
    @edsl::column("CLEARED")
    @edsl::dimension("alarm_cleared", True, True, canonical_eq_ne_ops, text_inputs)
