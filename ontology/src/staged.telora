# 早期实验的兼容别名；默认 model/groups/transform API 提供相同的分阶段能力。
# 声明保留自检所需事实；运行期准备信任模型，输入校验由 intent 层执行。
use crate::model as m;
use crate::groups as g;
use crate::transform as t;
use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::codec as codec;
use std::value::{Value};
use crate::samples as samples;
use crate::values as v;
use crate::relations as r;
use crate::scalars as scalars;
use crate::quantity as q;

def entity: for(Identity) Fn(String, TypeOf(Identity)) -> m::Entity(Identity) = m::entity;
def dataset: for(Row) Fn(String, String, TypeOf(Row), Array(String)) -> m::Dataset(Row) = m::dataset;
def field: for(Owner, Value) Fn(TypeOf(Owner), TypeOf(Value), String) -> m::Field(Owner, Value) = m::field;
def identity_part: for(Row, Identity, Value) Fn(m::Field(Row, Value), m::Field(Identity, Value)) -> m::IdentityPart(Row, Identity) = m::identity_part;
def role: for(Row, Identity) Fn(m::Dataset(Row), m::Entity(Identity), String, Bool, Array(m::IdentityPart(Row, Identity))) -> m::Role(Row) = m::role;
def input: for(Row, Value) Fn(m::Field(Row, Value)) -> g::Expr(Row, Value) = g::input;
def dimension_group: for(Value) Fn(String, TypeOf(Value), Bool, Array(g::Filter)) -> g::DimensionGroup(Value) = g::dimension_group;
def dimension: for(Row, Value) Fn(m::Dataset(Row), g::DimensionGroup(Value), g::Expr(Row, Value), String, Bool, Array(g::Filter)) -> g::Binding(Row) = g::dimension;
def declare: for(Row) Fn(m::Dataset(Row), Array(m::Role(Row)), Array(g::Binding(Row)), Array(String)) -> t::Declaration = t::declare;
def prepare: Fn(String, Array(t::Declaration), qb::PlanProfile) -> t::Prepared = t::prepare_trusted;
# 不在声明或 Service 初始化时调用；与 transform 使用相同的 declarations。
def self_check: Fn(String, Array(t::Declaration), qb::PlanProfile) -> () = fn(revision, declarations, profile) {
    t::self_check(revision, declarations, [], [], [], profile);
    ()
};

def optional_field: for(Owner, Value) Fn(TypeOf(Owner), TypeOf(Value), String) -> m::Field(Owner, Value) = m::optional_field;
def reference_part: for(Row, Identity, Raw, Nominal) Fn(m::Field(Row, Raw), m::Field(Identity, Nominal)) -> m::IdentityPart(Row, Identity) = m::reference_part;

def seconds: for(Row) Fn(g::Expr(Row, q::Milliseconds)) -> g::Expr(Row, q::Seconds) = g::seconds;
def rate: for(Row) Fn(g::Expr(Row, q::Bytes), g::Expr(Row, q::Seconds)) -> g::Expr(Row, q::BytesPerSecond) = g::rate;
def ipv4: for(Row) Fn(g::Expr(Row, String)) -> g::Expr(Row, scalars::Ipv4) = g::ipv4;
def utc_bucket: for(Row, Time) Fn(g::Expr(Row, Time), qb::UtcBucketUnit) -> g::Expr(Row, Time) = g::utc_bucket;
def numeric_group: for(Value) Fn(String, TypeOf(Value), Array(g::Statistic)) -> g::NumericGroup(Value) = g::numeric_group;
def numeric_binding: for(Row, Value) Fn(m::Dataset(Row), g::NumericGroup(Value), g::Expr(Row, Value), Array(g::StatisticName)) -> g::Binding(Row) = g::numeric_binding;
def transfer_binding: for(Row) Fn(m::Dataset(Row), g::MeasureGroup, g::Expr(Row, q::Bytes), g::Expr(Row, q::Seconds), Array(g::Rename)) -> g::Binding(Row) = g::transfer_binding;
def identity_dimensions: for(Row) Fn(m::Dataset(Row), m::Role(Row), Array(g::IdentityName)) -> g::Binding(Row) = g::identity_dimensions;
def sample_group: for(Value) Fn(String, TypeOf(Value), samples::Statistic, Array(samples::Statistic), Option(String)) -> samples::Group(Value) = samples::group;
def sample_bind: for(Row, Value) Fn(m::Dataset(Row), samples::Group(Value), m::Field(Row, Value), Array(samples::Name)) -> samples::Binding(Row) = samples::bind;
def metric: for(Row, Time) Fn(t::Declaration, m::Field(Row, Time)) -> t::Declaration = t::metric;
def event: for(Row, Time) Fn(t::Declaration, m::Field(Row, Time)) -> t::Declaration = t::event;
def with_samples: for(Row) Fn(t::Declaration, Array(samples::Binding(Row))) -> t::Declaration = t::with_samples;
def column: for(Row, Value) Fn(m::Field(Row, Value), String) -> t::ColumnMapping(Row) = t::column;
def map_columns: for(Row) Fn(t::Declaration, Array(t::ColumnMapping(Row))) -> t::Declaration = t::map_columns;
# 编码是准备所需的计算；成员合法性、唯一性与映射契约留给自检。
def domain: for(Business: codec::Encode, Wire: codec::Encode) Fn(String, TypeOf(Business), TypeOf(Wire), Array(v::Member(Business, Wire)), Bool) -> v::Domain(Business, Wire) = v::domain;
def ordered: for(Business: codec::Encode, Wire) Fn(v::Domain(Business, Wire), Array(Business)) -> v::Domain(Business, Wire) = v::ordered;
def domain_group: for(Business, Wire) Fn(v::Domain(Business, Wire), Bool, Array(g::Filter)) -> v::DimensionGroup(Business, Wire) = v::dimension_group;
def domain_bind: for(Row, Business, Wire) Fn(m::Dataset(Row), v::DimensionGroup(Business, Wire), g::Expr(Row, Wire), String, Bool, Array(g::Filter)) -> v::Binding(Row) = v::bind;
def with_domains: for(Row) Fn(t::Declaration, Array(v::Binding(Row))) -> t::Declaration = t::with_domains;
def field_count: for(Row, Value) Fn(m::Dataset(Row), m::Field(Row, Value), String) -> t::FieldCount(Row) = t::field_count;
def filtered_count: for(Row, Business: codec::Encode) Fn(t::FieldCount(Row), v::Binding(Row), Business) -> t::FieldCount(Row) = t::filtered_count;
def with_field_counts: for(Row) Fn(t::Declaration, Array(t::FieldCount(Row))) -> t::Declaration = t::with_field_counts;
def combine_counts: for(Row) Fn(String, qb::ComputedOp, t::CountRef(Row), t::CountRef(Row)) -> t::ComputedCount(Row) = t::combine_counts;
def with_computed_counts: for(Row) Fn(t::Declaration, Array(t::ComputedCount(Row))) -> t::Declaration = t::with_computed_counts;

def scope_equal: for(Row, Scalar: codec::Encode) Fn(m::Dataset(Row), m::Field(Row, Scalar), Scalar) -> t::RowScope(Row) = t::scope_equal;
def with_scope: for(Row) Fn(t::Declaration, Array(t::RowScope(Row))) -> t::Declaration = t::with_scope;
def native_pair: for(Row) Fn(String, g::Binding(Row), g::Binding(Row)) -> t::NativePair(Row) = t::native_pair;
def with_native_pairs: for(Row) Fn(t::Declaration, Array(t::NativePair(Row))) -> t::Declaration = t::with_native_pairs;
def endpoint: for(Row) Fn(m::Dataset(Row), m::Role(Row)) -> r::Endpoint = r::endpoint;
def relation: for(From, To) Fn(String, m::Dataset(From), m::Role(From), m::Dataset(To), m::Role(To), edsl::RelationCardinality) -> r::Relation = r::relation;
def guarded: for(Row, Scalar: codec::Encode) Fn(r::Relation, m::Field(Row, Scalar), edsl::FilterOp, Scalar) -> r::Relation = r::guarded;
def link: Fn(String, r::Relation, r::Relation, edsl::LinkDirection) -> r::Link = r::link;
def guarded_link: for(Row, Scalar: codec::Encode) Fn(r::Link, m::Field(Row, Scalar), edsl::FilterOp, Scalar) -> r::Link = r::guarded_link;
def build: Fn(String, Array(t::Declaration), Array(r::Relation), Array(t::Alternative), Array(r::Link), qb::PlanProfile) -> t::Prepared = t::build_trusted;
def self_check_root: Fn(String, Array(t::Declaration), Array(r::Relation), Array(t::Alternative), Array(r::Link), qb::PlanProfile) -> () = fn(revision, declarations, relations, alternatives, links, profile) {
    t::self_check(revision, declarations, relations, alternatives, links, profile);
    ()
};
pub use t::{count_ref, computed_count_ref};
pub use self::{entity, dataset, field, optional_field, identity_part, reference_part, role, input, dimension_group, dimension, declare, prepare, self_check,
    seconds, rate, ipv4, utc_bucket, numeric_group, numeric_binding, transfer_binding, identity_dimensions,
    sample_group, sample_bind, metric, event, with_samples, column, map_columns,
    domain, ordered, domain_group, domain_bind, with_domains, field_count, filtered_count, with_field_counts, combine_counts, with_computed_counts,
    scope_equal, with_scope, native_pair, with_native_pairs, endpoint, relation, guarded, link, guarded_link, build, self_check_root};
