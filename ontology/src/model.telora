# RFC 0002 阶段 A：独立的对象身份、记录粒度和角色映射。
# 此入口只准备声明，不连接数据库，不授予查询或图遍历能力。
use std::array as array;
use std::type_desc as td;

type Entity(Identity) = struct { id: String, identity: Type };
type Dataset(Row) = struct { id: String, source: String, row: Type, grain: Array(String) };
type Field(Owner, Value) = struct { owner: Type, value: Type, name: String, nullable: Bool };
type IdentityPart(Row, Identity) = struct {
    row: Type, identity: Type, source: String, target: String, value: Type, nullable: Bool, raw: Option(Type),
};
type Role(Row) = struct {
    id: String, entity: String, identity: Type, optional: Bool,
    parts: Array(Part),
};
type Part = struct { source: String, target: String, value: Type, nullable: Bool, raw: Option(Type) };
type PreparedDataset = struct {
    id: String, source: String, row: Type, grain: Array(String), roles: Array(PreparedRole),
};
type PreparedRole = struct {
    id: String, entity: String, identity: Type, optional: Bool, parts: Array(Part),
};

def resolved: Fn(Type) -> Type = fn(ty) {
    if td::kind(ty) == td::TypeDescKind::Ref {
        match td::resolve(ty) { Ok(value) => value, Err(error) => fail!(error.message, ty) }
    } else { ty }
};
def field_type: Fn(Type, String) -> Type = fn(owner, name) {
    match array::find(td::fields(owner), fn(field) { field.name == name }) {
        Some(field) => field.ty,
        None => fail!("typed model field does not exist", owner, name),
    }
};

# 只接受标量或其 newtype 包装；Option 不作为全行身份成员。
def identity_value: Fn(Type) -> Bool = fn(ty) {
    let value = resolved(ty);
    match td::kind(value) {
        td::TypeDescKind::Int => True,
        td::TypeDescKind::String => True,
        td::TypeDescKind::Newtype => identity_value(td::children(value)[0]),
        _ => False,
    }
};

def validate_identity: Fn(Type) -> () = fn(identity) {
    let fields = td::fields(identity);
    if td::kind(resolved(identity)) != td::TypeDescKind::Struct || array::length(fields) == 0 {
        fail!("entity identity must be a nonempty record", identity)
    } else if !array::all(fields, fn(field) { identity_value(field.ty) }) {
        fail!("entity identity requires non-null integer or text business values", identity)
    } else { () }
};

def entity: for(Identity) Fn(String, TypeOf(Identity)) -> Entity(Identity) = fn(id, identity) { {id, identity} };

def validate_dataset: Fn(String, String, Type, Array(String)) -> () = fn(id, source, row, grain) {
    if id == "" || source == "" { fail!("dataset id and source must be nonempty", id, source) }
    else if td::kind(resolved(row)) != td::TypeDescKind::Struct {
        fail!("dataset row must be a record", row)
    } else {
        array::map(grain, fn(name) {
            if !identity_value(field_type(row, name)) {
                fail!("dataset grain must use non-null identity values", row, name)
            } else if array::length(array::filter(grain, fn(other) { other == name })) != 1 {
                fail!("dataset grain repeats a field", name)
            } else { () }
        });
        ()
    }
};
def dataset: for(Row) Fn(String, String, TypeOf(Row), Array(String)) -> Dataset(Row) = fn(id, source, row, grain) { {id, source, row, grain} };

def field: for(Owner, Value) Fn(TypeOf(Owner), TypeOf(Value), String) -> Field(Owner, Value) = fn(owner, value, name) { {owner, value, name, nullable: False} };

def optional_field: for(Owner, Value) Fn(TypeOf(Owner), TypeOf(Value), String) -> Field(Owner, Value) = fn(owner, value, name) { {owner, value, name, nullable: True} };

# Value 是共享的类型形参，编译期约束映射两侧的名义类型一致。
def identity_part: for(Row, Identity, Value) Fn(Field(Row, Value), Field(Identity, Value)) -> IdentityPart(Row, Identity) = fn(source, target) {
    {row: source.owner, identity: target.owner, source: source.name, target: target.name, value: source.value, nullable: source.nullable, raw: None}
};

# 仅原始整数/文本引用可显式采用目标身份的名义类型；编码不变，不允许名义 ID 之间隐式互转。
def identity_storage: Fn(Type) -> Type = fn(ty) {
    let value = resolved(ty);
    if td::kind(value) == td::TypeDescKind::Newtype { identity_storage(td::children(value)[0]) } else { value }
};
def validate_reference: Fn(Type, Type) -> () = fn(raw, target) {
    if (raw != Int.type && raw != String.type) || !identity_value(target) || identity_storage(target) != raw {
        fail!("explicit identity reference requires raw integer or text with unchanged storage", raw, target)
    } else { () }
};
def reference_part: for(Row, Identity, Raw, Nominal) Fn(Field(Row, Raw), Field(Identity, Nominal)) -> IdentityPart(Row, Identity) = fn(source, target) {
    {row: source.owner, identity: target.owner, source: source.name, target: target.name, value: target.value, nullable: source.nullable, raw: Some(source.value)}
};

def validate_parts: Fn(Type, Type, Bool, Array(Part)) -> () = fn(row, identity, optional, parts) {
    validate_identity(identity);
    let fields = td::fields(identity);
    if array::length(parts) != array::length(fields)
        || !array::all(fields, fn(field) {
            array::length(array::filter(parts, fn(part) { part.target == field.name })) == 1
        }) {
        fail!("role mapping must cover the complete identity exactly once", identity)
    } else {
        array::map(parts, fn(part) {
            let actual = field_type(row, part.source);
            let source_type = match part.raw { None => part.value, Some(raw) => { validate_reference(raw, part.value); raw } };
            let valid = if part.nullable {
                let variants = td::variants(resolved(actual));
                array::length(variants) == 2
                    && array::any(variants, fn(variant) { variant.name == "None" && variant.payload == None })
                    && array::any(variants, fn(variant) { variant.name == "Some" && variant.payload == Some(source_type) })
            } else { actual == source_type };
            if !valid || field_type(identity, part.target) != part.value {
                fail!("role mapping has incompatible field types", part.source, part.target)
            } else if part.nullable && !optional {
                fail!("nullable identity input requires an optional role", part.source)
            } else if array::length(array::filter(parts, fn(other) { other.source == part.source })) != 1 {
                fail!("role mapping repeats a source field", part.source)
            } else { () }
        });
        ()
    }
};

def role: for(Row, Identity) Fn(Dataset(Row), Entity(Identity), String, Bool, Array(IdentityPart(Row, Identity))) -> Role(Row) = fn(dataset, entity, id, optional, parts) {
    {id, entity: entity.id, identity: entity.identity, optional, parts: array::map(parts, fn(part) {
        {source: part.source, target: part.target, value: part.value, nullable: part.nullable, raw: part.raw}.ty!(Part)
    })}
};

def validate_prepared: Fn(PreparedDataset) -> PreparedDataset = fn(declared) {
    validate_dataset(declared.id, declared.source, declared.row, declared.grain);
    let roles = declared.roles;
    let prepared = array::map(roles, fn(role) {
        if role.id == "" || role.entity == "" { fail!("role and entity ids must be nonempty", role.id, role.entity) }
        else if array::length(array::filter(roles, fn(other) { other.id == role.id })) != 1 {
            fail!("dataset repeats an entity role id", role.id)
        } else if array::any(roles, fn(other) { other.entity == role.entity && other.identity != role.identity }) {
            fail!("entity id has conflicting identity types", role.entity)
        } else {
            validate_parts(declared.row, role.identity, role.optional, role.parts);
            {id: role.id, entity: role.entity, identity: role.identity, optional: role.optional, parts: role.parts}.ty!(PreparedRole)
        }
    });
    declared <~ {roles: prepared}
};
def prepare: for(Row) Fn(Dataset(Row), Array(Role(Row))) -> PreparedDataset = fn(dataset, roles) {
    {id: dataset.id, source: dataset.source, row: dataset.row, grain: dataset.grain,
        roles: array::map(roles, fn(role) { {id: role.id, entity: role.entity, identity: role.identity, optional: role.optional, parts: role.parts}.ty!(PreparedRole) })}
};

pub use self::{Entity, Dataset, Field, IdentityPart, Role, Part, PreparedDataset, PreparedRole,
    entity, dataset, field, optional_field, reference_part, identity_part, role, prepare, validate_prepared};

# 显式严格构造，用于诊断和检查需要立即拒绝的调用方。
def checked_entity: for(Identity) Fn(String, TypeOf(Identity)) -> Entity(Identity) = fn(id, identity) {
    validate_identity(identity);
    if id == "" { fail!("entity id must be nonempty", id) }
    else { {id, identity} }
};
def checked_dataset: for(Row) Fn(String, String, TypeOf(Row), Array(String)) -> Dataset(Row) = fn(id, source, row, grain) {
    validate_dataset(id, source, row, grain);
    {id, source, row, grain}
};
def checked_field: for(Owner, Value) Fn(TypeOf(Owner), TypeOf(Value), String) -> Field(Owner, Value) = fn(owner, value, name) {
    if field_type(owner, name) != value {
        fail!("typed model field has a different nominal type", owner, name, value)
    } else { {owner, value, name, nullable: False} }
};
def checked_optional_field: for(Owner, Value) Fn(TypeOf(Owner), TypeOf(Value), String) -> Field(Owner, Value) = fn(owner, value, name) {
    if field_type(owner, name) != Option(Value).type {
        fail!("typed model optional field has a different nominal type", owner, name, value)
    } else { {owner, value, name, nullable: True} }
};
def checked_identity_part: for(Row, Identity, Value) Fn(Field(Row, Value), Field(Identity, Value)) -> IdentityPart(Row, Identity) = fn(source, target) {
    if target.nullable { fail!("identity target cannot be nullable", target.name) }
    else { {row: source.owner, identity: target.owner, source: source.name, target: target.name,
        value: source.value, nullable: source.nullable, raw: None} }
};
def checked_reference_part: for(Row, Identity, Raw, Nominal) Fn(Field(Row, Raw), Field(Identity, Nominal)) -> IdentityPart(Row, Identity) = fn(source, target) {
    if target.nullable { fail!("identity target cannot be nullable", target.name) } else { () };
    validate_reference(Raw.type, Nominal.type);
    {row: source.owner, identity: target.owner, source: source.name, target: target.name,
        value: target.value, nullable: source.nullable, raw: Some(source.value)}
};
def checked_role: for(Row, Identity) Fn(Dataset(Row), Entity(Identity), String, Bool, Array(IdentityPart(Row, Identity))) -> Role(Row) = fn(dataset, entity, id, optional, parts) {
    if id == "" || entity.id == "" { fail!("role and entity ids must be nonempty", id, entity.id) }
    else {
        let mapped = array::map(parts, fn(part) {
            if part.row != dataset.row || part.identity != entity.identity {
                fail!("role mapping belongs to a different row or identity", id)
            } else { {source: part.source, target: part.target, value: part.value, nullable: part.nullable, raw: part.raw}.ty!(Part) }
        });
        validate_parts(dataset.row, entity.identity, optional, mapped);
        {id, entity: entity.id, identity: entity.identity, optional, parts: mapped}
    }
};
def checked_prepare: for(Row) Fn(Dataset(Row), Array(Role(Row))) -> PreparedDataset = fn(declared, roles) {
    # 公开 record 可以手工构造，准备边界重新验证，不把普通 record 当成不可伪造证明。
    if declared.row != Row.type { fail!("dataset row witness does not match its type", declared.id) }
    else {
        validate_prepared({id: declared.id, source: declared.source, row: Row.type, grain: declared.grain,
            roles: array::map(roles, fn(role) { {id: role.id, entity: role.entity, identity: role.identity,
                optional: role.optional, parts: role.parts}.ty!(PreparedRole) })})
    }
};
pub use self::{checked_entity, checked_dataset, checked_field, checked_optional_field, checked_identity_part, checked_reference_part, checked_role, checked_prepare, validate_identity};
