# ---------------------------------------------------------------------------
# 42. Request-scoped time-source authorization (facade decision predicates):
#     a Resolver cannot disguise a relative window as plain absolute filters or
#     a 'Direct window without Host-declared per-request direct bounds; relative
#     windows still require the trusted report reference.
# ---------------------------------------------------------------------------

def time_filter_ge: Fn(String) -> edsl.FilterRequest = fn(value) {
    {id: "ServerKpiTime", subject: "analyst", op: 'Ge, input: 'Text(value)}
};
def time_filter_lt: Fn(String) -> edsl.FilterRequest = fn(value) {
    {id: "ServerKpiTime", subject: "analyst", op: 'Lt, input: 'Text(value)}
};

def no_time_intent: facade.Intent = {
    measures: [request_measure("ServerDeviceCount")],
    dimensions: [],
    filters: [],
    any_of: [],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
    exists: [],
    having: [],
    group_count: 'None,
    time_windows: 'None,
};

