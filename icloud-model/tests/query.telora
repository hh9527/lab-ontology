        if entity.id == "device" {
            let dataset = match entity.dataset {
                Some(spec) => Some({...spec, grain: ["id", "tenant_id", "name"]}),
                None => fail!("device must declare its grain"),
            };
            {...entity, dataset}
        } else { entity }
    });
    let extended = {...payload, entities};
    let scope: edsl::LinkSiteScope = {
        a_relation: "physical_link_a_device", z_relation: "physical_link_z_device",
        link_tenant_relation: "physical_link_belongs_to_tenant",
        device_tenant_relation: "device_belongs_to_tenant",
        site_relation: "device_located_at_site", tenant_relation: "site_belongs_to_tenant",
        device_filters: [], site_filters: [], tenant_filters: [],
    };
    edsl::lower_link_site(extended,
        {measures: [{id: "physical_link_count", subject: "public", input: edsl::MeasureInput::All}],
         dimensions: [], filters: [], ordering: [], limit: None, offset: None, partition: None}, scope)
}, "both link endpoint roles must cover complete device grain and aligned tenant identity keys");

pub def link_site_rejects_two_names_for_same_endpoint_role: test::Test = test::should_fail_with(fn() {
    let a = match array::find(payload.relations, fn(relation) { relation.id == "physical_link_a_device" }) {
        Some(relation) => relation,
        None => fail!("missing A endpoint role"),
    };
    let relations = array::map(payload.relations, fn(relation) {
        if relation.id == "physical_link_z_device" { {...relation, key: a.key} } else { relation }
    });
    let broken = {...payload, relations};
    let scope: edsl::LinkSiteScope = {
        a_relation: "physical_link_a_device", z_relation: "physical_link_z_device",
        link_tenant_relation: "physical_link_belongs_to_tenant",
        device_tenant_relation: "device_belongs_to_tenant",
        site_relation: "device_located_at_site", tenant_relation: "site_belongs_to_tenant",
        device_filters: [], site_filters: [], tenant_filters: [],
    };
    edsl::lower_link_site(broken,
        {measures: [{id: "physical_link_count", subject: "public", input: edsl::MeasureInput::All}],
         dimensions: [], filters: [], ordering: [], limit: None, offset: None, partition: None}, scope)
}, "both link endpoint roles must cover complete device grain and aligned tenant identity keys");

