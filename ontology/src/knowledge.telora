use crate::ontology as edsl;
use std::array as array;
use crate::query as qb;
use std::blame as blame;
use std::codec as codec;
use std::dict as dict;
use std::json as json;
use std::string as string;
use std::type_property as property;
use std::value::{ Value };

type LinkKind = enum { Member, Traversable, Related };
type KnowledgeLink = struct { target: edsl::KnowledgeTarget, kind: LinkKind };
type IndexEntry = struct { key: edsl::KnowledgeTarget, label: String, aliases: Array(String), summary: String,
    from: Option(edsl::KnowledgeTarget), to: Option(edsl::KnowledgeTarget) };
type Point = struct {
    terms: Array(edsl::TermAnnotation),
    value_type: Option(edsl::ValueTypeBrief),
    value: Option(edsl::CanonicalValueSpec),
    logical_type: Option(edsl::LogicalType),
    nullable: Bool,
    references: Array(edsl::ReferenceSpec),
    field_roles: Array(edsl::FieldRoleBrief),
    roles: Array(edsl::FieldRole),
    target: edsl::KnowledgeTarget,
    label: String,
    aliases: Array(String),
    localized: Array(edsl::LocalizedKnowledgeText),
    summary: String,
    refs: Array(KnowledgeLink),
    grain: Array(String),
    time_roles: Array(edsl::TimeRoleBrief),
    time_role: Option(edsl::TimeRoleBrief),
    dimension: Option(edsl::VisibleDimensionBrief),
    measure: Option(edsl::MeasureBrief),
    relation: Option(edsl::RelationBrief),
    direction: Option(edsl::LinkDirection),
    guard: Option(edsl::ScopePredicate),
    entries: Option(Array(IndexEntry)),
    revision: String,
};
type KnowledgeIndex = struct { entries: Array(IndexEntry),
    targets: Dict(edsl::KnowledgeTarget), points: Dict(Point),
    datasets: Dict(edsl::DatasetBrief), summaries: Dict(String),
    related: Dict(Array(KnowledgeLink)), terms: Dict(Array(edsl::TermAnnotation)) };
type DocResult = enum { NotFound, Found(Point) };
type KnowledgeResponse = enum { Document(DocResult) };
type KnowledgeRequest = struct { method: String, input: Value };
type InfoInput = struct { key: String };
type TermText = struct { term: String, description: String };
type Description = struct { label: String, aliases: Array(String), localized: Array(edsl::LocalizedKnowledgeText), summary: String, terms: Array(TermText) };
type NodeLink = struct { type: LinkKind, key: String };
type Node = struct { key: String, type: edsl::KnowledgeKind, description: Description, links: Array(NodeLink), detail: Value };
type NodeResult = enum { NotFound, Found(Node) };
type NodeResponse = enum { Document(NodeResult) };
type DatasetDetail = struct { id: String, grain: Array(String), time_roles: Array(edsl::TimeRoleBrief), references: Array(edsl::ReferenceSpec), field_roles: Array(edsl::FieldRoleBrief) };
type FieldDetail = struct { id: String, dataset: String, nullable: Bool, logical_type: Option(edsl::LogicalType), roles: Array(edsl::FieldRole), reference_ids: Array(String) };
type ValueDetail = struct { id: String, ty: String, wires: Array(edsl::FilterInput) };
type TypeValueDetail = struct { id: String, label: String, aliases: Array(String), localized: Array(edsl::LocalizedValueLabel), wires: Array(edsl::FilterInput) };
type ValueTypeDetail = struct { id: String, label: String, summary: String, storage: String, half_open: Bool,
    values: Array(TypeValueDetail), canonical_order: Array(String) };
type BusinessLinkDetail = struct { id: String, hub: String, direction: Option(edsl::LinkDirection), guard: Option(edsl::ScopePredicate) };
type DatasetTerm = struct { name: String, doc: String, aliases: Array(String) };
type DimensionTerm = struct { dataset: String, name: String, doc: String, aliases: Array(String) };
type MeasureTerm = struct { dataset: String, name: String, doc: String, aliases: Array(String) };
type ValueTerm = struct { ty: String, name: String, doc: String, aliases: Array(String) };
type RelationTerm = struct { name: String, doc: String, aliases: Array(String) };
type LinkEntry = struct { source: String, target: String, kind: LinkKind };
type LinksIndex = struct { revision: String, links: Array(LinkEntry) };
type TerminologyIndex = struct { revision: String, datasets: Array(DatasetTerm), dimensions: Array(DimensionTerm), measures: Array(MeasureTerm), rels: Array(RelationTerm), types: Array(DatasetTerm), values: Array(ValueTerm) };
type DiscoveryInput = struct {};

def target: Fn(edsl::KnowledgeKind, String, String) -> edsl::KnowledgeTarget = fn(kind, owner, id) {
    {kind, owner, id}
};

def member: Fn(edsl::KnowledgeTarget) -> KnowledgeLink = fn(item) { {target: item, kind: LinkKind::Member} };
def traversable: Fn(edsl::KnowledgeTarget) -> KnowledgeLink = fn(item) { {target: item, kind: LinkKind::Traversable} };

def point: Fn(edsl::KnowledgeTarget, String, Array(String), String, Array(KnowledgeLink)) -> Point =
    fn(id, label, aliases, summary, refs) {
        {target: id, label, aliases, localized: [], summary, refs, terms: [], grain: [], time_roles: [], time_role: None,
            references: [], field_roles: [], roles: [], nullable: False, logical_type: None,
            dimension: None, measure: None, relation: None, direction: None, guard: None,
            entries: None, revision: "", value_type: None, value: None}
    };

def syntax_target: Fn(String) -> edsl::KnowledgeTarget = fn(id) {
    target(edsl::KnowledgeKind::Schema, "", `syntax/\{id}`)
};

def type_target: Fn(String) -> edsl::KnowledgeTarget = fn(id) {
    target(edsl::KnowledgeKind::Ty, "", id)
};

def input_type_ref: Fn(edsl::FilterInputKind) -> KnowledgeLink = fn(kind) {
    match codec::encode(kind) {
        Value::String(name) => member(type_target(name)),
        other => fail!("logical input type must encode as a name", other),
    }
};

def type_operations: Fn(edsl::FilterInputKind) -> Array(KnowledgeLink) = fn(kind) {
    let comparisons = [member(syntax_target("operations/comparison"))];
    match kind {
        edsl::FilterInputKind::Text => array::push(comparisons, member(syntax_target("operations/text_match"))),
        edsl::FilterInputKind::Ipv4 => array::push(comparisons, member(syntax_target("model/ipv4_subnets"))),
        edsl::FilterInputKind::DatetimeUtc => array::push(comparisons, member(syntax_target("operations/time_window"))),
        edsl::FilterInputKind::DateUtc => array::push(comparisons, member(syntax_target("operations/time_window"))),
        edsl::FilterInputKind::LocalDateTime => array::push(comparisons, member(syntax_target("operations/time_window"))),
        edsl::FilterInputKind::EpochMillis => array::push(comparisons, member(syntax_target("operations/time_window"))),
        edsl::FilterInputKind::Int => comparisons,
        edsl::FilterInputKind::Number => comparisons,
        edsl::FilterInputKind::Bool => comparisons,
    }
};

def type_points: Array(Point) = array::map([
    (edsl::FilterInputKind::Text, "JSON string; literal text comparisons and pattern searches only where the dimension declares them. Text is not an address or a temporal value."),
    (edsl::FilterInputKind::Int, "JSON integer; exact integral values, with Model-declared comparison operations. Units and business meaning come from the field or measure."),
    (edsl::FilterInputKind::Number, "JSON number; numeric values with Model-declared comparisons. Units and permitted aggregations come from the Model."),
    (edsl::FilterInputKind::Bool, "JSON boolean true or false; not a string or integer flag. Model declarations map physical representations."),
    (edsl::FilterInputKind::Ipv4, "Canonical dotted-decimal JSON string: four octets 0..255 without leading zeros. Eq/Ne compare addresses; InSubnet/NotInSubnet take canonical CIDR networks /0..32. No lexical order, text pattern search or implicit IPv6 conversion. Raw unknown-format addresses remain Text. A validated IPv4 view can return NULL for invalid source values."),
    (edsl::FilterInputKind::DatetimeUtc, "JSON string expressing a UTC instant as YYYY-MM-DDTHH:MM:SSZ, for example 2024-03-01T00:00:00Z. Currently only normalized UTC seconds are accepted; resolve other offsets and fractions before submission. Not arbitrary Text or an unzoned local datetime."),
    (edsl::FilterInputKind::EpochMillis, "JSON integer representing milliseconds since the Unix epoch. Not seconds, Number or arbitrary Int; do not silently change units."),
    (edsl::FilterInputKind::DateUtc, "JSON string YYYY-MM-DD expressing a UTC calendar date, without a time of day. Not an instant or arbitrary Text."),
    (edsl::FilterInputKind::LocalDateTime, "JSON string YYYY-MM-DD HH:MM:SS expressing a local calendar datetime without an embedded zone. Local wall-clock boundaries must be resolved externally with the relevant timezone and ambiguity policy; never infer the database session timezone."),
], fn(entry) {
    let name = match codec::encode(entry.0) {
        Value::String(name) => name, other => fail!("logical input type must encode as a name", other),
    };
    point(type_target(name), name, [], entry.1,
        array::concat([[member(syntax_target("model/logical_types")), member(syntax_target("graph/filter"))], type_operations(entry.0)]))
});

def value_type_points: Fn(edsl::PreparedPayload) -> Array(Point) = fn(payload) {
    array::flat_map(edsl::visible_value_types(payload), fn(spec) {
        let parent = type_target(spec.id);
        let values = array::map(spec.values, fn(value) {
            let current = target(edsl::KnowledgeKind::Value, spec.id, value.id);
            let base = point(current, value.label,
                array::concat([value.aliases, array::map(value.localized, fn(text) { text.label })]), "", [member(parent)]);
            {...base, value: array::find(spec.mapping, fn(mapping) { mapping.id == value.id }),
                localized: array::map(value.localized, fn(text) { {locale: text.locale, label: text.label, summary: ""} })}
        });
        let base = point(parent, spec.label, [], spec.summary,
            array::concat([[member(syntax_target("model/logical_types")), member(syntax_target("operations/comparison"))],
                array::map(values, fn(value) { member(value.target) })]));
        array::concat([[{...base, value_type: Some(spec)}], values])
    })
};

def index_point: Fn(edsl::PreparedPayload) -> Point = fn(payload) {
    {...point(target(edsl::KnowledgeKind::Index, "", "index"), "Knowledge index", [],
        "Schema keys and concrete knowledge key patterns. Use discovery roots and info(key) for complete details. Dataset details directly reference their members.", []),
        entries: Some(index_entries(syntax_points).entries), revision: payload.revision}
};

def syntax_points: Array(Point) = [
    point(syntax_target("operations/comparison"), "Comparison operations", [],
        "Eq and Ne compare compatible logical values. Gt, Ge, Lt and Le are also defined for Int, Number and temporal types; Text has Model-declared lexical comparisons, not numeric or temporal ordering. Bool and Ipv4 do not gain ordered comparisons. A type's links describe supported operations, not permission on every field: inspect the dimension's filterable and ops. Values must follow its logical format and declared canonical value contract. Comparisons against NULL are not arbitrary value comparisons; Ne does not include missing values.",
        [member(syntax_target("graph/filter")), member(syntax_target("graph/filter/capabilities"))]),
    point(syntax_target("operations/text_match"), "Text match operations", [],
        "Contains, NotContains, StartsWith and EndsWith operate on Text only when authorized by the dimension. Inputs are literal text, not caller-provided SQL or regex patterns. Current matching is case-folded. Do not replace one operation with another after rejection: they select different populations. Text storage alone does not authorize text matching on a logical address or time.",
        [member(syntax_target("graph/filter")), member(syntax_target("graph/filter/capabilities"))]),
    point(syntax_target("operations/utc_time_bucket"), "UTC time bucket", [],
        "A declared UTC bucket dimension projects the start of an hour, day or calendar month. Select it alongside a declared measure to group observations by that bucket; no Intent granularity parameter is accepted. DatetimeUtc output is canonical UTC YYYY-MM-DDTHH:MM:SSZ, DateUtc output is YYYY-MM-DD and supports day/month only, EpochMillis output is integer Unix milliseconds. Input and output logical types agree. NULL stays NULL. Common calendar range is years 0001..9999; out-of-range epoch values produce NULL. Negative epochs floor toward the preceding bucket, not toward zero. Month is a calendar operation, not a fixed duration. PostgreSQL session timezone does not change bucket boundaries. Filter the original time dimension with an explicit half-open interval, then group by the bucket dimension; do not replace the interval with a bucket filter unless that is the requested population. No inferred timezone, clock, local-calendar interpretation or implicit type conversion.",
        [member(syntax_target("operations/time_window"))]),
    point(syntax_target("operations/time_window"), "TimeWindow operation", [],
        "Graph time_windows items are {node,dimension,start,end}, at the root or inside exists. The dimension must have a declared time role and authorize Ge for start and Lt for a finite end. The interval is [start,end): start is included, end is excluded. start is required and concrete; end may be null or omitted for [start,None), meaning no upper cutoff, NOT now. Future-dated rows may match an open upper bound. Finite bounds must use the same dimension's logical format and start must precede end. SQL compares the original column with bound values, >= start AND < end, or just >= start for no end. No implicit clock, database now(), timezone inference or column-side time conversion. Resolve yesterday, last seven days, calendar months and other relative periods externally using the application's reference time and timezone; submit concrete boundaries. A calendar day need not be 24 hours and a calendar month is not a fixed number of days. For example, in DatetimeUtc, UTC February 2024 is start=2024-02-01T00:00:00Z, end=2024-03-01T00:00:00Z. This interval contract is unrelated to dimension.half_open, which denotes a partially enumerated business value domain. Linking a type to this operation does not grant field authorization.",
        [member(type_target("EpochMillis")), member(type_target("DatetimeUtc")),
            member(type_target("DateUtc")), member(type_target("LocalDateTime")), member(syntax_target("graph/filter/capabilities"))]),
    point(syntax_target("model/ipv4_subnets"), "Restricted IPv4 subnet operations", [],
        "InSubnet and NotInSubnet apply only to an Ipv4 dimension that declares the operation in ops. value is a canonical IPv4 CIDR string, no kind: for example 10.4.16.0/20. Every integer mask /0..32 is supported. Host bits must be zero, never silently normalized. Input address and stored values use canonical dotted decimal without leading zeros. Whole-octet prefixes retain the trailing dot, so 10.4.0.0/16 cannot match 10.40.0.1. Lowering uses a bound half-open binary text range as prefilter, followed by a bound generated regex for partial octets. /32 uses address equality; /0 matches every non-NULL address. NotInSubnet negates the entire membership predicate over non-NULL addresses, not missing values. CIDR is a network operation argument, not an address for Eq or any_of. Typed callers use Ipv4Subnet. No Text, IPv6 or native inet conversion is implied. PostgreSQL uses COLLATE C and native regex; SQLite uses COLLATE BINARY and requires the executor to register regexp(pattern,value), returning NULL for NULL arguments and boolean membership otherwise. Generated patterns use only anchors, decimal alternatives, groups, [.] and [0-9]{1,3}. A usable range index must have the matching collation; index use is not guaranteed by semantic support. Preparation checks comparison, binary collation, conjunction, regex and negation capabilities.",
        [member(syntax_target("model/logical_types")), member(syntax_target("graph/filter"))]),
    point(syntax_target("model/logical_types"), "Logical types and field capabilities", [],
        "Physical storage is not the logical value domain. Time fields distinguish DatetimeUtc, DateUtc, LocalDateTime and EpochMillis even when their storage is String or Int. Explicit logical_type(Ipv4) uses canonical dotted-decimal String storage with four octets 0..255 and no leading zeros; it is not Text. Address Eq/Ne and IPv4 CIDR InSubnet/NotInSubnet are defined; see the linked subnet contract. No lexical ordering, Contains, IPv6 or implicit conversion to Text. Noncanonical stored addresses violate the declared storage contract; preparation does not scan data. The field's published ops may narrow the type's operations, but cannot give a type an undefined operation. Index availability and cost are field/physical capability considerations, not a reason to reinterpret address semantics. Names of fields do not infer their types; raw unknown-format source columns remain Text until their representation is established. Logical types grant no filter or projection authorization.",
        array::concat([[member(syntax_target("model/ipv4_subnets"))], array::map(type_points, fn(item) { member(item.target) })])),
    point(syntax_target("model/field_roles"), "Field roles and object references", [],
        "Dataset detail.references contains named {id,fields} sets. Each complete non-NULL tuple is a trusted unique address within that dataset; fields inside a set participate together, and different sets are alternative addresses. Field detail.nullable is derived from Option(T). Any missing member makes the entire reference unavailable; NULL is not an address value. A nullable reference does not establish a total key or grain. Do not treat one member of a composite set as a complete reference. Dataset detail.field_roles contains {field,roles}; Field detail has roles and reference_ids. Appellation participates in identity display and need not be unique; Reference participates in an explicitly declared unique address; Classification describes a category; Metric describes quantitative use. Roles may overlap. Formal metric declarations also derive Metric. Roles grant no query capabilities, do not change grain or keys, and imply no default display, URL, unit or aggregate. Only fully visible references are published. Query and report consumers must respect the separately declared capabilities.", []),
    point(syntax_target("knowledge/target"), "Knowledge target", [],
        "Index key index publishes schema keys and concrete knowledge key patterns; detail.revision identifies the Prepared Model revision. Names are URI-encoded components; Schema keys preserve slash-separated path segments. info accepts {key:<string>} and returns complete knowledge for the exact key. The discovery capability supplies Dataset and Relation roots. Consumers derive search vocabulary and references from info documents.",
        [member(syntax_target("knowledge/node"))]),
    point(syntax_target("knowledge/node"), "Knowledge node contract", [],
        "Every Found node is {key,type,description,links,detail}. description is {label,aliases,localized,summary}; localized items are {locale,label,summary}; terms are {term,description}. links are {type,key}: Member structural membership, Related explanatory association, Traversable declared relation endpoint. Index detail is {revision,schemas,key_patterns,encoding}: schemas lists exact Schema keys; key_patterns lists {kind,pattern} for concrete nodes. Index enumerates no business instances. Dataset has {id,grain,time_roles,references,field_roles} and directly links to its fields, dimensions, measures, relations, time roles and business links. Field has {id,dataset,nullable,logical_type,roles,reference_ids}; Value has {id,ty,wires}; named Ty details contain id, storage, half_open, canonical_order and values with member labels, aliases, localized labels and wires. Dimension, Measure and Relation preserve their Model details. Measure detail.sampling contains its declared source field, unit, aggregate and Primary or SampleSummary role. Sampling metadata has no independent key. TimeRole identifies its owning dataset; BusinessLink has {id,hub,direction,guard}; Schema detail is empty. Labels are display text, never Intent identifiers. Follow references for capabilities, units and population semantics. info publishes only Index, Schema and concrete knowledge nodes. Unknown or hidden keys return NotFound. The discovery capability returns {revision,roots,key_patterns,vocabulary}; search vocabulary and reverse references are generated by consumers.",
        [member(target(edsl::KnowledgeKind::Index, "", "index"))]),
    point(syntax_target("knowledge/request"), "Knowledge request", [],
        "The unbound knowledge service accepts exactly {method,input}. method is <domain>/info; input follows the declared info shape. A mounted service slot receives only input, without this envelope.",
        [member(syntax_target("knowledge/info"))]),
    point(syntax_target("knowledge/info"), "Knowledge info request", [],
        "info input is exactly {key:<string>}. Read index for schema keys and concrete key patterns. Find business names through the consumer search service backed by externally generated terminology, then read exact keys. Dataset links directly identify members. Unknown or invisible keys return NotFound. discovery returns Dataset and Relation roots for consumer-side indexing.",
        [member(syntax_target("knowledge/target")), member(target(edsl::KnowledgeKind::Index, "", "index"))]),
    point(syntax_target("knowledge/discovery"), "Knowledge discovery request", [],
        "discovery input is exactly {}. The independent capability returns {revision,roots,key_patterns,vocabulary}. roots contains complete visible Dataset and Relation keys. key_patterns shares the Index definition. vocabulary declares searchable membership and output shape as {kind,group,owner,require}; owner names the detail field and key placeholder; require checks a direct detail field is present and non-NULL. Kinds outside vocabulary remain readable but are not vocabulary members. An empty vocabulary declares no members; a missing declaration is a contract error. Consumers follow info references from these roots to find dimensions, measures, business types and their values. Structured descriptions include declared terms as {term,description}. Consumers derive terminology and unique reference edges for search and reverse lookup. Schema keys and concrete key patterns are available through info(index).",
        [member(syntax_target("knowledge/info"))]),
    point(syntax_target("intent"), "Intent syntax", [],
        "Submit {intents:[...]} with one to five independent intents. Each intent has op Graph, GraphPair or GraphUnion. Values in filters are interpreted by their declared dimension or measure; do not supply an input kind.",
        [member(syntax_target("graph")), member(syntax_target("graph_pair")), member(syntax_target("graph_union")),
            member(syntax_target("knowledge/target")), member(syntax_target("knowledge/request"))]),
    point(syntax_target("graph"), "Graph intent", [],
        "Required: op=Graph, root node id, nodes, edges, select. Optional: row_grain=Root|Association, distinct, constraints, measures, measure_having, filters, time_windows, any_of, exists, count, count_value, count_having, count_groups, include_empty, group_by_identity, top_per, top_by_measure, order_by, take. A graph must project dimensions/measures or count an explicit subject. Entity, dimension, measure and relation IDs come from domain knowledge.",
        [member(syntax_target("graph/node")), member(syntax_target("graph/edge")), member(syntax_target("graph/select")),
            member(syntax_target("graph/filter")), member(syntax_target("graph/aggregate")),
            member(syntax_target("graph/existence")), member(syntax_target("graph/order"))]),
    point(syntax_target("graph/node"), "Graph node", [],
        "Node: {id,entity}. id is a request-local node name; entity is a declared dataset ID. root names one node id.", []),
    point(syntax_target("graph/edge"), "Graph edge", [],
        "Edge or constraint: {relation,from,to}. relation is a declared relation ID; from and to name nodes. Only declared, directionally valid relations can be traversed.", []),
    point(syntax_target("graph/select"), "Graph projection", [],
        "select items are {node,dimension}; measures items are {node,measure}. count is a node id; count_value is {node,dimension}. group_by_identity is an array of node ids. Use declared IDs, not field or SQL names.", []),
    point(syntax_target("graph/filter"), "Graph filter", [],
        "filters items are {node,dimension,op,value}; any_of items are {node,dimension,values}. Operators: Eq, Ne, Gt, Ge, Lt, Le, Contains, NotContains, StartsWith, EndsWith, InSubnet, NotInSubnet. Subnet operators take a restricted canonical IPv4 CIDR network; read the shared subnet contract. The dimension declares allowed operators, logical input type and values. No kind field: use a JSON string, number or boolean compatible with the dimension. For half_open dimensions, a known concept uses its listed business ID; {\"unknown\":\"raw value\"} matches one unrecognized wire and {\"unknowns\":true} matches all unrecognized non-NULL wires. Ne takes the non-NULL complement. Consult dimension.value_contract for tagged result columns. Typed measure predicate inputs and canonical wires in info describe Model facts, not the Intent value shape. Resolve relative times before submission.", [member(syntax_target("model/ipv4_subnets"))]),
    point(syntax_target("graph/aggregate"), "Graph aggregate", [],
        "measure_having and existence having items are {node,measure,op,value}; value follows the measure output type. A measure ID selects its Model-declared aggregation, never an implicit override. If that meaning does not meet the business request, discover another declared measure or report the missing capability. Outer measure_having requires its measure in measures and either (1) group_by_identity=[root] with root-only selected dimensions, or (2) the supported contextual sample shape: root context -> owner and sample -> owner, both owner endpoints One or Optional, complete context/owner/sample identities, group_by_identity=[root,owner], and selections from context/owner only. The latter permits one optional owner -> ancestor edge with an at-most-one ancestor endpoint and ancestor selections; exactly three nodes, or four with that ancestor, and no extra edges, row count, business-link edges or include_empty. This keeps each owner's sample population separate per context identity instead of merging names or multiplying observations. Existence having is checked in its own population, not by the outer measure_having shape. count_having is {op,value} with integer value. count_groups and include_empty are booleans. Do not add identity grouping merely to bypass a rejection if it changes the requested business groups.",
        [member(syntax_target("graph/select")), member(syntax_target("graph/edge")), member(syntax_target("graph/existence"))]),
    point(syntax_target("graph/filter/capabilities"), "Declared filter capabilities", [],
        "The syntax operator vocabulary is not permission to apply every operator to every dimension. Read the dimension's filterable, ops, input_kinds and values. Eq-only is a Model capability boundary, not a missing SQL implementation. A rejected Contains cannot silently become StartsWith or Eq: these select different populations. Choose a discovered equivalent plan, ask a business clarification when appropriate, or explain the unavailable capability. Text pattern operators currently compare case-folded text; do not infer exact case-sensitive identifier semantics. Model scope and filtered-measure predicates obey the same declared capabilities.",
        [member(syntax_target("graph/filter"))]),
    point(syntax_target("graph/order/semantics"), "Ordering and aggregate meaning", [],
        "Raw order_by plus take returns the first rows in one global ordered population, not per-group Min or Max statistics. Raw take appends complete declared grain identity columns as tie breakers for deterministic selection; it does not promise a business preference among equal values. SQLite ASC places NULL first and DESC places NULL last; PostgreSQL execution equivalence must explicitly preserve that contract rather than use its opposite defaults. Consequently ASC take=1 may return a missing value whereas Min ignores NULL. Aggregate top_by_measure ranks by the selected measure's declared aggregation: highest average is not highest sample peak. Discover a declared sample summary when that is the requested meaning, and never substitute raw Top-N for a missing statistical capability without explaining the different business result.",
        [member(syntax_target("graph/order")), member(syntax_target("graph/aggregate"))]),
    point(syntax_target("graph/existence"), "Graph existence", [],
        "Use EXISTS to qualify outer rows without multiplying their grain. Complete Graph shape: {\"op\":\"Graph\",\"root\":\"outer\",\"nodes\":[{\"id\":\"outer\",\"entity\":\"<outer entity>\"}],\"edges\":[],\"select\":[{\"node\":\"outer\",\"dimension\":\"<outer dimension>\"}],\"exists\":[{\"anchor\":\"outer\",\"nodes\":[{\"id\":\"related\",\"entity\":\"<related entity>\"}],\"edges\":[{\"relation\":\"<declared relation>\",\"from\":\"related\",\"to\":\"outer\"}],\"filters\":[{\"node\":\"related\",\"dimension\":\"<related dimension>\",\"op\":\"Eq\",\"value\":\"<value>\"}]}]}. Replace placeholders using domain info; relation direction must match its declaration and may instead run from outer to related. The anchor names an outer node; inner nodes belong only to EXISTS. Other optional existence keys: constraints, time_windows, any_of, having, negated (boolean). Remove the example filter if mere existence is enough. An outer count or measure can replace select when its grain is valid.",
        [member(syntax_target("graph/edge")), member(syntax_target("graph/filter"))]),
    point(syntax_target("graph/order"), "Graph ordering and time", [],
        "Raw global Top-N Graph shape: {\"op\":\"Graph\",\"root\":\"row\",\"nodes\":[{\"id\":\"row\",\"entity\":\"<entity>\"}],\"edges\":[],\"select\":[{\"node\":\"row\",\"dimension\":\"<dimension>\"}],\"order_by\":[{\"node\":\"row\",\"dimension\":\"<ordered dimension>\",\"direction\":\"Desc\"}],\"take\":3}. Raw take requires ordered raw rows and grain-safe joins from the root; qualify multiplying paths with EXISTS (see syntax/graph/existence). Aggregate Top-N Graph shape: {\"op\":\"Graph\",\"root\":\"row\",\"nodes\":[{\"id\":\"row\",\"entity\":\"<entity>\"}],\"edges\":[],\"select\":[{\"node\":\"row\",\"dimension\":\"<group dimension>\"}],\"measures\":[{\"node\":\"row\",\"measure\":\"<measure>\"}],\"top_by_measure\":{\"node\":\"row\",\"measure\":\"<measure>\",\"direction\":\"Desc\",\"take\":3}}. This ranks visible dimension groups only when hidden identity keys do not split them and the measure source is grain-safe. Per-owner sample Top-N Graph shape: {\"op\":\"Graph\",\"root\":\"owner\",\"nodes\":[{\"id\":\"owner\",\"entity\":\"<owner entity>\"},{\"id\":\"sample\",\"entity\":\"<sample entity>\"}],\"edges\":[{\"relation\":\"<sample-to-owner relation>\",\"from\":\"sample\",\"to\":\"owner\"}],\"select\":[{\"node\":\"owner\",\"dimension\":\"<owner dimension>\"},{\"node\":\"sample\",\"dimension\":\"<sample dimension>\"}],\"top_per\":{\"owner\":\"owner\",\"sample\":\"sample\",\"rank\":\"<ordered sample dimension>\",\"take\":3}}. It requires exactly one declared sample-to-owner edge whose owner endpoint is One or Optional, a sample grain and an ordered sample rank dimension. Replace all placeholders using domain info. order_by items are {node,dimension,direction} with Asc|Desc; take is a positive bounded integer. time_windows items are {node,dimension,start,end}; end may be null or omitted for an open upper bound. Time values use the dimension's declared logical format.",
        [member(syntax_target("graph/existence")), member(syntax_target("graph/aggregate")), member(syntax_target("operations/time_window")), member(syntax_target("graph/latest"))]),
    point(syntax_target("graph/latest"), "Latest sample measure", [],
        "Latest is a Model-declared numeric measure selected through measures:[{node,measure}]. Within each actual grouping population, order eligible rows by the dataset's authoritative UTC instant descending, NULLS LAST, then remaining complete sample grain ascending, NULLS FIRST. Return that row's original value and unit, preserving a selected NULL; never substitute an older non-NULL value. Measures on the same sample node share one selected row. NULL-time rows cannot supply Latest, but remain in ordinary Avg/Count populations. Dataset scope, joins, filters, explicit half-open windows and EXISTS qualify samples before selection; measure_having compares the selected value afterwards. No implicit now cutoff; future samples can match an unbounded window. Use complete owner identity grouping for per-owner questions. Latest can coexist with same-source ordinary measures, participate in top_by_measure and be the measure of each GraphPair window; align owner identities for comparisons. Initial restrictions: one Latest sample source/order per grouped operand, numeric fields, no DISTINCT, aggregate-local FILTER, external dependencies, raw top_per, derived union source, or nested EXISTS aggregate predicates. Missing owners follow existing inner-join population semantics; Latest does not extend include_empty. Read the measure's TimeRole and dataset grain references for the selection clock and tie fields. Raw top_per remains the whole-row retrieval path.",
        [member(syntax_target("graph/aggregate")), member(syntax_target("graph/order")), member(syntax_target("graph_pair")), member(syntax_target("operations/time_window"))]),
    point(syntax_target("graph_pair"), "Graph pair", [],
        "GraphPair shape: {op:GraphPair,left:<Graph>,right:<Graph>,align_by:[{left:{node:<left node>},right:{node:<right node>}}],select:[{side:Left|Right,node:<node on that side>,dimension:<dimension>}],count_groups?:boolean,rank_by?:<rank>}. Required nonempty align_by pairs nodes of the same entity and expands complete model-declared identities, including composite grains. Node IDs may differ; no repeated nodes. Each operand has exactly one measure, empty or omitted select, and group_by_identity exactly matching its aligned nodes in order, beginning with root. Required outer select (may be empty) chooses a side per column and only references aligned nodes whose attributes are determined by identity. It derives operand projections; display dimensions never become alignment keys. Output follows select order then both measures; aliases are left_<node>_<dimension or measure> / right_<node>_<dimension or measure>, with adjacent __kind for half-open dimensions. Both sides can expose differing display values without changing matching. An identity containing time pairs individual sample points, not periods. Disjoint windows on the same aligned identity time field are rejected because no identity can match; align owner entities for period comparisons. Equal or overlapping windows remain valid. Independently aggregate and inner join identities; apply filters, time_windows, exists and measure_having inside each population. Operand counts, distinct, include_empty, order_by, take, top_by_measure and top_per are forbidden. Rank examples: {op:Subtract,minuend:Right,subtrahend:Left,direction:Desc,take:5}; {op:Ratio,numerator:Right,denominator:Left,direction:Desc,take:5}; {op:GrowthRate,current:Right,baseline:Left,direction:Desc,take:5}. Side parameters accept Left|Right but must reference different sides. Formulas: minuend-subtrahend; numerator/denominator; (current-baseline)/baseline as a fraction (0.2 means 20%). direction is Asc|Desc; take is an integer 1..1000. Both measures must be numeric; different measure IDs require matching non-null declared units. Exclude NULL measures, zero Ratio denominators and nonpositive GrowthRate baselines. Negative current values remain eligible. Cast both operands to approximate double precision; rank after identity joining, with complete alignment identity ties ascending, NULLS FIRST. Ranked results append numeric comparison_value after both measures and order by that column. Subtract retains the declared operand unit (percent differences are percentage points); Ratio returns a dimensionless multiple; GrowthRate returns a dimensionless fraction. Unranked results have no comparison column. Profile authorization requires Order, Limit, Scalar, Filter and IsNotNull, plus Sub for Subtract, Div/Ne for Ratio or Sub/Div/Gt for GrowthRate. Ranking cannot combine with count_groups:true; unranked count_groups counts all aligned identities.",
        [member(syntax_target("graph"))]),
    point(syntax_target("graph_union"), "Graph union", [],
        "{op:GraphUnion,branches:[{result_node,graph},...]}. At least two Graph branches return the same entity and selected dimensions in the same order. Each branch projects the complete result identity as raw unordered rows; union removes duplicates.",
        [member(syntax_target("graph"))]),
];

def labels: Fn(Array(edsl::LocalizedKnowledgeText)) -> Array(String) = fn(texts) {
    array::map(texts, fn(entry) { entry.label })
};

def dataset_point: Fn(edsl::PreparedPayload, edsl::DatasetBrief) -> Point = fn(payload, brief) {
    let id = target(edsl::KnowledgeKind::Dataset, "", brief.id);
    let dimensions = array::map(brief.dimension_ids, fn(name) {
        member(target(edsl::KnowledgeKind::Dimension, brief.id, name))
    });
    let fields = array::map(edsl::published_fields(payload, brief.id), fn(name) {
        member(target(edsl::KnowledgeKind::Field, brief.id, name))
    });
    let measures = array::map(brief.measure_ids, fn(name) {
        member(target(edsl::KnowledgeKind::Measure, brief.id, name))
    });
    let times = array::map(brief.time_roles, fn(role) {
        member(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field))
    });
    let relations = array::map(brief.relation_ids, fn(name) {
        let declared = match array::find(payload.relations, fn(entry) { entry.id == name }) {
            Some(entry) => entry,
            None => fail!("knowledge relation disappeared from prepared model", name),
        };
        member(target(edsl::KnowledgeKind::Relation, payload.entities[declared.from].id, name))
    });
    let links = array::map(array::filter(payload.business_links, fn(link) {
        let hub = payload.entities[link.hub].id;
        let participant = payload.entities[link.participant].id;
        hub == brief.id || participant == brief.id
    }), fn(link) {
        member(target(edsl::KnowledgeKind::BusinessLink, payload.entities[link.hub].id, link.id))
    });
    let role_contract = if array::length(brief.references) > 0 || array::length(brief.field_roles) > 0 {
        [member(syntax_target("model/field_roles"))]
    } else { [] };
    let refs = array::concat([fields, dimensions, measures, times, relations, links, role_contract]);
    let item = point(id, brief.label, array::concat([brief.aliases, labels(brief.localized)]), brief.summary, refs);
    let entity = match array::find(payload.entities, fn(e) { e.id == brief.id }) {
        Some(e) => e, None => fail!("knowledge dataset disappeared from prepared model", brief.id),
    };
    let grain = match entity.dataset {
        Some(spec) => spec.grain,
        None => if entity.key_field >= 0 { [entity.fields[entity.key_field].name] } else { [] },
    };
    {...item, localized: brief.localized, grain, time_roles: brief.time_roles,
        references: brief.references, field_roles: brief.field_roles}
};

def dimension_point: Fn(edsl::PreparedPayload, String) -> Point = fn(payload, id) {
    let detail = edsl::visible_dimension_detail(payload, id);
    let parent = target(edsl::KnowledgeKind::Dataset, "", detail.dataset);
    let dimension = target(edsl::KnowledgeKind::Dimension, detail.dataset, detail.id);
    let value_refs = array::map(detail.values, fn(value) {
        member(target(edsl::KnowledgeKind::Value, detail.ty, value.id))
    });
    let operation_contracts = if detail.input_kinds == [edsl::FilterInputKind::Ipv4] {
        [member(syntax_target("graph/filter/capabilities")), member(syntax_target("model/ipv4_subnets"))]
    } else { [member(syntax_target("graph/filter/capabilities"))] };
    let entity = match array::find(payload.entities, fn(entity) { entity.id == detail.dataset }) {
        Some(entity) => entity, None => fail!("dimension owner missing", detail.dataset),
    };
    let field = match array::find(entity.fields, fn(field) { field.name == detail.field }) {
        Some(field) => field, None => fail!("dimension field missing", detail.field),
    };
    let bucket_contract = match property::get_field_prop(entity.entity_type, field.index, edsl::UtcBucketDimensionsDef.type) {
        Some(definition) => if array::any(definition.dimensions, fn(spec) { spec.id == detail.id }) {
            [member(syntax_target("operations/utc_time_bucket"))]
        } else { [] },
        None => [],
    };
    let contracts = array::concat([operation_contracts, bucket_contract, array::map(detail.input_kinds, input_type_ref)]);
    let base = point(dimension, detail.label, array::concat([detail.aliases, labels(detail.localized)]),
        detail.summary, array::concat([[member(parent), member(target(edsl::KnowledgeKind::Field, detail.dataset, detail.field)), member(type_target(detail.ty))], value_refs, contracts]));
    {...base, dimension: Some(detail), localized: detail.localized}
};

def measure_point: Fn(edsl::PreparedPayload, String) -> Point = fn(payload, id) {
    let detail = edsl::measure_detail(payload, id);
    let field_refs = match detail.field {
        Some(name) => [member(target(edsl::KnowledgeKind::Field, detail.dataset, name))], None => [],
    };
    let predicate_refs = match detail.predicate {
        None => [],
        Some(predicate) => do {
            let entity = match array::find(payload.entities, fn(entry) { entry.id == detail.dataset }) {
                Some(entry) => entry, None => fail!("measure predicate owner is not in the prepared model", id),
            };
            let field = match array::find(entity.fields, fn(entry) { entry.name == predicate.field }) {
                Some(entry) => entry, None => fail!("measure predicate field is not in the prepared model", id, predicate.field),
            };
            let dimension = match array::find(payload.dimensions, fn(entry) {
                entry.entity == entity.index && entry.field == field.index
            }) {
                Some(entry) => entry, None => fail!("measure predicate dimension is not in the prepared model", id, predicate.field),
            };
            let dimension_ref = target(edsl::KnowledgeKind::Dimension, detail.dataset, dimension.id);
            let business = edsl::visible_dimension_detail(payload, dimension.id);
            let value_ref = match (predicate.op, predicate.input) {
                (edsl::FilterOp::Eq, edsl::FilterInput::Text(name)) =>
                    if array::any(business.values, fn(value) { value.id == name }) {
                        [member(target(edsl::KnowledgeKind::Value, dimension.ty, name))]
                    } else { [] },
                _ => [],
            };
            array::concat([[member(dimension_ref)], value_ref])
        },
    };
    let computed_refs = match detail.computed {
        Some(computed) => [member(target(edsl::KnowledgeKind::Measure, detail.dataset, computed.left)),
            member(target(edsl::KnowledgeKind::Measure, detail.dataset, computed.right))],
        None => [],
    };
    let latest_refs = if detail.aggregate == Some(qb::AggregateFunction::Latest) {
        let dataset = edsl::dataset_domain(payload, detail.dataset);
        array::concat([[member(syntax_target("graph/latest"))],
            match dataset.utc_time {
                Some(name) => [member(target(edsl::KnowledgeKind::TimeRole, detail.dataset, name))], None => [],
            },
            array::map(dataset.grain, fn(name) { member(target(edsl::KnowledgeKind::Field, detail.dataset, name)) })])
    } else { [] };
    let refs = array::concat([
        [member(target(edsl::KnowledgeKind::Dataset, "", detail.dataset))],
        field_refs,
        array::map(detail.required_dataset_ids, fn(dataset) {
            member(target(edsl::KnowledgeKind::Dataset, "", dataset))
        }),
        predicate_refs, computed_refs, latest_refs,
    ]);
    let base = point(target(edsl::KnowledgeKind::Measure, detail.dataset, detail.id), detail.label,
        array::concat([detail.aliases, labels(detail.localized)]), detail.summary, refs);
    {...base, measure: Some(detail), localized: detail.localized}
};

def relation_point: Fn(edsl::PreparedPayload, String) -> Point = fn(payload, id) {
    let detail = edsl::relation_detail(payload, id);
    let guard_refs = match detail.guard {
        Some(guard) => [member(target(edsl::KnowledgeKind::Field, detail.from_dataset, guard.field))],
        None => [],
    };
    let base = point(target(edsl::KnowledgeKind::Relation, detail.from_dataset, detail.id), detail.label,
        array::concat([detail.aliases, labels(detail.localized)]), detail.summary,
        array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", detail.from_dataset)),
         traversable(target(edsl::KnowledgeKind::Dataset, "", detail.to_dataset))], guard_refs]));
    {...base, relation: Some(detail), localized: detail.localized}
};

def link_point: Fn(edsl::PreparedPayload, edsl::BusinessLinkEntry) -> Point = fn(payload, link) {
    let hub = payload.entities[link.hub].id;
    let participant = payload.entities[link.participant].id;
    let guard_refs = match link.guard {
        None => [],
        Some(pred) => [member(target(edsl::KnowledgeKind::Field, hub, pred.field))],
    };
    let note = match property::get_type_prop(payload.entities[link.hub].entity_type, edsl::BusinessLinkDescriptions.type) {
        Some(descriptions) => array::find(descriptions.notes, fn(note) { note.id == link.id }),
        None => None,
    };
    let base = point(target(edsl::KnowledgeKind::BusinessLink, hub, link.id),
        match note { Some(value) => value.label, None => link.id }, [],
        match note { Some(value) => value.summary, None => "" },
        array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", hub)),
         traversable(target(edsl::KnowledgeKind::Dataset, "", participant)),
         member(target(edsl::KnowledgeKind::Relation, hub, link.a_relation)),
         member(target(edsl::KnowledgeKind::Relation, hub, link.z_relation))], guard_refs]));
    {...base, direction: Some(link.direction), guard: link.guard}
};

def field_point: Fn(edsl::PreparedPayload, edsl::DatasetBrief, String) -> Point = fn(payload, brief, name) {
    let entity = match array::find(payload.entities, fn(entity) { entity.id == brief.id }) {
        Some(entity) => entity, None => fail!("published dataset missing", brief.id),
    };
    let item = point(target(edsl::KnowledgeKind::Field, brief.id, name), name, [], "",
        [member(target(edsl::KnowledgeKind::Dataset, "", brief.id))]);
    let field = match array::find(entity.fields, fn(field) { field.name == name }) {
        Some(field) => field, None => fail!("published field missing", brief.id, name),
    };
    {...item, nullable: field.nullable, logical_type: field.logical_type,
        refs: match field.logical_type {
            Some(kind) => match codec::encode(kind) {
                Value::String(name) => array::push(item.refs, member(type_target(name))),
                other => fail!("logical field type must encode as a name", other),
            }, None => item.refs,
        },
        roles: match array::find(brief.field_roles, fn(field) { field.field == name }) {
            Some(field) => field.roles, None => [],
        }, references: array::filter(brief.references, fn(ref) { array::any(ref.fields, fn(field) { field == name }) })}
};

def time_role_point: Fn(edsl::DatasetBrief, edsl::TimeRoleBrief) -> Point = fn(brief, role) {
    let base = point(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field), role.field, [], "",
        array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", brief.id)),
            member(target(edsl::KnowledgeKind::Field, brief.id, role.field))],
            array::map(role.dimension_ids, fn(id) {
                member(target(edsl::KnowledgeKind::Dimension, brief.id, id))
            }), [match codec::encode(role.logical_type) {
                Value::String(name) => member(type_target(name)),
                other => fail!("time logical type must encode as a name", other),
            }]]));
    {...base, time_role: Some(role)}
};

def dataset_members: Fn(edsl::PreparedPayload, edsl::DatasetBrief) -> Array(Point) = fn(payload, brief) {
    let fields = array::map(edsl::published_fields(payload, brief.id), fn(name) { field_point(payload, brief, name) });
    let dimensions = array::map(brief.dimension_ids, fn(id) { dimension_point(payload, id) });
    let measures = array::map(brief.measure_ids, fn(id) { measure_point(payload, id) });
    let relations = array::map(array::filter(payload.relations, fn(entry) {
        entry.id != "" && payload.entities[entry.from].id == brief.id
    }), fn(entry) { relation_point(payload, entry.id) });
    let times = array::map(brief.time_roles, fn(role) {
        time_role_point(brief, role)
    });
    let links = array::map(array::filter(payload.business_links, fn(link) {
        payload.entities[link.hub].id == brief.id
    }), fn(link) { link_point(payload, link) });
    array::concat([fields, dimensions, measures, relations, times, links])
};

def target_key: Fn(edsl::KnowledgeTarget) -> String = fn(id) {
    edsl::knowledge_key(id)
};

def visible_terms: Fn(edsl::PreparedPayload, Array(IndexEntry)) -> Array(edsl::TermAnnotation) =
    fn(payload, entries) {
        let declared = array::filter(array::flat_map(edsl::knowledge_annotation_types(payload), fn(ty) {
            match property::get_type_prop(ty, edsl::TermAnnotations.type) {
                Some(declared) => declared.entries, None => [],
            }
        }), fn(entry) { array::any(entries, fn(item) { item.key == entry.target }) });
        let aliases = array::flat_map(entries, fn(entry) {
            array::map(entry.aliases, fn(term) {
                {term, description: if entry.summary == "" { entry.label } else { entry.summary }, target: entry.key}.ty!(edsl::TermAnnotation)
            })
        });
        array::fold(array::concat([declared, aliases]), [].ty!(Array(edsl::TermAnnotation)), fn(seen, entry) {
            if array::any(seen, fn(other) { other.term == entry.term && other.target == entry.target }) { seen }
            else { array::push(seen, entry) }
        })
    };

# Materialize the same nodes as the public, cached lookup path.
def map: Fn(edsl::PreparedPayload) -> Array(Point) = fn(payload) {
    let index = index_from_model(payload);
    let declared_terms = array::flat_map(edsl::knowledge_annotation_types(payload), fn(ty) {
        match property::get_type_prop(ty, edsl::TermAnnotations.type) {
            Some(spec) => spec.entries, None => [],
        }
    });
    let datasets = edsl::visible_knowledge_index(payload);
    let domain = array::concat([
        array::map(datasets, fn(brief) { dataset_point(payload, brief) }),
        array::flat_map(datasets, fn(brief) { dataset_members(payload, brief) }),
    ]);
    let docs = array::flat_map(edsl::knowledge_annotation_types(payload), fn(ty) {
        match property::get_type_prop(ty, edsl::KnowledgeDocs.type) {
            Some(declared) => declared.entries, None => [],
        }
    });
    let related = array::flat_map(edsl::knowledge_annotation_types(payload), fn(ty) {
        match property::get_type_prop(ty, edsl::KnowledgeRelations.type) {
            Some(declared) => declared.entries, None => [],
        }
    });
    let keys = dict::from_pairs(array::map(index.entries, fn(entry) { (target_key(entry.key), True) }));
    let raw = array::concat([syntax_points, type_points, array::map(domain, fn(item) {
        let refs = array::concat([item.refs, array::map(array::filter(related, fn(ref) {
            ref.source == item.target && dict::get(keys, target_key(ref.target)) != None
        }), fn(ref) { {target: ref.target, kind: LinkKind::Related} })]);
        let summary = match array::find(docs, fn(note) { note.target == item.target }) {
            Some(note) => note.text, None => item.summary,
        };
        {...item, refs, summary}
    }), array::map(dict::keys(index.points), fn(key) { match dict::get(index.points, key) {
        Some(item) => item, None => fail!("cached knowledge point disappeared", key),
    } })]);
    let visible = dict::from_pairs(array::map(raw, fn(item) { (target_key(item.target), True) }));
    if let Some(dangling) = array::find(raw, fn(item) {
        array::any(item.refs, fn(ref) {
            dict::get(visible, target_key(ref.target)) == None
        })
    }) { fail!("knowledge point references a point outside the visible model", dangling.target) }
    else { array::map(raw, fn(item) { {...item, terms: array::filter(declared_terms, fn(term) { term.target == item.target })} }) }
};

def index_entries: Fn(Array(Point)) -> KnowledgeIndex = fn(points) {
    {entries: array::map(points, fn(item) {
        {key: item.target, label: item.label, aliases: item.aliases, summary: item.summary, from: None, to: None}
    }), targets: {}, points: {}, datasets: {}, summaries: {}, related: {}, terms: {}}
};

def index_entry: Fn(edsl::KnowledgeTarget, String, Array(String), String) -> IndexEntry = fn(key, label, aliases, summary) {
    {key, label, aliases, summary, from: None, to: None}
};

def index_from_model: Fn(edsl::PreparedPayload) -> KnowledgeIndex = fn(payload) {
    let datasets = edsl::visible_knowledge_index(payload);
    let roots = array::map(datasets, fn(brief) {
        index_entry(target(edsl::KnowledgeKind::Dataset, "", brief.id), brief.label,
            array::concat([brief.aliases, labels(brief.localized)]), brief.summary)
    });
    let members = array::flat_map(datasets, fn(brief) {
        let fields = array::map(edsl::published_fields(payload, brief.id), fn(name) {
            index_entry(target(edsl::KnowledgeKind::Field, brief.id, name), name, [], "")
        });
        let dimensions = array::map(brief.dimension_ids, fn(id) {
            let detail = edsl::visible_dimension_detail(payload, id);
            index_entry(target(edsl::KnowledgeKind::Dimension, brief.id, id),
                detail.label, array::concat([detail.aliases, labels(detail.localized)]), detail.summary)
        });
        let measures = array::map(brief.measure_ids, fn(id) {
            let detail = edsl::measure_detail(payload, id);
            index_entry(target(edsl::KnowledgeKind::Measure, brief.id, id), detail.label,
                array::concat([detail.aliases, labels(detail.localized)]), detail.summary)
        });
        let relations = array::map(array::filter(payload.relations, fn(entry) {
            entry.id != "" && payload.entities[entry.from].id == brief.id
        }), fn(entry) {
            let detail = edsl::relation_detail(payload, entry.id);
            {...index_entry(target(edsl::KnowledgeKind::Relation, brief.id, entry.id), detail.label,
                array::concat([detail.aliases, labels(detail.localized)]), detail.summary),
                from: Some(target(edsl::KnowledgeKind::Dataset, "", payload.entities[entry.from].id)),
                to: Some(target(edsl::KnowledgeKind::Dataset, "", payload.entities[entry.to].id))}
        });
        let times = array::map(brief.time_roles, fn(role) {
            index_entry(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field), role.field, [], "")
        });
        let links = array::map(array::filter(payload.business_links, fn(link) {
            payload.entities[link.hub].id == brief.id
        }), fn(link) {
            let detail = link_point(payload, link);
            {...index_entry(detail.target, detail.label, detail.aliases, detail.summary),
                from: Some(target(edsl::KnowledgeKind::Dataset, "", brief.id)),
                to: Some(target(edsl::KnowledgeKind::Dataset, "", payload.entities[link.participant].id))}
        });
        array::concat([fields, dimensions, measures, relations, times, links])
    });
    let docs = array::flat_map(edsl::knowledge_annotation_types(payload), fn(ty) {
        match property::get_type_prop(ty, edsl::KnowledgeDocs.type) {
            Some(declared) => declared.entries, None => [],
        }
    });
    let typed = value_type_points(payload);
    let entries = array::map(array::concat([index_entries(syntax_points).entries, index_entries(type_points).entries, index_entries(typed).entries, roots, members]), fn(entry) {
        match array::find(docs, fn(note) { note.target == entry.key }) {
            Some(note) => {...entry, summary: note.text}, None => entry,
        }
    });
    let keys = dict::from_pairs(array::map(entries, fn(entry) { (target_key(entry.key), True) }));
    if array::length(dict::keys(keys)) != array::length(entries) {
        fail!("knowledge keys must identify exactly one visible node", entries)
    } else {
        let root = index_point(payload);
        let catalog = array::concat([entries, index_entries([root]).entries]);
        let summaries = array::fold(array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeDocs.type) {
                Some(declared) => declared.entries, None => [],
            }
        }), {}.ty!(Dict(String)), fn(seen, note) {
            let key = target_key(note.target);
            if dict::get(seen, key) != None { seen }
            else { dict::merge(seen, dict::from_pairs([(key, note.text)])) }
        });
        let related = array::fold(array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeRelations.type) {
                Some(declared) => declared.entries, None => [],
            }
        }), {}.ty!(Dict(Array(KnowledgeLink))), fn(seen, ref) {
            if dict::get(keys, target_key(ref.target)) == None { seen }
            else {
                let key = target_key(ref.source);
                let refs = match dict::get(seen, key) { Some(items) => items, None => [] };
                dict::merge(seen, dict::from_pairs([(key, array::push(refs, {target: ref.target, kind: LinkKind::Related}))]))
            }
        });
        let terms = array::fold(array::flat_map(edsl::knowledge_annotation_types(payload), fn(ty) {
            match property::get_type_prop(ty, edsl::TermAnnotations.type) {
                Some(spec) => spec.entries, None => [],
            }
        }), {}.ty!(Dict(Array(edsl::TermAnnotation))), fn(seen, term) {
            let key = target_key(term.target);
            let items = match dict::get(seen, key) { Some(items) => items, None => [] };
            dict::merge(seen, dict::from_pairs([(key, array::push(items, term))]))
        });
        {entries: catalog,
            datasets: dict::from_pairs(array::map(datasets, fn(brief) { (brief.id, brief) })),
            summaries, related, terms,
            targets: dict::from_pairs(array::map(catalog, fn(entry) { (target_key(entry.key), entry.key) })),
            points: dict::from_pairs(array::map(array::concat([[root], typed]), fn(item) {
                let summary = match array::find(docs, fn(note) { note.target == item.target }) {
                    Some(note) => note.text, None => item.summary,
                };
                (target_key(item.target), {...item, summary})
            }))}
    }
};

def distinct_text: Fn(Array(String)) -> Array(String) = fn(items) {
    array::fold(items, [].ty!(Array(String)), fn(seen, item) {
        if item == "" || array::any(seen, fn(other) { other == item }) { seen }
        else { array::push(seen, item) }
    })
};

def terminology_entry: Fn(IndexEntry, Array(edsl::TermAnnotation), Array(String)) -> DatasetTerm = fn(entry, terms, localized_docs) {
    let matching = array::filter(terms, fn(term) { term.target == entry.key });
    let aliases = distinct_text(array::concat([[entry.label], entry.aliases, array::map(matching, fn(term) { term.term })]));
    {name: entry.key.id,
        doc: string::join(distinct_text(array::concat([[entry.summary], localized_docs, array::map(matching, fn(term) { term.description })])), "\n"),
        aliases: array::filter(aliases, fn(alias) { alias != entry.key.id })}
};

def terminology_from_catalog: Fn(edsl::PreparedPayload, KnowledgeIndex) -> TerminologyIndex = fn(payload, index) {
    let terms = visible_terms(payload, index.entries);
    let datasets = edsl::visible_knowledge_index(payload);
    {revision: payload.revision,
        types: array::map(array::filter(index.entries, fn(entry) {
            entry.key.kind == edsl::KnowledgeKind::Ty && dict::get(index.points, target_key(entry.key)) != None
        }), fn(entry) { terminology_entry(entry, terms, []) }),
        datasets: array::map(array::filter(index.entries, fn(entry) { entry.key.kind == edsl::KnowledgeKind::Dataset }),
            fn(entry) {
                let brief = match array::find(datasets, fn(brief) { brief.id == entry.key.id }) {
                    Some(brief) => brief, None => fail!("terminology dataset disappeared", entry.key),
                };
                terminology_entry(entry, terms, array::map(brief.localized, fn(text) { text.summary }))
            }),
        dimensions: array::map(array::filter(index.entries, fn(entry) { entry.key.kind == edsl::KnowledgeKind::Dimension }), fn(entry) {
            let detail = edsl::visible_dimension_detail(payload, entry.key.id);
            let text = terminology_entry(entry, terms, array::map(detail.localized, fn(text) { text.summary }));
            {dataset: entry.key.owner, name: text.name, doc: text.doc, aliases: text.aliases}.ty!(DimensionTerm)
        }),
        measures: array::map(array::filter(index.entries, fn(entry) { entry.key.kind == edsl::KnowledgeKind::Measure }), fn(entry) {
            let detail = edsl::measure_detail(payload, entry.key.id);
            let text = terminology_entry(entry, terms, array::map(detail.localized, fn(text) { text.summary }));
            {dataset: entry.key.owner, name: text.name, doc: text.doc, aliases: text.aliases}.ty!(MeasureTerm)
        }),
        values: array::map(array::filter(index.entries, fn(entry) { entry.key.kind == edsl::KnowledgeKind::Value }), fn(entry) {
            let text = terminology_entry(entry, terms, []);
            {ty: entry.key.owner, name: text.name, doc: text.doc, aliases: text.aliases}.ty!(ValueTerm)
        }),
        rels: array::map(array::filter(index.entries, fn(entry) { entry.key.kind == edsl::KnowledgeKind::Relation }), fn(entry) {
            let detail = edsl::relation_detail(payload, entry.key.id);
            let text = terminology_entry(entry, terms, array::map(detail.localized, fn(text) { text.summary }));
            {name: text.name, doc: text.doc, aliases: text.aliases}.ty!(RelationTerm)
        })}
};

def terminology_from_model: Fn(edsl::PreparedPayload) -> TerminologyIndex = fn(payload) {
    terminology_from_catalog(payload, index_from_model(payload))
};

def links_from_model: Fn(edsl::PreparedPayload) -> LinksIndex = fn(payload) {
    {revision: payload.revision, links: array::flat_map(map(payload), fn(item) {
        let unique = array::fold(item.refs, {}.ty!(Dict(KnowledgeLink)), fn(seen, ref) {
            let key = json::stringify(codec::encode((target_key(ref.target), ref.kind)));
            if dict::get(seen, key) != None { seen }
            else { dict::merge(seen, dict::from_pairs([(key, ref)])) }
        });
        array::map(dict::values(unique), fn(ref) {
            {source: target_key(item.target), target: target_key(ref.target), kind: ref.kind}.ty!(LinkEntry)
        })
    })}.ty!(LinksIndex)
};

def raw_point_from_model: Fn(edsl::PreparedPayload, KnowledgeIndex, edsl::KnowledgeTarget) -> DocResult =
    fn(payload, index, key) {
        if dict::get(index.targets, target_key(key)) != Some(key) { DocResult::NotFound }
        else if let Some(item) = dict::get(index.points, target_key(key)) {
            DocResult::Found(item)
        } else if key.kind == edsl::KnowledgeKind::Ty {
            match array::find(type_points, fn(item) { item.target == key }) {
                Some(item) => DocResult::Found(item), None => fail!("knowledge data type disappeared", key),
            }
        } else if key.kind == edsl::KnowledgeKind::Schema {
            match array::find(syntax_points, fn(item) { item.target == key }) {
                Some(item) => DocResult::Found(item),
                None => fail!("knowledge schema key has no point", key),
            }
        } else {
            let owner = if key.kind == edsl::KnowledgeKind::Dataset { key.id } else { key.owner };
            let brief = match dict::get(index.datasets, owner) {
                Some(entry) => entry,
                None => fail!("knowledge key owner disappeared from prepared model", key),
            };
            let raw = match key.kind {
                edsl::KnowledgeKind::Dataset => dataset_point(payload, brief),
                edsl::KnowledgeKind::Field => field_point(payload, brief, key.id),
                edsl::KnowledgeKind::Dimension => dimension_point(payload, key.id),
                edsl::KnowledgeKind::Measure => measure_point(payload, key.id),
                edsl::KnowledgeKind::Relation => relation_point(payload, key.id),
                edsl::KnowledgeKind::TimeRole => match array::find(brief.time_roles, fn(role) { role.field == key.id }) {
                    Some(role) => time_role_point(brief, role),
                    None => fail!("knowledge time role disappeared", key),
                },
                edsl::KnowledgeKind::BusinessLink => match array::find(payload.business_links, fn(link) {
                    link.id == key.id && payload.entities[link.hub].id == key.owner
                }) {
                    Some(link) => link_point(payload, link),
                    None => fail!("knowledge business link disappeared", key),
                },
                _ => fail!("knowledge key has no point in prepared model", key),
            };
            let refs = array::concat([raw.refs, match dict::get(index.related, target_key(key)) {
                Some(items) => items, None => [],
            }]);
            let summary = match dict::get(index.summaries, target_key(key)) {
                Some(text) => text, None => raw.summary,
            };
            DocResult::Found({...raw, refs, summary})
        }
    };

def point_from_model: Fn(edsl::PreparedPayload, KnowledgeIndex, edsl::KnowledgeTarget) -> DocResult = fn(payload, index, key) {
    match raw_point_from_model(payload, index, key) {
        DocResult::NotFound => DocResult::NotFound,
        DocResult::Found(item) => {
            let terms = if key.kind == edsl::KnowledgeKind::Index || key.kind == edsl::KnowledgeKind::Schema { [] }
                else { match dict::get(index.terms, target_key(key)) {
                    Some(items) => items, None => [],
                } };
            DocResult::Found({...item, terms})
        },
    }
};

def by_target: Fn(edsl::PreparedPayload, edsl::KnowledgeTarget) -> DocResult = fn(payload, id) {
    point_from_model(payload, index_from_model(payload), id)
};

def knowledge_lookup_factory: Fn(edsl::PreparedPayload) -> Fn(edsl::KnowledgeTarget) -> DocResult = fn(payload) {
    let index = index_from_model(payload);
    fn(id) { point_from_model(payload, index, id) }
};

def decode_request: for(A: codec::Decode) Fn(Value, String) -> A = fn(value, contract) {
    match codec::decode@[A](value) {
        Ok(decoded) => decoded,
        Err(error) => raise!(blame::with_context(error,
            `see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", contract)}`)),
    }
};

def point_from_key: Fn(edsl::PreparedPayload, KnowledgeIndex, String) -> DocResult =
    fn(payload, index, key) {
        match dict::get(index.targets, key) {
            Some(target) => point_from_model(payload, index, target),
            None => DocResult::NotFound,
        }
    };

# The caller binds a domain to its prepared model.
def serve_catalog: Fn(edsl::PreparedPayload, KnowledgeIndex, String, Value) -> KnowledgeResponse =
    fn(payload, index, domain, request) {
    if domain == "" { fail!("knowledge domain must not be empty") } else { () };
    let envelope = decode_request@[KnowledgeRequest](request, "syntax/knowledge/request");
    if envelope.method == `\{domain}/info` {
        let input = decode_request@[InfoInput](envelope.input, "syntax/knowledge/info");
        KnowledgeResponse::Document(point_from_key(payload, index, input.key))
    } else { fail!(`unknown knowledge method for domain; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/knowledge/request")}`, envelope.method, domain) }
};

def serve: Fn(edsl::PreparedPayload, String, Value) -> KnowledgeResponse = fn(payload, domain, request) {
    serve_catalog(payload, index_from_model(payload), domain, request)
};

def object_value: Fn(Array((String, Value))) -> Value = fn(fields) {
    Value::Object(dict::from_pairs(fields))
};

type KeyPattern = struct { kind: edsl::KnowledgeKind, pattern: String };
type VocabularyEntry = struct { kind: edsl::KnowledgeKind, group: String, owner: Option(String), require: Option(String) };
type IndexDetail = struct { revision: String, schemas: Array(String), key_patterns: Array(KeyPattern), encoding: String };
type DiscoveryDetail = struct { revision: String, roots: Array(String), key_patterns: Array(KeyPattern), vocabulary: Array(VocabularyEntry) };
def vocabulary: Array(VocabularyEntry) = [
    {kind: edsl::KnowledgeKind::Dataset, group: "datasets", owner: None, require: None},
    {kind: edsl::KnowledgeKind::Dimension, group: "dimensions", owner: Some("dataset"), require: None},
    {kind: edsl::KnowledgeKind::Measure, group: "measures", owner: Some("dataset"), require: None},
    {kind: edsl::KnowledgeKind::Relation, group: "rels", owner: None, require: None},
    {kind: edsl::KnowledgeKind::Ty, group: "types", owner: None, require: Some("storage")},
    {kind: edsl::KnowledgeKind::Value, group: "values", owner: Some("ty"), require: None},
    {kind: edsl::KnowledgeKind::BusinessLink, group: "business_links", owner: Some("hub"), require: None},
];
def key_patterns: Array(KeyPattern) = array::map([
    (edsl::KnowledgeKind::Dataset, "Dataset/{dataset}"),
    (edsl::KnowledgeKind::Field, "Field/{dataset}/{field}"),
    (edsl::KnowledgeKind::Dimension, "Dimension/{dataset}/{dimension}"),
    (edsl::KnowledgeKind::Measure, "Measure/{dataset}/{measure}"),
    (edsl::KnowledgeKind::Relation, "Relation/{relation}"),
    (edsl::KnowledgeKind::Ty, "Ty/{ty}"),
    (edsl::KnowledgeKind::Value, "Value/{ty}/{value}"),
    (edsl::KnowledgeKind::TimeRole, "TimeRole/{dataset}/{field}"),
    (edsl::KnowledgeKind::BusinessLink, "BusinessLink/{hub}/{link}"),
], fn(entry) { {kind: entry.0, pattern: entry.1} });

def owned_detail: for(A: codec::Encode) Fn(String, A) -> Value = fn(dataset, detail) {
    match codec::encode(detail) {
        Value::Object(fields) => Value::Object(dict::merge(fields, {dataset: Value::String(dataset)})),
        other => fail!("Model knowledge detail must be a record", other),
    }
};

def node_value: Fn(Point) -> Value = fn(item) {
    let detail = match item.target.kind {
        edsl::KnowledgeKind::Index => codec::encode({revision: item.revision,
            schemas: array::map(match item.entries { Some(entries) => entries, None => [] }, fn(entry) { target_key(entry.key) }),
            key_patterns, encoding: "Encode each canonical name as one URI component exactly once. Schema keys use Schema/syntax/{path}; encode each path segment. Returned keys are complete and can be passed directly to info."}.ty!(IndexDetail)),
        edsl::KnowledgeKind::Dataset => codec::encode({id: item.target.id, grain: item.grain, time_roles: item.time_roles,
            references: item.references, field_roles: item.field_roles}.ty!(DatasetDetail)),
        edsl::KnowledgeKind::Field => codec::encode({id: item.target.id, dataset: item.target.owner, nullable: item.nullable, logical_type: item.logical_type, roles: item.roles,
            reference_ids: array::map(item.references, fn(ref) { ref.id })}.ty!(FieldDetail)),
        edsl::KnowledgeKind::Ty => match item.value_type {
            Some(spec) => codec::encode({id: spec.id, label: spec.label, summary: spec.summary,
                storage: spec.storage, half_open: spec.half_open, canonical_order: spec.canonical_order,
                values: array::map(spec.values, fn(value) {
                    let wires = match array::find(spec.mapping, fn(member) { member.id == value.id }) {
                        Some(member) => member.wires, None => [],
                    };
                    {id: value.id, label: value.label, aliases: value.aliases, localized: value.localized, wires}.ty!(TypeValueDetail)
                })}.ty!(ValueTypeDetail)),
            None => object_value([("id", Value::String(item.target.id))]),
        },
        edsl::KnowledgeKind::Value => codec::encode({id: item.target.id, ty: item.target.owner,
            wires: match item.value { Some(value) => value.wires, None => [] }}.ty!(ValueDetail)),
        edsl::KnowledgeKind::Dimension => match item.dimension {
            Some(value) => codec::encode(value), None => object_value([]),
        },
        edsl::KnowledgeKind::Measure => match item.measure {
            Some(value) => codec::encode(value), None => object_value([]),
        },
        edsl::KnowledgeKind::Relation => match item.relation {
            Some(value) => codec::encode(value), None => object_value([]),
        },
        edsl::KnowledgeKind::TimeRole => match item.time_role {
            Some(value) => owned_detail(item.target.owner, value), None => object_value([]),
        },
        edsl::KnowledgeKind::BusinessLink => codec::encode({id: item.target.id, hub: item.target.owner,
            direction: item.direction, guard: item.guard}.ty!(BusinessLinkDetail)),
        _ => object_value([]),
    };
    object_value([
        ("key", Value::String(target_key(item.target))),
        ("type", codec::encode(item.target.kind)),
        ("description", codec::encode({label: item.label, aliases: item.aliases, localized: item.localized, summary: item.summary,
            terms: array::map(item.terms, fn(term) { {term: term.term, description: term.description}.ty!(TermText) })}.ty!(Description))),
        ("links", codec::encode(array::map(item.refs, fn(ref) {
            object_value([("type", codec::encode(ref.kind)), ("key", Value::String(target_key(ref.target)))])
        }))),
        ("detail", detail),
    ])
};

def encode_response: Fn(KnowledgeResponse) -> Value = fn(response) {
    match response {
        KnowledgeResponse::Document(document) => match document {
            DocResult::Found(item) =>
                object_value([("Document", object_value([("Found", node_value(item))]))]),
            DocResult::NotFound => object_value([("Document", Value::String("NotFound"))]),
        },
    }
};

def serve_value: Fn(edsl::PreparedPayload, String, Value) -> Value = fn(payload, domain, request) {
    encode_response(serve(payload, domain, request))
};

def knowledge_service_factory: Fn(edsl::PreparedPayload, String) -> Fn(Value) -> Value =
    fn(payload, domain) {
        let index = index_from_model(payload);
        fn(request) { encode_response(serve_catalog(payload, index, domain, request)) }
    };

# The collection selects the slot; this handler receives only its input.
def knowledge_info_method_factory: Fn(edsl::PreparedPayload) -> Fn(Value) -> Value =
    fn(payload) {
        let index = index_from_model(payload);
        fn(input) {
            let request = decode_request@[InfoInput](input, "syntax/knowledge/info");
            encode_response(KnowledgeResponse::Document(point_from_key(payload,
                index, request.key)))
        }
    };

def discovery_keys: Fn(edsl::PreparedPayload) -> Array(String) = fn(payload) {
    let datasets = edsl::visible_knowledge_index(payload);
    let visible = dict::from_pairs(array::map(datasets, fn(dataset) { (dataset.id, True) }));
    array::concat([
        array::map(datasets, fn(dataset) { target_key(target(edsl::KnowledgeKind::Dataset, "", dataset.id)) }),
        array::map(array::filter(payload.relations, fn(relation) {
            relation.id != "" && dict::get(visible, payload.entities[relation.from].id) != None
        }), fn(relation) { target_key(target(edsl::KnowledgeKind::Relation, "", relation.id)) }),
    ])
};

def knowledge_discovery_method_factory: Fn(edsl::PreparedPayload) -> Fn(Value) -> Value = fn(payload) {
    let detail: DiscoveryDetail = {revision: payload.revision, roots: discovery_keys(payload), key_patterns, vocabulary};
    let response = codec::encode(detail);
    fn(input) {
        let request = decode_request@[DiscoveryInput](input, "syntax/knowledge/discovery");
        response
    }
};

pub use self::{ LinkKind, KnowledgeLink, Point, IndexEntry, KnowledgeIndex, DocResult, KnowledgeResponse,
    Description, TermText, NodeLink, Node, NodeResult, NodeResponse, node_value,
    DatasetDetail, FieldDetail, ValueDetail, TypeValueDetail, ValueTypeDetail, BusinessLinkDetail, KeyPattern, IndexDetail, DiscoveryDetail, VocabularyEntry,
    map, index_entries, index_from_model, by_target, knowledge_lookup_factory, serve, serve_value,
    DatasetTerm, DimensionTerm, MeasureTerm, ValueTerm, RelationTerm, TerminologyIndex, terminology_from_model,
    LinkEntry, LinksIndex, links_from_model,
    discovery_keys, knowledge_discovery_method_factory,
    knowledge_service_factory, knowledge_info_method_factory };
