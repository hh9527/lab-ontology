    ori_res_id: Option(String),
    @m::column("poolUid")
    @g::field_view(g::dimension_group("lun/pool_uid", String.type, True, [g::Filter::Eq]), "lu_pool_uid", True, [g::Filter::Eq])
    pool_uid: Option(String),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("lun/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "lu_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("protectionCapacity")
    @g::field_view(g::dimension_group("lun/protection_capacity", String.type, True, [g::Filter::Eq]), "lu_protection_capacity", True, [g::Filter::Eq])
    protection_capacity: Option(String),
    @m::column("allocCapacity")
    @g::field_view(g::dimension_group("lun/alloc_capacity", Float.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "lu_alloc_capacity", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    alloc_capacity: Option(Float),
    @m::column("totalCapacity")
    @g::field_view(g::dimension_group("lun/total_capacity", Float.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "lu_total_capacity", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    total_capacity: Option(Float),
    @m::column("WWN")
    @g::field_view(g::dimension_group("lun/wwn", String.type, True, [g::Filter::Eq]), "lu_wwn", True, [g::Filter::Eq])
