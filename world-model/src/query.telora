# world-model/src/query.telora
#
# Deterministic closed intent resolver for world_1.  Decodes the INTENT JSON
# (docs/INTENT.md), validates it against the prepared knowledge payload,
# lowers it through the ontology eDSL and returns a parameterized SQLite
# Query ({sql, bindings}).  All dynamic values stay in bindings.
#
# The public intent is a tagged, closed request family:
#   {'Ordinary(...)}             -> projection/filter/aggregate/ordering
#   {'DistinctDimensions(...)}   -> measureless dimension request lowered
#                                    with foundation `lower_distinct`
#   {'HiddenRowOrder(...)}       -> measureless row list sorted by one
#                                    authorized numeric dimension that is NOT
#                                    projected (hidden row-order)
#   {'HiddenAggregateOrder(...)} -> grouped listing sorted by one authorized
#                                    simple aggregate on the same base entity
#                                    that is NOT projected (hidden internal
#                                    aggregate ordering)
# All variants share one vocabulary/type validator and keep returned columns
# exactly equal to the requested projection in documented order.

import "ontology/edsl" as edsl;
import "ontology/query" as qb;
import "std/array" as array;
import "std/json" as json;
import "std/codec" as codec;
import "std/value" { ScalarValue, Value };

type IntentMeasure = struct {
    id: String,
    mode: String,
};

type IntentDimension = struct {
    id: String,
};

type IntentFilter = struct {
    id: String,
    op: String,
    value: ScalarValue,
};

type IntentOrder = struct {
    measure: Option(String),
    dimension: Option(String),
    direction: String,
};

# A closed public output token: references exactly one *requested* measure id or
# one *requested* dimension id.  Empty `output_order` keeps the legacy order
# (dimensions then measures); a non-empty order is exact.
type OutputToken = enum {
    'Measure(String),
    'Dimension(String),
};

# `ordinary`: the classic request shape (measures may be empty).
type OrdinaryIntent = struct {
    measures: Array(IntentMeasure),
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    order: Array(IntentOrder),
    limit: Option(Int),
    offset: Option(Int),
    output_order: Array(OutputToken),
};

# `distinct_dimensions`: a measureless dimension request; every returned row is
# a distinct combination of the requested dimensions.  No count measure is ever
# invented or projected.
type DistinctDimensionsIntent = struct {
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    order: Array(IntentOrder),
    limit: Option(Int),
    offset: Option(Int),
};

# `hidden_row_order`: a measureless row listing that projects `dimensions` while
# sorting (and optionally limiting) by one authorized numeric dimension
# `sort_by` that is never projected.
type HiddenRowOrderIntent = struct {
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    sort_by: String,
    direction: String,
    limit: Option(Int),
    offset: Option(Int),
};

# `hidden_aggregate_order`: a grouped listing that projects `dimensions` while
# sorting (and optionally limiting) by one authorized simple aggregate measure
# `sort_by` on the same base entity that is never projected.
type HiddenAggregateOrderIntent = struct {
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    sort_by: String,
    direction: String,
    limit: Option(Int),
    offset: Option(Int),
};

# Related predicate for `related_exists` / `related_absent`: a closed semantic
# target entity id and ordered filters over dimensions belonging to that target.
type RelatedClause = struct {
    target: String,
    filters: Array(IntentFilter),
    min_matches: Option(Int),
};

# `related_exists`: keep an outer country row/group when the declared related
# target has at least one matching record (correlated EXISTS).
type RelatedExistsIntent = struct {
    measures: Array(IntentMeasure),
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    order: Array(IntentOrder),
    limit: Option(Int),
    offset: Option(Int),
    related: RelatedClause,
    output_order: Array(OutputToken),
};

# `related_absent`: keep an outer country row/group when no matching related
# record exists (correlated NOT EXISTS).
type RelatedAbsentIntent = struct {
    measures: Array(IntentMeasure),
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    order: Array(IntentOrder),
    limit: Option(Int),
    offset: Option(Int),
    related: RelatedClause,
    output_order: Array(OutputToken),
};

# `set_combine` / `set_count`: combine two independently validated compatible
# ordinary operands with one closed set kind ('intersect' | 'except' | 'union').
# `set_count` returns only the cardinality of the resulting set.
type SetOperandIntent = struct {
    kind: String,
    left: OrdinaryIntent,
    right: OrdinaryIntent,
};

# One operand of `related_set_combine` / `related_set_count`: an outer Country
# listing (one or more projected Country dimensions + ordered outer filters)
# qualified by exactly one `RelatedClause` (correlated EXISTS over a declared
# Country -> related-target route).  Intentionally dimension-only: no measures,
# ordering, pagination, or open query body.
type RelatedSetOperand = struct {
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    related: RelatedClause,
};

# `related_set_combine` / `related_set_count`: apply a closed set kind to two
# independently lowered, related-qualified Country listings.  `related_set_count`
# returns only the cardinality of the resulting set.
type RelatedSetIntent = struct {
    kind: String,
    left: RelatedSetOperand,
    right: RelatedSetOperand,
};

# A single aggregate-result predicate: one measure id, one closed comparison
# operator (eq/ne/lt/le/gt/ge) and one typed numeric threshold.
type HavingPredicate = struct {
    measure: String,
    op: String,
    threshold: ScalarValue,
};

# `selected_having`: an aggregate/grouped ordinary request plus ordered
# predicates over measures that are already selected (projected).
type SelectedHavingIntent = struct {
    measures: Array(IntentMeasure),
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    order: Array(IntentOrder),
    limit: Option(Int),
    offset: Option(Int),
    having: Array(HavingPredicate),
    output_order: Array(OutputToken),
};

# `hidden_having`: an aggregate/grouped request plus ordered predicates over
# authorized simple aggregates on the same base entity that are NOT selected.
# Hidden measures never enter SELECT.
type HiddenHavingIntent = struct {
    measures: Array(IntentMeasure),
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    order: Array(IntentOrder),
    limit: Option(Int),
    offset: Option(Int),
    having: Array(HavingPredicate),
    output_order: Array(OutputToken),
};

# A single numeric outer-attribute versus scalar-aggregate comparison:
# attribute id (authorized plain numeric dimension on the outer base entity),
# one closed comparison operator, an authorized plain numeric measure id, and
# ordered `scope_filters` that restrict only the inner aggregate's rows (empty
# array = the global aggregate).
type AttributeComparePredicate = struct {
    attribute: String,
    op: String,
    measure: String,
    scope_filters: Array(IntentFilter),
};

# `attribute_aggregate_compare`: a measureless row listing (>= 1 projected
# dimension) kept when a numeric outer attribute compares to one scalar
# aggregate.  Comparisons affect row qualification only; neither the compared
# attribute nor the inner aggregate becomes an output column.
type AttributeAggregateCompareIntent = struct {
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    order: Array(IntentOrder),
    limit: Option(Int),
    offset: Option(Int),
    comparisons: Array(AttributeComparePredicate),
};

# Related clause for `related_hidden_row_order`: a target entity id and ordered
# filters over dimensions belonging to that target (multi-hop qualification).
type RelatedHiddenClause = struct {
    target: String,
    filters: Array(IntentFilter),
};

# `related_hidden_row_order`: a City row listing that projects City dimensions
# while ranking by one hidden numeric City attribute AND keeping only rows whose
# declared related target (through the City -> Country -> CountryLanguage route)
# has a matching record.  The qualifier lowers as a correlated EXISTS; the outer
# City grain is preserved (no synthetic direct City-CountryLanguage join).
type RelatedHiddenRowOrderIntent = struct {
    dimensions: Array(IntentDimension),
    filters: Array(IntentFilter),
    sort_by: String,
    direction: String,
    limit: Option(Int),
    offset: Option(Int),
    related: RelatedHiddenClause,
};

# Tagged, closed request family.  Unknown tags are rejected at decode time.
type Intent = enum {
    'Ordinary(OrdinaryIntent),
    'DistinctDimensions(DistinctDimensionsIntent),
    'HiddenRowOrder(HiddenRowOrderIntent),
    'HiddenAggregateOrder(HiddenAggregateOrderIntent),
    'RelatedExists(RelatedExistsIntent),
    'RelatedAbsent(RelatedAbsentIntent),
    'SetCombine(SetOperandIntent),
    'SetCount(SetOperandIntent),
    'SelectedHaving(SelectedHavingIntent),
    'HiddenHaving(HiddenHavingIntent),
    'AttributeAggregateCompare(AttributeAggregateCompareIntent),
    'RelatedHiddenRowOrder(RelatedHiddenRowOrderIntent),
    'RelatedSetCombine(RelatedSetIntent),
    'RelatedSetCount(RelatedSetIntent),
};

def subject: String = "public";

# --- payload lookup helpers -------------------------------------------------

def find_measure: Fn(edsl.PreparedPayload, String) -> Option(edsl.MeasureEntry) = fn(payload, id) {
    array.find(payload.measures, fn(m) { m.id == id })
};

def find_dimension: Fn(edsl.PreparedPayload, String) -> Option(edsl.DimensionEntry) = fn(payload, id) {
    array.find(payload.dimensions, fn(d) { d.id == id })
};

def entity_id_at: Fn(edsl.PreparedPayload, Int) -> String = fn(payload, index) {
    match array.get(payload.entities, index) {
        'Some(e) => e.id,
        'None => "",
    }
};

def entity_index_of_id: Fn(edsl.PreparedPayload, String) -> Int = fn(payload, id) {
    let found = array.find(array.enumerate(payload.entities), fn(pair) {
        match pair {
            (_, e) => e.id == id,
        }
    });
    match found {
        'Some(pair) => match pair {
            (i, _) => i,
        },
        'None => -1,
    }
};

def contains_id: Fn(Array(String), String) -> Bool = fn(items, id) {
    array.any(items, fn(x) { x == id })
};

def dimension_ids_of: Fn(Array(IntentDimension)) -> Array(String) = fn(dimensions) {
    array.map(dimensions, fn(d) { d.id })
};

def measure_ids_of: Fn(Array(IntentMeasure)) -> Array(String) = fn(measures) {
    array.map(measures, fn(m) { m.id })
};

def first_dimension_entity: Fn(edsl.PreparedPayload, Array(IntentDimension)) -> Int = fn(payload, dimensions) {
    if array.length(dimensions) > 0 {
        match find_dimension(payload, dimensions[0].id) {
            'Some(entry) => entry.entity,
            'None => -1,
        }
    } else {
        -1
    }
};

def path_safe: Fn(edsl.PreparedPayload, Int, Int) -> Bool = fn(payload, from, to) {
    match array.get(payload.paths, from) {
        'None => 'False,
        'Some(row) => match array.get(row, to) {
            'None => 'False,
            'Some('Safe(_)) => 'True,
            'Some(_) => 'False,
        },
    }
};

# --- operator / value parsing -----------------------------------------------

def parse_op: Fn(String) -> Option(edsl.FilterOp) = fn(op) {
    match op {
        "eq" => 'Some('Eq),
        "ne" => 'Some('Ne),
        "gt" => 'Some('Gt),
        "ge" => 'Some('Ge),
        "lt" => 'Some('Lt),
        "le" => 'Some('Le),
        "contains" => 'Some('Contains),
        "not_contains" => 'Some('NotContains),
        "starts_with" => 'Some('StartsWith),
        "ends_with" => 'Some('EndsWith),
        _ => 'None,
    }
};

def is_text_op: Fn(edsl.FilterOp) -> Bool = fn(op) {
    match op {
        'Contains => 'True,
        'NotContains => 'True,
        'StartsWith => 'True,
        'EndsWith => 'True,
        _ => 'False,
    }
};

def value_kind: Fn(ScalarValue) -> Option(edsl.FilterInputKind) = fn(v) {
    match v {
        'String(_) => 'Some('Text),
        'Int(_) => 'Some('Int),
        'Float(_) => 'Some('Number),
        _ => 'None,
    }
};

def is_numeric_kind: Fn(edsl.FilterInputKind) -> Bool = fn(k) {
    match k {
        'Int => 'True,
        'Number => 'True,
        _ => 'False,
    }
};

def direction_issue: Fn(String) -> Option(String) = fn(direction) {
    if direction != "asc" && direction != "desc" {
        'Some(`rule: invalid order direction \{direction}`)
    } else {
        'None
    }
};

# --- per-item issues --------------------------------------------------------

def measure_issue: Fn(edsl.PreparedPayload, IntentMeasure) -> Option(String) = fn(payload, m) {
    if m.mode != "all" && m.mode != "distinct" {
        'Some(`rule: invalid measure mode for \{m.id}: \{m.mode}`)
    } else {
        match find_measure(payload, m.id) {
            'Some(_) => 'None,
            'None => 'Some(`vocab: unknown measure \{m.id}`),
        }
    }
};

def dimension_issue: Fn(edsl.PreparedPayload, IntentDimension) -> Option(String) = fn(payload, d) {
    match find_dimension(payload, d.id) {
        'None => 'Some(`vocab: unknown dimension \{d.id}`),
        'Some(entry) => if !entry.authorized {
            'Some(`vocab: dimension \{d.id} is not authorized`)
        } else {
            'None
        },
    }
};

def filter_issue: Fn(edsl.PreparedPayload, IntentFilter) -> Option(String) = fn(payload, f) {
    match find_dimension(payload, f.id) {
        'None => 'Some(`vocab: unknown filter dimension \{f.id}`),
        'Some(entry) => do {
            if !entry.authorized {
                'Some(`vocab: filter dimension \{f.id} is not authorized`)
            } else if !entry.filterable {
                'Some(`rule: filter dimension \{f.id} is not filterable`)
            } else {
                match parse_op(f.op) {
                    'None => 'Some(`rule: unknown filter operator \{f.op}`),
                    'Some(op) => do {
                        if !array.any(entry.ops, fn(o) { o == op }) {
                            'Some(`rule: operator \{f.op} not supported on dimension \{f.id}`)
                        } else {
                            match value_kind(f.value) {
                                'None => 'Some(`type: filter value on \{f.id} must be text or number`),
                                'Some(kind) => do {
                                    if !array.any(entry.input_kinds, fn(k) { k == kind }) {
                                        'Some(`type: value type not supported on dimension \{f.id}`)
                                    } else if is_text_op(op) {
                                        match f.value {
                                            'String(_) => 'None,
                                            _ => 'Some(`type: text operator on \{f.id} requires a text value`),
                                        }
                                    } else {
                                        'None
                                    }
                                },
                            }
                        }
                    },
                }
            }
        },
    }
};

# --- list-level issue helpers ----------------------------------------------

def fold_issues: for(A) Fn(Fn(edsl.PreparedPayload, A) -> Option(String), edsl.PreparedPayload, Array(A)) -> Option(String) =
    fn(issue, payload, items) {
        let init: Option(String) = 'None;
        array.fold(items, init, fn(acc, item) {
            match acc {
                'Some(_) => acc,
                'None => issue(payload, item),
            }
        })
    };

def first_problem: Fn(Array(Option(String))) -> Option(String) = fn(problems) {
    let init: Option(String) = 'None;
    array.fold(problems, init, fn(acc, p) {
        match acc {
            'Some(_) => acc,
            'None => p,
        }
    })
};

def dimensions_problem: Fn(edsl.PreparedPayload, Array(IntentDimension)) -> Option(String) = fn(payload, dimensions) {
    fold_issues(dimension_issue, payload, dimensions)
};

def filters_problem: Fn(edsl.PreparedPayload, Array(IntentFilter)) -> Option(String) = fn(payload, filters) {
    fold_issues(filter_issue, payload, filters)
};

def measures_problem: Fn(edsl.PreparedPayload, Array(IntentMeasure)) -> Option(String) = fn(payload, measures) {
    let problem = fold_issues(measure_issue, payload, measures);
    match problem {
        'Some(_) => problem,
        'None => do {
            if array.length(measures) <= 1 {
                'None
            } else {
                let target = match find_measure(payload, measures[0].id) {
                    'Some(e) => e.entity,
                    'None => -1,
                };
                match array.find(measures, fn(m) {
                    match find_measure(payload, m.id) {
                        'Some(e) => e.entity != target,
                        'None => 'True,
                    }
                }) {
                    'Some(m) => 'Some(`rule: measures do not share one entity grain: \{m.id}`),
                    'None => 'None,
                }
            }
        },
    }
};

def limit_issue: Fn(Option(Int)) -> Option(String) = fn(limit) {
    match limit {
        'Some(n) => if n <= 0 { 'Some("rule: limit must be a positive integer") } else { 'None },
        'None => 'None,
    }
};

def offset_issue: Fn(Option(Int)) -> Option(String) = fn(offset) {
    match offset {
        'Some(n) => if n < 0 {
            'Some("rule: offset must be a non-negative integer")
        } else {
            'None
        },
        'None => 'None,
    }
};

# `ordering_present` is false only when an intent has no ordering at all.
def page_problem: Fn(Option(Int), Option(Int), Bool) -> Option(String) = fn(limit, offset, ordering_present) {
    let first = limit_issue(limit);
    match first {
        'Some(_) => first,
        'None => do {
            let second = offset_issue(offset);
            match second {
                'Some(_) => second,
                'None => match offset {
                    'Some(_) => if ordering_present {
                        'None
                    } else {
                        'Some("rule: offset requires a stable ordering")
                    },
                    'None => 'None,
                },
            }
        },
    }
};

# --- `ordinary` validation --------------------------------------------------

def ordinary_order_issue: Fn(edsl.PreparedPayload, OrdinaryIntent, IntentOrder) -> Option(String) = fn(payload, intent, o) {
    if o.direction != "asc" && o.direction != "desc" {
        'Some(`rule: invalid order direction \{o.direction}`)
    } else if o.measure != 'None && o.dimension != 'None {
        'Some("rule: order must name exactly one measure or one dimension")
    } else {
        match o.measure {
            'Some(mid) => do {
                if !contains_id(measure_ids_of(intent.measures), mid) {
                    'Some(`rule: ordering measure \{mid} is not selected`)
                } else {
                    match find_measure(payload, mid) {
                        'Some(_) => 'None,
                        'None => 'Some(`vocab: ordering references unknown measure \{mid}`),
                    }
                }
            },
            'None => match o.dimension {
                'Some(did) => do {
                    if contains_id(dimension_ids_of(intent.dimensions), did) {
                        match find_dimension(payload, did) {
                            'Some(_) => 'None,
                            'None => 'Some(`vocab: ordering references unknown dimension \{did}`),
                        }
                    } else if array.length(intent.measures) > 0 {
                        'Some(`rule: ordering dimension \{did} must be selected in an aggregated intent`)
                    } else {
                        match find_dimension(payload, did) {
                            'None => 'Some(`vocab: ordering references unknown dimension \{did}`),
                            'Some(entry) => if !entry.authorized {
                                'Some(`vocab: ordering dimension \{did} is not authorized`)
                            } else if !path_safe(payload, first_dimension_entity(payload, intent.dimensions), entry.entity) {
                                'Some(`rule: hidden ordering dimension \{did} is not safely reachable from the subject`)
                            } else {
                                'None
                            },
                        }
                    }
                },
                'None => 'Some("rule: order must name a measure or a dimension"),
            },
        }
    }
};

def ordinary_order_problem: Fn(edsl.PreparedPayload, OrdinaryIntent) -> Option(String) = fn(payload, intent) {
    let init: Option(String) = 'None;
    array.fold(intent.order, init, fn(acc, o) {
        match acc {
            'Some(_) => acc,
            'None => ordinary_order_issue(payload, intent, o),
        }
    })
};

def output_token_issue: Fn(edsl.PreparedPayload, Array(String), Array(String), OutputToken) -> Option(String) = fn(payload, measure_ids, dimension_ids, token) {
    match token {
        'Measure(mid) => first_problem([
            match find_measure(payload, mid) {
                'Some(_) => 'None,
                'None => 'Some(`vocab: unknown output measure \{mid}`),
            },
            if contains_id(measure_ids, mid) {
                'None
            } else {
                'Some(`rule: output measure \{mid} is not requested`)
            },
        ]),
        'Dimension(did) => first_problem([
            match find_dimension(payload, did) {
                'Some(_) => 'None,
                'None => 'Some(`vocab: unknown output dimension \{did}`),
            },
            if contains_id(dimension_ids, did) {
                'None
            } else {
                'Some(`rule: output dimension \{did} is not requested`)
            },
        ]),
    }
};

def token_measure_count: Fn(Array(OutputToken), String) -> Int = fn(tokens, id) {
    array.fold(tokens, 0, fn(acc, t) {
        match t {
            'Measure(m) => if m == id { acc + 1 } else { acc },
            _ => acc,
        }
    })
};

def token_dimension_count: Fn(Array(OutputToken), String) -> Int = fn(tokens, id) {
    array.fold(tokens, 0, fn(acc, t) {
        match t {
            'Dimension(d) => if d == id { acc + 1 } else { acc },
            _ => acc,
        }
    })
};

# A non-empty `output_order` must list every requested measure and dimension
# exactly once; it may not reference hidden/compared/related/scope items.
# Empty order preserves the legacy dimensions-then-measures projection.
def output_order_problem: Fn(edsl.PreparedPayload, Array(String), Array(String), Array(OutputToken)) -> Option(String) = fn(payload, measure_ids, dimension_ids, tokens) {
    if array.length(tokens) == 0 {
        'None
    } else {
        let per_token = array.fold(tokens, 'None, fn(acc, t) {
            match acc {
                'Some(_) => acc,
                'None => output_token_issue(payload, measure_ids, dimension_ids, t),
            }
        });
        match per_token {
            'Some(_) => per_token,
            'None => do {
                let omitted_measure = array.find(measure_ids, fn(mid) {
                    token_measure_count(tokens, mid) != 1
                });
                match omitted_measure {
                    'Some(mid) => 'Some(`rule: output_order must include requested measure \{mid} exactly once`),
                    'None => do {
                        let omitted_dim = array.find(dimension_ids, fn(did) {
                            token_dimension_count(tokens, did) != 1
                        });
                        match omitted_dim {
                            'Some(did) => 'Some(`rule: output_order must include requested dimension \{did} exactly once`),
                            'None => 'None,
                        }
                    },
                }
            },
        }
    }
};

def ordinary_problem: Fn(edsl.PreparedPayload, OrdinaryIntent) -> Option(String) = fn(payload, intent) {
    if array.length(intent.measures) == 0 && array.length(intent.dimensions) == 0 {
        'Some("rule: intent must select at least one measure or one dimension")
    } else {
        first_problem([
            measures_problem(payload, intent.measures),
            dimensions_problem(payload, intent.dimensions),
            filters_problem(payload, intent.filters),
            ordinary_order_problem(payload, intent),
            page_problem(intent.limit, intent.offset, array.length(intent.order) > 0),
            output_order_problem(payload, measure_ids_of(intent.measures), dimension_ids_of(intent.dimensions), intent.output_order),
        ])
    }
};

# --- `distinct_dimensions` validation ---------------------------------------

def distinct_order_issue: Fn(edsl.PreparedPayload, DistinctDimensionsIntent, IntentOrder) -> Option(String) = fn(payload, intent, o) {
    if o.direction != "asc" && o.direction != "desc" {
        'Some(`rule: invalid order direction \{o.direction}`)
    } else if o.measure != 'None && o.dimension != 'None {
        'Some("rule: order must name exactly one measure or one dimension")
    } else {
        match o.measure {
            'Some(_) => 'Some("rule: a distinct list cannot order by a measure"),
            'None => match o.dimension {
                'Some(did) => do {
                    if contains_id(dimension_ids_of(intent.dimensions), did) {
                        match find_dimension(payload, did) {
                            'Some(_) => 'None,
                            'None => 'Some(`vocab: ordering references unknown dimension \{did}`),
                        }
                    } else {
                        'Some("rule: a distinct list can only order by a selected dimension")
                    }
                },
                'None => 'Some("rule: order must name a measure or a dimension"),
            },
        }
    }
};

def distinct_order_problem: Fn(edsl.PreparedPayload, DistinctDimensionsIntent) -> Option(String) = fn(payload, intent) {
    let init: Option(String) = 'None;
    array.fold(intent.order, init, fn(acc, o) {
        match acc {
            'Some(_) => acc,
            'None => distinct_order_issue(payload, intent, o),
        }
    })
};

def distinct_dimensions_problem: Fn(edsl.PreparedPayload, DistinctDimensionsIntent) -> Option(String) = fn(payload, intent) {
    first_problem([
        if array.length(intent.dimensions) == 0 {
            'Some("rule: a distinct_dimensions request must select at least one dimension")
        } else {
            'None
        },
        dimensions_problem(payload, intent.dimensions),
        filters_problem(payload, intent.filters),
        distinct_order_problem(payload, intent),
        page_problem(intent.limit, intent.offset, array.length(intent.order) > 0),
    ])
};

# --- `hidden_row_order` validation ------------------------------------------

def hidden_row_sort_issue: Fn(edsl.PreparedPayload, HiddenRowOrderIntent) -> Option(String) = fn(payload, intent) {
    if contains_id(dimension_ids_of(intent.dimensions), intent.sort_by) {
        'Some("rule: the hidden row-order sort dimension must not be projected")
    } else {
        match find_dimension(payload, intent.sort_by) {
            'None => 'Some(`vocab: unknown hidden sort dimension \{intent.sort_by}`),
            'Some(entry) => do {
                if !entry.authorized {
                    'Some(`vocab: hidden sort dimension \{intent.sort_by} is not authorized`)
                } else if !array.any(entry.input_kinds, is_numeric_kind) {
                    'Some(`type: hidden row-order sort dimension \{intent.sort_by} must be numeric`)
                } else if !path_safe(payload, first_dimension_entity(payload, intent.dimensions), entry.entity) {
                    'Some(`rule: hidden sort dimension \{intent.sort_by} is not safely reachable from the subject`)
                } else {
                    'None
                }
            },
        }
    }
};

def hidden_row_order_problem: Fn(edsl.PreparedPayload, HiddenRowOrderIntent) -> Option(String) = fn(payload, intent) {
    first_problem([
        if array.length(intent.dimensions) == 0 {
            'Some("rule: a hidden_row_order request must select at least one projected dimension")
        } else {
            'None
        },
        dimensions_problem(payload, intent.dimensions),
        filters_problem(payload, intent.filters),
        direction_issue(intent.direction),
        hidden_row_sort_issue(payload, intent),
        page_problem(intent.limit, intent.offset, 'True),
    ])
};

# --- `hidden_aggregate_order` validation ------------------------------------

def grouped_dims_same_entity: Fn(edsl.PreparedPayload, Array(IntentDimension)) -> Option(String) = fn(payload, dimensions) {
    if array.length(dimensions) == 0 {
        'None
    } else {
        let target = match find_dimension(payload, dimensions[0].id) {
            'Some(e) => e.entity,
            'None => -1,
        };
        match array.find(dimensions, fn(d) {
            match find_dimension(payload, d.id) {
                'Some(e) => e.entity != target,
                'None => 'True,
            }
        }) {
            'Some(d) => 'Some(`rule: grouped dimensions must share the base entity: \{d.id}`),
            'None => 'None,
        }
    }
};

def hidden_aggregate_sort_issue: Fn(edsl.PreparedPayload, HiddenAggregateOrderIntent) -> Option(String) = fn(payload, intent) {
    let base = first_dimension_entity(payload, intent.dimensions);
    match find_measure(payload, intent.sort_by) {
        'None => 'Some(`vocab: unknown hidden aggregate measure \{intent.sort_by}`),
        'Some(entry) => if entry.entity != base {
            'Some(`rule: hidden aggregate measure \{intent.sort_by} is not on the base entity grain`)
        } else {
            'None
        },
    }
};

def hidden_aggregate_order_problem: Fn(edsl.PreparedPayload, HiddenAggregateOrderIntent) -> Option(String) = fn(payload, intent) {
    first_problem([
        if array.length(intent.dimensions) == 0 {
            'Some("rule: a hidden_aggregate_order request must select at least one grouped dimension")
        } else {
            'None
        },
        dimensions_problem(payload, intent.dimensions),
        filters_problem(payload, intent.filters),
        direction_issue(intent.direction),
        grouped_dims_same_entity(payload, intent.dimensions),
        hidden_aggregate_sort_issue(payload, intent),
        match intent.offset {
            'Some(_) => 'Some("rule: a hidden_aggregate_order request does not support offset"),
            'None => 'None,
        },
        limit_issue(intent.limit),
    ])
};

# --- `related_exists` / `related_absent` validation -------------------------

def body_base_entity: Fn(edsl.PreparedPayload, Array(IntentMeasure), Array(IntentDimension)) -> Int = fn(payload, measures, dimensions) {
    if array.length(measures) > 0 {
        match find_measure(payload, measures[0].id) {
            'Some(entry) => entry.entity,
            'None => -1,
        }
    } else if array.length(dimensions) > 0 {
        match find_dimension(payload, dimensions[0].id) {
            'Some(entry) => entry.entity,
            'None => -1,
        }
    } else {
        -1
    }
};

def target_entity_index: Fn(edsl.PreparedPayload, String) -> Int = fn(payload, target) {
    match target {
        "city" => entity_index_of_id(payload, "city"),
        "country_language" => entity_index_of_id(payload, "country_language"),
        _ => -1,
    }
};

def related_target_problem: Fn(String) -> Option(String) = fn(target) {
    match target {
        "city" => 'None,
        "country_language" => 'None,
        _ => 'Some(`vocab: unknown related target \{target}`),
    }
};

def related_filters_on_target: Fn(edsl.PreparedPayload, String, Array(IntentFilter)) -> Option(String) = fn(payload, target, filters) {
    let target_entity = target_entity_index(payload, target);
    let init: Option(String) = 'None;
    array.fold(filters, init, fn(acc, f) {
        match acc {
            'Some(_) => acc,
            'None => match find_dimension(payload, f.id) {
                'None => 'Some(`vocab: unknown related filter dimension \{f.id}`),
                'Some(entry) => if entry.entity != target_entity {
                    'Some(`rule: related filter dimension \{f.id} does not belong to target \{target}`)
                } else {
                    'None
                },
            },
        }
    })
};

def related_min_matches_problem: Fn(Option(Int)) -> Option(String) = fn(min_matches) {
    match min_matches {
        'Some(n) => if n <= 0 {
            'Some("rule: min_matches must be a positive integer")
        } else {
            'None
        },
        'None => 'None,
    }
};

def related_clause_problem: Fn(edsl.PreparedPayload, RelatedClause) -> Option(String) = fn(payload, related) {
    first_problem([
        related_target_problem(related.target),
        related_filters_on_target(payload, related.target, related.filters),
        related_min_matches_problem(related.min_matches),
        filters_problem(payload, related.filters),
    ])
};

# Only the declared grain-safe Country -> City / CountryLanguage routes are
# supported.  The outer body must be a Country request: base entity is Country
# and every outer dimension / filter belongs to that base.
def related_outer_entity_problem: Fn(edsl.PreparedPayload, Array(IntentMeasure), Array(IntentDimension), Array(IntentFilter)) -> Option(String) = fn(payload, measures, dimensions, filters) {
    let base = body_base_entity(payload, measures, dimensions);
    let country_entity = entity_index_of_id(payload, "country");
    if base != country_entity {
        'Some("rule: a related existence request must be based on country")
    } else {
        let dim_issue = array.fold(dimensions, 'None, fn(acc, d) {
            match acc {
                'Some(_) => acc,
                'None => match find_dimension(payload, d.id) {
                    'None => acc,
                    'Some(entry) => if entry.entity != base {
                        'Some(`rule: outer dimension \{d.id} does not belong to the country base`)
                    } else {
                        'None
                    },
                },
            }
        });
        match dim_issue {
            'Some(_) => dim_issue,
            'None => array.fold(filters, 'None, fn(acc, f) {
                match acc {
                    'Some(_) => acc,
                    'None => match find_dimension(payload, f.id) {
                        'None => acc,
                        'Some(entry) => if entry.entity != base {
                            'Some(`rule: outer filter dimension \{f.id} does not belong to the country base`)
                        } else {
                            'None
                        },
                    },
                }
            }),
        }
    }
};

def related_variant_problem: Fn(edsl.PreparedPayload, Array(IntentMeasure), Array(IntentDimension), Array(IntentFilter), Array(IntentOrder), Option(Int), Option(Int), RelatedClause) -> Option(String) = fn(payload, measures, dimensions, filters, order, limit, offset, related) {
    let outer: OrdinaryIntent = {
        measures,
        dimensions,
        filters,
        order,
        limit,
        offset,
        output_order: [],
    };
    first_problem([
        ordinary_problem(payload, outer),
        related_outer_entity_problem(payload, measures, dimensions, filters),
        related_clause_problem(payload, related),
    ])
};

def related_exists_problem: Fn(edsl.PreparedPayload, RelatedExistsIntent) -> Option(String) = fn(payload, intent) {
    first_problem([
        related_variant_problem(payload, intent.measures, intent.dimensions, intent.filters, intent.order, intent.limit, intent.offset, intent.related),
        output_order_problem(payload, measure_ids_of(intent.measures), dimension_ids_of(intent.dimensions), intent.output_order),
    ])
};

def related_absent_problem: Fn(edsl.PreparedPayload, RelatedAbsentIntent) -> Option(String) = fn(payload, intent) {
    first_problem([
        related_variant_problem(payload, intent.measures, intent.dimensions, intent.filters, intent.order, intent.limit, intent.offset, intent.related),
        output_order_problem(payload, measure_ids_of(intent.measures), dimension_ids_of(intent.dimensions), intent.output_order),
    ])
};

# --- set operation validation ----------------------------------------------

def set_kind_issue: Fn(String) -> Option(String) = fn(kind) {
    match kind {
        "intersect" => 'None,
        "except" => 'None,
        "union" => 'None,
        _ => 'Some(`rule: unknown set operation kind \{kind}`),
    }
};

def operand_embeddable_issue: Fn(OrdinaryIntent) -> Option(String) = fn(operand) {
    if array.length(operand.order) > 0 {
        'Some("rule: set operands must not carry local ordering")
    } else if array.length(operand.output_order) > 0 {
        'Some("rule: set operands must not carry an explicit output_order")
    } else {
        match operand.limit {
            'Some(_) => 'Some("rule: set operands must not carry local limit"),
            'None => match operand.offset {
                'Some(_) => 'Some("rule: set operands must not carry local offset"),
                'None => 'None,
            },
        }
    }
};

# Ontology default projection order for an ordinary request is measures
# (request order) then dimensions (request order).  Set compatibility requires
# equal projection arity with matching positional categories.
def operand_signature: Fn(Array(IntentMeasure), Array(IntentDimension)) -> Array(String) = fn(measures, dimensions) {
    let measure_part: Array(String) = array.map(measures, fn(m) { "M" });
    let dimension_part: Array(String) = array.map(dimensions, fn(d) { "D" });
    array.concat([measure_part, dimension_part])
};

def signature_mismatch: Fn(Array(String), Array(String)) -> Option(String) = fn(left, right) {
    if array.length(left) != array.length(right) {
        'Some("rule: set operands must have equal projection arity")
    } else {
        let zipped = array.enumerate(left);
        let bad = array.find(zipped, fn(pair) {
            match pair {
                (i, l) => l != right[i],
            }
        });
        match bad {
            'None => 'None,
            'Some(_) => 'Some("rule: set operands have incompatible positional projection categories"),
        }
    }
};

def set_operand_problem: Fn(edsl.PreparedPayload, SetOperandIntent) -> Option(String) = fn(payload, intent) {
    let left_shape = operand_signature(intent.left.measures, intent.left.dimensions);
    let right_shape = operand_signature(intent.right.measures, intent.right.dimensions);
    first_problem([
        set_kind_issue(intent.kind),
        ordinary_problem(payload, intent.left),
        ordinary_problem(payload, intent.right),
        operand_embeddable_issue(intent.left),
        operand_embeddable_issue(intent.right),
        if array.length(left_shape) == 0 {
            'Some("rule: set operands must have a non-empty projection")
        } else {
            'None
        },
        signature_mismatch(left_shape, right_shape),
    ])
};

def set_combine_problem: Fn(edsl.PreparedPayload, SetOperandIntent) -> Option(String) = fn(payload, intent) {
    set_operand_problem(payload, intent)
};

def set_count_problem: Fn(edsl.PreparedPayload, SetOperandIntent) -> Option(String) = fn(payload, intent) {
    set_operand_problem(payload, intent)
};

# --- selected / hidden HAVING validation -----------------------------------

def parse_having_op: Fn(String) -> Option(edsl.HavingOp) = fn(op) {
    match op {
        "eq" => 'Some('Eq),
        "ne" => 'Some('Ne),
        "lt" => 'Some('Lt),
        "le" => 'Some('Le),
        "gt" => 'Some('Gt),
        "ge" => 'Some('Ge),
        _ => 'None,
    }
};

def having_threshold_issue: Fn(ScalarValue) -> Option(String) = fn(threshold) {
    match threshold {
        'Int(_) => 'None,
        'Float(_) => 'None,
        _ => 'Some("type: HAVING threshold must be a numeric value"),
    }
};

def having_op_issue: Fn(String) -> Option(String) = fn(op) {
    match parse_having_op(op) {
        'Some(_) => 'None,
        'None => 'Some(`rule: unknown HAVING operator \{op}`),
    }
};

def having_measure_selected_issue: Fn(Array(String), String) -> Option(String) = fn(selected, measure) {
    if contains_id(selected, measure) {
        'None
    } else {
        'Some(`rule: HAVING measure \{measure} is not selected`)
    }
};

def selected_having_predicate_issue: Fn(edsl.PreparedPayload, Array(String), HavingPredicate) -> Option(String) = fn(payload, selected, p) {
    first_problem([
        match find_measure(payload, p.measure) {
            'Some(_) => 'None,
            'None => 'Some(`vocab: unknown HAVING measure \{p.measure}`),
        },
        having_measure_selected_issue(selected, p.measure),
        having_op_issue(p.op),
        having_threshold_issue(p.threshold),
    ])
};

def fold_having_predicates: Fn(Fn(edsl.PreparedPayload, Array(String), HavingPredicate) -> Option(String), edsl.PreparedPayload, Array(String), Array(HavingPredicate)) -> Option(String) =
    fn(issue, payload, selected, predicates) {
        let init: Option(String) = 'None;
        array.fold(predicates, init, fn(acc, p) {
            match acc {
                'Some(_) => acc,
                'None => issue(payload, selected, p),
            }
        })
    };

def selected_having_problem: Fn(edsl.PreparedPayload, SelectedHavingIntent) -> Option(String) = fn(payload, intent) {
    let outer: OrdinaryIntent = {
        measures: intent.measures,
        dimensions: intent.dimensions,
        filters: intent.filters,
        order: intent.order,
        limit: intent.limit,
        offset: intent.offset,
        output_order: [],
    };
    let selected = measure_ids_of(intent.measures);
    first_problem([
        if array.length(intent.measures) == 0 {
            'Some("rule: selected_having requires an aggregate request with selected measures")
        } else {
            'None
        },
        ordinary_problem(payload, outer),
        fold_having_predicates(selected_having_predicate_issue, payload, selected, intent.having),
        output_order_problem(payload, measure_ids_of(intent.measures), dimension_ids_of(intent.dimensions), intent.output_order),
    ])
};

def hidden_having_measure_issue: Fn(edsl.PreparedPayload, Int, Array(String), HavingPredicate) -> Option(String) = fn(payload, base, selected, p) {
    first_problem([
        match find_measure(payload, p.measure) {
            'Some(_) => 'None,
            'None => 'Some(`vocab: unknown hidden HAVING measure \{p.measure}`),
        },
        match find_measure(payload, p.measure) {
            'Some(entry) => if entry.entity != base {
                'Some(`rule: hidden HAVING measure \{p.measure} is not on the base entity grain`)
            } else {
                'None
            },
            'None => 'None,
        },
        if contains_id(selected, p.measure) {
            'Some(`rule: hidden HAVING measure \{p.measure} must not be selected`)
        } else {
            'None
        },
        having_op_issue(p.op),
        having_threshold_issue(p.threshold),
    ])
};

def fold_hidden_having: Fn(edsl.PreparedPayload, Int, Array(String), Array(HavingPredicate)) -> Option(String) = fn(payload, base, selected, predicates) {
    let init: Option(String) = 'None;
    array.fold(predicates, init, fn(acc, p) {
        match acc {
            'Some(_) => acc,
            'None => hidden_having_measure_issue(payload, base, selected, p),
        }
    })
};

def hidden_having_problem: Fn(edsl.PreparedPayload, HiddenHavingIntent) -> Option(String) = fn(payload, intent) {
    let outer: OrdinaryIntent = {
        measures: intent.measures,
        dimensions: intent.dimensions,
        filters: intent.filters,
        order: intent.order,
        limit: intent.limit,
        offset: intent.offset,
        output_order: [],
    };
    let base = if array.length(intent.measures) > 0 {
        match find_measure(payload, intent.measures[0].id) {
            'Some(entry) => entry.entity,
            'None => -1,
        }
    } else {
        -1
    };
    let selected = measure_ids_of(intent.measures);
    let dim_issue = array.fold(intent.dimensions, 'None, fn(acc, d) {
        match acc {
            'Some(_) => acc,
            'None => match find_dimension(payload, d.id) {
                'None => acc,
                'Some(entry) => if base >= 0 && entry.entity != base {
                    'Some(`rule: grouped dimension \{d.id} is not on the hidden HAVING base entity`)
                } else {
                    'None
                },
            },
        }
    });
    first_problem([
        if array.length(intent.measures) == 0 {
            'Some("rule: hidden_having requires an aggregate request with selected measures")
        } else if array.length(intent.dimensions) == 0 {
            'Some("rule: hidden_having requires at least one grouped dimension")
        } else {
            'None
        },
        ordinary_problem(payload, outer),
        dim_issue,
        fold_hidden_having(payload, base, selected, intent.having),
        output_order_problem(payload, measure_ids_of(intent.measures), dimension_ids_of(intent.dimensions), intent.output_order),
    ])
};

# --- attribute_aggregate_compare validation --------------------------------

def comparison_scope_issue: Fn(edsl.PreparedPayload, Int, IntentFilter) -> Option(String) = fn(payload, measure_entity, f) {
    first_problem([
        match find_dimension(payload, f.id) {
            'None => 'Some(`vocab: unknown comparison scope dimension \{f.id}`),
            'Some(entry) => if entry.entity != measure_entity {
                'Some(`rule: comparison scope dimension \{f.id} does not belong to the measure entity`)
            } else {
                'None
            },
        },
        filter_issue(payload, f),
    ])
};

def fold_comparison_scopes: Fn(edsl.PreparedPayload, AttributeComparePredicate) -> Option(String) = fn(payload, p) {
    let measure_entity = match find_measure(payload, p.measure) {
        'Some(entry) => entry.entity,
        'None => -1,
    };
    let init: Option(String) = 'None;
    array.fold(p.scope_filters, init, fn(acc, f) {
        match acc {
            'Some(_) => acc,
            'None => comparison_scope_issue(payload, measure_entity, f),
        }
    })
};

def attribute_issue: Fn(edsl.PreparedPayload, Int, AttributeComparePredicate) -> Option(String) = fn(payload, base, p) {
    first_problem([
        match find_dimension(payload, p.attribute) {
            'Some(_) => 'None,
            'None => 'Some(`vocab: unknown comparison attribute \{p.attribute}`),
        },
        match find_dimension(payload, p.attribute) {
            'None => 'None,
            'Some(entry) => do {
                if !entry.authorized {
                    'Some(`vocab: comparison attribute \{p.attribute} is not authorized`)
                } else if entry.entity != base {
                    'Some(`rule: comparison attribute \{p.attribute} is not on the outer base entity`)
                } else if !array.any(entry.input_kinds, is_numeric_kind) {
                    'Some(`type: comparison attribute \{p.attribute} must be numeric`)
                } else {
                    'None
                }
            },
        },
        match find_measure(payload, p.measure) {
            'Some(_) => 'None,
            'None => 'Some(`vocab: unknown comparison measure \{p.measure}`),
        },
        having_op_issue(p.op),
        fold_comparison_scopes(payload, p),
    ])
};

def fold_attribute_comparisons: Fn(edsl.PreparedPayload, Int, Array(AttributeComparePredicate)) -> Option(String) = fn(payload, base, comparisons) {
    let init: Option(String) = 'None;
    array.fold(comparisons, init, fn(acc, p) {
        match acc {
            'Some(_) => acc,
            'None => attribute_issue(payload, base, p),
        }
    })
};

def attribute_aggregate_compare_problem: Fn(edsl.PreparedPayload, AttributeAggregateCompareIntent) -> Option(String) = fn(payload, intent) {
    let outer: OrdinaryIntent = {
        measures: [],
        dimensions: intent.dimensions,
        filters: intent.filters,
        order: intent.order,
        limit: intent.limit,
        offset: intent.offset,
        output_order: [],
    };
    let base = if array.length(intent.dimensions) > 0 {
        match find_dimension(payload, intent.dimensions[0].id) {
            'Some(entry) => entry.entity,
            'None => -1,
        }
    } else {
        -1
    };
    let dim_issue = array.fold(intent.dimensions, 'None, fn(acc, d) {
        match acc {
            'Some(_) => acc,
            'None => match find_dimension(payload, d.id) {
                'None => acc,
                'Some(entry) => if base >= 0 && entry.entity != base {
                    'Some(`rule: outer dimension \{d.id} is not on the comparison base entity`)
                } else {
                    'None
                },
            },
        }
    });
    let filter_issue = array.fold(intent.filters, 'None, fn(acc, f) {
        match acc {
            'Some(_) => acc,
            'None => match find_dimension(payload, f.id) {
                'None => acc,
                'Some(entry) => if base >= 0 && entry.entity != base {
                    'Some(`rule: outer filter dimension \{f.id} is not on the comparison base entity`)
                } else {
                    'None
                },
            },
        }
    });
    first_problem([
        if array.length(intent.dimensions) == 0 {
            'Some("rule: attribute_aggregate_compare requires at least one projected dimension")
        } else {
            'None
        },
        if array.length(intent.comparisons) == 0 {
            'Some("rule: attribute_aggregate_compare requires at least one comparison")
        } else {
            'None
        },
        ordinary_problem(payload, outer),
        dim_issue,
        filter_issue,
        fold_attribute_comparisons(payload, base, intent.comparisons),
    ])
};

# --- related_hidden_row_order validation -----------------------------------

def related_hidden_target_issue: Fn(edsl.PreparedPayload, RelatedHiddenClause) -> Option(String) = fn(payload, related) {
    match related.target {
        "country_language" => 'None,
        _ => 'Some(`rule: unsupported related target \{related.target} for a city hidden row-order route`),
    }
};

def related_hidden_filters_issue: Fn(edsl.PreparedPayload, RelatedHiddenClause) -> Option(String) = fn(payload, related) {
    let target_entity = entity_index_of_id(payload, "country_language");
    let init: Option(String) = 'None;
    array.fold(related.filters, init, fn(acc, f) {
        match acc {
            'Some(_) => acc,
            'None => match find_dimension(payload, f.id) {
                'None => 'Some(`vocab: unknown related filter dimension \{f.id}`),
                'Some(entry) => if entry.entity != target_entity {
                    'Some(`rule: related filter dimension \{f.id} does not belong to target \{related.target}`)
                } else {
                    'None
                },
            },
        }
    })
};

def related_hidden_sort_issue: Fn(edsl.PreparedPayload, Int, RelatedHiddenRowOrderIntent) -> Option(String) = fn(payload, base, intent) {
    if contains_id(dimension_ids_of(intent.dimensions), intent.sort_by) {
        'Some("rule: the hidden row-order sort dimension must not be projected")
    } else {
        match find_dimension(payload, intent.sort_by) {
            'None => 'Some(`vocab: unknown hidden sort dimension \{intent.sort_by}`),
            'Some(entry) => do {
                if !entry.authorized {
                    'Some(`vocab: hidden sort dimension \{intent.sort_by} is not authorized`)
                } else if entry.entity != base {
                    'Some(`rule: hidden sort dimension \{intent.sort_by} is not on the outer base entity`)
                } else if !array.any(entry.input_kinds, is_numeric_kind) {
                    'Some(`type: hidden row-order sort dimension \{intent.sort_by} must be numeric`)
                } else {
                    'None
                }
            },
        }
    }
};

def related_hidden_row_order_problem: Fn(edsl.PreparedPayload, RelatedHiddenRowOrderIntent) -> Option(String) = fn(payload, intent) {
    let base = if array.length(intent.dimensions) > 0 {
        match find_dimension(payload, intent.dimensions[0].id) {
            'Some(entry) => entry.entity,
            'None => -1,
        }
    } else {
        -1
    };
    let dim_issue = array.fold(intent.dimensions, 'None, fn(acc, d) {
        match acc {
            'Some(_) => acc,
            'None => match find_dimension(payload, d.id) {
                'None => acc,
                'Some(entry) => if base >= 0 && entry.entity != base {
                    'Some(`rule: outer dimension \{d.id} is not on the outer base entity`)
                } else {
                    'None
                },
            },
        }
    });
    let filter_issue = array.fold(intent.filters, 'None, fn(acc, f) {
        match acc {
            'Some(_) => acc,
            'None => match find_dimension(payload, f.id) {
                'None => acc,
                'Some(entry) => if base >= 0 && entry.entity != base {
                    'Some(`rule: outer filter dimension \{f.id} is not on the outer base entity`)
                } else {
                    'None
                },
            },
        }
    });
    first_problem([
        if array.length(intent.dimensions) == 0 {
            'Some("rule: related_hidden_row_order requires at least one projected dimension")
        } else {
            'None
        },
        if base >= 0 && entity_id_at(payload, base) != "city" {
            'Some("rule: the related hidden row-order composition route is only supported from a city base")
        } else {
            'None
        },
        dimensions_problem(payload, intent.dimensions),
        filters_problem(payload, intent.filters),
        dim_issue,
        filter_issue,
        direction_issue(intent.direction),
        related_hidden_target_issue(payload, intent.related),
        related_hidden_filters_issue(payload, intent.related),
        filters_problem(payload, intent.related.filters),
        related_hidden_sort_issue(payload, base, intent),
        page_problem(intent.limit, intent.offset, 'True),
    ])
};

# --- related_set_combine / related_set_count validation ---------------------

def related_set_operand_problem: Fn(edsl.PreparedPayload, RelatedSetOperand) -> Option(String) = fn(payload, operand) {
    first_problem([
        if array.length(operand.dimensions) == 0 {
            'Some("rule: a related set operand requires at least one projected dimension")
        } else {
            'None
        },
        dimensions_problem(payload, operand.dimensions),
        filters_problem(payload, operand.filters),
        related_outer_entity_problem(payload, [], operand.dimensions, operand.filters),
        related_clause_problem(payload, operand.related),
    ])
};

def related_set_arity_issue: Fn(Array(IntentDimension), Array(IntentDimension)) -> Option(String) = fn(left, right) {
    if array.length(left) != array.length(right) {
        'Some("rule: related set operands must have equal projection arity")
    } else {
        'None
    }
};

def related_set_problem: Fn(edsl.PreparedPayload, RelatedSetIntent) -> Option(String) = fn(payload, intent) {
    first_problem([
        set_kind_issue(intent.kind),
        related_set_operand_problem(payload, intent.left),
        related_set_operand_problem(payload, intent.right),
        related_set_arity_issue(intent.left.dimensions, intent.right.dimensions),
    ])
};

def related_set_combine_problem: Fn(edsl.PreparedPayload, RelatedSetIntent) -> Option(String) = fn(payload, intent) {
    related_set_problem(payload, intent)
};

def related_set_count_problem: Fn(edsl.PreparedPayload, RelatedSetIntent) -> Option(String) = fn(payload, intent) {
    related_set_problem(payload, intent)
};

# ---------------------------------------------------------------------------
# Validation dispatch over the closed family.
# ---------------------------------------------------------------------------

def intent_problem: Fn(edsl.PreparedPayload, Intent) -> Option(String) = fn(payload, intent) {
    match intent {
        'Ordinary(o) => ordinary_problem(payload, o),
        'DistinctDimensions(d) => distinct_dimensions_problem(payload, d),
        'HiddenRowOrder(h) => hidden_row_order_problem(payload, h),
        'HiddenAggregateOrder(h) => hidden_aggregate_order_problem(payload, h),
        'RelatedExists(e) => related_exists_problem(payload, e),
        'RelatedAbsent(a) => related_absent_problem(payload, a),
        'SetCombine(s) => set_combine_problem(payload, s),
        'SetCount(s) => set_count_problem(payload, s),
        'SelectedHaving(h) => selected_having_problem(payload, h),
        'HiddenHaving(h) => hidden_having_problem(payload, h),
        'AttributeAggregateCompare(c) => attribute_aggregate_compare_problem(payload, c),
        'RelatedHiddenRowOrder(r) => related_hidden_row_order_problem(payload, r),
        'RelatedSetCombine(s) => related_set_combine_problem(payload, s),
        'RelatedSetCount(s) => related_set_count_problem(payload, s),
    }
};

# ---------------------------------------------------------------------------
# Mapping.
# ---------------------------------------------------------------------------

def to_filter_input: Fn(ScalarValue) -> edsl.FilterInput = fn(v) {
    match v {
        'String(s) => {
            let out: edsl.FilterInput = 'Text(s);
            out
        },
        'Int(i) => {
            let out: edsl.FilterInput = 'Int(i);
            out
        },
        'Float(f) => {
            let out: edsl.FilterInput = 'Number(f);
            out
        },
        _ => fail!("type: filter value must be text or number"),
    }
};

def op_of_string: Fn(String) -> edsl.FilterOp = fn(op) {
    match parse_op(op) {
        'Some(o) => o,
        'None => fail!("rule: unknown filter operator", op),
    }
};

def measure_input_of: Fn(String) -> edsl.MeasureInput = fn(mode) {
    match mode {
        "all" => 'All,
        "distinct" => 'Distinct,
        _ => fail!("rule: invalid measure mode", mode),
    }
};

def order_target_of: Fn(IntentOrder) -> edsl.OrderTarget = fn(o) {
    match o.measure {
        'Some(mid) => {
            let t: edsl.OrderTarget = 'Measure(mid);
            t
        },
        'None => match o.dimension {
            'Some(did) => {
                let t: edsl.OrderTarget = 'Dimension(did);
                t
            },
            'None => fail!("rule: order must name a measure or a dimension"),
        },
    }
};

def order_direction_of: Fn(String) -> edsl.OrderDirection = fn(direction) {
    match direction {
        "asc" => 'Asc,
        "desc" => 'Desc,
        _ => fail!("rule: invalid order direction", direction),
    }
};

def build_measures: Fn(Array(IntentMeasure)) -> Array(edsl.MeasureRequest) = fn(measures) {
    array.map(measures, fn(m) {
        let req: edsl.MeasureRequest = { id: m.id, subject: subject, input: measure_input_of(m.mode) };
        req
    })
};

def build_dimensions: Fn(Array(IntentDimension)) -> Array(edsl.DimensionRequest) = fn(dimensions) {
    array.map(dimensions, fn(d) {
        let req: edsl.DimensionRequest = { id: d.id, subject: subject, input: 'None };
        req
    })
};

def build_filters: Fn(Array(IntentFilter)) -> Array(edsl.FilterRequest) = fn(filters) {
    array.map(filters, fn(f) {
        let req: edsl.FilterRequest = {
            id: f.id,
            subject: subject,
            op: op_of_string(f.op),
            input: to_filter_input(f.value),
        };
        req
    })
};

def build_ordering: Fn(Array(IntentOrder)) -> Array(edsl.OrderRequest) = fn(ordering) {
    array.map(ordering, fn(o) {
        let req: edsl.OrderRequest = {
            target: order_target_of(o),
            direction: order_direction_of(o.direction),
        };
        req
    })
};

def build_request: Fn(Array(IntentMeasure), Array(IntentDimension), Array(IntentFilter), Array(IntentOrder), Option(Int), Option(Int)) -> edsl.QueryRequest = fn(measures, dimensions, filters, ordering, limit, offset) {
    let request: edsl.QueryRequest = {
        measures: build_measures(measures),
        dimensions: build_dimensions(dimensions),
        filters: build_filters(filters),
        ordering: build_ordering(ordering),
        limit,
        offset,
        partition: 'None,
    };
    request
};

# Dimension expr + measure aggregate items are resolved from the ontology plan
# so projection can be rebuilt in the stable dims-then-measures order.
def dimension_entry_of: Fn(edsl.PreparedPayload, String) -> edsl.DimensionEntry = fn(payload, id) {
    match find_dimension(payload, id) {
        'Some(entry) => entry,
        'None => fail!("vocab: unknown dimension", id),
    }
};

def dimension_expr_of: Fn(edsl.PreparedPayload, String) -> qb.Expr = fn(payload, id) {
    edsl.dimension_expr(payload, dimension_entry_of(payload, id))
};

def measure_select_item: Fn(qb.Plan, String) -> qb.SelectItem = fn(plan, id) {
    match array.find(plan.projection, fn(item) {
        match item {
            'Aggregate(call) => call.alias == id,
            'Computed(ca) => ca.alias == id,
            'Expr(_) => 'False,
        }
    }) {
        'Some(item) => item,
        'None => fail!("internal: projected measure item not found", id),
    }
};

def finalize_projection: Fn(edsl.PreparedPayload, Array(IntentDimension), Array(IntentMeasure), qb.Plan) -> Array(qb.SelectItem) = fn(payload, dimensions, measures, plan) {
    let dim_items: Array(qb.SelectItem) = array.map(dimensions, fn(d) {
        qb.expr_item(dimension_expr_of(payload, d.id))
    });
    let measure_items: Array(qb.SelectItem) = array.map(measures, fn(m) {
        measure_select_item(plan, m.id)
    });
    array.concat([dim_items, measure_items])
};

def finalize_plan: Fn(edsl.PreparedPayload, Array(IntentDimension), Array(IntentMeasure), qb.Plan) -> qb.Plan = fn(payload, dimensions, measures, plan) {
    let out: qb.Plan = {
        revision: plan.revision,
        sources: plan.sources,
        derived: plan.derived,
        projection: finalize_projection(payload, dimensions, measures, plan),
        filter: plan.filter,
        exists: plan.exists,
        joins: plan.joins,
        grouping: plan.grouping,
        having: plan.having,
        ordering: plan.ordering,
        limit: plan.limit,
        offset: plan.offset,
        partition: plan.partition,
        scalar_comparisons: plan.scalar_comparisons,
        ranked_key_comparisons: plan.ranked_key_comparisons,
    };
    out
};

# Exact public projection order.  Empty `tokens` keeps the legacy
# dimensions-then-measures order; a non-empty list is exact and may only
# reference requested measures/dimensions (validated before lowering).  Only
# the SELECT column order changes; grouping/HAVING/filters/joins/EXISTS/scalar
# comparisons/ordering/limits/bindings/grain/authorization are untouched.
def ordered_projection: Fn(edsl.PreparedPayload, Array(IntentDimension), Array(IntentMeasure), qb.Plan, Array(OutputToken)) -> Array(qb.SelectItem) = fn(payload, dimensions, measures, plan, tokens) {
    if array.length(tokens) == 0 {
        finalize_projection(payload, dimensions, measures, plan)
    } else {
        array.map(tokens, fn(t) {
            match t {
                'Measure(id) => measure_select_item(plan, id),
                'Dimension(id) => qb.expr_item(dimension_expr_of(payload, id)),
            }
        })
    }
};

def finalize_plan_ordered: Fn(edsl.PreparedPayload, Array(IntentDimension), Array(IntentMeasure), qb.Plan, Array(OutputToken)) -> qb.Plan = fn(payload, dimensions, measures, plan, tokens) {
    let out: qb.Plan = {
        revision: plan.revision,
        sources: plan.sources,
        derived: plan.derived,
        projection: ordered_projection(payload, dimensions, measures, plan, tokens),
        filter: plan.filter,
        exists: plan.exists,
        joins: plan.joins,
        grouping: plan.grouping,
        having: plan.having,
        ordering: plan.ordering,
        limit: plan.limit,
        offset: plan.offset,
        partition: plan.partition,
        scalar_comparisons: plan.scalar_comparisons,
        ranked_key_comparisons: plan.ranked_key_comparisons,
    };
    out
};

# ---------------------------------------------------------------------------
# Lowering dispatch over the closed request family.
# ---------------------------------------------------------------------------

def lower_ordinary: Fn(edsl.PreparedPayload, OrdinaryIntent) -> qb.Query = fn(payload, intent) {
    let request = build_request(
        intent.measures,
        intent.dimensions,
        intent.filters,
        intent.order,
        intent.limit,
        intent.offset,
    );
    let lowered = edsl.lower(payload, request);
    let finalized = finalize_plan_ordered(payload, intent.dimensions, intent.measures, lowered, intent.output_order);
    let validated = qb.validate(finalized, payload.profile);
    qb.transform_sqlite(validated)
};

def lower_distinct_dimensions: Fn(edsl.PreparedPayload, DistinctDimensionsIntent) -> qb.Query = fn(payload, intent) {
    let request = build_request(
        [],
        intent.dimensions,
        intent.filters,
        intent.order,
        intent.limit,
        intent.offset,
    );
    edsl.lower_distinct(payload, request)
};

def lower_hidden_row_order: Fn(edsl.PreparedPayload, HiddenRowOrderIntent) -> qb.Query = fn(payload, intent) {
    let ordering: Array(IntentOrder) = [{
        measure: 'None,
        dimension: 'Some(intent.sort_by),
        direction: intent.direction,
    }];
    let request = build_request(
        [],
        intent.dimensions,
        intent.filters,
        ordering,
        intent.limit,
        intent.offset,
    );
    let lowered = edsl.lower(payload, request);
    let validated = qb.validate(lowered, payload.profile);
    qb.transform_sqlite(validated)
};

def lower_hidden_aggregate_order: Fn(edsl.PreparedPayload, HiddenAggregateOrderIntent) -> qb.Query = fn(payload, intent) {
    let request = build_request(
        [],
        intent.dimensions,
        intent.filters,
        [],
        intent.limit,
        'None,
    );
    let direction: edsl.OrderDirection = order_direction_of(intent.direction);
    let internal_orders: Array(edsl.InternalOrderRequest) = [{
        measure: intent.sort_by,
        subject: subject,
        direction,
    }];
    let plan = edsl.lower_internal_top(payload, request, internal_orders);
    let validated = qb.validate(plan, payload.profile);
    qb.transform_sqlite(validated)
};

def build_related_spec: Fn(edsl.PreparedPayload, RelatedClause) -> edsl.ExistsRequest = fn(payload, related) {
    let spec: edsl.ExistsRequest = {
        target: related.target,
        subject: subject,
        filters: build_filters(related.filters),
        any_of: [],
        min_matches: related.min_matches,
    };
    spec
};

def lower_related_exists: Fn(edsl.PreparedPayload, RelatedExistsIntent) -> qb.Query = fn(payload, intent) {
    let request = build_request(
        intent.measures,
        intent.dimensions,
        intent.filters,
        intent.order,
        intent.limit,
        intent.offset,
    );
    let spec = build_related_spec(payload, intent.related);
    let lowered = edsl.lower_full(payload, request, [spec], []);
    let finalized = finalize_plan_ordered(payload, intent.dimensions, intent.measures, lowered, intent.output_order);
    let validated = qb.validate(finalized, payload.profile);
    qb.transform_sqlite(validated)
};

def lower_related_absent: Fn(edsl.PreparedPayload, RelatedAbsentIntent) -> qb.Query = fn(payload, intent) {
    let request = build_request(
        intent.measures,
        intent.dimensions,
        intent.filters,
        intent.order,
        intent.limit,
        intent.offset,
    );
    let spec = build_related_spec(payload, intent.related);
    let lowered = edsl.lower_absence(payload, request, [spec], []);
    let finalized = finalize_plan_ordered(payload, intent.dimensions, intent.measures, lowered, intent.output_order);
    let validated = qb.validate(finalized, payload.profile);
    qb.transform_sqlite(validated)
};

def set_kind_of: Fn(String) -> qb.SetOpKind = fn(kind) {
    match kind {
        "intersect" => 'Intersect,
        "except" => 'Except,
        "union" => 'Union,
        _ => fail!("rule: unknown set operation kind", kind),
    }
};

def operand_request: Fn(OrdinaryIntent) -> edsl.QueryRequest = fn(operand) {
    build_request(
        operand.measures,
        operand.dimensions,
        operand.filters,
        operand.order,
        operand.limit,
        operand.offset,
    )
};

def lower_set_combine: Fn(edsl.PreparedPayload, SetOperandIntent) -> qb.Query = fn(payload, intent) {
    let kind = set_kind_of(intent.kind);
    edsl.lower_set(kind, payload, operand_request(intent.left), operand_request(intent.right))
};

def lower_set_count: Fn(edsl.PreparedPayload, SetOperandIntent) -> qb.Query = fn(payload, intent) {
    let kind = set_kind_of(intent.kind);
    edsl.lower_set_count(kind, payload, operand_request(intent.left), operand_request(intent.right))
};

def having_op_of: Fn(String) -> edsl.HavingOp = fn(op) {
    match parse_having_op(op) {
        'Some(o) => o,
        'None => fail!("rule: unknown HAVING operator", op),
    }
};

def having_filter_input: Fn(ScalarValue) -> edsl.FilterInput = fn(threshold) {
    match threshold {
        'Int(i) => {
            let out: edsl.FilterInput = 'Int(i);
            out
        },
        'Float(f) => {
            let out: edsl.FilterInput = 'Number(f);
            out
        },
        _ => fail!("type: HAVING threshold must be a numeric value"),
    }
};

def build_having_request: Fn(HavingPredicate) -> edsl.HavingRequest = fn(p) {
    let req: edsl.HavingRequest = {
        measure: p.measure,
        subject: subject,
        op: having_op_of(p.op),
        threshold: having_filter_input(p.threshold),
    };
    req
};

def build_internal_having_request: Fn(HavingPredicate) -> edsl.InternalHavingRequest = fn(p) {
    let req: edsl.InternalHavingRequest = {
        measure: p.measure,
        subject: subject,
        op: having_op_of(p.op),
        threshold: having_filter_input(p.threshold),
    };
    req
};

def lower_selected_having: Fn(edsl.PreparedPayload, SelectedHavingIntent) -> qb.Query = fn(payload, intent) {
    let request = build_request(
        intent.measures,
        intent.dimensions,
        intent.filters,
        intent.order,
        intent.limit,
        intent.offset,
    );
    let having: Array(edsl.HavingRequest) = array.map(intent.having, build_having_request);
    let lowered = edsl.lower_full(payload, request, [], having);
    let finalized = finalize_plan_ordered(payload, intent.dimensions, intent.measures, lowered, intent.output_order);
    let validated = qb.validate(finalized, payload.profile);
    qb.transform_sqlite(validated)
};

def lower_hidden_having_variant: Fn(edsl.PreparedPayload, HiddenHavingIntent) -> qb.Query = fn(payload, intent) {
    let request = build_request(
        intent.measures,
        intent.dimensions,
        intent.filters,
        intent.order,
        intent.limit,
        intent.offset,
    );
    let hidden: Array(edsl.InternalHavingRequest) = array.map(intent.having, build_internal_having_request);
    let lowered = edsl.lower_hidden_having(payload, request, hidden);
    let finalized = finalize_plan_ordered(payload, intent.dimensions, intent.measures, lowered, intent.output_order);
    let validated = qb.validate(finalized, payload.profile);
    qb.transform_sqlite(validated)
};

def build_scalar_compare_request: Fn(AttributeComparePredicate) -> edsl.ScalarCompareRequest = fn(p) {
    let req: edsl.ScalarCompareRequest = {
        attribute: p.attribute,
        subject: subject,
        op: having_op_of(p.op),
        measure: p.measure,
        scope_filters: build_filters(p.scope_filters),
    };
    req
};

def lower_attribute_aggregate_compare: Fn(edsl.PreparedPayload, AttributeAggregateCompareIntent) -> qb.Query = fn(payload, intent) {
    let request = build_request(
        [],
        intent.dimensions,
        intent.filters,
        intent.order,
        intent.limit,
        intent.offset,
    );
    let comparisons: Array(edsl.ScalarCompareRequest) = array.map(intent.comparisons, build_scalar_compare_request);
    let lowered = edsl.lower_attribute_compare(payload, request, comparisons);
    let finalized = finalize_plan(payload, intent.dimensions, [], lowered);
    let validated = qb.validate(finalized, payload.profile);
    qb.transform_sqlite(validated)
};

def build_related_hidden_spec: Fn(edsl.PreparedPayload, RelatedHiddenClause) -> edsl.ExistsRequest = fn(payload, related) {
    let spec: edsl.ExistsRequest = {
        target: related.target,
        subject: subject,
        filters: build_filters(related.filters),
        any_of: [],
        min_matches: 'None,
    };
    spec
};

def lower_related_hidden_row_order: Fn(edsl.PreparedPayload, RelatedHiddenRowOrderIntent) -> qb.Query = fn(payload, intent) {
    let ordering: Array(IntentOrder) = [{
        measure: 'None,
        dimension: 'Some(intent.sort_by),
        direction: intent.direction,
    }];
    let request = build_request(
        [],
        intent.dimensions,
        intent.filters,
        ordering,
        intent.limit,
        intent.offset,
    );
    let spec = build_related_hidden_spec(payload, intent.related);
    let lowered = edsl.lower_full(payload, request, [spec], []);
    let finalized = finalize_plan(payload, intent.dimensions, [], lowered);
    let validated = qb.validate(finalized, payload.profile);
    qb.transform_sqlite(validated)
};

def lower_related_set_plan: Fn(edsl.PreparedPayload, RelatedSetOperand) -> qb.Plan = fn(payload, operand) {
    let request = build_request(
        [],
        operand.dimensions,
        operand.filters,
        [],
        'None,
        'None,
    );
    let spec = build_related_spec(payload, operand.related);
    let lowered = edsl.lower_full(payload, request, [spec], []);
    let validated = qb.validate(lowered, payload.profile);
    validated
};

def lower_related_set_combine: Fn(edsl.PreparedPayload, RelatedSetIntent) -> qb.Query = fn(payload, intent) {
    let kind = set_kind_of(intent.kind);
    let left = lower_related_set_plan(payload, intent.left);
    let right = lower_related_set_plan(payload, intent.right);
    qb.transform_sqlite_set(kind, left, right)
};

def lower_related_set_count: Fn(edsl.PreparedPayload, RelatedSetIntent) -> qb.Query = fn(payload, intent) {
    let kind = set_kind_of(intent.kind);
    let left = lower_related_set_plan(payload, intent.left);
    let right = lower_related_set_plan(payload, intent.right);
    qb.transform_sqlite_set_count(kind, left, right)
};

def resolve: Fn(edsl.PreparedPayload, Intent) -> qb.Query = fn(payload, intent) {
    if !payload.authorize(subject) {
        fail!("auth: subject is not authorized for world intent")
    } else {
        match intent_problem(payload, intent) {
            'Some(message) => fail!(message),
            'None => match intent {
                'Ordinary(o) => lower_ordinary(payload, o),
                'DistinctDimensions(d) => lower_distinct_dimensions(payload, d),
                'HiddenRowOrder(h) => lower_hidden_row_order(payload, h),
                'HiddenAggregateOrder(h) => lower_hidden_aggregate_order(payload, h),
                'RelatedExists(e) => lower_related_exists(payload, e),
                'RelatedAbsent(a) => lower_related_absent(payload, a),
                'SetCombine(s) => lower_set_combine(payload, s),
                'SetCount(s) => lower_set_count(payload, s),
                'SelectedHaving(h) => lower_selected_having(payload, h),
                'HiddenHaving(h) => lower_hidden_having_variant(payload, h),
                'AttributeAggregateCompare(c) => lower_attribute_aggregate_compare(payload, c),
                'RelatedHiddenRowOrder(r) => lower_related_hidden_row_order(payload, r),
                'RelatedSetCombine(s) => lower_related_set_combine(payload, s),
                'RelatedSetCount(s) => lower_related_set_count(payload, s),
            },
        }
    }
};

# ---------------------------------------------------------------------------
# Decoding helpers.
# ---------------------------------------------------------------------------

def intent_of_value: Fn(Value) -> Result(Intent, String) = fn(raw) {
    match codec.decode(Intent, raw) {
        'Ok(x) => {
            let ok: Result(Intent, String) = 'Ok(x);
            ok
        },
        'Err(_) => {
            let err: Result(Intent, String) = 'Err("unsupported: input JSON is not one of the closed world intent kinds (Ordinary, DistinctDimensions, HiddenRowOrder, HiddenAggregateOrder, RelatedExists, RelatedAbsent, SetCombine, SetCount, SelectedHaving, HiddenHaving, AttributeAggregateCompare, RelatedHiddenRowOrder, RelatedSetCombine, RelatedSetCount)");
            err
        },
    }
};

def parse_intent: Fn(String) -> Result(Intent, String) = fn(text) {
    match json.parse(text) {
        'Ok(value) => intent_of_value(value),
        'Err(_) => {
            let err: Result(Intent, String) = 'Err("input is not valid JSON");
            err
        },
    }
};

export {
    IntentMeasure,
    IntentDimension,
    IntentFilter,
    IntentOrder,
    OrdinaryIntent,
    DistinctDimensionsIntent,
    HiddenRowOrderIntent,
    HiddenAggregateOrderIntent,
    RelatedClause,
    RelatedExistsIntent,
    RelatedAbsentIntent,
    SetOperandIntent,
    HavingPredicate,
    SelectedHavingIntent,
    HiddenHavingIntent,
    AttributeComparePredicate,
    AttributeAggregateCompareIntent,
    RelatedHiddenClause,
    RelatedHiddenRowOrderIntent,
    RelatedSetOperand,
    RelatedSetIntent,
    Intent,
    subject,
    parse_op,
    value_kind,
    dimensions_problem,
    filters_problem,
    measures_problem,
    ordinary_problem,
    distinct_dimensions_problem,
    hidden_row_order_problem,
    hidden_aggregate_order_problem,
    related_exists_problem,
    related_absent_problem,
