pub def chained_business_links_in_existence: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"peer","entity":"device"},{"id":"upstream","entity":"device"}],
            "edges":[{"relation":"connected_device","from":"d","to":"peer"},
                     {"relation":"upstream_device","from":"peer","to":"upstream"}],
            "filters":[{"node":"upstream","dimension":"device_id","op":"eq","kind":"text","value":"target"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "EXISTS (SELECT 1 FROM connections AS connected_device_link")
        && string::contains(sq.sql, "JOIN routes AS upstream_device_link")
        && string::contains(sq.sql, "upstream.id = ?1")
        && string::contains(pg.sql, "JOIN \"routes\" AS \"upstream_device_link\"")
        && sq.bindings == [qb::Val::String("target")]
        && pg.bindings == sq.bindings {
        True
    } else { fail!("chained business links lost correlation, identity, or binding", sq, pg) }
});

pub def chained_business_links_reject_reverse_direction: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"d", "nodes":[{"id":"d","entity":"device"}],
        "edges":[], "select":[], "count":"d",
