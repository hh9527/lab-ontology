use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::diagnostics as diagnostics;
use std::test as test;

def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Column,
        qb::Operator::Bind,
        qb::Operator::Scalar,
        qb::Operator::Filter
    ],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [qb::ScalarFunction::Eq],
    allow_distinct: False,
};

@edsl::entity_id("first")
@edsl::entity_source("first_table", "first_source")
type First = struct {
    @edsl::column("name")
    @edsl::dimension("shared_name", True, False, [], [])
    name: String,
    @edsl::column("other")
    @edsl::dimension("alphabetically_first", True, False, [], [])
    other: String,
};

@edsl::entity_id("second")
@edsl::entity_source("second_table", "second_source")
type Second = struct {
    @edsl::column("name")
    @edsl::dimension("shared_name", True, False, [], [])
    name: String,
    @edsl::column("other")
    @edsl::dimension("alphabetically_first", True, False, [], [])
    other: String,
};

@edsl::entity_id("empty")
@edsl::entity_source("empty_table", "empty_source")
type EmptyName = struct {
    @edsl::column("name")
    @edsl::dimension("", True, False, [], [])
    name: String,
};

pub def dimension_ids_are_unique_across_datasets: test::Test = test::should_fail_with(
    fn() {
        edsl::build_root("duplicate-dimensions", [First.type, Second.type], profile)
    },
    "duplicate dimension id"
);

pub def duplicate_diagnostic_preserves_declaration_order: test::Test = test::should_ok(
    fn() {
        # Compare argument origins independently of dictionary key order or line numbers.
        let first_id = edsl::build_root("unique", [First.type], profile).dimensions[0].id;
        let expected = diagnostics::with_diagnostics(
            fn(id: String) {
                if id == "" {
                    True
                } else {
                    fail!("duplicate dimension id", id)
                }
            }
        )(first_id);
        let actual = diagnostics::with_diagnostics(
            fn(types: Array(Type)) {
                edsl::build_root("duplicate-order", types, profile)
            }
        )([First.type, Second.type]);
        match (actual, expected) {
            (Err(reports), Err(reference)) => if array::length(reports) == 1 && reports[0].message == "duplicate dimension id" && array::length(
                reports[0].locs
            ) == 2 && reports[0].locs[1] == reference[0].locs[1] {
                True
            } else {
                fail!("duplicate diagnostic must select the first declaration", reports)
            },
            _ => fail!("duplicate dimension ids must be rejected"),
        }
    }
);

pub def empty_dimension_ids_are_rejected: test::Test = test::should_fail_with(
    fn() {
        edsl::build_root("empty-dimension", [EmptyName.type], profile)
    },
    "dimension id must be nonempty"
);

pub def empty_id_diagnostic_precedes_duplicates: test::Test = test::should_fail_with(
    fn() {
        edsl::build_root(
            "empty-before-duplicate",
            [First.type, Second.type, EmptyName.type],
            profile
        )
    },
    "dimension id must be nonempty"
);

pub def predicate_requires_every_operator_used_by_its_expression: test::Test = test::should_ok(
    fn() {
        let source = qb::source_with_hint(qb::build_context(), "trusted_table", "t");
        let bound = qb::bind(source.0, qb::Val::String("name"));
        let expression = qb::scalar(qb::ScalarFunction::Eq, [qb::column(source.1, "name"), bound.1]);
        if qb::predicate_profile_accepts(expression, profile) && array::all(
            profile.allowed_operators,
            fn(missing) {
                !qb::predicate_profile_accepts(
                    expression,
                    {
                        ...profile,
                        allowed_operators: array::filter(
                            profile.allowed_operators,
                            fn(op) {
                                op != missing
                            }
                        )
                    }
                )
            }
        ) {
            True
        } else {
            fail!(
                "predicate profile must require its filter, scalar, column and binding capabilities"
            )
        }
    }
);

pub def predicate_requires_scalars_in_nested_expressions: test::Test = test::should_ok(
    fn() {
        let source = qb::source_with_hint(qb::build_context(), "trusted_table", "t");
        let inner = qb::scalar(
            qb::ScalarFunction::Eq,
            [qb::column(source.1, "name"), qb::column(source.1, "other")]
        );
        let expression = qb::scalar(qb::ScalarFunction::Not, [inner]);
        let nested_profile = {
            ...profile,
            allowed_scalars: [qb::ScalarFunction::Not, qb::ScalarFunction::Eq]
        };
        if qb::predicate_profile_accepts(expression, nested_profile) && array::all(
            nested_profile.allowed_scalars,
            fn(missing) {
                !qb::predicate_profile_accepts(
                    expression,
                    {
                        ...nested_profile,
                        allowed_scalars: array::filter(
                            nested_profile.allowed_scalars,
                            fn(scalar) {
                                scalar != missing
                            }
                        )
                    }
                )
            }
        ) {
            True
        } else {
            fail!("predicate profile must check every nested scalar capability")
        }
    }
);
