def subnet_inputs: Array(edsl::FilterInput) = [
    edsl::FilterInput::Ipv4Subnet("0.0.0.0/0"),
    edsl::FilterInput::Ipv4Subnet("128.0.0.0/1"),
    edsl::FilterInput::Ipv4Subnet("192.0.0.0/8"),
    edsl::FilterInput::Ipv4Subnet("192.0.0.0/9"),
    edsl::FilterInput::Ipv4Subnet("192.0.0.0/16"),
    edsl::FilterInput::Ipv4Subnet("192.0.0.0/17"),
    edsl::FilterInput::Ipv4Subnet("192.0.2.0/24"),
    edsl::FilterInput::Ipv4Subnet("192.0.2.0/25"),
    edsl::FilterInput::Ipv4Subnet("192.0.2.1/32"),
];

def profiles: Array(qb::PlanProfile) = array::concat([[profile],
    array::map(profile.allowed_scalars, fn(missing) { {...profile,
        allowed_scalars: array::filter(profile.allowed_scalars, fn(op) { op != missing })} }),
    array::map(profile.allowed_operators, fn(missing) { {...profile,
        allowed_operators: array::filter(profile.allowed_operators, fn(op) { op != missing })} })]);

def accepts: Fn(Type, qb::PlanProfile) -> Bool = fn(ty, candidate) {
    match diagnostics::with_diagnostics(fn(p: qb::PlanProfile) {
        edsl::build_root("profile-matrix", [ty], p)
    })(candidate) { Ok(_) => True, Err(_) => False }
};

# Compare preparation against real filter ASTs, including every representative
# subnet shape. Removing one capability at a time catches both overrestriction
# and missing checks; a computed base must retain its own capabilities.
def agrees: Fn(Type, edsl::FilterOp, Array(edsl::FilterInput)) -> Bool = fn(ty, op, inputs) {
    let payload = edsl::build_root("oracle", [ty], profile);
    let expressions = array::map(inputs, fn(input) {
        edsl::resolve_filters_with_context(qb::build_context(), payload, [{id: "value", op, input}]).1[0].expr
    });
    array::all(profiles, fn(candidate) {
        let expected = array::all(expressions, fn(expr) { qb::predicate_profile_accepts(expr, candidate) });
        if accepts(ty, candidate) == expected { True }
        else { fail!("preparation disagrees with generated filter capabilities", ty, op, candidate, expected) }
    })
};

pub def TextEq_matches_generated_ast: test::Test = test::should_ok(fn() {
    agrees(TextEq.type, edsl::FilterOp::Eq, [edsl::FilterInput::Text("probe")])
});

pub def TextNe_matches_generated_ast: test::Test = test::should_ok(fn() {
    agrees(TextNe.type, edsl::FilterOp::Ne, [edsl::FilterInput::Text("probe")])
});

