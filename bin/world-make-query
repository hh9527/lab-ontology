#!/bin/sh
set -eu

usage() {
    echo "usage: world-make-query check" >&2
    exit 64
}

[ "$#" -eq 1 ] || usage
[ "$1" = "check" ] || usage

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
telora=$project_root/bin/telora
model=$project_root/world-model
work_dir=$project_root/world-eval
input=$work_dir/input.json
ok=$work_dir/ok.json
diagnostic=$work_dir/diagnostic.jsonl

mkdir -p "$work_dir"
: > "$ok"
: > "$diagnostic"

fail() {
    code=$1
    message=$2
    printf '{"message":"%s","record":"error","schema":"world-make-query.error/v1"}\n' \
        "$message" > "$diagnostic"
    printf 'exit code: %s\n' "$code"
    exit "$code"
}

[ -x "$telora" ] || fail 69 "world-make-query: Telora executable is unavailable"
[ -f "$model/telora-crate.json" ] || fail 69 "world-make-query: World model is unavailable"
[ -f "$input" ] || fail 66 "world-make-query: input.json is unavailable"

set +e
"$telora" -C "$model" eval-with @src/bin/make-query:main \
    --source "input=$input" > "$ok" 2> "$diagnostic"
code=$?
set -e

if [ "$code" -ne 0 ]; then
    : > "$ok"
fi

printf 'exit code: %s\n' "$code"
exit "$code"
