# world-model/tests/query.telora
#
# Contract tests for the world_1 intent resolver over the closed tagged family:
#   - `ordinary`, `distinct_dimensions`, `hidden_row_order`,
#     `hidden_aggregate_order`, `related_exists` / `related_absent`,
#     `set_combine` / `set_count`, `selected_having` / `hidden_having`,
#     `attribute_aggregate_compare` (global + scoped),
#     `related_hidden_row_order`, `related_set_combine` / `related_set_count`;
#   - complete numeric aggregate vocabulary;
#   - exact public projection invariant (no helper measure leaked into SELECT);
#   - explicit public projection order (`output_order`).
# Shared vocabulary/type validation, categorized rejection, binding order and
# deterministic repeated lowering are asserted across the variants.

import "@src/model" { payload };
import "@src/query" {
    Intent,
    parse_intent,
    intent_problem,
    resolve,
};
import "ontology/query" as qb;
import "std/array" as array;
import "std/string" as string;

def intent_of_text: Fn(String) -> Intent = fn(text) {
    match parse_intent(text) {
        'Ok(i) => i,
        'Err(message) => fail!("test intent did not parse", message),
    }
};

def run_text: Fn(String) -> qb.Query = fn(text) {
    resolve(payload, intent_of_text(text))
};

def problem_text: Fn(String) -> Option(String) = fn(text) {
    intent_problem(payload, intent_of_text(text))
};

def contains_literal: Fn(String, String) -> Bool = fn(sql, literal) {
    array.length(string.split(sql, literal)) > 1
};

def binding_count: Fn(qb.Query) -> Int = fn(q) {
    array.length(q.bindings)
};

def grouped_intent: Fn(String, String) -> String = fn(measure, dimension) {
    `{"Ordinary":{"measures":[{"id":"\{measure}","mode":"all"}],"dimensions":[{"id":"\{dimension}"}],"filters":[],"order":[],"limit":null,"offset":null,"output_order":[]}}`
};

def ungrouped_intent: Fn(String) -> String = fn(measure) {
    `{"Ordinary":{"measures":[{"id":"\{measure}","mode":"all"}],"dimensions":[],"filters":[],"order":[],"limit":null,"offset":null,"output_order":[]}}`
};

