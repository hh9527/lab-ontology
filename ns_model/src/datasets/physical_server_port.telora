use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::physical_server;
@domain::subject("PhysicalServerPort", "id")
@domain::dataset("physical-server-port", "PhysicalServerPort", ["id"])
@domain::relations(relations)
pub type PhysicalServerPort = struct {
    @g::field_view(g::dimension_group("physical-server-port/id", ids::PhysicalServerPortById.type, True, [g::Filter::Eq]), "phsepo_id", True, [g::Filter::Eq])
    @domain::count("phsepo_count")
    id: ids::PhysicalServerPortById,
    @g::field_view(g::dimension_group("physical-server-port/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "phsepo_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("portType")
    @g::field_view(g::dimension_group("physical-server-port/port_type/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "phsepo_port_type_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::PhsepoPortType.type, "phsepo_port_type", [v::member(domains::PhsepoPortType::OpticalPort, ["OpticalPort"]), v::member(domains::PhsepoPortType::ElectricalPort, ["ElectricalPort"])])
    port_type: Option(String),
    @m::column("linkStatus")
    @g::field_view(g::dimension_group("physical-server-port/link_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "phsepo_link_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::PhsepoLinkStatus.type, "phsepo_link_status", [v::member(domains::PhsepoLinkStatus::LinkUp, ["Up"]), v::member(domains::PhsepoLinkStatus::LinkDown, ["Down"]), v::member(domains::PhsepoLinkStatus::NoLink, ["NoLink"]), v::member(domains::PhsepoLinkStatus::Unknown, ["Unknown"])])
    link_status: Option(String),
    @m::column("cardResId")
    @g::field_view(g::dimension_group("physical-server-port/card_res_id", String.type, True, [g::Filter::Eq]), "phsepo_card_res_id", True, [g::Filter::Eq])
    card_res_id: Option(String),
    @m::column("macAddress")
    @g::field_view(g::dimension_group("physical-server-port/mac_address", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "phsepo_mac_address", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    mac_address: Option(String),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("physical-server-port/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "phsepo_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
};

pub def relations: Array(r::Relation) = [
    r::relation("phsepo__ps_rev", domain::endpoint(PhysicalServerPort.type, "parent_res_id"), domain::endpoint(physical_server::PhysicalServer.type, "ori_res_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
