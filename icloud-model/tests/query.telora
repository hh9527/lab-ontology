def lower_json: Fn(String) -> qb::Query = fn(source) {
    let value: Value = json::parse(source).unwrap!();
    intent::query_intent_lower_factory(payload, "public")(value)
};

pub def local_epoch_millis_is_discoverable: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "device", "create_time");
    if role.semantics == edsl::TimeSemantics::Local
        && role.encoding == edsl::TimeEncoding::LocalEpochMillis {
        True
    } else { fail!("creation time must disclose its local epoch-ms encoding", role) }
});

pub def time_roles_are_reachable_from_subject_knowledge_index: test::Test = test::should_ok(fn() {
    let scoped = edsl::knowledge_index_for_subject(payload, "public");
    let complete = edsl::knowledge_index(payload);
    let device = match array::find(scoped, fn(entry) { entry.id == "device" }) {
        Some(entry) => entry, None => fail!("device missing from knowledge index"),
    };
    let kpi = match array::find(scoped, fn(entry) { entry.id == "device_kpi" }) {
        Some(entry) => entry, None => fail!("KPI missing from knowledge index"),
    };
    let alarm = match array::find(scoped, fn(entry) { entry.id == "current_alarm" }) {
        Some(entry) => entry, None => fail!("alarm missing from knowledge index"),
    };
    let full_alarm = match array::find(complete, fn(entry) { entry.id == "current_alarm" }) {
        Some(entry) => entry, None => fail!("alarm missing from full index"),
    };
    let created = array::find(device.time_roles, fn(role) { role.field == "create_time" });
    let sampled = array::find(kpi.time_roles, fn(role) { role.field == "ts" });
    let occurred = array::find(alarm.time_roles, fn(role) { role.field == "occur_utc" });
    let arrived = array::find(alarm.time_roles, fn(role) { role.field == "arrive_utc" });
    let local_alarm = array::find(full_alarm.time_roles, fn(role) { role.field == "occur_time" });
    let local_ok = match created {
        Some(role) => role.semantics == edsl::TimeSemantics::Local
            && role.encoding == edsl::TimeEncoding::LocalEpochMillis
            && !role.authoritative && role.dimension_ids == ["device_create_ms"],
        None => False,
    };
    let kpi_ok = match sampled {
        Some(role) => role.semantics == edsl::TimeSemantics::Utc
            && role.encoding == edsl::TimeEncoding::CanonicalUtcSecondText
            && role.authoritative && role.dimension_ids == ["device_kpi_ts_raw"],
        None => False,
    };
    let alarm_ok = match occurred {
        Some(role) => role.authoritative && role.dimension_ids == ["alarm_occur_utc_raw"],
        None => False,
    };
    let arrival_ok = match arrived {
        Some(role) => !role.authoritative && role.semantics == edsl::TimeSemantics::Utc
            && role.encoding == edsl::TimeEncoding::CanonicalUtcSecondText
            && array::length(role.dimension_ids) == 0,
        None => False,
    };
    let full_local_ok = match local_alarm {
        Some(role) => role.semantics == edsl::TimeSemantics::Local
            && role.encoding == edsl::TimeEncoding::LocalText
            && !role.authoritative && array::length(role.dimension_ids) == 0,
        None => False,
    };
    if local_ok && kpi_ok && alarm_ok && arrival_ok && full_local_ok
        && array::length(alarm.time_roles) == 2 { True }
    else { fail!("time discovery lost role, authority, or queryability", device, kpi, alarm, full_alarm) }
});

pub def local_epoch_millis_filters_use_supplied_bounds: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"list","measures":[],"dimensions":["device_name"],"filters":[{"dimension":"device_create_ms","op":"ge","kind":"int","value":1718467200000},{"dimension":"device_create_ms","op":"lt","kind":"int","value":1718467201000}],"ordering":[],"limit":null,"offset":null}`);
    if array::length(string::split(q.sql, "d.createTime >= ?")) == 2
        && array::length(string::split(q.sql, "d.createTime < ?")) == 2
        && q.bindings == [qb::Val::Int(1718467200000), qb::Val::Int(1718467201000)] {
        True
    } else { fail!("local epoch-ms filter must use externally resolved integer bounds", q) }
});

pub def local_epoch_millis_rejects_unresolved_text: test::Test = test::should_fail_with(fn() {
    lower_json(`{"op":"list","measures":[],"dimensions":["device_name"],"filters":[{"dimension":"device_create_ms","op":"ge","kind":"text","value":"2024-06-15 16:00:00"}],"ordering":[],"limit":null,"offset":null}`)
}, "invalid filter value for dimension");

pub def dataset_grain_and_time_are_discoverable: test::Test = test::should_ok(fn() {
    let device = edsl::dataset_domain(payload, "device");
    let frame = edsl::dataset_domain(payload, "frame");
    let alarm = edsl::dataset_domain(payload, "current_alarm");
    let kpi = edsl::dataset_domain(payload, "device_kpi");
    if device.kind == edsl::DatasetKind::Entity && device.grain == ["id", "tenant_id"]
        && device.utc_time == None
        && frame.kind == edsl::DatasetKind::Entity && frame.grain == ["id", "tenant_id"]
        && alarm.kind == edsl::DatasetKind::Event && alarm.grain == ["csn"]
        && alarm.utc_time == Some("occur_utc")
        && kpi.kind == edsl::DatasetKind::Metric
        && kpi.grain == ["res_id", "tenant_id", "ts"]
        && kpi.utc_time == Some("ts") {
        True
    } else {
        fail!("event and KPI dataset roles must be discoverable", alarm, kpi)
    }
});

pub def device_kpi_metric_contract_is_discoverable: test::Test = test::should_ok(fn() {
    let metrics = edsl::metric_domain(payload, "device_kpi");
    match (array::find(metrics, fn(m) { m.id == "cpu_usage" }),
        array::find(metrics, fn(m) { m.id == "cpu_peak" }),
        array::find(metrics, fn(m) { m.id == "memory_usage" }),
        array::find(metrics, fn(m) { m.id == "port_count" })) {
        (Some(cpu), Some(cpu_peak), Some(memory), Some(ports)) => if array::length(metrics) == 10
            && cpu.id == "cpu_usage" && cpu.field == "cpu_usage"
            && cpu.aggregate == qb::AggregateFunction::Avg && cpu.unit == Some("%")
            && cpu.role == edsl::MetricValueRole::DeclaredMetric
            && cpu_peak.id == "cpu_peak" && cpu_peak.field == "cpu_usage"
            && cpu_peak.aggregate == qb::AggregateFunction::Max && cpu_peak.unit == cpu.unit
            && cpu_peak.role == edsl::MetricValueRole::SampleSummary
            && memory.id == "memory_usage" && memory.aggregate == qb::AggregateFunction::Avg
            && ports.id == "port_count" && ports.aggregate == qb::AggregateFunction::Sum
            && ports.role == edsl::MetricValueRole::DeclaredMetric
            && array::any(metrics, fn(m) { m.id == "port_count_peak" && m.field == "port_count"
                && m.aggregate == qb::AggregateFunction::Max && m.unit == ports.unit
                && m.role == edsl::MetricValueRole::SampleSummary })
            && array::any(metrics, fn(m) { m.id == "port_count_sample_avg" && m.field == "port_count"
                && m.aggregate == qb::AggregateFunction::Avg && m.unit == ports.unit
                && m.role == edsl::MetricValueRole::SampleSummary })
            && array::any(metrics, fn(m) { m.id == "running_port_count"
                && m.aggregate == qb::AggregateFunction::Sum && m.role == edsl::MetricValueRole::DeclaredMetric })
            && array::any(metrics, fn(m) { m.id == "used_port_count"
                && m.aggregate == qb::AggregateFunction::Sum && m.role == edsl::MetricValueRole::DeclaredMetric })
            && array::any(metrics, fn(m) { m.id == "used_port_sample_avg"
                && m.aggregate == qb::AggregateFunction::Avg && m.role == edsl::MetricValueRole::SampleSummary })
            && array::any(metrics, fn(m) { m.id == "running_port_sample_avg"
                && m.aggregate == qb::AggregateFunction::Avg && m.role == edsl::MetricValueRole::SampleSummary }) {
            True
        } else {
            fail!("device KPI metric metadata differs from iCloud", metrics)
        },
        _ => fail!("missing device KPI metric contract", metrics),
    }
});

pub def independent_average_sample_summaries_qualify_device_count: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"qualify_metrics","measures":["device_count"],"dimensions":[],"filters":[{"dimension":"device_class","op":"eq","kind":"text","value":"router"}],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-26T00:00:00Z","end":"2024-02-29T00:00:00Z"},"having":{"measure":"memory_usage","op":"ge","kind":"number","value":47.5}},{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-26T00:00:00Z","end":"2024-02-29T00:00:00Z"},"having":{"measure":"port_count_sample_avg","op":"ge","kind":"int","value":48}}]}`);
    if array::length(string::split(q.sql, "avg(k_qualification.memUsage) >= ?")) == 2
        && array::length(string::split(q.sql, "avg(k_qualification.portCount) >= ?")) == 2
        && array::length(string::split(q.sql, "d.tenant_id = k_qualification.tenantId")) == 3
        && array::length(string::split(q.sql, "EXISTS (")) == 3
        && array::length(string::split(q.sql, "JOIN NetworkDeviceKPI")) == 1 {
        True
    } else { fail!("Q0091 requires independent Avg samples, not the published Sum metric", q) }
});

pub def running_ports_sample_average_does_not_override_sum_metric: test::Test = test::should_ok(fn() {
