    @g::field_view(g::dimension_group("kpi-server-device/outlet_air_temperature", metric::KpiServerDeviceOutletAirTemperature.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sede_outlet_air_temperature_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
