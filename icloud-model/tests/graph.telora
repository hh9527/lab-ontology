pub def empty_population_rejects_where_constraint: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"server",
        "nodes":[{"id":"server","entity":"server_device"},{"id":"tenant","entity":"tenant"}],
