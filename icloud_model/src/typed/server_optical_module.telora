use super::classifications as classes;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("ServerOpticalModule")
type ServerOpticalModuleById = struct(ComponentId);
type ChannelCount = struct(Int);
@domain::subject("ServerOpticalModule", "source_id")
@domain::dataset("source_PhysicalServerOpticalModule", "PhysicalServerOpticalModule", ["source_id"])
@domain::relations(relations)
type PhysicalServerOpticalModule = struct {
    @m::column("name")
    @g::search("source_PhysicalServerOpticalModule__name")
    source_name: String,
    @m::column("tenantId")
    @g::exact("source_PhysicalServerOpticalModule__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("id")
    @g::exact("source_PhysicalServerOpticalModule__id")
    source_id: ServerOpticalModuleById,
    @m::column("partNumber")
    @g::search("source_PhysicalServerOpticalModule__partNumber")
    source_partNumber: String,
    @m::column("channelNum")
    @g::field_view(
        g::dimension_group(
            "source_PhysicalServerOpticalModule__channelNum",
            ChannelCount.type,
            True,
            g::numeric_filters
        ),
        "source_PhysicalServerOpticalModule__channelNum",
        True,
        g::numeric_filters
    )
    source_channelNum: ChannelCount,
    @m::column("portResId")
    @g::exact("source_PhysicalServerOpticalModule__portResId")
    source_portResId: String,
    @m::column("cardResId")
    @g::exact("source_PhysicalServerOpticalModule__cardResId")
    source_cardResId: String,
    @m::column("serialNumber")
    @g::search("source_PhysicalServerOpticalModule__serialNumber")
    source_serialNumber: String,
    @m::column("operStatus")
    @g::exact("source_PhysicalServerOpticalModule__operStatus_raw")
    @v::map(
        SourcePhysicalServerOpticalModuleOperStatus.type,
        "source_PhysicalServerOpticalModule__operStatus",
        [
            v::member(SourcePhysicalServerOpticalModuleOperStatus::Normal, ["OK"]),
            v::member(SourcePhysicalServerOpticalModuleOperStatus::Warning, ["Warning"]),
            v::member(SourcePhysicalServerOpticalModuleOperStatus::Critical, ["Critical"]),
            v::member(SourcePhysicalServerOpticalModuleOperStatus::Unknown, ["Unknown"])
        ]
    )
    source_operStatus: String,
    @m::column("adminStatus")
    @g::exact("source_PhysicalServerOpticalModule__adminStatus")
    source_adminStatus: String,
    @m::column("transType")
    @g::exact("source_PhysicalServerOpticalModule__transType_raw")
    @v::map_or(
        classes::TransceiverKind.type,
        "source_PhysicalServerOpticalModule__transType",
        [
            v::member(classes::TransceiverKind::Optical, ["光模块"]),
            v::member(classes::TransceiverKind::Electrical, ["电模块"])
        ],
        classes::TransceiverKind::Unknown
    )
    source_transType: String,
    @m::column("vendorSn")
    @g::search("source_PhysicalServerOpticalModule__vendorSn")
    source_vendorSn: String,
    @m::column("vendorName")
    @g::search("source_PhysicalServerOpticalModule__vendorName")
    source_vendorName: String,
    @m::column("neResId")
    @g::exact("source_PhysicalServerOpticalModule__neResId")
    source_neResId: domain::Reference(server::ServerByOriginId),
    @m::column("projectId")
    @g::exact("source_PhysicalServerOpticalModule__projectId")
    source_projectId: String,
    @m::column("ifName")
    @g::search("source_PhysicalServerOpticalModule__ifName")
    source_ifName: String,
};

def subject: r::Endpoint = domain::endpoint(PhysicalServerOpticalModule.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(PhysicalServerOpticalModule.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(PhysicalServerOpticalModule.type, "source_neResId");

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerOpticalModuleOperStatus = enum {
    @ev::description("normal", "正常")
    Normal,

    @ev::description("warning", "警告")
    Warning,

    @ev::description("critical", "紧急")
    Critical,

    @ev::description("unknown", "未知")
    Unknown,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_PhysicalServer_PhysicalServerOpticalModule",
        server::origin,
        parent,
        cardinality
    ),
    r::relation(
        "source_PhysicalServerOpticalModule_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerOpticalModule, ServerOpticalModuleById};

pub use self::{SourcePhysicalServerOpticalModuleOperStatus};
