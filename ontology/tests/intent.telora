# Cross-model checks for the model-derived intent lowering factory.
#
# The factory is bound only to a `PreparedPayload` and a caller subject.  These
# checks drive it over TWO structurally different domain-neutral prepared models
# (the fictional enterprise `@test/test_knowledge` payload and a local org teams /
# members model) and assert exact SQL, bindings and determinism for the closed
# intent shapes: list, count, field-to-field predicates, hidden row ordering,
# selected HAVING, hidden HAVING, related existence/absence, related hidden
# ordering (top), distinct, set combination and set count.
#
# `query_intent_ok` is the pure contract probe used for the rejection checks;
# the real lowering rejects the same shapes atomically with `fail!` and never
# emits a partial Query.

use crate::ontology as edsl;
use std::test as test;
use crate::intent::{ query_intent_lower_factory, query_intent_ok };
use crate::test_models::test_knowledge::{ payload, profile };
use crate::query as qb;
use std::array as array;
use std::json as json;
use std::value::{ Value };
use std::string as string;

@edsl::entity_id("epoch_events")
@edsl::entity_source("epoch_events", "ee")
@edsl::dataset(edsl::DatasetKind::Event, ["id"], Some("occurred_ms"))
type EpochEvent = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::dimension("EpochEventId", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Int])
    id: Int,
    @edsl::column("occurredMs")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::UtcEpochMillis)
    occurred_ms: Int,
    @edsl::column("receivedMs")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::UtcEpochMillis)
    received_ms: Int,
    @edsl::column("localMs")
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::LocalEpochMillis)
    local_ms: Int,
};

def lower_epoch: Fn(Value) -> qb::Query = query_intent_lower_factory(
    edsl::build_root("epoch-clock-test", [EpochEvent.type], profile, fn(subject) { True }), "analyst");

pub def epoch_window_uses_declared_clock_and_integer_bounds: test::Test = test::should_ok(fn() {
    let query = lower_epoch(parse(r#"{"op":"utc_epoch_window","measures":[],"dimensions":["EpochEventId"],"filters":[],"ordering":[],"window":{"dataset":"epoch_events","field":"occurred_ms","start":1700000000000,"end":1700000001000},"limit":null,"offset":null}"#));
    if string::contains(query.sql, "ee.occurredMs >= ?")
        && string::contains(query.sql, "ee.occurredMs < ?")
        && query.bindings == [qb::Val::Int(1700000000000), qb::Val::Int(1700000001000)] { True }
    else { fail!("UTC epoch-millisecond bounds must retain integer bindings", query) }
});

pub def epoch_window_selects_secondary_utc_clock: test::Test = test::should_ok(fn() {
    let query = lower_epoch(parse(r#"{"op":"utc_epoch_window","measures":[],"dimensions":["EpochEventId"],"filters":[],"ordering":[],"window":{"dataset":"epoch_events","field":"received_ms","start":1700000000000,"end":1700000001000},"limit":null,"offset":null}"#));
    if string::contains(query.sql, "ee.receivedMs >= ?")
        && !string::contains(query.sql, "ee.occurredMs >= ?")
        && query.bindings == [qb::Val::Int(1700000000000), qb::Val::Int(1700000001000)] { True }
    else { fail!("secondary UTC epoch clock must be selected explicitly", query) }
});

@edsl::entity_source("wrong_epoch_clock", "wec")
@edsl::dataset(edsl::DatasetKind::Event, ["id"], Some("occurred"))
type WrongEpochClock = struct {
    @edsl::column("id")
    @edsl::key(True)
    id: Int,
    @edsl::column("occurred")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::UtcEpochMillis)
    occurred: String,
};

pub def epoch_clock_rejects_text_field: test::Test = test::should_fail_with(fn() {
    edsl::build_root("wrong-epoch-clock", [WrongEpochClock.type], profile, fn(subject) { True })
}, "time encoding disagrees with field type");

pub def epoch_window_rejects_local_clock: test::Test = test::should_fail_with(fn() {
    lower_epoch(parse(r#"{"op":"utc_epoch_window","measures":[],"dimensions":["EpochEventId"],"filters":[],"ordering":[],"window":{"dataset":"epoch_events","field":"local_ms","start":100,"end":200},"limit":null,"offset":null}"#))
}, "UTC window encoding does not match");

pub def epoch_window_rejects_reversed_bounds: test::Test = test::should_fail_with(fn() {
    lower_epoch(parse(r#"{"op":"utc_epoch_window","measures":[],"dimensions":["EpochEventId"],"filters":[],"ordering":[],"window":{"dataset":"epoch_events","field":"received_ms","start":200,"end":100},"limit":null,"offset":null}"#))
}, "UTC epoch-millisecond window start must precede end");

pub def text_window_rejects_epoch_clock: test::Test = test::should_fail_with(fn() {
    lower_epoch(parse(r#"{"op":"utc_window","measures":[],"dimensions":["EpochEventId"],"filters":[],"ordering":[],"window":{"dataset":"epoch_events","start":"2024-01-01T00:00:00Z","end":"2024-02-01T00:00:00Z"},"limit":null,"offset":null}"#))
}, "UTC window requires a declared canonical UTC time field");

@edsl::entity_id("epoch_owner")
@edsl::entity_source("epoch_owner", "eo")
@edsl::dataset(edsl::DatasetKind::Entity, ["id", "tenant_id"], None)
type EpochOwner = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::dimension("EpochOwnerId", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    id: String,
    @edsl::column("tenantId")
    @edsl::dimension("EpochOwnerTenant", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    tenant_id: String,
};

@edsl::entity_id("epoch_samples")
@edsl::entity_source("epoch_samples", "es")
@edsl::dataset(edsl::DatasetKind::Metric, ["owner_id", "tenant_id", "ts", "sequence"], Some("ts"))
@edsl::named_relation_key("epoch_sample_owner", EpochOwner.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({from: "owner_id", to: "id"}),
        edsl::RelationKey::FieldEq({from: "tenant_id", to: "tenant_id"}),
    ]))
type EpochSample = struct {
    @edsl::column("ownerId")
    owner_id: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::UtcEpochMillis)
    @edsl::dimension("EpochSampleTs", True, True, [edsl::FilterOp::Ge], [edsl::FilterInputKind::Int])
    ts: Int,
    @edsl::column("receivedMs")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::UtcEpochMillis)
    received_ms: Int,
    @edsl::column("sequence")
    sequence: Int,
    @edsl::column("value")
    @edsl::dimension("EpochSampleValue", True, True, [edsl::FilterOp::Ge], [edsl::FilterInputKind::Int])
    @edsl::measure("EpochSampleSum", qb::AggregateFunction::Sum, [])
    value: Int,
};

def lower_epoch_sample: Fn(Value) -> qb::Query = query_intent_lower_factory(
    edsl::build_root("epoch-sample-test", [EpochOwner.type, EpochSample.type], profile, fn(subject) { True }), "analyst");

pub def epoch_sample_top_preserves_owner_grain: test::Test = test::should_ok(fn() {
    let query = lower_epoch_sample(parse(r#"{"op":"sample_epoch_top","measures":[],"dimensions":["EpochOwnerId","EpochSampleValue","EpochSampleTs"],"filters":[],"ordering":[],"owner":"epoch_owner","relation":"epoch_sample_owner","rank":"EpochSampleValue","take":2,"window":{"dataset":"epoch_samples","field":"ts","start":1700000000000,"end":1700000001000},"limit":null,"offset":null}"#));
    if string::contains(query.sql, "es.ts >= ?")
        && string::contains(query.sql, "PARTITION BY eo.id, eo.tenantId")
        && query.bindings == [qb::Val::Int(1700000000000), qb::Val::Int(1700000001000), qb::Val::Int(2)] { True }
    else { fail!("epoch sample Top-N must bind milliseconds and partition by full owner grain", query) }
});

pub def latest_epoch_sample_uses_authoritative_clock: test::Test = test::should_ok(fn() {
    let query = lower_epoch_sample(parse(r#"{"op":"latest_epoch_sample","dataset":"epoch_samples","owner":"epoch_owner","relation":"epoch_sample_owner","measures":[],"dimensions":["EpochOwnerId","EpochSampleValue","EpochSampleTs"],"filters":[],"ordering":[],"window":{"field":"ts","start":1700000000000,"end":1700000001000},"limit":null,"offset":null}"#));
    if string::contains(query.sql, "es.ts DESC")
        && string::contains(query.sql, "PARTITION BY eo.id, eo.tenantId")
        && query.bindings == [qb::Val::Int(1700000000000), qb::Val::Int(1700000001000), qb::Val::Int(1)] { True }
    else { fail!("latest epoch sample must rank whole rows by the authoritative clock", query) }
});

pub def latest_epoch_sample_rejects_secondary_clock: test::Test = test::should_fail_with(fn() {
    lower_epoch_sample(parse(r#"{"op":"latest_epoch_sample","dataset":"epoch_samples","owner":"epoch_owner","relation":"epoch_sample_owner","measures":[],"dimensions":["EpochOwnerId","EpochSampleValue","EpochSampleTs"],"filters":[],"ordering":[],"window":{"field":"received_ms","start":100,"end":200},"limit":null,"offset":null}"#))
}, "latest sample window must use the authoritative UTC clock");

pub def latest_epoch_sample_all_history: test::Test = test::should_ok(fn() {
    let query = lower_epoch_sample(parse(r#"{"op":"latest_epoch_sample","dataset":"epoch_samples","owner":"epoch_owner","relation":"epoch_sample_owner","measures":[],"dimensions":["EpochOwnerId","EpochSampleValue","EpochSampleTs"],"filters":[],"ordering":[],"window":null,"limit":null,"offset":null}"#));
    if string::contains(query.sql, "es.ts DESC")
        && !string::contains(query.sql, "es.ts >= ?")
        && query.bindings == [qb::Val::Int(1)] { True }
    else { fail!("unbounded latest epoch sample must use all history", query) }
});

pub def text_sample_top_rejects_epoch_clock: test::Test = test::should_fail_with(fn() {
    lower_epoch_sample(parse(r#"{"op":"sample_top","measures":[],"dimensions":["EpochOwnerId","EpochSampleValue","EpochSampleTs"],"filters":[],"ordering":[],"owner":"epoch_owner","relation":"epoch_sample_owner","rank":"EpochSampleValue","take":2,"window":{"dataset":"epoch_samples","start":"2024-01-01T00:00:00Z","end":"2024-02-01T00:00:00Z"},"limit":null,"offset":null}"#))
}, "UTC window requires a declared canonical UTC time field");

pub def epoch_sample_qualification_keeps_independent_windows: test::Test = test::should_ok(fn() {
    let query = lower_epoch_sample(parse(r#"{"op":"qualify_epoch_samples","measures":[],"dimensions":["EpochOwnerId"],"filters":[],"ordering":[],"qualifications":[{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[{"dimension":"EpochSampleValue","op":"ge","kind":"int","value":8}],"window":{"field":"ts","start":1000,"end":2000},"min_matches":2},{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[],"window":{"field":"ts","start":3000,"end":4000},"min_matches":1}],"limit":null,"offset":null}"#));
    if array::length(string::split(query.sql, "EXISTS (")) == 3
        && array::length(string::split(query.sql, "ownerId")) >= 3
        && array::length(string::split(query.sql, "tenantId")) >= 3
        && query.bindings == [qb::Val::Int(1000), qb::Val::Int(2000), qb::Val::Int(8), qb::Val::Int(2),
            qb::Val::Int(3000), qb::Val::Int(4000), qb::Val::Int(1)] { True }
    else { fail!("independent epoch sample scopes must preserve full owner identity and integer bounds", query) }
});

pub def epoch_sample_count_range_keeps_zero_match_owners: test::Test = test::should_ok(fn() {
    let query = lower_epoch_sample(parse(r#"{"op":"qualify_epoch_sample_count","measures":[],"dimensions":["EpochOwnerId"],"filters":[],"ordering":[],"qualifications":[{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[],"window":{"field":"ts","start":1000,"end":2000},"min_matches":0,"max_matches":4}],"limit":null,"offset":null}"#));
    if string::contains(query.sql, "NOT EXISTS (")
        && string::contains(query.sql, "es_samples.ts >= ?")
        && query.bindings == [qb::Val::Int(1000), qb::Val::Int(2000), qb::Val::Int(4)] { True }
    else { fail!("zero-minimum epoch qualification must exclude only over-limit owners", query) }
});

pub def epoch_sample_qualification_rejects_secondary_clock: test::Test = test::should_fail_with(fn() {
    lower_epoch_sample(parse(r#"{"op":"qualify_epoch_samples","measures":[],"dimensions":["EpochOwnerId"],"filters":[],"ordering":[],"qualifications":[{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[],"window":{"field":"received_ms","start":1000,"end":2000},"min_matches":1}],"limit":null,"offset":null}"#))
}, "sample qualification requires the authoritative UTC epoch-millisecond clock");

pub def epoch_sample_count_rejects_reversed_window: test::Test = test::should_fail_with(fn() {
    lower_epoch_sample(parse(r#"{"op":"qualify_epoch_sample_count","measures":[],"dimensions":["EpochOwnerId"],"filters":[],"ordering":[],"qualifications":[{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[],"window":{"field":"ts","start":2000,"end":1000},"min_matches":0,"max_matches":4}],"limit":null,"offset":null}"#))
}, "sample qualification requires ordered UTC epoch-millisecond bounds");

pub def epoch_metric_qualifications_keep_independent_aggregates: test::Test = test::should_ok(fn() {
    let query = lower_epoch_sample(parse(r#"{"op":"qualify_epoch_metrics","measures":[],"dimensions":["EpochOwnerId"],"filters":[],"ordering":[],"qualifications":[{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[{"dimension":"EpochSampleValue","op":"ge","kind":"int","value":8}],"window":{"field":"ts","start":1000,"end":2000},"having":{"measure":"EpochSampleSum","op":"gt","kind":"int","value":20}},{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[],"window":{"field":"ts","start":3000,"end":4000},"having":{"measure":"EpochSampleSum","op":"ge","kind":"int","value":30}}],"limit":null,"offset":null}"#));
    if array::length(string::split(query.sql, "EXISTS (")) == 3
        && array::length(string::split(query.sql, "ownerId")) >= 3
        && array::length(string::split(query.sql, "tenantId")) >= 3
        && array::length(string::split(query.sql, "sum(")) == 3
        && query.bindings == [qb::Val::Int(1000), qb::Val::Int(2000), qb::Val::Int(8), qb::Val::Int(20),
            qb::Val::Int(3000), qb::Val::Int(4000), qb::Val::Int(30)] { True }
    else { fail!("separate epoch KPI summaries must retain filters, grain and bindings", query) }
});

pub def epoch_metric_qualification_rejects_secondary_clock: test::Test = test::should_fail_with(fn() {
    lower_epoch_sample(parse(r#"{"op":"qualify_epoch_metrics","measures":[],"dimensions":["EpochOwnerId"],"filters":[],"ordering":[],"qualifications":[{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[],"window":{"field":"received_ms","start":1000,"end":2000},"having":{"measure":"EpochSampleSum","op":"gt","kind":"int","value":20}}],"limit":null,"offset":null}"#))
}, "metric qualification requires the authoritative UTC epoch-millisecond clock");

pub def epoch_metric_qualification_rejects_reversed_window: test::Test = test::should_fail_with(fn() {
    lower_epoch_sample(parse(r#"{"op":"qualify_epoch_metrics","measures":[],"dimensions":["EpochOwnerId"],"filters":[],"ordering":[],"qualifications":[{"relation":"epoch_sample_owner","dataset":"epoch_samples","filters":[],"window":{"field":"ts","start":2000,"end":1000},"having":{"measure":"EpochSampleSum","op":"gt","kind":"int","value":20}}],"limit":null,"offset":null}"#))
}, "metric qualification requires ordered UTC epoch-millisecond bounds");

pub def lowering_rejects_non_object_case: test::Test = test::should_fail_with(fn() {
    lower_knowledge(Value::Int(7))
}, "intent field is not an object");

pub def lowering_rejects_malformed_measures_case: test::Test = test::should_fail_with(fn() {
    lower_knowledge(parse(r#"{"op":"count","measures":"MemberCount","dimensions":[],"filters":[],"ordering":[]}"#))
}, "intent field is not an array");

# ---------------------------------------------------------------------------
# Second structurally different prepared model (domain-neutral "org" model).
# ---------------------------------------------------------------------------

def count_agg: qb::AggregateFunction = qb::AggregateFunction::Count;
def sum_agg: qb::AggregateFunction = qb::AggregateFunction::Sum;
def flag_true: Bool = True;
def eq_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def ge_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ge, edsl::FilterOp::Le];
def text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def int_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];
def no_requires: Array(Type) = [];
def fanout_kind: edsl::RelationKind = edsl::RelationKind::FanOut;

# Canonical field order (alphabetical): 0 code, 1 headcount, 2 id, 3 owner_id,
# 4 region, 5 zone.
@edsl::entity_id("org_teams")
@edsl::entity_source("org_teams", "t")
type OrgTeam = struct {
    @edsl::column("code")
    @edsl::dimension("OrgCode", flag_true, flag_true, eq_ops, text_kinds)
    code: String,
    @edsl::column("headcount")
    @edsl::measure("TeamHeadSum", sum_agg, no_requires)
    headcount: Int,
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("TeamCount", count_agg, no_requires)
    id: Int,
    @edsl::column("owner_id")
    @edsl::distinct_measure("UniqueTeamOwnerCount", count_agg, no_requires)
    owner_id: Int,
    @edsl::column("region")
    @edsl::dimension("OrgRegion", flag_true, flag_true, eq_ops, text_kinds)
    region: String,
    @edsl::column("zone")
    @edsl::dimension("OrgZone", flag_true, flag_true, eq_ops, text_kinds)
    zone: String,
};

# Canonical field order: 0 id, 1 team_id.  Members declare the reverse fan-out
# relation to their team, so teams reach members through the prepared direction.
@edsl::entity_id("org_members")
@edsl::entity_source("org_members", "m")
@edsl::relation(OrgTeam.type, fanout_kind, 1, 2)
type OrgMember = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("OrgMemberCount", count_agg, no_requires)
    id: Int,
    @edsl::column("team_id")
    team_id: Int,
};

def org_entity_types: Array(Type) = [OrgTeam.type, OrgMember.type];

def org_authorize: Fn(String) -> Bool = fn(subject) { subject == "analyst" };

def org_payload: Fn() -> edsl::PreparedPayload = fn() {
    let result: edsl::PreparedPayload = edsl::build_root("org-v1", org_entity_types, profile, org_authorize);
    result
};

# ---------------------------------------------------------------------------
# Factories and helpers.
# ---------------------------------------------------------------------------

def lower_knowledge: Fn(Value) -> qb::Query = query_intent_lower_factory(payload, "analyst");
def lower_org: Fn(Value) -> qb::Query = query_intent_lower_factory(org_payload(), "analyst");

def parse: Fn(String) -> Value = fn(source) {
    json::parse(source).unwrap!()
};

def assert_knowledge: Fn(String, Value, String, Array(qb::Val)) -> Bool = fn(label, intent, expected_sql, expected) {
    let query = lower_knowledge(intent);
    if query.sql == expected_sql && query.bindings == expected {
        True
    } else {
        fail!("derived knowledge intent mismatch", label, query.sql, query.bindings, expected_sql, expected)
    }
};

def assert_org: Fn(String, Value, String, Array(qb::Val)) -> Bool = fn(label, intent, expected_sql, expected) {
    let query = lower_org(intent);
    if query.sql == expected_sql && query.bindings == expected {
        True
    } else {
        fail!("derived org intent mismatch", label, query.sql, query.bindings, expected_sql, expected)
    }
};

# ---------------------------------------------------------------------------
# Positive shapes on the knowledge model.
# ---------------------------------------------------------------------------

def count_members: Fn() -> Bool = fn() {
    assert_knowledge(
        "count-members",
        parse(r#"{
            "op": "count",
            "measures": ["MemberCount"],
            "dimensions": [],
            "filters": [],
            "ordering": [],
            "exists": [],
            "having": [],
            "limit": null,
            "offset": null
        }"#),
        "SELECT count(mb.id) AS MemberCount FROM members AS mb",
        [],
    )
};

def filtered_members: Fn() -> Bool = fn() {
    assert_knowledge(
        "filtered-members",
        parse(r#"{
            "op": "list",
            "measures": [],
            "dimensions": ["MemberKind"],
            "filters": [
                {"dimension": "MemberKind", "op": "eq", "kind": "text", "value": "staff"}
            ],
            "ordering": [],
            "exists": [],
            "having": [],
            "limit": null,
            "offset": null
        }"#),
        "SELECT mb.kind FROM members AS mb WHERE mb.kind = ?",
        [qb::Val::String("staff")],
    )
};

def knowledge_distinct: Fn() -> Bool = fn() {
    assert_knowledge(
        "knowledge-distinct",
        parse(r#"{
            "op": "distinct",
            "measures": [],
            "dimensions": ["MemberKind"],
            "filters": [],
            "ordering": [],
            "limit": null,
            "offset": null
        }"#),
        "SELECT DISTINCT mb.kind FROM members AS mb",
        [],
    )
};

# ---------------------------------------------------------------------------
# Positive shapes on the org model.
# ---------------------------------------------------------------------------

def org_field_to_field: Fn() -> Bool = fn() {
    assert_org(
        "org-field-to-field",
        parse(r#"{
            "op": "list",
            "measures": [],
            "dimensions": ["OrgRegion"],
            "filters": [
                {"left": "OrgCode", "op": "eq", "right": "OrgZone"}
            ],
            "ordering": [],
            "limit": null,
            "offset": null
        }"#),
        "SELECT t.region FROM org_teams AS t WHERE t.code = t.zone",
        [],
    )
};

def org_hidden_row_ordering: Fn() -> Bool = fn() {
    assert_org(
        "org-hidden-row-ordering",
        parse(r#"{
            "op": "list",
            "measures": [],
            "dimensions": ["OrgRegion"],
            "filters": [],
            "ordering": [
                {"target": "Dimension", "id": "OrgZone", "direction": "Asc"}
            ],
            "limit": null,
            "offset": null
        }"#),
        "SELECT t.region FROM org_teams AS t ORDER BY t.zone ASC",
        [],
    )
};

def org_selected_having: Fn() -> Bool = fn() {
    assert_org(
        "org-selected-having",
        parse(r#"{
            "op": "aggregate",
            "measures": ["TeamCount"],
            "dimensions": ["OrgRegion"],
            "filters": [],
            "ordering": [],
            "having": [
                {"measure": "TeamCount", "op": "ge", "kind": "int", "value": 2}
            ],
            "exists": [],
            "limit": null,
            "offset": null
        }"#),
        "SELECT count(t.id) AS TeamCount, t.region FROM org_teams AS t GROUP BY t.region HAVING count(t.id) >= ?",
        [qb::Val::Int(2)],
    )
};

def org_model_declared_distinct_measure: Fn() -> Bool = fn() {
    assert_org(
        "org-model-declared-distinct-measure",
        parse(r#"{
            "op": "count",
            "measures": ["UniqueTeamOwnerCount"],
            "dimensions": [],
            "filters": [],
            "ordering": [],
            "having": [],
            "exists": [],
            "limit": null,
            "offset": null
        }"#),
        "SELECT count(DISTINCT t.owner_id) AS UniqueTeamOwnerCount FROM org_teams AS t",
        [],
    )
};

def org_measure_dimension_output_order: Fn() -> Bool = fn() {
    assert_org(
        "org-measure-dimension-output-order",
        parse(r#"{
            "op": "aggregate",
            "measures": ["TeamCount"],
            "dimensions": ["OrgRegion"],
            "filters": [],
            "ordering": [],
            "having": [],
            "exists": [],
            "output_order": [
                {"kind": "dimension", "id": "OrgRegion"},
                {"kind": "measure", "id": "TeamCount"}
            ],
            "limit": null,
            "offset": null
        }"#),
        "SELECT t.region, count(t.id) AS TeamCount FROM org_teams AS t GROUP BY t.region",
        [],
    )
};

def org_hidden_having: Fn() -> Bool = fn() {
    assert_org(
        "org-hidden-having",
        parse(r#"{
            "op": "aggregate",
            "measures": ["TeamCount"],
            "dimensions": ["OrgRegion"],
            "filters": [],
            "ordering": [],
            "having": [],
            "hidden_having": [
                {"measure": "TeamHeadSum", "op": "ge", "kind": "int", "value": 5}
            ],
            "exists": [],
            "limit": null,
            "offset": null
        }"#),
        "SELECT count(t.id) AS TeamCount, t.region FROM org_teams AS t GROUP BY t.region HAVING sum(t.headcount) >= ?",
        [qb::Val::Int(5)],
    )
};

def org_related_exists: Fn() -> Bool = fn() {
    assert_org(
        "org-related-exists",
        parse(r#"{
            "op": "exists",
            "measures": [],
            "dimensions": ["OrgRegion"],
            "filters": [],
            "ordering": [],
            "exists": [
                {"target": "org_members", "filters": [], "min_matches": null}
            ],
            "having": [],
            "limit": null,
            "offset": null
        }"#),
        "SELECT t.region FROM org_teams AS t WHERE EXISTS (SELECT 1 FROM org_members AS m WHERE t.id = m.team_id)",
        [],
    )
};

def org_related_absence: Fn() -> Bool = fn() {
    assert_org(
