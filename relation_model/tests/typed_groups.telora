mod fixture;
use self::fixture as f;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::quantity as q;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::test as test;
use std::value::{Value};

pub def one_measure_group_binds_twice_and_across_datasets: test::Test = test::should_ok(fn() {
    let ms = g::prepare(f::millis, [f::ms_rx, f::ms_tx]);
    let s = g::prepare(f::secs, [f::s_rx, f::s_tx]);
    array::length(ms) == 6 && array::length(s) == 6 && ms[2].local == s[2].local
        && ms[2].value == q::BytesPerSecond.type && ms[0].value == q::Bytes.type
        && array::all(ms, fn(member) { member.nullable })
});
pub def label_group_is_reused_with_capabilities_restricted: test::Test = test::should_ok(fn() {
    let ms = g::prepare(f::millis, [f::ms_label, f::ms_category, f::ms_identity]);
    let s = g::prepare(f::secs, [f::s_label, f::s_category, f::s_identity]);
    ms[0].group == s[0].group && ms[0].filters == [g::Filter::Eq]
        && ms[0].nullable && ms[2].nullable && ms[3].nullable
        && ms[2].value == f::TenantId.type && ms[3].value == f::DeviceId.type
});
pub def missing_member_mapping_is_rejected: test::Test = test::should_fail_with(fn() {
    g::transfer_binding(f::millis, g::transfer, f::ms_amount, f::ms_duration, [f::names("rx")[0]])
}, "measure binding must name every member exactly once");
pub def duplicate_member_mapping_is_rejected: test::Test = test::should_fail_with(fn() {
    let first = f::names("rx")[0];
    g::transfer_binding(f::millis, g::transfer, f::ms_amount, f::ms_duration, [first, first, first])
}, "measure binding must name every member exactly once");
pub def colliding_public_names_are_rejected: test::Test = test::should_fail_with(fn() {
    g::prepare(f::millis, [f::ms_rx, f::ms_rx])
}, "group publish ids must be valid and unique");
pub def invalid_public_name_is_rejected: test::Test = test::should_fail_with(fn() {
    let bad = f::ms_rx.members[0] <~ {id: "rx; drop table samples_ms"};
    g::prepare(f::millis, [f::ms_rx <~ {members: [bad, f::ms_rx.members[1], f::ms_rx.members[2]]}])
}, "group publish ids must be valid and unique");
pub def dimension_binding_cannot_expand_filters: test::Test = test::should_fail_with(fn() {
    g::dimension(f::millis, f::category, g::input(m::field(f::MillisRow.type, f::Category.type, "category")),
        "class", True, [g::Filter::Contains])
}, "dimension binding cannot expand group capabilities");
pub def hidden_dimension_stays_out_of_projection: test::Test = test::should_ok(fn() {
    let hidden = g::dimension(f::millis, f::label,
        g::input(m::optional_field(f::MillisRow.type, String.type, "name")), "hidden", False, []);
    match g::query(f::millis, [hidden, f::ms_rx]).plan {
        qb::QueryPlan::Rows(plan) => array::length(plan.projection) == 3 && plan.grouping == [],
        _ => False,
    }
});
pub def preparation_rechecks_measure_recipe: test::Test = test::should_fail_with(fn() {
    let mean = f::ms_rx.members[2] <~ {aggregate: Some(qb::AggregateFunction::Max)};
    g::prepare(f::millis, [f::ms_rx <~ {members: [f::ms_rx.members[0], f::ms_rx.members[1], mean]}])
}, "measure binding cannot override its group recipe");
pub def preparation_rechecks_capability_ceiling: test::Test = test::should_fail_with(fn() {
    let member = f::ms_category.members[0] <~ {filters: [g::Filter::Contains]};
    g::prepare(f::millis, [f::ms_category <~ {members: [member]}])
}, "dimension binding cannot expand group capabilities");
pub def preparation_rechecks_expression_type: test::Test = test::should_fail_with(fn() {
    let forged = f::ms_amount <~ {value: q::Seconds.type};
    g::transfer_binding(f::millis, g::transfer, forged, f::ms_duration, f::names("rx"))
}, "group expression witness does not match its type");
pub def preparation_rechecks_dataset_ownership: test::Test = test::should_fail_with(fn() {
    g::prepare(f::millis, [f::ms_rx <~ {dataset: "other"}])
}, "group binding belongs to a different dataset");
pub def preparation_rechecks_source_ownership: test::Test = test::should_fail_with(fn() {
    g::prepare(f::millis, [f::ms_rx <~ {source: "other"}])
}, "group binding belongs to a different dataset");
pub def identity_dimensions_cannot_omit_tenant: test::Test = test::should_fail_with(fn() {
    g::identity_dimensions(f::millis, f::millis_role, [{member: "local", publish: "device_id"}])
}, "identity dimensions must publish the complete identity");
pub def aggregate_cannot_claim_nonnull_output: test::Test = test::should_fail_with(fn() {
    let member = f::ms_rx.members[0] <~ {nullable: False};
    g::prepare(f::millis, [f::ms_rx <~ {members: [member, f::ms_rx.members[1], f::ms_rx.members[2]]}])
}, "group member result type does not match its expression");
pub def preparation_rechecks_complete_identity_dimensions: test::Test = test::should_fail_with(fn() {
    g::prepare(f::millis, [f::ms_identity <~ {members: [f::ms_identity.members[1]]}])
}, "identity dimensions must preserve the complete role");
pub def preparation_rechecks_complete_measure_group: test::Test = test::should_fail_with(fn() {
    g::prepare(f::millis, [f::ms_rx <~ {members: [f::ms_rx.members[0]]}])
}, "measure binding must preserve its complete group");
pub def dimension_binding_cannot_enable_projection: test::Test = test::should_fail_with(fn() {
    let hidden = f::label <~ {projectable: False};
    g::dimension(f::millis, hidden, g::input(m::optional_field(f::MillisRow.type, String.type, "name")), "hidden", True, [])
}, "dimension binding cannot expand group capabilities");

type RuntimeCase = struct { id: String, sqlite: qb::Query, postgres: qb::Query };
def export_case: Fn(String, qb::QueryAst) -> RuntimeCase = fn(id, ast) {
    {id, sqlite: sqlite::build_query(ast), postgres: postgres::build_query(ast)}
};
pub def runtime_cases: Value = codec::encode([
    export_case("ms_grouped", g::query(f::millis, [f::ms_identity, f::ms_label, f::ms_category, f::ms_rx, f::ms_tx])),
    export_case("s_grouped", g::query(f::secs, [f::s_identity, f::s_label, f::s_category, f::s_rx, f::s_tx])),
    export_case("ms_all", g::query(f::millis, [f::ms_rx, f::ms_tx])),
    export_case("s_all", g::query(f::secs, [f::s_rx, f::s_tx])),
]);
