use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 终端来源独立声明：不收紧 M:N 上界，时间单位仍待生产确认。
use super::inventory as i;
use super::site as sites;
use super::pon_device as pons;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
type TerminalId = struct(String);
@domain::entity_by("Terminal")
type TerminalById = struct(TerminalId);
@domain::subject("Terminal", "source_resId")
@domain::dataset("source_EntTerminalElement", "EntTerminalElement", ["source_resId"])
@domain::relations(relations)
@domain::alternatives(alternatives)
type EntTerminalElement = struct {
    @m::column("tenantId")
    @g::exact("source_EntTerminalElement__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("projectId")
    @g::exact("source_EntTerminalElement__projectId")
    source_projectId: domain::Reference(sites::SiteById),
    @m::column("resId")
    @g::exact("source_EntTerminalElement__resId")
    source_resId: TerminalById,
    @m::column("mac")
    @g::search("source_EntTerminalElement__mac")
    source_mac: String,
    @m::column("name")
    @g::search("source_EntTerminalElement__name")
    source_name: String,
    @m::column("ip")
    @g::search("source_EntTerminalElement__ip")
    @g::ipv4_view("source_EntTerminalElement__ip_ipv4")
    source_ip: String,
    @m::column("ipv6")
    @g::search("source_EntTerminalElement__ipv6")
    source_ipv6: String,
    @m::column("status")
    @v::classification(SourceEntTerminalElementStatus_domain, "source_EntTerminalElement__status")
    source_status: Int,
    @m::column("type")
    @v::classification(SourceEntTerminalElementType_domain, "source_EntTerminalElement__type")
    source_type: String,
    @m::column("vendor")
    @g::search("source_EntTerminalElement__vendor")
    source_vendor: String,
    @m::column("model")
    @g::search("source_EntTerminalElement__model")
    source_model: String,
    @m::column("serialNumber")
    @g::search("source_EntTerminalElement__serialNumber")
    source_serialNumber: String,
    @m::column("osName")
    @g::search("source_EntTerminalElement__osName")
    source_osName: String,
    @m::column("priority")
    @v::classification(
        SourceEntTerminalElementPriority_domain,
        "source_EntTerminalElement__priority"
    )
    source_priority: Int,
    @m::column("source")
    @v::classification(SourceEntTerminalElementSource_domain, "source_EntTerminalElement__source")
    source_source: Int,
    @m::column("remark")
    @g::search("source_EntTerminalElement__remark")
    source_remark: String,
    @m::column("accessDeviceId")
    @g::exact("source_EntTerminalElement__accessDeviceId")
    @domain::targets(
        [
            {name: "device", identity: i::DeviceById.type}.ty!(domain::ReferenceTarget),
            {name: "pon", identity: pons::PonElementById.type}.ty!(domain::ReferenceTarget)
        ]
    )
    source_accessDeviceId: domain::Reference(String),
    @m::column("accessIfName")
    @g::search("source_EntTerminalElement__accessIfName")
    source_accessIfName: String,
    @m::column("vlanId")
    @g::field_view(
        g::dimension_group("integer", Int.type, True, g::numeric_filters),
        "source_EntTerminalElement__vlanId",
        True,
        g::numeric_filters
    )
    source_vlanId: Int,
    @m::column("siteId")
    @g::exact("source_EntTerminalElement__siteId")
    source_siteId: domain::Reference(sites::SiteById),
    @m::column("unauthorized")
    @g::field_view(
        g::dimension_group("integer", Int.type, True, g::numeric_filters),
        "source_EntTerminalElement__unauthorized",
        True,
        g::numeric_filters
    )
    source_unauthorized: Int,
    @m::column("isBlocked")
    @g::field_view(
        g::dimension_group("integer", Int.type, True, g::numeric_filters),
        "source_EntTerminalElement__isBlocked",
        True,
        g::numeric_filters
    )
    source_isBlocked: Int,
    @m::column("blockStatus")
    @v::classification(
        SourceEntTerminalElementBlockStatus_domain,
        "source_EntTerminalElement__blockStatus"
    )
    source_blockStatus: Int,
    # 沿用旧 UTC 毫秒假定；来源整数时钟单位尚待确认。
    @m::column("blockTime")
    @g::field_view(
        g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::numeric_filters),
        "source_EntTerminalElement__blockTime",
        True,
        g::numeric_filters
    )
    source_blockTime: s::EpochMillis,
};

def subject: r::Endpoint = domain::endpoint(EntTerminalElement.type, "source_resId");
def tenant: r::Endpoint = domain::endpoint(EntTerminalElement.type, "source_tenantId");
def site: r::Endpoint = domain::endpoint(EntTerminalElement.type, "source_siteId");
def project: r::Endpoint = domain::endpoint(EntTerminalElement.type, "source_projectId");
def device: r::Endpoint = domain::endpoint(EntTerminalElement.type, "device");
def pon: r::Endpoint = domain::endpoint(EntTerminalElement.type, "pon");

@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementStatus = enum {
    @ev::itag(-1)
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::itag(0)
    @ev::description("Online", "在线")
    Online,
    @ev::itag(1)
    @ev::description("Offline", "离线")
    Offline,
};
def SourceEntTerminalElementStatus_domain: v::Domain(SourceEntTerminalElementStatus, Int) = v::from_enum(
    "SourceEntTerminalElementStatus",
    SourceEntTerminalElementStatus.type,
    Int.type,
    False
);

