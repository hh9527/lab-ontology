# ---------------------------------------------------------------------------
# SQLite JSON1 v1.
# ---------------------------------------------------------------------------

def json_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "verify-json",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "id")),
            qb.expr_item(qb.json_extract(qb.column("e", "payload"), "$.attempt_id")),
            qb.expr_item(qb.json_extract(qb.column("e", "payload"), "$.status")),
            qb.expr_item(qb.json_type(qb.column("e", "payload"), "$.amount")),
            qb.expr_item(qb.json_valid(qb.column("e", "payload"))),
        ],
        filter: 'Some(qb.scalar('Eq, [
            qb.json_extract(qb.column("e", "payload"), "$.status"),
            qb.bind_string("ok"),
        ])),
        joins: [],
        grouping: [qb.json_extract(qb.column("e", "payload"), "$.attempt_id")],
        ordering: [qb.asc(qb.json_extract(qb.column("e", "payload"), "$.attempt_id"))],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    plan
};

def expected_json_sql = "SELECT e.id, json_extract(e.payload, ?), json_extract(e.payload, ?), json_type(e.payload, ?), json_valid(e.payload) FROM events AS e WHERE json_extract(e.payload, ?) = ? GROUP BY json_extract(e.payload, ?) ORDER BY json_extract(e.payload, ?) ASC";

def expected_json_bindings: Array(qb.Val) = [
    'String("$.attempt_id"), 'String("$.status"), 'String("$.amount"),
    'String("$.status"), 'String("ok"),
    'String("$.attempt_id"), 'String("$.attempt_id"),
];

def json_partition_plan: Fn() -> qb.Plan = fn() {
    let attempt = qb.json_extract(qb.column("e", "payload"), "$.attempt_id");
    let plan: qb.Plan = {
        revision: "verify-json-partition",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.expr_item(attempt),
            qb.aggregate('Count, qb.column("e", "id"), 'False, "uses"),
        ],
        filter: 'None,
        joins: [],
        grouping: [qb.column("e", "role"), attempt],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'Some(qb.partitioned_top_n(
            [qb.column("e", "role")],
            [qb.desc_aggregate("uses"), qb.asc(attempt)],
            3,
        )),
    };
    plan
};

def expected_json_partition_sql = "SELECT __q_0, __q_1, uses FROM (SELECT e.role AS __q_0, json_extract(e.payload, ?) AS __q_1, count(e.id) AS uses, row_number() OVER (PARTITION BY e.role ORDER BY count(e.id) DESC, json_extract(e.payload, ?) ASC) AS __q_rn FROM events AS e GROUP BY e.role, json_extract(e.payload, ?)) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_0 ASC, uses DESC, __q_1 ASC";

def expected_json_partition_bindings: Array(qb.Val) = [
    'String("$.attempt_id"), 'String("$.attempt_id"),
    'String("$.attempt_id"), 'Int(3),
];

# ---------------------------------------------------------------------------
# JSON codec boundary helpers (Val <-> untagged scalar JSON).
# ---------------------------------------------------------------------------

def encode_val: Fn(qb.Val) -> Value = fn(val) {
    codec.encode(Value, val) |> result.unwrap
};

def decode_val: Fn(Value) -> qb.Val = fn(value) {
    codec.decode(qb.Val, value) |> result.unwrap
};

def val_roundtrip: Fn(qb.Val) -> Bool = fn(val) {
    decode_val(encode_val(val)) == val
};

# Parse a JSON scalar text and decode it back to a Val (dispatch check).
def json_to_val: Fn(String) -> qb.Val = fn(text) {
    let parsed = json.parse(text) |> result.unwrap;
    decode_val(parsed)
};

# A scalar JSON value: String/Int/Float/True/False.  Any Array/Object or
# wrapper object (e.g. {"Int": 3}) is not a native scalar.
def is_scalar_value: Fn(Value) -> Bool = fn(value) {
    match value {
        'String(_) => 'True,
        'Int(_) => 'True,
        'Float(_) => 'True,
        'True => 'True,
        'False => 'True,
        _ => 'False,
    }
};

# Encode a Query across the codec boundary and check that `bindings` is a
# native scalar array with no variant wrappers.
def query_bindings_are_scalar_array: Fn(qb.Query) -> Bool = fn(query) {
    let encoded = codec.encode(Value, query) |> result.unwrap;
    match encoded {
        'Object(fields) => match dict.get(fields, "bindings") {
            'Some('Array(items)) => array.all(items, is_scalar_value),
            _ => 'False,
        },
        _ => 'False,
    }
};

def query_encoded_bindings_match: Fn(qb.Query, Array(qb.Val)) -> Bool = fn(query, expected) {
    let encoded = codec.encode(Value, query) |> result.unwrap;
    match encoded {
        'Object(fields) => match dict.get(fields, "bindings") {
            'Some('Array(items)) => array.map(items, decode_val) == expected,
            _ => 'False,
        },
        _ => 'False,
    }
};

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    let plan = demo_plan();
    let full = full_profile();
    let restricted = restricted_profile();

    let coverage_ok = qb.profile_accepts(plan, full);
    let reject_ok = !qb.profile_accepts(plan, restricted);
    let simple_ok = qb.profile_accepts(simple_plan(), simple_profile());

    let operators_expected: Array(qb.Operator) = [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Join, 'Group, 'Order, 'Limit,
    ];
    let operators_ok = qb.operators(plan) == operators_expected;

    let validated = qb.validate(plan, full);
    let q1 = qb.transform_sqlite(validated);
    let q2 = qb.transform_sqlite(plan);
    let determinism_ok = q1.sql == q2.sql && q1.bindings == q2.bindings;
    let ordering_ok = q1.sql == expected_sql;
    let bindings_ok = q1.bindings == expected_bindings;

    let top_n = qb.validate(top_n_plan(), full);
    let q3 = qb.transform_sqlite(top_n);
    let top_n_order_ok = q3.sql == expected_top_n_sql;
    let top_n_bindings_ok = q3.bindings == expected_top_n_bindings;
    let top_n_operators_ok = qb.profile_accepts(top_n, full);

    # Closed computed expression (first whitespace segment) checks.
    let token_plan = first_token_plan();
    let token = qb.validate(token_plan, full);
    let q4 = qb.transform_sqlite(token);
    let token_sql_ok = q4.sql == expected_first_token_sql;
    let token_bindings_ok = q4.bindings == expected_first_token_bindings;
    let token_profile_ok = qb.profile_accepts(token_plan, full);
    let token_profile_reject_ok = !qb.profile_accepts(token_plan, restricted_profile());
    # The conditional's ELSE branch is the original column: no delimiter,
    # empty input and NULL input all fall back to the original value.
    let token_else_ok = string.contains(q4.sql, "ELSE c.command");

    # Safe pagination checks.
    let paged = qb.validate(paged_plan(), full);
    let q5 = qb.transform_sqlite(paged);
    let paged_sql_ok = q5.sql == expected_paged_sql;
    let paged_bindings_ok = q5.bindings == expected_paged_bindings;
    let offset_only = qb.validate(offset_only_plan(), full);
    let q6 = qb.transform_sqlite(offset_only);
    let offset_only_sql_ok = q6.sql == expected_offset_only_sql;
    let offset_requires_ordering_ok = !qb.structure_ok(offset_no_ordering_plan());
    let negative_offset_rejected_ok = !qb.structure_ok(negative_offset_plan());
    let offset_expected: Array(qb.Operator) = [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Filter,
        'Order, 'Limit, 'Offset,
    ];
    let offset_operator_ok = qb.operators(paged_plan()) == offset_expected;
    let paged_profile_ok = qb.profile_accepts(paged_plan(), full);

    # Partitioned Top N checks.
    let partition = qb.validate(top_per_role_plan(), full);
    let q7 = qb.transform_sqlite(partition);
    let partition_sql_ok = q7.sql == expected_partition_sql;
    let partition_bindings_ok = q7.bindings == expected_partition_bindings;
    let partition_profile_ok = qb.profile_accepts(top_per_role_plan(), full);
    let partition_take_bound_ok = string.contains(q7.sql, "__q_rn <= ?");
    let partition_tie_break_reject_ok = !qb.structure_ok(partition_no_tie_break_plan());
    let partition_operators_expected: Array(qb.Operator) = [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Group, 'Order, 'Partition,
    ];
    let partition_operators_ok = qb.operators(top_per_role_plan()) == partition_operators_expected;

    # Filtered and computed aggregates checks.
    let computed = qb.validate(filtered_aggregate_plan(), full);
    let q8 = qb.transform_sqlite(computed);
    let computed_sql_ok = q8.sql == expected_computed_sql;
    let computed_bindings_ok = q8.bindings == expected_computed_bindings;
    let computed_ordering_ok = string.contains(q8.sql, "ORDER BY (count(e.id) FILTER (WHERE e.type = ?) - count(e.id) FILTER (WHERE e.type = ?)) DESC");
    let computed_profile_ok = qb.profile_accepts(filtered_aggregate_plan(), full);
    let computed_partition = qb.validate(computed_partition_net_plan(), full);
    let q9 = qb.transform_sqlite(computed_partition);
    let computed_partition_sql_ok = q9.sql == expected_computed_partition_sql;
    let computed_partition_bindings_ok = q9.bindings == expected_computed_partition_bindings;
    let computed_unknown_reject_ok = !qb.structure_ok(computed_unknown_operand_plan());
    let computed_cycle_reject_ok = !qb.structure_ok(computed_cycle_plan());
    # Profile capability coverage: aggregate-local filter consumes `Filter`;
    # computed aggregates consume `Scalar` plus the specific Add/Sub scalar.
    let eq_but_no_filter: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate, 'Group],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Eq],
        allow_distinct: 'True,
    };
    let filtered_consumes_filter_ok = !qb.profile_accepts(filtered_aggregate_plan(), eq_but_no_filter);
    let no_scalar: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Aggregate, 'Filter, 'Group, 'Order],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Eq, 'Add, 'Sub],
        allow_distinct: 'True,
    };
    let computed_consumes_scalar_ok = !qb.profile_accepts(filtered_aggregate_plan(), no_scalar);

    # SQLite JSON1 v1 checks.
    let json_validated = qb.validate(json_plan(), full);
    let q10 = qb.transform_sqlite(json_validated);
    let json_sql_ok = q10.sql == expected_json_sql;
    let json_bindings_ok = q10.bindings == expected_json_bindings;
    let json_path_bound_ok = !string.contains(q10.sql, "$.attempt_id")
        && string.contains(q10.sql, "json_extract(e.payload, ?)");
    let json_profile_ok = qb.profile_accepts(json_plan(), full);
    let json_partition = qb.validate(json_partition_plan(), full);
    let q11 = qb.transform_sqlite(json_partition);
    let json_partition_sql_ok = q11.sql == expected_json_partition_sql;
    let json_partition_bindings_ok = q11.bindings == expected_json_partition_bindings;
    let json_bad_probe: qb.Plan = {
        revision: "verify-json-bad-path",
        sources: [qb.source("e", "events")],
        projection: [qb.expr_item(qb.scalar('JsonExtract, [
            qb.column("e", "payload"),
            qb.column("e", "path"),
        ]))],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let json_nonstring_path_reject_ok = !qb.structure_ok(json_bad_probe);

    # JSON codec boundary checks.
    let json_roundtrip_ok = val_roundtrip('Int(3))
        && val_roundtrip('Float(3.5))
        && val_roundtrip('String("abc"))
        && val_roundtrip('Bool('True));
    let json_int_float_dispatch_ok = json_to_val("3") == 'Int(3)
        && json_to_val("3.5") == 'Float(3.5)
        && json_to_val("\"abc\"") == 'String("abc")
        && json_to_val("true") == 'Bool('True);
    let json_scalar_array_ok = query_bindings_are_scalar_array(q1)
        && query_bindings_are_scalar_array(q3);
    let json_encoded_bindings_ok = query_encoded_bindings_match(q1, expected_bindings)
        && query_encoded_bindings_match(q3, expected_top_n_bindings);

    let all_ok = coverage_ok && reject_ok && simple_ok && operators_ok
        && determinism_ok && ordering_ok && bindings_ok
        && top_n_order_ok && top_n_bindings_ok && top_n_operators_ok
        && token_sql_ok && token_bindings_ok && token_profile_ok
        && token_profile_reject_ok && token_else_ok
        && paged_sql_ok && paged_bindings_ok && offset_only_sql_ok
        && offset_requires_ordering_ok && negative_offset_rejected_ok
        && offset_operator_ok && paged_profile_ok
        && partition_sql_ok && partition_bindings_ok && partition_profile_ok
        && partition_take_bound_ok && partition_tie_break_reject_ok
        && partition_operators_ok
        && computed_sql_ok && computed_bindings_ok && computed_ordering_ok
        && computed_profile_ok && computed_partition_sql_ok
        && computed_partition_bindings_ok
        && computed_unknown_reject_ok && computed_cycle_reject_ok
        && filtered_consumes_filter_ok && computed_consumes_scalar_ok
        && json_sql_ok && json_bindings_ok && json_path_bound_ok
        && json_profile_ok && json_partition_sql_ok
        && json_partition_bindings_ok && json_nonstring_path_reject_ok
        && json_roundtrip_ok && json_int_float_dispatch_ok
        && json_scalar_array_ok && json_encoded_bindings_ok;

    if !all_ok {
        fail!("verify checks failed", plan)
    } else {
        let binding_values: Array(Value) = array.map(q1.bindings, val_to_value);
        let result: Value = 'Object({
            coverage: if coverage_ok { 'True } else { 'False },
            operators: if operators_ok { 'True } else { 'False },
            determinism: if determinism_ok { 'True } else { 'False },
            ordering: if ordering_ok { 'True } else { 'False },
            bindings: if bindings_ok { 'True } else { 'False },
            top_n_aggregate_ordering: if top_n_order_ok && top_n_bindings_ok { 'True } else { 'False },
            first_token_lowering: if token_sql_ok && token_bindings_ok { 'True } else { 'False },
            first_token_profile: if token_profile_ok && token_profile_reject_ok { 'True } else { 'False },
            pagination_lowering: if paged_sql_ok && paged_bindings_ok && offset_only_sql_ok { 'True } else { 'False },
            pagination_safety: if offset_requires_ordering_ok && negative_offset_rejected_ok && offset_operator_ok { 'True } else { 'False },
            partition_lowering: if partition_sql_ok && partition_bindings_ok && partition_take_bound_ok { 'True } else { 'False },
            partition_safety: if partition_tie_break_reject_ok && partition_operators_ok { 'True } else { 'False },
            filtered_computed_lowering: if computed_sql_ok && computed_bindings_ok && computed_ordering_ok { 'True } else { 'False },
            filtered_computed_safety: if computed_profile_ok && computed_partition_sql_ok && computed_partition_bindings_ok && computed_unknown_reject_ok && computed_cycle_reject_ok && filtered_consumes_filter_ok && computed_consumes_scalar_ok { 'True } else { 'False },
            json_lowering: if json_sql_ok && json_bindings_ok && json_path_bound_ok && json_partition_sql_ok && json_partition_bindings_ok { 'True } else { 'False },
            json_safety: if json_profile_ok && json_nonstring_path_reject_ok { 'True } else { 'False },
            json_roundtrip: if json_roundtrip_ok { 'True } else { 'False },
            json_int_float_dispatch: if json_int_float_dispatch_ok { 'True } else { 'False },
            json_scalar_array: if json_scalar_array_ok { 'True } else { 'False },
            json_encoded_bindings: if json_encoded_bindings_ok { 'True } else { 'False },
            sql: 'String(q1.sql),
            binding_values: 'Array(binding_values),
        });
        result
    }
};
