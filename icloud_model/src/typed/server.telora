# 服务器独立声明，主身份与来源资源身份显式分开
use super::inventory as i;
use super::site as site;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
type ServerId = struct(String);
type ServerOriginId = struct(String);
type Identity = struct { id: ServerId };
type Row = struct {
    id: ServerId,
    name: String,
    asset_number: String,
    ip_address: String,
    ori_res_id: ServerOriginId,
    tenant_id: i::TenantId,
    ref_parent_subnet: i::SiteId,
    project_id: i::SiteId,
    classification: String,
    health_status: Int,
    manufacturer: String,
    source_createTime: s::EpochMillis,
    source_bmcHostName: String,
    source_serviceDuration: Int,
    source_serviceStartTime: Int,
    source_assetManager: String,
    source_biosVersion: String,
    source_mac: String,
    source_connectStatus: Int,
    source_productName: String,
    source_location: String,
    source_sn: String,
    source_version: String,
};
def entity: m::Entity(Identity) = m::entity("server_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset("server_device", "PhysicalServer", Row.type, ["id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, ServerId.type, "id"), m::field(Identity.type, ServerId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "tenant_id"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
def subnet: m::Role(Row) = m::role(dataset, site::entity, "subnet", False, [m::identity_part(m::field(Row.type, i::SiteId.type, "ref_parent_subnet"), m::field(site::Identity.type, i::SiteId.type, "id"))]);
def project: m::Role(Row) = m::role(dataset, site::entity, "project", False, [m::identity_part(m::field(Row.type, i::SiteId.type, "project_id"), m::field(site::Identity.type, i::SiteId.type, "id"))]);
type ServerClass = struct(String);
def ServerClass_domain: v::Domain(ServerClass, String) = v::domain("ServerClass", ServerClass.type, String.type, [
    v::member(ServerClass("subrack"), ["ne.category.server.subrack"]),
    v::member(ServerClass("kunlun"), ["ne.category.server.kunlun"]),
    v::member(ServerClass("rack"), ["ne.category.server.rack"]),
    v::member(ServerClass("taishan"), ["ne.category.server.taishan"]),
    v::member(ServerClass("heterogeneous"), ["ne.category.server.heterogeneous"]),
    v::member(ServerClass("enclosure"), ["ne.category.server.enclosure"]),
    v::member(ServerClass("wire_ne_category_server_chassis_6b8552f6"), ["ne.category.server.chassis"]),
    v::member(ServerClass("wire_ne_category_server_highdensity_360fe715"), ["ne.category.server.highdensity"]),
    v::member(ServerClass("wire_ne_category_server_litechassisserver_41c4a915"), ["ne.category.server.litechassisserver"]),
    v::member(ServerClass("wire_ne_category_server_other_63957b69"), ["ne.category.server.other"]),
    v::member(ServerClass("wire_ne_category_server_blade_d8702a81"), ["ne.category.server.blade"]),
    v::member(ServerClass("wire_ne_category_server_switch_bf9882c4"), ["ne.category.server.switch"]),
    v::member(ServerClass("wire_ne_category_server_edge_f2ef6521"), ["ne.category.server.edge"]),
], False);
type ServerHealth = struct(String);
def ServerHealth_domain: v::Domain(ServerHealth, Int) = v::domain("ServerHealth", ServerHealth.type, Int.type, [
    v::member(ServerHealth("normal"), [0]),
    v::member(ServerHealth("warning"), [1]),
    v::member(ServerHealth("minor"), [2]),
    v::member(ServerHealth("major"), [3]),
    v::member(ServerHealth("critical"), [4]),
    v::member(ServerHealth("error"), [-1]),
    v::member(ServerHealth("unknown"), [-2]),
], False);
type ServerDeviceConnectStatus = struct(String);
def ServerDeviceConnectStatus_domain: v::Domain(ServerDeviceConnectStatus, Int) = v::domain("ServerDeviceConnectStatus", ServerDeviceConnectStatus.type, Int.type, [
    v::member(ServerDeviceConnectStatus("wire_1_8d618873"), [1]),
    v::member(ServerDeviceConnectStatus("wire_3_bab86ec8"), [3]),
    v::member(ServerDeviceConnectStatus("wire_4_5978b238"), [4]),
    v::member(ServerDeviceConnectStatus("wire_5_c6f5830f"), [5]),
], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [subject, tenant, subnet, project], [
    i::search(dataset, m::field(Row.type, String.type, "name"), "server_name"),
    i::search(dataset, m::field(Row.type, String.type, "asset_number"), "server_asset_number"),
    i::search(dataset, m::field(Row.type, String.type, "ip_address"), "server_ip_address"),
    i::search(dataset, m::field(Row.type, String.type, "manufacturer"), "server_manufacturer"),
    g::dimension(dataset, g::dimension_group("server_device__createTime", s::EpochMillis.type, True, g::numeric_filters), g::input(m::field(Row.type, s::EpochMillis.type, "source_createTime")), "server_device__createTime", True, g::numeric_filters),
    i::search(dataset, m::field(Row.type, String.type, "source_bmcHostName"), "server_device__bmcHostName"),
    g::dimension(dataset, g::dimension_group("server_device__serviceDuration", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_serviceDuration")), "server_device__serviceDuration", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("server_device__serviceStartTime", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_serviceStartTime")), "server_device__serviceStartTime", True, g::numeric_filters),
    i::exact(dataset, m::field(Row.type, String.type, "source_assetManager"), "server_device__assetManager"),
    i::search(dataset, m::field(Row.type, String.type, "source_biosVersion"), "server_device__biosVersion"),
    i::search(dataset, m::field(Row.type, String.type, "source_mac"), "server_device__mac"),
    i::search(dataset, m::field(Row.type, String.type, "source_productName"), "server_device__productName"),
    i::search(dataset, m::field(Row.type, String.type, "source_location"), "server_device__location"),
    i::search(dataset, m::field(Row.type, String.type, "source_sn"), "server_device__sn"),
    i::search(dataset, m::field(Row.type, String.type, "source_version"), "server_device__version"),
    g::dimension(dataset, g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters), g::ipv4(g::input(m::field(Row.type, String.type, "ip_address"))), "server_ip_address_ipv4", True, g::ipv4_filters),
], []), [
    t::column(m::field(Row.type, ServerId.type, "id"), "id"),
    t::column(m::field(Row.type, String.type, "name"), "name"),
    t::column(m::field(Row.type, String.type, "asset_number"), "assetNumber"),
    t::column(m::field(Row.type, String.type, "ip_address"), "ipAddress"),
    t::column(m::field(Row.type, ServerOriginId.type, "ori_res_id"), "oriResId"),
    t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::field(Row.type, i::SiteId.type, "ref_parent_subnet"), "refParentSubnet"),
    t::column(m::field(Row.type, i::SiteId.type, "project_id"), "projectId"),
    t::column(m::field(Row.type, String.type, "classification"), "classification"),
    t::column(m::field(Row.type, Int.type, "health_status"), "healthStatus"),
    t::column(m::field(Row.type, String.type, "manufacturer"), "manufacturer"),
    t::column(m::field(Row.type, s::EpochMillis.type, "source_createTime"), "createTime"),
    t::column(m::field(Row.type, String.type, "source_bmcHostName"), "bmcHostName"),
    t::column(m::field(Row.type, Int.type, "source_serviceDuration"), "serviceDuration"),
    t::column(m::field(Row.type, Int.type, "source_serviceStartTime"), "serviceStartTime"),
    t::column(m::field(Row.type, String.type, "source_assetManager"), "assetManager"),
    t::column(m::field(Row.type, String.type, "source_biosVersion"), "biosVersion"),
    t::column(m::field(Row.type, String.type, "source_mac"), "mac"),
    t::column(m::field(Row.type, Int.type, "source_connectStatus"), "connectStatus"),
    t::column(m::field(Row.type, String.type, "source_productName"), "productName"),
    t::column(m::field(Row.type, String.type, "source_location"), "location"),
    t::column(m::field(Row.type, String.type, "source_sn"), "sn"),
    t::column(m::field(Row.type, String.type, "source_version"), "version"),
 ]), [
    v::bind(dataset, v::dimension_group(ServerClass_domain, True, g::equality_filters), g::input(m::field(Row.type, String.type, "classification")), "server_class", True, g::equality_filters),
    v::bind(dataset, v::dimension_group(ServerHealth_domain, True, g::equality_filters), g::input(m::field(Row.type, Int.type, "health_status")), "server_health", True, g::equality_filters),
    v::bind(dataset, v::dimension_group(ServerDeviceConnectStatus_domain, True, g::equality_filters), g::input(m::field(Row.type, Int.type, "source_connectStatus")), "server_device__connectStatus", True, g::equality_filters),
]);
def cardinality: edsl::RelationCardinality = {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0};
def relations: Array(r::Relation) = [
    r::relation("server_belongs_to_tenant", dataset, tenant, i::tenants, i::tenant_subject, cardinality),
    r::relation("source_PhysicalServer_X_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, cardinality),
];
def alternatives: Array(t::Alternative) = [
    {id: "server_located_at_site", cardinality, choices: [r::relation("server_located_at_site_subnet", dataset, subnet, site::dataset, site::subject, cardinality), r::relation("server_located_at_site_project", dataset, project, site::dataset, site::subject, cardinality)]},
    {id: "source_PhysicalServer_X_SITE_VIEW", cardinality, choices: [r::relation("source_PhysicalServer_X_SITE_VIEW_subnet", dataset, subnet, site::dataset, site::subject, cardinality), r::relation("source_PhysicalServer_X_SITE_VIEW_project", dataset, project, site::dataset, site::subject, cardinality)]},
];
pub use self::{declaration, relations, alternatives};
