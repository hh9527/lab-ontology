@registry::dataset(
    "kpi-storage-enterprise-controller",
    "kpi_storage_enterpriseController",
    ["obj_id", "ts"]
)
@registry::roles([role_248])
@registry::groups(
    [
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseController.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "sec_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseController.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "sec_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseController.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "sec_utc_month",
            True,
            g::time_filters
        )
    ]
)
