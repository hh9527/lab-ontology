    @v::map(domains::HoIsAdd2HostGroup.type, "ho_is_add2_host_group", [v::member(domains::HoIsAdd2HostGroup::Yes, ["true"]), v::member(domains::HoIsAdd2HostGroup::No, ["false"])])
    is_add2_host_group: Option(String),
    @m::column("parentId")
