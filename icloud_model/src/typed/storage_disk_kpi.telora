use super::metric_values as metric;
use ontology::quantity as statistic_quantity;
use ontology::quantity as presentation;
use ontology::semantic as domain;
# 独立 transform 声明；单位、grain 与关系只采用既有公开契约。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
use super::storage_disk as disk;
type StorageDiskSampledById = disk::StorageDiskById;
# TODO(#58)：KB 的字节倍率未确认；不提供隐式转换。
@presentation::calculations(
    [
        presentation::Calculation::Compare,
        presentation::Calculation::Mean,
        presentation::Calculation::Min,
        presentation::Calculation::Max,
        presentation::Calculation::Round
    ]
)
type StorageIoSize = struct(Float);
def io_size_statistics: samples::Group(StorageIoSize) = samples::group(
    "storage_io_size_kb",
    StorageIoSize.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("KB")
);
@domain::bind(StorageDiskSampledById.type, "source_resId")
@domain::dataset("source_StorageHardDriveKPI", "StorageHardDriveKPI", ["source_resId", "source_ts"])
@domain::metric("source_ts")
@domain::relations([
    r::relation("source_SYS_StorageDisk_StorageHardDriveKPI",
        domain::endpoint(disk::SysStorageDisk.type, "source_id"),
        domain::endpoint(StorageHardDriveKPI.type, "source_resId"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0})
])
type StorageHardDriveKPI = struct {
    @m::column("ts")
    @g::view("source_StorageHardDriveKPI__ts", True, g::numeric_filters)
    @g::utc_bucket_view("source_StorageHardDriveKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_StorageHardDriveKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_StorageHardDriveKPI_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("storage_disk_kpi_sample_count")
    @edsl::field_role(edsl::FieldRole::Classification)
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_StorageHardDriveKPI__resId")
    source_resId: StorageDiskSampledById,
    @m::column("utility")
    @g::view("source_StorageHardDriveKPI__utility", True, g::numeric_filters)
    @samples::field(
        metric::StorageDiskUtilization_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "storage_disk_usage"},
            {statistic: samples::Statistic::Max, publish: "storage_disk_usage_max"},
            {statistic: samples::Statistic::Min, publish: "storage_disk_usage_min"}
        ]
    )
    @samples::valid_count("source_utilityEffcnt")
    @domain::count("storage_disk_usage_observation_count")
    source_utility: metric::StorageDiskUtilization,
    @m::column("avgreadiosize")
    @g::view("source_StorageHardDriveKPI__avgreadiosize", True, g::numeric_filters)
    @samples::field(
        io_size_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "storage_disk_read_io_size"},
            {statistic: samples::Statistic::Max, publish: "storage_disk_read_io_size_max"},
            {statistic: samples::Statistic::Min, publish: "storage_disk_read_io_size_min"}
        ]
    )
    @samples::valid_count("source_avgreadiosizeEffcnt")
    @domain::count("storage_disk_read_io_size_observation_count")
    source_avgreadiosize: StorageIoSize,
    @m::column("avgwriteiosize")
    @g::view("source_StorageHardDriveKPI__avgwriteiosize", True, g::numeric_filters)
    @samples::field(
        io_size_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "storage_disk_write_io_size"},
            {statistic: samples::Statistic::Max, publish: "storage_disk_write_io_size_max"},
            {statistic: samples::Statistic::Min, publish: "storage_disk_write_io_size_min"}
        ]
    )
    @samples::valid_count("source_avgwriteiosizeEffcnt")
    @domain::count("storage_disk_write_io_size_observation_count")
    source_avgwriteiosize: StorageIoSize,
    @m::column("utilityEffcnt")
    @g::view("source_StorageHardDriveKPI__utilityEffcnt", True, g::numeric_filters)
    source_utilityEffcnt: EffectiveCount,
    @m::column("avgreadiosizeEffcnt")
    @g::view("source_StorageHardDriveKPI__avgreadiosizeEffcnt", True, g::numeric_filters)
    source_avgreadiosizeEffcnt: EffectiveCount,
    @m::column("avgwriteiosizeEffcnt")
    @g::view("source_StorageHardDriveKPI__avgwriteiosizeEffcnt", True, g::numeric_filters)
    source_avgwriteiosizeEffcnt: EffectiveCount,
};

pub use self::{StorageHardDriveKPI};
