pub def count_sites_with_fewer_than_five_storage_devices: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"site","include_empty":true,
        "nodes":[{"id":"site","entity":"site"},{"id":"storage","entity":"storage_device"}],
        "edges":[{"relation":"storage_device_site","from":"storage","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"}],
        "filters":[{"node":"site","dimension":"site_type","op":"eq","kind":"text","value":"offline"},
                   {"node":"storage","dimension":"storage_device_subclass","op":"ne","kind":"text","value":"fc_switch_device"}],
        "count":"storage","group_by_identity":["site"],
        "count_having":{"op":"lt","value":5},"count_groups":true}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "SELECT count(1) FROM (SELECT site.SITE_NAME")
        && string::contains(sq.sql, "LEFT JOIN (SELECT * FROM HuaweiStorageDevice AS storage WHERE")
        && string::contains(sq.sql, "GROUP BY site.SITE_NAME, site.SITE_ID HAVING count(storage.id) <")
        && string::contains(pg.sql, "SELECT count(1) FROM (SELECT \"site\".\"SITE_NAME\"")
        && string::contains(pg.sql, "HAVING count(\"storage\".\"id\") <")
        && sq.bindings == pg.bindings { True }
    else { fail!("site group count lost the qualified root population", sq, pg) }
});

pub def count_only_sites_with_matching_storage_devices: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{"op":"graph","root":"site",
        "nodes":[{"id":"site","entity":"site"},{"id":"storage","entity":"storage_device"}],
        "edges":[{"relation":"storage_device_site","from":"storage","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"}],
        "count":"storage","group_by_identity":["site"],
        "count_having":{"op":"lt","value":5},"count_groups":true}"#).unwrap!());
    if string::contains(query.sql, "SELECT count(1) FROM (SELECT site.SITE_NAME")
        && string::contains(query.sql, "INNER JOIN HuaweiStorageDevice AS storage")
        && !string::contains(query.sql, "LEFT JOIN") { True }
    else { fail!("matched-only site population must exclude sites with no related storage", query.sql) }
});

