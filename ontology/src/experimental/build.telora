# 同一次构建期准备产出运行程序及外部知识；不依赖 Service 生命周期。
use std::build as build;
use std::value::{Value};
use crate::experimental::transform as transform;
use crate::experimental::knowledge as knowledge;
use crate::ontology as edsl;

def stage: for(B) Fn(Fn() -> transform::Prepared, Fn(edsl::PreparedPayload) -> B) -> B = fn(prepare, program) {
    build::stage(fn() {
        let prepared = prepare();
        {runtime: prepared.payload, information: {"ontology.knowledge": knowledge::export(prepared)}}
    }, program)
};
pub use self::{stage};
