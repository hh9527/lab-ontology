def SourceFCSwitchDeviceDeviceType_domain: v::Domain(SourceFCSwitchDeviceDeviceType, String) = v::from_enum(
    "SourceFCSwitchDeviceDeviceType",
    SourceFCSwitchDeviceDeviceType.type,
    String.type,
    False
