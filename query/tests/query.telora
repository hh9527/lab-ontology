    let plan: qb.Plan = {
        revision: "test-bad-arity",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.substr([qb.column("o", "name")]))],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: 'None,
    };
    plan
