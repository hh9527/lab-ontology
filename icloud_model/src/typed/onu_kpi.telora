use ontology::quantity as statistic_quantity;
use super::metric_values as metric;
use ontology::quantity as presentation;
use ontology::semantic as domain;
# ONU KPI 独立声明；保持原始样本尺度，不引入加总或有效次数加权。
use super::inventory as i;
use super::pon_quantities as q;
use super::pon_device as p;
use super::pon_onu as onu;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
@domain::bind(p::PonElementById.type, "res_id")
@r::sources("onu_kpi_of_pon_device", ["source_EntPonElementAssociationPonDeviceOnuKPI"])
@domain::dataset("onu_kpi", "PonDeviceOnuKPI", ["res_id", "ts"])
@domain::metric("ts")
@domain::record_counts(["onu_kpi_sample_count"])
@edsl::dataset_description(
    "ONU KPI 采样",
    "onu_kpi_sample_count 统计窗口内采样行，不是 ONU 台数；按 ONU 分布时先按 ONU 身份聚合窗口指标，再分箱计数，并核对有界结果完整性"
)
@domain::relations(relations)
type PonDeviceOnuKPI = struct {
    @m::column("resId")
    res_id: domain::Reference(p::PonElementById),
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @g::view("onu_kpi_ts", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("onu_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("onu_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("onu_utc_month", qb::UtcBucketUnit::Month)
    @edsl::field_role(edsl::FieldRole::Classification)
    ts: s::DateTimeUtc,
    @m::column("ifInBandRate")
    @g::view("onu_receive_usage_sample", True, g::numeric_filters)
    @samples::field(
        metric::InboundBandwidthUtilization_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_receive_usage"},
            {statistic: samples::Statistic::Max, publish: "onu_receive_usage_max"},
            {statistic: samples::Statistic::Min, publish: "onu_receive_usage_min"}
        ]
    )
    @samples::valid_count("source_ifInBandRateEffcnt")
    @domain::count("onu_receive_usage_observation_count")
    if_in_band_rate: metric::InboundBandwidthUtilization,
    @m::column("parentId")
    @g::exact("onu_kpi__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("onu_kpi__projectId")
    source_projectId: String,
    @m::column("onuHwOpticsRxPower")
    @g::view("onu_kpi__onuHwOpticsRxPower", True, g::numeric_filters)
    @samples::field(
        q::Dbm_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_rx_power"},
            {statistic: samples::Statistic::Max, publish: "onu_rx_power_max"},
            {statistic: samples::Statistic::Min, publish: "onu_rx_power_min"}
        ]
    )
    @samples::valid_count("source_onuHwOpticsRxPowerEffcnt")
    @domain::count("onu_rx_power_observation_count")
    source_onuHwOpticsRxPower: q::Dbm,
    @m::column("onuHwOpticsTxPower")
    @g::view("onu_kpi__onuHwOpticsTxPower", True, g::numeric_filters)
    @samples::field(
        q::Dbm_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_tx_power"},
            {statistic: samples::Statistic::Max, publish: "onu_tx_power_max"},
            {statistic: samples::Statistic::Min, publish: "onu_tx_power_min"}
        ]
    )
    @samples::valid_count("source_onuHwOpticsTxPowerEffcnt")
    @domain::count("onu_tx_power_observation_count")
    source_onuHwOpticsTxPower: q::Dbm,
    @m::column("hwGponOntOpticsOltRxOntPower")
    @g::view("onu_kpi__hwGponOntOpticsOltRxOntPower", True, g::numeric_filters)
    @samples::field(
        q::Dbm_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_olt_rx"},
            {statistic: samples::Statistic::Max, publish: "onu_olt_rx_max"},
            {statistic: samples::Statistic::Min, publish: "onu_olt_rx_min"}
        ]
    )
    @samples::valid_count("source_hwGponOntOpticsOltRxOntPowerEffcnt")
    @domain::count("onu_olt_rx_observation_count")
    source_hwGponOntOpticsOltRxOntPower: q::Dbm,
    @m::column("onuhwOpticsTemperature")
    @g::view("onu_kpi__onuhwOpticsTemperature", True, g::numeric_filters)
    @samples::field(
        q::DegreesCelsius_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_opt_temp"},
            {statistic: samples::Statistic::Max, publish: "onu_opt_temp_max"},
            {statistic: samples::Statistic::Min, publish: "onu_opt_temp_min"}
        ]
    )
    @samples::valid_count("source_onuhwOpticsTemperatureEffcnt")
    @domain::count("onu_opt_temp_observation_count")
    source_onuhwOpticsTemperature: q::DegreesCelsius,
    @m::column("temperature")
    @g::view("onu_kpi__temperature", True, g::numeric_filters)
    @samples::field(
        q::DegreesCelsius_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_temp"},
            {statistic: samples::Statistic::Max, publish: "onu_temp_max"},
            {statistic: samples::Statistic::Min, publish: "onu_temp_min"}
        ]
    )
    @samples::valid_count("source_temperatureEffcnt")
    @domain::count("onu_temp_observation_count")
    source_temperature: q::DegreesCelsius,
    @m::column("memUsage")
    @g::view("onu_kpi__memUsage", True, g::numeric_filters)
    @samples::field(
        metric::memory_summary,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_mem"},
            {statistic: samples::Statistic::Max, publish: "onu_mem_max"},
            {statistic: samples::Statistic::Min, publish: "onu_mem_min"}
        ]
    )
    @samples::valid_count("source_memUsageEffcnt")
    @domain::count("onu_mem_observation_count")
    source_memUsage: metric::MemoryUtilization,
    @m::column("cpuUsage")
    @g::view("onu_kpi__cpuUsage", True, g::numeric_filters)
    @samples::field(
        metric::cpu_summary,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_cpu"},
            {statistic: samples::Statistic::Max, publish: "onu_cpu_max"},
            {statistic: samples::Statistic::Min, publish: "onu_cpu_min"}
        ]
    )
    @samples::valid_count("source_cpuUsageEffcnt")
    @domain::count("onu_cpu_observation_count")
    source_cpuUsage: metric::CpuUtilization,
    @m::column("ifHCInOctetsSpeed")
    @g::view("onu_kpi__ifHCInOctetsSpeed", True, g::numeric_filters)
    @samples::field(
        q::BitsPerSecond_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_rx"},
            {statistic: samples::Statistic::Max, publish: "onu_rx_max"},
            {statistic: samples::Statistic::Min, publish: "onu_rx_min"}
        ]
    )
    @samples::valid_count("source_ifHCInOctetsSpeedEffcnt")
    @domain::count("onu_rx_observation_count")
    source_ifHCInOctetsSpeed: q::BitsPerSecond,
    @m::column("ifHCOutOctetsSpeed")
    @g::view("onu_kpi__ifHCOutOctetsSpeed", True, g::numeric_filters)
    @samples::field(
        q::BitsPerSecond_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_tx"},
            {statistic: samples::Statistic::Max, publish: "onu_tx_max"},
            {statistic: samples::Statistic::Min, publish: "onu_tx_min"}
        ]
    )
    @samples::valid_count("source_ifHCOutOctetsSpeedEffcnt")
    @domain::count("onu_tx_observation_count")
    source_ifHCOutOctetsSpeed: q::BitsPerSecond,
    @m::column("ifOutBandRate")
    @g::view("onu_kpi__ifOutBandRate", True, g::numeric_filters)
    @samples::field(
        metric::OutboundBandwidthUtilization_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "onu_tx_usage"},
            {statistic: samples::Statistic::Max, publish: "onu_tx_usage_max"},
            {statistic: samples::Statistic::Min, publish: "onu_tx_usage_min"}
        ]
    )
    @samples::valid_count("source_ifOutBandRateEffcnt")
    @domain::count("onu_tx_usage_observation_count")
    source_ifOutBandRate: metric::OutboundBandwidthUtilization,
    @m::column("downBipError")
    @g::view("onu_kpi__downBipError", True, g::numeric_filters)
    @samples::valid_count("source_downBipErrorEffcnt")
    source_downBipError: metric::DownstreamBipErrors,
    @m::column("onuHwOpticsRxPowerEffcnt")
    @g::view("onu_kpi__onuHwOpticsRxPowerEffcnt", True, g::numeric_filters)
    source_onuHwOpticsRxPowerEffcnt: statistic_quantity::EffectiveCount,
    @m::column("onuHwOpticsTxPowerEffcnt")
    @g::view("onu_kpi__onuHwOpticsTxPowerEffcnt", True, g::numeric_filters)
    source_onuHwOpticsTxPowerEffcnt: statistic_quantity::EffectiveCount,
    @m::column("hwGponOntOpticsOltRxOntPowerEffcnt")
    @g::view("onu_kpi__hwGponOntOpticsOltRxOntPowerEffcnt", True, g::numeric_filters)
    source_hwGponOntOpticsOltRxOntPowerEffcnt: statistic_quantity::EffectiveCount,
    @m::column("onuhwOpticsTemperatureEffcnt")
    @g::view("onu_kpi__onuhwOpticsTemperatureEffcnt", True, g::numeric_filters)
    source_onuhwOpticsTemperatureEffcnt: statistic_quantity::EffectiveCount,
    @m::column("temperatureEffcnt")
    @g::view("onu_kpi__temperatureEffcnt", True, g::numeric_filters)
    source_temperatureEffcnt: statistic_quantity::EffectiveCount,
    @m::column("memUsageEffcnt")
    @g::view("onu_kpi__memUsageEffcnt", True, g::numeric_filters)
    source_memUsageEffcnt: statistic_quantity::EffectiveCount,
    @m::column("cpuUsageEffcnt")
    @g::view("onu_kpi__cpuUsageEffcnt", True, g::numeric_filters)
    source_cpuUsageEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifHCInOctetsSpeedEffcnt")
    @g::view("onu_kpi__ifHCInOctetsSpeedEffcnt", True, g::numeric_filters)
    source_ifHCInOctetsSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifHCOutOctetsSpeedEffcnt")
    @g::view("onu_kpi__ifHCOutOctetsSpeedEffcnt", True, g::numeric_filters)
    source_ifHCOutOctetsSpeedEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifInBandRateEffcnt")
    @g::view("onu_kpi__ifInBandRateEffcnt", True, g::numeric_filters)
    source_ifInBandRateEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifOutBandRateEffcnt")
    @g::view("onu_kpi__ifOutBandRateEffcnt", True, g::numeric_filters)
    source_ifOutBandRateEffcnt: statistic_quantity::EffectiveCount,
    @m::column("downBipErrorEffcnt")
    @g::view("onu_kpi__downBipErrorEffcnt", True, g::numeric_filters)
    source_downBipErrorEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifUtilizationRateEffcnt")
    @g::view("onu_kpi__ifUtilizationRateEffcnt", True, g::numeric_filters)
    source_ifUtilizationRateEffcnt: statistic_quantity::EffectiveCount,
};
def device: r::Endpoint = domain::endpoint(PonDeviceOnuKPI.type, "res_id");
def relations: Array(r::Relation) = [
    r::relation(
        "onu_kpi_of_pon_device",
        device,
        p::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "onu_kpi_of_onu_role",
        device,
        onu::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PonDeviceOnuKPI};
