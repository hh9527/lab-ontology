def dog_entity_index: Int = 5;

def test_probe_ranked_positive = do {
    let feasible: Bool = edsl.ranked_key_compare_ok(
        payload,
        dog_entity_index,
        "resolver",
        "DogBreedCode",
        "DogBreedCode",
        "DogCount",
        edsl.OrderDirection.Desc,
        [],
    );
    if feasible {
        True
    } else {
        fail!("ranked-key positive probe expected to be feasible")
    }
};

def test_probe_ranked_type_rejection = do {
    let feasible: Bool = edsl.ranked_key_compare_ok(
        payload,
        dog_entity_index,
        "resolver",
        "DogAge",
        "DogBreedCode",
        "DogCount",
        edsl.OrderDirection.Desc,
        [],
    );
    if feasible {
        fail!("ranked-key type-incompatible probe expected to be rejected")
    } else {
        True
    }
};

def check_sql: Fn(String, Value, String) -> Bool = fn(label, intent, expected_sql) {
    let query: qb.Query = lower_intent(intent);
    if query.sql == expected_sql {
        True
    } else {
        fail!("sql assertion failed", label, query.sql)
    }
};

def test_exact_top_hidden_no_measure = do {
    let intent = json.parse(r#"{
        "op": "top", "measures": [],
        "dimensions": ["OwnerId", "OwnerFirstName", "OwnerLastName"],
        "filters": [],
        "ordering": [{"target": "Measure", "id": "DogCount", "direction": "Desc"}],
        "exists": [], "having": [], "limit": 1, "offset": null
    }"#) |> result.unwrap;
    check_sql("exact-top-hidden", intent,
        "SELECT ow.owner_id, ow.first_name, ow.last_name FROM Owners AS ow INNER JOIN Dogs AS dg ON ow.owner_id = dg.owner_id GROUP BY ow.owner_id, ow.first_name, ow.last_name ORDER BY count(dg.dog_id) DESC LIMIT ?")
};

