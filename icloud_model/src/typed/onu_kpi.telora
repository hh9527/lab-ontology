@registry::relations(relations)
type PonDeviceOnuKPI = struct {
    @m::column("resId")
    res_id: p::PonId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    ts: s::DateTimeUtc,
    @m::column("ifInBandRate")
    if_in_band_rate: q::Percent,
    @m::column("parentId")
    @g::exact("onu_kpi__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("onu_kpi__projectId")
    source_projectId: String,
    @m::column("onuHwOpticsRxPower")
    source_onuHwOpticsRxPower: q::Dbm,
    @m::column("onuHwOpticsTxPower")
    source_onuHwOpticsTxPower: q::Dbm,
    @m::column("hwGponOntOpticsOltRxOntPower")
    source_hwGponOntOpticsOltRxOntPower: q::Dbm,
    @m::column("onuhwOpticsTemperature")
    source_onuhwOpticsTemperature: q::DegreesCelsius,
    @m::column("temperature")
    source_temperature: q::DegreesCelsius,
    @m::column("memUsage")
    source_memUsage: q::Percent,
    @m::column("cpuUsage")
    source_cpuUsage: q::Percent,
    @m::column("ifHCInOctetsSpeed")
    source_ifHCInOctetsSpeed: q::BitsPerSecond,
    @m::column("ifHCOutOctetsSpeed")
    source_ifHCOutOctetsSpeed: q::BitsPerSecond,
    @m::column("ifOutBandRate")
    source_ifOutBandRate: q::Percent,
    @m::column("downBipError")
    source_downBipError: Int,
    @m::column("onuHwOpticsRxPowerEffcnt")
    source_onuHwOpticsRxPowerEffcnt: Int,
    @m::column("onuHwOpticsTxPowerEffcnt")
    source_onuHwOpticsTxPowerEffcnt: Int,
    @m::column("hwGponOntOpticsOltRxOntPowerEffcnt")
    source_hwGponOntOpticsOltRxOntPowerEffcnt: Int,
    @m::column("onuhwOpticsTemperatureEffcnt")
    source_onuhwOpticsTemperatureEffcnt: Int,
    @m::column("temperatureEffcnt")
    source_temperatureEffcnt: Int,
    @m::column("memUsageEffcnt")
    source_memUsageEffcnt: Int,
    @m::column("cpuUsageEffcnt")
    source_cpuUsageEffcnt: Int,
    @m::column("ifHCInOctetsSpeedEffcnt")
    source_ifHCInOctetsSpeedEffcnt: Int,
    @m::column("ifHCOutOctetsSpeedEffcnt")
    source_ifHCOutOctetsSpeedEffcnt: Int,
    @m::column("ifInBandRateEffcnt")
    source_ifInBandRateEffcnt: Int,
    @m::column("ifOutBandRateEffcnt")
    source_ifOutBandRateEffcnt: Int,
    @m::column("downBipErrorEffcnt")
    source_downBipErrorEffcnt: Int,
    @m::column("ifUtilizationRateEffcnt")
    source_ifUtilizationRateEffcnt: Int,
};
def dataset: m::Dataset(PonDeviceOnuKPI) = registry::dataset_of(PonDeviceOnuKPI.type);
def device: m::Role(PonDeviceOnuKPI) = m::role(
    dataset,
    p::entity,
    "device",
    False,
    [
        m::identity_part(
            m::field(PonDeviceOnuKPI.type, p::PonId.type, "res_id"),
            m::field(p::Identity.type, p::PonId.type, "id")
        )
    ]
);
def declaration: t::Declaration = registry::declaration(PonDeviceOnuKPI.type);
def relations: Array(r::Relation) = [
    r::relation(
        "onu_kpi_of_pon_device",
        dataset,
        device,
        p::dataset,
        p::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "onu_kpi_of_onu_role",
        dataset,
        device,
        onu::dataset,
        onu::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EntPonElementAssociationPonDeviceOnuKPI",
        p::dataset,
        p::subject,
        dataset,
        device,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{declaration, relations};

pub use self::{PonDeviceOnuKPI};
