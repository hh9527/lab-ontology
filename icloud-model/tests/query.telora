pub def ap_ssid_sample_mean_is_distinct_from_published_sum: test::Test = test::should_ok(fn() {
    let metrics = edsl::metric_domain(payload, "ap_radio_ssid_kpi");
    let published = array::any(metrics, fn(m) {
        m.id == "ap_ssid_connected_terminals" && m.aggregate == qb::AggregateFunction::Sum
    });
    let sample_mean = array::any(metrics, fn(m) {
        m.id == "ap_ssid_connected_terminals_sample_avg" && m.aggregate == qb::AggregateFunction::Avg
    });
    if published && sample_mean { True }
    else { fail!("AP SSID Model must declare published Sum and separate sample Avg", metrics) }
});

pub def ap_ssid_mean_groups_by_complete_ap_identity: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_related","dataset":"ap_radio_ssid_kpi","owner":"device","relation":"ap_ssid_kpi_of_device","measures":["ap_ssid_connected_terminals_sample_avg"],"dimensions":["device_name"],"filters":[{"dimension":"device_class","op":"eq","kind":"text","value":"AP"}],"ordering":[],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"limit":null,"offset":null}`);
    if string::contains(q.sql, "avg(ask.connectedTerminals)")
        && string::contains(q.sql, "ask.parentId = d.id")
        && string::contains(q.sql, "ask.tenantId = d.tenant_id")
        && string::contains(q.sql, "GROUP BY d.name, d.id, d.tenant_id")
        && q.bindings == [qb::Val::String("ne.category.fatap"), qb::Val::String("AP"),
            qb::Val::String("2024-02-01T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z")] { True }
    else { fail!("AP SSID mean must pool raw rows within complete AP identity", q) }
});

pub def ap_ssid_all_history_mean_requires_no_fake_qualification: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_related","dataset":"ap_radio_ssid_kpi","owner":"device","relation":"ap_ssid_kpi_of_device","measures":["ap_ssid_connected_terminals_sample_avg"],"dimensions":["device_name"],"filters":[],"ordering":[],"window":null,"limit":null,"offset":null}`);
