use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::kpi_network_optical_info;
@domain::subject("EnterpriseOpticalModule", "obj_sys_id")
@domain::dataset("enterprise-optical-module-2-kpi", "EnterpriseOpticalModule2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseOpticalModule2Kpi = struct {
    @m::column("objSysId")
    @g::field_view(g::dimension_group("enterprise-optical-module-2-kpi/obj_sys_id", ids::EnterpriseOpticalModuleById.type, True, [g::Filter::Eq]), "eom2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("eom2_count")
    obj_sys_id: ids::EnterpriseOpticalModuleById,
    @g::field_view(g::dimension_group("enterprise-optical-module-2-kpi/obj_id", domain::Reference(ids::EnterpriseOpticalModule2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "eom2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseOpticalModule2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("eom2__noi", domain::endpoint(EnterpriseOpticalModule2Kpi.type, "obj_id"), domain::endpoint(kpi_network_optical_info::KpiNetworkOpticalInfo.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
