use crate::ontology as edsl;
use crate::knowledge as knowledge;
use std::test as test;
use std::array as array;

pub def independent_and_member_addresses: test::Test = test::should_ok(fn() {
    knowledge::target_address({kind: edsl::KnowledgeKind::Dataset, owner: "", id: "alarm"}) == {node: "datasets/alarm", member: None}
    && knowledge::target_address({kind: edsl::KnowledgeKind::Field, owner: "alarm", id: "severity"}) == {node: "datasets/alarm", member: Some("fields/severity")}
    && knowledge::target_address({kind: edsl::KnowledgeKind::Ty, owner: "", id: "Severity"}) == {node: "types/Severity", member: None}
    && knowledge::target_address({kind: edsl::KnowledgeKind::Value, owner: "Severity", id: "major"}) == {node: "types/Severity", member: Some("values/major")}
});

pub def addresses_encode_ids_independently_once: test::Test = test::should_ok(fn() {
    knowledge::target_address({kind: edsl::KnowledgeKind::Dimension, owner: "a/b#%", id: "x/y#%"})
        == {node: "datasets/a%2Fb%23%25", member: Some("dimensions/x%2Fy%23%25")}
});

pub def every_fact_category_has_a_role: test::Test = test::should_ok(fn() {
    array::map([edsl::KnowledgeKind::Field, edsl::KnowledgeKind::Dimension, edsl::KnowledgeKind::Measure,
        edsl::KnowledgeKind::TimeRole, edsl::KnowledgeKind::BusinessLink, edsl::KnowledgeKind::Value,
        edsl::KnowledgeKind::Relation], knowledge::target_role)
    == ["fields", "dimensions", "measures", "time_roles", "business_links", "values", "relations"]
});

pub def diagnostics_use_consumer_addresses: test::Test = test::should_ok(fn() {
    edsl::knowledge_key_hint(edsl::KnowledgeKind::Dimension, "alarm", "severity")
        == "\"datasets/alarm#dimensions/severity\""
});
