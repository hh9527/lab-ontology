def org_related_hidden_ordering: Fn() -> Bool = fn() {
    assert_org(
        "org-related-hidden-ordering",
        parse(r#"{
            "op": "top",
            "measures": [],
            "dimensions": ["OrgRegion"],
            "filters": [],
            "ordering": [
                {"target": "Measure", "id": "OrgMemberCount", "direction": "Desc"}
            ],
            "limit": 1,
            "offset": null
        }"#),
        "SELECT t.region FROM org_teams AS t INNER JOIN org_members AS m ON t.id = m.team_id GROUP BY t.region ORDER BY count(m.id) DESC LIMIT ?",
        [qb::Val::Int(1)],
    )
};

def org_set_intersect: Fn() -> Bool = fn() {
    assert_org(
        "org-set-intersect",
        parse(r#"{
            "op": "set",
            "kind": "intersect",
            "branches": [
                {
                    "shape": "row",
                    "measures": [],
                    "dimensions": ["OrgRegion"],
                    "filters": [
                        {"dimension": "OrgRegion", "op": "eq", "kind": "text", "value": "north"}
                    ],
                    "ordering": [],
                    "limit": null,
                    "offset": null
                },
                {
                    "shape": "row",
                    "measures": [],
                    "dimensions": ["OrgRegion"],
                    "filters": [
                        {"dimension": "OrgRegion", "op": "eq", "kind": "text", "value": "south"}
                    ],
                    "ordering": [],
                    "limit": null,
                    "offset": null
                }
            ]
        }"#),
        "SELECT t.region FROM org_teams AS t WHERE t.region = ? INTERSECT SELECT t.region FROM org_teams AS t WHERE t.region = ?",
        [qb::Val::String("north"), qb::Val::String("south")],
    )
};

def org_set_count: Fn() -> Bool = fn() {
    assert_org(
        "org-set-count",
        parse(r#"{
            "op": "set_count",
            "kind": "intersect",
            "branches": [
                {
                    "shape": "row",
                    "measures": [],
                    "dimensions": ["OrgRegion"],
                    "filters": [
                        {"dimension": "OrgRegion", "op": "eq", "kind": "text", "value": "north"}
                    ],
                    "ordering": [],
                    "limit": null,
                    "offset": null
                },
                {
                    "shape": "row",
                    "measures": [],
                    "dimensions": ["OrgRegion"],
                    "filters": [
                        {"dimension": "OrgRegion", "op": "eq", "kind": "text", "value": "south"}
                    ],
                    "ordering": [],
                    "limit": null,
                    "offset": null
                }
            ]
        }"#),
        "SELECT count(1) FROM (SELECT t.region FROM org_teams AS t WHERE t.region = ? INTERSECT SELECT t.region FROM org_teams AS t WHERE t.region = ?) AS __q_set",
        [qb::Val::String("north"), qb::Val::String("south")],
    )
};

# ---------------------------------------------------------------------------
# Determinism: repeated lowering is byte-identical across both models.
# ---------------------------------------------------------------------------

def deterministic_knowledge: Fn() -> Bool = fn() {
    let intent = parse(r#"{
        "op": "list",
        "measures": [],
        "dimensions": ["MemberKind"],
        "filters": [
            {"dimension": "MemberKind", "op": "eq", "kind": "text", "value": "staff"}
        ],
        "ordering": [],
        "exists": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#);
    let first = lower_knowledge(intent);
    let second = lower_knowledge(intent);
    if first == second {
        True
    } else {
        fail!("knowledge intent lowering is not deterministic", first, second)
    }
};

def deterministic_org: Fn() -> Bool = fn() {
    let intent = parse(r#"{
        "op": "aggregate",
        "measures": ["TeamCount"],
        "dimensions": ["OrgRegion"],
        "filters": [],
        "ordering": [],
        "having": [],
        "hidden_having": [
            {"measure": "TeamHeadSum", "op": "ge", "kind": "int", "value": 5}
        ],
        "exists": [],
        "limit": null,
        "offset": null
    }"#);
    let first = lower_org(intent);
    let second = lower_org(intent);
    if first.sql == second.sql && first.bindings == second.bindings {
        True
    } else {
        fail!("org intent lowering is not deterministic", first, second)
    }
};

# ---------------------------------------------------------------------------
# Rejection probes (pure `query_intent_ok`, never fails).
# ---------------------------------------------------------------------------

def valid_knowledge_intent: Value = parse(r#"{
    "op": "list",
    "measures": [],
    "dimensions": ["MemberKind"],
    "filters": [],
    "ordering": [],
    "exists": [],
    "having": [],
    "limit": null,
    "offset": null
}"#);

def rejects_unauthorized_subject: Fn() -> Bool = fn() {
    if !query_intent_ok(payload, "outsider", valid_knowledge_intent) {
        True
    } else {
        fail!("intent probe: an unauthorized subject should be rejected")
    }
};

def rejects_unknown_op: Fn() -> Bool = fn() {
    let intent = parse(r#"{"op": "wizard", "measures": [], "dimensions": [], "filters": [], "ordering": []}"#);
    if !query_intent_ok(payload, "analyst", intent) {
        True
    } else {
        fail!("intent probe: an unsupported op should be rejected")
    }
};

def rejects_malformed_measures: Fn() -> Bool = fn() {
    let intent = parse(r#"{"op": "count", "measures": "MemberCount", "dimensions": [], "filters": [], "ordering": []}"#);
    if !query_intent_ok(payload, "analyst", intent) {
        True
    } else {
        fail!("intent probe: a malformed measures field should be rejected")
    }
};

def rejects_field_predicate_outside_list: Fn() -> Bool = fn() {
    # field-to-field predicates are a row-level list shape; using one inside an
    # aggregate shape is rejected by the structural probe (and by lowering).
    let intent = parse(r#"{
        "op": "aggregate",
        "measures": ["TeamCount"],
        "dimensions": ["OrgRegion"],
        "filters": [
            {"left": "OrgCode", "op": "eq", "right": "OrgZone"}
        ],
        "ordering": [],
        "having": [],
        "limit": null,
        "offset": null
    }"#);
    if !query_intent_ok(org_payload(), "analyst", intent) {
        True
    } else {
        fail!("intent probe: a field-to-field predicate outside the list shape should be rejected")
    }
};

def rejects_unsupported_set_kind: Fn() -> Bool = fn() {
    let intent = parse(r#"{"op": "set", "kind": "fuzzy", "branches": []}"#);
    if !query_intent_ok(payload, "analyst", intent) {
        True
    } else {
        fail!("intent probe: an unsupported set kind should be rejected")
    }
};

def positive_control_intents: Fn() -> Bool = fn() {
    if query_intent_ok(payload, "analyst", valid_knowledge_intent)
        && query_intent_ok(org_payload(), "analyst", parse(r#"{
            "op": "list",
            "measures": [],
            "dimensions": ["OrgRegion"],
            "filters": [
                {"left": "OrgCode", "op": "eq", "right": "OrgZone"}
            ],
            "ordering": [],
            "limit": null,
            "offset": null
        }"#)) {
        True
    } else {
        fail!("intent probe: valid intents should be accepted")
    }
};

