pub def pon_communication_values_retain_locales_and_physical_equivalence: test::Test = test::should_ok(fn() {
    let detail = edsl::dimension_detail_for_subject(payload, "public", "pon_commu_state");
    let full = edsl::dimension_detail(payload, "pon_commu_state");
    let offline = array::find(detail.values, fn(value) { value.id == "offline" });
    let online = array::find(detail.values, fn(value) { value.id == "online" });
    let mapped = array::find(full.canonical_values, fn(value) { value.id == "offline" });
    let q = lower_json(`{"op":"list","measures":[],"dimensions":["pon_id"],"filters":[{"dimension":"pon_commu_state","op":"eq","kind":"text","value":"offline"}],"ordering":[],"limit":null,"offset":null}`);
    if detail.dataset == "pon_device" && array::length(detail.values) == 2
        && match offline { Some(value) => value.label == "Offline"
            && array::any(value.localized, fn(item) { item.locale == "en" && item.label == "Offline" })
            && array::any(value.localized, fn(item) { item.locale == "zh" && item.label == "离线" }), None => False }
        && match online { Some(value) => array::any(value.localized, fn(item) { item.locale == "zh" && item.label == "在线" }), None => False }
        && array::length(full.localized_values) == 4
        && match mapped { Some(value) => array::length(value.wires) == 6, None => False }
        && q.bindings == [qb::Val::String("0"), qb::Val::String("2"), qb::Val::String("3"), qb::Val::String("4"), qb::Val::String("14"), qb::Val::String("15")]
        && string::contains(q.sql, "pd.commuState") { True }
    else { fail!("PON communication labels must not change canonical filtering", detail, full, q) }
});

