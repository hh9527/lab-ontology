# Contract tests for the EnterpriseKnowledge eDSL.
#
# Runs assertions over:
#   property fold, request coverage, relation selection, equality/range filters,
#   unprojected filter dimensions, measure-desc/dimension-asc ordering, Top N,
#   binding order, profile coverage, repeated-lowering determinism, and
#   cross-module prepared behavior.
#
# Any failed assertion fails loudly so `check @test/ontology` is strict.

import "@src/query" as qb;
import "std/value" { Value };
import "std/array" as array;
import "std/string" as string;
import "std/type-property" as property;
import "std/type-desc" as td;
import "@src/edsl" as edsl;
import "@src/knowledge" as knowledge;

# ---------------------------------------------------------------------------
# Assertion helper.
# ---------------------------------------------------------------------------

def check: Fn(Bool, String) -> Bool = fn(cond, label) {
    if cond { 'True } else { fail!("verify check failed", label) }
};

# ---------------------------------------------------------------------------
# Structural inspection helpers.
# ---------------------------------------------------------------------------

def get_index: for(A) Fn(Array(A), Int) -> A = fn(values, i) {
    match array.get(values, i) {
        'Some(v) => v,
        'None => fail!("index out of range", i),
    }
};

def get_expr: Fn(Array(qb.Expr), Int) -> qb.Expr = fn(xs, i) {
    get_index(xs, i)
};

def is_column: Fn(qb.Expr, String, String) -> Bool = fn(e, source, column) {
    match e {
        'Column(ref) => ref.source == source && ref.column == column,
        _ => 'False,
    }
};

def is_bind: Fn(qb.Expr) -> Bool = fn(e) {
    match e { 'Bind(_) => 'True, _ => 'False }
};

def is_eq_region: Fn(qb.Expr) -> Bool = fn(e) {
    match e {
        'Scalar(call) => call.function == 'Eq
            && array.length(call.args) == 2
            && is_column(get_expr(call.args, 0), "o", "region")
            && is_bind(get_expr(call.args, 1)),
        _ => 'False,
    }
};

def is_ge_week: Fn(qb.Expr) -> Bool = fn(e) {
    match e {
        'Scalar(call) => do {
            if call.function != 'Ge || array.length(call.args) != 2 {
                'False
            } else {
                let pred = get_expr(call.args, 0);
                let bound = get_expr(call.args, 1);
                match pred {
                    'Scalar(sub) => sub.function == 'Substr
                        && array.length(sub.args) == 3
                        && is_column(get_expr(sub.args, 0), "o", "created_at")
                        && is_bind(get_expr(sub.args, 1))
                        && is_bind(get_expr(sub.args, 2))
                        && is_bind(bound),
                    _ => 'False,
                }
            }
        },
        _ => 'False,
    }
};

def filter_and_eq_ge: Fn(Option(qb.Expr)) -> Bool = fn(f) {
    match f {
        'Some('Scalar(call)) => do {
            if call.function != 'And || array.length(call.args) != 2 {
                'False
            } else {
                is_eq_region(get_expr(call.args, 0)) && is_ge_week(get_expr(call.args, 1))
            }
        },
        _ => 'False,
    }
};

def aggregate_alias_count: Fn(Array(qb.SelectItem), String) -> Int = fn(items, alias) {
    array.length(array.filter(items, fn(item) {
        match item {
            'Aggregate(agg) => agg.alias == alias,
            'Expr(_) => 'False,
            'Computed(_) => 'False,
        }
    }))
};

def expr_item_count: Fn(Array(qb.SelectItem)) -> Int = fn(items) {
    array.length(array.filter(items, fn(item) {
        match item { 'Expr(_) => 'True, 'Aggregate(_) => 'False, 'Computed(_) => 'False }
    }))
};

def ordering_shape_ok: Fn(Array(qb.OrderBy)) -> Bool = fn(ordering) {
    if array.length(ordering) != 2 {
        'False
    } else {
        let first = get_index(ordering, 0);
        let second = get_index(ordering, 1);
        let first_key_ok = match first.key {
            'AggregateRef(ref) => ref.alias == "OrderAmount",
            _ => 'False,
        };
        let first_dir_ok = match first.direction { 'Desc => 'True, 'Asc => 'False };
        let second_key_ok = match second.key {
            'Expr(e) => is_column(e, "o", "region"),
            _ => 'False,
        };
        let second_dir_ok = match second.direction { 'Asc => 'True, 'Desc => 'False };
        first_key_ok && first_dir_ok && second_key_ok && second_dir_ok
    }
};

def join_ok: Fn(Array(qb.Join)) -> Bool = fn(joins) {
    if array.length(joins) != 1 {
        'False
    } else {
        let j = get_index(joins, 0);
        let kind_ok = match j.kind { 'Inner => 'True, 'Left => 'False };
        let source_ok = j.source.alias == "c" && j.source.table == "customers";
        let cond_ok = match j.condition {
            'Eq(eq) => eq.left.source == "o" && eq.left.column == "customer_id"
                && eq.right.source == "c" && eq.right.column == "id",
            _ => 'False,
        };
        kind_ok && source_ok && cond_ok
    }
};

# ---------------------------------------------------------------------------
# Property fold probe (declared in this module).
# ---------------------------------------------------------------------------

def safe_kind: edsl.RelationKind = 'Safe;
def fanout_kind: edsl.RelationKind = 'FanOut;
def flag_true: Bool = 'True;

@edsl.relation(FoldProbe, safe_kind, 0, 0)
@edsl.relation(FoldProbe, fanout_kind, 0, 0)
type FoldProbe = struct {
    @edsl.column("first")
    @edsl.column("second")
    @edsl.key(flag_true)
    id: Int,
};

# ---------------------------------------------------------------------------
# Requests used by the checks.
# ---------------------------------------------------------------------------

def main_request: edsl.QueryRequest = {
    measures: [
        { id: "OrderAmount", subject: "analyst", input: 'All },
        { id: "OrderCount", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "OrderRegion", subject: "analyst", input: 'None },
        { id: "OrderWeek", subject: "analyst", input: 'None },
        { id: "CustomerTier", subject: "analyst", input: 'None },
    ],
    filters: [
        { id: "OrderRegion", subject: "analyst", op: 'Eq, input: 'Text("east") },
        { id: "OrderWeek", subject: "analyst", op: 'Ge, input: 'Text("2024-01") },
    ],
    ordering: [
        { target: 'Measure("OrderAmount"), direction: 'Desc },
        { target: 'Dimension("OrderRegion"), direction: 'Asc },
    ],
    limit: 'Some(5),
    offset: 'None,
    partition: 'None,
};

def unprojected_filter_request: edsl.QueryRequest = {
    measures: [
        { id: "OrderAmount", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "OrderRegion", subject: "analyst", input: 'None },
    ],
    filters: [
        { id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("gold") },
    ],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

# Closed-enum dimension request: filters CustomerTier by a legal stable value.
def enum_request: edsl.QueryRequest = {
    measures: [
        { id: "OrderAmount", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "OrderRegion", subject: "analyst", input: 'None },
    ],
    filters: [
        { id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("gold") },
    ],
    ordering: [],
    limit: 'Some(2),
    offset: 'None,
    partition: 'None,
};

# Open String dimension request (compatibility with the existing open
# dimensions; the value is not constrained by any closed domain).
def open_string_request: edsl.QueryRequest = {
    measures: [
        { id: "OrderAmount", subject: "analyst", input: 'All },
    ],
    dimensions: [
        { id: "OrderRegion", subject: "analyst", input: 'None },
    ],
    filters: [
        { id: "OrderRegion", subject: "analyst", op: 'Eq, input: 'Text("west") },
    ],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

# ---------------------------------------------------------------------------
# Individual checks.
# ---------------------------------------------------------------------------

def check_property_fold: Bool = do {
    let col_ok = match property.get_field_prop(FoldProbe, 0, edsl.ColumnMap) {
        'Some(c) => c.column == "second",
        'None => 'False,
    };
    let rel_ok = match property.get_type_prop(FoldProbe, edsl.RelationDef) {
        'Some(d) => array.length(d.relations) == 2,
        'None => 'False,
    };
    let key_ok = match property.get_field_prop(FoldProbe, 0, edsl.KeyFlag) {
        'Some(k) => k.value,
        'None => 'False,
    };
    check(col_ok, "property fold: multiple column annotations collapse to last")
        && check(rel_ok, "property fold: relation annotations append")
        && check(key_ok, "property fold: key annotation present")
};

def check_knowledge_entries: Bool = do {
    let p = knowledge.payload;
    let measure_ids = array.map(p.measures, fn(m) { m.id });
    let has_amount = array.any(measure_ids, fn(id) { id == "OrderAmount" });
    let has_count = array.any(measure_ids, fn(id) { id == "OrderCount" });
    let has_cust = array.any(measure_ids, fn(id) { id == "CustomerCount" });
    let has_item = array.any(measure_ids, fn(id) { id == "ItemAmount" });
    let has_item_qty = array.any(measure_ids, fn(id) { id == "ItemQty" });
    let has_trace = array.any(measure_ids, fn(id) { id == "TraceCount" });
    let has_run = array.any(measure_ids, fn(id) { id == "TraceRunCount" });
    let has_skip = array.any(measure_ids, fn(id) { id == "TraceSkipCount" });
    let has_total = array.any(measure_ids, fn(id) { id == "TraceTotal" });
    let has_delta = array.any(measure_ids, fn(id) { id == "TraceDelta" });
    let has_approval = array.any(measure_ids, fn(id) { id == "ApprovalCount" })
        && array.any(measure_ids, fn(id) { id == "ApprovalApprovedCount" })
        && array.any(measure_ids, fn(id) { id == "ApprovalRejectedCount" })
        && array.any(measure_ids, fn(id) { id == "ApprovalNet" })
        && array.any(measure_ids, fn(id) { id == "ApprovalTotal" });
    let has_device = array.any(measure_ids, fn(id) { id == "DeviceCount" });
    let dim_ids = array.map(p.dimensions, fn(d) { d.id });
    let dims_ok = array.all([
        "OrderId", "OrderRegion", "OrderWeek", "CustomerName", "CustomerTier",
        "CustomerContact", "TraceKind", "TraceHead", "TraceOwner",
        "ApprovalStatus", "ApprovalSubject",
        "DeviceChannel", "DeviceRetryCount", "DeviceOwner",
    ], fn(id) { array.any(dim_ids, fn(d) { d == id }) });
    let contact = array.find(p.dimensions, fn(d) { d.id == "CustomerContact" });
    let contact_unauthorized = match contact {
        'Some(d) => !d.authorized,
        'None => 'False,
    };
    check(has_amount && has_count && has_cust && has_item && has_item_qty && has_trace && has_run && has_skip && has_total && has_delta && has_approval && has_device, "knowledge measures collected")
        && check(dims_ok, "knowledge dimensions collected")
        && check(contact_unauthorized, "known dimension CustomerContact exists but is not authorized")
};

def check_request_coverage: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, main_request);
    check(array.length(plan.projection) == 5, "request coverage: one projection per requested measure/dimension")
        && check(aggregate_alias_count(plan.projection, "OrderAmount") == 1, "request coverage: OrderAmount exactly once")
        && check(aggregate_alias_count(plan.projection, "OrderCount") == 1, "request coverage: OrderCount exactly once")
        && check(expr_item_count(plan.projection) == 3, "request coverage: three dimension expr items")
};

def check_relation_selection: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, main_request);
    check(join_ok(plan.joins), "relation selection: safe path Order->Customer becomes one inner join")
};

def check_filters: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, main_request);
    check(filter_and_eq_ge(plan.filter), "filters: equality on region and range (Ge) on computed week")
};

def check_unprojected_filter_dimension: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, unprojected_filter_request);
    let filter_mentions_tier = match plan.filter {
        'Some('Scalar(call)) => array.any(call.args, fn(a) { is_column(a, "c", "tier") }),
        _ => 'False,
    };
    let tier_not_projected = aggregate_alias_count(plan.projection, "tier") == 0
        && array.length(array.filter(plan.projection, fn(item) {
            match item { 'Expr(e) => is_column(e, "c", "tier"), _ => 'False }
        })) == 0;
    check(filter_mentions_tier, "unprojected filter dimension: filter path covers tier")
        && check(tier_not_projected, "unprojected filter dimension: tier not projected")
        && check(array.length(plan.joins) == 1, "unprojected filter dimension: join path provided")
};

def check_ordering_and_limit: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, main_request);
    check(ordering_shape_ok(plan.ordering), "ordering: measure desc then dimension asc")
        && check(plan.limit == 'Some(5), "top n: limit is Some(5)")
};

def check_bindings_order: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, main_request);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = [
        'Int(1), 'Int(7), 'String("east"), 'Int(1), 'Int(7), 'String("2024-01"),
        'Int(1), 'Int(7), 'Int(5),
    ];
    check(query.bindings == expected, "bindings order: projection, filter, grouping, limit")
};

def check_profile_coverage: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, main_request);
    let accepted = qb.profile_accepts(plan, knowledge.profile);
    let narrow: qb.PlanProfile = {
        allowed_operators: [
            'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
            'Filter, 'Group, 'Order, 'Limit,
        ],
        allowed_join_kinds: ['Inner, 'Left],
        allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
        allowed_scalars: ['Substr, 'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not],
        allow_distinct: 'True,
    };
    let rejected = !qb.profile_accepts(plan, narrow);
    check(accepted, "profile coverage: plan accepted by knowledge profile")
        && check(rejected, "profile coverage: plan rejected when Join capability is removed")
};

def check_determinism: Bool = do {
    let plan1: qb.Plan = edsl.lower(knowledge.payload, main_request);
    let plan2: qb.Plan = edsl.lower(knowledge.payload, main_request);
    let q1: qb.Query = qb.transform_sqlite(plan1);
    let q2: qb.Query = qb.transform_sqlite(plan2);
    check(plan1 == plan2, "determinism: repeated lowering yields identical plan")
        && check(q1.sql == q2.sql && q1.bindings == q2.bindings, "determinism: identical sql and bindings")
};

def check_measure_required_joins: Bool = do {
    # ItemAmount (item grain) requires Order: requesting it without any
    # dimensions must still produce the Item->Order safe join.
    let item_only: edsl.QueryRequest = {
        measures: [{ id: "ItemAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let p1: qb.Plan = edsl.lower(knowledge.payload, item_only);
    # ItemQty (item grain) requires Order and Customer: two safe joins.
    let item_qty: edsl.QueryRequest = {
        measures: [{ id: "ItemQty", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let p2: qb.Plan = edsl.lower(knowledge.payload, item_qty);
    let join1_ok = array.length(p1.joins) == 1;
    let join2_ok = array.length(p2.joins) == 2;
    check(join1_ok, "measure required entity: ItemAmount plan has the Item->Order join")
        && check(join2_ok, "measure required entities: ItemQty plan has Item->Order and Order->Customer joins")
};

def check_cross_module_prepared: Bool = do {
    # This module consumes the payload published by @src/knowledge (a different
    # module). The published closures (computed dimension builder and the
    # authorization predicate) must work here with their original identity.
    let p = knowledge.payload;
    let auth_ok = p.authorize("analyst") && !p.authorize("outsider");
    let week_entry = match array.find(p.dimensions, fn(d) { d.id == "OrderWeek" }) {
        'Some(d) => d,
        'None => fail!("OrderWeek dimension missing"),
    };
    let week_expr = edsl.dimension_expr(p, week_entry);
    let computed_ok = match week_expr {
        'Scalar(call) => call.function == 'Substr && array.length(call.args) == 3,
        _ => 'False,
    };
    let entities_ok = array.length(p.entities) == 14;
    check(auth_ok, "cross-module: published authorization closure works")
        && check(computed_ok, "cross-module: published computed-dimension closure works")
        && check(entities_ok, "cross-module: published entity index available")
};

def check_enum_domain: Bool = do {
    # The CustomerTier dimension carries a closed value domain published at
    # prepare time (stable values and labels), discoverable from the payload
    # without reading the model source.
    let p = knowledge.payload;
    let tier = match array.find(p.dimensions, fn(d) { d.id == "CustomerTier" }) {
        'Some(d) => d,
        'None => fail!("CustomerTier dimension missing"),
    };
    let values = tier.values;
    let domain_ok = array.length(values) == 3
        && array.any(values, fn(v) { v.variant == "Gold" && v.value == "gold" && v.label == "Gold customer" })
        && array.any(values, fn(v) { v.variant == "Silver" && v.value == "silver" && v.label == "Silver customer" })
        && array.any(values, fn(v) { v.variant == "Bronze" && v.value == "bronze" && v.label == "Bronze customer" });
    let region = match array.find(p.dimensions, fn(d) { d.id == "OrderRegion" }) {
        'Some(d) => d,
        'None => fail!("OrderRegion dimension missing"),
    };
    check(domain_ok, "enum domain: closed catalog published with stable values and labels")
        && check(array.length(region.values) == 0, "enum domain: open string dimension has empty value domain")
};

def check_dimension_domain_helper: Bool = do {
    let values = edsl.dimension_domain(knowledge.payload, "CustomerTier");
    let region_values = edsl.dimension_domain(knowledge.payload, "OrderRegion");
    check(array.length(values) == 3, "dimension_domain: enum dimension exposes its closed domain")
        && check(array.length(region_values) == 0, "dimension_domain: open dimension exposes empty domain")
};

def check_enum_filter: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, enum_request);
    let filter_ok = match plan.filter {
        'Some('Scalar(call)) => call.function == 'Eq
            && array.length(call.args) == 2
            && is_column(get_expr(call.args, 0), "c", "tier")
            && is_bind(get_expr(call.args, 1)),
        _ => 'False,
    };
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("gold"), 'Int(2)];
    check(filter_ok, "enum filter: legal stable value becomes Eq on c.tier with a bind")
        && check(query.bindings == expected, "enum filter: bindings are the stable value and the limit")
};

def check_open_string_dimension: Bool = do {
    # OrderRegion remains an open String dimension: it has no closed value
    # domain and its filter value is still a parameterized binding.
    let plan: qb.Plan = edsl.lower(knowledge.payload, open_string_request);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("west")];
    check(query.bindings == expected, "open string dimension: filter binding stays parameterized")
};

def check_enum_determinism: Bool = do {
    let plan1: qb.Plan = edsl.lower(knowledge.payload, enum_request);
    let plan2: qb.Plan = edsl.lower(knowledge.payload, enum_request);
    let q1: qb.Query = qb.transform_sqlite(plan1);
    let q2: qb.Query = qb.transform_sqlite(plan2);
    check(plan1 == plan2, "enum determinism: repeated lowering yields identical plan")
        && check(q1.sql == q2.sql && q1.bindings == q2.bindings, "enum determinism: identical sql and bindings")
};

# ---------------------------------------------------------------------------
# Requests and checks for the closed computed-expression, pagination and
# scope capabilities.
# ---------------------------------------------------------------------------

# TraceHead is a computed dimension over t.label (first whitespace-delimited
# segment via 'Instr/'If/'Sub/'Substr) with an inherent scope on t.kind.
def trace_head_request: edsl.QueryRequest = {
    measures: [{ id: "TraceCount", subject: "analyst", input: 'All }],
    dimensions: [{ id: "TraceHead", subject: "analyst", input: 'None }],
    filters: [],
    ordering: [{ target: 'Dimension("TraceHead"), direction: 'Asc }],
    limit: 'Some(3),
    offset: 'None,
    partition: 'None,
};

# Pagination: stable deterministic ordering is required so pages repeat.
def paginated_request: edsl.QueryRequest = {
    measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
    dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
    filters: [],
    ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
    limit: 'Some(5),
    offset: 'Some(10),
    partition: 'None,
};

# Scope + user filter: the inherent scope predicate must merge before the
# user filter, deterministically, with both values parameterized.
def scope_request: edsl.QueryRequest = {
    measures: [{ id: "TraceCount", subject: "analyst", input: 'All }],
    dimensions: [{ id: "TraceHead", subject: "analyst", input: 'None }],
    filters: [{ id: "TraceOwner", subject: "analyst", op: 'Eq, input: 'Text("alice") }],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

def is_head_expr: Fn(qb.Expr) -> Bool = fn(e) {
    match e {
        'Scalar(call) => call.function == 'If && array.length(call.args) == 3,
        _ => 'False,
    }
};

# Matches Eq(column(source "t", column), Bind(value)).
def is_eq_bind: Fn(qb.Expr, String, qb.Val) -> Bool = fn(e, column, value) {
    match e {
        'Scalar(call) => call.function == 'Eq
            && array.length(call.args) == 2
            && (match get_expr(call.args, 0) {
                'Column(ref) => ref.source == "t" && ref.column == column,
                _ => 'False,
            })
            && (match get_expr(call.args, 1) { 'Bind(v) => v == value, _ => 'False }),
        _ => 'False,
    }
};

def check_computed_dimension: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, trace_head_request);
    let proj_ok = array.any(plan.projection, fn(item) {
        match item { 'Expr(e) => is_head_expr(e), 'Aggregate(_) => 'False, 'Computed(_) => 'False }
    });
    let group_ok = array.length(plan.grouping) == 1 && is_head_expr(get_expr(plan.grouping, 0));
    let order_ok = array.length(plan.ordering) == 1 && (match get_index(plan.ordering, 0).key {
        'Expr(e) => is_head_expr(e),
        'AggregateRef(_) => 'False,
    });
    let scope_ok = match plan.filter {
        'Some(f) => is_eq_bind(f, "kind", 'String("run")),
        'None => 'False,
    };
    check(proj_ok, "computed dimension: new-scalar expression in projection")
        && check(group_ok, "computed dimension: same expression in grouping")
        && check(order_ok, "computed dimension: same expression in ordering")
        && check(scope_ok, "computed dimension: inherent scope lowers to Eq on t.kind with bind")
};

def check_pagination: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, paginated_request);
    let query: qb.Query = qb.transform_sqlite(plan);
    let plan2: qb.Plan = edsl.lower(knowledge.payload, paginated_request);
    let q2: qb.Query = qb.transform_sqlite(plan2);
    let offset_ok = plan.offset == 'Some(10);
    let last_ok = match array.get(query.bindings, array.length(query.bindings) - 1) {
        'Some(v) => v == 'Int(10),
        'None => 'False,
    };
    let det_ok = plan == plan2 && query.sql == q2.sql && query.bindings == q2.bindings;
    check(offset_ok, "pagination: offset lowers to Plan.offset")
        && check(last_ok, "pagination: offset is the last ordered binding")
        && check(det_ok, "pagination: repeated lowering is byte-identical")
};

def check_scope_declared: Bool = do {
    let p = knowledge.payload;
    let head = match array.find(p.dimensions, fn(d) { d.id == "TraceHead" }) {
        'Some(d) => d,
        'None => fail!("TraceHead dimension missing"),
    };
    let scope_ok = array.length(head.scope) == 1
        && get_index(head.scope, 0).field == 1
        && get_index(head.scope, 0).op == 'Eq
        && get_index(head.scope, 0).input == 'Text("run");
    check(scope_ok, "scope: TraceHead publishes its inherent scope predicate")
};

def check_scope_merge: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, scope_request);
    let merge_ok = match plan.filter {
        'Some('Scalar(call)) => call.function == 'And
            && array.length(call.args) == 2
            && is_eq_bind(get_expr(call.args, 0), "kind", 'String("run"))
            && is_eq_bind(get_expr(call.args, 1), "owner", 'String("alice")),
        _ => 'False,
    };
    check(merge_ok, "scope: scope predicate merges before the user filter, both parameterized")
};

# ---------------------------------------------------------------------------
# Requests and checks for Top Per Group and filtered/computed measures.
# ---------------------------------------------------------------------------

# Per-region Top 2 by amount, tie-broken by the computed week dimension.
def top_per_region_request: edsl.QueryRequest = {
    measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
    dimensions: [
        { id: "OrderRegion", subject: "analyst", input: 'None },
        { id: "OrderWeek", subject: "analyst", input: 'None },
    ],
    filters: [],
    ordering: [
        { target: 'Measure("OrderAmount"), direction: 'Desc },
        { target: 'Dimension("OrderWeek"), direction: 'Asc },
    ],
    limit: 'None,
    offset: 'None,
    partition: 'Some({ by: ["OrderRegion"], take: 2 }),
};

# Filtered measures: mutually exclusive counts over the closed TraceKind domain.
def filtered_measure_request: edsl.QueryRequest = {
    measures: [
        { id: "TraceRunCount", subject: "analyst", input: 'All },
        { id: "TraceSkipCount", subject: "analyst", input: 'All },
    ],
    dimensions: [{ id: "TraceOwner", subject: "analyst", input: 'None }],
    filters: [],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

# Global filter + measure inherent predicate: the global filter stays in the
# global WHERE and the inherent predicate stays in the aggregate FILTER; they
# must not be flattened into a conflicting global AND (wrong empty set).
def filtered_with_global_request: edsl.QueryRequest = {
    measures: [{ id: "TraceRunCount", subject: "analyst", input: 'All }],
    dimensions: [{ id: "TraceOwner", subject: "analyst", input: 'None }],
    filters: [{ id: "TraceOwner", subject: "analyst", op: 'Eq, input: 'Text("alice") }],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

# Computed measures (both 'Add and 'Sub) with ordinary ordering.
def computed_measure_request: edsl.QueryRequest = {
    measures: [
        { id: "TraceTotal", subject: "analyst", input: 'All },
        { id: "TraceDelta", subject: "analyst", input: 'All },
    ],
    dimensions: [{ id: "TraceOwner", subject: "analyst", input: 'None }],
    filters: [],
    ordering: [{ target: 'Measure("TraceDelta"), direction: 'Desc }],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

# Top Per Group ordered by a computed measure.
def top_per_group_computed_request: edsl.QueryRequest = {
    measures: [{ id: "TraceDelta", subject: "analyst", input: 'All }],
    dimensions: [{ id: "TraceOwner", subject: "analyst", input: 'None }],
    filters: [],
    ordering: [{ target: 'Measure("TraceDelta"), direction: 'Desc }],
    limit: 'None,
    offset: 'None,
    partition: 'Some({ by: ["TraceOwner"], take: 2 }),
};

def is_week_expr: Fn(qb.Expr) -> Bool = fn(e) {
    match e {
        'Scalar(call) => call.function == 'Substr && array.length(call.args) == 3,
        _ => 'False,
    }
};

def aggregate_alias: Fn(qb.SelectItem, String) -> Bool = fn(item, alias) {
    match item { 'Aggregate(agg) => agg.alias == alias, _ => 'False }
};

def is_filtered_aggregate: Fn(qb.SelectItem, String) -> Bool = fn(item, alias) {
    match item {
        'Aggregate(agg) => agg.alias == alias && (match agg.filter {
            'Some('Scalar(call)) => call.function == 'Eq
                && array.length(call.args) == 2
                && is_column(get_expr(call.args, 0), "t", "kind")
                && is_bind(get_expr(call.args, 1)),
            _ => 'False,
        }),
        _ => 'False,
    }
};

def check_top_per_group: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, top_per_region_request);
    let part_ok = match plan.partition {
        'Some(p) => array.length(p.partition_by) == 1
            && is_column(get_expr(p.partition_by, 0), "o", "region")
            && array.length(p.order_by) == 2
            && (match get_index(p.order_by, 0).key {
                'AggregateRef(ref) => ref.alias == "OrderAmount",
                _ => 'False,
            })
            && (match get_index(p.order_by, 0).direction { 'Desc => 'True, 'Asc => 'False })
            && (match get_index(p.order_by, 1).key {
                'Expr(e) => is_week_expr(e),
                _ => 'False,
            })
            && p.take == 2,
        'None => 'False,
    };
    let global_ok = array.length(plan.ordering) == 0 && plan.limit == 'None && plan.offset == 'None;
    let query: qb.Query = qb.transform_sqlite(plan);
    check(part_ok, "top per group: per-region top 2 lowers to Plan.partition with stable order_by")
        && check(global_ok, "top per group: no global ordering/limit/offset is combined")
};

def check_filtered_measure: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, filtered_measure_request);
    let has_run = array.any(plan.projection, fn(item) { is_filtered_aggregate(item, "TraceRunCount") });
    let has_skip = array.any(plan.projection, fn(item) { is_filtered_aggregate(item, "TraceSkipCount") });
    let query: qb.Query = qb.transform_sqlite(plan);
    check(has_run && has_skip, "filtered measure: inherent predicate lowers to FILTER on each aggregate")
};

def check_filtered_global_separation: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, filtered_with_global_request);
    let global_ok = match plan.filter {
        'Some(f) => is_eq_bind(f, "owner", 'String("alice")),
        'None => 'False,
    };
    let filtered_ok = array.any(plan.projection, fn(item) { is_filtered_aggregate(item, "TraceRunCount") });
    let query: qb.Query = qb.transform_sqlite(plan);
    check(global_ok, "filtered measure: global filter stays a single global Eq on the user filter")
        && check(filtered_ok, "filtered measure: inherent predicate stays in the aggregate FILTER, not merged")
};

# Non-Timeline domain proof: approval-status conditional counts and their
# Add/Sub composition go through the same public filtered/computed lowering path
# (the capability is not keyed to Trace/EventType names or data shapes).
def approval_request: edsl.QueryRequest = {
    measures: [
        { id: "ApprovalApprovedCount", subject: "analyst", input: 'All },
        { id: "ApprovalRejectedCount", subject: "analyst", input: 'All },
        { id: "ApprovalNet", subject: "analyst", input: 'All },
        { id: "ApprovalTotal", subject: "analyst", input: 'All },
    ],
    dimensions: [{ id: "ApprovalStatus", subject: "analyst", input: 'None }],
    filters: [],
    ordering: [{ target: 'Measure("ApprovalNet"), direction: 'Desc }],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

def check_non_timeline_measures: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, approval_request);
    let approved_ok = array.any(plan.projection, fn(item) {
        match item {
            'Aggregate(agg) => agg.alias == "ApprovalApprovedCount" && (match agg.filter {
                'Some('Scalar(call)) => call.function == 'Eq
                    && array.length(call.args) == 2
                    && is_column(get_expr(call.args, 0), "a", "status")
                    && (match get_expr(call.args, 1) { 'Bind('String("approved")) => 'True, _ => 'False }),
                _ => 'False,
            }),
            _ => 'False,
        }
    });
    let net_ok = array.any(plan.projection, fn(item) {
        match item { 'Computed(c) => c.alias == "ApprovalNet" && c.op == 'Sub && c.left == "ApprovalApprovedCount" && c.right == "ApprovalRejectedCount", _ => 'False }
    });
    let total_ok = array.any(plan.projection, fn(item) {
        match item { 'Computed(c) => c.alias == "ApprovalTotal" && c.op == 'Add && c.left == "ApprovalApprovedCount" && c.right == "ApprovalRejectedCount", _ => 'False }
    });
    let order_ok = array.length(plan.ordering) == 1 && (match get_index(plan.ordering, 0).key {
        'AggregateRef(ref) => ref.alias == "ApprovalNet",
        _ => 'False,
    });
    let query: qb.Query = qb.transform_sqlite(plan);
    check(approved_ok, "non-timeline: approval approved count lowers with its inherent FILTER")
        && check(net_ok && total_ok, "non-timeline: approval net (Sub) and total (Add) lower through the public path")
        && check(order_ok, "non-timeline: approval computed measure participates in ordering")
};

# ---------------------------------------------------------------------------
# Requests and checks for JSON-backed dimensions.
# ---------------------------------------------------------------------------

# DeviceChannel = $.channel (top-level) and DeviceRetryCount = $.retry.count
# (nested). Requests only carry the business ids; the paths stay bindings.
def json_request: edsl.QueryRequest = {
    measures: [{ id: "DeviceCount", subject: "analyst", input: 'All }],
    dimensions: [
        { id: "DeviceChannel", subject: "analyst", input: 'None },
        { id: "DeviceRetryCount", subject: "analyst", input: 'None },
    ],
    filters: [{ id: "DeviceChannel", subject: "analyst", op: 'Eq, input: 'Text("api") }],
    ordering: [{ target: 'Dimension("DeviceRetryCount"), direction: 'Desc }],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

# JSON dimension as a stable partition ordering tie-breaker.
def json_top_per_group_request: edsl.QueryRequest = {
    measures: [{ id: "DeviceCount", subject: "analyst", input: 'All }],
    dimensions: [
        { id: "DeviceOwner", subject: "analyst", input: 'None },
        { id: "DeviceChannel", subject: "analyst", input: 'None },
    ],
    filters: [],
    ordering: [
        { target: 'Measure("DeviceCount"), direction: 'Desc },
        { target: 'Dimension("DeviceChannel"), direction: 'Asc },
    ],
    limit: 'None,
    offset: 'None,
    partition: 'Some({ by: ["DeviceOwner"], take: 2 }),
};

def is_json_extract: Fn(qb.Expr, String) -> Bool = fn(e, path) {
    match e {
        'Scalar(call) => call.function == 'JsonExtract
            && array.length(call.args) == 2
            && (match get_expr(call.args, 0) {
                'Column(ref) => ref.source == "d" && ref.column == "attributes_json",
                _ => 'False,
            })
            && (match get_expr(call.args, 1) { 'Bind('String(p)) => p == path, _ => 'False }),
        _ => 'False,
    }
};

def check_json_dimension: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, json_request);
    let proj_channel = array.any(plan.projection, fn(item) {
        match item { 'Expr(e) => is_json_extract(e, "$.channel"), _ => 'False }
    });
    let proj_retry = array.any(plan.projection, fn(item) {
        match item { 'Expr(e) => is_json_extract(e, "$.retry.count"), _ => 'False }
    });
    let group_ok = array.length(plan.grouping) == 2
        && is_json_extract(get_expr(plan.grouping, 0), "$.channel")
        && is_json_extract(get_expr(plan.grouping, 1), "$.retry.count");
    let filter_ok = match plan.filter {
        'Some('Scalar(call)) => call.function == 'Eq
            && array.length(call.args) == 2
            && is_json_extract(get_expr(call.args, 0), "$.channel")
            && (match get_expr(call.args, 1) { 'Bind('String("api")) => 'True, _ => 'False }),
        _ => 'False,
    };
    let order_ok = array.length(plan.ordering) == 1
        && (match get_index(plan.ordering, 0).key {
            'Expr(e) => is_json_extract(e, "$.retry.count"),
            _ => 'False,
        })
        && (match get_index(plan.ordering, 0).direction { 'Desc => 'True, 'Asc => 'False });
    let query: qb.Query = qb.transform_sqlite(plan);
    check(proj_channel && proj_retry, "json dimension: top-level and nested paths in projection")
        && check(group_ok, "json dimension: paths in grouping")
        && check(filter_ok, "json dimension: parameterized filter on a declared path")
        && check(order_ok, "json dimension: stable ordering on a nested path")
};

def check_json_top_per_group: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, json_top_per_group_request);
    let part_ok = match plan.partition {
        'Some(p) => array.length(p.order_by) == 2
            && (match get_index(p.order_by, 0).key {
                'AggregateRef(ref) => ref.alias == "DeviceCount",
                _ => 'False,
            })
            && (match get_index(p.order_by, 1).key {
                'Expr(e) => is_json_extract(e, "$.channel"),
                _ => 'False,
            })
            && p.take == 2,
        'None => 'False,
    };
    let query: qb.Query = qb.transform_sqlite(plan);
    check(part_ok, "json dimension: path as a stable partition ordering tie-breaker")
};

def check_computed_measure: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, computed_measure_request);
    let deps_projected = array.any(plan.projection, fn(item) { aggregate_alias(item, "TraceRunCount") })
        && array.any(plan.projection, fn(item) { aggregate_alias(item, "TraceSkipCount") });
    let add_ok = array.any(plan.projection, fn(item) {
        match item {
            'Computed(c) => c.op == 'Add && c.left == "TraceRunCount" && c.right == "TraceSkipCount" && c.alias == "TraceTotal",
            _ => 'False,
        }
    });
    let sub_ok = array.any(plan.projection, fn(item) {
        match item {
            'Computed(c) => c.op == 'Sub && c.left == "TraceRunCount" && c.right == "TraceSkipCount" && c.alias == "TraceDelta",
            _ => 'False,
        }
    });
    let order_ok = array.length(plan.ordering) == 1 && (match get_index(plan.ordering, 0).key {
        'AggregateRef(ref) => ref.alias == "TraceDelta",
        _ => 'False,
    });
    check(deps_projected, "computed measure: dependencies are projected")
        && check(add_ok && sub_ok, "computed measure: both 'Add and 'Sub lower over the dependency aliases")
        && check(order_ok, "computed measure: computed measure participates in ordinary ordering")
};

def check_top_per_group_computed: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, top_per_group_computed_request);
    let computed_projected = array.any(plan.projection, fn(item) {
        match item { 'Computed(c) => c.alias == "TraceDelta", _ => 'False }
    });
    let part_ok = match plan.partition {
        'Some(p) => array.length(p.order_by) == 1
            && (match get_index(p.order_by, 0).key {
                'AggregateRef(ref) => ref.alias == "TraceDelta",
                _ => 'False,
            })
            && p.take == 2,
        'None => 'False,
    };
    check(computed_projected && part_ok, "top per group: computed measure is a stable partition ordering target")
};

# ---------------------------------------------------------------------------
# Next-round capabilities: measureless row lists, text search ops, HAVING and
# grain-preserving existence filters.
# ---------------------------------------------------------------------------

def is_expr_item: Fn(qb.SelectItem) -> Bool = fn(item) {
    match item { 'Expr(_) => 'True, 'Aggregate(_) => 'False, 'Computed(_) => 'False }
};

# Measureless row-level projection: a list request over dimensions (no fictional
# COUNT measure), lowerable to an ungrouped Plan with a parameterized filter.
def check_row_level_list: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
            { id: "CustomerTier", subject: "analyst", input: 'None },
        ],
        filters: [
            { id: "OrderRegion", subject: "analyst", op: 'Contains, input: 'Text("EAST") },
        ],
        ordering: [
            { target: 'Dimension("OrderRegion"), direction: 'Asc },
        ],
        limit: 'Some(25),
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let no_group = array.length(plan.grouping) == 0;
    let has_join = array.length(plan.joins) == 1;
    let only_exprs = array.all(plan.projection, fn(i) { is_expr_item(i) });
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("EAST"), 'Int(0), 'Int(25)];
    check(no_group && has_join && only_exprs, "measureless row list: ungrouped projection over a safe join")
        && check(query.bindings == expected, "measureless row list: contains keeps parameterized bindings and limit")
};

# Closed text search operations lower through the query 'Instr/'Lower/'Length/
# 'Substr vocabulary; runtime values never enter SQL text.
def text_op_query: Fn(edsl.FilterOp, String) -> qb.Query = fn(op, text) {
    let request: edsl.QueryRequest = {
        measures: [],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [{ id: "OrderRegion", subject: "analyst", op: op, input: 'Text(text) }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    qb.transform_sqlite(plan)
};

def check_text_search_ops: Bool = do {
    let starts = text_op_query('StartsWith, "nor");
    let contains = text_op_query('Contains, "east");
    let notc = text_op_query('NotContains, "zzz");
    let ends = text_op_query('EndsWith, "th");
    let shapes_ok = string.contains(starts.sql, "instr(lower(o.region), lower(?)) = ?")
        && string.contains(contains.sql, "instr(lower(o.region), lower(?)) > ?")
        && string.contains(notc.sql, "instr(o.region, ?) = ?")
        && string.contains(ends.sql, "substr(lower(o.region)");
    let starts_b: Array(qb.Val) = ['String("nor"), 'Int(1)];
    let contains_b: Array(qb.Val) = ['String("east"), 'Int(0)];
    let notc_b: Array(qb.Val) = ['String("zzz"), 'Int(0)];
    let ends_b: Array(qb.Val) = ['String("th"), 'Int(1), 'String("th")];
    check(shapes_ok, "text search ops: starts-with/contains/not-contains/ends-with lower to closed expressions")
        && check(starts.bindings == starts_b, "text search ops: starts-with binds value then position")
        && check(contains.bindings == contains_b, "text search ops: contains binds value then zero")
        && check(notc.bindings == notc_b, "text search ops: not-contains binds value then zero")
        && check(ends.bindings == ends_b, "text search ops: ends-with binds the value twice and the computed start")
};

# Typed HAVING over a selected measure lowers to the query aggregate predicate;
# the threshold stays a parameterized binding.
def check_having: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let having: edsl.HavingRequest = {
        measure: "OrderAmount",
        subject: "analyst",
        op: 'Ge,
        threshold: 'Number(100.0),
    };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [], [having]);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected_h: Array(qb.Val) = ['Float(100.0)];
    check(array.length(plan.having) == 1, "having: aggregate-result predicate is lowered")
        && check(query.bindings == expected_h, "having: threshold enters ordered bindings")
};

# Grain-preserving existence filter: a fan-out-only required entity is satisfied
# by the correlated EXISTS predicate instead of a fan-out join, so the subject
# measure is not amplified.
def check_exists: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "CustomerCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let exists: edsl.ExistsRequest = { target: "orders", subject: "analyst", filters: [], any_of: [], min_matches: 'None };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [exists], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    check(array.length(plan.exists) == 1 && array.length(plan.joins) == 0,
        "exists: fan-out requirement becomes a correlated EXISTS without a fan-out join")
        && check(string.contains(query.sql, "EXISTS (SELECT 1 FROM orders AS o WHERE c.id = o.customer_id)"),
            "exists: correlated existence predicate keeps the customer grain")
};

# Parent -> Child: ParentCount plus a minimum-match existence never joins the
# fan-out child edge, so the parent count is not amplified by child rows.
def check_parent_grain: Bool = do {
    let base: edsl.QueryRequest = {
        measures: [{ id: "ParentCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plain: qb.Plan = edsl.lower(knowledge.payload, base);
    let exists: edsl.ExistsRequest = { target: "children", subject: "analyst", filters: [], any_of: [], min_matches: 'Some(2) };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, base, [exists], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['Int(2)];
    check(array.length(plain.joins) == 0 && array.length(plan.joins) == 0,
        "parent grain: ParentCount never joins the fan-out child edge")
        && check(string.contains(query.sql, "GROUP BY k.parent_id HAVING count(k.id) >= ?")
            && array.length(plan.grouping) == 0,
            "parent grain: correlated aggregate existence keeps an ungrouped parent count")
        && check(query.bindings == expected, "parent grain: minimum match threshold is parameterized")
};

# Nested shape 1: count of groups satisfying HAVING.
def check_group_count: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let having: edsl.HavingRequest = {
        measure: "OrderAmount",
        subject: "analyst",
        op: 'Ge,
        threshold: 'Number(100.0),
    };
    let query: qb.Query = edsl.lower_group_count(knowledge.payload, request, [having]);
    let expected: Array(qb.Val) = ['Float(100.0)];
    check(string.contains(query.sql, "count(1) FROM (SELECT"), "group count: lowers to count(1) over the inner query")
        && check(query.bindings == expected, "group count: HAVING threshold is the only binding")
};

# Closed OR-group on the subject filter lowers to one inner Or; the dimension's
# entity is joined safely (Order -> Customer) and the values keep request order.
def check_any_of: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let any: edsl.AnyOfRequest = { id: "CustomerTier", subject: "analyst", values: ['Text("gold"), 'Text("silver")] };
    let plan: qb.Plan = edsl.lower_any(knowledge.payload, request, [any], [], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("gold"), 'String("silver")];
    check(array.length(plan.joins) == 1 && query.bindings == expected,
        "any-of: OR-group joins its dimension entity safely and binds values in order")
        && check(string.contains(query.sql, "(c.tier = ? OR c.tier = ?)"),
            "any-of: one dimension OR-group lowers to a single Or over equalities")
};

# ---------------------------------------------------------------------------
# Bounded two-hop correlated existence (ontology foundation feedback).
#
# Component -> Site (unique grain-safe owner) -> Alarm is declared explicitly
# with @edsl.exists_route(Site, Alarm). Lowering must add only the grain-safe
# owner join and a correlated EXISTS over the target: no outer fan-out join
# that would amplify the component grain.
# ---------------------------------------------------------------------------

def entity_id_index: Fn(Array(edsl.EntityEntry), String) -> Int = fn(entities, id) {
    match array.find(entities, fn(e) { e.id == id }) {
        'Some(e) => e.index,
        'None => -1,
    }
};

def component_base_request: edsl.QueryRequest = {
    measures: [{ id: "ComponentCount", subject: "analyst", input: 'All }],
    dimensions: [],
    filters: [],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

def alarm_exists_spec: edsl.ExistsRequest = {
    target: "alarms",
    subject: "analyst",
    filters: [],
    any_of: [],
    min_matches: 'None,
};

def alarm_min_exists_spec: edsl.ExistsRequest = {
    target: "alarms",
    subject: "analyst",
    filters: [],
    any_of: [],
    min_matches: 'Some(2),
};

def alarm_filtered_exists_spec: edsl.ExistsRequest = {
    target: "alarms",
    subject: "analyst",
    filters: [{ id: "AlarmLevel", subject: "analyst", op: 'Eq, input: 'Int(3) }],
    any_of: [],
    min_matches: 'None,
};

def check_knowledge_route_prepared: Bool = do {
    let p = knowledge.payload;
    let component = entity_id_index(p.entities, "components");
    let alarms = entity_id_index(p.entities, "alarms");
    let route_ok = array.any(p.routes, fn(r) { r.base == component && r.target == alarms });
    check(route_ok, "two-hop: prepared payload stores the declared Component -> Site -> Alarm route")
        && check(array.length(p.routes) == 1, "two-hop: exactly one correlated-existence route is declared")
};

def check_two_hop_forward_exists: Bool = do {
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, component_base_request, [alarm_exists_spec], []);
    let join_shape = if array.length(plan.joins) == 1 {
        let join = get_index(plan.joins, 0);
        let kind_ok = match join.kind { 'Inner => 'True, 'Left => 'False };
        let source_ok = join.source.alias == "s" && join.source.table == "sites";
        let cond_ok = match join.condition {
            'Eq(eq) => eq.left.source == "m" && eq.left.column == "site_id"
                && eq.right.source == "s" && eq.right.column == "id",
            _ => 'False,
        };
        kind_ok && source_ok && cond_ok
    } else {
        'False
    };
    let exists_count = array.length(plan.exists) == 1;
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected_sql = "SELECT count(m.id) AS ComponentCount FROM components AS m INNER JOIN sites AS s ON m.site_id = s.id WHERE EXISTS (SELECT 1 FROM alarms AS al WHERE s.id = al.site_id)";
    check(join_shape && exists_count, "two-hop: base->site inner join plus one correlated EXISTS")
        && check(query.sql == expected_sql, "two-hop: SQL keeps the base grain via owner join and EXISTS")
        && check(array.length(query.bindings) == 0, "two-hop: no bindings when there are no dynamic values")
};

def check_two_hop_grain_not_amplified: Bool = do {
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, component_base_request, [alarm_exists_spec], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    check(string.contains(query.sql, "FROM components AS m INNER JOIN sites AS s ON m.site_id = s.id"),
        "two-hop: only the grain-safe owner join is emitted")
        && check(!string.contains(query.sql, "JOIN alarms"), "two-hop: the Site->Alarm fan-out edge is never joined")
        && check(string.contains(query.sql, "WHERE EXISTS (SELECT 1 FROM alarms AS al WHERE s.id = al.site_id)"),
            "two-hop: existence is a correlated predicate, not a row-multiplying join")
};

def check_two_hop_min_matches: Bool = do {
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, component_base_request, [alarm_min_exists_spec], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['Int(2)];
    check(string.contains(query.sql, "GROUP BY al.site_id HAVING count(al.id) >= ?"),
        "two-hop min_matches: correlated aggregate EXISTS over the owner-correlated group")
        && check(query.bindings == expected, "two-hop min_matches: threshold enters ordered bindings")
};

def check_two_hop_filter_bindings_and_determinism: Bool = do {
    let q1: qb.Query = qb.transform_sqlite(edsl.lower_full(knowledge.payload, component_base_request, [alarm_filtered_exists_spec], []));
    let q2: qb.Query = qb.transform_sqlite(edsl.lower_full(knowledge.payload, component_base_request, [alarm_filtered_exists_spec], []));
    let expected: Array(qb.Val) = ['Int(3)];
    check(string.contains(q1.sql, "AND al.level = ?"), "two-hop inner filter: dynamic value stays a bind")
        && check(q1.bindings == expected, "two-hop inner filter: binding order is deterministic")
        && check(q1.sql == q2.sql && q1.bindings == q2.bindings, "two-hop: repeated lowering is byte-identical")
};

def check_correlation_feasible: Bool = do {
    let p = knowledge.payload;
    check(edsl.correlation_feasible(p, "components", "alarms"), "feasible: declared two-hop route")
        && check(edsl.correlation_feasible(p, "components", "sites"), "feasible: one-hop owner target")
        && check(!edsl.correlation_feasible(p, "components", "customers"), "infeasible: unrelated target")
        && check(!edsl.correlation_feasible(p, "components", "components"), "infeasible: self target")
        && check(!edsl.correlation_feasible(p, "ghost", "alarms"), "infeasible: unknown base")
        && check(!edsl.correlation_feasible(p, "components", "ghost"), "infeasible: unknown target")
};

def check_exists_inner_filter_target: Bool = do {
    let p = knowledge.payload;
    let alarms = entity_id_index(p.entities, "alarms");
    let on_target = edsl.filters_on_entity(p, alarms, [
        { id: "AlarmLevel", subject: "analyst", op: 'Eq, input: 'Int(3) },
    ]);
    let off_target = edsl.filters_on_entity(p, alarms, [
        { id: "OrderRegion", subject: "analyst", op: 'Eq, input: 'Text("east") },
    ]);
    check(on_target, "exists inner filter on the path end entity is accepted")
        && check(!off_target, "exists inner filter reaching beyond the path end is rejected")
};

