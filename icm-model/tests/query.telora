export def test_request_scoped_time_authorization = do {
    let bounds: Array(facade.DirectBoundSpec) = [
        {dimension: "ServerKpiTime", value: "2026-08-01 00:00:00"},
        {dimension: "ServerKpiTime", value: "2026-08-08 00:00:00"},
    ];
    let direct_pair: Array(edsl.FilterRequest) = [
        time_filter_ge("2026-08-01 00:00:00"),
        time_filter_lt("2026-08-08 00:00:00"),
    ];
    # Authorized direct pair with declared bounds.
    let _a1: Bool = if facade.time_filters_authorized(direct_pair, 'Some(bounds)) {
        'True
    } else {
        fail!("declared direct bounds must authorize matching direct time filters")
    };
    # Without request-scoped direct bounds the same time filters must NOT pass.
    let _a2: Bool = if facade.time_filters_authorized(direct_pair, 'None) == 'False {
        'True
    } else {
        fail!("time filters must not compile without Host-declared direct bounds")
    };
    # A mismatched (fabricated) bound must not pass.
    let forged_pair: Array(edsl.FilterRequest) = [
        time_filter_ge("2026-08-01 00:00:00"),
        time_filter_lt("2026-08-09 00:00:00"),
    ];
    let _a3: Bool = if facade.time_filters_authorized(forged_pair, 'Some(bounds)) == 'False {
        'True
    } else {
        fail!("fabricated absolute bound must not be authorized")
    };
    # A request without time conditions is unaffected by a missing context.
    let _a4: Bool = if facade.time_context_authorized(no_time_intent, 'None, 'None) {
        'True
    } else {
        fail!("non-time request must be unaffected by a missing time context")
    };
    # Relative window requires the trusted report reference even with direct bounds.
    let rel: facade.Intent = time_window_intent('FixedWindow, 'Some("2026-08-08 00:00:00"));
    let _a5: Bool = if facade.time_context_authorized(rel, 'None, 'Some(bounds)) == 'False {
        'True
    } else {
        fail!("relative window must require the trusted report reference")
    };
    let _a6: Bool = if facade.time_context_authorized(rel, 'Some("2026-08-08 00:00:00"), 'Some(bounds)) {
        'True
    } else {
        fail!("relative window with matching trusted reference must be authorized")
    };
    # A 'Direct window needs both bounds declared as direct input.
    let direct_win: facade.Intent = time_window_intent('Direct, 'None);
    let _a7: Bool = if facade.time_context_authorized(direct_win, 'None, 'Some(bounds)) {
        'True
    } else {
        fail!("Direct window with both bounds declared must be authorized")
    };
    let _a8: Bool = if facade.time_context_authorized(direct_win, 'None, 'None) == 'False {
        'True
    } else {
        fail!("Direct window must not compile without declared direct bounds")
    };
    'True
};
