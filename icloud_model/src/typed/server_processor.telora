use super::classifications as classes;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("ServerProcessor")
type ServerProcessorById = struct(ComponentId);
type SlotId = struct(Int);
@domain::subject("ServerProcessor", "source_id")
@domain::dataset("source_PhysicalServerProcessor", "PhysicalServerProcessor", ["source_id"])
@domain::relations(relations)
type PhysicalServerProcessor = struct {
    @m::column("tenantId")
    @g::exact("source_PhysicalServerProcessor__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("id")
    @g::exact("source_PhysicalServerProcessor__id")
    source_id: ServerProcessorById,
    @m::column("slotId")
    @g::field_view(
        g::dimension_group(
            "source_PhysicalServerProcessor__slotId",
            SlotId.type,
            True,
            g::numeric_filters
        ),
        "source_PhysicalServerProcessor__slotId",
        True,
        g::numeric_filters
    )
    source_slotId: SlotId,
    @m::column("frequency")
    @g::exact("source_PhysicalServerProcessor__frequency_raw")
    @v::map_or(
        ProcessorFrequencyAvailability.type,
        "source_PhysicalServerProcessor__frequency",
        [v::member(ProcessorFrequencyAvailability::Unavailable, [-1])],
        ProcessorFrequencyAvailability::Unknown
    )
    source_frequency: Int,
    @m::column("model")
    @g::search("source_PhysicalServerProcessor__model")
    source_model: String,
    @m::column("manufacturer")
    @g::search("source_PhysicalServerProcessor__manufacturer")
    source_manufacturer: String,
    @m::column("processorType")
    @g::exact("source_PhysicalServerProcessor__processorType_raw")
    @v::map_or(
        classes::ProcessorKind.type,
        "source_PhysicalServerProcessor__processorType",
        [
            v::member(classes::ProcessorKind::GeneralCompute, ["通用计算"]),
            v::member(classes::ProcessorKind::HighDensityCompute, ["高密计算"])
        ],
        classes::ProcessorKind::Unknown
    )
    source_processorType: String,
    @m::column("processorId")
    @g::exact("source_PhysicalServerProcessor__processorId")
    source_processorId: String,
    @m::column("parentResId")
    @g::exact("source_PhysicalServerProcessor__parentResId")
    source_parentResId: domain::Reference(server::ServerByOriginId),
    @m::column("operStatus")
    @g::exact("source_PhysicalServerProcessor__operStatus_raw")
    @v::map(
        SourcePhysicalServerProcessorOperStatus.type,
        "source_PhysicalServerProcessor__operStatus",
        [
            v::member(SourcePhysicalServerProcessorOperStatus::Normal, ["0"]),
            v::member(SourcePhysicalServerProcessorOperStatus::Warning, ["1"]),
            v::member(SourcePhysicalServerProcessorOperStatus::Minor, ["2"]),
            v::member(SourcePhysicalServerProcessorOperStatus::Major, ["3"]),
            v::member(SourcePhysicalServerProcessorOperStatus::Critical, ["4"]),
            v::member(SourcePhysicalServerProcessorOperStatus::Error, ["-1"]),
            v::member(SourcePhysicalServerProcessorOperStatus::Unknown, ["-2"])
        ]
    )
    source_operStatus: String,
    @m::column("adminStatus")
    @g::exact("source_PhysicalServerProcessor__adminStatus_raw")
    @v::map(
        SourcePhysicalServerProcessorAdminStatus.type,
        "source_PhysicalServerProcessor__adminStatus",
        [
            v::member(SourcePhysicalServerProcessorAdminStatus::Unknown, ["0", "-1"]),
            v::member(SourcePhysicalServerProcessorAdminStatus::Enabled, ["1"]),
            v::member(SourcePhysicalServerProcessorAdminStatus::Disabled, ["2"])
        ]
    )
    source_adminStatus: String,
    @m::column("name")
    @g::search("source_PhysicalServerProcessor__name")
    source_name: String,
    @m::column("projectId")
    @g::exact("source_PhysicalServerProcessor__projectId")
    source_projectId: String,
    @m::column("serialNumber")
    @g::search("source_PhysicalServerProcessor__serialNumber")
    source_serialNumber: String,
};

def subject: r::Endpoint = domain::endpoint(PhysicalServerProcessor.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(PhysicalServerProcessor.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(PhysicalServerProcessor.type, "source_parentResId");

type ProcessorFrequencyAvailability = enum {
    Unavailable,
    Unknown,
};

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerProcessorOperStatus = enum {
    @ev::description("normal", "正常")
    Normal,

    @ev::description("warning", "警告")
    Warning,

    @ev::description("minor", "一般")
    Minor,

    @ev::description("major", "严重")
    Major,

    @ev::description("critical", "紧急")
    Critical,

    @ev::description("error", "错误")
    Error,

    @ev::description("unknown", "未知")
    Unknown,
};

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerProcessorAdminStatus = enum {
    @ev::description("unknown", "未知")
    Unknown,

    @ev::description("enabled", "已启用")
    Enabled,

    @ev::description("disabled", "未启用")
    Disabled,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_PhysicalServer_PhysicalServerProcessor",
        server::origin,
        parent,
        cardinality
    ),
    r::relation(
        "source_PhysicalServerProcessor_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerProcessor, ServerProcessorById};

pub use self::{
    ProcessorFrequencyAvailability,
    SourcePhysicalServerProcessorOperStatus,
    SourcePhysicalServerProcessorAdminStatus
};
