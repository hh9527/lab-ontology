# ---------------------------------------------------------------------------
# Provider factories (used as decorators by the knowledge author).
# ---------------------------------------------------------------------------
def column: Fn(String) -> Fn(property::FieldPropertyCtx, Option(ColumnMap)) -> ColumnMap = fn(
    column
) {
    contract::publish_name(column);
    fn(ctx, previous) {
        let result: ColumnMap = {column};
        result
    }
};

def measure_description: Fn(
    String,
    String,
    String
) -> Fn(property::FieldPropertyCtx, Option(MeasureDescriptions)) -> MeasureDescriptions = fn(
    id,
    label,
    summary
) {
    fn(ctx, previous) {
        let note: MeasureNote = {id, label, summary};
        {
            notes: match previous {
                Some(existing) => array::push(existing.notes, note),
                None => [note],
            }
        }
    }
};

def dimension_description: Fn(
    String,
    String,
    String
) -> Fn(property::FieldPropertyCtx, Option(DimensionDescriptions)) -> DimensionDescriptions = fn(
    id,
    label,
    summary
) {
    fn(ctx, previous) {
        let note: DimensionNote = {id, label, summary};
        {
            notes: match previous {
                Some(existing) => array::push(existing.notes, note),
                None => [note],
            }
        }
    }
};

