        knowledge::DocResult::Found(point) => match point.dimension {
            Some(detail) => if array::any(detail.ops, fn(op) { op == edsl::FilterOp::Contains })
                && array::any(detail.ops, fn(op) { op == edsl::FilterOp::NotContains }) { True }
            else { fail!("port containment operations are not discoverable", point) },
            None => fail!("port dimension has no detail"),
        },
        other => fail!("port dimension is undiscoverable", other),
    }
});

pub def port_operational_state_and_device_path_are_discoverable: test::Test = test::should_ok(fn() {
    let status: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
        owner: "port", id: "port_oper_status"};
    let owner: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "port", id: "port_belongs_to_device"};
    let response = knowledge::knowledge_info_method_factory(payload)(
        key_input(edsl::KnowledgeKind::Dataset, "", "port"));
    match checked_response(response) {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if array::any(point.refs, fn(ref) { ref.target == status })
                && array::any(point.refs, fn(ref) { ref.target == owner }) { True }
            else { fail!("port knowledge lost its status or device ownership", point) },
        other => fail!("port topic cannot be discovered", other),
    }
});

pub def physical_link_discloses_server_participation_separately_from_network_device: test::Test = test::should_ok(fn() {
    let link: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "physical_link"};
    let server: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "physical_link", id: "physical_link_attached_server"};
    let device: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "physical_link", id: "physical_link_attached_device"};
    match lookup(link) {
        knowledge::DocResult::Found(point) => if array::any(point.refs, fn(ref) { ref.target == server })
            && array::any(point.refs, fn(ref) { ref.target == device }) {
            match lookup(server) {
                knowledge::DocResult::Found(relation) => if relation.relation != None { True }
                    else { fail!("server participation lacks relation detail") },
                other => fail!("server participation relation is undiscoverable", other),
            }
        } else { fail!("physical link lacks either declared participant relation") },
        other => fail!("physical-link dataset is undiscoverable", other),
    }
});

pub def undirected_peer_discloses_its_bidirectional_hub_guard: test::Test = test::should_ok(fn() {
    let target: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::BusinessLink,
        owner: "physical_link", id: "physical_link_peer_device"};
    match lookup(target) {
        knowledge::DocResult::Found(point) => match point.guard {
            Some(pred) => if pred.field == "direction" && pred.op == edsl::FilterOp::Eq
                && pred.input == edsl::FilterInput::Text("bidirectional")
                && array::any(point.refs, fn(ref) { ref.target.kind == edsl::KnowledgeKind::Field
                    && ref.target.owner == "physical_link" && ref.target.id == "direction" }) { True }
            else { fail!("peer knowledge lost bidirectional hub guard", point) },
            None => fail!("peer knowledge does not disclose its direction guard"),
        },
        other => fail!("bidirectional peer link is undiscoverable", other),
    }
});

pub def peer_topic_doc_exposes_direction_guard: test::Test = test::should_ok(fn() {
    let document = knowledge::knowledge_info_method_factory(payload)(
        key_input(edsl::KnowledgeKind::BusinessLink, "physical_link", "physical_link_peer_device"));
    match checked_response(document) {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if point.target.kind == edsl::KnowledgeKind::BusinessLink
                && point.target.owner == "physical_link"
                && point.guard == Some({field: "direction", op: edsl::FilterOp::Eq,
                    input: edsl::FilterInput::Text("bidirectional")}) { True }
            else { fail!("peer topic lost the guarded business link", point) },
        other => fail!("peer topic did not resolve to its guarded knowledge point", other),
    }
});

pub def downstream_topic_doc_exposes_one_way_guard: test::Test = test::should_ok(fn() {
    let document = knowledge::knowledge_info_method_factory(payload)(
