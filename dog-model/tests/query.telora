def test_ranked_output_order_parent_first_desc = do {
    let intent = json.parse(r#"{
        "op": "ranked", "measures": [],
        "dimensions": ["DogName", "OwnerFirstName"],
        "filters": [], "ordering": [], "exists": [], "having": [],
        "output_order": ["OwnerFirstName", "DogName"],
        "ranked": [
            {"attribute": "DogOwnerId", "op": "eq", "group": "DogOwnerId", "measure": "DogCount", "direction": "Desc", "scope": []}
        ],
        "limit": null, "offset": null
    }"#) |> result.unwrap;
    check_sql("ranked-output-order-parent-first-desc", intent,
        "SELECT ow.first_name, dg.name FROM Dogs AS dg INNER JOIN Owners AS ow ON dg.owner_id = ow.owner_id WHERE dg.owner_id = (SELECT dg.owner_id FROM Dogs AS dg GROUP BY dg.owner_id ORDER BY count(dg.dog_id) DESC LIMIT 1)")
};

