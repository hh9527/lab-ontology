use std::array as array;
# 类型自身声明知识导航策略；不按物理表示继承。
use std::type_desc as td;
use std::prelude as prelude;
use std::type_property as property;

@prelude::property(PropertyTarget::Type)
type ReverseReferences = struct {
    allowed: Bool
};
# 记录默认属于其使用位置；独立领域记录显式声明知识身份。
@prelude::property(PropertyTarget::Type)
type IndependentType = struct {};
@prelude::property(PropertyTarget::Type)
type TypeConstructor = struct {
    name: String
};
def constructor: Fn(String) -> Fn(Type, Option(TypeConstructor)) -> TypeConstructor = fn(name) {
    fn(ctx, previous) {
        {name}
    }
};
def constructor_name: Fn(Type) -> Option(String) = fn(ty) {
    match property::get_type_prop(ty, TypeConstructor.type) {
        Some(info) => Some(info.name),
        None => None
    }
};
def independent_type: Fn() -> Fn(td::TypeDesc, Option(IndependentType)) -> IndependentType = fn() {
    fn(ctx, previous) {
        {}
    }
};
def is_independent_record: Fn(Type) -> Bool = fn(ty) {
    property::get_type_prop(ty, IndependentType.type) != None
};
def reverse_references: Fn(Bool) -> Fn(td::TypeDesc, Option(ReverseReferences)) -> ReverseReferences = fn(
    allowed
) {
    fn(ctx, previous) {
        {allowed}
    }
};
def allows_reverse_references: Fn(Type) -> Bool = fn(ty) {
    match property::get_type_prop(ty, ReverseReferences.type) {
        Some(policy) => policy.allowed,
        None => False,
    }
};
pub use self::{
    ReverseReferences,
    reverse_references,
    allows_reverse_references,
    independent_type,
    is_independent_record
};
pub use self::{constructor, constructor_name};

# Dataset 的业务主体只用于知识归属，不授予 JOIN，也不声称每行唯一。
type Subject = struct {
    entity: String,
    field: String
};
@prelude::property(PropertyTarget::Type)
type Subjects = struct {
    items: Array(Subject)
};
def subject: Fn(String, String) -> Fn(Type, Option(Subjects)) -> Subjects = fn(entity, field) {
    if entity == "" || field == "" {
        fail!("knowledge subject requires entity and field")
    } else {
        ()
    };
    fn(ctx, previous) {
        {
            items: array::concat(
                [
                    match previous {
                        Some(p) => p.items,
                        None => []
                    },
                    [{entity, field}]
                ]
            )
        }
    }
};
pub use self::{Subject, Subjects, subject};
