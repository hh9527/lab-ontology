# AP 样本的共享名义量与统计组；不加载模型或知识。
use ontology::samples as samples;
use ontology::quantity as q;
use ontology::quantity::{KilobitsPerSecond, IntegerKilobitsPerSecond};
# 射频上报速率保留 Int，不以 Float 改变原始契约。
use ontology::quantity::{EffectiveCount};
# 原声明未确认 RSSI 单位，不因字段名补充 dBm。
@q::calculations(
    [
        q::Calculation::Compare,
        q::Calculation::Mean,
        q::Calculation::Min,
        q::Calculation::Max,
        q::Calculation::Round
    ]
)
type MeanReportedRssi = struct(Float);
@q::calculations(
    [
        q::Calculation::Compare,
        q::Calculation::Mean,
        q::Calculation::Min,
        q::Calculation::Max,
        q::Calculation::Round
    ]
)
@q::mean_result(MeanReportedRssi.type)
type ReportedRssi = struct(Int);
def rate_statistics: samples::Group(KilobitsPerSecond) = samples::group(
    "ap_rate",
    KilobitsPerSecond.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    None
);
def integer_rate_statistics: samples::Group(IntegerKilobitsPerSecond) = samples::group(
    "ap_integer_rate",
    IntegerKilobitsPerSecond.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    None
);
def count_statistics: samples::Group(q::Count) = samples::group(
    "ap_count",
    q::Count.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    None
);
def rssi_statistics: samples::Group(ReportedRssi) = samples::group(
    "ap_rssi",
    ReportedRssi.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    None
);
pub use self::{
    KilobitsPerSecond,
    IntegerKilobitsPerSecond,
    EffectiveCount,
    ReportedRssi,
    MeanReportedRssi,
    rate_statistics,
    integer_rate_statistics,
    count_statistics,
    rssi_statistics
};
