);
pub def epoch_millis_to_utc_is_rejected: test::Test = test::should_fail_with(
    fn() {
        uql::render_expr_with_context(
            qb::scalar(qb::ScalarFunction::EpochMillisToUtc, [needle.1]),
            cap.0
        )
    },
    "UQL does not define epoch millis to timestamp conversion"
);
pub def symbolic_parameter_is_rejected: test::Test = test::should_fail_with(
    fn() {
        uql::render_expr_with_context(
            qb::scalar(qb::ScalarFunction::IsNotNull, [qb::Expr::Parameter(0)]),
            cap.0
        )
    },
    "symbolic query parameters require binding before this dialect"
);
pub def epoch_boundaries_expand_per_occurrence: test::Test = test::should_ok(fn() {
    type EpochEntry = struct {value: qb::Val, unit: qb::UtcBucketUnit};
    let boundaries: Array(EpochEntry) = array::flat_map(
        [
            qb::Val::Int(-1), qb::Val::Int(-3600001), qb::Val::Int(-86400001),
            qb::Val::Int(-62135596800000), qb::Val::Int(-62135596800001),
            qb::Val::Int(253402300799999), qb::Val::Int(253402300800000), qb::Val::None,
        ],
        fn(value) {
            array::map(
                [qb::UtcBucketUnit::Hour, qb::UtcBucketUnit::Day, qb::UtcBucketUnit::Month],
                fn(unit) {
                    {value, unit}.ty!(EpochEntry)
                }
            )
        }
    );
    array::fold(boundaries, True, fn(healthy, entry) {
        let bound = qb::bind(qb::build_context(), entry.value);
        let rendered = uql::render_expr_with_context(
            qb::scalar(
                qb::ScalarFunction::UtcTimeBucket({unit: entry.unit, encoding: qb::UtcBucketEncoding::EpochMillis}),
                [bound.1]
            ),
            bound.0
        );
        if rendered.bindings != [entry.value, entry.value, entry.value, entry.value] {
            fail!("epoch bucket must expand the guarded value per occurrence", entry, rendered.bindings)
        } else { () };
        healthy
    });
});
pub def unregistered_binding_is_rejected: test::Test = test::should_fail_with(
    fn() {
        uql::render_expr_with_context(qb::Expr::AllocatedBind({index: 5}), cap.0)
    },
    "binding handle is not registered"
);
pub def invalid_identifier_is_rejected: test::Test = test::should_fail_with(
    fn() {
        uql::render_expr_with_context(
            qb::Expr::Column({source: "select", column: "id` FROM events; --"}),
            cap.0
        )
    },
    "invalid UQL column identifier"
);
pub def invalid_final_take_is_rejected: test::Test = test::should_fail_with(
    fn() {
        uql::build_query(
            {
                ...qb::finish(cap.0, qb::QueryPlan::Rows(plan)),
                selection: Some(
                    {
                        order_by: [
                            {
                                key: qb::Expr::Column({source: "__q_result", column: "id"}),
                                direction: qb::Ordering::Asc
                            }
                        ],
                        take: 0
                    }
                )
            }
        )
    },
    "final take must be an integer in 1..500"
);

# Runtime cases exercise every top-level QueryPlan variant, nested comparisons,
# scopes, CASE aggregate semantics, latest staging and partitioned Top-N.
def scoped: qb::Plan = {...plan, sources: [{...source.1, scope: Some(predicate)}]};
def correlated: qb::Exists = qb::exists(
    peer.1,
    [
        qb::column_eq(
            qb::source_column_ref(source.1, "category"),
            qb::source_column_ref(peer.1, "category")
        )
    ],
    Some(qb::scalar(qb::ScalarFunction::Eq, [qb::column(peer.1, "kind"), needle.1]))
);
def scalar_inner: qb::ScalarSubquery = qb::scalar_subquery_spec(
    peer.1,
    [],
    None,
    qb::AggregateFunction::Avg,
    qb::column(peer.1, "amount"),
    False,
    None
);
def ranked_inner: qb::RankedKeySubquery = qb::ranked_key_subquery_spec(
    peer.1,
    [],
    None,
    [qb::column(peer.1, "category")],
    {
        function: qb::AggregateFunction::Sum,
        arg: qb::column(peer.1, "amount"),
        distinct: False,
        filter: None,
        alias: "total",
        latest: None
    },
    qb::Ordering::Desc
);
def latest_call: qb::SelectItem = qb::SelectItem::Aggregate(
    {
        function: qb::AggregateFunction::Latest,
        arg: amount,
        distinct: False,
        filter: None,
        alias: "latest",
        latest: Some(
            {
                time: qb::source_column_ref(source.1, "ts"),
                ties: [qb::source_column_ref(source.1, "id")]
            }
        )
    }
);
def latest: qb::Plan = {
    ...plan,
    projection: [qb::named_expr_item(category, "category"), latest_call],
    grouping: [category],
    ordering: []
};
def partitioned: qb::Plan = {
    ...plan,
    projection: [qb::named_expr_item(category, "category"), qb::named_expr_item(id, "id")],
    ordering: [],
    partition: Some(
        qb::partitioned_top_n_bound(
            [category],
            [
                qb::order_by(qb::OrderKey::Expr(amount), qb::Ordering::Desc),
                qb::order_by(qb::OrderKey::Expr(id), qb::Ordering::Asc)
            ],
            take.1
        )
    )
};
# The partition key is deliberately not projected: it must surface through the
# hidden `__q_pk_<i>` materialization so the outer ordering stays stable.
def partitioned_hidden_key: qb::Plan = {
    ...plan,
    projection: [qb::named_expr_item(id, "id")],
    ordering: [],
    partition: Some(
        qb::partitioned_top_n_bound(
            [category],
            [qb::order_by(qb::OrderKey::Expr(amount), qb::Ordering::Desc)],
            take.1
        )
    )
};
def days_ago: qb::Plan = {
    ...plan,
    projection: [qb::named_expr_item(qb::scalar(qb::ScalarFunction::UtcDaysAgo, [ago_time.1, ago_days.1]), "ago")]
};
def days_ago_null: qb::Plan = {
    ...plan,
    projection: [qb::named_expr_item(qb::scalar(qb::ScalarFunction::UtcDaysAgo, [null_time.1, ago_days.1]), "ago")]
};
def bucket_hour: qb::Plan = {
    ...plan,
    projection: [
        qb::named_expr_item(
            qb::scalar(
                qb::ScalarFunction::UtcTimeBucket({unit: qb::UtcBucketUnit::Hour, encoding: qb::UtcBucketEncoding::DateTimeUtc}),
                [ago_time.1]
            ),
            "bucket"
        )
    ]
};
def joined: qb::JoinedGroups = {
    left: {...grouped, ordering: []},
    right: {...grouped, ordering: []},
    keys: ["category"],
    left_identity: [category],
    right_identity: [category],
    outputs: [
        {side: qb::PairSide::Left, column: "hits", alias: "hits"},
        {side: qb::PairSide::Right, column: "hits", alias: "right_hits"}
    ],
    rank: None,
};
type Case = struct {
    name: String,
    query: qb::Query
};
def cases: Array(Case) = [
    {name: "rows", query: render(qb::QueryPlan::Rows(plan))},
    {
        name: "desc",
        query: render(
            qb::QueryPlan::Rows(
                {...plan, ordering: [qb::order_by(qb::OrderKey::Expr(amount), qb::Ordering::Desc)]}
            )
        )
    },
    {name: "scoped", query: render(qb::QueryPlan::Rows(scoped))},
    {name: "grouped", query: render(qb::QueryPlan::Rows(grouped))},
    {
        name: "distinct",
        query: render(
            qb::QueryPlan::DistinctRows(
                {...plan, projection: [qb::named_expr_item(category, "category")], ordering: []}
            )
        )
    },
    {name: "group_count", query: render(qb::QueryPlan::GroupCount(grouped))},
    {
        name: "union",
        query: render(
            qb::QueryPlan::SetRows(
                {
                    kind: qb::SetOpKind::Union,
                    operands: [{...plan, ordering: []}, {...plan, ordering: []}]
                }
            )
        )
    },
    {
        name: "set_count",
        query: render(
            qb::QueryPlan::SetCount(
                {
                    kind: qb::SetOpKind::Union,
                    operands: [{...plan, ordering: []}, {...plan, ordering: []}]
                }
            )
        )
    },
    {name: "exists", query: render(qb::QueryPlan::Rows({...plan, exists: [correlated]}))},
    {
        name: "not_exists",
        query: render(qb::QueryPlan::Rows({...plan, exists: [qb::exists_not(correlated)]}))
    },
    {
        name: "scalar",
        query: render(
            qb::QueryPlan::Rows(
                {
                    ...plan,
                    scalar_comparisons: [
                        qb::scalar_aggregate_comparison(
                            qb::source_column_ref(source.1, "amount"),
                            qb::ScalarFunction::Gt,
                            scalar_inner
                        )
                    ]
                }
            )
        )
    },
    {
        name: "ranked",
        query: render(
            qb::QueryPlan::Rows(
                {
                    ...plan,
                    ranked_key_comparisons: [
                        qb::ranked_key_comparison(
                            qb::source_column_ref(source.1, "category"),
                            qb::ScalarFunction::Eq,
                            ranked_inner
                        )
                    ]
                }
            )
        )
    },
    {name: "latest", query: render(qb::QueryPlan::Rows(latest))},
    {name: "partitioned", query: render(qb::QueryPlan::Rows(partitioned))},
    {name: "partitioned_hidden_key", query: render(qb::QueryPlan::Rows(partitioned_hidden_key))},
    {name: "joined", query: render(qb::QueryPlan::JoinedGroups(joined))},
    {name: "joined_count", query: render(qb::QueryPlan::JoinedGroupCount(joined))},
    {
        name: "joined_ratio",
        query: render(
            qb::QueryPlan::JoinedGroups(
                {
                    ...joined,
                    rank: Some(
                        {
                            left_measure: "hits",
                            right_measure: "hits",
                            op: qb::PairRankOp::Ratio,
                            first: qb::PairSide::Right,
                            direction: qb::Ordering::Desc,
                            take: take.1
                        }
                    )
                }
            )
        )
    },
    {
        name: "capped",
        query: uql::build_query(
            {
                ...qb::finish(cap.0, qb::QueryPlan::Rows({...plan, limit: Some(take.1)})),
                selection: Some(
                    {
                        order_by: [
                            {
                                key: qb::Expr::Column({source: "__q_result", column: "id"}),
                                direction: qb::Ordering::Asc
                            }
                        ],
                        take: 1
                    }
                )
            }
        )
    },
    {
        name: "lower",
        query: render(
            qb::QueryPlan::Rows(
                {
                    ...plan,
                    projection: [
                        qb::named_expr_item(
                            qb::scalar(qb::ScalarFunction::Lower, [qb::column(source.1, "kind")]),
                            "kind"
                        )
                    ]
                }
            )
        )
    },
    {name: "days_ago", query: render(qb::QueryPlan::Rows(days_ago))},
    {name: "days_ago_null", query: render(qb::QueryPlan::Rows(days_ago_null))},
    {name: "bucket_hour", query: render(qb::QueryPlan::Rows(bucket_hour))},
];
# The expected arrays are the occurrence-order expansions: grouped re-expands
# its computed measure in HAVING and ORDER BY, joined groups render the grouped
# plan twice, and the capped case keeps the business LIMIT before the take.
type Expectation = struct {
    name: String,
    bindings: Array(qb::Val)
};
def grouped_bindings: Array(qb::Val) = [
    qb::Val::String("active"),
    qb::Val::String("active"),
    qb::Val::String("active"),
    qb::Val::String("active"),
    qb::Val::Int(0),
    qb::Val::String("active"),
    qb::Val::String("active")
];
# The aligned sides strip the grouped plan's ordering, so each side expands the
# projection and HAVING re-expansions only.
def aligned_bindings: Array(qb::Val) = [
    qb::Val::String("active"),
    qb::Val::String("active"),
    qb::Val::String("active"),
    qb::Val::String("active"),
    qb::Val::Int(0)
];
def joined_bindings: Array(qb::Val) = array::concat([aligned_bindings, aligned_bindings]);
def expectations: Array(Expectation) = [
    {name: "rows", bindings: []},
    {name: "desc", bindings: []},
    {name: "distinct", bindings: []},
    {name: "union", bindings: []},
    {name: "set_count", bindings: []},
    {name: "scalar", bindings: []},
    {name: "ranked", bindings: []},
    {name: "latest", bindings: []},
    {name: "lower", bindings: []},
    {name: "scoped", bindings: [qb::Val::String("active")]},
    {name: "exists", bindings: [qb::Val::String("active")]},
    {name: "not_exists", bindings: [qb::Val::String("active")]},
    {name: "grouped", bindings: grouped_bindings},
    {name: "group_count", bindings: grouped_bindings},
    {name: "partitioned", bindings: [qb::Val::Int(2)]},
    {name: "partitioned_hidden_key", bindings: [qb::Val::Int(2)]},
    {name: "joined", bindings: joined_bindings},
    {name: "joined_count", bindings: joined_bindings},
    {name: "joined_ratio", bindings: array::push(joined_bindings, qb::Val::Int(2))},
    {name: "capped", bindings: [qb::Val::Int(2)]},
    {
        name: "days_ago",
        bindings: [
            qb::Val::Int(2),
            qb::Val::String("2026-03-05 07:25:00"),
            qb::Val::Int(2),
            qb::Val::String("2026-03-05 07:25:00")
        ]
    },
    {name: "days_ago_null", bindings: [qb::Val::Int(2), qb::Val::None, qb::Val::Int(2), qb::Val::None]},
    {name: "bucket_hour", bindings: [qb::Val::String("2026-03-05 07:25:00")]},
];
def expected_for: Fn(String) -> Array(qb::Val) = fn(name) {
    match array::find(expectations, fn(item) { item.name == name }) {
        Some(item) => item.bindings,
        None => fail!("missing expansion expectation", name),
    }
};
pub def all_plan_shapes_expand_occurrence_bindings: test::Test = test::should_ok(
    fn() {
        let mismatched = array::filter(cases, fn(item) {
            item.query.bindings != expected_for(item.name)
        });
        if array::length(mismatched) > 0 {
            fail!("a plan shape broke the occurrence-order expansion", mismatched)
        } else { () };
        let broken = array::filter(cases, fn(item) {
            placeholder_count(item.query.sql) != array::length(item.query.bindings)
        });
        if array::length(broken) > 0 {
            fail!("a plan shape rendered a placeholder count that differs from its bindings", broken)
        } else { () };
        let filtered = array::filter(cases, fn(item) { string::contains(item.query.sql, "FILTER (") });
        if array::length(filtered) > 0 {
            fail!("a plan shape rendered a FILTER clause", filtered)
        } else { () };
        let widened = array::filter(cases, fn(item) { string::contains(item.query.sql, "DOUBLE PRECISION") });
        if array::length(widened) > 0 {
            fail!("a plan shape rendered non-portable DOUBLE PRECISION", widened)
        } else { () }
    }
);
pub def selection_wrap_orders_and_limits_literal: test::Test = test::should_ok(
    fn() {
        let query = match array::find(cases, fn(item) { item.name == "capped" }) {
            Some(item) => item.query,
            None => fail!("missing capped case"),
        };
        if !string::contains(query.sql, "AS `__q_result`") {
            fail!("the final selection lost its semantic alias", query.sql)
        } else { () };
        if !string::contains(query.sql, "LIMIT 1") {
            fail!("the final selection must append a literal LIMIT", query.sql)
        } else { () };
        if placeholder_count(query.sql) != array::length(query.bindings) {
            fail!("placeholder count must equal the bindings length", query.sql, query.bindings)
        } else { () }
    }
);
pub def ranked_bind_key_expands_per_restatement: test::Test = test::should_ok(
    fn() {
        let ranked_bound_inner: qb::RankedKeySubquery = qb::ranked_key_subquery_spec(
            peer.1,
            [],
            None,
            [needle.1],
            {
                function: qb::AggregateFunction::Sum,
                arg: qb::column(peer.1, "amount"),
                distinct: False,
                filter: None,
                alias: "total",
                latest: None
            },
            qb::Ordering::Desc
        );
        let query = render(
            qb::QueryPlan::Rows(
                {
                    ...plan,
                    ranked_key_comparisons: [
                        qb::ranked_key_comparison(
                            qb::source_column_ref(source.1, "category"),
                            qb::ScalarFunction::Eq,
                            ranked_bound_inner
                        )
                    ]
                }
            )
        );
        if !string::contains(query.sql, "= (SELECT ? FROM") {
            fail!("the bound ranked key lost its scalar subquery form", query.sql)
        } else { () };
        if !string::contains(query.sql, "GROUP BY ? ORDER BY sum(`select_2`.`amount`) DESC NULLS LAST LIMIT 1)") {
            fail!("the bound ranked key must restate itself in GROUP BY", query.sql)
        } else { () };
        if query.bindings != [qb::Val::String("active"), qb::Val::String("active")] {
            fail!("the key must repeat its binding once per restatement", query.bindings)
        } else { () };
        if placeholder_count(query.sql) != array::length(query.bindings) {
            fail!("placeholder count must equal the bindings length", query.sql, query.bindings)
        } else { () }
    }
);
pub def structural_names_use_the_shared_vocabulary: test::Test = test::should_ok(
    fn() {
        let named: Array(Case) = array::filter(cases, fn(item) {
            item.name == "latest" || item.name == "joined" || item.name == "group_count"
                || item.name == "capped" || item.name == "partitioned" || item.name == "partitioned_hidden_key"
        });
        if array::length(named) != 6 {
            fail!("structural name cases went missing", array::map(named, fn(item) { item.name }))
        } else { () };
        let latest_sql = match array::find(named, fn(item) { item.name == "latest" }) {
            Some(item) => item.query.sql,
            None => fail!("missing latest"),
        };
        if !string::contains(latest_sql, "AS `__latest_stage`") {
            fail!("latest staging lost its semantic alias", latest_sql)
        } else { () };
        if !string::contains(latest_sql, "`__latest_row` = 1") {
            fail!("latest reduction lost its staged row marker", latest_sql)
        } else { () };
        if !string::contains(latest_sql, "DESC NULLS LAST") {
            fail!("latest window lost its explicit NULLS ordering", latest_sql)
        } else { () };
        let joined_sql = match array::find(named, fn(item) { item.name == "joined" }) {
            Some(item) => item.query.sql,
            None => fail!("missing joined"),
        };
        if !string::contains(joined_sql, "`__q_left`.`category` <=> `__q_right`.`category`") {
            fail!("joined identity keys lost their NULL-safe alignment", joined_sql)
        } else { () };
        let count_sql = match array::find(named, fn(item) { item.name == "group_count" }) {
            Some(item) => item.query.sql,
            None => fail!("missing group_count"),
        };
        if !string::contains(count_sql, "AS `__q_count`") {
            fail!("group counting lost its semantic derived alias", count_sql)
        } else { () };
        let capped_sql = match array::find(named, fn(item) { item.name == "capped" }) {
            Some(item) => item.query.sql,
            None => fail!("missing capped"),
        };
        if !string::contains(capped_sql, "AS `__q_result`") {
            fail!("the final selection lost its semantic alias", capped_sql)
        } else { () };
        if !string::contains(capped_sql, "LIMIT 1") {
            fail!("the final selection must append a literal LIMIT", capped_sql)
        } else { () };
        let partitioned_sql = match array::find(named, fn(item) { item.name == "partitioned" }) {
            Some(item) => item.query.sql,
            None => fail!("missing partitioned"),
        };
        if !string::contains(partitioned_sql, "AS `__q_partitioned`") {
            fail!("partitioned Top-N lost its semantic outer alias", partitioned_sql)
        } else { () };
        if !string::contains(partitioned_sql, "`__q_rn` <= ?") {
            fail!("partitioned Top-N lost its row-number cut", partitioned_sql)
        } else { () };
        if !string::contains(partitioned_sql, "AS `__q_ok_0`") {
            fail!("partitioned Top-N lost its hidden ordering key name", partitioned_sql)
        } else { () };
        let hidden_key_sql = match array::find(named, fn(item) { item.name == "partitioned_hidden_key" }) {
            Some(item) => item.query.sql,
            None => fail!("missing partitioned_hidden_key"),
        };
        if !string::contains(hidden_key_sql, "AS `__q_pk_0`") {
            fail!("an unprojected partition key must materialize as __q_pk_<i>", hidden_key_sql)
        } else { () }
    }
);
pub def offset_without_limit_is_rejected: test::Test = test::should_fail_with(
    fn() {
        render(qb::QueryPlan::Rows({...plan, offset: Some(threshold.1)}))
    },
    "UQL OFFSET requires a LIMIT or a final output cap"
);
pub def offset_with_selection_uses_single_layer: test::Test = test::should_ok(
    fn() {
        let query = uql::build_query(
            {
                ...qb::finish(cap.0, qb::QueryPlan::Rows({...plan, offset: Some(threshold.1)})),
                selection: Some(
                    {
                        order_by: [
                            {
                                key: qb::Expr::Column({source: "__q_result", column: "id"}),
                                direction: qb::Ordering::Asc
                            }
                        ],
                        take: 2
                    }
                )
            }
        );
        if !string::contains(query.sql, "LIMIT 2 OFFSET ?") {
            fail!("a bare OFFSET with a selection must upgrade to the single-layer shape", query.sql)
        } else { () };
        if string::contains(query.sql, "AS `__q_result`") {
            fail!("the single-layer OFFSET shape must not wrap again", query.sql)
        } else { () };
        if placeholder_count(query.sql) != array::length(query.bindings) {
            fail!("placeholder count must equal the bindings length", query.sql, query.bindings)
        } else { () }
    }
);
pub def ungrouped_having_renders_natively: test::Test = test::should_ok(
    fn() {
        let query = render(qb::QueryPlan::Rows({...grouped, projection: [count], grouping: [], ordering: []}));
        if !string::contains(query.sql, "HAVING count(DISTINCT CASE") {
            fail!("ungrouped HAVING must render natively", query.sql)
        } else { () }
    }
);
pub def ranked_keys_use_direct_scalar_subquery: test::Test = test::should_ok(
    fn() {
        let query = render(
            qb::QueryPlan::Rows(
                {
                    ...plan,
                    ranked_key_comparisons: [
                        qb::ranked_key_comparison(
                            qb::source_column_ref(source.1, "category"),
                            qb::ScalarFunction::Eq,
                            ranked_inner
                        )
                    ]
                }
            )
        );
        if !string::contains(query.sql, "`select`.`category` = (SELECT `select_2`.`category` FROM") {
            fail!("ranked key lost its direct scalar subquery form", query.sql)
        } else { () };
        if !string::contains(
            query.sql,
            "GROUP BY `select_2`.`category` ORDER BY sum(`select_2`.`amount`) DESC NULLS LAST LIMIT 1)"
        ) {
            fail!("ranked key lost its grouped ordering with LIMIT 1", query.sql)
        } else { () };
        if string::contains(query.sql, "EXISTS (SELECT 1 FROM (SELECT") {
            fail!("ranked key must not use the historical EXISTS wrapper", query.sql)
        } else { () }
    }
);
# The §6.1 count shape: the aggregate argument is a constant binding allocated
# BEFORE the predicate's binding, but the CASE text places the predicate first,
# so the expansion must follow text order, not allocation order.
def agg_order_arg: (qb::BuildCtx, qb::Expr) = qb::bind(qb::build_context(), qb::Val::Int(1));
def agg_order_filter: (qb::BuildCtx, qb::Expr) = qb::bind(agg_order_arg.0, qb::Val::String("active"));
def agg_order_predicate: qb::Expr = qb::scalar(
    qb::ScalarFunction::Eq,
    [qb::column(source.1, "kind"), agg_order_filter.1]
);
def agg_order_plan: qb::Plan = {...plan,
    projection: [
        qb::aggregate_filtered(qb::AggregateFunction::Count, agg_order_arg.1, False, Some(agg_order_predicate), "c")
    ],
    ordering: []};
pub def filtered_aggregate_binds_in_text_order: test::Test = test::should_ok(
    fn() {
        let query = uql::build_query(qb::finish(agg_order_filter.0, qb::QueryPlan::Rows(agg_order_plan)));
        if !string::contains(query.sql, "count(CASE WHEN `select`.`kind` = ? THEN ? ELSE NULL END)") {
            fail!("filtered aggregate lost its scoped CASE form", query.sql)
        } else { () };
        if query.bindings != [qb::Val::String("active"), qb::Val::Int(1)] {
            fail!("the filter must bind before the aggregate argument (text order)", query.bindings)
        } else { () };
        if placeholder_count(query.sql) != array::length(query.bindings) {
            fail!("placeholder count must equal the bindings length", query.sql, query.bindings)
        } else { () }
    }
);
pub def joined_groups_align_null_safe: test::Test = test::should_ok(
    fn() {
        let query = render(qb::QueryPlan::JoinedGroups(joined));
        if !string::contains(query.sql, "AS `__q_left`") || !string::contains(query.sql, "AS `__q_right`") {
            fail!("joined groups lost their fixed semantic aliases", query.sql)
        } else { () };
        if !string::contains(query.sql, "`__q_left`.`category` <=> `__q_right`.`category`") {
            fail!("joined identity keys lost their NULL-safe alignment", query.sql)
        } else { () }
    }
);
def epoch_cases: Array(Case) = array::flat_map(
    [
        qb::Val::Int(-1),
        qb::Val::Int(-3600001),
        qb::Val::Int(-86400001),
        qb::Val::Int(-62135596800000),
        qb::Val::Int(-62135596800001),
        qb::Val::Int(253402300799999),
        qb::Val::Int(253402300800000),
        qb::Val::None,
    ],
    fn(value) {
        array::map(
            [qb::UtcBucketUnit::Hour, qb::UtcBucketUnit::Day, qb::UtcBucketUnit::Month],
            fn(unit) {
                let bound = qb::bind(qb::build_context(), value);
                let rendered = uql::render_expr_with_context(
                    qb::scalar(
                        qb::ScalarFunction::UtcTimeBucket(
                            {unit, encoding: qb::UtcBucketEncoding::EpochMillis}
                        ),
                        [bound.1]
                    ),
                    bound.0
                );
                let name = match unit {
                    qb::UtcBucketUnit::Hour => "epoch_hour",
                    qb::UtcBucketUnit::Day => "epoch_day",
                    _ => "epoch_month"
                };
                {name, query: {...rendered, sql: `SELECT \{rendered.sql}`}}.ty!(Case)
            }
        )
    }
);
pub def execution_queries: Value = codec::encode(array::concat([cases, epoch_cases]));
