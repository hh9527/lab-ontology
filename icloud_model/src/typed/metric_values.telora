# 业务指标保留独立代数身份；比例运算能力由 inner type 继承。
use ontology::quantity as q;
use ontology::samples as samples;
type CpuUtilization = struct(q::Percent);
type MemoryUtilization = struct(q::Percent);
type OnlineProportion = struct(q::Percent);
def cpu_statistics: samples::Group(CpuUtilization) = samples::group(
    "cpu_utilization", CpuUtilization.type, samples::Statistic::Mean,
    [samples::Statistic::Latest, samples::Statistic::Min, samples::Statistic::Max], Some("%")
);
def memory_statistics: samples::Group(MemoryUtilization) = samples::group(
    "memory_utilization", MemoryUtilization.type, samples::Statistic::Mean,
    [samples::Statistic::Latest, samples::Statistic::Min, samples::Statistic::Max], Some("%")
);
def online_statistics: samples::Group(OnlineProportion) = samples::group(
    "online_proportion", OnlineProportion.type, samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max], Some("%")
);
pub use self::{CpuUtilization, MemoryUtilization, OnlineProportion, cpu_statistics, memory_statistics, online_statistics};

def cpu_summary: samples::Group(CpuUtilization) = samples::group("cpu_summary", CpuUtilization.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], Some("%"));
pub use self::cpu_summary;

def memory_summary: samples::Group(MemoryUtilization) = samples::group("memory_summary", MemoryUtilization.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], Some("%"));
pub use self::memory_summary;
