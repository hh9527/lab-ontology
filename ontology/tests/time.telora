use crate::ontology as edsl;
use crate::intent::{ query_intent_ast_factory, query_intent_ast_factory_with_context,
    query_request_lower_factory };
use crate::knowledge as knowledge;
use crate::query as qb;
use crate::sqlite as sqlite;
use crate::time as time;
use std::json as json;
use std::string as string;
use std::test as test;

@edsl::entity_id("dog")
@edsl::entity_source("dogs", "dog")
type Dog = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
    @edsl::column("date_of_birth")
    @edsl::time_field(edsl::TimeSemantics::Date, edsl::TimeEncoding::DateText)
    @edsl::dimension("birth_date", True, True,
        [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::Date])
    birth_date: String,
    @edsl::column("created_at")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("created_at", True, True,
        [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::Rfc3339])
    created_at: String,
};

@edsl::entity_id("legacy_clock")
@edsl::entity_source("legacy_clocks", "legacy")
@edsl::named_relation_key("bad_clock_join", Dog.type, edsl::RelationKind::FanOut,
    edsl::DeclaredRelationKey::FieldEq({from: "timestamp_text", to: "created_at"}))
type LegacyClock = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
    @edsl::column("timestamp_text")
    timestamp_text: String,
};

@edsl::entity_source("bad_time_dimension", "bad")
type BadTimeDimension = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
    @edsl::column("time")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("bad_time", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    time: String,
};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Column, qb::Operator::Project,
        qb::Operator::Filter, qb::Operator::Scalar, qb::Operator::Bind, qb::Operator::Group,
        qb::Operator::Aggregate],
    allowed_join_kinds: [], allowed_aggregates: [qb::AggregateFunction::Count],
    allowed_scalars: [qb::ScalarFunction::Ge, qb::ScalarFunction::Lt, qb::ScalarFunction::And],
    allow_distinct: False,
};

def payload: edsl::PreparedPayload = edsl::build_root("time-contract", [Dog.type], profile,
    fn(subject) { subject == "reader" });

pub def date_window_preserves_date_semantics: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload, "reader")(json::parse(r#"{
        "op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"birth_date"}],
        "time_windows":[{"node":"dog","dimension":"birth_date",
            "start":"2024-02-29", "end":"2024-03-01"}]
    }"#).unwrap!());
    let query = sqlite::build_query(ast);
    if string::contains(query.sql, "dog.date_of_birth >= ?1")
        && string::contains(query.sql, "dog.date_of_birth < ?2")
        && query.bindings == [qb::Val::String("2024-02-29"), qb::Val::String("2024-03-01")] { True }
    else { fail!("calendar dates must compare as declared date text", query) }
});

pub def invalid_calendar_date_fails_before_query: test::Test = test::should_fail_with(fn() {
    time::window_filters(payload, "reader", "birth_date", {
        start: time::TimeValue::Date("2025-02-29"), end: time::TimeValue::Date("2025-03-01")})
}, "invalid calendar date boundary");

pub def instant_cannot_filter_calendar_date: test::Test = test::should_fail_with(fn() {
    time::window_filters(payload, "reader", "birth_date", {
        start: time::TimeValue::UtcSecond("2024-02-29 00:00:00"),
        end: time::TimeValue::UtcSecond("2024-03-01 00:00:00")})
}, "time boundary does not match declared field encoding");

pub def plain_filter_cannot_bypass_date_validation: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload, "reader")(json::parse(r#"{
        "op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"birth_date"}],
        "filters":[{"node":"dog","dimension":"birth_date",
            "op":"ge","kind":"text","value":"2025-02-29"}]
    }"#).unwrap!())
}, "calendar date filter requires Date input");

pub def rfc3339_window_is_typed_even_when_stored_as_text: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload, "reader")(json::parse(r#"{
        "op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
        "time_windows":[{"node":"dog","dimension":"created_at",
            "start":"2024-02-29T00:00:00Z", "end":"2024-03-01T00:00:00Z"}]
    }"#).unwrap!());
    let query = sqlite::build_query(ast);
    if string::contains(query.sql, "dog.created_at >= ?1")
        && query.bindings == [qb::Val::String("2024-02-29T00:00:00Z"),
            qb::Val::String("2024-03-01T00:00:00Z")] { True }
    else { fail!("RFC3339 must retain its logical type until binding", query) }
});

pub def request_epoch_millis_converts_to_rfc3339: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{
        "op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"created_at"}],"time_windows":[{"node":"dog","dimension":"created_at",
            "start":"2024-02-29T00:00:00Z", "end":"now"}]
    }"#).unwrap!();
    let context = time::request_context(1709280550000, None);
    let query = sqlite::build_query(query_intent_ast_factory_with_context(payload, "reader", context)(intent));
    if query.bindings == [qb::Val::String("2024-02-29T00:00:00Z"),
        qb::Val::String("2024-03-01T08:09:10Z")] { True }
    else { fail!("epoch clock conversion lost its UTC instant", query) }
});

pub def request_envelope_supplies_now_to_intent: test::Test = test::should_ok(fn() {
    let request = json::parse(r#"{
        "ctx":{"now":1709280550000,"tz":480},
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
            "time_windows":[{"node":"dog","dimension":"created_at",
                "start":"2024-02-29T00:00:00Z", "end":"now"}]}
    }"#).unwrap!();
    let query = query_request_lower_factory(payload, "reader", sqlite::build_query)(request);
    if query.bindings == [qb::Val::String("2024-02-29T00:00:00Z"),
        qb::Val::String("2024-03-01T08:09:10Z")] { True }
    else { fail!("request envelope did not bind its explicit clock", query) }
});

pub def calendar_yesterday_differs_from_fixed_24_hours: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "dog", "created_at");
    let context = time::request_context(1709294400000, Some(480));
    match (time::calendar_boundary(context, role, time::CalendarUnit::Day, -1),
        time::fixed_delta(context, role, -86400000)) {
        (time::TimeValue::Rfc3339("2024-02-28T16:00:00Z"),
            time::TimeValue::Rfc3339("2024-02-29T12:00:00Z")) => True,
        other => fail!("calendar yesterday must differ from elapsed 24 hours", other),
    }
});

pub def calendar_window_lowers_to_typed_bindings: test::Test = test::should_ok(fn() {
    let query = query_request_lower_factory(payload, "reader", sqlite::build_query)(json::parse(r#"{
        "ctx":{"now":1709294400000,"tz":480},
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"birth_date"}],
            "time_windows":[{"node":"dog","dimension":"birth_date",
                "start":{"calendar":"month","offset":-1},
                "end":{"calendar":"month","offset":0}}]}
    }"#).unwrap!());
    if query.bindings == [qb::Val::String("2024-02-01"), qb::Val::String("2024-03-01")]
        && string::contains(query.sql, "dog.date_of_birth >= ?1") { True }
    else { fail!("calendar month must lower as raw-column date bindings", query) }
});

pub def calendar_week_and_negative_epoch_boundaries: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "dog", "created_at");
    match (time::calendar_boundary(time::request_context(1709294400000, Some(480)),
            role, time::CalendarUnit::Week, 0),
        time::calendar_boundary(time::request_context(-1000, Some(0)),
            role, time::CalendarUnit::Day, 0)) {
        (time::TimeValue::Rfc3339("2024-02-25T16:00:00Z"),
            time::TimeValue::Rfc3339("1969-12-31T00:00:00Z")) => True,
        other => fail!("Monday week or negative epoch boundary was incorrect", other),
    }
});

pub def calendar_month_crosses_year_and_leap_day: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "dog", "birth_date");
    match (time::calendar_boundary(time::request_context(1709294400000, Some(480)),
            role, time::CalendarUnit::Day, -1),
        time::calendar_boundary(time::request_context(1735646400000, Some(480)),
            role, time::CalendarUnit::Month, 1)) {
        (time::TimeValue::Date("2024-02-29"), time::TimeValue::Date("2025-01-01")) => True,
        other => fail!("leap day or year rollover was incorrect", other),
    }
});

pub def fixed_delta_expression_lowers_without_calendar_timezone: test::Test = test::should_ok(fn() {
    let query = query_request_lower_factory(payload, "reader", sqlite::build_query)(json::parse(r#"{
        "ctx":{"now":1709294400000},
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
            "time_windows":[{"node":"dog","dimension":"created_at",
                "start":{"delta_ms":-86400000},"end":"now"}]}
    }"#).unwrap!());
    if query.bindings == [qb::Val::String("2024-02-29T12:00:00Z"),
        qb::Val::String("2024-03-01T12:00:00Z")] { True }
    else { fail!("fixed duration expression did not lower", query) }
});

pub def calendar_expression_rejects_unknown_keys: test::Test = test::should_fail_with(fn() {
    query_request_lower_factory(payload, "reader", sqlite::build_query)(json::parse(r#"{
        "ctx":{"now":1709294400000,"tz":480},
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
            "time_windows":[{"node":"dog","dimension":"created_at",
                "start":{"calendar":"day","offset":-1,"approximate":true},"end":"now"}]}
    }"#).unwrap!())
}, "graph intent contains unsupported key");

pub def calendar_boundary_requires_offset_context: test::Test = test::should_fail_with(fn() {
    query_request_lower_factory(payload, "reader", sqlite::build_query)(json::parse(r#"{
        "ctx":{"now":1709294400000},
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
            "time_windows":[{"node":"dog","dimension":"created_at",
                "start":{"calendar":"day","offset":-1},"end":"now"}]}
    }"#).unwrap!())
}, "calendar boundary requires request ctx.tz offset minutes");

pub def request_envelope_requires_now_when_referenced: test::Test = test::should_fail_with(fn() {
    query_request_lower_factory(payload, "reader", sqlite::build_query)(json::parse(r#"{
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
            "time_windows":[{"node":"dog","dimension":"created_at",
                "start":"2024-02-29T00:00:00Z", "end":"now"}]}
    }"#).unwrap!())
}, "now boundary requires request ctx.now");

pub def intent_rejects_old_ctx_reference: test::Test = test::should_fail_with(fn() {
    query_request_lower_factory(payload, "reader", sqlite::build_query)(json::parse(r#"{
        "ctx":{"now":1709280550000},
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
            "time_windows":[{"node":"dog","dimension":"created_at",
                "start":"2024-02-29T00:00:00Z",
                "end":{"ctx":"now"}}]}
    }"#).unwrap!())
}, "graph intent contains unsupported key");

pub def kindless_date_filter_uses_model_logical_type: test::Test = test::should_ok(fn() {
    let query = query_request_lower_factory(payload, "reader", sqlite::build_query)(json::parse(r#"{
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"birth_date"}],
            "filters":[{"node":"dog","dimension":"birth_date","op":"ge","value":"2024-02-29"}]}
    }"#).unwrap!());
    if query.bindings == [qb::Val::String("2024-02-29")] { True }
    else { fail!("date filter did not use model logical type", query) }
});

pub def kindless_now_filter_uses_model_encoding_and_comparison: test::Test = test::should_ok(fn() {
    let query = query_request_lower_factory(payload, "reader", sqlite::build_query)(json::parse(r#"{
        "ctx":{"now":1709280550123},
        "intent":{"op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
            "filters":[{"node":"dog","dimension":"created_at","op":"lt","value":"now"}]}
    }"#).unwrap!());
    if query.bindings == [qb::Val::String("2024-03-01T08:09:11Z")] { True }
    else { fail!("millisecond clock was not rounded for a second-resolution comparison", query) }
});

pub def now_before_unix_epoch_rounds_toward_next_second: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "dog", "created_at");
    match time::now_for(time::request_context(-1, None), role) {
        time::TimeValue::Rfc3339("1970-01-01T00:00:00Z") => True,
        other => fail!("negative epoch millisecond ceiling was incorrect", other),
    }
});

pub def exact_negative_epoch_second_uses_previous_calendar_day: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "dog", "created_at");
    match time::now_for(time::request_context(-1000, None), role) {
        time::TimeValue::Rfc3339("1969-12-31T23:59:59Z") => True,
        other => fail!("negative epoch second calendar conversion was incorrect", other),
    }
});

pub def epoch_request_clock_converts_to_rfc3339: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "dog", "created_at");
    match time::now_for(time::request_context(1709280550000, None), role) {
        time::TimeValue::Rfc3339("2024-03-01T08:09:10Z") => True,
        other => fail!("epoch clock conversion changed the instant", other),
    }
});

pub def ordinary_text_cannot_filter_rfc3339_field: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload, "reader")(json::parse(r#"{
        "op":"graph","root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
        "filters":[{"node":"dog","dimension":"created_at","op":"ge",
            "kind":"text","value":"2024-02-29T00:00:00Z"}]
    }"#).unwrap!())
}, "RFC3339 time field requires RFC3339 input");

pub def offset_rfc3339_requires_normalization_before_binding: test::Test = test::should_fail_with(fn() {
    time::window_filters(payload, "reader", "created_at", {
        start: time::TimeValue::Rfc3339("2024-03-01T08:00:00+08:00"),
        end: time::TimeValue::Rfc3339("2024-03-02T08:00:00+08:00")})
}, "invalid canonical RFC3339 UTC second value");

pub def rfc3339_preserves_four_digit_year_and_december: test::Test = test::should_ok(fn() {
    if edsl::canonical_rfc3339("0001-12-31T23:59:59Z")
        && edsl::calendar_date("2024-12-31")
        && !edsl::canonical_rfc3339("2025-02-29T00:00:00Z") { True }
    else { fail!("time validators lost a valid date or accepted a non-leap day") }
});

pub def relation_cannot_join_rfc3339_to_plain_string: test::Test = test::should_fail_with(fn() {
    edsl::build_root("incompatible-time-relation", [Dog.type, LegacyClock.type], profile,
        fn(subject) { subject == "reader" })
}, "relation fields have different logical time types or encodings");

pub def time_dimension_cannot_declare_plain_text_input: test::Test = test::should_fail_with(fn() {
    edsl::build_root("wrong-time-input-kind", [BadTimeDimension.type], profile,
        fn(subject) { subject == "reader" })
}, "plain dimension filter input or operation disagrees with field type");

pub def knowledge_exposes_logical_time_type_and_storage_encoding: test::Test = test::should_ok(fn() {
    let target: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::TimeRole,
        owner: "dog", id: "created_at"};
    match knowledge::by_target(payload, "reader", target) {
        knowledge::DocResult::Found(point) => match point.time_role {
            Some(role) => if role.logical_type == edsl::TimeLogicalType::Rfc3339
                && role.encoding == edsl::TimeEncoding::Rfc3339Text { True }
                else { fail!("time knowledge lost logical or storage type", role) },
            None => fail!("time knowledge has no role", point),
        },
        other => fail!("time role is not discoverable", other),
    }
});
