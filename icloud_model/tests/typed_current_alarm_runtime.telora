            alarm_case(`filter_\{dimension.id}_\{member.id}_\{op}`, `"select":[{"node":"a","dimension":"alarm_csn"}],"filters":[{"node":"a","dimension":"\{dimension.id}","op":"\{op}","value":"\{member.id}"}]`)
        }) })
    }),
    [alarm_case("totals", measure_selection),
     alarm_case("uncleared", `\{measure_selection},"filters":[{"node":"a","dimension":"alarm_cleared","op":"Eq","value":"uncleared"}]`),
     alarm_case("window", `\{measure_selection},"time_windows":[{"node":"a","dimension":"alarm_occur_utc_raw","start":2000,"end":7000}]`),
     alarm_case("severity_groups", r#""select":[{"node":"a","dimension":"alarm_severity"}],"measures":[{"node":"a","measure":"alarm_count"},{"node":"a","measure":"weighted_severe_alarm_score"}]"#),
     alarm_case("tenant_groups", r#""select":[{"node":"a","dimension":"alarm_tenant_id"}],"measures":[{"node":"a","measure":"alarm_count"}]"#),
     alarm_case("name_search", r#""select":[{"node":"a","dimension":"alarm_csn"}],"filters":[{"node":"a","dimension":"alarm_name","op":"Contains","value":"_%"}]"#),
    ],
    [
    pair("alarm_site_reference", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"},{"id":"p","entity":"site"}],"edges":[{"relation":"alarm_site_reference","from":"a","to":"p"}],"select":[{"node":"a","dimension":"alarm_csn"},{"node":"p","dimension":"site_id"}]}"#).unwrap!()),
    pair("alarm_belongs_to_tenant", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"},{"id":"p","entity":"tenant"}],"edges":[{"relation":"alarm_belongs_to_tenant","from":"a","to":"p"}],"select":[{"node":"a","dimension":"alarm_csn"},{"node":"p","dimension":"tenant_id"}]}"#).unwrap!()),
    pair("server_current_alarm", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"},{"id":"p","entity":"server_device"}],"edges":[{"relation":"server_current_alarm","from":"a","to":"p"}],"select":[{"node":"a","dimension":"alarm_csn"},{"node":"p","dimension":"server_name"}]}"#).unwrap!()),
    pair("device_current_alarm", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"},{"id":"p","entity":"device"}],"edges":[{"relation":"device_current_alarm","from":"a","to":"p"}],"select":[{"node":"a","dimension":"alarm_csn"},{"node":"p","dimension":"device_id"}]}"#).unwrap!()),
    pair("source_EntNetworkElement_T_CURRENT_ALARM", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"},{"id":"p","entity":"device"}],"edges":[{"relation":"source_EntNetworkElement_T_CURRENT_ALARM","from":"p","to":"a"}],"select":[{"node":"a","dimension":"alarm_csn"},{"node":"p","dimension":"device_id"}]}"#).unwrap!()),
    pair("source_X_TENANT_VIEW_T_CURRENT_ALARM", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"},{"id":"p","entity":"tenant"}],"edges":[{"relation":"source_X_TENANT_VIEW_T_CURRENT_ALARM","from":"p","to":"a"}],"select":[{"node":"a","dimension":"alarm_csn"},{"node":"p","dimension":"tenant_id"}]}"#).unwrap!()),
    pair("source_X_SITE_VIEW_T_CURRENT_ALARM", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"},{"id":"p","entity":"site"}],"edges":[{"relation":"source_X_SITE_VIEW_T_CURRENT_ALARM","from":"p","to":"a"}],"select":[{"node":"a","dimension":"alarm_csn"},{"node":"p","dimension":"site_id"}]}"#).unwrap!()),
