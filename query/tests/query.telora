    let plan: qb.Plan = {
        revision: "test-bad-identifier",
        sources: [qb.source("o", "order items")],
        projection: [qb.expr_item(qb.column("o", "id"))],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: 'None,
    };
    plan
