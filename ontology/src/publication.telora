# 模型发布：知识载荷、公开类型、codec 与两阶段查询协议。
use crate::typed_query as typed_query;
use crate::typed_query_protocol as protocol;
use crate::intent as intent;
use crate::ontology as edsl;
use crate::js_codec as js_codec;
use std::value::{Value};
use std::codec as codec;
use std::build as build;
use std::array as array;
use std::string as string;
use std::json as json;
use std::dict as dict;
use std::pipeline as pipeline;
use std::hash as hash;
type InputType = typed_query::PublishedType;
type Contract = struct {
    contract_id: String,
    abi_version: String,
    datasets: Array(typed_query::Dataset),
    relations: Array(typed_query::Relation),
    types: Array(InputType),
    codec_module: String
};
type ContractBody = struct {
    abi_version: String,
    datasets: Array(typed_query::Dataset),
    relations: Array(typed_query::Relation),
    types: Array(InputType),
    codec_module: String
};
type Program = struct {
    contract: Value,
    check: Fn(Value) -> Value,
    transform: Fn(Value) -> Value
};

def prepare: Fn(edsl::PreparedPayload, String, Array((String, typed_query::TypeRef)), intent::ToQuery) -> Program = fn(model, namespace, input_declarations, lower) {
    let collected: typed_query::Collected = typed_query::collect(model, namespace);
    let catalog: Array(typed_query::Dataset) = collected.datasets;
    let relations: Array(typed_query::Relation) = typed_query::relation_symbols(model,namespace);
    let input_refs: Array(typed_query::TypeRef) = array::map(
        input_declarations,
        fn(declared) {
            declared.1
        }
    );
    let input_types: Array(InputType) = array::map(
        array::enumerate(input_declarations),
        fn(pair) {
            {name: pair.1.0, logical: input_refs[pair.0].logical, storage: pair.1.1.storage}.ty!(
                InputType
            )
        }
    );
    # 自定义类型先去重；在这一边界之后才生成源码。
    let type_refs: Array(typed_query::TypeRef) = pipeline::run(
        pipeline::from_array(array::concat([collected.types, input_refs])) |> pipeline::distinct_by(
            typed_query::type_key
        ) |> pipeline::collect()
    );
    let public_types: Array(InputType) = array::concat([
        input_types,
        array::filter(typed_query::type_symbols(namespace, type_refs), fn(item) {
            !array::any(input_types, fn(declared) { declared.name == item.name })
        })
    ]);
    let codec_entries: String = string::join(
        array::flat_map(
            type_refs,
            fn(ref) {
                array::map(
                    js_codec::sources(ref.ty, ref.storage),
                    fn(source) {
                        let key = json::stringify(
                            codec::encode(typed_query::type_key(ref <~ {storage: source.storage}))
                        );
                        string::join([key, ":", source.code], "")
                    }
                )
            }
        ),
        ",\n"
    );
    let mapping_entries: String = string::join(
        array::map(
            array::filter(
                model.dimensions,
                fn(d) {
                    d.canonical_values != []
                }
            ),
            fn(d) {
                let key = json::stringify(
                    codec::encode(`\{model.entities[d.entity].id}/\{d.id}`)
                );
                `\{key}:\{js_codec::mapping_source(d)}`
            }
        ),
        ",\n"
    );
    let presentation_entries: String = string::join(array::map(type_refs,fn(ref){
        let key=json::stringify(codec::encode(typed_query::type_key(ref)));
        `\{key}:\{js_codec::presentation_source(ref.ty)}`
    }),",\n");
    let semantic_entries: String = string::join(array::map(type_refs,fn(ref){
        let key=json::stringify(codec::encode(typed_query::type_key(ref)));
        `\{key}:\{js_codec::semantic_source(ref.ty)}`
    }),",\n");
    let codec_module: String = `export function createCodecs(primary) { return Object.freeze({\{codec_entries}}); }\nexport const presentations = Object.freeze({\{presentation_entries}});\nexport const semantics = Object.freeze({\{semantic_entries}});\nexport const mappings = Object.freeze({\{mapping_entries}});\n//# sourceURL=ontology-generated-codecs.mjs\n`;
    let contract_id: String = hash::sha256(json::stringify(codec::encode({
        abi_version: "dari-model/v3", datasets: catalog, relations, types: public_types, codec_module
    }.ty!(ContractBody))));

    {
        contract: codec::encode(
            {contract_id, abi_version: "dari-model/v3", datasets: catalog, relations, types: public_types, codec_module}.ty!(Contract)
        ),
        check: fn(input) { protocol::check_type(model, catalog, relations, contract_id, input) },
        transform: intent::query_request_method_factory(model, lower)
    }.ty!(Program)
};

# 构建期计算目录和 codec，运行期只保留发布合同与查询闭包。
def stage: Fn(edsl::PreparedPayload, String, Array((String, typed_query::TypeRef)), intent::ToQuery) -> Program = fn(model, namespace, aliases, lower) {
    build::stage(
        fn() {
            let program = prepare(model, namespace, aliases, lower);
            let contract = codec::decode@[Contract](program.contract).unwrap!();
            {
                runtime: program,
                information: dict::from_pairs([("dari.codecs", codec::encode(contract.codec_module))])
            }
        },
        fn(program) { program }
    )
};

type Request = struct { method: String, input: Value };
def dispatch: Fn(Program, Value) -> Value = fn(program, input) {
    let request = codec::decode@[Request](input).unwrap!();
    if request.method == "contract" { program.contract }
    else if request.method == "check_type" { program.check(request.input) }
    else if request.method == "transform" { program.transform(request.input) }
    else { fail!("unknown DARI model ABI method", request.method) }
};
pub use self::{Program, Contract, prepare, stage, dispatch};
