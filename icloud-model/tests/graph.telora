        && string::contains(sq.sql, "sample.ts >=") && string::contains(sq.sql, "sample.ts <")
        && string::contains(sq.sql, "GROUP BY frame.name, device.name, frame.id, frame.tenantId, device.id, device.tenant_id")
        && string::contains(pg.sql, "max(\"sample\".\"cpuUsage\")")
