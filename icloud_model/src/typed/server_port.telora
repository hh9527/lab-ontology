use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("ServerPort")
type ServerPortById = struct(ComponentId);
@domain::subject("ServerPort", "source_id")
@domain::dataset("source_PhysicalServerPort", "PhysicalServerPort", ["source_id"])
@domain::relations(relations)
type PhysicalServerPort = struct {
    @m::column("name")
    @g::search("source_PhysicalServerPort__name")
    source_name: String,
    @m::column("tenantId")
    @g::exact("source_PhysicalServerPort__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("id")
    @g::exact("source_PhysicalServerPort__id")
    source_id: ServerPortById,
    @m::column("portType")
    @g::exact("source_PhysicalServerPort__portType_raw")
    @v::map(
        SourcePhysicalServerPortPortType.type,
        "source_PhysicalServerPort__portType",
        [
            v::member(SourcePhysicalServerPortPortType::OpticalPort, ["OpticalPort"]),
            v::member(SourcePhysicalServerPortPortType::ElectricalPort, ["ElectricalPort"])
        ]
    )
    source_portType: String,
    @m::column("linkStatus")
    @g::exact("source_PhysicalServerPort__linkStatus_raw")
    @v::map(
        SourcePhysicalServerPortLinkStatus.type,
        "source_PhysicalServerPort__linkStatus",
        [
            v::member(SourcePhysicalServerPortLinkStatus::LinkUp, ["Up"]),
            v::member(SourcePhysicalServerPortLinkStatus::LinkDown, ["Down"]),
            v::member(SourcePhysicalServerPortLinkStatus::NoLink, ["NoLink"]),
            v::member(SourcePhysicalServerPortLinkStatus::Unknown, ["Unknown"])
        ]
    )
    source_linkStatus: String,
    @m::column("cardResId")
    @g::exact("source_PhysicalServerPort__cardResId")
    source_cardResId: String,
    @m::column("macAddress")
    @g::search("source_PhysicalServerPort__macAddress")
    source_macAddress: String,
    @m::column("projectId")
    @g::exact("source_PhysicalServerPort__projectId")
    source_projectId: String,
    @m::column("parentResId")
    @g::exact("source_PhysicalServerPort__parentResId")
    source_parentResId: domain::Reference(server::ServerByOriginId),
};

def subject: r::Endpoint = domain::endpoint(PhysicalServerPort.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(PhysicalServerPort.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(PhysicalServerPort.type, "source_parentResId");

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerPortPortType = enum {
    @ev::description("OpticalPort", "光口")
    OpticalPort,

    @ev::description("ElectricalPort", "电口")
    ElectricalPort,
};

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerPortLinkStatus = enum {
    LinkUp,

    LinkDown,

    NoLink,

    @ev::description("Unknown", "未知")
    Unknown,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation("source_PhysicalServer_PhysicalServerPort", server::origin, parent, cardinality),
    r::relation(
        "source_PhysicalServerPort_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerPort, ServerPortById};

pub use self::{SourcePhysicalServerPortPortType, SourcePhysicalServerPortLinkStatus};
