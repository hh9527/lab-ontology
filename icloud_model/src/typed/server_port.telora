use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(
    String
);
@registry::entity("server_port_entity")
type Identity = struct {
    id: ComponentId
};
@registry::dataset("source_PhysicalServerPort", "PhysicalServerPort", ["source_id"])
@registry::roles([subject, tenant, parent])
@registry::relations(relations)
type PhysicalServerPort = struct {
    @m::column("name")
    @g::search("source_PhysicalServerPort__name")
    source_name: String,
    @m::column("tenantId")
    @g::exact("source_PhysicalServerPort__tenantId")
    source_tenantId: i::TenantId,
    @m::column("id")
    @g::exact("source_PhysicalServerPort__id")
    source_id: ComponentId,
    @m::column("portType")
    @v::classification(
        SourcePhysicalServerPortPortType_domain,
        "source_PhysicalServerPort__portType"
    )
    source_portType: String,
    @m::column("linkStatus")
    @v::classification(
        SourcePhysicalServerPortLinkStatus_domain,
        "source_PhysicalServerPort__linkStatus"
    )
    source_linkStatus: String,
    @m::column("cardResId")
    @g::exact("source_PhysicalServerPort__cardResId")
    source_cardResId: String,
    @m::column("macAddress")
    @g::search("source_PhysicalServerPort__macAddress")
    source_macAddress: String,
    @m::column("projectId")
    @g::exact("source_PhysicalServerPort__projectId")
    source_projectId: String,
    @m::column("parentResId")
    @g::exact("source_PhysicalServerPort__parentResId")
    source_parentResId: server::ServerOriginId,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(PhysicalServerPort) = registry::dataset_of(PhysicalServerPort.type);
def subject: m::Role(PhysicalServerPort) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerPort.type, ComponentId.type, "source_id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServerPort) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerPort.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent: m::Role(PhysicalServerPort) = m::role(
    dataset,
    server::origin_entity,
    "server_origin",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerPort.type, server::ServerOriginId.type, "source_parentResId"),
            m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerPortPortType = enum {
    @ev::rename("OpticalPort")
    @ev::description("OpticalPort", "光口")
    OpticalPort,
    @ev::rename("ElectricalPort")
    @ev::description("ElectricalPort", "电口")
    ElectricalPort,
};
def SourcePhysicalServerPortPortType_domain: v::Domain(SourcePhysicalServerPortPortType, String) = v::from_enum(
    "SourcePhysicalServerPortPortType",
    SourcePhysicalServerPortPortType.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerPortLinkStatus = enum {
    @ev::rename("Up")
    LinkUp,
    @ev::rename("Down")
    LinkDown,
    @ev::rename("NoLink")
    NoLink,
    @ev::rename("Unknown")
    @ev::description("Unknown", "未知")
    Unknown,
};
def SourcePhysicalServerPortLinkStatus_domain: v::Domain(SourcePhysicalServerPortLinkStatus, String) = v::from_enum(
    "SourcePhysicalServerPortLinkStatus",
    SourcePhysicalServerPortLinkStatus.type,
    String.type,
    False
);
def declaration: t::Declaration = registry::declaration(PhysicalServerPort.type);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_PhysicalServer_PhysicalServerPort",
        server::dataset,
        server::origin,
        dataset,
        parent,
        cardinality
    ),
    r::relation(
        "source_PhysicalServerPort_X_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        cardinality
    ),
];
pub use self::{declaration, relations};

pub use self::{PhysicalServerPort, Identity};
