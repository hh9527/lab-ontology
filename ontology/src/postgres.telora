use std::array as array;
use std::string as string;
use crate::query as qb;

def path_value: Fn(qb::JsonPathSegment) -> qb::Val = fn(segment) {
    match segment {
        qb::JsonPathSegment::Key(key) => qb::Val::String(key),
        qb::JsonPathSegment::Index(index) => qb::Val::String(`\{index}`),
        qb::JsonPathSegment::FromEnd(index) => qb::Val::String(`-\{index}`),
    }
};

type RenderCtx = struct {
    next_binding: Int,
    bindings: Array(qb::Val),
    builder_bindings: Array(qb::Val),
    reserved_aliases: Array(String),
    next_alias: Int,
};

type Emitted = struct { sql: String, ctx: RenderCtx };

pub def context: Fn(Int, Array(String)) -> RenderCtx = fn(start, reserved) {
    if start <= 0 { fail!("PostgreSQL placeholder index must be positive", start) }
    else { {next_binding: start, bindings: [], builder_bindings: [], reserved_aliases: reserved, next_alias: 0} }
};

def bind: Fn(RenderCtx, qb::Val) -> Emitted = fn(ctx, value) {
    {sql: `$\{ctx.next_binding}`, ctx: {...ctx,
        next_binding: ctx.next_binding + 1,
        bindings: array::push(ctx.bindings, value)}}
};

pub def internal_alias: Fn(RenderCtx) -> Tuple([String, RenderCtx]) = fn(ctx) {
    let candidate = `__q_\{ctx.next_alias}`;
    let next: RenderCtx = {...ctx, next_alias: ctx.next_alias + 1};
    if array::any(ctx.reserved_aliases, fn(name) { name == candidate }) {
        internal_alias(next)
    } else {
        (candidate, {...next, reserved_aliases: array::push(next.reserved_aliases, candidate)})
    }
};

def path_expr: Fn(qb::JsonPath, RenderCtx) -> Emitted = fn(path, ctx) {
    let initial: Emitted = {sql: "", ctx};
    let args = array::fold(path.segments, initial, fn(state, segment) {
        let allocated = bind(state.ctx, path_value(segment));
        let sql = if state.sql == "" { `\{allocated.sql}::text` }
            else { `\{state.sql}, \{allocated.sql}::text` };
        {sql, ctx: allocated.ctx}
    });
    let sql = if array::length(path.segments) == 0 { "ARRAY[]::text[]" }
        else { `ARRAY[\{args.sql}]` };
    {sql, ctx: args.ctx}
};

def json_value: Fn(String, String) -> String = fn(document, path) {
    `json_extract_path(\{document}::json, VARIADIC \{path})`
};

def json_text: Fn(String, String) -> String = fn(document, path) {
    `json_extract_path_text(\{document}::json, VARIADIC \{path})`
};

def scalar_sql: Fn(qb::ScalarFunction, Array(String)) -> String = fn(function, parts) {
    match function {
        qb::ScalarFunction::Substr => `substr(\{string::join(parts, ", ")})`,
        qb::ScalarFunction::Instr => `strpos(\{parts[0]}, \{parts[1]})`,
        qb::ScalarFunction::If => `CASE WHEN \{parts[0]} THEN \{parts[1]} ELSE \{parts[2]} END`,
        qb::ScalarFunction::Add => `(\{parts[0]} + \{parts[1]})`,
        qb::ScalarFunction::Sub => `(\{parts[0]} - \{parts[1]})`,
        qb::ScalarFunction::Lower => `translate(\{parts[0]}, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')`,
        qb::ScalarFunction::Length => `char_length(\{parts[0]})`,
        qb::ScalarFunction::JsonExtractText => json_text(parts[0], parts[1]),
        qb::ScalarFunction::JsonExtractInt => `(\{json_text(parts[0], parts[1])})::bigint`,
        qb::ScalarFunction::JsonExtractNumber => `(\{json_text(parts[0], parts[1])})::double precision`,
        qb::ScalarFunction::JsonType => {
            let value = json_value(parts[0], parts[1]);
            `CASE WHEN \{value} IS NULL THEN NULL WHEN json_typeof(\{value}) = 'number' THEN CASE WHEN \{value}::text ~ '[.eE]' THEN 'real' ELSE 'integer' END WHEN json_typeof(\{value}) = 'boolean' THEN \{value}::text ELSE json_typeof(\{value}) END`
        },
        qb::ScalarFunction::JsonValid => `CASE WHEN \{parts[0]} IS NULL THEN 0 WHEN pg_input_is_valid(\{parts[0]}::text, 'json') THEN 1 ELSE 0 END`,
        qb::ScalarFunction::UtcDaysAgo => `to_char((\{parts[0]}::timestamptz - make_interval(days => \{parts[1]}::integer)) AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"')`,
        qb::ScalarFunction::Eq => `\{parts[0]} = \{parts[1]}`,
        qb::ScalarFunction::Ne => `\{parts[0]} != \{parts[1]}`,
        qb::ScalarFunction::Lt => `\{parts[0]} < \{parts[1]}`,
        qb::ScalarFunction::Le => `\{parts[0]} <= \{parts[1]}`,
        qb::ScalarFunction::Gt => `\{parts[0]} > \{parts[1]}`,
        qb::ScalarFunction::Ge => `\{parts[0]} >= \{parts[1]}`,
        qb::ScalarFunction::And => `(\{parts[0]} AND \{parts[1]})`,
        qb::ScalarFunction::Or => `(\{parts[0]} OR \{parts[1]})`,
        qb::ScalarFunction::Not => `NOT (\{parts[0]})`,
    }
};

type Arguments = struct { sql: Array(String), ctx: RenderCtx };

# The context owns all placeholder assignments, even in nested scalars.
pub def emit_expr: Fn(qb::Expr, RenderCtx) -> Emitted = fn(expr, ctx) {
    match expr {
        qb::Expr::Column(ref) => if qb::is_sql_identifier(ref.source) && qb::is_sql_identifier(ref.column) {
            {sql: `"\{ref.source}"."\{ref.column}"`, ctx}
        } else { fail!("invalid PostgreSQL column identifier", ref) },
        qb::Expr::Bind(value) => bind(ctx, value),
        qb::Expr::AllocatedBind(binding) => if binding.index > 0
            && binding.index <= array::length(ctx.builder_bindings) {
            {sql: `$\{binding.index}`, ctx}
        } else { fail!("binding handle is not registered in builder context", binding) },
        qb::Expr::JsonPath(path) => path_expr(path, ctx),
        qb::Expr::Scalar(call) => {
            let initial: Arguments = {sql: [], ctx};
            let args = array::fold(call.args, initial, fn(state, arg) {
                let rendered = emit_expr(arg, state.ctx);
                {sql: array::push(state.sql, rendered.sql), ctx: rendered.ctx}
            });
            {sql: scalar_sql(call.function, args.sql), ctx: args.ctx}
        },
    }
};

pub def render_expr: Fn(qb::Expr, Int) -> qb::Query = fn(expr, start) {
    let emitted = emit_expr(expr, context(start, []));
    {sql: emitted.sql, bindings: emitted.ctx.bindings}
};

pub def render_expr_with_context: Fn(qb::Expr, qb::BuildCtx) -> qb::Query = fn(expr, builder) {
    let initial: RenderCtx = {...context(1, []), builder_bindings: builder.bindings};
    let emitted = emit_expr(expr, initial);
    if array::length(emitted.ctx.bindings) != 0 {
        fail!("context-bound expression cannot mix legacy bindings", expr)
    } else { {sql: emitted.sql, bindings: builder.bindings} }
};

def quoted: Fn(String) -> String = fn(identifier) {
    if qb::is_sql_identifier(identifier) { `"\{identifier}"` }
    else { fail!("invalid PostgreSQL identifier", identifier) }
};

def render_exprs: Fn(Array(qb::Expr), RenderCtx) -> Emitted = fn(exprs, ctx) {
    let initial: Arguments = {sql: [], ctx};
    let parts = array::fold(exprs, initial, fn(state, expr) {
        let value = emit_expr(expr, state.ctx);
        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
    });
    {sql: string::join(parts.sql, ", "), ctx: parts.ctx}
};

def render_source: Fn(qb::Source, RenderCtx) -> Emitted = fn(source, ctx) {
    let table = quoted(source.table);
    let alias = quoted(source.alias);
    match source.scope {
        None => {sql: `\{table} AS \{alias}`, ctx},
        Some(expr) => {
            let predicate = emit_expr(expr, ctx);
            {sql: `(SELECT * FROM \{table} AS \{alias} WHERE \{predicate.sql}) AS \{alias}`,
                ctx: predicate.ctx}
        },
    }
};

def render_branch: Fn(qb::UnionBranch, RenderCtx) -> Emitted = fn(branch, ctx) {
    let initial: Arguments = {sql: [], ctx};
    let items = array::fold(branch.outputs, initial, fn(state, item) {
        let value = emit_expr(item.expr, state.ctx);
        {sql: array::push(state.sql, `\{value.sql} AS \{quoted(item.name)}`), ctx: value.ctx}
    });
    let source = render_source(branch.source, items.ctx);
    let filtered: Emitted = match branch.filter {
        Some(expr) => {
            let value = emit_expr(expr, source.ctx);
            {sql: ` WHERE \{value.sql}`, ctx: value.ctx}
        },
        None => {sql: "", ctx: source.ctx},
    };
    {sql: `SELECT \{string::join(items.sql, ", ")} FROM \{source.sql}\{filtered.sql}`,
        ctx: filtered.ctx}
};

def render_from: Fn(qb::Plan, RenderCtx) -> Emitted = fn(plan, ctx) {
    match plan.derived {
        None => render_source(plan.sources[0], ctx),
        Some(derived) => {
            let initial: Arguments = {sql: [], ctx};
            let branches = array::fold(derived.branches, initial, fn(state, branch) {
                let value = render_branch(branch, state.ctx);
                {sql: array::push(state.sql, value.sql), ctx: value.ctx}
            });
            {sql: `(\{string::join(branches.sql, " UNION ALL ")}) AS \{quoted(derived.alias)}`,
                ctx: branches.ctx}
        },
    }
};

def column_sql: Fn(qb::ColumnRef) -> String = fn(ref) {
    `\{quoted(ref.source)}.\{quoted(ref.column)}`
};

def render_on: Fn(qb::JoinCondition, RenderCtx) -> Emitted = fn(condition, ctx) {
    match condition {
        qb::JoinCondition::Eq(eq) => {sql: `\{column_sql(eq.left)} = \{column_sql(eq.right)}`, ctx},
        qb::JoinCondition::Predicate(expr) => emit_expr(expr, ctx),
        qb::JoinCondition::And(items) => {
            let initial: Arguments = {sql: [], ctx};
            let parts = array::fold(items, initial, fn(state, item) {
                let value = render_on(item, state.ctx);
                {sql: array::push(state.sql, value.sql), ctx: value.ctx}
            });
            {sql: `(\{string::join(parts.sql, " AND ")})`, ctx: parts.ctx}
        },
        qb::JoinCondition::Or(items) => {
            let initial: Arguments = {sql: [], ctx};
            let parts = array::fold(items, initial, fn(state, item) {
                let value = render_on(item, state.ctx);
                {sql: array::push(state.sql, value.sql), ctx: value.ctx}
            });
            {sql: `(\{string::join(parts.sql, " OR ")})`, ctx: parts.ctx}
        },
    }
};

def render_join: Fn(qb::Join, RenderCtx) -> Emitted = fn(join, ctx) {
    let source = render_source(join.source, ctx);
    let on = render_on(join.condition, source.ctx);
    let kind = match join.kind {
        qb::JoinKind::Inner => "INNER JOIN",
        qb::JoinKind::Left => "LEFT JOIN",
    };
    {sql: `\{kind} \{source.sql} ON \{on.sql}`, ctx: on.ctx}
};

def aggregate: Fn(qb::AggregateCall, RenderCtx) -> Emitted = fn(call, ctx) {
    let arg = emit_expr(call.arg, ctx);
    let distinct = if call.distinct { "DISTINCT " } else { "" };
    let filtered: Emitted = match call.filter {
        Some(expr) => {
            let value = emit_expr(expr, arg.ctx);
            {sql: ` FILTER (WHERE \{value.sql})`, ctx: value.ctx}
        },
        None => {sql: "", ctx: arg.ctx},
    };
    {sql: `\{qb::aggregate_name(call.function)}(\{distinct}\{arg.sql})\{filtered.sql}`,
        ctx: filtered.ctx}
};

def measure: Fn(qb::Plan, String, RenderCtx) -> Emitted = fn(plan, name, ctx) {
    let found = array::find(plan.projection, fn(item) {
        match item {
            qb::SelectItem::Aggregate(call) => call.alias == name,
            qb::SelectItem::Computed(ca) => ca.alias == name,
            _ => False,
        }
    });
    match found {
        Some(qb::SelectItem::Aggregate(call)) => aggregate(call, ctx),
        Some(qb::SelectItem::Computed(ca)) => {
            let left = measure(plan, ca.left, ctx);
            let right = measure(plan, ca.right, left.ctx);
            let op = match ca.op { qb::ComputedOp::Add => "+", qb::ComputedOp::Sub => "-" };
            {sql: `(\{left.sql} \{op} \{right.sql})`, ctx: right.ctx}
        },
        _ => fail!("PostgreSQL measure references an undeclared aggregate", name),
    }
};

def select_item: Fn(qb::SelectItem, qb::Plan, RenderCtx) -> Emitted = fn(item, plan, ctx) {
    match item {
        qb::SelectItem::Expr(expr) => emit_expr(expr, ctx),
        qb::SelectItem::NamedExpr(named) => {
            let value = emit_expr(named.expr, ctx);
            {sql: `\{value.sql} AS \{quoted(named.alias)}`, ctx: value.ctx}
        },
        qb::SelectItem::Aggregate(call) => {
            let value = aggregate(call, ctx);
            {sql: `\{value.sql} AS \{quoted(call.alias)}`, ctx: value.ctx}
        },
        qb::SelectItem::Computed(ca) => {
            let value = measure(plan, ca.alias, ctx);
            {sql: `\{value.sql} AS \{quoted(ca.alias)}`, ctx: value.ctx}
        },
    }
};

def order_key: Fn(qb::OrderKey, qb::Plan, RenderCtx) -> Emitted = fn(key, plan, ctx) {
    match key {
        qb::OrderKey::Expr(expr) => emit_expr(expr, ctx),
        qb::OrderKey::AggregateRef(ref) => measure(plan, ref.alias, ctx),
        qb::OrderKey::Aggregate(call) => aggregate(call, ctx),
    }
};

def order_item: Fn(qb::OrderBy, qb::Plan, RenderCtx) -> Emitted = fn(item, plan, ctx) {
    let key = order_key(item.key, plan, ctx);
    let suffix = match item.direction {
        qb::Ordering::Asc => "ASC NULLS FIRST",
        qb::Ordering::Desc => "DESC NULLS LAST",
    };
    {sql: `\{key.sql} \{suffix}`, ctx: key.ctx}
};

def having_item: Fn(qb::Having, qb::Plan, RenderCtx) -> Emitted = fn(item, plan, ctx) {
    let value = match item.measure {
        qb::HavingMeasure::Ref(ref) => measure(plan, ref.alias, ctx),
        qb::HavingMeasure::Call(call) => aggregate(call, ctx),
    };
    let op = match item.op {
        qb::HavingOp::Eq => "=", qb::HavingOp::Ne => "!=",
        qb::HavingOp::Lt => "<", qb::HavingOp::Le => "<=",
        qb::HavingOp::Gt => ">", qb::HavingOp::Ge => ">=",
    };
    let threshold = bind(value.ctx, item.threshold);
    {sql: `\{value.sql} \{op} \{threshold.sql}`, ctx: threshold.ctx}
};

def pair_sql: Fn(qb::ColumnEq) -> String = fn(pair) {
    `\{column_sql(pair.left)} = \{column_sql(pair.right)}`
};

def correlations: Fn(qb::Exists) -> String = fn(ex) {
    match ex.alternatives {
        Some(branches) => {
            let sql = array::map(branches, fn(branch) {
                `(\{string::join(array::map(branch, pair_sql), " AND ")})`
            });
            `(\{string::join(sql, " OR ")})`
        },
        None => string::join(array::map(ex.pairs, pair_sql), " AND "),
    }
};

def exists_having: Fn(qb::Having, RenderCtx) -> Emitted = fn(item, ctx) {
    match item.measure {
        qb::HavingMeasure::Call(call) => {
            let value = aggregate(call, ctx);
            let op = match item.op {
                qb::HavingOp::Eq => "=", qb::HavingOp::Ne => "!=",
                qb::HavingOp::Lt => "<", qb::HavingOp::Le => "<=",
                qb::HavingOp::Gt => ">", qb::HavingOp::Ge => ">=",
            };
            let threshold = bind(value.ctx, item.threshold);
            {sql: `\{value.sql} \{op} \{threshold.sql}`, ctx: threshold.ctx}
        },
        qb::HavingMeasure::Ref(_) => fail!("EXISTS HAVING requires a direct aggregate", item),
    }
};

def render_peer: Fn(qb::PeerCorr, RenderCtx) -> Emitted = fn(corr, ctx) {
    let origin = render_source(corr.origin, ctx);
    let peer = render_source(corr.peer, origin.ctx);
    let first = `(\{pair_sql(corr.branch_a.origin)} AND \{pair_sql(corr.branch_a.peer)})`;
    let second = `(\{pair_sql(corr.branch_b.origin)} AND \{pair_sql(corr.branch_b.peer)})`;
    let exchange = if corr.exchange { `(\{first} OR \{second})` } else { first };
    let distinct = if corr.distinct_keys {
        ` AND \{column_sql(corr.branch_a.origin.right)} <> \{column_sql(corr.branch_a.peer.right)}`
    } else { "" };
    let origin_filter: Emitted = match corr.origin_filter {
        Some(expr) => emit_expr(expr, peer.ctx), None => {sql: "", ctx: peer.ctx},
    };
    let peer_filter: Emitted = match corr.peer_filter {
        Some(expr) => emit_expr(expr, origin_filter.ctx), None => {sql: "", ctx: origin_filter.ctx},
    };
    let origin_sql = if corr.origin_filter != None { ` AND \{origin_filter.sql}` } else { "" };
    let peer_sql = if corr.peer_filter != None { ` AND \{peer_filter.sql}` } else { "" };
    {sql: `SELECT 1 FROM \{origin.sql}, \{peer.sql} WHERE \{exchange}\{distinct}\{origin_sql}\{peer_sql}`,
        ctx: peer_filter.ctx}
};

def render_link: Fn(qb::Exists, qb::ExistsLink, RenderCtx) -> Emitted = fn(ex, link, ctx) {
    let hop = render_source(ex.source, ctx);
    let next = render_source(link.source, hop.ctx);
    let tail: Emitted = match link.tail {
        Some(item) => {
            let source = render_source(item.source, next.ctx);
            {sql: ` INNER JOIN \{source.sql} ON \{string::join(array::map(item.pairs, pair_sql), " AND ")}`,
                ctx: source.ctx}
        },
        None => {sql: "", ctx: next.ctx},
    };
    let filtered: Emitted = match link.filter {
        Some(expr) => emit_expr(expr, tail.ctx), None => {sql: "", ctx: tail.ctx},
    };
    let on = match link.alternatives {
        Some(branches) => `(\{string::join(array::map(branches, fn(branch) {
            `(\{string::join(array::map(branch, pair_sql), " AND ")})`
        }), " OR ")})`,
        None => string::join(array::map(link.pairs, pair_sql), " AND "),
    };
    let where_filter = if link.filter != None { ` AND \{filtered.sql}` } else { "" };
    {sql: `SELECT 1 FROM \{hop.sql} INNER JOIN \{next.sql} ON \{on}\{tail.sql} WHERE \{correlations(ex)}\{where_filter}`,
        ctx: filtered.ctx}
};

def render_exists: Fn(qb::Exists, RenderCtx) -> Emitted = fn(ex, ctx) {
    let prefix = if ex.negated { "NOT EXISTS" } else { "EXISTS" };
    match ex.peer {
        Some(corr) => {
            let body = render_peer(corr, ctx);
            {sql: `\{prefix} (\{body.sql})`, ctx: body.ctx}
        },
        None => match ex.link {
            Some(link) => {
                let body = render_link(ex, link, ctx);
                {sql: `\{prefix} (\{body.sql})`, ctx: body.ctx}
            },
            None => {
        let source = render_source(ex.source, ctx);
        let filter: Emitted = match ex.filter {
            Some(expr) => emit_expr(expr, source.ctx),
            None => {sql: "", ctx: source.ctx},
        };
        let grouping = render_exprs(ex.grouping, filter.ctx);
        let initial: Arguments = {sql: [], ctx: grouping.ctx};
        let having = array::fold(ex.having, initial, fn(state, item) {
            let value = exists_having(item, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        });
        let filter_sql = if ex.filter != None { ` AND \{filter.sql}` } else { "" };
        let group_sql = if array::length(ex.grouping) > 0 { ` GROUP BY \{grouping.sql}` } else { "" };
        let having_sql = if array::length(ex.having) > 0 { ` HAVING \{string::join(having.sql, " AND ")}` } else { "" };
        {sql: `\{prefix} (SELECT 1 FROM \{source.sql} WHERE \{correlations(ex)}\{filter_sql}\{group_sql}\{having_sql})`,
            ctx: having.ctx}
            },
        },
    }
};

def comparison_op: Fn(qb::ScalarFunction) -> String = fn(op) {
    match op {
        qb::ScalarFunction::Eq => "=", qb::ScalarFunction::Ne => "!=",
        qb::ScalarFunction::Lt => "<", qb::ScalarFunction::Le => "<=",
        qb::ScalarFunction::Gt => ">", qb::ScalarFunction::Ge => ">=",
        _ => fail!("invalid scalar comparison operator", op),
    }
};

def render_scalar_comparison: Fn(qb::ScalarAggregateComparison, RenderCtx) -> Emitted = fn(cmp, ctx) {
    let sq = cmp.inner;
    let call: qb::AggregateCall = {
        function: sq.function, arg: sq.arg, distinct: sq.distinct,
        filter: sq.agg_filter, alias: "__scalar_value",
    };
    let value = aggregate(call, ctx);
    let source = render_source(sq.source, value.ctx);
    let initial: Arguments = {sql: [], ctx: source.ctx};
    let joins = array::fold(sq.joins, initial, fn(state, join) {
        let emitted = render_join(join, state.ctx);
        {sql: array::push(state.sql, emitted.sql), ctx: emitted.ctx}
    });
    let filtered: Emitted = match sq.filter {
        Some(expr) => emit_expr(expr, joins.ctx), None => {sql: "", ctx: joins.ctx},
    };
    let join_sql = if array::length(sq.joins) > 0 { ` \{string::join(joins.sql, " ")}` } else { "" };
    let filter_sql = if sq.filter != None { ` WHERE \{filtered.sql}` } else { "" };
    {sql: `\{column_sql(cmp.outer)} \{comparison_op(cmp.op)} (SELECT \{value.sql} FROM \{source.sql}\{join_sql}\{filter_sql})`,
        ctx: filtered.ctx}
};

def render_ranked_comparison: Fn(qb::RankedKeyComparison, RenderCtx) -> Emitted = fn(cmp, ctx) {
    let sq = cmp.inner;
    let key = render_exprs(sq.keys, ctx);
    let source = render_source(sq.source, key.ctx);
    let initial: Arguments = {sql: [], ctx: source.ctx};
    let joins = array::fold(sq.joins, initial, fn(state, join) {
        let emitted = render_join(join, state.ctx);
        {sql: array::push(state.sql, emitted.sql), ctx: emitted.ctx}
    });
    let filtered: Emitted = match sq.filter {
        Some(expr) => emit_expr(expr, joins.ctx), None => {sql: "", ctx: joins.ctx},
    };
    let ordering = aggregate(sq.order, filtered.ctx);
    let direction = match sq.direction {
        qb::Ordering::Asc => "ASC NULLS FIRST",
        qb::Ordering::Desc => "DESC NULLS LAST",
    };
    let join_sql = if array::length(sq.joins) > 0 { ` \{string::join(joins.sql, " ")}` } else { "" };
    let filter_sql = if sq.filter != None { ` WHERE \{filtered.sql}` } else { "" };
    # The single projected key is the group key; referencing its SELECT position
    # prevents a bound key expression from becoming a different PG expression.
    {sql: `\{column_sql(cmp.outer)} \{comparison_op(cmp.op)} (SELECT \{key.sql} FROM \{source.sql}\{join_sql}\{filter_sql} GROUP BY 1 ORDER BY \{ordering.sql} \{direction} LIMIT 1)`,
        ctx: ordering.ctx}
};

def render_where: Fn(qb::Plan, RenderCtx) -> Emitted = fn(plan, ctx) {
    let filtered: Emitted = match plan.filter {
        Some(expr) => emit_expr(expr, ctx),
        None => {sql: "", ctx},
    };
    let initial: Arguments = {sql: if plan.filter != None { [filtered.sql] } else { [] }, ctx: filtered.ctx};
    let exists_terms = array::fold(plan.exists, initial, fn(state, ex) {
        let value = render_exists(ex, state.ctx);
        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
    });
    let scalar_terms = array::fold(plan.scalar_comparisons, exists_terms, fn(state, cmp) {
        let value = render_scalar_comparison(cmp, state.ctx);
        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
    });
    let terms = array::fold(plan.ranked_key_comparisons, scalar_terms, fn(state, cmp) {
        let value = render_ranked_comparison(cmp, state.ctx);
        {sql: array::push(state.sql, value.sql), ctx: value.ctx}
    });
    let sql = if array::length(terms.sql) > 0 { ` WHERE \{string::join(terms.sql, " AND ")}` } else { "" };
    {sql, ctx: terms.ctx}
};

def plan_aliases: Fn(qb::Plan) -> Array(String) = fn(plan) {
    let derived_aliases = match plan.derived {
        Some(derived) => array::concat([[derived.alias],
            array::map(derived.branches, fn(branch) { branch.source.alias })]),
        None => [],
    };
    array::concat([
        array::map(plan.sources, fn(source) { source.alias }),
        array::map(plan.joins, fn(join) { join.source.alias }),
        array::concat(array::map(plan.projection, fn(item) {
            match item {
                qb::SelectItem::Expr(_) => [],
                qb::SelectItem::NamedExpr(named) => [named.alias],
                qb::SelectItem::Aggregate(call) => [call.alias],
                qb::SelectItem::Computed(ca) => [ca.alias],
            }
        })),
        array::map(plan.exists, fn(ex) { ex.source.alias }),
        array::concat(array::map(plan.scalar_comparisons, fn(cmp) {
            array::concat([[cmp.inner.source.alias],
                array::map(cmp.inner.joins, fn(join) { join.source.alias })])
        })),
        array::concat(array::map(plan.ranked_key_comparisons, fn(cmp) {
            array::concat([[cmp.inner.source.alias],
                array::map(cmp.inner.joins, fn(join) { join.source.alias })])
        })),
        array::concat(array::map(plan.exists, fn(ex) {
            match ex.peer {
                Some(corr) => [corr.peer.alias],
                None => match ex.link {
                    Some(link) => match link.tail {
                        Some(tail) => [link.source.alias, tail.source.alias],
                        None => [link.source.alias],
                    },
                    None => [],
                },
            }
        })),
        derived_aliases,
    ])
};

def plan_context: Fn(qb::Plan) -> RenderCtx = fn(plan) {
    context(1, plan_aliases(plan))
};

type PartitionItem = struct {sql: String, value: String, alias: String, ctx: RenderCtx};
type ExprBinding = struct {expr: qb::Expr, sql: String, alias: String};
type PartitionItems = struct {sql: Array(String), aliases: Array(String), expressions: Array(ExprBinding), ctx: RenderCtx};

def partition_item: Fn(qb::SelectItem, qb::Plan, RenderCtx) -> PartitionItem = fn(item, plan, ctx) {
    match item {
        qb::SelectItem::Expr(expr) => {
            let emitted = emit_expr(expr, ctx);
            let allocated = internal_alias(emitted.ctx);
            {sql: `\{emitted.sql} AS \{quoted(allocated.0)}`, value: emitted.sql, alias: allocated.0, ctx: allocated.1}
        },
        qb::SelectItem::NamedExpr(named) => {
            let emitted = emit_expr(named.expr, ctx);
            {sql: `\{emitted.sql} AS \{quoted(named.alias)}`, value: emitted.sql, alias: named.alias, ctx: emitted.ctx}
        },
        qb::SelectItem::Aggregate(call) => {
            let emitted = aggregate(call, ctx);
            {sql: `\{emitted.sql} AS \{quoted(call.alias)}`, value: emitted.sql, alias: call.alias, ctx: emitted.ctx}
        },
        qb::SelectItem::Computed(ca) => {
            let emitted = measure(plan, ca.alias, ctx);
            {sql: `\{emitted.sql} AS \{quoted(ca.alias)}`, value: emitted.sql, alias: ca.alias, ctx: emitted.ctx}
        },
    }
};

def find_expression: Fn(qb::Expr, Array(ExprBinding)) -> Option(ExprBinding) = fn(expr, expressions) {
    array::find(expressions, fn(item) { item.expr == expr })
};

type PartitionKeys = struct {hidden: Array(String), outer: Array(String), expressions: Array(ExprBinding), ctx: RenderCtx};

def partition_key: Fn(qb::Expr, PartitionKeys) -> PartitionKeys = fn(expr, state) {
    match find_expression(expr, state.expressions) {
        Some(found) => {hidden: state.hidden, outer: array::push(state.outer, found.alias), expressions: state.expressions, ctx: state.ctx},
        None => {
            let emitted = emit_expr(expr, state.ctx);
            let allocated = internal_alias(emitted.ctx);
            let binding: ExprBinding = {expr, sql: emitted.sql, alias: allocated.0};
            {hidden: array::push(state.hidden, `\{emitted.sql} AS \{quoted(allocated.0)}`),
                outer: array::push(state.outer, allocated.0),
                expressions: array::push(state.expressions, binding), ctx: allocated.1}
        },
    }
};

def partition_order_key: Fn(qb::OrderBy, PartitionKeys) -> PartitionKeys = fn(item, state) {
    match item.key {
        qb::OrderKey::Expr(expr) => partition_key(expr, state),
        qb::OrderKey::AggregateRef(ref) => {
            {hidden: state.hidden, outer: array::push(state.outer, ref.alias), expressions: state.expressions, ctx: state.ctx}
        },
        qb::OrderKey::Aggregate(_) => fail!("partition ordering requires a projected aggregate", item),
    }
};

def emit_partitioned: Fn(qb::Plan, qb::PartitionedTopN, RenderCtx) -> Emitted = fn(plan, pt, ctx) {
    let initial: PartitionItems = {sql: [], aliases: [], expressions: [], ctx};
    let selected = array::fold(plan.projection, initial, fn(state, item) {
        let emitted = partition_item(item, plan, state.ctx);
        let expressions = match item {
            qb::SelectItem::Expr(expr) => array::push(state.expressions,
                {expr, sql: emitted.value, alias: emitted.alias}),
            qb::SelectItem::NamedExpr(named) => array::push(state.expressions,
                {expr: named.expr, sql: emitted.value, alias: emitted.alias}),
            _ => state.expressions,
        };
        {sql: array::push(state.sql, emitted.sql),
            aliases: array::push(state.aliases, emitted.alias), expressions, ctx: emitted.ctx}
    });
    let key_initial: PartitionKeys = {hidden: [], outer: [], expressions: selected.expressions, ctx: selected.ctx};
    let partition = array::fold(pt.partition_by, key_initial, fn(state, expr) {
        partition_key(expr, state)
    });
    let order_initial: PartitionKeys = {hidden: [], outer: [], expressions: partition.expressions, ctx: partition.ctx};
    let ordered = array::fold(pt.order_by, order_initial, fn(state, item) {
        partition_order_key(item, state)
    });
    let window_partition = array::map(pt.partition_by, fn(expr) {
        match find_expression(expr, ordered.expressions) {
            Some(found) => found.sql,
            None => fail!("partition key was not rendered", expr),
        }
    });
    let window_initial: Arguments = {sql: [], ctx: ordered.ctx};
    let window_order = array::fold(pt.order_by, window_initial, fn(state, item) {
        let rendered = match item.key {
            qb::OrderKey::Expr(expr) => match find_expression(expr, ordered.expressions) {
                Some(found) => {sql: found.sql, ctx: state.ctx},
                None => fail!("partition ordering key was not rendered", expr),
            },
            _ => order_key(item.key, plan, state.ctx),
        };
        let suffix = match item.direction {
            qb::Ordering::Asc => "ASC NULLS FIRST", qb::Ordering::Desc => "DESC NULLS LAST",
        };
        {sql: array::push(state.sql, `\{rendered.sql} \{suffix}`), ctx: rendered.ctx}
    });
    let row_alias = internal_alias(window_order.ctx);
    let source = render_from(plan, row_alias.1);
    let join_initial: Arguments = {sql: [], ctx: source.ctx};
    let joins = array::fold(plan.joins, join_initial, fn(state, join) {
        let rendered = render_join(join, state.ctx);
        {sql: array::push(state.sql, rendered.sql), ctx: rendered.ctx}
    });
    let where_clause = render_where(plan, joins.ctx);
    let grouping_sql = array::map(plan.grouping, fn(expr) {
        match find_expression(expr, ordered.expressions) {
            Some(found) => found.sql,
            None => fail!("partition grouping key was not rendered", expr),
        }
    });
    let having_initial: Arguments = {sql: [], ctx: where_clause.ctx};
    let having = array::fold(plan.having, having_initial, fn(state, item) {
        let rendered = having_item(item, plan, state.ctx);
        {sql: array::push(state.sql, rendered.sql), ctx: rendered.ctx}
    });
    let inner_alias = internal_alias(having.ctx);
    let take = bind(inner_alias.1, qb::Val::Int(pt.take));
    let hidden = array::concat([partition.hidden, ordered.hidden]);
    let row_number = `row_number() OVER (PARTITION BY \{string::join(window_partition, ", ")} ORDER BY \{string::join(window_order.sql, ", ")}) AS \{quoted(row_alias.0)}`;
    let inner_items = array::concat([selected.sql, hidden, [row_number]]);
    let join_sql = if array::length(plan.joins) > 0 { ` \{string::join(joins.sql, " ")}` } else { "" };
    let group_sql = if array::length(plan.grouping) > 0 { ` GROUP BY \{string::join(grouping_sql, ", ")}` } else { "" };
    let having_sql = if array::length(plan.having) > 0 { ` HAVING \{string::join(having.sql, " AND ")}` } else { "" };
    let inner_sql = `SELECT \{string::join(inner_items, ", ")} FROM \{source.sql}\{join_sql}\{where_clause.sql}\{group_sql}\{having_sql}`;
    let outer_columns = array::map(selected.aliases, fn(name) { `\{quoted(inner_alias.0)}.\{quoted(name)}` });
    let partition_order = array::map(partition.outer, fn(name) {
        `\{quoted(inner_alias.0)}.\{quoted(name)} ASC NULLS FIRST`
    });
    let ranked_order = array::map(array::enumerate(pt.order_by), fn(pair) {
        let direction = match pair.1.direction {
            qb::Ordering::Asc => "ASC NULLS FIRST", qb::Ordering::Desc => "DESC NULLS LAST",
        };
        `\{quoted(inner_alias.0)}.\{quoted(ordered.outer[pair.0])} \{direction}`
    });
    let outer_order = string::join(array::concat([partition_order, ranked_order]), ", ");
    {sql: `SELECT \{string::join(outer_columns, ", ")} FROM (\{inner_sql}) AS \{quoted(inner_alias.0)} WHERE \{quoted(inner_alias.0)}.\{quoted(row_alias.0)} <= \{take.sql} ORDER BY \{outer_order}`,
        ctx: take.ctx}
};

def emit_rows: Fn(qb::Plan, Bool, RenderCtx) -> Emitted = fn(raw, distinct, ctx) {
    let plan = if distinct { qb::validate_distinct_plan(raw) } else { qb::validate_structure(raw) };
    match plan.partition {
        Some(pt) => emit_partitioned(plan, pt, ctx),
        None => {
        let select_initial: Arguments = {sql: [], ctx};
        let selected = array::fold(plan.projection, select_initial, fn(state, item) {
            let value = select_item(item, plan, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        });
        let source = render_from(plan, selected.ctx);
        let join_initial: Arguments = {sql: [], ctx: source.ctx};
        let joins = array::fold(plan.joins, join_initial, fn(state, join) {
            let value = render_join(join, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        });
        let where_clause = render_where(plan, joins.ctx);
        let grouping = render_exprs(plan.grouping, where_clause.ctx);
        let having_initial: Arguments = {sql: [], ctx: grouping.ctx};
        let having = array::fold(plan.having, having_initial, fn(state, item) {
            let value = having_item(item, plan, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        });
        let ordering_initial: Arguments = {sql: [], ctx: having.ctx};
        let ordering = array::fold(plan.ordering, ordering_initial, fn(state, item) {
            let value = order_item(item, plan, state.ctx);
            {sql: array::push(state.sql, value.sql), ctx: value.ctx}
        });
        let limit: Emitted = match plan.limit {
            Some(value) => {
                let allocated = bind(ordering.ctx, qb::Val::Int(value));
                {sql: ` LIMIT \{allocated.sql}`, ctx: allocated.ctx}
            },
            None => {sql: "", ctx: ordering.ctx},
        };
        let offset: Emitted = match plan.offset {
            Some(value) => {
                let allocated = bind(limit.ctx, qb::Val::Int(value));
                {sql: ` OFFSET \{allocated.sql}`, ctx: allocated.ctx}
            },
            None => {sql: "", ctx: limit.ctx},
        };
        let prefix = if distinct { "SELECT DISTINCT" } else { "SELECT" };
        let join_sql = if array::length(plan.joins) > 0 { ` \{string::join(joins.sql, " ")}` } else { "" };
        let where_sql = where_clause.sql;
        let group_sql = if array::length(plan.grouping) > 0 { ` GROUP BY \{grouping.sql}` } else { "" };
        let having_sql = if array::length(plan.having) > 0 { ` HAVING \{string::join(having.sql, " AND ")}` } else { "" };
        let order_sql = if array::length(plan.ordering) > 0 { ` ORDER BY \{string::join(ordering.sql, ", ")}` } else { "" };
        {sql: `\{prefix} \{string::join(selected.sql, ", ")} FROM \{source.sql}\{join_sql}\{where_sql}\{group_sql}\{having_sql}\{order_sql}\{limit.sql}\{offset.sql}`,
            ctx: offset.ctx}
        },
    }
};

def emit_set: Fn(qb::SetPlan, RenderCtx) -> Emitted = fn(set, ctx) {
    let operands = qb::validate_set_operands(set.kind, set.left, set.right);
    let left = emit_rows(operands.0, False, ctx);
    let right = emit_rows(operands.1, False, left.ctx);
    let op = qb::set_op_sql(set.kind);
    {sql: `\{left.sql} \{op} \{right.sql}`, ctx: right.ctx}
};

# The single PG AST boundary remains a candidate until the dialect contract
# (notably set projection types) is proven by cross-dialect execution.
pub def render_query_plan_candidate: Fn(qb::QueryPlan) -> qb::Query = fn(raw) {
    match qb::validate_query_plan(raw) {
        qb::QueryPlan::Rows(plan) => {
            let rows = emit_rows(plan, False, plan_context(plan));
            {sql: rows.sql, bindings: rows.ctx.bindings}
        },
        qb::QueryPlan::DistinctRows(plan) => {
            let rows = emit_rows(plan, True, plan_context(plan));
            {sql: rows.sql, bindings: rows.ctx.bindings}
        },
        qb::QueryPlan::GroupCount(plan) => {
            let rows = emit_rows(plan, False, plan_context(plan));
            let alias = internal_alias(rows.ctx);
            {sql: `SELECT count(1) FROM (\{rows.sql}) AS \{quoted(alias.0)}`,
                bindings: alias.1.bindings}
        },
        qb::QueryPlan::SetRows(set) => {
            let reserved = array::concat([plan_aliases(set.left), plan_aliases(set.right)]);
            let rows = emit_set(set, context(1, reserved));
            {sql: rows.sql, bindings: rows.ctx.bindings}
        },
        qb::QueryPlan::SetCount(set) => {
            let reserved = array::concat([plan_aliases(set.left), plan_aliases(set.right)]);
            let rows = emit_set(set, context(1, reserved));
            let alias = internal_alias(rows.ctx);
            {sql: `SELECT count(1) FROM (\{rows.sql}) AS \{quoted(alias.0)}`,
                bindings: alias.1.bindings}
        },
    }
};

pub def render_query_plan_with_context: Fn(qb::QueryPlan, qb::BuildCtx) -> qb::Query = fn(raw, builder) {
    let plan = qb::validate_query_plan(raw);
    let reserved = match plan {
        qb::QueryPlan::Rows(rows) => plan_aliases(rows),
        qb::QueryPlan::DistinctRows(rows) => plan_aliases(rows),
        qb::QueryPlan::GroupCount(rows) => plan_aliases(rows),
        qb::QueryPlan::SetRows(set) => array::concat([plan_aliases(set.left), plan_aliases(set.right)]),
        qb::QueryPlan::SetCount(set) => array::concat([plan_aliases(set.left), plan_aliases(set.right)]),
    };
    let ctx: RenderCtx = {...context(builder.next_binding, reserved),
        bindings: builder.bindings, builder_bindings: builder.bindings};
    let rendered = match plan {
        qb::QueryPlan::Rows(rows) => emit_rows(rows, False, ctx),
        qb::QueryPlan::DistinctRows(rows) => emit_rows(rows, True, ctx),
        qb::QueryPlan::GroupCount(rows) => {
            let inner = emit_rows(rows, False, ctx);
            let alias = internal_alias(inner.ctx);
            {sql: `SELECT count(1) FROM (\{inner.sql}) AS \{quoted(alias.0)}`, ctx: alias.1}
        },
        qb::QueryPlan::SetRows(set) => emit_set(set, ctx),
        qb::QueryPlan::SetCount(set) => {
            let inner = emit_set(set, ctx);
            let alias = internal_alias(inner.ctx);
            {sql: `SELECT count(1) FROM (\{inner.sql}) AS \{quoted(alias.0)}`, ctx: alias.1}
        },
    };
    if array::length(rendered.ctx.bindings) != array::length(builder.bindings) {
        fail!("constructed query plan contains values not allocated by qb", plan)
    } else { {sql: rendered.sql, bindings: builder.bindings} }
};

pub def render_rows_candidate: Fn(qb::Plan, Bool) -> qb::Query = fn(plan, distinct) {
    if distinct { render_query_plan_candidate(qb::QueryPlan::DistinctRows(plan)) }
    else { render_query_plan_candidate(qb::QueryPlan::Rows(plan)) }
};

pub def render_group_count_candidate: Fn(qb::Plan) -> qb::Query = fn(plan) {
    render_query_plan_candidate(qb::QueryPlan::GroupCount(plan))
};

pub def render_set_candidate: Fn(qb::SetPlan, Bool) -> qb::Query = fn(set, count) {
    if count { render_query_plan_candidate(qb::QueryPlan::SetCount(set)) }
    else { render_query_plan_candidate(qb::QueryPlan::SetRows(set)) }
};
