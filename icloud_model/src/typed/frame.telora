use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# Frame独立声明，保留源可空性和已声明粒度
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
# 可空DN仅表达来源引用，不虚构Frame主键或grain
type FrameDn = struct(
    String
);
@registry::entity("frame_source_reference")
type Reference = struct {
    dn: FrameDn
};
def reference: m::Entity(Reference) = registry::entity_of(Reference.type);
@registry::dataset("frame", "I_EnterpriseFrame", [])
@registry::roles([device, tenant, frame_reference])
@edsl::reference("dn", ["frame_dn"])
@registry::relations(relations)
type IEnterpriseFrame = struct {
    @edsl::field_role(edsl::FieldRole::Appellation)
    @g::search("frame_name")
    name: String,
    @m::column("refParentNE")
    ref_parent_ne: Option(i::DeviceId),
    @m::column("tenantId")
    tenant_id: Option(i::TenantId),
    @m::column("operState")
    @v::classification(FrameOperState_domain, "frame_oper_state")
    oper_state: Option(Int),
    @m::column("manufacturer")
    @g::search("frame__manufacturer")
    source_manufacturer: Option(String),
    @m::column("softVersion")
    @g::search("frame__softVersion")
    source_softVersion: Option(String),
    @m::column("remark")
    @g::search("frame__remark")
    source_remark: Option(String),
    @m::column("projectId")
    @g::exact("frame__projectId")
    source_projectId: Option(String),
    @m::column("frameDn")
    @g::exact("frame__frameDn")
    frame_dn: Option(FrameDn),
    @m::column("adminState")
    @v::classification(FrameAdminState_domain, "frame__adminState")
    source_adminState: Option(Int),
};
def dataset: m::Dataset(IEnterpriseFrame) = registry::dataset_of(IEnterpriseFrame.type);
def device: m::Role(IEnterpriseFrame) = m::role(
    dataset,
    i::device,
    "device",
    True,
    [
        m::identity_part(
            m::optional_field(IEnterpriseFrame.type, i::DeviceId.type, "ref_parent_ne"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def tenant: m::Role(IEnterpriseFrame) = m::role(
    dataset,
    i::tenant,
    "tenant",
    True,
    [
        m::identity_part(
            m::optional_field(IEnterpriseFrame.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def frame_reference: m::Role(IEnterpriseFrame) = m::role(
    dataset,
    reference,
    "frame_reference",
    True,
    [
        m::identity_part(
            m::optional_field(IEnterpriseFrame.type, FrameDn.type, "frame_dn"),
            m::field(Reference.type, FrameDn.type, "dn")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type FrameOperState = enum {
    @ev::itag(3)
    @ev::itag(11)
    @ev::itag(13)
    @ev::itag(15)
    @ev::itag(16)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(2)
    @ev::itag(12)
    @ev::itag(17)
    @ev::description("error", "故障")
    Error,
    @ev::itag(4)
    @ev::description("offline", "离线")
    Offline,
    @ev::itag(-1)
    @ev::itag(1)
    @ev::description("unknow", "未知")
    Unknown,
};
def FrameOperState_domain: v::Domain(FrameOperState, Int) = v::from_enum(
    "FrameOperState",
    FrameOperState.type,
    Int.type,
    False
);

@knowledge_policy::reverse_references(True)
type FrameAdminState = enum {
    @ev::itag(4)
    @ev::itag(11)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(2)
    @ev::itag(3)
    @ev::itag(12)
    @ev::description("error", "故障")
    Error,
    @ev::itag(13)
    @ev::description("important", "回环")
    Important,
    @ev::itag(1)
    @ev::itag(-1)
    @ev::description("unknow", "未知")
    Unknown,
};
def FrameAdminState_domain: v::Domain(FrameAdminState, Int) = v::from_enum(
    "FrameAdminState",
    FrameAdminState.type,
    Int.type,
    False
);
def declaration: t::Declaration = registry::declaration(IEnterpriseFrame.type);
def relations: Array(r::Relation) = [
    r::relation(
        "frame_belongs_to_device",
        dataset,
        device,
        i::devices,
        i::device_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntNetworkElement_EnterpriseFrame",
        i::devices,
        i::device_subject,
        dataset,
        device,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EnterpriseFrame_X_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{declaration, relations, FrameDn, Reference, reference, dataset, frame_reference};

pub use self::{IEnterpriseFrame};
