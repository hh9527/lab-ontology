use ontology::registry as registry;
# PON 端口 KPI：保持来源 parentId 关联及既有样本粒度假定。
use super::inventory as i;
use super::pon_quantities as q;
use super::pon_device as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
type PortSampleId = struct(String);
# TODO(#51): 来源 one 与百分比显示冲突；保留既有 % 尺度，不与 ONU 百分比类型自动互换。
type ReportedPercent = struct(Float);
@registry::dataset("pon_port_kpi", "PonDevicePonPortKPI", ["res_id", "tenant_id", "ts"])
@registry::roles([device])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi_ts",
                s::DateTimeUtc.type,
                True,
                [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
            ),
            g::input(m::field(PonDevicePonPortKPI.type, s::DateTimeUtc.type, "ts")),
            "pon_port_kpi_ts",
            True,
            [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDevicePonPortKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "pon_port_kpi_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDevicePonPortKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "pon_port_kpi_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDevicePonPortKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "pon_port_kpi_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_receive_sample",
                ReportedPercent.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDevicePonPortKPI.type, ReportedPercent.type, "if_in_band_rate")),
            "pon_port_receive_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__ifOutBandRate",
                ReportedPercent.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PonDevicePonPortKPI.type, ReportedPercent.type, "source_ifOutBandRate")
            ),
            "pon_port_kpi__ifOutBandRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__onuHwOpticsTxPower",
                q::Dbm.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDevicePonPortKPI.type, q::Dbm.type, "source_onuHwOpticsTxPower")),
            "pon_port_kpi__onuHwOpticsTxPower",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__hwOpticsTemperature",
                q::DegreesCelsius.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDevicePonPortKPI.type,
                    q::DegreesCelsius.type,
                    "source_hwOpticsTemperature"
                )
            ),
            "pon_port_kpi__hwOpticsTemperature",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__ifHCInOctetsSpeed",
                q::BitsPerSecond.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDevicePonPortKPI.type,
                    q::BitsPerSecond.type,
                    "source_ifHCInOctetsSpeed"
                )
            ),
            "pon_port_kpi__ifHCInOctetsSpeed",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__ifHCOutOctetsSpeed",
                q::BitsPerSecond.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDevicePonPortKPI.type,
                    q::BitsPerSecond.type,
                    "source_ifHCOutOctetsSpeed"
                )
            ),
            "pon_port_kpi__ifHCOutOctetsSpeed",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__ifInBandRateEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDevicePonPortKPI.type, Int.type, "source_ifInBandRateEffcnt")),
            "pon_port_kpi__ifInBandRateEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__ifOutBandRateEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDevicePonPortKPI.type, Int.type, "source_ifOutBandRateEffcnt")),
            "pon_port_kpi__ifOutBandRateEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__onuHwOpticsTxPowerEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PonDevicePonPortKPI.type, Int.type, "source_onuHwOpticsTxPowerEffcnt")
            ),
            "pon_port_kpi__onuHwOpticsTxPowerEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_port_kpi__hwOpticsTemperatureEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PonDevicePonPortKPI.type, Int.type, "source_hwOpticsTemperatureEffcnt")
            ),
            "pon_port_kpi__hwOpticsTemperatureEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::metric("ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            reported_percent_statistics,
            m::field(PonDevicePonPortKPI.type, ReportedPercent.type, "if_in_band_rate"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_port_receive_usage"},
                {statistic: samples::Statistic::Max, publish: "pon_port_receive_sample_max"},
                {statistic: samples::Statistic::Min, publish: "pon_port_receive_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            reported_percent_statistics,
            m::field(PonDevicePonPortKPI.type, ReportedPercent.type, "source_ifOutBandRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_port_transmit_usage"},
                {statistic: samples::Statistic::Max, publish: "pon_port_transmit_usage_max"},
                {statistic: samples::Statistic::Min, publish: "pon_port_transmit_usage_min"}
            ]
        ),
        samples::bind(
            dataset,
            q::Dbm_statistics,
            m::field(PonDevicePonPortKPI.type, q::Dbm.type, "source_onuHwOpticsTxPower"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_port_optics_tx_power"},
                {statistic: samples::Statistic::Max, publish: "pon_port_optics_tx_power_max"},
                {statistic: samples::Statistic::Min, publish: "pon_port_optics_tx_power_min"}
            ]
        ),
        samples::bind(
            dataset,
            q::DegreesCelsius_statistics,
            m::field(PonDevicePonPortKPI.type, q::DegreesCelsius.type, "source_hwOpticsTemperature"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_port_optics_temperature"},
                {statistic: samples::Statistic::Max, publish: "pon_port_optics_temperature_max"},
                {statistic: samples::Statistic::Min, publish: "pon_port_optics_temperature_min"}
            ]
        ),
        samples::bind(
            dataset,
            q::BitsPerSecond_statistics,
            m::field(PonDevicePonPortKPI.type, q::BitsPerSecond.type, "source_ifHCInOctetsSpeed"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_port_rx_rate"},
                {statistic: samples::Statistic::Max, publish: "pon_port_rx_rate_max"},
                {statistic: samples::Statistic::Min, publish: "pon_port_rx_rate_min"}
            ]
        ),
        samples::bind(
            dataset,
            q::BitsPerSecond_statistics,
            m::field(PonDevicePonPortKPI.type, q::BitsPerSecond.type, "source_ifHCOutOctetsSpeed"),
            [
                {statistic: samples::Statistic::Mean, publish: "pon_port_tx_rate"},
                {statistic: samples::Statistic::Max, publish: "pon_port_tx_rate_max"},
                {statistic: samples::Statistic::Min, publish: "pon_port_tx_rate_min"}
            ]
        ),
    ]
)
@registry::relations(relations)
type PonDevicePonPortKPI = struct {
    @m::column("resId")
    res_id: PortSampleId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @m::column("parentId")
    parent_id: p::PonId,
    @m::column("portName")
    port_name: String,
    ts: s::DateTimeUtc,
    @m::column("ifInBandRate")
    if_in_band_rate: ReportedPercent,
    @m::column("projectId")
    @g::exact("pon_port_kpi__projectId")
    source_projectId: String,
    @m::column("ifOutBandRate")
    source_ifOutBandRate: ReportedPercent,
    @m::column("onuHwOpticsTxPower")
    source_onuHwOpticsTxPower: q::Dbm,
    @m::column("hwOpticsTemperature")
    source_hwOpticsTemperature: q::DegreesCelsius,
    @m::column("ifHCInOctetsSpeed")
    source_ifHCInOctetsSpeed: q::BitsPerSecond,
    @m::column("ifHCOutOctetsSpeed")
    source_ifHCOutOctetsSpeed: q::BitsPerSecond,
    @m::column("ifInBandRateEffcnt")
    source_ifInBandRateEffcnt: Int,
    @m::column("ifOutBandRateEffcnt")
    source_ifOutBandRateEffcnt: Int,
    @m::column("onuHwOpticsTxPowerEffcnt")
    source_onuHwOpticsTxPowerEffcnt: Int,
    @m::column("hwOpticsTemperatureEffcnt")
    source_hwOpticsTemperatureEffcnt: Int,
};
def dataset: m::Dataset(PonDevicePonPortKPI) = registry::dataset_of(PonDevicePonPortKPI.type);
def device: m::Role(PonDevicePonPortKPI) = m::role(
    dataset,
    p::entity,
    "device",
    False,
    [
        m::identity_part(
            m::field(PonDevicePonPortKPI.type, p::PonId.type, "parent_id"),
            m::field(p::Identity.type, p::PonId.type, "id")
        )
    ]
);
def reported_percent_statistics: samples::Group(ReportedPercent) = samples::group(
    "pon_port_Percent",
    ReportedPercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
def relations: Array(r::Relation) = [
    r::relation(
        "pon_port_kpi_of_device",
        r::endpoint(dataset.row, device.id),
        r::endpoint(p::dataset.row, p::subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntPonElementAssociationPonDevicePonPortKPI",
        r::endpoint(p::dataset.row, p::subject.id),
        r::endpoint(dataset.row, device.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{PonDevicePonPortKPI};
