    v::member(PortIfType("wire_65635_bc384e3d"), [65635]),
], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [subject, device, tenant], [
    i::search(dataset, m::field(Row.type, String.type, "name"), "port_name"),
    g::dimension(dataset, g::dimension_group("numeric", BitsPerSecond.type, True, g::numeric_filters), g::input(m::field(Row.type, BitsPerSecond.type, "source_bandwidth")), "port__bandwidth", True, g::numeric_filters),
    i::search(dataset, m::field(Row.type, String.type, "source_alias"), "port__alias"),
    i::exact(dataset, m::field(Row.type, String.type, "source_portIndex"), "port__portIndex"),
    i::exact(dataset, m::field(Row.type, String.type, "source_nativeId"), "port__nativeId"),
    i::search(dataset, m::field(Row.type, String.type, "source_remark"), "port__remark"),
    i::exact(dataset, m::field(Row.type, String.type, "source_duplexMode"), "port__duplexMode"),
    i::search(dataset, m::field(Row.type, String.type, "source_ipAddress"), "port__ipAddress"),
    g::dimension(dataset, g::dimension_group("numeric", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_ifMtu")), "port__ifMtu", True, g::numeric_filters),
    i::exact(dataset, m::field(Row.type, String.type, "source_parentResId"), "port__parentResId"),
    i::search(dataset, m::field(Row.type, String.type, "source_ifPhysAddress"), "port__ifPhysAddress"),
    g::dimension(dataset, g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters), g::ipv4(g::input(m::field(Row.type, String.type, "source_ipAddress"))), "port__ipAddress_ipv4", True, g::ipv4_filters),
], ["interface_count"]), [
    t::column(m::field(Row.type, PortId.type, "id"), "id"),
    t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::field(Row.type, i::DeviceId.type, "ref_parent_ne"), "refParentNE"),
    t::column(m::field(Row.type, String.type, "name"), "name"),
    t::column(m::field(Row.type, String.type, "oper_status"), "operState"),
    t::column(m::field(Row.type, String.type, "source_adminState"), "adminState"),
    t::column(m::field(Row.type, BitsPerSecond.type, "source_bandwidth"), "bandwidth"),
    t::column(m::field(Row.type, String.type, "source_alias"), "alias"),
    t::column(m::field(Row.type, String.type, "source_portIndex"), "portIndex"),
    t::column(m::field(Row.type, String.type, "source_nativeId"), "nativeId"),
    t::column(m::field(Row.type, String.type, "source_remark"), "remark"),
    t::column(m::field(Row.type, String.type, "source_duplexMode"), "duplexMode"),
    t::column(m::field(Row.type, String.type, "source_ipAddress"), "ipAddress"),
    t::column(m::field(Row.type, Int.type, "source_ifMtu"), "ifMtu"),
    t::column(m::field(Row.type, String.type, "source_parentResId"), "parentResId"),
    t::column(m::field(Row.type, String.type, "source_ifPhysAddress"), "ifPhysAddress"),
    t::column(m::field(Row.type, Int.type, "source_ifType"), "ifType"),
]), [
    v::bind(dataset, v::dimension_group(PortOperStatus_domain, True, g::equality_filters), g::input(m::field(Row.type, String.type, "oper_status")), "port_oper_status", True, g::equality_filters),
    v::bind(dataset, v::dimension_group(PortAdminState_domain, True, g::equality_filters), g::input(m::field(Row.type, String.type, "source_adminState")), "port__adminState", True, g::equality_filters),
    v::bind(dataset, v::dimension_group(PortIfType_domain, True, g::equality_filters), g::input(m::field(Row.type, Int.type, "source_ifType")), "port__ifType", True, g::equality_filters),
]);
def cardinality: edsl::RelationCardinality = {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional};
def relations: Array(r::Relation) = [
    r::relation("port_belongs_to_device", dataset, device, i::devices, i::device_subject, cardinality),
    r::relation("source_EntNetworkElement_EnterpriseNetworkLTP", i::devices, i::device_subject, dataset, device, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("source_EnterpriseNetworkLTP_X_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, cardinality),
];
pub use self::{declaration, relations, PortId, Identity, entity, dataset, subject};
