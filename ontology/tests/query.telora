# ---------------------------------------------------------------------------
# JSON codec boundary (Val <-> untagged scalar JSON).
# ---------------------------------------------------------------------------

def json_val_int_roundtrip = fn() {
    val_roundtrip(qb.Val.Int(3))
};

def json_val_float_roundtrip = fn() {
    val_roundtrip(qb.Val.Float(3.5))
};

def json_val_string_roundtrip = fn() {
    val_roundtrip(qb.Val.String("abc"))
};

def json_val_bool_roundtrip = fn() {
    val_roundtrip(qb.Val.Bool(True))
};

def json_val_null_roundtrip = fn() {
    val_roundtrip(qb.Val.None)
};

def bind_null_constructs_null_binding = fn() {
    match qb.bind_null() {
        qb.Expr.Bind(qb.Val.None) => True,
        _ => False,
    }
};

def json_val_int_encodes_as_scalar_number = fn() {
    encode_val(qb.Val.Int(3)) == Value.Int(3)
};

def json_val_float_encodes_as_scalar_number = fn() {
    encode_val(qb.Val.Float(3.5)) == Value.Float(3.5)
};

def json_val_string_encodes_as_scalar_string = fn() {
    encode_val(qb.Val.String("abc")) == Value.String("abc")
};

def json_val_bool_encodes_as_scalar_bool = fn() {
    encode_val(qb.Val.Bool(True)) == Value.True
};

def json_val_null_encodes_as_scalar_null = fn() {
    encode_val(qb.Val.None) == Value.None
};

def json_val_no_variant_wrapper = fn() {
    let encoded = json.stringify(encode_val(qb.Val.Int(3)));
    encoded == "3"
        && json.stringify(encode_val(qb.Val.Float(3.5))) == "3.5"
        && json.stringify(encode_val(qb.Val.String("abc"))) == "\"abc\""
        && json.stringify(encode_val(qb.Val.Bool(True))) == "true"
        && json.stringify(encode_val(qb.Val.None)) == "null"
};

def json_int_float_dispatch = fn() {
    json_to_val("3") == qb.Val.Int(3)
        && json_to_val("3.5") == qb.Val.Float(3.5)
        && json_to_val("\"abc\"") == qb.Val.String("abc")
        && json_to_val("true") == qb.Val.Bool(True)
        && json_to_val("null") == qb.Val.None
};

def json_float_whole_number_dispatch_boundary = fn() {
    # JSON text cannot preserve a whole-number Float: "3.0" parses to a Float
    # but the compact text "3" parses to an Int.  The Int/Float dispatch follows
    # the JSON parser: "3.0" stays Float, "3" is Int.  This is a documented
    # JSON codec boundary, not a QueryBuilder lowering change.
    json_to_val("3.0") == qb.Val.Float(3.0)
};

def json_query_bindings_are_scalar_array = fn() {
    query_bindings_are_scalar_array(qb.transform_sqlite(demo_plan()))
};

def json_query_encoded_bindings_match = fn() {
    let expected: Array(qb.Val) = [qb.Val.Int(1), qb.Val.Int(3), qb.Val.Float(100.0), qb.Val.Int(10)];
    query_encoded_bindings_match(qb.transform_sqlite(demo_plan()), expected)
};

def json_query_roundtrip = fn() {
    let q = qb.transform_sqlite(demo_plan());
    let encoded = codec.encode(Value.type, q);
    let decoded: qb.Query = codec.decode(qb.Query.type, encoded).unwrap!();
    decoded == q
};

def json_query_bindings_no_wrapper_objects = fn() {
    let encoded = codec.encode(Value.type, qb.transform_sqlite(demo_plan()));
    let has_wrapper = match encoded {
        Value.Object(fields) => match dict.get(fields, "bindings") {
            Some(Value.Array(items)) => array.any(items, fn(item) {
                match item {
                    Value.Object(_) => True,
                    Value.Array(_) => True,
                    _ => False,
                }
            }),
            _ => True,
        },
        _ => True,
    };
    !has_wrapper
};

def json_codec_does_not_change_lowering = fn() {
    # The untagged codec property only affects the codec boundary; Query
    # generation and determinism are unchanged.
    let q1 = qb.transform_sqlite(demo_plan());
    let q2 = qb.transform_sqlite(demo_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
        && q1.sql == "SELECT o.customer_id, substr(o.name, ?, ?), sum(o.total) AS total_sum FROM orders AS o INNER JOIN customers AS c ON o.customer_id = c.id WHERE o.total > ? GROUP BY o.customer_id ORDER BY o.customer_id ASC LIMIT ?"
};

# ---------------------------------------------------------------------------
# P0: HAVING aggregate-result predicate.
#
# `Plan.having` compares a projected aggregate/computed measure alias to a
# dynamic scalar threshold; thresholds always become trailing `?` bindings and
# the full measure expression is re-rendered (so a FILTER aggregate repeats its
# bindings in placeholder order).  The `Having` operator gates the feature in
# `PlanProfile`.
# ---------------------------------------------------------------------------

def having_count_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-having-count",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("e", "id"), False, "event_count"),
        ],
        filter: None,
        exists: [],
        joins: [],
        grouping: [qb.column("e", "role")],
        having: [qb.having(qb.HavingOp.Gt, "event_count", qb.Val.Int(5))],
        ordering: [qb.desc_aggregate("event_count")],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def having_lowers_after_group_with_bound_threshold = fn() {
    let q = qb.transform_sqlite(having_count_plan());
    let expected: Array(qb.Val) = [qb.Val.Int(5)];
    q.sql == "SELECT e.role, count(e.id) AS event_count FROM events AS e GROUP BY e.role HAVING count(e.id) > ? ORDER BY count(e.id) DESC"
        && q.bindings == expected
};

def having_filtered_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-having-filtered",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.aggregate_filtered(qb.AggregateFunction.Count, qb.column("e", "id"), False,
                Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("e", "type"), qb.bind_string("task_started")])),
                "started_count"),
        ],
        filter: None,
        exists: [],
        joins: [],
        grouping: [qb.column("e", "role")],
        having: [qb.having(qb.HavingOp.Gt, "started_count", qb.Val.Int(2))],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def having_filtered_measure_repeats_placeholders_in_text_order = fn() {
    let q = qb.transform_sqlite(having_filtered_plan());
    let expected: Array(qb.Val) = [qb.Val.String("task_started"), qb.Val.String("task_started"), qb.Val.Int(2)];
    q.sql == "SELECT e.role, count(e.id) FILTER (WHERE e.type = ?) AS started_count FROM events AS e GROUP BY e.role HAVING count(e.id) FILTER (WHERE e.type = ?) > ?"
        && q.bindings == expected
        && (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
};

def having_deterministic = fn() {
    let q1 = qb.transform_sqlite(having_count_plan());
    let q2 = qb.transform_sqlite(having_count_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

def having_operator_reported = fn() {
    let expected: Array(qb.Operator) = [
        qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Aggregate, qb.Operator.Group, qb.Operator.Having, qb.Operator.Order,
    ];
    qb.operators(having_count_plan()) == expected
};

def having_requires_profile_having_operator = fn() {
    let no_having: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Aggregate, qb.Operator.Group, qb.Operator.Order],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [],
        allow_distinct: True,
    };
    !qb.profile_accepts(having_count_plan(), no_having)
        && qb.profile_accepts(having_count_plan(), full_profile())
};

def having_unknown_measure_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-having-unknown",
        sources: [qb.source("e", "events")],
        projection: [qb.expr_item(qb.column("e", "role"))],
        filter: None,
        exists: [],
        joins: [],
        grouping: [qb.column("e", "role")],
