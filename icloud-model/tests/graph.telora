        "nodes":[{"id":"server","entity":"server_device"},{"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "constraints":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "select":[{"node":"server","dimension":"server_name"}]
    }"#).unwrap!());
