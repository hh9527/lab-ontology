    let q = run_text(rh_outer_filter_json);
    let ok_sql = q.sql == `SELECT ct.Name FROM city AS ct INNER JOIN country AS c ON ct.CountryCode = c.Code WHERE ct.District = ? AND EXISTS (SELECT 1 FROM countrylanguage AS cl WHERE c.Code = cl.CountryCode AND (cl.IsOfficial = ? AND cl.Language = ?)) ORDER BY ct.Population DESC LIMIT ?`;
    let ok_binds = binding_count(q) == 4;
