@domain::subject("Fan", "id")
@domain::dataset("fan", "SYS_Fan", ["id"])
pub type Fan = struct {
    @g::field_view(g::dimension_group("fan/id", ids::FanById.type, True, [g::Filter::Eq]), "fan_id", True, [g::Filter::Eq])
    @domain::count("fan_count")
    id: ids::FanById,
    @g::field_view(g::dimension_group("fan/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "fan_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("fan/obj_sys_id", String.type, True, [g::Filter::Eq]), "fan_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(String),
    @m::column("oriResId")
    @g::field_view(g::dimension_group("fan/ori_res_id", String.type, True, [g::Filter::Eq]), "fan_ori_res_id", True, [g::Filter::Eq])
    ori_res_id: Option(String),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("fan/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "fan_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
    @g::field_view(g::dimension_group("fan/slot", String.type, True, [g::Filter::Eq]), "fan_slot", True, [g::Filter::Eq])
    slot: Option(String),
    @g::field_view(g::dimension_group("fan/location", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "fan_location", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    location: Option(String),
    @m::column("bomId")
    @g::field_view(g::dimension_group("fan/bom_id", String.type, True, [g::Filter::Eq]), "fan_bom_id", True, [g::Filter::Eq])
    bom_id: Option(String),
    @m::column("runningStatus")
    @g::field_view(g::dimension_group("fan/running_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "fan_running_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::FanRunningStatus.type, "fan_running_status", [v::member(domains::FanRunningStatus::Unknown, ["0"]), v::member(domains::FanRunningStatus::Normal, ["1"]), v::member(domains::FanRunningStatus::Running, ["2"]), v::member(domains::FanRunningStatus::NotRunning, ["3"]), v::member(domains::FanRunningStatus::Sleep, ["8"]), v::member(domains::FanRunningStatus::Online, ["27"]), v::member(domains::FanRunningStatus::Offline, ["28"])])
    running_status: Option(String),
    @m::column("healthStatus")
    @g::field_view(g::dimension_group("fan/health_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "fan_health_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::FanHealthStatus.type, "fan_health_status", [v::member(domains::FanHealthStatus::Unknown, ["0"]), v::member(domains::FanHealthStatus::Normal, ["1"]), v::member(domains::FanHealthStatus::Faulty, ["2"])])
    health_status: Option(String),
    @m::column("runLevel")
    @g::field_view(g::dimension_group("fan/run_level/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "fan_run_level_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::FanRunLevel.type, "fan_run_level", [v::member(domains::FanRunLevel::Low, ["0"]), v::member(domains::FanRunLevel::Normal, ["1"]), v::member(domains::FanRunLevel::High, ["2"])])
    run_level: Option(String),
    @m::column("parentType")
    @g::field_view(g::dimension_group("fan/parent_type/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "fan_parent_type_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::FanParentType.type, "fan_parent_type", [v::member(domains::FanParentType::Chassis, ["206"]), v::member(domains::FanParentType::Controller, ["207"])])
    parent_type: Option(String),
    @m::column("parentId")
    @g::field_view(g::dimension_group("fan/parent_id", String.type, True, [g::Filter::Eq]), "fan_parent_id", True, [g::Filter::Eq])
    parent_id: Option(String),
    @m::column("fanId")
