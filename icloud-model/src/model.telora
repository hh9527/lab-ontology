    @edsl::canonical_values(pon_class_values)
    @edsl::canonical_alias("onu", "光猫")
    classification: String,
    @edsl::column("commuState")
    @edsl::dimension("pon_commu_state", yes, yes, canonical_eq_ne_ops, text_inputs)
    @edsl::canonical_values(pon_commu_values)
    @edsl::localized_canonical_value("online", "en", "Online")
    @edsl::localized_canonical_value("online", "zh", "在线")
    @edsl::localized_canonical_value("offline", "en", "Offline")
    @edsl::localized_canonical_value("offline", "zh", "离线")
    commu_state: String,
    @edsl::column("createTime")
    @edsl::time_field(local_role, local_epoch_millis)
    @edsl::dimension("pon_create_ms", yes, yes, int_ops, int_inputs)
    create_time: Int,
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::dimension("pon_id", yes, yes, text_ops, text_inputs)
    id: String,
    @edsl::column("name")
    @edsl::dimension("pon_name", yes, yes, text_ops, text_inputs)
    name: String,
};

