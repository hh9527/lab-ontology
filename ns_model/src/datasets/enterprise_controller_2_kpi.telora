use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::controller;
use crate::datasets::kpi_storage_enterprise_controller;
@domain::subject("Controller", "obj_sys_id")
@domain::dataset("enterprise-controller-2-kpi", "enterpriseController2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseController2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-controller-2-kpi/obj_sys_id", ids::EnterpriseController2KpiByObjSysId.type, True, [g::Filter::Eq]), "ec2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("ec2_count")
    obj_sys_id: ids::EnterpriseController2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-controller-2-kpi/obj_id", domain::Reference(ids::EnterpriseController2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "ec2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseController2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("ec2__co", domain::endpoint(EnterpriseController2Kpi.type, "obj_sys_id"), domain::endpoint(controller::Controller.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("ec2__sec", domain::endpoint(EnterpriseController2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_controller::KpiStorageEnterpriseController.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
