use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 站点独立声明，保留设备定位的两个备选身份角色
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
@registry::entity("site_entity")
type Identity = struct {
    id: i::SiteId
};
@knowledge_policy::reverse_references(True)
type SiteType = enum {
    @ev::rename("onlineSite")
    @ev::description("Online site", "线上站点")
    Online,
    @ev::rename("offlineSite")
    @ev::description("Offline site", "线下站点")
    Offline,
};
@registry::dataset("site", "X_SITE_VIEW", ["site_id"])
@registry::roles([subject, tenant])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::time_filters),
            g::input(m::field(XSiteView.type, s::EpochMillis.type, "source_CREATE_TIME")),
            "site__CREATE_TIME",
            True,
            g::time_filters
        ),
    ]
)
@registry::relations(relations)
@registry::alternatives(alternatives)
type XSiteView = struct {
    @m::column("SITE_ID")
    @g::exact("site_id")
    site_id: i::SiteId,
    @m::column("SITE_NAME")
    @g::search("site_name")
    site_name: String,
    @m::column("SITE_TYPE")
    @v::classification(types, "site_type")
    site_type: String,
    @m::column("TENANT_ID")
    tenant_id: i::TenantId,
    @m::column("PARENT_SITE_ID")
    @g::exact("site__PARENT_SITE_ID")
    source_PARENT_SITE_ID: String,
    @m::column("SITE_ALIAS")
    @g::search("site__SITE_ALIAS")
    source_SITE_ALIAS: String,
    # 保留基线 UTC 毫秒假定，尚未确认生产单位
    @m::column("CREATE_TIME")
    source_CREATE_TIME: s::EpochMillis,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(XSiteView) = registry::dataset_of(XSiteView.type);
def subject: m::Role(XSiteView) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(XSiteView.type, i::SiteId.type, "site_id"),
            m::field(Identity.type, i::SiteId.type, "id")
        )
    ]
);
def tenant: m::Role(XSiteView) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(XSiteView.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def project: m::Role(i::IEntNetworkElement) = m::role(
    i::devices,
    entity,
    "project_site",
    False,
    [
        m::identity_part(
            m::field(i::IEntNetworkElement.type, i::SiteId.type, "project_id"),
            m::field(Identity.type, i::SiteId.type, "id")
        )
    ]
);
def subnet: m::Role(i::IEntNetworkElement) = m::role(
    i::devices,
    entity,
    "subnet_site",
    False,
    [
        m::identity_part(
            m::field(i::IEntNetworkElement.type, i::SiteId.type, "ref_parent_subnet"),
            m::field(Identity.type, i::SiteId.type, "id")
        )
    ]
);
def types: v::Domain(SiteType, String) = v::from_enum("SiteType", SiteType.type, String.type, False);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def relations: Array(r::Relation) = [
    r::relation(
        "site_belongs_to_tenant",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        cardinality
    ),
    r::relation(
        "source_X_TENANT_VIEW_X_SITE_VIEW",
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        r::endpoint(dataset.row, tenant.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
def alternatives: Array(registry::Alternative) = [
    {
        id: "device_located_at_site",
        cardinality,
        choices: [
            r::relation(
                "device_project_site",
                r::endpoint(i::devices.row, project.id),
                r::endpoint(dataset.row, subject.id),
                cardinality
            ),
            r::relation(
                "device_subnet_site",
                r::endpoint(i::devices.row, subnet.id),
                r::endpoint(dataset.row, subject.id),
                cardinality
            )
        ]
    },
    {
        id: "source_EntNetworkElement_X_SITE_VIEW",
        cardinality,
        choices: [
            r::relation(
                "source_device_project_site",
                r::endpoint(i::devices.row, project.id),
                r::endpoint(dataset.row, subject.id),
                cardinality
            ),
            r::relation(
                "source_device_subnet_site",
                r::endpoint(i::devices.row, subnet.id),
                r::endpoint(dataset.row, subject.id),
                cardinality
            )
        ]
    },
];
pub use self::{relations, alternatives, project, subnet, Identity, entity, dataset, subject};

pub use self::{XSiteView};
