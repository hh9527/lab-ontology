use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
@domain::subject("NetworkElement", "obj_id")
@domain::dataset("kpi-network-fan-info", "kpi_network_fan_info", ["obj_id","ts"])
@domain::metric("ts")
pub type KpiNetworkFanInfo = struct {
    @m::column("timestamp")
    @g::field_view(g::dimension_group("kpi-network-fan-info/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "nfi_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("nfi_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("nfi_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("nfi_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @g::field_view(g::dimension_group("kpi-network-fan-info/obj_id", domain::Reference(ids::NetworkElement2KpiFanByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "nfi_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::NetworkElement2KpiFanByObjId),
    @m::column("hwEntityFanSpeed")
    @g::field_view(g::dimension_group("kpi-network-fan-info/hw_entity_fan_speed", metric::KpiNetworkFanInfoHwEntityFanSpeed.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "nfi_hw_entity_fan_speed_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-network-fan-info/hw_entity_fan_speed", metric::KpiNetworkFanInfoHwEntityFanSpeed.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("RPM")), [{statistic: samples::Statistic::Mean, publish: "nfi_hw_entity_fan_speed"}, {statistic: samples::Statistic::Max, publish: "nfi_hw_entity_fan_speed_max"}, {statistic: samples::Statistic::Min, publish: "nfi_hw_entity_fan_speed_min"}])
    hw_entity_fan_speed: Option(metric::KpiNetworkFanInfoHwEntityFanSpeed),
};
