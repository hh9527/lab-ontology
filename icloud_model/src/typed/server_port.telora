# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(String);
type Identity = struct { id: ComponentId };
type Row = struct {
    source_name: String,
    source_tenantId: i::TenantId,
    source_id: ComponentId,
    source_portType: String,
    source_linkStatus: String,
    source_cardResId: String,
    source_macAddress: String,
    source_projectId: String,
    source_parentResId: server::ServerOriginId,
};
def entity: m::Entity(Identity) = m::entity("server_port_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset("source_PhysicalServerPort", "PhysicalServerPort", Row.type, ["source_id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, ComponentId.type, "source_id"), m::field(Identity.type, ComponentId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "source_tenantId"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
def parent: m::Role(Row) = m::role(dataset, server::origin_entity, "server_origin", False, [m::identity_part(m::field(Row.type, server::ServerOriginId.type, "source_parentResId"), m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id"))]);
type SourcePhysicalServerPortPortType = struct(String);
def SourcePhysicalServerPortPortType_domain: v::Domain(SourcePhysicalServerPortPortType, String) = v::domain("SourcePhysicalServerPortPortType", SourcePhysicalServerPortPortType.type, String.type, [
    v::member(SourcePhysicalServerPortPortType("wire_OpticalPort_c215d09c"), ["OpticalPort"]),
    v::member(SourcePhysicalServerPortPortType("wire_ElectricalPort_0ae2b003"), ["ElectricalPort"]),
], False);
type SourcePhysicalServerPortLinkStatus = struct(String);
def SourcePhysicalServerPortLinkStatus_domain: v::Domain(SourcePhysicalServerPortLinkStatus, String) = v::domain("SourcePhysicalServerPortLinkStatus", SourcePhysicalServerPortLinkStatus.type, String.type, [
    v::member(SourcePhysicalServerPortLinkStatus("wire_Up_7b5a6329"), ["Up"]),
    v::member(SourcePhysicalServerPortLinkStatus("wire_Down_b561793d"), ["Down"]),
    v::member(SourcePhysicalServerPortLinkStatus("wire_NoLink_5ba24694"), ["NoLink"]),
    v::member(SourcePhysicalServerPortLinkStatus("wire_Unknown_56323c5e"), ["Unknown"]),
], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [subject, tenant, parent], [
    i::search(dataset, m::field(Row.type, String.type, "source_name"), "source_PhysicalServerPort__name"),
    i::exact(dataset, m::field(Row.type, i::TenantId.type, "source_tenantId"), "source_PhysicalServerPort__tenantId"),
    i::exact(dataset, m::field(Row.type, ComponentId.type, "source_id"), "source_PhysicalServerPort__id"),
    i::exact(dataset, m::field(Row.type, String.type, "source_cardResId"), "source_PhysicalServerPort__cardResId"),
    i::search(dataset, m::field(Row.type, String.type, "source_macAddress"), "source_PhysicalServerPort__macAddress"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "source_PhysicalServerPort__projectId"),
    i::exact(dataset, m::field(Row.type, server::ServerOriginId.type, "source_parentResId"), "source_PhysicalServerPort__parentResId"),
], []), [
    t::column(m::field(Row.type, String.type, "source_name"), "name"),
    t::column(m::field(Row.type, i::TenantId.type, "source_tenantId"), "tenantId"),
    t::column(m::field(Row.type, ComponentId.type, "source_id"), "id"),
    t::column(m::field(Row.type, String.type, "source_portType"), "portType"),
    t::column(m::field(Row.type, String.type, "source_linkStatus"), "linkStatus"),
    t::column(m::field(Row.type, String.type, "source_cardResId"), "cardResId"),
    t::column(m::field(Row.type, String.type, "source_macAddress"), "macAddress"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::field(Row.type, server::ServerOriginId.type, "source_parentResId"), "parentResId"),
 ]), [
    v::bind(dataset, v::dimension_group(SourcePhysicalServerPortPortType_domain, True, g::equality_filters), g::input(m::field(Row.type, String.type, "source_portType")), "source_PhysicalServerPort__portType", True, g::equality_filters),
    v::bind(dataset, v::dimension_group(SourcePhysicalServerPortLinkStatus_domain, True, g::equality_filters), g::input(m::field(Row.type, String.type, "source_linkStatus")), "source_PhysicalServerPort__linkStatus", True, g::equality_filters),
]);
def cardinality: edsl::RelationCardinality = {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0};
def relations: Array(r::Relation) = [
    r::relation("source_PhysicalServer_PhysicalServerPort", server::dataset, server::origin, dataset, parent, cardinality),
    r::relation("source_PhysicalServerPort_X_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, cardinality),
];
pub use self::{declaration, relations};
