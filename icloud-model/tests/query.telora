pub def knowledge_index_cross_references_are_model_derived: test::Test = test::should_ok(fn() {
    let catalog = edsl::knowledge_index(payload);
    let kpi = match array::find(catalog, fn(item) { item.id == "device_kpi" }) {
        Some(item) => item,
        None => fail!("device KPI missing from discovery index"),
    };
    let device = match array::find(catalog, fn(item) { item.id == "device" }) {
        Some(item) => item,
        None => fail!("device missing from discovery index"),
    };
    let link = edsl::relation_domain(payload, "device_kpi_of_device");
    let alarm = match array::find(catalog, fn(item) { item.id == "current_alarm" }) {
        Some(item) => item,
        None => fail!("event missing from discovery index"),
    };
    if kpi.kind == edsl::DatasetKind::Metric
        && kpi.label == "Device KPI samples"
        && array::any(kpi.measure_ids, fn(id) { id == "cpu_usage" })
        && array::any(kpi.measure_ids, fn(id) { id == "port_count_peak" })
        && array::any(kpi.metric_ids, fn(id) { id == "cpu_usage" })
        && alarm.kind == edsl::DatasetKind::Event
        && array::any(alarm.measure_ids, fn(id) { id == "alarm_count" })
        && array::length(alarm.metric_ids) == 0
        && array::any(device.measure_ids, fn(id) { id == "device_count" })
        && array::any(kpi.relation_ids, fn(id) { id == "device_kpi_of_device" })
        && array::any(device.relation_ids, fn(id) { id == "device_kpi_of_device" })
        && link.label == "Samples for device"
        && link.summary == "Resource and tenant identify the KPI owner" {
        True
    } else {
        fail!("discovery index lost its model cross references", kpi, device, link)
    }
});

pub def public_knowledge_index_retains_event_count: test::Test = test::should_ok(fn() {
    let catalog = edsl::knowledge_index_for_subject(payload, "public");
    let alarm = match array::find(catalog, fn(item) { item.id == "current_alarm" }) {
        Some(item) => item, None => fail!("current alarm missing from public catalog"),
    };
    if array::any(alarm.measure_ids, fn(id) { id == "alarm_count" })
        && array::any(alarm.dimension_ids, fn(id) { id == "alarm_csn" }) {
        True
    } else { fail!("public catalog lost lowerable event knowledge", alarm) }
});

pub def measure_knowledge_explains_event_count_and_sample_summaries: test::Test = test::should_ok(fn() {
    let alarm = edsl::measure_domain_for_subject(payload, "public", "alarm_count");
    let port = edsl::measure_domain(payload, "port_count");
    let peak = edsl::measure_domain(payload, "port_count_peak");
    let peak_role = match peak.metric {
        Some(metadata) => metadata.role == edsl::MetricValueRole::SampleSummary,
        None => False,
    };
    if alarm.dataset == "current_alarm" && alarm.field == Some("csn")
        && alarm.aggregate == Some(qb::AggregateFunction::Count)
        && alarm.label == "Alarm count" && array::length(alarm.required_dataset_ids) == 0
        && alarm.metric == None
        && port.aggregate == Some(qb::AggregateFunction::Sum)
        && peak.aggregate == Some(qb::AggregateFunction::Max)
        && port.field == peak.field && port.label != peak.label && peak_role {
        True
    } else { fail!("measure discovery lost declared event or KPI semantics", alarm, port, peak) }
});

