    @g::field_view(g::dimension_group("network-element-2-kpi-fatap/obj_id", domain::Reference(ids::NetworkElement2KpiFatapByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "neelfa_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::NetworkElement2KpiFatapByObjId)),
