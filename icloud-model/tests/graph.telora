pub def outer_constraint_preserves_named_relation_key: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"server",
        "nodes":[{"id":"server","entity":"server_device"},{"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "constraints":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "select":[{"node":"server","dimension":"server_name"}]
    }"#).unwrap!());
    if string::contains(query.sql, "WHERE server.tenantId = tenant.TENANT_ID") { True }
    else { fail!(`outer constraint did not materialize its named key: \{query.sql}`) }
});

pub def empty_population_rejects_where_constraint: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"server",
        "nodes":[{"id":"server","entity":"server_device"},{"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "constraints":[{"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "include_empty":true, "select":[{"node":"server","dimension":"server_name"}]
    }"#).unwrap!())
}, "graph include_empty cannot apply constraint edges in WHERE without changing empty populations");
