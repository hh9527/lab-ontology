        )
    },
    "UQL buckets support hour, day and month units only"
);
pub def date_hour_bucket_is_rejected: test::Test = test::should_fail_with(
    fn() {
        uql::render_expr_with_context(
            qb::scalar(
                qb::ScalarFunction::UtcTimeBucket(
                    {unit: qb::UtcBucketUnit::Hour, encoding: qb::UtcBucketEncoding::Date}
                ),
