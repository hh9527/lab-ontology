}, "graph dimension order requires raw rows");

pub def site_device_value_set_requires_explicit_distinct: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"site","distinct":true,
        "nodes":[{"id":"site","entity":"site"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_located_at_site","from":"device","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"},
                  {"node":"device","dimension":"device_name"}],
        "filters":[{"node":"site","dimension":"site_type","op":"eq","kind":"text","value":"offline"}]
    }"#).unwrap!();
    let sqlite_query = lower(intent);
    let pg_query = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sqlite_query.sql, "SELECT DISTINCT site.SITE_NAME AS site_site_name, device.name AS device_device_name")
        && string::contains(pg_query.sql, "SELECT DISTINCT \"site\".\"SITE_NAME\"")
        && string::contains(sqlite_query.sql, "device.projectId = site.SITE_ID")
        && string::contains(sqlite_query.sql, "device.refParentSubnet = site.SITE_ID")
        && sqlite_query.bindings == pg_query.bindings { True }
    else { fail!(`site-device value-set semantics lost: \{sqlite_query.sql} / \{pg_query.sql}`) }
});

pub def site_name_value_count_is_distinct_not_entity_count: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"server",
        "nodes":[{"id":"server","entity":"server_device"},{"id":"site","entity":"site"}],
        "edges":[{"relation":"server_located_at_site","from":"server","to":"site"}],
        "select":[],"count_value":{"node":"site","dimension":"site_name"},
        "filters":[{"node":"server","dimension":"server_asset_number","op":"eq","kind":"text","value":"AN-000001"},
                   {"node":"server","dimension":"server_class","op":"eq","kind":"text","value":"kunlun"}]}"#).unwrap!();
    let sqlite_query = lower(intent);
    let pg_query = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sqlite_query.sql, "count(DISTINCT site.SITE_NAME)")
        && string::contains(pg_query.sql, "count(DISTINCT \"site\".\"SITE_NAME\")")
        && sqlite_query.bindings == pg_query.bindings
        && sqlite_query.bindings == [qb::Val::String("AN-000001"), qb::Val::String("ne.category.server.kunlun")] { True }
    else { fail!(`site-name count lost value distinct or dialect-independent bindings: \{sqlite_query.sql} / \{pg_query.sql}`, sqlite_query.bindings, pg_query.bindings) }
});

pub def rack_server_site_qualifies_link_without_multiplying_link_count: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"link",
        "nodes":[{"id":"link","entity":"physical_link"}],"edges":[],
        "select":[],"count":"link",
        "filters":[{"node":"link","dimension":"physical_link_type","op":"eq","kind":"text","value":"manual"}],
        "exists":[{"anchor":"link",
            "nodes":[{"id":"server","entity":"server_device"},{"id":"site","entity":"site"}],
            "edges":[{"relation":"physical_link_attached_server","from":"link","to":"server"},
                     {"relation":"server_located_at_site","from":"server","to":"site"}],
            "filters":[{"node":"server","dimension":"server_class","op":"eq","kind":"text","value":"rack"},
                       {"node":"server","dimension":"server_ip_address","op":"eq","kind":"text","value":"103.0.1.2"},
                       {"node":"site","dimension":"site_name","op":"eq","kind":"text","value":"Q0350-site"}]}]}"#).unwrap!();
    let ast = query_intent_ast_factory(payload, "public")(intent);
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "count(link.id)")
        && string::contains(sq.sql, "EXISTS (SELECT 1")
        && string::contains(sq.sql, "link.tenantId = server.tenantId")
        && string::contains(sq.sql, "server.ipAddress")
        && sq.bindings == pg.bindings { True }
    else { fail!(`server link count lost A/Z or tenant scope: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

