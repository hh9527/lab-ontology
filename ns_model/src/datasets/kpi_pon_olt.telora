    ne_ping_resp_time: Option(metric::KpiPonOltNePingRespTime),
};

pub def relations: Array(r::Relation) = [
    r::relation("po__peo2_rev", domain::endpoint(KpiPonOlt.type, "obj_id"), domain::endpoint(pon_element_olt_2_kpi::PonElementOlt2Kpi.type, "obj_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
