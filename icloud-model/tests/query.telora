});

pub def physical_link_endpoints_are_directional: test::Test = test::should_ok(fn() {
    let request: edsl::QueryRequest = {
        measures: [],
        dimensions: [{ id: "physical_link_id", subject: "public", input: edsl::DimensionInput::None }],
        filters: [], ordering: [], limit: None, offset: None, partition: None,
    };
    let peer: edsl::PeerRequest = {
        subject: "public",
        origin: { entity: "device", key: Some(edsl::FilterInput::Text("device-a")), filters: [] },
        peer: { entity: "device", key: Some(edsl::FilterInput::Text("device-z")), filters: [] },
    };
    let q = qb::transform_sqlite(edsl::lower_peer(payload, request, [peer]));
    if array::length(string::split(q.sql, "pl.a_ne_res_id = d_o.id")) > 1
        && array::length(string::split(q.sql, "pl.z_ne_res_id = d_p.id")) > 1
        && array::length(string::split(q.sql, "pl.tenantId = d_o.tenant_id")) > 1
        && array::length(string::split(q.sql, "pl.tenantId = d_p.tenant_id")) > 1
        && array::length(string::split(q.sql, " OR ")) == 1
        && q.bindings == [qb::Val::String("device-a"), qb::Val::String("device-z")] {
        True
    } else {
        fail!("physical link endpoints must not be exchanged", q)
    }
});

pub def peer_hub_rejects_incomplete_participant_identity: test::Test = test::should_fail_with(fn() {
    let relations = array::map(payload.relations, fn(relation) {
        if relation.id == "physical_link_a_device" {
            let key = match relation.key {
                edsl::RelationKey::And(keys) => match array::get(keys, 0) {
                    Some(first) => first,
                    None => fail!("missing A endpoint key"),
                },
                _ => fail!("expected compound A endpoint relation"),
            };
            {...relation, key}
        } else { relation }
    });
    let broken = {...payload, relations};
    edsl::lower_peer(broken,
        {measures: [], dimensions: [{id: "physical_link_id", subject: "public", input: edsl::DimensionInput::None}],
         filters: [], ordering: [], limit: None, offset: None, partition: None},
        [{subject: "public", origin: {entity: "device", key: None, filters: []},
          peer: {entity: "device", key: None, filters: []}}])
}, "peer hub role relation must match its endpoint and full participant grain");

