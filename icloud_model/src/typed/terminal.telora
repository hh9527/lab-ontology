use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 终端来源独立声明：不收紧 M:N 上界，时间单位仍待生产确认。
use super::inventory as i;
use super::site as sites;
use super::pon_device as pons;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
type TerminalId = struct(
    String
);
@registry::entity("terminal_entity")
type Identity = struct {
    id: TerminalId
};
@registry::dataset("source_EntTerminalElement", "EntTerminalElement", ["source_resId"])
@registry::roles([subject, tenant, site, project, device, pon])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(EntTerminalElement.type, String.type, "source_ip"))),
            "source_EntTerminalElement__ip_ipv4",
            True,
            g::ipv4_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("integer", Int.type, True, g::numeric_filters),
            g::input(m::field(EntTerminalElement.type, Int.type, "source_vlanId")),
            "source_EntTerminalElement__vlanId",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("integer", Int.type, True, g::numeric_filters),
            g::input(m::field(EntTerminalElement.type, Int.type, "source_unauthorized")),
            "source_EntTerminalElement__unauthorized",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("integer", Int.type, True, g::numeric_filters),
            g::input(m::field(EntTerminalElement.type, Int.type, "source_isBlocked")),
            "source_EntTerminalElement__isBlocked",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::numeric_filters),
            g::input(m::field(EntTerminalElement.type, s::EpochMillis.type, "source_blockTime")),
            "source_EntTerminalElement__blockTime",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
@registry::alternatives(alternatives)
type EntTerminalElement = struct {
    @m::column("tenantId")
    @g::exact("source_EntTerminalElement__tenantId")
    source_tenantId: i::TenantId,
    @m::column("projectId")
    @g::exact("source_EntTerminalElement__projectId")
    source_projectId: i::SiteId,
    @m::column("resId")
    @g::exact("source_EntTerminalElement__resId")
    source_resId: TerminalId,
    @m::column("mac")
    @g::search("source_EntTerminalElement__mac")
    source_mac: String,
    @m::column("name")
    @g::search("source_EntTerminalElement__name")
    source_name: String,
    @m::column("ip")
    @g::search("source_EntTerminalElement__ip")
    source_ip: String,
    @m::column("ipv6")
    @g::search("source_EntTerminalElement__ipv6")
    source_ipv6: String,
    @m::column("status")
    @v::classification(SourceEntTerminalElementStatus_domain, "source_EntTerminalElement__status")
    source_status: Int,
    @m::column("type")
    @v::classification(SourceEntTerminalElementType_domain, "source_EntTerminalElement__type")
    source_type: String,
    @m::column("vendor")
    @g::search("source_EntTerminalElement__vendor")
    source_vendor: String,
    @m::column("model")
    @g::search("source_EntTerminalElement__model")
    source_model: String,
    @m::column("serialNumber")
    @g::search("source_EntTerminalElement__serialNumber")
    source_serialNumber: String,
    @m::column("osName")
    @g::search("source_EntTerminalElement__osName")
    source_osName: String,
    @m::column("priority")
    @v::classification(
        SourceEntTerminalElementPriority_domain,
        "source_EntTerminalElement__priority"
    )
    source_priority: Int,
    @m::column("source")
    @v::classification(SourceEntTerminalElementSource_domain, "source_EntTerminalElement__source")
    source_source: Int,
    @m::column("remark")
    @g::search("source_EntTerminalElement__remark")
    source_remark: String,
    @m::column("accessDeviceId")
    @g::exact("source_EntTerminalElement__accessDeviceId")
    source_accessDeviceId: String,
    @m::column("accessIfName")
    @g::search("source_EntTerminalElement__accessIfName")
    source_accessIfName: String,
    @m::column("vlanId")
    source_vlanId: Int,
    @m::column("siteId")
    @g::exact("source_EntTerminalElement__siteId")
    source_siteId: i::SiteId,
    @m::column("unauthorized")
    source_unauthorized: Int,
    @m::column("isBlocked")
    source_isBlocked: Int,
    @m::column("blockStatus")
    @v::classification(
        SourceEntTerminalElementBlockStatus_domain,
        "source_EntTerminalElement__blockStatus"
    )
    source_blockStatus: Int,
    # 沿用旧 UTC 毫秒假定；来源整数时钟单位尚待确认。
    @m::column("blockTime")
    source_blockTime: s::EpochMillis,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(EntTerminalElement) = registry::dataset_of(EntTerminalElement.type);
def subject: m::Role(EntTerminalElement) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(EntTerminalElement.type, TerminalId.type, "source_resId"),
            m::field(Identity.type, TerminalId.type, "id")
        )
    ]
);
def tenant: m::Role(EntTerminalElement) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(EntTerminalElement.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def site: m::Role(EntTerminalElement) = m::role(
    dataset,
    sites::entity,
    "site",
    False,
    [
        m::identity_part(
            m::field(EntTerminalElement.type, i::SiteId.type, "source_siteId"),
            m::field(sites::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def project: m::Role(EntTerminalElement) = m::role(
    dataset,
    sites::entity,
    "project",
    False,
    [
        m::identity_part(
            m::field(EntTerminalElement.type, i::SiteId.type, "source_projectId"),
            m::field(sites::Identity.type, i::SiteId.type, "id")
        )
    ]
);
def device: m::Role(EntTerminalElement) = m::role(
    dataset,
    i::device,
    "device",
    False,
    [
        m::reference_part(
            m::field(EntTerminalElement.type, String.type, "source_accessDeviceId"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def pon: m::Role(EntTerminalElement) = m::role(
    dataset,
    pons::entity,
    "pon",
    False,
    [
        m::reference_part(
            m::field(EntTerminalElement.type, String.type, "source_accessDeviceId"),
            m::field(pons::Identity.type, pons::PonId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementStatus = enum {
    @ev::itag(-1)
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::itag(0)
    @ev::description("Online", "在线")
    Online,
    @ev::itag(1)
    @ev::description("Offline", "离线")
    Offline,
};
def SourceEntTerminalElementStatus_domain: v::Domain(SourceEntTerminalElementStatus, Int) = v::from_enum(
    "SourceEntTerminalElementStatus",
    SourceEntTerminalElementStatus.type,
    Int.type,
    False
);

