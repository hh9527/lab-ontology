use ontology::knowledge_policy as knowledge_policy;
# 物理链路：A/Z 是固定物理位置，业务方向由显式条件决定。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type LinkId = struct(
    String
);
type Identity = struct {
    id: LinkId
};
type Row = struct {
    a_ne_res_id: String,
    tenant_id: i::TenantId,
    a_ne_name: String,
    z_ne_name: String,
    id: LinkId,
    name: String,
    link_type: Int,
    direction: String,
    link_status: Int,
    z_ne_res_id: String,
    a_port_ip: String,
    z_port_name: String,
    a_ne_ip: String,
    source_alias: String,
    source_aEndME: String,
    source_zEndME: String,
    source_createTime: s::EpochMillis,
    source_speed: String,
    source_projectId: String,
    source_zPortIp: String,
    source_zPortAlias: String,
    source_zPortDn: String,
    source_zNeIp: String,
    source_aPortAlias: String,
    source_aPortName: String,
    source_aPortDn: String,
};
def entity: m::Entity(Identity) = m::entity("physical_link_entity", Identity.type);
def dataset: m::Dataset(Row) = m::dataset(
    "physical_link",
    "EnterprisePhysicalLink",
    Row.type,
    ["id"]
);
def subject: m::Role(Row) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(Row.type, LinkId.type, "id"),
            m::field(Identity.type, LinkId.type, "id")
        )
    ]
);
def tenant: m::Role(Row) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(Row.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def a_device: m::Role(Row) = m::role(
    dataset,
    i::device,
    "a_device",
    False,
    [
        m::reference_part(
            m::field(Row.type, String.type, "a_ne_res_id"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def z_device: m::Role(Row) = m::role(
    dataset,
    i::device,
    "z_device",
    False,
    [
        m::reference_part(
            m::field(Row.type, String.type, "z_ne_res_id"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def a_server: m::Role(Row) = m::role(
    dataset,
    server::entity,
    "a_server",
    False,
    [
        m::reference_part(
            m::field(Row.type, String.type, "a_ne_res_id"),
            m::field(server::Identity.type, server::ServerId.type, "id")
        )
    ]
);
def z_server: m::Role(Row) = m::role(
    dataset,
    server::entity,
    "z_server",
    False,
    [
        m::reference_part(
            m::field(Row.type, String.type, "z_ne_res_id"),
            m::field(server::Identity.type, server::ServerId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type PhysicalLinkType = struct(
    String
);
def PhysicalLinkType_domain: v::Domain(PhysicalLinkType, Int) = v::domain(
    "PhysicalLinkType",
    PhysicalLinkType.type,
    Int.type,
    [
        v::member(PhysicalLinkType("manual"), [99]),
        v::member(PhysicalLinkType("lldp"), [1]),
        v::member(PhysicalLinkType("wire_2_d0a68914"), [2]),
        v::member(PhysicalLinkType("wire_3_bab86ec8"), [3]),
        v::member(PhysicalLinkType("wire_4_5978b238"), [4]),
        v::member(PhysicalLinkType("wire_5_c6f5830f"), [5]),
        v::member(PhysicalLinkType("wire_6_02a10e4d"), [6]),
        v::member(PhysicalLinkType("csp"), [7]),
        v::member(PhysicalLinkType("server_internal"), [8]),
        v::member(PhysicalLinkType("fiber_search"), [9]),
        v::member(PhysicalLinkType("wire_10_63a7292b"), [10]),
        v::member(PhysicalLinkType("wire_11_2c163c76"), [11]),
        v::member(PhysicalLinkType("wire_12_5dc4ea39"), [12]),
        v::member(PhysicalLinkType("wire_13_c3b4db05"), [13]),
        v::member(PhysicalLinkType("wire_100_9fe18167"), [100]),
    ],
    False
);
@knowledge_policy::reverse_references(True)
type PhysicalLinkDirection = struct(
    String
);
def PhysicalLinkDirection_domain: v::Domain(PhysicalLinkDirection, String) = v::domain(
    "PhysicalLinkDirection",
    PhysicalLinkDirection.type,
    String.type,
    [
        v::member(PhysicalLinkDirection("bidirectional"), ["bidirectional"]),
        v::member(PhysicalLinkDirection("unidirectional"), ["unidirectional"]),
    ],
    False
);
@knowledge_policy::reverse_references(True)
type PhysicalLinkStatus = struct(
    String
);
def PhysicalLinkStatus_domain: v::Domain(PhysicalLinkStatus, Int) = v::domain(
    "PhysicalLinkStatus",
    PhysicalLinkStatus.type,
    Int.type,
    [
        v::member(PhysicalLinkStatus("fault"), [2, 3]),
        v::member(PhysicalLinkStatus("wire_0_92e42f8f"), [0]),
        v::member(PhysicalLinkStatus("wire_1_8d618873"), [1]),
        v::member(PhysicalLinkStatus("wire_4_5978b238"), [4]),
        v::member(PhysicalLinkStatus("wire_5_c6f5830f"), [5]),
    ],
    False
);
def a_ne_name_dimension: g::Binding(Row) = i::search(
    dataset,
    m::field(Row.type, String.type, "a_ne_name"),
    "physical_link_a_ne_name"
);
def z_ne_name_dimension: g::Binding(Row) = i::search(
    dataset,
    m::field(Row.type, String.type, "z_ne_name"),
    "physical_link_z_ne_name"
);
def declaration: t::Declaration = t::with_native_pairs(
    t::with_domains(
        t::map_columns(
            t::declare(
                dataset,
                [subject, tenant, a_device, z_device, a_server, z_server],
                [
                    a_ne_name_dimension,
                    z_ne_name_dimension,
                    i::exact(dataset, m::field(Row.type, LinkId.type, "id"), "physical_link_id"),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "name"),
                        "physical_link_name"
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "a_port_ip"),
                        "physical_link_a_port_ip"
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
                        g::ipv4(g::input(m::field(Row.type, String.type, "a_port_ip"))),
                        "physical_link_a_port_ip_ipv4",
                        True,
                        g::ipv4_filters
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "z_port_name"),
                        "physical_link_z_port_name"
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "a_ne_ip"),
                        "physical_link_a_ne_ip"
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
                        g::ipv4(g::input(m::field(Row.type, String.type, "a_ne_ip"))),
                        "physical_link_a_ne_ip_ipv4",
                        True,
                        g::ipv4_filters
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "source_alias"),
                        "physical_link__alias"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_aEndME"),
                        "physical_link__aEndME"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_zEndME"),
                        "physical_link__zEndME"
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::time_filters),
                        g::input(m::field(Row.type, s::EpochMillis.type, "source_createTime")),
                        "physical_link__createTime",
                        True,
                        g::time_filters
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_speed"),
                        "physical_link__speed"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_projectId"),
                        "physical_link__projectId"
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "source_zPortIp"),
                        "physical_link__zPortIp"
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
                        g::ipv4(g::input(m::field(Row.type, String.type, "source_zPortIp"))),
                        "physical_link__zPortIp_ipv4",
                        True,
                        g::ipv4_filters
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "source_zPortAlias"),
                        "physical_link__zPortAlias"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_zPortDn"),
                        "physical_link__zPortDn"
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "source_zNeIp"),
                        "physical_link__zNeIp"
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
                        g::ipv4(g::input(m::field(Row.type, String.type, "source_zNeIp"))),
                        "physical_link__zNeIp_ipv4",
                        True,
                        g::ipv4_filters
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "source_aPortAlias"),
                        "physical_link__aPortAlias"
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "source_aPortName"),
                        "physical_link__aPortName"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_aPortDn"),
                        "physical_link__aPortDn"
                    ),
                ],
                ["physical_link_count"]
            ),
            [
                t::column(m::field(Row.type, String.type, "a_ne_res_id"), "aNeResId"),
                t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
                t::column(m::field(Row.type, String.type, "a_ne_name"), "aNeName"),
                t::column(m::field(Row.type, String.type, "z_ne_name"), "zNeName"),
                t::column(m::field(Row.type, LinkId.type, "id"), "id"),
                t::column(m::field(Row.type, String.type, "name"), "name"),
                t::column(m::field(Row.type, Int.type, "link_type"), "linkType"),
                t::column(m::field(Row.type, String.type, "direction"), "direction"),
                t::column(m::field(Row.type, Int.type, "link_status"), "linkStatus"),
                t::column(m::field(Row.type, String.type, "z_ne_res_id"), "zNeResId"),
                t::column(m::field(Row.type, String.type, "a_port_ip"), "aPortIp"),
                t::column(m::field(Row.type, String.type, "z_port_name"), "zPortName"),
                t::column(m::field(Row.type, String.type, "a_ne_ip"), "aNeIp"),
                t::column(m::field(Row.type, String.type, "source_alias"), "alias"),
                t::column(m::field(Row.type, String.type, "source_aEndME"), "aEndME"),
                t::column(m::field(Row.type, String.type, "source_zEndME"), "zEndME"),
                t::column(
                    m::field(Row.type, s::EpochMillis.type, "source_createTime"),
                    "createTime"
                ),
                t::column(m::field(Row.type, String.type, "source_speed"), "speed"),
                t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
                t::column(m::field(Row.type, String.type, "source_zPortIp"), "zPortIp"),
                t::column(m::field(Row.type, String.type, "source_zPortAlias"), "zPortAlias"),
                t::column(m::field(Row.type, String.type, "source_zPortDn"), "zPortDn"),
                t::column(m::field(Row.type, String.type, "source_zNeIp"), "zNeIp"),
                t::column(m::field(Row.type, String.type, "source_aPortAlias"), "aPortAlias"),
                t::column(m::field(Row.type, String.type, "source_aPortName"), "aPortName"),
                t::column(m::field(Row.type, String.type, "source_aPortDn"), "aPortDn"),
            ]
        ),
        [
            v::bind(
                dataset,
                v::dimension_group(PhysicalLinkType_domain, True, g::equality_filters),
                g::input(m::field(Row.type, Int.type, "link_type")),
                "physical_link_type",
                True,
                g::equality_filters
            ),
            v::bind(
                dataset,
                v::dimension_group(PhysicalLinkDirection_domain, True, g::equality_filters),
                g::input(m::field(Row.type, String.type, "direction")),
                "physical_link_direction",
                True,
                g::equality_filters
            ),
            v::bind(
                dataset,
                v::dimension_group(PhysicalLinkStatus_domain, True, g::equality_filters),
                g::input(m::field(Row.type, Int.type, "link_status")),
                "physical_link_status",
                True,
                g::equality_filters
            ),
        ]
    ),
    [t::native_pair("link_ne_names", a_ne_name_dimension, z_ne_name_dimension)]
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def many_many: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Many0
};
def a: r::Relation = r::relation(
    "physical_link_a_device",
    dataset,
    a_device,
    i::devices,
    i::device_subject,
    cardinality
);
def z: r::Relation = r::relation(
    "physical_link_z_device",
    dataset,
    z_device,
    i::devices,
    i::device_subject,
    cardinality
);
def relations: Array(r::Relation) = [
    a,
    z,
    r::relation(
        "physical_link_belongs_to_tenant",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        cardinality
    )
];
def alternatives: Array(t::Alternative) = [
    {id: "physical_link_attached_device", choices: [a, z], cardinality: many_many},
    {
        id: "physical_link_attached_server",
        choices: [
            r::relation(
                "link_a_server",
                dataset,
                a_server,
                server::dataset,
                server::subject,
                cardinality
            ),
            r::relation(
                "link_z_server",
                dataset,
                z_server,
                server::dataset,
                server::subject,
                cardinality
            )
        ],
        cardinality: many_many
    },
];
def links: Array(r::Link) = [
    r::guarded_link(
        r::link("physical_link_peer_device", a, z, edsl::LinkDirection::Undirected),
        m::field(Row.type, String.type, "direction"),
        edsl::FilterOp::Eq,
        "bidirectional"
    ),
    r::guarded_link(
        r::link("physical_link_downstream_device", a, z, edsl::LinkDirection::Directed),
        m::field(Row.type, String.type, "direction"),
        edsl::FilterOp::Eq,
        "unidirectional"
    ),
];
pub use self::{Row, dataset, declaration, relations, alternatives, links};
