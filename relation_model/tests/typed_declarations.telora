use ontology::declarations as d;
use ontology::ontology as edsl;
use std::test as test;

@edsl::entity_id("identity")
type Identity = struct {
    id: String
};
@edsl::entity_id("plain")
@edsl::entity_source("plain_rows", "p")
type Plain = struct {
    id: String
};
@edsl::entity_id("metrics")
@edsl::entity_source("metric_rows", "m")
@edsl::dataset(edsl::DatasetKind::Metric, ["id", "at"], Some("at"))
type Metric = struct {
    id: String,
    at: Int
};
@edsl::entity_id("events")
@edsl::entity_source("event_rows", "e")
@edsl::dataset(edsl::DatasetKind::Event, ["id"], Some("at"))
type Event = struct {
    id: String,
    at: Int
};

type Manual = struct {
    id: String
};
impl d::DatasetModel for Manual {
    describe: fn() {
        {
            id: "manual",
            source: "manual_rows",
            grain: ["id"],
            kind: edsl::DatasetKind::Entity,
            clock: None
        }.ty!(d::DatasetInfo)
    },
};
# exact impl 优先于注解驱动的 blanket impl。
@edsl::entity_id("annotated")
@edsl::entity_source("ignored_rows", "i")
type Override = struct {
    id: String
};
impl d::DatasetModel for Override {
    describe: fn() {
        {
            id: "override",
            source: "chosen_rows",
            grain: [],
            kind: edsl::DatasetKind::Entity,
            clock: None
        }.ty!(d::DatasetInfo)
    },
};

pub def entity_identity: test::Test = test::should_ok(
    fn() {
        let entity = d::entity(Identity.type);
        entity.id == "identity" && entity.identity == Identity.type
    }
);
pub def absent_optional_spec: test::Test = test::should_ok(
    fn() {
        let value = d::declare(Plain.type, [], [], []);
        value.dataset.id == "plain" && value.dataset.source == "plain_rows" && value.dataset.grain == [] && value.kind == edsl::DatasetKind::Entity && value.clock == None
    }
);
pub def metric_and_event_keep_semantics: test::Test = test::should_ok(
    fn() {
        let metric = d::declare(Metric.type, [], [], []);
        let event = d::declare(Event.type, [], [], []);
        metric.kind == edsl::DatasetKind::Metric && metric.clock == Some("at") && metric.dataset.grain == [
            "id",
            "at"
        ] && event.kind == edsl::DatasetKind::Event && event.clock == Some("at")
    }
);
pub def explicit_impl_and_override: test::Test = test::should_ok(
    fn() {
        let manual = d::dataset(Manual.type);
        let override = d::dataset(Override.type);
        manual.id == "manual" && manual.source == "manual_rows" && override.id == "override" && override.source == "chosen_rows"
    }
);
