});

pub def alarm_severity_projection_returns_canonical_business_value: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[], "select":[{"node":"alarm","dimension":"alarm_severity"}]
    }"#).unwrap!());
    if string::contains(query.sql, "CASE WHEN")
        && string::contains(query.sql, "alarm.SEVERITY")
        && query.bindings == [qb::Val::None, qb::Val::String("1"), qb::Val::String("critical"),
            qb::Val::String("2"), qb::Val::String("major"), qb::Val::String("3"), qb::Val::String("minor"),
            qb::Val::String("4"), qb::Val::String("warning")] { True }
    else { fail!(`alarm projection exposed a physical wire instead of the declared value: \{query.sql}`, query.bindings) }
});

pub def grouped_alarm_severity_uses_canonical_grain: test::Test = test::should_ok(fn() {
