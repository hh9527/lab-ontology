# Contract tests for the EnterpriseKnowledge eDSL.
#
# Runs assertions over:
#   property fold, request coverage, relation selection, equality/range filters,
#   unprojected filter dimensions, measure-desc/dimension-asc ordering, Top N,
#   binding order, profile coverage, repeated-lowering determinism, and
#   cross-module prepared behavior.
#
# Any failed assertion fails the exported Test loudly.

use crate::query as qb;
use std::value::{ Value };
use std::array as array;
use std::string as string;
use std::type_property as property;
use std::type_desc as td;
use std::test as test;
use crate::ontology as edsl;
use crate::test_models::test_knowledge as knowledge;

def missing_predicate_field: edsl::ScopePredicate = {
    field: 99, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("run"),
};
def undeclared_predicate_dimension: edsl::ScopePredicate = {
    field: 1, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("run"),
};
def unsupported_predicate_operator: edsl::ScopePredicate = {
    field: 1, op: edsl::FilterOp::Gt, input: edsl::FilterInput::Text("run"),
};

@edsl::entity_source("bad_predicate_field", "bpf")
type BadPredicateField = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::filtered_measure("bad_field_count", qb::AggregateFunction::Count, [], missing_predicate_field)
    id: Int,
};

@edsl::entity_source("bad_predicate_dimension", "bpd")
type BadPredicateDimension = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::filtered_measure("bad_dimension_count", qb::AggregateFunction::Count, [], undeclared_predicate_dimension)
    id: Int,
    @edsl::column("status")
    status: String,
};

@edsl::entity_source("bad_predicate_operator", "bpo")
type BadPredicateOperator = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::filtered_measure("bad_operator_count", qb::AggregateFunction::Count, [], unsupported_predicate_operator)
    id: Int,
    @edsl::column("status")
    @edsl::dimension("bad_predicate_status", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    status: String,
};

pub def invalid_measure_predicate_field_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-predicate-field-v1", [BadPredicateField.type], knowledge::profile,
        fn(subject) { subject == "analyst" })
}, "measure predicate references an unknown field");

pub def undeclared_measure_predicate_dimension_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-predicate-dimension-v1", [BadPredicateDimension.type], knowledge::profile,
        fn(subject) { subject == "analyst" })
}, "measure predicate references a field with no dimension declaration");

pub def unsupported_measure_predicate_operator_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-predicate-operator-v1", [BadPredicateOperator.type], knowledge::profile,
        fn(subject) { subject == "analyst" })
}, "measure predicate uses an operation not supported by the dimension");

def text_aggregate_scope: edsl::ScopePredicate = {
    field: 1, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("active"),
};

@edsl::entity_source("invalid_sum_source", "iss")
type InvalidTextSum = struct {
    @edsl::column("state")
    @edsl::measure("state_sum", qb::AggregateFunction::Sum, [])
    state: String,
};

@edsl::entity_source("invalid_avg_source", "ias")
type InvalidFilteredTextAvg = struct {
    @edsl::column("id")
    id: Int,
    @edsl::column("state")
    @edsl::dimension("filter_state", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    @edsl::filtered_measure("state_avg", qb::AggregateFunction::Avg, [], text_aggregate_scope)
    state: String,
};

@edsl::entity_source("valid_text_aggregate_source", "vtas")
type ValidTextAggregate = struct {
    @edsl::column("id")
    id: Int,
    @edsl::column("state")
    @edsl::dimension("valid_filter_state", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    @edsl::measure("state_count", qb::AggregateFunction::Count, [])
    @edsl::filtered_measure("first_state", qb::AggregateFunction::Min, [], text_aggregate_scope)
    state: String,
};

pub def text_sum_is_rejected_during_model_preparation: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid-sum-v1", [InvalidTextSum.type], knowledge::profile, fn(subject) { True })
}, "Sum and Avg measures require a numeric field");

pub def filtered_text_avg_is_rejected_during_model_preparation: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid-avg-v1", [InvalidFilteredTextAvg.type], knowledge::profile, fn(subject) { True })
}, "Sum and Avg measures require a numeric field");

pub def text_count_and_min_remain_modelled: test::Test = test::should_ok(fn() {
    let payload = edsl::build_root("valid-text-aggregates-v1", [ValidTextAggregate.type], knowledge::profile,
        fn(subject) { True });
    array::length(payload.measures) == 2
});

