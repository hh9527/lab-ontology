    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("healthStatus")
    @g::field_view(g::dimension_group("host/health_status/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "ho_health_status_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::HoHealthStatus.type, "ho_health_status", [v::member(domains::HoHealthStatus::Normal, ["1"]), v::member(domains::HoHealthStatus::NoRedundantPath, ["17"]), v::member(domains::HoHealthStatus::Offline, ["18"])])
