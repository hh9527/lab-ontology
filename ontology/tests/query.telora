# ---------------------------------------------------------------------------
# P1: deterministic SQL/bindings order across multi-source plans that combine
# structured filter, correlated EXISTS, HAVING and role-alias joins.
# ---------------------------------------------------------------------------

def combined_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-combined",
        sources: [qb.source("t", "transfers")],
        projection: [
            qb.expr_item(qb.column("t", "id")),
            qb.expr_item(qb.column("a", "site")),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("t", "id"), False, "transfer_count"),
        ],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("t", "kind"), qb.bind_string("wire")])),
        exists: [qb.exists(
            qb.source("x", "signals"),
            [qb.column_eq(qb.column_ref("t", "id"), qb.column_ref("x", "transfer_id"))],
            Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("x", "level"), qb.bind_int(1)])),
        )],
        joins: [
            qb.join(
                qb.JoinKind.Inner,
                qb.source("a", "accounts"),
                qb.column_ref("t", "from_id"),
                qb.column_ref("a", "id"),
            ),
            qb.join_on(qb.JoinKind.Inner, qb.source("r", "accounts"), qb.on_and([
                qb.on_eq(qb.column_ref("t", "to_id"), qb.column_ref("r", "id")),
                qb.on_or([
                    qb.on_eq(qb.column_ref("a", "site"), qb.column_ref("r", "site")),
                    qb.on_eq(qb.column_ref("a", "region"), qb.column_ref("r", "region")),
                ]),
            ])),
        ],
        grouping: [qb.column("t", "id"), qb.column("a", "site")],
        having: [qb.having(qb.HavingOp.Gt, "transfer_count", qb.Val.Int(2))],
        ordering: [qb.desc_aggregate("transfer_count"), qb.asc(qb.column("a", "site"))],
        limit: Some(10),
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def combined_relations_deterministic_sql_and_bindings = fn() {
    let q1 = qb.transform_sqlite(combined_plan());
    let q2 = qb.transform_sqlite(combined_plan());
    let expected: Array(qb.Val) = [qb.Val.String("wire"), qb.Val.Int(1), qb.Val.Int(2), qb.Val.Int(10)];
    q1.sql == q2.sql
        && q1.bindings == q2.bindings
        && q1.sql == "SELECT t.id, a.site, count(t.id) AS transfer_count FROM transfers AS t INNER JOIN accounts AS a ON t.from_id = a.id INNER JOIN accounts AS r ON (t.to_id = r.id AND (a.site = r.site OR a.region = r.region)) WHERE t.kind = ? AND EXISTS (SELECT 1 FROM signals AS x WHERE t.id = x.transfer_id AND x.level = ?) GROUP BY t.id, a.site HAVING count(t.id) > ? ORDER BY count(t.id) DESC, a.site ASC LIMIT ?"
        && q1.bindings == expected
        && (array.length(string.split(q1.sql, "?")) - 1) == array.length(q1.bindings)
};

def combined_relations_profile_accepts = fn() {
    qb.profile_accepts(combined_plan(), full_profile())
};

# ---------------------------------------------------------------------------
# HAVING inside the partitioned Top N inner query (deterministic bindings).
# ---------------------------------------------------------------------------

def partition_with_having_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-partition-having",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.expr_item(qb.column("e", "command_head")),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("e", "id"), False, "event_count"),
        ],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("e", "status"), qb.bind_string("failed")])),
        exists: [],
        joins: [],
        grouping: [qb.column("e", "role"), qb.column("e", "command_head")],
        having: [qb.having(qb.HavingOp.Gt, "event_count", qb.Val.Int(1))],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: Some(qb.partitioned_top_n(
            [qb.column("e", "role")],
            [qb.desc_aggregate("event_count"), qb.asc(qb.column("e", "command_head"))],
            3,
        )),
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def having_inside_partition_inner_query_keeps_binding_order = fn() {
    let q = qb.transform_sqlite(partition_with_having_plan());
    let expected: Array(qb.Val) = [qb.Val.String("failed"), qb.Val.Int(1), qb.Val.Int(3)];
    q.sql == "SELECT __q_0, __q_1, event_count FROM (SELECT e.role AS __q_0, e.command_head AS __q_1, count(e.id) AS event_count, row_number() OVER (PARTITION BY e.role ORDER BY count(e.id) DESC, e.command_head ASC) AS __q_rn FROM events AS e WHERE e.status = ? GROUP BY e.role, e.command_head HAVING count(e.id) > ?) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_0 ASC, event_count DESC, __q_1 ASC"
        && q.bindings == expected
        && qb.profile_accepts(partition_with_having_plan(), full_profile())
};

# ---------------------------------------------------------------------------
# Nested aggregation (round): shape 1 counts groups that satisfy a HAVING.
#
#   parents/children: for each parent the children are grouped by parent and
#   only groups with `count(child.id) > ?` survive; the outer result is the
#   number of qualifying parents: `count_groups` wraps the grouped relation.
# ---------------------------------------------------------------------------

def children_by_parent_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-children-by-parent",
        sources: [qb.source("c", "children")],
        projection: [qb.expr_item(qb.column("c", "parent_id"))],
        filter: None,
        exists: [],
        joins: [],
        grouping: [qb.column("c", "parent_id")],
        having: [qb.having_call(qb.HavingOp.Gt, qb.AggregateFunction.Count, qb.column("c", "id"), False, qb.Val.Int(3))],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def count_groups_returns_qualifying_group_count = fn() {
    let q = qb.count_groups(children_by_parent_plan(), full_profile());
    let expected: Array(qb.Val) = [qb.Val.Int(3)];
    q.sql == "SELECT count(1) FROM (SELECT c.parent_id FROM children AS c GROUP BY c.parent_id HAVING count(c.id) > ?) AS __q_count"
        && q.bindings == expected
};

def count_groups_inner_plan_is_closed_and_valid = fn() {
    # The inner plan is a normal typed Plan: it passes structure/profile checks
    # and its own lowering is the wrapped subquery body.
    qb.structure_ok(children_by_parent_plan())
        && qb.profile_accepts(children_by_parent_plan(), full_profile())
        && qb.transform_sqlite(children_by_parent_plan()).sql == "SELECT c.parent_id FROM children AS c GROUP BY c.parent_id HAVING count(c.id) > ?"
};

def count_groups_deterministic = fn() {
    let q1 = qb.count_groups(children_by_parent_plan(), full_profile());
    let q2 = qb.count_groups(children_by_parent_plan(), full_profile());
    q1.sql == q2.sql && q1.bindings == q2.bindings
        && (array.length(string.split(q1.sql, "?")) - 1) == array.length(q1.bindings)
};

def children_bad_having_measure_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-children-bad-having",
        sources: [qb.source("c", "children")],
        projection: [qb.expr_item(qb.column("c", "parent_id"))],
        filter: None,
        exists: [],
        joins: [],
        grouping: [qb.column("c", "parent_id")],
        having: [qb.having_call(qb.HavingOp.Gt, qb.AggregateFunction.Count, qb.column("z", "id"), False, qb.Val.Int(3))],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def count_groups_rejects_unknown_inner_reference = fn() {
    !qb.structure_ok(children_bad_having_measure_plan())
};

def count_groups_profile_rejects_inner_bypass = fn() {
    # The profile narrows the nested body: dropping the aggregate operator or
    # the aggregate function must reject the inner relation, so a subquery can
    # never bypass the profile.
    let no_aggregate_op: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Filter, qb.Operator.Group, qb.Operator.Having],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [],
        allow_distinct: True,
    };
    let no_count_aggregate: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Scalar, qb.Operator.Aggregate, qb.Operator.Group, qb.Operator.Having],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Sum],
        allowed_scalars: [],
        allow_distinct: True,
    };
    qb.profile_accepts(children_by_parent_plan(), full_profile())
        && !qb.profile_accepts(children_by_parent_plan(), no_aggregate_op)
        && !qb.profile_accepts(children_by_parent_plan(), no_count_aggregate)
};

# ---------------------------------------------------------------------------
# Nested aggregation (round): shape 2 correlated aggregate EXISTS.
#
#   subjects/events: keep a subject only when it has at least N matching
#   events.  The inner body groups the correlated events and applies a HAVING
#   count threshold; no JOIN is emitted so the outer COUNT keeps the subject
#   grain (no fan-out).
# ---------------------------------------------------------------------------

def subjects_min_events_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-subjects-min-events",
        sources: [qb.source("s", "subjects")],
        projection: [qb.expr_item(qb.column("s", "id"))],
        filter: None,
        exists: [qb.exists_grouped(
            qb.source("e", "events"),
            [qb.column_eq(qb.column_ref("s", "id"), qb.column_ref("e", "subject_id"))],
            Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("e", "kind"), qb.bind_string("measuring")])),
            [qb.column("e", "subject_id")],
            [qb.having_call(qb.HavingOp.Ge, qb.AggregateFunction.Count, qb.column("e", "id"), False, qb.Val.Int(3))],
        )],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def subjects_min_events_count_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-subjects-min-events-count",
        sources: [qb.source("s", "subjects")],
        projection: [
            qb.aggregate(qb.AggregateFunction.Count, qb.column("s", "id"), False, "subject_count"),
        ],
        filter: None,
        exists: [qb.exists_grouped(
            qb.source("e", "events"),
            [qb.column_eq(qb.column_ref("s", "id"), qb.column_ref("e", "subject_id"))],
            None,
            [qb.column("e", "subject_id")],
            [qb.having_call(qb.HavingOp.Ge, qb.AggregateFunction.Count, qb.column("e", "id"), False, qb.Val.Int(3))],
        )],
        joins: [],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def correlated_aggregate_exists_renders_group_having = fn() {
    let q = qb.transform_sqlite(subjects_min_events_plan());
    let expected: Array(qb.Val) = [qb.Val.String("measuring"), qb.Val.Int(3)];
    q.sql == "SELECT s.id FROM subjects AS s WHERE EXISTS (SELECT 1 FROM events AS e WHERE s.id = e.subject_id AND e.kind = ? GROUP BY e.subject_id HAVING count(e.id) >= ?)"
        && q.bindings == expected
        && (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
};

def correlated_aggregate_exists_no_fan_out = fn() {
    # The inner body is only an EXISTS predicate: no JOIN is emitted, so the
    # outer COUNT over subjects cannot be inflated by per-subject event rows.
    let q = qb.transform_sqlite(subjects_min_events_count_plan());
    let expected: Array(qb.Val) = [qb.Val.Int(3)];
    q.sql == "SELECT count(s.id) AS subject_count FROM subjects AS s WHERE EXISTS (SELECT 1 FROM events AS e WHERE s.id = e.subject_id GROUP BY e.subject_id HAVING count(e.id) >= ?)"
        && q.bindings == expected
        && !string.contains(q.sql, "JOIN")
};

def correlated_aggregate_exists_deterministic = fn() {
    let q1 = qb.transform_sqlite(subjects_min_events_plan());
    let q2 = qb.transform_sqlite(subjects_min_events_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
        && qb.profile_accepts(subjects_min_events_plan(), full_profile())
};

