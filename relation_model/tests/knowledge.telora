use ontology::ontology as edsl;
use ontology::knowledge as knowledge;
use ontology::intent::{ query_intent_ast_factory };
use ontology::query as qb;
use ontology::sqlite as sqlite;
use std::json as json;
use std::codec as codec;
use std::dict as dict;
use std::value::{ Value };
use std::array as array;
use std::string as string;
use std::test as test;

def eq_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def text_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def datetime_utc_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::DatetimeUtc];
def local_time_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::LocalDateTime];
def order_status: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension, owner: "order", id: "order_status"};
def status_event: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "status_event"};
def unrelated: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "unrelated"};
def status_values: Array(edsl::CanonicalValueSpec) = [
    {id: "paid", label: "Paid", wires: [edsl::FilterInput::Text("P")]},
    {id: "cancelled", label: "Cancelled", wires: [edsl::FilterInput::Text("C")]},
];

@edsl::entity_id("order")
@edsl::entity_source("orders", "o")
@edsl::dataset(edsl::DatasetKind::Entity, ["id", "tenant_id"], None)
@edsl::dataset_description("Order", "One commercial order per tenant")
@edsl::dataset_alias("订单")
@edsl::localized_dataset("zh-CN", "订单资料", "每个租户下的订单")
@edsl::knowledge_doc(order_status, "Status is the current lifecycle value")
@edsl::knowledge_doc({kind: edsl::KnowledgeKind::Field, owner: "order", id: "status"}, "Stored status field")
@edsl::related_to(order_status, status_event)
@edsl::related_to(order_status, unrelated)
@edsl::term("生命周期", "订单的当前生命周期", order_status)
@edsl::term("生命周期", "订单对象", {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "order"})
@edsl::term("存储状态", "数据库中保存的订单状态", {kind: edsl::KnowledgeKind::Field, owner: "order", id: "status"})
@edsl::term("内部机密", "不可见状态", {kind: edsl::KnowledgeKind::Dimension, owner: "order", id: "private_status"})
type Order = struct {
    @edsl::column("id")
    @edsl::measure("order_count", qb::AggregateFunction::Count, [])
    @edsl::measure_description("order_count", "Order count", "Count eligible order IDs")
    @edsl::measure_alias("order_count", "订单数量")
    @edsl::dimension("order_id", True, True, eq_ops, text_inputs)
    id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
    @edsl::column("status")
    @edsl::dimension("order_status", True, True, eq_ops, text_inputs)
    @edsl::dimension_alias("order_status", "订单状态")
    @edsl::localized_dimension("order_status", "zh-CN", "订单生命周期状态", "订单当前状态说明")
    @edsl::dimension_type(OrderStatusValueType.type)
    status: String,
    @edsl::column("secret")
    @edsl::dimension("private_status", False, True, eq_ops, text_inputs)
    @edsl::dimension_alias("private_status", "隐私状态")
    secret: String,
};

@edsl::entity_id("status_event")
@edsl::entity_source("status_events", "ev")
@edsl::dataset(edsl::DatasetKind::Event, ["id"], Some("occurred_at"))
@edsl::dataset_description("Status event", "Each recorded order status transition")
@edsl::dataset_alias("订单状态")
@edsl::relation_description("event_order", "Changed order", "Event belongs to one order")
@edsl::named_relation_key("event_order", Order.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional},
    edsl::DeclaredRelationKey::And([
        edsl::DeclaredRelationKey::FieldEq({from: "order_id", to: "id"}),
        edsl::DeclaredRelationKey::FieldEq({from: "tenant_id", to: "tenant_id"}),
    ]))
type StatusEvent = struct {
    @edsl::column("id")
    @edsl::dimension("event_id", True, True, eq_ops, text_inputs)
    id: String,
    @edsl::column("order_id")
    order_id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
    @edsl::column("occurred_at")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("event_time", True, True, eq_ops, datetime_utc_inputs)
    occurred_at: String,
    @edsl::column("display_time")
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::LocalText)
    @edsl::dimension("display_time", True, True, eq_ops, local_time_inputs)
    display_time: String,
};

@edsl::entity_id("unrelated")
@edsl::entity_source("unrelated", "u")
@edsl::dataset_description("Lifecycle term", "Related in documentation, without a declared join")
type Unrelated = struct {
    @edsl::column("id")
    @edsl::key()
    id: String,
};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Column, qb::Operator::Project,
        qb::Operator::Filter, qb::Operator::Scalar, qb::Operator::Bind, qb::Operator::Join, qb::Operator::Aggregate],
    allowed_join_kinds: [qb::JoinKind::Inner], allowed_aggregates: [qb::AggregateFunction::Count],
    allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::Or, qb::ScalarFunction::If, qb::ScalarFunction::And],
    allow_distinct: False,
};
def payload: edsl::PreparedPayload = edsl::build_root("doc-pressure", [Order.type, StatusEvent.type, Unrelated.type],
    profile);

pub def datetime_utc_input_documentation_is_discoverable: test::Test = test::should_ok(fn() {
    let detail = edsl::visible_dimension_detail(payload, "event_time");
    match knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Dimension, owner: "status_event", id: "event_time"}) {
        knowledge::DocResult::Found(point) => match point.dimension {
            Some(found) => if detail.input_kinds == [edsl::FilterInputKind::DatetimeUtc]
                && array::length(found.input_docs) == 1
                && found.input_docs[0].kind == edsl::FilterInputKind::DatetimeUtc
                && string::contains(found.input_docs[0].text, "YYYY-MM-DDTHH:MM:SSZ")
                && string::contains(found.input_docs[0].text, "2026-09-20T16:00:00Z") { () }
                else { fail!("DatetimeUtc format documentation is missing", found) },
            None => fail!("dimension detail missing"),
        },
        _ => fail!("time dimension is not discoverable"),
    }
});

pub def input_documentation_does_not_leak_to_other_kinds: test::Test = test::should_ok(fn() {
    let detail = edsl::visible_dimension_detail(payload, "order_status");
    if detail.input_docs == [] { () } else { fail!("unexpected input documentation", detail) }
});

pub def shared_aliases_have_distinct_keys: test::Test = test::should_ok(fn() {
    let index = knowledge::index_entries(knowledge::map(payload));
    let status = knowledge::by_target(payload, order_status);
    let event = knowledge::by_target(payload, status_event);
    match (status, event) {
        (knowledge::DocResult::Found(a), knowledge::DocResult::Found(b)) =>
            if array::any(index.entries, fn(entry) { entry.key == order_status })
                && array::any(index.entries, fn(entry) { entry.key == status_event })
                && array::any(a.aliases, fn(name) { name == "订单状态" })
                && array::any(b.aliases, fn(name) { name == "订单状态" }) { True }
            else { fail!("shared alias collapsed distinct knowledge keys", a, b) },
        other => fail!("shared alias lost a knowledge point", other),
    }
});

pub def private_dimension_is_not_addressable: test::Test = test::should_ok(fn() {
    let secret = knowledge::by_target(payload,
        {kind: edsl::KnowledgeKind::Dimension, owner: "order", id: "private_status"});
    if secret == knowledge::DocResult::NotFound { True }
    else { fail!("private dimension leaked through its key", secret) }
});

pub def local_document_has_separate_structural_and_semantic_links: test::Test = test::should_ok(fn() {
    match knowledge::by_target(payload, order_status) {
        knowledge::DocResult::Found(point) => if point.summary == "Status is the current lifecycle value"
            && array::any(point.refs, fn(ref) { ref.target == status_event && ref.kind == knowledge::LinkKind::Related })
            && array::any(point.refs, fn(ref) { ref.target == unrelated && ref.kind == knowledge::LinkKind::Related })
            && array::any(point.refs, fn(ref) {
                ref.target.kind == edsl::KnowledgeKind::Value && ref.target.id == "paid" && ref.kind == knowledge::LinkKind::Member
            }) { True }
            else { fail!("knowledge links confused related text with model structure", point) },
        other => fail!("exact stable id was not found", other),
    }
});

pub def declared_relation_is_navigable_but_related_doc_is_not: test::Test = test::should_ok(fn() {
    let graph = knowledge::map(payload);
    let relation = array::find(graph, fn(point) {
        point.target.kind == edsl::KnowledgeKind::Relation && point.target.id == "event_order"
    });
    match relation {
        Some(point) => if array::any(point.refs, fn(ref) {
            ref.target.kind == edsl::KnowledgeKind::Dataset && ref.target.id == "order"
                && ref.kind == knowledge::LinkKind::Traversable
        }) { True } else { fail!("named relation does not expose legal target", point) },
        None => fail!("declared relation missing from map"),
    }
});

pub def discovered_relation_and_dimensions_lower_to_a_query: test::Test = test::should_ok(fn() {
    let relation = knowledge::by_target(payload,
        {kind: edsl::KnowledgeKind::Relation, owner: "status_event", id: "event_order"});
    match relation {
        knowledge::DocResult::Found(point) => if point.relation == None {
            fail!("named relation detail is missing", point)
        } else { () },
        other => fail!("named relation cannot be discovered", other),
    };
    let ast = query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph", "root":"ev",
        "nodes":[{"id":"ev","entity":"status_event"},{"id":"o","entity":"order"}],
        "edges":[{"relation":"event_order","from":"ev","to":"o"}],
        "select":[{"node":"ev","dimension":"event_time"},{"node":"o","dimension":"order_status"}]
    }"#).unwrap!());
    let query = sqlite::build_query(ast);
    if query.bindings == [qb::Val::None, qb::Val::String("P"), qb::Val::String("paid"),
        qb::Val::String("C"), qb::Val::String("cancelled"), qb::Val::String("P"), qb::Val::String("C")]
        && string::contains(query.sql, "WHERE (o.status = ?6 OR o.status = ?7)") { True }
    else { fail!("discovered graph lost its canonical status projection bindings", query) }
});

pub def document_reference_does_not_make_a_query_relation: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph", "root":"o", "nodes":[{"id":"o","entity":"order"},{"id":"u","entity":"unrelated"}],
        "edges":[{"relation":"documentation_link","from":"o","to":"u"}],
        "select":[{"node":"o","dimension":"order_status"}]
    }"#).unwrap!())
}, "unknown named relation");

@edsl::entity_id("doc_case")
@edsl::entity_source("doc_cases", "dc")
@edsl::knowledge_doc({kind: edsl::KnowledgeKind::Dimension, owner: "doc_case", id: "state"}, "Documented state")
@edsl::term("状态含义", "业务状态的说明", {kind: edsl::KnowledgeKind::Dimension, owner: "doc_case", id: "state"})
type DocumentedCase = struct {
    @edsl::column("id") @edsl::key() id: String,
    @edsl::column("state") @edsl::dimension("state", True, True, eq_ops, text_inputs) state: String,
};

@edsl::entity_id("doc_case")
@edsl::entity_source("doc_cases", "dc")
type UndocumentedCase = struct {
    @edsl::column("id") @edsl::key() id: String,
    @edsl::column("state") @edsl::dimension("state", True, True, eq_ops, text_inputs) state: String,
};

pub def docs_and_terms_do_not_change_query_lowering: test::Test = test::should_ok(fn() {
    let with_doc = edsl::build_root("with-doc", [DocumentedCase.type], profile);
    let without_doc = edsl::build_root("without-doc", [UndocumentedCase.type], profile);
    let request = json::parse(r#"{
        "op":"Graph", "root":"dc", "nodes":[{"id":"dc","entity":"doc_case"}],
        "edges":[], "select":[{"node":"dc","dimension":"state"}]
    }"#).unwrap!();
    let a = sqlite::build_query(query_intent_ast_factory(with_doc)(request));
    let b = sqlite::build_query(query_intent_ast_factory(without_doc)(request));
    let explained = knowledge::by_target(with_doc,
        {kind: edsl::KnowledgeKind::Dimension, owner: "doc_case", id: "state"});
    let bare = knowledge::by_target(without_doc,
        {kind: edsl::KnowledgeKind::Dimension, owner: "doc_case", id: "state"});
    match (explained, bare) {
        (knowledge::DocResult::Found(x), knowledge::DocResult::Found(y)) =>
            if a == b && x.summary == "Documented state" && y.summary == ""
                && string::contains(json::stringify(codec::encode(knowledge::terminology_from_model(with_doc))), "状态含义")
                && !string::contains(json::stringify(codec::encode(knowledge::terminology_from_model(without_doc))), "状态含义") { True }
            else { fail!("documentation changed the query or failed to change the description", a, b, x, y) },
        other => fail!("documentation affected knowledge point identity", other),
    }
});

pub def every_visible_point_has_an_exact_topic_and_closed_references: test::Test = test::should_ok(fn() {
    let points = knowledge::map(payload);
    let entries = knowledge::index_entries(points).entries;
    if array::all(points, fn(point) {
        array::length(array::filter(entries, fn(entry) { entry.key == point.target })) == 1
            && array::all(point.refs, fn(ref) {
                array::any(points, fn(other) { other.target == ref.target })
            })
    }) { True } else { fail!("a knowledge point is not indexed exactly once or references an invisible point") }
});

pub def on_demand_doc_matches_validated_catalog: test::Test = test::should_ok(fn() {
    let doc = knowledge::knowledge_info_method_factory(payload);
    let inputs = [
        json::parse(r#"{"key":"Dataset/order"}"#).unwrap!(),
        json::parse(r#"{"key":"Dimension/order/order_status"}"#).unwrap!(),
        json::parse(r#"{"key":"Relation/event_order"}"#).unwrap!(),
        json::parse(r#"{"key":"Dataset/missing"}"#).unwrap!(),
    ];
    if array::all(inputs, fn(input) {
            doc(input) == knowledge::serve_value(payload, "foo",
                Value::Object({method: Value::String("foo/info"), input}))
        }) { True }
    else { fail!("bound info differs from the same knowledge catalog") }
});

def read_node: Fn(Fn(Value) -> Value, String) -> knowledge::Node = fn(info, key) {
    match codec::decode@[knowledge::NodeResponse](info(Value::Object({key: Value::String(key)}))).unwrap!() {
        knowledge::NodeResponse::Document(document) => match document {
            knowledge::NodeResult::Found(node) => node,
            knowledge::NodeResult::NotFound => fail!("returned knowledge key is not addressable", key),
        },
    }
};

def encoded_type: for(A: codec::Encode) Fn(A) -> Value = fn(item) {
    match codec::encode(item) {
        Value::Object(fields) => match dict::get(fields, "type") {
            Some(value) => value, None => fail!("knowledge node has no type"),
        },
        other => fail!("knowledge node must be an object", other),
    }
};

pub def terminology_derives_aliases_preserve_ambiguity_and_hide_private_targets: test::Test = test::should_ok(fn() {
    let terms = knowledge::terminology_from_model(payload);
    let aliases = array::concat([array::flat_map(terms.datasets, fn(entry) { entry.aliases }),
        array::flat_map(terms.dimensions, fn(entry) { entry.aliases })]);
    array::length(array::filter(aliases, fn(term) { term == "生命周期" })) == 2
        && array::length(array::filter(aliases, fn(term) { term == "订单状态" })) == 2
        && array::any(aliases, fn(term) { term == "订单资料" })
        && !array::any(aliases, fn(term) { term == "内部机密" || term == "隐私状态" })
});

pub def old_concepts_key_is_not_an_alternate_vocabulary: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    match codec::decode@[knowledge::NodeResponse](info(Value::Object({key: Value::String("concepts")}))).unwrap!() {
        knowledge::NodeResponse::Document(knowledge::NodeResult::NotFound) => True,
        _ => fail!("removed concepts key must not resolve"),
    }
});

pub def index_and_links_resolve_opaque_keys_with_one_node_contract: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let index = read_node(info, "index");
    let catalog = codec::decode@[knowledge::IndexDetail](index.detail).unwrap!();
    if encoded_type(index) == Value::String("Index") && array::length(catalog.schemas) > 0
        && catalog.revision == payload.revision
        && array::length(index.links) == 0
        && array::length(catalog.key_patterns) == 10
        && array::all(catalog.schemas, fn(key) {
            let node = read_node(info, key);
            node.key == key && encoded_type(node) == Value::String("Schema")
                && array::all(node.links, fn(link) { read_node(info, link.key).key == link.key })
                && array::length(array::filter(catalog.schemas, fn(other) { other == key })) == 1
        }) { True }
    else { fail!("root catalog and node links do not form a unique, self-discoverable map", index) }
});

pub def data_types_are_discovered_separately_from_query_contracts: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let utc = read_node(info, "Type/DatetimeUtc");
    let role = read_node(info, edsl::knowledge_key({kind: edsl::KnowledgeKind::Dimension, owner: "status_event", id: "event_time"}.ty!(edsl::KnowledgeTarget)));
    if string::contains(utc.description.summary, "UTC instant")
        && array::any(role.links, fn(link) { link.key == utc.key }) { True }
    else { fail!("types, temporal input meaning or dimension references are missing", utc, role) }
});

pub def temporal_types_link_to_shared_time_window_operation: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let key = edsl::knowledge_key({kind: edsl::KnowledgeKind::Schema, owner: "", id: "syntax/operations/time_window"});
    let window = read_node(info, key);
    if array::all(["DatetimeUtc", "EpochMillis", "DateUtc", "LocalDateTime"], fn(id) {
        let node = read_node(info, edsl::knowledge_key({kind: edsl::KnowledgeKind::DataType, owner: "", id}));
        array::any(node.links, fn(link) { link.key == key })
    }) && array::all(["Text", "Int", "Ipv4", "Bool", "Number"], fn(id) {
        let node = read_node(info, edsl::knowledge_key({kind: edsl::KnowledgeKind::DataType, owner: "", id}));
        !array::any(node.links, fn(link) { link.key == key })
    }) && string::contains(window.description.summary, "[start,end)")
        && string::contains(window.description.summary, "NOT now")
        && string::contains(window.description.summary, "dimension.half_open") { True }
    else { fail!("logical types must discover temporal operations without authorizing unrelated types", window) }
});

pub def public_nodes_match_the_full_model_map: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    if array::all(knowledge::map(payload), fn(point) {
        let node = read_node(info, edsl::knowledge_key(point.target));
        codec::encode(node) == knowledge::node_value(point)
    }) { True }
    else { fail!("on-demand node differs from the full Model map") }
});

pub def opaque_keys_do_not_hide_canonical_intent_ids: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let order = read_node(info, "Dataset/order");
    let detail = codec::decode@[knowledge::DatasetDetail](order.detail).unwrap!();
    let members = array::map(order.links, fn(link) { read_node(info, link.key) });
    let dimension = match array::find(members, fn(node) { encoded_type(node) == Value::String("Dimension") && node.key == "Dimension/order/order_status" }) {
        Some(node) => node, None => fail!("Order status dimension is not discoverable"),
    };
    let paid = match array::find(array::map(dimension.links, fn(link) { read_node(info, link.key) }), fn(node) {
        node.description.label == "Paid" && encoded_type(node) == Value::String("Value")
    }) { Some(node) => node, None => fail!("Paid value is not discoverable") };
    let status = match array::find(members, fn(node) {
        node.description.label == "status" && encoded_type(node) == Value::String("Field")
    }) { Some(node) => node, None => fail!("Status field is not discoverable") };
    let canonical = codec::decode@[knowledge::ValueDetail](paid.detail).unwrap!();
    let field = codec::decode@[knowledge::FieldDetail](status.detail).unwrap!();
    let ast = query_intent_ast_factory(payload)(Value::Object({
        op: Value::String("Graph"), root: Value::String("o"),
        nodes: Value::Array([Value::Object({id: Value::String("o"), entity: Value::String(detail.id)})]),
        edges: Value::Array([]), select: Value::Array([Value::Object({node: Value::String("o"), dimension: Value::String("order_status")})]),
        filters: Value::Array([Value::Object({node: Value::String("o"), dimension: Value::String("order_status"),
            op: Value::String("Eq"), value: Value::String(canonical.id)})]),
    }));
    if detail.id == "order" && canonical.id == "paid" && canonical.type_id == "OrderStatus"
        && field.id == "status" && field.dataset == detail.id && sqlite::build_query(ast).bindings != [] { True }
    else { fail!("opaque node keys replaced the canonical Model IDs", detail, canonical, field) }
});

pub def path_like_keys_encode_components_without_collisions: test::Test = test::should_ok(fn() {
    let first = edsl::knowledge_key({kind: edsl::KnowledgeKind::Dimension, owner: "设备/位置", id: "状态?#/值%"});
    let second = edsl::knowledge_key({kind: edsl::KnowledgeKind::Dimension, owner: "设备", id: "位置/状态?#/值%"});
    if first == "Dimension/%E8%AE%BE%E5%A4%87%2F%E4%BD%8D%E7%BD%AE/%E7%8A%B6%E6%80%81%3F%23%2F%E5%80%BC%25"
        && first != second { True }
    else { fail!("knowledge key components are not safely encoded", first, second) }
});

pub def vocabulary_keys_keep_name_components_unambiguous: test::Test = test::should_ok(fn() {
    edsl::knowledge_key({kind: edsl::KnowledgeKind::Dataset, owner: "", id: "a/b"}) == "Dataset/a%2Fb"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::Field, owner: "a/b", id: "f/g"}) == "Field/a%2Fb/f%2Fg"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::Dimension, owner: "a/b", id: "d/e"}) == "Dimension/a%2Fb/d%2Fe"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::Relation, owner: "ignored", id: "r/s"}) == "Relation/r%2Fs"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::DataType, owner: "", id: "t/u"}) == "Type/t%2Fu"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::Value, owner: "t/u", id: "v/w"}) == "Value/t%2Fu/v%2Fw"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::Measure, owner: "a/b", id: "m/n"}) == "Measure/a%2Fb/m%2Fn"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::Metric, owner: "a/b", id: "m/n"}) == "Metric/a%2Fb/m%2Fn"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::TimeRole, owner: "a/b", id: "t/u"}) == "TimeRole/a%2Fb/t%2Fu"
        && edsl::knowledge_key({kind: edsl::KnowledgeKind::BusinessLink, owner: "a/b", id: "l/r"}) == "BusinessLink/a%2Fb/l%2Fr"
});

pub def search_terminology_covers_visible_names_docs_and_localizations: test::Test = test::should_ok(fn() {
    let terms = knowledge::terminology_from_model(payload);
    let order = array::find(terms.datasets, fn(entry) { entry.name == "order" });
    let status = array::find(terms.dimensions, fn(entry) { entry.dataset == "order" && entry.name == "order_status" });
    let relation = array::find(terms.rels, fn(entry) { entry.name == "event_order" });
    match (order, status, relation) {
        (Some(dataset), Some(dimension), Some(rel)) =>
            terms.revision == payload.revision
                && array::all(["Order", "订单", "订单资料", "生命周期"], fn(alias) {
                    array::any(dataset.aliases, fn(value) { value == alias })
                })
                && string::contains(dataset.doc, "One commercial order per tenant")
                && string::contains(dataset.doc, "每个租户下的订单")
                && string::contains(dimension.doc, "Status is the current lifecycle value")
                && string::contains(dimension.doc, "订单的当前生命周期")
                && string::contains(dimension.doc, "订单当前状态说明")
                && array::all(["订单状态", "订单生命周期状态", "生命周期"], fn(alias) {
                    array::any(dimension.aliases, fn(value) { value == alias })
                })
                && !array::any(dimension.aliases, fn(alias) { alias == "存储状态" })
                && rel.aliases == ["Changed order"]
                && rel.doc == "Event belongs to one order"
                && !array::any(terms.dimensions, fn(entry) { entry.dataset == "order" && entry.name == "private_status" }),
        _ => fail!("visible terminology is incomplete", terms),
    }
});

pub def search_terminology_keys_resolve_to_complete_documents: test::Test = test::should_ok(fn() {
    let terms = knowledge::terminology_from_model(payload);
    let info = knowledge::knowledge_info_method_factory(payload);
    array::all(terms.datasets, fn(entry) { encoded_type(read_node(info, `Dataset/\{entry.name}`)) == Value::String("Dataset") })
        && array::all(terms.dimensions, fn(entry) { encoded_type(read_node(info, `Dimension/\{entry.dataset}/\{entry.name}`)) == Value::String("Dimension") })
        && array::all(terms.measures, fn(entry) { encoded_type(read_node(info, `Measure/\{entry.dataset}/\{entry.name}`)) == Value::String("Measure") })
        && array::all(terms.values, fn(entry) { encoded_type(read_node(info, `Value/\{entry.type_id}/\{entry.name}`)) == Value::String("Value") })
        && array::all(terms.rels, fn(entry) { encoded_type(read_node(info, `Relation/\{entry.name}`)) == Value::String("Relation") })
        && encoded_type(read_node(info, "Type/DatetimeUtc")) == Value::String("DataType")
});

pub def search_terminology_preserves_measure_semantics: test::Test = test::should_ok(fn() {
    let terms = knowledge::terminology_from_model(payload);
    match array::find(terms.measures, fn(entry) { entry.dataset == "order" && entry.name == "order_count" }) {
        Some(measure) => measure.doc == "Count eligible order IDs"
            && measure.aliases == ["Order count", "订单数量"]
            && !array::any(terms.dimensions, fn(entry) { entry.name == "order_count" }),
        None => fail!("measure terminology is missing", terms),
    }
});

pub def search_terminology_preserves_value_names_and_scope: test::Test = test::should_ok(fn() {
    let terms = knowledge::terminology_from_model(payload);
    match array::find(terms.values, fn(entry) { entry.type_id == "OrderStatus" && entry.name == "paid" }) {
        Some(value) => value.doc == "Payment completed\n订单已完成支付"
            && value.aliases == ["Paid", "已付款"]
            && !array::any(knowledge::links_from_model(payload).links, fn(link) { link.source == "Dimension/order/private_status" }),
        None => fail!("value terminology is missing", terms),
    }
});

pub def links_match_public_info_and_resolve_only_visible_targets: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    let links = knowledge::links_from_model(payload);
    links.revision == payload.revision && array::length(links.links) > 0
        && array::all(links.links, fn(link) { array::length(array::filter(links.links, fn(other) { other == link })) == 1 })
        && array::all(links.links, fn(link) {
            let source = read_node(info, link.source);
            let destination = read_node(info, link.target);
            destination.key == link.target && array::any(source.links, fn(ref) {
                ref.key == link.target
            })
        })
        && array::any(links.links, fn(link) { link.source == "Dimension/order/order_status" && link.target == "Type/OrderStatus" })
});

pub def bulk_reference_data_is_not_an_info_document: test::Test = test::should_ok(fn() {
    knowledge::knowledge_info_method_factory(payload)(Value::Object({key: Value::String("links")}))
            == json::parse(r#"{"Document":"NotFound"}"#).unwrap!()
});

pub def discovery_handler_returns_only_visible_root_keys: test::Test = test::should_ok(fn() {
    let handler = knowledge::knowledge_discovery_method_factory(payload);
    let first = handler(Value::Object({}));
    let second = handler(Value::Object({}));
    first == second && first == codec::encode(knowledge::discovery_keys(payload))
});

pub def discovery_rejects_query_fields: test::Test = test::should_fail_with(fn() {
    knowledge::knowledge_discovery_method_factory(payload)(Value::Object({query: Value::String("order")}))
}, "$.query: unknown field; see info key");

pub def info_contains_only_index_schema_and_concrete_knowledge: test::Test = test::should_ok(fn() {
    let info = knowledge::knowledge_info_method_factory(payload);
    array::all(["terminology", "Directory/datasets", "Directory/order/members"], fn(key) {
        info(Value::Object({key: Value::String(key)})) == Value::Object({Document: Value::String("NotFound")})
    }) && array::all(knowledge::map(payload), fn(point) {
        point.target.kind == edsl::KnowledgeKind::Index || point.entries == None
    })
});

pub def published_field_is_distinct_from_dimension_and_hidden_column: test::Test = test::should_ok(fn() {
    let points = knowledge::map(payload);
    let field = {kind: edsl::KnowledgeKind::Field, owner: "order", id: "status"};
    let hidden = {kind: edsl::KnowledgeKind::Field, owner: "order", id: "secret"};
    let visible = array::find(points, fn(item) { item.target == field });
    match visible {
        Some(item) => if item.summary == "Stored status field"
            && !array::any(points, fn(other) { other.target == hidden })
            && array::any(points, fn(other) {
                other.target == order_status && array::any(other.refs, fn(ref) { ref.target == field })
            }) { True }
            else { fail!("knowledge field is hidden or the private column leaked", item) },
        None => fail!("published field missing from map"),
    }
});

pub def event_time_role_retains_authoritative_clock_semantics: test::Test = test::should_ok(fn() {
    let id = {kind: edsl::KnowledgeKind::TimeRole, owner: "status_event", id: "occurred_at"};
    match knowledge::by_target(payload, id) {
        knowledge::DocResult::Found(item) => match item.time_role {
            Some(role) => if role.authoritative && role.semantics == edsl::TimeSemantics::Utc
                && role.encoding == edsl::TimeEncoding::Rfc3339Text
                && array::any(item.refs, fn(ref) {
                    ref.target == {kind: edsl::KnowledgeKind::Field, owner: "status_event", id: "occurred_at"}
                }) { True }
                else { fail!("time role lost clock semantics or its field", item) },
            None => fail!("time role details were not preserved", item),
        },
        other => fail!("event time role is undiscoverable", other),
    }
});

pub def local_display_time_is_not_the_authoritative_clock: test::Test = test::should_ok(fn() {
    let id = {kind: edsl::KnowledgeKind::TimeRole, owner: "status_event", id: "display_time"};
    match knowledge::by_target(payload, id) {
        knowledge::DocResult::Found(item) => match item.time_role {
            Some(role) => if !role.authoritative && role.semantics == edsl::TimeSemantics::Local
                && role.encoding == edsl::TimeEncoding::LocalText { True }
                else { fail!("local display time was presented as an authoritative instant", item) },
            None => fail!("local time role is missing its declared semantics", item),
        },
        other => fail!("local time role is undiscoverable", other),
    }
});

pub def business_alias_is_not_a_strict_dimension_id: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph", "root":"o", "nodes":[{"id":"o","entity":"order"}],
        "edges":[], "select":[{"node":"o","dimension":"订单状态"}]
    }"#).unwrap!())
}, "unknown dimension");

pub def localized_name_stays_in_knowledge_detail: test::Test = test::should_ok(fn() {
    match knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "order"}) {
        knowledge::DocResult::Found(point) =>
            if array::any(point.localized, fn(text) { text.label == "订单资料" && text.locale == "zh-CN" }) { True }
            else { fail!("localized name lost its declaring context", point) },
        other => fail!("localized dataset key is not addressable", other),
    }
});

pub def service_index_lists_unique_keys_and_info_navigates: test::Test = test::should_ok(fn() {
    let index = knowledge::serve(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"index"}
    }"#).unwrap!());
    let point = knowledge::serve(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"Dimension/order/order_status"}
    }"#).unwrap!());
    match (index, point) {
        (knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(a)),
            knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(item))) =>
            match a.entries {
                Some(entries) => if array::length(entries) > 0 && array::all(entries, fn(entry) { entry.key.kind == edsl::KnowledgeKind::Schema })
                    && array::length(a.refs) == 0
                    && item.target == order_status { True }
                    else { fail!("schema index or exact key navigation failed", a, item) },
                None => fail!("index topic has no entries", a),
            },
        other => fail!("unexpected service response", other),
    }
});

pub def service_response_round_trips_through_json: test::Test = test::should_ok(fn() {
    let result = knowledge::serve_value(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"Dimension/order/order_status"}
    }"#).unwrap!());
    let round_trip = json::parse(json::stringify(result)).unwrap!();
    match codec::decode@[knowledge::NodeResponse](round_trip).unwrap!() {
        knowledge::NodeResponse::Document(knowledge::NodeResult::Found(item)) =>
            if item.key == edsl::knowledge_key(order_status) { True }
            else { fail!("serialized knowledge response lost its key", item) },
        other => fail!("service response cannot be transported as JSON", other),
    }
});

pub def service_response_has_stable_json_envelope: test::Test = test::should_ok(fn() {
    let found = knowledge::serve_value(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"Dimension/order/order_status"}
    }"#).unwrap!());
    let missing = knowledge::serve_value(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"Dataset/missing"}
    }"#).unwrap!());
    let index = knowledge::serve_value(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"index"}
    }"#).unwrap!());
    match (found, missing, index) {
        (Value::Object(a), Value::Object(b), Value::Object(c)) =>
            match (dict::get(a, "Document"), dict::get(b, "Document"), dict::get(c, "Document")) {
                (Some(Value::Object(point)), Some(Value::String("NotFound")), Some(Value::Object(list))) =>
                    if dict::get(point, "Found") != None && dict::get(list, "Found") != None { True }
                    else { fail!("knowledge response lost its index topic or exact point", point, list) },
                other => fail!("knowledge response variant envelope changed", other),
            },
        other => fail!("knowledge responses are not JSON objects", other),
    }
});

pub def service_does_not_expose_hidden_target: test::Test = test::should_ok(fn() {
    match knowledge::serve(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"Dimension/order/private_status"}
    }"#).unwrap!()) {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::NotFound) => True,
        other => fail!("hidden target leaked through direct lookup", other),
    }
});

pub def service_rejects_wrong_domain: test::Test = test::should_fail_with(fn() {
    knowledge::serve(payload, "foo", json::parse(r#"{
        "method":"bar/info", "input":{"key":"Dimension/order/order_status"}
    }"#).unwrap!())
}, "unknown knowledge method for domain");

pub def service_rejects_removed_index_method: test::Test = test::should_fail_with(fn() {
    knowledge::serve(payload, "foo", json::parse(r#"{
        "method":"foo/index", "input":{}
    }"#).unwrap!())
}, "unknown knowledge method for domain; see info key");

pub def service_rejects_extra_request_fields: test::Test = test::should_fail_with(fn() {
    knowledge::serve(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"Dimension/order/order_status", "guess":true}
    }"#).unwrap!())
}, "$.guess: unknown field; see info key");

pub def service_rejects_extra_envelope_field: test::Test = test::should_fail_with(fn() {
    knowledge::serve(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":"index"}, "guess":true
    }"#).unwrap!())
}, "$.guess: unknown field; see info key");

pub def service_rejects_non_string_key: test::Test = test::should_fail_with(fn() {
    knowledge::serve(payload, "foo", json::parse(r#"{
        "method":"foo/info", "input":{"key":{"kind":"Dataset","owner":"","id":"order","guess":true}}
    }"#).unwrap!())
}, "$.key: expected String; see info key");

pub def bound_service_keeps_its_model_and_domain: test::Test = test::should_ok(fn() {
    let service = knowledge::knowledge_service_factory(payload, "foo");
    let first = service(json::parse(r#"{
        "method":"foo/info", "input":{"key":"Dimension/order/order_status"}
    }"#).unwrap!());
    let second = service(json::parse(r#"{
        "method":"foo/info", "input":{"key":"index"}
    }"#).unwrap!());
    match (first, second) {
        (Value::Object(found), Value::Object(index)) =>
            if dict::get(found, "Document") != None && dict::get(index, "Document") != None { True }
            else { fail!("bound knowledge service lost its domain", found, index) },
        other => fail!("bound knowledge service returned an invalid response", other),
    }
});

@edsl::entity_id("bad_doc")
@edsl::entity_source("bad_docs", "bd")
@edsl::knowledge_doc(order_status, "Wrong owner")
type BadDoc = struct { @edsl::column("id") @edsl::key() id: String };

pub def annotation_cannot_claim_another_entity_point: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid-knowledge", [Order.type, BadDoc.type], profile)
}, "knowledge doc must describe an existing point owned by its declaring entity");

@edsl::entity_id("duplicate_doc")
@edsl::entity_source("duplicate_docs", "dd")
@edsl::knowledge_doc({kind: edsl::KnowledgeKind::Dataset, owner: "", id: "duplicate_doc"}, "First")
@edsl::knowledge_doc({kind: edsl::KnowledgeKind::Dataset, owner: "", id: "duplicate_doc"}, "Second")
type DuplicateDoc = struct { @edsl::column("id") @edsl::key() id: String };

pub def duplicate_documentation_is_rejected: test::Test = test::should_fail_with(fn() {
    edsl::build_root("duplicate-knowledge", [DuplicateDoc.type], profile)
}, "duplicate knowledge doc target");

@edsl::entity_id("bad_term")
@edsl::entity_source("bad_terms", "bc")
@edsl::term("外部状态", "不能认领其他实体的知识点", order_status)
type BadTerm = struct { @edsl::column("id") @edsl::key() id: String };

pub def term_cannot_claim_another_entity_point: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid-term", [Order.type, StatusEvent.type, Unrelated.type, BadTerm.type], profile)
}, "term annotation requires a term, description and declared target owned by its entity");

@edsl::entity_id("duplicate_term")
@edsl::entity_source("duplicate_terms", "dc")
@edsl::term("对象", "第一条说明", {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "duplicate_term"})
@edsl::term("对象", "第二条说明", {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "duplicate_term"})
type DuplicateTerm = struct { @edsl::column("id") @edsl::key() id: String };

pub def duplicate_explicit_term_is_rejected: test::Test = test::should_fail_with(fn() {
    edsl::build_root("duplicate-term", [DuplicateTerm.type], profile)
}, "duplicate term for knowledge target");

@edsl::entity_id("invalid_ref")
@edsl::entity_source("invalid_refs", "ir")
@edsl::related_to({kind: edsl::KnowledgeKind::Dataset, owner: "", id: "invalid_ref"},
    {kind: edsl::KnowledgeKind::Dataset, owner: "", id: "missing"})
type InvalidRef = struct { @edsl::column("id") @edsl::key() id: String };

pub def nonexistent_related_point_is_rejected: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid-reference", [InvalidRef.type], profile)
}, "knowledge reference must link distinct declared points from its owner");

@edsl::value_type("OrderStatus", String.type, status_values)
@edsl::knowledge_doc({kind: edsl::KnowledgeKind::Value, owner: "OrderStatus", id: "paid"}, "Payment completed")
@edsl::term("已付款", "订单已完成支付", {kind: edsl::KnowledgeKind::Value, owner: "OrderStatus", id: "paid"})
type OrderStatusValueType = struct {};
