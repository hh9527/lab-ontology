    BackupStatus,
    @ev::itag(21)
    @ev::description("Heartbeat", "心跳")
    Heartbeat,
};
def CurrentAlarmEVENTTYPE_domain: v::Domain(CurrentAlarmEVENTTYPE, Int) = v::from_enum(
    "CurrentAlarmEVENTTYPE",
    CurrentAlarmEVENTTYPE.type,
    Int.type,
    False
);
def severity_dimension: v::Binding(TCurrentAlarm) = v::dimension_of(
    dataset,
    m::field(TCurrentAlarm.type, Int.type, "severity"),
    "alarm_severity"
);
def cleared_dimension: v::Binding(TCurrentAlarm) = v::dimension_of(
    dataset,
    m::field(TCurrentAlarm.type, Int.type, "cleared"),
    "alarm_cleared"
);

def total: registry::FieldCount(TCurrentAlarm) = registry::field_count(
    dataset,
    m::field(TCurrentAlarm.type, Int.type, "csn"),
    "alarm_count"
);
def opened: registry::FieldCount(TCurrentAlarm) = registry::filtered_count(
    registry::field_count(
        dataset,
        m::field(TCurrentAlarm.type, Int.type, "csn"),
        "alarm_open_count"
    ),
    cleared_dimension,
    AlarmCleared::Uncleared
);
def critical: registry::FieldCount(TCurrentAlarm) = registry::filtered_count(
    registry::field_count(
        dataset,
        m::field(TCurrentAlarm.type, Int.type, "csn"),
        "critical_alarm_count"
    ),
    severity_dimension,
    AlarmSeverity::Critical
);
def major: registry::FieldCount(TCurrentAlarm) = registry::filtered_count(
    registry::field_count(
        dataset,
        m::field(TCurrentAlarm.type, Int.type, "csn"),
        "major_alarm_count"
    ),
    severity_dimension,
    AlarmSeverity::Major
);
def severe: registry::ComputedCount(TCurrentAlarm) = registry::combine_counts(
    "critical_or_major_alarm_count",
    qb::ComputedOp::Add,
    registry::count_ref(critical),
    registry::count_ref(major)
);
# 算术组合不推断业务人口；这个结果是分数，不能当作告警数。
def weighted_score: registry::ComputedCount(TCurrentAlarm) = registry::combine_counts(
    "weighted_severe_alarm_score",
    qb::ComputedOp::Add,
    registry::computed_count_ref(severe),
    registry::count_ref(critical)
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def source_cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::guarded(
        r::relation(
            "alarm_site_reference",
            r::endpoint(dataset.row, site_reference.id),
            r::endpoint(site::dataset.row, site::subject.id),
            cardinality
        ),
        m::field(TCurrentAlarm.type, String.type, "strext13"),
        edsl::FilterOp::Ne,
        "3"
    ),
    r::relation(
        "alarm_belongs_to_tenant",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        cardinality
    ),
    r::relation(
        "server_current_alarm",
        r::endpoint(dataset.row, server_reference.id),
        r::endpoint(server::dataset.row, server::subject.id),
        cardinality
    ),
    r::relation(
        "device_current_alarm",
        r::endpoint(dataset.row, device.id),
        r::endpoint(i::devices.row, i::device_subject.id),
        cardinality
    ),
    r::relation(
        "source_EntNetworkElement_T_CURRENT_ALARM",
        r::endpoint(i::devices.row, i::device_subject.id),
        r::endpoint(dataset.row, device.id),
        source_cardinality
    ),
    r::relation(
        "source_X_TENANT_VIEW_T_CURRENT_ALARM",
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        r::endpoint(dataset.row, tenant.id),
        source_cardinality
    ),
    r::relation(
        "source_X_SITE_VIEW_T_CURRENT_ALARM",
        r::endpoint(site::dataset.row, site::subject.id),
        r::endpoint(dataset.row, site_reference.id),
        source_cardinality
    ),
    r::relation(
        "source_PhysicalServer_T_CURRENT_ALARM",
        r::endpoint(server::dataset.row, server::subject.id),
        r::endpoint(dataset.row, server_reference.id),
        source_cardinality
    ),
    r::relation(
        "source_HuaweiStorageDeviceAggregationT_CURRENT_ALARM",
        r::endpoint(storage::dataset.row, storage::subject.id),
        r::endpoint(dataset.row, storage_reference.id),
        source_cardinality
    ),
    r::relation(
        "source_EntPonElementAssociationT_CURRENT_ALARM",
        r::endpoint(pon::dataset.row, pon::subject.id),
        r::endpoint(dataset.row, pon_reference.id),
        source_cardinality
    ),
];
