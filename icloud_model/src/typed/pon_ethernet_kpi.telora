use ontology::registry as registry;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_device as pon;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
type ResourceId = struct(String);
use ontology::quantity::{EffectiveCount};
# hwOpticsRxPower 的单位／尺度没有在旧公开契约中确认。
type ReportedHwOpticsRxPower = struct(Float);
# hwOpticsTxPower 的单位／尺度没有在旧公开契约中确认。
type ReportedHwOpticsTxPower = struct(Float);
# ifHCInOctets 的单位／尺度没有在旧公开契约中确认。
type ReportedIfHCInOctets = struct(Float);
# ifHCOutOctets 的单位／尺度没有在旧公开契约中确认。
type ReportedIfHCOutOctets = struct(Float);
# ifInBandRate 的单位／尺度没有在旧公开契约中确认。
type ReportedIfInBandRate = struct(Float);
# ifOutBandRate 的单位／尺度没有在旧公开契约中确认。
type ReportedIfOutBandRate = struct(Float);
@registry::dataset("source_PonDeviceEthernetPortKPI", "PonDeviceEthernetPortKPI", ["source_resId"])
@registry::roles([owner])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(PonDeviceEthernetPortKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_PonDeviceEthernetPortKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceEthernetPortKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_PonDeviceEthernetPortKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceEthernetPortKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_PonDeviceEthernetPortKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(PonDeviceEthernetPortKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_PonDeviceEthernetPortKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__hwOpticsRxPower",
                ReportedHwOpticsRxPower.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    ReportedHwOpticsRxPower.type,
                    "source_hwOpticsRxPower"
                )
            ),
            "source_PonDeviceEthernetPortKPI__hwOpticsRxPower",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__hwOpticsTxPower",
                ReportedHwOpticsTxPower.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    ReportedHwOpticsTxPower.type,
                    "source_hwOpticsTxPower"
                )
            ),
            "source_PonDeviceEthernetPortKPI__hwOpticsTxPower",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__ifHCInOctets",
                ReportedIfHCInOctets.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    ReportedIfHCInOctets.type,
                    "source_ifHCInOctets"
                )
            ),
            "source_PonDeviceEthernetPortKPI__ifHCInOctets",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__ifHCOutOctets",
                ReportedIfHCOutOctets.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    ReportedIfHCOutOctets.type,
                    "source_ifHCOutOctets"
                )
            ),
            "source_PonDeviceEthernetPortKPI__ifHCOutOctets",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__ifInBandRate",
                ReportedIfInBandRate.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    ReportedIfInBandRate.type,
                    "source_ifInBandRate"
                )
            ),
            "source_PonDeviceEthernetPortKPI__ifInBandRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__ifOutBandRate",
                ReportedIfOutBandRate.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    ReportedIfOutBandRate.type,
                    "source_ifOutBandRate"
                )
            ),
            "source_PonDeviceEthernetPortKPI__ifOutBandRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__hwOpticsRxPowerEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    EffectiveCount.type,
                    "source_hwOpticsRxPowerEffcnt"
                )
            ),
            "source_PonDeviceEthernetPortKPI__hwOpticsRxPowerEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__hwOpticsTxPowerEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    EffectiveCount.type,
                    "source_hwOpticsTxPowerEffcnt"
                )
            ),
            "source_PonDeviceEthernetPortKPI__hwOpticsTxPowerEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__ifHCInOctetsEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    EffectiveCount.type,
                    "source_ifHCInOctetsEffcnt"
                )
            ),
            "source_PonDeviceEthernetPortKPI__ifHCInOctetsEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__ifHCOutOctetsEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
                    EffectiveCount.type,
                    "source_ifHCOutOctetsEffcnt"
                )
            ),
            "source_PonDeviceEthernetPortKPI__ifHCOutOctetsEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PonDeviceEthernetPortKPI__ifInBandRateEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    PonDeviceEthernetPortKPI.type,
