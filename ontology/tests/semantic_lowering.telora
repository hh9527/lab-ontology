);
def any_sample: Value = sample_input(
    r#""select":[{"node":"s","dimension":"sample__id"}],"any_of":[{"node":"s","dimension":"sample__id","values":["d1","d2"]}]"#
);
pub def baseline_filter_time_and_any_of_are_available: test::Test = verify(
    fn() {
        array::all(
            [filtered_sample, windowed_sample, any_sample],
            fn(input) {
                string::contains(sqlite::build_query(old_plan(input)).sql, "WHERE")
            }
        )
    }
);
pub def acceptance_filter_permissions: test::Test = verify(
    fn() {
        same_result(filtered_sample)
    }
);
pub def acceptance_time_window_permissions: test::Test = verify(
    fn() {
        same_result(windowed_sample)
    }
);
pub def acceptance_any_of_permissions: test::Test = verify(
    fn() {
        same_result(any_sample)
    }
);
pub def acceptance_min_max: test::Test = verify(
    fn() {
        same_result(
            sample_input(
                r#""select":[],"measures":[{"node":"s","measure":"sample__cpu_min"},{"node":"s","measure":"sample__cpu_max"}]"#
            )
        )
    }
);
pub def acceptance_sample_order: test::Test = verify(
    fn() {
        match (
            baseline_payload.entities[0].sample_order,
            new_acceptance_payload.entities[3].sample_order
        ) {
            (Some(old), Some(new)) => old.time.column == new.time.column && array::map(
                old.ties,
                fn(column) {
                    column.column
                }
            ) == array::map(
                new.ties,
                fn(column) {
                    column.column
                }
            ),
            _ => False
        }
    }
);
def aligned_payload: edsl::PreparedPayload = adapter::payload(
    "aligned",
    mappings,
    array::concat([relations, [s::alignment("sample_device", samples.prepared, devices.prepared)]]),
    acceptance_profile
);
pub def acceptance_subject_identity_aligns_to_another_mapping: test::Test = verify(
    fn() {
        let input = parse(
            r#"{"op":"Graph","root":"s","nodes":[{"id":"s","entity":"sample"},{"id":"d","entity":"device"}],"edges":[{"relation":"sample_device","from":"s","to":"d"}],"select":[{"node":"s","dimension":"sample__id"},{"node":"d","dimension":"device__name"}],"limit":500}"#
        );
        let plan = intent::query_intent_ast_factory(aligned_payload)(input);
        string::contains(sqlite::build_query(plan).sql, "LEFT JOIN") && intent::result_columns(
            aligned_payload,
            input,
            plan
        )[
            1
        ].nullable
    }
);

def union_identity: Value = sample_input(
    r#""select":[{"node":"s","dimension":"sample__id"},{"node":"s","dimension":"sample__ts"}]"#
);
def union_input: Value = parse(
    `{"op":"GraphUnion","branches":[{"result_node":"s","graph":\{json::stringify(union_identity)}},{"result_node":"s","graph":\{json::stringify(union_identity)}}],"limit":500}`
);
pub def acceptance_graph_union: test::Test = verify(
    fn() {
        same_result(union_input)
    }
);
def pair_branch: Fn(String) -> Value = fn(node) {
    parse(
        `{"op":"Graph","root":"\{node}","nodes":[{"id":"\{node}","entity":"sample"}],"edges":[],"select":[],"measures":[{"node":"\{node}","measure":"sample__cpu_mean"}],"group_by_identity":["\{node}"]}`
    )
};
def pair_input: Fn(String) -> Value = fn(extra) {
    parse(
        `{"op":"GraphPair","left":\{json::stringify(pair_branch("a"))},"right":\{json::stringify(pair_branch("b"))},"align_by":[{"left":{"node":"a"},"right":{"node":"b"}}],"select":[{"side":"Left","node":"a","dimension":"sample__id"}],\{extra}"limit":500}`
    )
};
pub def acceptance_graph_pair: test::Test = verify(
    fn() {
        same_result(pair_input(""))
    }
);
pub def acceptance_graph_pair_growth_ranking: test::Test = verify(
    fn() {
        same_result(
            pair_input(
                r#""rank_by":{"op":"GrowthRate","current":"Right","baseline":"Left","direction":"Desc","take":10},"#
            )
        )
    }
);

def owner_period: Fn(String, String, String, String) -> Value = fn(owner, sample, start, end) {
    parse(
        `{"op":"Graph","root":"\{owner}","nodes":[{"id":"\{owner}","entity":"device"},{"id":"\{sample}","entity":"sample"}],"edges":[{"relation":"sample_device","from":"\{sample}","to":"\{owner}"}],"select":[],"measures":[{"node":"\{sample}","measure":"sample__cpu_mean"}],"group_by_identity":["\{owner}"],"time_windows":[{"node":"\{sample}","dimension":"sample__ts","start":"\{start}","end":"\{end}"}]}`
    )
};
pub def acceptance_disjoint_periods_align_by_business_identity: test::Test = verify(
    fn() {
        let left = owner_period("a", "x", "2026-11-01T00:00:00Z", "2026-11-02T00:00:00Z");
        let right = owner_period("b", "y", "2026-11-02T00:00:00Z", "2026-11-03T00:00:00Z");
        let input = parse(
            `{"op":"GraphPair","left":\{json::stringify(left)},"right":\{json::stringify(right)},"align_by":[{"left":{"node":"a"},"right":{"node":"b"}}],"select":[{"side":"Left","node":"a","dimension":"device__id"}],"rank_by":{"op":"GrowthRate","current":"Right","baseline":"Left","direction":"Desc","take":10},"limit":500}`
        );
        let plan = intent::query_intent_ast_factory(aligned_payload)(input);
        let sql = sqlite::build_query(plan);
        string::contains(sql.sql, "ORDER BY") && array::length(sql.bindings) >= 5
    }
);
