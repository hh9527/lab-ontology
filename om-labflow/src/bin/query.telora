# om-labflow 公共查询入口
#
#   bin/telora -C om-labflow run query --source input=request.json
#   bin/telora -C om-labflow run query --source input=stdin+json://
#
# 从名为 `input` 的 Value source 读取领域查询请求，走公共 dynamic facade 完成
# 校验与 lowering，并在 stdout 只输出参数化 Query：
#
#   {"sql": "...", "bindings": [...]}
#
# 不输出额外包装、解释文本或执行结果。

import "std/value" { Value };
import "std/dict" as dict;
import "@src/knowledge" { payload };
import "@src/query" as facade;

option "run-ctx.sources" ["input"];

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    let raw = match dict.get(sources, "input") {
        'Some(value) => value,
        'None => fail!("missing input source", sources),
    };
    let query = facade.build_from_value(payload, raw);
    facade.encode_query(query)
};
