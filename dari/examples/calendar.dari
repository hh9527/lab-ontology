# 本年二月前两个相交自然周，跨月部分裁到二月内。
data ctx = context! { now: Context::Now, tz: Context::ClientTz };
data february = do {
    let today = date_of(ctx.now, ctx.tz);
    let year = calendar_period(today, CalendarUnit::Year);
    let start = shift_date(year.start, CalendarUnit::Month, 1);
    calendar_period(start, CalendarUnit::Month)
};
data first = do {
    let week = calendar_period(february.start, CalendarUnit::Week);
    at_zone(intersection(week, february), ctx.tz)
};
data second = do {
    let week = calendar_period(february.start, CalendarUnit::Week);
    let next = shift_dates(week, CalendarUnit::Week, 1);
    at_zone(intersection(next, february), ctx.tz)
};
data first_start = to_datetime_tz(first.start, ctx.tz);
data first_end = to_datetime_tz(first.end, ctx.tz);
data second_start = to_datetime_tz(second.start, ctx.tz);
data second_end = to_datetime_tz(second.end, ctx.tz);
answer tree! { Answer [
    h1 ["二月前两个自然周"],
    p ["第一周起点：", Value(value = first_start)],
    p ["第一周结束边界（不含）：", Value(value = first_end)],
    p ["第二周起点：", Value(value = second_start)],
    p ["第二周结束边界（不含）：", Value(value = second_end)]
] };
