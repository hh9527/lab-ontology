use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储资源独立声明，只准备transform所需契约
use super::inventory as i;
use super::site as site;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type StorageId = struct(String);
@domain::entity_by("Storage")
type StorageById = struct(StorageId);
use ontology::quantity::{Fraction, Megabytes};
@edsl::reference("id", ["id"])
@domain::subject("Storage", "id")
@domain::dataset("storage_device", "HuaweiStorageDevice", ["id"])
@domain::record_counts(["storage_device_count"])
@domain::relations(relations)
@domain::alternatives(alternatives)
type HuaweiStorageDevice = struct {
    @g::exact("storage_device_id")
    id: StorageById,
    @edsl::field_role(edsl::FieldRole::Appellation)
    @g::search("storage_device__name")
    @domain::count("storage_device_named_count")
    name: String,
    @m::column("tenantId")
    tenant_id: domain::Reference(i::TenantById),
    @m::column("parentResId")
    parent_res_id: domain::Reference(site::SiteById),
    @m::column("projectId")
    project_id: domain::Reference(site::SiteById),
    @m::column("runningStatus")
    @v::classification(StorageRunningStatus_domain, "storage_running_status")
    running_status: String,
    @m::column("subClassName")
    @v::classification(StorageDeviceSubclass_domain, "storage_device_subclass")
    sub_class_name: String,
    @m::column("usedCapacityRate")
    @g::field_view(
        g::dimension_group(
            "storage_device__usedCapacityRate",
            Fraction.type,
            True,
            g::numeric_filters
        ),
        "storage_device__usedCapacityRate",
        True,
        g::numeric_filters
    )
    source_usedCapacityRate: Fraction,
    @m::column("totalStoragePoolCapacity")
    @g::field_view(
        g::dimension_group(
            "storage_device__totalStoragePoolCapacity",
            Megabytes.type,
            True,
            g::numeric_filters
        ),
        "storage_device__totalStoragePoolCapacity",
        True,
        g::numeric_filters
    )
    source_totalStoragePoolCapacity: Megabytes,
    @m::column("unUsedCapacity")
    @g::field_view(
        g::dimension_group(
            "storage_device__unUsedCapacity",
            Megabytes.type,
            True,
            g::numeric_filters
        ),
        "storage_device__unUsedCapacity",
        True,
        g::numeric_filters
    )
    source_unUsedCapacity: Megabytes,
    @m::column("nativeId")
    @g::exact("storage_device__nativeId")
    source_nativeId: String,
    @m::column("createTime")
    @g::field_view(
        g::dimension_group(
            "storage_device__createTime",
            s::EpochMillis.type,
            True,
            g::numeric_filters
        ),
        "storage_device__createTime",
        True,
        g::numeric_filters
    )
    source_createTime: s::EpochMillis,
    @m::column("regionId")
    @g::exact("storage_device__regionId")
    source_regionId: String,
    @m::column("belongSeries")
    @g::search("storage_device__belongSeries")
    source_belongSeries: String,
    @m::column("powerStatus")
    @v::classification(StorageDevicePowerStatus_domain, "storage_device__powerStatus")
    source_powerStatus: String,
    @m::column("classification")
    @v::classification(StorageDeviceClassification_domain, "storage_device__classification")
    source_classification: String,
    @m::column("hotPatchVersion")
    @g::search("storage_device__hotPatchVersion")
    source_hotPatchVersion: String,
    @m::column("deviceType")
    @v::classification(StorageDeviceDeviceType_domain, "storage_device__deviceType")
    source_deviceType: String,
    @m::column("healthStatus")
    @v::classification(StorageDeviceHealthStatus_domain, "storage_device__healthStatus")
    source_healthStatus: String,
    @m::column("connectStatus")
    @v::classification(StorageDeviceConnectStatus_domain, "storage_device__connectStatus")
    source_connectStatus: Int,
    @m::column("usedCapacity")
    @g::field_view(
        g::dimension_group("storage_device__usedCapacity", Megabytes.type, True, g::numeric_filters),
        "storage_device__usedCapacity",
        True,
        g::numeric_filters
    )
    source_usedCapacity: Megabytes,
    @m::column("totalCapacity")
    @g::field_view(
        g::dimension_group(
            "storage_device__totalCapacity",
            Megabytes.type,
            True,
            g::numeric_filters
        ),
        "storage_device__totalCapacity",
        True,
        g::numeric_filters
    )
    source_totalCapacity: Megabytes,
    @m::column("manufacturer")
    @g::search("storage_device__manufacturer")
    source_manufacturer: String,
    @m::column("sn")
    @g::search("storage_device__sn")
    source_sn: String,
    @m::column("productmodel")
    @g::search("storage_device__productmodel")
    source_productmodel: String,
    @m::column("location")
    @g::search("storage_device__location")
    source_location: String,
    @m::column("ipAddress")
    @g::search("storage_device__ipAddress")
    @g::ipv4_view("storage_device__ipAddress_ipv4")
    source_ipAddress: String,
    @m::column("version")
    @g::search("storage_device__version")
    source_version: String,
};

def subject: r::Endpoint = domain::endpoint(HuaweiStorageDevice.type, "id");
def tenant: r::Endpoint = domain::endpoint(HuaweiStorageDevice.type, "tenant_id");
def parent_site: r::Endpoint = domain::endpoint(HuaweiStorageDevice.type, "parent_res_id");
def project_site: r::Endpoint = domain::endpoint(HuaweiStorageDevice.type, "project_id");
@knowledge_policy::reverse_references(True)
type StorageRunningStatus = enum {
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("3")
    @ev::description("Not Running", "未运行")
    NotRunning,
    @ev::rename("12")
    @ev::description("Powering On", "正在上电")
    PoweringOn,
    @ev::rename("47")
    @ev::description("Powering Off", "正在下电")
    PoweringOff,
    @ev::rename("51")
    @ev::description("Upgrading", "正在升级")
    Upgrading,
};
def StorageRunningStatus_domain: v::Domain(StorageRunningStatus, String) = v::from_enum(
    "StorageRunningStatus",
    StorageRunningStatus.type,
    String.type,
    False
);
@knowledge_policy::reverse_references(True)
type StorageDeviceSubclass = enum {
    @ev::rename("EnterpriseStorage")
    @ev::description("Enterprise flash storage device", "闪存存储设备")
    EnterpriseFlashStorageDevice,
    @ev::rename("FusionStorageDevice")
    @ev::description("Distributed storage device", "分布式存储设备")
    DistributedStorageDevice,
    @ev::rename("SmisStorageDevice")
    @ev::description("Lenovo SMIS storage device", "联想SISM存储设备")
    LenovoSmisStorageDevice,
    @ev::rename("HuaweiSmisStorageDevice")
    @ev::description("Huawei SMIS storage device", "华为SMIS存储设备")
    HuaweiSmisStorageDevice,
    @ev::rename("SYS_ProtectDevice")
    @ev::description(
        "Data protection appliance and backup cluster storage device",
        "数据保护一体机、备份集群存储设备"
    )
    DataProtectionApplianceAndBackupClusterStorageDevice,
    @ev::rename("DsmStorageDevice")
    @ev::description("Mobile specification DSM and DFS storage device", "移动规范DSM、DFS存储设备")
    MobileSpecificationDsmAndDfsStorageDevice,
    @ev::rename("HPEStorageDevice")
    @ev::description("HPE storage device", "HP存储设备")
    HpeStorageDevice,
    @ev::rename("VSPStorageDevice")
    @ev::description("VSP storage device", "VSP存储设备")
    VspStorageDevice,
    @ev::rename("FCSwitchDevice")
    @ev::description("FC switch device", "FC交换机")
    FcSwitchDevice,
};
def StorageDeviceSubclass_domain: v::Domain(StorageDeviceSubclass, String) = v::from_enum(
    "StorageDeviceSubclass",
    StorageDeviceSubclass.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type StorageDevicePowerStatus = enum {
    @ev::rename("poweroff")
    @ev::description("power off", "下电")
    PowerOff,
    @ev::rename("poweron")
    @ev::description("power on", "上电")
    PowerOn,
};
def StorageDevicePowerStatus_domain: v::Domain(StorageDevicePowerStatus, String) = v::from_enum(
    "StorageDevicePowerStatus",
    StorageDevicePowerStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type StorageDeviceClassification = enum {
    @ev::rename("HuaweiStorage")
    @ev::description("Huawei Storage Device", "华为存储设备")
    HuaweiStorageDevice,
    @ev::rename("FcSwitch")
    @ev::description("Fibre Channel Switch", "交换机")
    FibreChannelSwitch,
    @ev::rename("ThirdPartyStorage")
    @ev::description("Third-Party Storage Device", "三方存储设备")
    ThirdPartyStorageDevice,
};
def StorageDeviceClassification_domain: v::Domain(StorageDeviceClassification, String) = v::from_enum(
    "StorageDeviceClassification",
    StorageDeviceClassification.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type StorageDeviceDeviceType = enum {
    @ev::rename("storage")
    @ev::description("storage device", "存储设备")
    StorageDevice,
    @ev::rename("fcswitch")
    @ev::description("FC switch", "FC交换机")
    FcSwitch,
};
def StorageDeviceDeviceType_domain: v::Domain(StorageDeviceDeviceType, String) = v::from_enum(
    "StorageDeviceDeviceType",
    StorageDeviceDeviceType.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type StorageDeviceHealthStatus = enum {
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("Faulty", "故障")
    Faulty,
};
def StorageDeviceHealthStatus_domain: v::Domain(StorageDeviceHealthStatus, String) = v::from_enum(
    "StorageDeviceHealthStatus",
    StorageDeviceHealthStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type StorageDeviceConnectStatus = enum {
    @ev::itag(0)
    @ev::description("offline", "离线")
    Offline,
    @ev::itag(1)
    @ev::description("online", "在线")
    Online,
    @ev::itag(9)
    @ev::description("Disconnected", "连接失败")
    Disconnected,
};
def StorageDeviceConnectStatus_domain: v::Domain(StorageDeviceConnectStatus, Int) = v::from_enum(
    "StorageDeviceConnectStatus",
    StorageDeviceConnectStatus.type,
    Int.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def relations: Array(r::Relation) = [
    r::relation("storage_device_belongs_to_tenant", tenant, i::tenant_subject, cardinality),
    r::relation(
        "source_HuaweiStorageDeviceAssociationX_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        cardinality
    ),
];
def alternatives: Array(domain::Alternative) = [
    {
        id: "storage_device_site",
        cardinality,
        choices: [
            r::relation("storage_device_site_parent", parent_site, site::subject, cardinality),
            r::relation("storage_device_site_project", project_site, site::subject, cardinality)
        ]
    },
    {
        id: "source_HuaweiStorageDeviceAssociationX_SITE_VIEW",
        cardinality,
        choices: [
            r::relation(
                "source_HuaweiStorageDeviceAssociationX_SITE_VIEW_parent",
                parent_site,
                site::subject,
                cardinality
            ),
            r::relation(
                "source_HuaweiStorageDeviceAssociationX_SITE_VIEW_project",
                project_site,
                site::subject,
                cardinality
            )
        ]
    },
];
pub use self::{StorageId, StorageById, subject, relations, alternatives};

pub use self::{HuaweiStorageDevice};
