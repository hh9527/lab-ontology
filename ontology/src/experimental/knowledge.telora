# 从同一次 Prepared 导出有限事实；不捕获 handler，不生成反向导航。
use crate::experimental::transform as t;
use crate::experimental::groups as g;
use crate::experimental::values as v;
use crate::experimental::samples as samples;
use crate::ontology as edsl;
use std::array as array;
use std::dict as dict;
use std::string as string;
use std::type_desc as td;
use std::uri as uri;
use std::json as json;
use std::hash as hash;
use std::codec as codec;
use std::value::{Value};

type TypeField = struct {name: String, type: String};
type TypeVariant = struct {name: String, payload: Option(String)};
type RolePart = struct {source: String, target: String, type: String, nullable: Bool, raw: Option(String)};
type RolePair = struct {from: String, to: String};
type BindingMember = struct {local: String, publish: String, input: Value, type: String, nullable: Bool, aggregate: Option(crate::query::AggregateFunction), projectable: Bool, filters: Array(g::Filter), kind: g::MemberKind};
type Fact = struct { key: String, value: Value, references: Array(String) };
def object: Fn(Array((String, Value))) -> Value = fn(pairs) { Value::Object(dict::from_pairs(pairs)) };
def ref: Fn(String, String) -> String = fn(root, id) { `\{root}/\{uri::encode_component(id)}` };
def member_ref: Fn(String, String, String) -> String = fn(dataset, kind, id) { `\{ref("datasets", dataset)}#\{kind}/\{uri::encode_component(id)}` };
def type_id: Fn(Type) -> String = fn(ty) {
    match td::name(ty) {
        Some(name) => if td::children(ty) == [] { name }
            else { json::stringify(codec::encode((name, array::map(td::children(ty), type_id)))) },
        None => {
            let kind = td::kind(ty);
            let children = array::map(td::children(ty), type_id);
            let fields = if kind == td::TypeDescKind::Struct { array::map(td::fields(ty), fn(f) { f.name }) } else { [] };
            let variants = if kind == td::TypeDescKind::Enum { array::map(td::variants(ty), fn(v) { v.name }) } else { [] };
            match kind {
                td::TypeDescKind::Int => "Int", td::TypeDescKind::Float => "Float", td::TypeDescKind::String => "String", td::TypeDescKind::Bytes => "Bytes",
                td::TypeDescKind::Never => "Never", td::TypeDescKind::Type => "Type",
                _ => `shape:\{hash::sha256(json::stringify(codec::encode((kind, children, fields, variants))))}`,
            }
        },
    }
};
def type_ref: Fn(Type) -> String = fn(ty) { ref("types", type_id(ty)) };
def resolved: Fn(Type) -> Type = fn(ty) {
    if td::kind(ty) == td::TypeDescKind::Ref {
        match td::resolve(ty) { Ok(body) => body, Err(error) => fail!(error.message, ty) }
    } else { ty }
};
def type_dependencies: Fn(Type) -> Array(Type) = fn(ty) {
    let body = resolved(ty);
    array::concat([td::children(ty), if body != ty { [body] } else { [] },
        if td::kind(body) == td::TypeDescKind::Struct { array::map(td::fields(body), fn(f) { f.ty }) }
        else if td::kind(body) == td::TypeDescKind::Enum { array::flat_map(td::variants(body), fn(v) { match v.payload { Some(p) => [p], None => [] } }) }
        else { td::children(body) }])
};
def collect_types: Fn(Array(Type), Array(Type)) -> Array(Type) = fn(pending, seen) {
    # 按一层依赖批量去重，避免逐项复制整个待处理队列。
    let fresh = array::fold(pending, [].ty!(Array(Type)), fn(acc, ty) {
        if array::any(seen, fn(previous) { previous == ty }) || array::any(acc, fn(previous) { previous == ty }) { acc }
        else { array::push(acc, ty) }
    });
    if fresh == [] { seen }
    else { collect_types(array::flat_map(fresh, type_dependencies), array::concat([seen, fresh])) }
};
def type_fact: Fn(Type) -> Fact = fn(ty) {
    let body = resolved(ty);
    let fields = if td::kind(body) == td::TypeDescKind::Struct {
        array::map(td::fields(body), fn(f) { {name: f.name, type: type_ref(f.ty)}.ty!(TypeField) })
    } else { [] };
    let variants = if td::kind(body) == td::TypeDescKind::Enum {
        array::map(td::variants(body), fn(v) { {name: v.name, payload: match v.payload { Some(p) => Some(type_ref(p)), None => None }}.ty!(TypeVariant) })
    } else { [] };
    {key: type_ref(ty), value: object([("name", codec::encode(td::name(ty))), ("kind", codec::encode(td::kind(ty))), ("representation", codec::encode(if body != ty { Some(type_ref(body)) } else { None })), ("arguments", codec::encode(array::map(td::children(ty), type_ref))), ("field_types", codec::encode(fields)), ("variants", codec::encode(variants))]),
        references: array::map(type_dependencies(ty), type_ref)}
};
def column: Fn(g::Column) -> Value = fn(c) { object([("name", codec::encode(c.name)), ("type", codec::encode(type_ref(c.value))), ("nullable", codec::encode(c.nullable))]) };
def expression: Fn(g::Node) -> Value = fn(node) {
    match node {
        g::Node::Column(c) => object([("op", Value::String("column")), ("input", column(c))]),
        g::Node::Seconds(input) => object([("op", Value::String("seconds")), ("input", expression(input))]),
        g::Node::Ipv4(input) => object([("op", Value::String("ipv4")), ("input", expression(input))]),
        g::Node::UtcBucket(bucket) => object([("op", Value::String("utc_bucket")), ("input", expression(bucket.input)), ("unit", codec::encode(bucket.unit))]),
        g::Node::Rate(inputs) => object([("op", Value::String("rate")), ("amount", expression(inputs.amount)), ("duration", expression(inputs.duration))]),
        g::Node::Identity(input) => object([("op", Value::String("identity")), ("column", column(input.column)), ("parts", Value::Array(array::map(input.parts, column)))]),
    }
};
def expression_types: Fn(g::Node) -> Array(Type) = fn(node) {
    match node {
        g::Node::Column(c) => [c.value],
        g::Node::Seconds(input) => expression_types(input),
        g::Node::Ipv4(input) => expression_types(input),
        g::Node::UtcBucket(b) => expression_types(b.input),
        g::Node::Rate(inputs) => array::concat([expression_types(inputs.amount), expression_types(inputs.duration)]),
        g::Node::Identity(input) => array::concat([[input.column.value], array::map(input.parts, fn(c) { c.value })]),
    }
};
def binding_id: Fn(g::BindingFacts) -> String = fn(binding) {
    # 公开成员在 Dataset 内唯一；使用完整输出映射而非声明顺序或 Group 名。
    json::stringify(codec::encode(dict::from_pairs(array::map(binding.members, fn(m) { (m.local, m.id) }))))
};
def group_value: Fn(g::BindingFacts) -> Value = fn(binding) {
    match binding.contract {
        g::BindingContract::DeferredDimension(group) => object([("name", codec::encode(group.id)), ("type", codec::encode(type_ref(group.value))), ("projectable", codec::encode(group.projectable)), ("filters", codec::encode(group.filters))]),
        g::BindingContract::Transfer(group) => object([("name", codec::encode(group.id)), ("members", codec::encode(group.members))]),
        g::BindingContract::Numeric(group) => object([("name", codec::encode(group.id)), ("type", codec::encode(type_ref(group.value))), ("members", codec::encode(group.members))]),
        g::BindingContract::Identity(role) => object([("name", codec::encode("identity")), ("entity", codec::encode(ref("entities", role.entity))), ("type", codec::encode(type_ref(role.identity)))]),
        g::BindingContract::Dimension => {
            let member = binding.members[0];
            let policy = match member.kind { g::MemberKind::Dimension(policy) => policy, _ => fail!("dimension contract has no dimension policy", member.id) };
            object([("name", codec::encode(member.group)), ("type", codec::encode(type_ref(member.value))),
                ("projectable", codec::encode(policy.projectable)), ("filters", codec::encode(policy.filters))])
        },
    }
};
def group_root: Fn(g::BindingFacts) -> String = fn(binding) {
    match binding.contract { g::BindingContract::Transfer(_) => "measure_groups", g::BindingContract::Numeric(_) => "measure_groups", _ => "dimension_groups" }
};
def group_ref: Fn(g::BindingFacts) -> String = fn(binding) { ref(group_root(binding), hash::sha256(json::stringify(group_value(binding)))) };
def binding_facts: Fn(t::Declaration, g::BindingFacts) -> Array(Fact) = fn(declared, binding) {
    let key = member_ref(declared.dataset.id, "bindings", binding_id(binding));
    let group = group_ref(binding);
    let types = array::flat_map(binding.members, fn(m) { array::concat([[m.value], expression_types(m.node)]) });
    let group_fact: Fact = {key: group, value: group_value(binding), references: array::map(types, type_ref)};
    let members = array::map(binding.members, fn(m) {
        {local: m.local, publish: m.id, input: expression(m.node), type: type_ref(m.value), nullable: m.nullable,
            aggregate: m.aggregate, projectable: m.projectable, filters: m.filters, kind: m.kind}.ty!(BindingMember)
    });
    let binding_fact: Fact = {key, value: object([("group", codec::encode(group)), ("members", codec::encode(members))]), references: array::concat([[group], array::map(types, type_ref)])};
    let outputs = array::map(binding.members, fn(m) {
        {key: member_ref(declared.dataset.id, if m.aggregate == None { "dimensions" } else { "measures" }, m.id),
            value: object([("binding", codec::encode(key)), ("group", codec::encode(group)), ("local", codec::encode(m.local)), ("type", codec::encode(type_ref(m.value)))]), references: [key, group, type_ref(m.value)]}.ty!(Fact)
    });
    array::concat([[group_fact, binding_fact], outputs])
};
def domain_facts: Fn(t::Declaration, v::BindingFacts) -> Array(Fact) = fn(d, b) {
    let definition = object([("name", codec::encode(b.definition.id)), ("type", codec::encode(type_ref(b.definition.value))), ("wire", codec::encode(type_ref(b.definition.wire))), ("canonical_values", codec::encode(b.definition.values)), ("half_open", codec::encode(b.definition.half_open)), ("order", codec::encode(b.definition.order)), ("projectable", codec::encode(b.group_projectable)), ("filters", codec::encode(b.group_filters))]);
    let group = ref("dimension_groups", hash::sha256(json::stringify(definition)));
    let binding = member_ref(d.dataset.id, "bindings", json::stringify(codec::encode(("domain", b.id))));
    let value_facts = array::map(b.definition.values, fn(v) {
        {key: `\{type_ref(b.definition.value)}#values/\{uri::encode_component(v.id)}`,
            value: object([("wires", codec::encode(v.wires))]), references: [type_ref(b.definition.value)]}.ty!(Fact)
    });
    array::concat([value_facts, [{key: type_ref(b.definition.value), value: object([("canonical_order", codec::encode(b.definition.order)), ("half_open", codec::encode(b.definition.half_open)), ("wire", codec::encode(type_ref(b.definition.wire)))]), references: [type_ref(b.definition.wire)]}.ty!(Fact),
     {key: group, value: definition, references: [type_ref(b.definition.value), type_ref(b.definition.wire)]}.ty!(Fact),
     {key: binding, value: object([("group", codec::encode(group)), ("input", codec::encode(expression(b.node))), ("publish", codec::encode(b.id)), ("nullable", codec::encode(b.nullable)), ("projectable", codec::encode(b.projectable)), ("filters", codec::encode(b.filters))]), references: [group]}.ty!(Fact),
     {key: member_ref(d.dataset.id, "dimensions", b.id), value: object([("binding", codec::encode(binding)), ("group", codec::encode(group)), ("type", codec::encode(type_ref(b.definition.value)))]), references: [binding, group, type_ref(b.definition.value)]}.ty!(Fact)]])
};
def sample_facts: Fn(t::Declaration, samples::BindingFacts) -> Array(Fact) = fn(d, b) {
    let definition = object([("name", codec::encode(b.group)), ("type", codec::encode(type_ref(b.value))), ("primary", codec::encode(b.primary)), ("summaries", codec::encode(b.summaries)), ("unit", codec::encode(b.unit))]);
    let group = ref("measure_groups", hash::sha256(json::stringify(definition)));
    let binding = member_ref(d.dataset.id, "bindings", json::stringify(codec::encode(("sample", b.names))));
    array::concat([[
        {key: group, value: definition, references: [type_ref(b.value)]}.ty!(Fact),
        {key: binding, value: object([("group", codec::encode(group)), ("field", codec::encode(member_ref(d.dataset.id, "fields", b.field))), ("nullable", codec::encode(b.nullable)), ("names", codec::encode(b.names))]), references: [group, member_ref(d.dataset.id, "fields", b.field)]}.ty!(Fact)],
        array::map(b.names, fn(n) { {key: member_ref(d.dataset.id, "measures", n.publish), value: object([("binding", codec::encode(binding)), ("group", codec::encode(group)), ("statistic", codec::encode(n.statistic)), ("type", codec::encode(type_ref(b.value)))]), references: [binding, group, type_ref(b.value)]}.ty!(Fact) })])
};
def dataset_facts: Fn(t::Declaration, edsl::EntityEntry) -> Array(Fact) = fn(declared, dataset) {
    let ds = declared.dataset;
    let roles = array::flat_map(ds.roles, fn(role) {
        [{key: ref("entities", role.entity), value: object([("identity", codec::encode(type_ref(role.identity)))]), references: [type_ref(role.identity)]}.ty!(Fact),
         {key: member_ref(ds.id, "roles", role.id), value: object([("entity", codec::encode(ref("entities", role.entity))), ("identity", codec::encode(type_ref(role.identity))), ("optional", codec::encode(role.optional)), ("parts", codec::encode(array::map(role.parts, fn(p) { {source: p.source, target: p.target, type: type_ref(p.value), nullable: p.nullable, raw: match p.raw { Some(raw) => Some(type_ref(raw)), None => None }}.ty!(RolePart) })))]),
            references: array::concat([[ref("entities", role.entity), type_ref(role.identity)], array::flat_map(role.parts, fn(p) { array::concat([[type_ref(p.value)], match p.raw { Some(raw) => [type_ref(raw)], None => [] }]) })])}.ty!(Fact)]
    });
    let fields = array::map(dataset.fields, fn(f) {
        {key: member_ref(ds.id, "fields", f.name), value: object([("column", codec::encode(f.column)), ("type", codec::encode(type_ref(f.ty))), ("nullable", codec::encode(f.nullable)), ("key", codec::encode(f.is_key)), ("time", codec::encode(f.time)), ("logical_type", codec::encode(f.logical_type))]), references: [type_ref(f.ty)]}.ty!(Fact)
    });
    let time_roles = array::flat_map(dataset.fields, fn(f) {
        match f.time {
            None => [],
            Some(time) => [{key: member_ref(ds.id, "time_roles", f.name), value: object([
                ("field", codec::encode(member_ref(ds.id, "fields", f.name))), ("encoding", codec::encode(time.encoding)),
                ("semantics", codec::encode(time.semantics)), ("authoritative", codec::encode(declared.clock == Some(f.name)))]),
                references: [member_ref(ds.id, "fields", f.name)]}.ty!(Fact)],
        }
    });
    let base: Fact = {key: ref("datasets", ds.id), value: object([("source", codec::encode(ds.source)), ("row", codec::encode(type_ref(ds.row))), ("grain", codec::encode(ds.grain)), ("kind", codec::encode(declared.kind)), ("scope", codec::encode(dataset.scope)), ("clock", codec::encode(declared.clock))]), references: [type_ref(ds.row)]};
    array::concat([[base], roles, fields, time_roles, array::flat_map(declared.groups, fn(b) { binding_facts(declared, b) }),
        array::flat_map(declared.domains, fn(b) { domain_facts(declared, b) }), array::flat_map(declared.samples, fn(b) { sample_facts(declared, b) })])
};
# 合并来源事实和实际授权；不从 Group 声明猜测公开权限。
def merge_value: Fn(Value, Value) -> Value = fn(left, right) {
    match (left, right) { (Value::Object(a), Value::Object(b)) => Value::Object(dict::merge(a, b)), _ => right }
};
def relation_key: Fn(edsl::EntityEntry, edsl::EntityEntry, edsl::RelationKey) -> Value = fn(from, to, key) {
    match key {
        edsl::RelationKey::Eq(pair) => object([("op", Value::String("eq")), ("from", Value::String(member_ref(from.id, "fields", from.fields[pair.from].name))), ("to", Value::String(member_ref(to.id, "fields", to.fields[pair.to].name)))]),
        edsl::RelationKey::And(keys) => object([("op", Value::String("and")), ("inputs", Value::Array(array::map(keys, fn(k) { relation_key(from, to, k) })))]),
        edsl::RelationKey::Or(keys) => object([("op", Value::String("or")), ("inputs", Value::Array(array::map(keys, fn(k) { relation_key(from, to, k) })))]),
    }
};
def relation_fields: Fn(edsl::EntityEntry, edsl::EntityEntry, edsl::RelationKey) -> Array(String) = fn(from, to, key) {
    match key {
        edsl::RelationKey::Eq(pair) => [member_ref(from.id, "fields", from.fields[pair.from].name), member_ref(to.id, "fields", to.fields[pair.to].name)],
        edsl::RelationKey::And(keys) => array::flat_map(keys, fn(k) { relation_fields(from, to, k) }),
        edsl::RelationKey::Or(keys) => array::flat_map(keys, fn(k) { relation_fields(from, to, k) }),
    }
};
def capability_facts: Fn(edsl::PreparedPayload) -> Array(Fact) = fn(payload) {
    let dims = array::map(payload.dimensions, fn(d) {
        let ds = payload.entities[d.entity].id;
        {key: member_ref(ds, "dimensions", d.id), value: object([("authorized", codec::encode(d.authorized)), ("projectable", codec::encode(d.projectable)), ("filterable", codec::encode(d.filterable)), ("ops", codec::encode(d.ops)), ("input_kinds", codec::encode(d.input_kinds)), ("output_type", codec::encode(d.output_type)), ("computed", codec::encode(d.computed)), ("utc_bucket", codec::encode(d.utc_bucket)), ("canonical_values", codec::encode(d.canonical_values)), ("canonical_order", codec::encode(d.canonical_order)), ("half_open", codec::encode(d.half_open)), ("scope", codec::encode(d.scope)), ("field", codec::encode(member_ref(ds, "fields", payload.entities[d.entity].fields[d.field].name)))]),
            references: [member_ref(ds, "fields", payload.entities[d.entity].fields[d.field].name)]}.ty!(Fact)
    });
    let measures = array::map(payload.measures, fn(m) {
        let ds = payload.entities[m.entity].id;
        {key: member_ref(ds, "measures", m.id), value: object([("anchor_field", codec::encode(member_ref(ds, "fields", payload.entities[m.entity].fields[m.field].name))), ("aggregate", codec::encode(m.aggregate)), ("input", codec::encode(m.input)), ("predicate", codec::encode(m.predicate)), ("computed", codec::encode(m.computed)), ("requires", codec::encode(array::map(m.requires, fn(index) { ref("datasets", payload.entities[index].id) }))), ("sampling", codec::encode(array::find(payload.entities[m.entity].sample_measures, fn(s) { s.id == m.id })))]),
            references: array::concat([[member_ref(ds, "fields", payload.entities[m.entity].fields[m.field].name)], array::map(m.requires, fn(index) { ref("datasets", payload.entities[index].id) }),
                match m.computed { Some(c) => [member_ref(ds, "measures", c.left), member_ref(ds, "measures", c.right)], None => [] }])}.ty!(Fact)
    });
    let relations = array::map(payload.relations, fn(r) {
        let from = ref("datasets", payload.entities[r.from].id);
        let to = ref("datasets", payload.entities[r.to].id);
        {key: ref("relations", r.id), value: object([("from_dataset", codec::encode(from)), ("to_dataset", codec::encode(to)), ("cardinality", codec::encode(r.cardinality)), ("key", relation_key(payload.entities[r.from], payload.entities[r.to], r.key)), ("guard", codec::encode(r.guard))]), references: array::concat([[from, to], relation_fields(payload.entities[r.from], payload.entities[r.to], r.key)])}.ty!(Fact)
    });
    let links = array::map(payload.business_links, fn(l) {
        let hub = ref("datasets", payload.entities[l.hub].id);
        let participant = ref("datasets", payload.entities[l.participant].id);
        let a = ref("relations", l.a_relation);
        let z = ref("relations", l.z_relation);
        {key: member_ref(payload.entities[l.hub].id, "business_links", l.id), value: object([("hub", codec::encode(hub)), ("participant", codec::encode(participant)), ("a_relation", codec::encode(a)), ("z_relation", codec::encode(z)), ("direction", codec::encode(l.direction)), ("guard", codec::encode(l.guard))]), references: [hub, participant, a, z]}.ty!(Fact)
    });
    array::concat([dims, measures, relations, links])
};
def relation_sources: Fn(t::Prepared) -> Array(Fact) = fn(prepared) {
    let relations = array::map(prepared.relations, fn(r) {
        let from = member_ref(r.from.dataset.id, "roles", r.from.role);
        let to = member_ref(r.to.dataset.id, "roles", r.to.role);
        {key: ref("relations", r.id), value: object([("from_role", codec::encode(from)), ("to_role", codec::encode(to))]), references: [from, to]}.ty!(Fact)
    });
    let alternatives = array::map(prepared.alternatives, fn(a) {
        let endpoints = array::map(a.choices, fn(r) { {from: member_ref(r.from.dataset.id, "roles", r.from.role), to: member_ref(r.to.dataset.id, "roles", r.to.role)}.ty!(RolePair) });
        {key: ref("relations", a.id), value: object([("alternatives", codec::encode(endpoints))]), references: array::flat_map(endpoints, fn(e) { [e.from, e.to] })}.ty!(Fact)
    });
    array::concat([relations, alternatives])
};
# 平衡合并，复用的定义按语义地址合并；总复制量为 O(n log n)。
def merge_facts: Fn(Array(Fact)) -> Dict(Fact) = fn(facts) {
    if array::length(facts) < 2 { dict::from_pairs(array::map(facts, fn(f) { (f.key, f) })) }
    else {
        let middle = array::length(facts) / 2;
        let indexed = array::enumerate(facts);
        let left = merge_facts(array::map(array::filter(indexed, fn(p) { p.0 < middle }), fn(p) { p.1 }));
        let right = merge_facts(array::map(array::filter(indexed, fn(p) { p.0 >= middle }), fn(p) { p.1 }));
        let additions = dict::from_pairs(array::map(dict::pairs(right), fn(pair) {
            let fact = pair.1;
            let next = match dict::get(left, fact.key) {
                None => fact,
                Some(previous) => {key: fact.key, value: merge_value(previous.value, fact.value), references: array::concat([previous.references, fact.references])}.ty!(Fact),
            };
            (pair.0, next)
        }));
        dict::merge(left, additions)
    }
};
def export: Fn(t::Prepared) -> Value = fn(prepared) {
    let seeds = array::flat_map(prepared.declarations, fn(d) {
        array::concat([[d.dataset.row], array::map(d.dataset.roles, fn(r) { r.identity }),
            array::map(d.samples, fn(b) { b.value }), array::flat_map(d.domains, fn(b) { [b.definition.value, b.definition.wire] }),
            array::flat_map(d.groups, fn(b) { array::flat_map(b.members, fn(m) { array::concat([[m.value], expression_types(m.node)]) }) })])
    });
    let types = collect_types(seeds, []);
    let passes = [array::map(types, type_fact), array::flat_map(array::enumerate(prepared.declarations), fn(pair) { dataset_facts(pair.1, prepared.payload.entities[pair.0]) }), capability_facts(prepared.payload), relation_sources(prepared)];
    # 类内重复仅为同定义复用；跨类别补充以有限次字典合并装配，避免逐事实复制全图。
    let merged = array::fold(passes, {}.ty!(Dict(Fact)), fn(acc, facts) {
        let unique = merge_facts(facts);
        let additions = dict::from_pairs(array::map(dict::pairs(unique), fn(pair) {
            let fact = pair.1;
            let next = match dict::get(acc, fact.key) {
                None => fact,
                Some(previous) => {key: fact.key, value: merge_value(previous.value, fact.value), references: array::concat([previous.references, fact.references])}.ty!(Fact),
            };
            (pair.0, next)
        }));
        dict::merge(acc, additions)
    });
    object([("knowledge_contract", codec::encode("ontology-knowledge-v4")), ("intent_contract", codec::encode("ontology-intent-v1")), ("addressing", codec::encode("node-member-uri-v1")), ("revision", codec::encode(prepared.payload.revision)), ("facts", codec::encode(dict::values(merged))), ("items", codec::encode([].ty!(Array(Value))))])
};
pub use self::{export, type_id};
