def no_offset_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Filter, qb.Operator.Order, qb.Operator.Limit],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Substr, qb.ScalarFunction.Gt],
        allow_distinct: True,
    };
    profile
};

def pagination_lowerings_to_limit_offset = fn() {
    let q = qb.transform_sqlite(paged_plan());
    let expected: Array(qb.Val) = [qb.Val.Float(50.0), qb.Val.Int(10), qb.Val.Int(20)];
    q.sql == "SELECT o.id FROM orders AS o WHERE o.total > ? ORDER BY o.id ASC LIMIT ? OFFSET ?"
        && q.bindings == expected
};

def pagination_offset_without_limit_lowerings_to_limit_minus_one = fn() {
    let q = qb.transform_sqlite(offset_only_plan());
    let expected: Array(qb.Val) = [qb.Val.Int(5)];
    q.sql == "SELECT o.id FROM orders AS o ORDER BY o.id ASC LIMIT -1 OFFSET ?"
        && q.bindings == expected
};

def pagination_offset_zero_is_accepted_and_lowered = fn() {
    let q = qb.transform_sqlite(offset_zero_plan());
    let expected: Array(qb.Val) = [qb.Val.Int(10), qb.Val.Int(0)];
    q.sql == "SELECT o.id FROM orders AS o ORDER BY o.id ASC LIMIT ? OFFSET ?"
        && q.bindings == expected
};

def pagination_bindings_follow_placeholder_order = fn() {
    let q = qb.transform_sqlite(paged_plan());
    let q2 = qb.transform_sqlite(offset_zero_plan());
    (array.length(string.split(q.sql, "?")) - 1) == array.length(q.bindings)
        && (array.length(string.split(q2.sql, "?")) - 1) == array.length(q2.bindings)
};

def pagination_requires_stable_ordering = fn() {
    !qb.structure_ok(offset_no_ordering_plan())
};

def pagination_rejects_negative_offset = fn() {
    !qb.structure_ok(negative_offset_plan())
};

def pagination_accepts_non_negative_offset = fn() {
    qb.structure_ok(paged_plan()) && qb.structure_ok(offset_zero_plan())
};

def pagination_operator_in_canonical_order = fn() {
    let expected: Array(qb.Operator) = [
        qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Filter,
        qb.Operator.Order, qb.Operator.Limit, qb.Operator.Offset,
    ];
    qb.operators(paged_plan()) == expected
};

def pagination_profile_rejects_without_offset_operator = fn() {
    !qb.profile_accepts(paged_plan(), no_offset_profile())
};

def pagination_profile_accepts_with_offset_operator = fn() {
    qb.profile_accepts(paged_plan(), full_profile())
};

def pagination_deterministic = fn() {
    let q1 = qb.transform_sqlite(paged_plan());
    let q2 = qb.transform_sqlite(paged_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

# ---------------------------------------------------------------------------
# Partitioned Top N.
#
# Success: partition by Role, keep the top 3 CommandHeads per Role by
# EventCount desc, CommandHead asc.  `take` enters SQL as a bound `?`.
# ---------------------------------------------------------------------------

def top_per_role_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-top-per-role",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.expr_item(qb.column("e", "command_head")),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("e", "id"), False, "event_count"),
        ],
        filter: Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("e", "status"), qb.bind_string("failed")])),
        joins: [],
        grouping: [qb.column("e", "role"), qb.column("e", "command_head")],
        ordering: [],
        limit: None,
        offset: None,
        exists: [],
        having: [],
        derived: None,
        partition: Some(qb.partitioned_top_n(
            [qb.column("e", "role")],
            [qb.desc_aggregate("event_count"), qb.asc(qb.column("e", "command_head"))],
            3,
        )),
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def expected_top_per_role_sql = "SELECT __q_0, __q_1, event_count FROM (SELECT e.role AS __q_0, e.command_head AS __q_1, count(e.id) AS event_count, row_number() OVER (PARTITION BY e.role ORDER BY count(e.id) DESC, e.command_head ASC) AS __q_rn FROM events AS e WHERE e.status = ? GROUP BY e.role, e.command_head) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_0 ASC, event_count DESC, __q_1 ASC";

def expected_top_per_role_bindings: Array(qb.Val) = [qb.Val.String("failed"), qb.Val.Int(3)];

