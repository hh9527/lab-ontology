use crate::model::{ payload, Tenant, Site, Device, Connection, Route };
use ontology::intent::{ query_intent_ast_factory };
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::json as json;
use std::string as string;
use std::test as test;
use std::array as array;
use std::value::{ Value };

def lower: Fn(Value) -> qb::QueryAst = query_intent_ast_factory(payload, "resolver");

@edsl::entity_id("unscoped_connection")
@edsl::entity_source("unscoped_connections", "uc")
@edsl::dataset(edsl::DatasetKind::Entity, ["id"], None)
@edsl::named_relation_key("unscoped_connection_endpoint", Device.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::Or([
        edsl::RelationKey::FieldEq({from: "a_id", to: "id"}),
        edsl::RelationKey::FieldEq({from: "z_id", to: "id"}),
    ]))
type UnscopedConnection = struct {
    @edsl::column("a_id") a_id: String,
    @edsl::column("id") @edsl::key(True) id: String,
    @edsl::column("z_id") z_id: String,
};

def unscoped_payload: edsl::PreparedPayload = edsl::build_root("unscoped-count-pressure",
    [Tenant.type, Site.type, Device.type, UnscopedConnection.type], payload.profile,
    fn(subject) { subject == "resolver" });

# Two independent sample populations share a composite owner, but must never
# multiply one another before their aggregate thresholds are evaluated.
@edsl::entity_id("sample_a")
@edsl::entity_source("sample_a", "sample_a")
@edsl::dataset(edsl::DatasetKind::Metric, ["id", "tenant_id", "ts"], Some("ts"))
@edsl::named_relation_key("sample_a_owner", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({from: "owner_id", to: "id"}),
        edsl::RelationKey::FieldEq({from: "tenant_id", to: "tenant_id"}),
    ]))
type SampleA = struct {
    @edsl::column("id")
    @edsl::dimension("sample_a_id", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    id: String,
    @edsl::column("owner_id")
    owner_id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::CanonicalUtcSecondText)
    @edsl::dimension("sample_a_ts", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    ts: String,
    @edsl::column("value")
    @edsl::dimension("sample_a_value", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Int])
    @edsl::measure("sample_a_sum", qb::AggregateFunction::Sum, [])
    value: Int,
};

@edsl::entity_id("sample_b")
@edsl::entity_source("sample_b", "sample_b")
@edsl::dataset(edsl::DatasetKind::Metric, ["id", "tenant_id", "ts"], Some("ts"))
@edsl::named_relation_key("sample_b_owner", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({from: "owner_id", to: "id"}),
        edsl::RelationKey::FieldEq({from: "tenant_id", to: "tenant_id"}),
    ]))
type SampleB = struct {
    @edsl::column("id")
    id: String,
    @edsl::column("owner_id")
    owner_id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::CanonicalUtcSecondText)
    ts: String,
    @edsl::column("value")
    @edsl::measure("sample_b_count", qb::AggregateFunction::Count, [])
    value: Int,
};

def sample_profile: qb::PlanProfile = {...payload.profile,
    allowed_operators: array::concat([payload.profile.allowed_operators, [qb::Operator::Having, qb::Operator::Partition, qb::Operator::Order]]),
    allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Sum],
    allowed_scalars: array::concat([payload.profile.allowed_scalars, [qb::ScalarFunction::Gt]]),
};
def sample_payload: edsl::PreparedPayload = edsl::build_root("independent-sample-pressure",
    [Tenant.type, Site.type, Device.type, SampleA.type, SampleB.type], sample_profile, fn(subject) { subject == "resolver" });
def lower_samples: Fn(Value) -> qb::QueryAst = query_intent_ast_factory(sample_payload, "resolver");

pub def independent_sample_aggregates_do_not_multiply: test::Test = test::should_ok(fn() {
    let ast = lower_samples(json::parse(r#"{
        "op":"graph", "root":"owner", "nodes":[{"id":"owner","entity":"device"}],
        "edges":[], "select":[], "count":"owner",
        "exists":[
            {"anchor":"owner","nodes":[{"id":"a","entity":"sample_a"}],
             "edges":[{"relation":"sample_a_owner","from":"a","to":"owner"}],
             "having":[{"node":"a","measure":"sample_a_sum","op":"gt","kind":"int","value":9}]},
            {"anchor":"owner","nodes":[{"id":"b","entity":"sample_b"}],
             "edges":[{"relation":"sample_b_owner","from":"b","to":"owner"}],
             "having":[{"node":"b","measure":"sample_b_count","op":"gt","kind":"int","value":1}]}
        ]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "HAVING sum(a.value) > ?1")
        && string::contains(sq.sql, "HAVING count(b.value) > ?2")
        && string::contains(sq.sql, "GROUP BY a.owner_id, a.tenant_id")
        && string::contains(sq.sql, "GROUP BY b.owner_id, b.tenant_id")
        && !string::contains(sq.sql, "JOIN sample_a")
        && !string::contains(sq.sql, "JOIN sample_b")
        && string::contains(pg.sql, "HAVING sum(\"a\".\"value\") > $1") {
        True
    } else { fail!("independent sample aggregates lost their owner grain", sq, pg) }
});

pub def aggregate_existence_rejects_wrong_measure_owner: test::Test = test::should_fail_with(fn() {
    lower_samples(json::parse(r#"{
        "op":"graph", "root":"owner", "nodes":[{"id":"owner","entity":"device"}],
        "edges":[], "select":[], "count":"owner",
        "exists":[{"anchor":"owner","nodes":[{"id":"a","entity":"sample_a"}],
            "edges":[{"relation":"sample_a_owner","from":"a","to":"owner"}],
            "having":[{"node":"a","measure":"sample_b_count","op":"gt","kind":"int","value":1}]}]
    }"#).unwrap!())
}, "graph aggregate measure does not belong to its sample node");

pub def aggregate_existence_rejects_wrong_sample_relation: test::Test = test::should_fail_with(fn() {
    lower_samples(json::parse(r#"{
        "op":"graph", "root":"owner", "nodes":[{"id":"owner","entity":"device"}],
        "edges":[], "select":[], "count":"owner",
        "exists":[{"anchor":"owner","nodes":[{"id":"a","entity":"sample_a"}],
            "edges":[{"relation":"sample_b_owner","from":"a","to":"owner"}],
            "having":[{"node":"a","measure":"sample_a_sum","op":"gt","kind":"int","value":1}]}]
    }"#).unwrap!())
}, "graph existence edge role or target does not match declared relation");

pub def latest_sample_keeps_the_whole_row_and_composite_owner: test::Test = test::should_ok(fn() {
    let ast = lower_samples(json::parse(r#"{
        "op":"graph", "root":"owner",
        "nodes":[{"id":"owner","entity":"device"},{"id":"sample","entity":"sample_a"}],
        "edges":[{"relation":"sample_a_owner","from":"sample","to":"owner"}],
        "select":[{"node":"owner","dimension":"device_id"},
                  {"node":"sample","dimension":"sample_a_ts"},
                  {"node":"sample","dimension":"sample_a_value"}],
        "top_per":{"owner":"owner","sample":"sample","rank":"sample_a_ts","take":1}
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "PARTITION BY owner.id, owner.tenant_id")
        && string::contains(sq.sql, "ORDER BY sample.ts DESC, sample.id ASC")
        && string::contains(sq.sql, "sample.value AS sample_sample_a_value")
        && string::contains(pg.sql, "PARTITION BY \"owner\".\"id\", \"owner\".\"tenant_id\"") {
        True
    } else { fail!("latest sample lost full row or owner identity", sq, pg) }
});

pub def latest_sample_rejects_unrelated_rank: test::Test = test::should_fail_with(fn() {
    lower_samples(json::parse(r#"{
        "op":"graph", "root":"owner",
        "nodes":[{"id":"owner","entity":"device"},{"id":"sample","entity":"sample_a"}],
        "edges":[{"relation":"sample_a_owner","from":"sample","to":"owner"}],
        "select":[{"node":"sample","dimension":"sample_a_value"}],
        "top_per":{"owner":"owner","sample":"sample","rank":"device_id","take":1}
    }"#).unwrap!())
}, "graph top-per rank must be a plain authorized sample dimension");

pub def latest_sample_rejects_unrelated_owner_relation: test::Test = test::should_fail_with(fn() {
    lower_samples(json::parse(r#"{
        "op":"graph", "root":"owner",
        "nodes":[{"id":"owner","entity":"device"},{"id":"sample","entity":"sample_a"}],
        "edges":[{"relation":"sample_b_owner","from":"sample","to":"owner"}],
        "select":[{"node":"sample","dimension":"sample_a_value"}],
        "top_per":{"owner":"owner","sample":"sample","rank":"sample_a_ts","take":1}
    }"#).unwrap!())
}, "graph edge role or target does not match declared relation");

def plain_builder: Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr) = fn(ctx, col) { (ctx, col) };
def projection_scope: Array(edsl::ScopePredicate) = [
    {field: "id", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("active")},
];

@edsl::entity_id("projection_pressure")
@edsl::entity_source("projection_pressure", "pressure")
type ProjectionPressure = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::dimension("pressure_id", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    id: String,
    @edsl::column("computed_label")
    @edsl::computed_dimension("computed_label", edsl::OutputType::Text, True, True,
        [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text], plain_builder)
    computed_label: String,
    @edsl::column("secret_label")
    @edsl::dimension("secret_label", False, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    secret_label: String,
    @edsl::column("scoped_label")
    @edsl::dimension("scoped_label", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    @edsl::scope(projection_scope)
    scoped_label: String,
};

def projection_payload: edsl::PreparedPayload = edsl::build_root("graph-projection-pressure",
    [ProjectionPressure.type], payload.profile, fn(subject) { subject == "resolver" });
def lower_projection: Fn(Value) -> qb::QueryAst = query_intent_ast_factory(projection_payload, "resolver");

pub def graph_computed_projection_reports_unsupported: test::Test = test::should_fail_with(fn() {
    lower_projection(json::parse(r#"{"op":"graph","root":"p",
        "nodes":[{"id":"p","entity":"projection_pressure"}],"edges":[],
        "select":[{"node":"p","dimension":"computed_label"}]}"#).unwrap!())
}, "unsupported graph computed dimension projection");

pub def graph_scoped_projection_reports_unsupported: test::Test = test::should_fail_with(fn() {
    lower_projection(json::parse(r#"{"op":"graph","root":"p",
        "nodes":[{"id":"p","entity":"projection_pressure"}],"edges":[],
        "select":[{"node":"p","dimension":"scoped_label"}]}"#).unwrap!())
}, "unsupported graph scoped dimension projection");

pub def graph_unauthorized_projection_is_invalid: test::Test = test::should_fail_with(fn() {
    lower_projection(json::parse(r#"{"op":"graph","root":"p",
        "nodes":[{"id":"p","entity":"projection_pressure"}],"edges":[],
        "select":[{"node":"p","dimension":"secret_label"}]}"#).unwrap!())
}, "graph projection dimension is not authorized");

pub def graph_wrong_node_projection_is_invalid: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"tenant",
        "nodes":[{"id":"tenant","entity":"tenant"}],"edges":[],
        "select":[{"node":"tenant","dimension":"device_id"}]}"#).unwrap!())
}, "graph projection dimension does not belong to its named node");

@edsl::entity_id("ambiguous_connection")
@edsl::entity_source("ambiguous_connections", "ambiguous_connection")
@edsl::named_relation_key("ambiguous_safe_endpoint", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::Or([
        edsl::RelationKey::Eq({from: 0, to: 0}),
        edsl::RelationKey::Eq({from: 1, to: 0}),
    ]))
type AmbiguousConnection = struct {
    @edsl::column("a_device_id")
    a_device_id: String,
    @edsl::column("z_device_id")
    z_device_id: String,
};

pub def safe_alternative_key_cannot_prove_unique_target: test::Test = test::should_fail_with(fn() {
    edsl::build_root("unsafe-alternative", [Tenant.type, Site.type, Device.type, AmbiguousConnection.type],
        payload.profile, fn(subject) { subject == "resolver" })
}, "safe relation cannot prove a unique target across alternative keys");

pub def graph_rejects_ignored_top_level_condition: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph","root":"d","nodes":[{"id":"d","entity":"device"}],
        "edges":[],"select":[{"node":"d","dimension":"device_id"}],
        "any_of":[{"node":"d","dimension":"device_id","op":"eq","kind":"text","value":"x"}]
    }"#).unwrap!())
}, "graph intent contains unsupported key");

pub def graph_rejects_ignored_existence_constraint: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph","root":"d","nodes":[{"id":"d","entity":"device"}],
        "edges":[],"select":[],"count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"site","entity":"site"}],
            "edges":[{"relation":"device_site","from":"d","to":"site"}],"min_matches":2}]
    }"#).unwrap!())
}, "graph intent contains unsupported key");

pub def graph_rejects_ignored_edge_constraint: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph","root":"d","nodes":[{"id":"d","entity":"device"},{"id":"site","entity":"site"}],
        "edges":[{"relation":"device_site","from":"d","to":"site","scope":"active"}],
        "select":[{"node":"d","dimension":"device_id"}]
    }"#).unwrap!())
}, "graph intent contains unsupported key");

pub def graph_rejects_ignored_filter_constraint: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph","root":"d","nodes":[{"id":"d","entity":"device"}],
        "edges":[],"select":[{"node":"d","dimension":"device_id"}],
        "filters":[{"node":"d","dimension":"device_id","op":"eq","kind":"text","value":"x","negated":true}]
    }"#).unwrap!())
}, "graph intent contains unsupported key");

@edsl::entity_id("reading")
@edsl::entity_source("readings", "reading")
@edsl::dataset(edsl::DatasetKind::Entity, ["reading_id", "tenant_id"], None)
@edsl::named_relation_key("reading_tenant", Tenant.type, edsl::RelationKind::Safe,
    edsl::RelationKey::Eq({from: 1, to: 0}))
type Reading = struct {
    @edsl::column("reading_id")
    @edsl::dimension("reading_id", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    reading_id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

@edsl::entity_id("reading_child")
@edsl::entity_source("reading_children", "child")
@edsl::named_relation_key("child_reading", Reading.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::Eq({from: 1, to: 0}),
        edsl::RelationKey::Eq({from: 2, to: 1}),
    ]))
type ReadingChild = struct {
    @edsl::column("id")
    @edsl::key(True)
    @edsl::dimension("child_id", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    id: String,
    @edsl::column("reading_id")
    reading_id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

@edsl::entity_id("partial_reading_child")
@edsl::entity_source("partial_reading_children", "partial_child")
@edsl::named_relation_key("partial_child_reading", Reading.type, edsl::RelationKind::Safe,
    edsl::RelationKey::Eq({from: 0, to: 0}))
type PartialReadingChild = struct {
    @edsl::column("reading_id")
    reading_id: String,
};

pub def composite_target_requires_full_identity: test::Test = test::should_fail_with(fn() {
    edsl::build_root("partial-composite-join", [Tenant.type, Reading.type, PartialReadingChild.type],
        payload.profile, fn(subject) { subject == "resolver" })
}, "partial_child_reading from partial_reading_child to reading lacks target identity field tenant_id; add its declared equality to the relation key");

@edsl::entity_id("partial_device_endpoint")
@edsl::entity_source("partial_device_endpoints", "partial_endpoint")
@edsl::named_relation_key("partial_endpoint_device", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::Eq({from: 0, to: 0}))
type PartialDeviceEndpoint = struct {
    @edsl::column("device_id")
    device_id: String,
};

pub def tenant_scoped_device_rejects_id_only_safe_relation: test::Test = test::should_fail_with(fn() {
    edsl::build_root("partial-device-identity", [Tenant.type, Site.type, Device.type, PartialDeviceEndpoint.type],
        payload.profile, fn(subject) { subject == "resolver" })
}, "partial_endpoint_device from partial_device_endpoint to device lacks target identity field tenant_id; add its declared equality to the relation key");

@edsl::entity_id("duplicate_reading_child")
@edsl::entity_source("duplicate_reading_children", "duplicate_child")
@edsl::named_relation_key("duplicate_child_reading", Reading.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::Eq({from: 0, to: 0}),
        edsl::RelationKey::Eq({from: 1, to: 0}),
        edsl::RelationKey::Eq({from: 2, to: 1}),
    ]))
type DuplicateReadingChild = struct {
    @edsl::column("reading_id")
    reading_id: String,
    @edsl::column("second_reading_id")
    second_reading_id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

pub def conjunctive_identity_constraints_preserve_both_equalities: test::Test = test::should_ok(fn() {
    let model = edsl::build_root("conjunctive-identity-match", [Tenant.type, Reading.type, DuplicateReadingChild.type],
        payload.profile, fn(subject) { subject == "resolver" });
    let ast = query_intent_ast_factory(model, "resolver")(json::parse(r#"{
        "op":"graph", "root":"child",
        "nodes":[{"id":"child","entity":"duplicate_reading_child"},{"id":"reading","entity":"reading"}],
        "edges":[{"relation":"duplicate_child_reading","from":"child","to":"reading"}],
        "select":[{"node":"reading","dimension":"reading_id"}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast).sql;
    let pg = postgres::build_query(ast).sql;
    if string::contains(sq, "child.reading_id = reading.reading_id")
        && string::contains(sq, "child.second_reading_id = reading.reading_id")
        && string::contains(sq, "child.tenant_id = reading.tenant_id")
        && string::contains(pg, "\"child\".\"second_reading_id\" = \"reading\".\"reading_id\"") {
        True
    } else { fail!("conjunctive identity proof dropped a declared constraint", sq, pg) }
});

@edsl::entity_id("reading_hub")
@edsl::entity_source("reading_hubs", "hub")
@edsl::dataset(edsl::DatasetKind::Entity, ["id", "tenant_id"], None)
@edsl::named_relation_key("hub_children", ReadingChild.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::And([
        edsl::RelationKey::Eq({from: 0, to: 1}),
        edsl::RelationKey::Eq({from: 1, to: 1}),
        edsl::RelationKey::Eq({from: 2, to: 2}),
    ]))
type ReadingHub = struct {
    @edsl::column("id")
    @edsl::dimension("hub_id", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    id: String,
    @edsl::column("second_id")
    second_id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

@edsl::entity_id("partial_reading_hub")
@edsl::entity_source("partial_reading_hubs", "hub")
@edsl::dataset(edsl::DatasetKind::Entity, ["id", "tenant_id"], None)
@edsl::named_relation_key("partial_hub_children", ReadingChild.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::Eq({from: 0, to: 1}))
type PartialReadingHub = struct {
    @edsl::column("id")
    id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

pub def repeated_source_identity_equality_proves_child_count: test::Test = test::should_ok(fn() {
    let model = edsl::build_root("hub-child-grain", [Tenant.type, Reading.type, ReadingChild.type, ReadingHub.type],
        payload.profile, fn(subject) { subject == "resolver" });
    let ast = query_intent_ast_factory(model, "resolver")(json::parse(r#"{
        "op":"graph", "root":"hub", "include_empty":true,
        "nodes":[{"id":"hub","entity":"reading_hub"},{"id":"child","entity":"reading_child"}],
        "edges":[{"relation":"hub_children","from":"hub","to":"child"}],
        "select":[{"node":"hub","dimension":"hub_id"}], "count":"child"
    }"#).unwrap!());
    let sq = sqlite::build_query(ast).sql;
    let pg = postgres::build_query(ast).sql;
    if string::contains(sq, "LEFT JOIN reading_children AS child ON")
        && string::contains(sq, "hub.id = child.reading_id")
        && string::contains(sq, "hub.second_id = child.reading_id")
        && string::contains(sq, "hub.tenant_id = child.tenant_id")
        && string::contains(sq, "count(child.id)")
        && string::contains(pg, "\"hub\".\"second_id\" = \"child\".\"reading_id\"") {
        True
    } else { fail!("reverse FanOut identity proof lost a declared conjunct", sq, pg) }
});

pub def partial_source_identity_cannot_prove_child_count: test::Test = test::should_fail_with(fn() {
    let model = edsl::build_root("partial-hub-child-grain",
        [Tenant.type, Reading.type, ReadingChild.type, PartialReadingHub.type],
        payload.profile, fn(subject) { subject == "resolver" });
    query_intent_ast_factory(model, "resolver")(json::parse(r#"{
        "op":"graph", "root":"hub",
        "nodes":[{"id":"hub","entity":"partial_reading_hub"},{"id":"child","entity":"reading_child"}],
        "edges":[{"relation":"partial_hub_children","from":"hub","to":"child"}],
        "select":[], "count":"child"
    }"#).unwrap!())
}, "relation partial_hub_children between hub and child may multiply child; if this edge only filters rows, use correlated EXISTS");

pub def composite_target_full_identity_is_lowerable: test::Test = test::should_ok(fn() {
    let model = edsl::build_root("composite-join", [Tenant.type, Reading.type, ReadingChild.type],
        payload.profile, fn(subject) { subject == "resolver" });
    let ast = query_intent_ast_factory(model, "resolver")(json::parse(r#"{
        "op":"graph", "root":"child",
        "nodes":[{"id":"child","entity":"reading_child"},{"id":"reading","entity":"reading"}],
        "edges":[{"relation":"child_reading","from":"child","to":"reading"}],
        "select":[{"node":"child","dimension":"child_id"}], "count":"child"
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "child.reading_id = reading.reading_id")
        && string::contains(sq.sql, "child.tenant_id = reading.tenant_id")
        && string::contains(pg.sql, "\"child\".\"tenant_id\" = \"reading\".\"tenant_id\"") {
        True
    } else { fail!("composite target identity was truncated", sq, pg) }
});

@edsl::entity_id("nullable_reading")
@edsl::entity_source("nullable_readings", "nullable_reading")
@edsl::dataset(edsl::DatasetKind::Entity, ["reading_id"], None)
type NullableReading = struct {
    @edsl::column("reading_id")
    reading_id: Option(String),
};

pub def nullable_dataset_grain_does_not_prove_count_identity: test::Test = test::should_fail_with(fn() {
