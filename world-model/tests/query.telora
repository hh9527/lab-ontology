def test_related_set_combine_intersect_exact = do {
    let q = run_text(rs_combine_intersect_json);
    let ok_exact = q.sql == `SELECT c.Name FROM country AS c WHERE c.Continent = ? AND EXISTS (SELECT 1 FROM countrylanguage AS cl WHERE c.Code = cl.CountryCode AND cl.IsOfficial = ?) INTERSECT SELECT c.Name FROM country AS c WHERE c.Region = ? AND EXISTS (SELECT 1 FROM countrylanguage AS cl WHERE c.Code = cl.CountryCode AND cl.IsOfficial = ?)`;
    let ok_binds = binding_count(q) == 4;
    let b0 = match q.bindings[0] { 'String(s) => s == "Asia", _ => 'False };
    let b1 = match q.bindings[1] { 'String(s) => s == "T", _ => 'False };
    let b2 = match q.bindings[2] { 'String(s) => s == "X", _ => 'False };
    let b3 = match q.bindings[3] { 'String(s) => s == "F", _ => 'False };
    let no_helper = !contains_literal(q.sql, "count(");
    if ok_exact && ok_binds && b0 && b1 && b2 && b3 && no_helper { 'True } else { fail!("related_set_combine intersect sql/bindings differ") }
};

