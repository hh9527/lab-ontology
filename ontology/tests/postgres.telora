use std::string as string;
use std::test as test;
use crate::query as qb;
use crate::postgres as pg;

pub def nested_json_bind_order: test::Test = test::should_ok(fn() {
    let path = qb::json_path([qb::JsonPathSegment::Key("a.b"), qb::JsonPathSegment::FromEnd(1)]);
    let predicate = qb::scalar(qb::ScalarFunction::Eq, [
        qb::json_extract(qb::column("MixedAlias", "PayloadJSON"), path, qb::JsonScalarKind::Int),
        qb::bind_int(20),
    ]);
    let query = pg::render_expr(predicate, 4);
    if query.sql == `(json_extract_path_text("MixedAlias"."PayloadJSON"::json, VARIADIC ARRAY[$4::text, $5::text]))::bigint = $6`
        && query.bindings == [qb::Val::String("a.b"), qb::Val::String("-1"), qb::Val::Int(20)] {
        True
    } else { fail!("PostgreSQL JSON expression must number path and filter bindings in SQL order", query) }
});

pub def root_path_has_no_binding: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::json_type(qb::bind_string("42"), qb::json_path([])), 1);
    if query.bindings == [qb::Val::String("42")]
        && string::contains(query.sql, "VARIADIC ARRAY[]::text[]")
        && string::contains(query.sql, "json_typeof(") {
        True
    } else { fail!("root path must not add phantom placeholders", query) }
});

pub def repeated_operand_uses_one_binding: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::json_valid(qb::bind_string("{\"x\":1}")), 1);
    if query.bindings == [qb::Val::String("{\"x\":1}")]
        && string::contains(query.sql, "$1 IS NULL")
        && string::contains(query.sql, "pg_input_is_valid($1::text, 'json')") {
        True
    } else { fail!("a repeated PG placeholder must not duplicate the binding", query) }
});

pub def ascii_only_case_fold: test::Test = test::should_ok(fn() {
    let query = pg::render_expr(qb::lower(qb::bind_string("ABCÉ")), 2);
    if query.sql == "translate($2, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')"
        && query.bindings == [qb::Val::String("ABCÉ")] {
        True
    } else { fail!("PG lower must preserve SQLite ASCII-only semantics", query) }
});

pub def invalid_column_identifier: test::Test = test::should_fail_with(fn() {
    pg::render_expr(qb::column("e", "invalid\"name"), 1)
}, "invalid PostgreSQL column identifier");

pub def invalid_placeholder_start: test::Test = test::should_fail_with(fn() {
    pg::render_expr(qb::bind_int(3), 0)
}, "PostgreSQL placeholder index must be positive");

pub def internal_alias_skips_reserved_names: test::Test = test::should_ok(fn() {
    let first = pg::internal_alias(pg::context(1, ["__q_0", "__q_2"]));
    let second = pg::internal_alias(first.1);
    if first.0 == "__q_1" && second.0 == "__q_3" { True }
    else { fail!("immutable context must allocate collision-free internal aliases") }
});

pub def rows_assign_resources_in_sql_order: test::Test = test::should_ok(fn() {
    let base: qb::Plan = {
        revision: "pg-rows",
        sources: [qb::scoped_source("Mixed", "Orders", qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("Mixed", "Role"), qb::bind_string("root")]))],
        projection: [qb::expr_item(qb::bind_string("project")), qb::expr_item(qb::column("Mixed", "Id"))],
        joins: [qb::join_on(qb::JoinKind::Left,
            qb::scoped_source("Child", "Customers", qb::scalar(qb::ScalarFunction::Eq,
                [qb::column("Child", "Role"), qb::bind_string("joined")])),
            qb::on_and([
                qb::on_eq(qb::column_ref("Mixed", "Id"), qb::column_ref("Child", "OwnerId")),
                qb::on_predicate(qb::scalar(qb::ScalarFunction::Eq,
                    [qb::column("Child", "Level"), qb::bind_int(7)])),
            ]))],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("Mixed", "Role"), qb::bind_string("root")])),
        grouping: [], having: [],
        ordering: [qb::asc(qb::column("Mixed", "Id"))],
        limit: None, offset: Some(2),
        exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(base, False);
    if query.bindings == [qb::Val::String("project"), qb::Val::String("root"),
        qb::Val::String("joined"), qb::Val::Int(7), qb::Val::String("root"), qb::Val::Int(2)]
        && string::contains(query.sql, "SELECT $1, \"Mixed\".\"Id\" FROM (SELECT * FROM \"Orders\" AS \"Mixed\" WHERE \"Mixed\".\"Role\" = $2) AS \"Mixed\"")
        && string::contains(query.sql, "LEFT JOIN (SELECT * FROM \"Customers\" AS \"Child\" WHERE \"Child\".\"Role\" = $3) AS \"Child\" ON (\"Mixed\".\"Id\" = \"Child\".\"OwnerId\" AND \"Child\".\"Level\" = $4)")
        && string::contains(query.sql, "WHERE \"Mixed\".\"Role\" = $5 ORDER BY \"Mixed\".\"Id\" ASC NULLS FIRST OFFSET $6")
        && !string::contains(query.sql, "LIMIT -1") { True }
    else { fail!("Rows materialization must thread the context in SQL order", query) }
});

pub def grouped_rows_reexpand_measure_with_fresh_bindings: test::Test = test::should_ok(fn() {
    let local = qb::scalar(qb::ScalarFunction::Eq,
        [qb::column("e", "kind"), qb::bind_string("active")]);
    let plan: qb::Plan = {
        revision: "pg-grouped",
        sources: [qb::source("e", "Events")], joins: [],
        projection: [qb::expr_item(qb::column("e", "category")),
            qb::aggregate_filtered(qb::AggregateFunction::Count, qb::column("e", "id"),
                False, Some(local), "hits")],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("e", "category"), qb::bind_string("A")])),
        grouping: [qb::column("e", "category")],
        having: [qb::having(qb::HavingOp::Gt, "hits", qb::Val::Int(1))],
        ordering: [qb::desc_aggregate("hits")], limit: Some(5), offset: None,
        exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::String("active"), qb::Val::String("A"),
        qb::Val::String("active"), qb::Val::Int(1), qb::Val::String("active"), qb::Val::Int(5)]
        && string::contains(query.sql, "count(\"e\".\"id\") FILTER (WHERE \"e\".\"kind\" = $1) AS \"hits\"")
        && string::contains(query.sql, "HAVING count(\"e\".\"id\") FILTER (WHERE \"e\".\"kind\" = $3) > $4")
        && string::contains(query.sql, "ORDER BY count(\"e\".\"id\") FILTER (WHERE \"e\".\"kind\" = $5) DESC NULLS LAST LIMIT $6") {
        True
    } else { fail!("measure expansion must allocate fresh bindings in each SQL position", query) }
});

pub def derived_union_threads_context_across_branches: test::Test = test::should_ok(fn() {
    let branch_a = qb::union_branch(qb::scoped_source("a", "ItemsA",
        qb::scalar(qb::ScalarFunction::Eq, [qb::column("a", "role"), qb::bind_string("scope-a")])),
        [qb::union_column("id", qb::column("a", "id")),
            qb::union_column("tag", qb::bind_string("tag-a"))], None);
    let branch_b = qb::union_branch(qb::source("b", "ItemsB"),
        [qb::union_column("id", qb::column("b", "id")),
            qb::union_column("tag", qb::bind_string("tag-b"))],
        Some(qb::scalar(qb::ScalarFunction::Gt,
            [qb::column("b", "id"), qb::bind_int(10)])));
    let plan: qb::Plan = {
        revision: "pg-union-source", sources: [],
        derived: Some(qb::derived_source("u", [branch_a, branch_b])),
        projection: [qb::expr_item(qb::bind_string("outer")), qb::expr_item(qb::column("u", "id"))],
        joins: [], filter: Some(qb::scalar(qb::ScalarFunction::Gt,
            [qb::column("u", "id"), qb::bind_int(1)])),
        grouping: [], having: [], ordering: [qb::asc(qb::column("u", "id"))],
        limit: None, offset: None, exists: [], partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_rows_candidate(plan, False);
    if query.bindings == [qb::Val::String("outer"), qb::Val::String("tag-a"),
        qb::Val::String("scope-a"), qb::Val::String("tag-b"), qb::Val::Int(10), qb::Val::Int(1)]
        && string::contains(query.sql, "SELECT \"a\".\"id\" AS \"id\", $2 AS \"tag\" FROM (SELECT * FROM \"ItemsA\" AS \"a\" WHERE \"a\".\"role\" = $3) AS \"a\"")
        && string::contains(query.sql, "UNION ALL SELECT \"b\".\"id\" AS \"id\", $4 AS \"tag\" FROM \"ItemsB\" AS \"b\" WHERE \"b\".\"id\" > $5")
        && string::contains(query.sql, ") AS \"u\" WHERE \"u\".\"id\" > $6") {
        True
    } else { fail!("UNION ALL branches must share the immutable resource context", query) }
});

pub def group_count_allocates_wrapper_alias: test::Test = test::should_ok(fn() {
    let plan: qb::Plan = {
        revision: "pg-group-count", sources: [qb::source("__q_0", "Events")],
        projection: [qb::expr_item(qb::column("__q_0", "category")),
            qb::aggregate(qb::AggregateFunction::Count, qb::column("__q_0", "id"), False, "hits")],
        joins: [], filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("__q_0", "category"), qb::bind_string("A")])),
        grouping: [qb::column("__q_0", "category")], having: [], ordering: [],
        limit: None, offset: None, exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    };
    let query = pg::render_group_count_candidate(plan);
    if query.bindings == [qb::Val::String("A")]
        && string::contains(query.sql, "FROM \"Events\" AS \"__q_0\" WHERE \"__q_0\".\"category\" = $1")
        && string::contains(query.sql, ") AS \"__q_1\"") {
        True
    } else { fail!("wrapper alias must avoid source aliases using the same context", query) }
});

def set_operand: Fn(String) -> qb::Plan = fn(status) {
    {
        revision: "pg-set", sources: [qb::source("__q_0", "Events")],
        projection: [qb::expr_item(qb::column("__q_0", "id"))],
        filter: Some(qb::scalar(qb::ScalarFunction::Eq,
            [qb::column("__q_0", "status"), qb::bind_string(status)])),
        joins: [], grouping: [], having: [], ordering: [],
        limit: None, offset: None, exists: [], derived: None, partition: None,
        scalar_comparisons: [], ranked_key_comparisons: [],
    }
};

pub def set_branches_share_binding_and_alias_context: test::Test = test::should_ok(fn() {
    let set: qb::SetPlan = {kind: qb::SetOpKind::Intersect,
        left: set_operand("left"), right: set_operand("right")};
    let rows = pg::render_set_candidate(set, False);
    let count = pg::render_set_candidate(set, True);
    if rows.bindings == [qb::Val::String("left"), qb::Val::String("right")]
        && string::contains(rows.sql, "WHERE \"__q_0\".\"status\" = $1 INTERSECT SELECT")
        && string::contains(rows.sql, "WHERE \"__q_0\".\"status\" = $2")
        && count.bindings == rows.bindings
        && string::contains(count.sql, ") AS \"__q_1\"") {
        True
    } else { fail!("set branches and outer count must share one immutable context", rows, count) }
});
