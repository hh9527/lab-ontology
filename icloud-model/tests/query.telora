pub def q0043_sample_top_five_keeps_raw_kpi_grain: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"utc_window","measures":[],"dimensions":["port_count_sample","device_name","device_kpi_ts_raw"],"filters":[{"dimension":"device_alias","op":"eq","kind":"text","value":"public"},{"dimension":"device_mac","op":"eq","kind":"text","value":"00:1A:2B:00:00:00"},{"dimension":"device_class","op":"eq","kind":"text","value":"WAC"}],"ordering":[{"target":"Dimension","id":"port_count_sample","direction":"Desc"},{"target":"Dimension","id":"device_kpi_ts_raw","direction":"Desc"},{"target":"Dimension","id":"device_kpi_res_id","direction":"Asc"},{"target":"Dimension","id":"device_kpi_tenant_id","direction":"Asc"}],"window":{"dataset":"device_kpi","start":"2024-01-01T00:00:00Z","end":"2024-01-31T00:00:00Z"},"limit":5,"offset":null}`);
    if array::length(string::split(q.sql, "SELECT k.portCount, d.name, k.ts FROM NetworkDeviceKPI AS k")) > 1
        && array::length(string::split(q.sql, "k.resId = d.id")) > 1
        && array::length(string::split(q.sql, "k.tenantId = d.tenant_id")) > 1
        && array::length(string::split(q.sql, "ORDER BY k.portCount DESC, k.ts DESC, k.resId ASC, k.tenantId ASC")) > 1
        && array::length(string::split(q.sql, "GROUP BY")) == 1
        && array::length(string::split(q.sql, "sum(")) == 1
        && q.bindings == [qb::Val::String("public"), qb::Val::String("00:1A:2B:00:00:00"), qb::Val::String("ne.category.ac"), qb::Val::String("AC"), qb::Val::String("WAC"), qb::Val::String("2024-01-01T00:00:00Z"), qb::Val::String("2024-01-31T00:00:00Z"), qb::Val::Int(5)] {
        True
    } else { fail!("sample Top-N must not aggregate or cross tenant", q.sql, q.bindings) }
});

