type Pair = struct { id: String, request: Value, typed: qb::Query, baseline: qb::Query, postgres: qb::Query, columns: Array(intent::ResultColumn), baseline_columns: Array(intent::ResultColumn) };
def pair: Fn(String, Value) -> Pair = fn(id, request) {
    let actual = intent::query_intent_ast_factory(payload)(request);
    let expected = intent::query_intent_ast_factory(baseline::payload)(request);
    {id, request, typed: sqlite::build_query(actual), baseline: sqlite::build_query(expected), postgres: postgres::build_query(actual),
        columns: intent::result_columns(payload, request, actual), baseline_columns: intent::result_columns(baseline::payload, request, expected)}
};
