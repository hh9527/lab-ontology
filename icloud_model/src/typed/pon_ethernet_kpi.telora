                )
            ),
            "source_PonDeviceEthernetPortKPI__ifOutBandRateEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
type PonDeviceEthernetPortKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_PonDeviceEthernetPortKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_PonDeviceEthernetPortKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_PonDeviceEthernetPortKPI__parentId")
    source_parentId: pon::PonId,
    @m::column("projectId")
    @g::exact("source_PonDeviceEthernetPortKPI__projectId")
    source_projectId: String,
    @m::column("portName")
    @g::search("source_PonDeviceEthernetPortKPI__portName")
    source_portName: String,
    @m::column("hwOpticsRxPower")
    source_hwOpticsRxPower: ReportedHwOpticsRxPower,
    @m::column("hwOpticsTxPower")
    source_hwOpticsTxPower: ReportedHwOpticsTxPower,
    @m::column("ifHCInOctets")
    source_ifHCInOctets: ReportedIfHCInOctets,
    @m::column("ifHCOutOctets")
    source_ifHCOutOctets: ReportedIfHCOutOctets,
    @m::column("ifInBandRate")
    source_ifInBandRate: ReportedIfInBandRate,
    @m::column("ifOutBandRate")
    source_ifOutBandRate: ReportedIfOutBandRate,
    @m::column("hwOpticsRxPowerEffcnt")
    source_hwOpticsRxPowerEffcnt: EffectiveCount,
    @m::column("hwOpticsTxPowerEffcnt")
    source_hwOpticsTxPowerEffcnt: EffectiveCount,
    @m::column("ifHCInOctetsEffcnt")
    source_ifHCInOctetsEffcnt: EffectiveCount,
    @m::column("ifHCOutOctetsEffcnt")
    source_ifHCOutOctetsEffcnt: EffectiveCount,
    @m::column("ifInBandRateEffcnt")
    source_ifInBandRateEffcnt: EffectiveCount,
    @m::column("ifOutBandRateEffcnt")
    source_ifOutBandRateEffcnt: EffectiveCount,
};
def dataset: m::Dataset(PonDeviceEthernetPortKPI) = registry::dataset_of(
    PonDeviceEthernetPortKPI.type
);
def owner: m::Role(PonDeviceEthernetPortKPI) = m::role(
    dataset,
    pon::entity,
    "owner",
    False,
    [
        m::identity_part(
            m::field(PonDeviceEthernetPortKPI.type, pon::PonId.type, "source_parentId"),
            m::field(pon::Identity.type, pon::PonId.type, "id")
        )
    ]
);

def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElementAssociationPonDeviceEthernetPortKPI",
        r::endpoint(pon::dataset.row, pon::subject.id),
        r::endpoint(dataset.row, owner.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{PonDeviceEthernetPortKPI};
