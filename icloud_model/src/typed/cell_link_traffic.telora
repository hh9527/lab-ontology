use ontology::registry as registry;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
type ResourceId = struct(
    String
);
use ontology::quantity::{EffectiveCount};
# upwardTraffic 的单位／尺度没有在旧公开契约中确认。
type ReportedUpwardTraffic = struct(
    Float
);
# downwardTraffic 的单位／尺度没有在旧公开契约中确认。
type ReportedDownwardTraffic = struct(
    Float
);
# utilization 的单位／尺度没有在旧公开契约中确认。
type ReportedUtilization = struct(
    Float
);
@registry::dataset(
    "source_NetworkCellLinkTrafficKPI",
    "NetworkCellLinkTrafficKPI",
    ["source_resId"]
)
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkTrafficKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkCellLinkTrafficKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_NetworkCellLinkTrafficKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkCellLinkTrafficKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_NetworkCellLinkTrafficKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkCellLinkTrafficKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_NetworkCellLinkTrafficKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkCellLinkTrafficKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_NetworkCellLinkTrafficKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkTrafficKPI__upwardTraffic",
                ReportedUpwardTraffic.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkCellLinkTrafficKPI.type,
                    ReportedUpwardTraffic.type,
                    "source_upwardTraffic"
                )
            ),
            "source_NetworkCellLinkTrafficKPI__upwardTraffic",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkTrafficKPI__downwardTraffic",
                ReportedDownwardTraffic.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkCellLinkTrafficKPI.type,
                    ReportedDownwardTraffic.type,
                    "source_downwardTraffic"
                )
            ),
            "source_NetworkCellLinkTrafficKPI__downwardTraffic",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkTrafficKPI__utilization",
                ReportedUtilization.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkCellLinkTrafficKPI.type,
                    ReportedUtilization.type,
                    "source_utilization"
                )
            ),
            "source_NetworkCellLinkTrafficKPI__utilization",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkTrafficKPI__upwardTrafficEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkCellLinkTrafficKPI.type,
                    EffectiveCount.type,
                    "source_upwardTrafficEffcnt"
                )
            ),
            "source_NetworkCellLinkTrafficKPI__upwardTrafficEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkTrafficKPI__downwardTrafficEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkCellLinkTrafficKPI.type,
                    EffectiveCount.type,
                    "source_downwardTrafficEffcnt"
                )
            ),
            "source_NetworkCellLinkTrafficKPI__downwardTrafficEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkCellLinkTrafficKPI__utilizationEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkCellLinkTrafficKPI.type,
                    EffectiveCount.type,
                    "source_utilizationEffcnt"
                )
            ),
            "source_NetworkCellLinkTrafficKPI__utilizationEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
type NetworkCellLinkTrafficKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkCellLinkTrafficKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkCellLinkTrafficKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("projectId")
    @g::exact("source_NetworkCellLinkTrafficKPI__projectId")
    source_projectId: String,
    @m::column("srcSiteId")
    @g::exact("source_NetworkCellLinkTrafficKPI__srcSiteId")
    source_srcSiteId: String,
    @m::column("destSiteId")
    @g::exact("source_NetworkCellLinkTrafficKPI__destSiteId")
    source_destSiteId: String,
    @m::column("sourceWanlinkId")
    @g::exact("source_NetworkCellLinkTrafficKPI__sourceWanlinkId")
    source_sourceWanlinkId: String,
    @m::column("destWanlinkId")
    @g::exact("source_NetworkCellLinkTrafficKPI__destWanlinkId")
    source_destWanlinkId: String,
    @m::column("upwardTraffic")
    source_upwardTraffic: ReportedUpwardTraffic,
    @m::column("downwardTraffic")
    source_downwardTraffic: ReportedDownwardTraffic,
    @m::column("utilization")
    source_utilization: ReportedUtilization,
    @m::column("upwardTrafficEffcnt")
    source_upwardTrafficEffcnt: EffectiveCount,
    @m::column("downwardTrafficEffcnt")
    source_downwardTrafficEffcnt: EffectiveCount,
    @m::column("utilizationEffcnt")
    source_utilizationEffcnt: EffectiveCount,
};
def dataset: m::Dataset(NetworkCellLinkTrafficKPI) = registry::dataset_of(
    NetworkCellLinkTrafficKPI.type
);

pub use self::{NetworkCellLinkTrafficKPI};
