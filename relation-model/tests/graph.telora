pub def role_distinct_join: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"link",
        "nodes":[{"id":"link","entity":"connection"},{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"connection_a","from":"link","to":"a"},{"relation":"connection_z","from":"link","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "a_device_id") && string::contains(sq.sql, "z_device_id")
        && string::contains(sq.sql, " AS a") && string::contains(sq.sql, " AS z")
        && string::contains(pg.sql, " AS \"a\"") && string::contains(pg.sql, " AS \"z\"")
        && string::contains(sq.sql, "tenant_id") && string::contains(pg.sql, "tenant_id") {
        True
    } else { fail!("graph did not retain both endpoint identities", sq.sql, pg.sql) }
});

pub def two_hop: test::Test = test::should_ok(fn() {
