        "group_by_identity":["frame","device"],
        "measure_having":[{"node":"sample","measure":"cpu_usage","op":"gt","kind":"number","value":80.0}],
        "top_by_measure":{"node":"sample","measure":"cpu_usage","direction":"desc","take":5}}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "GROUP BY frame.name, device.name, frame.id, frame.tenantId, device.id, device.tenant_id")
        && string::contains(sq.sql, "HAVING avg(sample.cpuUsage) >")
        && string::contains(sq.sql, "ORDER BY avg(sample.cpuUsage) DESC, frame.id ASC, frame.tenantId ASC, device.id ASC, device.tenant_id ASC")
        && string::contains(pg.sql, "HAVING avg(\"sample\".\"cpuUsage\") >")
        && sq.bindings == pg.bindings { True }
    else { fail!("contextual KPI threshold lost complete identities or dialect bindings", sq, pg) }
});

pub def frame_context_device_kpi_keeps_safe_tenant_ancestor: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"frame",
        "nodes":[{"id":"frame","entity":"frame"},{"id":"device","entity":"device"},
                 {"id":"sample","entity":"device_kpi"},{"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"frame_belongs_to_device","from":"frame","to":"device"},
                 {"relation":"device_kpi_of_device","from":"sample","to":"device"},
                 {"relation":"device_belongs_to_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"frame","dimension":"frame_name"},
                  {"node":"tenant","dimension":"tenant_name"}],
        "measures":[{"node":"sample","measure":"port_count"}],
        "group_by_identity":["frame","device"],
        "measure_having":[{"node":"sample","measure":"port_count","op":"gt","kind":"int","value":10}],
        "top_by_measure":{"node":"sample","measure":"port_count","direction":"desc","take":5}}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "device.tenant_id = tenant.TENANT_ID")
        && string::contains(sq.sql, "sum(sample.portCount)")
        && string::contains(sq.sql, "GROUP BY frame.name, tenant.TENANT_NAME, frame.id, frame.tenantId, device.id, device.tenant_id")
        && string::contains(sq.sql, "HAVING sum(sample.portCount) >")
        && string::contains(pg.sql, "sum(\"sample\".\"portCount\")")
        && sq.bindings == pg.bindings { True }
    else { fail!(`Safe owner ancestor changed contextual KPI grain: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

pub def frame_context_preserves_computed_alarm_severity_with_tenant: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"frame",
        "nodes":[{"id":"frame","entity":"frame"},{"id":"device","entity":"device"},
                 {"id":"alarm","entity":"current_alarm"},{"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"frame_belongs_to_device","from":"frame","to":"device"},
                 {"relation":"device_current_alarm","from":"alarm","to":"device"},
                 {"relation":"device_belongs_to_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"frame","dimension":"frame_name"},
                  {"node":"tenant","dimension":"tenant_name"}],
        "measures":[{"node":"alarm","measure":"weighted_severe_alarm_score"}],
        "group_by_identity":["frame","device"],
        "measure_having":[{"node":"alarm","measure":"weighted_severe_alarm_score","op":"gt","kind":"int","value":2}],
        "top_by_measure":{"node":"alarm","measure":"weighted_severe_alarm_score","direction":"desc","take":5}}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "AS alarm_weighted_severe_alarm_score")
        && !string::contains(sq.sql, "AS alarm_critical_alarm_count")
        && string::contains(sq.sql, "FILTER (WHERE alarm.SEVERITY =")
        && string::contains(sq.sql, "GROUP BY frame.name, tenant.TENANT_NAME, frame.id, frame.tenantId, device.id, device.tenant_id")
        && string::contains(sq.sql, "HAVING")
        && string::contains(pg.sql, "FILTER (WHERE")
        && sq.bindings == pg.bindings { True }
    else { fail!(`contextual filtered alarm computation changed event grain: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

pub def independent_kpi_windows_cannot_share_a_joined_aggregate_population: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},
                 {"id":"week","entity":"device_kpi"},{"id":"month","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"week","to":"device"},
                 {"relation":"device_kpi_of_device","from":"month","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"week","measure":"port_count"},
                    {"node":"month","measure":"port_count"}],
        "group_by_identity":["device"],
        "filters":[{"node":"week","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"week","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-08 00:00:00"},
                   {"node":"month","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"month","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-01 00:00:00"}]}"#).unwrap!())
}, "graph measure source may be multiplied by a joined relation");

def independent_window_intent: Fn() -> std::value::Value = fn() {
    json::parse(r#"{"op":"graph_pair",
        "left":{"op":"graph","root":"device",
            "nodes":[{"id":"device","entity":"device"},{"id":"week","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"week","to":"device"}],
            "select":[{"node":"device","dimension":"device_name"}],
            "measures":[{"node":"week","measure":"port_count"}],"group_by_identity":["device"],
            "filters":[{"node":"week","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                       {"node":"week","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-08 00:00:00"}]},
        "right":{"op":"graph","root":"device",
            "nodes":[{"id":"device","entity":"device"},{"id":"month","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"month","to":"device"}],
            "select":[{"node":"device","dimension":"device_name"}],
            "measures":[{"node":"month","measure":"port_count"}],"group_by_identity":["device"],
            "filters":[{"node":"month","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-02-01 00:00:00"},
                       {"node":"month","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-03-01 00:00:00"}]}}"#).unwrap!()
};

pub def independent_kpi_windows_join_only_complete_owner_groups: test::Test = test::should_ok(fn() {
    let intent = independent_window_intent();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "sum(week.portCount) AS week_port_count")
        && string::contains(sq.sql, "sum(month.portCount) AS month_port_count")
        && string::contains(sq.sql, "__q_left.__q_key_1 = __q_right.__q_key_1")
        && string::contains(sq.sql, "__q_left.__q_key_2 = __q_right.__q_key_2")
        && !string::contains(sq.sql, "week.resId = month.resId")
        && string::contains(pg.sql, "\"week\".\"portCount\"")
        && string::contains(pg.sql, "\"month\".\"portCount\"")
        && sq.bindings == [qb::Val::String("2025-01-01 00:00:00"), qb::Val::String("2025-01-08 00:00:00"),
            qb::Val::String("2025-02-01 00:00:00"), qb::Val::String("2025-03-01 00:00:00")]
        && pg.bindings == sq.bindings { True }
    else { fail!(`independent KPI groups were multiplied or lost owner identity: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

pub def joined_groups_reject_incomplete_owner_identity: test::Test = test::should_fail_with(fn() {
    let ast = query_intent_ast_factory(payload, "public")(independent_window_intent());
    match ast.plan {
        qb::QueryPlan::JoinedGroups(joined) => {
            sqlite::build_query(qb::finish(ast.ctx, qb::QueryPlan::JoinedGroups({...joined,
                keys: [joined.keys[0], joined.keys[1]]})))
        },
        _ => fail!("expected joined grouped plans"),
    }
}, "joined groups require grouped, embeddable operands, identity keys and visible outputs");

pub def paired_kpi_thresholds_stay_inside_their_own_windows: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph_pair",
        "left":{"op":"graph","root":"device",
            "nodes":[{"id":"device","entity":"device"},{"id":"week","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"week","to":"device"}],
            "select":[{"node":"device","dimension":"device_name"}],
            "measures":[{"node":"week","measure":"port_count"}],"group_by_identity":["device"],
            "filters":[{"node":"week","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                       {"node":"week","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-08 00:00:00"}],
            "measure_having":[{"node":"week","measure":"port_count","op":"gt","kind":"int","value":4}]},
        "right":{"op":"graph","root":"device",
            "nodes":[{"id":"device","entity":"device"},{"id":"month","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"month","to":"device"}],
            "select":[{"node":"device","dimension":"device_name"}],
            "measures":[{"node":"month","measure":"port_count"}],"group_by_identity":["device"],
            "filters":[{"node":"month","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-02-01 00:00:00"},
                       {"node":"month","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-03-01 00:00:00"}],
            "measure_having":[{"node":"month","measure":"port_count","op":"gt","kind":"int","value":30}]}}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "HAVING sum(week.portCount) > ?3")
        && string::contains(sq.sql, "HAVING sum(month.portCount) > ?6")
        && string::contains(pg.sql, "HAVING sum(\"week\".\"portCount\") > $3")
        && string::contains(pg.sql, "HAVING sum(\"month\".\"portCount\") > $6")
        && sq.bindings == [qb::Val::String("2025-01-01 00:00:00"), qb::Val::String("2025-01-08 00:00:00"), qb::Val::Int(4),
            qb::Val::String("2025-02-01 00:00:00"), qb::Val::String("2025-03-01 00:00:00"), qb::Val::Int(30)]
        && pg.bindings == sq.bindings { True }
    else { fail!(`paired KPI thresholds crossed sample populations: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

