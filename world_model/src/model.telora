# world_model/src/model.telora
#
# EnterpriseKnowledge for the Spider `world_1` domain (PRIVATE mappings).
# Physical table/column names and relation paths stay in this module and are
# never published to docs/DOMAIN.md / docs/INTENT.md.
#
# Numeric attributes publish the ordinary aggregate variants that are
# meaningful for each physical field:
#   - additive numeric quantities: sum / avg / min / max;
#   - numeric rates/percentages and non-additive numeric (e.g. years,
#     life expectancy): avg / min / max (sum would misstate meaning);
#   - explicit entity row-count measures stay separate.
# Multiple ordinary aggregates can share their actual model field.

use ontology::query as qb;
use ontology::ontology as edsl;

def num_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Gt, edsl::FilterOp::Ge, edsl::FilterOp::Lt, edsl::FilterOp::Le];
def text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Contains, edsl::FilterOp::NotContains, edsl::FilterOp::StartsWith, edsl::FilterOp::EndsWith];
def text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def num_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int, edsl::FilterInputKind::Number];

# --- country ---------------------------------------------------------------
# Relations to City and CountryLanguage refer to `code` by name.
@edsl::entity_id("country")
@edsl::entity_source("country", "c")
type Country = struct {
    @edsl::column("Code")
    @edsl::key()
    @edsl::measure("country_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("country_code", True, True, text_ops, text_kinds)
    code: String,

    @edsl::column("Continent")
    @edsl::dimension("country_continent", True, True, text_ops, text_kinds)
    continent: String,

    # GNP (additive quantity): sum / avg / min / max
    @edsl::column("GNP")
    @edsl::measure("country_gnp_avg", qb::AggregateFunction::Avg, [])
    @edsl::measure("country_gnp_sum", qb::AggregateFunction::Sum, [])
    @edsl::measure("country_gnp_min", qb::AggregateFunction::Min, [])
    @edsl::measure("country_gnp_max", qb::AggregateFunction::Max, [])
    @edsl::dimension("country_gnp", True, True, num_ops, num_kinds)
    gnp: Float,

    @edsl::column("GovernmentForm")
    @edsl::measure("country_government_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("country_government", True, True, text_ops, text_kinds)
    government_form: String,

    @edsl::column("HeadOfState")
    @edsl::dimension("country_head", True, True, text_ops, text_kinds)
    head_of_state: String,

    # Independence year (non-additive point-in-time): avg / min / max
    @edsl::column("IndepYear")
    @edsl::dimension("country_indep_year", True, True, num_ops, num_kinds)
    @edsl::measure("country_indep_year_avg", qb::AggregateFunction::Avg, [])
    @edsl::measure("country_indep_year_min", qb::AggregateFunction::Min, [])
    @edsl::measure("country_indep_year_max", qb::AggregateFunction::Max, [])
    indep_year: Int,

    # Life expectancy (rate-like): avg / min / max
    @edsl::column("LifeExpectancy")
    @edsl::measure("country_life_expectancy_avg", qb::AggregateFunction::Avg, [])
    @edsl::measure("country_life_expectancy_min", qb::AggregateFunction::Min, [])
    @edsl::measure("country_life_expectancy_max", qb::AggregateFunction::Max, [])
    @edsl::dimension("country_life_expectancy", True, True, num_ops, num_kinds)
    life_expectancy: Float,

    @edsl::column("Name")
    @edsl::dimension("country_name", True, True, text_ops, text_kinds)
    name: String,

    # Population (additive quantity): sum / avg / min / max
    @edsl::column("Population")
    @edsl::measure("country_population_sum", qb::AggregateFunction::Sum, [])
    @edsl::measure("country_population_avg", qb::AggregateFunction::Avg, [])
    @edsl::measure("country_population_min", qb::AggregateFunction::Min, [])
    @edsl::measure("country_population_max", qb::AggregateFunction::Max, [])
    @edsl::dimension("country_population", True, True, num_ops, num_kinds)
    population: Int,

    @edsl::column("Region")
    @edsl::dimension("country_region", True, True, text_ops, text_kinds)
    region: String,

    # Surface area (additive quantity): sum / avg / min / max
    @edsl::column("SurfaceArea")
    @edsl::measure("country_surface_area_avg", qb::AggregateFunction::Avg, [])
    @edsl::measure("country_surface_area_sum", qb::AggregateFunction::Sum, [])
    @edsl::measure("country_surface_area_min", qb::AggregateFunction::Min, [])
    @edsl::measure("country_surface_area_max", qb::AggregateFunction::Max, [])
    @edsl::dimension("country_surface_area", True, True, num_ops, num_kinds)
    surface_area: Float,
};

# --- country language ------------------------------------------------------
# A language spoken in a country.  Declared before City so City can reference it
# in a named two-hop existence graph (City -> Country -> CountryLanguage).
# `country_code` is the declared foreign key field.
@edsl::entity_id("country_language")
@edsl::entity_source("countrylanguage", "cl")
@edsl::named_typed_relation_key("language_country", CountryLanguage.type, Country.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(CountryLanguage.type, String.type, "country_code"), edsl::model_field(Country.type, String.type, "code")),
])
type CountryLanguage = struct {
    @edsl::column("CountryCode")
    country_code: String,

    @edsl::column("IsOfficial")
    @edsl::dimension("language_official", True, True, text_ops, text_kinds)
    is_official: String,

    @edsl::column("Language")
    @edsl::measure("language_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("language_name", True, True, text_ops, text_kinds)
    language: String,

    # Percentage (rate): avg / min / max
    @edsl::column("Percentage")
    @edsl::measure("language_percentage_max", qb::AggregateFunction::Max, [])
    @edsl::measure("language_percentage_avg", qb::AggregateFunction::Avg, [])
    @edsl::measure("language_percentage_min", qb::AggregateFunction::Min, [])
    @edsl::dimension("language_percentage", True, True, num_ops, num_kinds)
    percentage: Int,
};

# --- city ------------------------------------------------------------------
# A city belonging to a country through its named `country_code` field.
# A City row may be qualified by a named two-hop existence graph through its
# Country owner (City -> Country -> CountryLanguage); no synthetic direct edge.
@edsl::entity_id("city")
@edsl::entity_source("city", "ct")
@edsl::named_typed_relation_key("city_country", City.type, Country.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(City.type, String.type, "country_code"), edsl::model_field(Country.type, String.type, "code")),
])
type City = struct {
    @edsl::column("CountryCode")
    country_code: String,

    @edsl::column("District")
    @edsl::dimension("city_district", True, True, text_ops, text_kinds)
    district: String,

    @edsl::column("ID")
    @edsl::key()
    @edsl::measure("city_count", qb::AggregateFunction::Count, [])
    id: Int,

    @edsl::column("Name")
    @edsl::dimension("city_name", True, True, text_ops, text_kinds)
    name: String,

    # Population (additive quantity): sum / avg / min / max
    @edsl::column("Population")
    @edsl::measure("city_population_sum", qb::AggregateFunction::Sum, [])
    @edsl::measure("city_population_avg", qb::AggregateFunction::Avg, [])
    @edsl::measure("city_population_min", qb::AggregateFunction::Min, [])
    @edsl::measure("city_population_max", qb::AggregateFunction::Max, [])
    @edsl::dimension("city_population", True, True, num_ops, num_kinds)
    population: Int,
};

# ---------------------------------------------------------------------------
# Profile / payload.
# ---------------------------------------------------------------------------

def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
        qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order,
        qb::Operator::Limit, qb::Operator::Offset,
    ],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Sum, qb::AggregateFunction::Avg, qb::AggregateFunction::Min, qb::AggregateFunction::Max],
    allowed_scalars: [
        qb::ScalarFunction::Substr, qb::ScalarFunction::Instr, qb::ScalarFunction::If, qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Lower, qb::ScalarFunction::Length,
        qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not,
    ],
    allow_distinct: True,
};

def authorize: Fn(String) -> Bool = fn(subject) {
    subject == "public"
};

def entity_types: Array(Type) = [
    Country.type,
    City.type,
    CountryLanguage.type,
];

def payload: edsl::PreparedPayload = edsl::build_root(
    "world-v1",
    entity_types,
    profile,
    authorize,
);

pub use self::{
    Country,
    City,
    CountryLanguage,
    profile,
    authorize,
    payload,
};
