import "std/test" as test;
import "std/array" as array;
import "std/type-property" as property;
import "@src/query" as qb;
import "@src/ontology" as edsl;
import "@test/cyclic_relations_model" { Order, Package, Unrelated };

def check: Fn(Bool, String) -> Bool = fn(ok, message) {
    if ok { True } else { fail!("cyclic relation contract", message) }
};

def at: for(T) Fn(Array(T), Int) -> T = fn(items, index) {
    match array.get(items, index) {
        Some(value) => value,
        None => fail!("missing test item", index),
    }
};

def profile: qb.PlanProfile = {
    allowed_operators: [],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [],
    allow_distinct: False,
};

def index_of: Fn(edsl.PreparedPayload, Type) -> Int = fn(root, ty) {
    at(array.filter(root.entities, fn(entity) { entity.entity_type == ty }), 0).index
};

def verify: Fn(Array(Type)) -> Bool = fn(types) {
    let root = edsl.build_root("cyclic-relations-v1", types, profile, fn(subject) { True });
    let order = index_of(root, Order.type);
    let package = index_of(root, Package.type);
    let unrelated = index_of(root, Unrelated.type);
    check(array.length(root.relations) == 2, "both declared edges survive prepare")
        && check(array.any(root.relations, fn(edge) {
            edge.from == package && edge.to == order && edge.kind == edsl.RelationKind.Safe
        }), "Package -> Order is Safe")
        && check(array.any(root.relations, fn(edge) {
            edge.from == order && edge.to == package && edge.kind == edsl.RelationKind.FanOut
        }), "Order -> Package is FanOut")
        && check(match at(at(root.paths, package), order) {
            edsl.PathResult.Safe(edges) => array.length(edges) == 1,
            _ => False,
        }, "safe direction remains safe")
        && check(match at(at(root.paths, order), package) {
            edsl.PathResult.FanOut(edges) => array.length(edges) == 1,
            _ => False,
        }, "reverse direction is fan-out-only despite the cycle")
        && check(match at(at(root.paths, order), unrelated) {
            edsl.PathResult.Missing => True,
            _ => False,
        }, "disconnected entity remains missing")
};

export def imported_property_identity: test.Test = test.should_ok(fn() {
    let forward = match property.get_type_prop(Order.type, edsl.RelationDef.type) {
        Some(value) => at(value.relations, 0).target == Package.type,
        None => False,
    };
    let backward = match property.get_type_prop(Package.type, edsl.RelationDef.type) {
        Some(value) => at(value.relations, 0).target == Order.type,
        None => False,
    };
    check(forward && backward, "imported property targets retain nominal Type identity")
});

export def reciprocal_paths: test.Test = test.should_ok(fn() {
    verify([Order.type, Package.type, Unrelated.type])
});

export def reordered_entities: test.Test = test.should_ok(fn() {
    verify([Unrelated.type, Package.type, Order.type])
});
