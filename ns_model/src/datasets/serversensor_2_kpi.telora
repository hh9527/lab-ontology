use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::kpi_server_sensor;
@domain::subject("KpiServerSensor", "obj_id")
@domain::dataset("serversensor-2-kpi", "serversensor2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type Serversensor2Kpi = struct {
    @m::column("OBJ_SYS_ID")
    @g::field_view(g::dimension_group("serversensor-2-kpi/obj_sys_id", String.type, True, [g::Filter::Eq]), "serversensor_2_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: String,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("serversensor-2-kpi/obj_id", domain::Reference(ids::KpiServerSensorByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "serversensor_2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::KpiServerSensorByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("serversensor_2__ss", domain::endpoint(Serversensor2Kpi.type, "obj_id"), domain::endpoint(kpi_server_sensor::KpiServerSensor.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
