# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_device as pon;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::transform as t;
use ontology::query as qb;
type EffectiveCount = struct(Int);
# TODO(#47)：CPU 百分比单位沿用已授权假定，尚未确认来源元数据。
type AssumedCpuPercent = struct(Float);
def cpu_statistics: samples::Group(AssumedCpuPercent) = samples::group("assumed_pon_cpu", AssumedCpuPercent.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%"));
# memUsage 的单位／尺度没有在旧公开契约中确认。
type ReportedMemUsage = struct(Float);
# neContrlableRate 的单位／尺度没有在旧公开契约中确认。
type ReportedNeContrlableRate = struct(Float);
# nePingRespTime 的单位／尺度没有在旧公开契约中确认。
type ReportedNePingRespTime = struct(Float);
type Row = struct {
    source_ts: s::DateTimeUtc,
    source_resId: pon::PonId,
    source_tenantId: i::TenantId,
    source_parentId: String,
    source_projectId: String,
    source_cpuUsage: AssumedCpuPercent,
    source_memUsage: ReportedMemUsage,
    source_onlineRate: p::Percent,
    source_neContrlableRate: ReportedNeContrlableRate,
    source_nePingRespTime: ReportedNePingRespTime,
    source_cpuUsageEffcnt: EffectiveCount,
    source_memUsageEffcnt: EffectiveCount,
    source_onlineRateEffcnt: EffectiveCount,
    source_neContrlableRateEffcnt: EffectiveCount,
    source_nePingRespTimeEffcnt: EffectiveCount,
};
def dataset: m::Dataset(Row) = m::dataset("source_PonDeviceKPI", "PonDeviceKPI", Row.type, ["source_resId", "source_tenantId", "source_ts"]);
def owner: m::Role(Row) = m::role(dataset, pon::entity, "owner", False, [m::identity_part(m::field(Row.type, pon::PonId.type, "source_resId"), m::field(pon::Identity.type, pon::PonId.type, "id"))]);
def raw: t::Declaration = t::map_columns(t::declare(dataset, [owner], [
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__ts", s::DateTimeUtc.type, True, g::numeric_filters), g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), "source_PonDeviceKPI__ts", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Hour), "source_PonDeviceKPI_utc_hour", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Day), "source_PonDeviceKPI_utc_day", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Month), "source_PonDeviceKPI_utc_month", True, g::time_filters),
    i::exact(dataset, m::field(Row.type, pon::PonId.type, "source_resId"), "source_PonDeviceKPI__resId"),
    i::exact(dataset, m::field(Row.type, i::TenantId.type, "source_tenantId"), "source_PonDeviceKPI__tenantId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_parentId"), "source_PonDeviceKPI__parentId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "source_PonDeviceKPI__projectId"),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__cpuUsage", AssumedCpuPercent.type, True, g::numeric_filters), g::input(m::field(Row.type, AssumedCpuPercent.type, "source_cpuUsage")), "source_PonDeviceKPI__cpuUsage", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__memUsage", ReportedMemUsage.type, True, g::numeric_filters), g::input(m::field(Row.type, ReportedMemUsage.type, "source_memUsage")), "source_PonDeviceKPI__memUsage", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__onlineRate", p::Percent.type, True, g::numeric_filters), g::input(m::field(Row.type, p::Percent.type, "source_onlineRate")), "source_PonDeviceKPI__onlineRate", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__neContrlableRate", ReportedNeContrlableRate.type, True, g::numeric_filters), g::input(m::field(Row.type, ReportedNeContrlableRate.type, "source_neContrlableRate")), "source_PonDeviceKPI__neContrlableRate", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__nePingRespTime", ReportedNePingRespTime.type, True, g::numeric_filters), g::input(m::field(Row.type, ReportedNePingRespTime.type, "source_nePingRespTime")), "source_PonDeviceKPI__nePingRespTime", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__cpuUsageEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_cpuUsageEffcnt")), "source_PonDeviceKPI__cpuUsageEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__memUsageEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_memUsageEffcnt")), "source_PonDeviceKPI__memUsageEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__onlineRateEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_onlineRateEffcnt")), "source_PonDeviceKPI__onlineRateEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__neContrlableRateEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_neContrlableRateEffcnt")), "source_PonDeviceKPI__neContrlableRateEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceKPI__nePingRespTimeEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_nePingRespTimeEffcnt")), "source_PonDeviceKPI__nePingRespTimeEffcnt", True, g::numeric_filters),
], []), [
    t::column(m::field(Row.type, s::DateTimeUtc.type, "source_ts"), "ts"),
    t::column(m::field(Row.type, pon::PonId.type, "source_resId"), "resId"),
    t::column(m::field(Row.type, i::TenantId.type, "source_tenantId"), "tenantId"),
    t::column(m::field(Row.type, String.type, "source_parentId"), "parentId"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::field(Row.type, AssumedCpuPercent.type, "source_cpuUsage"), "cpuUsage"),
    t::column(m::field(Row.type, ReportedMemUsage.type, "source_memUsage"), "memUsage"),
    t::column(m::field(Row.type, p::Percent.type, "source_onlineRate"), "onlineRate"),
    t::column(m::field(Row.type, ReportedNeContrlableRate.type, "source_neContrlableRate"), "neContrlableRate"),
    t::column(m::field(Row.type, ReportedNePingRespTime.type, "source_nePingRespTime"), "nePingRespTime"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_cpuUsageEffcnt"), "cpuUsageEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_memUsageEffcnt"), "memUsageEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_onlineRateEffcnt"), "onlineRateEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_neContrlableRateEffcnt"), "neContrlableRateEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_nePingRespTimeEffcnt"), "nePingRespTimeEffcnt"),
]);
def declaration: t::Declaration = t::with_samples(t::metric(raw, m::field(Row.type, s::DateTimeUtc.type, "source_ts")), [
    samples::bind(dataset, cpu_statistics, m::field(Row.type, AssumedCpuPercent.type, "source_cpuUsage"), [{statistic: samples::Statistic::Mean, publish: "pon_cpu_usage"}, {statistic: samples::Statistic::Max, publish: "pon_cpu_sample_max"}, {statistic: samples::Statistic::Min, publish: "pon_cpu_sample_min"}]),
    samples::bind(dataset, p::Percent_statistics, m::field(Row.type, p::Percent.type, "source_onlineRate"), [{statistic: samples::Statistic::Mean, publish: "pon_online_rate_avg"}, {statistic: samples::Statistic::Min, publish: "pon_online_rate_min"}, {statistic: samples::Statistic::Max, publish: "pon_online_rate_max"}]),
]);
def relations: Array(r::Relation) = [
    r::relation("source_EntPonElementAssociationPonDeviceKPI", pon::dataset, pon::subject, dataset, owner, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
pub use self::{declaration, relations};
