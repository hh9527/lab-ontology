use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::kpi_network_slot_info;
@domain::subject("EnterpriseSlot", "obj_sys_id")
@domain::dataset("enterprise-slot-2-kpi", "EnterpriseSlot2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseSlot2Kpi = struct {
    @m::column("objSysId")
    @g::field_view(g::dimension_group("enterprise-slot-2-kpi/obj_sys_id", ids::EnterpriseSlotById.type, True, [g::Filter::Eq]), "es2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("es2_count")
    obj_sys_id: ids::EnterpriseSlotById,
    @g::field_view(g::dimension_group("enterprise-slot-2-kpi/obj_id", domain::Reference(ids::EnterpriseSlot2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "es2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseSlot2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("es2__nsi", domain::endpoint(EnterpriseSlot2Kpi.type, "obj_id"), domain::endpoint(kpi_network_slot_info::KpiNetworkSlotInfo.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
