# Top-N by a projected aggregate measure, with a dimension tie-breaker:
# count(o.id) DESC, o.customer_id ASC, LIMIT 5.
def top_n_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "verify-top-n",
        sources: [qb.source("o", "orders")],
        projection: [
            qb.expr_item(qb.column("o", "customer_id")),
            qb.aggregate('Count, qb.column("o", "id"), 'False, "order_count"),
        ],
        filter: 'None,
        joins: [],
        grouping: [qb.column("o", "customer_id")],
        ordering: [qb.desc_aggregate("order_count"), qb.asc(qb.column("o", "customer_id"))],
        limit: 'Some(5),
        offset: 'None,
        partition: 'None,
    };
    plan
};

def expected_sql = "SELECT o.customer_id, substr(o.name, ?, ?), sum(o.total) AS total_sum FROM orders AS o INNER JOIN customers AS c ON o.customer_id = c.id WHERE o.total > ? GROUP BY o.customer_id ORDER BY o.customer_id ASC LIMIT ?";

def expected_top_n_sql = "SELECT o.customer_id, count(o.id) AS order_count FROM orders AS o GROUP BY o.customer_id ORDER BY count(o.id) DESC, o.customer_id ASC LIMIT ?";

def expected_bindings: Array(qb.Val) = ['Int(1), 'Int(3), 'Float(100.0), 'Int(10)];

def expected_top_n_bindings: Array(qb.Val) = ['Int(5)];

# ---------------------------------------------------------------------------
# Closed computed expression: first whitespace-delimited segment of a command.
#
#   ./bin/telora -C query run main  ->  ./bin/telora
#
# Composed with the closed primitives Instr (find), If (conditional) and
# Sub/Substr (truncate before the delimiter).  No delimiter -> the original
# value; empty input -> empty value; NULL input -> NULL (SQL CASE WHEN treats
# NULL as false and selects the ELSE branch, which is the original value).
# ---------------------------------------------------------------------------

def first_token_expr: Fn(qb.Expr) -> qb.Expr = fn(command) {
    let sep: qb.Expr = qb.bind_string(" ");
    let pos: qb.Expr = qb.instr(command, sep);
    let found: qb.Expr = qb.scalar('Gt, [pos, qb.bind_int(0)]);
    let rest: qb.Expr = qb.sub(pos, qb.bind_int(1));
    let segment: qb.Expr = qb.scalar_if(
        found,
        qb.substr([command, qb.bind_int(1), rest]),
        command,
    );
    segment
};

def first_token_plan: Fn() -> qb.Plan = fn() {
    let segment = first_token_expr(qb.column("c", "command"));
    let plan: qb.Plan = {
        revision: "verify-first-token",
        sources: [qb.source("c", "commands")],
        projection: [
            qb.expr_item(segment),
            qb.aggregate('Count, qb.column("c", "id"), 'False, "uses"),
        ],
        filter: 'None,
        joins: [],
        grouping: [segment],
        ordering: [qb.desc_aggregate("uses"), qb.asc(qb.column("c", "command"))],
        limit: 'Some(100),
        offset: 'None,
        partition: 'None,
    };
    plan
};

def expected_first_token_sql = "SELECT CASE WHEN instr(c.command, ?) > ? THEN substr(c.command, ?, (instr(c.command, ?) - ?)) ELSE c.command END, count(c.id) AS uses FROM commands AS c GROUP BY CASE WHEN instr(c.command, ?) > ? THEN substr(c.command, ?, (instr(c.command, ?) - ?)) ELSE c.command END ORDER BY count(c.id) DESC, c.command ASC LIMIT ?";

def expected_first_token_bindings: Array(qb.Val) = [
    'String(" "), 'Int(0), 'Int(1), 'String(" "), 'Int(1),
    'String(" "), 'Int(0), 'Int(1), 'String(" "), 'Int(1),
    'Int(100),
];

