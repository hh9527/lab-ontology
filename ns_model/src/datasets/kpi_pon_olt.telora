use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::pon_element_olt_2_kpi;
@domain::subject("NetworkElement", "obj_id")
@domain::dataset("kpi-pon-olt", "kpi_pon_olt", ["obj_id","ts"])
@domain::metric("ts")
@domain::relations(relations)
pub type KpiPonOlt = struct {
    @g::field_view(g::dimension_group("kpi-pon-olt/obj_id", domain::Reference(ids::PonElementOlt2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "po_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::PonElementOlt2KpiByObjId),
    @m::column("tenantId")
    @g::field_view(g::dimension_group("kpi-pon-olt/tenant_id", String.type, True, [g::Filter::Eq]), "po_tenant_id", True, [g::Filter::Eq])
    tenant_id: Option(String),
    @m::column("ownerId")
    @g::field_view(g::dimension_group("kpi-pon-olt/owner_id", Int.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "po_owner_id", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    owner_id: Option(Int),
    @m::column("timestamp")
    @g::field_view(g::dimension_group("kpi-pon-olt/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "po_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("po_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("po_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("po_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("cpuUsage")
    @g::field_view(g::dimension_group("kpi-pon-olt/cpu_usage", metric::KpiPonOltCpuUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "po_cpu_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-pon-olt/cpu_usage", metric::KpiPonOltCpuUsage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "po_cpu_usage"}, {statistic: samples::Statistic::Max, publish: "po_cpu_usage_max"}, {statistic: samples::Statistic::Min, publish: "po_cpu_usage_min"}])
    cpu_usage: Option(metric::KpiPonOltCpuUsage),
    @m::column("memUsage")
    @g::field_view(g::dimension_group("kpi-pon-olt/mem_usage", metric::KpiPonOltMemUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "po_mem_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-pon-olt/mem_usage", metric::KpiPonOltMemUsage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "po_mem_usage"}, {statistic: samples::Statistic::Max, publish: "po_mem_usage_max"}, {statistic: samples::Statistic::Min, publish: "po_mem_usage_min"}])
    mem_usage: Option(metric::KpiPonOltMemUsage),
    @m::column("neContrlableRate")
    @g::field_view(g::dimension_group("kpi-pon-olt/ne_contrlable_rate", metric::KpiPonOltNeContrlableRate.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "po_ne_contrlable_rate_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-pon-olt/ne_contrlable_rate", metric::KpiPonOltNeContrlableRate.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "po_ne_contrlable_rate"}, {statistic: samples::Statistic::Max, publish: "po_ne_contrlable_rate_max"}, {statistic: samples::Statistic::Min, publish: "po_ne_contrlable_rate_min"}])
    ne_contrlable_rate: Option(metric::KpiPonOltNeContrlableRate),
    @m::column("nePingRespTime")
    @g::field_view(g::dimension_group("kpi-pon-olt/ne_ping_resp_time", metric::KpiPonOltNePingRespTime.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "po_ne_ping_resp_time_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
