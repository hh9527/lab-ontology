    let plan: qb.Plan = {
        revision: "test-negative-limit",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "id"))],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: 'Some(-1),
    };
