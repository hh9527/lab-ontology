# 仅在隔离实验中导入；保存原始定义，不生成 PreparedPayload 或知识 JSON。
use crate::registry as registry;
use crate::model as m;
use crate::groups as g;
use crate::values as v;
use crate::transform as t;
use crate::relations as r;
use crate::samples as samples;
use crate::knowledge as k;
use std::type_memorizer as memo;
use std::type_desc as td;
use std::type_property as props;
use std::array as array;
use std::pipeline as pipeline;
use std::codec as codec;
use std::value::{Value};

type Field = struct {
    owner: Type,
    field: td::FieldDesc,
    dimensions: Array(g::FieldDimension),
    domains: Array(v::FieldDomain)
};
type DimensionSpec = enum {
    Field(g::FieldDimension),
    Domain(v::FieldDomain),
    Member(g::Member),
    BoundDomain(v::BindingFacts)
};
type Dimension = struct {
    owner: Type,
    id: String,
    spec: DimensionSpec
};
type MeasureSpec = enum {
    RecordCount,
    FieldCount(t::FieldCountFacts),
    ComputedCount(t::ComputedCountFacts),
    Member(g::Member),
    Sample(samples::BindingFacts)
};
type Measure = struct {
    owner: Type,
    id: String,
    spec: MeasureSpec
};
type DimensionGroupSpec = struct {
    id: String,
    value: Type,
    projectable: Bool,
    filters: Array(g::Filter)
};
type DimensionGroup = enum {
    Dimension(DimensionGroupSpec),
    Domain(v::Definition)
};
type MeasureGroup = enum {
    Transfer(g::MeasureGroup),
    Numeric(g::NumericGroupFacts),
    Sample(SampleGroup)
};
type SampleGroup = struct {
    group: String,
    value: Type,
    primary: samples::Statistic,
    summaries: Array(samples::Statistic),
    unit: Option(String)
};
# 每类只保存 (cname, thunk) 数组，不建立定义表或索引。
type Inventory = struct {
    datasets: Array((String, Fn() -> t::Declaration)),
    entities: Array((String, Fn() -> Type)),
    relations: Array((String, Fn() -> r::Relation)),
    dimensions: Array((String, Fn() -> Dimension)),
    measures: Array((String, Fn() -> Measure)),
    dimension_groups: Array((String, Fn() -> DimensionGroup)),
    measure_groups: Array((String, Fn() -> MeasureGroup)),
    types: Array((String, Fn() -> Type)),
    field_count: Int
};
# 只生成名称和 thunk，按名称去重后收集为数组。
def defer_with: for(A, B) Fn(Array(A), Fn(A) -> String, Fn(A) -> B) -> Array((String, Fn() -> B)) = fn(
    items,
    key,
    initialize
) {
    pipeline::run(
        pipeline::from_array(items) |> pipeline::map(
            fn(item) {
                (
                    key(item),
                    fn() {
                        initialize(item)
                    }
                )
            }
        ) |> pipeline::distinct_by(
            fn(entry) {
                entry.0
            }
        ) |> pipeline::collect()
    )
};
def defer: for(A) Fn(Array(A), Fn(A) -> String) -> Array((String, Fn() -> A)) = fn(items, key) {
    defer_with(
        items,
        key,
        fn(item) {
            item
        }
    )
};
def compute_type_name: Fn(Type) -> String = fn(ty) {
    if ty == Int.type {
        "Int"
    } else if ty == Float.type {
        "Float"
    } else if ty == Bool.type {
        "Bool"
    } else if ty == String.type {
        "String"
    } else {
        match td::name(ty) {
            Some(name) => name,
            None => fail!("inventory requires a named definition", ty)
        }
    }
};
def type_names: memo::TypeMemorizer(String) = memo::type_memorizer(compute_type_name);
def type_name: Fn(Type) -> String = fn(ty) {
    memo::computed_with_type(type_names, ty)
};
def type_entries: memo::TypeMemorizer(Option((String, Fn() -> Type))) = memo::type_memorizer(
    fn(ty) {
        match scalar_references(ty) {
            None => None,
            Some(value) => Some(
                (
                    type_name(value),
                    fn() {
                        value
                    }
                )
            )
        }
    }
);
def finish_entries: for(A) Fn(Array((String, Fn() -> A))) -> Array((String, Fn() -> A)) = fn(
    entries
) {
    pipeline::run(
        pipeline::from_array(entries) |> pipeline::distinct_by(
            fn(entry) {
                entry.0
            }
        ) |> pipeline::collect()
    )
};
def member_entry: for(A) Fn(Type, String, Fn() -> A) -> (String, Fn() -> A) = fn(
    owner,
    id,
    initialize
) {
    (`\{type_name(owner)}::\{id}`, initialize)
};
def fields: Fn(Type) -> Array(Field) = fn(owner) {
    array::map(
        m::fields_of(owner),
        fn(field) {
            {
                owner,
                field,
                dimensions: match props::get_field_prop(owner, field.index, g::FieldDimensions.type) {
                    Some(value) => value.dimensions,
                    None => []
                },
                domains: match props::get_field_prop(owner, field.index, v::FieldDomains.type) {
                    Some(value) => value.dimensions,
                    None => []
                }
            }.ty!(Field)
        }
    )
};
def bindings: Fn(t::Declaration) -> Array(g::BindingFacts) = fn(declared) {
    array::concat(
        [
            declared.groups,
            array::flat_map(
                declared.native_pairs,
                fn(pair) {
                    [pair.first, pair.second]
                }
            )
        ]
    )
};
def root_connections: Fn(Type) -> registry::Connections = fn(ty) {
    match props::get_type_prop(ty, registry::Connections.type) {
        Some(value) => value,
        None => {relations: [], alternatives: [], links: []}
    }
};
# 当前数据类型只局部解包 Option(T)，不遍历具名类型的表示或依赖。
def direct_datatype: Fn(Type) -> Type = fn(ty) {
    if td::kind(ty) == td::TypeDescKind::Enum && k::inline_type(ty) {
        td::children(ty)[0]
    } else {
        ty
    }
};
def datatype_references: memo::TypeMemorizer(Option(Type)) = memo::type_memorizer(
    fn(ty) {
        let scalar = direct_datatype(ty);
        if scalar == Int.type || scalar == Float.type || scalar == Bool.type || scalar == String.type {
            None
        } else {
            Some(scalar)
        }
    }
);
def scalar_references: Fn(Type) -> Option(Type) = fn(ty) {
    memo::computed_with_type(datatype_references, ty)
};
def collect: Fn(Array(Type), Array(r::Relation)) -> Inventory = fn(roots, explicit_relations) {
    let unique = pipeline::run(
        pipeline::from_array(roots) |> pipeline::distinct_by(type_name) |> pipeline::collect()
    );
    let datasets = array::flat_map(
        unique,
        fn(ty) {
            match props::get_type_prop(ty, registry::RootSpec.type) {
                Some(registry::RootSpec::Dataset(_)) => [registry::declaration_data(ty)],
                Some(registry::RootSpec::Entity(_)) => [],
                _ => fail!("inventory root requires Dataset or Entity property", ty)
            }
        }
    );
    let entities = array::filter(
        unique,
        fn(ty) {
            match props::get_type_prop(ty, registry::RootSpec.type) {
                Some(registry::RootSpec::Entity(_)) => True,
                _ => False
            }
        }
    );
    let connections = array::map(unique, root_connections);
    let relations = array::concat(
        [
            explicit_relations,
            array::flat_map(
                connections,
                fn(c) {
                    c.relations
                }
            ),
            array::flat_map(
                connections,
                fn(c) {
                    array::flat_map(
                        c.links,
                        fn(link) {
                            [link.a, link.z]
                        }
                    )
                }
            )
        ]
    );
    collect_declarations(datasets, entities, relations)
};
def collect_declarations: Fn(Array(t::Declaration), Array(Type), Array(r::Relation)) -> Inventory = fn(
    datasets,
    entities,
    relations
) {
    collect_declarations_mode(datasets, entities, relations, False)
};
def collect_initialized: Fn(Array(t::Declaration), Array(Type), Array(r::Relation)) -> Inventory = fn(
    datasets,
    entities,
    relations
) {
    collect_declarations_mode(datasets, entities, relations, True)
};
def collect_declarations_mode: Fn(
    Array(t::Declaration),
    Array(Type),
    Array(r::Relation),
    Bool
) -> Inventory = fn(datasets, entities, declared_relations, initialized) {
    let roots = pipeline::run(
        pipeline::from_array(
            array::concat(
                [
                    array::map(
                        datasets,
                        fn(declared) {
                            declared.dataset.row
                        }
                    ),
                    entities
                ]
            )
        ) |> pipeline::distinct_by(type_name) |> pipeline::collect()
    );
    let all_field_descs = array::flat_map(roots, m::fields_of);
    # Initialized Dataset declarations already contain their field dimensions/domains.
    let all_fields = array::flat_map(
        if initialized {
            entities
        } else {
            roots
        },
        fields
    );
    let all_bindings = array::flat_map(datasets, bindings);
    let dimensions = array::concat(
        [
            array::flat_map(
                all_fields,
                fn(field) {
                    array::concat(
                        [
                            array::map(
                                field.dimensions,
                                fn(spec) {
                                    member_entry(
                                        field.owner,
                                        spec.id,
                                        fn() {
                                            {
                                                owner: field.owner,
                                                id: spec.id,
                                                spec: DimensionSpec::Field(spec)
                                            }.ty!(Dimension)
                                        }
                                    )
                                }
                            ),
                            array::map(
                                field.domains,
                                fn(spec) {
                                    member_entry(
                                        field.owner,
                                        spec.id,
                                        fn() {
                                            {
                                                owner: field.owner,
                                                id: spec.id,
                                                spec: DimensionSpec::Domain(spec)
                                            }.ty!(Dimension)
                                        }
                                    )
                                }
                            )
                        ]
                    )
                }
            ),
            array::flat_map(
                all_bindings,
                fn(binding) {
                    array::flat_map(
                        binding.members,
                        fn(member) {
                            match member.kind {
                                g::MemberKind::Dimension(_) => [
                                    member_entry(
                                        binding.row,
                                        member.id,
                                        fn() {
                                            {
                                                owner: binding.row,
                                                id: member.id,
                                                spec: DimensionSpec::Member(member)
                                            }.ty!(Dimension)
                                        }
                                    )
                                ],
                                _ => []
                            }
                        }
                    )
                }
            ),
            array::flat_map(
                datasets,
                fn(declared) {
                    array::map(
                        declared.domains,
                        fn(binding) {
                            member_entry(
                                binding.row,
                                binding.id,
                                fn() {
                                    {
                                        owner: binding.row,
                                        id: binding.id,
                                        spec: DimensionSpec::BoundDomain(binding)
                                    }.ty!(Dimension)
                                }
                            )
                        }
                    )
                }
            )
        ]
    );
    let measures = array::flat_map(
        datasets,
        fn(declared) {
            let owner = declared.dataset.row;
            array::concat(
                [
                    array::map(
                        declared.record_counts,
                        fn(id) {
                            member_entry(
                                owner,
                                id,
                                fn() {
                                    {owner, id, spec: MeasureSpec::RecordCount}.ty!(Measure)
                                }
                            )
                        }
                    ),
                    array::map(
                        declared.field_counts,
                        fn(spec) {
                            member_entry(
                                owner,
                                spec.id,
                                fn() {
                                    {owner, id: spec.id, spec: MeasureSpec::FieldCount(spec)}.ty!(
                                        Measure
                                    )
                                }
                            )
                        }
                    ),
                    array::map(
                        declared.computed_counts,
                        fn(spec) {
                            member_entry(
                                owner,
                                spec.result.id,
                                fn() {
                                    {
                                        owner,
                                        id: spec.result.id,
                                        spec: MeasureSpec::ComputedCount(spec)
                                    }.ty!(Measure)
                                }
                            )
                        }
                    ),
                    array::flat_map(
                        bindings(declared),
                        fn(binding) {
                            array::flat_map(
                                binding.members,
                                fn(member) {
                                    match member.kind {
                                        g::MemberKind::Dimension(_) => [],
                                        _ => [
                                            member_entry(
                                                owner,
                                                member.id,
                                                fn() {
                                                    {
                                                        owner,
                                                        id: member.id,
                                                        spec: MeasureSpec::Member(member)
                                                    }.ty!(Measure)
                                                }
                                            )
                                        ]
                                    }
                                }
                            )
                        }
                    ),
                    array::flat_map(
                        declared.samples,
                        fn(binding) {
                            array::map(
                                binding.names,
                                fn(name) {
                                    member_entry(
                                        owner,
                                        name.publish,
                                        fn() {
                                            {
                                                owner,
                                                id: name.publish,
                                                spec: MeasureSpec::Sample(binding)
                                            }.ty!(Measure)
                                        }
                                    )
                                }
                            )
                        }
                    )
                ]
            )
        }
    );
    let dimension_groups = array::concat(
        [
            array::flat_map(
                all_fields,
                fn(field) {
                    array::concat(
                        [
                            array::map(
                                field.dimensions,
                                fn(spec) {
                                    let value = match spec.value {
                                        Some(ty) => ty,
                                        None => direct_datatype(field.field.ty)
                                    };
                                    (
                                        `\{spec.group}(\{type_name(value)})`,
                                        fn() {
                                            DimensionGroup::Dimension(
                                                {
                                                    id: spec.group,
                                                    value,
                                                    projectable: spec.group_projectable,
                                                    filters: spec.group_filters
                                                }
                                            )
                                        }
                                    )
                                }
                            ),
                            array::map(
                                field.domains,
                                fn(spec) {
                                    let definition = spec.definition;
                                    (
                                        `\{definition.id}(\{type_name(definition.value)},\{type_name(definition.wire)})`,
                                        fn() {
                                            DimensionGroup::Domain(definition)
                                        }
                                    )
                                }
                            )
                        ]
                    )
                }
            ),
            array::flat_map(
                all_bindings,
                fn(binding) {
                    match binding.contract {
                        g::BindingContract::DeferredDimension(spec) => [
                            (
                                `\{spec.id}(\{type_name(spec.value)})`,
                                fn() {
                                    DimensionGroup::Dimension(
                                        {
                                            id: spec.id,
                                            value: spec.value,
                                            projectable: spec.projectable,
                                            filters: spec.filters
                                        }
                                    )
                                }
                            )
                        ],
                        _ => []
                    }
                }
            ),
            array::flat_map(
                datasets,
                fn(declared) {
                    array::map(
                        declared.domains,
                        fn(binding) {
                            let definition = binding.definition;
                            (
                                `\{definition.id}(\{type_name(definition.value)},\{type_name(definition.wire)})`,
                                fn() {
                                    DimensionGroup::Domain(definition)
                                }
                            )
                        }
                    )
                }
            )
        ]
    );
    let measure_groups = array::flat_map(
        datasets,
        fn(declared) {
            array::concat(
                [
                    array::flat_map(
                        bindings(declared),
                        fn(binding) {
                            match binding.contract {
                                g::BindingContract::Transfer(spec) => [
                                    (
                                        spec.id,
                                        fn() {
                                            MeasureGroup::Transfer(spec)
                                        }
                                    )
                                ],
                                g::BindingContract::Numeric(spec) => [
                                    (
                                        `\{spec.id}(\{type_name(spec.value)})`,
                                        fn() {
                                            MeasureGroup::Numeric(spec)
                                        }
                                    )
                                ],
                                _ => []
                            }
                        }
                    ),
                    array::map(
                        declared.samples,
                        fn(spec) {
                            (
                                `\{spec.group}(\{type_name(spec.value)})`,
                                fn() {
                                    MeasureGroup::Sample(
                                        {
                                            group: spec.group,
                                            value: spec.value,
                                            primary: spec.primary,
                                            summaries: spec.summaries,
                                            unit: spec.unit
                                        }
                                    )
                                }
                            )
                        }
                    )
                ]
            )
        }
    );
    let seeds = array::concat(
        [
            array::map(
                all_field_descs,
                fn(field) {
                    field.ty
                }
            ),
            array::flat_map(
                all_fields,
                fn(field) {
                    array::concat(
                        [
                            array::flat_map(
                                field.dimensions,
                                fn(spec) {
                                    match spec.value {
                                        Some(ty) => [ty],
                                        None => []
                                    }
                                }
                            ),
                            array::flat_map(
                                field.domains,
                                fn(spec) {
                                    [spec.definition.value, spec.definition.wire]
                                }
                            )
                        ]
                    )
                }
            ),
            array::flat_map(
                all_bindings,
                fn(binding) {
                    array::concat(
                        [
                            match binding.contract {
                                g::BindingContract::DeferredDimension(spec) => [spec.value],
                                _ => []
                            },
                            array::flat_map(
                                binding.members,
                                fn(member) {
                                    [member.value]
                                }
                            )
                        ]
                    )
                }
            ),
            array::flat_map(
                datasets,
                fn(declared) {
                    array::concat(
                        [
                            array::flat_map(
                                declared.domains,
                                fn(binding) {
                                    [binding.definition.value, binding.definition.wire]
                                }
                            ),
                            array::map(
                                declared.samples,
                                fn(binding) {
                                    binding.value
                                }
                            ),
                            array::map(
                                declared.field_counts,
                                fn(count) {
                                    count.value
                                }
                            )
                        ]
                    )
                }
            )
        ]
    );
    let types = pipeline::run(
        pipeline::from_array(seeds) |> pipeline::filter_map(
            fn(ty) {
                memo::computed_with_type(type_entries, ty)
            }
        ) |> pipeline::distinct_by(
            fn(entry) {
                entry.0
            }
        ) |> pipeline::collect()
    );
    {
        datasets: defer(
            datasets,
            fn(item) {
                type_name(item.dataset.row)
            }
        ),
        entities: defer(entities, type_name),
        relations: defer(
            declared_relations,
            fn(item) {
                item.id
            }
        ),
        dimensions: finish_entries(dimensions),
        measures: finish_entries(measures),
        dimension_groups: finish_entries(dimension_groups),
        measure_groups: finish_entries(measure_groups),
        types,
        field_count: array::length(all_field_descs)
    }.ty!(Inventory)
};
type Summary = struct {
    datasets: Int,
    entities: Int,
    relations: Int,
    fields: Int,
    dimensions: Int,
    measures: Int,
    dimension_groups: Int,
    measure_groups: Int,
    types: Int
};
def summary: Fn(Inventory) -> Value = fn(value) {
    codec::encode(
        {
            datasets: array::length(value.datasets),
            entities: array::length(value.entities),
            relations: array::length(value.relations),
            fields: value.field_count,
            dimensions: array::length(value.dimensions),
            measures: array::length(value.measures),
            dimension_groups: array::length(value.dimension_groups),
            measure_groups: array::length(value.measure_groups),
            types: array::length(value.types)
        }.ty!(Summary)
    )
};
type Names = struct {
    datasets: Array(String),
    entities: Array(String),
    relations: Array(String),
    dimensions: Array(String),
    measures: Array(String),
    dimension_groups: Array(String),
    measure_groups: Array(String),
    types: Array(String)
};
def manifest: Fn(Inventory) -> Value = fn(value) {
    Value::Object(
        {
            counts: summary(value),
            names: codec::encode(
                {
                    datasets: array::map(
                        value.datasets,
                        fn(entry) {
                            entry.0
                        }
                    ),
                    entities: array::map(
                        value.entities,
                        fn(entry) {
                            entry.0
                        }
                    ),
                    relations: array::map(
                        value.relations,
                        fn(entry) {
                            entry.0
                        }
                    ),
                    dimensions: array::map(
                        value.dimensions,
                        fn(entry) {
                            entry.0
                        }
                    ),
                    measures: array::map(
                        value.measures,
                        fn(entry) {
                            entry.0
                        }
                    ),
                    dimension_groups: array::map(
                        value.dimension_groups,
                        fn(entry) {
                            entry.0
                        }
                    ),
                    measure_groups: array::map(
                        value.measure_groups,
                        fn(entry) {
                            entry.0
                        }
                    ),
                    types: array::map(
                        value.types,
                        fn(entry) {
                            entry.0
                        }
                    )
                }.ty!(Names)
            )
        }
    )
};
pub use self::{
    collect,
    collect_declarations,
    collect_initialized,
    summary,
    manifest,
    Inventory,
    defer_with
};
