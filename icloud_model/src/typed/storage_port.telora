use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储磁盘／端口：保留来源 grain、原始文本与明确单位，不推断额外身份或关系。
use super::inventory as i;
use super::storage as storage;
use super::fc_switch as fc;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type PortId = struct(String);
@domain::entity_by("StoragePort")
type StoragePortById = struct(PortId);
# 来源 speed 为整数 Mbit/s，不把文本 maxSpeed (Gbit/s) 隐式转换为同一量。
type MegabitsPerSecond = struct(Int);
@domain::subject("StoragePort", "source_id")
@domain::dataset("source_SYS_StoragePort", "SYS_StoragePort", ["source_id"])
@domain::relations(relations)
type SysStoragePort = struct {
    @m::column("id")
    @g::exact("source_SYS_StoragePort__id")
    source_id: StoragePortById,
    @m::column("tenantId")
    @g::exact("source_SYS_StoragePort__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("name")
    @g::search("source_SYS_StoragePort__name")
    source_name: String,
    @m::column("remotePortWwn")
    @g::search("source_SYS_StoragePort__remotePortWwn")
    source_remotePortWwn: String,
    @m::column("remoteNodeWwn")
    @g::search("source_SYS_StoragePort__remoteNodeWwn")
    source_remoteNodeWwn: String,
    @m::column("lostSync")
    @g::exact("source_SYS_StoragePort__lostSync")
    source_lostSync: String,
    @m::column("ipv6Mask")
    @g::search("source_SYS_StoragePort__ipv6Mask")
    source_ipv6Mask: String,
    @m::column("ipv4Mask")
    @g::search("source_SYS_StoragePort__ipv4Mask")
    source_ipv4Mask: String,
    @m::column("firmwareVersion")
    @g::search("source_SYS_StoragePort__firmwareVersion")
    source_firmwareVersion: String,
    @m::column("parentResId")
    @g::exact("source_SYS_StoragePort__parentResId")
    @domain::targets(
        [
            {name: "storage_owner", identity: storage::StorageById.type}.ty!(
                domain::ReferenceTarget
            ),
            {name: "fc_owner", identity: fc::FcSwitchById.type}.ty!(domain::ReferenceTarget)
        ]
    )
    source_parentResId: domain::Reference(String),
    @m::column("ipv6Gateway")
    @g::search("source_SYS_StoragePort__ipv6Gateway")
    source_ipv6Gateway: String,
    @m::column("ipv4Gateway")
    @g::search("source_SYS_StoragePort__ipv4Gateway")
    @g::ipv4_view("source_SYS_StoragePort__ipv4Gateway_ipv4")
    source_ipv4Gateway: String,
    @m::column("logicType")
    @g::exact("source_SYS_StoragePort__logicType_raw")
    @v::map(
        SourceSYSStoragePortLogicType.type,
        "source_SYS_StoragePort__logicType",
        [
            v::member(SourceSYSStoragePortLogicType::HostPortOrServicePort, ["0"]),
            v::member(SourceSYSStoragePortLogicType::CascadePort, ["1"]),
            v::member(SourceSYSStoragePortLogicType::ManagementPort, ["2"]),
            v::member(SourceSYSStoragePortLogicType::InternalPort, ["3"]),
            v::member(SourceSYSStoragePortLogicType::MaintenancePort, ["4"]),
            v::member(SourceSYSStoragePortLogicType::ManagementOrServiceHybridPort, ["5"]),
            v::member(SourceSYSStoragePortLogicType::MaintenanceOrServiceHybridPort, ["6"]),
            v::member(SourceSYSStoragePortLogicType::ContainerFrontEndPort, ["13"]),
            v::member(SourceSYSStoragePortLogicType::ContainerBackEndPort, ["14"])
        ]
    )
    source_logicType: String,
    @m::column("maxSpeed")
    @g::exact("source_SYS_StoragePort__maxSpeed")
    source_maxSpeed: String,
    @m::column("phySlotNum")
    @g::exact("source_SYS_StoragePort__phySlotNum")
    source_phySlotNum: String,
    @m::column("location")
    @g::search("source_SYS_StoragePort__location")
    source_location: String,
    @m::column("speed")
    @g::field_view(
        g::dimension_group(
            "source_SYS_StoragePort__speed",
            MegabitsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "source_SYS_StoragePort__speed",
        True,
        g::numeric_filters
    )
    source_speed: MegabitsPerSecond,
    @m::column("bondName")
    @g::search("source_SYS_StoragePort__bondName")
    source_bondName: String,
    @m::column("mgmtIpv6")
    @g::search("source_SYS_StoragePort__mgmtIpv6")
    source_mgmtIpv6: String,
    @m::column("mgmtIp")
    @g::search("source_SYS_StoragePort__mgmtIp")
    @g::ipv4_view("source_SYS_StoragePort__mgmtIp_ipv4")
    source_mgmtIp: String,
    @m::column("mac")
    @g::search("source_SYS_StoragePort__mac")
    source_mac: String,
    @m::column("wwn")
    @g::search("source_SYS_StoragePort__wwn")
    source_wwn: String,
    @m::column("portType")
    @g::exact("source_SYS_StoragePort__portType_raw")
    @v::map(
        SourceSYSStoragePortPortType.type,
        "source_SYS_StoragePort__portType",
        [
            v::member(SourceSYSStoragePortPortType::FCoEPort, ["FCoE"]),
            v::member(SourceSYSStoragePortPortType::EthernetPort, ["ETH"]),
            v::member(SourceSYSStoragePortPortType::RoCePort, ["RoCE"]),
            v::member(SourceSYSStoragePortPortType::SasPort, ["SAS"]),
            v::member(SourceSYSStoragePortPortType::FcPort, ["FC"])
        ]
    )
    source_portType: String,
    @m::column("healthStatus")
    @g::exact("source_SYS_StoragePort__healthStatus_raw")
    @v::map(
        SourceSYSStoragePortHealthStatus.type,
        "source_SYS_StoragePort__healthStatus",
        [
            v::member(SourceSYSStoragePortHealthStatus::Unknown, ["0"]),
            v::member(SourceSYSStoragePortHealthStatus::Normal, ["1"]),
            v::member(SourceSYSStoragePortHealthStatus::Failure, ["2", "down"]),
            v::member(SourceSYSStoragePortHealthStatus::AboutToFail, ["3"]),
            v::member(SourceSYSStoragePortHealthStatus::ThereIsAnErrorCode, ["7"]),
            v::member(SourceSYSStoragePortHealthStatus::Connected, ["10"]),
            v::member(SourceSYSStoragePortHealthStatus::NotConnected, ["11"]),
            v::member(SourceSYSStoragePortHealthStatus::NonConsistent, ["9"]),
            v::member(SourceSYSStoragePortHealthStatus::Health, ["up"])
        ]
    )
    source_healthStatus: String,
    @m::column("runningStatus")
    @g::exact("source_SYS_StoragePort__runningStatus_raw")
    @v::map(
        SourceSYSStoragePortRunningStatus.type,
        "source_SYS_StoragePort__runningStatus",
        [
            v::member(SourceSYSStoragePortRunningStatus::Unknown, ["0"]),
            v::member(SourceSYSStoragePortRunningStatus::Normal, ["1"]),
            v::member(SourceSYSStoragePortRunningStatus::Running, ["2"]),
            v::member(SourceSYSStoragePortRunningStatus::Disconnected, ["3", "11"]),
            v::member(SourceSYSStoragePortRunningStatus::Bypassed, ["4"]),
            v::member(SourceSYSStoragePortRunningStatus::Diagnostics, ["5"]),
            v::member(SourceSYSStoragePortRunningStatus::Connected, ["10"]),
            v::member(SourceSYSStoragePortRunningStatus::ToBeRestored, ["33"]),
            v::member(SourceSYSStoragePortRunningStatus::Health, ["up"]),
            v::member(SourceSYSStoragePortRunningStatus::Faulty, ["down"])
        ]
    )
    source_runningStatus: String,
    @m::column("connectStatus")
    @g::exact("source_SYS_StoragePort__connectStatus_raw")
    @v::map(
        SourceSYSStoragePortConnectStatus.type,
        "source_SYS_StoragePort__connectStatus",
        [
            v::member(SourceSYSStoragePortConnectStatus::Connected, ["up"]),
            v::member(SourceSYSStoragePortConnectStatus::Disconnected, ["down"])
        ]
    )
    source_connectStatus: String,
    @m::column("portId")
    @g::exact("source_SYS_StoragePort__portId")
    source_portId: String,
};

def subject: r::Endpoint = domain::endpoint(SysStoragePort.type, "source_id");
def tenant: r::Endpoint = domain::endpoint(SysStoragePort.type, "source_tenantId");
def parent: r::Endpoint = domain::endpoint(SysStoragePort.type, "storage_owner");
def fc_parent: r::Endpoint = domain::endpoint(SysStoragePort.type, "fc_owner");

@knowledge_policy::reverse_references(True)
type SourceSYSStoragePortLogicType = enum {
    @ev::description("Host port (or service port)", "主机端口(或业务端口）")
    HostPortOrServicePort,

    @ev::description("Cascade port", "级联端口")
    CascadePort,

    @ev::description("Management port", "管理端口")
    ManagementPort,

    @ev::description("Internal port", "内部端口")
    InternalPort,

    @ev::description("Maintenance port", "维护端口")
    MaintenancePort,

    @ev::description("Management (or service hybrid port)", "管理（或业务混合口)")
    ManagementOrServiceHybridPort,

    @ev::description("Maintenance (or service hybrid port)", "维护(或业务混合口)")
    MaintenanceOrServiceHybridPort,

    @ev::description("Container front-end port", "容器前端端口")
    ContainerFrontEndPort,

    @ev::description("Container back-end port", "容器后端端口")
    ContainerBackEndPort,
};

@knowledge_policy::reverse_references(True)
type SourceSYSStoragePortPortType = enum {
    @ev::description("FCoE port", "FCoE端口")
    FCoEPort,

    @ev::description("Ethernet port", "以太网端口")
    EthernetPort,

    @ev::description("RoCE port", "RoCE端口")
    RoCePort,

    @ev::description("SAS port", "SAS端口")
    SasPort,

    @ev::description("FC port", "FC端口")
    FcPort,
};

@knowledge_policy::reverse_references(True)
type SourceSYSStoragePortHealthStatus = enum {
    @ev::description("unknown", "未知")
    Unknown,

    @ev::description("normal", "正常")
    Normal,

    @ev::description("failure", "故障")
    Failure,

    @ev::description("About to fail", "即将故障")
    AboutToFail,

    @ev::description("There is an error code", "有误码")
    ThereIsAnErrorCode,

    @ev::description("connected", "已连接")
    Connected,

    @ev::description("not connected", "未连接")
    NotConnected,

    @ev::description("non-consistent", "不一致")
    NonConsistent,

    @ev::description("health", "健康")
    Health,
};

@knowledge_policy::reverse_references(True)
type SourceSYSStoragePortRunningStatus = enum {
    @ev::description("unknown", "未知")
    Unknown,

    @ev::description("normal", "正常")
    Normal,

    @ev::description("running", "运行")
    Running,

    @ev::description("Disconnected", "未连接")
    Disconnected,

    @ev::description("Bypassed", "不再使用")
    Bypassed,

    @ev::description("Diagnostics", "诊断口")
    Diagnostics,

    @ev::description("connected", "已连接")
    Connected,

    @ev::description("To be restored", "待恢复")
    ToBeRestored,

    @ev::description("health", "健康")
    Health,

    @ev::description("faulty", "故障")
    Faulty,
};

@knowledge_policy::reverse_references(True)
type SourceSYSStoragePortConnectStatus = enum {
    @ev::description("connected", "已连接")
    Connected,

    @ev::description("disconnected", "未连接")
    Disconnected,
};

def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceAssociationSYS_StoragePort",
        storage::subject,
        parent,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_SYS_StoragePortAssociationX_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_FCSwitchDevice_SYS_StoragePort",
        fc::subject,
        fc_parent,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{SysStoragePort, StoragePortById};

pub use self::{
    SourceSYSStoragePortLogicType,
    SourceSYSStoragePortPortType,
    SourceSYSStoragePortHealthStatus,
    SourceSYSStoragePortRunningStatus,
    SourceSYSStoragePortConnectStatus
};
