        offset: 'None,
        partition: 'None,
    };
    let exists: edsl.ExistsRequest = { target: "children", subject: "analyst", filters: [], any_of: [], min_matches: 'Some(0) };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [exists], []);
    plan
};

