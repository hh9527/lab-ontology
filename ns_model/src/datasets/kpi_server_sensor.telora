use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::serversensor_2_kpi;
@domain::subject("KpiServerSensor", "obj_id")
@domain::dataset("kpi-server-sensor", "kpi_server_sensor", ["obj_id","ts"])
@domain::metric("ts")
@domain::relations(relations)
pub type KpiServerSensor = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-server-sensor/obj_id", domain::Reference(ids::KpiServerSensorByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "ss_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::KpiServerSensorByObjId),
    @m::column("TS")
    @g::field_view(g::dimension_group("kpi-server-sensor/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "ss_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("ss_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("ss_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("ss_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("SENSORTEMPERATURE")
    @g::field_view(g::dimension_group("kpi-server-sensor/sensor_temperature", metric::KpiServerSensorSensorTemperature.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "ss_sensor_temperature_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-server-sensor/sensor_temperature", metric::KpiServerSensorSensorTemperature.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("°C")), [{statistic: samples::Statistic::Mean, publish: "ss_sensor_temperature"}, {statistic: samples::Statistic::Max, publish: "ss_sensor_temperature_max"}, {statistic: samples::Statistic::Min, publish: "ss_sensor_temperature_min"}])
    sensor_temperature: Option(metric::KpiServerSensorSensorTemperature),
};

pub def relations: Array(r::Relation) = [
    r::relation("ss__serversensor_2_rev", domain::endpoint(KpiServerSensor.type, "obj_id"), domain::endpoint(serversensor_2_kpi::Serversensor2Kpi.type, "obj_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
