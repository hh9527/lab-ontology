use ontology::quantity as q;
use std::test as test;
use std::codec as codec;
use std::json as json;

pub def conversion_is_explicit_and_preserves_fraction: test::Test = test::should_ok(
    fn() {
        q::seconds(q::Milliseconds(1500.0)) == q::Seconds(1.5) && q::rate(
            q::Bytes(3.0),
            q::seconds(q::Milliseconds(2000.0))
        ) == Some(q::BytesPerSecond(1.5))
    }
);
pub def unit_types_are_nominal: test::Test = test::should_ok(
    fn() {
        q::Seconds.type != q::Milliseconds.type && q::Bytes.type != q::BytesPerSecond.type
    }
);
pub def invalid_duration_is_missing_not_zero: test::Test = test::should_ok(
    fn() {
        q::rate(q::Bytes(10.0), q::Seconds(0.0)) == None && q::rate(
            q::Bytes(10.0),
            q::Seconds(-1.0)
        ) == None && q::rate(q::Bytes(0.0), q::Seconds(1.0)) == Some(q::BytesPerSecond(0.0))
    }
);
pub def aggregation_meanings_are_distinct: test::Test = test::should_ok(
    fn() {
        let samples: Array(q::Sample) = [
            {amount: q::Bytes(100.0), duration: q::Seconds(1.0)},
            {amount: q::Bytes(900.0), duration: q::Seconds(9.0)},
            {amount: q::Bytes(100.0), duration: q::Seconds(10.0)},
            {amount: q::Bytes(10000.0), duration: q::Seconds(0.0)},
        ];
        q::mean_rate(samples) == Some(q::BytesPerSecond(70.0)) && q::weighted_rate(samples) == Some(
            q::BytesPerSecond(55.0)
        )
    }
);
pub def empty_and_invalid_samples_have_no_aggregate: test::Test = test::should_ok(
    fn() {
        let invalid: Array(q::Sample) = [{amount: q::Bytes(5.0), duration: q::Seconds(-1.0)}];
        q::mean_rate([]) == None && q::weighted_rate([]) == None && q::mean_rate(invalid) == None && q::weighted_rate(
            invalid
        ) == None
    }
);
pub def quantity_codec_uses_numeric_payload: test::Test = test::should_ok(
    fn() {
        let value = codec::decode@[q::Bytes](json::parse("1.5").unwrap!()).unwrap!();
        value == q::Bytes(1.5) && codec::encode(value) == codec::encode(1.5)
    }
);
