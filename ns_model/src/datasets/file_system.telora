    @g::field_view(g::dimension_group("file-system/snapshot_reserve_capacity", String.type, True, [g::Filter::Eq]), "fs_snapshot_reserve_capacity", True, [g::Filter::Eq])
    snapshot_reserve_capacity: Option(String),
    @m::column("allocCapacityRatio")
    @g::field_view(g::dimension_group("file-system/alloc_capacity_ratio", Float.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "fs_alloc_capacity_ratio", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    alloc_capacity_ratio: Option(Float),
    @m::column("poolName")
    @g::field_view(g::dimension_group("file-system/pool_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "fs_pool_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    pool_name: Option(String),
