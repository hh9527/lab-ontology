        offset: None,
        exists: [],
        having: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    let q = qb.transform_sqlite(plan);
    array.length(q.bindings) == 0 && q.sql == "SELECT o.id FROM orders AS o"
};

# ---------------------------------------------------------------------------
# Closed computed expression: first whitespace-delimited segment.
#
# Contract (SQLite `instr` semantics, 1-based, 0 when absent):
#   - no delimiter : `instr(text, sep) = 0`, the `> 0` guard fails and the
#                    ELSE branch returns the original value;
#   - empty string : same as no delimiter -> empty string;
#   - NULL input   : `instr(NULL, sep)` is NULL, `CASE WHEN NULL` selects the
#                    ELSE branch, so NULL propagates unchanged.
# The segment before the first delimiter is `substr(text, 1, instr - 1)`.
# ---------------------------------------------------------------------------

def first_token_expr: Fn(qb.Expr) -> qb.Expr = fn(command) {
    let sep: qb.Expr = qb.bind_string(" ");
    let pos: qb.Expr = qb.instr(command, sep);
    let found: qb.Expr = qb.scalar(qb.ScalarFunction.Gt, [pos, qb.bind_int(0)]);
    let rest: qb.Expr = qb.sub(pos, qb.bind_int(1));
    let segment: qb.Expr = qb.scalar_if(
        found,
        qb.substr([command, qb.bind_int(1), rest]),
        command,
    );
    segment
};

def first_token_plan: Fn() -> qb.Plan = fn() {
    let segment = first_token_expr(qb.column("c", "command"));
    let plan: qb.Plan = {
        revision: "test-first-token",
        sources: [qb.source("c", "commands")],
        projection: [
            qb.expr_item(segment),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("c", "id"), False, "uses"),
        ],
        filter: None,
        joins: [],
        grouping: [segment],
        ordering: [qb.desc_aggregate("uses"), qb.asc(qb.column("c", "command"))],
        limit: Some(100),
        offset: None,
        exists: [],
        having: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def expected_first_token_sql = "SELECT CASE WHEN instr(c.command, ?) > ? THEN substr(c.command, ?, (instr(c.command, ?) - ?)) ELSE c.command END, count(c.id) AS uses FROM commands AS c GROUP BY CASE WHEN instr(c.command, ?) > ? THEN substr(c.command, ?, (instr(c.command, ?) - ?)) ELSE c.command END ORDER BY count(c.id) DESC, c.command ASC LIMIT ?";

def expected_first_token_bindings: Array(qb.Val) = [
    qb.Val.String(" "), qb.Val.Int(0), qb.Val.Int(1), qb.Val.String(" "), qb.Val.Int(1),
    qb.Val.String(" "), qb.Val.Int(0), qb.Val.Int(1), qb.Val.String(" "), qb.Val.Int(1),
    qb.Val.Int(100),
];

