use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::storage_fc_switch_port;
use crate::datasets::kpi_storage_fc_port;
@domain::subject("StorageFcSwitchPort", "obj_sys_id")
@domain::dataset("fc-port-2-kpi", "FcPort2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type FcPort2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("fc-port-2-kpi/obj_sys_id", ids::FcPort2KpiByObjSysId.type, True, [g::Filter::Eq]), "fp2_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: ids::FcPort2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("fc-port-2-kpi/obj_id", domain::Reference(ids::FcPort2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "fp2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::FcPort2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("fp2__sfsp", domain::endpoint(FcPort2Kpi.type, "obj_sys_id"), domain::endpoint(storage_fc_switch_port::StorageFcSwitchPort.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("fp2__sfp", domain::endpoint(FcPort2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_fc_port::KpiStorageFcPort.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
