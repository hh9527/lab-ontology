# spider-model/src/bin/make-query.telora
#
# Deterministic entry used by the Host adapter `bin/spider-make-query check`.
#
# The adapter runs:
#   telora -C spider-model eval-with @src/bin/make-query:main \
#       --source input=<input.json>
#
# `input` is a Value conforming to the ontology public flat closed intent
# protocol (ontology/docs/ONTOLOGY.md, docs/INTENT.md).  The domain resolver is
# the model-derived intent lower factory: the prepared payload is bound once
# and every input Value is lowered by the shared ontology implementation; this
# module holds no domain-specific parsing or lowering branches.
#
# On success the returned Value is the parameterized Query encoded as
#     {"sql": "...", "bindings": [...]}
# where every dynamic value lives in `bindings` and never appears in `sql`.
# Any unknown vocabulary, type error or illegal combination fails with a
# deterministic diagnostic and a non-zero exit (the Host clears ok.json).

import "@src/model" { payload };
import "ontology/intent" as intent;
import "std/dict" as dict;
import "std/entry" as entry;
import "std/codec" as codec;
import "std/value" { Value };

def config: entry.ContextConfig = {
    sources: ["input"],
    envs: [],
    args: False,
};

export def main: entry.Eval = entry.main(config, fn(ctx) {
    let raw: Value = match dict.get(ctx.sources, "input") {
        Some(value) => value,
        None => fail!("missing input source"),
    };
    let lower = intent.query_intent_lower_factory(payload, "public");
    let query = lower(raw);
    codec.encode(Value.type, query)
});
