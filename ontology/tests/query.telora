            qb.join(qb.JoinKind.Inner, qb.source("z", "endpoints"), qb.column_ref("m", "z_id"), qb.column_ref("z", "id")),
        ],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def role_alias_join_two_ends_same_target = fn() {
    let q = qb.transform_sqlite(role_alias_join_site_plan());
    q.sql == "SELECT m.id, a.name, z.name FROM movements AS m INNER JOIN endpoints AS a ON m.a_id = a.id INNER JOIN endpoints AS z ON m.z_id = z.id"
};

