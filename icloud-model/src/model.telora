# A small, deliberately incomplete model of real iMaster Cloud knowledge.
# The acceptance contract in docs/DOMAIN.md records what must NOT be inferred
# from these physical relationships until ontology has explicit semantics.

use ontology::ontology as edsl;
use ontology::query as qb;

def yes: Bool = True;
def text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def device_name_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Contains];
def link_text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Contains];
def text_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def int_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Gt, edsl::FilterOp::Ge, edsl::FilterOp::Lt];
def int_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];
def none_required: Array(Type) = [];
def online_value: edsl::CanonicalValueSpec = { id: "online", label: "Online", wires: [edsl::FilterInput::Text("0"), edsl::FilterInput::Text("online")] };
def offline_value: edsl::CanonicalValueSpec = { id: "offline", label: "Offline", wires: [edsl::FilterInput::Text("1"), edsl::FilterInput::Text("offline")] };
def other_value: edsl::CanonicalValueSpec = { id: "other", label: "Other", wires: [edsl::FilterInput::Text("other")] };
def communication_values: Array(edsl::CanonicalValueSpec) = [online_value, offline_value, other_value];
def storage_normal_value: edsl::CanonicalValueSpec = { id: "normal", label: "Normal", wires: [edsl::FilterInput::Text("1")] };
def storage_running_values: Array(edsl::CanonicalValueSpec) = [storage_normal_value];
def wac_value: edsl::CanonicalValueSpec = { id: "WAC", label: "Wireless access controller", wires: [edsl::FilterInput::Text("ne.category.ac"), edsl::FilterInput::Text("AC"), edsl::FilterInput::Text("WAC")] };
def device_class_values: Array(edsl::CanonicalValueSpec) = [wac_value];
def fault_value: edsl::CanonicalValueSpec = { id: "fault", label: "Fault", wires: [edsl::FilterInput::Int(2), edsl::FilterInput::Int(3)] };
def physical_link_status_values: Array(edsl::CanonicalValueSpec) = [fault_value];
def frame_normal_value: edsl::CanonicalValueSpec = { id: "normal", label: "Normal", wires: [edsl::FilterInput::Int(3), edsl::FilterInput::Int(11), edsl::FilterInput::Int(13), edsl::FilterInput::Int(15), edsl::FilterInput::Int(16)] };
def frame_error_value: edsl::CanonicalValueSpec = { id: "error", label: "Fault", wires: [edsl::FilterInput::Int(2), edsl::FilterInput::Int(12), edsl::FilterInput::Int(17)] };
def frame_oper_values: Array(edsl::CanonicalValueSpec) = [frame_normal_value, frame_error_value];
def event_kind: edsl::DatasetKind = edsl::DatasetKind::Event;
def entity_kind: edsl::DatasetKind = edsl::DatasetKind::Entity;
def metric_kind: edsl::DatasetKind = edsl::DatasetKind::Metric;
def device_grain: Array(String) = ["id", "tenant_id"];
def frame_grain: Array(String) = ["id", "tenant_id"];
def no_time: Option(String) = None;
def alarm_grain: Array(String) = ["csn"];
def alarm_time: Option(String) = Some("occur_utc");
def kpi_grain: Array(String) = ["res_id", "tenant_id", "ts"];
def kpi_time: Option(String) = Some("ts");
def avg_agg: qb::AggregateFunction = qb::AggregateFunction::Avg;
def sum_agg: qb::AggregateFunction = qb::AggregateFunction::Sum;
def percent_unit: Option(String) = Some("%");
def no_unit: Option(String) = None;
def utc_role: edsl::TimeSemantics = edsl::TimeSemantics::Utc;
def local_role: edsl::TimeSemantics = edsl::TimeSemantics::Local;
def utc_seconds: edsl::TimeEncoding = edsl::TimeEncoding::CanonicalUtcSecondText;
def local_text: edsl::TimeEncoding = edsl::TimeEncoding::LocalText;

@edsl::entity_id("device")
@edsl::entity_source("I_EntNetworkElement", "d")
@edsl::dataset(entity_kind, device_grain, no_time)
@edsl::dataset_description("Network device", "Network resource identified within its tenant")
@edsl::relation_description("device_located_at_site", "Located at site", "Either project or parent subnet identifies the site")
@edsl::named_relation_key("device_located_at_site", Site.type, edsl::RelationKind::Safe,
    edsl::RelationKey::Or([
        edsl::RelationKey::FieldEq({ from: "project_id", to: "site_id" }),
        edsl::RelationKey::FieldEq({ from: "ref_parent_subnet", to: "site_id" }),
    ]))
type Device = struct {
    @edsl::column("alias")
    @edsl::dimension("device_alias", yes, yes, text_ops, text_inputs)
    alias: String,
    @edsl::column("classification")
    @edsl::dimension("device_class", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(device_class_values)
    classification: String,
    @edsl::column("commu_state")
    @edsl::dimension("device_commu_state", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(communication_values)
    commu_state: String,
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::measure("device_count", qb::AggregateFunction::Count, none_required)
    @edsl::dimension("device_id", yes, yes, text_ops, text_inputs)
    id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
    @edsl::column("projectId")
    project_id: String,
    @edsl::column("refParentSubnet")
    ref_parent_subnet: String,
    @edsl::column("name")
    @edsl::dimension("device_name", yes, yes, device_name_ops, text_inputs)
    name: String,
    @edsl::column("mac")
    @edsl::dimension("device_mac", yes, yes, text_ops, text_inputs)
    mac: String,
};

@edsl::entity_id("site")
@edsl::entity_source("X_SITE_VIEW", "s")
@edsl::dataset_description("Site", "Governance site referenced by network devices")
type Site = struct {
    @edsl::column("SITE_ID")
    @edsl::key(yes)
    @edsl::dimension("site_id", yes, yes, text_ops, text_inputs)
    site_id: String,
    @edsl::column("SITE_NAME")
    @edsl::dimension("site_name", yes, yes, text_ops, text_inputs)
    site_name: String,
};

@edsl::entity_id("storage_device")
@edsl::entity_source("HuaweiStorageDevice", "sd")
@edsl::dataset_description("Storage device", "Storage resource with parent or project site ownership")
@edsl::relation_description("storage_device_site", "Located at site", "Parent resource or project identifies the site")
@edsl::named_relation_key("storage_device_site", Site.type, edsl::RelationKind::FanOut,
    edsl::RelationKey::Or([
        edsl::RelationKey::FieldEq({ from: "parent_res_id", to: "site_id" }),
        edsl::RelationKey::FieldEq({ from: "project_id", to: "site_id" }),
    ]))
type StorageDevice = struct {
    @edsl::column("id")
    @edsl::key(yes)
    id: String,
    @edsl::column("name")
    @edsl::measure("storage_device_named_count", qb::AggregateFunction::Count, none_required)
    name: String,
    @edsl::column("parentResId")
    parent_res_id: String,
    @edsl::column("projectId")
    project_id: String,
    @edsl::column("runningStatus")
    @edsl::dimension("storage_running_status", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(storage_running_values)
    running_status: String,
    @edsl::column("subClassName")
    @edsl::dimension("storage_device_subclass", yes, yes, text_ops, text_inputs)
    sub_class_name: String,
};

@edsl::entity_id("frame")
@edsl::entity_source("I_EnterpriseFrame", "f")
@edsl::dataset(entity_kind, frame_grain, no_time)
@edsl::dataset_description("Network frame", "Equipment frame belonging to a network device")
@edsl::relation_description("frame_belongs_to_device", "Belongs to device", "A frame identifies its parent device; explicit frame context repeats parent-owned KPI values per matching frame, without allocating the metric to frames")
@edsl::named_relation_key("frame_belongs_to_device", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "ref_parent_ne", to: "id" }))
type Frame = struct {
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::dimension("frame_id", yes, yes, text_ops, text_inputs)
    id: String,
    @edsl::column("name")
    @edsl::dimension("frame_name", yes, yes, text_ops, text_inputs)
    name: String,
    @edsl::column("refParentNE")
    ref_parent_ne: String,
    @edsl::column("tenantId")
    tenant_id: String,
    @edsl::column("operState")
    @edsl::dimension("frame_oper_state", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(frame_oper_values)
    oper_state: Int,
};

# KPI rows have a separate sampling grain. This entity carrier does not yet
# express MetricSet, authoritative time, aggregation policy, or metric units.
@edsl::entity_id("device_kpi")
@edsl::entity_source("NetworkDeviceKPI", "k")
@edsl::dataset_description("Device KPI samples", "UTC samples of network device measurements")
@edsl::relation_description("device_kpi_of_device", "Samples for device", "Resource and tenant identify the KPI owner")
@edsl::dataset(metric_kind, kpi_grain, kpi_time)
@edsl::named_relation_key("device_kpi_of_device", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({ from: "res_id", to: "id" }),
        edsl::RelationKey::FieldEq({ from: "tenant_id", to: "tenant_id" }),
    ]))
type DeviceKpi = struct {
    @edsl::column("resId")
    @edsl::dimension("device_kpi_res_id", yes, yes, text_ops, text_inputs)
    res_id: String,
    @edsl::column("tenantId")
    @edsl::dimension("device_kpi_tenant_id", yes, yes, text_ops, text_inputs)
    tenant_id: String,
    @edsl::column("ts")
    @edsl::time_field(utc_role, utc_seconds)
    @edsl::dimension("device_kpi_ts_raw", yes, yes, text_ops, text_inputs)
    ts: String,
    @edsl::column("cpuUsage")
    @edsl::measure("cpu_usage", avg_agg, none_required)
    @edsl::metric_value("cpu_usage", avg_agg, percent_unit)
    cpu_usage: Float,
    @edsl::column("portCount")
    @edsl::dimension("port_count_sample", yes, yes, int_ops, int_inputs)
    @edsl::measure("port_count", sum_agg, none_required)
    @edsl::metric_value("port_count", sum_agg, no_unit)
    port_count: Int,
};

# ic's GovernanceCurrentAlarm is an EventSet, not an entity. This carrier
# demonstrates only the physical composite link, not the event semantics.
# Canonical field order: csn(0), occur_utc(1), res_id(2), severity(3), tenant_id(4).
@edsl::entity_id("current_alarm")
@edsl::entity_source("T_CURRENT_ALARM", "a")
@edsl::dataset_description("Current alarm", "One alarm event per serial number with UTC occurrence time")
@edsl::relation_description("device_current_alarm", "Alarm of device", "MEDN and tenant identify the affected device")
@edsl::dataset(event_kind, alarm_grain, alarm_time)
@edsl::named_relation_key("device_current_alarm", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::And([
        edsl::RelationKey::FieldEq({ from: "res_id", to: "id" }),
        edsl::RelationKey::FieldEq({ from: "tenant_id", to: "tenant_id" }),
    ]))
type CurrentAlarm = struct {
    @edsl::column("CSN")
    @edsl::key(yes)
    @edsl::measure("alarm_count", qb::AggregateFunction::Count, none_required)
    csn: Int,
    @edsl::column("OCCUR_UTC")
    @edsl::time_field(utc_role, utc_seconds)
    occur_utc: String,
    @edsl::column("OCCUR_TIME")
    @edsl::time_field(local_role, local_text)
    occur_time: String,
    @edsl::column("MEDN")
    res_id: String,
    @edsl::column("SEVERITY")
    @edsl::dimension("alarm_severity", yes, yes, text_ops, text_inputs)
    severity: String,
    @edsl::column("TENANT_ID")
    tenant_id: String,
};

# The two endpoint roles are separate facts in ic. Here the hub-specific
# peer declaration is representable, but no stable relation IDs are exposed.
# Field names keep the endpoint roles stable as native link attributes evolve.
@edsl::entity_id("physical_link")
@edsl::entity_source("EnterprisePhysicalLink", "pl")
@edsl::dataset_description("Physical link", "Physical connection with fixed A and Z device endpoints")
@edsl::relation_description("physical_link_a_device", "A-end device", "Origin endpoint of the physical link")
@edsl::relation_description("physical_link_z_device", "Z-end device", "Peer endpoint of the physical link")
@edsl::directed_peer_hub_fields(Device.type, "id", "a_ne_res_id", Device.type, "id", "z_ne_res_id")
@edsl::named_relation_key("physical_link_a_device", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "a_ne_res_id", to: "id" }))
@edsl::named_relation_key("physical_link_z_device", Device.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "z_ne_res_id", to: "id" }))
type PhysicalLink = struct {
    @edsl::column("a_ne_res_id")
    a_ne_res_id: String,
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::dimension("physical_link_id", yes, yes, text_ops, text_inputs)
    @edsl::measure("physical_link_count", qb::AggregateFunction::Count, none_required)
    id: String,
    @edsl::column("link_status")
    @edsl::dimension("physical_link_status", yes, yes, text_ops, text_inputs)
    @edsl::canonical_values(physical_link_status_values)
    link_status: Int,
    @edsl::column("z_ne_res_id")
    z_ne_res_id: String,
    @edsl::column("aPortIp")
    @edsl::dimension("physical_link_a_port_ip", yes, yes, text_ops, text_inputs)
    a_port_ip: String,
    @edsl::column("zPortName")
    @edsl::dimension("physical_link_z_port_name", yes, yes, link_text_ops, text_inputs)
    z_port_name: String,
    @edsl::column("aNeIp")
    @edsl::dimension("physical_link_a_ne_ip", yes, yes, link_text_ops, text_inputs)
    a_ne_ip: String,
};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column,
        qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
        qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join,
        qb::Operator::Group, qb::Operator::Having, qb::Operator::Order,
        qb::Operator::Limit, qb::Operator::Offset],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Avg, qb::AggregateFunction::Sum],
    allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::Ne,
        qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt,
        qb::ScalarFunction::Ge, qb::ScalarFunction::If, qb::ScalarFunction::And, qb::ScalarFunction::Or,
        qb::ScalarFunction::Lower, qb::ScalarFunction::Instr, qb::ScalarFunction::UtcDaysAgo],
    allow_distinct: True,
};

def payload: edsl::PreparedPayload = edsl::build_root(
    "icloud-challenge-v2", [Device.type, Site.type, StorageDevice.type, Frame.type, DeviceKpi.type, CurrentAlarm.type, PhysicalLink.type],
    profile, fn(subject) { subject == "public" });

pub use self::{ Device, Site, StorageDevice, Frame, DeviceKpi, CurrentAlarm, PhysicalLink, payload };
