use crate::ontology as edsl;
use crate::intent as intent;
use crate::query as qb;
use crate::sqlite as sqlite;
use crate::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::dict as dict;
use std::json as json;
use std::string as string;
use std::test as test;
use std::value::{ Value };

@edsl::entity_id("device")
@edsl::entity_source("devices", "device")
type Device = struct {
    @edsl::column("id") @edsl::key()
    id: String,
    @edsl::column("name")
    @edsl::dimension("name", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    name: String,
};

@edsl::entity_id("sample")
@edsl::entity_source("samples", "sample")
@edsl::dataset(edsl::DatasetKind::Metric, ["id"], Some("ts"))
@edsl::named_relation_key("sample_device", Device.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::One},
    edsl::DeclaredRelationKey::FieldEq({from: "owner", to: "id"}))
type Sample = struct {
    @edsl::column("id") @edsl::key()
    id: Int,
    @edsl::column("owner")
    owner: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("time", True, True, [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::EpochMillis])
    ts: Int,
    @edsl::column("usage")
    @edsl::sample_measure("usage", qb::AggregateFunction::Avg, Some("%"))
    usage: Float,
    @edsl::column("usage")
    @edsl::sample_measure("peak", qb::AggregateFunction::Max, Some("%"))
    peak: Float,
    @edsl::column("usage")
    @edsl::measure("unitless", qb::AggregateFunction::Avg, [])
    unitless: Float,
    @edsl::column("bytes")
    @edsl::sample_measure("bytes", qb::AggregateFunction::Sum, Some("bytes"))
    bytes: Int,
    @edsl::column("label")
    @edsl::measure("label", qb::AggregateFunction::Min, [])
    label: String,
};

@edsl::entity_id("composite_device")
@edsl::entity_source("composite_devices", "cd")
@edsl::dataset(edsl::DatasetKind::Entity, ["id", "tenant"], None)
type CompositeDevice = struct {
    @edsl::column("id") id: String,
    @edsl::column("tenant") tenant: String,
    @edsl::column("name")
    @edsl::dimension("composite_name", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    name: String,
};
@edsl::entity_id("composite_sample")
@edsl::entity_source("composite_samples", "cs")
@edsl::dataset(edsl::DatasetKind::Metric, ["id"], Some("ts"))
@edsl::named_relation_key("composite_sample_device", CompositeDevice.type,
    {from: edsl::Cardinality::Many0, to: edsl::Cardinality::One},
    edsl::DeclaredRelationKey::And([
        edsl::DeclaredRelationKey::FieldEq({from: "owner", to: "id"}),
        edsl::DeclaredRelationKey::FieldEq({from: "tenant", to: "tenant"}),
    ]))
type CompositeSample = struct {
    @edsl::column("id") @edsl::key() id: Int,
    @edsl::column("owner") owner: String,
    @edsl::column("tenant") tenant: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("composite_phase", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::EpochMillis])
    ts: Int,
    @edsl::column("usage") @edsl::measure("composite_usage", qb::AggregateFunction::Avg, [])
    usage: Float,
};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column,
        qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate, qb::Operator::Filter,
        qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order, qb::Operator::Limit],
    allowed_join_kinds: [qb::JoinKind::Inner],
    allowed_aggregates: [qb::AggregateFunction::Avg, qb::AggregateFunction::Max, qb::AggregateFunction::Min, qb::AggregateFunction::Sum],
    allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::Ge, qb::ScalarFunction::Lt,
        qb::ScalarFunction::And, qb::ScalarFunction::Sub, qb::ScalarFunction::Div,
        qb::ScalarFunction::Ne, qb::ScalarFunction::Gt, qb::ScalarFunction::IsNotNull],
    allow_distinct: False,
};
@edsl::entity_id("timed_sample")
@edsl::entity_source("timed_samples", "timed")
@edsl::dataset(edsl::DatasetKind::Metric, ["owner", "ts"], Some("ts"))
type TimedSample = struct {
    @edsl::column("owner") @edsl::key()
    owner: String,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("timed_time", True, True, [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::EpochMillis])
    ts: Int,
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("timed_time_alias", True, True, [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::EpochMillis])
    ts_alias: Int,
    @edsl::column("usage")
    @edsl::sample_measure("timed_usage", qb::AggregateFunction::Avg, Some("%"))
    usage: Float,
};

@edsl::entity_id("dated_sample")
@edsl::entity_source("dated_samples", "dated")
@edsl::dataset(edsl::DatasetKind::Entity, ["owner", "day"], None)
type DatedSample = struct {
    @edsl::column("owner") @edsl::key()
    owner: String,
    @edsl::column("day")
    @edsl::time_field(edsl::TimeSemantics::DateUtc, edsl::TimeEncoding::DateText)
    @edsl::dimension("dated_day", True, True, [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::DateUtc])
    day: String,
    @edsl::column("usage") @edsl::measure("dated_usage", qb::AggregateFunction::Avg, [])
    usage: Float,
};
def payload: edsl::PreparedPayload = edsl::build_root("pair-rank-v2", [Device.type, Sample.type, CompositeDevice.type, CompositeSample.type, TimedSample.type, DatedSample.type], profile);
def lower: Fn(Value) -> qb::QueryAst = intent::query_intent_ast_factory(payload);

def graph: Fn(String, String, Int, Int) -> Value = fn(node, measure, start, end) {
    json::parse(`{"op":"Graph","root":"d","nodes":[{"id":"d","entity":"device"},{"id":"\{node}","entity":"sample"}],
        "edges":[{"relation":"sample_device","from":"\{node}","to":"d"}],"select":[],
        "group_by_identity":["d"],"measures":[{"node":"\{node}","measure":"\{measure}"}],
        "time_windows":[{"node":"\{node}","dimension":"time","start":\{start},"end":\{end}}]}`).unwrap!()
};
def rank: Fn(String, Int) -> Value = fn(direction, take) {
    json::parse(`{"op":"Subtract","minuend":"Right","subtrahend":"Left","direction":"\{direction}","take":\{take}}`).unwrap!()
};
def pair: Fn(String, String, Value) -> Value = fn(left, right, ranking) {
    Value::Object({op: Value::String("GraphPair"), left: graph("prev", left, 0, 10),
        right: graph("curr", right, 10, 20), rank_by: ranking,
        align_by: json::parse(r#"[{"left":{"node":"d"},"right":{"node":"d"}}]"#).unwrap!(),
        select: json::parse(r#"[{"side":"Left","node":"d","dimension":"name"}]"#).unwrap!()})
};
def patch: Fn(Value, Dict(Value)) -> Value = fn(value, changes) {
    match value { Value::Object(fields) => Value::Object(dict::merge(fields, changes)), _ => fail!("expected object", value) }
};

def timed_graph: Fn(String, Int, String, String) -> Value = fn(node, start, end, dimension) {
    json::parse(`{"op":"Graph","root":"\{node}","nodes":[{"id":"\{node}","entity":"timed_sample"}],"edges":[],"select":[],
        "group_by_identity":["\{node}"],"measures":[{"node":"\{node}","measure":"timed_usage"}],
        "time_windows":[{"node":"\{node}","dimension":"\{dimension}","start":\{start},"end":\{end}}]}`).unwrap!()
};
def timed_pair: Fn(Int, String, Int, String) -> Value = fn(a, b, c, d) {
    Value::Object({op: Value::String("GraphPair"), left: timed_graph("l", a, b, "timed_time"),
        right: timed_graph("r", c, d, "timed_time_alias"),
        align_by: json::parse(r#"[{"left":{"node":"l"},"right":{"node":"r"}}]"#).unwrap!(),
        select: json::parse("[]").unwrap!()})
};
pub def temporal_identity_rejects_adjacent_windows: test::Test = test::should_fail_with(fn() {
    lower(timed_pair(0, "10", 10, "20"))
}, "identity contains time field ts");
pub def temporal_identity_rejects_gapped_windows: test::Test = test::should_fail_with(fn() {
    lower(timed_pair(0, "10", 11, "20"))
}, "disjoint time windows");
pub def temporal_identity_rejects_reversed_windows: test::Test = test::should_fail_with(fn() {
    lower(timed_pair(10, "20", 0, "10"))
}, "disjoint time windows");
pub def temporal_identity_rejects_disjoint_open_window: test::Test = test::should_fail_with(fn() {
    lower(timed_pair(0, "10", 10, "null"))
}, "Align owner entities");
pub def temporal_identity_accepts_equal_windows: test::Test = test::should_ok(fn() { lower(timed_pair(0, "10", 0, "10")) });
pub def temporal_identity_accepts_overlapping_windows: test::Test = test::should_ok(fn() { lower(timed_pair(0, "10", 5, "15")) });
pub def temporal_identity_accepts_overlapping_open_windows: test::Test = test::should_ok(fn() { lower(timed_pair(0, "null", 10, "null")) });

def dated_graph: Fn(String, String, String) -> Value = fn(node, start, end) {
    json::parse(`{"op":"Graph","root":"\{node}","nodes":[{"id":"\{node}","entity":"dated_sample"}],"edges":[],"select":[],
        "group_by_identity":["\{node}"],"measures":[{"node":"\{node}","measure":"dated_usage"}],
        "time_windows":[{"node":"\{node}","dimension":"dated_day","start":"\{start}","end":"\{end}"}]}`).unwrap!()
};
def dated_pair: Fn(String) -> Value = fn(right_start) {
    patch(timed_pair(0, "10", 5, "15"), {
        left: dated_graph("l", "2026-09-01", "2026-09-10"),
        right: dated_graph("r", right_start, "2026-09-20"),
    })
};
pub def temporal_date_identity_rejects_adjacent_windows: test::Test = test::should_fail_with(fn() {
    lower(dated_pair("2026-09-10"))
}, "identity contains time field day");
pub def temporal_date_identity_accepts_overlapping_windows: test::Test = test::should_ok(fn() { lower(dated_pair("2026-09-05")) });

pub def rank_is_bound_and_uses_right_minus_left_in_both_dialects: test::Test = test::should_ok(fn() {
    let ast = lower(pair("usage", "usage", rank("Desc", 5)));
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    sq.bindings == [qb::Val::Int(0), qb::Val::Int(10), qb::Val::Int(10), qb::Val::Int(20), qb::Val::Int(5)]
        && pg.bindings == sq.bindings
        && string::contains(sq.sql, "CAST(__q_right.curr_usage AS REAL) - CAST(__q_left.prev_usage AS REAL)")
        && string::contains(sq.sql, "__q_left.prev_usage IS NOT NULL AND __q_right.curr_usage IS NOT NULL")
        && string::contains(sq.sql, "DESC, __q_left.__q_key_0 ASC NULLS FIRST")
        && !string::contains(sq.sql, "__q_key_1")
        && string::contains(sq.sql, "LIMIT ?5") && string::contains(pg.sql, "LIMIT $5")
        && string::contains(pg.sql, "AS DOUBLE PRECISION")
});
pub def matching_declared_units_allow_different_measures: test::Test = test::should_ok(fn() {
    lower(pair("usage", "peak", rank("Asc", 1000)))
});
pub def rank_rejects_different_units: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "bytes", rank("Desc", 5)))
}, "matching declared units");
pub def rank_rejects_unestablished_units: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "unitless", rank("Desc", 5)))
}, "matching declared units");
pub def rank_rejects_text_measures: test::Test = test::should_fail_with(fn() {
    lower(pair("label", "label", rank("Desc", 5)))
}, "requires numeric measures");
pub def rank_rejects_zero_take: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "usage", rank("Desc", 0)))
}, "rank take must be a positive integer within the cap");
pub def rank_rejects_excessive_take: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "usage", rank("Desc", 1001)))
}, "rank take must be a positive integer within the cap");
pub def rank_rejects_count_groups: test::Test = test::should_fail_with(fn() {
    lower(patch(pair("usage", "usage", rank("Desc", 5)), {count_groups: Value::True}))
}, "rank_by cannot be combined with count_groups");
pub def rank_rejects_unknown_operation: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "usage", patch(rank("Desc", 5), {op: Value::String("Multiply")})))
}, "supports Subtract, Ratio or GrowthRate");
pub def rank_rejects_unknown_direction: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "usage", rank("Down", 5)))
}, "direction must be Asc or Desc");
pub def rank_does_not_allow_operand_top_n: test::Test = test::should_fail_with(fn() {
    lower(patch(pair("usage", "usage", rank("Desc", 5)), {
        left: patch(graph("prev", "usage", 0, 10), {
            top_by_measure: json::parse(r#"{"node":"prev","measure":"usage","direction":"Desc","take":5}"#).unwrap!(),
        }),
    }))
}, "aggregate pair operands each require one measure");
pub def rank_rejects_invalid_ast_pagination_binding: test::Test = test::should_fail_with(fn() {
    let ast = lower(pair("usage", "usage", rank("Desc", 5)));
    sqlite::build_query({...ast, ctx: {...ast.ctx, bindings: [qb::Val::Int(0), qb::Val::Int(10), qb::Val::Int(10), qb::Val::Int(20), qb::Val::Int(1001)]}})
}, "rank take binding must contain an integer within its allowed range");

pub def rank_rejects_unknown_fields: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "usage", patch(rank("Desc", 5), {extra: Value::True})))
}, "unknown field");
pub def rank_requires_profile_authorization: test::Test = test::should_fail_with(fn() {
    let restricted = edsl::build_root("restricted", [Device.type, Sample.type],
        {...profile, allowed_scalars: array::filter(profile.allowed_scalars, fn(op) { op != qb::ScalarFunction::Sub })});
    intent::query_intent_ast_factory(restricted)(pair("usage", "usage", rank("Desc", 5)))
}, "not authorized");
pub def rank_rejects_forged_measure_alias: test::Test = test::should_fail_with(fn() {
    let ast = lower(pair("usage", "usage", rank("Desc", 5)));
    match ast.plan {
        qb::QueryPlan::JoinedGroups(joined) => match joined.rank {
            Some(ranking) => postgres::build_query({...ast, plan: qb::QueryPlan::JoinedGroups({...joined,
                rank: Some({...ranking, left_measure: "d_name"})})}),
            _ => fail!("expected rank"),
        },
        _ => fail!("expected joined groups"),
    }
}, "requires projected measure aliases");
pub def rank_rejects_forged_group_count: test::Test = test::should_fail_with(fn() {
    let ast = lower(pair("usage", "usage", rank("Desc", 5)));
    match ast.plan {
        qb::QueryPlan::JoinedGroups(joined) => sqlite::build_query({...ast, plan: qb::QueryPlan::JoinedGroupCount(joined)}),
        _ => fail!("expected joined groups"),
    }
}, "cannot rank or truncate groups");

def comparison: Fn(String, String, String) -> Value = fn(op, first, second) {
    if op == "Ratio" {
        json::parse(`{"op":"Ratio","numerator":"\{first}","denominator":"\{second}","direction":"Desc","take":1000}`).unwrap!()
    } else if op == "GrowthRate" {
        json::parse(`{"op":"GrowthRate","current":"\{first}","baseline":"\{second}","direction":"Desc","take":1000}`).unwrap!()
    } else {
        json::parse(`{"op":"Subtract","minuend":"\{first}","subtrahend":"\{second}","direction":"Desc","take":1000}`).unwrap!()
    }
};
pub def ratio_and_growth_render_guarded_floating_arithmetic: test::Test = test::should_ok(fn() {
    let ratio = lower(pair("bytes", "bytes", comparison("Ratio", "Right", "Left")));
    let growth = lower(pair("usage", "usage", comparison("GrowthRate", "Left", "Right")));
    let sq = sqlite::build_query(ratio);
    let pg = postgres::build_query(growth);
    string::contains(sq.sql, "CAST(__q_right.curr_bytes AS REAL) / NULLIF(CAST(__q_left.prev_bytes AS REAL), 0)")
        && string::contains(sq.sql, "AND __q_left.prev_bytes <> 0")
        && string::contains(pg.sql, " / NULLIF(CAST(")
        && string::contains(pg.sql, "AS DOUBLE PRECISION), 0)")
        && string::contains(pg.sql, "\"curr_usage\" > 0")
});
pub def rank_rejects_same_side_operands: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "usage", comparison("Ratio", "Left", "Left")))
}, "must reference different sides");
pub def ranked_comparison_is_projected_and_used_for_ordering: test::Test = test::should_ok(fn() {
    array::all(["Subtract", "Ratio", "GrowthRate"], fn(op) {
        let ast = lower(pair("usage", "usage", comparison(op, "Right", "Left")));
        let sq = sqlite::build_query(ast).sql;
        let pg = postgres::build_query(ast).sql;
        string::contains(sq, "AS comparison_value")
            && string::contains(sq, "ORDER BY comparison_value DESC")
            && string::contains(pg, "AS \"comparison_value\"")
            && string::contains(pg, "ORDER BY \"comparison_value\" DESC")
    })
});
pub def ranked_comparison_alias_is_reserved: test::Test = test::should_fail_with(fn() {
    let ast = lower(pair("usage", "usage", rank("Desc", 5)));
    match ast.plan {
        qb::QueryPlan::JoinedGroups(joined) => sqlite::build_query({...ast,
            plan: qb::QueryPlan::JoinedGroups({...joined, outputs: array::map(joined.outputs, fn(item) {
                if item.side == qb::PairSide::Right { {...item, alias: "comparison_value"} } else { item }
            })})}),
        _ => fail!("expected joined groups"),
    }
}, "output must name unique projected non-key columns");
pub def rank_rejects_implicit_subtract_operands: test::Test = test::should_fail_with(fn() {
    lower(pair("usage", "usage", json::parse(r#"{"op":"Subtract","direction":"Desc","take":5}"#).unwrap!()))
}, "missing required field");
pub def pair_rejects_implicit_alignment: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"GraphPair","left":{},"right":{}}"#).unwrap!())
}, "GraphPair migration");
pub def pair_rejects_operand_display_columns: test::Test = test::should_fail_with(fn() {
    lower(patch(pair("usage", "usage", rank("Desc", 5)), {
        left: patch(graph("prev", "usage", 0, 10), {
            select: json::parse(r#"[{"node":"d","dimension":"name"}]"#).unwrap!(),
        }),
    }))
}, "move operand select");
pub def pair_rejects_sample_display_columns: test::Test = test::should_fail_with(fn() {
    lower(patch(pair("usage", "usage", rank("Desc", 5)), {
        select: json::parse(r#"[{"side":"Right","node":"curr","dimension":"time"}]"#).unwrap!(),
    }))
}, "must belong to aligned identity nodes");
pub def pair_rejects_duplicate_alignment: test::Test = test::should_fail_with(fn() {
    lower(patch(pair("usage", "usage", rank("Desc", 5)), {
        align_by: json::parse(r#"[{"left":{"node":"d"},"right":{"node":"d"}},{"left":{"node":"d"},"right":{"node":"d"}}]"#).unwrap!(),
    }))
}, "unique nodes");
pub def pair_rejects_extra_group_identity: test::Test = test::should_fail_with(fn() {
    lower(patch(pair("usage", "usage", rank("Desc", 5)), {
        right: patch(graph("curr", "usage", 10, 20), {group_by_identity: json::parse(r#"["d","curr"]"#).unwrap!()}),
    }))
}, "must exactly match align_by");
pub def pair_rejects_duplicate_output_aliases: test::Test = test::should_fail_with(fn() {
    lower(patch(pair("usage", "usage", rank("Desc", 5)), {
        select: json::parse(r#"[{"side":"Left","node":"d","dimension":"name"},{"side":"Left","node":"d","dimension":"name"}]"#).unwrap!(),
    }))
}, "unique projected non-key columns");
pub def ratio_requires_division_authorization: test::Test = test::should_fail_with(fn() {
    let restricted = edsl::build_root("restricted", [Device.type, Sample.type],
        {...profile, allowed_scalars: array::filter(profile.allowed_scalars, fn(op) { op != qb::ScalarFunction::Div })});
    intent::query_intent_ast_factory(restricted)(pair("usage", "usage", comparison("Ratio", "Right", "Left")))
}, "not authorized");

# Simulate attributes resolved separately by each population; identities stay unchanged.
def label_plan: Fn(qb::Plan, qb::Expr) -> qb::Plan = fn(plan, label) {
    let original = match plan.projection[0] { qb::SelectItem::NamedExpr(named) => named.expr, _ => fail!("expected label") };
    {...plan, projection: array::map(plan.projection, fn(item) { match item {
        qb::SelectItem::NamedExpr(named) => if named.expr == original { qb::SelectItem::NamedExpr({...named, expr: label}) } else { item },
        _ => item,
    } }), grouping: array::map(plan.grouping, fn(expr) { if expr == original { label } else { expr } })}
};
def changed_labels: qb::Query = do {
    let ast = lower(patch(pair("usage", "usage", rank("Desc", 5)), {
        select: json::parse(r#"[{"side":"Right","node":"d","dimension":"name"},{"side":"Left","node":"d","dimension":"name"}]"#).unwrap!(),
    }));
    let old_label = qb::bind(ast.ctx, qb::Val::String("previous name"));
    let new_label = qb::bind(old_label.0, qb::Val::String("current name"));
    match ast.plan {
        qb::QueryPlan::JoinedGroups(joined) => sqlite::build_query({...ast, ctx: new_label.0,
            plan: qb::QueryPlan::JoinedGroups({...joined, left: label_plan(joined.left, old_label.1),
                right: label_plan(joined.right, new_label.1)})}),
        _ => fail!("expected joined groups"),
    }
};
def composite_graph: Fn(String, Int) -> Value = fn(owner, phase) {
    json::parse(`{"op":"Graph","root":"\{owner}","nodes":[{"id":"\{owner}","entity":"composite_device"},{"id":"s","entity":"composite_sample"}],
        "edges":[{"relation":"composite_sample_device","from":"s","to":"\{owner}"}],"select":[],
        "group_by_identity":["\{owner}"],"measures":[{"node":"s","measure":"composite_usage"}],
        "filters":[{"node":"s","dimension":"composite_phase","op":"Eq","value":\{phase}}]}`).unwrap!()
};
def composite_pair: Value = Value::Object({op: Value::String("GraphPair"),
    left: composite_graph("a", 1), right: composite_graph("z", 2),
    align_by: json::parse(r#"[{"left":{"node":"a"},"right":{"node":"z"}}]"#).unwrap!(),
    select: json::parse(r#"[{"side":"Right","node":"z","dimension":"composite_name"}]"#).unwrap!(),
    rank_by: rank("Desc", 5)});
pub def composite_alignment_keeps_complete_identity_without_display_keys: test::Test = test::should_ok(fn() {
    let ast = lower(composite_pair);
    match ast.plan {
        qb::QueryPlan::JoinedGroups(joined) => array::length(joined.keys) == 2
            && joined.left_identity == [qb::column(joined.left.sources[0], "id"), qb::column(joined.left.sources[0], "tenant")]
            && joined.right_identity == [qb::column(joined.right.sources[0], "id"), qb::column(joined.right.sources[0], "tenant")]
            && string::contains(postgres::build_query(ast).sql, "NULLS FIRST"),
        _ => False,
    }
});

def unranked: Value = Value::Object({op: Value::String("GraphPair"),
    left: graph("prev", "usage", 0, 10), right: graph("curr", "usage", 10, 20),
    align_by: json::parse(r#"[{"left":{"node":"d"},"right":{"node":"d"}}]"#).unwrap!(),
    select: json::parse(r#"[{"side":"Left","node":"d","dimension":"name"}]"#).unwrap!()});
pub def postgres_execution_queries: Value = codec::encode(array::concat([
    array::map([("Desc", 2), ("Asc", 2)], fn(spec) {
        postgres::build_query(lower(pair("usage", "usage", rank(spec.0, spec.1))))
    }),
    array::map(["Subtract", "Ratio", "GrowthRate"], fn(op) {
        postgres::build_query(lower(pair("usage", "usage", comparison(op, "Right", "Left"))))
    }),
    array::map(["Subtract", "Ratio", "GrowthRate"], fn(op) {
        postgres::build_query(lower(pair("usage", "usage", comparison(op, "Left", "Right"))))
    }),
    [postgres::build_query(lower(unranked))],
]));
pub def execution_queries: Value = codec::encode(array::concat([array::map([("Desc", 2), ("Asc", 2), ("Desc", 1000)], fn(spec) {
    sqlite::build_query(lower(pair("usage", "usage", rank(spec.0, spec.1))))
}), [sqlite::build_query(lower(unranked)),
    sqlite::build_query(lower(patch(unranked, {count_groups: Value::True}))),
    sqlite::build_query(lower(patch(pair("usage", "usage", rank("Desc", 2)), {
        left: patch(graph("prev", "usage", 0, 10), {
            measure_having: json::parse(r#"[{"node":"prev","measure":"usage","op":"Ge","value":20.0}]"#).unwrap!(),
        }),
    }))),
    sqlite::build_query(lower(pair("usage", "usage", comparison("Ratio", "Right", "Left")))),
    sqlite::build_query(lower(pair("usage", "usage", comparison("GrowthRate", "Right", "Left")))),
    sqlite::build_query(lower(pair("usage", "usage", comparison("Ratio", "Left", "Right")))),
    sqlite::build_query(lower(pair("usage", "usage", comparison("Subtract", "Left", "Right")))),
    changed_labels,
    sqlite::build_query(lower(pair("bytes", "bytes", comparison("Ratio", "Right", "Left")))),
    sqlite::build_query(lower(composite_pair)),
]]));
