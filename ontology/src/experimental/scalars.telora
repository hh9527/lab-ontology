# 逻辑标量使用具名类型，与其物理文本表示区分。
# 原始文本到 IPv4 的部分转换由 groups::ipv4 显式声明，失败产生 NULL。
use crate::ontology as edsl;
use std::type_desc as td;
use std::array as array;

type Ipv4 = struct(String);
pub use self::{Ipv4};
type EpochMillis = struct(Int);
type LocalEpochMillis = struct(Int);
type Rfc3339Utc = struct(String);
type LocalDateTime = struct(String);
type DateUtc = struct(String);
# 仅拆开可空包装与类型引用，不能把任意 newtype 的物理表示当作时间语义。
def time_role: Fn(Type) -> Option(edsl::TimeField) = fn(value) {
    if value == EpochMillis.type { Some({semantics: edsl::TimeSemantics::Utc, encoding: edsl::TimeEncoding::EpochMillis}) }
    else if value == LocalEpochMillis.type { Some({semantics: edsl::TimeSemantics::Local, encoding: edsl::TimeEncoding::EpochMillis}) }
    else if value == Rfc3339Utc.type { Some({semantics: edsl::TimeSemantics::Utc, encoding: edsl::TimeEncoding::Rfc3339Text}) }
    else if value == LocalDateTime.type { Some({semantics: edsl::TimeSemantics::Local, encoding: edsl::TimeEncoding::LocalText}) }
    else if value == DateUtc.type { Some({semantics: edsl::TimeSemantics::DateUtc, encoding: edsl::TimeEncoding::DateText}) }
    else if td::kind(value) == td::TypeDescKind::Ref { match td::resolve(value) { Ok(resolved) => time_role(resolved), Err(error) => fail!(error.message, value) } }
    else { None }
};
def field_time_role: Fn(Type) -> Option(edsl::TimeField) = fn(value) {
    let known = time_role(value);
    if known != None { known }
    else if td::kind(value) == td::TypeDescKind::Ref { match td::resolve(value) { Ok(resolved) => field_time_role(resolved), Err(error) => fail!(error.message, value) } }
    else if td::kind(value) == td::TypeDescKind::Enum {
        match array::find(td::variants(value), fn(variant) { variant.name == "Some" }) {
            Some(variant) => match variant.payload { Some(payload) => time_role(payload), None => None }, None => None,
        }
    } else { time_role(value) }
};
def input_kind: Fn(edsl::TimeField) -> edsl::FilterInputKind = fn(role) {
    match role.encoding {
        edsl::TimeEncoding::EpochMillis => edsl::FilterInputKind::EpochMillis,
        edsl::TimeEncoding::Rfc3339Text => edsl::FilterInputKind::DatetimeUtc,
        edsl::TimeEncoding::DateText => edsl::FilterInputKind::DateUtc,
        edsl::TimeEncoding::LocalText => edsl::FilterInputKind::LocalDateTime,
    }
};
pub use self::{EpochMillis, LocalEpochMillis, Rfc3339Utc, LocalDateTime, DateUtc, time_role, field_time_role, input_kind};
