# Example entry: a fictional knowledge request with filters, ordered sorting and
# Top N, lowered to a Plan and concretized to a parameterized SQLite Query with
# non-empty bindings via the public query delivery.
#
# The Query is encoded across the public JSON codec boundary with
# `codec.encode(Value, query)`.  Because the query `Val` carries the
# `@json.untagged` codec property, `Query.bindings` is encoded as a native JSON
# scalar array (e.g. [1, 7, "east", ...]) with no variant wrapper.

import "query/lib" as qb;
import "std/codec" as codec;
import "std/result" as result;
import "std/value" { Value };
import "@src/edsl" as edsl;
import "@src/knowledge" as knowledge;

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    let request: edsl.QueryRequest = {
        measures: [
            { id: "OrderAmount", subject: "analyst", input: 'All },
            { id: "OrderCount", subject: "analyst", input: 'All },
        ],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
            { id: "OrderWeek", subject: "analyst", input: 'None },
            { id: "CustomerTier", subject: "analyst", input: 'None },
        ],
        filters: [
            { id: "OrderRegion", subject: "analyst", op: 'Eq, input: 'Text("east") },
            { id: "OrderWeek", subject: "analyst", op: 'Ge, input: 'Text("2024-01") },
            { id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("gold") },
        ],
        ordering: [
            { target: 'Measure("OrderAmount"), direction: 'Desc },
            { target: 'Dimension("OrderRegion"), direction: 'Asc },
        ],
        limit: 'Some(5),
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let query: qb.Query = qb.transform_sqlite(plan);
    codec.encode(Value, query) |> result.unwrap
};
