};

def filtered_predicate_profile_reject = fn() {
    # Allows Eq but not the scalar itself... this profile forbids the scalar.
    let no_eq: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Aggregate, qb.Operator.Filter, qb.Operator.Group],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Substr],
        allow_distinct: True,
    };
    !qb.profile_accepts(filtered_aggregate_plan(), no_eq)
};

def filtered_aggregate_consumes_filter_capability = fn() {
    # A profile that allows the scalar `Eq` but forbids the `Filter` operator
    # must still reject a filtered aggregate: the aggregate-local predicate is
    # a Filter capability.
    let eq_but_no_filter: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Aggregate, qb.Operator.Group],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Eq],
        allow_distinct: True,
    };
    !qb.profile_accepts(filtered_aggregate_plan(), eq_but_no_filter)
};

def computed_aggregates_profile_accepts = fn() {
    qb.profile_accepts(computed_aggregate_plan(), full_profile())
};

