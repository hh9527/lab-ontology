def union_known_state: edsl::ScopePredicate = {field: 0, op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("up")};

def union_bad_text_branches: Array(edsl::UnionBranchDecl) = [
    {table: "union_int_rows", alias: "uit", columns: union_single_int_column, filter: Some(union_text_on_int)},
];
def union_bad_number_branches: Array(edsl::UnionBranchDecl) = [
    {table: "union_int_rows", alias: "uin", columns: union_single_int_column, filter: Some(union_number_on_int)},
