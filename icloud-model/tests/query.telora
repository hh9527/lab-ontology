        if relation.id == "device_kpi_of_device" { {...relation, kind: edsl::RelationKind::FanOut} }
        else { relation }
    });
    bounded_sample_plan({...payload, relations})
}, "sample qualification requires a named safe sample-to-owner relation");

pub def bounded_sample_count_rejects_owner_grain_extension: test::Test = test::should_fail_with(fn() {
