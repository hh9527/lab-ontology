use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 网络端口独立声明，保留现有 transform 契约
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type PortId = struct(String);
# 源带宽单位为 bit/s，不与 BytesPerSecond 隐式互换
use ontology::quantity::{BitsPerSecond};
@registry::entity("port_entity")
type Identity = struct {
    id: PortId
};
@registry::dataset("port", "I_EnterpriseNetworkLTP", ["id"])
@registry::roles([subject, device, tenant])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(IEnterpriseNetworkLTP.type, String.type, "ip_address"))),
            "port__ipAddress_ipv4",
            True,
            g::ipv4_filters
        ),
    ]
)
@registry::record_counts(["interface_count"])
@registry::relations(relations)
type IEnterpriseNetworkLTP = struct {
    @g::exact("port_id")
    id: PortId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @m::column("refParentNE")
    ref_parent_ne: i::DeviceId,
    @g::search("port_name")
    name: String,
    @m::column("operState")
    @v::classification(PortOperStatus_domain, "port_oper_status")
    oper_status: String,
    @m::column("adminState")
    @v::classification(PortAdminState_domain, "port__adminState")
    admin_state: String,
    @g::numeric("port__bandwidth")
    bandwidth: BitsPerSecond,
    @g::search("port__alias")
    alias: String,
    @m::column("portIndex")
    @g::exact("port__portIndex")
    port_index: String,
    @m::column("nativeId")
    @g::exact("port__nativeId")
    native_id: String,
    @g::search("port__remark")
    remark: String,
    @m::column("duplexMode")
    @g::exact("port__duplexMode")
    duplex_mode: String,
    @m::column("ipAddress")
    @g::search("port__ipAddress")
    ip_address: String,
    @m::column("ifMtu")
    @g::numeric("port__ifMtu")
    if_mtu: Int,
    @m::column("parentResId")
    @g::exact("port__parentResId")
    parent_res_id: String,
    @m::column("ifPhysAddress")
    @g::search("port__ifPhysAddress")
    if_phys_address: String,
    @m::column("ifType")
    @v::classification(PortIfType_domain, "port__ifType")
    if_type: Int,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(IEnterpriseNetworkLTP) = registry::dataset_of(IEnterpriseNetworkLTP.type);
def subject: m::Role(IEnterpriseNetworkLTP) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(IEnterpriseNetworkLTP.type, PortId.type, "id"),
            m::field(Identity.type, PortId.type, "id")
        )
    ]
);
def device: m::Role(IEnterpriseNetworkLTP) = m::role(
    dataset,
    i::device,
    "device",
    False,
    [
        m::identity_part(
            m::field(IEnterpriseNetworkLTP.type, i::DeviceId.type, "ref_parent_ne"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def tenant: m::Role(IEnterpriseNetworkLTP) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(IEnterpriseNetworkLTP.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type PortOperStatus = enum {
    @ev::rename("active")
    Up,
    @ev::rename("inactive")
    Down,
    @ev::rename("unknown")
    Unknown,
};
def PortOperStatus_domain: v::Domain(PortOperStatus, String) = v::from_enum(
    "PortOperStatus",
    PortOperStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type PortAdminState = enum {
    @ev::rename("active")
    Up,
    @ev::rename("inactive")
    Down,
    @ev::rename("test")
    Planning,
};
def PortAdminState_domain: v::Domain(PortAdminState, String) = v::from_enum(
    "PortAdminState",
    PortAdminState.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type PortIfType = enum {
    @ev::itag(1)
    Other,
    @ev::itag(2)
    Ethernet,
    @ev::itag(3)
    EthTrunk,
    @ev::itag(4)
    VirtualEthernet,
    @ev::itag(5)
    Atm,
    @ev::itag(6)
    Pos,
    @ev::itag(7)
    Serial,
    @ev::itag(8)
    Vlanif,
    @ev::itag(9)
    E1,
    @ev::itag(10)
    T1,
    @ev::itag(11)
    Cpos,
    @ev::itag(12)
    Tunnel,
    @ev::itag(13)
    Loopback,
    @ev::itag(14)
    IpTrunk,
    @ev::itag(15)
    VirtualTemplate,
    @ev::itag(16)
    RingIf,
    @ev::itag(17)
    Mfr,
    @ev::itag(18)
    MpGroup,
    @ev::itag(19)
    Aux,
    @ev::itag(20)
    E3,
    @ev::itag(21)
    T3,
    @ev::itag(22)
    Meth,
    @ev::itag(23)
    Null,
    @ev::itag(24)
    Rpr,
    @ev::itag(25)
    Epon,
    @ev::itag(26)
    WlanEss,
    @ev::itag(27)
    Gpon,
    @ev::itag(28)
    WlanDbss,
    @ev::itag(29)
    WlanMesh,
    @ev::itag(30)
    Vbdif,
    @ev::itag(31)
    Nve,
    @ev::itag(32)
    Cellular,
    @ev::itag(33)
    Ubr,
    @ev::itag(34)
    UbrE,
    @ev::itag(35)
    Hl,
    @ev::itag(1025)
    Flexe1025,
    @ev::itag(65559)
    Flexe65559,
    @ev::itag(65635)
    Flexe65635,
};
def PortIfType_domain: v::Domain(PortIfType, Int) = v::from_enum(
    "PortIfType",
    PortIfType.type,
    Int.type,
    False
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def relations: Array(r::Relation) = [
    r::relation(
        "port_belongs_to_device",
        r::endpoint(dataset.row, device.id),
        r::endpoint(i::devices.row, i::device_subject.id),
        cardinality
    ),
    r::relation(
        "source_EntNetworkElement_EnterpriseNetworkLTP",
        r::endpoint(i::devices.row, i::device_subject.id),
        r::endpoint(dataset.row, device.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EnterpriseNetworkLTP_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        cardinality
    ),
];
pub use self::{relations, PortId, Identity, entity, dataset, subject};

pub use self::{IEnterpriseNetworkLTP};
