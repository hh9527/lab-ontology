use crate::shared_types as shared;
# 共享数量类型、单位、计算能力及展示规则。
# 使用 Float 表示物理量，避免整数除法改变速率结果。
# 开放数量类型可共享，但不参与由领域词汇发起的反向导航。
# 比例类型声明自身尺度；KiB/MiB/GiB 是二进制容量单位，与十进制容量分别表达。
use std::prelude as prelude;
use std::type_desc as td;
use std::type_property as property;
use std::array as array;

type Calculation = enum {
    Compare,
    Mean,
    Min,
    Max,
    Round,
    Difference,
    Ratio,
    GrowthRate,
    Sum,
    Add,
    Subtract,
    Multiply,
    Divide,
    Negate,
};
@prelude::property(PropertyTarget::Type)
type Calculations = struct {
    allowed: Array(Calculation)
};
def calculations: Fn(Array(Calculation)) -> Fn(Type, Option(Calculations)) -> Calculations = fn(
    allowed
) {
    fn(ctx, previous) {
        if !numeric_storage(ctx) {
            fail!("calculations requires numeric storage", ctx)
        } else {
            ()
        };
        if previous != None {
            fail!("calculations must be declared once", ctx)
        } else {
            ()
        };
        if array::any(
            allowed,
            fn(op) {
                array::length(
                    array::filter(
                        allowed,
                        fn(other) {
                            other == op
                        }
                    )
                ) != 1
            }
        ) {
            fail!("duplicate calculation capability", ctx)
        } else {
            ()
        };
        {allowed}
    }
};
@prelude::property(PropertyTarget::Type)
type DisplayScale = struct {
    multiplier: Float,
    suffix: String
};
@prelude::property(PropertyTarget::Type)
type DisplayPrecision = struct {
    digits: Int
};
def display_precision: Fn(Int) -> Fn(Type, Option(DisplayPrecision)) -> DisplayPrecision = fn(
    digits
) {
    fn(ctx, previous) {
        if !numeric_storage(ctx) || digits < 0 || digits > 12 || previous != None {
            fail!(
                "display_precision requires numeric storage, digits 0..12 and one declaration",
                ctx
            )
        } else {
            ()
        };
        {digits}
    }
};
def display_digits: Fn(Type) -> Option(Int) = fn(ty) {
    match property::get_type_prop(ty, DisplayPrecision.type) {
        Some(value) => Some(value.digits),
        None => do {
            let body = if td::kind(ty) == td::TypeDescKind::Ref {
                match td::resolve(ty) {
                    Ok(value) => value,
                    Err(error) => fail!(error.message)
                }
            } else {
                ty
            };
            if td::kind(body) == td::TypeDescKind::Newtype {
                display_digits(td::children(body)[0])
            } else {
                None
            }
        },
    }
};
def display_scale: Fn(Float, String) -> Fn(Type, Option(DisplayScale)) -> DisplayScale = fn(
    multiplier,
    suffix
) {
    fn(ctx, previous) {
        if !numeric_storage(ctx) || multiplier <= 0.0 || previous != None {
            fail!(
                "display_scale requires numeric storage, positive multiplier and one declaration",
                ctx
            )
        } else {
            ()
        };
        {multiplier, suffix}
    }
};
def display_policy: Fn(Type) -> Option(DisplayScale) = fn(ty) {
    match property::get_type_prop(ty, DisplayScale.type) {
        Some(policy) => Some(policy),
        None => do {
            let body = if td::kind(ty) == td::TypeDescKind::Ref {
                match td::resolve(ty) {
                    Ok(value) => value,
                    Err(error) => fail!(error.message)
                }
            } else {
                ty
            };
            if td::kind(body) == td::TypeDescKind::Newtype {
                display_policy(td::children(body)[0])
            } else {
                None
            }
        },
    }
};
# 比例允许声明的比较与统计；差值保留兼容业务类型，比值与增长率使用 Ratio，禁止直接求和。
@calculations(
    [
        Calculation::Compare,
        Calculation::Mean,
        Calculation::Min,
        Calculation::Max,
        Calculation::Round,
        Calculation::Difference,
        Calculation::Ratio,
        Calculation::GrowthRate
    ]
)
@shared::identity("Percent")
@display_scale(1.0, "%")
@unit("%", "ratio", 0.01)
type Percent = struct(Float);
@calculations(
    [
        Calculation::Compare,
        Calculation::Mean,
        Calculation::Min,
        Calculation::Max,
        Calculation::Round,
        Calculation::Difference,
        Calculation::Ratio,
        Calculation::GrowthRate
    ]
)
@shared::identity("Ratio")
@display_scale(100.0, "%")
@unit("1", "ratio", 1.0)
type Ratio = struct(Float);
@prelude::property(PropertyTarget::Type)
type Unit = struct {
    symbol: String,
    quantity: String,
    scale: Float
};
# scale 表示相对于该量纲基准单位的倍率，不触发隐式换算。
def unit: Fn(String, String, Float) -> Fn(td::TypeDesc, Option(Unit)) -> Unit = fn(
    symbol,
    quantity,
    scale
) {
    fn(ctx, previous) {
        if symbol == "" || quantity == "" || scale <= 0.0 {
            fail!("unit requires a symbol, quantity and positive scale")
        } else {
            {symbol, quantity, scale}
        }
    }
};
@prelude::property(PropertyTarget::Field)
type FieldUnit = struct {
    unit: Unit
};
# 字段值保留数据库尺度，scale 只描述倍率，不触发隐式转换或授予计算能力。
def field_unit: Fn(
    String,
    String,
    Float
) -> Fn(property::FieldPropertyCtx, Option(FieldUnit)) -> FieldUnit = fn(symbol, quantity, scale) {
    if symbol == "" || quantity == "" || scale <= 0.0 {
        fail!("field_unit requires a symbol, quantity and positive scale")
    } else {
        ()
    };
    fn(ctx, previous) {
        if previous != None {
            fail!("field unit must be declared once", ctx.name)
        } else {
            ()
        };
        if !numeric_storage(ctx.ty) {
            fail!("field_unit requires Int or Float, optionally nullable", ctx.name)
        } else {
            ()
        };
        {unit: {symbol, quantity, scale}}
    }
};
def numeric_storage: Fn(Type) -> Bool = fn(ty) {
    if ty == Float.type || ty == Int.type {
        True
    } else if td::kind(ty) == td::TypeDescKind::Ref {
        match td::resolve(ty) {
            Ok(value) => numeric_storage(value),
            Err(_) => False
        }
    } else if td::kind(ty) == td::TypeDescKind::Newtype {
        numeric_storage(td::children(ty)[0])
    } else if td::kind(ty) == td::TypeDescKind::Enum {
        let variants = td::variants(ty);
        array::length(variants) == 2 && array::any(
            variants,
            fn(v) {
                v.name == "None" && v.payload == None
            }
        ) && array::any(
            variants,
            fn(v) {
                v.name == "Some" && match v.payload {
                    Some(value) => numeric_storage(value),
                    None => False
                }
            }
        )
    } else {
        False
    }
};
def calculation_policy: Fn(Type) -> Option(Array(Calculation)) = fn(ty) {
    let body = if td::kind(ty) == td::TypeDescKind::Ref {
        match td::resolve(ty) {
            Ok(value) => value,
            Err(error) => fail!(error.message)
        }
    } else {
        ty
    };
    let inherited = if td::kind(body) == td::TypeDescKind::Newtype {
        calculation_policy(td::children(body)[0])
    } else {
        None
    };
    match property::get_type_prop(ty, Calculations.type) {
        Some(spec) => Some(
            match inherited {
                Some(parent) => if array::any(
                    spec.allowed,
                    fn(op) {
                        !array::any(
                            parent,
                            fn(p) {
                                p == op
                            }
                        )
                    }
                ) {
                    fail!("newtype calculations cannot exceed inner type capabilities", ty)
                } else {
                    spec.allowed
                },
                None => spec.allowed,
            }
        ),
        None => inherited,
    }
};
# Nominal business quantities inherit physical units without becoming interchangeable.
def unit_of: Fn(Type) -> Option(Unit) = fn(ty) {
    match property::get_type_prop(ty, Unit.type) {
        Some(value) => Some(value),
        None => {
            let body = if td::kind(ty) == td::TypeDescKind::Ref {
                match td::resolve(ty) {
                    Ok(value) => value,
                    Err(error) => fail!(error.message)
                }
            } else {
                ty
            };
            if td::kind(body) == td::TypeDescKind::Newtype {
                unit_of(td::children(body)[0])
            } else if td::kind(body) == td::TypeDescKind::Enum {
                let variants = td::variants(body);
                if array::length(variants) == 2 && array::any(
                    variants,
                    fn(v) {
                        v.name == "None" && v.payload == None
                    }
                ) {
                    match array::find(
                        variants,
                        fn(v) {
                            v.name == "Some"
                        }
                    ) {
                        Some(v) => match v.payload {
                            Some(value) => unit_of(value),
                            None => None
                        },
                        None => None
                    }
                } else {
                    None
                }
            } else {
                None
            }
        }
    }
};
# Linear quantities can be added and compared, but not multiplied into the same unit.
@prelude::property(PropertyTarget::Type)
type MeanResult = struct {
    value: Type
};
def mean_result: Fn(Type) -> Fn(Type, Option(MeanResult)) -> MeanResult = fn(value) {
    fn(ctx, previous) {
        {value}
    }
};
def mean_result_type: Fn(Type) -> Option(Type) = fn(ty) {
    match property::get_type_prop(ty, MeanResult.type) {
        Some(spec) => Some(spec.value),
        None => {
            let body = if td::kind(ty) == td::TypeDescKind::Ref {
                match td::resolve(ty) {
                    Ok(value) => value,
                    Err(error) => fail!(error.message)
                }
            } else {
                ty
            };
            if td::kind(body) == td::TypeDescKind::Newtype {
                mean_result_type(td::children(body)[0])
            } else {
                None
            }
        }
    }
};
def linear: Fn(Type, Option(Calculations)) -> Calculations = calculations(
    [
        Calculation::Compare,
        Calculation::Mean,
        Calculation::Min,
        Calculation::Max,
        Calculation::Round,
        Calculation::Difference,
        Calculation::Ratio,
        Calculation::GrowthRate,
        Calculation::Sum,
        Calculation::Add,
        Calculation::Subtract
    ]
);
@unit("dBm", "power_level", 1.0)
@calculations(
    [
        Calculation::Compare,
        Calculation::Mean,
        Calculation::Min,
        Calculation::Max,
        Calculation::Round,
        Calculation::Difference
    ]
)
