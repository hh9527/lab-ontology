use crate::model::{ payload };
use ontology::intent as intent;
use std::codec::{ encode, Value };
use std::json as json;

pub def qualified_observation: Value = encode(intent::query_intent_lower_factory(payload, "public")(
    json::parse(`{"op":"observe_qualified","measures":[],"dimensions":["device_name","port_count_sample","device_kpi_ts_raw"],"filters":[],"ordering":[{"target":"Dimension","id":"device_kpi_ts_raw","direction":"Asc"}],"limit":1000,"offset":null,"owner":"device","relation":"device_kpi_of_device","window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[{"dimension":"port_count_sample","op":"gt","kind":"int","value":90}],"window":{"start":"2024-01-31T00:00:00Z","end":"2024-03-01T00:00:00Z"},"min_matches":3}]}`).unwrap!()
));

pub def qualified_count: Value = encode(intent::query_intent_lower_factory(payload, "public")(
    json::parse(`{"op":"qualify_metrics","measures":["device_count"],"dimensions":[],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"cpu_usage","op":"ge","kind":"int","value":40}},{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-10T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"port_count","op":"ge","kind":"int","value":8}}]}`).unwrap!()
));

pub def grouped_observation: Value = encode(intent::query_intent_lower_factory(payload, "public")(
    json::parse(`{"op":"observe_qualified","measures":["port_count"],"dimensions":["device_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"device","relation":"device_kpi_of_device","window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[{"dimension":"port_count_sample","op":"gt","kind":"int","value":0}],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"min_matches":1}]}`).unwrap!()
));
