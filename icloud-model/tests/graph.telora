pub def port_kpi_threshold_groups_samples_per_port: test::Test = test::should_ok(fn() {
    let query = lower(port_kpi_intent());
    if string::contains(query.sql, "EXISTS (SELECT 1 FROM I_EnterpriseNetworkLTP AS port")
        && string::contains(query.sql, "INNER JOIN NetworkDeviceInterfaceKPI AS sample")
        && string::contains(query.sql, "GROUP BY port.id")
        && string::contains(query.sql, "HAVING avg(sample.ifOutPktSpeed) >") { True }
    else { fail!(`port sample qualification lost its per-port grain: \{query.sql}`, query.bindings) }
});

pub def port_kpi_threshold_materializes_in_postgres: test::Test = test::should_ok(fn() {
    let query = postgres::build_query(query_intent_ast_factory(payload, "public")(port_kpi_intent()));
    if string::contains(query.sql, "GROUP BY \"port\".\"id\" HAVING avg(\"sample\".\"ifOutPktSpeed\") > $2")
        && query.bindings == [qb::Val::String("uplink"), qb::Val::Float(80.0)] { True }
    else { fail!(`PostgreSQL lost the per-port qualification: \{query.sql}`, query.bindings) }
});

pub def interface_top_three_ranks_declared_raw_packet_rate: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{
        "op":"graph", "root":"port",
        "nodes":[{"id":"port","entity":"port"},{"id":"sample","entity":"interface_kpi"}],
        "edges":[{"relation":"interface_kpi_of_port","from":"sample","to":"port"}],
        "select":[{"node":"port","dimension":"port_name"},
                  {"node":"sample","dimension":"interface_tx_sample"},
                  {"node":"sample","dimension":"interface_kpi_ts_raw"}],
        "top_per":{"owner":"port","sample":"sample","rank":"interface_tx_sample","take":3}
    }"#).unwrap!();
    let ast = query_intent_ast_factory(payload, "public")(intent);
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "PARTITION BY port.id")
        && string::contains(sq.sql, "ORDER BY sample.ifOutPktSpeed DESC")
        && string::contains(sq.sql, "sample.ts ASC")
        && string::contains(pg.sql, "ORDER BY \"sample\".\"ifOutPktSpeed\" DESC")
        && sq.bindings == [qb::Val::Int(3)] && pg.bindings == [qb::Val::Int(3)] { True }
    else { fail!("interface top-three lost packet-rate rank or stable sample tie-breaker", sq, pg) }
});

