use ontology::knowledge as knowledge;
use ontology::knowledge_policy as policy;
use ontology::scalars as s;
use std::test as test;

@knowledge::reverse_references(False)
type SharedCode = struct(
    String
);
@knowledge::reverse_references(True)
type BusinessTime = struct(
    s::DateTimeUtc
);
type OrdinaryCode = struct(
    String
);
type WrappedCode = struct(
    BusinessTime
);
@knowledge::reverse_references(True)
type OptInCode = struct(
    String
);

pub def custom_type_can_disable_reverse_references: test::Test = test::should_ok(
    fn() {
        !policy::allows_reverse_references(SharedCode.type)
    }
);
pub def ordinary_types_disable_reverse_references: test::Test = test::should_ok(
    fn() {
        !policy::allows_reverse_references(OrdinaryCode.type)
    }
);
pub def policy_does_not_follow_storage: test::Test = test::should_ok(
    fn() {
        !policy::allows_reverse_references(WrappedCode.type) && policy::allows_reverse_references(
            BusinessTime.type
        )
    }
);
pub def all_time_scalars_disable_reverse_references: test::Test = test::should_ok(
    fn() {
        !policy::allows_reverse_references(s::Date.type) && !policy::allows_reverse_references(
            s::DateTime.type
        ) && !policy::allows_reverse_references(s::DateTimeUtc.type) && !policy::allows_reverse_references(
            s::EpochMillis.type
        )
    }
);

# A tiny publication fixture verifies property → JSON → static JS → plugin.
use ontology::transform as t;
use ontology::world as w;
use ontology::query as qb;
use std::value::{Value};
def profile: qb::PlanProfile = {
    allowed_operators: [],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [],
    allow_distinct: False
};
use ontology::model as m;
type PolicyIdentity = struct {
    date: s::Date,
    datetime: s::DateTime,
    utc: s::DateTimeUtc,
    epoch: s::EpochMillis,
    shared: SharedCode,
    ordinary: OrdinaryCode,
    opted: OptInCode
};
def fixture: w::World = w::with_entities(
    w::define("reference-policy", [], [], [], [], profile),
    [w::entity(m::entity("policy", PolicyIdentity.type))]
);
pub def policy_publication: Value = w::publication(fixture, w::prepare(fixture));
