# 独立 transform 声明；单位、grain 与关系只采用既有公开契约。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::samples as samples;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
type EffectiveCount = struct(Int);
type ResourceId = struct(String);
# TODO(#58)：KB 的字节倍率未确认；不提供隐式转换。
type Kilobytes = struct(Float);
def io_size_statistics: samples::Group(Kilobytes) = samples::group("storage_io_size_kb", Kilobytes.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("KB"));
type Row = struct {
    source_ts: s::DateTimeUtc,
    source_resId: ResourceId,
    source_utility: p::Percent,
    source_avgreadiosize: Kilobytes,
    source_avgwriteiosize: Kilobytes,
    source_utilityEffcnt: EffectiveCount,
    source_avgreadiosizeEffcnt: EffectiveCount,
    source_avgwriteiosizeEffcnt: EffectiveCount,
};
def dataset: m::Dataset(Row) = m::dataset("source_StorageHardDriveKPI", "StorageHardDriveKPI", Row.type, ["source_resId", "source_ts"]);
def raw: t::Declaration = t::map_columns(t::declare(dataset, [], [
    g::dimension(dataset, g::dimension_group("source_StorageHardDriveKPI__ts", s::DateTimeUtc.type, True, g::numeric_filters), g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), "source_StorageHardDriveKPI__ts", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Hour), "source_StorageHardDriveKPI_utc_hour", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Day), "source_StorageHardDriveKPI_utc_day", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Month), "source_StorageHardDriveKPI_utc_month", True, g::time_filters),
    i::exact(dataset, m::field(Row.type, ResourceId.type, "source_resId"), "source_StorageHardDriveKPI__resId"),
    g::dimension(dataset, g::dimension_group("source_StorageHardDriveKPI__utility", p::Percent.type, True, g::numeric_filters), g::input(m::field(Row.type, p::Percent.type, "source_utility")), "source_StorageHardDriveKPI__utility", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_StorageHardDriveKPI__avgreadiosize", Kilobytes.type, True, g::numeric_filters), g::input(m::field(Row.type, Kilobytes.type, "source_avgreadiosize")), "source_StorageHardDriveKPI__avgreadiosize", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_StorageHardDriveKPI__avgwriteiosize", Kilobytes.type, True, g::numeric_filters), g::input(m::field(Row.type, Kilobytes.type, "source_avgwriteiosize")), "source_StorageHardDriveKPI__avgwriteiosize", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_StorageHardDriveKPI__utilityEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_utilityEffcnt")), "source_StorageHardDriveKPI__utilityEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_StorageHardDriveKPI__avgreadiosizeEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_avgreadiosizeEffcnt")), "source_StorageHardDriveKPI__avgreadiosizeEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_StorageHardDriveKPI__avgwriteiosizeEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_avgwriteiosizeEffcnt")), "source_StorageHardDriveKPI__avgwriteiosizeEffcnt", True, g::numeric_filters),
], []), [
    t::column(m::field(Row.type, s::DateTimeUtc.type, "source_ts"), "ts"),
    t::column(m::field(Row.type, ResourceId.type, "source_resId"), "resId"),
    t::column(m::field(Row.type, p::Percent.type, "source_utility"), "utility"),
    t::column(m::field(Row.type, Kilobytes.type, "source_avgreadiosize"), "avgreadiosize"),
    t::column(m::field(Row.type, Kilobytes.type, "source_avgwriteiosize"), "avgwriteiosize"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_utilityEffcnt"), "utilityEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_avgreadiosizeEffcnt"), "avgreadiosizeEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_avgwriteiosizeEffcnt"), "avgwriteiosizeEffcnt"),
]);
def declaration: t::Declaration = t::with_samples(t::metric(raw, m::field(Row.type, s::DateTimeUtc.type, "source_ts")), [
    samples::bind(dataset, p::Percent_statistics, m::field(Row.type, p::Percent.type, "source_utility"), [{statistic: samples::Statistic::Mean, publish: "storage_disk_usage"}, {statistic: samples::Statistic::Max, publish: "storage_disk_usage_max"}, {statistic: samples::Statistic::Min, publish: "storage_disk_usage_min"}]),
    samples::bind(dataset, io_size_statistics, m::field(Row.type, Kilobytes.type, "source_avgreadiosize"), [{statistic: samples::Statistic::Mean, publish: "storage_disk_read_io_size"}, {statistic: samples::Statistic::Max, publish: "storage_disk_read_io_size_max"}, {statistic: samples::Statistic::Min, publish: "storage_disk_read_io_size_min"}]),
    samples::bind(dataset, io_size_statistics, m::field(Row.type, Kilobytes.type, "source_avgwriteiosize"), [{statistic: samples::Statistic::Mean, publish: "storage_disk_write_io_size"}, {statistic: samples::Statistic::Max, publish: "storage_disk_write_io_size_max"}, {statistic: samples::Statistic::Min, publish: "storage_disk_write_io_size_min"}]),
]);
pub use self::{declaration};
