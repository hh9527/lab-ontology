use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 保留暂定租户／资源／UTC 样本身份，生产唯一性仍待 #51 确认。
use super::inventory as i;
use super::ap_quantities as a;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::quantity as q;
use ontology::samples as samples;
use ontology::values as v;
use ontology::query as qb;
type ResourceId = struct(String);
@domain::subject("ApRadio", "source_resId")
@domain::dataset(
    "source_NetworkApRadioKPI",
    "NetworkApRadioKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
type NetworkApRadioKPI = struct {
    @m::column("ts")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__ts",
            s::DateTimeUtc.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__ts",
        True,
        g::numeric_filters
    )
    @g::utc_bucket_view("source_NetworkApRadioKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkApRadioKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkApRadioKPI_utc_month", qb::UtcBucketUnit::Month)
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkApRadioKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkApRadioKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_NetworkApRadioKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_NetworkApRadioKPI__projectId")
    source_projectId: String,
    @m::column("frequency")
    @v::classification(frequencies, "source_NetworkApRadioKPI__frequency")
    source_frequency: String,
    @m::column("channel")
    @g::exact("source_NetworkApRadioKPI__channel")
    source_channel: String,
    @m::column("radioName")
    @g::search("source_NetworkApRadioKPI__radioName")
    source_radioName: String,
    @m::column("hwRadioChUtilizationRate")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__hwRadioChUtilizationRate",
            p::Percent.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__hwRadioChUtilizationRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        p::Percent_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_channel_usage"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_channel_usage_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_channel_usage_min"}
        ]
    )
    source_hwRadioChUtilizationRate: p::Percent,
    @m::column("hwRadioNoise")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__hwRadioNoise",
            p::Dbm.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__hwRadioNoise",
        True,
        g::numeric_filters
    )
    @samples::field(
        p::Dbm_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_noise"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_noise_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_noise_min"}
        ]
    )
    source_hwRadioNoise: p::Dbm,
    @m::column("hwWlanRadioRetryFramesRate")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__hwWlanRadioRetryFramesRate",
            p::Percent.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__hwWlanRadioRetryFramesRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        p::Percent_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_retry_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_retry_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_retry_rate_min"}
        ]
    )
    source_hwWlanRadioRetryFramesRate: p::Percent,
    @m::column("upwardSpeed")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__upwardSpeed",
            a::IntegerKilobitsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__upwardSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        a::integer_rate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_uplink_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_uplink_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_uplink_rate_min"}
        ]
    )
    source_upwardSpeed: a::IntegerKilobitsPerSecond,
    @m::column("downwardSpeed")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__downwardSpeed",
            a::IntegerKilobitsPerSecond.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__downwardSpeed",
        True,
        g::numeric_filters
    )
    @samples::field(
        a::integer_rate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_downlink_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_downlink_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_downlink_rate_min"}
        ]
    )
    source_downwardSpeed: a::IntegerKilobitsPerSecond,
    @m::column("packetLossRate")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__packetLossRate",
            p::Percent.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__packetLossRate",
        True,
        g::numeric_filters
    )
    @samples::field(
        p::Percent_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_packet_loss_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_packet_loss_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_packet_loss_rate_min"}
        ]
    )
    source_packetLossRate: p::Percent,
    @m::column("connectedTerminals")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__connectedTerminals",
            q::Count.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__connectedTerminals",
        True,
        g::numeric_filters
    )
    @samples::field(
        a::count_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_connected_terminals"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_connected_terminals_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_connected_terminals_min"}
        ]
    )
    source_connectedTerminals: q::Count,
    @m::column("rssi")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__rssi",
            a::ReportedRssi.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__rssi",
        True,
        g::numeric_filters
    )
    @samples::field(
        a::rssi_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_rssi"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_rssi_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_rssi_min"}
        ]
    )
    source_rssi: a::ReportedRssi,
    @m::column("hwRadioChUtilizationRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__hwRadioChUtilizationRateEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__hwRadioChUtilizationRateEffcnt",
        True,
        g::numeric_filters
    )
    source_hwRadioChUtilizationRateEffcnt: a::EffectiveCount,
    @m::column("hwRadioNoiseEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__hwRadioNoiseEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__hwRadioNoiseEffcnt",
        True,
        g::numeric_filters
    )
    source_hwRadioNoiseEffcnt: a::EffectiveCount,
    @m::column("hwWlanRadioRetryFramesRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__hwWlanRadioRetryFramesRateEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__hwWlanRadioRetryFramesRateEffcnt",
        True,
        g::numeric_filters
    )
    source_hwWlanRadioRetryFramesRateEffcnt: a::EffectiveCount,
    @m::column("upwardSpeedEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__upwardSpeedEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__upwardSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_upwardSpeedEffcnt: a::EffectiveCount,
    @m::column("downwardSpeedEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__downwardSpeedEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__downwardSpeedEffcnt",
        True,
        g::numeric_filters
    )
    source_downwardSpeedEffcnt: a::EffectiveCount,
    @m::column("packetLossRateEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__packetLossRateEffcnt",
            a::EffectiveCount.type,
            True,
            g::numeric_filters
        ),
        "source_NetworkApRadioKPI__packetLossRateEffcnt",
        True,
