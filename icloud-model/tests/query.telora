use crate::model::{ payload };
use ontology::intent as intent;
use ontology::ontology as edsl;
use ontology::query as qb;
use std::array as array;
use std::json as json;
use std::string as string;
use std::test as test;
use std::value::{ Value };

def yes: Bool = True;
def eq_only: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def text_only: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def invalid_value: edsl::CanonicalValueSpec = {
    id: "bad", label: "Bad", wires: [edsl::FilterInput::Text("wrong-type")],
};
def invalid_values: Array(edsl::CanonicalValueSpec) = [invalid_value];

@edsl::entity_source("invalid_sample", "iv")
type InvalidMapping = struct {
    @edsl::column("id")
    @edsl::key(yes)
    id: Int,
    @edsl::column("state")
    @edsl::dimension("invalid_state", yes, yes, eq_only, text_only)
    @edsl::canonical_values(invalid_values)
    state: Int,
};

@edsl::entity_source("valid_target", "vt")
type ValidTarget = struct {
    @edsl::column("id")
    @edsl::key(yes)
    id: Int,
};

@edsl::entity_source("bad_relation", "br")
@edsl::relation_key(ValidTarget.type, edsl::RelationKind::Safe,
    edsl::RelationKey::FieldEq({ from: "missing", to: "id" }))
type InvalidRelation = struct {
    @edsl::column("id")
    @edsl::key(yes)
    id: Int,
};

@edsl::entity_source("bad_peer_hub", "bph")
@edsl::directed_peer_hub_fields(ValidTarget.type, "id", "missing", ValidTarget.type, "id", "peer_id")
type InvalidPeerHub = struct {
    @edsl::column("id")
    @edsl::key(yes)
    id: Int,
    @edsl::column("peer_id")
    peer_id: Int,
};

pub def unknown_named_peer_hub_endpoint_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-peer-hub-v1", [ValidTarget.type, InvalidPeerHub.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "unknown peer hub origin endpoint field");

pub def unknown_relation_field_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid-relation-v1", [ValidTarget.type, InvalidRelation.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "unknown relation source field");

def bad_metric_kind: edsl::DatasetKind = edsl::DatasetKind::Metric;
def bad_grain: Array(String) = ["not_a_field"];
def bad_time: Option(String) = Some("ts");

@edsl::entity_source("broken_metric", "bm")
@edsl::dataset(bad_metric_kind, bad_grain, bad_time)
type BrokenMetric = struct {
    @edsl::column("ts")
    ts: String,
};

pub def unknown_grain_field_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-grain-v1", [BrokenMetric.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "unknown dataset grain field");

def missing_time_grain: Array(String) = ["id"];
def missing_time: Option(String) = None;

@edsl::entity_source("broken_event", "be")
@edsl::dataset(bad_metric_kind, missing_time_grain, missing_time)
type MissingUtcMetric = struct {
    @edsl::column("id")
    id: String,
};

pub def metric_without_utc_time_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-time-v1", [MissingUtcMetric.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "event and metric datasets require an authoritative UTC field");

def wrong_aggregate: qb::AggregateFunction = qb::AggregateFunction::Sum;
def right_aggregate: qb::AggregateFunction = qb::AggregateFunction::Avg;
def no_metric_unit: Option(String) = None;
def metric_grain: Array(String) = ["ts"];
def metric_time: Option(String) = Some("ts");
def utc_encoding_for_tests: edsl::TimeEncoding = edsl::TimeEncoding::CanonicalUtcSecondText;
def local_encoding_for_tests: edsl::TimeEncoding = edsl::TimeEncoding::LocalText;
def no_dependencies: Array(Type) = [];

@edsl::entity_source("broken_metric_aggregation", "bma")
@edsl::dataset(bad_metric_kind, metric_grain, metric_time)
type WrongAggregation = struct {
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, utc_encoding_for_tests)
    ts: String,
    @edsl::column("value")
    @edsl::measure("usage", wrong_aggregate, no_dependencies)
    @edsl::metric_value("usage", right_aggregate, no_metric_unit)
    value: Float,
};

pub def inconsistent_metric_aggregation_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-metric-v1", [WrongAggregation.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "metric metadata disagrees with its lowerable measure");

@edsl::entity_source("bad_summary_without_metric", "bs")
type SummaryWithoutMetric = struct {
    @edsl::column("value")
    @edsl::sample_aggregate("peak", qb::AggregateFunction::Max, no_metric_unit)
    value: Int,
};

pub def sample_summary_requires_metric: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-summary-v1", [SummaryWithoutMetric.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "sample aggregate requires a declared metric on the same field");

def percent_unit: Option(String) = Some("%");

@edsl::entity_source("bad_summary_unit", "bu")
@edsl::dataset(bad_metric_kind, metric_grain, metric_time)
type SummaryWrongUnit = struct {
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, utc_encoding_for_tests)
    ts: String,
    @edsl::column("value")
    @edsl::measure("usage", qb::AggregateFunction::Avg, no_dependencies)
    @edsl::metric_value("usage", qb::AggregateFunction::Avg, percent_unit)
    @edsl::sample_aggregate("peak", qb::AggregateFunction::Max, no_metric_unit)
    value: Int,
};

pub def sample_summary_cannot_change_unit: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-summary-unit-v1", [SummaryWrongUnit.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [qb::AggregateFunction::Avg], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "sample aggregate requires an id and the original metric unit");

@edsl::entity_source("bad_summary_id", "bi")
@edsl::dataset(bad_metric_kind, metric_grain, metric_time)
type SummaryDuplicateId = struct {
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, utc_encoding_for_tests)
    ts: String,
    @edsl::column("value")
    @edsl::measure("usage", qb::AggregateFunction::Avg, no_dependencies)
    @edsl::metric_value("usage", qb::AggregateFunction::Avg, no_metric_unit)
    @edsl::sample_aggregate("usage", qb::AggregateFunction::Max, no_metric_unit)
    value: Int,
};

pub def sample_summary_id_must_be_unique: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-summary-id-v1", [SummaryDuplicateId.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [qb::AggregateFunction::Avg], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "duplicate metric value id");

def event_kind_for_local: edsl::DatasetKind = edsl::DatasetKind::Event;
def local_grain: Array(String) = ["id"];
def local_as_utc: Option(String) = Some("occur_time");
def local_semantics: edsl::TimeSemantics = edsl::TimeSemantics::Local;

@edsl::entity_source("bad_local_event", "ble")
@edsl::dataset(event_kind_for_local, local_grain, local_as_utc)
type LocalEvent = struct {
    @edsl::column("id")
    id: String,
    @edsl::column("occur_time")
    @edsl::time_field(local_semantics, local_encoding_for_tests)
    occur_time: String,
};

pub def local_time_cannot_be_the_utc_role: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-local-v1", [LocalEvent.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "dataset UTC field must have the UTC time role");

@edsl::entity_source("bad_epoch_type", "bet")
type WrongEpochType = struct {
    @edsl::column("created")
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::LocalEpochMillis)
    created: String,
};

pub def epoch_millis_requires_integer_storage: test::Test = test::should_fail_with(fn() {
