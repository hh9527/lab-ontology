use crate::query as qb;
use crate::uql as uql;
use std::array as array;
use std::codec as codec;
use std::string as string;
use std::test as test;
use std::value::{Value};

# Same context is reused across every renderer clause and nested query.
def source: (qb::BuildCtx, qb::Source) = qb::source_with_hint(
    qb::build_context(),
    "events",
    "select"
);
def peer: (qb::BuildCtx, qb::Source) = qb::source_with_hint(source.0, "events", "select");
def needle: (qb::BuildCtx, qb::Expr) = qb::bind(peer.0, qb::Val::String("active"));
def take: (qb::BuildCtx, qb::Expr) = qb::bind(needle.0, qb::Val::Int(2));
def threshold: (qb::BuildCtx, qb::Expr) = qb::bind(take.0, qb::Val::Int(0));
def cap: (qb::BuildCtx, qb::Expr) = qb::bind(threshold.0, qb::Val::Int(1));
def ago_time: (qb::BuildCtx, qb::Expr) = qb::bind(cap.0, qb::Val::String("2026-03-05 07:25:00"));
def ago_days: (qb::BuildCtx, qb::Expr) = qb::bind(ago_time.0, qb::Val::Int(2));
def null_time: (qb::BuildCtx, qb::Expr) = qb::bind(ago_days.0, qb::Val::None);
def id: qb::Expr = qb::column(source.1, "id");
def category: qb::Expr = qb::column(source.1, "category");
def amount: qb::Expr = qb::column(source.1, "amount");
def predicate: qb::Expr = qb::scalar(
    qb::ScalarFunction::Eq,
    [qb::column(source.1, "kind"), needle.1]
);
def count: qb::SelectItem = qb::aggregate_filtered(
    qb::AggregateFunction::Count,
    amount,
    True,
    Some(predicate),
    "hits"
);
def count_call: qb::AggregateCall = match count {
    qb::SelectItem::Aggregate(call) => call,
    _ => fail!("aggregate required")
};
def plan: qb::Plan = {
    revision: "uql",
    sources: [source.1],
    joins: [],
    projection: [qb::named_expr_item(id, "id")],
    filter: None,
    grouping: [],
    having: [],
    ordering: [qb::order_by(qb::OrderKey::Expr(id), qb::Ordering::Asc)],
    limit: None,
    offset: None,
    exists: [],
    derived: None,
    internal_measures: [],
    partition: None,
    scalar_comparisons: [],
    ranked_key_comparisons: [],
};
def grouped: qb::Plan = {
    ...plan,
    projection: [
        qb::named_expr_item(category, "category"),
        count,
        qb::computed_item(qb::ComputedOp::Add, "hits", "hits", "double_hits")
    ],
    grouping: [category],
    having: [qb::having_bound(qb::HavingOp::Ge, "hits", threshold.1)],
    ordering: [qb::order_by(qb::OrderKey::AggregateRef({alias: "double_hits"}), qb::Ordering::Desc)],
};
def render: Fn(qb::QueryPlan) -> qb::Query = fn(p) {
    uql::build_query(qb::finish(null_time.0, p))
};
def scalar: Fn(qb::ScalarFunction, Array(qb::Expr)) -> String = fn(f, args) {
    uql::render_expr_with_context(qb::scalar(f, args), null_time.0).sql
};
def scalar_query: Fn(qb::ScalarFunction, Array(qb::Expr)) -> qb::Query = fn(f, args) {
    uql::render_expr_with_context(qb::scalar(f, args), null_time.0)
};
def placeholder_count: Fn(String) -> Int = fn(sql) {
    array::length(string::split(sql, "?")) - 1
};

pub def identifiers_aliases_and_binding_handles: test::Test = test::should_ok(
    fn() {
        let query = render(
            qb::QueryPlan::Rows(
                {
                    ...plan,
                    joins: [
                        qb::join(
                            qb::JoinKind::Left,
                            peer.1,
                            qb::source_column_ref(source.1, "id"),
                            qb::source_column_ref(peer.1, "id")
                        )
                    ],
                    filter: Some(predicate),
                    limit: Some(take.1),
                    offset: Some(threshold.1),
                }
            )
        );
        if query.bindings != [qb::Val::String("active"), qb::Val::Int(2), qb::Val::Int(0)] {
            fail!("the occurrence expansion lost the render order", query.bindings)
        } else { () };
        if !string::contains(query.sql, "`events` AS `select`") {
            fail!("source rendering lost its table and alias", query.sql)
        } else { () };
        if !string::contains(
            query.sql,
            "LEFT JOIN `events` AS `select_2` ON `select`.`id` = `select_2`.`id`"
        ) {
            fail!("join rendering lost its ON alignment", query.sql)
        } else { () };
        if !string::contains(query.sql, "`select`.`kind` = ?") {
            fail!("the placeholder must be positional", query.sql)
        } else { () };
        if !string::contains(query.sql, "LIMIT ? OFFSET ?") {
            fail!("pagination must render positional placeholders", query.sql)
        } else { () };
        if placeholder_count(query.sql) != array::length(query.bindings) {
            fail!("placeholder count must equal the bindings length", query.sql, query.bindings)
        } else { () }
    }
);
pub def repeated_binding_expands_per_occurrence: test::Test = test::should_ok(
    fn() {
        let rendered = uql::render_expr_with_context(
            qb::scalar(qb::ScalarFunction::Eq, [needle.1, needle.1]),
            cap.0
        );
        if rendered.sql != "? = ?" {
            fail!("a repeated handle must render one placeholder per occurrence", rendered.sql)
        } else { () };
        if rendered.bindings != [qb::Val::String("active"), qb::Val::String("active")] {
            fail!("a repeated handle must repeat its value per occurrence", rendered.bindings)
        } else { () }
    }
);
pub def filtered_distinct_aggregate_preserves_local_scope: test::Test = test::should_ok(
    fn() {
        let query = render(qb::QueryPlan::Rows(grouped));
        if !string::contains(
            query.sql,
            "count(DISTINCT CASE WHEN `select`.`kind` = ? THEN `select`.`amount` ELSE NULL END)"
        ) {
            fail!("the filtered aggregate lost its scoped CASE form", query.sql)
        } else { () };
        if string::contains(query.sql, "FILTER (") {
            fail!("the filtered aggregate must not render a FILTER clause", query.sql)
        } else { () };
        if string::contains(query.sql, " WHERE ") {
            fail!("the local predicate leaked into the global WHERE", query.sql)
        } else { () };
        if !string::contains(query.sql, "HAVING count(DISTINCT CASE") {
            fail!("the HAVING threshold lost its aggregate form", query.sql)
        } else { () };
        if !string::contains(query.sql, "END) >= ?") {
            fail!("the HAVING threshold must use a positional placeholder", query.sql)
        } else { () }
    }
);
pub def documented_string_functions_and_direct_lower: test::Test = test::should_ok(
    fn() {
        if scalar(qb::ScalarFunction::Instr, [id, needle.1]) != "instr(`select`.`id`, ?)" {
            fail!("instr must render positional placeholders", scalar(qb::ScalarFunction::Instr, [id, needle.1]))
        } else { () };
        if scalar(qb::ScalarFunction::Substr, [id, take.1]) != "substr(`select`.`id`, ?)" {
            fail!("substr must render positional placeholders", scalar(qb::ScalarFunction::Substr, [id, take.1]))
        } else { () };
        if scalar(qb::ScalarFunction::Length, [id]) != "char_length(`select`.`id`)" {
            fail!("length lost its char_length form", scalar(qb::ScalarFunction::Length, [id]))
        } else { () };
        if scalar(qb::ScalarFunction::RegexMatch, [id, needle.1]) != "(regexp_count(`select`.`id`, ?) > 0)" {
            fail!("regex match lost its regexp_count form", scalar(qb::ScalarFunction::RegexMatch, [id, needle.1]))
        } else { () };
        # OQ-5: the engine's lower() folds A-Z only, matching the AST contract.
        if scalar(qb::ScalarFunction::Lower, [needle.1]) != "lower(?)" {
            fail!("lower must render the engine function directly", scalar(qb::ScalarFunction::Lower, [needle.1]))
        } else { () }
    }
);
pub def binary_collation_is_not_silently_changed: test::Test = test::should_fail_with(
    fn() {
        scalar(qb::ScalarFunction::BinaryText, [id])
    },
    "UQL spec does not define binary text collation"
);
pub def explicit_null_order_is_native: test::Test = test::should_ok(
    fn() {
        let asc = render(qb::QueryPlan::Rows(plan));
        let desc = render(
            qb::QueryPlan::Rows(
                {...plan, ordering: [qb::order_by(qb::OrderKey::Expr(id), qb::Ordering::Desc)]}
            )
        );
        if !string::contains(asc.sql, "ORDER BY `select`.`id` ASC NULLS FIRST") {
            fail!("ascending order lost its native NULLS FIRST form", asc.sql)
        } else { () };
        if !string::contains(desc.sql, "ORDER BY `select`.`id` DESC NULLS LAST") {
            fail!("descending order lost its native NULLS LAST form", desc.sql)
        } else { () }
    }
);
pub def utc_buckets_use_documented_functions: test::Test = test::should_ok(
    fn() {
        let datetime = scalar(
            qb::ScalarFunction::UtcTimeBucket(
                {unit: qb::UtcBucketUnit::Hour, encoding: qb::UtcBucketEncoding::DateTimeUtc}
            ),
            [id]
        );
        let date = scalar(
            qb::ScalarFunction::UtcTimeBucket(
                {unit: qb::UtcBucketUnit::Month, encoding: qb::UtcBucketEncoding::Date}
            ),
            [id]
        );
        let epoch = scalar(
            qb::ScalarFunction::UtcTimeBucket(
                {unit: qb::UtcBucketUnit::Month, encoding: qb::UtcBucketEncoding::EpochMillis}
            ),
            [id]
        );
        if datetime != "time_floor(CAST(`select`.`id` AS TIMESTAMP), 'PT1H')" {
            fail!("unexpected datetime hour bucket rendering (OQ-7)", datetime)
        } else { () };
        if date != "date_trunc('month', CAST(`select`.`id` AS TIMESTAMP))" {
            fail!("unexpected date bucket rendering (OQ-2)", date)
        } else { () };
        if !string::contains(epoch, "timestampdiff('SECOND'") {
            fail!("epoch bucket lost its timestampdiff form", epoch)
        } else { () };
        if !string::contains(epoch, "mod(mod(`select`.`id`, 86400000) + 86400000, 86400000)") {
            fail!("epoch bucket lost its canonical day-offset arithmetic", epoch)
        } else { () };
        if !string::contains(epoch, "TIMESTAMP '1970-01-01 00:00:00'") {
            fail!("epoch month bucket lost its typed epoch anchor (m12)", epoch)
        } else { () };
        if !string::contains(epoch, "ELSE NULL END") {
            fail!("epoch bucket lost its NULL branch", epoch)
        } else { () };
        let days_ago = scalar_query(qb::ScalarFunction::UtcDaysAgo, [needle.1, take.1]);
        if days_ago.sql != "concat(timestamp_format(timestampadd('DAY', (0 - CAST(? AS INTEGER)), CAST(? AS TIMESTAMP)), '%Y-%m-%d'), 'T', timestamp_format(timestampadd('DAY', (0 - CAST(? AS INTEGER)), CAST(? AS TIMESTAMP)), '%H:%i:%s'), 'Z')" {
            fail!("utc_days_ago lost its concat combination (OQ-1)", days_ago.sql)
        } else { () };
        if days_ago.bindings != [qb::Val::Int(2), qb::Val::String("active"), qb::Val::Int(2), qb::Val::String("active")] {
            fail!("utc_days_ago must expand the restated subexpression per occurrence", days_ago.bindings)
        } else { () }
    }
);
pub def unsupported_bucket_vocabulary_is_rejected: test::Test = test::should_fail_with(
    fn() {
        uql::render_expr_with_context(
            qb::scalar(
                qb::ScalarFunction::UtcTimeBucket(
                    {unit: qb::UtcBucketUnit::Year, encoding: qb::UtcBucketEncoding::DateTimeUtc}
                ),
                [id]
            ),
            cap.0
        )
    },
    "UQL buckets support hour, day and month units only"
);
