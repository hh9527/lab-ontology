pub def graph_group_count_rejects_top: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"site",
        "nodes":[{"id":"site","entity":"site"}],"edges":[],"select":[],
        "count":"site","group_by_identity":["site"],
