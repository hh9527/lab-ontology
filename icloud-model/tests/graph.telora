pub def site_device_rows_do_not_implicitly_deduplicate: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{"op":"graph","root":"site",
        "nodes":[{"id":"site","entity":"site"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_located_at_site","from":"device","to":"site"}],
        "select":[{"node":"site","dimension":"site_name"},
                  {"node":"device","dimension":"device_name"}]}
    "#).unwrap!());
    if string::contains(query.sql, "SELECT site.SITE_NAME")
        && !string::contains(query.sql, "SELECT DISTINCT") { True }
    else { fail!("graph row semantics unexpectedly deduplicated visible values", query.sql) }
});

pub def distinct_rejects_counted_identity: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"device","distinct":true,
        "nodes":[{"id":"device","entity":"device"}],"edges":[],
        "select":[{"node":"device","dimension":"device_name"}],"count":"device"}"#).unwrap!())
}, "graph distinct requires raw projected rows");

pub def distinct_rejects_non_boolean_flag: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"device","distinct":"yes",
        "nodes":[{"id":"device","entity":"device"}],"edges":[],
        "select":[{"node":"device","dimension":"device_name"}]}"#).unwrap!())
}, "graph distinct must be boolean");

pub def alarm_severity_counts_keep_independent_aggregate_scopes: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"alarm","measure":"critical_alarm_count"},
                    {"node":"alarm","measure":"major_alarm_count"}],
        "group_by_identity":["device"]}"#).unwrap!();
    let sqlite_query = lower(intent);
    let pg_query = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sqlite_query.sql, "count(alarm.CSN) FILTER (WHERE")
        && string::contains(sqlite_query.sql, "alarm.SEVERITY = ?1")
        && string::contains(sqlite_query.sql, "alarm.SEVERITY = ?2")
        && string::contains(sqlite_query.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && !string::contains(sqlite_query.sql, " WHERE alarm.SEVERITY")
        && string::contains(pg_query.sql, "FILTER (WHERE")
        && sqlite_query.bindings == [qb::Val::String("1"), qb::Val::String("2")]
        && pg_query.bindings == sqlite_query.bindings { True }
    else { fail!(`filtered event counts changed sample population: \{sqlite_query.sql} / \{pg_query.sql}`) }
});

pub def site_alarm_relation_excludes_system_marker_only_on_navigation: test::Test = test::should_ok(fn() {
    let site_intent = json::parse(r#"{"op":"graph","root":"site","include_empty":true,
        "nodes":[{"id":"site","entity":"site"},{"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"alarm_site_reference","from":"alarm","to":"site"}],
        "select":[{"node":"site","dimension":"site_id"}],
        "count":"alarm","group_by_identity":["site"]}"#).unwrap!();
    let sq = lower(site_intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(site_intent));
    let all_alarms = lower(json::parse(r#"{"op":"graph","root":"alarm",
        "nodes":[{"id":"alarm","entity":"current_alarm"}],"edges":[],"select":[],"count":"alarm"}"#).unwrap!());
    if string::contains(sq.sql, "alarm.STREXT13 = site.SITE_ID")
        && string::contains(sq.sql, "alarm.STREXT13 != ?1")
        && string::contains(pg.sql, "\"alarm\".\"STREXT13\" != $1")
        && sq.bindings == [qb::Val::String("3")] && pg.bindings == sq.bindings
        && !string::contains(all_alarms.sql, "STREXT13") { True }
    else { fail!(`site navigation lost its guard or leaked it into all alarms: \{sq.sql} / \{pg.sql} / \{all_alarms.sql}`, sq.bindings, pg.bindings) }
});

pub def site_alarm_exists_keeps_relation_guard_inside_existence: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{"op":"graph","root":"site",
        "nodes":[{"id":"site","entity":"site"}],"edges":[],
        "select":[{"node":"site","dimension":"site_id"}],
        "exists":[{"anchor":"site","nodes":[{"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"alarm_site_reference","from":"alarm","to":"site"}]}]}"#).unwrap!());
    if string::contains(query.sql, "EXISTS (SELECT 1 FROM T_CURRENT_ALARM AS alarm")
        && string::contains(query.sql, "alarm.STREXT13 != ?1")
        && query.bindings == [qb::Val::String("3")] { True }
    else { fail!(`site-alarm existence omitted the declared source guard: \{query.sql}`, query.bindings) }
});

pub def site_alarm_constraint_reapplies_relation_guard: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{"op":"graph","root":"alarm",
        "nodes":[{"id":"alarm","entity":"current_alarm"},{"id":"site","entity":"site"}],
        "edges":[{"relation":"alarm_site_reference","from":"alarm","to":"site"}],
        "constraints":[{"relation":"alarm_site_reference","from":"alarm","to":"site"}],
        "select":[{"node":"site","dimension":"site_id"}]}"#).unwrap!());
    if string::contains(query.sql, "WHERE")
        && string::contains(query.sql, "alarm.STREXT13 != ?2")
        && query.bindings == [qb::Val::String("3"), qb::Val::String("3")] { True }
    else { fail!(`named relation constraint omitted its guard: \{query.sql}`, query.bindings) }
});

pub def site_alarm_relation_rejects_reversed_roles: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"site",
        "nodes":[{"id":"site","entity":"site"},{"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"alarm_site_reference","from":"site","to":"alarm"}],
        "select":[{"node":"site","dimension":"site_id"}]}"#).unwrap!())
}, "graph edge role or target does not match declared relation");

pub def zero_preserving_alarm_measures_keep_their_separate_scopes: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device","include_empty":true,
        "nodes":[{"id":"device","entity":"device"},{"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"alarm","measure":"critical_alarm_count"},
                    {"node":"alarm","measure":"major_alarm_count"},
                    {"node":"alarm","measure":"critical_or_major_alarm_count"}],
        "group_by_identity":["device"]}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "LEFT JOIN T_CURRENT_ALARM AS alarm")
        && string::contains(sq.sql, "count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?1)")
        && string::contains(sq.sql, "count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?2)")
        && string::contains(sq.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && string::contains(pg.sql, "LEFT JOIN \"T_CURRENT_ALARM\" AS \"alarm\"")
        && sq.bindings == pg.bindings { True }
    else { fail!("zero-preserving event counts lost independent predicates or owner grain", sq, pg) }
});

