use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 存储组件来源：parent 使用存储设备身份；原始文本不按单位说明隐式解析。
use super::inventory as i;
use super::storage as storage;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(
    String
);
@registry::entity("storage_chassis_entity")
type Identity = struct {
    id: ComponentId
};
@registry::dataset("source_SYS_Chassis", "SYS_Chassis", ["source_id"])
@registry::roles([subject, tenant, parent])
@registry::relations(relations)
type SysChassis = struct {
    @m::column("tenantId")
    @g::exact("source_SYS_Chassis__tenantId")
    source_tenantId: i::TenantId,
    @m::column("id")
    @g::exact("source_SYS_Chassis__id")
    source_id: ComponentId,
    @m::column("projectId")
    @g::exact("source_SYS_Chassis__projectId")
    source_projectId: String,
    @m::column("name")
    @g::search("source_SYS_Chassis__name")
    source_name: String,
    @m::column("oriResId")
    @g::exact("source_SYS_Chassis__oriResId")
    source_oriResId: String,
    @m::column("parentResId")
    @g::exact("source_SYS_Chassis__parentResId")
    source_parentResId: storage::StorageId,
    @m::column("curSupplyMode")
    @g::exact("source_SYS_Chassis__curSupplyMode")
    source_curSupplyMode: String,
    @m::column("systemSupplyMode")
    @g::exact("source_SYS_Chassis__systemSupplyMode")
    source_systemSupplyMode: String,
    @m::column("macAddress")
    @g::search("source_SYS_Chassis__macAddress")
    source_macAddress: String,
    @m::column("logicType")
    @v::classification(SourceSYSChassisLogicType_domain, "source_SYS_Chassis__logicType")
    source_logicType: String,
    @m::column("height")
    @g::exact("source_SYS_Chassis__height")
    source_height: String,
    @m::column("model")
    @g::search("source_SYS_Chassis__model")
    source_model: String,
    @m::column("wwn")
    @g::search("source_SYS_Chassis__wwn")
    source_wwn: String,
    @m::column("temperature")
    @g::exact("source_SYS_Chassis__temperature")
    source_temperature: String,
    @m::column("boardType")
    @g::exact("source_SYS_Chassis__boardType")
    source_boardType: String,
    @m::column("slot")
    @g::exact("source_SYS_Chassis__slot")
    source_slot: String,
    @m::column("chassisId")
    @g::exact("source_SYS_Chassis__chassisId")
    source_chassisId: String,
    @m::column("sn")
    @g::search("source_SYS_Chassis__sn")
    source_sn: String,
    @m::column("healthStatus")
    @v::classification(SourceSYSChassisHealthStatus_domain, "source_SYS_Chassis__healthStatus")
    source_healthStatus: String,
    @m::column("runningStatus")
    @v::classification(SourceSYSChassisRunningStatus_domain, "source_SYS_Chassis__runningStatus")
    source_runningStatus: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(SysChassis) = registry::dataset_of(SysChassis.type);
def subject: m::Role(SysChassis) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(SysChassis.type, ComponentId.type, "source_id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def tenant: m::Role(SysChassis) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(SysChassis.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent: m::Role(SysChassis) = m::role(
    dataset,
    storage::entity,
    "storage_owner",
    False,
    [
        m::identity_part(
            m::field(SysChassis.type, storage::StorageId.type, "source_parentResId"),
            m::field(storage::Identity.type, storage::StorageId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourceSYSChassisLogicType = enum {
    @ev::rename("0")
    @ev::description("Cascading Enclosure (Disk Enclosure)", "级联框（硬盘框）")
    CascadingEnclosureDiskEnclosure,
    @ev::rename("1")
    @ev::description("Control Enclosure", "控制框")
    ControlEnclosure,
    @ev::rename("2")
    @ev::description("Data Switch", "数据交换机")
    DataSwitch,
    @ev::rename("3")
    @ev::description("Management Switch", "管理交换机")
    ManagementSwitch,
    @ev::rename("4")
    @ev::description("Management Server", "管理服务器")
    ManagementServer,
};
def SourceSYSChassisLogicType_domain: v::Domain(SourceSYSChassisLogicType, String) = v::from_enum(
    "SourceSYSChassisLogicType",
    SourceSYSChassisLogicType.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSChassisHealthStatus = enum {
    @ev::rename("0")
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("Faulty", "故障")
    Faulty,
};
def SourceSYSChassisHealthStatus_domain: v::Domain(SourceSYSChassisHealthStatus, String) = v::from_enum(
    "SourceSYSChassisHealthStatus",
    SourceSYSChassisHealthStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceSYSChassisRunningStatus = enum {
    @ev::rename("0")
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("Running", "运行")
    Running,
    @ev::rename("5")
    @ev::description("High Temperature Sleep", "高温休眠")
    HighTemperatureSleep,
    @ev::rename("27")
    @ev::description("Online", "在线")
    Online,
    @ev::rename("28")
    @ev::description("Offline", "离线")
    Offline,
};
def SourceSYSChassisRunningStatus_domain: v::Domain(SourceSYSChassisRunningStatus, String) = v::from_enum(
    "SourceSYSChassisRunningStatus",
    SourceSYSChassisRunningStatus.type,
    String.type,
    False
);
def declaration: t::Declaration = registry::declaration(SysChassis.type);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_HuaweiStorageDeviceCompositionSYS_Chassis",
        storage::dataset,
        storage::subject,
        dataset,
        parent,
        cardinality
    ),
    r::relation(
        "source_SYS_ChassisAssociationX_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{declaration, relations};

pub use self::{SysChassis, Identity};
