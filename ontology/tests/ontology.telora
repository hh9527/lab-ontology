};

def hub_problem_count: Fn(Array(Type)) -> Int = fn(types) {
    let graph = edsl::knowledge_graph(types);
    let build = edsl::hub_build(graph.0);
    array::length(build.problems)
};

def check_hub_route_valid: Fn() -> Bool = fn() {
    let types: Array(Type) = [HubParticipant.type, HubOne.type];
    let graph = edsl::knowledge_graph(types);
    let build = edsl::hub_build(graph.0);
    check(array::length(build.problems) == 0 && array::length(build.routes) == 1,
        "hub prepare: valid dual-hub declaration resolves exactly one route")
};

def check_hub_route_rejects_same_endpoint: Fn() -> Bool = fn() {
    let types: Array(Type) = [HubParticipant.type, HubSame.type];
    check(hub_problem_count(types) > 0, "hub prepare: identical left/right endpoints are rejected")
};

def check_hub_route_rejects_non_key_participant: Fn() -> Bool = fn() {
    let types: Array(Type) = [HubParticipant.type, HubBadKey.type];
    check(hub_problem_count(types) > 0, "hub prepare: non-key participant reference is rejected")
};

def check_hub_route_rejects_missing_participant_key: Fn() -> Bool = fn() {
    let types: Array(Type) = [HubParticipantNoKey.type, HubNoKey.type];
    check(hub_problem_count(types) > 0, "hub prepare: participant without a declared key is rejected")
};

def check_hub_route_rejects_endpoint_range: Fn() -> Bool = fn() {
    let types: Array(Type) = [HubParticipant.type, HubRange.type];
    check(hub_problem_count(types) > 0, "hub prepare: out-of-range endpoint field is rejected")
};

def check_hub_route_rejects_duplicate: Fn() -> Bool = fn() {
    let types: Array(Type) = [HubParticipant.type, HubDup.type];
    check(hub_problem_count(types) > 0, "hub prepare: duplicate declarations to the same participant are rejected")
};

# A second dual-hub participant fixture used only to prove the guard above.
@edsl::entity_source("hp2_t", "hp2")
type HubParticipantTwo = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_source("h2_t", "h2")
@edsl::dual_hub(HubParticipant.type, 0, 1, 2)
@edsl::dual_hub(HubParticipantTwo.type, 0, 1, 2)
type HubTwoParticipant = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
    right: Int,
};

def check_hub_route_accepts_multi_participant: Fn() -> Bool = fn() {
    # A hub may legitimately declare a dual-hub route for MULTIPLE participant
    # tables (the physical-link multi-participant shape).  Only a duplicate
    # route for the same (hub, participant) pair is ambiguous; paired endpoints
    # are expressed by the explicit peer_hub route, never by pairing dual-hub
    # request constraints.
    let types: Array(Type) = [HubParticipant.type, HubParticipantTwo.type, HubTwoParticipant.type];
    let graph = edsl::knowledge_graph(types);
    let build = edsl::hub_build(graph.0);
    check(array::length(build.problems) == 0 && array::length(build.routes) == 2,
        "hub prepare: a hub may declare dual-hub routes for multiple participant types")
};

# ---------------------------------------------------------------------------
# Paired-endpoint (peer) route slice.
#
# Pair (hub base) additionally declares a peer_hub route whose two role fields
# both reference Member's key.  A paired request keeps a hub row only when its
# two endpoints are the two specified participants (origin and peer), in either
# endpoint order (the two exchange branches).  No participant join, no fan-out.
# ---------------------------------------------------------------------------

def peer_hub_base_request: edsl::QueryRequest = {
    measures: [{ id: "PairCount", subject: "analyst", input: edsl::MeasureInput::All }],
    dimensions: [],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def peer_ab_request: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "members", key: Some(edsl::FilterInput::Int(101)), filters: [] },
    peer: { entity: "members", key: Some(edsl::FilterInput::Int(202)), filters: [] },
};

def peer_ba_request: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "members", key: Some(edsl::FilterInput::Int(202)), filters: [] },
    peer: { entity: "members", key: Some(edsl::FilterInput::Int(101)), filters: [] },
};

def check_peer_route_prepared: Fn() -> Bool = fn() {
    let p = knowledge::payload;
    let pairs = entity_id_index(p.entities, "pairs");
    let members = entity_id_index(p.entities, "members");
    let route_ok = array::any(p.peer_routes, fn(r) {
        r.hub == pairs && r.origin_entity == members && r.peer_entity == members
        && r.origin_field == 2 && r.peer_field == 3 && r.exchange
    });
    check(route_ok, "peer: prepared payload stores the Pair peer route (same participant, exchange allowed)")
        && check(array::length(p.peer_routes) == 1, "peer: exactly one paired route is declared")
};

def check_peer_same_type_lowering: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_peer(knowledge::payload, peer_hub_base_request, [peer_ab_request]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(pr.id) AS PairCount FROM pairs AS pr WHERE EXISTS (SELECT 1 FROM members AS mb_o, members AS mb_p WHERE ((pr.left_member_id = mb_o.id AND pr.right_member_id = mb_p.id) OR (pr.right_member_id = mb_o.id AND pr.left_member_id = mb_p.id)) AND mb_o.id <> mb_p.id AND mb_o.id = ? AND mb_p.id = ?)";
    let expected: Array(qb::Val) = [qb::Val::Int(101), qb::Val::Int(202)];
    check(query.sql == expected_sql, "peer: same-type pair lowers to a correlated EXISTS with two participant aliases and the two ordered exchange branches")
        && check(query.bindings == expected, "peer: origin/peer key binds belong to their own inner aliases in placeholder order")
        && check(array::length(plan.joins) == 0 && array::length(plan.exists) == 1,
            "peer: one correlated EXISTS, no outer participant join; the hub grain is not fanned out")
};

def check_peer_same_type_swapped_equivalent: Fn() -> Bool = fn() {
    # Swapping origin/peer of the same participant type must produce the same
    # SQL text (the exchange covers both endpoint assignments); only the two
    # key bindings exchange places.
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_peer(knowledge::payload, peer_hub_base_request, [peer_ab_request]));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_peer(knowledge::payload, peer_hub_base_request, [peer_ba_request]));
    let expected1: Array(qb::Val) = [qb::Val::Int(101), qb::Val::Int(202)];
    let expected2: Array(qb::Val) = [qb::Val::Int(202), qb::Val::Int(101)];
    check(q1.sql == q2.sql, "peer: same-type participants share one exchange SQL shape")
        && check(q1.bindings == expected1 && q2.bindings == expected2,
            "peer: swapped participants mirror the origin/peer binding order")
};

def member_attr_vip_gold_req: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "members", key: None,
        filters: [{ id: "MemberKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("vip") }] },
    peer: { entity: "members", key: None,
        filters: [{ id: "MemberKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("gold") }] },
};

def member_attr_same_value_req: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "members", key: None,
        filters: [{ id: "MemberKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("vip") }] },
    peer: { entity: "members", key: None,
        filters: [{ id: "MemberKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("vip") }] },
};

def check_peer_same_type_attribute_only: Fn() -> Bool = fn() {
    # Same participant table, attribute-only constraints on both sides: one
    # correlated EXISTS, two distinct inner aliases, both exchange branches, and
    # each filter bound to its own alias.
    let plan: qb::Plan = edsl::lower_peer(knowledge::payload, peer_hub_base_request, [member_attr_vip_gold_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(pr.id) AS PairCount FROM pairs AS pr WHERE EXISTS (SELECT 1 FROM members AS mb_o, members AS mb_p WHERE ((pr.left_member_id = mb_o.id AND pr.right_member_id = mb_p.id) OR (pr.right_member_id = mb_o.id AND pr.left_member_id = mb_p.id)) AND mb_o.id <> mb_p.id AND mb_o.kind = ? AND mb_p.kind = ?)";
    let expected: Array(qb::Val) = [qb::Val::String("vip"), qb::Val::String("gold")];
    check(query.sql == expected_sql, "peer: attribute-only same-type pair keeps one EXISTS and both exchange branches")
        && check(query.bindings == expected, "peer: attribute filters bind to their own aliases in order")
        && check(array::length(plan.joins) == 0 && array::length(plan.exists) == 1,
            "peer: attribute-only pair emits no outer join and no fan-out")
};

def check_peer_same_type_attribute_same_value: Fn() -> Bool = fn() {
    # Identical filter values on both sides stay on two distinct aliases (the
    # SQL keeps two separate `?` bindings); nothing is merged or mis-paired.
    let plan: qb::Plan = edsl::lower_peer(knowledge::payload, peer_hub_base_request, [member_attr_same_value_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::String("vip"), qb::Val::String("vip")];
    check(string::contains(query.sql, "FROM members AS mb_o, members AS mb_p")
            && string::contains(query.sql, "AND mb_o.id <> mb_p.id")
            && string::contains(query.sql, "AND mb_o.kind = ? AND mb_p.kind = ?"),
        "peer: same filter value on both sides keeps two distinct alias bindings AND the identity guard")
        && check(query.bindings == expected, "peer: identical values bind once per alias in order")
};

def member_entity_only_req: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "members", key: None, filters: [] },
    peer: { entity: "members", key: None, filters: [] },
};

def check_peer_same_type_entity_only: Fn() -> Bool = fn() {
    # Entity-only participants of the SAME entity are allowed: the entity is the
    # verified identity/type constraint.  The SQL keeps both participant aliases
    # and both exchange branches AND the closed `origin.key <> peer.key`
    # identity proof, so one member row can never occupy both endpoints.
    let plan: qb::Plan = edsl::lower_peer(knowledge::payload, peer_hub_base_request, [member_entity_only_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(pr.id) AS PairCount FROM pairs AS pr WHERE EXISTS (SELECT 1 FROM members AS mb_o, members AS mb_p WHERE ((pr.left_member_id = mb_o.id AND pr.right_member_id = mb_p.id) OR (pr.right_member_id = mb_o.id AND pr.left_member_id = mb_p.id)) AND mb_o.id <> mb_p.id)";
    check(query.sql == expected_sql, "peer: same-entity entity-only keeps two aliases, both branches and the identity guard")
        && check(array::length(query.bindings) == 0, "peer: entity-only side has no dynamic binding")
        && check(array::length(plan.joins) == 0 && array::length(plan.exists) == 1,
            "peer: entity-only same-type pair is one correlated EXISTS with no outer join")
};

def check_peer_deterministic: Fn() -> Bool = fn() {
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_peer(knowledge::payload, peer_hub_base_request, [peer_ab_request]));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_peer(knowledge::payload, peer_hub_base_request, [peer_ab_request]));
    check(q1.sql == q2.sql && q1.bindings == q2.bindings,
        "peer: repeated lowering is byte-identical")
};

def check_peer_request_probe: Fn() -> Bool = fn() {
    let p = knowledge::payload;
    let pairs = entity_id_index(p.entities, "pairs");
    let orders = entity_id_index(p.entities, "orders");
    let self_req: edsl::PeerRequest = {
        subject: "analyst",
        origin: { entity: "members", key: Some(edsl::FilterInput::Int(101)), filters: [] },
        peer: { entity: "members", key: Some(edsl::FilterInput::Int(101)), filters: [] },
    };
    let unknown_req: edsl::PeerRequest = {
        subject: "analyst",
        origin: { entity: "ghost", key: Some(edsl::FilterInput::Int(1)), filters: [] },
        peer: { entity: "members", key: Some(edsl::FilterInput::Int(2)), filters: [] },
    };
    let unrelated_req: edsl::PeerRequest = {
        subject: "analyst",
        origin: { entity: "members", key: Some(edsl::FilterInput::Int(1)), filters: [] },
        peer: { entity: "orders", key: Some(edsl::FilterInput::Int(2)), filters: [] },
    };
    # Filtered participant constraints (MemberKind dimension on members).
    let attr_only_req: edsl::PeerRequest = {
        subject: "analyst",
        origin: { entity: "members", key: None, filters: [{ id: "MemberKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("vip") }] },
        peer: { entity: "members", key: Some(edsl::FilterInput::Int(202)), filters: [] },
    };
    let empty_origin_req: edsl::PeerRequest = {
        subject: "analyst",
        origin: { entity: "members", key: None, filters: [] },
        peer: { entity: "members", key: Some(edsl::FilterInput::Int(202)), filters: [] },
    };
    let wrong_entity_req: edsl::PeerRequest = {
        subject: "analyst",
        origin: { entity: "members", key: None, filters: [{ id: "PairKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("x") }] },
        peer: { entity: "members", key: Some(edsl::FilterInput::Int(202)), filters: [] },
    };
    let bad_op_req: edsl::PeerRequest = {
        subject: "analyst",
        origin: { entity: "members", key: None, filters: [{ id: "MemberKind", subject: "analyst", op: edsl::FilterOp::Gt, input: edsl::FilterInput::Text("vip") }] },
        peer: { entity: "members", key: Some(edsl::FilterInput::Int(202)), filters: [] },
    };
    check(edsl::peer_request_ok(p, pairs, peer_ab_request), "peer probe: valid exact-key pair is feasible")
        && check(edsl::peer_request_ok(p, pairs, attr_only_req), "peer probe: attribute-only participant constraint is feasible")
        && check(edsl::peer_request_ok(p, pairs, empty_origin_req), "peer probe: an entity-only participant is feasible (entity is the verified identity constraint)")
        && check(!edsl::peer_request_ok(p, pairs, self_req), "peer probe: self-pair is rejected")
        && check(!edsl::peer_request_ok(p, pairs, unknown_req), "peer probe: unknown participant entity is rejected")
        && check(!edsl::peer_request_ok(p, pairs, unrelated_req), "peer probe: unrelated participant pair without a route is rejected")
        && check(!edsl::peer_request_ok(p, pairs, wrong_entity_req), "peer probe: a filter referencing another entity is rejected")
        && check(!edsl::peer_request_ok(p, pairs, bad_op_req), "peer probe: an unsupported filter operator is rejected")
        && check(!edsl::peer_request_ok(p, orders, peer_ab_request), "peer probe: a hub without a peer route is rejected")
};

# ---------------------------------------------------------------------------
# Heterogeneous paired-endpoint route fixture: the two hub endpoints reference
# two different participant tables.  Physical-link A/Z endpoints are NOT type
# roles, so the heterogeneous pair must still render BOTH endpoint-exchange
# branches.  Each equality connects a hub endpoint value to the key column of
# the participant table the request declared, so a key collision across the two
# tables can never be silently interpreted as the same endpoint.
# ---------------------------------------------------------------------------

def count_agg: qb::AggregateFunction = qb::AggregateFunction::Count;
def no_requires: Array(Type) = [];
def eq_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];

@edsl::entity_id("left_parts")
@edsl::entity_source("left_parts", "lp")
type LeftPart = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("kind")
    @edsl::dimension("LeftKind", flag_true, flag_true, eq_ops, text_kinds)
    kind: String,
};

@edsl::entity_id("right_parts")
@edsl::entity_source("right_parts", "rp")
type RightPart = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("kind")
    @edsl::dimension("RightKind", flag_true, flag_true, eq_ops, text_kinds)
    kind: String,
};

@edsl::entity_id("typed_hub")
@edsl::entity_source("typed_hub", "th")
@edsl::peer_hub(LeftPart.type, 0, 1, RightPart.type, 0, 2)
type TypedHub = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("TypedHubCount", count_agg, no_requires)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
    right: Int,
};

def typed_entity_types: Array(Type) = [TypedHub.type, LeftPart.type, RightPart.type];

@edsl::entity_id("directed_typed_hub")
@edsl::entity_source("typed_hub", "th")
@edsl::directed_peer_hub(LeftPart.type, 0, 1, RightPart.type, 0, 2)
type DirectedTypedHub = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("DirectedHubCount", count_agg, no_requires)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
    right: Int,
};

def directed_typed_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("directed-typed-hub-v1", [DirectedTypedHub.type, LeftPart.type, RightPart.type], knowledge::profile, typed_authorize)
};

def directed_hub_request: edsl::QueryRequest = {
    measures: [{ id: "DirectedHubCount", subject: "analyst", input: edsl::MeasureInput::All }],
    dimensions: [], filters: [], ordering: [], limit: None, offset: None, partition: None,
};

def typed_authorize: Fn(String) -> Bool = fn(subject) { True };

def typed_payload: Fn() -> edsl::PreparedPayload = fn() {
    let result: edsl::PreparedPayload = edsl::build_root("typed-hub-v1", typed_entity_types, knowledge::profile, typed_authorize);
    result
};

def typed_hub_request: edsl::QueryRequest = {
    measures: [{ id: "TypedHubCount", subject: "analyst", input: edsl::MeasureInput::All }],
    dimensions: [],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def typed_forward_req: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "left_parts", key: Some(edsl::FilterInput::Int(11)), filters: [] },
    peer: { entity: "right_parts", key: Some(edsl::FilterInput::Int(22)), filters: [] },
};

def typed_swapped_req: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "right_parts", key: Some(edsl::FilterInput::Int(22)), filters: [] },
    peer: { entity: "left_parts", key: Some(edsl::FilterInput::Int(11)), filters: [] },
};

def check_typed_peer_route: Fn() -> Bool = fn() {
    let p = typed_payload();
    let route = get_index(p.peer_routes, 0);
    check(array::length(p.peer_routes) == 1, "typed peer: heterogeneous route is prepared")
        && check(route.origin_entity != route.peer_entity,
            "typed peer: the two endpoints reference two different participant entities")
};

def check_typed_peer_forward_sql: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_peer(typed_payload(), typed_hub_request, [typed_forward_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(th.id) AS TypedHubCount FROM typed_hub AS th WHERE EXISTS (SELECT 1 FROM left_parts AS lp_o, right_parts AS rp_p WHERE ((th.left = lp_o.id AND th.right = rp_p.id) OR (th.right = lp_o.id AND th.left = rp_p.id)) AND lp_o.id = ? AND rp_p.id = ?)";
    let expected: Array(qb::Val) = [qb::Val::Int(11), qb::Val::Int(22)];
    check(query.sql == expected_sql, "typed peer: origin/peer each correlated through its OWN participant table, both exchange branches present")
        && check(query.bindings == expected, "typed peer: bindings are origin key then peer key on their own aliases")
        && check(array::length(plan.joins) == 0 && array::length(plan.exists) == 1,
            "typed peer: one correlated EXISTS, no outer participant join and no fan-out")
};

def check_typed_peer_swapped_sql: Fn() -> Bool = fn() {
    # A swapped request order still renders both endpoint-exchange branches and
    # now leads with the RIGHT-parts participant as the origin inner source: the
    # participant entity selects the inner alias, so the SQL keeps identity.
    let plan: qb::Plan = edsl::lower_peer(typed_payload(), typed_hub_request, [typed_swapped_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(th.id) AS TypedHubCount FROM typed_hub AS th WHERE EXISTS (SELECT 1 FROM right_parts AS rp_o, left_parts AS lp_p WHERE ((th.left = rp_o.id AND th.right = lp_p.id) OR (th.right = rp_o.id AND th.left = lp_p.id)) AND rp_o.id = ? AND lp_p.id = ?)";
    let expected: Array(qb::Val) = [qb::Val::Int(22), qb::Val::Int(11)];
    check(query.sql == expected_sql, "typed peer: swapped request correlates each participant through its own table")
        && check(query.bindings == expected, "typed peer: swapped bindings keep placeholder order on their own aliases")
};

def check_directed_typed_peer_swapped_roles: Fn() -> Bool = fn() {
    let query = qb::transform_sqlite(edsl::lower_peer(directed_typed_payload(), directed_hub_request, [typed_swapped_req]));
    let expected = "SELECT count(th.id) AS DirectedHubCount FROM typed_hub AS th WHERE EXISTS (SELECT 1 FROM right_parts AS rp_o, left_parts AS lp_p WHERE (th.right = rp_o.id AND th.left = lp_p.id) AND rp_o.id = ? AND lp_p.id = ?)";
    check(query.sql == expected, "directed peer: reversed request retains authored participant endpoint roles")
        && check(query.bindings == [qb::Val::Int(22), qb::Val::Int(11)], "directed peer: bindings follow requested aliases")
};

def typed_attr_forward_req: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "left_parts", key: None,
        filters: [{ id: "LeftKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("a") }] },
    peer: { entity: "right_parts", key: None,
        filters: [{ id: "RightKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("b") }] },
};

def typed_key_attr_req: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "left_parts", key: Some(edsl::FilterInput::Int(11)),
        filters: [{ id: "LeftKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("a") }] },
    peer: { entity: "right_parts", key: Some(edsl::FilterInput::Int(22)),
        filters: [{ id: "RightKind", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Text("b") }] },
};

def check_typed_peer_attribute_only: Fn() -> Bool = fn() {
    # Heterogeneous attribute-only participants: each side is constrained by its
    # own entity's filter inside the SAME correlated EXISTS, both exchange
    # branches remain, and the filters are bound to their own aliases.
    let plan: qb::Plan = edsl::lower_peer(typed_payload(), typed_hub_request, [typed_attr_forward_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(th.id) AS TypedHubCount FROM typed_hub AS th WHERE EXISTS (SELECT 1 FROM left_parts AS lp_o, right_parts AS rp_p WHERE ((th.left = lp_o.id AND th.right = rp_p.id) OR (th.right = lp_o.id AND th.left = rp_p.id)) AND lp_o.kind = ? AND rp_p.kind = ?)";
    let expected: Array(qb::Val) = [qb::Val::String("a"), qb::Val::String("b")];
    check(query.sql == expected_sql, "typed peer: attribute-only sides keep one correlated EXISTS and both exchange branches")
        && check(query.bindings == expected, "typed peer: each side's filter binds to its own alias in order")
        && check(array::length(plan.joins) == 0 && array::length(plan.exists) == 1,
            "typed peer: attribute-only pair emits no outer join and no fan-out")
};

def check_typed_peer_key_plus_attribute: Fn() -> Bool = fn() {
    # Exact key and attribute filter on one side are ANDed within that alias;
    # binding order is key first, then attribute filters (origin side, then peer
    # side), and stays deterministic.
    let plan: qb::Plan = edsl::lower_peer(typed_payload(), typed_hub_request, [typed_key_attr_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(th.id) AS TypedHubCount FROM typed_hub AS th WHERE EXISTS (SELECT 1 FROM left_parts AS lp_o, right_parts AS rp_p WHERE ((th.left = lp_o.id AND th.right = rp_p.id) OR (th.right = lp_o.id AND th.left = rp_p.id)) AND (lp_o.id = ? AND lp_o.kind = ?) AND (rp_p.id = ? AND rp_p.kind = ?))";
    let expected: Array(qb::Val) = [qb::Val::Int(11), qb::Val::String("a"), qb::Val::Int(22), qb::Val::String("b")];
    check(query.sql == expected_sql, "typed peer: key and attribute filter are ANDed inside each alias")
        && check(query.bindings == expected, "typed peer: binding order is key then attributes per alias (origin then peer)")
};

def check_typed_peer_filtered_deterministic: Fn() -> Bool = fn() {
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_peer(typed_payload(), typed_hub_request, [typed_key_attr_req]));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_peer(typed_payload(), typed_hub_request, [typed_key_attr_req]));
    check(q1.sql == q2.sql && q1.bindings == q2.bindings,
        "typed peer: repeated filtered lowering is byte-identical")
};

def typed_entity_only_req: edsl::PeerRequest = {
    subject: "analyst",
    origin: { entity: "left_parts", key: None, filters: [] },
    peer: { entity: "right_parts", key: None, filters: [] },
};

def check_typed_peer_entity_only: Fn() -> Bool = fn() {
    # Entity-only participants of DIFFERENT entities/tables: no bare key
    # inequality is added.  A hub row is kept when some left_parts row and some
    # right_parts row occupy the two endpoints; even if the two tables carry the
    # same key value, they are two different identities and are never
    # mis-paired onto the same endpoint.
    let plan: qb::Plan = edsl::lower_peer(typed_payload(), typed_hub_request, [typed_entity_only_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(th.id) AS TypedHubCount FROM typed_hub AS th WHERE EXISTS (SELECT 1 FROM left_parts AS lp_o, right_parts AS rp_p WHERE ((th.left = lp_o.id AND th.right = rp_p.id) OR (th.right = lp_o.id AND th.left = rp_p.id)))";
    check(query.sql == expected_sql, "typed peer: hetero entity-only keeps both entity aliases and both exchange branches")
        && check(!string::contains(query.sql, "<>"), "typed peer: no bare key inequality across different tables")
        && check(array::length(query.bindings) == 0, "typed peer: entity-only side has no dynamic binding")
        && check(array::length(plan.joins) == 0 && array::length(plan.exists) == 1,
            "typed peer: hetero entity-only is one correlated EXISTS with no outer join")
};

def check_typed_peer_cross_table_key_collision: Fn() -> Bool = fn() {
    # Heterogeneous participant tables may carry the SAME key value (here 22 on
    # both left_parts and right_parts).  Every equality connects a hub endpoint
    # to ONE declared participant table, and the two participants are distinct
    # inner aliases in the SQL, so the predicate can never reinterpret a single
    # endpoint value through both tables or silently collapse the pair.
    let collision_req: edsl::PeerRequest = {
        subject: "analyst",
        origin: { entity: "left_parts", key: Some(edsl::FilterInput::Int(22)), filters: [] },
        peer: { entity: "right_parts", key: Some(edsl::FilterInput::Int(22)), filters: [] },
    };
    let plan: qb::Plan = edsl::lower_peer(typed_payload(), typed_hub_request, [collision_req]);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT count(th.id) AS TypedHubCount FROM typed_hub AS th WHERE EXISTS (SELECT 1 FROM left_parts AS lp_o, right_parts AS rp_p WHERE ((th.left = lp_o.id AND th.right = rp_p.id) OR (th.right = lp_o.id AND th.left = rp_p.id)) AND lp_o.id = ? AND rp_p.id = ?)";
    let expected: Array(qb::Val) = [qb::Val::Int(22), qb::Val::Int(22)];
    check(query.sql == expected_sql, "typed peer: equal keys across different tables stay separate inner aliases")
        && check(query.bindings == expected, "typed peer: cross-table equal keys bind in placeholder order")
};

# ---------------------------------------------------------------------------
# Bounded two-hop existence with a FAN-OUT first hop (spider round 4).
#
# Subject A (LinkSubject) -> B (LinkOwner, one-to-many / FanOut) -> C
# (LinkTarget).  The whole A -> B -> C condition is one correlated EXISTS whose
# B and C are joined INSIDE the subquery, so B is never an outer join and the
# subject A grain is never amplified.  Lowering returns only subject fields.
# ---------------------------------------------------------------------------

def int_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];

@edsl::entity_id("link_subjects")
@edsl::entity_source("link_subjects", "ls")
@edsl::relation(LinkOwner.type, fanout_kind, 2, 0)
@edsl::exists_route(LinkOwner.type, LinkTarget.type)
type LinkSubject = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    @edsl::measure("LinkSubjectCount", count_agg, no_requires)
    id: Int,
    @edsl::column("name")
    @edsl::dimension("LinkSubjectName", flag_true, flag_true, eq_ops, text_kinds)
    name: String,
    @edsl::column("owner_id")
    owner_id: Int,
};

@edsl::entity_id("link_owners")
@edsl::entity_source("link_owners", "lo")
@edsl::relation(LinkTarget.type, fanout_kind, 0, 2)
type LinkOwner = struct {
    @edsl::column("id")
    id: Int,
};

@edsl::entity_id("link_targets")
@edsl::entity_source("link_targets", "lt")
type LinkTarget = struct {
    @edsl::column("id")
    id: Int,
    @edsl::column("level")
    @edsl::dimension("LinkTargetLevel", flag_true, flag_true, eq_ops, int_kinds)
    level: Int,
    @edsl::column("owner_id")
    owner_id: Int,
};

def link_entity_types: Array(Type) = [LinkSubject.type, LinkOwner.type, LinkTarget.type];

def link_authorize: Fn(String) -> Bool = fn(subject) { True };

def link_payload: Fn() -> edsl::PreparedPayload = fn() {
    edsl::build_root("link-v1", link_entity_types, knowledge::profile, link_authorize)
};

def link_subject_count_request: edsl::QueryRequest = {
    measures: [{ id: "LinkSubjectCount", subject: "analyst", input: edsl::MeasureInput::All }],
    dimensions: [],
    filters: [],
    ordering: [],
    limit: None,
    offset: None,
    partition: None,
};

def link_target_level_spec: edsl::ExistsRequest = {
    target: "link_targets",
    subject: "analyst",
    filters: [{ id: "LinkTargetLevel", subject: "analyst", op: edsl::FilterOp::Eq, input: edsl::FilterInput::Int(2) }],
    any_of: [],
    min_matches: None,
};

def link_target_exists_spec: edsl::ExistsRequest = {
    target: "link_targets",
    subject: "analyst",
    filters: [],
    any_of: [],
    min_matches: None,
};

def check_link_route_prepared: Fn() -> Bool = fn() {
    let p = link_payload();
    let route = if array::length(p.routes) == 1 { get_index(p.routes, 0) } else { fail!("expected one link route") };
    let via_rel = get_index(p.relations, route.via_edge);
    let kind_ok = match via_rel.kind { edsl::RelationKind::FanOut => True, edsl::RelationKind::Safe => False };
    check(array::length(p.routes) == 1, "link: declared fan-out first-hop route is prepared once")
        && check(kind_ok, "link: the first hop relation is FanOut")
        && check(array::length(p.entities) == 3, "link: subject/owner/target entities prepared")
};

def check_link_two_hop_lowering: Fn() -> Bool = fn() {
    let plan: qb::Plan = edsl::lower_full(link_payload(), link_subject_count_request, [link_target_level_spec], []);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected: Array(qb::Val) = [qb::Val::Int(2)];
    let expected_sql = "SELECT count(ls.id) AS LinkSubjectCount FROM link_subjects AS ls WHERE EXISTS (SELECT 1 FROM link_owners AS lo INNER JOIN link_targets AS lt ON lo.id = lt.owner_id WHERE ls.owner_id = lo.id AND lt.level = ?)";
    check(array::length(plan.joins) == 0 && array::length(plan.exists) == 1,
        "link: no outer participant join; one correlated EXISTS carries the whole A -> B -> C body")
        && check(query.sql == expected_sql, "link: B and C are joined inside the EXISTS; the subject grain is untouched")
        && check(query.bindings == expected, "link: the target filter binds in placeholder order")
        && check(!string::contains(query.sql, "JOIN link_owners"), "link: the fan-out first hop is never an outer JOIN")
};

def check_link_two_hop_returns_subject_dims_only: Fn() -> Bool = fn() {
    let request: edsl::QueryRequest = {
        measures: [],
        dimensions: [{ id: "LinkSubjectName", subject: "analyst", input: edsl::DimensionInput::None }],
        filters: [],
        ordering: [],
        limit: None,
        offset: None,
        partition: None,
    };
    let plan: qb::Plan = edsl::lower_full(link_payload(), request, [link_target_exists_spec], []);
    let query: qb::Query = qb::transform_sqlite(plan);
    let expected_sql = "SELECT ls.name FROM link_subjects AS ls WHERE EXISTS (SELECT 1 FROM link_owners AS lo INNER JOIN link_targets AS lt ON lo.id = lt.owner_id WHERE ls.owner_id = lo.id)";
    check(query.sql == expected_sql, "link: measureless existence returns only the subject dimension")
        && check(array::length(plan.grouping) == 0 && array::length(plan.projection) == 1,
            "link: no grouping or extra link-count column is introduced")
};

def check_link_two_hop_deterministic_and_absence: Fn() -> Bool = fn() {
    let q1: qb::Query = qb::transform_sqlite(edsl::lower_full(link_payload(), link_subject_count_request, [link_target_level_spec], []));
    let q2: qb::Query = qb::transform_sqlite(edsl::lower_full(link_payload(), link_subject_count_request, [link_target_level_spec], []));
    let absent: qb::Plan = edsl::lower_absence(link_payload(), link_subject_count_request, [link_target_exists_spec], []);
    let aq: qb::Query = qb::transform_sqlite(absent);
    check(q1.sql == q2.sql && q1.bindings == q2.bindings, "link: repeated lowering is byte-identical")
        && check(string::contains(aq.sql, "WHERE NOT EXISTS (SELECT 1 FROM link_owners AS lo INNER JOIN link_targets AS lt ON lo.id = lt.owner_id WHERE ls.owner_id = lo.id)"),
            "link: anti-existence of the whole A -> B -> C body lowers to NOT EXISTS")
};

# ---------------------------------------------------------------------------
# Paired-route declaration fixtures (valid and invalid).
# ---------------------------------------------------------------------------

@edsl::entity_source("pk_t", "pk")
type PeerKey = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_source("prs_t", "prs")
@edsl::peer_hub(PeerKey.type, 0, 1, PeerKey.type, 0, 1)
type PeerSameField = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
    right: Int,
};

@edsl::entity_source("pok_t", "pok")
@edsl::peer_hub(PeerKey.type, 0, 1, PeerKey.type, 0, 2)
type PeerOk = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
    right: Int,
};

@edsl::entity_source("prk_t", "prk")
@edsl::peer_hub(PeerKey.type, 1, 1, PeerKey.type, 0, 2)
type PeerBadKey = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
    right: Int,
};

@edsl::entity_source("pdup_t", "pdup")
@edsl::peer_hub(PeerKey.type, 0, 1, PeerKey.type, 0, 2)
@edsl::peer_hub(PeerKey.type, 0, 1, PeerKey.type, 0, 2)
type PeerDup = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
    right: Int,
};

@edsl::entity_source("poke_t", "poke")
@edsl::peer_hub(PeerKey.type, 0, 1, PeerKey.type, 0, 3)
type PeerOutOfRange = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
    right: Int,
};

def peer_problem_count: Fn(Array(Type)) -> Int = fn(types) {
    let graph = edsl::knowledge_graph(types);
    let build = edsl::peer_build(graph.0);
    array::length(build.problems)
};

def check_peer_route_valid: Fn() -> Bool = fn() {
    let types: Array(Type) = [PeerKey.type, PeerOk.type];
    let graph = edsl::knowledge_graph(types);
    let build = edsl::peer_build(graph.0);
    let route = if array::length(build.routes) == 1 { get_index(build.routes, 0) } else { fail!("expected one peer route") };
    let route_ok = route.origin_entity == route.peer_entity && route.exchange
        && route.origin_field == 1 && route.peer_field == 2;
    check(array::length(build.problems) == 0 && array::length(build.routes) == 1 && route_ok,
        "peer prepare: valid same-participant pair resolves exactly one exchange route")
};

def check_peer_route_rejects_same_endpoint: Fn() -> Bool = fn() {
    let types: Array(Type) = [PeerKey.type, PeerSameField.type];
    check(peer_problem_count(types) > 0, "peer prepare: identical origin/peer endpoint fields are rejected")
};

def check_peer_route_rejects_non_key_participant: Fn() -> Bool = fn() {
    let types: Array(Type) = [PeerKey.type, PeerBadKey.type];
    check(peer_problem_count(types) > 0, "peer prepare: non-key participant reference is rejected")
};

def check_peer_route_rejects_endpoint_range: Fn() -> Bool = fn() {
    let types: Array(Type) = [PeerKey.type, PeerOutOfRange.type];
    check(peer_problem_count(types) > 0, "peer prepare: out-of-range endpoint field is rejected")
};

def check_peer_route_rejects_duplicate: Fn() -> Bool = fn() {
    let types: Array(Type) = [PeerKey.type, PeerDup.type];
    check(peer_problem_count(types) > 0, "peer prepare: duplicate paired routes on one hub are rejected")
};

# ---------------------------------------------------------------------------
# Denser-relation-graph fuel regression (hub + leaf fan-out/ring edges).
