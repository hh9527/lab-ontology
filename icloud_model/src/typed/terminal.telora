@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementPriority = enum {
    @ev::itag(10)
    Vip,
    @ev::itag(20)
    @ev::description("Important", "重要")
    Important,
    @ev::itag(30)
    @ev::description("Common", "一般")
    Common,
};
def SourceEntTerminalElementPriority_domain: v::Domain(SourceEntTerminalElementPriority, Int) = v::from_enum(
    "SourceEntTerminalElementPriority",
    SourceEntTerminalElementPriority.type,
    Int.type,
    False
);

