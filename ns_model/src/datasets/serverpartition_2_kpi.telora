use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::kpi_server_partition;
@domain::subject("KpiServerPartition", "obj_id")
@domain::dataset("serverpartition-2-kpi", "serverpartition2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type Serverpartition2Kpi = struct {
    @m::column("OBJ_SYS_ID")
    @g::field_view(g::dimension_group("serverpartition-2-kpi/obj_sys_id", String.type, True, [g::Filter::Eq]), "serverpartition_2_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: String,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("serverpartition-2-kpi/obj_id", domain::Reference(ids::KpiServerPartitionByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "serverpartition_2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::KpiServerPartitionByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("serverpartition_2__sepa", domain::endpoint(Serverpartition2Kpi.type, "obj_id"), domain::endpoint(kpi_server_partition::KpiServerPartition.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
