# 独立声明到现有 transform 的准备入口，不解析或建立知识地图。
use crate::experimental::model as m;
use crate::experimental::groups as g;
use crate::experimental::relations as r;
use crate::experimental::values as v;
use crate::experimental::scalars as scalars;
use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::type_desc as td;
use std::string as string;

type ColumnBinding = struct { row: Type, field: String, value: Type, nullable: Bool, column: String };
type ColumnMapping(Row) = struct { row: Type, field: String, value: Type, nullable: Bool, column: String };
type Declaration = struct { dataset: m::PreparedDataset, groups: Array(g::BindingFacts), record_counts: Array(String), columns: Array(ColumnBinding), domains: Array(v::BindingFacts) };
type Prepared = struct { declarations: Array(Declaration), payload: edsl::PreparedPayload };
type Alternative = struct { id: String, choices: Array(r::Relation), cardinality: edsl::RelationCardinality };
def declare: for(Row) Fn(m::Dataset(Row), Array(m::Role(Row)), Array(g::Binding(Row)), Array(String)) -> Declaration = fn(dataset, roles, groups, record_counts) {
    let declared = m::prepare(dataset, roles);
    let bindings = array::map(groups, g::binding_facts);
    g::prepare_facts(declared, bindings);
    {dataset: declared, groups: bindings, record_counts, columns: [], domains: []}
};
def with_domains: for(Row) Fn(Declaration, Array(v::Binding(Row))) -> Declaration = fn(declared, bindings) {
    if declared.dataset.row != Row.type { fail!("business dimensions belong to another dataset row", declared.dataset.id) }
    else { declared <~ {domains: array::map(bindings, v::binding_facts)} }
};
# Row 字段映射到可信物理列，不接受 SQL 表达式或改变字段类型。
def column: for(Row, Value) Fn(m::Field(Row, Value), String) -> ColumnMapping(Row) = fn(field, name) {
    let checked = if field.nullable { m::optional_field(Row.type, Value.type, field.name) }
        else { m::field(Row.type, Value.type, field.name) };
    if field.owner != Row.type || field.value != Value.type || !qb::is_sql_identifier(name) {
        fail!("typed column mapping requires a valid owner, value and physical identifier", field.name, name)
    } else { {row: Row.type, field: checked.name, value: Value.type, nullable: checked.nullable, column: name} }
};
def map_columns: for(Row) Fn(Declaration, Array(ColumnMapping(Row))) -> Declaration = fn(declared, mappings) {
    if declared.dataset.row != Row.type { fail!("typed column mappings belong to a different dataset row", declared.dataset.id) }
    else { declared <~ {columns: array::map(mappings, fn(mapping) {
        {row: mapping.row, field: mapping.field, value: mapping.value, nullable: mapping.nullable, column: mapping.column}.ty!(ColumnBinding)
    })} }
};
# SQL 标识符仅接受 ASCII；两种主要 SQL 后端均不能靠大小写区分未引用列。
def identifier_key: Fn(String) -> String = fn(name) {
    array::fold([["A", "a"], ["B", "b"], ["C", "c"], ["D", "d"], ["E", "e"], ["F", "f"],
        ["G", "g"], ["H", "h"], ["I", "i"], ["J", "j"], ["K", "k"], ["L", "l"], ["M", "m"],
        ["N", "n"], ["O", "o"], ["P", "p"], ["Q", "q"], ["R", "r"], ["S", "s"], ["T", "t"],
        ["U", "u"], ["V", "v"], ["W", "w"], ["X", "x"], ["Y", "y"], ["Z", "z"]],
        name, fn(value, pair) { string::replace(value, pair[0], pair[1]) })
};
type Scalar = struct { storage: Type, nullable: Bool };
def scalar: Fn(Type) -> Scalar = fn(ty) {
    let resolved = if td::kind(ty) == td::TypeDescKind::Ref {
        match td::resolve(ty) { Ok(value) => value, Err(error) => fail!(error.message, ty) }
    } else { ty };
    if resolved == Bool.type { {storage: Bool.type, nullable: False} }
    else { match td::kind(resolved) {
        td::TypeDescKind::Newtype => scalar(td::children(resolved)[0]),
        td::TypeDescKind::Enum => {
            let variants = td::variants(resolved);
            let some = array::find(variants, fn(variant) { variant.name == "Some" && variant.payload != None });
            if array::length(variants) != 2 || !array::any(variants, fn(variant) { variant.name == "None" && variant.payload == None }) {
                fail!("typed transform requires a scalar or optional scalar representation", ty)
            } else {
                match some {
                    Some(variant) => match variant.payload {
                        Some(value) => {
                            let payload = scalar(value);
                            if payload.nullable { fail!("typed transform cannot encode nested optional values in one SQL column", ty) }
                            else { payload <~ {nullable: True} }
                        },
                        None => fail!("optional scalar requires a payload", ty),
                    },
                    None => fail!("optional scalar requires Some and None", ty),
                }
            }
        },
        td::TypeDescKind::Int => {storage: Int.type, nullable: False},
        td::TypeDescKind::Float => {storage: Float.type, nullable: False},
        td::TypeDescKind::String => {storage: String.type, nullable: False},
        _ => fail!("typed transform requires an integer, float, boolean or string representation", ty),
    } }
};
def physical_columns: Fn(Declaration) -> Array(String) = fn(declared) {
    let fields = td::fields(declared.dataset.row);
    array::map(declared.columns, fn(mapping) {
        let field = match array::find(fields, fn(field) { field.name == mapping.field }) {
            Some(value) => value, None => fail!("typed column mapping field does not exist", declared.dataset.id, mapping.field),
        };
        let actual = if mapping.nullable {
            let variants = td::variants(field.ty);
            array::length(variants) == 2
                && array::any(variants, fn(variant) { variant.name == "None" && variant.payload == None })
                && array::any(variants, fn(variant) { variant.name == "Some" && variant.payload == Some(mapping.value) })
        } else { field.ty == mapping.value };
        if mapping.row != declared.dataset.row || !actual { fail!("typed column mapping field witness does not match its row", declared.dataset.id, mapping.field) }
        else if !qb::is_sql_identifier(mapping.column) { fail!("typed column mapping physical name must be an identifier", mapping.column) }
        else if array::length(array::filter(declared.columns, fn(other) { other.field == mapping.field })) != 1 {
            fail!("typed column mapping repeats a logical field", mapping.field)
        } else { () }
    });
    let columns = array::map(fields, fn(field) {
        match array::find(declared.columns, fn(mapping) { mapping.field == field.name }) {
            Some(mapping) => mapping.column,
            None => field.name,
        }
    });
    let keys = array::map(columns, identifier_key);
    array::map(array::enumerate(columns), fn(pair) {
        if !qb::is_sql_identifier(pair.1) { fail!("typed transform physical field must be an identifier", pair.1) }
        else if array::length(array::filter(keys, fn(key) { key == keys[pair.0] })) != 1 {
            fail!("typed column mappings collide on a physical column", declared.dataset.id, pair.1)
        } else { pair.1 }
    })
};
def entity_entry: Fn(Declaration, Int) -> edsl::EntityEntry = fn(declared, index) {
    let dataset = m::validate_prepared(declared.dataset);
    let single_key = array::length(dataset.grain) == 1;
    let columns = physical_columns(declared);
    let fields = array::map(td::fields(dataset.row), fn(field) {
        let value = scalar(field.ty);
        if !qb::is_sql_identifier(field.name) { fail!("typed transform physical field must be an identifier", dataset.id, field.name) }
        else {
            {logical_type: None, nullable: value.nullable, index: field.index, name: field.name,
                column: columns[field.index], is_key: single_key && dataset.grain[0] == field.name, ty: value.storage}.ty!(edsl::FieldEntry)
        }
    });
    let key = match array::find(fields, fn(field) { field.is_key }) { Some(field) => field.index, None => -1 };
    let source = qb::source_with_hint(qb::build_context(), dataset.source, `typed_\{index}`).1;
    {references: [], field_roles: [], index, id: dataset.id, entity_type: dataset.row, table: dataset.source,
        alias: source.alias, source, key_field: key, fields, union: None,
        dataset: if array::length(dataset.grain) == 0 { None } else { Some({kind: edsl::DatasetKind::Entity, grain: dataset.grain, utc_time: None}) },
        sample_measures: [], description: None, scope: []}
};
# Group 使用 Row 字段寻址；在进入 QueryAst 前统一替换为已校验物理列。
def physical_expr: Fn(qb::Expr, Array(edsl::FieldEntry)) -> qb::Expr = fn(expr, fields) {
    match expr {
        qb::Expr::Column(column) => match array::find(fields, fn(field) { field.name == column.column }) {
            Some(field) => qb::Expr::Column(column <~ {column: field.column}),
            None => fail!("typed expression references an unmapped row field", column.column),
        },
        qb::Expr::AllocatedBind(_) => expr,
        qb::Expr::Scalar(call) => qb::Expr::Scalar(call <~ {args: array::map(call.args, fn(arg) { physical_expr(arg, fields) })}),
    }
};
def lower_member: Fn(qb::BuildCtx, qb::Source, Array(edsl::FieldEntry), g::Node) -> (qb::BuildCtx, qb::Expr) = fn(ctx, source, fields, node) {
    let lowered = g::lower(ctx, source, node);
    (lowered.0, physical_expr(lowered.1, fields))
};
# 现有准备结构保留一个锚定字段；完整表达式由 Group lowering 生成。
def anchor_column: Fn(g::Node) -> String = fn(node) {
    match node {
        g::Node::Column(column) => column.name,
        g::Node::Seconds(input) => anchor_column(input),
        g::Node::Ipv4(input) => anchor_column(input),
        g::Node::Rate(inputs) => anchor_column(inputs.amount),
        g::Node::Identity(input) => input.column.name,
    }
};
def dimension_entry: Fn(edsl::EntityEntry, g::Member) -> edsl::DimensionEntry = fn(entity, member) {
    if member.aggregate != None { fail!("typed Graph preparation does not yet lower aggregate Group expressions", member.id) } else { () };
    let column = anchor_column(member.node);
    let field = match array::find(entity.fields, fn(field) { field.name == column }) {
        Some(field) => field, None => fail!("typed dimension input field is missing", member.id),
    };
    let value = scalar(member.value);
    let output = if value.storage == String.type { edsl::OutputType::Text }
        else if value.storage == Int.type { edsl::OutputType::Integer }
        else if value.storage == Bool.type { edsl::OutputType::Boolean } else { edsl::OutputType::Number };
    let input = if member.value == scalars::Ipv4.type { edsl::FilterInputKind::Ipv4 } else if value.storage == String.type { edsl::FilterInputKind::Text }
        else if value.storage == Int.type { edsl::FilterInputKind::Int }
        else if value.storage == Bool.type { edsl::FilterInputKind::Bool } else { edsl::FilterInputKind::Number };
    let ops = array::map(member.filters, fn(op) {
        match op {
            g::Filter::InSubnet => edsl::FilterOp::InSubnet,
            g::Filter::NotInSubnet => edsl::FilterOp::NotInSubnet,
            g::Filter::Eq => edsl::FilterOp::Eq,
            g::Filter::Ne => edsl::FilterOp::Ne,
            g::Filter::Gt => edsl::FilterOp::Gt,
            g::Filter::Ge => edsl::FilterOp::Ge,
            g::Filter::Lt => edsl::FilterOp::Lt,
            g::Filter::Le => edsl::FilterOp::Le,
            g::Filter::Contains => edsl::FilterOp::Contains,
            g::Filter::NotContains => edsl::FilterOp::NotContains,
            g::Filter::StartsWith => edsl::FilterOp::StartsWith,
            g::Filter::EndsWith => edsl::FilterOp::EndsWith,
        }
    });
    {value_type: None, ty: if member.value == scalars::Ipv4.type { "Ipv4" } else if value.storage == String.type { "Text" } else if value.storage == Int.type { "Int" } else if value.storage == Bool.type { "Bool" } else { "Number" },
        half_open: False, id: member.id, entity: entity.index, field: field.index, output_type: output, computed: match member.node { g::Node::Column(_) => False, _ => True },
        build: fn(ctx, base) { lower_member(ctx, entity.source, entity.fields, member.node) }, authorized: member.projectable || array::length(ops) > 0, projectable: member.projectable, filterable: array::length(ops) > 0,
        ops, input_kinds: [input], values: [], canonical_values: [], canonical_order: [], canonical_aliases: [], scope: []}
};
def domain_entry: Fn(edsl::EntityEntry, v::BindingFacts) -> edsl::DimensionEntry = fn(entity, binding) {
    let policy = {projectable: binding.group_projectable, filters: binding.group_filters};
    let member: g::Member = {group: binding.definition.id, local: "value", id: binding.id, node: binding.node,
        value: binding.definition.wire, nullable: binding.nullable, aggregate: None, projectable: binding.projectable,
        filters: binding.filters, kind: g::MemberKind::Dimension(policy)};
    let base = dimension_entry(entity, member);
    base <~ {value_type: Some(binding.definition.value), ty: binding.definition.id, half_open: binding.definition.half_open,
        output_type: edsl::OutputType::Text, input_kinds: [edsl::FilterInputKind::Text],
        canonical_values: binding.definition.values, canonical_order: binding.definition.order}
};
def prepare: Fn(String, Array(Declaration), qb::PlanProfile) -> Prepared = fn(revision, declarations, profile) {
    let datasets = array::map(declarations, fn(declared) {
        let checked = m::validate_prepared(declared.dataset);
        array::map(array::flat_map(declared.groups, g::binding_roles), fn(role) {
            if !array::any(checked.roles, fn(registered) { registered == role }) {
                fail!("identity dimension role must be registered on its dataset", checked.id, role.id)
            } else { () }
        });
        if array::length(array::filter(declarations, fn(other) { other.dataset.id == checked.id })) != 1 {
            fail!("typed transform dataset ids must be unique", checked.id)
        } else if array::length(declared.record_counts) > 0 && array::length(checked.grain) == 0 {
            fail!("record count requires a declared dataset grain", checked.id)
        } else { checked }
    });
    let roles = array::flat_map(datasets, fn(dataset) { dataset.roles });
    array::map(roles, fn(role) {
        if array::any(roles, fn(other) { other.entity == role.entity && other.identity != role.identity }) {
            fail!("entity id has conflicting identities across datasets", role.entity)
        } else { () }
    });
    let entities = array::map(array::enumerate(declarations), fn(pair) { entity_entry(pair.1, pair.0) });
    array::map(entities, fn(entity) {
        if !array::any(profile.allowed_operators, fn(op) { op == qb::Operator::Source })
            || !qb::source_profile_accepts(entity.source, profile) {
            fail!("typed dataset source is not allowed by the query profile", entity.id)
        } else { () }
    });
    let dimensions = array::flat_map(array::enumerate(declarations), fn(pair) {
        let members = g::prepare_facts(pair.1.dataset, pair.1.groups);
        let domains = v::prepare(pair.1.dataset, pair.1.domains);
        array::concat([array::map(array::filter(members, fn(member) { member.aggregate == None }), fn(member) { dimension_entry(entities[pair.0], member) }),
            array::map(domains, fn(binding) { domain_entry(entities[pair.0], binding) })])
    });
    let domain_bindings = array::flat_map(declarations, fn(declared) { declared.domains });
    array::map(domain_bindings, fn(binding) {
        if array::any(domain_bindings, fn(other) { other.definition.id == binding.definition.id && other.definition.value != binding.definition.value }) {
            fail!("business domain id has conflicting value types", binding.definition.id)
        } else { () }
    });
    let measures = array::flat_map(array::enumerate(declarations), fn(pair) {
        let entity = entities[pair.0];
        let members = g::prepare_facts(pair.1.dataset, pair.1.groups);
        let grouped = array::map(array::filter(members, fn(member) { member.aggregate != None }), fn(member) {
            let field = match array::find(entity.fields, fn(field) { field.name == anchor_column(member.node) }) {
                Some(value) => value, None => fail!("typed measure input field is missing", member.id),
            };
            let function = match member.aggregate { Some(value) => value, None => fail!("typed measure requires an aggregate", member.id) };
            let value = scalar(member.value);
            let output = if value.storage == Int.type { edsl::OutputType::Integer }
                else if value.storage == Float.type { edsl::OutputType::Number }
                else { fail!("typed Group measure requires a numeric result", member.id) };
            {id: member.id, entity: entity.index, field: field.index, aggregate: function,
                input: edsl::MeasureInput::All, alias: member.id, requires: [], predicate: None, computed: None,
                row_expression: Some({output_type: output, build: fn(ctx, source) { lower_member(ctx, source, entity.fields, member.node) }})}.ty!(edsl::MeasureEntry)
        });
        let counts = array::map(pair.1.record_counts, fn(id) {
            let field = match array::find(entity.fields, fn(field) { field.name == pair.1.dataset.grain[0] }) {
                Some(value) => value, None => fail!("record count grain field is missing", id),
            };
            if !qb::is_sql_identifier(id) { fail!("record count id must be a SQL identifier", id) }
            else { {id, entity: entity.index, field: field.index, aggregate: qb::AggregateFunction::Count,
                input: edsl::MeasureInput::All, alias: id, requires: [], predicate: None, row_expression: None, computed: None}.ty!(edsl::MeasureEntry) }
        });
        array::concat([grouped, counts])
    });
    array::map(dimensions, fn(dimension) {
        if array::length(array::filter(dimensions, fn(other) { other.id == dimension.id })) != 1 {
            fail!("typed transform dimension ids must be unique", dimension.id)
        } else { () }
    });
    array::map(measures, fn(measure) {
        if array::length(array::filter(measures, fn(other) { other.id == measure.id })) != 1
            || array::any(dimensions, fn(dimension) { dimension.entity == measure.entity && dimension.id == measure.id }) {
            fail!("typed transform measure ids must be unique", measure.id)
        } else { () }
    });
    let payload = edsl::validate_transform_contract({revision, entities, dimensions, measures,
        relations: [], business_links: [], native_pairs: [], profile});
    {declarations, payload}
};

# 完整 root 只接受已登记的角色，避免关系端点私下改写 Dataset 的身份声明。
def registered_endpoint: Fn(Array(Declaration), r::Endpoint) -> () = fn(declarations, endpoint) {
    let dataset = match array::find(declarations, fn(entry) { entry.dataset.id == endpoint.dataset.id }) {
        Some(entry) => entry.dataset, None => fail!("relation endpoint dataset is not declared", endpoint.dataset.id),
    };
    let role = match array::find(dataset.roles, fn(role) { role.id == endpoint.role }) {
        Some(value) => value, None => fail!("relation endpoint role is not declared on its dataset", dataset.id, endpoint.role),
    };
    if dataset.row != endpoint.dataset.row || dataset.source != endpoint.dataset.source || dataset.grain != endpoint.dataset.grain
        || !array::any(endpoint.dataset.roles, fn(candidate) { candidate == role }) {
        fail!("relation endpoint conflicts with the registered dataset role", dataset.id, endpoint.role)
    } else { () }
};
def build: Fn(String, Array(Declaration), Array(r::Relation), Array(Alternative), Array(r::Link), qb::PlanProfile) -> Prepared = fn(revision, declarations, relations, alternatives, links, profile) {
    let prepared = prepare(revision, declarations, profile);
    let all_relations = array::concat([relations, array::flat_map(alternatives, fn(alternative) { alternative.choices }),
        array::flat_map(links, fn(link) { [link.a, link.z] })]);
    array::map(all_relations, fn(relation) {
        registered_endpoint(declarations, relation.from);
        registered_endpoint(declarations, relation.to);
        r::validate(relation);
        ()
    });
    let lowered = array::concat([r::lower_all(prepared.payload, relations), array::map(alternatives, fn(alternative) {
        r::lower_alternative(prepared.payload, alternative.id, alternative.choices, alternative.cardinality)
    })]);
    array::map(lowered, fn(relation) {
        if array::length(array::filter(lowered, fn(other) { other.id == relation.id })) != 1 {
            fail!("typed transform relation ids must be unique", relation.id)
        } else { () }
    });
    array::map(links, fn(link) {
        if array::length(array::filter(links, fn(other) { other.id == link.id })) != 1
            || array::any(lowered, fn(relation) { relation.id == link.id }) {
            fail!("typed transform business link ids must be unique", link.id)
        } else { () }
    });
    let with_relations = prepared.payload <~ {relations: lowered};
    prepared <~ {payload: with_relations <~ {business_links: array::map(links, fn(link) { r::lower_link(with_relations, link) })}}
};

pub use self::{Declaration, Prepared, Alternative, ColumnMapping, ColumnBinding, column, map_columns, with_domains, declare, prepare, build};
