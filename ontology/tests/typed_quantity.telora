use ontology::quantity as q;
use std::test as test;
use std::codec as codec;
use std::json as json;
use std::array as array;
use ontology::samples as samples;
use ontology::groups as groups;
use ontology::semantic as semantic;
use ontology::preparation as preparation;

def verify: Fn(Fn() -> Bool) -> test::Test = fn(check) {
    test::should_ok(
        fn() {
            if check() {
                ()
            } else {
                fail!("quantity assertion failed")
            }
        }
    )
};

pub def conversion_is_explicit_and_preserves_fraction: test::Test = verify(
    fn() {
        q::seconds(q::Milliseconds(1500.0)) == q::Seconds(1.5) && q::rate(
            q::Bytes(3.0),
            q::seconds(q::Milliseconds(2000.0))
        ) == Some(q::BytesPerSecond(1.5))
    }
);
pub def unit_types_are_nominal: test::Test = verify(
    fn() {
        q::Seconds.type != q::Milliseconds.type && q::Bytes.type != q::BytesPerSecond.type
    }
);
pub def invalid_duration_is_missing_not_zero: test::Test = verify(
    fn() {
        q::rate(q::Bytes(10.0), q::Seconds(0.0)) == None && q::rate(
            q::Bytes(10.0),
            q::Seconds(-1.0)
        ) == None && q::rate(q::Bytes(0.0), q::Seconds(1.0)) == Some(q::BytesPerSecond(0.0))
    }
);
pub def aggregation_meanings_are_distinct: test::Test = verify(
    fn() {
        let samples: Array(q::Sample) = [
            {amount: q::Bytes(100.0), duration: q::Seconds(1.0)},
            {amount: q::Bytes(900.0), duration: q::Seconds(9.0)},
            {amount: q::Bytes(100.0), duration: q::Seconds(10.0)},
            {amount: q::Bytes(10000.0), duration: q::Seconds(0.0)},
        ];
        q::mean_rate(samples) == Some(q::BytesPerSecond(70.0)) && q::weighted_rate(samples) == Some(
            q::BytesPerSecond(55.0)
        )
    }
);
pub def empty_and_invalid_samples_have_no_aggregate: test::Test = verify(
    fn() {
        let invalid: Array(q::Sample) = [{amount: q::Bytes(5.0), duration: q::Seconds(-1.0)}];
        q::mean_rate([]) == None && q::weighted_rate([]) == None && q::mean_rate(invalid) == None && q::weighted_rate(
            invalid
        ) == None
    }
);
pub def quantity_codec_uses_numeric_payload: test::Test = verify(
    fn() {
        let value = codec::decode@[q::Bytes](json::parse("1.5").unwrap!()).unwrap!();
        value == q::Bytes(1.5) && codec::encode(value) == codec::encode(1.5)
    }
);
type ReceivePower = struct(q::Dbm);
type TransmitPower = struct(q::Dbm);
type ByteSample = struct(q::IntegerBytes);
pub def integer_quantity_means_keep_a_fractional_quantity_type: test::Test = verify(
    fn() {
        q::mean_result_type(q::IntegerKilobitsPerSecond.type) == Some(q::KilobitsPerSecond.type) && q::mean_result_type(
            ByteSample.type
        ) == Some(q::Bytes.type) && q::mean_result_type(q::Dbm.type) == None
    }
);
pub def business_newtypes_inherit_units_and_keep_identity: test::Test = verify(
    fn() {
        q::unit_of(ReceivePower.type) == Some(
            {symbol: "dBm", quantity: "power_level", scale: 1.0}.ty!(q::Unit)
        ) && q::unit_of(Option(ReceivePower).type) == q::unit_of(ReceivePower.type) && ReceivePower.type != TransmitPower.type
    }
);
pub def logarithmic_and_temperature_values_do_not_inherit_float_algebra: test::Test = verify(
    fn() {
        let power = match q::calculation_policy(ReceivePower.type) {
            Some(value) => value,
            None => []
        };
        let temperature = match q::calculation_policy(q::DegreesCelsius.type) {
            Some(value) => value,
            None => []
        };
        array::any(
            power,
            fn(op) {
                op == q::Calculation::Mean
            }
        ) && !array::any(
            power,
            fn(op) {
                op == q::Calculation::Sum || op == q::Calculation::Add || op == q::Calculation::Ratio
            }
        ) && !array::any(
            temperature,
            fn(op) {
                op == q::Calculation::Add || op == q::Calculation::Multiply
            }
        )
    }
);
pub def logarithmic_power_cannot_gain_a_sum_statistic: test::Test = test::should_fail_with(
    fn() {
        samples::group("power", q::Dbm.type, samples::Statistic::Sum, [], None)
    },
    "sample statistic exceeds type calculation capabilities"
);
pub def unit_scales_do_not_coerce_storage_or_wire_values: test::Test = verify(
    fn() {
        codec::encode(q::IntegerMegabytes(1024)) == codec::encode(1024) && codec::encode(
            q::IntegerKilobitsPerSecond(125)
        ) == codec::encode(125) && q::unit_of(q::IntegerMegabytes.type) == q::unit_of(
            q::Megabytes.type
        ) && q::IntegerMegabytes.type != q::Megabytes.type && q::unit_of(q::Milliseconds.type) == Some(
            {symbol: "ms", quantity: "time", scale: 0.001}.ty!(q::Unit)
        )
    }
);
pub def text_quantities_keep_text_storage_and_do_not_gain_numeric_operations: test::Test = verify(
    fn() {
        codec::encode(q::TextDegreesCelsius("38.5")) == codec::encode("38.5") && groups::representation(
            q::TextDegreesCelsius.type
        ) == String.type && q::TextMegabytes.type != String.type
    }
);
@semantic::table("conflict")
type ConflictingFieldUnit = struct {
    @q::field_unit("W", "power", 1.0)
    value: q::DegreesCelsius
};
pub def a_field_cannot_relabel_a_temperature_as_watts: test::Test = test::should_fail_with(
    fn() {
        preparation::prepare(ConflictingFieldUnit.type)
    },
    "field unit conflicts with its nominal type"
);

pub def bit_rate_units_share_linear_calculation_capabilities: test::Test = verify(
    fn() {
        let policy = q::calculation_policy(q::BitsPerSecond.type);
        policy == q::calculation_policy(q::KilobitsPerSecond.type) &&
        policy == q::calculation_policy(q::IntegerKilobitsPerSecond.type) &&
        policy == q::calculation_policy(q::MegabitsPerSecond.type) &&
        policy == q::calculation_policy(q::IntegerMegabitsPerSecond.type) &&
        match policy {
            Some(operations) => array::any(operations, fn(op) { op == q::Calculation::Sum }),
            None => False
        }
    }
);
