        && array::length(string::split(q.sql, "GROUP BY")) == 1
        && array::length(string::split(q.sql, "sum(")) == 1
        && q.bindings == [qb::Val::String("public"), qb::Val::String("00:1A:2B:00:00:00"), qb::Val::String("ne.category.ac"), qb::Val::String("AC"), qb::Val::String("WAC"), qb::Val::String("2024-01-01T00:00:00Z"), qb::Val::String("2024-01-31T00:00:00Z"), qb::Val::Int(5)] {
