pub def frame_and_port_kpi_qualifications_remain_independent: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "exists":[
            {"anchor":"device", "nodes":[{"id":"frame","entity":"frame"}],
             "edges":[{"relation":"frame_belongs_to_device","from":"frame","to":"device"}],
             "filters":[{"node":"frame","dimension":"frame_oper_state","op":"eq",
                         "kind":"text","value":"normal"}]},
            {"anchor":"device",
             "nodes":[{"id":"port","entity":"port"},{"id":"sample","entity":"interface_kpi"}],
             "edges":[{"relation":"port_belongs_to_device","from":"port","to":"device"},
                      {"relation":"interface_kpi_of_port","from":"sample","to":"port"}],
             "having":[{"node":"sample","measure":"interface_tx","op":"gt",
                        "kind":"number","value":80.0}]}
        ]
    }"#).unwrap!());
    if string::contains(query.sql, "EXISTS (SELECT 1 FROM I_EnterpriseFrame AS frame")
        && string::contains(query.sql, "EXISTS (SELECT 1 FROM I_EnterpriseNetworkLTP AS port")
        && string::contains(query.sql, "GROUP BY port.id HAVING avg(sample.ifOutPktSpeed)")
        && !string::contains(query.sql, "JOIN I_EnterpriseFrame") { True }
    else { fail!(`frame qualification multiplied interface samples: \{query.sql}`, query.bindings) }
});

pub def alarm_severity_alternatives_keep_one_device_grain: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "exists":[{"anchor":"device", "nodes":[{"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
            "any_of":[{"node":"alarm","dimension":"alarm_severity","kind":"text",
                       "values":["critical","major"]}],
            "filters":[{"node":"alarm","dimension":"alarm_cleared","op":"eq",
                        "kind":"text","value":"uncleared"}]
        }]
    }"#).unwrap!());
    if string::contains(query.sql, "alarm.SEVERITY = ?")
        && string::contains(query.sql, " OR ")
        && string::contains(query.sql, "alarm.CLEARED = ?")
        && query.bindings == [qb::Val::Int(0), qb::Val::String("1"), qb::Val::String("2")] { True }
    else { fail!(`alarm alternatives lost OR semantics or canonical bindings: \{query.sql}`, query.bindings) }
});

