use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# ServerPsu独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@registry::entity("server_psu_entity")
type Identity = struct {
    id: ComponentId
};
@registry::dataset("server_psu", "PhysicalServerPSU", ["id"])
@registry::roles([subject, parent, tenant])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("server_psu__ratedPower", Int.type, True, g::numeric_filters),
            g::input(m::field(PhysicalServerPSU.type, Int.type, "source_ratedPower")),
            "server_psu__ratedPower",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_psu__slotId", Int.type, True, g::numeric_filters),
            g::input(m::field(PhysicalServerPSU.type, Int.type, "source_slotId")),
            "server_psu__slotId",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
type PhysicalServerPSU = struct {
    id: ComponentId,
    @m::column("parentResId")
    parent_res_id: server::ServerOriginId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @g::search("server_psu_manufacturer")
    manufacturer: String,
    @m::column("healthStatus")
    @v::classification(health, "server_psu_health")
    health_status: Int,
    @m::column("name")
    @g::search("server_psu__name")
    source_name: String,
    @m::column("redundancyMode")
    @g::exact("server_psu__redundancyMode")
    source_redundancyMode: String,
    @m::column("workMode")
    @g::exact("server_psu__workMode")
    source_workMode: String,
    @m::column("ratedPower")
    source_ratedPower: Int,
    @m::column("sn")
    @g::search("server_psu__sn")
    source_sn: String,
    @m::column("slotId")
    source_slotId: Int,
    @m::column("psuName")
    @g::search("server_psu__psuName")
    source_psuName: String,
    @m::column("projectId")
    @g::exact("server_psu__projectId")
    source_projectId: String,
    @m::column("resId")
    @g::exact("server_psu__resId")
    source_resId: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(PhysicalServerPSU) = registry::dataset_of(PhysicalServerPSU.type);
def subject: m::Role(PhysicalServerPSU) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerPSU.type, ComponentId.type, "id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def parent: m::Role(PhysicalServerPSU) = m::role(
    dataset,
    server::origin_entity,
    "server_origin",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerPSU.type, server::ServerOriginId.type, "parent_res_id"),
            m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServerPSU) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerPSU.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type ServerPsuHealth = enum {
    @ev::itag(-2)
    @ev::description("unknown", "未知")
    Unknown,
    @ev::itag(1)
    @ev::description("warning", "警告")
    Warning,
    @ev::itag(0)
    @ev::description("normal", "正常")
    Normal,
    @ev::itag(2)
    @ev::description("minor", "一般")
    Minor,
    @ev::itag(3)
    @ev::description("major", "严重")
    Major,
    @ev::itag(4)
    @ev::description("critical", "紧急")
    Critical,
    @ev::itag(-1)
    @ev::description("error", "错误")
    Error,
};
def health: v::Domain(ServerPsuHealth, Int) = v::from_enum(
    "ServerPsuHealth",
    ServerPsuHealth.type,
    Int.type,
    False
);
def tenant_cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "psu_parent_server",
        r::endpoint(dataset.row, parent.id),
        r::endpoint(server::dataset.row, server::origin.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_PhysicalServerPSU",
        r::endpoint(server::dataset.row, server::origin.id),
        r::endpoint(dataset.row, parent.id),
        tenant_cardinality
    ),
    r::relation(
        "source_PhysicalServerPSU_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        tenant_cardinality
    ),
    r::relation(
        "psu_belongs_to_tenant",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        tenant_cardinality
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerPSU, Identity};
