use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
@domain::subject("EnterpriseSlot", "obj_id")
@domain::dataset("kpi-network-slot-info", "kpi_network_slot_info", ["obj_id","ts"])
@domain::metric("ts")
pub type KpiNetworkSlotInfo = struct {
    @m::column("timestamp")
    @g::field_view(g::dimension_group("kpi-network-slot-info/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "nsi_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("nsi_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("nsi_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("nsi_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @g::field_view(g::dimension_group("kpi-network-slot-info/obj_id", domain::Reference(ids::EnterpriseSlot2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "nsi_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::EnterpriseSlot2KpiByObjId),
    @m::column("cpuUsage")
    @g::field_view(g::dimension_group("kpi-network-slot-info/cpu_usage", metric::KpiNetworkSlotInfoCpuUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "nsi_cpu_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-network-slot-info/cpu_usage", metric::KpiNetworkSlotInfoCpuUsage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "nsi_cpu_usage"}, {statistic: samples::Statistic::Max, publish: "nsi_cpu_usage_max"}, {statistic: samples::Statistic::Min, publish: "nsi_cpu_usage_min"}])
    cpu_usage: Option(metric::KpiNetworkSlotInfoCpuUsage),
    @m::column("memUsage")
    @g::field_view(g::dimension_group("kpi-network-slot-info/mem_usage", metric::KpiNetworkSlotInfoMemUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "nsi_mem_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-network-slot-info/mem_usage", metric::KpiNetworkSlotInfoMemUsage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "nsi_mem_usage"}, {statistic: samples::Statistic::Max, publish: "nsi_mem_usage_max"}, {statistic: samples::Statistic::Min, publish: "nsi_mem_usage_min"}])
    mem_usage: Option(metric::KpiNetworkSlotInfoMemUsage),
    @m::column("hwEntityTemperature")
    @g::field_view(g::dimension_group("kpi-network-slot-info/hw_entity_temperature", metric::KpiNetworkSlotInfoHwEntityTemperature.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "nsi_hw_entity_temperature_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-network-slot-info/hw_entity_temperature", metric::KpiNetworkSlotInfoHwEntityTemperature.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("°C")), [{statistic: samples::Statistic::Mean, publish: "nsi_hw_entity_temperature"}, {statistic: samples::Statistic::Max, publish: "nsi_hw_entity_temperature_max"}, {statistic: samples::Statistic::Min, publish: "nsi_hw_entity_temperature_min"}])
    hw_entity_temperature: Option(metric::KpiNetworkSlotInfoHwEntityTemperature),
    @m::column("hwEntityVoltage")
    @g::field_view(g::dimension_group("kpi-network-slot-info/hw_entity_voltage", metric::KpiNetworkSlotInfoHwEntityVoltage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "nsi_hw_entity_voltage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-network-slot-info/hw_entity_voltage", metric::KpiNetworkSlotInfoHwEntityVoltage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("V")), [{statistic: samples::Statistic::Mean, publish: "nsi_hw_entity_voltage"}, {statistic: samples::Statistic::Max, publish: "nsi_hw_entity_voltage_max"}, {statistic: samples::Statistic::Min, publish: "nsi_hw_entity_voltage_min"}])
    hw_entity_voltage: Option(metric::KpiNetworkSlotInfoHwEntityVoltage),
};
