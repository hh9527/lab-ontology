use crate::datasets::terminal_info;
@domain::subject("NetworkElement", "id")
@domain::dataset("pon-element", "EntPonElement", ["id"])
@domain::relations(relations)
pub type PonElement = struct {
    @g::field_view(g::dimension_group("pon-element/id", ids::NetworkElementById.type, True, [g::Filter::Eq]), "pe_id", True, [g::Filter::Eq])
    @domain::count("pe_count")
    id: ids::NetworkElementById,
    @g::field_view(g::dimension_group("pon-element/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: Option(String),
    @g::field_view(g::dimension_group("pon-element/alias", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_alias", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    alias: Option(String),
    @g::field_view(g::dimension_group("pon-element/classification/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "pe_classification_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map_or(domains::PeClassification.type, "pe_classification", [v::member(domains::PeClassification::Olt, ["ne.category.olt"]), v::member(domains::PeClassification::Onu, ["ne.category.pon.onu"]), v::member(domains::PeClassification::Spl, ["ne.category.pon.spl"])], domains::PeClassification::Unknown)
    classification: Option(String),
    @m::column("commuState")
    @g::field_view(g::dimension_group("pon-element/commu_state/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "pe_communication_state_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::PeCommunicationState.type, "pe_communication_state", [v::member(domains::PeCommunicationState::Online, ["1"]), v::member(domains::PeCommunicationState::Offline, ["2","3","4","14","15"])])
    commu_state: Option(String),
    @m::column("adminState")
    @g::field_view(g::dimension_group("pon-element/admin_state", String.type, True, [g::Filter::Eq]), "pe_admin_state_raw", True, [g::Filter::Eq])
    @v::map_or(domains::PeAdminState.type, "pe_admin_state", [v::member(domains::PeAdminState::Enabled, ["Enabled"]), v::member(domains::PeAdminState::Disabled, ["Disabled"])], domains::PeAdminState::Unknown)
    admin_state: Option(String),
    @g::field_view(g::dimension_group("pon-element/manufacturer", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_manufacturer", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    manufacturer: Option(String),
    @m::column("productName")
    @g::field_view(g::dimension_group("pon-element/product_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_product_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    product_name: Option(String),
    @g::field_view(g::dimension_group("pon-element/sn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_sn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    sn: Option(String),
    @g::field_view(g::dimension_group("pon-element/esn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_esn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    esn: Option(String),
    @g::field_view(g::dimension_group("pon-element/mac", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_mac", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    mac: Option(String),
    @m::column("ipAddress")
    @g::field_view(g::dimension_group("pon-element/ip_address", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_ip_address", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ip_address: Option(String),
    @g::field_view(g::dimension_group("pon-element/version", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_version", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    version: Option(String),
    @m::column("neOsVersion")
    @g::field_view(g::dimension_group("pon-element/ne_os_version", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_ne_os_version", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ne_os_version: Option(String),
    @m::column("nativeId")
    @g::field_view(g::dimension_group("pon-element/native_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "pe_native_id", True, [g::Filter::Eq])
    native_id: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("objSysId")
    @g::field_view(g::dimension_group("pon-element/obj_sys_id", domain::Reference(ids::PonElementByObjSysId).type, True, [g::Filter::Eq]), "pe_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::PonElementByObjSysId)),
    @m::column("refParentNE")
    @g::field_view(g::dimension_group("pon-element/ref_parent_ne", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "pe_parent_ne_id", True, [g::Filter::Eq])
    ref_parent_ne: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("parentOltResId")
    @g::field_view(g::dimension_group("pon-element/parent_olt_res_id", String.type, True, [g::Filter::Eq]), "pe_parent_olt_res_id", True, [g::Filter::Eq])
    parent_olt_res_id: Option(String),
    @m::column("refParentSubnet")
    @g::field_view(g::dimension_group("pon-element/ref_parent_subnet", domain::Reference(ids::SubnetById).type, True, [g::Filter::Eq]), "pe_parent_subnet_id", True, [g::Filter::Eq])
    ref_parent_subnet: Option(domain::Reference(ids::SubnetById)),
    @m::column("parentNeNativeId")
    @g::field_view(g::dimension_group("pon-element/parent_ne_native_id", String.type, True, [g::Filter::Eq]), "pe_parent_ne_native_id", True, [g::Filter::Eq])
    parent_ne_native_id: Option(String),
    @g::field_view(g::dimension_group("pon-element/remark", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "pe_remark", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    remark: Option(String),
    @m::column("createTime")
    @g::field_view(g::dimension_group("pon-element/create_time", Int.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "pe_create_ms", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    create_time: Option(Int),
};

pub def relations: Array(r::Relation) = [
    r::relation("pe__peo2", domain::endpoint(PonElement.type, "obj_sys_id"), domain::endpoint(pon_element_olt_2_kpi::PonElementOlt2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("pe__poelon", domain::endpoint(PonElement.type, "obj_sys_id"), domain::endpoint(pon_element_onu_2_kpi::PonElementOnu2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("pe__pe", domain::endpoint(PonElement.type, "id"), domain::endpoint(PonElement.type, "ref_parent_ne"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("pe__pe_rev", domain::endpoint(PonElement.type, "ref_parent_ne"), domain::endpoint(PonElement.type, "id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("pe__subnet", domain::endpoint(PonElement.type, "ref_parent_subnet"), domain::endpoint(subnet::Subnet.type, "id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("pe__ar_rev", domain::endpoint(PonElement.type, "native_id"), domain::endpoint(alarm_record::AlarmRecord.type, "me_dn"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("pe__ti", domain::endpoint(PonElement.type, "id"), domain::endpoint(terminal_info::TerminalInfo.type, "access_device_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
