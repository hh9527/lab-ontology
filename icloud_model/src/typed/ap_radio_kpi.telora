use super::metric_values as metric;
use ontology::quantity as statistic_quantity;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::quantity as presentation;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 保留暂定租户／资源／UTC 样本身份，生产唯一性仍待 #51 确认。
use super::inventory as i;
use super::ap_quantities as a;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::quantity as q;
use ontology::samples as samples;
use ontology::query as qb;
@domain::entity_by("ApRadio")
type ApRadioById = struct(String);
@domain::bind(ApRadioById.type, "source_resId")
@g::groupable(["source_NetworkApRadioKPI__frequency"])
@domain::dataset(
    "source_NetworkApRadioKPI",
    "NetworkApRadioKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
@domain::relations(source_relations)
type NetworkApRadioKPI = struct {
    @m::column("ts")
    @g::view("source_NetworkApRadioKPI__ts", True, g::numeric_filters)
    @g::utc_bucket_view("source_NetworkApRadioKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_NetworkApRadioKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_NetworkApRadioKPI_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("ap_radio_sample_count")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkApRadioKPI__resId")
    source_resId: ApRadioById,
    @m::column("tenantId")
    @g::exact("source_NetworkApRadioKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_NetworkApRadioKPI__parentId")
    @domain::attribute("source_parentId")
    source_parentId: domain::Reference(i::DeviceById),
    @m::column("projectId")
    @g::exact("source_NetworkApRadioKPI__projectId")
    source_projectId: String,
    @m::column("frequency")
    @g::exact("source_NetworkApRadioKPI__frequency")
    source_frequency: SourceNetworkApRadioKPIFrequency,
    @m::column("channel")
    @g::exact("source_NetworkApRadioKPI__channel")
    source_channel: String,
    @m::column("radioName")
    @g::search("source_NetworkApRadioKPI__radioName")
    @domain::attribute("source_radioName")
    source_radioName: String,
    @m::column("hwRadioChUtilizationRate")
    @g::view("source_NetworkApRadioKPI__hwRadioChUtilizationRate", True, g::numeric_filters)
    @samples::field(
        metric::RadioChannelUtilization_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_channel_usage"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_channel_usage_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_channel_usage_min"}
        ]
    )
    @samples::valid_count("source_hwRadioChUtilizationRateEffcnt")
    @domain::count("ap_radio_channel_usage_observation_count")
    source_hwRadioChUtilizationRate: metric::RadioChannelUtilization,
    @m::column("hwRadioNoise")
    @g::view("source_NetworkApRadioKPI__hwRadioNoise", True, g::numeric_filters)
    @samples::field(
        p::Dbm_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_noise"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_noise_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_noise_min"}
        ]
    )
    @samples::valid_count("source_hwRadioNoiseEffcnt")
    @domain::count("ap_radio_noise_observation_count")
    source_hwRadioNoise: p::Dbm,
    @m::column("hwWlanRadioRetryFramesRate")
    @g::view("source_NetworkApRadioKPI__hwWlanRadioRetryFramesRate", True, g::numeric_filters)
    @samples::field(
        metric::RadioRetryRate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_retry_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_retry_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_retry_rate_min"}
        ]
    )
    @samples::valid_count("source_hwWlanRadioRetryFramesRateEffcnt")
    @domain::count("ap_radio_retry_rate_observation_count")
    source_hwWlanRadioRetryFramesRate: metric::RadioRetryRate,
    @m::column("upwardSpeed")
    @g::view("source_NetworkApRadioKPI__upwardSpeed", True, g::numeric_filters)
    @samples::field(
        a::integer_rate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_uplink_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_uplink_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_uplink_rate_min"}
        ]
    )
    @samples::valid_count("source_upwardSpeedEffcnt")
    @domain::count("ap_radio_uplink_rate_observation_count")
    source_upwardSpeed: a::IntegerKilobitsPerSecond,
    @m::column("downwardSpeed")
    @g::view("source_NetworkApRadioKPI__downwardSpeed", True, g::numeric_filters)
    @samples::field(
        a::integer_rate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_downlink_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_downlink_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_downlink_rate_min"}
        ]
    )
    @samples::valid_count("source_downwardSpeedEffcnt")
    @domain::count("ap_radio_downlink_rate_observation_count")
    source_downwardSpeed: a::IntegerKilobitsPerSecond,
    @m::column("packetLossRate")
    @g::view("source_NetworkApRadioKPI__packetLossRate", True, g::numeric_filters)
    @samples::field(
        metric::RadioPacketLossRate_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_packet_loss_rate"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_packet_loss_rate_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_packet_loss_rate_min"}
        ]
    )
    @samples::valid_count("source_packetLossRateEffcnt")
    @domain::count("ap_radio_packet_loss_rate_observation_count")
    source_packetLossRate: metric::RadioPacketLossRate,
    @m::column("connectedTerminals")
    @g::view("source_NetworkApRadioKPI__connectedTerminals", True, g::numeric_filters)
    @samples::field(
        a::count_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_connected_terminals"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_connected_terminals_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_connected_terminals_min"}
        ]
    )
    @samples::valid_count("source_connectedTerminalsEffcnt")
    @domain::count("ap_radio_connected_terminals_observation_count")
    source_connectedTerminals: q::Count,
    @m::column("rssi")
    @g::view("source_NetworkApRadioKPI__rssi", True, g::numeric_filters)
    @samples::field(
        a::rssi_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "ap_radio_rssi"},
            {statistic: samples::Statistic::Max, publish: "ap_radio_rssi_max"},
            {statistic: samples::Statistic::Min, publish: "ap_radio_rssi_min"}
        ]
    )
    @samples::valid_count("source_rssiEffcnt")
    @domain::count("ap_radio_rssi_observation_count")
    source_rssi: a::ReportedRssi,
    @m::column("hwRadioChUtilizationRateEffcnt")
    @g::view("source_NetworkApRadioKPI__hwRadioChUtilizationRateEffcnt", True, g::numeric_filters)
    source_hwRadioChUtilizationRateEffcnt: a::EffectiveCount,
    @m::column("hwRadioNoiseEffcnt")
    @g::view("source_NetworkApRadioKPI__hwRadioNoiseEffcnt", True, g::numeric_filters)
    source_hwRadioNoiseEffcnt: a::EffectiveCount,
    @m::column("hwWlanRadioRetryFramesRateEffcnt")
    @g::view("source_NetworkApRadioKPI__hwWlanRadioRetryFramesRateEffcnt", True, g::numeric_filters)
    source_hwWlanRadioRetryFramesRateEffcnt: a::EffectiveCount,
    @m::column("upwardSpeedEffcnt")
    @g::view("source_NetworkApRadioKPI__upwardSpeedEffcnt", True, g::numeric_filters)
    source_upwardSpeedEffcnt: a::EffectiveCount,
    @m::column("downwardSpeedEffcnt")
    @g::view("source_NetworkApRadioKPI__downwardSpeedEffcnt", True, g::numeric_filters)
    source_downwardSpeedEffcnt: a::EffectiveCount,
    @m::column("packetLossRateEffcnt")
    @g::view("source_NetworkApRadioKPI__packetLossRateEffcnt", True, g::numeric_filters)
    source_packetLossRateEffcnt: a::EffectiveCount,
    @m::column("connectedTerminalsEffcnt")
    @g::view("source_NetworkApRadioKPI__connectedTerminalsEffcnt", True, g::numeric_filters)
    source_connectedTerminalsEffcnt: a::EffectiveCount,
    @m::column("rssiEffcnt")
    @g::view("source_NetworkApRadioKPI__rssiEffcnt", True, g::numeric_filters)
    source_rssiEffcnt: a::EffectiveCount,
};

@knowledge_policy::reverse_references(True)
type SourceNetworkApRadioKPIFrequency = enum {
    @ev::description("2.4G", "")
    @ev::rename("1")
    Ghz2Point4,

    @ev::description("5G", "")
    @ev::rename("2")
    Ghz5,

    @ev::description("6G", "")
    @ev::rename("3")
    Ghz6,
};

pub use self::{NetworkApRadioKPI};

pub use self::{SourceNetworkApRadioKPIFrequency};

def source_relations: Array(r::Relation) = [
    r::relation(
        "source_EntNetworkElement_NetworkApRadioKPI",
        i::ap_subject,
        domain::endpoint(NetworkApRadioKPI.type, "source_parentId"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    )
];
