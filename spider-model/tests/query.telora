# spider-model/tests/query.telora
#
# Contract tests for the ontology public flat closed intent protocol bound to
# the student_transcripts_tracking prepared payload.  Each exported `check_*`
# definition is evaluated by the exported Test: `test query` reports a
# diagnostic whenever the lowering or assertion fails.

import "@src/model" { payload };
import "std/test" as test;
import "ontology/intent" as intent;
import "ontology/query" as qb;
import "std/array" as array;
import "std/string" as string;
import "std/value" { Value };
import "std/json" as json;

def intent_of_json: Fn(String) -> Value = fn(text) {
    let parsed = json.parse(text);
    match parsed {
        Ok(value) => value,
        Err(_) => fail!("test intent did not parse"),
    }
};

def run_json: Fn(String) -> qb.Query = fn(text) {
    let lower = intent.query_intent_lower_factory(payload, "public");
    lower(intent_of_json(text))
};

def contains_literal: Fn(String, String) -> Bool = fn(sql, literal) {
    array.length(string.split(sql, literal)) > 1
};

def binding_count: Fn(qb.Query) -> Int = fn(q) {
    array.length(q.bindings)
};

# --- list -------------------------------------------------------------------

def check_address_lines = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["address_line1","address_line2"],"filters":[],"ordering":[],"limit":null,"offset":null}`);
    if contains_literal(q.sql, "SELECT") { True } else { fail!("address lines intent failed", q.sql) }
};

def check_zip_by_city = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["address_zip"],"filters":[{"dimension":"address_city","op":"eq","kind":"text","value":"Port Chelsea"}],"ordering":[],"limit":null,"offset":null}`);
    let no_literal = !contains_literal(q.sql, "Port Chelsea");
    if no_literal && binding_count(q) == 1 { True } else { fail!("zip by city intent failed", q.sql) }
};

def check_sections_desc = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["section_name"],"filters":[],"ordering":[{"target":"Dimension","id":"section_name","direction":"Desc"}],"limit":null,"offset":null}`);
    if contains_literal(q.sql, "ORDER BY") && contains_literal(q.sql, "DESC") {
        True
    } else {
        fail!("sections desc intent failed", q.sql)
    }
};

def check_course_descriptions = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["course_name","course_description"],"filters":[],"ordering":[],"limit":null,"offset":null}`);
    if contains_literal(q.sql, "co.course_description") {
        True
    } else {
        fail!("course description projection failed", q.sql)
    }
};

def check_department_contains = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["department_description"],"filters":[{"dimension":"department_name","op":"contains","kind":"text","value":"computer"}],"ordering":[],"limit":null,"offset":null}`);
    if binding_count(q) == 2 { True } else { fail!("department contains intent failed", q.sql) }
};

def check_student_phone = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["student_cell"],"filters":[{"dimension":"student_first_name","op":"eq","kind":"text","value":"Timmothy"},{"dimension":"student_last_name","op":"eq","kind":"text","value":"Ward"}],"ordering":[],"limit":null,"offset":null}`);
    if binding_count(q) == 2 { True } else { fail!("student phone intent failed", q.sql) }
};

def check_first_registered = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["student_first_name","student_middle_name","student_last_name"],"filters":[],"ordering":[{"target":"Dimension","id":"student_date_registered","direction":"Asc"}],"limit":1,"offset":null}`);
    if contains_literal(q.sql, "st.date_first_registered") && binding_count(q) == 1 {
        True
    } else {
        fail!("first registered intent failed", q.sql)
    }
};

def check_same_address_fields = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["student_id"],"filters":[{"left":"student_current_address","right":"student_permanent_address","op":"eq"}],"ordering":[],"limit":null,"offset":null}`);
    if contains_literal(q.sql, "st.current_address_id = st.permanent_address_id") && binding_count(q) == 0 {
        True
    } else {
        fail!("field-to-field predicate intent failed", q.sql)
    }
};

# --- distinct / count / aggregate ------------------------------------------

def check_distinct_degree_names = do {
    let q = run_json(`{"op":"distinct","measures":[],"dimensions":["degree_summary_name"],"filters":[],"ordering":[],"limit":null,"offset":null}`);
    if contains_literal(q.sql, "DISTINCT") && !contains_literal(q.sql, "count(") {
        True
    } else {
        fail!("distinct degree names intent failed", q.sql)
    }
};

def check_degrees_in_department = do {
    let q = run_json(`{"op":"count","measures":["degree_count"],"dimensions":[],"filters":[{"dimension":"department_name","op":"eq","kind":"text","value":"engineer"}],"ordering":[],"limit":null,"offset":null}`);
    if binding_count(q) == 1 { True } else { fail!("degrees in department intent failed", q.sql) }
};

def check_degree_count_by_department = do {
    let q = run_json(`{"op":"aggregate","measures":["degree_count"],"dimensions":["department_name"],"filters":[],"ordering":[],"limit":null,"offset":null}`);
    # Probe the actual select ordering to pin the documented contract: detect
    # whether "count(" appears before or after the department column.
    let parts = string.split(q.sql, "de.department_name");
    let measure_first = array.length(parts) > 1 && contains_literal(parts[0], "count(");
    if measure_first {
        True
    } else {
        fail!("aggregate does not render the measure before the dimension")
    }
};

def check_students_by_current_city_count = do {
    let q = run_json(`{"op":"aggregate","measures":["student_count"],"dimensions":["current_city"],"filters":[],"ordering":[],"limit":null,"offset":null}`);
    if contains_literal(q.sql, "GROUP BY") { True } else { fail!("students grouped by current city failed", q.sql) }
};

# --- exists / absence ------------------------------------------------------

def check_students_in_master_exists = do {
    let q = run_json(`{"op":"exists","measures":[],"dimensions":["student_first_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"exists":[{"target":"degree_program","filters":[{"dimension":"degree_summary_name","op":"eq","kind":"text","value":"Master"}]}]}`);
    if contains_literal(q.sql, "EXISTS") && !contains_literal(q.sql, "student_count") && binding_count(q) == 1 {
        True
    } else {
        fail!("students in master (exists) intent failed", q.sql)
    }
};

def check_students_not_in_master_absence = do {
    let q = run_json(`{"op":"absence","measures":[],"dimensions":["student_first_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"exists":[{"target":"degree_program","filters":[{"dimension":"degree_summary_name","op":"eq","kind":"text","value":"Master"}]}]}`);
    if contains_literal(q.sql, "NOT EXISTS") && !contains_literal(q.sql, "student_count") {
        True
    } else {
        fail!("students not in master (absence) intent failed", q.sql)
    }
};

# --- hidden related aggregate order (top) ----------------------------------

def check_semester_top_enrolments = do {
    let q = run_json(`{"op":"top","measures":[],"dimensions":["semester_name"],"filters":[],"ordering":[{"target":"Measure","id":"enrolment_count","direction":"Desc"}],"limit":1,"offset":null}`);
    if contains_literal(q.sql, "GROUP BY") && contains_literal(q.sql, "ORDER BY")
        && !contains_literal(q.sql, "AS enrolment_count") && binding_count(q) == 1 {
        True
    } else {
        fail!("semester top by enrolments (related) intent failed", q.sql)
    }
};

def check_degree_top_enrolments = do {
    let q = run_json(`{"op":"top","measures":[],"dimensions":["degree_summary_name"],"filters":[],"ordering":[{"target":"Measure","id":"enrolment_count","direction":"Desc"}],"limit":1,"offset":null}`);
    if contains_literal(q.sql, "GROUP BY") && contains_literal(q.sql, "ORDER BY")
        && !contains_literal(q.sql, "AS enrolment_count") && binding_count(q) == 1 {
        True
    } else {
        fail!("degree top by enrolments (related) intent failed", q.sql)
    }
};

def check_current_address_top_students = do {
    let q = run_json(`{"op":"top","measures":[],"dimensions":["current_city"],"filters":[],"ordering":[{"target":"Measure","id":"student_count","direction":"Desc"}],"limit":1,"offset":null}`);
    if contains_literal(q.sql, "GROUP BY") && contains_literal(q.sql, "ORDER BY")
        && !contains_literal(q.sql, "AS student_count") {
        True
    } else {
        fail!("current address top by students (reverse related) intent failed", q.sql)
    }
};

def check_current_address_line_multi = do {
    let q = run_json(`{"op":"top","measures":[],"dimensions":["current_address_id","current_line1","current_city"],"filters":[],"ordering":[{"target":"Measure","id":"student_count","direction":"Desc"}],"limit":1,"offset":null}`);
    if contains_literal(q.sql, "ca.city") && contains_literal(q.sql, "ca.line_1")
        && contains_literal(q.sql, "ca.address_id") && contains_literal(q.sql, "ORDER BY")
        && !contains_literal(q.sql, "AS student_count") {
        True
    } else {
        fail!("current-address role lines with reverse hidden count order failed", q.sql)
    }
};

# --- hidden related aggregate having ---------------------------------------

def check_students_min_enrolments_having = do {
    let q = run_json(`{"op":"top","measures":[],"dimensions":["student_first_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"hidden_having":[{"measure":"enrolment_count","op":"ge","kind":"int","value":2}]}`);
    if contains_literal(q.sql, "HAVING") && binding_count(q) == 1
        && !contains_literal(q.sql, "AS enrolment_count") {
        True
    } else {
        fail!("student min-enrolments HAVING intent failed", q.sql)
    }
};

def check_students_min_enrol_having_multi = do {
    # "恰好 N 个" maps to HAVING eq N: a bare number is not widened to a lower
    # bound.  Multi-attribute projections stay on the base subject.
    let q = run_json(`{"op":"top","measures":[],"dimensions":["student_id","student_first_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"hidden_having":[{"measure":"enrolment_count","op":"eq","kind":"int","value":3}]}`);
    if contains_literal(q.sql, "HAVING") && contains_literal(q.sql, "st.student_id")
        && contains_literal(q.sql, "st.first_name") && !contains_literal(q.sql, ">= ?")
        && !contains_literal(q.sql, "AS enrolment_count") && binding_count(q) == 1 {
        True
    } else {
        fail!("exact-count HAVING (eq N) with multi-attribute projection failed", q.sql)
    }
};

# --- parameter binding / fidelity / determinism ----------------------------

def check_two_bindings_parameterized = do {
    let q = run_json(`{"op":"list","measures":[],"dimensions":["student_first_name","student_last_name"],"filters":[{"dimension":"student_first_name","op":"eq","kind":"text","value":"AAA"},{"dimension":"student_last_name","op":"eq","kind":"text","value":"BBB"}],"ordering":[],"limit":null,"offset":null}`);
    if binding_count(q) == 2 && !contains_literal(q.sql, "AAA") && !contains_literal(q.sql, "BBB") {
        True
    } else {
        fail!("two-binding parameterization failed", q.sql)
    }
};

def check_string_fidelity = do {
    let upper: String = `{"op":"list","measures":[],"dimensions":["student_first_name"],"filters":[{"dimension":"student_first_name","op":"eq","kind":"text","value":"MiXeD"}],"ordering":[],"limit":null,"offset":null}`;
    let lower: String = `{"op":"list","measures":[],"dimensions":["student_first_name"],"filters":[{"dimension":"student_first_name","op":"eq","kind":"text","value":"mixed"}],"ordering":[],"limit":null,"offset":null}`;
    let q1 = run_json(upper);
    let q2 = run_json(lower);
    let same_sql = q1.sql == q2.sql;
    let no_lit = !contains_literal(q1.sql, "MiXeD") && !contains_literal(q2.sql, "mixed");
    let preserved = binding_count(q1) == 1 && binding_count(q2) == 1;
    if same_sql && no_lit && preserved {
        True
    } else {
        fail!("string filter values were not preserved verbatim")
    }
};

def check_lowering_deterministic = do {
    let text: String = `{"op":"top","measures":[],"dimensions":["semester_name"],"filters":[],"ordering":[{"target":"Measure","id":"enrolment_count","direction":"Desc"}],"limit":1,"offset":null}`;
    let a = run_json(text);
    let b = run_json(text);
    if a.sql == b.sql && binding_count(a) == binding_count(b) {
        True
    } else {
        fail!("intent lowering is not deterministic")
    }
};

def check_synonym_consistency = do {
    let s1: String = `{"op":"list","measures":[],"dimensions":["student_first_name"],"filters":[{"dimension":"student_last_name","op":"eq","kind":"text","value":"AAA"}],"ordering":[],"limit":null,"offset":null}`;
    let s2: String = `{"limit":null,"ordering":[],"offset":null,"filters":[{"value":"AAA","kind":"text","op":"eq","dimension":"student_last_name"}],"measures":[],"dimensions":["student_first_name"],"op":"list"}`;
    let a = run_json(s1);
    let c = run_json(s2);
    if a.sql == c.sql && binding_count(a) == binding_count(c) {
        True
    } else {
        fail!("synonymous intents are not consistent")
    }
};

# --- structural probe negatives (never fail) --------------------------------

def check_unknown_op_rejected = do {
    let v = intent_of_json(`{"op":"bogus","measures":[],"dimensions":["student_id"],"filters":[],"ordering":[],"limit":null,"offset":null}`);
    if intent.query_intent_ok(payload, "public", v) { fail!("unknown op was accepted") } else { True }
};

def check_field_predicate_on_aggregate_rejected = do {
    let v = intent_of_json(`{"op":"aggregate","measures":["degree_count"],"dimensions":["department_name"],"filters":[{"left":"department_name","right":"department_description","op":"eq"}],"ordering":[],"limit":null,"offset":null}`);
    if intent.query_intent_ok(payload, "public", v) { fail!("field predicate on aggregate was accepted") } else { True }
};

def check_malformed_filter_rejected = do {
    let v = intent_of_json(`{"op":"list","measures":[],"dimensions":["student_id"],"filters":[{"dimension":"student_first_name","value":"x"}],"ordering":[],"limit":null,"offset":null}`);
    if intent.query_intent_ok(payload, "public", v) { fail!("malformed filter was accepted") } else { True }
};

