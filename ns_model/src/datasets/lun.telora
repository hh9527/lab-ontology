    @v::map(domains::LuHealthStatus.type, "lu_health_status", [v::member(domains::LuHealthStatus::Value1, ["1"]), v::member(domains::LuHealthStatus::Value2, ["2"]), v::member(domains::LuHealthStatus::Value15, ["15"])])
