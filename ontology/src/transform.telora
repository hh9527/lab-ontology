# 独立声明到现有 transform 的准备入口，不解析或建立知识地图。
use crate::model as m;
use crate::groups as g;
use crate::relations as r;
use crate::values as v;
use crate::scalars as scalars;
use crate::samples as samples;
use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::pipeline as pipeline;
use std::dict as dict;
use crate::property_contract as contract;
use crate::registry_impl as registry;
use crate::knowledge as knowledge;
use std::type_desc as td;
use std::type_property as property;
use std::type_memorizer as memo;
use std::string as string;
use std::codec as codec;
use std::value::{Value};

type FieldCount(Row) = struct {
    index: Int,
    condition: Option(v::MemberPredicate),
    row: Type,
    dataset: String,
    source: String,
    field: String,
    value: Type,
    nullable: Bool,
    id: String
};
type FieldCountFacts = struct {
    index: Int,
    condition: Option(v::MemberPredicate),
    row: Type,
    dataset: String,
    source: String,
    field: String,
    value: Type,
    nullable: Bool,
    id: String
};
# 计数依赖使用同一 Dataset 的显式引用，不用任意字符串拼接表达式。
type CountRef(Row) = struct {
    row: Type,
    dataset: String,
    source: String,
    id: String
};
type CountRefFacts = struct {
    row: Type,
    dataset: String,
    source: String,
    id: String
};
type ComputedCount(Row) = struct {
    result: CountRef(Row),
    left: CountRef(Row),
    right: CountRef(Row),
    op: qb::ComputedOp
};
type ComputedCountFacts = struct {
    result: CountRefFacts,
    left: CountRefFacts,
    right: CountRefFacts,
    op: qb::ComputedOp
};
type RowScope(Row) = struct {
    row: Type,
    dataset: String,
    source: String,
    column: g::Column,
    input: edsl::FilterInput
};
type RowScopeFacts = struct {
    row: Type,
    dataset: String,
    source: String,
    column: g::Column,
    input: edsl::FilterInput
};
type NativePair(Row) = struct {
    id: String,
    first: g::Binding(Row),
    second: g::Binding(Row)
};
type NativePairFacts = struct {
    id: String,
    first: g::BindingFacts,
    second: g::BindingFacts
};
type Clock = struct {
    name: String,
    index: Int
};
type Declaration = struct {
    grain_fields: Array(Int),
    native_pairs: Array(NativePairFacts),
    computed_counts: Array(ComputedCountFacts),
    kind: edsl::DatasetKind,
    scope: Array(RowScopeFacts),
    dataset: m::PreparedDataset,
    groups: Array(g::BindingFacts),
    record_counts: Array(String),
    field_counts: Array(FieldCountFacts),
    domains: Array(v::BindingFacts),
    clock: Option(Clock),
    samples: Array(samples::BindingFacts)
};
type Prepared = struct {
    declarations: Array(Declaration),
    payload: edsl::PreparedPayload,
    relations: Array(r::Relation),
    alternatives: Array(Alternative)
};
type Alternative = struct {
    id: String,
    choices: Array(r::Relation),
    cardinality: edsl::RelationCardinality
};
def prepare_native_pair: Fn(NativePairFacts) -> () = fn(pair) {
    if array::length(pair.first.members) != 1 || array::length(pair.second.members) != 1 {
        fail!("native pair requires single dimension bindings", pair.id)
    } else {
        let first = pair.first.members[0];
        let second = pair.second.members[0];
        let plain: Fn(g::Member) -> Bool = fn(member) {
            member.aggregate == None && match member.node {
                g::Node::Column(_) => True,
                _ => False
            } && array::any(
                member.filters,
                fn(op) {
                    op == g::Filter::Eq
                }
            )
        };
        if first.value != second.value || !plain(first) || !plain(second) || first.node == second.node {
            fail!("native pair requires distinct compatible plain equality dimensions", pair.id)
        } else {
            ()
        }
    }
};
def native_pair: for(Row) Fn(String, g::Binding(Row), g::Binding(Row)) -> NativePair(Row) = fn(
    id,
    first,
    second
) {
    contract::publish_name(id);
    prepare_native_pair({id, first: g::binding_facts(first), second: g::binding_facts(second)});
    {id, first, second}
};
def scope_equal: for(Row, Scalar: codec::Encode) Fn(
    m::Dataset(Row),
    m::Field(Row, Scalar),
    Scalar
) -> RowScope(Row) = fn(dataset, field, value) {
    {
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        column: {index: field.index, name: field.name, value: Scalar.type, nullable: field.nullable},
        input: scalar_input(value)
    }
};
# COUNT(field) 只计算非NULL来源值，不要求字段是主键，也不自动变成DISTINCT
# 字段在构造时已准备；上层只检查声明归属。
def field_count: for(Row, Value) Fn(
    m::Dataset(Row),
    m::Field(Row, Value),
    String
) -> FieldCount(Row) = fn(dataset, field, id) {
    contract::publish_name(id);
    {
        condition: None,
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        index: field.index,
        field: field.name,
        value: Value.type,
        nullable: field.nullable,
        id
    }
};
def filtered_count: for(Row, Business: codec::Encode) Fn(
    FieldCount(Row),
    v::Binding(Row),
    Business
) -> FieldCount(Row) = fn(count, binding, member) {
    count <~ {condition: Some(v::member_predicate(binding, member))}
};
def count_ref: for(Row) Fn(FieldCount(Row)) -> CountRef(Row) = fn(count) {
    {row: count.row, dataset: count.dataset, source: count.source, id: count.id}
};
def count_ref_facts: for(Row) Fn(CountRef(Row)) -> CountRefFacts = fn(reference) {
    {row: reference.row, dataset: reference.dataset, source: reference.source, id: reference.id}
};
def combine_counts: for(Row) Fn(
    String,
    qb::ComputedOp,
    CountRef(Row),
    CountRef(Row)
) -> ComputedCount(Row) = fn(id, op, left, right) {
    contract::publish_name(id);
    {result: left <~ {id}, left, right, op}
};
def computed_count_ref: for(Row) Fn(ComputedCount(Row)) -> CountRef(Row) = fn(count) {
    count.result
};
def identifier_key: Fn(String) -> String = fn(name) {
    array::fold(
        [
            ["A", "a"],
            ["B", "b"],
            ["C", "c"],
            ["D", "d"],
            ["E", "e"],
            ["F", "f"],
            ["G", "g"],
            ["H", "h"],
            ["I", "i"],
            ["J", "j"],
            ["K", "k"],
            ["L", "l"],
            ["M", "m"],
            ["N", "n"],
            ["O", "o"],
            ["P", "p"],
            ["Q", "q"],
            ["R", "r"],
            ["S", "s"],
            ["T", "t"],
            ["U", "u"],
            ["V", "v"],
            ["W", "w"],
            ["X", "x"],
            ["Y", "y"],
            ["Z", "z"]
        ],
        name,
        fn(value, pair) {
            string::replace(value, pair[0], pair[1])
        }
    )
};
type Scalar = struct {
    storage: Type,
    nullable: Bool
};
def scalar_info: memo::TypeMemorizer(Scalar) = memo::type_memorizer(prepare_scalar);
def scalar: Fn(Type) -> Scalar = fn(ty) {
    memo::computed_with_type(scalar_info, ty)
};
def prepare_scalar: Fn(Type) -> Scalar = fn(ty) {
    let resolved = if td::kind(ty) == td::TypeDescKind::Ref {
        match td::resolve(ty) {
            Ok(value) => value,
            Err(error) => fail!(error.message, ty)
        }
    } else {
        ty
    };
    if resolved == Bool.type {
        {storage: Bool.type, nullable: False}
    } else {
        match td::kind(resolved) {
            td::TypeDescKind::Newtype => scalar(td::children(resolved)[0]),
            td::TypeDescKind::Enum => {
                let variants = td::variants(resolved);
                let some = array::find(
                    variants,
                    fn(variant) {
                        variant.name == "Some" && variant.payload != None
                    }
                );
                if array::length(variants) != 2 || !array::any(
                    variants,
                    fn(variant) {
                        variant.name == "None" && variant.payload == None
                    }
                ) {
                    fail!("typed transform requires a scalar or optional scalar representation", ty)
                } else {
                    match some {
                        Some(variant) => match variant.payload {
                            Some(value) => {
                                let payload = scalar(value);
                                if payload.nullable {
                                    fail!(
                                        "typed transform cannot encode nested optional values in one SQL column",
                                        ty
                                    )
                                } else {
                                    payload <~ {nullable: True}
                                }
                            },
                            None => fail!("optional scalar requires a payload", ty),
                        },
                        None => fail!("optional scalar requires Some and None", ty),
                    }
                }
            },
            td::TypeDescKind::Int => {storage: Int.type, nullable: False},
            td::TypeDescKind::Float => {storage: Float.type, nullable: False},
            td::TypeDescKind::String => {storage: String.type, nullable: False},
            _ => fail!(
                "typed transform requires an integer, float, boolean or string representation",
                ty
            ),
        }
    }
};
# 显式源列名已在 property 验证；隐式列名及最终冲突在局部集合形成时完成。
def property_columns: Fn(Declaration) -> Array(String) = fn(declared) {
    pipeline::run(
        pipeline::from_array(m::fields_of(declared.dataset.row)) |> pipeline::map(
            fn(field) {
                match property::get_field_prop(
                    declared.dataset.row,
                    field.index,
                    edsl::ColumnMap.type
                ) {
                    Some(mapping) => mapping.column,
                    None => {
                        contract::publish_name(field.name);
                        field.name
                    }
                }
            }
        ) |> pipeline::unique_by(identifier_key) |> pipeline::collect()
    )
};
def entity_entry: Fn(Declaration, Int) -> edsl::EntityEntry = fn(declared, index) {
    let dataset = declared.dataset;
    let columns = {
        property_columns(declared)
    };
    let fields = array::map(
        m::fields_of(dataset.row),
        fn(field) {
            let value = scalar(field.ty);
            {
                {
                    time: scalars::field_time_role(field.ty),
                    nullable: value.nullable,
                    index: field.index,
                    name: field.name,
                    column: columns[field.index],
                    ty: value.storage
                }.ty!(edsl::FieldEntry)
            }
        }
    );
    if array::length(declared.samples) > 0 && declared.kind != edsl::DatasetKind::Metric {
        fail!("sample measures require a Metric dataset", dataset.id)
    } else {
        ()
    };
    let sample_measures = samples::lower(declared.samples);
    let source: qb::Source = {table: dataset.source, alias: `typed_\{index}`, scope: None};
    {
        sample_order: match declared.clock {
            None => None,
            Some(value) => {
                let clock = fields[value.index];
                Some(
                    {
                        time: {source: source.alias, column: clock.column},
                        ties: pipeline::run(
                            pipeline::from_array(declared.grain_fields) |> pipeline::filter(
                                fn(index) {
                                    index != clock.index
                                }
                            ) |> pipeline::map(
                                fn(index) {
                                    {source: source.alias, column: fields[index].column}.ty!(
                                        qb::ColumnRef
                                    )
                                }
                            ) |> pipeline::collect()
                        )
                    }
                )
            }
        },
        source_scope: {
            alias: source.alias,
            bindings: [],
            expression: None,
            required: {
                allowed_operators: [],
                allowed_scalars: [],
                allowed_aggregates: [],
                allowed_join_kinds: [],
                allow_distinct: False
            }
        },
        references: edsl::references_of(dataset.row),
        index,
        id: dataset.id,
        entity_type: dataset.row,
        table: dataset.source,
        alias: source.alias,
        source,
        grain_fields: declared.grain_fields,
        fields,
        sample_measures,
        scope: array::map(
            declared.scope,
            fn(predicate) {
                {
                    index: predicate.column.index,
                    field: predicate.column.name,
                    op: edsl::FilterOp::Eq,
                    input: predicate.input
                }.ty!(edsl::PreparedGuard)
            }
        )
    }
};
# 局部初始化按字段索引绑定物理列；查询只调用已准备的表达式。
def physical_node: Fn(g::Node, Array(edsl::FieldEntry)) -> g::Node = fn(node, fields) {
    let column: Fn(g::Column) -> g::Column = fn(value) {
        value <~ {name: fields[value.index].column}
    };
    match node {
        g::Node::Column(value) => g::Node::Column(column(value)),
        g::Node::Seconds(input) => g::Node::Seconds(physical_node(input, fields)),
        g::Node::Ipv4(input) => g::Node::Ipv4(physical_node(input, fields)),
        g::Node::UtcBucket(bucket) => g::Node::UtcBucket(
            bucket <~ {input: physical_node(bucket.input, fields)}
        ),
        g::Node::Rate(inputs) => g::Node::Rate(
            {
                amount: physical_node(inputs.amount, fields),
                duration: physical_node(inputs.duration, fields)
            }
        ),
        g::Node::Identity(input) => g::Node::Identity(
            {column: column(input.column), parts: array::map(input.parts, column)}
        )
    }
};
# 现有准备结构保留一个锚定字段；完整表达式由 Group lowering 生成。
def anchor_column: Fn(g::Node) -> Int = fn(node) {
    match node {
        g::Node::Column(column) => column.index,
        g::Node::Seconds(input) => anchor_column(input),
        g::Node::Ipv4(input) => anchor_column(input),
        g::Node::UtcBucket(bucket) => anchor_column(bucket.input),
        g::Node::Rate(inputs) => anchor_column(inputs.amount),
        g::Node::Identity(input) => input.column.index,
    }
};
def dimension_entry: Fn(edsl::EntityEntry, g::Member) -> edsl::DimensionEntry = fn(entity, member) {
    let field = entity.fields[anchor_column(member.node)];
    let node = physical_node(member.node, entity.fields);
    let storage = g::representation(member.value);
    let output = if storage == String.type {
        edsl::OutputType::Text
    } else if storage == Int.type {
        edsl::OutputType::Integer
    } else if storage == Bool.type {
        edsl::OutputType::Boolean
    } else {
        edsl::OutputType::Number
    };
    let input = if let Some(role) = scalars::time_role(member.value) {
        scalars::input_kind(role)
    } else if member.value == scalars::Ipv4.type {
        edsl::FilterInputKind::Ipv4
    } else if storage == String.type {
        edsl::FilterInputKind::Text
    } else if storage == Int.type {
        edsl::FilterInputKind::Int
    } else if storage == Bool.type {
        edsl::FilterInputKind::Bool
    } else {
        edsl::FilterInputKind::Number
    };
    let ops = array::map(
        member.filters,
        fn(op) {
            match op {
                g::Filter::InSubnet => edsl::FilterOp::InSubnet,
                g::Filter::NotInSubnet => edsl::FilterOp::NotInSubnet,
                g::Filter::Eq => edsl::FilterOp::Eq,
                g::Filter::Ne => edsl::FilterOp::Ne,
                g::Filter::Gt => edsl::FilterOp::Gt,
                g::Filter::Ge => edsl::FilterOp::Ge,
                g::Filter::Lt => edsl::FilterOp::Lt,
                g::Filter::Le => edsl::FilterOp::Le,
                g::Filter::Contains => edsl::FilterOp::Contains,
                g::Filter::NotContains => edsl::FilterOp::NotContains,
                g::Filter::StartsWith => edsl::FilterOp::StartsWith,
                g::Filter::EndsWith => edsl::FilterOp::EndsWith,
            }
        }
    );
    {
        utc_bucket: match member.node {
            g::Node::UtcBucket(bucket) => Some({id: member.id, unit: bucket.unit}),
            _ => None
        },
        value_type: None,
        ty: if let Some(role) = scalars::time_role(member.value) {
            match role.encoding {
                edsl::TimeEncoding::EpochMillis => "EpochMillis",
                edsl::TimeEncoding::Rfc3339Text => "DateTimeUtc",
                edsl::TimeEncoding::DateText => "Date",
                edsl::TimeEncoding::LocalText => "DateTime"
            }
        } else if member.value == scalars::Ipv4.type {
            "Ipv4"
        } else if storage == String.type {
            "Text"
        } else if storage == Int.type {
            "Int"
        } else if storage == Bool.type {
            "Bool"
        } else {
            "Number"
        },
        half_open: False,
        fallback: None,
        id: member.id,
        entity: entity.index,
        field: field.index,
        output_type: output,
        computed: match member.node {
            g::Node::Column(_) => False,
            _ => True
        },
        build: fn(ctx, source) {
            g::lower(ctx, source, node)
        },
        authorized: member.projectable || array::length(ops) > 0,
        projectable: member.projectable,
        filterable: array::length(ops) > 0,
        ops,
        input_kinds: [input],
        canonical_values: [],
        canonical_order: [],
        canonical_aliases: []
    }
};
def domain_entry: Fn(edsl::EntityEntry, v::BindingFacts) -> edsl::DimensionEntry = fn(
    entity,
    binding
) {
    let policy = {projectable: binding.group_projectable, filters: binding.group_filters};
    let member: g::Member = {
        group: binding.definition.id,
        local: "value",
        id: binding.id,
        node: g::Node::Column(binding.column),
        value: binding.definition.wire,
        nullable: binding.nullable,
        aggregate: None,
        projectable: binding.projectable,
        filters: binding.filters,
        kind: g::MemberKind::Dimension(policy)
    };
    let base = dimension_entry(entity, member);
    base <~ {
        value_type: Some(binding.definition.value),
        ty: binding.definition.id,
        half_open: binding.definition.half_open,
        fallback: binding.definition.fallback,
        output_type: edsl::OutputType::Text,
        input_kinds: [edsl::FilterInputKind::Text],
        canonical_values: binding.definition.values,
        canonical_order: binding.definition.order
    }
};
# 只在 Dataset 的局部发布边界运行一次，产出可直接合并的完整信息。
def prepare_local: Fn(Array(Declaration)) -> Prepared = fn(declarations) {
    array::map(
        declarations,
        fn(declared) {
            let dataset = declared.dataset;
            array::map(
                array::flat_map(declared.groups, g::binding_roles),
                fn(role) {
                    if !array::any(
                        dataset.roles,
                        fn(registered) {
                            registered == role
                        }
                    ) {
                        fail!(
                            "identity dimension role must be registered on its dataset",
                            dataset.id,
                            role.id
                        )
                    } else {
                        ()
                    }
                }
            );
        }
    );
    lower_prepared(
        declarations,
        array::map(
            array::enumerate(declarations),
            fn(pair) {
                entity_entry(pair.1, pair.0)
            }
        )
    )
};
# 已准备的局部契约共享 lowering；不读取任何建模入口 property。
# 新模型在此之前完成逻辑字段到物理列的展开。
def lower_prepared: Fn(Array(Declaration), Array(edsl::EntityEntry)) -> Prepared = fn(
    declarations,
    entities
) {
    let revision = "";
    let profile: qb::PlanProfile = {
        allowed_operators: [],
        allowed_join_kinds: [],
        allowed_aggregates: [],
        allowed_scalars: [],
        allow_distinct: False
    };
    let group_members = array::map(
        declarations,
        fn(declared) {
            {
                array::flat_map(
                    declared.groups,
                    fn(binding) {
                        binding.members
                    }
                )
            }
        }
    );
    let dimensions = array::flat_map(
        array::enumerate(declarations),
        fn(pair) {
            let members = group_members[pair.0];
            let domains = {
                pair.1.domains
            };
            array::concat(
                [
                    pipeline::run(
                        pipeline::from_array(members) |> pipeline::filter(
                            fn(member) {
                                member.aggregate == None
                            }
                        ) |> pipeline::map(
                            fn(member) {
                                dimension_entry(entities[pair.0], member)
                            }
                        ) |> pipeline::collect()
                    ),
                    array::map(
                        domains,
                        fn(binding) {
                            domain_entry(entities[pair.0], binding)
                        }
                    )
                ]
            )
        }
    );
    {
        ()
    };
    let measures = array::flat_map(
        array::enumerate(declarations),
        fn(pair) {
            let entity = entities[pair.0];
            let members = group_members[pair.0];
            let grouped = array::flat_map(
                members,
                fn(member) {
                    match member.aggregate {
                        None => [],
                        Some(function) => {
                            let field = entity.fields[anchor_column(member.node)];
                            let node = physical_node(member.node, entity.fields);
                            let storage = g::representation(member.value);
                            let output = if storage == Int.type {
                                edsl::OutputType::Integer
                            } else {
                                edsl::OutputType::Number
                            };
                            [
                                {
                                    output_type: if function == qb::AggregateFunction::Avg {
                                        edsl::OutputType::Number
                                    } else {
                                        output
                                    },
                                    latest: None,
                                    id: member.id,
                                    entity: entity.index,
                                    field: field.index,
                                    aggregate: function,
                                    alias: member.id,
                                    predicate: None,
                                    computed: None,
                                    row_expression: match member.node {
                                        g::Node::Column(_) => None,
                                        _ => Some(
                                            {
                                                build: fn(ctx, source) {
                                                    g::lower(ctx, source, node)
                                                }
                                            }
                                        )
                                    }
                                }.ty!(edsl::MeasureEntry)
                            ]
                        }
                    }
                }
            );
            let counts = array::map(
                pair.1.record_counts,
                fn(id) {
                    let field = entity.fields[pair.1.grain_fields[0]];
                    {
                        output_type: edsl::OutputType::Integer,
                        latest: None,
                        id,
                        entity: entity.index,
                        field: field.index,
                        aggregate: qb::AggregateFunction::Count,
                        alias: id,
                        predicate: None,
                        row_expression: None,
                        computed: None
                    }.ty!(edsl::MeasureEntry)
                }
            );
            let field_counts = array::map(
                pair.1.field_counts,
                fn(count) {
                    let field = entity.fields[count.index];
                    {
                        output_type: edsl::OutputType::Integer,
                        latest: None,
                        id: count.id,
                        entity: entity.index,
                        field: field.index,
                        aggregate: qb::AggregateFunction::Count,
                        alias: count.id,
                        predicate: match count.condition {
                            None => None,
                            Some(predicate) => Some(
                                {
                                    v::prepare_predicate(pair.1.dataset, pair.1.domains, predicate) <~ {
                                        column: entity.fields[predicate.binding.column.index].column
                                    }
                                }
                            )
                        },
                        row_expression: None,
                        computed: None
                    }.ty!(edsl::MeasureEntry)
                }
            );
            let reported = array::flat_map(
                pair.1.samples,
                fn(binding) {
                    array::map(
                        binding.measures,
                        fn(sample) {
                            let field = entity.fields[binding.index];
                            {
                                output_type: if sample.aggregate == qb::AggregateFunction::Avg || field.ty == Float.type {
                                    edsl::OutputType::Number
                                } else {
                                    edsl::OutputType::Integer
                                },
                                latest: if sample.aggregate == qb::AggregateFunction::Latest {
                                    entity.sample_order
                                } else {
                                    None
                                },
                                id: sample.id,
                                entity: entity.index,
                                field: field.index,
                                aggregate: sample.aggregate,
                                alias: sample.id,
                                predicate: None,
                                row_expression: None,
                                computed: None
                            }.ty!(edsl::MeasureEntry)
                        }
                    )
                }
            );
            let computed = array::map(
                pair.1.computed_counts,
                fn(count) {
                    let anchor = pair.1.grain_fields[0];
                    {
                        output_type: edsl::OutputType::Integer,
                        latest: None,
                        id: count.result.id,
                        entity: entity.index,
                        field: anchor,
                        aggregate: qb::AggregateFunction::Count,
                        alias: count.result.id,
                        predicate: None,
                        row_expression: None,
                        computed: Some({op: count.op, left: count.left.id, right: count.right.id})
                    }.ty!(edsl::MeasureEntry)
                }
            );
            {
                array::map(
                    pair.1.computed_counts,
                    fn(count) {
                        array::map(
                            [count.left, count.right],
                            fn(reference) {
                                if !array::any(
                                    field_counts,
                                    fn(field) {
                                        field.id == reference.id
                                    }
                                ) && !array::any(
                                    counts,
                                    fn(field) {
                                        field.id == reference.id
                                    }
                                ) && !array::any(
                                    pair.1.computed_counts,
                                    fn(other) {
                                        other.result.id == reference.id
                                    }
                                ) {
                                    fail!(
                                        "computed count requires a declared count operand",
                                        reference.id
                                    )
                                } else {
                                    ()
                                }
                            }
                        )
                    }
                );
                ()
            };
            array::concat([grouped, counts, field_counts, reported, computed])
        }
    );
    {
        let names = pipeline::run(
            pipeline::from_array(dimensions) |> pipeline::unique_by(
                fn(item) {
                    item.id
                }
            ) |> pipeline::collect_dict(
                fn(item) {
                    item.id
                },
                fn(item) {
                    item.entity
                }
            )
        );
        pipeline::run(
            pipeline::from_array(measures) |> pipeline::unique_by(
                fn(item) {
                    item.id
                }
            ) |> pipeline::map(
                fn(measure) {
                    match dict::get(names, measure.id) {
                        Some(entity) => if entity == measure.entity {
                            fail!("typed transform measure ids must be unique", measure.id)
                        } else {
                            ()
                        },
                        None => ()
                    };
                    measure
                }
            ) |> pipeline::collect()
        );
        ()
    };
    let native_pairs = array::flat_map(
        array::enumerate(declarations),
        fn(pair) {
            array::map(
                pair.1.native_pairs,
                fn(spec) {
                    {
                        array::map(
                            [spec.first, spec.second],
                            fn(binding) {
                                if !array::any(
                                    pair.1.groups,
                                    fn(declared) {
                                        declared == binding
                                    }
                                ) {
                                    fail!(
                                        "native pair requires its declared dimension bindings",
                                        spec.id
                                    )
                                } else {
                                    ()
                                }
                            }
                        );
                        ()
                    };
                    {
                        id: spec.id,
                        entity: pair.0,
                        first: spec.first.members[0].id,
                        second: spec.second.members[0].id
                    }.ty!(edsl::NativePairEntry)
                }
            )
        }
    );
    let native_pairs = pipeline::run(
        pipeline::from_array(native_pairs) |> pipeline::unique_by(
            fn(pair) {
                pair.id
            }
        ) |> pipeline::collect()
    );
    let payload: edsl::PreparedPayload = {
        revision,
        entities,
        dimensions,
        measures,
        relations: [],
        business_links: [],
        native_pairs,
        profile
    };
    {declarations, payload, relations: [], alternatives: []}
};

# 完整 root 只接受已登记的角色，避免关系端点私下改写 Dataset 的身份声明。
def finish_build: Fn(Prepared, Array(r::Relation), Array(Alternative), Array(r::Link)) -> Prepared = fn(
    prepared,
    relations,
    alternatives,
    links
) {
    {
        ()
    };
    let owners = r::owners(prepared.payload);
    let lowered = array::concat(
        [
            r::lower_all(owners, relations),
            array::map(
                alternatives,
                fn(alternative) {
                    r::lower_alternative(
                        owners,
                        alternative.id,
                        alternative.choices,
                        alternative.cardinality
                    )
                }
            )
        ]
    );
    {
        ()
    };
    let with_relations = prepared.payload <~ {relations: lowered};
    prepared <~ {
        relations: array::concat(
            [
                relations,
                array::flat_map(
                    links,
                    fn(link) {
                        [link.a, link.z]
                    }
                )
            ]
        ),
        alternatives,
        payload: with_relations <~ {
            business_links: array::map(
                links,
                fn(link) {
                    r::lower_link(owners, link)
                }
            )
        }
    }
};

pub use self::{
    NativePairFacts,
    CountRefFacts,
    ComputedCountFacts,
    NativePair,
    native_pair,
    CountRef,
    ComputedCount,
    count_ref,
    computed_count_ref,
    combine_counts,
    RowScope,
    RowScopeFacts,
    scope_equal,
    Declaration,
    Clock,
    Prepared,
    Alternative,
    FieldCount,
    FieldCountFacts,
    filtered_count,
    field_count
};

def scalar_input: for(Scalar: codec::Encode) Fn(Scalar) -> edsl::FilterInput = fn(value) {
    match codec::encode(value) {
        Value::String(text) => edsl::FilterInput::Text(text),
        Value::Int(number) => edsl::FilterInput::Int(number),
        Value::Float(number) => edsl::FilterInput::Number(number),
        Value::True => edsl::FilterInput::Bool(True),
        Value::False => edsl::FilterInput::Bool(False),
        _ => fail!("model predicate requires a scalar literal"),
    }
};

# 显式检查同一份模型声明，成功返回 True；不校验运行期输入。
# 显式严格构造，用于诊断和检查需要立即拒绝的调用方。
# 单个定义的检查和 lowering 独立于 World；Registry 按 Type 缓存此结果。
type LocalDefinition = struct {
    declaration: Declaration,
    payload: edsl::PreparedPayload,
    contract: qb::PlanProfile,
    capabilities: knowledge::LocalCapabilities
};
def initialize_dataset: Fn(Type) -> LocalDefinition = fn(row) {
    let base = registry::declaration_data(row);
    let declared = base <~ {
        groups: array::concat([g::field_dimensions_for(base.dataset), base.groups]),
        domains: v::field_bindings(base.dataset)
    };
    finish_local(declared, prepare_local([declared]))
};
def finish_local: Fn(Declaration, Prepared) -> LocalDefinition = fn(declared, prepared) {
    let payload = edsl::prepare_source_scopes(prepared.payload);
    {
        declaration: declared,
        payload,
        contract: edsl::prepare_local_contract(payload),
        capabilities: knowledge::local_capabilities(payload)
    }
};
def initialize_prepared: Fn(Declaration, edsl::EntityEntry) -> LocalDefinition = fn(
    declared,
    entity
) {
    finish_local(declared, lower_prepared([declared], [entity]))
};
pub use self::{initialize_dataset, initialize_prepared, dimension_entry};
pub use self::{LocalDefinition};

# 局部结果已完成降级；此处只为全局地址重编号并合并。
def build_from_definitions: Fn(
    String,
    Array(LocalDefinition),
    Array(r::Relation),
    Array(Alternative),
    Array(r::Link),
    qb::PlanProfile
) -> Prepared = fn(revision, definitions, relations, alternatives, links, profile) {
    let entries = array::enumerate(definitions);
    let payload: edsl::PreparedPayload = {
        revision,
        entities: array::map(
            entries,
            fn(pair) {
                let entity = pair.1.payload.entities[0];
                let source: qb::Source = {
                    table: entity.table,
                    alias: `typed_\{pair.0}`,
                    scope: None
                };
                entity <~ {index: pair.0, source, alias: source.alias}
            }
        ),
        dimensions: array::flat_map(
            entries,
            fn(pair) {
                array::map(
                    pair.1.payload.dimensions,
                    fn(item) {
                        item <~ {entity: pair.0}
                    }
                )
            }
        ),
        measures: array::flat_map(
            entries,
            fn(pair) {
                array::map(
                    pair.1.payload.measures,
                    fn(item) {
                        item <~ {entity: pair.0}
                    }
                )
            }
        ),
        native_pairs: array::flat_map(
            entries,
            fn(pair) {
                array::map(
                    pair.1.payload.native_pairs,
                    fn(item) {
                        item <~ {entity: pair.0}
                    }
                )
            }
        ),
        relations: [],
        business_links: [],
        profile
    };
    finish_build(
        {
            declarations: array::map(
                definitions,
                fn(local) {
                    local.declaration
                }
            ),
            payload,
            relations: [],
            alternatives: []
        }.ty!(Prepared),
        relations,
        alternatives,
        links
    )
};
pub use self::{build_from_definitions};
