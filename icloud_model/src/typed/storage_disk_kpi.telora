use ontology::registry as registry;
# 独立 transform 声明；单位、grain 与关系只采用既有公开契约。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
type ResourceId = struct(
    String
);
# TODO(#58)：KB 的字节倍率未确认；不提供隐式转换。
type Kilobytes = struct(
    Float
);
def io_size_statistics: samples::Group(Kilobytes) = samples::group(
    "storage_io_size_kb",
    Kilobytes.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    Some("KB")
);
@registry::dataset(
    "source_StorageHardDriveKPI",
    "StorageHardDriveKPI",
    ["source_resId", "source_ts"]
)
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageHardDriveKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(StorageHardDriveKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_StorageHardDriveKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(StorageHardDriveKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_StorageHardDriveKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(StorageHardDriveKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_StorageHardDriveKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(StorageHardDriveKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_StorageHardDriveKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageHardDriveKPI__utility",
                p::Percent.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(StorageHardDriveKPI.type, p::Percent.type, "source_utility")),
            "source_StorageHardDriveKPI__utility",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageHardDriveKPI__avgreadiosize",
                Kilobytes.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(StorageHardDriveKPI.type, Kilobytes.type, "source_avgreadiosize")),
            "source_StorageHardDriveKPI__avgreadiosize",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageHardDriveKPI__avgwriteiosize",
                Kilobytes.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(StorageHardDriveKPI.type, Kilobytes.type, "source_avgwriteiosize")),
            "source_StorageHardDriveKPI__avgwriteiosize",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageHardDriveKPI__utilityEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(StorageHardDriveKPI.type, EffectiveCount.type, "source_utilityEffcnt")
            ),
            "source_StorageHardDriveKPI__utilityEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageHardDriveKPI__avgreadiosizeEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    StorageHardDriveKPI.type,
                    EffectiveCount.type,
                    "source_avgreadiosizeEffcnt"
                )
            ),
            "source_StorageHardDriveKPI__avgreadiosizeEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_StorageHardDriveKPI__avgwriteiosizeEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    StorageHardDriveKPI.type,
                    EffectiveCount.type,
                    "source_avgwriteiosizeEffcnt"
                )
            ),
            "source_StorageHardDriveKPI__avgwriteiosizeEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::metric("source_ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            p::Percent_statistics,
            m::field(StorageHardDriveKPI.type, p::Percent.type, "source_utility"),
            [
                {statistic: samples::Statistic::Mean, publish: "storage_disk_usage"},
                {statistic: samples::Statistic::Max, publish: "storage_disk_usage_max"},
                {statistic: samples::Statistic::Min, publish: "storage_disk_usage_min"}
            ]
        ),
        samples::bind(
            dataset,
            io_size_statistics,
            m::field(StorageHardDriveKPI.type, Kilobytes.type, "source_avgreadiosize"),
            [
                {statistic: samples::Statistic::Mean, publish: "storage_disk_read_io_size"},
                {statistic: samples::Statistic::Max, publish: "storage_disk_read_io_size_max"},
                {statistic: samples::Statistic::Min, publish: "storage_disk_read_io_size_min"}
            ]
        ),
        samples::bind(
            dataset,
            io_size_statistics,
            m::field(StorageHardDriveKPI.type, Kilobytes.type, "source_avgwriteiosize"),
            [
                {statistic: samples::Statistic::Mean, publish: "storage_disk_write_io_size"},
                {statistic: samples::Statistic::Max, publish: "storage_disk_write_io_size_max"},
                {statistic: samples::Statistic::Min, publish: "storage_disk_write_io_size_min"}
            ]
        ),
    ]
)
type StorageHardDriveKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_StorageHardDriveKPI__resId")
    source_resId: ResourceId,
    @m::column("utility")
    source_utility: p::Percent,
    @m::column("avgreadiosize")
    source_avgreadiosize: Kilobytes,
    @m::column("avgwriteiosize")
    source_avgwriteiosize: Kilobytes,
    @m::column("utilityEffcnt")
    source_utilityEffcnt: EffectiveCount,
    @m::column("avgreadiosizeEffcnt")
    source_avgreadiosizeEffcnt: EffectiveCount,
    @m::column("avgwriteiosizeEffcnt")
    source_avgwriteiosizeEffcnt: EffectiveCount,
};
def dataset: m::Dataset(StorageHardDriveKPI) = registry::dataset_of(StorageHardDriveKPI.type);

pub use self::{StorageHardDriveKPI};
