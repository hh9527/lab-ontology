use crate::typed_relations as t;
use ontology::model as m;
use ontology::relations as r;
use ontology::transform as transform;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::intent as intent;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::test as test;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};

def guarded: r::Relation = r::guarded(t::connection_a, m::field(t::ConnectionRow.type, t::DeviceId.type, "a_device_id"), edsl::FilterOp::Ne, t::DeviceId("3"));
def guard: r::Guard = match guarded.guard { Some(value) => value, None => fail!("guard is missing") };
def payload: edsl::PreparedPayload = t::payload <~ {relations: [r::lower(t::payload, guarded)], business_links: []};
def profile: qb::PlanProfile = t::profile <~ {allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::And, qb::ScalarFunction::IsNotNull]};
def ready: edsl::PreparedPayload = transform::build("guards", array::map(t::datasets, fn(declared) {
    if declared.dataset.id == "connection" { transform::map_columns(declared, [transform::column(m::field(t::ConnectionRow.type, t::DeviceId.type, "a_device_id"), "A_REF")]) } else { declared }
}), [guarded], [], [], profile).payload;
pub def source_guard_is_lowered: test::Test = test::should_ok(fn() { ready.relations[0].guard == Some({field: "a_device_id", op: edsl::FilterOp::Ne, input: edsl::FilterInput::Text("3")}) && ready.entities[3].scope == [] });
pub def target_row_cannot_supply_guard: test::Test = test::should_fail_with(fn() { r::checked_guarded(t::connection_a, m::checked_field(t::DeviceRow.type, t::DeviceId.type, "id"), edsl::FilterOp::Ne, t::DeviceId("3")) }, "relation guard belongs to another source row");
pub def non_equality_guard_is_rejected: test::Test = test::should_fail_with(fn() { r::checked_guarded(t::connection_a, m::checked_field(t::ConnectionRow.type, t::DeviceId.type, "a_device_id"), edsl::FilterOp::Gt, t::DeviceId("3")) }, "relation guard supports only Eq or Ne");
pub def erased_guard_source_is_rechecked: test::Test = test::should_fail_with(fn() { r::checked_lower(t::payload, guarded <~ {guard: Some(guard <~ {source: "other"})}) }, "relation guard belongs to another source dataset");
pub def erased_guard_literal_is_rechecked: test::Test = test::should_fail_with(fn() { r::checked_lower(t::payload, guarded <~ {guard: Some(guard <~ {input: edsl::FilterInput::Int(3)})}) }, "relation guard literal does not match field storage");
pub def alternative_cannot_drop_branch_guard: test::Test = test::should_fail_with(fn() { r::checked_lower_alternative(t::payload, "both", [guarded, t::connection_z], t::many_many) }, "alternative relations must share explicit dataset endpoints and guard");
type Case = struct { id: String, sqlite: qb::Query, postgres: qb::Query };
def runtime_case: Fn(String, String) -> Case = fn(id, raw) {
    let ast = intent::query_intent_ast_factory(ready)(json::parse(raw).unwrap!());
    {id, sqlite: sqlite::build_query(ast), postgres: postgres::build_query(ast)}
};
pub def runtime_cases: Value = codec::encode([
    runtime_case("all", r#"{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"connection"}],"edges":[],"select":[],"count":"c"}"#),
    runtime_case("joined", r#"{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"connection"},{"id":"d","entity":"device"}],"edges":[{"relation":"connection_a","from":"c","to":"d"}],"select":[{"node":"d","dimension":"device_id"}]}"#),
    runtime_case("reverse_empty", r#"{"op":"Graph","root":"d","include_empty":true,"nodes":[{"id":"c","entity":"connection"},{"id":"d","entity":"device"}],"edges":[{"relation":"connection_a","from":"c","to":"d"}],"select":[{"node":"d","dimension":"device_id"}],"count":"c","group_by_identity":["d"]}"#),
    runtime_case("exists", r#"{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"connection"}],"edges":[],"select":[],"count":"c","exists":[{"anchor":"c","nodes":[{"id":"d","entity":"device"}],"edges":[{"relation":"connection_a","from":"c","to":"d"}]}]}"#),
]);
pub def erased_guard_operator_is_rechecked: test::Test = test::should_fail_with(fn() { r::checked_lower(t::payload, guarded <~ {guard: Some(guard <~ {op: edsl::FilterOp::Gt})}) }, "relation guard supports only Eq or Ne");
pub def erased_guard_column_is_rechecked: test::Test = test::should_fail(fn() { r::checked_lower(t::payload, guarded <~ {guard: Some(guard <~ {column: guard.column <~ {name: "missing"}})}) });
pub def shared_guard_can_cover_alternative_keys: test::Test = test::should_ok(fn() {
    let other = r::guarded(t::connection_z, m::field(t::ConnectionRow.type, t::DeviceId.type, "a_device_id"), edsl::FilterOp::Ne, t::DeviceId("3"));
    r::lower_alternative(t::payload, "both", [guarded, other], t::many_many).guard == r::lower(t::payload, guarded).guard
});
