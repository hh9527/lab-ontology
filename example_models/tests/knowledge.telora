use dog_model::model as dog;
use spider_model::model as spider;
use world_model::model as world;
use ontology::knowledge as knowledge;
use ontology::ontology as edsl;
use std::array as array;
use std::codec as codec;
use std::test as test;
use std::value::{ Value };

def keys: Fn(edsl::PreparedPayload) -> Value = fn(payload) {
    codec::encode(array::map(knowledge::index_from_model(payload).entries,
        fn(entry) { edsl::knowledge_key(entry.key) }))
};

pub def dog_keys: Value = keys(dog::payload);
pub def spider_keys: Value = keys(spider::payload);
pub def world_keys: Value = keys(world::payload);

pub def all_examples_publish_facts_and_direct_members: test::Test = test::should_ok(fn() {
    array::all([dog::payload, spider::payload, world::payload], fn(payload) {
        let index = knowledge::index_from_model(payload);
        let root = knowledge::by_target(payload, {kind: edsl::KnowledgeKind::Index, owner: "", id: "index"});
        match root {
            knowledge::DocResult::Found(point) => point.entries == None && array::length(point.refs) == 9
                && array::all(index.entries, fn(entry) { entry.key.kind != edsl::KnowledgeKind::Schema }),
            _ => False,
        }
    })
});


pub def member_ownership_needs_no_reverse_publication: test::Test = test::should_ok(fn() {
    array::all([dog::payload, spider::payload, world::payload], fn(payload) {
        array::all(knowledge::map(payload), fn(point) {
            if point.target.kind == edsl::KnowledgeKind::Field
                || point.target.kind == edsl::KnowledgeKind::Dimension
                || point.target.kind == edsl::KnowledgeKind::TimeRole {
                !array::any(point.refs, fn(ref) { ref.target.kind == edsl::KnowledgeKind::Dataset })
            } else if point.target.kind == edsl::KnowledgeKind::Value {
                !array::any(point.refs, fn(ref) { ref.target.kind == edsl::KnowledgeKind::Ty })
            } else { True }
        })
    })
});
