# --- new measure IDs accepted by other variants ----------------------------

def test_vocab_hidden_aggregate_new_measure = do {
    let text: String = `{"HiddenAggregateOrder":{"dimensions":[{"id":"country_region"}],"filters":[],"sort_by":"country_population_avg","direction":"desc","limit":3,"offset":null}}`;
    let q = run_text(text);
    let ok_exact = q.sql == `SELECT c.Region FROM country AS c GROUP BY c.Region ORDER BY avg(c.Population) DESC LIMIT ?`;
    let ok_binds = binding_count(q) == 1;
    if ok_exact && ok_binds { 'True } else { fail!("hidden aggregate order with new avg measure failed") }
};

def test_vocab_hidden_having_new_measure = do {
    let text: String = `{"HiddenHaving":{"measures":[{"id":"country_count","mode":"all"}],"dimensions":[{"id":"country_region"}],"filters":[],"order":[],"limit":null,"offset":null,"having":[{"measure":"country_population_avg","op":"ge","threshold":1000000}],"output_order":[]}}`;
    let q = run_text(text);
    let ok_exact = q.sql == `SELECT c.Region, count(c.Code) AS country_count FROM country AS c GROUP BY c.Region HAVING avg(c.Population) >= ?`;
    let ok_binds = binding_count(q) == 1;
    if ok_exact && ok_binds { 'True } else { fail!("hidden having with new avg measure failed") }
};

def test_vocab_attribute_compare_new_measure = do {
    let text: String = `{"AttributeAggregateCompare":{"dimensions":[{"id":"country_name"}],"filters":[],"order":[],"limit":null,"offset":null,"comparisons":[{"attribute":"country_population","op":"gt","measure":"country_population_avg","scope_filters":[]}]}}`;
    let q = run_text(text);
    let ok_exact = q.sql == `SELECT c.Name FROM country AS c WHERE c.Population > (SELECT avg(c.Population) FROM country AS c)`;
    let ok_binds = binding_count(q) == 0;
    if ok_exact && ok_binds { 'True } else { fail!("attribute compare with new avg measure failed") }
};

