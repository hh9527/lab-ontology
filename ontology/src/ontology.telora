def int_range: Fn(Int) -> Array(Int) = fn(n) {
    if n <= 0 {
        []
    } else {
        array::push(int_range(n - 1), n - 1)
    }
};

def references_of: Fn(Type) -> Array(ReferenceSpec) = fn(ty) {
    match property::get_type_prop(ty, ReferencesDef.type) {
        Some(declared) => declared.references,
        None => []
    }
};

def field_roles_for: Fn(Type, FieldEntry, Array(ReferenceSpec)) -> Array(FieldRole) = fn(
    owner,
    field,
    references
) {
    let declared = match property::get_field_prop(owner, field.index, FieldRolesDef.type) {
        Some(note) => note.roles,
        None => [],
    };
    let roles = declared;
    if array::any(
        references,
        fn(ref) {
            array::any(
                ref.fields,
                fn(name) {
                    name == field.name
                }
            )
        }
    ) {
        array::push(roles, FieldRole::Reference)
    } else {
        roles
    }
};

def measure_by_id: Fn(Array(MeasureEntry), String) -> MeasureEntry = fn(measures, id) {
    match array::find(
        measures,
        fn(m) {
            m.id == id
        }
    ) {
        Some(m) => m,
        None => fail!("computed measure depends on an unknown measure", id),
    }
};

def measure_output_type: Fn(PreparedPayload, String) -> OutputType = fn(payload, id) {
    measure_by_id(payload.measures, id).output_type
};

def measure_latest_order: Fn(EntityEntry, MeasureEntry, qb::Source) -> Option(qb::LatestOrder) = fn(
    entity,
    entry,
    source
) {
    match entry.latest {
        None => None,
        Some(order) => Some(
            {
                time: order.time <~ {source: source.alias},
                ties: array::map(
                    order.ties,
                    fn(column) {
                        column <~ {source: source.alias}
                    }
                )
            }
        )
    }
};

def dimension_output_type: Fn(PreparedPayload, String) -> OutputType = fn(payload, id) {
    match array::find(
        payload.dimensions,
        fn(entry) {
            entry.id == id
        }
    ) {
        Some(entry) => entry.output_type,
        None => fail!("unknown dimension output type", id),
    }
};

# Follow the computed-measure dependency graph; a revisit means a cycle.
def exists_pairs: Fn(RelationKey) -> Array(RelationPair) = fn(key) {
    match key {
        RelationKey::Eq(pair) => [pair],
        RelationKey::And(keys) => array::flat_map(keys, exists_pairs),
        RelationKey::Or(_) => fail!("safe relation identity requires conjunctive keys"),
    }
};

def safe_relation_covers_target_identity: Fn(EntityEntry, Array(RelationPair)) -> Bool = fn(
    target,
    pairs
) {
    target.grain_fields != [] && array::all(
        target.grain_fields,
        fn(index) {
            array::any(
                pairs,
                fn(pair) {
                    pair.to == index
                }
            )
        }
    )
};

def conjunctive_identity_key: Fn(RelationKey) -> Bool = fn(key) {
    match key {
        RelationKey::Eq(_) => True,
        RelationKey::And(parts) => array::length(parts) > 0 && array::all(
            parts,
            conjunctive_identity_key
        ),
        _ => False,
    }
};

def filter_profile_scalars: Fn(DimensionEntry, FilterOp) -> Array(qb::ScalarFunction) = fn(
    entry,
    op
) {
    if is_subnet_op(op) {
        array::concat(
            [
                [
                    qb::ScalarFunction::And,
                    qb::ScalarFunction::Ge,
                    qb::ScalarFunction::Lt,
                    qb::ScalarFunction::BinaryText,
                    qb::ScalarFunction::RegexMatch
                ],
                if op == FilterOp::InSubnet {
                    [qb::ScalarFunction::Eq]
                } else {
                    [qb::ScalarFunction::Ne, qb::ScalarFunction::Not]
                },
            ]
        )
    } else if array::length(entry.canonical_values) > 0 {
        let multi_wire = array::any(
            entry.canonical_values,
            fn(value) {
                array::length(value.wires) > 1
            }
        );
        if op == FilterOp::Eq {
            array::concat(
                [
                    [qb::ScalarFunction::Eq],
                    if multi_wire {
                        [qb::ScalarFunction::Or]
                    } else {
                        []
                    }
                ]
            )
        } else if op == FilterOp::Ne {
            array::concat(
                [
                    [qb::ScalarFunction::Ne],
                    if multi_wire || !entry.half_open {
                        [qb::ScalarFunction::And]
                    } else {
                        []
                    },
                    if !entry.half_open && (multi_wire || array::length(entry.canonical_values) > 1) {
                        [qb::ScalarFunction::Eq, qb::ScalarFunction::Or]
                    } else if !entry.half_open {
                        [qb::ScalarFunction::Eq]
                    } else {
                        []
                    }
                ]
            )
        } else {
            fail!("canonical dimension supports only Eq or Ne", entry.id, op)
        }
    } else {
        match op {
            FilterOp::Contains => [
                qb::ScalarFunction::Gt,
                qb::ScalarFunction::Instr,
                qb::ScalarFunction::Lower
            ],
            FilterOp::NotContains => [
                qb::ScalarFunction::Eq,
                qb::ScalarFunction::Instr,
                qb::ScalarFunction::Lower
            ],
            FilterOp::StartsWith => [
                qb::ScalarFunction::Eq,
                qb::ScalarFunction::Instr,
                qb::ScalarFunction::Lower
            ],
            FilterOp::EndsWith => [
                qb::ScalarFunction::Eq,
                qb::ScalarFunction::Substr,
                qb::ScalarFunction::Lower,
                qb::ScalarFunction::Add,
                qb::ScalarFunction::Sub,
                qb::ScalarFunction::Length
            ],
            FilterOp::Eq => [qb::ScalarFunction::Eq],
            FilterOp::Ne => [qb::ScalarFunction::Ne],
            FilterOp::Gt => [qb::ScalarFunction::Gt],
            FilterOp::Ge => [qb::ScalarFunction::Ge],
            FilterOp::Lt => [qb::ScalarFunction::Lt],
            FilterOp::Le => [qb::ScalarFunction::Le],
            _ => fail!("invalid scalar filter operation", op),
        }
    }
};

type FilterResolution = struct {
    expr: qb::Expr,
    dimension: String,
    entity: Int,
    field: Int,
    op: FilterOp,
    input: FilterInput,
};

# 这些列名均来自 Dataset 的已完成局部信息，不重新经过手工 SQL 构造入口。
def prepared_column_ref: Fn(qb::Source, String) -> qb::ColumnRef = fn(source, column) {
    {source: source.alias, column}
};
def prepared_column: Fn(qb::Source, String) -> qb::Expr = fn(source, column) {
    qb::Expr::Column(prepared_column_ref(source, column))
};

def measure_row_expr: Fn(
    qb::BuildCtx,
    PreparedPayload,
    MeasureEntry,
    qb::Source
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry, source) {
    match entry.row_expression {
        Some(expression) => expression.build(ctx, source),
        None => {
            let entity = payload.entities[entry.entity];
            let field = entity.fields[entry.field];
            (ctx, prepared_column(source, field.column))
        },
    }
};

def dimension_expr: Fn(qb::BuildCtx, PreparedPayload, DimensionEntry) -> (qb::BuildCtx, qb::Expr) = fn(
    ctx,
    payload,
    entry
) {
    let entity = payload.entities[entry.entity];
    entry.build(ctx, entity.source)
};

def time_logical_type: Fn(TimeField) -> TimeLogicalType = fn(role) {
    match role.encoding {
        TimeEncoding::DateText => TimeLogicalType::Date,
        TimeEncoding::LocalText => TimeLogicalType::DateTime,
        TimeEncoding::EpochMillis => TimeLogicalType::EpochMillis,
        TimeEncoding::Rfc3339Text => TimeLogicalType::DateTimeUtc,
    }
};

def request_relation: Fn(PreparedPayload, String) -> RelationEntry = fn(payload, id) {
    match array::find(
        payload.relations,
        fn(relation) {
            relation.id == id
        }
    ) {
        Some(relation) => relation,
        None => fail!("query references an unknown relation", id)
    }
};

def entity_by_id: Fn(PreparedPayload, String) -> Int = fn(payload, id) {
    match array::find(
        payload.entities,
        fn(e) {
            e.id == id
        }
    ) {
        Some(e) => e.index,
        None => fail!(`graph entity is unknown: \{id}; discover a declared dataset ID`, id),
    }
};

def dimension_output_with_context: Fn(
    qb::BuildCtx,
    PreparedPayload,
    DimensionEntry
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry) {
    let physical = dimension_expr(ctx, payload, entry);
    if array::length(entry.canonical_values) == 0 {
        physical
    } else {
        let unknown = if entry.half_open {
            physical
        } else {
            qb::bind(physical.0, qb::Val::None)
        };
        array::fold(
            entry.canonical_values,
            unknown,
            fn(state, value) {
                let compared = canonical_compare_with_context(
                    state.0,
                    entry,
                    physical.1,
                    FilterOp::Eq,
                    FilterInput::Text(value.id)
                );
                let label = qb::bind(compared.0, qb::Val::String(value.id));
                (label.0, qb::scalar_if(compared.1, label.1, state.1))
            }
        )
    }
};

def filter_input_allowed: Fn(Array(FilterInputKind), FilterInput) -> Bool = fn(kinds, input) {
    let kind: Option(FilterInputKind) = match input {
        FilterInput::Ipv4Subnet(_) => None,
        FilterInput::Ipv4(_) => Some(FilterInputKind::Ipv4),
        FilterInput::Unknown(_) => fail!("Unknown requires a half-open canonical domain", input),
        FilterInput::Unknowns => fail!("Unknowns requires a half-open canonical domain", input),
        FilterInput::Text(_) => Some(FilterInputKind::Text),
        FilterInput::Number(_) => Some(FilterInputKind::Number),
        FilterInput::Int(_) => Some(FilterInputKind::Int),
        FilterInput::Bool(_) => Some(FilterInputKind::Bool),
        FilterInput::DateTimeUtc(_) => Some(FilterInputKind::DateTimeUtc),
        FilterInput::EpochMillis(_) => Some(FilterInputKind::EpochMillis),
        FilterInput::Date(_) => Some(FilterInputKind::Date),
        FilterInput::DateTime(_) => Some(FilterInputKind::DateTime),
    };
    match kind {
        Some(kind) => array::any(
            kinds,
            fn(k) {
                k == kind || (k == FilterInputKind::Number && kind == FilterInputKind::Int)
            }
        ),
        None => False,
    }
};

def calendar_components: Fn(Int, Int, Int) -> Bool = fn(year, month, day) {
    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
    let days = match month {
        2 => if leap {
            29
        } else {
            28
        },
        4 => 30,
        6 => 30,
        9 => 30,
        11 => 30,
        1 => 31,
        3 => 31,
        5 => 31,
        7 => 31,
        8 => 31,
        10 => 31,
        12 => 31,
        _ => 0,
    };
    year > 0 && day >= 1 && day <= days
};

def calendar_date: Fn(String) -> Bool = fn(value) {
    match string::parse@[CalendarDateParts](value) {
        Err(_) => False,
        Ok(parts) => calendar_components(parts.year, parts.month, parts.day),
    }
};

def canonical_utc_second: Fn(String) -> Bool = fn(value) {
    match string::parse@[CanonicalUtcParts](value) {
        Err(_) => False,
        Ok(parts) => calendar_components(parts.year, parts.month, parts.day) && parts.hour < 24 && parts.minute < 60 && parts.second < 60,
    }
};

def canonical_ipv4: Fn(String) -> Bool = fn(value) {
    match string::parse@[Ipv4Parts](value) {
        Ok(parts) => parts.a <= 255 && parts.b <= 255 && parts.c <= 255 && parts.d <= 255,
        Err(_) => False,
    }
};

# Explicit partial conversion: retain canonical IPv4 strings, otherwise NULL.
# Unlike a logical_type annotation, this makes no claim about raw source encoding.
def canonical_ipv4_view: Fn(qb::BuildCtx, qb::Expr) -> (qb::BuildCtx, qb::Expr) = fn(ctx, base) {
    let octet = "(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)";
    let pattern = qb::bind(ctx, qb::Val::String(`^\{octet}[.]\{octet}[.]\{octet}[.]\{octet}$`));
    # JavaScript '$' can match before a final newline. The second predicate
    # makes the common-regex contract strict for every executor's end anchor.
    let forbidden = qb::bind(pattern.0, qb::Val::String("[^0-9.]"));
    let missing = qb::bind(forbidden.0, qb::Val::None);
    (
        missing.0,
        qb::scalar(
            qb::ScalarFunction::If,
            [
                qb::scalar(
                    qb::ScalarFunction::And,
                    [
                        qb::scalar(qb::ScalarFunction::RegexMatch, [base, pattern.1]),
                        qb::scalar(
                            qb::ScalarFunction::Not,
                            [qb::scalar(qb::ScalarFunction::RegexMatch, [base, forbidden.1])]
                        ),
                    ]
                ),
                base,
                missing.1,
            ]
        )
    )
};

def is_subnet_op: Fn(FilterOp) -> Bool = fn(op) {
    op == FilterOp::InSubnet || op == FilterOp::NotInSubnet
};

@regex::parse_by(regex::compile(r"^(?P<mask>0|[1-9][0-9]?)$"))
type Ipv4Mask = struct {
    mask: Int
};
type Ipv4SubnetSpec = struct {
    prefix: String,
    upper: String,
    exact: Bool,
    pattern: Option(String)
};
def ipv4_subnet: Fn(String) -> Ipv4SubnetSpec = fn(value) {
    let parts = string::split(value, "/");
    if array::length(parts) != 2 || !canonical_ipv4(parts[0]) {
        fail!(`invalid canonical IPv4 subnet \{value}`, value)
    } else {
        let octets = string::split(parts[0], ".");
        let mask = match string::parse@[Ipv4Mask](parts[1]) {
            Ok(parsed) => if parsed.mask <= 32 {
                parsed.mask
            } else {
                fail!(`IPv4 subnet mask must be 0..32`, value)
            },
            Err(_) => fail!(`IPv4 subnet mask must be canonical 0..32`, value),
        };
        let parsed = match string::parse@[Ipv4Parts](parts[0]) {
            Ok(address) => address,
            Err(_) => fail!("invalid canonical IPv4 subnet", value),
        };
        let values = [parsed.a, parsed.b, parsed.c, parsed.d];
        let whole = mask / 8;
        let remainder = mask % 8;
        let width = [256, 128, 64, 32, 16, 8, 4, 2][remainder];
        let host_bits = array::any(
            int_range(4),
            fn(i) {
                if i < whole {
                    False
                } else if i == whole {
                    values[i] % width != 0
                } else {
                    values[i] != 0
                }
            }
        );
        if host_bits {
            fail!(`IPv4 subnet network address contains host bits: \{value}`, value)
        } else {
            let prefix = string::join(
                array::map(
                    int_range(whole),
                    fn(i) {
                        octets[i]
                    }
                ),
                "."
            );
            let pattern = if remainder == 0 {
                None
            } else {
                let fixed = array::map(
                    int_range(whole),
                    fn(i) {
                        octets[i]
                    }
                );
                let partial = `(\{string::join(array::map(int_range(width), fn(i) { `\{values[whole] + i}` }), "|")})`;
                let tail = array::map(
                    int_range(3 - whole),
                    fn(i) {
                        "[0-9]{1,3}"
                    }
                );
                Some(`^\{string::join(array::concat([array::push(fixed, partial), tail]), "[.]")}$`)
            };
            {
                prefix: if whole > 0 && whole < 4 {
                    `\{prefix}.`
                } else {
                    prefix
                },
                upper: `\{prefix}/`,
                exact: mask == 32,
                pattern
            }
        }
    }
};

def filter_argument_allowed: Fn(Array(FilterInputKind), FilterOp, FilterInput) -> Bool = fn(
    kinds,
    op,
    input
) {
    if is_subnet_op(op) {
        kinds == [FilterInputKind::Ipv4] && match input {
            FilterInput::Ipv4Subnet(_) => True,
            _ => False
        }
    } else {
        filter_input_allowed(kinds, input)
    }
};

def subnet_condition: Fn(
    qb::BuildCtx,
    DimensionEntry,
    qb::Expr,
    FilterOp,
    FilterInput
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, entry, base, op, input) {
    if !filter_argument_allowed(entry.input_kinds, op, input) {
        fail!(
            `subnet operation requires a typed IPv4 subnet for dimension \{entry.id}`,
            entry.id,
            input
        )
    } else {
        let spec = match input {
            FilterInput::Ipv4Subnet(value) => ipv4_subnet(value),
            _ => fail!("missing subnet argument", input)
        };
        let comparison = if op == FilterOp::InSubnet {
            qb::ScalarFunction::Eq
        } else {
            qb::ScalarFunction::Ne
        };
        if spec.prefix == "" && spec.pattern == None {
            # Self-comparison excludes NULL on both sides of the complement.
            (ctx, qb::scalar(comparison, [base, base]))
        } else {
            if spec.exact {
                let address = qb::bind(ctx, qb::Val::String(spec.prefix));
                (address.0, qb::scalar(comparison, [base, address.1]))
            } else {
                let prefix = if spec.prefix == "" {
                    (ctx, qb::scalar(qb::ScalarFunction::Eq, [base, base]))
                } else {
                    let lower = qb::bind(ctx, qb::Val::String(spec.prefix));
                    # IPv4 prefixes end in ASCII '.', whose binary successor is '/'.
                    let upper = qb::bind(lower.0, qb::Val::String(spec.upper));
                    let binary = qb::scalar(qb::ScalarFunction::BinaryText, [base]);
                    (
                        upper.0,
                        qb::scalar(
                            qb::ScalarFunction::And,
                            [
                                qb::scalar(qb::ScalarFunction::Ge, [binary, lower.1]),
                                qb::scalar(qb::ScalarFunction::Lt, [binary, upper.1]),
                            ]
                        )
                    )
                };
                let membership = match spec.pattern {
                    None => prefix,
                    Some(pattern) => {
                        let bound = qb::bind(prefix.0, qb::Val::String(pattern));
                        let exact = qb::scalar(qb::ScalarFunction::RegexMatch, [base, bound.1]);
                        (
                            bound.0,
                            if spec.prefix == "" {
                                exact
                            } else {
                                qb::scalar(qb::ScalarFunction::And, [prefix.1, exact])
                            }
                        )
                    },
                };
                (
                    membership.0,
                    if op == FilterOp::InSubnet {
                        membership.1
                    } else {
                        qb::scalar(qb::ScalarFunction::Not, [membership.1])
                    }
                )
            }
        }
    }
};

def canonical_rfc3339: Fn(String) -> Bool = fn(value) {
    match string::parse@[DateTimeUtcParts](value) {
        Err(_) => match string::parse@[DateTimeUtcMillisParts](value) {
            Err(_) => False,
            Ok(parts) => calendar_components(parts.year, parts.month, parts.day) && parts.hour < 24 && parts.minute < 60 && parts.second < 60,
        },
        Ok(parts) => calendar_components(parts.year, parts.month, parts.day) && parts.hour < 24 && parts.minute < 60 && parts.second < 60,
    }
};

# Fixed millisecond precision is a comparison key, not a local clock conversion.
# Normalizing both whole seconds and fractional seconds preserves temporal order.
def rfc3339_key: Fn(String) -> String = fn(value) {
    if !canonical_rfc3339(value) {
        fail!("invalid RFC3339 UTC value (seconds or 1..3 fractional digits)", value)
    } else {
        let body = string::replace(value, "Z", "");
        let parts = string::split(body, ".");
        if array::length(parts) == 1 {
            `\{body}.000Z`
        } else {
            let fraction = parts[1];
            let padded = if string::length(fraction) == 1 {
                `\{fraction}00`
            } else if string::length(fraction) == 2 {
                `\{fraction}0`
            } else {
                fraction
            };
            `\{parts[0]}.\{padded}Z`
        }
    }
};

def validate_time_filter: Fn(PreparedPayload, DimensionEntry, FilterInput) -> Bool = fn(
    payload,
    entry,
    input
) {
    let entity = payload.entities[entry.entity];
    let role = entity.fields[entry.field].time;
    match role {
        Some(time) => if !entry.computed || entry.utc_bucket != None {
            match time.encoding {
                TimeEncoding::DateText => match input {
                    FilterInput::Date(value) => if calendar_date(value) {
                        True
                    } else {
                        fail!("invalid calendar date filter value", entry.id, value)
                    },
                    _ => fail!("calendar date filter requires Date input", entry.id, input),
                },
                TimeEncoding::Rfc3339Text => match input {
                    FilterInput::DateTimeUtc(value) => if canonical_rfc3339(value) {
                        True
                    } else {
                        fail!(
                            "invalid RFC3339 UTC value (seconds or 1..3 fractional digits)",
                            entry.id,
                            value
                        )
                    },
                    _ => fail!("RFC3339 time field requires RFC3339 input", entry.id, input),
                },
                TimeEncoding::EpochMillis => match input {
                    FilterInput::EpochMillis(_) => True,
                    _ => fail!(
                        "epoch-millisecond time field requires EpochMillis input",
                        entry.id,
                        input
                    ),
                },
                TimeEncoding::LocalText => match input {
                    FilterInput::DateTime(value) => if canonical_utc_second(value) {
                        True
                    } else {
                        fail!("invalid local datetime filter value", entry.id, value)
                    },
                    _ => fail!("local datetime field requires DateTime input", entry.id, input),
                },
            }
        } else {
            True
        },
        None => True,
    }
};

# True for the text-search operations (starts-with/contains/ends-with families).
def is_text_op: Fn(FilterOp) -> Bool = fn(op) {
    match op {
        FilterOp::Contains => True,
        FilterOp::NotContains => True,
        FilterOp::StartsWith => True,
        FilterOp::EndsWith => True,
        FilterOp::Eq => False,
        FilterOp::Ne => False,
        FilterOp::Gt => False,
        FilterOp::Ge => False,
        FilterOp::Lt => False,
        FilterOp::Le => False,
        FilterOp::InSubnet => False,
        FilterOp::NotInSubnet => False,
    }
};

# Build the closed query expression for an open (non-enum) dimension filter.
# The caller has already validated operation support and the input kind/value.
# Comparison ops map to the closed query scalars; text ops lower through the
# closed qb.ScalarFunction.Instr/qb.ScalarFunction.Lower/qb.ScalarFunction.Length/qb.ScalarFunction.Substr/qb.ScalarFunction.Add/qb.ScalarFunction.Sub vocabulary. All runtime values
# remain parameterized binds.
# Convert a runtime filter value into the query ScalarValue used at codec
# boundaries and by HAVING thresholds.
def to_val: Fn(FilterInput) -> qb::Val = fn(input) {
    # Tagged domain inputs must be lowered through canonical_compare_with_context.
    match input {
        FilterInput::Unknown(_) => fail!("Unknown is not a scalar wire", input),
        FilterInput::Unknowns => fail!("Unknowns is not a scalar wire", input),
        FilterInput::Text(s) => qb::Val::String(s),
        FilterInput::Ipv4Subnet(_) => fail!(
            "IPv4 subnet is an operation argument, not a scalar address",
            input
        ),
        FilterInput::Ipv4(value) => if canonical_ipv4(value) {
            qb::Val::String(value)
        } else {
            fail!(`invalid canonical IPv4 address \{value}`, value)
        },
        FilterInput::Number(f) => qb::Val::Float(f),
        FilterInput::Int(i) => qb::Val::Int(i),
        FilterInput::Bool(b) => qb::Val::Bool(b),
        FilterInput::DateTimeUtc(value) => qb::Val::String(rfc3339_key(value)),
        FilterInput::EpochMillis(value) => qb::Val::Int(value),
        FilterInput::Date(value) => qb::Val::String(value),
        FilterInput::DateTime(value) => qb::Val::String(value),
    }
};

# Enum closed-domain filter resolution. A legal stable value keeps producing a
# parameterized binding; unknown values fail atomically with the the
# dimension id and the dynamic JSON input value as evidence.
# Construction-time variant: validation precedes allocation for each request,
# and each generated predicate carries handles registered in the returned ctx.
def canonical_compare_with_context: Fn(
    qb::BuildCtx,
    DimensionEntry,
    qb::Expr,
    FilterOp,
    FilterInput
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, entry, base, op, input) {
    match input {
        FilterInput::Unknown(raw) => do {
            if !entry.half_open || known_wire(entry, raw) {
                fail!("Unknown requires an unrecognized wire in a half-open domain", entry.id, raw)
            } else if op != FilterOp::Eq && op != FilterOp::Ne {
                fail!("half-open domain supports only Eq or Ne", entry.id, op)
            } else {
                let bound = qb::bind(ctx, qb::Val::String(raw));
                (
                    bound.0,
                    qb::scalar(
                        if op == FilterOp::Eq {
                            qb::ScalarFunction::Eq
                        } else {
                            qb::ScalarFunction::Ne
                        },
                        [base, bound.1]
                    )
                )
            }
        },
        FilterInput::Unknowns => do {
            if !entry.half_open {
                fail!("Unknowns requires a half-open domain", entry.id)
            } else if op != FilterOp::Eq && op != FilterOp::Ne {
                fail!("half-open domain supports only Eq or Ne", entry.id, op)
            } else {
                let known = canonical_known_with_context(ctx, entry, base);
                (
                    known.0,
                    if op == FilterOp::Ne {
                        known.1
                    } else {
                        qb::scalar(
                            qb::ScalarFunction::And,
                            [qb::is_not_null(base), qb::scalar(qb::ScalarFunction::Not, [known.1])]
                        )
                    }
                )
            }
        },
        _ => canonical_known_compare_with_context(ctx, entry, base, op, input),
    }
};

def known_wire: Fn(DimensionEntry, String) -> Bool = fn(entry, raw) {
    array::any(
        entry.canonical_values,
        fn(value) {
            array::any(
                value.wires,
                fn(wire) {
                    wire == FilterInput::Text(raw)
                }
            )
        }
    )
};

def canonical_known_with_context: Fn(
    qb::BuildCtx,
    DimensionEntry,
    qb::Expr
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, entry, base) {
    let known = array::fold(
        entry.canonical_values,
        (ctx, None),
        fn(state, value) {
            let equal = canonical_known_compare_with_context(
                state.0,
                entry,
                base,
                FilterOp::Eq,
                FilterInput::Text(value.id)
            );
            (
                equal.0,
                Some(
                    match state.1 {
                        None => equal.1,
                        Some(prev) => qb::scalar(qb::ScalarFunction::Or, [prev, equal.1])
                    }
                )
            )
        }
    );
    (
        known.0,
        match known.1 {
            Some(expr) => expr,
            None => fail!("empty canonical domain", entry.id)
        }
    )
};

def dimension_kind_with_context: Fn(
    qb::BuildCtx,
    PreparedPayload,
    DimensionEntry
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry) {
    let physical = dimension_expr(ctx, payload, entry);
    let known = canonical_known_with_context(physical.0, entry, physical.1);
    let k = qb::bind(known.0, qb::Val::String("Known"));
    let u = qb::bind(k.0, qb::Val::String("Unknown"));
    let n = qb::bind(u.0, qb::Val::None);
    (n.0, qb::scalar_if(known.1, k.1, qb::scalar_if(qb::is_not_null(physical.1), u.1, n.1)))
};

def canonical_known_compare_with_context: Fn(
    qb::BuildCtx,
    DimensionEntry,
    qb::Expr,
    FilterOp,
    FilterInput
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, entry, base, op, input) {
    let id = match input {
        FilterInput::Text(value) => value,
        _ => fail!("canonical dimension requires a text business value", entry.id, input),
    };
    if op != FilterOp::Eq && op != FilterOp::Ne {
        fail!("canonical dimension supports only Eq or Ne", entry.id, op)
    } else {
        let matched = match array::find(
            entry.canonical_values,
            fn(v) {
                v.id == id
            }
        ) {
            Some(value) => value,
            None => fail!(
                `unknown canonical value \{id} for dimension \{entry.id}; find its Dimension key in index`,
                entry.id,
                id
            ),
        };
        let scalar = if op == FilterOp::Eq {
            qb::ScalarFunction::Eq
        } else {
            qb::ScalarFunction::Ne
        };
        let wires = array::fold(
            matched.wires,
            (ctx, None),
            fn(state, wire) {
                let (next, bound) = qb::bind(state.0, to_val(wire));
                let term = qb::scalar(scalar, [base, bound]);
                let expr = match state.1 {
                    None => term,
                    Some(prev) => qb::scalar(
                        if op == FilterOp::Eq {
                            qb::ScalarFunction::Or
                        } else {
                            qb::ScalarFunction::And
                        },
                        [prev, term]
                    ),
                };
                (next, Some(expr))
            }
        );
        let compared = match wires.1 {
            Some(expr) => expr,
            None => fail!("canonical value has no physical wires", entry.id, id),
        };
        if op == FilterOp::Eq || entry.half_open {
            (wires.0, compared)
        } else {
            let known = array::fold(
                entry.canonical_values,
                (wires.0, None),
                fn(state, value) {
                    let equal = canonical_compare_with_context(
                        state.0,
                        entry,
                        base,
                        FilterOp::Eq,
                        FilterInput::Text(value.id)
                    );
                    let expr = match state.1 {
                        None => equal.1,
                        Some(prev) => qb::scalar(qb::ScalarFunction::Or, [prev, equal.1]),
                    };
                    (equal.0, Some(expr))
                }
            );
            match known.1 {
                Some(domain) => (known.0, qb::scalar(qb::ScalarFunction::And, [compared, domain])),
                None => fail!("canonical dimension has no declared business values", entry.id),
            }
        }
    }
};

def open_condition_with_context: Fn(
    qb::BuildCtx,
    qb::Expr,
    FilterOp,
    qb::Expr
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, base, op, bound) {
    if is_text_op(op) {
        let constant = qb::bind(
            ctx,
            qb::Val::Int(
                if op == FilterOp::StartsWith || op == FilterOp::EndsWith {
                    1
                } else {
                    0
                }
            )
        );
        let expr = match op {
            FilterOp::Contains => qb::scalar(
                qb::ScalarFunction::Gt,
                [qb::instr(qb::lower(base), qb::lower(bound)), constant.1]
            ),
            FilterOp::NotContains => qb::scalar(
                qb::ScalarFunction::Eq,
                [qb::instr(qb::lower(base), qb::lower(bound)), constant.1]
            ),
            FilterOp::StartsWith => qb::scalar(
                qb::ScalarFunction::Eq,
                [qb::instr(qb::lower(base), qb::lower(bound)), constant.1]
            ),
            FilterOp::EndsWith => do {
                let lower_base = qb::lower(base);
                let lower_bound = qb::lower(bound);
                let start = qb::add(
                    qb::sub(qb::length(lower_base), qb::length(lower_bound)),
                    constant.1
                );
                qb::scalar(qb::ScalarFunction::Eq, [qb::substr([lower_base, start]), lower_bound])
            },
            _ => fail!("invalid text filter operation", op),
        };
        (constant.0, expr)
    } else {
        let function = match op {
            FilterOp::Eq => qb::ScalarFunction::Eq,
            FilterOp::Ne => qb::ScalarFunction::Ne,
            FilterOp::Gt => qb::ScalarFunction::Gt,
            FilterOp::Ge => qb::ScalarFunction::Ge,
            FilterOp::Lt => qb::ScalarFunction::Lt,
            FilterOp::Le => qb::ScalarFunction::Le,
            _ => fail!("invalid scalar filter operation", op),
        };
        (ctx, qb::scalar(function, [base, bound]))
    }
};

def filter_value_on_base_with_context: Fn(
    qb::BuildCtx,
    DimensionEntry,
    qb::Expr,
    FilterOp,
    FilterInput
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, entry, base, op, input) {
    if is_subnet_op(op) {
        subnet_condition(ctx, entry, base, op, input)
    } else if array::length(entry.canonical_values) > 0 {
        canonical_compare_with_context(ctx, entry, base, op, input)
    } else if is_text_op(op) && match input {
        FilterInput::Text(_) => False,
        _ => True
    } {
        fail!("text filter operation requires a text input value", entry.id)
    } else if !filter_input_allowed(entry.input_kinds, input) {
        fail!(
            `invalid filter value for dimension \{entry.id}; find its Dimension key in index`,
            entry.id
        )
    } else {
        let bound = qb::bind(ctx, to_val(input));
        open_condition_with_context(bound.0, base, op, bound.1)
    }
};

def filter_value_with_context: Fn(
    qb::BuildCtx,
    PreparedPayload,
    DimensionEntry,
    FilterOp,
    FilterInput
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, payload, entry, op, input) {
    let valid = validate_time_filter(payload, entry, input);
    let base = dimension_expr(ctx, payload, entry);
    if valid {
        filter_value_on_base_with_context(base.0, entry, base.1, op, input)
    } else {
        fail!("invalid time filter", entry.id)
    }
};

def resolve_filters_with_context: Fn(
    qb::BuildCtx,
    PreparedPayload,
    Array(FilterRequest)
) -> (qb::BuildCtx, Array(FilterResolution)) = fn(ctx, payload, requests) {
    let initial: (qb::BuildCtx, Array(FilterResolution)) = (ctx, []);
    array::fold(
        requests,
        initial,
        fn(state, req) {
            let entry = match array::find(
                payload.dimensions,
                fn(d) {
                    d.id == req.id
                }
            ) {
                Some(d) => d,
                None => fail!(
                    `unknown filter dimension \{req.id}; related knowledge key "index"`,
                    req.id
                ),
            };
            if !entry.authorized {
                fail!(
                    `dimension \{req.id} is not authorized; related knowledge key "index" for visible alternatives`,
                    req.id
                )
            } else if !entry.filterable {
                fail!(
                    `dimension has no filter capability: \{req.id}; related knowledge key \{knowledge_key_hint(KnowledgeKind::Dimension, payload.entities[entry.entity].id, entry.id)}`,
                    req.id
                )
            } else if !array::any(
                entry.ops,
                fn(op) {
                    op == req.op
                }
            ) {
                fail!(
                    `filter operation not supported for dimension \{req.id}: \{json::stringify(codec::encode(req.op))}; related knowledge key \{knowledge_key_hint(KnowledgeKind::Dimension, payload.entities[entry.entity].id, entry.id)}`,
                    req.id,
                    req.op
                )
            } else {
                let valid_time = validate_time_filter(payload, entry, req.input);
                let computed = dimension_expr(state.0, payload, entry);
                let base = computed.1;
                let resolved = if !valid_time {
                    fail!("invalid time filter", entry.id)
                } else if is_subnet_op(req.op) {
                    subnet_condition(computed.0, entry, base, req.op, req.input)
                } else if array::length(entry.canonical_values) > 0 {
                    canonical_compare_with_context(computed.0, entry, base, req.op, req.input)
                } else if is_text_op(req.op) && match req.input {
                    FilterInput::Text(_) => False,
                    _ => True
                } {
                    fail!("text filter operation requires a text input value", req.id)
                } else if !filter_input_allowed(entry.input_kinds, req.input) {
                    fail!(
                        `invalid filter value for dimension \{req.id}; find its Dimension key in index`,
                        req.id
                    )
                } else {
                    let bound = qb::bind(computed.0, to_val(req.input));
                    open_condition_with_context(bound.0, base, req.op, bound.1)
                };
                let item: FilterResolution = {
                    expr: resolved.1,
                    dimension: entry.id,
                    entity: entry.entity,
                    field: entry.field,
                    op: req.op,
                    input: req.input
                };
                (resolved.0, array::push(state.1, item))
            }
        }
    )
};

def combine_filters: Fn(Array(qb::Expr)) -> Option(qb::Expr) = fn(exprs) {
    let init_none: Option(qb::Expr) = None;
    match array::fold(
        exprs,
        init_none,
        fn(acc, expr) {
            match acc {
                None => Some(expr),
                Some(prev) => Some(qb::scalar(qb::ScalarFunction::And, [prev, expr])),
            }
        }
    ) {
        Some(expr) => Some(expr),
        None => None,
    }
};

# ---------------------------------------------------------------------------
# Closed OR-group (AnyOf) over one dimension.
# ---------------------------------------------------------------------------
# Left-associative Or over Eq(base, bind(value)) in request order.
# Value-level check for one AnyOf member against a resolved dimension entry:
# closed enum domains require a Text stable value; open dimensions require an
# allowed input kind.
def append_filter_terms: Fn(Option(qb::Expr), Array(qb::Expr)) -> Option(qb::Expr) = fn(base, extra) {
    array::fold(
        extra,
        base,
        fn(acc, expr) {
            match acc {
                None => Some(expr),
                Some(prev) => Some(qb::scalar(qb::ScalarFunction::And, [prev, expr])),
            }
        }
    )
};

# 局部 scope 首次绑定到完整 dimension；值约束由绑定过程一次完成。
def resolve_scope_on_dimension: Fn(
    qb::BuildCtx,
    PreparedPayload,
    DimensionEntry,
    ScopePredicate
) -> (qb::BuildCtx, FilterResolution) = fn(ctx, payload, d, predicate) {
    let entity = payload.entities[d.entity];
    let hint = if d.authorized {
        knowledge_key_hint(KnowledgeKind::Dimension, entity.id, d.id)
    } else {
        "\"index\""
    };
    if !array::any(
        d.ops,
        fn(op) {
            op == predicate.op
        }
    ) {
        fail!(
            `scope uses an operation not supported by the dimension \{d.id}: \{json::stringify(codec::encode(predicate.op))}; related knowledge key \{hint}`,
            d.id,
            predicate.op
        )
    } else {
        let resolved = filter_value_with_context(ctx, payload, d, predicate.op, predicate.input);
        let item: FilterResolution = {
            expr: resolved.1,
            dimension: d.id,
            entity: d.entity,
            field: d.field,
            op: predicate.op,
            input: predicate.input
        };
        (resolved.0, item)
    }
};

def instantiate_scope: Fn(qb::Expr, String, String, Int) -> qb::Expr = fn(
    expr,
    previous,
    fresh,
    offset
) {
    match expr {
        qb::Expr::Column(column) => qb::Expr::Column(
            if column.source == previous {
                column <~ {source: fresh}
            } else {
                column
            }
        ),
        qb::Expr::AllocatedBind(binding) => qb::Expr::AllocatedBind(
            binding <~ {index: binding.index + offset}
        ),
        qb::Expr::Scalar(call) => qb::Expr::Scalar(
            call <~ {
                args: array::map(
                    call.args,
                    fn(arg) {
                        instantiate_scope(arg, previous, fresh, offset)
                    }
                )
            }
        )
    }
};
def entity_source_at_with_context: Fn(
    qb::BuildCtx,
    PreparedPayload,
    EntityEntry,
    String
) -> (qb::BuildCtx, qb::Source) = fn(ctx, payload, entity, hint) {
    let allocated = qb::source_with_hint(ctx, entity.table, hint);
    let template = entity.source_scope;
    let context = allocated.0 <~ {
        bindings: array::concat([allocated.0.bindings, template.bindings]),
        next_binding: allocated.0.next_binding + array::length(template.bindings)
    };
    let source = allocated.1 <~ {
        scope: match template.expression {
            Some(expr) => Some(
                instantiate_scope(
                    expr,
                    template.alias,
                    allocated.1.alias,
                    allocated.0.next_binding - 1
                )
            ),
            None => None
        }
    };
    (context, source)
};
# Different computed dimensions may share a physical field but transform it
# differently. Only different equalities on the same semantic dimension conflict.
def eq_conflict: Fn(FilterResolution, FilterResolution) -> Bool = fn(a, b) {
    a.entity == b.entity && a.dimension == b.dimension && a.op == FilterOp::Eq && b.op == FilterOp::Eq && match (
        a.input,
        b.input
    ) {
        (FilterInput::DateTimeUtc(x), FilterInput::DateTimeUtc(y)) => rfc3339_key(x) != rfc3339_key(
            y
        ),
        _ => a.input != b.input,
    }
};

def find_internal_conflict: Fn(Array(FilterResolution)) -> Option(FilterResolution) = fn(list) {
    let n = array::length(list);
    let init: Option(FilterResolution) = None;
    array::fold(
        int_range(n),
        init,
        fn(acc, i) {
            match acc {
                Some(_) => acc,
                None => do {
                    let a = list[i];
                    let inner_init: Option(FilterResolution) = None;
                    array::fold(
                        int_range(n),
                        inner_init,
                        fn(inner_acc, j) {
                            match inner_acc {
                                Some(_) => inner_acc,
                                None => if j > i {
                                    let b = list[j];
                                    if eq_conflict(a, b) {
                                        Some(b)
                                    } else {
                                        None
                                    }
                                } else {
                                    None
                                },
                            }
                        }
                    )
                },
            }
        }
    )
};

def resolve_measure_predicate_with_context: Fn(
    qb::BuildCtx,
    PreparedMeasurePredicate,
    qb::Source
) -> (qb::BuildCtx, qb::Expr) = fn(ctx, predicate, source) {
    let column = prepared_column(source, predicate.column);
    let first = qb::bind(ctx, predicate.wires[0]);
    let built = array::fold(
        predicate.wires,
        (first.0, qb::scalar(qb::ScalarFunction::Eq, [column, first.1]), True),
        fn(state, wire) {
            if state.2 {
                (state.0, state.1, False)
            } else {
                let bound = qb::bind(state.0, wire);
                (
                    bound.0,
                    qb::scalar(
                        qb::ScalarFunction::Or,
                        [state.1, qb::scalar(qb::ScalarFunction::Eq, [column, bound.1])]
                    ),
                    False
                )
            }
        }
    );
    (built.0, built.1)
};

def graph_key_condition: Fn(
    PreparedPayload,
    RelationEntry,
    qb::Source,
    qb::Source,
    RelationKey
) -> qb::JoinCondition = fn(payload, relation, from_source, to_source, key) {
    match key {
        RelationKey::Eq(pair) => do {
            let from_field = payload.entities[relation.from].fields[pair.from];
            let to_field = payload.entities[relation.to].fields[pair.to];
            qb::on_eq(
                prepared_column_ref(from_source, from_field.column),
                prepared_column_ref(to_source, to_field.column)
            )
        },
        RelationKey::And(parts) => qb::on_and(
            array::map(
                parts,
                fn(part) {
                    graph_key_condition(payload, relation, from_source, to_source, part)
                }
            )
        ),
        RelationKey::Or(parts) => qb::on_or(
            array::map(
                parts,
                fn(part) {
                    graph_key_condition(payload, relation, from_source, to_source, part)
                }
            )
        ),
    }
};

def guard_information: Fn(Option(PreparedGuard)) -> Option(ScopePredicate) = fn(guard) {
    match guard {
        None => None,
        Some(value) => Some({field: value.field, op: value.op, input: value.input})
    }
};
def bind_indexed_guard: Fn(
    qb::BuildCtx,
    EntityEntry,
    Option(PreparedGuard),
    qb::Source
) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, entity, guard, source) {
    match guard {
        None => (ctx, None),
        Some(value) => {
            let bound = qb::bind(ctx, to_val(value.input));
            let operation = if value.op == FilterOp::Ne {
                qb::ScalarFunction::Ne
            } else {
                qb::ScalarFunction::Eq
            };
            (
                bound.0,
                Some(
                    qb::scalar(
                        operation,
                        [prepared_column(source, entity.fields[value.index].column), bound.1]
                    )
                )
            )
        }
    }
};
def bind_relation_guard: Fn(
    qb::BuildCtx,
    PreparedPayload,
    RelationEntry,
    qb::Source
) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, payload, relation, source) {
    bind_indexed_guard(ctx, payload.entities[relation.from], relation.guard, source)
};
def bind_link_guard: Fn(
    qb::BuildCtx,
    PreparedPayload,
    BusinessLinkEntry,
    qb::Source
) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, payload, link, source) {
    bind_indexed_guard(ctx, payload.entities[link.hub], link.guard, source)
};
def graph_guarded_join: Fn(
    qb::BuildCtx,
    PreparedPayload,
    RelationEntry,
    qb::Source,
    qb::Source
) -> (qb::BuildCtx, qb::JoinCondition) = fn(ctx, payload, relation, from_source, to_source) {
    let key = graph_key_condition(payload, relation, from_source, to_source, relation.key);
    let guard = bind_relation_guard(ctx, payload, relation, from_source);
    (
        guard.0,
        match guard.1 {
            None => key,
            Some(expr) => qb::on_and([key, qb::on_predicate(expr)]),
        }
    )
};

def graph_link_joins: Fn(
    qb::BuildCtx,
    PreparedPayload,
    BusinessLinkEntry,
    qb::Source,
    String
) -> (qb::BuildCtx, qb::Source, Array(qb::Join)) = fn(ctx, payload, link, origin, target_hint) {
    let a = request_relation(payload, link.a_relation);
    let z = request_relation(payload, link.z_relation);
    let hub_entry = payload.entities[link.hub];
    let peer_entry = payload.entities[link.participant];
    let hub = entity_source_at_with_context(ctx, payload, hub_entry, `\{link.id}_link`);
    let guard = bind_link_guard(hub.0, payload, link, hub.1);
    let peer = entity_source_at_with_context(guard.0, payload, peer_entry, target_hint);
    let origin_a = graph_key_condition(payload, a, hub.1, origin, a.key);
    let origin_z = graph_key_condition(payload, z, hub.1, origin, z.key);
    let peer_a = graph_key_condition(payload, a, hub.1, peer.1, a.key);
    let peer_z = graph_key_condition(payload, z, hub.1, peer.1, z.key);
    let symmetric = link.direction == LinkDirection::Undirected;
    let hub_condition = if symmetric {
        qb::on_or([origin_a, origin_z])
    } else {
        origin_a
    };
    let hub_condition = match guard.1 {
        None => hub_condition,
        Some(expr) => qb::on_and([hub_condition, qb::on_predicate(expr)]),
    };
    let peer_condition = if symmetric {
        qb::on_or([qb::on_and([origin_a, peer_z]), qb::on_and([origin_z, peer_a])])
    } else {
        peer_z
    };
    (
        peer.0,
        peer.1,
        [
            qb::join_on(qb::JoinKind::Inner, hub.1, hub_condition),
            qb::join_on(qb::JoinKind::Inner, peer.1, peer_condition)
        ]
    )
};

type GraphInstance = struct {
    id: String,
    entity: Int,
    source: qb::Source
};

def graph_node: Fn(GraphRequest, String) -> GraphNode = fn(request, id) {
    match array::find(
        request.nodes,
        fn(node) {
            node.id == id
        }
    ) {
        Some(node) => node,
        None => fail!(`graph edge references an unknown node \{id}; declare it in nodes`, id),
    }
};

def graph_instance: Fn(Array(GraphInstance), String) -> GraphInstance = fn(instances, id) {
    match array::find(
        instances,
        fn(instance) {
            instance.id == id
        }
    ) {
        Some(instance) => instance,
        None => fail!(`graph node \{id} is not connected to the root; add a declared edge`, id),
    }
};

def graph_constraint_key: Fn(
    PreparedPayload,
    RelationEntry,
    qb::Source,
    qb::Source,
    RelationKey
) -> qb::Expr = fn(payload, relation, from_source, to_source, key) {
    match key {
        RelationKey::Eq(pair) => do {
            let from_field = payload.entities[relation.from].fields[pair.from];
            let to_field = payload.entities[relation.to].fields[pair.to];
            qb::scalar(
                qb::ScalarFunction::Eq,
                [
                    prepared_column(from_source, from_field.column),
                    prepared_column(to_source, to_field.column)
                ]
            )
        },
        RelationKey::And(parts) => qb::scalar(
            qb::ScalarFunction::And,
            array::map(
                parts,
                fn(part) {
                    graph_constraint_key(payload, relation, from_source, to_source, part)
                }
            )
        ),
        RelationKey::Or(parts) => qb::scalar(
            qb::ScalarFunction::Or,
            array::map(
                parts,
                fn(part) {
                    graph_constraint_key(payload, relation, from_source, to_source, part)
                }
            )
        ),
    }
};

def graph_constraints: Fn(
    qb::BuildCtx,
    PreparedPayload,
    Array(GraphInstance),
    Array(GraphEdge)
) -> (qb::BuildCtx, Array(qb::Expr)) = fn(ctx, payload, instances, edges) {
    array::fold(
        edges,
        (ctx, []),
        fn(state, edge) {
            if edge.from == edge.to {
                fail!("graph constraint requires two distinct named nodes", edge)
            } else {
                let from = graph_instance(instances, edge.from);
                let to = graph_instance(instances, edge.to);
                let relation = request_relation(payload, edge.relation);
                if relation.from != from.entity || relation.to != to.entity {
                    fail!(
                        "graph constraint relation does not match its named node roles",
                        edge,
                        payload.entities[relation.from].id,
                        payload.entities[relation.to].id
                    )
                } else {
                    let key = graph_constraint_key(
                        payload,
                        relation,
                        from.source,
                        to.source,
                        relation.key
                    );
                    let guard = bind_relation_guard(state.0, payload, relation, from.source);
                    let expr = match guard.1 {
                        None => key,
                        Some(value) => qb::scalar(qb::ScalarFunction::And, [key, value]),
                    };
                    (guard.0, array::push(state.1, expr))
                }
            }
        }
    )
};

def graph_filters: Fn(
    qb::BuildCtx,
    PreparedPayload,
    Array(GraphInstance),
    Array(GraphFilter)
) -> (qb::BuildCtx, Option(qb::Expr)) = fn(ctx, payload, instances, filters) {
    let built = array::fold(
        filters,
        (ctx, []),
        fn(state, spec) {
            let instance = graph_instance(instances, spec.node);
            let dimension = match array::find(
                payload.dimensions,
                fn(d) {
                    d.entity == instance.entity && d.id == spec.request.id
                }
            ) {
                Some(d) => d,
                None => fail!(
                    `graph filter on node \{spec.node} references an unknown dimension \{spec.request.id}; related knowledge key "index"`,
                    spec.node,
                    spec.request.id
                ),
            };
            if dimension.entity != instance.entity {
                fail!(
                    `graph filter dimension \{spec.request.id} does not belong to node \{spec.node}`,
                    spec.node,
                    spec.request.id
                )
            } else {
                let resolved = resolve_filters_with_context(
                    state.0,
                    payload <~ {dimensions: [dimension]},
                    [spec.request]
                );
                let original = payload.entities[instance.entity].alias;
                let expressions = array::map(
                    resolved.1,
                    fn(item) {
                        retarget_inner_expr(item.expr, original, instance.source.alias)
                    }
                );
                (resolved.0, array::concat([state.1, expressions]))
            }
        }
    );
    (built.0, append_filter_terms(None, built.1))
};

def graph_any_of: Fn(
    qb::BuildCtx,
    PreparedPayload,
    Array(GraphInstance),
    Array(GraphAnyOf)
) -> (qb::BuildCtx, Array(qb::Expr)) = fn(ctx, payload, instances, groups) {
    array::fold(
        groups,
        (ctx, []),
        fn(state, group) {
            if array::length(group.values) == 0 {
                fail!("graph any_of requires at least one value", group.node, group.dimension)
            } else {
                let alternatives = array::fold(
                    group.values,
                    (state.0, []),
                    fn(next, value) {
                        let request: FilterRequest = {
                            id: group.dimension,
                            op: FilterOp::Eq,
                            input: value
                        };
                        let resolved = graph_filters(
                            next.0,
                            payload,
                            instances,
                            [{node: group.node, request}]
                        );
                        match resolved.1 {
                            Some(expr) => (resolved.0, array::push(next.1, expr)),
                            None => fail!(
                                "graph any_of value produced no predicate",
                                group.node,
                                group.dimension
                            ),
                        }
                    }
                );
                let first = alternatives.1[0];
                let combined = array::fold(
                    array::filter(
                        array::enumerate(alternatives.1),
                        fn(item) {
                            item.0 > 0
                        }
                    ),
                    first,
                    fn(expr, item) {
                        qb::scalar(qb::ScalarFunction::Or, [expr, item.1])
                    }
                );
                (alternatives.0, array::push(state.1, combined))
            }
        }
    )
};

def retarget_inner_expr: Fn(qb::Expr, String, String) -> qb::Expr = fn(expr, previous, fresh) {
    match expr {
        qb::Expr::Column(column) => qb::Expr::Column(
            if column.source == previous {
                {...column, source: fresh}
            } else {
                column
            }
        ),
        qb::Expr::AllocatedBind(_) => expr,
        qb::Expr::Scalar(call) => qb::Expr::Scalar(
            {
                ...call,
                args: array::map(
                    call.args,
                    fn(arg) {
                        retarget_inner_expr(arg, previous, fresh)
                    }
                )
            }
        ),
    }
};

def graph_nullable_source: Fn(
    qb::BuildCtx,
    PreparedPayload,
    EntityEntry,
    GraphNode,
    Array(GraphFilter),
    Array(GraphAnyOf)
) -> (qb::BuildCtx, qb::Source) = fn(ctx, payload, entity, node, filters, groups) {
    let allocated = entity_source_at_with_context(ctx, payload, entity, node.id);
    let instance: GraphInstance = {id: node.id, entity: entity.index, source: allocated.1};
    let selected = array::filter(
        filters,
        fn(item) {
            item.node == node.id
        }
    );
    let filtered = graph_filters(allocated.0, payload, [instance], selected);
    let alternatives = graph_any_of(
        filtered.0,
        payload,
        [instance],
        array::filter(
            groups,
            fn(item) {
                item.node == node.id
            }
        )
    );
    let combined = match filtered.1 {
        Some(expr) => append_filter_terms(
            allocated.1.scope,
            array::concat([[expr], alternatives.1])
        ),
        None => append_filter_terms(allocated.1.scope, alternatives.1),
    };
    (alternatives.0, {...allocated.1, scope: combined})
};

# EXISTS correlations require equality pairs, with the outer/hop source on the
# left regardless of the declaration's physical from/to orientation.
def graph_correlation_pairs: Fn(
    PreparedPayload,
    RelationEntry,
    qb::Source,
    qb::Source,
    Bool,
    RelationKey
) -> Array(qb::ColumnEq) = fn(payload, relation, outer, inner, forward, key) {
    match key {
        RelationKey::Eq(pair) => do {
            let from_field = payload.entities[relation.from].fields[pair.from];
            let to_field = payload.entities[relation.to].fields[pair.to];
            if forward {
                [
                    qb::column_eq(
                        prepared_column_ref(outer, from_field.column),
                        prepared_column_ref(inner, to_field.column)
                    )
                ]
            } else {
                [
                    qb::column_eq(
                        prepared_column_ref(outer, to_field.column),
                        prepared_column_ref(inner, from_field.column)
                    )
                ]
            }
        },
        RelationKey::And(parts) => array::concat(
            array::map(
                parts,
                fn(part) {
                    graph_correlation_pairs(payload, relation, outer, inner, forward, part)
                }
            )
        ),
        RelationKey::Or(_) => fail!(
            "unsupported graph existence key with alternative matches",
            relation.id
        ),
    }
};

# Distribute declared AND/OR keys into closed correlation branches; each
# branch retains every equality declared for that alternative.
def graph_correlation_alternatives: Fn(
    PreparedPayload,
    RelationEntry,
    qb::Source,
    qb::Source,
    Bool,
    RelationKey
) -> Array(Array(qb::ColumnEq)) = fn(payload, relation, outer, inner, forward, key) {
    match key {
        RelationKey::Eq(_) => [
            graph_correlation_pairs(payload, relation, outer, inner, forward, key)
        ],
        RelationKey::And(parts) => array::fold(
            parts,
            [[]],
            fn(branches, part) {
                let next = graph_correlation_alternatives(
                    payload,
                    relation,
                    outer,
                    inner,
                    forward,
                    part
                );
                array::concat(
                    array::map(
                        branches,
                        fn(branch) {
                            array::map(
                                next,
                                fn(other) {
                                    array::concat([branch, other])
                                }
                            )
                        }
                    )
                )
            }
        ),
        RelationKey::Or(parts) => array::concat(
            array::map(
                parts,
                fn(part) {
                    graph_correlation_alternatives(payload, relation, outer, inner, forward, part)
                }
            )
        ),
    }
};

def graph_link_existence: Fn(
    qb::BuildCtx,
    PreparedPayload,
    Array(GraphInstance),
    GraphInstance,
    GraphExist,
    BusinessLinkEntry
) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, outer, anchor, spec, link) {
    if array::length(spec.edges) == 0 {
        fail!("business link existence requires an edge", link.id)
    } else if array::length(spec.having) > 0 {
        fail!(
            "graph aggregate existence requires a single at-most-one sample-to-owner relation",
            link.id
        )
    } else {
        let edge = spec.edges[0];
        let from_anchor = edge.from == anchor.id;
        let next_id = if from_anchor {
            edge.to
        } else {
            edge.from
        };
        if !from_anchor && edge.to != anchor.id {
            fail!("graph existence edge must introduce one node connected to the root", link.id)
        } else if !from_anchor && link.direction == LinkDirection::Directed {
            fail!("directed business link cannot be traversed from Z to A", link.id)
        } else {
            let node = match array::find(
                spec.nodes,
                fn(item) {
                    item.id == next_id
                }
            ) {
                Some(item) => item,
                None => fail!("graph business link references an unknown peer node", next_id),
            };
            if node.id != next_id || anchor.entity != link.participant || entity_by_id(
                payload,
                node.entity
            ) != link.participant {
                fail!(
                    "graph business link endpoints must both be its declared participant",
                    link.id
                )
            } else {
                let hub_entry = payload.entities[link.hub];
                let peer_entry = payload.entities[link.participant];
                let hub = entity_source_at_with_context(ctx, payload, hub_entry, `\{link.id}_link`);
                let guard = bind_link_guard(hub.0, payload, link, hub.1);
                let peer = entity_source_at_with_context(guard.0, payload, peer_entry, next_id);
                let a = request_relation(payload, link.a_relation);
                let z = request_relation(payload, link.z_relation);
                let origin_a = graph_correlation_pairs(
                    payload,
                    a,
                    anchor.source,
                    hub.1,
                    False,
                    a.key
                );
                let origin_z = graph_correlation_pairs(
                    payload,
                    z,
                    anchor.source,
                    hub.1,
                    False,
                    z.key
                );
                let symmetric = link.direction == LinkDirection::Undirected;
                let correlation = if symmetric {
                    [origin_a, origin_z]
                } else {
                    [origin_a]
                };
                let peer_a = graph_key_condition(payload, a, hub.1, peer.1, a.key);
                let peer_z = graph_key_condition(payload, z, hub.1, peer.1, z.key);
                let branch_a = qb::on_and(
                    array::concat(
                        [
                            array::map(
                                origin_a,
                                fn(p) {
                                    qb::on_eq(p.left, p.right)
                                }
                            ),
                            [peer_z]
                        ]
                    )
                );
                let branch_z = qb::on_and(
                    array::concat(
                        [
                            array::map(
                                origin_z,
                                fn(p) {
                                    qb::on_eq(p.left, p.right)
                                }
                            ),
                            [peer_a]
                        ]
                    )
                );
                let condition = if symmetric {
                    qb::on_or([branch_a, branch_z])
                } else {
                    peer_z
                };
                let join = qb::join_on(qb::JoinKind::Inner, peer.1, condition);
                let instances: Array(GraphInstance) = [
                    anchor,
                    {id: node.id, entity: link.participant, source: peer.1}
                ];
                let tail = array::filter(
                    array::enumerate(spec.edges),
                    fn(indexed) {
                        indexed.0 > 0
                    }
                );
                let built = array::fold(
                    tail,
                    (peer.0, instances, [join]),
                    fn(state, indexed) {
                        let next_edge = indexed.1;
                        let forward = array::any(
                            state.1,
                            fn(item) {
                                item.id == next_edge.from
                            }
                        );
                        let backward = array::any(
                            state.1,
                            fn(item) {
                                item.id == next_edge.to
                            }
                        );
                        if forward == backward {
                            fail!(
                                "graph existence edge must introduce one node connected to the root",
                                next_edge.relation
                            )
                        } else {
                            let previous = graph_instance(
                                state.1,
                                if forward {
                                    next_edge.from
                                } else {
                                    next_edge.to
                                }
                            );
                            let new_id = if forward {
                                next_edge.to
                            } else {
                                next_edge.from
                            };
                            let new_node = match array::find(
                                spec.nodes,
                                fn(item) {
                                    item.id == new_id
                                }
                            ) {
                                Some(item) => item,
                                None => fail!(
                                    "graph existence edge references an unknown inner node",
                                    next_edge.relation,
                                    new_id
                                ),
                            };
                            let new_entity = entity_by_id(payload, new_node.entity);
                            match array::find(
                                payload.business_links,
                                fn(entry) {
                                    entry.id == next_edge.relation
                                }
                            ) {
                                Some(next_link) => do {
                                    if previous.entity != next_link.participant || new_entity != next_link.participant {
                                        fail!(
                                            "graph business link endpoints must both be its declared participant",
                                            next_edge.relation
                                        )
                                    } else if !forward && next_link.direction == LinkDirection::Directed {
                                        fail!(
                                            "directed business link cannot be traversed from Z to A",
                                            next_edge.relation
                                        )
                                    } else {
                                        let joined = graph_link_joins(
                                            state.0,
                                            payload,
                                            next_link,
                                            previous.source,
                                            new_id
                                        );
                                        let instance: GraphInstance = {
                                            id: new_id,
                                            entity: new_entity,
                                            source: joined.1
                                        };
                                        (
                                            joined.0,
                                            array::push(state.1, instance),
                                            array::concat([state.2, joined.2])
                                        )
                                    }
                                },
                                None => do {
                                    let relation = request_relation(payload, next_edge.relation);
                                    if (
                                        forward && (
                                            relation.from != previous.entity || relation.to != new_entity
                                        )
                                    ) || (
                                        !forward && (
                                            relation.to != previous.entity || relation.from != new_entity
                                        )
                                    ) {
                                        let expected_from = payload.entities[relation.from].id;
                                        let expected_to = payload.entities[relation.to].id;
                                        let actual_from = if forward {
                                            payload.entities[previous.entity].id
                                        } else {
                                            new_node.entity
                                        };
                                        let actual_to = if forward {
                                            new_node.entity
                                        } else {
                                            payload.entities[previous.entity].id
                                        };
                                        fail!(
                                            `graph existence edge role or target does not match declared relation: \{next_edge.relation} expects from \{expected_from} to \{expected_to}, but \{next_edge.from} is \{actual_from} and \{next_edge.to} is \{actual_to}; correct the node entity or choose a relation declared for these roles`,
                                            next_edge
                                        )
                                    } else {
                                        let source = entity_source_at_with_context(
                                            state.0,
                                            payload,
                                            payload.entities[new_entity],
                                            new_id
                                        );
                                        let condition = graph_guarded_join(
                                            source.0,
                                            payload,
                                            relation,
                                            if forward {
                                                previous.source
                                            } else {
                                                source.1
                                            },
                                            if forward {
                                                source.1
                                            } else {
                                                previous.source
                                            }
                                        );
                                        let next_join = qb::join_on(
                                            qb::JoinKind::Inner,
                                            source.1,
                                            condition.1
                                        );
                                        let instance: GraphInstance = {
                                            id: new_id,
                                            entity: new_entity,
                                            source: source.1
                                        };
                                        (
                                            condition.0,
                                            array::push(state.1, instance),
                                            array::push(state.2, next_join)
                                        )
                                    }
                                },
                            }
                        }
                    }
                );
                let filtered = graph_filters(built.0, payload, built.1, spec.filters);
                let alternatives = graph_any_of(filtered.0, payload, built.1, spec.any_of);
                let exists = qb::exists_path_alternatives(hub.1, correlation, built.2);
                let constraints = graph_constraints(
                    alternatives.0,
                    payload,
                    array::concat([outer, built.1]),
                    spec.constraints
                );
                let constrained = append_filter_terms(
                    filtered.1,
                    array::concat(
                        [
                            match guard.1 {
                                Some(expr) => [expr],
                                None => []
                            },
                            alternatives.1,
                            constraints.1
                        ]
                    )
                );
                let exists = {...exists, filter: constrained};
                (
                    constraints.0,
                    if spec.negated {
                        qb::exists_not(exists)
                    } else {
                        exists
                    }
                )
            }
        }
    }
};

def graph_aggregate_op: Fn(FilterOp) -> qb::HavingOp = fn(op) {
    match op {
        FilterOp::Eq => qb::HavingOp::Eq,
        FilterOp::Ne => qb::HavingOp::Ne,
        FilterOp::Gt => qb::HavingOp::Gt,
        FilterOp::Ge => qb::HavingOp::Ge,
        FilterOp::Lt => qb::HavingOp::Lt,
        FilterOp::Le => qb::HavingOp::Le,
        _ => fail!("graph aggregate threshold requires a comparison operator", op),
    }
};

def graph_having_input_ok: Fn(OutputType, FilterInput) -> Bool = fn(output, input) {
    match (output, input) {
        (OutputType::Integer, FilterInput::Int(_)) => True,
        (OutputType::Number, FilterInput::Number(_)) => True,
        (OutputType::Number, FilterInput::Int(_)) => True,
        (OutputType::Text, FilterInput::Text(_)) => True,
        (OutputType::Boolean, FilterInput::Bool(_)) => True,
        _ => False,
    }
};

def graph_aggregate_having: Fn(
    qb::BuildCtx,
    PreparedPayload,
    GraphInstance,
    Array(GraphHaving)
) -> (qb::BuildCtx, Array(qb::Having)) = fn(ctx, payload, sample, specs) {
    array::fold(
        specs,
        (ctx, []),
        fn(state, spec) {
            let measure = match array::find(
                payload.measures,
                fn(entry) {
                    entry.entity == sample.entity && entry.id == spec.measure
                }
            ) {
                Some(entry) => entry,
                None => fail!(
                    "graph aggregate references an unknown declared measure",
                    spec.measure
                ),
            };
            if spec.node != sample.id {
                fail!(
                    "graph aggregate measure does not belong to its sample node",
                    spec.node,
                    spec.measure
                )
            } else if measure.aggregate == qb::AggregateFunction::Latest {
                fail!(
                    "Latest is not supported in nested EXISTS aggregate predicates; use an outer projected measure",
                    spec.measure
                )
            } else if measure.computed != None {
                fail!("graph aggregate requires a non-computed sample measure", spec.measure)
            } else {
                let output = measure.output_type;
                if !graph_having_input_ok(output, spec.threshold) {
                    fail!(
                        "graph aggregate threshold does not match measure output type",
                        spec.measure,
                        output,
                        spec.threshold
                    )
                } else {
                    let entity = payload.entities[sample.entity];
                    let field = entity.fields[measure.field];
                    let filtered = match measure.predicate {
                        None => (state.0, None),
                        Some(predicate) => do {
                            let resolved = resolve_measure_predicate_with_context(
                                state.0,
                                predicate,
                                entity.source
                            );
                            (
                                resolved.0,
                                Some(
                                    retarget_inner_expr(
                                        resolved.1,
                                        entity.alias,
                                        sample.source.alias
                                    )
                                )
                            )
                        },
                    };
                    let input = measure_row_expr(filtered.0, payload, measure, sample.source);
                    let threshold = qb::bind(input.0, to_val(spec.threshold));
                    let having = qb::having_call_filtered_bound(
                        graph_aggregate_op(spec.op),
                        measure.aggregate,
                        input.1,
                        False,
                        filtered.1,
                        threshold.1
                    );
                    (threshold.0, array::push(state.1, having))
                }
            }
        }
    )
};

# A joined node may filter a sample aggregate only when each sample determines
# at most one row of that node along the declared relation directions.
def graph_aggregate_sample_grain: Fn(PreparedPayload, GraphExist, String) -> Option(GraphEdge) = fn(
    payload,
    spec,
    sample
) {
    let checked = array::fold(
        spec.nodes,
        ([sample], None).ty!((Array(String), Option(GraphEdge))),
        fn(state, node) {
            array::fold(
                spec.edges,
                state,
                fn(next, edge) {
                    let from_known = array::any(
                        next.0,
                        fn(id) {
                            id == edge.from
                        }
                    );
                    let to_known = array::any(
                        next.0,
                        fn(id) {
                            id == edge.to
                        }
                    );
                    if from_known == to_known {
                        next
                    } else {
                        let safe = match array::find(
                            payload.business_links,
                            fn(link) {
                                link.id == edge.relation
                            }
                        ) {
                            Some(_) => False,
                            None => relation_preserves_grain(
                                request_relation(payload, edge.relation),
                                from_known
                            ),
                        };
                        (
                            array::push(
                                next.0,
                                if from_known {
                                    edge.to
                                } else {
                                    edge.from
                                }
                            ),
                            if safe {
                                next.1
                            } else {
                                match next.1 {
                                    Some(_) => next.1,
                                    None => Some(edge)
                                }
                            }
                        )
                    }
                }
            )
        }
    );
    if array::length(checked.0) != array::length(spec.nodes) + 1 {
        fail!("graph aggregate sample is not connected to its owner", sample)
    } else {
        checked.1
    }
};

def graph_existence: Fn(
    qb::BuildCtx,
    PreparedPayload,
    Array(GraphInstance),
    GraphExist
) -> (qb::BuildCtx, qb::Exists) = fn(ctx, payload, instances, spec) {
    let anchor = graph_instance(instances, spec.anchor);
    let count = array::length(spec.edges);
    if count == 0 || count != array::length(spec.nodes) {
        fail!("graph existence needs one declared node per edge", spec.anchor)
    } else if array::any(
        spec.nodes,
        fn(node) {
            node.id == "" || array::any(
                instances,
                fn(existing) {
                    existing.id == node.id
                }
            ) || seq::count(
                seq::filter(
                    seq::from_array(spec.nodes),
                    fn(other) {
                        other.id == node.id
                    }
                )
            ) != 1
        }
    ) {
        fail!("graph existence node ids must be distinct from outer graph instances")
    } else {
        let spec: GraphExist = {
            ...spec,
            edges: graph_ordered_edges(payload, spec.anchor, spec.edges)
        };
        match array::find(
            payload.business_links,
            fn(link) {
                spec.edges[0].relation == link.id
            }
        ) {
            Some(link) => graph_link_existence(ctx, payload, instances, anchor, spec, link),
            None => do {
                let initial: (
                    qb::BuildCtx,
                    Array(GraphInstance),
                    Array(Array(qb::ColumnEq)),
                    Array(qb::Join),
                    Array(qb::Expr)
                ) = (ctx, [anchor], [], [], []);
                let built = array::fold(
                    spec.edges,
                    initial,
                    fn(state, edge) {
                        let forward = array::any(
                            state.1,
                            fn(item) {
                                item.id == edge.from
                            }
                        );
                        let backward = array::any(
                            state.1,
                            fn(item) {
                                item.id == edge.to
                            }
                        );
                        let next_id = if forward {
                            edge.to
                        } else {
                            edge.from
                        };
                        let previous_id = if forward {
                            edge.from
                        } else {
                            edge.to
                        };
                        if forward == backward {
                            fail!(
                                "graph existence edge must introduce one node connected to the root",
                                edge.relation
                            )
                        } else {
                            let previous = graph_instance(state.1, previous_id);
                            let next_node = match array::find(
                                spec.nodes,
                                fn(node) {
                                    node.id == next_id
                                }
                            ) {
                                Some(node) => node,
                                None => fail!(
                                    "graph existence edge references an unknown inner node",
                                    edge.relation,
                                    next_id
                                ),
                            };
                            let next_entity = entity_by_id(payload, next_node.entity);
                            match array::find(
                                payload.business_links,
                                fn(link) {
                                    link.id == edge.relation
                                }
                            ) {
                                Some(link) => do {
                                    if previous.entity != link.participant || next_entity != link.participant {
                                        fail!(
                                            "graph business link endpoints must both be its declared participant",
                                            edge.relation
                                        )
                                    } else if !forward && link.direction == LinkDirection::Directed {
                                        fail!(
                                            "directed business link cannot be traversed from Z to A",
                                            edge.relation
                                        )
                                    } else {
                                        let joined = graph_link_joins(
                                            state.0,
                                            payload,
                                            link,
                                            previous.source,
                                            next_id
                                        );
                                        let instance: GraphInstance = {
                                            id: next_id,
                                            entity: next_entity,
                                            source: joined.1
                                        };
                                        (
                                            joined.0,
                                            array::push(state.1, instance),
                                            state.2,
                                            array::concat([state.3, joined.2]),
                                            state.4
                                        )
                                    }
                                },
                                None => do {
                                    let relation = request_relation(payload, edge.relation);
                                    let valid = if forward {
                                        relation.from == previous.entity && relation.to == next_entity
                                    } else {
                                        relation.to == previous.entity && relation.from == next_entity
                                    };
                                    if !valid {
                                        let expected_from = payload.entities[relation.from].id;
                                        let expected_to = payload.entities[relation.to].id;
                                        let actual_from = if forward {
                                            payload.entities[previous.entity].id
                                        } else {
                                            next_node.entity
                                        };
                                        let actual_to = if forward {
                                            next_node.entity
                                        } else {
                                            payload.entities[previous.entity].id
                                        };
                                        fail!(
                                            `graph existence edge role or target does not match declared relation: \{edge.relation} expects from \{expected_from} to \{expected_to}, but \{edge.from} is \{actual_from} and \{edge.to} is \{actual_to}; correct the node entity or choose a relation declared for these roles`,
                                            edge
                                        )
                                    } else {
                                        let source = entity_source_at_with_context(
                                            state.0,
                                            payload,
                                            payload.entities[next_entity],
                                            next_id
                                        );
                                        let first_edge = array::length(state.2) == 0;
                                        let alternatives = if first_edge {
                                            graph_correlation_alternatives(
                                                payload,
                                                relation,
                                                previous.source,
                                                source.1,
                                                forward,
                                                relation.key
                                            )
                                        } else {
                                            state.2
                                        };
                                        let instance: GraphInstance = {
                                            id: next_id,
                                            entity: next_entity,
                                            source: source.1
                                        };
                                        let from_source = if forward {
                                            previous.source
                                        } else {
                                            source.1
                                        };
                                        let to_source = if forward {
                                            source.1
                                        } else {
                                            previous.source
                                        };
                                        let guarded = if first_edge {
                                            let guard = bind_relation_guard(
                                                source.0,
                                                payload,
                                                relation,
                                                from_source
                                            );
                                            (
                                                guard.0,
                                                [],
                                                match guard.1 {
                                                    Some(expr) => [expr],
                                                    None => []
                                                }
                                            )
                                        } else {
                                            let joined = graph_guarded_join(
                                                source.0,
                                                payload,
                                                relation,
                                                from_source,
                                                to_source
                                            );
                                            (
                                                joined.0,
                                                [
                                                    qb::join_on(
                                                        qb::JoinKind::Inner,
                                                        source.1,
                                                        joined.1
                                                    )
                                                ],
                                                []
                                            )
                                        };
                                        (
                                            guarded.0,
                                            array::push(state.1, instance),
                                            alternatives,
                                            array::concat([state.3, guarded.1]),
                                            array::concat([state.4, guarded.2])
                                        )
                                    }
                                },
                            }
                        }
                    }
                );
                let first_instance = built.1[1];
                let first = first_instance.source;
                let sample = if array::length(spec.having) == 0 {
                    first_instance
                } else {
                    graph_instance(built.1, spec.having[0].node)
                };
                let grouped = if array::length(spec.having) == 0 {
                    (built.0, [])
                } else {
                    let edge = spec.edges[0];
                    if sample.id == anchor.id {
                        fail!(
                            "graph aggregate measure must belong to an introduced sample node",
                            sample.id
                        )
                    } else if let Some(unsafe_edge) = graph_aggregate_sample_grain(
                        payload,
                        spec,
                        sample.id
                    ) {
                        fail!(
                            "graph aggregate sample may be multiplied by a relation",
                            sample.id,
                            unsafe_edge
                        )
                    } else if sample.id != first_instance.id {
                        let entity = payload.entities[first_instance.entity];
                        (
                            built.0,
                            array::map(
                                graph_identity_columns(entity, first_instance.id),
                                fn(column) {
                                    prepared_column(first_instance.source, column)
                                }
                            )
                        )
                    } else if array::length(built.2) != 1 {
                        # All OR matches belong to the current outer owner. A constant
                        # group combines them without inventing groups per reference;
                        # an empty match set still produces no group for EXISTS.
                        let group = qb::bind(built.0, qb::Val::Int(1));
                        (group.0, [group.1])
                    } else {
                        (
                            built.0,
                            array::map(
                                built.2[0],
                                fn(pair) {
                                    qb::Expr::Column(pair.right)
                                }
                            )
                        )
                    }
                };
                let filtered = graph_filters(grouped.0, payload, built.1, spec.filters);
                let alternatives = graph_any_of(filtered.0, payload, built.1, spec.any_of);
                let aggregate = graph_aggregate_having(alternatives.0, payload, sample, spec.having);
                let exists = if array::length(built.2) == 1 {
                    qb::exists_path(first, built.2[0], built.3)
                } else {
                    qb::exists_path_alternatives(first, built.2, built.3)
                };
                let constraints = graph_constraints(
                    aggregate.0,
                    payload,
                    array::concat([instances, built.1]),
                    spec.constraints
                );
                let constrained = append_filter_terms(
                    filtered.1,
                    array::concat([built.4, alternatives.1, constraints.1])
                );
                let exists = {
                    ...exists,
                    filter: constrained,
                    grouping: grouped.1,
                    having: aggregate.1
                };
                (
                    constraints.0,
                    if spec.negated {
                        qb::exists_not(exists)
                    } else {
                        exists
                    }
                )
            },
        }
    }
};

# Counting a subject is safe only if every joined instance is functionally
# determined by it. Walk the declared tree from the independently of
# the root-first order used to construct the SQL joins.
def graph_unsafe_edges: Fn(
    PreparedPayload,
    GraphRequest,
    String
) -> (Array(String), Array(GraphEdge)) = fn(payload, request, subject_id) {
    let initial: (Array(String), Array(GraphEdge)) = ([subject_id], []);
    let proved = array::fold(
        request.nodes,
        initial,
        fn(state, node) {
            array::fold(
                request.edges,
                state,
                fn(step, edge) {
                    let from_known = array::any(
                        step.0,
                        fn(id) {
                            id == edge.from
                        }
                    );
                    let to_known = array::any(
                        step.0,
                        fn(id) {
                            id == edge.to
                        }
                    );
                    if from_known == to_known {
                        step
                    } else {
                        let safe = match array::find(
                            payload.business_links,
                            fn(link) {
                                link.id == edge.relation
                            }
                        ) {
                            Some(_) => False,
                            None => do {
                                let relation = request_relation(payload, edge.relation);
                                relation_preserves_grain(relation, from_known)
                            },
                        };
                        (
                            array::push(
                                step.0,
                                if from_known {
                                    edge.to
                                } else {
                                    edge.from
                                }
                            ),
                            if safe {
                                step.1
                            } else {
                                array::push(step.1, edge)
                            }
                        )
                    }
                }
            )
        }
    );
    proved
};

def graph_count_subject_grain: Fn(
    PreparedPayload,
    GraphRequest,
    String
) -> (Bool, Option(GraphEdge)) = fn(payload, request, subject_id) {
    let proved = graph_unsafe_edges(payload, request, subject_id);
    (
        array::length(proved.1) == 0 && array::length(proved.0) == array::length(request.nodes),
        array::get(proved.1, 0)
    )
};

def graph_multiplying_projection: Fn(GraphRequest, GraphEdge) -> Bool = fn(request, edge) {
    let from_depth = array::length(graph_count_ancestors(request, edge.from));
    let to_depth = array::length(graph_count_ancestors(request, edge.to));
    let multiplying_node = if from_depth > to_depth {
        edge.from
    } else {
        edge.to
    };
    array::any(
        request.select,
        fn(item) {
            item.node == multiplying_node
        }
    )
};

def graph_raw_row_fanout: Fn(PreparedPayload, GraphRequest) -> Bool = fn(payload, request) {
    request.count == None && request.count_value == None && array::length(request.measures) == 0 && request.top_per == None && request.top_by_measure == None && !graph_count_subject_grain(
        payload,
        request,
        request.root
    ).0
};

def graph_grouped_child_chain_count: Fn(PreparedPayload, GraphRequest, String) -> Bool = fn(
    payload,
    request,
    subject_id
) {
    if subject_id == request.root || array::length(request.edges) != array::length(request.nodes) - 1 || request.group_by_identity != [
        request.root
    ] || !array::all(
        request.select,
        fn(item) {
            item.node == request.root
        }
    ) {
        False
    } else {
        let path = graph_count_ancestors(request, subject_id);
        array::length(path) == array::length(request.nodes) && array::all(
            array::filter(
                array::enumerate(path),
                fn(entry) {
                    entry.0 > 0
                }
            ),
            fn(entry) {
                let child = graph_node(request, entry.1);
                let parent = graph_node(request, path[entry.0 - 1]);
                match array::find(
                    request.edges,
                    fn(edge) {
                        edge.from == child.id && edge.to == parent.id
                    }
                ) {
                    None => False,
                    Some(edge) => if array::any(
                        payload.business_links,
                        fn(link) {
                            link.id == edge.relation
                        }
                    ) {
                        False
                    } else {
                        let relation = request_relation(payload, edge.relation);
                        let target = payload.entities[entity_by_id(payload, parent.entity)];
                        let branches = match relation.key {
                            RelationKey::Or(parts) => parts,
                            key => [key],
                        };
                        relation.from == entity_by_id(payload, child.entity) && relation.to == target.index && array::length(
                            branches
                        ) > 0 && array::all(
                            branches,
                            fn(part) {
                                conjunctive_identity_key(part) && safe_relation_covers_target_identity(
                                    target,
                                    exists_pairs(part)
                                )
                            }
                        )
                    },
                }
            }
        )
    }
};

def graph_grouped_chain_missing_target_key: Fn(
    PreparedPayload,
    GraphRequest,
    String
) -> Option((String, Int, String)) = fn(payload, request, subject_id) {
    if subject_id == request.root || array::length(request.edges) != array::length(request.nodes) - 1 || request.group_by_identity != [
        request.root
    ] || !array::all(
        request.select,
        fn(item) {
            item.node == request.root
        }
    ) {
        None
    } else {
        let path = graph_count_ancestors(request, subject_id);
        if array::length(path) != array::length(request.nodes) {
            None
        } else {
            let missing = array::flat_map(
                array::filter(
                    array::enumerate(path),
                    fn(entry) {
                        entry.0 > 0
                    }
                ),
                fn(step) {
                    let child = graph_node(request, step.1);
                    let parent = graph_node(request, path[step.0 - 1]);
                    match array::find(
                        request.edges,
                        fn(edge) {
                            edge.from == child.id && edge.to == parent.id
                        }
                    ) {
                        None => [],
                        Some(edge) => if array::any(
                            payload.business_links,
                            fn(link) {
                                link.id == edge.relation
                            }
                        ) {
                            []
                        } else {
                            let relation = request_relation(payload, edge.relation);
                            let target = payload.entities[entity_by_id(payload, parent.entity)];
                            let branches = match relation.key {
                                RelationKey::Or(parts) => parts,
                                key => [key],
                            };
                            if relation.from != entity_by_id(payload, child.entity) || relation.to != target.index {
                                []
                            } else {
                                array::flat_map(
                                    array::enumerate(branches),
                                    fn(entry) {
                                        let part = entry.1;
                                        if !conjunctive_identity_key(part) {
                                            []
                                        } else {
                                            let pairs = exists_pairs(part);
                                            pipeline::run(
                                                pipeline::from_array(target.grain_fields) |> pipeline::filter(
                                                    fn(index) {
                                                        !array::any(
                                                            pairs,
                                                            fn(pair) {
                                                                pair.to == index
                                                            }
                                                        )
                                                    }
                                                ) |> pipeline::map(
                                                    fn(index) {
                                                        (
                                                            edge.relation,
                                                            entry.0 + 1,
                                                            target.fields[index].name
                                                        )
                                                    }
                                                ) |> pipeline::collect()
                                            )
                                        }
                                    }
                                )
                            }
                        },
                    }
                }
            );
            array::get(missing, 0)
        }
    }
};

# The join tree is rooted by construction. Only an ancestor of the counted
# instance can narrow its LEFT JOIN lineage without filtering an unrelated branch.
def graph_count_ancestors: Fn(GraphRequest, String) -> Array(String) = fn(request, subject_id) {
    let root_path: (String, Array(String)) = (request.root, [request.root]);
    let paths = array::fold(
        request.edges,
        [root_path],
        fn(known, edge) {
            let from = array::find(
                known,
                fn(path) {
                    path.0 == edge.from
                }
            );
            let to = array::find(
                known,
                fn(path) {
                    path.0 == edge.to
                }
            );
            match (from, to) {
                (Some(parent), None) => array::push(
                    known,
                    (edge.to, array::push(parent.1, edge.to))
                ),
                (None, Some(parent)) => array::push(
                    known,
                    (edge.from, array::push(parent.1, edge.from))
                ),
                _ => known,
            }
        }
    );
    match array::find(
        paths,
        fn(path) {
            path.0 == subject_id
        }
    ) {
        Some(path) => path.1,
        None => [],
    }
};

def graph_identity_columns: Fn(EntityEntry, String) -> Array(String) = fn(entity, node_id) {
    if entity.grain_fields == [] {
        fail!("graph identity requires a declared dataset grain", node_id)
    } else {
        array::map(
            entity.grain_fields,
            fn(index) {
                entity.fields[index].column
            }
        )
    }
};

def graph_count_identity_column: Fn(EntityEntry, String) -> String = fn(entity, subject_id) {
    graph_identity_columns(entity, subject_id)[0]
};

# Pair alignment expands model identities independently of visible grouping.
def graph_pair_identity: Fn(PreparedPayload, GraphRequest, qb::Plan) -> Array(qb::Expr) = fn(
    payload,
    request,
    plan
) {
    array::flat_map(
        request.group_by_identity,
        fn(id) {
            let node = graph_node(request, id);
            let entity = payload.entities[entity_by_id(payload, node.entity)];
            let source = match array::find(
                plan.sources,
                fn(source) {
                    source.alias == id
                }
            ) {
                Some(source) => source,
                None => fail!("graph pair identity source is missing", id),
            };
            array::map(
                graph_identity_columns(entity, id),
                fn(column) {
                    prepared_column(source, column)
                }
            )
        }
    )
};

# One owner-owned sample population may be repeated once per distinct context
# identity. An at-most-one owner-to-ancestor join preserves that population.
def graph_contextual_measure_grain: Fn(PreparedPayload, GraphRequest, String) -> Bool = fn(
    payload,
    request,
    sample_id
) {
    if sample_id == request.root || (
        array::length(request.nodes) != 3 && array::length(request.nodes) != 4
    ) || array::length(request.edges) != array::length(request.nodes) - 1 || request.count != None || request.include_empty {
        False
    } else {
        match array::find(
            request.edges,
            fn(edge) {
                edge.from == request.root && edge.to != sample_id
            }
        ) {
            None => False,
            Some(context_edge) => {
                let owner_id = context_edge.to;
                let sample_edge = array::find(
                    request.edges,
                    fn(edge) {
                        edge.from == sample_id && edge.to == owner_id
                    }
                );
                let ancestor_edges = array::filter(
                    request.edges,
                    fn(edge) {
                        edge != context_edge && !(edge.from == sample_id && edge.to == owner_id)
                    }
                );
                let ancestor_ok = if array::length(ancestor_edges) == 0 {
                    array::length(request.nodes) == 3
                } else if array::length(ancestor_edges) != 1 || array::length(request.nodes) != 4 {
                    False
                } else {
                    let edge = ancestor_edges[0];
                    if edge.from != owner_id || edge.to == request.root || edge.to == sample_id || edge.to == owner_id || array::any(
                        payload.business_links,
                        fn(link) {
                            link.id == edge.relation
                        }
                    ) {
                        False
                    } else {
                        let owner = graph_node(request, owner_id);
                        let ancestor = graph_node(request, edge.to);
                        let target = payload.entities[entity_by_id(payload, ancestor.entity)];
                        let relation = request_relation(payload, edge.relation);
                        relation.from == entity_by_id(payload, owner.entity) && relation.to == target.index && relation_preserves_grain(
                            relation,
                            True
                        )
                    }
                };
                if request.group_by_identity != [request.root, owner_id] || !ancestor_ok || !array::all(
                    request.select,
                    fn(item) {
                        item.node == request.root || item.node == owner_id || array::any(
                            ancestor_edges,
                            fn(edge) {
                                edge.to == item.node
                            }
                        )
                    }
                ) || array::any(
                    payload.business_links,
                    fn(link) {
                        link.id == context_edge.relation
                    }
                ) {
                    False
                } else {
                    match sample_edge {
                        None => False,
                        Some(edge) => if array::any(
                            payload.business_links,
                            fn(link) {
                                link.id == edge.relation
                            }
                        ) {
                            False
                        } else {
                            let context = graph_node(request, request.root);
                            let owner = graph_node(request, owner_id);
                            let sample = graph_node(request, sample_id);
                            let context_entity = payload.entities[
                                entity_by_id(payload, context.entity)
                            ];
                            let owner_entity = payload.entities[entity_by_id(payload, owner.entity)];
                            let sample_entity = payload.entities[
                                entity_by_id(payload, sample.entity)
                            ];
                            let context_relation = request_relation(payload, context_edge.relation);
                            let sample_relation = request_relation(payload, edge.relation);
                            array::length(graph_identity_columns(context_entity, request.root)) > 0 && array::length(
                                graph_identity_columns(owner_entity, owner_id)
                            ) > 0 && array::length(graph_identity_columns(sample_entity, sample_id)) > 0 && context_relation.from == context_entity.index && context_relation.to == owner_entity.index && sample_relation.from == sample_entity.index && sample_relation.to == owner_entity.index && relation_preserves_grain(
                                context_relation,
                                True
                            ) && relation_preserves_grain(sample_relation, True)
                        },
                    }
                }
            },
        }
    }
};

def graph_measure_alias: Fn(qb::SelectItem) -> String = fn(item) {
    match item {
        qb::SelectItem::Aggregate(call) => call.alias,
        qb::SelectItem::Computed(computed) => computed.alias,
        _ => fail!("graph measure cache contains a non-measure projection"),
    }
};

def graph_request_entity: Fn(PreparedPayload, GraphRequest, String) -> Int = fn(
    payload,
    request,
    node
) {
    let declared = match array::find(
        request.nodes,
        fn(item) {
            item.id == node
        }
    ) {
        Some(item) => item.entity,
        None => fail!("unknown graph node", node)
    };
    match array::find(
        payload.entities,
        fn(entity) {
            entity.id == declared
        }
    ) {
        Some(entity) => entity.index,
        None => fail!("unknown graph dataset", declared)
    }
};
def graph_zero_safe_measure: Fn(PreparedPayload, Int, String) -> Bool = fn(payload, entity, id) {
    match array::find(
        payload.measures,
        fn(entry) {
            entry.entity == entity && entry.id == id
        }
    ) {
        None => False,
        Some(measure) => match measure.computed {
            Some(spec) => graph_zero_safe_measure(payload, entity, spec.left) && graph_zero_safe_measure(
                payload,
                entity,
                spec.right
            ),
            None => measure.aggregate == qb::AggregateFunction::Count,
        },
    }
};

def graph_empty_measure_grain: Fn(PreparedPayload, GraphRequest) -> Bool = fn(payload, request) {
    request.count == None && request.group_by_identity == [request.root] && array::all(
        request.select,
        fn(item) {
            item.node == request.root
        }
    ) && array::length(request.measures) > 0 && array::all(
        request.measures,
        fn(item) {
            item.node != request.root && graph_zero_safe_measure(
                payload,
                graph_request_entity(payload, request, item.node),
                item.measure
            ) && graph_count_subject_grain(payload, request, item.node).0
        }
    )
};

def graph_measure_projection: Fn(
    qb::BuildCtx,
    PreparedPayload,
    GraphRequest,
    Array(GraphInstance),
    GraphMeasureSelect,
    Array(qb::SelectItem)
) -> (qb::BuildCtx, qb::SelectItem, Array(qb::SelectItem)) = fn(
    ctx,
    payload,
    request,
    instances,
    selection,
    cached
) {
    let instance = graph_instance(instances, selection.node);
    let measure = match array::find(
        payload.measures,
        fn(entry) {
            entry.entity == instance.entity && entry.id == selection.measure
        }
    ) {
        Some(entry) => entry,
        None => fail!(
            `graph projection on node \{selection.node} references an unknown declared measure \{selection.measure}`,
            selection.node,
            selection.measure
        ),
    };
    let alias = `\{selection.node}_\{selection.measure}`;
    if let Some(item) = array::find(
        cached,
        fn(item) {
            graph_measure_alias(item) == alias
        }
    ) {
        (ctx, item, cached)
    } else if let Some(computed) = measure.computed {
        let left = graph_measure_projection(
            ctx,
            payload,
            request,
            instances,
            {node: selection.node, measure: computed.left},
            cached
        );
        let right = graph_measure_projection(
            left.0,
            payload,
            request,
            instances,
            {node: selection.node, measure: computed.right},
            left.2
        );
        let item = qb::computed_item(
            computed.op,
            graph_measure_alias(left.1),
            graph_measure_alias(right.1),
            alias
        );
        (right.0, item, array::push(right.2, item))
    } else {
        let proof = graph_count_subject_grain(payload, request, selection.node);
        if !proof.0 && !graph_contextual_measure_grain(payload, request, selection.node) {
            let owner = array::find(
                request.edges,
                fn(edge) {
                    edge.from == request.root && edge.to != selection.node
                }
            );
            match owner {
                Some(edge) => if graph_contextual_measure_grain(
                    payload,
                    {...request, group_by_identity: [request.root, edge.to]},
                    selection.node
                ) {
                    fail!(
                        `graph contextual measure requires group_by_identity [\{request.root}, \{edge.to}] to keep context and owner identities separate; the measure remains owned by \{selection.node}`,
                        request.root,
                        edge.to,
                        selection.node,
                        selection.measure
                    )
                } else {
                    fail!(
                        `graph measure source may be multiplied by a joined relation; use correlated EXISTS for qualification`,
                        selection.node,
                        selection.measure,
                        proof.1
                    )
                },
                None => fail!(
                    `graph measure source may be multiplied by a joined relation; use correlated EXISTS for qualification`,
                    selection.node,
                    selection.measure,
                    proof.1
                ),
            }
        } else {
            let entity = payload.entities[instance.entity];
            let field = entity.fields[measure.field];
            let filtered = match measure.predicate {
                None => (ctx, None),
                Some(predicate) => do {
                    let resolved = resolve_measure_predicate_with_context(
                        ctx,
                        predicate,
                        entity.source
                    );
                    (
                        resolved.0,
                        Some(retarget_inner_expr(resolved.1, entity.alias, instance.source.alias))
                    )
                },
            };
            let input = measure_row_expr(filtered.0, payload, measure, instance.source);
            let call: qb::AggregateCall = {
                function: measure.aggregate,
                arg: input.1,
                distinct: False,
                filter: filtered.1,
                alias,
                latest: measure_latest_order(entity, measure, instance.source)
            };
            let item = qb::SelectItem::Aggregate(call);
            (input.0, item, array::push(cached, item))
        }
    }
};

def graph_top_per: Fn(
    qb::BuildCtx,
    PreparedPayload,
    GraphRequest,
    Array(GraphInstance),
    GraphTopPer
) -> (qb::BuildCtx, qb::PartitionedTopN) = fn(ctx, payload, request, instances, spec) {
    if request.count != None || request.include_empty || array::length(request.nodes) != 2 || array::length(
        request.edges
    ) != 1 || request.root != spec.owner || spec.owner == spec.sample {
        fail!(`graph top-per requires one sample joined directly to its root owner`, spec)
    } else if spec.take <= 0 || spec.take > qb::max_partition_take {
        fail!("graph top-per take must be positive and within the declared bound", spec.take)
    } else {
        let owner = graph_instance(instances, spec.owner);
        let sample = graph_instance(instances, spec.sample);
        let edge = request.edges[0];
        let relation = request_relation(payload, edge.relation);
        if edge.from != spec.sample || edge.to != spec.owner || relation.from != sample.entity || relation.to != owner.entity || !relation_preserves_grain(
            relation,
            True
        ) {
            fail!(
                `graph top-per requires a named at-most-one sample-to-owner relation`,
                edge.relation
            )
        } else {
            let sample_entity = payload.entities[sample.entity];
            let rank = match array::find(
                payload.dimensions,
                fn(entry) {
                    entry.entity == sample.entity && entry.id == spec.rank
                }
            ) {
                Some(dimension) => dimension,
                None => fail!(
                    `graph top-per rank \{spec.rank} must be a plain authorized sample dimension`,
                    spec.rank
                ),
            };
            if sample_entity.grain_fields == [] {
                fail!(
                    "graph top-per sample requires a nonempty declared sampling grain",
                    spec.sample
                )
            } else if rank.entity != sample.entity {
                fail!(
                    `graph top-per rank \{spec.rank} must be a plain authorized dimension on sample \{spec.sample}`,
                    spec.rank,
                    spec.sample
                )
            } else if rank.computed || !rank.authorized || !rank.projectable {
                fail!(
                    `graph top-per rank \{spec.rank} must be a plain authorized sample dimension`,
                    spec.rank
                )
            } else if array::any(
                rank.input_kinds,
                fn(kind) {
                    kind == FilterInputKind::Ipv4
                }
            ) || rank.output_type == OutputType::Boolean || (
                array::length(rank.canonical_values) > 0 && array::length(rank.canonical_order) == 0
            ) {
                fail!(
                    "graph top-per rank has no declared business ordering; choose an ordered dimension or declare canonical_order",
                    spec.rank
                )
            } else {
                let rank_field = sample_entity.fields[rank.field];
                let owner_entity = payload.entities[owner.entity];
                let partitions = array::map(
                    graph_identity_columns(owner_entity, spec.owner),
                    fn(column) {
                        prepared_column(owner.source, column)
                    }
                );
                let physical = prepared_column(sample.source, rank_field.column);
                let ranked = if array::length(rank.canonical_order) > 0 {
                    let unknown = qb::bind(ctx, qb::Val::None);
                    array::fold(
                        array::enumerate(rank.canonical_order),
                        (unknown.0, unknown.1),
                        fn(state, pair) {
                            let compared = canonical_compare_with_context(
                                state.0,
                                rank,
                                physical,
                                FilterOp::Eq,
                                FilterInput::Text(pair.1)
                            );
                            let ordinal = qb::bind(
                                compared.0,
                                qb::Val::Int(array::length(rank.canonical_order) - pair.0)
                            );
                            (ordinal.0, qb::scalar_if(compared.1, ordinal.1, state.1))
                        }
                    )
                } else {
                    (ctx, physical)
                };
                let ordering = array::concat(
                    [
                        [qb::order_by(qb::OrderKey::Expr(ranked.1), qb::Ordering::Desc)],
                        seq::collect(
                            seq::map(
                                seq::filter(
                                    seq::from_array(
                                        graph_identity_columns(sample_entity, spec.sample)
                                    ),
                                    fn(column) {
                                        column != rank_field.column
                                    }
                                ),
                                fn(column) {
                                    qb::order_by(
                                        qb::OrderKey::Expr(prepared_column(sample.source, column)),
                                        qb::Ordering::Asc
                                    )
                                }
                            )
                        ),
                    ]
                );
                let bound = qb::bind(ranked.0, qb::Val::Int(spec.take));
                (bound.0, qb::partitioned_top_n_bound(partitions, ordering, bound.1))
            }
        }
    }
};

def graph_top_by_measure: Fn(
    qb::BuildCtx,
    PreparedPayload,
    GraphRequest,
    Array(GraphInstance),
    Array(qb::Expr),
    GraphTopMeasure
) -> (qb::BuildCtx, Array(qb::OrderBy), qb::Expr) = fn(
    ctx,
    payload,
    request,
    instances,
    visible_grouping,
    spec
) {
    let identity_keys = array::fold(
        request.group_by_identity,
        [],
        fn(keys, id) {
            let instance = graph_instance(instances, id);
            let entity = payload.entities[instance.entity];
            array::concat(
                [
                    keys,
                    array::map(
                        graph_identity_columns(entity, id),
                        fn(column) {
                            prepared_column(instance.source, column)
                        }
                    )
                ]
            )
        }
    );
    # A dimension group is rankable only when appended identity keys cannot
    # refine its visible GROUP BY and joins preserve each measure source row.
    let unsplit_group = array::length(visible_grouping) > 0 && array::all(
        identity_keys,
        fn(key) {
            array::any(
                visible_grouping,
                fn(group) {
                    group == key
                }
            )
        }
    );
    let dimension_group = unsplit_group && graph_count_subject_grain(payload, request, spec.node).0;
    # Root dimensions are functionally determined by a complete root identity.
    let identity_group = request.group_by_identity == [request.root] && array::all(
        request.select,
        fn(item) {
            item.node == request.root
        }
    );
    let contextual_group = graph_contextual_measure_grain(payload, request, spec.node);
    if !array::any(
        request.measures,
        fn(item) {
            item.node == spec.node && item.measure == spec.measure
        }
    ) {
        fail!(
            `graph aggregate top must reference a projected measure: \{spec.node}.\{spec.measure}; add it to measures or select a projected measure`,
            spec.node,
            spec.measure
        )
    } else if !dimension_group && !identity_group && !contextual_group {
        fail!(
            `graph aggregate top requires a visible dimension group not split by hidden identity keys and a grain-safe measure source, or a proven identity/contextual measure group`,
            request.root,
            spec.node
        )
    } else if spec.take <= 0 || spec.take > qb::max_partition_take {
        fail!("graph aggregate top take must be positive and within the declared bound", spec.take)
    } else {
        let notice: Option(Int) = if !unsplit_group && array::length(visible_grouping) > 0 {
            warn!(
                "graph aggregate top ranks identity groups, not the projected dimension groups; hidden identity keys may split the visible groups. Remove group_by_identity to rank dimension values when the measure source is grain-safe"
            )
        } else {
            None
        };
        let alias = `\{spec.node}_\{spec.measure}`;
        let ranked = if spec.direction == qb::Ordering::Desc {
            qb::desc_aggregate(alias)
        } else {
            qb::asc_aggregate(alias)
        };
        let ordering = array::concat(
            [
                [ranked],
                array::map(
                    if dimension_group {
                        visible_grouping
                    } else {
                        identity_keys
                    },
                    qb::asc
                )
            ]
        );
        let limit = qb::take_bound(ctx, spec.take);
        (limit.0, ordering, limit.1)
    }
};

# An EXISTS anchored by a business link needs that link as its first path edge.
# Otherwise choose a stable child order independent of the submitted edge order.
def graph_edge_before: Fn(PreparedPayload, Array(String), GraphEdge, GraphEdge) -> Bool = fn(
    payload,
    known,
    left,
    right
) {
    let left_link = array::any(
        payload.business_links,
        fn(link) {
            link.id == left.relation
        }
    );
    let right_link = array::any(
        payload.business_links,
        fn(link) {
            link.id == right.relation
        }
    );
    let left_new = if array::any(
        known,
        fn(id) {
            id == left.from
        }
    ) {
        left.to
    } else {
        left.from
    };
    let right_new = if array::any(
        known,
        fn(id) {
            id == right.from
        }
    ) {
        right.to
    } else {
        right.from
    };
    if left_link != right_link {
        left_link
    } else if left_new != right_new {
        left_new < right_new
    } else if left.relation != right.relation {
        left.relation < right.relation
    } else if left.from != right.from {
        left.from < right.from
    } else {
        left.to < right.to
    }
};

def graph_ordered_edges: Fn(PreparedPayload, String, Array(GraphEdge)) -> Array(GraphEdge) = fn(
    payload,
    root,
    edges
) {
    let initial: (Array(String), Array(Int)) = ([root], []);
    let ordered = array::fold(
        edges,
        initial,
        fn(state, unused) {
            let next: Option((Int, GraphEdge)) = array::fold(
                array::enumerate(edges),
                None,
                fn(best, entry) {
                    let edge = entry.1;
                    let from_known = array::any(
                        state.0,
                        fn(id) {
                            id == edge.from
                        }
                    );
                    let to_known = array::any(
                        state.0,
                        fn(id) {
                            id == edge.to
                        }
                    );
                    if array::any(
                        state.1,
                        fn(index) {
                            index == entry.0
                        }
                    ) || from_known == to_known {
                        best
                    } else {
                        match best {
                            None => Some(entry),
                            Some(previous) => if graph_edge_before(
                                payload,
                                state.0,
                                edge,
                                previous.1
                            ) {
                                Some(entry)
                            } else {
                                best
                            },
                        }
                    }
                }
            );
            match next {
                None => state,
                Some(entry) => do {
                    let edge = entry.1;
                    let from_known = array::any(
                        state.0,
                        fn(id) {
                            id == edge.from
                        }
                    );
                    (
                        array::push(
                            state.0,
                            if from_known {
                                edge.to
                            } else {
                                edge.from
                            }
                        ),
                        array::push(state.1, entry.0)
                    )
                },
            }
        }
    );
    if array::length(ordered.1) != array::length(edges) {
        let unresolved = array::find(
            array::enumerate(edges),
            fn(entry) {
                !array::any(
                    ordered.1,
                    fn(index) {
                        index == entry.0
                    }
                )
            }
        );
        match unresolved {
            Some(entry) => do {
                let edge = entry.1;
                if array::any(
                    ordered.0,
                    fn(id) {
                        id == edge.from
                    }
                ) && array::any(
                    ordered.0,
                    fn(id) {
                        id == edge.to
                    }
                ) {
                    fail!(
                        "graph cycles and repeated instance edges are not supported",
                        edge.relation,
                        edge.to
                    )
                } else {
                    fail!(
                        "graph edge is not connected to the root; connect one endpoint through another declared edge",
                        root,
                        edge.relation,
                        edge.from,
                        edge.to
                    )
                }
            },
            None => fail!("graph edge ordering failed"),
        }
    } else {
        array::map(
            ordered.1,
            fn(index) {
                edges[index]
            }
        )
    }
};

# Each edge adds exactly one new instance. This makes a rooted graph explicit
# without choosing a shortest path or silently multiplying a join already used.
def lower_graph: Fn(qb::BuildCtx, PreparedPayload, GraphRequest) -> (qb::BuildCtx, qb::Plan) = fn(
    ctx,
    payload,
    request
) {
    let request: GraphRequest = {
        root: request.root,
        row_grain: request.row_grain,
        distinct: request.distinct,
        nodes: request.nodes,
        edges: graph_ordered_edges(payload, request.root, request.edges),
        constraints: request.constraints,
        select: request.select,
        measures: request.measures,
        filters: request.filters,
        any_of: request.any_of,
        exists: request.exists,
        count: request.count,
        count_value: request.count_value,
        count_having: request.count_having,
        measure_having: request.measure_having,
        count_groups: request.count_groups,
        include_empty: request.include_empty,
        group_by_identity: request.group_by_identity,
        top_per: request.top_per,
        top_by_measure: request.top_by_measure,
        order_by: request.order_by,
        take: request.take,
    };
    if array::length(request.nodes) == 0 || (
        array::length(request.select) == 0 && array::length(request.measures) == 0 && request.count == None && request.count_value == None
    ) {
        fail!("graph requires nodes and projections or an explicit count subject")
    } else if request.count_value != None && (
        request.count != None || array::length(request.select) > 0 || array::length(
            request.measures
        ) > 0 || array::length(request.group_by_identity) > 0 || request.count_having != None || array::length(
            request.measure_having
        ) > 0 || request.count_groups || request.distinct || request.include_empty || request.top_per != None || request.top_by_measure != None || array::length(
            request.order_by
        ) > 0 || request.take != None
    ) {
        fail!(
            "graph count_value counts one declared dimension across matching rows; remove other projections, counts, grouping, ordering and Top-N"
        )
    } else if array::any(
        request.nodes,
        fn(node) {
            node.id == "" || seq::count(
                seq::filter(
                    seq::from_array(request.nodes),
                    fn(other) {
                        other.id == node.id
                    }
                )
            ) != 1
        }
    ) {
        fail!("graph node instance ids must be nonempty and unique")
    } else if request.count == None && array::length(request.measures) == 0 && array::length(
        request.group_by_identity
    ) > 0 {
        fail!("graph identity grouping requires an aggregate projection")
    } else if request.distinct && (
        request.count != None || array::length(request.measures) > 0 || request.top_per != None || request.top_by_measure != None || request.include_empty
    ) {
        fail!(
            "graph distinct requires raw projected rows; remove count, measures, Top-N or include_empty"
        )
    } else if array::length(request.order_by) > 0 && (
        request.count != None || array::length(request.measures) > 0 || request.top_per != None || request.top_by_measure != None
    ) {
        fail!(
            `graph dimension order requires raw rows; use aggregate top or sample top for aggregated or partitioned results`
        )
    } else if request.take != None && (
        array::length(request.order_by) == 0 || request.distinct || request.count != None || array::length(
            request.measures
        ) > 0 || request.top_per != None || request.top_by_measure != None
    ) {
        fail!(
            `graph raw take requires ordered raw rows without DISTINCT, aggregates or partitioned Top-N`
        )
    } else if request.row_grain == GraphRowGrain::Association && (
        request.take != None || request.count != None || request.count_value != None || array::length(
            request.measures
        ) > 0 || request.top_per != None || request.top_by_measure != None || array::length(
            request.group_by_identity
        ) > 0
    ) {
        fail!(
            "graph association rows require raw projections without global root take, aggregates or partitioned Top-N"
        )
    } else if request.take != None && !graph_count_subject_grain(payload, request, request.root).0 {
        let unsafe_edge = graph_count_subject_grain(payload, request, request.root).1;
        let projected = match unsafe_edge {
            Some(edge) => graph_multiplying_projection(request, edge),
            None => False,
        };
        if projected {
            fail!(
                `graph raw take cannot preserve root row grain while projecting a multiplying relation; remove the related projection and use correlated EXISTS to qualify the root, or query explicit relationship rows without global root take`,
                request.root,
                unsafe_edge
            )
        } else {
            fail!(
                `graph raw take requires grain-safe joins from the root; move multiplying relations into correlated EXISTS before selecting global top rows`,
                request.root,
                unsafe_edge
            )
        }
    } else if request.count != None && array::length(request.measures) > 0 {
        fail!(
            "graph cannot combine row count with measure projection; choose one aggregation grain"
        )
    } else if request.count_having != None && (
        request.count == None || array::any(
            request.select,
            fn(item) {
                item.node != request.root
            }
        ) || !(
            request.group_by_identity == [request.root] || (
                request.count == Some(request.root) && array::length(request.group_by_identity) == 0 && array::length(
                    request.select
                ) > 0 && !request.include_empty
            )
        )
    ) {
        fail!(
            "graph count threshold requires root-only dimensions and either complete root identity or an explicit root-value group counting root rows",
            request.root
        )
    } else if let Some(spec) = array::find(
        request.measure_having,
        fn(spec) {
            !(
                request.group_by_identity == [request.root] && array::all(
                    request.select,
                    fn(item) {
                        item.node == request.root
                    }
                )
            ) && !graph_contextual_measure_grain(payload, request, spec.node)
        }
    ) {
        fail!(
            `graph measure threshold requires complete root identity with root-only dimensions, or proven context and owner identities for its named measure \{spec.node}.\{spec.measure}`,
            request.root,
            spec.node,
            spec.measure
        )
    } else if request.count_groups && (
        request.count_having == None && array::length(request.measure_having) == 0 || request.distinct || request.top_per != None || request.top_by_measure != None || array::length(
            request.order_by
        ) > 0
    ) {
        fail!(
            "graph count_groups requires a grouped aggregate threshold without DISTINCT, ordering or Top-N"
        )
    } else if request.include_empty && array::length(request.measures) > 0 && !graph_empty_measure_grain(
        payload,
        request
    ) {
        fail!(
            "graph include_empty measure requires zero-safe counts, complete root identity and grain-safe child joins"
        )
    } else if request.include_empty && array::length(request.constraints) > 0 {
        fail!(
            "graph include_empty cannot apply constraint edges in WHERE without changing empty populations"
        )
    } else if request.top_per != None && request.top_by_measure != None {
        fail!(`graph cannot combine raw-sample top_per with aggregate top_by_measure`)
    } else if request.top_per != None && array::length(request.measures) > 0 {
        fail!(`graph measure projection cannot rank raw rows with top_per`)
    } else if let Some(unknown) = array::find(
        request.group_by_identity,
        fn(id) {
            !array::any(
                request.nodes,
                fn(node) {
                    node.id == id
                }
            )
        }
    ) {
        fail!(`graph group identity references an unknown node \{unknown}`, unknown)
    } else if let Some(duplicate) = array::find(
        request.group_by_identity,
        fn(id) {
            seq::count(
                seq::filter(
                    seq::from_array(request.group_by_identity),
                    fn(other) {
                        other == id
                    }
                )
            ) > 1
        }
    ) {
        fail!(`graph group identity repeats node \{duplicate}`, duplicate)
    } else if request.top_per != None && array::length(request.group_by_identity) > 0 {
        fail!("graph top-per cannot combine with identity grouping")
    } else if let Some(unknown) = array::find(
        request.filters,
        fn(item) {
            !array::any(
                request.nodes,
                fn(node) {
                    node.id == item.node
                }
            )
        }
    ) {
        fail!(`graph filter references an unknown node \{unknown.node}`, unknown.node)
    } else if let Some(unknown) = array::find(
        request.any_of,
        fn(item) {
            !array::any(
                request.nodes,
                fn(node) {
                    node.id == item.node
                }
            )
        }
    ) {
        fail!(`graph any_of references an unknown node \{unknown.node}`, unknown.node)
    } else if request.include_empty && (
        (request.count == None && array::length(request.measures) == 0) || request.count == Some(
            request.root
        )
    ) {
        fail!("graph include_empty requires a non-root count subject")
    } else if request.include_empty && array::any(
        request.edges,
        fn(edge) {
            array::any(
                payload.business_links,
                fn(link) {
                    link.id == edge.relation
                }
            )
        }
    ) {
        let edge = match array::find(
            request.edges,
            fn(item) {
                array::any(
                    payload.business_links,
                    fn(link) {
                        link.id == item.relation
                    }
                )
            }
        ) {
            Some(item) => item,
            None => fail!("graph business link edge lookup failed after membership check"),
        };
        let subject_id = match request.count {
            Some(id) => id,
            None => request.root
        };
        fail!(
            `unsupported graph include_empty: business link \{edge.relation} between \{edge.from} and \{edge.to} needs outer-join counting semantics for \{subject_id}; do not replace it with EXISTS when zero-match groups or peer counts matter`,
            edge,
            subject_id
        )
    } else {
        let root_node = graph_node(request, request.root);
        let root_entity = entity_by_id(payload, root_node.entity);
        let root = entity_source_at_with_context(
            ctx,
            payload,
            payload.entities[root_entity],
            root_node.id
        );
        let initial: (qb::BuildCtx, Array(GraphInstance), Array(qb::Join)) = (
            root.0,
            [{id: root_node.id, entity: root_entity, source: root.1}],
            []
        );
        let built = array::fold(
            request.edges,
            initial,
            fn(state, edge) {
                let from_node = graph_node(request, edge.from);
                let to_node = graph_node(request, edge.to);
                if edge.from == edge.to {
                    fail!("graph edge must connect distinct instances", edge.relation)
                } else {
                    let from_entity = entity_by_id(payload, from_node.entity);
                    let to_entity = entity_by_id(payload, to_node.entity);
                    match array::find(
                        payload.business_links,
                        fn(link) {
                            link.id == edge.relation
                        }
                    ) {
                        Some(link) => do {
                            if from_entity != link.participant || to_entity != link.participant {
                                fail!(
                                    "graph business link endpoints must both be its declared participant",
                                    edge.relation
                                )
                            } else if array::any(
                                state.1,
                                fn(item) {
                                    item.id == edge.from
                                }
                            ) && !array::any(
                                state.1,
                                fn(item) {
                                    item.id == edge.to
                                }
                            ) {
                                let origin = graph_instance(state.1, edge.from);
                                let joined = graph_link_joins(
                                    state.0,
                                    payload,
                                    link,
                                    origin.source,
                                    edge.to
                                );
                                let instance: GraphInstance = {
                                    id: edge.to,
                                    entity: to_entity,
                                    source: joined.1
                                };
                                (
                                    joined.0,
                                    array::push(state.1, instance),
                                    array::concat([state.2, joined.2])
                                )
                            } else if link.direction == LinkDirection::Undirected && array::any(
                                state.1,
                                fn(item) {
                                    item.id == edge.to
                                }
                            ) && !array::any(
                                state.1,
                                fn(item) {
                                    item.id == edge.from
                                }
                            ) {
                                let origin = graph_instance(state.1, edge.to);
                                let joined = graph_link_joins(
                                    state.0,
                                    payload,
                                    link,
                                    origin.source,
                                    edge.from
                                );
                                let instance: GraphInstance = {
                                    id: edge.from,
                                    entity: from_entity,
                                    source: joined.1
                                };
                                (
                                    joined.0,
                                    array::push(state.1, instance),
                                    array::concat([state.2, joined.2])
                                )
                            } else if link.direction == LinkDirection::Directed && array::any(
                                state.1,
                                fn(item) {
                                    item.id == edge.to
                                }
                            ) {
                                fail!(
                                    "directed business link cannot be traversed from Z to A",
                                    edge.relation
                                )
                            } else {
                                fail!(
                                    "graph business link must introduce one connected participant",
                                    edge.relation
                                )
                            }
                        },
                        None => do {
                            let relation = request_relation(payload, edge.relation);
                            if relation.from != from_entity || relation.to != to_entity {
                                let expected_from = payload.entities[relation.from].id;
                                let expected_to = payload.entities[relation.to].id;
                                fail!(
                                    `graph edge role or target does not match declared relation: \{edge.relation} expects from \{expected_from} to \{expected_to}, but \{edge.from} is \{from_node.entity} and \{edge.to} is \{to_node.entity}; correct the node entity or choose a relation declared for these roles`,
                                    edge
                                )
                            } else if array::any(
                                state.1,
                                fn(item) {
                                    item.id == edge.from
                                }
                            ) && array::any(
                                state.1,
                                fn(item) {
                                    item.id == edge.to
                                }
                            ) {
                                fail!(
                                    "graph cycles and repeated instance edges are not supported",
                                    edge.relation,
                                    edge.to
                                )
                            } else {
                                let forward = array::any(
                                    state.1,
                                    fn(item) {
                                        item.id == edge.from
                                    }
                                );
                                let new_node = if forward {
                                    to_node
                                } else {
                                    from_node
                                };
                                let new_entity = if forward {
                                    to_entity
                                } else {
                                    from_entity
                                };
                                let cardinality = if forward {
                                    relation.cardinality.to
                                } else {
                                    relation.cardinality.from
                                };
                                let origin = graph_instance(
                                    state.1,
                                    if forward {
                                        edge.from
                                    } else {
                                        edge.to
                                    }
                                );
                                # Optional 是关系契约，不是 include_empty 或投影模式。
                                # 可缺失的上游经由单值关系继续读取时，也不能丢弃根行。
                                let nullable_origin = array::any(
                                    state.2,
                                    fn(join) {
                                        join.kind == qb::JoinKind::Left && join.source.alias == origin.source.alias
                                    }
                                );
                                let left_join = request.include_empty || cardinality == Cardinality::Optional || (
                                    nullable_origin && cardinality_at_most_one(cardinality)
                                );
                                let target = if request.include_empty {
                                    graph_nullable_source(
                                        state.0,
                                        payload,
                                        payload.entities[new_entity],
                                        new_node,
                                        request.filters,
                                        request.any_of
                                    )
                                } else {
                                    entity_source_at_with_context(
                                        state.0,
                                        payload,
                                        payload.entities[new_entity],
                                        new_node.id
                                    )
                                };
                                let from_source = if forward {
                                    graph_instance(state.1, edge.from).source
                                } else {
                                    target.1
                                };
                                let to_source = if forward {
                                    target.1
                                } else {
                                    graph_instance(state.1, edge.to).source
                                };
                                let condition = graph_guarded_join(
                                    target.0,
                                    payload,
                                    relation,
                                    from_source,
                                    to_source
                                );
                                let instance: GraphInstance = {
                                    id: new_node.id,
                                    entity: new_entity,
                                    source: target.1
                                };
                                let instances = array::push(state.1, instance);
                                let narrowed = if request.include_empty {
                                    array::fold(
                                        array::filter(
                                            request.exists,
                                            fn(spec) {
                                                spec.anchor == new_node.id
                                            }
                                        ),
                                        condition,
                                        fn(current, spec) {
                                            let result = graph_existence(
                                                current.0,
                                                payload,
                                                instances,
                                                spec
                                            );
                                            (
                                                result.0,
                                                qb::on_and([current.1, qb::on_exists(result.1)])
                                            )
                                        }
                                    )
                                } else {
                                    condition
                                };
                                let join = qb::join_on(
                                    if left_join {
                                        qb::JoinKind::Left
                                    } else {
                                        qb::JoinKind::Inner
                                    },
                                    target.1,
                                    narrowed.1
                                );
                                (narrowed.0, instances, array::push(state.2, join))
                            }
                        },
                    }
                }
            }
        );
        if array::length(built.1) != array::length(request.nodes) {
            fail!("graph contains nodes disconnected from the root")
        } else if let Some(unknown) = array::find(
            request.exists,
            fn(item) {
                !array::any(
                    request.nodes,
                    fn(node) {
                        node.id == item.anchor
                    }
                )
            }
        ) {
            fail!("graph existence anchor references an unknown node", unknown.anchor)
        } else if request.include_empty && array::any(
            request.exists,
            fn(item) {
                let counted = match request.count {
                    Some(id) => id,
                    None => request.root
                };
                !array::any(
                    graph_count_ancestors(request, counted),
                    fn(id) {
                        id == item.anchor
                    }
                )
            }
        ) {
            fail!("unsupported graph include_empty existence outside counted instance lineage")
        } else if graph_raw_row_fanout(payload, request) && !array::all(
            graph_unsafe_edges(payload, request, request.root).1,
            fn(edge) {
                graph_multiplying_projection(request, edge)
            }
        ) {
            fail!(
                `graph raw joins multiply root rows without projecting every related association; move unprojected relations into correlated EXISTS`,
                request.root,
                graph_unsafe_edges(payload, request, request.root).1
            )
        } else if graph_raw_row_fanout(payload, request) && request.row_grain != GraphRowGrain::Association {
            fail!(
                `graph raw projection crosses a multiplying relation; declare row_grain association for explicit relationship rows, or use correlated EXISTS to retain root row grain`,
                request.root,
                graph_count_subject_grain(payload, request, request.root).1
            )
        } else if request.row_grain == GraphRowGrain::Association && !graph_raw_row_fanout(
            payload,
            request
        ) {
            fail!(
                "graph association row grain requires a projected multiplying relation; otherwise use root row grain",
                request.root
            )
        } else {
            let selected = array::fold(
                request.select,
                (built.0, []),
                fn(state, item) {
                    let instance = graph_instance(built.1, item.node);
                    let dimension = match array::find(
                        payload.dimensions,
                        fn(d) {
                            d.entity == graph_instance(built.1, item.node).entity && d.id == item.dimension
                        }
                    ) {
                        Some(d) => d,
                        None => fail!(
                            `graph projection on node \{item.node} references an unknown dimension \{item.dimension}`,
                            item.node,
                            item.dimension
                        ),
                    };
                    if dimension.entity != instance.entity {
                        fail!(
                            `graph projection dimension \{item.dimension} does not belong to node \{item.node}`,
                            item.node,
                            item.dimension
                        )
                    } else if !dimension.authorized || !dimension.projectable {
                        fail!(
                            `graph projection dimension \{item.dimension} is not authorized on node \{item.node}`,
                            item.node,
                            item.dimension
                        )
                    } else {
                        # Expr has only columns, bindings and scalar calls: computed
                        # projection is row-local and cannot introduce join fanout.
                        let output = dimension_output_with_context(state.0, payload, dimension);
                        let original = payload.entities[instance.entity].alias;
                        let projection = array::push(
                            state.1,
                            qb::named_expr_item(
                                retarget_inner_expr(output.1, original, instance.source.alias),
                                `\{item.node}_\{item.dimension}`
                            )
                        );
                        if dimension.half_open {
                            let kind = dimension_kind_with_context(output.0, payload, dimension);
                            (
                                kind.0,
                                array::push(
                                    projection,
                                    qb::named_expr_item(
                                        retarget_inner_expr(kind.1, original, instance.source.alias),
                                        `\{item.node}_\{item.dimension}__kind`
                                    )
                                )
                            )
                        } else {
                            (output.0, projection)
                        }
                    }
                }
            );
            let row_projection = selected.1;
            let ordered = array::fold(
                request.order_by,
                (selected.0, []),
                fn(state, item) {
                    let position = array::find(
                        array::enumerate(request.select),
                        fn(entry) {
                            entry.1.node == item.node && entry.1.dimension == item.dimension
                        }
                    );
                    match position {
                        Some(entry) => do {
                            let dimension = match array::find(
                                payload.dimensions,
                                fn(d) {
                                    d.entity == graph_instance(built.1, item.node).entity && d.id == item.dimension
                                }
                            ) {
                                Some(d) => d,
                                None => fail!(
                                    `graph order on node \{item.node} references an unknown dimension \{item.dimension}`,
                                    item.node,
                                    item.dimension
                                ),
                            };
                            if (
                                array::length(dimension.canonical_values) > 0 && array::length(
                                    dimension.canonical_order
                                ) == 0
                            ) || array::any(
                                dimension.input_kinds,
                                fn(kind) {
                                    kind == FilterInputKind::Ipv4
                                }
                            ) || dimension.output_type == OutputType::Boolean {
                                fail!(
                                    "graph order dimension has no declared business ordering; use a plain ordered dimension or extend the Model with an explicit value order",
                                    item.node,
                                    item.dimension
                                )
                            } else {
                                match array::find(
                                    row_projection,
                                    fn(projected) {
                                        match projected {
                                            qb::SelectItem::NamedExpr(named) => named.alias == `\{item.node}_\{item.dimension}`,
                                            _ => False,
                                        }
                                    }
                                ) {
                                    Some(qb::SelectItem::NamedExpr(named)) => {
                                        let ranked = if array::length(dimension.canonical_order) > 0 {
                                            let instance = graph_instance(built.1, item.node);
                                            let field = payload.entities[instance.entity].fields[
                                                dimension.field
                                            ];
                                            let unknown = qb::bind(state.0, qb::Val::None);
                                            array::fold(
                                                array::enumerate(dimension.canonical_order),
                                                (unknown.0, unknown.1),
                                                fn(rank, pair) {
                                                    let compared = canonical_compare_with_context(
                                                        rank.0,
                                                        dimension,
                                                        prepared_column(
                                                            instance.source,
                                                            field.column
                                                        ),
                                                        FilterOp::Eq,
                                                        FilterInput::Text(pair.1)
                                                    );
                                                    let ordinal = qb::bind(
                                                        compared.0,
                                                        qb::Val::Int(pair.0)
                                                    );
                                                    (
                                                        ordinal.0,
                                                        qb::scalar_if(compared.1, ordinal.1, rank.1)
                                                    )
                                                }
                                            )
                                        } else {
                                            (state.0, named.expr)
                                        };
                                        (
                                            ranked.0,
                                            array::push(
                                                state.1,
                                                qb::order_by(
                                                    qb::OrderKey::Expr(ranked.1),
                                                    item.direction
                                                )
                                            )
                                        )
                                    },
                                    _ => fail!(
                                        "graph order requires a projected dimension",
                                        item.node,
                                        item.dimension
                                    ),
                                }
                            }
                        },
                        None => fail!(
                            `graph order requires projected dimension \{item.node}.\{item.dimension}; add it to select`,
                            item.node,
                            item.dimension
                        ),
                    }
                }
            );
            let raw_order = match request.take {
                None => ordered.1,
                Some(_) => array::fold(
                    built.1,
                    ordered.1,
                    fn(acc, instance) {
                        let entity = payload.entities[instance.entity];
                        array::fold(
                            graph_identity_columns(entity, instance.id),
                            acc,
                            fn(keys, column) {
                                let expr = prepared_column(instance.source, column);
                                if array::any(
                                    keys,
                                    fn(order) {
                                        order.key == qb::OrderKey::Expr(expr)
                                    }
                                ) {
                                    keys
                                } else {
                                    array::push(keys, qb::asc(expr))
                                }
                            }
                        )
                    }
                ),
            };
            let measures = array::fold(
                request.measures,
                (ordered.0, [], []),
                fn(state, item) {
                    let projected = graph_measure_projection(
                        state.0,
                        payload,
                        request,
                        built.1,
                        item,
                        state.2
                    );
                    (projected.0, array::push(state.1, projected.1), projected.2)
                }
            );
            let declared_internal_measures = array::filter(
                measures.2,
                fn(item) {
                    !array::any(
                        measures.1,
                        fn(visible) {
                            graph_measure_alias(visible) == graph_measure_alias(item)
                        }
                    )
                }
            );
            let value_count = match request.count_value {
                None => (measures.0, [], []),
                Some(item) => do {
                    let instance = graph_instance(built.1, item.node);
                    let dimension = match array::find(
                        payload.dimensions,
                        fn(d) {
                            d.entity == graph_instance(built.1, item.node).entity && d.id == item.dimension
                        }
                    ) {
                        Some(d) => d,
                        None => fail!(
                            `graph count_value on node \{item.node} references an unknown dimension \{item.dimension}`,
                            item.node,
                            item.dimension
                        ),
                    };
                    if dimension.entity != instance.entity {
                        fail!(
                            "graph count_value dimension does not belong to its named node",
                            item.node,
                            item.dimension
                        )
                    } else if !dimension.authorized || !dimension.projectable {
                        fail!(
                            "graph count_value dimension is not authorized",
                            item.node,
                            item.dimension
                        )
                    } else if dimension.half_open {
                        let physical = dimension_expr(measures.0, payload, dimension);
                        let known = canonical_known_with_context(physical.0, dimension, physical.1);
                        let output = dimension_output_with_context(known.0, payload, dimension);
                        let n = qb::bind(output.0, qb::Val::None);
                        let original = payload.entities[instance.entity].alias;
                        let kexpr = retarget_inner_expr(
                            qb::scalar_if(known.1, output.1, n.1),
                            original,
                            instance.source.alias
                        );
                        let uexpr = retarget_inner_expr(
                            qb::scalar_if(known.1, n.1, physical.1),
                            original,
                            instance.source.alias
                        );
                        let alias = `\{item.node}_\{item.dimension}_count`;
                        (
                            n.0,
                            [
                                qb::computed_item(
                                    qb::ComputedOp::Add,
                                    `\{alias}__known`,
                                    `\{alias}__unknown`,
                                    alias
                                )
                            ],
                            [
                                qb::aggregate(
                                    qb::AggregateFunction::Count,
                                    kexpr,
                                    True,
                                    `\{alias}__known`
                                ),
                                qb::aggregate(
                                    qb::AggregateFunction::Count,
                                    uexpr,
                                    True,
                                    `\{alias}__unknown`
                                )
                            ]
                        )
                    } else {
                        let output = dimension_output_with_context(measures.0, payload, dimension);
                        let original = payload.entities[instance.entity].alias;
                        let expr = retarget_inner_expr(output.1, original, instance.source.alias);
                        (
                            output.0,
                            [
                                qb::aggregate(
                                    qb::AggregateFunction::Count,
                                    expr,
                                    True,
                                    `\{item.node}_\{item.dimension}_count`
                                )
                            ],
                            []
                        )
                    }
                },
            };
            let internal_measures = array::concat([declared_internal_measures, value_count.2]);
            let projection = match request.count {
                None => array::concat([row_projection, measures.1, value_count.1]),
                Some(subject_id) => {
                    let grain = if subject_id == request.root {
                        (True, None)
                    } else {
                        graph_count_subject_grain(payload, request, subject_id)
                    };
                    let root_count_edge: Option(GraphEdge) = if subject_id == request.root {
                        array::get(graph_unsafe_edges(payload, request, request.root).1, 0)
                    } else {
                        None
                    };
                    if subject_id == request.root && root_count_edge != None {
                        match root_count_edge {
                            Some(edge) => fail!(
                                `graph count requires grain-safe forward joins: relation \{edge.relation} between \{edge.from} and \{edge.to} may multiply \{subject_id}; use correlated EXISTS if it only filters roots, or count the related instance to count its rows`,
                                subject_id,
                                edge.relation,
                                edge.from,
                                edge.to
                            ),
                            None => fail!(
                                "graph count requires grain-safe forward joins",
                                subject_id
                            ),
                        }
                    } else if subject_id != request.root && !grain.0 && !graph_grouped_child_chain_count(
                        payload,
                        request,
                        subject_id
                    ) {
                        match graph_grouped_chain_missing_target_key(payload, request, subject_id) {
                            Some(missing) => fail!(
                                `graph count relation \{missing.0} alternative \{missing.1} does not cover target identity field \{missing.2}; add the missing equality to this relation branch or use correlated EXISTS when the relation only filters roots`,
                                missing.0,
                                missing.1,
                                missing.2
                            ),
                            None => match grain.1 {
                                Some(edge) => fail!(
                                    `graph cannot prove the non-root count subject has one row per root relationship: relation \{edge.relation} between \{edge.from} and \{edge.to} may multiply \{subject_id}; if this edge only filters rows, use correlated EXISTS, otherwise choose a count subject whose grain stays unique`,
                                    subject_id,
                                    edge.relation,
                                    edge.from,
                                    edge.to
                                ),
                                None => fail!(
                                    "unsupported graph count: cannot establish a connected functional path from the count subject",
                                    subject_id
                                ),
                            },
                        }
                    } else {
                        let instance = graph_instance(built.1, subject_id);
                        let entity = payload.entities[instance.entity];
                        let column = graph_count_identity_column(entity, subject_id);
                        array::concat(
                            [
                                row_projection,
                                [
                                    qb::aggregate(
                                        qb::AggregateFunction::Count,
                                        prepared_column(instance.source, column),
                                        False,
                                        `\{subject_id}_count`
                                    )
                                ]
                            ]
                        )
                    }
                },
            };
            let visible_grouping = if request.count != None || array::length(request.measures) > 0 {
                array::map(
                    row_projection,
                    fn(item) {
                        match item {
                            qb::SelectItem::NamedExpr(named) => named.expr,
                            _ => fail!("graph grouping requires a plain dimension"),
                        }
                    }
                )
            } else {
                []
            };
            let grouping = array::fold(
                request.group_by_identity,
                visible_grouping,
                fn(grouped, id) {
                    let instance = graph_instance(built.1, id);
                    let entity = payload.entities[instance.entity];
                    array::fold(
                        graph_identity_columns(entity, id),
                        grouped,
                        fn(acc, column) {
                            let expr = prepared_column(instance.source, column);
                            if array::any(
                                acc,
                                fn(existing) {
                                    existing == expr
                                }
                            ) {
                                acc
                            } else {
                                array::push(acc, expr)
                            }
                        }
                    )
                }
            );
            let outer_filters = if request.include_empty {
                array::filter(
                    request.filters,
                    fn(item) {
                        item.node == request.root
                    }
                )
            } else {
                request.filters
            };
            let filtered = graph_filters(value_count.0, payload, built.1, outer_filters);
            let outer_exists = if request.include_empty {
                array::filter(
                    request.exists,
                    fn(spec) {
                        spec.anchor == request.root
                    }
                )
            } else {
                request.exists
            };
            let existential = array::fold(
                outer_exists,
                (filtered.0, []),
                fn(state, spec) {
                    let result = graph_existence(state.0, payload, built.1, spec);
                    (result.0, array::push(state.1, result.1))
                }
            );
            let sources = array::concat(
                [
                    [root.1],
                    array::map(
                        built.2,
                        fn(join) {
                            join.source
                        }
                    )
                ]
            );
            let partitioned = match request.top_per {
                Some(spec) => do {
                    let built_partition = graph_top_per(
                        existential.0,
                        payload,
                        request,
                        built.1,
                        spec
                    );
                    (built_partition.0, Some(built_partition.1))
                },
                None => (existential.0, None),
            };
            let alternatives = graph_any_of(
                partitioned.0,
                payload,
                built.1,
                if request.include_empty {
                    array::filter(
                        request.any_of,
                        fn(item) {
                            item.node == request.root
                        }
                    )
                } else {
                    request.any_of
                }
            );
            let top = match request.top_by_measure {
                Some(spec) => do {
                    let ranked = graph_top_by_measure(
                        alternatives.0,
                        payload,
                        request,
                        built.1,
                        visible_grouping,
                        spec
                    );
                    (ranked.0, ranked.1, Some(ranked.2))
                },
                None => (alternatives.0, [], None),
            };
            let raw_limit = match request.take {
                None => (top.0, top.2),
                Some(take) => do {
                    let bound = qb::take_bound(top.0, take);
                    (bound.0, Some(bound.1))
                },
            };
            let constraints = graph_constraints(raw_limit.0, payload, built.1, request.constraints);
            let recognized_groups = array::fold(
                request.select,
                (constraints.0, []),
                fn(state, item) {
                    let dimension = match array::find(
                        payload.dimensions,
                        fn(entry) {
                            entry.entity == graph_instance(built.1, item.node).entity && entry.id == item.dimension
                        }
                    ) {
                        Some(entry) => entry,
                        None => fail!(
                            "graph projection references an unknown dimension",
                            item.node,
                            item.dimension
                        ),
                    };
                    if array::length(dimension.canonical_values) > 0 && !dimension.half_open {
                        let known = graph_any_of(
                            state.0,
                            payload,
                            built.1,
                            [
                                {
                                    node: item.node,
                                    dimension: item.dimension,
                                    values: array::map(
                                        dimension.canonical_values,
                                        fn(value) {
                                            FilterInput::Text(value.id)
                                        }
                                    )
                                }
                            ]
                        );
                        (known.0, array::concat([state.1, known.1]))
                    } else if !dimension.half_open && request.count == Some(request.root) && array::length(
                        request.group_by_identity
                    ) == 0 {
                        let instance = graph_instance(built.1, item.node);
                        let field = payload.entities[instance.entity].fields[dimension.field];
                        (
                            state.0,
                            array::push(
                                state.1,
                                qb::is_not_null(prepared_column(instance.source, field.column))
                            )
                        )
                    } else {
                        state
                    }
                }
            );
            let recognized_rank = match request.top_per {
                Some(spec) => do {
                    let dimension = match array::find(
                        payload.dimensions,
                        fn(entry) {
                            entry.entity == graph_instance(built.1, spec.sample).entity && entry.id == spec.rank
                        }
                    ) {
                        Some(entry) => entry,
                        None => fail!(
                            `graph top-per rank references an unknown dimension \{spec.rank}`,
                            spec.rank
                        ),
                    };
                    if array::length(dimension.canonical_order) > 0 {
                        let known = graph_any_of(
                            recognized_groups.0,
                            payload,
                            built.1,
                            [
                                {
                                    node: spec.sample,
                                    dimension: spec.rank,
                                    values: array::map(
                                        dimension.canonical_values,
                                        fn(value) {
                                            FilterInput::Text(value.id)
                                        }
                                    )
                                }
                            ]
                        );
                        (known.0, known.1)
                    } else {
                        (recognized_groups.0, [])
                    }
                },
                None => (recognized_groups.0, []),
            };
            let constrained = append_filter_terms(
                filtered.1,
                array::concat(
                    [alternatives.1, constraints.1, recognized_groups.1, recognized_rank.1]
                )
            );
            let count_having = match request.count_having {
                None => (recognized_rank.0, []),
                Some(spec) => do {
                    let subject_id = match request.count {
                        Some(id) => id,
                        None => fail!("graph count threshold requires a count subject")
                    };
                    let bound = qb::bind(recognized_rank.0, qb::Val::Int(spec.threshold));
                    (
                        bound.0,
                        [
                            qb::having_bound(
                                graph_aggregate_op(spec.op),
                                `\{subject_id}_count`,
                                bound.1
                            )
                        ]
                    )
                },
            };
            let having = array::fold(
                request.measure_having,
                count_having,
                fn(state, spec) {
                    if !array::any(
                        request.measures,
                        fn(item) {
                            item.node == spec.node && item.measure == spec.measure
                        }
                    ) {
                        fail!(
                            `graph measure threshold must reference projected measure \{spec.node}.\{spec.measure}; add it to measures`,
                            spec.node,
                            spec.measure
                        )
                    } else {
                        let owner = graph_instance(built.1, spec.node).entity;
                        let output = match array::find(
                            payload.measures,
                            fn(entry) {
                                entry.entity == owner && entry.id == spec.measure
                            }
                        ) {
                            Some(measure) => measure.output_type,
                            None => fail!(
                                "graph measure threshold references an unknown measure",
                                spec.node,
                                spec.measure
                            )
                        };
                        if !graph_having_input_ok(output, spec.threshold) {
                            fail!(
                                "graph measure threshold does not match measure output type",
                                spec.node,
                                spec.measure,
                                output,
                                spec.threshold
                            )
                        } else {
                            let bound = qb::bind(state.0, to_val(spec.threshold));
                            (
                                bound.0,
                                array::push(
                                    state.1,
                                    qb::having_bound(
                                        graph_aggregate_op(spec.op),
                                        `\{spec.node}_\{spec.measure}`,
                                        bound.1
                                    )
                                )
                            )
                        }
                    }
                }
            );
            let plan: qb::Plan = {
                revision: payload.revision,
                sources,
                derived: None,
                projection,
                internal_measures,
                filter: constrained,
                exists: existential.1,
                joins: built.2,
                grouping,
                having: having.1,
                ordering: array::concat([top.1, raw_order]),
                limit: raw_limit.1,
                offset: None,
                partition: partitioned.1,
                scalar_comparisons: [],
                ranked_key_comparisons: [],
            };
            (having.0, qb::validate(plan, payload.profile))
        }
    }
};

