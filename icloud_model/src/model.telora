    {id: "warning", label: "Warning", wires: [edsl::FilterInput::Int(1)]},
    {id: "minor", label: "Minor", wires: [edsl::FilterInput::Int(2)]},
    {id: "major", label: "Major", wires: [edsl::FilterInput::Int(3)]},
