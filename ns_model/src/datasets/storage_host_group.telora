use crate::datasets::enterprise_host_group_2_kpi;
@domain::subject("StorageHostGroup", "id")
@domain::dataset("storage-host-group", "SYS_StorageHostGroup", ["id"])
@domain::relations(relations)
pub type StorageHostGroup = struct {
    @g::field_view(g::dimension_group("storage-host-group/id", ids::StorageHostGroupById.type, True, [g::Filter::Eq]), "shg_id", True, [g::Filter::Eq])
    @domain::count("shg_count")
    id: ids::StorageHostGroupById,
    @g::field_view(g::dimension_group("storage-host-group/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "shg_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("storage-host-group/obj_sys_id", domain::Reference(ids::EnterpriseHostGroup2KpiByObjSysId).type, True, [g::Filter::Eq]), "shg_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::EnterpriseHostGroup2KpiByObjSysId)),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("storage-host-group/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "shg_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("hostGroupId")
    @g::field_view(g::dimension_group("storage-host-group/host_group_id", String.type, True, [g::Filter::Eq]), "shg_host_group_id", True, [g::Filter::Eq])
    host_group_id: Option(String),
};

pub def relations: Array(r::Relation) = [
    r::relation("ehg2__shg_rev", domain::endpoint(StorageHostGroup.type, "obj_sys_id"), domain::endpoint(enterprise_host_group_2_kpi::EnterpriseHostGroup2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
