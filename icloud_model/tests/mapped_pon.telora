use crate::typed::{payload};
use ontology::intent as intent;
use ontology::sqlite as sqlite;
use std::json as json;
use std::codec as codec;
use std::value::{Value};

# 使用真实 IC property 定义；运行期小型样本检验角色范围与 OLT 聚合粒度。
pub def runtime_cases: Value = codec::encode(
    [
        sqlite::build_query(
            intent::query_intent_ast_factory(payload)(
                json::parse(
                    r#"{
        "op":"Graph","root":"a","nodes":[{"id":"a","entity":"pon_olt_role"}],"edges":[],
        "select":[{"node":"a","dimension":"pon_olt_id"}],
        "order_by":[{"column":"a_pon_olt_id","direction":"Asc"}],"take":10
    }"#
                ).unwrap!()
            )
        ),
        sqlite::build_query(
            intent::query_intent_ast_factory(payload)(
                json::parse(
                    r#"{
        "op":"Graph","root":"a","nodes":[{"id":"a","entity":"pon_onu_role"}],"edges":[],
        "select":[{"node":"a","dimension":"pon_onu_id"}],
        "order_by":[{"column":"a_pon_onu_id","direction":"Asc"}],"take":10
    }"#
                ).unwrap!()
            )
        ),
        sqlite::build_query(
            intent::query_intent_ast_factory(payload)(
                json::parse(
                    r#"{
        "op":"Graph","root":"a","nodes":[{"id":"a","entity":"onu_kpi"},{"id":"b","entity":"pon_onu_role"},{"id":"c","entity":"pon_olt_role"}],
        "edges":[{"relation":"onu_kpi_of_onu_role","from":"a","to":"b"},{"relation":"pon_onu_parent_olt","from":"b","to":"c"}],
        "select":[{"node":"c","dimension":"pon_olt_id"},{"node":"c","dimension":"pon_olt_name"}],
        "measures":[{"node":"a","measure":"onu_rx_power"},{"node":"a","measure":"onu_rx_power_min"}],
        "filters":[{"node":"a","dimension":"onu_kpi_ts","op":"Ge","value":"2026-11-09T00:00:00.000Z"},{"node":"a","dimension":"onu_kpi_ts","op":"Lt","value":"2026-11-12T00:00:00.000Z"}],
        "order_by":[{"column":"a_onu_rx_power","direction":"Asc"},{"column":"c_pon_olt_id","direction":"Asc"}],"take":10
    }"#
                ).unwrap!()
            )
        )
    ]
);
