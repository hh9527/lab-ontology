@domain::subject("StorageLunGroup", "id")
@domain::dataset("storage-lun-group", "SYS_StorageLunGroup", ["id"])
@domain::relations(relations)
pub type StorageLunGroup = struct {
    @g::field_view(g::dimension_group("storage-lun-group/id", ids::StorageLunGroupById.type, True, [g::Filter::Eq]), "slg_id", True, [g::Filter::Eq])
    @domain::count("slg_count")
    id: ids::StorageLunGroupById,
    @g::field_view(g::dimension_group("storage-lun-group/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "slg_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("storage-lun-group/obj_sys_id", domain::Reference(ids::EnterpriseLunGroup2KpiByObjSysId).type, True, [g::Filter::Eq]), "slg_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::EnterpriseLunGroup2KpiByObjSysId)),
    @m::column("parentResId")
    @g::field_view(g::dimension_group("storage-lun-group/parent_res_id", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "slg_parent_res_id", True, [g::Filter::Eq])
    parent_res_id: Option(domain::Reference(ids::NetworkElementById)),
    @g::field_view(g::dimension_group("storage-lun-group/capacity", String.type, True, [g::Filter::Eq]), "slg_capacity", True, [g::Filter::Eq])
    capacity: Option(String),
    @m::column("lunGroupId")
    @g::field_view(g::dimension_group("storage-lun-group/lun_group_id", String.type, True, [g::Filter::Eq]), "slg_lun_group_id", True, [g::Filter::Eq])
    lun_group_id: Option(String),
};

pub def relations: Array(r::Relation) = [
    r::relation("elg2__slg_rev", domain::endpoint(StorageLunGroup.type, "obj_sys_id"), domain::endpoint(enterprise_lun_group_2_kpi::EnterpriseLunGroup2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
