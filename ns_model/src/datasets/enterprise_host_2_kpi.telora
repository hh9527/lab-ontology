use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::host;
use crate::datasets::kpi_storage_enterprise_host;
@domain::subject("Host", "obj_sys_id")
@domain::dataset("enterprise-host-2-kpi", "enterpriseHost2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseHost2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-host-2-kpi/obj_sys_id", ids::EnterpriseHost2KpiByObjSysId.type, True, [g::Filter::Eq]), "eh2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("eh2_count")
    obj_sys_id: ids::EnterpriseHost2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-host-2-kpi/obj_id", domain::Reference(ids::EnterpriseHost2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "eh2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseHost2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("eh2__ho", domain::endpoint(EnterpriseHost2Kpi.type, "obj_sys_id"), domain::endpoint(host::Host.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("eh2__seh", domain::endpoint(EnterpriseHost2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_host::KpiStorageEnterpriseHost.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
