                 {"relation":"connection_a","from":"link","to":"device"}],
        "select":[{"node":"device","dimension":"device_id"}], "count":"device"
    }"#).unwrap!())
}, "relation connection_a between link and device may multiply device; if this edge only filters rows, use correlated EXISTS");

