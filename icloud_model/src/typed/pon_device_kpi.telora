use ontology::quantity as statistic_quantity;
use ontology::quantity as q;
use super::metric_values as metric;
use ontology::quantity as presentation;
use ontology::semantic as domain;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_device as pon;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
use ontology::quantity::{EffectiveCount};
type MemoryUsage = struct(metric::MemoryUtilization);
type Controllability = struct(q::Percent);
type PingResponseTime = struct(q::Milliseconds);
@domain::bind(pon::PonElementById.type, "source_resId")
@domain::dataset(
    "source_PonDeviceKPI",
    "PonDeviceKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@domain::metric("source_ts")
@domain::relations(relations)
type PonDeviceKPI = struct {
    @m::column("ts")
    @g::view("source_PonDeviceKPI__ts", True, g::numeric_filters)
    @g::utc_bucket_view("source_PonDeviceKPI_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("source_PonDeviceKPI_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("source_PonDeviceKPI_utc_month", qb::UtcBucketUnit::Month)
    @domain::count("pon_device_kpi_sample_count")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_PonDeviceKPI__resId")
    source_resId: domain::Reference(pon::PonElementById),
    @m::column("tenantId")
    @g::exact("source_PonDeviceKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_PonDeviceKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_PonDeviceKPI__projectId")
    source_projectId: String,
    @m::column("cpuUsage")
    @g::view("source_PonDeviceKPI__cpuUsage", True, g::numeric_filters)
    @samples::field(
        metric::cpu_summary,
        [
            {statistic: samples::Statistic::Mean, publish: "pon_cpu_usage"},
            {statistic: samples::Statistic::Max, publish: "pon_cpu_sample_max"},
            {statistic: samples::Statistic::Min, publish: "pon_cpu_sample_min"}
        ]
    )
    @samples::valid_count("source_cpuUsageEffcnt")
    @domain::count("pon_cpu_usage_observation_count")
    source_cpuUsage: metric::CpuUtilization,
    @m::column("memUsage")
    @g::view("source_PonDeviceKPI__memUsage", True, g::numeric_filters)
    @samples::valid_count("source_memUsageEffcnt")
    source_memUsage: MemoryUsage,
    @m::column("onlineRate")
    @g::view("source_PonDeviceKPI__onlineRate", True, g::numeric_filters)
    @samples::field(
        metric::online_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "pon_online_rate_avg"},
            {statistic: samples::Statistic::Min, publish: "pon_online_rate_min"},
            {statistic: samples::Statistic::Max, publish: "pon_online_rate_max"}
        ]
    )
    @samples::valid_count("source_onlineRateEffcnt")
    @domain::count("pon_online_rate_avg_observation_count")
    source_onlineRate: metric::OnlineProportion,
    @m::column("neContrlableRate")
    @g::view("source_PonDeviceKPI__neContrlableRate", True, g::numeric_filters)
    @samples::valid_count("source_neContrlableRateEffcnt")
    source_neContrlableRate: Controllability,
    @m::column("nePingRespTime")
    @g::view("source_PonDeviceKPI__nePingRespTime", True, g::numeric_filters)
    @samples::valid_count("source_nePingRespTimeEffcnt")
    source_nePingRespTime: PingResponseTime,
    @m::column("cpuUsageEffcnt")
    @g::view("source_PonDeviceKPI__cpuUsageEffcnt", True, g::numeric_filters)
    source_cpuUsageEffcnt: EffectiveCount,
    @m::column("memUsageEffcnt")
    @g::view("source_PonDeviceKPI__memUsageEffcnt", True, g::numeric_filters)
    source_memUsageEffcnt: EffectiveCount,
    @m::column("onlineRateEffcnt")
    @g::view("source_PonDeviceKPI__onlineRateEffcnt", True, g::numeric_filters)
    source_onlineRateEffcnt: EffectiveCount,
    @m::column("neContrlableRateEffcnt")
    @g::view("source_PonDeviceKPI__neContrlableRateEffcnt", True, g::numeric_filters)
    source_neContrlableRateEffcnt: EffectiveCount,
    @m::column("nePingRespTimeEffcnt")
    @g::view("source_PonDeviceKPI__nePingRespTimeEffcnt", True, g::numeric_filters)
    source_nePingRespTimeEffcnt: EffectiveCount,
};
def owner: r::Endpoint = domain::endpoint(PonDeviceKPI.type, "source_resId");

def relations: Array(r::Relation) = [
    r::relation(
        "source_EntPonElementAssociationPonDeviceKPI",
        pon::subject,
        owner,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{PonDeviceKPI};
