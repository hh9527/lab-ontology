# Dog kennel EnterpriseKnowledge domain model.
#
# This module declares the closed business vocabulary of the dog kennel domain on
# top of the ontology eDSL: entities, measures, dimensions, and the relations that
# keep the model deterministic.  Physical table/column names are implementation
# details of this module and are deliberately not part of the resolver-facing docs.
#
# Canonical field order used by `@edsl.relation` index arguments is the
# name-sorted field order, so every struct below lists its fields in sorted order.

use ontology::ontology as edsl;
use ontology::query as qb;

# ---------------------------------------------------------------------------
# Shared capability declarations
# ---------------------------------------------------------------------------

def flag_true: Bool = True;
def flag_false: Bool = False;
def no_types: Array(Type) = [];

def agg_count: qb::AggregateFunction = qb::AggregateFunction::Count;
def agg_sum: qb::AggregateFunction = qb::AggregateFunction::Sum;
def agg_max: qb::AggregateFunction = qb::AggregateFunction::Max;
def agg_min: qb::AggregateFunction = qb::AggregateFunction::Min;
def agg_avg: qb::AggregateFunction = qb::AggregateFunction::Avg;

def rel_safe: edsl::RelationKind = edsl::RelationKind::Safe;
def rel_fanout: edsl::RelationKind = edsl::RelationKind::FanOut;

def eq_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def range_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Gt, edsl::FilterOp::Ge, edsl::FilterOp::Lt, edsl::FilterOp::Le];
def text_ops: Array(edsl::FilterOp) = [
    edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Contains, edsl::FilterOp::NotContains, edsl::FilterOp::StartsWith, edsl::FilterOp::EndsWith,
];
def text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def int_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];
def num_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int, edsl::FilterInputKind::Number];

def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
        qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order,
        qb::Operator::Limit, qb::Operator::Offset, qb::Operator::Partition,
    ],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Sum, qb::AggregateFunction::Avg, qb::AggregateFunction::Min, qb::AggregateFunction::Max],
    allowed_scalars: [
        qb::ScalarFunction::Substr, qb::ScalarFunction::Instr, qb::ScalarFunction::If, qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Lower, qb::ScalarFunction::Length,
        qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not,
    ],
    allow_distinct: True,
};

def authorize: Fn(String) -> Bool = fn(subject) { subject == "resolver" };

# ---------------------------------------------------------------------------
# Breeds
# ---------------------------------------------------------------------------

@edsl::entity_id("Breed")
@edsl::entity_source("Breeds", "br")
type Breed = struct {
    @edsl::column("breed_code")
    @edsl::key(flag_true)
    @edsl::dimension("BreedCode", flag_true, flag_true, eq_ops, text_kinds)
    breed_code: String,

    @edsl::column("breed_name")
    @edsl::dimension("BreedName", flag_true, flag_true, text_ops, text_kinds)
    breed_name: String,
};

# ---------------------------------------------------------------------------
# Charges (rate card)
# ---------------------------------------------------------------------------

@edsl::entity_id("Charge")
@edsl::entity_source("Charges", "ch")
type Charge = struct {
    @edsl::column("charge_amount")
    @edsl::dimension("ChargeAmount", flag_true, flag_true, eq_ops, num_kinds)
    @edsl::measure("MaxChargeAmount", agg_max, no_types)
    charge_amount: Float,

    @edsl::column("charge_id")
    @edsl::key(flag_true)
    @edsl::measure("ChargeCount", agg_count, no_types)
    charge_id: Int,

    @edsl::column("charge_type")
    @edsl::dimension("ChargeType", flag_true, flag_true, text_ops, text_kinds)
    charge_type: String,

    # Synthetic carriers for extra aggregate functions over the charge amount.
    @edsl::column("charge_amount")
    @edsl::measure("AvgChargeAmount", agg_avg, no_types)
    zz_amount_avg: Float,

    @edsl::column("charge_amount")
    @edsl::measure("MinChargeAmount", agg_min, no_types)
    zz_amount_min: Float,
};

# ---------------------------------------------------------------------------
# Sizes
# ---------------------------------------------------------------------------

@edsl::entity_id("Size")
@edsl::entity_source("Sizes", "sz")
type Size = struct {
    @edsl::column("size_code")
    @edsl::key(flag_true)
    @edsl::dimension("SizeCode", flag_true, flag_true, eq_ops, text_kinds)
    size_code: String,

    @edsl::column("size_description")
    @edsl::dimension("SizeDescription", flag_true, flag_true, text_ops, text_kinds)
    size_description: String,
};

# ---------------------------------------------------------------------------
# Treatment types
# ---------------------------------------------------------------------------

@edsl::entity_id("TreatmentType")
@edsl::entity_source("Treatment_Types", "tt")
type TreatmentType = struct {
    @edsl::column("treatment_type_code")
    @edsl::key(flag_true)
    treatment_type_code: String,

    @edsl::column("treatment_type_description")
    @edsl::dimension("TreatmentTypeDescription", flag_true, flag_true, text_ops, text_kinds)
    treatment_type_description: String,
};

# ---------------------------------------------------------------------------
# Owners
# ---------------------------------------------------------------------------

@edsl::entity_id("Owner")
@edsl::entity_source("Owners", "ow")
type Owner = struct {
    @edsl::column("cell_number")
    @edsl::dimension("OwnerCellNumber", flag_true, flag_true, text_ops, text_kinds)
    cell_number: String,

    @edsl::column("city")
    @edsl::dimension("OwnerCity", flag_true, flag_true, text_ops, text_kinds)
    city: String,

    @edsl::column("email_address")
    @edsl::dimension("OwnerEmailAddress", flag_true, flag_true, text_ops, text_kinds)
    email_address: String,

    @edsl::column("first_name")
    @edsl::dimension("OwnerFirstName", flag_true, flag_true, text_ops, text_kinds)
    first_name: String,

    @edsl::column("home_phone")
    @edsl::dimension("OwnerHomePhone", flag_true, flag_true, text_ops, text_kinds)
    home_phone: String,

    @edsl::column("last_name")
    @edsl::dimension("OwnerLastName", flag_true, flag_true, text_ops, text_kinds)
    last_name: String,

    @edsl::column("owner_id")
    @edsl::key(flag_true)
    @edsl::dimension("OwnerId", flag_true, flag_true, eq_ops, int_kinds)
    @edsl::measure("OwnerCount", agg_count, no_types)
    owner_id: Int,

    @edsl::column("state")
    @edsl::dimension("OwnerState", flag_true, flag_true, text_ops, text_kinds)
    state: String,

    @edsl::column("street")
    @edsl::dimension("OwnerStreet", flag_true, flag_true, text_ops, text_kinds)
    street: String,

    @edsl::column("zip_code")
    @edsl::dimension("OwnerZipCode", flag_true, flag_true, text_ops, text_kinds)
    zip_code: String,
};

# ---------------------------------------------------------------------------
# Professionals
# ---------------------------------------------------------------------------

@edsl::entity_id("Professional")
@edsl::entity_source("Professionals", "pf")
type Professional = struct {
    @edsl::column("cell_number")
    @edsl::dimension("ProfessionalCellNumber", flag_true, flag_true, text_ops, text_kinds)
    cell_number: String,

    @edsl::column("city")
    @edsl::dimension("ProfessionalCity", flag_true, flag_true, text_ops, text_kinds)
    city: String,

    @edsl::column("email_address")
    @edsl::dimension("ProfessionalEmailAddress", flag_true, flag_true, text_ops, text_kinds)
    email_address: String,

    @edsl::column("first_name")
    @edsl::dimension("ProfessionalFirstName", flag_true, flag_true, text_ops, text_kinds)
    first_name: String,

    @edsl::column("home_phone")
    @edsl::dimension("ProfessionalHomePhone", flag_true, flag_true, text_ops, text_kinds)
    home_phone: String,

    @edsl::column("last_name")
    @edsl::dimension("ProfessionalLastName", flag_true, flag_true, text_ops, text_kinds)
    last_name: String,

    @edsl::column("professional_id")
    @edsl::key(flag_true)
    @edsl::dimension("ProfessionalId", flag_true, flag_true, eq_ops, int_kinds)
    @edsl::measure("ProfessionalCount", agg_count, no_types)
    professional_id: Int,

    @edsl::column("role_code")
    @edsl::dimension("ProfessionalRole", flag_true, flag_true, text_ops, text_kinds)
    role_code: String,

    @edsl::column("state")
    @edsl::dimension("ProfessionalState", flag_true, flag_true, text_ops, text_kinds)
    state: String,

    @edsl::column("street")
    @edsl::dimension("ProfessionalStreet", flag_true, flag_true, text_ops, text_kinds)
    street: String,

    @edsl::column("zip_code")
    @edsl::dimension("ProfessionalZipCode", flag_true, flag_true, text_ops, text_kinds)
    zip_code: String,
};

# ---------------------------------------------------------------------------
# Dogs
# ---------------------------------------------------------------------------

@edsl::entity_id("Dog")
@edsl::entity_source("Dogs", "dg")
@edsl::named_relation_key("dog_breed", Breed.type, rel_safe, edsl::RelationKey::Eq({from: 2, to: 0}))
@edsl::named_relation_key("dog_size", Size.type, rel_safe, edsl::RelationKey::Eq({from: 11, to: 0}))
@edsl::named_relation_key("dog_owner", Owner.type, rel_safe, edsl::RelationKey::Eq({from: 10, to: 6}))
type Dog = struct {
    @edsl::column("abandoned_yn")
    @edsl::dimension("AbandonedFlag", flag_true, flag_true, eq_ops, int_kinds)
    abandoned_yn: Int,

    @edsl::column("age")
    @edsl::dimension("DogAge", flag_true, flag_true, range_ops, int_kinds)
    @edsl::measure("MaxDogAge", agg_max, no_types)
    age: Int,

    @edsl::column("breed_code")
    @edsl::dimension("DogBreedCode", flag_true, flag_true, eq_ops, text_kinds)
    breed_code: String,

    @edsl::column("date_adopted")
    @edsl::dimension("DogDateAdopted", flag_true, flag_true, text_ops, text_kinds)
    date_adopted: String,

    @edsl::column("date_arrived")
    @edsl::dimension("DogDateArrived", flag_true, flag_true, text_ops, text_kinds)
    date_arrived: String,

    @edsl::column("date_departed")
    @edsl::dimension("DogDateDeparted", flag_true, flag_true, text_ops, text_kinds)
    date_departed: String,

    @edsl::column("date_of_birth")
    @edsl::dimension("DogDateOfBirth", flag_true, flag_true, text_ops, text_kinds)
    date_of_birth: String,

    @edsl::column("dog_id")
    @edsl::key(flag_true)
    @edsl::measure("DogCount", agg_count, no_types)
    dog_id: Int,

    @edsl::column("gender")
    @edsl::dimension("DogGender", flag_true, flag_true, eq_ops, text_kinds)
    gender: String,

    @edsl::column("name")
    @edsl::dimension("DogName", flag_true, flag_true, text_ops, text_kinds)
    name: String,

    @edsl::column("owner_id")
    @edsl::dimension("DogOwnerId", flag_true, flag_true, eq_ops, int_kinds)
    owner_id: Int,

    @edsl::column("size_code")
    @edsl::dimension("DogSizeCode", flag_true, flag_true, eq_ops, text_kinds)
    size_code: String,

    @edsl::column("weight")
    @edsl::dimension("DogWeight", flag_true, flag_true, eq_ops, num_kinds)
    weight: Float,

    # Synthetic carriers (name-sorted after `weight`) expose additional aggregate
    # functions over existing numeric columns without changing canonical indices.
    @edsl::column("age")
    @edsl::measure("AvgDogAge", agg_avg, no_types)
    zz_age_avg: Int,

    @edsl::column("age")
    @edsl::measure("MinDogAge", agg_min, no_types)
    zz_age_min: Int,

    @edsl::column("weight")
    @edsl::measure("AvgDogWeight", agg_avg, no_types)
    zz_weight_avg: Float,

    @edsl::column("weight")
    @edsl::measure("MinDogWeight", agg_min, no_types)
    zz_weight_min: Float,

    @edsl::column("weight")
    @edsl::measure("MaxDogWeight", agg_max, no_types)
    zz_weight_max: Float,
};

# ---------------------------------------------------------------------------
# Treatments
# ---------------------------------------------------------------------------

@edsl::entity_id("Treatment")
@edsl::entity_source("Treatments", "tr")
@edsl::named_relation_key("treatment_dog", Dog.type, rel_safe, edsl::RelationKey::Eq({from: 2, to: 7}))
@edsl::named_relation_key("treatment_professional", Professional.type, rel_safe, edsl::RelationKey::Eq({from: 3, to: 6}))
@edsl::named_relation_key("treatment_type", TreatmentType.type, rel_safe, edsl::RelationKey::Eq({from: 5, to: 0}))
type Treatment = struct {
    @edsl::column("cost_of_treatment")
    @edsl::dimension("TreatmentCostAmount", flag_true, flag_true, eq_ops, num_kinds)
    @edsl::measure("TotalTreatmentCost", agg_sum, no_types)
    cost_of_treatment: Float,

    @edsl::column("date_of_treatment")
    @edsl::dimension("TreatmentDate", flag_true, flag_true, text_ops, text_kinds)
    date_of_treatment: String,

    @edsl::column("dog_id")
    @edsl::dimension("TreatmentDogId", flag_true, flag_true, eq_ops, int_kinds)
    dog_id: Int,

    @edsl::column("professional_id")
    @edsl::dimension("TreatmentProfessionalId", flag_true, flag_true, eq_ops, int_kinds)
    professional_id: Int,

    @edsl::column("treatment_id")
    @edsl::key(flag_true)
    @edsl::measure("TreatmentCount", agg_count, no_types)
    treatment_id: Int,

    @edsl::column("treatment_type_code")
    treatment_type_code: String,

    # Synthetic carriers for extra aggregate functions over treatment cost.
    @edsl::column("cost_of_treatment")
    @edsl::measure("AvgTreatmentCost", agg_avg, no_types)
    zz_cost_avg: Float,

    @edsl::column("cost_of_treatment")
    @edsl::measure("MinTreatmentCost", agg_min, no_types)
    zz_cost_min: Float,

    @edsl::column("cost_of_treatment")
    @edsl::measure("MaxTreatmentCost", agg_max, no_types)
    zz_cost_max: Float,
};

# ---------------------------------------------------------------------------
# Prepared knowledge payload
# ---------------------------------------------------------------------------

def payload: edsl::PreparedPayload = edsl::build_root(
    "dog-kennels-v1",
    [Breed.type, Charge.type, Size.type, TreatmentType.type, Owner.type, Dog.type, Professional.type, Treatment.type],
    profile,
    authorize,
);

pub use self::{ payload, profile };
