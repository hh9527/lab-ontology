use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::serverpsu_2_kpi;
@domain::subject("PhysicalServerPsu", "obj_id")
@domain::dataset("kpi-server-psu", "kpi_server_psu", ["obj_id","ts"])
@domain::metric("ts")
@domain::relations(relations)
pub type KpiServerPsu = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-server-psu/obj_id", domain::Reference(ids::KpiServerPsuByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "seps_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::KpiServerPsuByObjId),
    @m::column("TS")
    @g::field_view(g::dimension_group("kpi-server-psu/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "seps_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("seps_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("seps_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("seps_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("INPUTPOWER")
    @g::field_view(g::dimension_group("kpi-server-psu/input_power", metric::KpiServerPsuInputPower.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "seps_input_power_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-server-psu/input_power", metric::KpiServerPsuInputPower.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("W")), [{statistic: samples::Statistic::Mean, publish: "seps_input_power"}, {statistic: samples::Statistic::Max, publish: "seps_input_power_max"}, {statistic: samples::Statistic::Min, publish: "seps_input_power_min"}])
    input_power: Option(metric::KpiServerPsuInputPower),
};

pub def relations: Array(r::Relation) = [
    r::relation("seps__serverpsu_2_rev", domain::endpoint(KpiServerPsu.type, "obj_id"), domain::endpoint(serverpsu_2_kpi::Serverpsu2Kpi.type, "obj_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
