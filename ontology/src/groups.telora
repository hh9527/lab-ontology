# 直接字段维度由 Row 上的声明展开；一个字段可以发布多个视图。
@prelude::property(PropertyTarget::Field)
type FieldDimensions = struct {
    dimensions: Array(FieldDimension)
};
type FieldDimensionSpec = struct {
    id: String,
    group: String,
    projectable: Bool,
    group_projectable: Bool,
    group_filters: Array(Filter),
    filters: Array(Filter)
};
type FieldDimension = struct {
    id: String,
    nullable: Bool,
    group: String,
    value: Type,
    projectable: Bool,
    group_projectable: Bool,
    group_filters: Array(Filter),
    filters: Array(Filter)
};
def prepare_field_dimension: Fn(property::FieldPropertyCtx, FieldDimensionSpec) -> FieldDimension = fn(
    ctx,
    spec
) {
    let variants = if td::kind(ctx.ty) == td::TypeDescKind::Enum {
        td::variants(ctx.ty)
    } else {
        []
    };
    let optional = array::length(variants) == 2 && array::any(
        variants,
        fn(v) {
            v.name == "None" && v.payload == None
        }
    );
    let value = if optional {
        match array::find(
            variants,
            fn(v) {
                v.name == "Some"
            }
        ) {
            Some(v) => match v.payload {
                Some(ty) => ty,
                None => fail!("invalid optional dimension", ctx.name)
            },
            None => fail!("invalid optional dimension", ctx.name)
        }
    } else {
        ctx.ty
    };
    if spec.group == "search" && value != String.type {
        fail!("search dimension requires String", ctx.name)
    } else if spec.group == "epoch_millis" && value != scalars::EpochMillis.type {
        fail!("epoch_millis dimension requires EpochMillis", ctx.name)
    } else {
        ()
    };
    validate_filters(value, spec.filters);
    {
        id: spec.id,
        group: spec.group,
        value,
        nullable: optional,
        projectable: spec.projectable,
        group_projectable: spec.group_projectable,
        group_filters: spec.group_filters,
        filters: spec.filters
    }
};
def field_dimension: Fn(
    String,
    String,
    Array(Filter)
) -> Fn(property::FieldPropertyCtx, Option(FieldDimensions)) -> FieldDimensions = fn(
    id,
    group,
    filters
) {
    property_contract::publish_name(id);
    fn(ctx, previous) {
        let before = match previous {
            Some(p) => p.dimensions,
            None => []
        };
        {
            dimensions: array::push(
                before,
                prepare_field_dimension(
                    ctx,
                    {
                        id,
                        group,
                        projectable: True,
                        group_projectable: True,
                        group_filters: filters,
                        filters
                    }.ty!(FieldDimensionSpec)
                )
            )
        }
    }
};
def search: Fn(String) -> Fn(property::FieldPropertyCtx, Option(FieldDimensions)) -> FieldDimensions = fn(
    id
) {
    field_dimension(id, "search", text_search_filters)
};
def exact: Fn(String) -> Fn(property::FieldPropertyCtx, Option(FieldDimensions)) -> FieldDimensions = fn(
    id
) {
    field_dimension(id, "exact", [Filter::Eq])
};
def numeric: Fn(
    String
) -> Fn(property::FieldPropertyCtx, Option(FieldDimensions)) -> FieldDimensions = fn(id) {
    field_dimension(id, "numeric", numeric_filters)
};
def epoch_millis: Fn(
    String
) -> Fn(property::FieldPropertyCtx, Option(FieldDimensions)) -> FieldDimensions = fn(id) {
    field_dimension(id, "epoch_millis", time_filters)
};
def field_dimensions_for: Fn(model::PreparedDataset) -> Array(BindingFacts) = fn(dataset) {
    array::flat_map(
        model::fields_of(dataset.row),
        fn(field) {
            match property::get_field_prop(dataset.row, field.index, FieldDimensions.type) {
                None => [],
                Some(declared) => {
                    array::map(
                        declared.dimensions,
                        fn(spec) {
                            let value = spec.value;
                            let optional = spec.nullable;
                            {
                                row: dataset.row,
                                dataset: dataset.id,
                                source: dataset.source,
                                contract: BindingContract::DeferredDimension(
                                    {
                                        id: spec.group,
                                        value,
                                        projectable: spec.group_projectable,
                                        filters: spec.group_filters
                                    }
                                ),
                                members: [
                                    {
                                        group: spec.group,
                                        local: "value",
                                        id: spec.id,
                                        node: Node::Column(
                                            {
                                                index: field.index,
                                                name: field.name,
                                                value,
                                                nullable: optional
                                            }
                                        ),
                                        value,
                                        nullable: optional,
                                        aggregate: None,
                                        projectable: spec.projectable,
                                        filters: spec.filters,
                                        kind: MemberKind::Dimension(
                                            {
                                                projectable: spec.group_projectable,
                                                filters: spec.group_filters
                                            }
                                        )
                                    }
                                ]
                            }.ty!(BindingFacts)
                        }
                    )
                }
            }
        }
    )
};

pub use self::{
    FieldDimensions,
    FieldDimension,
    search,
    exact,
    numeric,
    epoch_millis
};

pub use self::{field_dimensions_for};

# 组合声明通过发布名引用同一字段维度，不重复定义。

# 复用显式模板的直接字段视图，保留组能力上限与绑定能力。
def field_view: for(V) Fn(
    DimensionGroup(V),
    String,
    Bool,
    Array(Filter)
) -> Fn(property::FieldPropertyCtx, Option(FieldDimensions)) -> FieldDimensions = fn(
    group,
    id,
    projectable,
    filters
) {
    property_contract::publish_name(id);
    if (projectable && !group.projectable) || !array::all(
        filters,
        fn(op) {
            array::length(
                array::filter(
                    filters,
                    fn(other) {
                        other == op
                    }
                )
            ) == 1 && array::any(
                group.filters,
                fn(allowed) {
                    allowed == op
                }
            )
        }
    ) {
        fail!("dimension binding cannot expand group capabilities", id)
    } else {
        ()
    };
    fn(ctx, previous) {
        let nullable = if ctx.ty == V.type {
            False
        } else if ctx.ty == Option(V).type {
            True
        } else {
            fail!("field view does not match group type", ctx.name)
        };
        let before = match previous {
            Some(p) => p.dimensions,
            None => []
        };
        {
            dimensions: array::push(
                before,
                {
                    id,
                    nullable,
                    group: group.id,
                    value: V.type,
                    projectable,
                    group_projectable: group.projectable,
                    group_filters: group.filters,
                    filters
                }.ty!(FieldDimension)
            )
        }
    }
};

pub use self::{field_view};
