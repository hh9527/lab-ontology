use std::array as array;
use ontology::experimental::model as m;
use self::inventory as inventory;
use self::profile as profile;
use ontology::experimental::transform as t;
use ontology::experimental::relations as r;
use ontology::ontology as edsl;
def payload: edsl::PreparedPayload = t::build("icloud-typed-v1", [
    inventory::device_declaration <~ {dataset: m::prepare(inventory::devices, [
        inventory::device_subject, inventory::device_tenant, site::project, site::subnet,
    ])},
    inventory::tenant_declaration,
    site::declaration,
    port::declaration,
    interface_kpi::declaration,
    server::declaration,
    server_kpi::declaration,
    server_fan::declaration,
    server_psu::declaration,
    server_memory::declaration,
    storage::declaration,
    frame::declaration,
    network_slot::declaration,
    pon_device::declaration,
    pon_onu::declaration,
    pon_olt::declaration,
    onu_kpi::declaration,
    pon_port_kpi::declaration,
    ap_ssid_kpi::declaration,
    device_kpi::declaration,
    current_alarm::declaration <~ {dataset: current_alarm::declaration.dataset <~ {roles: array::concat([
        current_alarm::declaration.dataset.roles, m::prepare(current_alarm::dataset, [collaboration::alarm_reference, fc_switch::alarm_reference]).roles,
    ])}},
    physical_link::declaration <~ {dataset: physical_link::declaration.dataset <~ {roles: array::concat([
        physical_link::declaration.dataset.roles, m::prepare(physical_link::dataset, [fc_switch::a_reference, fc_switch::z_reference]).roles,
    ])}},
    collaboration::declaration,
    terminal::declaration,
    network_optical_module::declaration,
    fc_switch::declaration,
    ap_kpi::declaration,
    ap_radio_kpi::declaration,
    cell_link_quality::declaration,
    cell_link_traffic::declaration,
    board_kpi::declaration,
    network_online_kpi::declaration,
    server_disk::declaration,
    server_network_adapter::declaration,
    server_optical_module::declaration,
    server_port::declaration,
    server_processor::declaration,
    pon_ethernet_kpi::declaration,
    pon_device_kpi::declaration,
    pon_online_kpi::declaration,
    storage_backup_power::declaration,
    storage_chassis::declaration,
    storage_controller::declaration,
    storage_fan::declaration,
    storage_power_supply::declaration,
    storage_disk::declaration,
    storage_port::declaration,
    storage_device_kpi::declaration,
    storage_disk_kpi::declaration,
    device_catalog::declaration,
], array::concat([inventory::relations, site::relations, port::relations, interface_kpi::relations, server::relations, server_kpi::relations, server_fan::relations, server_psu::relations, server_memory::relations, storage::relations, frame::relations, network_slot::relations, pon_device::relations, onu_kpi::relations, pon_port_kpi::relations, ap_ssid_kpi::relations, device_kpi::relations, current_alarm::relations, physical_link::relations, collaboration::relations, terminal::relations, fc_switch::relations, server_disk::relations, server_network_adapter::relations, server_optical_module::relations, server_port::relations, server_processor::relations, pon_ethernet_kpi::relations, pon_device_kpi::relations, pon_online_kpi::relations, storage_backup_power::relations, storage_chassis::relations, storage_controller::relations, storage_fan::relations, storage_power_supply::relations, storage_disk::relations, storage_port::relations, storage_device_kpi::relations, [r::relation("pon_onu_parent_olt", pon_onu::dataset, pon_onu::parent, pon_olt::dataset, pon_olt::subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional})]]), array::concat([site::alternatives, server::alternatives, storage::alternatives, pon_device::alternatives, physical_link::alternatives, terminal::alternatives, fc_switch::alternatives]), physical_link::links, profile::profile).payload;
pub use self::{payload};
