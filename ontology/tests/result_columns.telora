use crate::ontology as edsl;
use crate::query as qb;
use crate::intent as intent;
use crate::sqlite as sqlite;
use crate::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::test as test;
use std::value::{ Value };

@edsl::entity_id("reading") @edsl::entity_source("readings", "r")
@edsl::dataset(edsl::DatasetKind::Metric, ["id"], Some("epoch"))
type Reading = struct {
    @edsl::column("id") @edsl::key()
    @edsl::dimension("id", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Int])
    @edsl::measure("total", qb::AggregateFunction::Count, [])
    @edsl::computed_measure("twice", qb::ComputedOp::Add, "total", "total")
    id: Int,
    @edsl::column("value")
    @edsl::dimension("value", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Int])
    @edsl::measure("sum", qb::AggregateFunction::Sum, [])
    @edsl::sample_measure("mean", qb::AggregateFunction::Avg, None)
    value: Option(Int),
    @edsl::column("ts")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("ts", True, True, [edsl::FilterOp::Eq, edsl::FilterOp::Lt], [edsl::FilterInputKind::DatetimeUtc])
    @edsl::utc_bucket_dimension("ts_day", qb::UtcBucketUnit::Day)
    ts: String,
    @edsl::column("epoch")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("epoch", True, True, [edsl::FilterOp::Eq, edsl::FilterOp::Lt], [edsl::FilterInputKind::EpochMillis])
    @edsl::utc_bucket_dimension("epoch_day", qb::UtcBucketUnit::Day)
    @edsl::measure("max_epoch", qb::AggregateFunction::Max, [])
    epoch: Int,
    @edsl::column("local_epoch")
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("local_epoch", True, True, [edsl::FilterOp::Eq, edsl::FilterOp::Lt], [edsl::FilterInputKind::EpochMillis])
    @edsl::measure("max_local_epoch", qb::AggregateFunction::Max, [])
    local_epoch: Int,
    @edsl::column("local_text")
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::LocalText)
    @edsl::dimension("local_text", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::LocalDateTime])
    @edsl::measure("max_local_text", qb::AggregateFunction::Max, [])
    local_text: String,
    @edsl::column("ratio")
    @edsl::dimension("ratio", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Number])
    ratio: Float,
    @edsl::column("active")
    @edsl::dimension("active", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Bool])
    active: Bool,
    @edsl::column("label")
    @edsl::dimension("label", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    @edsl::computed_dimension("label_length", edsl::OutputType::Integer, True, True,
        [edsl::FilterOp::Eq], [edsl::FilterInputKind::Int],
        fn(ctx, expr) { (ctx, qb::scalar(qb::ScalarFunction::Length, [expr])) })
    label: String,
};
def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column,
        qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Filter,
        qb::Operator::Group, qb::Operator::Aggregate, qb::Operator::Order, qb::Operator::Limit],
    allowed_join_kinds: [], allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Sum, qb::AggregateFunction::Avg, qb::AggregateFunction::Max],
    allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt,
        qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::Add, qb::ScalarFunction::Length,
        qb::ScalarFunction::UtcTimeBucket({unit: qb::UtcBucketUnit::Day, encoding: qb::UtcBucketEncoding::DatetimeUtc}),
        qb::ScalarFunction::UtcTimeBucket({unit: qb::UtcBucketUnit::Day, encoding: qb::UtcBucketEncoding::EpochMillis})], allow_distinct: True,
};
def payload: edsl::PreparedPayload = edsl::build_root("columns-v1", [Reading.type], profile);
def parse: Fn(String) -> Value = fn(text) { json::parse(text).unwrap!() };
def raw: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[{"node":"r","dimension":"label"},{"node":"r","dimension":"value"},{"node":"r","dimension":"active"},{"node":"r","dimension":"ratio"},{"node":"r","dimension":"label_length"}]}"#);
def empty: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[{"node":"r","dimension":"value"}],"filters":[{"node":"r","dimension":"id","op":"Eq","value":-1}]}"#);
def times: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[{"node":"r","dimension":"ts"},{"node":"r","dimension":"epoch"},{"node":"r","dimension":"ts_day"},{"node":"r","dimension":"epoch_day"}]}"#);
def local_times: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[{"node":"r","dimension":"local_epoch"},{"node":"r","dimension":"local_text"}]}"#);
def local_max: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[],"measures":[{"node":"r","measure":"max_local_epoch"},{"node":"r","measure":"max_local_text"}]}"#);
def aggregates: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[],"measures":[{"node":"r","measure":"sum"},{"node":"r","measure":"mean"},{"node":"r","measure":"total"},{"node":"r","measure":"twice"},{"node":"r","measure":"max_epoch"}]}"#);
def count: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[],"count":"r"}"#);
def value_count: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[],"count_value":{"node":"r","dimension":"value"}}"#);
def end_only_epoch: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[{"node":"r","dimension":"epoch"}],"time_windows":[{"node":"r","dimension":"epoch","end":1792540800000}]}"#);
def end_only_utc: Value = parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[{"node":"r","dimension":"epoch"}],"time_windows":[{"node":"r","dimension":"ts","end":"2026-10-21T00:00:00Z"}]}"#);
type Response = struct { accepted: Bool, diagnostics: Array(Value), queries: Option(Array(intent::PreparedQuery)) };
def prepare: Fn(intent::ToQuery, Value) -> intent::PreparedQuery = fn(dialect, input) {
    let response = intent::query_request_method_factory(payload, dialect)(Value::Object({intents: Value::Array([input])}));
    let decoded = codec::decode@[Response](response).unwrap!();
    match decoded.queries { Some(queries) => queries[0], None => fail!("valid column fixture rejected", response) }
};
def expected: Fn(String) -> intent::ResultColumn = fn(text) { codec::decode@[intent::ResultColumn](parse(text)).unwrap!() };
pub def language_types_follow_final_projection_order: test::Test = test::should_ok(fn() {
    let query = prepare(sqlite::build_query, raw);
    if query.columns == array::map([
        r#"{"name":"r_label","type":"String","nullable":false}"#,
        r#"{"name":"r_value","type":"Int","nullable":true}"#,
        r#"{"name":"r_active","type":"Bool","nullable":false}"#,
        r#"{"name":"r_ratio","type":"Float","nullable":false}"#,
        r#"{"name":"r_label_length","type":"Int","nullable":false}"#,
    ], expected) { True } else { fail!("wrong result schema", query) }
});
pub def aggregate_types_and_nullability_are_static: test::Test = test::should_ok(fn() {
    let query = prepare(sqlite::build_query, aggregates);
    if query.columns == array::map([
        r#"{"name":"r_sum","type":"Int","nullable":true}"#,
        r#"{"name":"r_mean","type":"Float","nullable":true}"#,
        r#"{"name":"r_total","type":"Int","nullable":false}"#,
        r#"{"name":"r_twice","type":"Int","nullable":false}"#,
        r#"{"name":"r_max_epoch","type":"EpochMillis","nullable":true}"#,
    ], expected) { True } else { fail!("wrong aggregate schema", query) }
});
pub def empty_queries_keep_declared_types: test::Test = test::should_ok(fn() {
    let query = prepare(sqlite::build_query, empty);
    if query.columns == [expected(r#"{"name":"r_value","type":"Int","nullable":true}"#)] { True }
    else { fail!("empty query lost its schema", query) }
});
pub def counts_are_nonnullable_integers: test::Test = test::should_ok(fn() {
    if prepare(sqlite::build_query, count).columns == [expected(r#"{"name":"r_count","type":"Int","nullable":false}"#)]
        && prepare(sqlite::build_query, value_count).columns == [expected(r#"{"name":"r_value_count","type":"Int","nullable":false}"#)] { True }
    else { fail!("wrong count schema") }
});
pub def columns_are_dialect_independent: test::Test = test::should_ok(fn() {
    if array::all([raw, empty, aggregates, count, value_count, times, local_times, local_max], fn(input) {
        prepare(sqlite::build_query, input).columns == prepare(postgres::build_query, input).columns
    }) { True } else { fail!("column contract depends on SQL dialect") }
});
type Fixture = struct { name: String, input: Value };
type ExecutionCase = struct { name: String, sqlite: intent::PreparedQuery, postgres: intent::PreparedQuery };
pub def execution_queries: Value = codec::encode(array::map([
    {name: "raw", input: raw}, {name: "empty", input: empty}, {name: "aggregates", input: aggregates},
    {name: "count", input: count}, {name: "value_count", input: value_count}, {name: "times", input: times},
    {name: "end_only_epoch", input: end_only_epoch}, {name: "end_only_utc", input: end_only_utc},
    {name: "local_times", input: local_times}, {name: "local_max", input: local_max},
].ty!(Array(Fixture)), fn(fixture) { {name: fixture.name, sqlite: prepare(sqlite::build_query, fixture.input), postgres: prepare(postgres::build_query, fixture.input)}.ty!(ExecutionCase) }));


pub def time_projections_keep_logical_types: test::Test = test::should_ok(fn() {
    let query = prepare(sqlite::build_query, times);
    if query.columns == array::map([
        r#"{"name":"r_ts","type":"DatetimeUtc","nullable":false}"#,
        r#"{"name":"r_epoch","type":"EpochMillis","nullable":false}"#,
        r#"{"name":"r_ts_day","type":"DatetimeUtc","nullable":true}"#,
        r#"{"name":"r_epoch_day","type":"EpochMillis","nullable":true}"#,
    ], expected) { True } else { fail!("time semantics were lost", query) }
});


pub def naive_time_and_instant_encodings_remain_distinct: test::Test = test::should_ok(fn() {
    if prepare(sqlite::build_query, local_times).columns == array::map([
        r#"{"name":"r_local_epoch","type":"EpochMillis","nullable":false}"#,
        r#"{"name":"r_local_text","type":"LocalDateTime","nullable":false}"#,
    ], expected) && prepare(sqlite::build_query, local_max).columns == [
        expected(r#"{"name":"r_max_local_epoch","type":"EpochMillis","nullable":true}"#),
        expected(r#"{"name":"r_max_local_text","type":"LocalDateTime","nullable":true}"#)
    ] { True } else { fail!("time representation was confused with business semantics") }
});

# An end-only window needs only Lt authorization; a bounded window also needs Ge.
pub def lower_bound_requires_its_own_capability: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(parse(r#"{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"reading"}],"edges":[],"select":[{"node":"r","dimension":"epoch"}],"time_windows":[{"node":"r","dimension":"epoch","start":0,"end":123}]}"#))
}, "time dimension does not support lower-bound range filters");
