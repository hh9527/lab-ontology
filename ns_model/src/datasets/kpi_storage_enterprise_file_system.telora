@registry::dataset(
    "kpi-storage-enterprise-file-system",
    "kpi_storage_enterpriseFileSystem",
    ["obj_id", "ts"]
)
@registry::roles([role_262])
@registry::groups(
    [
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseFileSystem.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "sefs_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseFileSystem.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "sefs_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            groups::group_7,
            g::utc_bucket(
                g::input(m::field(kpi_storage_enterpriseFileSystem.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "sefs_utc_month",
            True,
            g::time_filters
        )
    ]
)
