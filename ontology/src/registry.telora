# 类型定义解释为不可变注册操作；收集与最终校验分离。
use std::prelude as prelude;
use std::type_desc as td;
use std::type_property as props;
use std::array as array;
use std::dict as dict;
use std::type_memorizer as memo;
use std::pipeline as pipeline;
use crate::knowledge as knowledge;
use crate::model as m;
use crate::groups as g;
use crate::values as v;
use crate::transform as t;
use crate::relations as r;
use crate::samples as samples;
use crate::ontology as edsl;
use crate::world as world;
use crate::query as q;

type DatasetSpec = struct {
    id: String,
    source: String,
    grain: Array(String)
};
@prelude::property(PropertyTarget::Type)
type RootSpec = enum {
    Dataset(DatasetSpec),
    Entity(String)
};
@prelude::property(PropertyTarget::Type)
type Features = struct {
    steps: Array(Fn(t::Declaration) -> t::Declaration)
};
@prelude::property(PropertyTarget::Type)
type Connections = struct {
    relations: Array(r::Relation),
    alternatives: Array(t::Alternative),
    links: Array(r::Link)
};

def dataset: Fn(String, String, Array(String)) -> Fn(td::TypeDesc, Option(RootSpec)) -> RootSpec = fn(
    id,
    source,
    grain
) {
    fn(ctx, previous) {
        match previous {
            Some(_) => fail!("duplicate root declaration", id),
            None => RootSpec::Dataset({id, source, grain})
        }
    }
};
def entity: Fn(String) -> Fn(td::TypeDesc, Option(RootSpec)) -> RootSpec = fn(id) {
    fn(ctx, previous) {
        match previous {
            Some(_) => fail!("duplicate root declaration", id),
            None => RootSpec::Entity(id)
        }
    }
};
def dataset_spec: Fn(Type) -> DatasetSpec = fn(row) {
    match props::get_type_prop(row, RootSpec.type) {
        Some(RootSpec::Dataset(spec)) => spec,
        _ => fail!("registered dataset requires dataset property", row)
    }
};
def dataset_of: for(Row: Property(RootSpec)) Fn(TypeOf(Row)) -> m::Dataset(Row) = fn(row) {
    let spec = dataset_spec(row);
    m::dataset(spec.id, spec.source, row, spec.grain)
};
def entity_of: for(I: Property(RootSpec)) Fn(TypeOf(I)) -> m::Entity(I) = fn(identity) {
    match props::required@[RootSpec, I]() {
        RootSpec::Entity(id) => m::entity(id, identity),
        _ => fail!("registered entity requires entity property", identity)
    }
};
# Feature 的闭包只由 ontology 构造；领域层使用声明性标注。
def feature: Fn(
    Fn(t::Declaration) -> t::Declaration
) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(step) {
    fn(ctx, previous) {
        let before = match previous {
            Some(p) => p.steps,
            None => []
        };
        {steps: array::push(before, step)}
    }
};
def roles: for(Row) Fn(Array(m::Role(Row))) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(
    values
) {
    feature(
        fn(declared) {
            declared <~ {
                dataset: declared.dataset <~ {
                    roles: array::map(
                        values,
                        fn(role) {
                            {
                                id: role.id,
                                entity: role.entity,
                                identity: role.identity,
                                optional: role.optional,
                                parts: role.parts
                            }.ty!(m::PreparedRole)
                        }
                    )
                }
            }
        }
    )
};
def groups: for(Row) Fn(Array(g::Binding(Row))) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(
    values
) {
    feature(
        fn(declared) {
            declared <~ {
                groups: array::concat([declared.groups, array::map(values, g::binding_facts)])
            }
        }
    )
};
def record_counts: Fn(Array(String)) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(values) {
    feature(
        fn(declared) {
            declared <~ {record_counts: values}
        }
    )
};
def metric: Fn(String) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(field) {
    feature(
        fn(declared) {
            declared <~ {kind: edsl::DatasetKind::Metric, clock: Some(field)}
        }
    )
};
def event: Fn(String) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(field) {
    feature(
        fn(declared) {
            declared <~ {kind: edsl::DatasetKind::Event, clock: Some(field)}
        }
    )
};
def scope: for(Row) Fn(Array(t::RowScope(Row))) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(
    values
) {
    feature(
        fn(declared) {
            t::with_scope(declared, values)
        }
    )
};
def field_counts: for(Row) Fn(
    Array(t::FieldCount(Row))
) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(values) {
    feature(
        fn(declared) {
            t::with_field_counts(declared, values)
        }
    )
};
def computed_counts: for(Row) Fn(
    Array(t::ComputedCount(Row))
) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(values) {
    feature(
        fn(declared) {
            t::with_computed_counts(declared, values)
        }
    )
};
def native_pairs: for(Row) Fn(
    Array(t::NativePair(Row))
) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(values) {
    feature(
        fn(declared) {
            t::with_native_pairs(declared, values)
        }
    )
};
def reported_samples: for(Row) Fn(
    Array(samples::Binding(Row))
) -> Fn(td::TypeDesc, Option(Features)) -> Features = fn(values) {
    feature(
        fn(declared) {
            t::with_samples(declared, values)
        }
    )
};
def connections: Fn(Option(Connections)) -> Connections = fn(previous) {
    match previous {
        Some(p) => p,
        None => {relations: [], alternatives: [], links: []}
    }
};
def relations: Fn(Array(r::Relation)) -> Fn(td::TypeDesc, Option(Connections)) -> Connections = fn(
    values
) {
    fn(ctx, previous) {
        let p = connections(previous);
        p <~ {relations: array::concat([p.relations, values])}
    }
};
def alternatives: Fn(Array(t::Alternative)) -> Fn(td::TypeDesc, Option(Connections)) -> Connections = fn(
    values
) {
    fn(ctx, previous) {
        let p = connections(previous);
        p <~ {alternatives: array::concat([p.alternatives, values])}
    }
};
def links: Fn(Array(r::Link)) -> Fn(td::TypeDesc, Option(Connections)) -> Connections = fn(values) {
    fn(ctx, previous) {
        let p = connections(previous);
        p <~ {links: array::concat([p.links, values])}
    }
};

def compute_declaration: Fn(Type) -> t::Declaration = fn(row) {
    let spec = dataset_spec(row);
    let prepared: m::PreparedDataset = {
        id: spec.id,
        source: spec.source,
        row,
        grain: spec.grain,
        roles: []
    };
    let seed: t::Declaration = {
        dataset: prepared,
        groups: g::field_dimensions_for(prepared),
        domains: v::field_bindings(prepared),
        record_counts: [],
        field_counts: [],
        computed_counts: [],
        native_pairs: [],
        kind: edsl::DatasetKind::Entity,
        scope: [],
        columns: [],
        clock: None,
        samples: []
    };
    match props::get_type_prop(row, Features.type) {
        None => seed,
        Some(features) => array::fold(
            features.steps,
            seed,
            fn(current, step) {
                step(current)
            }
        )
    }
};
# 缓存仅由 Type 决定的纯声明；缓存命中与注册状态无关。
def declarations: memo::TypeMemorizer(t::LocalDefinition) = memo::type_memorizer(
    fn(row) {
        t::local_definition(compute_declaration(row))
    }
);
def local_definition: Fn(Type) -> t::LocalDefinition = fn(row) {
    memo::computed_with_type(declarations, row)
};
def declaration: Fn(Type) -> t::Declaration = fn(row) {
    local_definition(row).declaration
};
type RootInfo = struct {
    ty: Type,
    dataset: Option(t::LocalDefinition),
    entity: Option(world::Entity),
    connections: Connections
};
def root_infos: memo::TypeMemorizer(RootInfo) = memo::type_memorizer(
    fn(ty) {
        let root = match props::get_type_prop(ty, RootSpec.type) {
            Some(spec) => spec,
            None => fail!("registry root requires dataset or entity property", ty)
        };
        {
            ty,
            dataset: match root {
                RootSpec::Dataset(_) => Some(local_definition(ty)),
                _ => None
            },
            entity: match root {
                RootSpec::Entity(id) => Some({id, identity: ty}.ty!(world::Entity)),
                _ => None
            },
            connections: connections(props::get_type_prop(ty, Connections.type))
        }.ty!(RootInfo)
    }
);
def root_info: Fn(Type) -> RootInfo = fn(ty) {
    memo::computed_with_type(root_infos, ty)
};
type Registry = struct {
    roots: Array(Type),
    root_index: Dict(Bool),
    datasets: Array(t::Declaration),
    definitions: Array(t::LocalDefinition),
    entities: Array(world::Entity),
    relations: Array(r::Relation),
    alternatives: Array(t::Alternative),
    links: Array(r::Link)
};
def empty: Registry = {
    roots: [],
    root_index: {},
    datasets: [],
    definitions: [],
    entities: [],
    relations: [],
    alternatives: [],
    links: []
};
# 批量去重在封闭的 pipeline 内使用内部 builder；每类输出只合并一次。
# root_index 是 Registry 的普通不可变数据，不是可观察的全局 visited 状态。
def register_types: Fn(Registry, Array(Type)) -> Registry = fn(registry, types) {
    let fresh = pipeline::run(
        pipeline::from_array(types) |> pipeline::filter(
            fn(ty) {
                dict::get(registry.root_index, knowledge::type_id(ty)) == None
            }
        ) |> pipeline::distinct_by(knowledge::type_id) |> pipeline::map(root_info) |> pipeline::collect()
    );
    let index = pipeline::run(
        pipeline::from_array(fresh) |> pipeline::collect_dict(
            fn(info) {
                knowledge::type_id(info.ty)
            },
            fn(info) {
                True
            }
        )
    );
    registry <~ {
        roots: array::concat(
            [
                registry.roots,
                array::map(
                    fresh,
                    fn(info) {
                        info.ty
                    }
                )
            ]
        ),
        root_index: dict::merge(registry.root_index, index),
        datasets: array::concat(
            [
                registry.datasets,
                array::flat_map(
                    fresh,
                    fn(info) {
                        match info.dataset {
                            Some(value) => [value.declaration],
                            None => []
                        }
                    }
                )
            ]
        ),
        definitions: array::concat(
            [
                registry.definitions,
                array::flat_map(
                    fresh,
                    fn(info) {
                        match info.dataset {
                            Some(value) => [value],
                            None => []
                        }
                    }
                )
            ]
        ),
        entities: array::concat(
            [
                registry.entities,
                array::flat_map(
                    fresh,
                    fn(info) {
                        match info.entity {
                            Some(value) => [value],
                            None => []
                        }
                    }
                )
            ]
        ),
        relations: array::concat(
            [
                registry.relations,
                array::concat(
                    array::map(
                        fresh,
                        fn(info) {
                            info.connections.relations
                        }
                    )
                )
            ]
        ),
        alternatives: array::concat(
            [
                registry.alternatives,
                array::concat(
                    array::map(
                        fresh,
                        fn(info) {
                            info.connections.alternatives
                        }
                    )
                )
            ]
        ),
        links: array::concat(
            [
                registry.links,
                array::concat(
                    array::map(
                        fresh,
                        fn(info) {
                            info.connections.links
                        }
                    )
                )
            ]
        )
    }
};
def register_type: Fn(Registry, Type) -> Registry = fn(registry, ty) {
    match dict::get(registry.root_index, knowledge::type_id(ty)) {
        Some(_) => registry,
        None => register_types(registry, [ty])
    }
};
trait Registerable {
    register: Fn(Registry) -> Registry,
};
impl(T: Property(RootSpec)) Registerable for T {
    register: fn(registry) {
        register_type(registry, T.type)
    },
};
# 同一个 RootSpec 支撑 Dataset 与 Entity 的统一 trait 实现。
def define: Fn(String, Array(Type), Array(r::Relation), q::PlanProfile) -> world::World = fn(
    revision,
    roots,
    relations,
    profile
) {
    let registry = register_types(empty, roots);
    world::with_entities(
        world::from_definitions(
            revision,
            registry.definitions,
            array::concat([registry.relations, relations]),
            registry.alternatives,
            registry.links,
            profile
        ),
        registry.entities
    )
};
pub use self::{
    DatasetSpec,
    RootSpec,
    Features,
    Connections,
    Registry,
    Registerable,
    empty,
    dataset,
    entity,
    dataset_of,
    entity_of,
    roles,
    groups,
    record_counts,
    metric,
    event,
    scope,
    field_counts,
    computed_counts,
    native_pairs,
    reported_samples,
    relations,
    alternatives,
    links,
    declaration,
    register_type,
    register_types,
    define
};
