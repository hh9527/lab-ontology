# Source-backed iMaster Cloud schema with curated business query capabilities.
# docs/SOURCE_REFRESH.md records source authority and explicit assumptions.
# Source datetime KPI clocks have confirmed UTC semantics (issue #44).
# DatetimeUtc uses normalized ISO-Z seconds on SQLite; integer clocks use EpochMillis.

use ontology::ontology as edsl;
use ontology::query as qb;
use std::array as array;

def text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def search_text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne,
    edsl::FilterOp::Contains, edsl::FilterOp::NotContains, edsl::FilterOp::StartsWith, edsl::FilterOp::EndsWith];
def ipv4_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne,
    edsl::FilterOp::InSubnet, edsl::FilterOp::NotInSubnet];
def ipv4_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Ipv4];
def utc_window_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ge, edsl::FilterOp::Lt];
def canonical_eq_ne_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne];
def text_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def datetime_utc_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::DatetimeUtc];
def int_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Gt,
    edsl::FilterOp::Ge, edsl::FilterOp::Lt, edsl::FilterOp::Le];
def int_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];
def epoch_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::EpochMillis];
def bool_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne];
def bool_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Bool];
