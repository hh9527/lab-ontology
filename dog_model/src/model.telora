# Dog kennel EnterpriseKnowledge domain model.
#
# This module declares the closed business vocabulary of the dog kennel domain on
# top of the ontology eDSL: entities, measures, dimensions, and the relations that
# keep the model deterministic.  Physical table/column names are implementation
# details of this module and are deliberately not part of the resolver-facing docs.
#
# Relations name their fields and do not depend on struct field order.

use ontology::ontology as edsl;
use ontology::query as qb;

# ---------------------------------------------------------------------------
# Shared capability declarations
# ---------------------------------------------------------------------------

def eq_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq];
def range_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Gt, edsl::FilterOp::Ge, edsl::FilterOp::Lt, edsl::FilterOp::Le];
def text_ops: Array(edsl::FilterOp) = [
    edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Contains, edsl::FilterOp::NotContains, edsl::FilterOp::StartsWith, edsl::FilterOp::EndsWith,
];
def text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def int_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int];
def num_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int, edsl::FilterInputKind::Number];

def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
        qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order,
        qb::Operator::Limit, qb::Operator::Offset, qb::Operator::Partition,
    ],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Sum, qb::AggregateFunction::Avg, qb::AggregateFunction::Min, qb::AggregateFunction::Max],
    allowed_scalars: [
        qb::ScalarFunction::Substr, qb::ScalarFunction::Instr, qb::ScalarFunction::If, qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Lower, qb::ScalarFunction::Length,
        qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not,
    ],
    allow_distinct: True,
};

def authorize: Fn(String) -> Bool = fn(subject) { subject == "resolver" };

# ---------------------------------------------------------------------------
# Breeds
# ---------------------------------------------------------------------------

@edsl::entity_id("Breed")
@edsl::entity_source("Breeds", "br")
type Breed = struct {
    @edsl::column("breed_code")
    @edsl::key()
    @edsl::dimension("BreedCode", True, True, eq_ops, text_kinds)
    breed_code: String,

    @edsl::column("breed_name")
    @edsl::dimension("BreedName", True, True, text_ops, text_kinds)
    breed_name: String,
};

# ---------------------------------------------------------------------------
# Charges (rate card)
# ---------------------------------------------------------------------------

@edsl::entity_id("Charge")
@edsl::entity_source("Charges", "ch")
type Charge = struct {
    @edsl::column("charge_amount")
    @edsl::dimension("ChargeAmount", True, True, eq_ops, num_kinds)
    @edsl::measure("MaxChargeAmount", qb::AggregateFunction::Max, [])
    @edsl::measure("AvgChargeAmount", qb::AggregateFunction::Avg, [])
    @edsl::measure("MinChargeAmount", qb::AggregateFunction::Min, [])
    charge_amount: Float,

    @edsl::column("charge_id")
    @edsl::key()
    @edsl::measure("ChargeCount", qb::AggregateFunction::Count, [])
    charge_id: Int,

    @edsl::column("charge_type")
    @edsl::dimension("ChargeType", True, True, text_ops, text_kinds)
    charge_type: String,

};

# ---------------------------------------------------------------------------
# Sizes
# ---------------------------------------------------------------------------

@edsl::entity_id("Size")
@edsl::entity_source("Sizes", "sz")
type Size = struct {
    @edsl::column("size_code")
    @edsl::key()
    @edsl::dimension("SizeCode", True, True, eq_ops, text_kinds)
    size_code: String,

    @edsl::column("size_description")
    @edsl::dimension("SizeDescription", True, True, text_ops, text_kinds)
    size_description: String,
};

# ---------------------------------------------------------------------------
# Treatment types
# ---------------------------------------------------------------------------

@edsl::entity_id("TreatmentType")
@edsl::entity_source("Treatment_Types", "tt")
type TreatmentType = struct {
    @edsl::column("treatment_type_code")
    @edsl::key()
    treatment_type_code: String,

    @edsl::column("treatment_type_description")
    @edsl::dimension("TreatmentTypeDescription", True, True, text_ops, text_kinds)
    treatment_type_description: String,
};

# ---------------------------------------------------------------------------
# Owners
# ---------------------------------------------------------------------------

@edsl::entity_id("Owner")
@edsl::entity_source("Owners", "ow")
type Owner = struct {
    @edsl::column("cell_number")
    @edsl::dimension("OwnerCellNumber", True, True, text_ops, text_kinds)
    cell_number: String,

    @edsl::column("city")
    @edsl::dimension("OwnerCity", True, True, text_ops, text_kinds)
    city: String,

    @edsl::column("email_address")
    @edsl::dimension("OwnerEmailAddress", True, True, text_ops, text_kinds)
    email_address: String,

    @edsl::column("first_name")
    @edsl::dimension("OwnerFirstName", True, True, text_ops, text_kinds)
    first_name: String,

    @edsl::column("home_phone")
    @edsl::dimension("OwnerHomePhone", True, True, text_ops, text_kinds)
    home_phone: String,

    @edsl::column("last_name")
    @edsl::dimension("OwnerLastName", True, True, text_ops, text_kinds)
    last_name: String,

    @edsl::column("owner_id")
    @edsl::key()
    @edsl::dimension("OwnerId", True, True, eq_ops, int_kinds)
    @edsl::measure("OwnerCount", qb::AggregateFunction::Count, [])
    owner_id: Int,

    @edsl::column("state")
    @edsl::dimension("OwnerState", True, True, text_ops, text_kinds)
    state: String,

    @edsl::column("street")
    @edsl::dimension("OwnerStreet", True, True, text_ops, text_kinds)
    street: String,

    @edsl::column("zip_code")
    @edsl::dimension("OwnerZipCode", True, True, text_ops, text_kinds)
    zip_code: String,
};

# ---------------------------------------------------------------------------
# Professionals
# ---------------------------------------------------------------------------

@edsl::entity_id("Professional")
@edsl::entity_source("Professionals", "pf")
type Professional = struct {
    @edsl::column("cell_number")
    @edsl::dimension("ProfessionalCellNumber", True, True, text_ops, text_kinds)
    cell_number: String,

    @edsl::column("city")
    @edsl::dimension("ProfessionalCity", True, True, text_ops, text_kinds)
    city: String,

    @edsl::column("email_address")
    @edsl::dimension("ProfessionalEmailAddress", True, True, text_ops, text_kinds)
    email_address: String,

    @edsl::column("first_name")
    @edsl::dimension("ProfessionalFirstName", True, True, text_ops, text_kinds)
    first_name: String,

    @edsl::column("home_phone")
    @edsl::dimension("ProfessionalHomePhone", True, True, text_ops, text_kinds)
    home_phone: String,

    @edsl::column("last_name")
    @edsl::dimension("ProfessionalLastName", True, True, text_ops, text_kinds)
    last_name: String,

    @edsl::column("professional_id")
    @edsl::key()
    @edsl::dimension("ProfessionalId", True, True, eq_ops, int_kinds)
    @edsl::measure("ProfessionalCount", qb::AggregateFunction::Count, [])
    professional_id: Int,

    @edsl::column("role_code")
    @edsl::dimension("ProfessionalRole", True, True, text_ops, text_kinds)
    role_code: String,

    @edsl::column("state")
    @edsl::dimension("ProfessionalState", True, True, text_ops, text_kinds)
    state: String,

    @edsl::column("street")
    @edsl::dimension("ProfessionalStreet", True, True, text_ops, text_kinds)
    street: String,

    @edsl::column("zip_code")
    @edsl::dimension("ProfessionalZipCode", True, True, text_ops, text_kinds)
    zip_code: String,
};

# ---------------------------------------------------------------------------
# Dogs
# ---------------------------------------------------------------------------

@edsl::entity_id("Dog")
@edsl::entity_source("Dogs", "dg")
@edsl::named_typed_relation_key("dog_breed", Dog.type, Breed.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Dog.type, String.type, "breed_code"), edsl::model_field(Breed.type, String.type, "breed_code")),
])
@edsl::named_typed_relation_key("dog_size", Dog.type, Size.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Dog.type, String.type, "size_code"), edsl::model_field(Size.type, String.type, "size_code")),
])
@edsl::named_typed_relation_key("dog_owner", Dog.type, Owner.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Dog.type, Int.type, "owner_id"), edsl::model_field(Owner.type, Int.type, "owner_id")),
])
type Dog = struct {
    @edsl::column("abandoned_yn")
    @edsl::dimension("AbandonedFlag", True, True, eq_ops, int_kinds)
    abandoned_yn: Int,

    @edsl::column("age")
    @edsl::dimension("DogAge", True, True, range_ops, int_kinds)
    @edsl::measure("MaxDogAge", qb::AggregateFunction::Max, [])
    @edsl::measure("AvgDogAge", qb::AggregateFunction::Avg, [])
    @edsl::measure("MinDogAge", qb::AggregateFunction::Min, [])
    age: Int,

    @edsl::column("breed_code")
    @edsl::dimension("DogBreedCode", True, True, eq_ops, text_kinds)
    breed_code: String,

    @edsl::column("date_adopted")
    @edsl::dimension("DogDateAdopted", True, True, text_ops, text_kinds)
    date_adopted: String,

    @edsl::column("date_arrived")
    @edsl::dimension("DogDateArrived", True, True, text_ops, text_kinds)
    date_arrived: String,

    @edsl::column("date_departed")
    @edsl::dimension("DogDateDeparted", True, True, text_ops, text_kinds)
    date_departed: String,

    @edsl::column("date_of_birth")
    @edsl::dimension("DogDateOfBirth", True, True, text_ops, text_kinds)
    date_of_birth: String,

    @edsl::column("dog_id")
    @edsl::key()
    @edsl::measure("DogCount", qb::AggregateFunction::Count, [])
    dog_id: Int,

    @edsl::column("gender")
    @edsl::dimension("DogGender", True, True, eq_ops, text_kinds)
    gender: String,

    @edsl::column("name")
    @edsl::dimension("DogName", True, True, text_ops, text_kinds)
    name: String,

    @edsl::column("owner_id")
    @edsl::dimension("DogOwnerId", True, True, eq_ops, int_kinds)
    owner_id: Int,

    @edsl::column("size_code")
    @edsl::dimension("DogSizeCode", True, True, eq_ops, text_kinds)
    size_code: String,

    @edsl::column("weight")
    @edsl::dimension("DogWeight", True, True, eq_ops, num_kinds)
    @edsl::measure("AvgDogWeight", qb::AggregateFunction::Avg, [])
    @edsl::measure("MinDogWeight", qb::AggregateFunction::Min, [])
    @edsl::measure("MaxDogWeight", qb::AggregateFunction::Max, [])
    weight: Float,
};

# ---------------------------------------------------------------------------
# Treatments
# ---------------------------------------------------------------------------

@edsl::entity_id("Treatment")
@edsl::entity_source("Treatments", "tr")
@edsl::named_typed_relation_key("treatment_dog", Treatment.type, Dog.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Treatment.type, Int.type, "dog_id"), edsl::model_field(Dog.type, Int.type, "dog_id")),
])
@edsl::named_typed_relation_key("treatment_professional", Treatment.type, Professional.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Treatment.type, Int.type, "professional_id"), edsl::model_field(Professional.type, Int.type, "professional_id")),
])
@edsl::named_typed_relation_key("treatment_type", Treatment.type, TreatmentType.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Treatment.type, String.type, "treatment_type_code"), edsl::model_field(TreatmentType.type, String.type, "treatment_type_code")),
])
type Treatment = struct {
    @edsl::column("cost_of_treatment")
    @edsl::dimension("TreatmentCostAmount", True, True, eq_ops, num_kinds)
    @edsl::measure("TotalTreatmentCost", qb::AggregateFunction::Sum, [])
    @edsl::measure("AvgTreatmentCost", qb::AggregateFunction::Avg, [])
    @edsl::measure("MinTreatmentCost", qb::AggregateFunction::Min, [])
    @edsl::measure("MaxTreatmentCost", qb::AggregateFunction::Max, [])
    cost_of_treatment: Float,

    @edsl::column("date_of_treatment")
    @edsl::dimension("TreatmentDate", True, True, text_ops, text_kinds)
    date_of_treatment: String,

    @edsl::column("dog_id")
    @edsl::dimension("TreatmentDogId", True, True, eq_ops, int_kinds)
    dog_id: Int,

    @edsl::column("professional_id")
    @edsl::dimension("TreatmentProfessionalId", True, True, eq_ops, int_kinds)
    professional_id: Int,

    @edsl::column("treatment_id")
    @edsl::key()
    @edsl::measure("TreatmentCount", qb::AggregateFunction::Count, [])
    treatment_id: Int,

    @edsl::column("treatment_type_code")
    treatment_type_code: String,

};

# ---------------------------------------------------------------------------
# Prepared knowledge payload
# ---------------------------------------------------------------------------

def payload: edsl::PreparedPayload = edsl::build_root(
    "dog-kennels-v1",
    [Breed.type, Charge.type, Size.type, TreatmentType.type, Owner.type, Dog.type, Professional.type, Treatment.type],
    profile,
    authorize,
);

pub use self::{ payload, profile };
