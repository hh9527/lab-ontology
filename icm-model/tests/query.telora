# ---------------------------------------------------------------------------
# 10. Group predicate (HAVING) via the full intent path
# ---------------------------------------------------------------------------

def assert_intent_query: Fn(facade.Intent, String, Array(ScalarValue)) -> Bool = fn(
    intent, expected_sql, expected_bindings
) {
    let query: qb.Query = facade.make_intent_query(intent);
    if query.sql != expected_sql {
        fail!("intent query.sql mismatch", query.sql, expected_sql)
    } else if query.bindings != expected_bindings {
        fail!("intent query.bindings mismatch", query.bindings, expected_bindings)
    } else {
        'True
    }
};

def alarm_having_intent: facade.Intent = {
    measures: [request_measure("AlarmCount")],
    dimensions: [request_dimension("AlarmType")],
    filters: [],
    any_of: [],
    ordering: [
        {target: 'Dimension("AlarmType"), direction: 'Asc},
    ],
    limit: 'None,
    offset: 'None,
    partition: 'None,
    exists: [],
    having: [
        {measure: "AlarmCount", subject: subject, op: 'Gt, threshold: 'Int(2)},
    ],
    group_count: 'None,
    time_windows: 'None,
};

export def test_having = assert_intent_query(
    alarm_having_intent,
    "SELECT count(a.CSN) AS AlarmCount, a.ALARMTYPE FROM T_CURRENT_ALARM AS a GROUP BY a.ALARMTYPE HAVING count(a.CSN) > ? ORDER BY a.ALARMTYPE ASC",
    ['Int(2)],
);

# ---------------------------------------------------------------------------
# 11. Manufacturer value normalisation (known Huawei spellings -> "huawei")
# ---------------------------------------------------------------------------

def server_huawei_request: edsl.QueryRequest = {
    measures: [request_measure("ServerDeviceCount")],
    dimensions: [],
    filters: [
        {id: "ServerManufacturer", subject: subject, op: 'Eq, input: 'Text("huawei")},
    ],
    ordering: [],
    limit: 'None,
    offset: 'None,
    partition: 'None,
};

export def test_manufacturer_normalization = assert_query(
    server_huawei_request,
    "SELECT count(d.id) AS ServerDeviceCount FROM PhysicalServer AS d WHERE CASE WHEN lower(d.manufacturer) = ? THEN ? ELSE CASE WHEN lower(d.manufacturer) = ? THEN ? ELSE CASE WHEN lower(d.manufacturer) = ? THEN ? ELSE d.manufacturer END END END = ?",
    ['String("huawei"), 'String("huawei"), 'String("huawei technologies co., ltd"), 'String("huawei"), 'String("2011"), 'String("huawei"), 'String("huawei")],
);

export def test_manufacturer_deterministic = assert_deterministic(server_huawei_request);

