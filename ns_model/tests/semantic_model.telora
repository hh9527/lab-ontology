use crate::model;
use std::test;
use std::array;

pub def all_ns_datasets_and_relations_are_published: test::Test = test::should_ok(fn() {
    if array::length(model::roots) != 151 || array::length(model::payload.entities) != 151 || array::length(model::payload.relations) != 302 {
        fail!("NS dataset or relation coverage changed")
    } else { () }
});
pub def declared_grain_fields_are_non_nullable: test::Test = test::should_ok(fn() {
    if !array::all(model::payload.entities, fn(entity) {
        array::all(entity.grain_fields, fn(index) { !entity.fields[index].nullable })
    }) { fail!("NS grain field is nullable") } else { () }
});
