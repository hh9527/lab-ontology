# IC 统一模型发布入口
pub mod typed;
use ontology::publication;
use ontology::typed_query;
use ontology::intent;
use std::transform_service as service;
use std::value::{Value};
def input_declarations: Array((String, typed_query::TypeRef)) = [
    (
        "ic::AlarmSeverity",
        typed_query::type_ref(typed::current_alarm::AlarmSeverity.type, intent::ResultType::String)
    ),
    (
        "ic::DeviceClass",
        typed_query::type_ref(typed::inventory::DeviceClass.type, intent::ResultType::String)
    )
];

def program: publication::Program = publication::stage(
    typed::revision,
    typed::roots,
    typed::plan_profile,
    "ic",
    input_declarations
);
type ModelService = struct {
    program: publication::Program
};
impl service::TransformService for ModelService {
    init: fn(ctx) {
        {program}.ty!(Self)
    },
    transform: fn(self, input) {
        publication::dispatch(self.program, input)
    },
};
@service::collection
pub type MainService = struct {
    @service::slot("ontology/model")
    model: ModelService,
};
