# 保留暂定租户／资源／UTC 样本身份，生产唯一性仍待 #51 确认。
use super::inventory as i;
use super::ap_quantities as a;
use super::pon_quantities as p;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::quantity as q;
use ontology::experimental::samples as samples;
use ontology::experimental::transform as t;
use ontology::experimental::values as v;
use ontology::query as qb;
type ResourceId = struct(String);
type Row = struct {
    source_ts: s::DateTimeUtc,
    source_resId: ResourceId,
    source_tenantId: i::TenantId,
    source_parentId: String,
    source_projectId: String,
    source_hwCurrAssStationCount: q::Count,
    source_hwApEthportUpRate: a::KilobitsPerSecond,
    source_hwApEthportDownRate: a::KilobitsPerSecond,
    source_hwAPUpPortPER: p::Percent,
    source_hwCurrAssStationCountEffcnt: a::EffectiveCount,
    source_hwApEthportUpRateEffcnt: a::EffectiveCount,
    source_hwApEthportDownRateEffcnt: a::EffectiveCount,
    source_hwAPUpPortPEREffcnt: a::EffectiveCount,
};
def dataset: m::Dataset(Row) = m::dataset("source_NetworkAPKPI", "NetworkAPKPI", Row.type, ["source_resId", "source_tenantId", "source_ts"]);
def raw: t::Declaration = t::map_columns(t::declare(dataset, [], [
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__ts", s::DateTimeUtc.type, True, g::numeric_filters), g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), "source_NetworkAPKPI__ts", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Hour), "source_NetworkAPKPI_utc_hour", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Day), "source_NetworkAPKPI_utc_day", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Month), "source_NetworkAPKPI_utc_month", True, g::time_filters),
    i::exact(dataset, m::field(Row.type, ResourceId.type, "source_resId"), "source_NetworkAPKPI__resId"),
    i::exact(dataset, m::field(Row.type, i::TenantId.type, "source_tenantId"), "source_NetworkAPKPI__tenantId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_parentId"), "source_NetworkAPKPI__parentId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "source_NetworkAPKPI__projectId"),
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__hwCurrAssStationCount", q::Count.type, True, g::numeric_filters), g::input(m::field(Row.type, q::Count.type, "source_hwCurrAssStationCount")), "source_NetworkAPKPI__hwCurrAssStationCount", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__hwApEthportUpRate", a::KilobitsPerSecond.type, True, g::numeric_filters), g::input(m::field(Row.type, a::KilobitsPerSecond.type, "source_hwApEthportUpRate")), "source_NetworkAPKPI__hwApEthportUpRate", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__hwApEthportDownRate", a::KilobitsPerSecond.type, True, g::numeric_filters), g::input(m::field(Row.type, a::KilobitsPerSecond.type, "source_hwApEthportDownRate")), "source_NetworkAPKPI__hwApEthportDownRate", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__hwAPUpPortPER", p::Percent.type, True, g::numeric_filters), g::input(m::field(Row.type, p::Percent.type, "source_hwAPUpPortPER")), "source_NetworkAPKPI__hwAPUpPortPER", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__hwCurrAssStationCountEffcnt", a::EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, a::EffectiveCount.type, "source_hwCurrAssStationCountEffcnt")), "source_NetworkAPKPI__hwCurrAssStationCountEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__hwApEthportUpRateEffcnt", a::EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, a::EffectiveCount.type, "source_hwApEthportUpRateEffcnt")), "source_NetworkAPKPI__hwApEthportUpRateEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__hwApEthportDownRateEffcnt", a::EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, a::EffectiveCount.type, "source_hwApEthportDownRateEffcnt")), "source_NetworkAPKPI__hwApEthportDownRateEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_NetworkAPKPI__hwAPUpPortPEREffcnt", a::EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, a::EffectiveCount.type, "source_hwAPUpPortPEREffcnt")), "source_NetworkAPKPI__hwAPUpPortPEREffcnt", True, g::numeric_filters),
], []), [
    t::column(m::field(Row.type, s::DateTimeUtc.type, "source_ts"), "ts"),
    t::column(m::field(Row.type, ResourceId.type, "source_resId"), "resId"),
    t::column(m::field(Row.type, i::TenantId.type, "source_tenantId"), "tenantId"),
    t::column(m::field(Row.type, String.type, "source_parentId"), "parentId"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::field(Row.type, q::Count.type, "source_hwCurrAssStationCount"), "hwCurrAssStationCount"),
    t::column(m::field(Row.type, a::KilobitsPerSecond.type, "source_hwApEthportUpRate"), "hwApEthportUpRate"),
    t::column(m::field(Row.type, a::KilobitsPerSecond.type, "source_hwApEthportDownRate"), "hwApEthportDownRate"),
    t::column(m::field(Row.type, p::Percent.type, "source_hwAPUpPortPER"), "hwAPUpPortPER"),
    t::column(m::field(Row.type, a::EffectiveCount.type, "source_hwCurrAssStationCountEffcnt"), "hwCurrAssStationCountEffcnt"),
    t::column(m::field(Row.type, a::EffectiveCount.type, "source_hwApEthportUpRateEffcnt"), "hwApEthportUpRateEffcnt"),
    t::column(m::field(Row.type, a::EffectiveCount.type, "source_hwApEthportDownRateEffcnt"), "hwApEthportDownRateEffcnt"),
    t::column(m::field(Row.type, a::EffectiveCount.type, "source_hwAPUpPortPEREffcnt"), "hwAPUpPortPEREffcnt"),
]);
def declaration: t::Declaration = t::with_samples(t::metric(raw, m::field(Row.type, s::DateTimeUtc.type, "source_ts")), [
    samples::bind(dataset, a::count_statistics, m::field(Row.type, q::Count.type, "source_hwCurrAssStationCount"), [{statistic: samples::Statistic::Mean, publish: "ap_associated_terminals"}, {statistic: samples::Statistic::Max, publish: "ap_associated_terminals_max"}, {statistic: samples::Statistic::Min, publish: "ap_associated_terminals_min"}]),
    samples::bind(dataset, a::rate_statistics, m::field(Row.type, a::KilobitsPerSecond.type, "source_hwApEthportUpRate"), [{statistic: samples::Statistic::Mean, publish: "ap_uplink_tx_rate"}, {statistic: samples::Statistic::Max, publish: "ap_uplink_tx_rate_max"}, {statistic: samples::Statistic::Min, publish: "ap_uplink_tx_rate_min"}]),
    samples::bind(dataset, a::rate_statistics, m::field(Row.type, a::KilobitsPerSecond.type, "source_hwApEthportDownRate"), [{statistic: samples::Statistic::Mean, publish: "ap_uplink_rx_rate"}, {statistic: samples::Statistic::Max, publish: "ap_uplink_rx_rate_max"}, {statistic: samples::Statistic::Min, publish: "ap_uplink_rx_rate_min"}]),
    samples::bind(dataset, p::Percent_statistics, m::field(Row.type, p::Percent.type, "source_hwAPUpPortPER"), [{statistic: samples::Statistic::Mean, publish: "ap_uplink_packet_error_rate"}, {statistic: samples::Statistic::Max, publish: "ap_uplink_packet_error_rate_max"}, {statistic: samples::Statistic::Min, publish: "ap_uplink_packet_error_rate_min"}]),
]);
pub use self::{declaration};
