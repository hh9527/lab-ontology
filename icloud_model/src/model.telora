def alarm_grain: Array(String) = ["csn"];
def kpi_grain: Array(String) = ["res_id", "tenant_id", "ts"];
def port_grain: Array(String) = ["id"];
def interface_kpi_grain: Array(String) = ["res_id", "tenant_id", "ts"];
def number_inputs: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Number];

