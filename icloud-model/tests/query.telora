pub def alarm_window_uses_authoritative_utc_field: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"utc_window","measures":[],"dimensions":["alarm_severity"],"filters":[],"ordering":[],"window":{"dataset":"current_alarm","start":"2024-02-29T00:00:00Z","end":"2024-03-01T00:00:00Z"},"limit":null,"offset":null}`);
    if array::length(string::split(q.sql, "a.OCCURUTC >= ?")) > 1
        && array::length(string::split(q.sql, "a.OCCURUTC < ?")) > 1
        && array::length(string::split(q.sql, "OCCUR_TIME")) == 1
        && array::get(q.bindings, array::length(q.bindings) - 2) == Some(qb::Val::String("2024-02-29T00:00:00Z"))
        && array::get(q.bindings, array::length(q.bindings) - 1) == Some(qb::Val::String("2024-03-01T00:00:00Z")) {
        True
    } else {
        fail!("alarm window must bind only the authoritative UTC field", q)
    }
});

pub def alarm_arrival_window_uses_declared_secondary_clock: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"utc_field_window","measures":[],"dimensions":["alarm_csn"],"filters":[],"ordering":[],"window":{"dataset":"current_alarm","field":"arrive_utc","start":"2024-02-29T00:00:00Z","end":"2024-03-01T00:00:00Z"},"limit":null,"offset":null}`);
    let catalog = edsl::knowledge_index_for_subject(payload, "public");
    let alarms = array::find(catalog, fn(item) { item.id == "current_alarm" });
    let discovered = match alarms {
        Some(entry) => array::any(entry.time_roles, fn(role) {
            role.field == "arrive_utc" && !role.authoritative
                && role.semantics == edsl::TimeSemantics::Utc
                && array::length(role.dimension_ids) == 0
        }),
        None => False,
    };
    if string::contains(q.sql, "a.ARRIVEUTC >= ?")
        && string::contains(q.sql, "a.ARRIVEUTC < ?")
        && !string::contains(q.sql, "a.OCCURUTC >= ?")
        && q.bindings == [qb::Val::String("2024-02-29T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z")]
        && discovered { True }
    else { fail!("arrival window must select the declared secondary clock and remain discoverable", q, alarms) }
});

pub def onu_local_creation_and_utc_sample_windows_compose: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"utc_window","measures":[],"dimensions":["pon_name","onu_receive_usage_sample","onu_kpi_ts"],"filters":[{"dimension":"pon_alias","op":"eq","kind":"text","value":"193.168.8.1/0/5/8"},{"dimension":"pon_class","op":"eq","kind":"text","value":"onu"},{"dimension":"pon_create_ms","op":"ge","kind":"int","value":1718467200000},{"dimension":"pon_create_ms","op":"lt","kind":"int","value":1718467201000}],"ordering":[{"target":"Dimension","id":"onu_kpi_ts","direction":"Asc"}],"window":{"dataset":"onu_kpi","start":"2024-06-01T00:00:00Z","end":"2024-07-01T00:00:00Z"},"limit":1000,"offset":null}`);
    let catalog = edsl::knowledge_index_for_subject(payload, "public");
    let owner = array::find(catalog, fn(entry) { entry.id == "pon_device" });
    let samples = array::find(catalog, fn(entry) { entry.id == "onu_kpi" });
    let roles_ok = match (owner, samples) {
        (Some(device), Some(metric)) =>
            array::any(device.time_roles, fn(role) {
                role.field == "create_time" && role.semantics == edsl::TimeSemantics::Local
                    && role.encoding == edsl::TimeEncoding::LocalEpochMillis
                    && role.dimension_ids == ["pon_create_ms"]
            }) && array::any(metric.time_roles, fn(role) {
                role.field == "ts" && role.authoritative && role.semantics == edsl::TimeSemantics::Utc
            }) && metric.metric_ids == ["onu_receive_usage"],
        _ => False,
    };
    if string::contains(q.sql, "SELECT pd.name, ok.ifInBandRate, ok.ts")
        && string::contains(q.sql, "ok.resId = pd.id")
        && string::contains(q.sql, "pd.createTime >= ?")
        && string::contains(q.sql, "pd.createTime < ?")
        && string::contains(q.sql, "ok.ts >= ?")
        && string::contains(q.sql, "ok.ts < ?")
        && string::contains(q.sql, "ORDER BY ok.ts ASC")
        && !string::contains(q.sql, "avg(")
        && q.bindings == [qb::Val::String("193.168.8.1/0/5/8"), qb::Val::String("ne.category.pon.onu"),
            qb::Val::Int(1718467200000), qb::Val::Int(1718467201000),
            qb::Val::String("2024-06-01T00:00:00Z"), qb::Val::String("2024-07-01T00:00:00Z"), qb::Val::Int(1000)]
        && roles_ok { True }
    else { fail!("ONU trend must preserve two clocks, raw sample, identity relation and discovery", q, owner, samples) }
});

