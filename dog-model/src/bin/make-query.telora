# Host-facing entry for the dog kennel intent-to-SQL resolver.
#
# The Host (bin/dog-make-query) supplies one source, `input`, whose value is the
# JSON intent described in docs/INTENT.md.  This entry lowers that intent to a
# single parameterized SQLite Query and returns it as the public Value:
#
#   {"sql": "...", "bindings": [...]}
#
# This is a pure eval-with entry: no reducer, no effect loop.

import "@src/query" { lower_intent };
import "std/codec" as codec;
import "std/dict" as dict;
import "std/entry" as entry;
import "std/result" as result;
import "std/value" { Value };

def config: entry.ContextConfig = {
    sources: ["input"],
    envs: [],
    args: 'False,
};

export def main = entry.main(config, fn(ctx) {
    match dict.get(ctx.sources, "input") {
        'Some(intent) => {
            let query = lower_intent(intent);
            codec.encode(Value, query) |> result.unwrap
        },
        'None => fail!("missing input intent source"),
    }
});
