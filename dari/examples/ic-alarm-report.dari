// 模型对完整输入按严重级别聚合；take 限制聚合后的类别数。
data ctx = context! { epoch_millis: Context::Now , time_zone: Context::ClientTz };
data windows = time_windows(ctx, {unit:TimeUnit::Day,count:3,mode:WindowMode::Complete});
data start = windows[0].start.epoch_millis;
data end = windows[2].end.epoch_millis;
data rows = query_remote! {
    let a = from(ic::current_alarm);
    let projected = a |> filter(a.alarm_occur_utc_raw >= start)
      |> filter(a.alarm_occur_utc_raw < end)
      |> project({severity:a.alarm_severity,total:a.alarm_count});
    projected
      |> order_by(asc(projected.severity)) |> take(10)
};
data summary = query! {
    let r = from(rows);
    let projected = r |> project({total:sum(r.total)});
    projected |> take_opt()
};


report report = tree! { Report(title = "告警构成") [
    h1 ["最近三个完整日告警构成"],
    p ["口径：客户端日历时区，三个完整日，按发生时间筛选，全量告警聚合"],
    p ["告警总数：",Value(data = summary,field = project!(total))],
    PieChart(data = rows, spec = {
    x:project!(severity),value:project!(total),title:"最近三个完整日告警构成",
    allow_no_data:True,style:{labels:True}
}),Table(data = rows, spec = {
    columns:["severity","total"],labels:{severity:"严重级别",total:"告警数"},allow_no_data:True
})
]};
answer tree! { Answer [UseReport(ref = report)]};
