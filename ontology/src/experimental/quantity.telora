# RFC 0002 的单位计算实验；运算签名列举当前支持的可计算关系。
# 使用 Float 表示物理量，避免整数除法改变速率结果。
type Bytes = struct(Float);
type Seconds = struct(Float);
type Milliseconds = struct(Float);
type BytesPerSecond = struct(Float);

def seconds: Fn(Milliseconds) -> Seconds = fn(value) { Seconds(value.0 / 1000.0) };
def add_bytes: Fn(Bytes, Bytes) -> Bytes = fn(left, right) { Bytes(left.0 + right.0) };

# 非正时长没有速率；缺失结果由调用方显式处理，不能冒充零速率。
def rate: Fn(Bytes, Seconds) -> Option(BytesPerSecond) = fn(amount, duration) {
    if duration.0 > 0.0 { Some(BytesPerSecond(amount.0 / duration.0)) } else { None }
};

# 逐样本速率的平均值与累计量／累计时长是两个独立业务口径。
type Sample = struct { amount: Bytes, duration: Seconds };
use std::array as array;
def mean_rate: Fn(Array(Sample)) -> Option(BytesPerSecond) = fn(samples) {
    let rates = array::fold(samples, [].ty!(Array(BytesPerSecond)), fn(values, sample) {
        match rate(sample.amount, sample.duration) {
            Some(value) => array::push(values, value), None => values,
        }
    });
    if array::length(rates) == 0 { None }
    else {
        let sum = array::fold(rates, 0.0, fn(total, value) { total + value.0 });
        # 同时累计 Float 个数，避免依赖隐式 Int -> Float 转换。
        let count = array::fold(rates, 0.0, fn(total, value) { total + 1.0 });
        Some(BytesPerSecond(sum / count))
    }
};
def weighted_rate: Fn(Array(Sample)) -> Option(BytesPerSecond) = fn(samples) {
    let valid = array::filter(samples, fn(sample) { sample.duration.0 > 0.0 });
    let amount = array::fold(valid, Bytes(0.0), fn(total, sample) { add_bytes(total, sample.amount) });
    let duration = array::fold(valid, 0.0, fn(total, sample) { total + sample.duration.0 });
    rate(amount, Seconds(duration))
};

pub use self::{Bytes, Seconds, Milliseconds, BytesPerSecond, Sample,
    seconds, add_bytes, rate, mean_rate, weighted_rate};
