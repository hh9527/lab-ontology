# ontology 与数据流水线语言共享的逻辑概念；不包含领域模型名称。
use std::prelude as prelude;
use std::type_desc as td;
use std::type_property as property;
use std::array as array;
@prelude::property(PropertyTarget::Type)
type Identity = struct {name:String};
def identity: Fn(String) -> Fn(Type, Option(Identity)) -> Identity = fn(name) {
    if !array::any(["Percent","Ratio","EpochMillis","DateTimeUtc","DateTimeTz","TimeZone"],fn(known){known == name}) {fail!("unknown shared type",name)} else { () };
    fn(ctx,previous){if previous != None {fail!("shared type identity must be declared once",ctx)} else {{name}}}
};
def direct: Fn(Type) -> Option(String) = fn(ty) {
    match property::get_type_prop(ty,Identity.type){Some(value)=>Some(value.name),None=>None}
};
def semantic: Fn(Type) -> Option(String) = fn(ty) {
    match direct(ty) {
        Some(name)=>Some(name),
        None=>do {
            let body=if td::kind(ty) == td::TypeDescKind::Ref {match td::resolve(ty){Ok(value)=>value,Err(error)=>fail!(error.message)}} else {ty};
            if td::kind(body) == td::TypeDescKind::Newtype {semantic(td::children(body)[0])} else {None}
        },
    }
};
pub use self::{Identity,identity,direct,semantic};
