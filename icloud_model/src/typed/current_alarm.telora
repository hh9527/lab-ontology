]), [severity_dimension, cleared_dimension, change_flag_dimension, source_CLEARCATEGORY_dimension, source_ACKED_dimension, source_EVENTTYPE_dimension]);
def total: t::FieldCount(Row) = t::field_count(dataset, m::field(Row.type, Int.type, "csn"), "alarm_count");
def opened: t::FieldCount(Row) = t::filtered_count(t::field_count(dataset, m::field(Row.type, Int.type, "csn"), "alarm_open_count"), cleared_dimension, AlarmCleared("uncleared"));
def critical: t::FieldCount(Row) = t::filtered_count(t::field_count(dataset, m::field(Row.type, Int.type, "csn"), "critical_alarm_count"), severity_dimension, AlarmSeverity("critical"));
def major: t::FieldCount(Row) = t::filtered_count(t::field_count(dataset, m::field(Row.type, Int.type, "csn"), "major_alarm_count"), severity_dimension, AlarmSeverity("major"));
def severe: t::ComputedCount(Row) = t::combine_counts("critical_or_major_alarm_count", qb::ComputedOp::Add, t::count_ref(critical), t::count_ref(major));
# 算术组合不推断业务人口；这个结果是分数，不能当作告警数。
def weighted_score: t::ComputedCount(Row) = t::combine_counts("weighted_severe_alarm_score", qb::ComputedOp::Add, t::computed_count_ref(severe), t::count_ref(critical));
def declaration: t::Declaration = t::with_computed_counts(t::with_field_counts(t::event(base, m::field(Row.type, s::EpochMillis.type, "occur_utc")), [total, opened, critical, major]), [severe, weighted_score]);
