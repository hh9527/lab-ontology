# Deterministic assertion over the intent path.
def assert_deterministic_intent: Fn(facade.Intent) -> Bool = fn(intent) {
    let first: qb.Query = facade.make_intent_query(intent);
    let second: qb.Query = facade.make_intent_query(intent);
    if first == second { 'True } else {
        fail!("intent query is not deterministic")
    }
};

export def test_exists_deterministic = assert_deterministic_intent(net_exists_min2_intent);

