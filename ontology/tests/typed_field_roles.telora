# 同一业务事实经 World 发布；称谓不自动升级为指代。
use crate::ontology as edsl;
use crate::model as m;
use crate::transform as t;
use crate::knowledge as k;
use crate::world as w;
use crate::query as qb;
use std::array as array;
use std::test as test;
use std::value::{Value};

type Identity = struct { tenant: String, local: String };
@edsl::reference("scoped", ["tenant", "local"])
type Row = struct {
    tenant: String,
    local: String,
    @edsl::field_role(edsl::FieldRole::Appellation)
    name: String,
    @edsl::field_role(edsl::FieldRole::Appellation)
    @edsl::field_role(edsl::FieldRole::Classification)
    category: String,
    @edsl::field_role(edsl::FieldRole::Metric)
    amount: Float,
    unclassified_number: Int,
};
def dataset: m::Dataset(Row) = m::dataset("objects", "objects", Row.type, ["tenant", "local"]);
def entity: m::Entity(Identity) = m::entity("object", Identity.type);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [
    m::identity_part(m::field(Row.type, String.type, "tenant"), m::field(Identity.type, String.type, "tenant")),
    m::identity_part(m::field(Row.type, String.type, "local"), m::field(Identity.type, String.type, "local")),
]);
def declaration: t::Declaration = t::declare(dataset, [subject], [], []);
def profile: qb::PlanProfile = {allowed_operators: [], allowed_join_kinds: [], allowed_aggregates: [], allowed_scalars: [], allow_distinct: False};
def world: w::World = w::define("field-roles", [declaration], [], [], [], profile);
def prepared: t::Prepared = w::prepare(world);
pub def publication: Value = w::publication(world, prepared);
def roles: Fn(String) -> Array(edsl::FieldRole) = fn(name) {
    let e = prepared.payload.entities[0];
    let f = match array::find(e.fields, fn(f) { f.name == name }) { Some(f) => f, None => fail!(name) };
    k::field_business_roles(declaration, e, f, edsl::collect_references(Row.type, e.fields))
};
pub def appellation_does_not_promise_identity: test::Test = test::should_ok(fn() { roles("name") == [edsl::FieldRole::Appellation] });
pub def roles_can_overlap: test::Test = test::should_ok(fn() { roles("category") == [edsl::FieldRole::Appellation, edsl::FieldRole::Classification] });
pub def reference_keeps_all_parts: test::Test = test::should_ok(fn() {
    edsl::collect_references(Row.type, prepared.payload.entities[0].fields) == [{id: "scoped", fields: ["tenant", "local"]}]
        && roles("tenant") == [edsl::FieldRole::Reference] && roles("local") == [edsl::FieldRole::Reference]
});
pub def numeric_storage_does_not_imply_metric: test::Test = test::should_ok(fn() {
    roles("amount") == [edsl::FieldRole::Metric] && roles("unclassified_number") == []
});
