# ---------------------------------------------------------------------------

def device_top_site_intent: facade.Intent = {
    measures: [request_measure("DeviceCount")],
    dimensions: [
        request_dimension("DeviceTenantId"),
        request_dimension("DeviceSiteId"),
    ],
    filters: [],
    any_of: [],
    ordering: [
        {target: 'Measure("DeviceCount"), direction: 'Desc},
        {target: 'Dimension("DeviceSiteId"), direction: 'Asc},
    ],
    limit: 'None,
    offset: 'None,
    partition: 'Some({by: ["DeviceTenantId"], take: 1}),
    exists: [],
    having: [],
    group_count: 'None,
};

export def test_unified_device_top_site_per_tenant = assert_intent_query(
    device_top_site_intent,
    "SELECT DeviceCount, __q_1, __q_2 FROM (SELECT count(u.device_id) AS DeviceCount, u.tenant_id AS __q_1, u.site_id AS __q_2, row_number() OVER (PARTITION BY u.tenant_id ORDER BY count(u.device_id) DESC, u.site_id ASC) AS __q_rn FROM (SELECT n.id AS device_id, n.refParentSubnet AS site_id, n.tenantId AS tenant_id FROM EntNetworkElement AS n UNION ALL SELECT p.id AS device_id, p.refParentSubnet AS site_id, p.tenantId AS tenant_id FROM EntPonElement AS p UNION ALL SELECT s.id AS device_id, s.refParentSubnet AS site_id, s.tenantId AS tenant_id FROM PhysicalServer AS s UNION ALL SELECT g.id AS device_id, g.refParentSubnet AS site_id, g.tenantId AS tenant_id FROM HuaweiStorageDevice AS g UNION ALL SELECT t.resId AS device_id, t.siteId AS site_id, t.tenantId AS tenant_id FROM EntTerminalElement AS t) AS u GROUP BY u.tenant_id, u.site_id) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_1 ASC, DeviceCount DESC, __q_2 ASC",
    ['Int(1)],
);

export def test_unified_device_top_site_deterministic = assert_deterministic_intent(device_top_site_intent);

