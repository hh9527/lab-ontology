use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::fc_switch_device;
@domain::subject("Fabric", "id")
@domain::dataset("fabric", "SYS_Fabric", ["id"])
@domain::relations(relations)
pub type Fabric = struct {
    @g::field_view(g::dimension_group("fabric/id", ids::FabricById.type, True, [g::Filter::Eq]), "fa_id", True, [g::Filter::Eq])
    @domain::count("fa_count")
    id: ids::FabricById,
    @g::field_view(g::dimension_group("fabric/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "fa_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @m::column("objSysId")
    @g::field_view(g::dimension_group("fabric/obj_sys_id", String.type, True, [g::Filter::Eq]), "fa_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(String),
    @m::column("zoneNum")
    @g::field_view(g::dimension_group("fabric/zone_num", String.type, True, [g::Filter::Eq]), "fa_zone_num", True, [g::Filter::Eq])
    zone_num: Option(String),
    @m::column("switchNum")
    @g::field_view(g::dimension_group("fabric/switch_num", String.type, True, [g::Filter::Eq]), "fa_switch_num", True, [g::Filter::Eq])
    switch_num: Option(String),
    @g::field_view(g::dimension_group("fabric/wwn", domain::Reference(ids::FcSwitchDeviceBySn).type, True, [g::Filter::Eq, g::Filter::Ne]), "fa_wwn", True, [g::Filter::Eq, g::Filter::Ne])
    wwn: Option(domain::Reference(ids::FcSwitchDeviceBySn)),
    @m::column("typeId")
    @g::field_view(g::dimension_group("fabric/type_id", String.type, True, [g::Filter::Eq]), "fa_type_id", True, [g::Filter::Eq])
    type_id: String,
};

pub def relations: Array(r::Relation) = [
    r::relation("fsd__fa_rev", domain::endpoint(Fabric.type, "wwn"), domain::endpoint(fc_switch_device::FcSwitchDevice.type, "sn"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
