{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "mcp": {
    "ontology": {
      "type": "remote",
      "url": "http://127.0.0.1:18016/mcp",
      "enabled": true
    }
  },
  "tools": {
    "*": false,
    "ontology_index": true,
    "ontology_info": true,
    "ontology_transform": true
  },
  "permission": {
    "*": "deny",
    "ontology_index": "allow",
    "ontology_info": "allow",
    "ontology_transform": "allow"
  }
}
