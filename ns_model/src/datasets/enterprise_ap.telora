    @g::field_view(g::dimension_group("enterprise-ap/obj_sys_id", domain::Reference(ids::EnterpriseApByObjSysId).type, True, [g::Filter::Eq]), "ea_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: Option(domain::Reference(ids::EnterpriseApByObjSysId)),
