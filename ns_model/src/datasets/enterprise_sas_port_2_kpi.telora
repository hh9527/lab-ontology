use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::storage_port;
use crate::datasets::kpi_storage_enterprise_sas_port;
@domain::subject("StoragePort", "obj_sys_id")
@domain::dataset("enterprise-sas-port-2-kpi", "enterpriseSasPort2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseSasPort2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-sas-port-2-kpi/obj_sys_id", ids::CloudBlockNetPort2KpiByObjSysId.type, True, [g::Filter::Eq]), "esp2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("esp2_count")
    obj_sys_id: ids::CloudBlockNetPort2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-sas-port-2-kpi/obj_id", domain::Reference(ids::EnterpriseSasPort2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "esp2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseSasPort2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("esp2__stpo", domain::endpoint(EnterpriseSasPort2Kpi.type, "obj_sys_id"), domain::endpoint(storage_port::StoragePort.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("esp2__sesp", domain::endpoint(EnterpriseSasPort2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_sas_port::KpiStorageEnterpriseSasPort.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
