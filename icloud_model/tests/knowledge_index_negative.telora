use crate::model::{ payload };
use ontology::knowledge as knowledge;
use std::value::{ Value };
use std::test as test;

pub def cached_index_rejects_obsolete_pagination_fields: test::Test = test::should_fail_with(fn() {
    let index = knowledge::knowledge_index_method_factory(payload, "public");
    index(Value::Object({offset: Value::Int(-1), limit: Value::Int(3)}))
}, "knowledge request contains unsupported field");
