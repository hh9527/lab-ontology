# ontology/tests/query.telora
#
# Public contract checks for the QueryBuilder package: closed operator
# vocabulary, profile coverage, structural validity, deterministic SQLite
# lowering, binding order, and the untagged-scalar JSON codec boundary of
# `Val`/`Query`. Each exported Test executes its assertions in its own thunk.

import "std/array" as array;
import "std/test" as test;
import "std/string" as string;
import "std/codec" as codec;
import "std/dict" as dict;
import "std/json" as json;
import "std/value" { Value };
import "@src/query" as qb;

export def validate_rejects_profile_case = test.should_fail_with(fn() {
    qb.validate(demo_plan(), restricted_profile())
}, "plan uses capabilities not allowed by the profile");

export def lowering_rejects_invalid_projection_case = test.should_fail_with(fn() {
    qb.transform_sqlite(bad_arity_plan())
}, "plan projection contains an invalid expression");

export def scalar_fixtures = test.with_fixtures([
    "fixtures/scalar-int.json", "fixtures/scalar-null.json",
], fn(value) {
    test.should_ok(fn() {
        let decoded = codec.decode(qb.Val.type, value).unwrap!();
        let encoded = codec.encode(Value.type, decoded);
        if encoded == value { True } else { fail!("scalar roundtrip mismatch", value, encoded) }
    })
});

export def non_scalar_result_fixtures = test.with_fixtures([
    "fixtures/non-scalar-object.json", "fixtures/non-scalar-array.json",
], fn(value) {
    test.should_ok(fn() {
        match codec.decode(qb.Val.type, value) {
            Err(_) => True,
            Ok(_) => fail!("non-scalar accepted", value),
        }
    })
});

export def non_scalar_raise_fixtures = test.with_fixtures([
    "fixtures/non-scalar-object.json", "fixtures/non-scalar-array.json",
], fn(value) {
    test.should_fail(fn() { codec.decode(qb.Val.type, value).unwrap!() })
});

# ---------------------------------------------------------------------------
# JSON codec boundary helpers (Val <-> untagged scalar JSON).
# ---------------------------------------------------------------------------

def encode_val: Fn(qb.Val) -> Value = fn(val) {
    codec.encode(Value.type, val)
};
def decode_val: Fn(Value) -> qb.Val = fn(value) {
    codec.decode(qb.Val.type, value).unwrap!()
};
def val_roundtrip: Fn(qb.Val) -> Bool = fn(val) {
    decode_val(encode_val(val)) == val
};

# Parse a JSON scalar text and decode it back to a Val (dispatch check).
def json_to_val: Fn(String) -> qb.Val = fn(text) {
    let parsed = json.parse(text).unwrap!();
    decode_val(parsed)
};

# A scalar JSON value: String/Int/Float/True/False/None. Any Array/Object or
# wrapper object (e.g. {"Int": 3}) is not a native scalar.
def is_scalar_value: Fn(Value) -> Bool = fn(value) {
    match value {
        Value.String(_) => True,
        Value.Int(_) => True,
        Value.Float(_) => True,
        Value.True => True,
        Value.False => True,
        Value.None => True,
        _ => False,
    }
};

# Encode a Query across the codec boundary and check that `bindings` is a
# native scalar array with no variant wrappers.
def query_bindings_are_scalar_array: Fn(qb.Query) -> Bool = fn(query) {
    let encoded = codec.encode(Value.type, query);
    match encoded {
        Value.Object(fields) => match dict.get(fields, "bindings") {
            Some(Value.Array(items)) => array.all(items, is_scalar_value),
            _ => False,
        },
        _ => False,
    }
};

def query_encoded_bindings_match: Fn(qb.Query, Array(qb.Val)) -> Bool = fn(query, expected) {
    let encoded = codec.encode(Value.type, query);
    match encoded {
        Value.Object(fields) => match dict.get(fields, "bindings") {
            Some(Value.Array(items)) => array.map(items, decode_val) == expected,
            _ => False,
        },
        _ => False,
    }
};


def full_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [
            qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Aggregate,
            qb.Operator.Filter, qb.Operator.Exists, qb.Operator.Join, qb.Operator.Group, qb.Operator.Having, qb.Operator.Order, qb.Operator.Limit,
            qb.Operator.Offset, qb.Operator.Partition,
        ],
        allowed_join_kinds: [qb.JoinKind.Inner, qb.JoinKind.Left],
        allowed_aggregates: [qb.AggregateFunction.Count, qb.AggregateFunction.Sum, qb.AggregateFunction.Avg, qb.AggregateFunction.Min, qb.AggregateFunction.Max],
        allowed_scalars: [qb.ScalarFunction.Substr, qb.ScalarFunction.Instr, qb.ScalarFunction.If, qb.ScalarFunction.Add, qb.ScalarFunction.Sub, qb.ScalarFunction.Lower, qb.ScalarFunction.Length, qb.ScalarFunction.JsonExtract, qb.ScalarFunction.JsonType, qb.ScalarFunction.JsonValid, qb.ScalarFunction.Eq, qb.ScalarFunction.Ne, qb.ScalarFunction.Lt, qb.ScalarFunction.Le, qb.ScalarFunction.Gt, qb.ScalarFunction.Ge, qb.ScalarFunction.And, qb.ScalarFunction.Or, qb.ScalarFunction.Not],
        allow_distinct: True,
    };
    profile
};

def simple_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Order],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Substr],
        allow_distinct: True,
    };
    profile
};

def no_distinct_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Aggregate],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Substr],
        allow_distinct: False,
    };
    profile
};

def restricted_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Bind, qb.Operator.Scalar, qb.Operator.Order],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Substr],
        allow_distinct: True,
    };
    profile
};

def demo_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-demo",
        sources: [qb.source("o", "orders")],
        projection: [
            qb.expr_item(qb.column("o", "customer_id")),
            qb.expr_item(qb.substr([qb.column("o", "name"), qb.bind_int(1), qb.bind_int(3)])),
            qb.aggregate(qb.AggregateFunction.Sum, qb.column("o", "total"), False, "total_sum"),
        ],
        filter: Some(qb.scalar(qb.ScalarFunction.Gt, [qb.column("o", "total"), qb.bind_float(100.0)])),
        joins: [
            qb.join(
                qb.JoinKind.Inner,
                qb.source("c", "customers"),
                qb.column_ref("o", "customer_id"),
                qb.column_ref("c", "id"),
            ),
        ],
        grouping: [qb.column("o", "customer_id")],
        ordering: [qb.asc(qb.column("o", "customer_id"))],
        limit: Some(10),
        offset: None,
        exists: [],
        having: [],
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

