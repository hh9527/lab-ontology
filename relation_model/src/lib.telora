mod model;
pub mod typed_relations;

pub use crate::typed_relations::{ payload };
use crate::typed_relations::{prepared};
use ontology::intent as intent;
use ontology::experimental::build as build;
use ontology::sqlite as sqlite;
use std::transform_service as service;
use std::http as http;
use std::value::{ Value };

def lower: Fn(Value) -> Value = build::stage(fn() { prepared }, fn(payload) {
    intent::query_request_method_factory(payload, sqlite::build_query)
});

type QueryService = struct { lower: Fn(Value) -> Value };
impl service::TransformService for QueryService {
    init: fn(ctx) {
        { lower: lower }.ty!(Self)
    },
    transform: fn(self, input) { self.lower(input) },
};

@service::collection
pub type MainService = struct {
    @service::slot("relation/transform") @http::post("/relation/transform") query: QueryService,
};
