use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::diagnostics as diagnostics;
use std::test as test;
use std::codec as codec;
use std::value::{Value};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Column, qb::Operator::Bind,
        qb::Operator::Scalar, qb::Operator::Filter],
    allowed_join_kinds: [], allowed_aggregates: [],
    allowed_scalars: [
        qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Gt,
        qb::ScalarFunction::Ge, qb::ScalarFunction::Lt, qb::ScalarFunction::Le,
        qb::ScalarFunction::Instr, qb::ScalarFunction::Lower, qb::ScalarFunction::Substr,
        qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Length,
        qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not,
        qb::ScalarFunction::IsNotNull, qb::ScalarFunction::If, qb::ScalarFunction::BinaryText,
        qb::ScalarFunction::RegexMatch,
    ], allow_distinct: False,
};

