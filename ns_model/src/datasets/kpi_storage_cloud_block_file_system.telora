    @g::utc_bucket_view("scbfs_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("scbfs_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("scbfs_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("TOTALCAPACITY")
    @g::field_view(g::dimension_group("kpi-storage-cloud-block-file-system/totalcapacity", metric::KpiStorageCloudBlockFileSystemTotalcapacity.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "scbfs_totalcapacity_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-storage-cloud-block-file-system/totalcapacity", metric::KpiStorageCloudBlockFileSystemTotalcapacity.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("GB")), [{statistic: samples::Statistic::Mean, publish: "scbfs_totalcapacity"}, {statistic: samples::Statistic::Max, publish: "scbfs_totalcapacity_max"}, {statistic: samples::Statistic::Min, publish: "scbfs_totalcapacity_min"}])
    totalcapacity: Option(metric::KpiStorageCloudBlockFileSystemTotalcapacity),
    @m::column("USEDCAPACITY")
    @g::field_view(g::dimension_group("kpi-storage-cloud-block-file-system/usedcapacity", metric::KpiStorageCloudBlockFileSystemUsedcapacity.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "scbfs_usedcapacity_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-storage-cloud-block-file-system/usedcapacity", metric::KpiStorageCloudBlockFileSystemUsedcapacity.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("GB")), [{statistic: samples::Statistic::Mean, publish: "scbfs_usedcapacity"}, {statistic: samples::Statistic::Max, publish: "scbfs_usedcapacity_max"}, {statistic: samples::Statistic::Min, publish: "scbfs_usedcapacity_min"}])
    usedcapacity: Option(metric::KpiStorageCloudBlockFileSystemUsedcapacity),
    @m::column("USAGE")
    @g::field_view(g::dimension_group("kpi-storage-cloud-block-file-system/usage", metric::KpiStorageCloudBlockFileSystemUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "scbfs_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-storage-cloud-block-file-system/usage", metric::KpiStorageCloudBlockFileSystemUsage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "scbfs_usage"}, {statistic: samples::Statistic::Max, publish: "scbfs_usage_max"}, {statistic: samples::Statistic::Min, publish: "scbfs_usage_min"}])
    usage: Option(metric::KpiStorageCloudBlockFileSystemUsage),
