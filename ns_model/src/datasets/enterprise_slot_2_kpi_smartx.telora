use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::enterprise_slot;
use crate::datasets::kpi_network_video_backhaul_switch;
@domain::subject("EnterpriseSlot", "obj_sys_id")
@domain::dataset("enterprise-slot-2-kpi-smartx", "EnterpriseSlot2kpi_smartx", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseSlot2KpiSmartx = struct {
    @m::column("objSysId")
    @g::field_view(g::dimension_group("enterprise-slot-2-kpi-smartx/obj_sys_id", ids::EnterpriseSlotById.type, True, [g::Filter::Eq]), "es2s_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("es2s_count")
    obj_sys_id: ids::EnterpriseSlotById,
    @g::field_view(g::dimension_group("enterprise-slot-2-kpi-smartx/obj_id", domain::Reference(ids::KpiNetworkVideoBackhaulSwitchByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "es2s_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::KpiNetworkVideoBackhaulSwitchByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("es__es2s_rev", domain::endpoint(EnterpriseSlot2KpiSmartx.type, "obj_sys_id"), domain::endpoint(enterprise_slot::EnterpriseSlot.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("es2s__nvbs", domain::endpoint(EnterpriseSlot2KpiSmartx.type, "obj_id"), domain::endpoint(kpi_network_video_backhaul_switch::KpiNetworkVideoBackhaulSwitch.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
