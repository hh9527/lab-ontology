pub mod model;
pub mod source_audit;

use crate::model::{ payload };
use ontology::intent as intent;
use ontology::knowledge as knowledge;
use ontology::sqlite as sqlite;
use std::transform_service as service;
use std::http as http;
use std::value::{ Value };

type QueryService = struct { lower: Fn(Value) -> Value };
impl service::TransformService for QueryService {
    init: fn(ctx) {
        { lower: intent::query_request_method_factory(payload, sqlite::build_query) }.ty!(Self)
    },
    transform: fn(self, input) { self.lower(input) },
};

type DocService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for DocService {
    init: fn(ctx) {
        { handle: knowledge::knowledge_info_method_factory(payload) }.ty!(Self)
    },
    transform: fn(self, input) { self.handle(input) },
};

type DiscoveryService = struct { handle: Fn(Value) -> Value };
impl service::TransformService for DiscoveryService {
    init: fn(ctx) {
        { handle: knowledge::knowledge_discovery_method_factory(payload) }.ty!(Self)
    },
    transform: fn(self, input) { self.handle(input) },
};

@service::collection
pub type MainService = struct {
    @service::slot("ic/transform") @http::post("/ic/transform") query: QueryService,
    @service::slot("ic/info") @http::post("/ic/info") doc: DocService,
    @service::slot("ic/discovery") @http::post("/ic/discovery") discovery: DiscoveryService,
};
