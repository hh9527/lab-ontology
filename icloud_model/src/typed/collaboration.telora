use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 协作设备来源：没有 CPU 样本或度量，不把缺失指标当作零。
use super::inventory as i;
use super::current_alarm as alarm;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
type CollaborationId = struct(String);
@registry::entity("collaboration_entity")
type Identity = struct {
    id: CollaborationId
};
@registry::dataset("source_EntCollaborationElement", "I_EntCollaborationElement", ["source_id"])
@registry::roles([subject, tenant])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::time_filters),
            g::input(
                m::field(IEntCollaborationElement.type, s::EpochMillis.type, "source_createTime")
            ),
            "source_EntCollaborationElement__createTime",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(
                g::input(m::field(IEntCollaborationElement.type, String.type, "source_ipAddress"))
            ),
            "source_EntCollaborationElement__ipAddress_ipv4",
            True,
            g::ipv4_filters
        ),
    ]
)
@registry::relations(relations)
type IEntCollaborationElement = struct {
    @m::column("tenantId")
    @g::exact("source_EntCollaborationElement__tenantId")
    source_tenantId: i::TenantId,
    @m::column("name")
    @g::search("source_EntCollaborationElement__name")
    source_name: String,
    @m::column("createTime")
    source_createTime: s::EpochMillis,
    @m::column("remark")
    @g::search("source_EntCollaborationElement__remark")
    source_remark: String,
    @m::column("id")
    @g::exact("source_EntCollaborationElement__id")
    source_id: CollaborationId,
    @m::column("parentResId")
    @g::exact("source_EntCollaborationElement__parentResId")
    source_parentResId: String,
    @m::column("projectId")
    @g::exact("source_EntCollaborationElement__projectId")
    source_projectId: String,
    @m::column("operState")
    @v::classification(
        SourceEntCollaborationElementOperState_domain,
        "source_EntCollaborationElement__operState"
    )
    source_operState: String,
    @m::column("version")
    @g::search("source_EntCollaborationElement__version")
    source_version: String,
    @m::column("productName")
    @g::search("source_EntCollaborationElement__productName")
    source_productName: String,
    @m::column("classification")
    @v::classification(
        SourceEntCollaborationElementClassification_domain,
        "source_EntCollaborationElement__classification"
    )
    source_classification: String,
    @m::column("ipAddress")
    @g::search("source_EntCollaborationElement__ipAddress")
    source_ipAddress: String,
    @m::column("mac")
    @g::search("source_EntCollaborationElement__mac")
    source_mac: String,
    @m::column("sn")
    @g::search("source_EntCollaborationElement__sn")
    source_sn: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(IEntCollaborationElement) = registry::dataset_of(
    IEntCollaborationElement.type
);
def subject: m::Role(IEntCollaborationElement) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(IEntCollaborationElement.type, CollaborationId.type, "source_id"),
            m::field(Identity.type, CollaborationId.type, "id")
        )
    ]
);
def tenant: m::Role(IEntCollaborationElement) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(IEntCollaborationElement.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def alarm_reference: m::Role(alarm::TCurrentAlarm) = m::role(
    alarm::dataset,
    entity,
    "collaboration",
    False,
    [
        m::reference_part(
            m::field(alarm::TCurrentAlarm.type, String.type, "res_id"),
            m::field(Identity.type, CollaborationId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourceEntCollaborationElementOperState = enum {
    @ev::rename("0")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("3")
    @ev::description("Offline", "离线")
    Offline,
};
def SourceEntCollaborationElementOperState_domain: v::Domain(
    SourceEntCollaborationElementOperState,
    String
) = v::from_enum(
    "SourceEntCollaborationElementOperState",
    SourceEntCollaborationElementOperState.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceEntCollaborationElementClassification = enum {
    @ev::rename("Collaboration")
    @ev::description("Collaboration", "协作终端")
    Collaboration,
};
def SourceEntCollaborationElementClassification_domain: v::Domain(
    SourceEntCollaborationElementClassification,
    String
) = v::from_enum(
    "SourceEntCollaborationElementClassification",
    SourceEntCollaborationElementClassification.type,
    String.type,
    False
);
def relations: Array(r::Relation) = [
    r::relation(
        "source_EntCollaborationElement_T_CURRENT_ALARM",
        r::endpoint(dataset.row, subject.id),
        r::endpoint(alarm::dataset.row, alarm_reference.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EntCollaborationElement_X_TENANT_VIEW",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{dataset, alarm_reference, relations};

pub use self::{IEntCollaborationElement, Identity};
