    )
    source_packetLossRateEffcnt: a::EffectiveCount,
    @m::column("connectedTerminalsEffcnt")
    @g::field_view(
        g::dimension_group(
            "source_NetworkApRadioKPI__connectedTerminalsEffcnt",
