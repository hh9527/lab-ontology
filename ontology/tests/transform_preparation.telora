use crate::ontology as edsl;
use crate::intent as intent;
use crate::query as qb;
use crate::sqlite as sqlite;
use std::test as test;
use std::json as json;
use std::string as string;

@edsl::entity_id("item")
@edsl::entity_source("items", "item")
type QueryWithUnfinishedKnowledge = struct {
    @edsl::column("id")
    @edsl::key()
    @edsl::dimension("item_id", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    @edsl::measure_description("unfinished", "Unfinished knowledge", "Not a query dependency")
    id: String,
};
def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source,
        qb::Operator::Project,
        qb::Operator::Column,
        qb::Operator::Bind,
        qb::Operator::Scalar,
        qb::Operator::Filter
    ],
    allowed_join_kinds: [],
    allowed_aggregates: [],
    allowed_scalars: [qb::ScalarFunction::Eq],
    allow_distinct: False,
};
pub def transform_does_not_prepare_knowledge_descriptions: test::Test = test::should_ok(
    fn() {
        let payload = edsl::build_transform_root(
            "transform-only",
            [QueryWithUnfinishedKnowledge.type],
            profile
        );
        let lower = intent::query_intent_lower_factory(payload, sqlite::build_query);
        let query = lower(
            json::parse(
                r#"{
        "op":"Graph", "root":"i", "nodes":[{"id":"i","entity":"item"}],
        "edges":[], "select":[{"node":"i","dimension":"item_id"}],
        "filters":[{"node":"i","dimension":"item_id","op":"Eq","value":"x"}]
    }"#
            ).unwrap!()
        );
        string::contains(query.sql, "items AS i") && query.bindings == [qb::Val::String("x")]
    }
);
pub def transform_still_enforces_filter_profile: test::Test = test::should_fail_with(
    fn() {
        edsl::build_transform_root(
            "no-eq",
            [QueryWithUnfinishedKnowledge.type],
            profile <~ {allowed_scalars: []}
        )
    },
    "declared dimension filter uses capabilities not allowed by the query profile"
);

@edsl::entity_source("bad", "bad")
type NullableKey = struct {
    @edsl::column("id")
    @edsl::key()
    id: Option(String)
};
pub def transform_still_enforces_nonnull_identity: test::Test = test::should_fail_with(
    fn() {
        edsl::build_transform_root("nullable-key", [NullableKey.type], profile)
    },
    "key identity cannot be nullable"
);
