use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::enterprise_network_ltp;
use crate::datasets::network_element;
@domain::subject("NetworkElement", "id")
@domain::dataset("remote-network-element", "EntRemoteNetworkElement", ["id"])
@domain::relations(relations)
pub type RemoteNetworkElement = struct {
    @m::column("refParentNE")
    @g::field_view(g::dimension_group("remote-network-element/ref_parent_ne", domain::Reference(ids::NetworkElementById).type, True, [g::Filter::Eq]), "rne_ref_parent_ne", True, [g::Filter::Eq])
    ref_parent_ne: Option(domain::Reference(ids::NetworkElementById)),
    @m::column("productName")
    @g::field_view(g::dimension_group("remote-network-element/product_name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_product_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    product_name: Option(String),
    @m::column("refParentSubnet")
    @g::field_view(g::dimension_group("remote-network-element/ref_parent_subnet", String.type, True, [g::Filter::Eq]), "rne_ref_parent_subnet", True, [g::Filter::Eq])
    ref_parent_subnet: Option(String),
    @m::column("commuState")
    @g::field_view(g::dimension_group("remote-network-element/commu_state/raw", String.type, True, [g::Filter::Eq, g::Filter::Ne]), "rne_commu_state_raw", True, [g::Filter::Eq, g::Filter::Ne])
    @v::map(domains::RneCommunicationState.type, "rne_commu_state", [v::member(domains::RneCommunicationState::Online, ["0"]), v::member(domains::RneCommunicationState::Upgrading, ["1"]), v::member(domains::RneCommunicationState::Offline, ["2","99"]), v::member(domains::RneCommunicationState::Abnormal, ["3"]), v::member(domains::RneCommunicationState::Configing, ["4"])])
    commu_state: Option(String),
    @g::field_view(g::dimension_group("remote-network-element/manufacturer", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_manufacturer", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    manufacturer: Option(String),
    @g::field_view(g::dimension_group("remote-network-element/sn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_sn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    sn: Option(String),
    @g::field_view(g::dimension_group("remote-network-element/mac", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_mac", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    mac: Option(String),
    @g::field_view(g::dimension_group("remote-network-element/location", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_location", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    location: Option(String),
    @m::column("ipAddress")
    @g::field_view(g::dimension_group("remote-network-element/ip_address", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_ip_address", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    ip_address: Option(String),
    @g::field_view(g::dimension_group("remote-network-element/remark", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_remark", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    remark: Option(String),
    @g::field_view(g::dimension_group("remote-network-element/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: Option(String),
    @g::field_view(g::dimension_group("remote-network-element/id", ids::NetworkElementById.type, True, [g::Filter::Eq]), "rne_id", True, [g::Filter::Eq])
    @domain::count("rne_count")
    id: ids::NetworkElementById,
    @g::field_view(g::dimension_group("remote-network-element/esn", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "rne_esn", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    esn: Option(String),
};

pub def relations: Array(r::Relation) = [
    r::relation("rne__enl", domain::endpoint(RemoteNetworkElement.type, "id"), domain::endpoint(enterprise_network_ltp::EnterpriseNetworkLtp.type, "ref_parent_ne"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("rne__ne_rev", domain::endpoint(RemoteNetworkElement.type, "ref_parent_ne"), domain::endpoint(network_element::NetworkElement.type, "id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
];
