# Invalid-request entry. Every case must fail atomically: no trusted Plan is
# published and no Query is produced. `run invalid --best-effort` stops at the
# first failure (fail! is not catchable); the remaining categories are covered
# by the case list below and by the non-exported prepare-time scenarios, and
# documented in NOTES.

import "query/lib" as qb;
import "std/value" { Value };
import "std/array" as array;
import "@src/edsl" as edsl;
import "@src/knowledge" as knowledge;

def count_agg: qb.AggregateFunction = 'Count;
def sub_op: qb.ComputedOp = 'Sub;
def no_types: Array(Type) = [];

# ---------------------------------------------------------------------------
# Request-level failure cases.
# ---------------------------------------------------------------------------

def invalid_cases: Array(edsl.QueryRequest) = [
    # Unknown enum value: CustomerTier is a closed value domain; "platinum" is
    # not a member and must fail atomically with the dynamic input as evidence.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CustomerTier", subject: "analyst", input: 'None }],
        filters: [{ id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("platinum") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Range op on a closed-enum dimension (only Eq is supported).
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CustomerTier", subject: "analyst", input: 'None }],
        filters: [{ id: "CustomerTier", subject: "analyst", op: 'Ge, input: 'Text("gold") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Non-text input for a closed-enum dimension.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CustomerTier", subject: "analyst", input: 'None }],
        filters: [{ id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Int(1) }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Filter on a known but groupable-not-filterable dimension (missing
    # capability diagnostic; required by the goal).
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: "OrderId", subject: "analyst", op: 'Eq, input: 'Text("1") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Known dimension that is not authorized for querying (projection/grouping
    # use fails with an authorization diagnostic, not "unknown").
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CustomerContact", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Filter on a known but unauthorized dimension.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: "CustomerContact", subject: "analyst", op: 'Eq, input: 'Text("x") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Ordering by a known but unauthorized dimension.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [{ target: 'Dimension("CustomerContact"), direction: 'Asc }],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Measure whose required entity is reachable only through a fan-out
    # relation: CustomerCount (customer grain) requires Order, but the
    # Customer->Order path is fan-out-only.
    {
        measures: [{ id: "CustomerCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Non-positive limit.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'Some(0),
        offset: 'None,
        partition: 'None,
    },
    # Negative limit.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'Some(-3),
        offset: 'None,
        partition: 'None,
    },
    # Unknown measure.
    {
        measures: [{ id: "BogusMeasure", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Unknown dimension.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "BogusDim", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Filter operation not supported for the dimension (Eq on a range-only
    # computed dimension).
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: "OrderWeek", subject: "analyst", op: 'Eq, input: 'Text("2024-01") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Invalid filter value (numeric input for a text-only dimension).
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [{ id: "OrderRegion", subject: "analyst", op: 'Eq, input: 'Number(5.0) }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Ordering target that was not requested.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [{ target: 'Dimension("OrderWeek"), direction: 'Asc }],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Fan-out-only path: base Customer, dimension on Order requires the
    # fan-out relation, which is rejected as unsafe.
    {
        measures: [{ id: "CustomerCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Grain conflict between measures on different natural grains.
    {
        measures: [
            { id: "OrderAmount", subject: "analyst", input: 'All },
            { id: "CustomerCount", subject: "analyst", input: 'All },
        ],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Unauthorized subject.
    {
        measures: [{ id: "OrderAmount", subject: "outsider", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Empty measures: no base grain can be derived.
    {
        measures: [],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Negative offset: offset must be non-negative even with stable ordering.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'Some(5),
        offset: 'Some(-1),
        partition: 'None,
    },
    # Offset without stable ordering: pagination requires deterministic order.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'Some(5),
        offset: 'Some(0),
        partition: 'None,
    },
    # Scope/filter conflict: TraceHead is inherently scoped to kind=run; a user
    # filter of kind=skip contradicts the scope and must fail atomically.
    {
        measures: [{ id: "TraceCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "TraceHead", subject: "analyst", input: 'None }],
        filters: [{ id: "TraceKind", subject: "analyst", op: 'Eq, input: 'Text("skip") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    },
    # Partition by a dimension not selected in the request.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderWeek", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    },
    # Unstable partition ordering: the non-partition dimension is not covered.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
            { id: "OrderWeek", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    },
    # Non-positive take.
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 0 }),
    },
    # Top Per Group combined with a global limit (undefined combination).
    {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'Some(5),
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    },
];

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    # Every case must fail atomically: a healthy result would make this entry
    # an invalid "unexpected success". main consumes the attempt results so any
    # successful case (a contract regression) fails loudly instead of
    # publishing a trusted result.
    let attempts = array.map(invalid_cases, fn(req) {
        let plan: qb.Plan = edsl.lower(knowledge.payload, req);
        let _query: qb.Query = qb.transform_sqlite(plan);
        "unexpected success"
    });
    let healthy: Bool = array.all(attempts, fn(s) { s == "unexpected success" });
    let outcome: Value = if healthy { 'String("unexpected success") } else { 'String("unexpected success") };
    outcome
};

# ---------------------------------------------------------------------------
# Prepare-time failure scenarios (non-exported). They fail during best-effort
# module evaluation (run --best-effort / check), so their diagnostics surface
# alongside the request-level failures.
# ---------------------------------------------------------------------------

def flag_true: Bool = 'True;
def flag_false: Bool = 'False;
def no_ops: Array(edsl.FilterOp) = [];
def eq_ops: Array(edsl.FilterOp) = ['Eq];
def text_kinds: Array(edsl.FilterInputKind) = ['Text];
def invalid_authorize: Fn(String) -> Bool = fn(subject) { subject == "analyst" };

# Duplicate stable values in an enum value domain must fail at prepare time.
type DupTier = enum {
    @edsl.enum_value("gold", "Gold customer")
    'Gold,
    @edsl.enum_value("gold", "Duplicate gold")
    'Gold2,
};

@edsl.entity_source("dup", "d")
type DupEntity = struct {
    @edsl.column("tier")
    @edsl.dimension("DupTier", flag_true, flag_true, eq_ops, text_kinds)
    tier: DupTier,
};

def duplicate_stable_values: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [DupEntity];
    let result: edsl.PreparedPayload = edsl.build_root("bad-dup", entity_types, knowledge.profile, invalid_authorize);
    result
};

# Payload-bearing enums are not accepted as dimension value domains (first
# version supports payload-free variants only); prepare must diagnose it.
type PayTier = enum {
    'Code(Int),
    'Name(String),
};

@edsl.entity_source("pay", "p")
type PayEntity = struct {
    @edsl.column("tier")
    @edsl.dimension("PayTier", flag_true, flag_true, eq_ops, text_kinds)
    tier: PayTier,
};

def payload_variant_dimension: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [PayEntity];
    let result: edsl.PreparedPayload = edsl.build_root("bad-payload", entity_types, knowledge.profile, invalid_authorize);
    result
};

# Unknown enum value at lowering time: CustomerTier is a closed value domain;
# "platinum" is not a member and must fail atomically with the dynamic input
# value as evidence.
def unknown_enum_value: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CustomerTier", subject: "analyst", input: 'None }],
        filters: [{ id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("platinum") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Negative offset: pagination requires a non-negative offset.
def negative_offset: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'Some(5),
        offset: 'Some(-1),
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Offset without stable ordering: pagination requires deterministic order.
def offset_without_ordering: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'Some(5),
        offset: 'Some(0),
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Scope/filter conflict: TraceHead is inherently scoped to kind=run; filtering
# kind=skip contradicts the scope and must fail atomically.
def conflicting_scope_filter: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "TraceCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "TraceHead", subject: "analyst", input: 'None }],
        filters: [{ id: "TraceKind", subject: "analyst", op: 'Eq, input: 'Text("skip") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Partition by a dimension not selected in the request.
def partition_unrequested: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderWeek", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Unstable partition ordering: the non-partition dimension is not covered.
def partition_unstable: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
            { id: "OrderWeek", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Non-positive take.
def partition_bad_take: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 0 }),
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Top Per Group combined with a global limit (undefined combination).
def partition_with_limit: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'Some(5),
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    plan
};

# Computed measure with an unknown dependency must fail at prepare time.
@edsl.entity_source("bad_unknown", "u")
type BadUnknown = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("GoodCount", count_agg, no_types)
    @edsl.computed_measure("BadComputed", sub_op, "GoodCount", "MissingMeasure")
    id: Int,
};

def computed_unknown_dependency: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [BadUnknown];
    let result: edsl.PreparedPayload = edsl.build_root("bad-unknown", entity_types, knowledge.profile, invalid_authorize);
    result
};

# A computed-measure dependency cycle must fail at prepare time.
@edsl.entity_source("bad_cycle", "y")
type BadCycle = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.computed_measure("CycleA", sub_op, "CycleB", "CycleA")
    @edsl.computed_measure("CycleB", sub_op, "CycleA", "CycleB")
    id: Int,
};

def computed_cycle: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [BadCycle];
    let result: edsl.PreparedPayload = edsl.build_root("bad-cycle", entity_types, knowledge.profile, invalid_authorize);
    result
};

# Cross-grain computed measure must fail at prepare time.
@edsl.entity_source("bad_cross", "x")
type BadCross = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.measure("CrossCount", count_agg, no_types)
    @edsl.computed_measure("CrossComputed", sub_op, "CrossCount", "TraceCount")
    id: Int,
};

def computed_cross_grain: edsl.PreparedPayload = do {
    # Trace is in the knowledge so TraceCount exists; CrossComputed combining
    # CrossCount (BadCross grain) with TraceCount (Trace grain) is cross-grain.
    let entity_types: Array(Type) = [BadCross, knowledge.Trace];
    let result: edsl.PreparedPayload = edsl.build_root("bad-cross", entity_types, knowledge.profile, invalid_authorize);
    result
};

# Filtered-measure predicate contract failures. Each filtered measure carries a
# predicate that violates one rule; requesting it must fail atomically through
# the public build_root + lower path (no partial Plan/Query is published).
# Canonical (alphabetical) field order: 0: id, 1: name, 2: note, 3: owner,
# 4: status.
def bad_unauthorized_predicate: edsl.ScopePredicate = {field: 3, op: 'Eq, input: 'Text("x")};
def bad_not_filterable_predicate: edsl.ScopePredicate = {field: 1, op: 'Eq, input: 'Text("x")};
def bad_op_predicate: edsl.ScopePredicate = {field: 4, op: 'Ge, input: 'Text("approved")};
def bad_input_kind_predicate: edsl.ScopePredicate = {field: 2, op: 'Eq, input: 'Number(5.0)};
def bad_enum_value_predicate: edsl.ScopePredicate = {field: 4, op: 'Eq, input: 'Text("platinum")};

type ProbeStatus = enum {
    @edsl.enum_value("approved", "Approved")
    'Approved,
    @edsl.enum_value("rejected", "Rejected")
    'Rejected,
};

@edsl.entity_source("probe", "p")
type PredicateProbe = struct {
    @edsl.column("id")
    @edsl.key(flag_true)
    @edsl.filtered_measure("BadUnauthorized", count_agg, no_types, bad_unauthorized_predicate)
    @edsl.filtered_measure("BadNotFilterable", count_agg, no_types, bad_not_filterable_predicate)
    @edsl.filtered_measure("BadOp", count_agg, no_types, bad_op_predicate)
    @edsl.filtered_measure("BadInputKind", count_agg, no_types, bad_input_kind_predicate)
    @edsl.filtered_measure("BadEnumValue", count_agg, no_types, bad_enum_value_predicate)
    id: Int,
    @edsl.column("name")
    @edsl.dimension("ProbeName", flag_true, flag_false, no_ops, text_kinds)
    name: String,
    @edsl.column("note")
    @edsl.dimension("ProbeNote", flag_true, flag_true, eq_ops, text_kinds)
    note: String,
    @edsl.column("owner")
    @edsl.dimension("ProbeOwner", flag_false, flag_false, eq_ops, text_kinds)
    owner: String,
    @edsl.column("status")
    @edsl.dimension("ProbeStatus", flag_true, flag_true, eq_ops, text_kinds)
    status: ProbeStatus,
};

def bad_predicate_payload: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [PredicateProbe];
    let result: edsl.PreparedPayload = edsl.build_root("bad-predicate", entity_types, knowledge.profile, invalid_authorize);
    result
};

def predicate_unauthorized: qb.Plan = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "BadUnauthorized", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(bad_predicate_payload, request);
