export def vocabulary_is_closed = do {
    let expected: Array(qb.Operator) = [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Join, 'Group, 'Order, 'Limit,
    ];
    qb.operators(demo_plan()) == expected
};

export def profile_accepts_legal_plan = do {
    qb.profile_accepts(demo_plan(), full_profile())
};

export def profile_rejects_restricted_plan = do {
    !qb.profile_accepts(demo_plan(), restricted_profile())
};

export def profile_rejects_left_join = do {
    let only_inner: qb.PlanProfile = {
        allowed_operators: ['Source, 'Project, 'Column, 'Join],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr],
        allow_distinct: 'True,
    };
    !qb.profile_accepts(left_join_plan(), only_inner)
};

export def distinct_rejected_without_allow = do {
    !qb.profile_accepts(distinct_plan(), no_distinct_profile())
};

export def distinct_accepted_with_allow = do {
    qb.profile_accepts(distinct_plan(), full_profile())
};

export def simple_plan_accepted = do {
    qb.profile_accepts(simple_plan(), simple_profile())
};

export def structure_rejects_bad_arity = do {
    !qb.structure_ok(bad_arity_plan())
};

export def structure_rejects_unknown_alias = do {
    !qb.structure_ok(unknown_alias_plan())
};

export def structure_rejects_negative_limit = do {
    !qb.structure_ok(negative_limit_plan())
};

export def structure_rejects_bad_identifier = do {
    !qb.structure_ok(bad_identifier_plan())
};

export def structure_accepts_valid_plan = do {
    qb.structure_ok(simple_plan())
};

export def validate_returns_plan = do {
    let plan = simple_plan();
    qb.validate(plan, simple_profile()) == plan
};

export def transform_is_deterministic = do {
    let q1 = qb.transform_sqlite(simple_plan());
    let q2 = qb.transform_sqlite(simple_plan());
    q1.sql == q2.sql && q1.bindings == q2.bindings
};

export def transform_preserves_clause_order = do {
    let q = qb.transform_sqlite(demo_plan());
    let expected = "SELECT o.customer_id, substr(o.name, ?, ?), sum(o.total) AS total_sum FROM orders AS o INNER JOIN customers AS c ON o.customer_id = c.id WHERE o.total > ? GROUP BY o.customer_id ORDER BY o.customer_id ASC LIMIT ?";
    q.sql == expected
};

export def transform_bindings_in_placeholder_order = do {
    let q = qb.transform_sqlite(demo_plan());
    let expected: Array(qb.Val) = ['Int(1), 'Int(3), 'Float(100.0), 'Int(10)];
    q.bindings == expected
};

export def transform_uses_placeholders_not_escaped_values = do {
    let q = qb.transform_sqlite(simple_plan());
    let contains_literal = string.contains(q.sql, "\"x\"") || string.contains(q.sql, "'x'");
    !contains_literal && string.contains(q.sql, "?")
};

export def transform_left_join_sql = do {
    let q = qb.transform_sqlite(left_join_plan());
    q.sql == "SELECT o.id FROM orders AS o LEFT JOIN customers AS c ON o.customer_id = c.id"
};

export def aggregate_ordering_top_n_sql = do {
    let q = qb.transform_sqlite(top_n_plan());
    q.sql == "SELECT o.customer_id, count(o.id) AS order_count FROM orders AS o GROUP BY o.customer_id ORDER BY count(o.id) DESC, o.customer_id ASC LIMIT ?"
};

export def aggregate_ordering_top_n_bindings = do {
    let q = qb.transform_sqlite(top_n_plan());
    let expected: Array(qb.Val) = ['Int(5)];
    q.bindings == expected
};

export def aggregate_ordering_does_not_emit_source_qualified_alias = do {
    let q = qb.transform_sqlite(top_n_plan());
    !string.contains(q.sql, "o.order_count")
};

export def aggregate_ordering_accepted_by_profile = do {
    qb.profile_accepts(top_n_plan(), full_profile())
};

export def ordering_rejects_unprojected_aggregate = do {
    !qb.structure_ok(unprojected_ordering_plan())
};

export def ordering_rejects_unknown_aggregate = do {
    !qb.structure_ok(unknown_ordering_plan())
};

export def ordering_rejects_bad_alias_identifier = do {
    !qb.structure_ok(bad_ordering_alias_plan())
};

export def ordering_unprojected_aggregate_has_no_query = do {
    # The same structural rejection is what makes transform_sqlite fail; no
    # partial Query is ever published (verified live by `run invalid`).
    let unprojected = unprojected_ordering_plan();
    !qb.structure_ok(unprojected)
};

export def transform_empty_bindings_when_no_dynamic_values = do {
    let plan: qb.Plan = {
        revision: "test-no-bindings",
        sources: [qb.source("o", "orders")],
        projection: [qb.expr_item(qb.column("o", "id"))],
        filter: 'None,
        joins: [],
        grouping: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let q = qb.transform_sqlite(plan);
    array.length(q.bindings) == 0 && q.sql == "SELECT o.id FROM orders AS o"
};

# ---------------------------------------------------------------------------
# Closed computed expression: first whitespace-delimited segment.
#
# Contract (SQLite `instr` semantics, 1-based, 0 when absent):
#   - no delimiter : `instr(text, sep) = 0`, the `> 0` guard fails and the
#                    ELSE branch returns the original value;
#   - empty string : same as no delimiter -> empty string;
#   - NULL input   : `instr(NULL, sep)` is NULL, `CASE WHEN NULL` selects the
#                    ELSE branch, so NULL propagates unchanged.
# The segment before the first delimiter is `substr(text, 1, instr - 1)`.
# ---------------------------------------------------------------------------

def first_token_expr: Fn(qb.Expr) -> qb.Expr = fn(command) {
    let sep: qb.Expr = qb.bind_string(" ");
    let pos: qb.Expr = qb.instr(command, sep);
    let found: qb.Expr = qb.scalar('Gt, [pos, qb.bind_int(0)]);
    let rest: qb.Expr = qb.sub(pos, qb.bind_int(1));
    let segment: qb.Expr = qb.scalar_if(
        found,
        qb.substr([command, qb.bind_int(1), rest]),
        command,
    );
    segment
};

def first_token_plan: Fn() -> qb.Plan = fn() {
    let segment = first_token_expr(qb.column("c", "command"));
    let plan: qb.Plan = {
        revision: "test-first-token",
        sources: [qb.source("c", "commands")],
        projection: [
            qb.expr_item(segment),
            qb.aggregate('Count, qb.column("c", "id"), 'False, "uses"),
        ],
        filter: 'None,
        joins: [],
        grouping: [segment],
        ordering: [qb.desc_aggregate("uses"), qb.asc(qb.column("c", "command"))],
        limit: 'Some(100),
        offset: 'None,
        partition: 'None,
    };
    plan
};

def expected_first_token_sql = "SELECT CASE WHEN instr(c.command, ?) > ? THEN substr(c.command, ?, (instr(c.command, ?) - ?)) ELSE c.command END, count(c.id) AS uses FROM commands AS c GROUP BY CASE WHEN instr(c.command, ?) > ? THEN substr(c.command, ?, (instr(c.command, ?) - ?)) ELSE c.command END ORDER BY count(c.id) DESC, c.command ASC LIMIT ?";

def expected_first_token_bindings: Array(qb.Val) = [
    'String(" "), 'Int(0), 'Int(1), 'String(" "), 'Int(1),
    'String(" "), 'Int(0), 'Int(1), 'String(" "), 'Int(1),
    'Int(100),
];

