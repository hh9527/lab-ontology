@edsl::entity_id("scoped_reading")
@edsl::entity_source("scoped_readings", "sr")
@edsl::entity_scope([{field: "classification", op: edsl::FilterOp::Eq,
    input: edsl::FilterInput::Text("active")}])
@edsl::named_relation_key("scoped_reading_tenant", Tenant.type, edsl::RelationKind::Safe,
    edsl::RelationKey::Eq({from: 2, to: 0}))
type ScopedReading = struct {
    @edsl::column("classification")
    @edsl::dimension("scoped_reading_class", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    classification: String,
    @edsl::column("id")
    @edsl::key(True)
    id: String,
    @edsl::column("tenant_id")
    tenant_id: String,
};

def count_payload: edsl::PreparedPayload = edsl::build_root("count-grain-pressure",
    [Tenant.type, Reading.type, Unidentified.type, ScopedReading.type], payload.profile,
    fn(subject) { subject == "resolver" });
def lower_count_grain: Fn(Value) -> qb::QueryAst = query_intent_ast_factory(count_payload, "resolver");

pub def composite_dataset_grain_count: test::Test = test::should_ok(fn() {
    let ast = lower_count_grain(json::parse(r#"{
        "op":"graph", "root":"tenant", "nodes":[{"id":"tenant","entity":"tenant"},{"id":"reading","entity":"reading"}],
        "edges":[{"relation":"reading_tenant","from":"reading","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"reading", "include_empty":true
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "LEFT JOIN readings AS reading")
        && string::contains(sq.sql, "count(reading.reading_id)")
        && string::contains(pg.sql, "count(\"reading\".\"reading_id\")") {
        True
    } else { fail!("composite dataset grain must count present rows without DISTINCT", sq, pg) }
});

pub def count_rejects_missing_identity: test::Test = test::should_fail_with(fn() {
    lower_count_grain(json::parse(r#"{
        "op":"graph", "root":"tenant", "nodes":[{"id":"tenant","entity":"tenant"},{"id":"u","entity":"unidentified"}],
        "edges":[{"relation":"unidentified_tenant","from":"u","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"u"
    }"#).unwrap!())
}, "graph count subject requires a declared key or dataset grain");

