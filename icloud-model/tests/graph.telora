pub def qualified_device_observes_an_independent_kpi_window: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"observed","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"observed","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"observed","measure":"port_count_sample_avg"}],
        "group_by_identity":["device"],
        "filters":[
            {"node":"observed","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-02-01 00:00:00"},
            {"node":"observed","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-04 00:00:00"}],
        "exists":[{"anchor":"device", "nodes":[{"id":"cpu","entity":"device_kpi"}],
            "edges":[{"relation":"device_kpi_of_device","from":"cpu","to":"device"}],
            "filters":[
                {"node":"cpu","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                {"node":"cpu","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}],
            "having":[{"node":"cpu","measure":"cpu_usage","op":"gt","kind":"number","value":80.0}]}]
    }"#).unwrap!());
    if string::contains(query.sql, "avg(observed.portCount) AS observed_port_count_sample_avg")
        && string::contains(query.sql, "HAVING avg(cpu.cpuUsage)")
        && string::contains(query.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && array::length(query.bindings) == 5 { True }
    else { fail!(`qualified KPI observation lost measure grain or window: \{query.sql}`, query.bindings) }
});

pub def top_devices_by_declared_cpu_average_keep_full_identity: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{
        "op":"graph", "root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"sample","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"sample","measure":"cpu_usage"}],
        "group_by_identity":["device"],
        "filters":[{"node":"sample","dimension":"device_kpi_ts_raw","op":"ge",
                    "kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"lt",
                    "kind":"text","value":"2025-01-08 00:00:00"}],
        "top_by_measure":{"node":"sample","measure":"cpu_usage","direction":"desc","take":5}
    }"#).unwrap!();
    let ast = query_intent_ast_factory(payload, "public")(intent);
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && string::contains(sq.sql, "ORDER BY avg(sample.cpuUsage) DESC, device.id ASC, device.tenant_id ASC LIMIT ?3")
        && string::contains(pg.sql, "ORDER BY avg(\"sample\".\"cpuUsage\") DESC NULLS LAST")
        && sq.bindings == [qb::Val::String("2025-01-01 00:00:00"),
            qb::Val::String("2025-01-08 00:00:00"), qb::Val::Int(5)]
        && pg.bindings == sq.bindings { True }
    else { fail!("aggregate top-five lost device identity or external window", sq, pg) }
});

pub def projected_cpu_average_filters_same_sample_group: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"sample","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"sample","measure":"cpu_usage"}],
        "group_by_identity":["device"],
        "filters":[{"node":"sample","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}],
        "measure_having":[{"node":"sample","measure":"cpu_usage","op":"ge","kind":"number","value":80.0}]}
    "#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "avg(sample.cpuUsage) AS sample_cpu_usage")
        && string::contains(sq.sql, "GROUP BY device.name, device.id, device.tenant_id HAVING avg(sample.cpuUsage) >= ?3")
        && string::contains(pg.sql, "HAVING avg(\"sample\".\"cpuUsage\") >= $3")
        && sq.bindings == [qb::Val::String("2025-01-01 00:00:00"),
            qb::Val::String("2025-01-04 00:00:00"), qb::Val::Float(80.0)]
        && pg.bindings == sq.bindings { True }
    else { fail!("CPU threshold did not filter the same declared aggregate it projects", sq, pg) }
});

pub def count_devices_qualified_by_projected_cpu_average: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"sample","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"sample","measure":"cpu_usage"}],
        "group_by_identity":["device"],
        "measure_having":[{"node":"sample","measure":"cpu_usage","op":"gt","kind":"number","value":80.0}],
        "count_groups":true}"#).unwrap!());
    if string::contains(query.sql, "SELECT count(1) FROM (SELECT device.name")
        && string::contains(query.sql, "GROUP BY device.name, device.id, device.tenant_id HAVING avg(sample.cpuUsage) > ?1") { True }
    else { fail!("qualified device count lost its declared AVG sample grain", query.sql) }
});

