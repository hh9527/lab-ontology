# World 定义模型边界；引用类型与内嵌知识由统一路径自动收集。
use crate::model as m;
use crate::transform as t;
use crate::relations as r;
use crate::groups as g;
use crate::knowledge as k;
use crate::field_knowledge as fk;
use crate::query as qb;
use std::array as array;
use std::dict as dict;
use std::pipeline as pipeline;
use std::build as build;
use std::value::{Value};

type Entity = struct {
    id: String,
    identity: Type
};
type World = struct {
    revision: String,
    entities: Array(Entity),
    datasets: Array(t::Declaration),
    definitions: Array(t::LocalDefinition),
    local_knowledge: Array(Value),
    local_capabilities: k::LocalCapabilities,
    relations: Array(r::Relation),
    alternatives: Array(t::Alternative),
    links: Array(r::Link),
    profile: qb::PlanProfile,
};
# 索引构造同时检查名称；发现出的内容无需再证明覆盖。
def from_definitions_with_entities: Fn(
    String,
    Array(t::LocalDefinition),
    Array(Entity),
    Array(r::Relation),
    Array(t::Alternative),
    Array(r::Link),
    qb::PlanProfile
) -> World = fn(revision, definitions, entities, relations, alternatives, links, profile) {
    let required = qb::combine_requirements(
        array::map(
            definitions,
            fn(local) {
                local.contract
            }
        )
    );
    if !qb::requirements_accepted(required, profile) {
        fail!("model capabilities are not allowed by the query profile", required, profile)
    } else {
        ()
    };
    let datasets = pipeline::run(
        pipeline::from_array(definitions) |> pipeline::unique_by(
            fn(local) {
                local.declaration.dataset.id
            }
        ) |> pipeline::map(
            fn(local) {
                local.declaration
            }
        ) |> pipeline::collect()
    );
    let entities = pipeline::run(
        array::fold(
            datasets,
            pipeline::from_array(entities),
            fn(found, dataset) {
                pipeline::merge(
                    found,
                    pipeline::from_array(dataset.dataset.roles) |> pipeline::map(
                        fn(role) {
                            {id: role.entity, identity: role.identity}.ty!(Entity)
                        }
                    )
                )
            }
        ) |> pipeline::distinct_by(
            fn(entity) {
                `\{entity.id}:\{k::type_id(entity.identity)}`
            }
        ) |> pipeline::unique_by(
            fn(entity) {
                entity.id
            }
        ) |> pipeline::collect()
    );
    let published = pipeline::run(
        pipeline::merge(
            pipeline::from_array(relations) |> pipeline::map(
                fn(relation) {
                    (relation.id, True)
                }
            ),
            pipeline::merge(
                pipeline::from_array(alternatives) |> pipeline::map(
                    fn(relation) {
                        (relation.id, False)
                    }
                ),
                pipeline::from_array(links) |> pipeline::map(
                    fn(link) {
                        (link.id, False)
                    }
                )
            )
        ) |> pipeline::unique_by(
            fn(item) {
                item.0
            }
        ) |> pipeline::collect_dict(
            fn(item) {
                item.0
            },
            fn(item) {
                item.1
            }
        )
    );
    pipeline::run(
        array::fold(
            links,
            pipeline::from_array([].ty!(Array(String))),
            fn(found, link) {
                pipeline::merge(found, pipeline::from_array([link.a.id, link.z.id]))
            }
        ) |> pipeline::distinct_by(
            fn(id) {
                id
            }
        ) |> pipeline::map(
            fn(id) {
                if dict::get(published, id) != Some(True) {
                    fail!("business link references an unpublished relation", id)
                } else {
                    ()
                }
            }
        ) |> pipeline::collect()
    );
    let capabilities = array::map(
        definitions,
        fn(local) {
            local.capabilities
        }
    );
    let model = {
        revision,
        entities,
        definitions,
        local_knowledge: [],
        local_capabilities: {
            dimensions: array::flat_map(
                capabilities,
                fn(local) {
                    local.dimensions
                }
            ),
            measures: array::flat_map(
                capabilities,
                fn(local) {
                    local.measures
                }
            )
        },
        datasets,
        relations,
        alternatives,
        links,
        profile
    };
    prepare_local_knowledge(model)
};
def resolved_entities: Fn(World) -> Array(Entity) = fn(world) {
    world.entities
};
def prepare: Fn(World) -> t::Prepared = fn(world) {
    t::build_from_definitions(
        world.revision,
        world.definitions,
        world.relations,
        world.alternatives,
        world.links,
        world.profile
    )
};
def prepare_local_knowledge: Fn(World) -> World = fn(world) {
    let entities = resolved_entities(world);
    let source_types = array::concat(
        [
            fk::declaration_types(world.datasets),
            array::map(
                entities,
                fn(e) {
                    e.identity
                }
            )
        ]
    );
    let types = fk::discover_types(source_types);
    let local_knowledge = fk::local_knowledge(
        types,
        array::map(
            entities,
            fn(entity) {
                (entity.id, entity.identity)
            }
        ),
        source_types,
        array::map(world.definitions, fk::dataset_definition),
        array::flat_map(
            world.definitions,
            fn(local) {
                array::map(
                    local.payload.entities[0].fields,
                    fn(field) {
                        field.ty
                    }
                )
            }
        )
    );
    world <~ {local_knowledge}
};
def publication: Fn(World, t::Prepared) -> Value = fn(world, prepared) {
    fk::publication_with_local(prepared, world.local_knowledge, world.local_capabilities)
};
def stage: for(B) Fn(World, Fn(crate::ontology::PreparedPayload) -> B) -> B = fn(world, program) {
    build::stage(
        fn() {
            let prepared = prepare(world);
            {
                runtime: prepared.payload,
                information: {"ontology.knowledge": publication(world, prepared)}
            }
        },
        program
    )
};
pub use self::{Entity, World, resolved_entities, prepare, publication, stage};

pub use self::{from_definitions_with_entities};
