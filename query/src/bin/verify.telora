# query/src/bin/verify.telora
#
# Verifies the core guarantees of QueryBuilder:
#   1. profile coverage  : operators(plan) <= profile and refined capability
#                          checks accept legal plans and reject out-of-scope
#                          plans;
#   2. canonical order   : the generated SQL preserves projection, join,
#                          grouping and ordering order (checked byte-for-byte
#                          against the documented expected SQL);
#   3. determinism       : transforming the same Plan twice yields
#                          byte-identical SQL and same-order bindings;
#   4. JSON codec        : `Val` crosses the JSON boundary as untagged scalar
#                          JSON (round-trip for all five variants, correct
#                          Int/Float dispatch, and Query.bindings encoded as a
#                          native scalar array with no variant wrappers).
# The run fails (Host diagnostics, no output) if any check fails.

import "std/array" as array;
import "std/codec" as codec;
import "std/dict" as dict;
import "std/json" as json;
import "std/result" as result;
import "std/string" as string;
import "std/value" { Value };
import "@src/lib" as qb;

def val_to_value: Fn(qb.Val) -> Value = fn(val) {
    match val {
        'String(text) => 'String(text),
        'Int(number) => 'Int(number),
        'Float(number) => 'Float(number),
        'Bool(flag) => if flag { 'True } else { 'False },
        'None => 'None,
    }
};

def full_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: [
            'Source, 'Column, 'Bind, 'Scalar, 'Aggregate, 'Project,
            'Filter, 'Exists, 'Join, 'Group, 'Having, 'Order, 'Limit,
            'Offset, 'Partition,
        ],
        allowed_join_kinds: ['Inner, 'Left],
        allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
        allowed_scalars: ['Substr, 'Instr, 'If, 'Add, 'Sub, 'Lower, 'Length, 'JsonExtract, 'JsonType, 'JsonValid, 'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not],
        allow_distinct: 'True,
    };
    profile
};

def restricted_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: ['Source, 'Column, 'Bind, 'Scalar, 'Project, 'Filter, 'Order],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr],
        allow_distinct: 'False,
    };
    profile
};

def simple_profile: Fn() -> qb.PlanProfile = fn() {
    let profile: qb.PlanProfile = {
        allowed_operators: ['Source, 'Column, 'Bind, 'Project, 'Order],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr],
        allow_distinct: 'True,
    };
    profile
};

