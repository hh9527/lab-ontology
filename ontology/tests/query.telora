def correlated_aggregate_exists_profile_rejects_inner_bypass = fn() {
    let no_exists: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Aggregate, qb.Operator.Filter, qb.Operator.Group, qb.Operator.Having],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Eq],
        allow_distinct: True,
    };
    let no_count_aggregate: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Exists, qb.Operator.Filter, qb.Operator.Group, qb.Operator.Having],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Sum],
        allowed_scalars: [qb.ScalarFunction.Eq],
        allow_distinct: True,
    };
    let no_aggregate_op: qb.PlanProfile = {
        allowed_operators: [qb.Operator.Source, qb.Operator.Project, qb.Operator.Column, qb.Operator.Exists, qb.Operator.Filter, qb.Operator.Group, qb.Operator.Having],
        allowed_join_kinds: [qb.JoinKind.Inner],
        allowed_aggregates: [qb.AggregateFunction.Count],
        allowed_scalars: [qb.ScalarFunction.Eq],
        allow_distinct: True,
    };
    qb.profile_accepts(subjects_min_events_plan(), full_profile())
        && !qb.profile_accepts(subjects_min_events_plan(), no_exists)
        && !qb.profile_accepts(subjects_min_events_plan(), no_count_aggregate)
        && !qb.profile_accepts(subjects_min_events_plan(), no_aggregate_op)
};

# ---------------------------------------------------------------------------
# Derived UNION ALL source (round): composable multi-source relation.
#
#   Two same-grain item tables are normalised into one logical relation
#   `u(owner_id, group_id, item_id)` with UNION ALL; the outer plan then
#   groups/aggregates and applies the existing partitioned Top N per owner.
# ---------------------------------------------------------------------------

def union_a_branch: Fn() -> qb.UnionBranch = fn() {
    qb.union_branch(qb.source("a", "items_a"), [
        qb.union_column("owner_id", qb.column("a", "owner_id")),
        qb.union_column("group_id", qb.column("a", "group_id")),
        qb.union_column("item_id", qb.column("a", "item_id")),
    ], None)
};

def union_b_branch: Fn() -> qb.UnionBranch = fn() {
    qb.union_branch(qb.source("b", "items_b"), [
        qb.union_column("owner_id", qb.column("b", "owner_id")),
        qb.union_column("group_id", qb.column("b", "group_id")),
        qb.union_column("item_id", qb.column("b", "item_id")),
    ], None)
};

def union_items_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-union-items",
        sources: [],
        derived: Some(qb.derived_source("u", [
            union_a_branch(),
            union_b_branch(),
        ])),
        projection: [
            qb.expr_item(qb.column("u", "owner_id")),
            qb.expr_item(qb.column("u", "group_id")),
            qb.aggregate(qb.AggregateFunction.Count, qb.column("u", "item_id"), False, "item_count"),
        ],
        filter: None,
        exists: [],
        joins: [],
        grouping: [qb.column("u", "owner_id"), qb.column("u", "group_id")],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        partition: Some(qb.partitioned_top_n(
            [qb.column("u", "owner_id")],
            [qb.desc_aggregate("item_count"), qb.asc(qb.column("u", "group_id"))],
            1,
        )),
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def expected_union_items_sql = "SELECT __q_0, __q_1, item_count FROM (SELECT u.owner_id AS __q_0, u.group_id AS __q_1, count(u.item_id) AS item_count, row_number() OVER (PARTITION BY u.owner_id ORDER BY count(u.item_id) DESC, u.group_id ASC) AS __q_rn FROM (SELECT a.owner_id AS owner_id, a.group_id AS group_id, a.item_id AS item_id FROM items_a AS a UNION ALL SELECT b.owner_id AS owner_id, b.group_id AS group_id, b.item_id AS item_id FROM items_b AS b) AS u GROUP BY u.owner_id, u.group_id) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_0 ASC, item_count DESC, __q_1 ASC";

def expected_union_items_bindings: Array(qb.Val) = [qb.Val.Int(1)];

def union_all_derived_source_lowers_composably = fn() {
    let q = qb.transform_sqlite(union_items_plan());
    q.sql == expected_union_items_sql
        && q.bindings == expected_union_items_bindings
        && qb.structure_ok(union_items_plan())
        && qb.profile_accepts(union_items_plan(), full_profile())
};

def union_a_filtered_branch: Fn() -> qb.UnionBranch = fn() {
    qb.union_branch(qb.source("a", "items_a"), [
        qb.union_column("owner_id", qb.column("a", "owner_id")),
        qb.union_column("group_id", qb.column("a", "group_id")),
        qb.union_column("item_id", qb.column("a", "item_id")),
    ], Some(qb.scalar(qb.ScalarFunction.Eq, [qb.column("a", "kind"), qb.bind_string("x")])))
};

def union_b_filtered_branch: Fn() -> qb.UnionBranch = fn() {
