use ontology::registry as registry;
# 网络设备样本：保留来源尺度、最新整行选择和明确的计数样本加总。
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::quantity as q;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::quantity::{Percent};
# 来源在线率暂按百分比；不确认生产尺度或与其他在线率总体互换。
type ReportedOnlinePercent = struct(Float);
# 来源未定义数值尺度或分子分母，不能推导端口数比值。
type ReportedPortUsage = struct(Float);
@registry::dataset("device_kpi", "NetworkDeviceKPI", ["res_id", "tenant_id", "ts"])
@registry::roles([device])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "device_kpi_ts_raw",
                s::DateTimeUtc.type,
                True,
                [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
            ),
            g::input(m::field(NetworkDeviceKPI.type, s::DateTimeUtc.type, "ts")),
            "device_kpi_ts_raw",
            True,
            [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "device_kpi_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "device_kpi_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "device_kpi_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("device_cpu_sample", Percent.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, Percent.type, "cpu_usage")),
            "device_cpu_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("device_memory_sample", Percent.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, Percent.type, "mem_usage")),
            "device_memory_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("port_count_sample", q::Count.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, q::Count.type, "port_count")),
            "port_count_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("used_port_sample", q::Count.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, q::Count.type, "port_used_count")),
            "used_port_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("running_port_sample", q::Count.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, q::Count.type, "oper_status_count")),
            "running_port_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("admin_port_sample", q::Count.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, q::Count.type, "admin_status_count")),
            "admin_port_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "device_kpi__onlineRate",
                ReportedOnlinePercent.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(NetworkDeviceKPI.type, ReportedOnlinePercent.type, "source_onlineRate")
            ),
            "device_kpi__onlineRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "device_kpi__ifUtilizationRate",
                ReportedPortUsage.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(NetworkDeviceKPI.type, ReportedPortUsage.type, "source_ifUtilizationRate")
            ),
            "device_kpi__ifUtilizationRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("device_kpi__cpuUsageEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, Int.type, "source_cpuUsageEffcnt")),
            "device_kpi__cpuUsageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("device_kpi__memUsageEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, Int.type, "source_memUsageEffcnt")),
            "device_kpi__memUsageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("device_kpi__onlineRateEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, Int.type, "source_onlineRateEffcnt")),
            "device_kpi__onlineRateEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "device_kpi__ifUtilizationRateEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkDeviceKPI.type, Int.type, "source_ifUtilizationRateEffcnt")),
            "device_kpi__ifUtilizationRateEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("device_kpi__portCountEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(NetworkDeviceKPI.type, Int.type, "source_portCountEffcnt")),
            "device_kpi__portCountEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "device_kpi__portUsedCountEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkDeviceKPI.type, Int.type, "source_portUsedCountEffcnt")),
            "device_kpi__portUsedCountEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "device_kpi__operStatusCountEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkDeviceKPI.type, Int.type, "source_operStatusCountEffcnt")),
            "device_kpi__operStatusCountEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "device_kpi__adminStatusCountEffcnt",
                Int.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkDeviceKPI.type, Int.type, "source_adminStatusCountEffcnt")),
            "device_kpi__adminStatusCountEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::record_counts(["device_kpi_sample_count"])
@registry::metric("ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            cpu_usage_statistics,
            m::field(NetworkDeviceKPI.type, Percent.type, "cpu_usage"),
            [
                {statistic: samples::Statistic::Mean, publish: "cpu_usage"},
                {statistic: samples::Statistic::Latest, publish: "device_cpu_latest"},
                {statistic: samples::Statistic::Max, publish: "cpu_peak"},
                {statistic: samples::Statistic::Min, publish: "device_cpu_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            cpu_usage_statistics,
            m::field(NetworkDeviceKPI.type, Percent.type, "mem_usage"),
            [
                {statistic: samples::Statistic::Mean, publish: "memory_usage"},
                {statistic: samples::Statistic::Latest, publish: "device_memory_latest"},
                {statistic: samples::Statistic::Max, publish: "memory_peak"},
                {statistic: samples::Statistic::Min, publish: "device_memory_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            port_count_statistics,
            m::field(NetworkDeviceKPI.type, q::Count.type, "port_count"),
            [
                {statistic: samples::Statistic::Sum, publish: "port_count"},
                {statistic: samples::Statistic::Max, publish: "port_count_peak"},
                {statistic: samples::Statistic::Mean, publish: "port_count_sample_avg"}
            ]
        ),
        samples::bind(
            dataset,
            port_used_count_statistics,
            m::field(NetworkDeviceKPI.type, q::Count.type, "port_used_count"),
            [
                {statistic: samples::Statistic::Sum, publish: "used_port_count"},
                {statistic: samples::Statistic::Mean, publish: "used_port_sample_avg"},
                {statistic: samples::Statistic::Max, publish: "used_port_sample_max"}
            ]
        ),
        samples::bind(
            dataset,
            oper_status_count_statistics,
            m::field(NetworkDeviceKPI.type, q::Count.type, "oper_status_count"),
            [
                {statistic: samples::Statistic::Sum, publish: "running_port_count"},
                {statistic: samples::Statistic::Mean, publish: "running_port_sample_avg"}
            ]
        ),
        samples::bind(
            dataset,
            source_onlineRate_statistics,
            m::field(NetworkDeviceKPI.type, ReportedOnlinePercent.type, "source_onlineRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "device_online_rate_avg"},
                {statistic: samples::Statistic::Min, publish: "device_online_rate_min"},
                {statistic: samples::Statistic::Max, publish: "device_online_rate_max"}
            ]
        ),
        samples::bind(
            dataset,
            source_ifUtilizationRate_statistics,
            m::field(NetworkDeviceKPI.type, ReportedPortUsage.type, "source_ifUtilizationRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "device_port_usage_avg"},
                {statistic: samples::Statistic::Max, publish: "device_port_usage_max"},
                {statistic: samples::Statistic::Min, publish: "device_port_usage_min"}
            ]
        ),
    ]
)
@registry::relations(relations)
type NetworkDeviceKPI = struct {
    @m::column("resId")
    @g::exact("device_kpi_res_id")
    res_id: i::DeviceId,
    @m::column("tenantId")
    @g::exact("device_kpi_tenant_id")
    tenant_id: i::TenantId,
    ts: s::DateTimeUtc,
    @m::column("cpuUsage")
    cpu_usage: Percent,
    @m::column("memUsage")
    mem_usage: Percent,
    @m::column("portCount")
    port_count: q::Count,
    @m::column("portUsedCount")
    port_used_count: q::Count,
    @m::column("operStatusCount")
    oper_status_count: q::Count,
    @m::column("adminStatusCount")
    admin_status_count: q::Count,
    @m::column("parentId")
    @g::exact("device_kpi__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("device_kpi__projectId")
    source_projectId: String,
    @m::column("deviceName")
    @g::search("device_kpi__deviceName")
    source_deviceName: String,
    @m::column("classification")
    @g::exact("device_kpi__classification")
    source_classification: String,
    @m::column("onlineRate")
    source_onlineRate: ReportedOnlinePercent,
    @m::column("ifUtilizationRate")
    source_ifUtilizationRate: ReportedPortUsage,
    @m::column("cpuUsageEffcnt")
    source_cpuUsageEffcnt: Int,
    @m::column("memUsageEffcnt")
    source_memUsageEffcnt: Int,
    @m::column("onlineRateEffcnt")
    source_onlineRateEffcnt: Int,
    @m::column("ifUtilizationRateEffcnt")
    source_ifUtilizationRateEffcnt: Int,
    @m::column("portCountEffcnt")
    source_portCountEffcnt: Int,
    @m::column("portUsedCountEffcnt")
    source_portUsedCountEffcnt: Int,
    @m::column("operStatusCountEffcnt")
    source_operStatusCountEffcnt: Int,
    @m::column("adminStatusCountEffcnt")
    source_adminStatusCountEffcnt: Int,
};
def dataset: m::Dataset(NetworkDeviceKPI) = registry::dataset_of(NetworkDeviceKPI.type);
def device: m::Role(NetworkDeviceKPI) = m::role(
    dataset,
    i::device,
    "device",
    False,
    [
        m::identity_part(
            m::field(NetworkDeviceKPI.type, i::DeviceId.type, "res_id"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def cpu_usage_statistics: samples::Group(Percent) = samples::group(
    "device_cpu_usage",
    Percent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Latest, samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
def port_count_statistics: samples::Group(q::Count) = samples::group(
    "device_port_count",
    q::Count.type,
    samples::Statistic::Sum,
    [samples::Statistic::Max, samples::Statistic::Mean],
    None
);
def port_used_count_statistics: samples::Group(q::Count) = samples::group(
    "device_port_used_count",
    q::Count.type,
    samples::Statistic::Sum,
    [samples::Statistic::Mean, samples::Statistic::Max],
    None
);
def oper_status_count_statistics: samples::Group(q::Count) = samples::group(
    "device_oper_status_count",
    q::Count.type,
    samples::Statistic::Sum,
    [samples::Statistic::Mean],
    None
);
def source_onlineRate_statistics: samples::Group(ReportedOnlinePercent) = samples::group(
    "device_source_onlineRate",
    ReportedOnlinePercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max],
    Some("%")
);
def source_ifUtilizationRate_statistics: samples::Group(ReportedPortUsage) = samples::group(
    "device_source_ifUtilizationRate",
    ReportedPortUsage.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    None
);
def relations: Array(r::Relation) = [
    r::relation(
        "device_kpi_of_device",
        r::endpoint(dataset.row, device.id),
        r::endpoint(i::devices.row, i::device_subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntNetworkElement_NetworkDeviceKPI",
        r::endpoint(i::devices.row, i::device_subject.id),
        r::endpoint(dataset.row, device.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{NetworkDeviceKPI};
