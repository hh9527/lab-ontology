# 将独立 Entity 角色绑定为具名 Dataset 关系；只服务 transform。
use crate::model as model;
use crate::values as values;
use crate::enum_values as ev;
use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::prelude as prelude;
use std::type_property as property;
use std::codec as codec;
use std::value::{Value};
use crate::groups as g;
use std::type_desc as td;
use crate::registry_impl as registry;
use std::type_memorizer as memo;

# Source names are provenance, not additional traversable edges or aliases.
type SourceMapping = struct {
    relation: String,
    names: Array(String)
};
@prelude::property(PropertyTarget::Type)
type SourceMappings = struct {
    items: Array(SourceMapping)
};
def sources: Fn(String, Array(String)) -> Fn(Type, Option(SourceMappings)) -> SourceMappings = fn(
    relation,
    names
) {
    if relation == "" || names == [] || array::any(
        names,
        fn(name) {
            name == "" || name == relation || array::length(
                array::filter(
                    names,
                    fn(other) {
                        other == name
                    }
                )
            ) != 1
        }
    ) {
        fail!("relation sources require unique, nonempty provenance names", relation)
    } else {
        ()
    };
    fn(row, previous) {
        let items = match previous {
            Some(spec) => spec.items,
            None => []
        };
        if array::any(
            items,
            fn(item) {
                item.relation == relation
            }
        ) {
            fail!("relation sources must be declared once", relation)
        } else {
            ()
        };
        {items: array::push(items, {relation, names}.ty!(SourceMapping))}
    }
};
def source_names: Fn(Array(Type), String) -> Array(String) = fn(rows, id) {
    array::flat_map(
        rows,
        fn(row) {
            match property::get_type_prop(row, SourceMappings.type) {
                None => [],
                Some(spec) => array::flat_map(
                    spec.items,
                    fn(item) {
                        if item.relation == id {
                            item.names
                        } else {
                            []
                        }
                    }
                )
            }
        }
    )
};
def validate_sources: Fn(Array(Type), Array(String)) -> () = fn(rows, ids) {
    array::map(
        rows,
        fn(row) {
            match property::get_type_prop(row, SourceMappings.type) {
                None => (),
                Some(spec) => do {
                    array::map(
                        spec.items,
                        fn(item) {
                            if !array::any(
                                ids,
                                fn(id) {
                                    id == item.relation
                                }
                            ) {
                                fail!(
                                    "relation sources reference an unknown relation",
                                    item.relation
                                )
                            } else {
                                ()
                            }
                        }
                    );
                    ()
                }
            }
        }
    );
    ()
};
pub use self::{sources, source_names, validate_sources};

type Endpoint = struct {
    dataset: model::PreparedDataset,
    role: String,
    binding: model::PreparedRole,
    guard: Option(Guard)
};
type GuardPredicate = struct {
    target: Bool,
    row: Type,
    dataset: String,
    source: String,
    column: g::Column,
    op: edsl::FilterOp,
    input: edsl::FilterInput
};
type Guard = enum {
    Predicate(GuardPredicate),
    All(Array(Guard)),
    Any(Array(Guard))
};
type Relation = struct {
    key: edsl::RelationKey,
    guard: Option(Guard),
    id: String,
    from: Endpoint,
    to: Endpoint,
    cardinality: edsl::RelationCardinality
};
type Link = struct {
    guard: Option(Guard),
    id: String,
    a: Relation,
    z: Relation,
    direction: edsl::LinkDirection
};

def endpoint: Fn(Type, String) -> Endpoint = fn(row, name) {
    let dataset = registry::declaration(row).dataset;
    match array::find(
        dataset.roles,
        fn(role) {
            role.id == name
        }
    ) {
        Some(binding) => {dataset, role: name, binding, guard: None},
        None => fail!("relation endpoint role does not exist", dataset.id, name)
    }
};
# Endpoint constraints are relative to that endpoint, independent of edge direction.
def endpoint_guard: Fn(Guard, Bool) -> Guard = fn(predicate, target) {
    match predicate {
        Guard::Predicate(value) => Guard::Predicate(value <~ {target}),
        Guard::All(items) => Guard::All(
            array::map(
                items,
                fn(item) {
                    endpoint_guard(item, target)
                }
            )
        ),
        Guard::Any(items) => Guard::Any(
            array::map(
                items,
                fn(item) {
                    endpoint_guard(item, target)
                }
            )
        )
    }
};
def relation: Fn(String, Endpoint, Endpoint, edsl::RelationCardinality) -> Relation = fn(
    id,
    from,
    to,
    cardinality
) {
    if id == "" {
        fail!("typed relation id must be nonempty")
    } else if from.binding.entity != to.binding.entity || from.binding.identity != to.binding.identity {
        fail!("relation endpoints must describe the same entity identity", id)
    } else {
        # Role 的 parts 已按同一 Identity 的字段顺序完成准备，直接配对索引。
        let parts = array::map(
            to.binding.parts,
            fn(other) {
                edsl::RelationKey::Eq(
                    {
                        from: from.binding.parts[other.target_index].source_index,
                        to: other.source_index
                    }
                )
            }
        );
        let key = if array::length(parts) == 1 {
            parts[0]
        } else {
            edsl::RelationKey::And(parts)
        };
        let edge = {guard: None, id, from, to, cardinality, key}.ty!(Relation);
        let edge = match from.guard {
            None => edge,
            Some(predicate) => with_guard(edge, endpoint_guard(predicate, False))
        };
        match to.guard {
            None => edge,
            Some(predicate) => with_guard(edge, endpoint_guard(predicate, True))
        }
    }
};
# 多次附加条件取合取，不能覆盖已有的业务约束。
def with_guard: Fn(Relation, Guard) -> Relation = fn(edge, predicate) {
    edge <~ {
        guard: Some(
            match edge.guard {
                None => predicate,
                Some(previous) => Guard::All([previous, predicate])
            }
        )
    }
};
def guarded: for(Row, Scalar: codec::Encode) Fn(
    Relation,
    model::Field(Row, Scalar),
    edsl::FilterOp,
    Scalar
) -> Relation = fn(relation, field, op, value) {
    if relation.from.dataset.row != Row.type {
        fail!("relation guard belongs to another source row", relation.id)
    } else if op != edsl::FilterOp::Eq && op != edsl::FilterOp::Ne {
        fail!("relation guard supports only Eq or Ne", relation.id)
    } else {
        let inputs = if values::is_enum(Scalar.type) {
            let name = match codec::encode(value) {
                Value::String(name) => name,
                _ => fail!("enum guard requires a unit variant")
            };
            match array::find(
                ev::members(Scalar.type),
                fn(member) {
                    member.id == name
                }
            ) {
                Some(member) => member.wires,
                None => fail!("enum guard member is not declared", name)
            }
        } else {
            [scalar_input(value)]
        };
        let predicates = array::map(
            inputs,
            fn(input) {
                Guard::Predicate(
                    {
                        target: False,
                        row: Row.type,
                        dataset: relation.from.dataset.id,
                        source: relation.from.dataset.source,
                        column: {
                            index: field.index,
                            name: field.name,
                            value: values::storage_type(Scalar.type),
                            nullable: field.nullable
                        },
                        op,
                        input
                    }.ty!(GuardPredicate)
                )
            }
        );
        with_guard(
            relation,
            if array::length(predicates) == 1 {
                predicates[0]
            } else if op == edsl::FilterOp::Eq {
                Guard::Any(predicates)
            } else {
                Guard::All(predicates)
            }
        )
    }
};
def link: Fn(String, Relation, Relation, edsl::LinkDirection) -> Link = fn(id, a, z, direction) {
    if id == "" || a.id == z.id || a.from.dataset.row != z.from.dataset.row || a.from.role == z.from.role || a.to.dataset.row != z.to.dataset.row || a.to.role != z.to.role {
        fail!("business link requires distinct hub roles and one explicit participant dataset", id)
    } else {
        {guard: None, id, a, z, direction}
    }
};
def guarded_link: for(Row, Scalar: codec::Encode) Fn(
    Link,
    model::Field(Row, Scalar),
    edsl::FilterOp,
    Scalar
) -> Link = fn(declared, field, op, value) {
    declared <~ {guard: guarded(declared.a <~ {guard: declared.guard}, field, op, value).guard}
};
# World 的端点登记约束只在此首次解析；同一 Dataset 的所有关系复用结果。
type Owners = memo::TypeMemorizer(edsl::EntityEntry);
def owners: Fn(edsl::PreparedPayload) -> Owners = fn(payload) {
    memo::type_memorizer(
        fn(row) {
            match array::find(
                payload.entities,
                fn(entry) {
                    entry.entity_type == row
                }
            ) {
                Some(entry) => entry,
                None => fail!("relation endpoint dataset is not registered in World", row)
            }
        }
    )
};
def owner: Fn(Owners, Endpoint) -> edsl::EntityEntry = fn(owners, endpoint) {
    memo::computed_with_type(owners, endpoint.dataset.row)
};
def lower_guard: Fn(Guard) -> edsl::PreparedRelationGuard = fn(value) {
    match value {
        Guard::Predicate(value) => edsl::PreparedRelationGuard::Predicate(
            {
                target: value.target,
                predicate: {
                    field: value.column.name,
                    index: value.column.index,
                    op: value.op,
                    input: value.input
                }
            }
        ),
        Guard::All(values) => edsl::PreparedRelationGuard::All(array::map(values, lower_guard)),
        Guard::Any(values) => edsl::PreparedRelationGuard::Any(array::map(values, lower_guard))
    }
};
def guard: Fn(Option(Guard)) -> Option(edsl::PreparedRelationGuard) = fn(value) {
    match value {
        None => None,
        Some(value) => Some(lower_guard(value))
    }
};
def lower: Fn(Owners, Relation) -> edsl::RelationEntry = fn(owners, declared) {
    let from = owner(owners, declared.from);
    let to = owner(owners, declared.to);
    {
        id: declared.id,
        label: declared.id,
        summary: "",
        from: from.index,
        to: to.index,
        cardinality: declared.cardinality,
        key: declared.key,
        guard: guard(declared.guard)
    }
};
def lower_all: Fn(Owners, Array(Relation)) -> Array(edsl::RelationEntry) = fn(owners, declarations) {
    array::map(
        declarations,
        fn(declared) {
            lower(owners, declared)
        }
    )
};
def lower_alternative: Fn(
    Owners,
    String,
    Array(Relation),
    edsl::RelationCardinality
) -> edsl::RelationEntry = fn(owners, id, choices, cardinality) {
    let lowered = lower_all(owners, choices);
    lowered[0] <~ {
        id,
        label: id,
        cardinality,
        key: edsl::RelationKey::Or(
            array::map(
                lowered,
                fn(relation) {
                    relation.key
                }
            )
        )
    }
};
def lower_link: Fn(Owners, Link) -> edsl::BusinessLinkEntry = fn(owners, declared) {
    let hub = owner(owners, declared.a.from);
    let participant = owner(owners, declared.a.to);
    {
        id: declared.id,
        hub: hub.index,
        participant: participant.index,
        a_relation: declared.a.id,
        z_relation: declared.z.id,
        direction: declared.direction,
        guard: guard(declared.guard)
    }
};
pub use self::{
    Owners,
    owners,
    Guard,
    GuardPredicate,
    with_guard,
    guarded_link,
    guarded,
    Endpoint,
    Relation,
    Link,
    endpoint,
    relation,
    link,
    lower,
    lower_all,
    lower_alternative,
    lower_link
};
def scalar_input: for(Scalar: codec::Encode) Fn(Scalar) -> edsl::FilterInput = fn(value) {
    match codec::encode(value) {
        Value::String(text) => edsl::FilterInput::Text(text),
        Value::Int(number) => edsl::FilterInput::Int(number),
        Value::Float(number) => edsl::FilterInput::Number(number),
        Value::True => edsl::FilterInput::Bool(True),
        Value::False => edsl::FilterInput::Bool(False),
        _ => fail!("model predicate requires a scalar literal"),
    }
};
