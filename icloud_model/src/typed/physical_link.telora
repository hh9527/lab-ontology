use super::fc_switch as fc_switch;
use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 物理链路：A/Z 是固定物理位置，业务方向由显式条件决定。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
type LinkId = struct(String);
@registry::entity("physical_link_entity")
type Identity = struct {
    id: LinkId
};
@registry::dataset("physical_link", "EnterprisePhysicalLink", ["id"])
@registry::roles(
    [
        subject,
        tenant,
        a_device,
        z_device,
        a_server,
        z_server,
        fc_switch::a_reference,
        fc_switch::z_reference
    ]
)
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(EnterprisePhysicalLink.type, String.type, "a_port_ip"))),
            "physical_link_a_port_ip_ipv4",
            True,
            g::ipv4_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(EnterprisePhysicalLink.type, String.type, "a_ne_ip"))),
            "physical_link_a_ne_ip_ipv4",
            True,
            g::ipv4_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::time_filters),
            g::input(
                m::field(EnterprisePhysicalLink.type, s::EpochMillis.type, "source_createTime")
            ),
            "physical_link__createTime",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(EnterprisePhysicalLink.type, String.type, "source_zPortIp"))),
            "physical_link__zPortIp_ipv4",
            True,
            g::ipv4_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(EnterprisePhysicalLink.type, String.type, "source_zNeIp"))),
            "physical_link__zNeIp_ipv4",
            True,
            g::ipv4_filters
        ),
    ]
)
@registry::record_counts(["physical_link_count"])
@registry::native_pairs(
    [registry::native_pair("link_ne_names", a_ne_name_dimension, z_ne_name_dimension)]
)
@registry::relations(relations)
@registry::alternatives(alternatives)
@registry::links(links)
type EnterprisePhysicalLink = struct {
    @m::column("aNeResId")
    a_ne_res_id: String,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    @m::column("aNeName")
    @g::search("physical_link_a_ne_name")
    a_ne_name: String,
    @m::column("zNeName")
    @g::search("physical_link_z_ne_name")
    z_ne_name: String,
    @g::exact("physical_link_id")
    id: LinkId,
    @g::search("physical_link_name")
    name: String,
    @m::column("linkType")
    @v::classification(PhysicalLinkType_domain, "physical_link_type")
    link_type: Int,
    @v::classification(PhysicalLinkDirection_domain, "physical_link_direction")
    direction: String,
    @m::column("linkStatus")
    @v::classification(PhysicalLinkStatus_domain, "physical_link_status")
    link_status: Int,
    @m::column("zNeResId")
    z_ne_res_id: String,
    @m::column("aPortIp")
    @g::search("physical_link_a_port_ip")
    a_port_ip: String,
    @m::column("zPortName")
    @g::search("physical_link_z_port_name")
    z_port_name: String,
    @m::column("aNeIp")
    @g::search("physical_link_a_ne_ip")
    a_ne_ip: String,
    @m::column("alias")
    @g::search("physical_link__alias")
    source_alias: String,
    @m::column("aEndME")
    @g::exact("physical_link__aEndME")
    source_aEndME: String,
    @m::column("zEndME")
    @g::exact("physical_link__zEndME")
    source_zEndME: String,
    @m::column("createTime")
    source_createTime: s::EpochMillis,
    @m::column("speed")
    @g::exact("physical_link__speed")
    source_speed: String,
    @m::column("projectId")
    @g::exact("physical_link__projectId")
    source_projectId: String,
    @m::column("zPortIp")
    @g::search("physical_link__zPortIp")
    source_zPortIp: String,
    @m::column("zPortAlias")
    @g::search("physical_link__zPortAlias")
    source_zPortAlias: String,
    @m::column("zPortDn")
    @g::exact("physical_link__zPortDn")
    source_zPortDn: String,
    @m::column("zNeIp")
    @g::search("physical_link__zNeIp")
    source_zNeIp: String,
    @m::column("aPortAlias")
    @g::search("physical_link__aPortAlias")
    source_aPortAlias: String,
    @m::column("aPortName")
    @g::search("physical_link__aPortName")
    source_aPortName: String,
    @m::column("aPortDn")
    @g::exact("physical_link__aPortDn")
    source_aPortDn: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(EnterprisePhysicalLink) = registry::dataset_of(EnterprisePhysicalLink.type);
def subject: m::Role(EnterprisePhysicalLink) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(EnterprisePhysicalLink.type, LinkId.type, "id"),
            m::field(Identity.type, LinkId.type, "id")
        )
    ]
);
def tenant: m::Role(EnterprisePhysicalLink) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(EnterprisePhysicalLink.type, i::TenantId.type, "tenant_id"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def a_device: m::Role(EnterprisePhysicalLink) = m::role(
    dataset,
    i::device,
    "a_device",
    False,
    [
        m::reference_part(
            m::field(EnterprisePhysicalLink.type, String.type, "a_ne_res_id"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def z_device: m::Role(EnterprisePhysicalLink) = m::role(
    dataset,
    i::device,
    "z_device",
    False,
    [
        m::reference_part(
            m::field(EnterprisePhysicalLink.type, String.type, "z_ne_res_id"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def a_server: m::Role(EnterprisePhysicalLink) = m::role(
    dataset,
    server::entity,
    "a_server",
    False,
    [
        m::reference_part(
            m::field(EnterprisePhysicalLink.type, String.type, "a_ne_res_id"),
            m::field(server::Identity.type, server::ServerId.type, "id")
        )
    ]
);
def z_server: m::Role(EnterprisePhysicalLink) = m::role(
    dataset,
    server::entity,
    "z_server",
    False,
    [
        m::reference_part(
            m::field(EnterprisePhysicalLink.type, String.type, "z_ne_res_id"),
            m::field(server::Identity.type, server::ServerId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type PhysicalLinkType = enum {
    @ev::itag(99)
    @ev::description("ManuallyCreate", "手动创建")
    Manual,
    @ev::itag(1)
    Lldp,
    @ev::itag(2)
    Sbs,
    @ev::itag(3)
    Mac,
    @ev::itag(4)
    Cdp,
    @ev::itag(5)
    Ip,
    @ev::itag(6)
    EthTrunk,
    @ev::itag(7)
    Csp,
    @ev::itag(8)
    @ev::description("ServerInternal", "服务器内部发现")
    ServerInternal,
    @ev::itag(9)
    @ev::description("Search", "纤缆搜索")
    FiberSearch,
    @ev::itag(10)
    Fc,
    @ev::itag(11)
    @ev::description("PlanImport", "规划导入")
    PlanImport,
    @ev::itag(12)
    @ev::description("AID", "空口发现")
    Aid,
    @ev::itag(13)
    Omci,
    @ev::itag(100)
    @ev::description("DcnNorth", "北向导入")
    DcnNorth,
};
def PhysicalLinkType_domain: v::Domain(PhysicalLinkType, Int) = v::from_enum(
    "PhysicalLinkType",
    PhysicalLinkType.type,
    Int.type,
    False
);
@knowledge_policy::reverse_references(True)
type PhysicalLinkDirection = enum {
    @ev::rename("bidirectional")
    @ev::description("Bidirectional", "双向")
    Bidirectional,
    @ev::rename("unidirectional")
    @ev::description("Unidirectional", "单向")
    Unidirectional,
};
def PhysicalLinkDirection_domain: v::Domain(PhysicalLinkDirection, String) = v::from_enum(
    "PhysicalLinkDirection",
    PhysicalLinkDirection.type,
    String.type,
    False
);
@knowledge_policy::reverse_references(True)
type PhysicalLinkStatus = enum {
    @ev::itag(2)
    @ev::itag(3)
    @ev::description("FAULT", "故障")
    Fault,
    @ev::itag(0)
    @ev::description("NORMAL", "正常")
    Normal,
    @ev::itag(1)
    @ev::description("UNKNOWN", "未知")
    Unknown,
    @ev::itag(4)
    @ev::description("OFFLINE", "离线")
    Offline,
    @ev::itag(5)
    @ev::description("UNMANAGE", "未管理")
    Unmanage,
};
def PhysicalLinkStatus_domain: v::Domain(PhysicalLinkStatus, Int) = v::from_enum(
    "PhysicalLinkStatus",
    PhysicalLinkStatus.type,
    Int.type,
    False
);
def a_ne_name_dimension: g::Binding(EnterprisePhysicalLink) = g::dimension_of(
    dataset,
    m::field(EnterprisePhysicalLink.type, String.type, "a_ne_name"),
    "physical_link_a_ne_name"
);
def z_ne_name_dimension: g::Binding(EnterprisePhysicalLink) = g::dimension_of(
    dataset,
    m::field(EnterprisePhysicalLink.type, String.type, "z_ne_name"),
    "physical_link_z_ne_name"
);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def many_many: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Many0
};
def a: r::Relation = r::relation(
    "physical_link_a_device",
    r::endpoint(dataset.row, a_device.id),
    r::endpoint(i::devices.row, i::device_subject.id),
    cardinality
);
def z: r::Relation = r::relation(
    "physical_link_z_device",
    r::endpoint(dataset.row, z_device.id),
    r::endpoint(i::devices.row, i::device_subject.id),
    cardinality
);
def relations: Array(r::Relation) = [
    a,
    z,
    r::relation(
        "physical_link_belongs_to_tenant",
        r::endpoint(dataset.row, tenant.id),
        r::endpoint(i::tenants.row, i::tenant_subject.id),
        cardinality
    )
];
def alternatives: Array(registry::Alternative) = [
    {id: "physical_link_attached_device", choices: [a, z], cardinality: many_many},
    {
        id: "physical_link_attached_server",
        choices: [
            r::relation(
                "link_a_server",
                r::endpoint(dataset.row, a_server.id),
                r::endpoint(server::dataset.row, server::subject.id),
                cardinality
            ),
            r::relation(
                "link_z_server",
                r::endpoint(dataset.row, z_server.id),
                r::endpoint(server::dataset.row, server::subject.id),
                cardinality
            )
        ],
        cardinality: many_many
    },
];
def links: Array(r::Link) = [
    r::guarded_link(
        r::link("physical_link_peer_device", a, z, edsl::LinkDirection::Undirected),
        m::field(EnterprisePhysicalLink.type, String.type, "direction"),
        edsl::FilterOp::Eq,
        "bidirectional"
    ),
    r::guarded_link(
        r::link("physical_link_downstream_device", a, z, edsl::LinkDirection::Directed),
        m::field(EnterprisePhysicalLink.type, String.type, "direction"),
        edsl::FilterOp::Eq,
        "unidirectional"
    ),
];
pub use self::{EnterprisePhysicalLink, dataset, relations, alternatives, links};

pub use self::{Identity};
