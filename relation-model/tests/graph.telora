        && string::contains(sq.sql, "link.tenant_id = d.tenant_id")
        && string::contains(pg.sql, "INNER JOIN \"connections\" AS \"link\" ON")
        && string::contains(pg.sql, " OR ") {
        True
    } else { fail!("later existence JOIN did not preserve the declared alternative key", sq, pg) }
});

