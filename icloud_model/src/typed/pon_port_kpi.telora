# PON 端口 KPI：保持来源 parentId 关联及既有样本粒度假定。
use super::inventory as i;
use super::pon_quantities as q;
use super::pon_device as p;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::samples as samples;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
type PortSampleId = struct(String);
# TODO(#51): 来源 one 与百分比显示冲突；保留既有 % 尺度，不与 ONU 百分比类型自动互换。
type ReportedPercent = struct(Float);
type Row = struct {
    res_id: PortSampleId,
    tenant_id: i::TenantId,
    parent_id: p::PonId,
    port_name: String,
    ts: s::Rfc3339Utc,
    if_in_band_rate: ReportedPercent,
    source_projectId: String,
    source_ifOutBandRate: ReportedPercent,
    source_onuHwOpticsTxPower: q::Dbm,
    source_hwOpticsTemperature: q::DegreesCelsius,
    source_ifHCInOctetsSpeed: q::BitsPerSecond,
    source_ifHCOutOctetsSpeed: q::BitsPerSecond,
    source_ifInBandRateEffcnt: Int,
    source_ifOutBandRateEffcnt: Int,
    source_onuHwOpticsTxPowerEffcnt: Int,
    source_hwOpticsTemperatureEffcnt: Int,
};
def dataset: m::Dataset(Row) = m::dataset("pon_port_kpi", "PonDevicePonPortKPI", Row.type, ["res_id", "tenant_id", "ts"]);
def device: m::Role(Row) = m::role(dataset, p::entity, "device", False, [m::identity_part(m::field(Row.type, p::PonId.type, "parent_id"), m::field(p::Identity.type, p::PonId.type, "id"))]);
def reported_percent_statistics: samples::Group(ReportedPercent) = samples::group("pon_port_Percent", ReportedPercent.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%"));
def declaration: t::Declaration = t::with_samples(t::metric(t::map_columns(t::declare(dataset, [device], [
    g::dimension(dataset, g::dimension_group("pon_port_kpi_ts", s::Rfc3339Utc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), g::input(m::field(Row.type, s::Rfc3339Utc.type, "ts")), "pon_port_kpi_ts", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::Rfc3339Utc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::Rfc3339Utc.type, "ts")), qb::UtcBucketUnit::Hour), "pon_port_kpi_utc_hour", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::Rfc3339Utc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::Rfc3339Utc.type, "ts")), qb::UtcBucketUnit::Day), "pon_port_kpi_utc_day", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::Rfc3339Utc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::Rfc3339Utc.type, "ts")), qb::UtcBucketUnit::Month), "pon_port_kpi_utc_month", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("pon_port_receive_sample", ReportedPercent.type, True, g::numeric_filters), g::input(m::field(Row.type, ReportedPercent.type, "if_in_band_rate")), "pon_port_receive_sample", True, g::numeric_filters),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "pon_port_kpi__projectId"),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__ifOutBandRate", ReportedPercent.type, True, g::numeric_filters), g::input(m::field(Row.type, ReportedPercent.type, "source_ifOutBandRate")), "pon_port_kpi__ifOutBandRate", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__onuHwOpticsTxPower", q::Dbm.type, True, g::numeric_filters), g::input(m::field(Row.type, q::Dbm.type, "source_onuHwOpticsTxPower")), "pon_port_kpi__onuHwOpticsTxPower", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__hwOpticsTemperature", q::DegreesCelsius.type, True, g::numeric_filters), g::input(m::field(Row.type, q::DegreesCelsius.type, "source_hwOpticsTemperature")), "pon_port_kpi__hwOpticsTemperature", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__ifHCInOctetsSpeed", q::BitsPerSecond.type, True, g::numeric_filters), g::input(m::field(Row.type, q::BitsPerSecond.type, "source_ifHCInOctetsSpeed")), "pon_port_kpi__ifHCInOctetsSpeed", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__ifHCOutOctetsSpeed", q::BitsPerSecond.type, True, g::numeric_filters), g::input(m::field(Row.type, q::BitsPerSecond.type, "source_ifHCOutOctetsSpeed")), "pon_port_kpi__ifHCOutOctetsSpeed", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__ifInBandRateEffcnt", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_ifInBandRateEffcnt")), "pon_port_kpi__ifInBandRateEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__ifOutBandRateEffcnt", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_ifOutBandRateEffcnt")), "pon_port_kpi__ifOutBandRateEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__onuHwOpticsTxPowerEffcnt", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_onuHwOpticsTxPowerEffcnt")), "pon_port_kpi__onuHwOpticsTxPowerEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("pon_port_kpi__hwOpticsTemperatureEffcnt", Int.type, True, g::numeric_filters), g::input(m::field(Row.type, Int.type, "source_hwOpticsTemperatureEffcnt")), "pon_port_kpi__hwOpticsTemperatureEffcnt", True, g::numeric_filters),
], []), [
    t::column(m::field(Row.type, PortSampleId.type, "res_id"), "resId"),
    t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
    t::column(m::field(Row.type, p::PonId.type, "parent_id"), "parentId"),
    t::column(m::field(Row.type, String.type, "port_name"), "portName"),
    t::column(m::field(Row.type, s::Rfc3339Utc.type, "ts"), "ts"),
    t::column(m::field(Row.type, ReportedPercent.type, "if_in_band_rate"), "ifInBandRate"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::field(Row.type, ReportedPercent.type, "source_ifOutBandRate"), "ifOutBandRate"),
    t::column(m::field(Row.type, q::Dbm.type, "source_onuHwOpticsTxPower"), "onuHwOpticsTxPower"),
    t::column(m::field(Row.type, q::DegreesCelsius.type, "source_hwOpticsTemperature"), "hwOpticsTemperature"),
    t::column(m::field(Row.type, q::BitsPerSecond.type, "source_ifHCInOctetsSpeed"), "ifHCInOctetsSpeed"),
    t::column(m::field(Row.type, q::BitsPerSecond.type, "source_ifHCOutOctetsSpeed"), "ifHCOutOctetsSpeed"),
    t::column(m::field(Row.type, Int.type, "source_ifInBandRateEffcnt"), "ifInBandRateEffcnt"),
    t::column(m::field(Row.type, Int.type, "source_ifOutBandRateEffcnt"), "ifOutBandRateEffcnt"),
    t::column(m::field(Row.type, Int.type, "source_onuHwOpticsTxPowerEffcnt"), "onuHwOpticsTxPowerEffcnt"),
    t::column(m::field(Row.type, Int.type, "source_hwOpticsTemperatureEffcnt"), "hwOpticsTemperatureEffcnt"),
]), m::field(Row.type, s::Rfc3339Utc.type, "ts")), [
    samples::bind(dataset, reported_percent_statistics, m::field(Row.type, ReportedPercent.type, "if_in_band_rate"), [{statistic: samples::Statistic::Mean, publish: "pon_port_receive_usage"}, {statistic: samples::Statistic::Max, publish: "pon_port_receive_sample_max"}, {statistic: samples::Statistic::Min, publish: "pon_port_receive_sample_min"}]),
    samples::bind(dataset, reported_percent_statistics, m::field(Row.type, ReportedPercent.type, "source_ifOutBandRate"), [{statistic: samples::Statistic::Mean, publish: "pon_port_transmit_usage"}, {statistic: samples::Statistic::Max, publish: "pon_port_transmit_usage_max"}, {statistic: samples::Statistic::Min, publish: "pon_port_transmit_usage_min"}]),
    samples::bind(dataset, q::Dbm_statistics, m::field(Row.type, q::Dbm.type, "source_onuHwOpticsTxPower"), [{statistic: samples::Statistic::Mean, publish: "pon_port_optics_tx_power"}, {statistic: samples::Statistic::Max, publish: "pon_port_optics_tx_power_max"}, {statistic: samples::Statistic::Min, publish: "pon_port_optics_tx_power_min"}]),
    samples::bind(dataset, q::DegreesCelsius_statistics, m::field(Row.type, q::DegreesCelsius.type, "source_hwOpticsTemperature"), [{statistic: samples::Statistic::Mean, publish: "pon_port_optics_temperature"}, {statistic: samples::Statistic::Max, publish: "pon_port_optics_temperature_max"}, {statistic: samples::Statistic::Min, publish: "pon_port_optics_temperature_min"}]),
    samples::bind(dataset, q::BitsPerSecond_statistics, m::field(Row.type, q::BitsPerSecond.type, "source_ifHCInOctetsSpeed"), [{statistic: samples::Statistic::Mean, publish: "pon_port_rx_rate"}, {statistic: samples::Statistic::Max, publish: "pon_port_rx_rate_max"}, {statistic: samples::Statistic::Min, publish: "pon_port_rx_rate_min"}]),
    samples::bind(dataset, q::BitsPerSecond_statistics, m::field(Row.type, q::BitsPerSecond.type, "source_ifHCOutOctetsSpeed"), [{statistic: samples::Statistic::Mean, publish: "pon_port_tx_rate"}, {statistic: samples::Statistic::Max, publish: "pon_port_tx_rate_max"}, {statistic: samples::Statistic::Min, publish: "pon_port_tx_rate_min"}]),
]);
def relations: Array(r::Relation) = [
    r::relation("pon_port_kpi_of_device", dataset, device, p::dataset, p::subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("source_EntPonElementAssociationPonDevicePonPortKPI", p::dataset, p::subject, dataset, device, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
pub use self::{declaration, relations};
