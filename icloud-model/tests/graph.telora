pub def independently_filtered_alarm_measures_keep_separate_thresholds: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"alarm","measure":"critical_alarm_count"},
                    {"node":"alarm","measure":"major_alarm_count"}],
        "group_by_identity":["device"],
        "measure_having":[{"node":"alarm","measure":"critical_alarm_count","op":"gt","kind":"int","value":2},
                          {"node":"alarm","measure":"major_alarm_count","op":"gt","kind":"int","value":1}]}
    "#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?1) AS alarm_critical_alarm_count")
        && string::contains(sq.sql, "count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?2) AS alarm_major_alarm_count")
        && string::contains(sq.sql, "HAVING count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?1) > ?3")
        && string::contains(sq.sql, "count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?2) > ?4")
        && string::contains(pg.sql, "FILTER (WHERE \"alarm\".\"SEVERITY\" = $1)")
        && sq.bindings == [qb::Val::String("1"), qb::Val::String("2"), qb::Val::Int(2), qb::Val::Int(1)]
        && pg.bindings == sq.bindings { True }
    else { fail!("independent filtered alarm thresholds merged their populations", sq, pg) }
});

pub def device_kpi_sum_in_each_frame_context: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"frame",
        "nodes":[{"id":"frame","entity":"frame"},{"id":"device","entity":"device"},
                 {"id":"sample","entity":"device_kpi"}],
        "edges":[{"relation":"frame_belongs_to_device","from":"frame","to":"device"},
                 {"relation":"device_kpi_of_device","from":"sample","to":"device"}],
        "select":[{"node":"frame","dimension":"frame_name"},{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"sample","measure":"port_count"}],
        "group_by_identity":["frame","device"],
        "filters":[{"node":"sample","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-04 00:00:00"}]}
    "#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "frame.refParentNE = device.id AND frame.tenantId = device.tenant_id")
        && string::contains(sq.sql, "sample.resId = device.id")
        && string::contains(sq.sql, "sample.tenantId = device.tenant_id")
        && string::contains(sq.sql, "sum(sample.portCount) AS sample_port_count")
        && string::contains(sq.sql, "GROUP BY frame.name, device.name, frame.id, frame.tenantId, device.id, device.tenant_id")
        && string::contains(pg.sql, "sum(\"sample\".\"portCount\")")
        && sq.bindings == pg.bindings { True }
    else { fail!(`contextual Device KPI SUM lost Frame and owner identity: \{sq.sql} / \{pg.sql}`, sq, pg) }
});

pub def frame_context_requires_owner_identity_group: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{"op":"graph","root":"frame",
        "nodes":[{"id":"frame","entity":"frame"},{"id":"device","entity":"device"},
