pub def relations: Array(r::Relation) = [
    r::relation("fs__sh", domain::endpoint(FileSystem.type, "file_system_id"), domain::endpoint(share::Share.type, "fs_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}),
    r::relation("cbfs2__fs_rev", domain::endpoint(FileSystem.type, "obj_sys_id"), domain::endpoint(cloud_block_file_system_2_kpi::CloudBlockFileSystem2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
