use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 终端来源独立声明：不收紧 M:N 上界，时间单位仍待生产确认。
use super::inventory as i;
use super::site as sites;
use super::pon_device as pons;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
type TerminalId = struct(String);
@domain::entity_by("Terminal")
type TerminalById = struct(TerminalId);
@domain::subject("Terminal", "source_resId")
@domain::dataset("source_EntTerminalElement", "EntTerminalElement", ["source_resId"])
@domain::relations(relations)
@domain::alternatives(alternatives)
type EntTerminalElement = struct {
    @m::column("tenantId")
    @g::exact("source_EntTerminalElement__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("projectId")
    @g::exact("source_EntTerminalElement__projectId")
    source_projectId: domain::Reference(sites::SiteById),
    @m::column("resId")
    @g::exact("source_EntTerminalElement__resId")
    source_resId: TerminalById,
    @m::column("mac")
    @g::search("source_EntTerminalElement__mac")
    source_mac: String,
    @m::column("name")
    @g::search("source_EntTerminalElement__name")
    source_name: String,
    @m::column("ip")
    @g::search("source_EntTerminalElement__ip")
    @g::ipv4_view("source_EntTerminalElement__ip_ipv4")
    source_ip: String,
    @m::column("ipv6")
    @g::search("source_EntTerminalElement__ipv6")
    source_ipv6: String,
    @m::column("status")
    @g::exact("source_EntTerminalElement__status_raw")
    @v::map(
        SourceEntTerminalElementStatus.type,
        "source_EntTerminalElement__status",
        [
            v::member(SourceEntTerminalElementStatus::Unknown, [-1]),
            v::member(SourceEntTerminalElementStatus::Online, [0]),
            v::member(SourceEntTerminalElementStatus::Offline, [1])
        ]
    )
    source_status: Int,
    @m::column("type")
    @g::exact("source_EntTerminalElement__type_raw")
    @v::map(
        SourceEntTerminalElementType.type,
        "source_EntTerminalElement__type",
        [
            v::member(SourceEntTerminalElementType::AccessPoint, ["AccessPoint"]),
            v::member(
                SourceEntTerminalElementType::AudioImagingOrVideoEquipment,
                ["AudioImagingOrVideoEquipment"]
            ),
            v::member(SourceEntTerminalElementType::Desktop, ["Desktop"]),
            v::member(
                SourceEntTerminalElementType::FirewallAndSecurityAppliance,
                ["FirewallAndSecurityAppliance"]
            ),
            v::member(SourceEntTerminalElementType::Hit, ["HIT"]),
            v::member(SourceEntTerminalElementType::IpCamera, ["IPCamera"]),
            v::member(SourceEntTerminalElementType::InternetOfThings, ["InternetOfThings"]),
            v::member(SourceEntTerminalElementType::Laptop, ["Laptop"]),
            v::member(SourceEntTerminalElementType::MedicalDevice, ["MedicalDevice"]),
            v::member(SourceEntTerminalElementType::MobilePhone, ["MobilePhone"]),
            v::member(SourceEntTerminalElementType::OperatingSystem, ["OperatingSystem"]),
            v::member(SourceEntTerminalElementType::Others, ["Others"]),
            v::member(SourceEntTerminalElementType::Bridge, ["Bridge"]),
            v::member(SourceEntTerminalElementType::FinancialEquipment, ["FinancialEquipment"]),
            v::member(SourceEntTerminalElementType::Gateway, ["Gateway"]),
            v::member(SourceEntTerminalElementType::HandheldComputers, ["HandheldComputers"]),
            v::member(SourceEntTerminalElementType::LoadBalancer, ["LoadBalancer"]),
            v::member(
                SourceEntTerminalElementType::MonitoringAndTestingDevice,
                ["MonitoringAndTestingDevice"]
            ),
            v::member(SourceEntTerminalElementType::NetworkAccessDevice, ["NetworkAccessDevice"]),
            v::member(SourceEntTerminalElementType::Pbx, ["PBX"]),
            v::member(SourceEntTerminalElementType::PhysicalSecurity, ["PhysicalSecurity"]),
            v::member(SourceEntTerminalElementType::ThinClient, ["ThinClient"]),
            v::member(SourceEntTerminalElementType::WanAccelerator, ["WANAccelerator"]),
            v::member(SourceEntTerminalElementType::PersonalComputer, ["PersonalComputer"]),
            v::member(SourceEntTerminalElementType::PowerDevice, ["PowerDevice"]),
            v::member(SourceEntTerminalElementType::Printer, ["Printer"]),
            v::member(SourceEntTerminalElementType::Router, ["Router"]),
            v::member(SourceEntTerminalElementType::Server, ["Server"]),
            v::member(SourceEntTerminalElementType::SetTopBox, ["SetTopBox"]),
            v::member(SourceEntTerminalElementType::StorageDevice, ["StorageDevice"]),
            v::member(SourceEntTerminalElementType::Switch, ["Switch"]),
            v::member(SourceEntTerminalElementType::Tablet, ["Tablet"]),
            v::member(SourceEntTerminalElementType::VoIpDevice, ["VoIPDevice"]),
            v::member(SourceEntTerminalElementType::Watch, ["Watch"]),
            v::member(SourceEntTerminalElementType::WirelessDevice, ["WirelessDevice"])
        ]
    )
    source_type: String,
    @m::column("vendor")
    @g::search("source_EntTerminalElement__vendor")
    source_vendor: String,
    @m::column("model")
    @g::search("source_EntTerminalElement__model")
    source_model: String,
    @m::column("serialNumber")
    @g::search("source_EntTerminalElement__serialNumber")
    source_serialNumber: String,
    @m::column("osName")
    @g::search("source_EntTerminalElement__osName")
    source_osName: String,
    @m::column("priority")
    @g::exact("source_EntTerminalElement__priority_raw")
    @v::map(
        SourceEntTerminalElementPriority.type,
        "source_EntTerminalElement__priority",
        [
            v::member(SourceEntTerminalElementPriority::Vip, [10]),
            v::member(SourceEntTerminalElementPriority::Important, [20]),
            v::member(SourceEntTerminalElementPriority::Common, [30])
        ]
    )
    source_priority: Int,
    @m::column("source")
    @g::exact("source_EntTerminalElement__source_raw")
    @v::map(
        SourceEntTerminalElementSource.type,
        "source_EntTerminalElement__source",
        [
            v::member(SourceEntTerminalElementSource::AutomaticIdentification, [0]),
            v::member(SourceEntTerminalElementSource::AdministratorAdded, [1]),
            v::member(SourceEntTerminalElementSource::UserSelfRegistration, [2]),
            v::member(SourceEntTerminalElementSource::BoardingSelfRegistration, [3]),
            v::member(SourceEntTerminalElementSource::MdmSelfRegistration, [4]),
            v::member(SourceEntTerminalElementSource::TerminalIdentificationAndDiscovery, [5]),
            v::member(SourceEntTerminalElementSource::ThirdPartySystemAdded, [6]),
            v::member(SourceEntTerminalElementSource::DeviceReporting, [7]),
            v::member(SourceEntTerminalElementSource::DeviceScanning, [8]),
            v::member(SourceEntTerminalElementSource::QiankunOpSynchronization, [9]),
            v::member(SourceEntTerminalElementSource::IdeaHub, [10])
        ]
    )
    source_source: Int,
    @m::column("remark")
    @g::search("source_EntTerminalElement__remark")
    source_remark: String,
    @m::column("accessDeviceId")
    @g::exact("source_EntTerminalElement__accessDeviceId")
    @domain::targets(
        [
            {name: "device", identity: i::DeviceById.type}.ty!(domain::ReferenceTarget),
            {name: "pon", identity: pons::PonElementById.type}.ty!(domain::ReferenceTarget)
        ]
    )
    source_accessDeviceId: domain::Reference(String),
    @m::column("accessIfName")
    @g::search("source_EntTerminalElement__accessIfName")
    source_accessIfName: String,
    @m::column("vlanId")
    @g::field_view(
        g::dimension_group("integer", Int.type, True, g::numeric_filters),
        "source_EntTerminalElement__vlanId",
        True,
        g::numeric_filters
    )
    source_vlanId: Int,
    @m::column("siteId")
    @g::exact("source_EntTerminalElement__siteId")
    source_siteId: domain::Reference(sites::SiteById),
    @m::column("unauthorized")
    @g::field_view(
        g::dimension_group("integer", Int.type, True, g::numeric_filters),
        "source_EntTerminalElement__unauthorized",
        True,
        g::numeric_filters
    )
    source_unauthorized: Int,
    @m::column("isBlocked")
    @g::field_view(
        g::dimension_group("integer", Int.type, True, g::numeric_filters),
        "source_EntTerminalElement__isBlocked",
        True,
        g::numeric_filters
    )
    source_isBlocked: Int,
    @m::column("blockStatus")
    @g::exact("source_EntTerminalElement__blockStatus_raw")
    @v::map(
        SourceEntTerminalElementBlockStatus.type,
        "source_EntTerminalElement__blockStatus",
        [
            v::member(SourceEntTerminalElementBlockStatus::NotBlocked, [0]),
            v::member(SourceEntTerminalElementBlockStatus::MacBlocked, [1]),
            v::member(SourceEntTerminalElementBlockStatus::PortShutdown, [2])
        ]
    )
    source_blockStatus: Int,
    # 沿用旧 UTC 毫秒假定；来源整数时钟单位尚待确认。
    @m::column("blockTime")
    @g::field_view(
        g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::numeric_filters),
        "source_EntTerminalElement__blockTime",
        True,
        g::numeric_filters
    )
    source_blockTime: s::EpochMillis,
};

def subject: r::Endpoint = domain::endpoint(EntTerminalElement.type, "source_resId");
def tenant: r::Endpoint = domain::endpoint(EntTerminalElement.type, "source_tenantId");
def site: r::Endpoint = domain::endpoint(EntTerminalElement.type, "source_siteId");
def project: r::Endpoint = domain::endpoint(EntTerminalElement.type, "source_projectId");
def device: r::Endpoint = domain::endpoint(EntTerminalElement.type, "device");
def pon: r::Endpoint = domain::endpoint(EntTerminalElement.type, "pon");

@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementStatus = enum {
    @ev::itag(-1)
    @ev::description("Unknown", "未知")
    Unknown,
    @ev::itag(0)
    @ev::description("Online", "在线")
    Online,
    @ev::itag(1)
    @ev::description("Offline", "离线")
    Offline,
};

@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementType = enum {
    @ev::description("AccessPoint", "接入点")
    AccessPoint,

    @ev::description("AudioImagingOrVideoEquipment", "音频、图像或视频设备")
    AudioImagingOrVideoEquipment,

    @ev::description("Desktop", "台式机")
    Desktop,

    @ev::description("FirewallAndSecurityAppliance", "防火墙和安全设备")
    FirewallAndSecurityAppliance,

    @ev::description("HIT", "家庭终端")
    Hit,

    @ev::description("IPCamera", "网络摄像头")
    IpCamera,

    @ev::description("InternetOfThings", "物联网设备（IoT）")
    InternetOfThings,

    @ev::description("Laptop", "笔记本电脑")
    Laptop,

    @ev::description("MedicalDevice", "医疗器械")
    MedicalDevice,

    @ev::description("MobilePhone", "手机")
    MobilePhone,

    @ev::description("OperatingSystem", "操作系统")
    OperatingSystem,

    @ev::description("Others", "其他")
    Others,

    @ev::description("Bridge", "网桥")
    Bridge,

    @ev::description("FinancialEquipment", "金融设备")
    FinancialEquipment,

    @ev::description("Gateway", "网关")
    Gateway,

    @ev::description("HandheldComputers", "手持式计算机")
    HandheldComputers,

    @ev::description("LoadBalancer", "负载均衡设备")
    LoadBalancer,

    @ev::description("MonitoringAndTestingDevice", "监控和测试装置")
    MonitoringAndTestingDevice,

    @ev::description("NetworkAccessDevice", "网络接入设备")
    NetworkAccessDevice,

    @ev::description("PBX", "专用小交换机")
    Pbx,

    @ev::description("PhysicalSecurity", "物理安全")
    PhysicalSecurity,

    @ev::description("ThinClient", "瘦客户端")
    ThinClient,

    @ev::description("WANAccelerator", "广域网加速器")
    WanAccelerator,

    @ev::description("PersonalComputer", "个人电脑")
    PersonalComputer,

    @ev::description("PowerDevice", "电源设备")
    PowerDevice,

    @ev::description("Printer", "打印机")
    Printer,

    @ev::description("Router", "路由器")
    Router,

    @ev::description("Server", "服务器")
    Server,

    @ev::description("SetTopBox", "机顶盒")
    SetTopBox,

    @ev::description("StorageDevice", "存储设备")
    StorageDevice,

    @ev::description("Switch", "交换机")
    Switch,

    @ev::description("Tablet", "平板电脑")
    Tablet,

    @ev::description("VoIPDevice", "VoIP设备")
    VoIpDevice,

    @ev::description("Watch", "手表")
    Watch,

    @ev::description("WirelessDevice", "无线设备")
    WirelessDevice,
};

@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementPriority = enum {
    @ev::itag(10)
    Vip,
    @ev::itag(20)
    @ev::description("Important", "重要")
    Important,
    @ev::itag(30)
    @ev::description("Common", "一般")
    Common,
};

@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementSource = enum {
    @ev::itag(0)
    @ev::description("Automatic identification", "自动识别")
    AutomaticIdentification,
    @ev::itag(1)
    @ev::description("Administrator added", "管理员添加")
    AdministratorAdded,
    @ev::itag(2)
    @ev::description("User self-registration", "用户自注册")
    UserSelfRegistration,
    @ev::itag(3)
    @ev::description("Boarding self-registration", "boarding自注册")
    BoardingSelfRegistration,
    @ev::itag(4)
    @ev::description("MDM self-registration", "MDM自注册")
    MdmSelfRegistration,
    @ev::itag(5)
    @ev::description("Terminal identification and discovery", "终端识别发现")
    TerminalIdentificationAndDiscovery,
    @ev::itag(6)
    @ev::description("Third-party system added", "三方系统添加")
    ThirdPartySystemAdded,
    @ev::itag(7)
    @ev::description("Device reporting", "设备上报")
    DeviceReporting,
    @ev::itag(8)
    @ev::description("Device scanning", "设备扫描")
    DeviceScanning,
    @ev::itag(9)
    @ev::description("Qiankun OP synchronization", "乾坤OP同步")
    QiankunOpSynchronization,
    @ev::itag(10)
    IdeaHub,
};

@knowledge_policy::reverse_references(True)
type SourceEntTerminalElementBlockStatus = enum {
    @ev::itag(0)
    @ev::description("Not blocked", "未阻断")
    NotBlocked,
    @ev::itag(1)
    @ev::description("MAC blocked", "mac阻断")
    MacBlocked,
    @ev::itag(2)
    @ev::description("Port shutdown", "端口shutdown")
    PortShutdown,
};

def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_EntTerminalElement_EntNetworkElement",
        device,
        i::device_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EntTerminalElement_EntPonElement",
        pon,
        pons::subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0}
    ),
    r::relation("source_EntTerminalElement_X_TENANT_VIEW", tenant, i::tenant_subject, cardinality),
];
def alternatives: Array(domain::Alternative) = [
    {
        id: "source_EntTerminalElement_X_SITE_VIEW",
        cardinality,
        choices: [
            r::relation("terminal_site", site, sites::subject, cardinality),
            r::relation("terminal_project", project, sites::subject, cardinality),
        ]
    }
];
pub use self::{relations, alternatives};

pub use self::{EntTerminalElement, TerminalById};

pub use self::{
    SourceEntTerminalElementStatus,
    SourceEntTerminalElementType,
    SourceEntTerminalElementPriority,
    SourceEntTerminalElementSource,
    SourceEntTerminalElementBlockStatus
};
