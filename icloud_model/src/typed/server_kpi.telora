use ontology::registry as registry;
# 服务器采样独立声明，Latest 采用权威UTC时钟与完整采样grain
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::quantity::{Percent};
type Watts = struct(
    Float
);
# averagePower 未在当前公共契约声明单位，保留来源值而不隐式换算
type ReportedAveragePower = struct(
    Float
);
@registry::dataset("server_kpi", "ServerDeviceKPI", ["res_id", "tenant_id", "ts"])
@registry::roles([owner])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "server_kpi_ts_raw",
                s::DateTimeUtc.type,
                True,
                [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
            ),
            g::input(m::field(ServerDeviceKPI.type, s::DateTimeUtc.type, "ts")),
            "server_kpi_ts_raw",
            True,
            [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_memory_sample", Percent.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Percent.type, "mem_usage")),
            "server_memory_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_cpu_sample", Percent.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Percent.type, "cpu_usage")),
            "server_cpu_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "server_average_power_sample",
                ReportedAveragePower.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(ServerDeviceKPI.type, ReportedAveragePower.type, "average_power")),
            "server_average_power_sample",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_kpi__systemPower", Watts.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Watts.type, "source_systemPower")),
            "server_kpi__systemPower",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_kpi__peakPower", Watts.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Watts.type, "source_peakPower")),
            "server_kpi__peakPower",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_kpi__cpuUsageEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Int.type, "source_cpuUsageEffcnt")),
            "server_kpi__cpuUsageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_kpi__memUsageEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Int.type, "source_memUsageEffcnt")),
            "server_kpi__memUsageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_kpi__systemPowerEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Int.type, "source_systemPowerEffcnt")),
            "server_kpi__systemPowerEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_kpi__averagePowerEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Int.type, "source_averagePowerEffcnt")),
            "server_kpi__averagePowerEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("server_kpi__peakPowerEffcnt", Int.type, True, g::numeric_filters),
            g::input(m::field(ServerDeviceKPI.type, Int.type, "source_peakPowerEffcnt")),
            "server_kpi__peakPowerEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "utc_bucket",
                s::DateTimeUtc.type,
                True,
                [
                    g::Filter::Eq,
                    g::Filter::Ne,
                    g::Filter::Lt,
                    g::Filter::Le,
                    g::Filter::Gt,
                    g::Filter::Ge
                ]
            ),
            g::utc_bucket(
                g::input(m::field(ServerDeviceKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Hour
            ),
            "server_kpi_utc_hour",
            True,
            [
                g::Filter::Eq,
                g::Filter::Ne,
                g::Filter::Lt,
                g::Filter::Le,
                g::Filter::Gt,
                g::Filter::Ge
            ]
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "utc_bucket",
                s::DateTimeUtc.type,
                True,
                [
                    g::Filter::Eq,
                    g::Filter::Ne,
                    g::Filter::Lt,
                    g::Filter::Le,
                    g::Filter::Gt,
                    g::Filter::Ge
                ]
            ),
            g::utc_bucket(
                g::input(m::field(ServerDeviceKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Day
            ),
            "server_kpi_utc_day",
            True,
            [
                g::Filter::Eq,
                g::Filter::Ne,
                g::Filter::Lt,
                g::Filter::Le,
                g::Filter::Gt,
                g::Filter::Ge
            ]
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "utc_bucket",
                s::DateTimeUtc.type,
                True,
                [
                    g::Filter::Eq,
                    g::Filter::Ne,
                    g::Filter::Lt,
                    g::Filter::Le,
                    g::Filter::Gt,
                    g::Filter::Ge
                ]
            ),
            g::utc_bucket(
                g::input(m::field(ServerDeviceKPI.type, s::DateTimeUtc.type, "ts")),
                qb::UtcBucketUnit::Month
            ),
            "server_kpi_utc_month",
            True,
            [
                g::Filter::Eq,
                g::Filter::Ne,
                g::Filter::Lt,
                g::Filter::Le,
                g::Filter::Gt,
                g::Filter::Ge
            ]
        ),
    ]
)
@registry::metric("ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            statistics,
            m::field(ServerDeviceKPI.type, Percent.type, "mem_usage"),
            [
                {statistic: samples::Statistic::Mean, publish: "server_memory_usage"},
                {statistic: samples::Statistic::Latest, publish: "server_memory_latest"},
                {statistic: samples::Statistic::Max, publish: "server_memory_sample_max"},
                {statistic: samples::Statistic::Min, publish: "server_memory_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            statistics,
            m::field(ServerDeviceKPI.type, Percent.type, "cpu_usage"),
            [
                {statistic: samples::Statistic::Mean, publish: "server_cpu_usage"},
                {statistic: samples::Statistic::Latest, publish: "server_cpu_latest"},
                {statistic: samples::Statistic::Max, publish: "server_cpu_peak"},
                {statistic: samples::Statistic::Min, publish: "server_cpu_sample_min"}
            ]
        ),
    ]
)
@registry::relations(relations)
type ServerDeviceKPI = struct {
    @m::column("resId")
    res_id: server::ServerId,
    @m::column("tenantId")
    tenant_id: i::TenantId,
    ts: s::DateTimeUtc,
    @m::column("memUsage")
    mem_usage: Percent,
    @m::column("cpuUsage")
    cpu_usage: Percent,
    @m::column("averagePower")
    average_power: ReportedAveragePower,
    @m::column("parentId")
    @g::exact("server_kpi__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("server_kpi__projectId")
    source_projectId: String,
    @m::column("systemPower")
    source_systemPower: Watts,
    @m::column("peakPower")
    source_peakPower: Watts,
    @m::column("cpuUsageEffcnt")
    source_cpuUsageEffcnt: Int,
    @m::column("memUsageEffcnt")
    source_memUsageEffcnt: Int,
    @m::column("systemPowerEffcnt")
    source_systemPowerEffcnt: Int,
    @m::column("averagePowerEffcnt")
    source_averagePowerEffcnt: Int,
    @m::column("peakPowerEffcnt")
    source_peakPowerEffcnt: Int,
};
def dataset: m::Dataset(ServerDeviceKPI) = registry::dataset_of(ServerDeviceKPI.type);
def owner: m::Role(ServerDeviceKPI) = m::role(
    dataset,
    server::entity,
    "server",
    False,
    [
        m::identity_part(
            m::field(ServerDeviceKPI.type, server::ServerId.type, "res_id"),
            m::field(server::Identity.type, server::ServerId.type, "id")
        )
    ]
);
def statistics: samples::Group(Percent) = samples::group(
    "server_percent",
    Percent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Latest, samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
def relations: Array(r::Relation) = [
    r::relation(
        "server_kpi_of_server",
        r::endpoint(dataset.row, owner.id),
        r::endpoint(server::dataset.row, server::subject.id),
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_PhysicalServer_ServerDeviceKPI",
        r::endpoint(server::dataset.row, server::subject.id),
        r::endpoint(dataset.row, owner.id),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{relations};

pub use self::{ServerDeviceKPI};
