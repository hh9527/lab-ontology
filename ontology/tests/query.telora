# ---------------------------------------------------------------------------
# P0: role aliases and structured (Eq/And/Or) join conditions.
# ---------------------------------------------------------------------------

def role_alias_join_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "test-role-alias-join",
        sources: [qb.source("t", "transfers")],
        projection: [
            qb.expr_item(qb.column("t", "id")),
            qb.expr_item(qb.column("a", "name")),
            qb.expr_item(qb.column("r", "name")),
        ],
        filter: None,
        exists: [],
        joins: [
            qb.join(
                qb.JoinKind.Inner,
                qb.source("a", "accounts"),
                qb.column_ref("t", "from_id"),
                qb.column_ref("a", "id"),
            ),
            qb.join_on(qb.JoinKind.Inner, qb.source("r", "accounts"), qb.on_or([
                qb.on_eq(qb.column_ref("t", "to_id"), qb.column_ref("r", "id")),
                qb.on_eq(qb.column_ref("a", "parent_id"), qb.column_ref("r", "id")),
            ])),
        ],
        grouping: [],
        having: [],
        ordering: [],
        limit: None,
        offset: None,
        derived: None,
        partition: None,
        scalar_comparisons: [],
        ranked_key_comparisons: [],
    };
    plan
};

def role_alias_join_renders_two_roles_and_compound_on = fn() {
    let q = qb.transform_sqlite(role_alias_join_plan());
    q.sql == "SELECT t.id, a.name, r.name FROM transfers AS t INNER JOIN accounts AS a ON t.from_id = a.id INNER JOIN accounts AS r ON (t.to_id = r.id OR a.parent_id = r.id)"
        && array.length(q.bindings) == 0
};

def role_alias_join_site_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
