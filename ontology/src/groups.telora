# RFC 0002 阶段 B：封闭表达式、可复用模板和显式绑定。
use crate::model as model;
use crate::quantity as quantity;
use crate::query as qb;
use crate::scalars as scalars;
use crate::ontology as edsl;
use std::array as array;
use std::type_desc as td;

type Column = struct {
    name: String,
    value: Type,
    nullable: Bool
};
type RateInputs = struct {
    amount: Node,
    duration: Node
};
type IdentityInput = struct {
    column: Column,
    parts: Array(Column)
};
type BucketInput = struct {
    input: Node,
    unit: qb::UtcBucketUnit
};
type Node = enum {
    Column(Column),
    Seconds(Node),
    Ipv4(Node),
    UtcBucket(BucketInput),
    Rate(RateInputs),
    Identity(IdentityInput),
};
type Shape = struct {
    value: Type,
    nullable: Bool
};
type Expr(Row, Value) = struct {
    row: Type,
    value: Type,
    nullable: Bool,
    node: Node
};

def column_shape: Fn(Type, Column) -> Shape = fn(row, column) {
    let actual = match array::find(
        td::fields(row),
        fn(field) {
            field.name == column.name
        }
    ) {
        Some(field) => field.ty,
        None => fail!("group input field does not exist", column.name),
    };
    let valid = if column.nullable {
        let variants = td::variants(actual);
        array::length(variants) == 2 && array::any(
            variants,
            fn(v) {
                v.name == "None" && v.payload == None
            }
        ) && array::any(
            variants,
            fn(v) {
                v.name == "Some" && v.payload == Some(column.value)
            }
        )
    } else {
        actual == column.value
    };
    if !valid {
        fail!("group input field has incompatible type", column.name)
    } else {
        {value: column.value, nullable: column.nullable}
    }
};
def shape: Fn(Type, Node) -> Shape = fn(row, node) {
    match node {
        Node::Column(column) => column_shape(row, column),
        Node::UtcBucket(bucket) => {
            let source = shape(row, bucket.input);
            bucket_encoding(source.value, bucket.unit);
            {value: source.value, nullable: True}
        },
        Node::Ipv4(input) => {
            let source = shape(row, input);
            if source.value != String.type {
                fail!("IPv4 view requires text input", source.value)
            } else {
                {value: scalars::Ipv4.type, nullable: True}
            }
        },
        Node::Seconds(input) => {
            let source = shape(row, input);
            if source.value != quantity::Milliseconds.type {
                fail!("seconds conversion requires milliseconds", source.value)
            } else {
                {value: quantity::Seconds.type, nullable: source.nullable}
            }
        },
        Node::Rate(inputs) => {
            let amount = shape(row, inputs.amount);
            let duration = shape(row, inputs.duration);
            if amount.value != quantity::Bytes.type || duration.value != quantity::Seconds.type {
                fail!("rate expression requires bytes and seconds", amount.value, duration.value)
            } else {
                {value: quantity::BytesPerSecond.type, nullable: True}
            }
        },
        Node::Identity(input) => {
            let value = column_shape(row, input.column);
            array::map(
                input.parts,
                fn(part) {
                    column_shape(row, part)
                }
            );
            if array::length(input.parts) == 0 || !array::any(
                input.parts,
                fn(part) {
                    part == input.column
                }
            ) {
                fail!("identity dimension must include its complete role", input.column.name)
            } else {
                {
                    value: value.value,
                    nullable: array::any(
                        input.parts,
                        fn(part) {
                            part.nullable
                        }
                    )
                }
            }
        },
    }
};
def checked: for(Row, Value) Fn(Expr(Row, Value)) -> Expr(Row, Value) = fn(expr) {
    let actual = shape(Row.type, expr.node);
    if expr.row != Row.type || expr.value != Value.type || actual.value != Value.type || actual.nullable != expr.nullable {
        fail!("group expression witness does not match its type", expr.value)
    } else {
        expr
    }
};
def input: for(Row, Value) Fn(model::Field(Row, Value)) -> Expr(Row, Value) = fn(field) {
    {
        row: Row.type,
        value: field.value,
        nullable: field.nullable,
        node: Node::Column({name: field.name, value: field.value, nullable: field.nullable})
    }
};
def seconds: for(Row) Fn(Expr(Row, quantity::Milliseconds)) -> Expr(Row, quantity::Seconds) = fn(
    source
) {
    {
        row: Row.type,
        value: quantity::Seconds.type,
        nullable: source.nullable,
        node: Node::Seconds(source.node)
    }
};
def rate: for(Row) Fn(
    Expr(Row, quantity::Bytes),
    Expr(Row, quantity::Seconds)
) -> Expr(Row, quantity::BytesPerSecond) = fn(amount, duration) {
    {
        row: Row.type,
        value: quantity::BytesPerSecond.type,
        nullable: True,
        node: Node::Rate({amount: amount.node, duration: duration.node})
    }
};

def ipv4: for(Row) Fn(Expr(Row, String)) -> Expr(Row, scalars::Ipv4) = fn(source) {
    {row: Row.type, value: scalars::Ipv4.type, nullable: True, node: Node::Ipv4(source.node)}
};

def bucket_encoding: Fn(Type, qb::UtcBucketUnit) -> qb::UtcBucketEncoding = fn(value, unit) {
    match scalars::time_role(value) {
        None => fail!("UTC bucket requires a UTC time type", value),
        Some(role) => if role.semantics == edsl::TimeSemantics::Local {
            fail!("UTC bucket does not accept local time", value)
        } else {
            match role.encoding {
                edsl::TimeEncoding::EpochMillis => qb::UtcBucketEncoding::EpochMillis,
                edsl::TimeEncoding::Rfc3339Text => qb::UtcBucketEncoding::DateTimeUtc,
                edsl::TimeEncoding::DateText => if unit == qb::UtcBucketUnit::Hour {
                    fail!("Date has no hour bucket")
                } else {
                    qb::UtcBucketEncoding::Date
                },
                _ => fail!("UTC bucket does not accept local time", value),
            }
        },
    }
};
def utc_bucket: for(Row, Time) Fn(Expr(Row, Time), qb::UtcBucketUnit) -> Expr(Row, Time) = fn(
    source,
    unit
) {
    {
        row: Row.type,
        value: Time.type,
        nullable: True,
        node: Node::UtcBucket({input: source.node, unit})
    }
};
type Filter = enum {
    Eq,
    Ne,
    Gt,
    Ge,
    Lt,
    Le,
    Contains,
    NotContains,
    StartsWith,
    EndsWith,
    InSubnet,
    NotInSubnet
};
def ipv4_filters: Array(Filter) = [Filter::Eq, Filter::Ne, Filter::InSubnet, Filter::NotInSubnet];
def equality_filters: Array(Filter) = [Filter::Eq, Filter::Ne];
def text_search_filters: Array(Filter) = [
    Filter::Eq,
    Filter::Ne,
    Filter::Contains,
    Filter::NotContains,
    Filter::StartsWith,
    Filter::EndsWith
];
def numeric_filters: Array(Filter) = [
    Filter::Eq,
    Filter::Ne,
    Filter::Gt,
    Filter::Ge,
    Filter::Lt,
    Filter::Le
];
def time_filters: Array(Filter) = numeric_filters;
def representation: Fn(Type) -> Type = fn(value) {
    if td::kind(value) == td::TypeDescKind::Ref {
        match td::resolve(value) {
            Ok(resolved) => representation(resolved),
            Err(error) => fail!(error.message, value)
        }
    } else if td::kind(value) == td::TypeDescKind::Newtype {
        representation(td::children(value)[0])
    } else {
        value
    }
};
def validate_filters: Fn(Type, Array(Filter)) -> () = fn(value, filters) {
    let storage = representation(value);
    let temporal = scalars::time_role(value) != None;
    if temporal && !array::all(
        filters,
        fn(op) {
            array::any(
                numeric_filters,
                fn(allowed) {
                    op == allowed
                }
            )
        }
    ) {
        fail!("time dimensions only support comparisons", value)
    } else {
        ()
    };
    if value == scalars::Ipv4.type && !array::all(
        filters,
        fn(op) {
            array::any(
                ipv4_filters,
                fn(allowed) {
                    op == allowed
                }
            )
        }
    ) {
        fail!("IPv4 dimensions only support address operations", value)
    } else {
        ()
    };
    array::map(
        filters,
        fn(op) {
            if array::length(
                array::filter(
                    filters,
                    fn(other) {
                        other == op
                    }
                )
            ) != 1 {
                fail!("dimension policy repeats a filter", op)
            } else {
                match op {
                    Filter::InSubnet => if value != scalars::Ipv4.type {
                        fail!("subnet filters require IPv4 values", value)
                    } else {
                        ()
                    },
                    Filter::NotInSubnet => if value != scalars::Ipv4.type {
                        fail!("subnet filters require IPv4 values", value)
                    } else {
                        ()
                    },
                    Filter::Eq => (),
                    Filter::Ne => (),
                    Filter::Gt => if !temporal && storage != Int.type && storage != Float.type {
                        fail!("ordered filters require a numeric representation", value, op)
                    } else {
                        ()
                    },
                    Filter::Ge => if !temporal && storage != Int.type && storage != Float.type {
                        fail!("ordered filters require a numeric representation", value, op)
                    } else {
                        ()
                    },
                    Filter::Lt => if !temporal && storage != Int.type && storage != Float.type {
                        fail!("ordered filters require a numeric representation", value, op)
                    } else {
                        ()
                    },
                    Filter::Le => if !temporal && storage != Int.type && storage != Float.type {
                        fail!("ordered filters require a numeric representation", value, op)
                    } else {
                        ()
                    },
                    Filter::Contains => if storage != String.type {
                        fail!("text filters require a text representation", value, op)
                    } else {
                        ()
                    },
                    Filter::NotContains => if storage != String.type {
                        fail!("text filters require a text representation", value, op)
                    } else {
                        ()
                    },
                    Filter::StartsWith => if storage != String.type {
                        fail!("text filters require a text representation", value, op)
                    } else {
                        ()
                    },
                    Filter::EndsWith => if storage != String.type {
                        fail!("text filters require a text representation", value, op)
                    } else {
                        ()
                    },
                }
            }
        }
    );
    ()
};
type DimensionPolicy = struct {
    projectable: Bool,
    filters: Array(Filter)
};
type MemberKind = enum {
    Dimension(DimensionPolicy),
    Transfer(TransferMember),
    Numeric(Statistic)
};
type DimensionGroupFacts = struct {
    id: String,
    value: Type,
    projectable: Bool,
    filters: Array(Filter)
};
type BindingContract = enum {
    Dimension,
    DeferredDimension(DimensionGroupFacts),
    Transfer(MeasureGroup),
    Identity(model::PreparedRole),
    Numeric(NumericGroupFacts)
};
type DimensionGroup(Value) = struct {
    id: String,
    value: Type,
    projectable: Bool,
    filters: Array(Filter)
};
def dimension_group: for(Value) Fn(
    String,
    TypeOf(Value),
    Bool,
    Array(Filter)
) -> DimensionGroup(Value) = fn(id, value, projectable, filters) {
    {id, value, projectable, filters}
};
type Member = struct {
    group: String,
    local: String,
    id: String,
    node: Node,
    value: Type,
    nullable: Bool,
    aggregate: Option(qb::AggregateFunction),
    projectable: Bool,
    filters: Array(Filter),
    kind: MemberKind,
};
type Binding(Row) = struct {
    row: Type,
    dataset: String,
    source: String,
    contract: BindingContract,
    members: Array(Member)
};
type BindingFacts = struct {
    row: Type,
    dataset: String,
    source: String,
    contract: BindingContract,
    members: Array(Member)
};
def binding_facts: for(Row) Fn(Binding(Row)) -> BindingFacts = fn(binding) {
    {
        row: binding.row,
        dataset: binding.dataset,
        source: binding.source,
        contract: binding.contract,
        members: binding.members
    }
};
def binding_roles: Fn(BindingFacts) -> Array(model::PreparedRole) = fn(binding) {
    match binding.contract {
        BindingContract::Identity(role) => [role],
        _ => []
    }
};
def dimension: for(Row, Value) Fn(
    model::Dataset(Row),
    DimensionGroup(Value),
    Expr(Row, Value),
    String,
    Bool,
    Array(Filter)
) -> Binding(Row) = fn(dataset, group, source, publish, projectable, filters) {
    {
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        contract: BindingContract::DeferredDimension(
            {
                id: group.id,
                value: group.value,
                projectable: group.projectable,
                filters: group.filters
            }
        ),
        members: [
            {
                group: group.id,
                local: "value",
                id: publish,
                node: source.node,
                value: source.value,
                nullable: source.nullable,
                aggregate: None,
                projectable,
                filters,
                kind: MemberKind::Dimension(
                    {projectable: group.projectable, filters: group.filters}
                )
            }
        ]
    }
};

# 先实验有明确输入签名的流量模板；绑定没有修改聚合算子的入口。
type TransferMember = enum {
    AmountTotal,
    RatePeak,
    RateMean
};
type MeasureGroup = struct {
    id: String,
    members: Array(TransferMember)
};
def transfer: MeasureGroup = {
    id: "transfer",
    members: [TransferMember::AmountTotal, TransferMember::RatePeak, TransferMember::RateMean]
};
type Rename = struct {
    member: TransferMember,
    publish: String
};
type Recipe = struct {
    local: String,
    node: Node,
    value: Type,
    function: qb::AggregateFunction
};
def transfer_binding: for(Row) Fn(
    model::Dataset(Row),
    MeasureGroup,
    Expr(Row, quantity::Bytes),
    Expr(Row, quantity::Seconds),
    Array(Rename)
) -> Binding(Row) = fn(dataset, group, amount, elapsed, names) {
    let speed = rate(amount, elapsed);
    {
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        contract: BindingContract::Transfer(group),
        members: array::map(
            names,
            fn(name) {
                let recipe: Recipe = match name.member {
                    TransferMember::AmountTotal => {
                        local: "amount_total",
                        node: amount.node,
                        value: amount.value,
                        function: qb::AggregateFunction::Sum
                    },
                    TransferMember::RatePeak => {
                        local: "rate_peak",
                        node: speed.node,
                        value: speed.value,
                        function: qb::AggregateFunction::Max
                    },
                    TransferMember::RateMean => {
                        local: "rate_mean",
                        node: speed.node,
                        value: speed.value,
                        function: qb::AggregateFunction::Avg
                    },
                };
                {
                    group: group.id,
                    local: recipe.local,
                    id: name.publish,
                    node: recipe.node,
                    value: recipe.value,
                    nullable: True,
                    aggregate: Some(recipe.function),
                    projectable: True,
                    filters: [],
                    kind: MemberKind::Transfer(name.member)
                }.ty!(Member)
            }
        )
    }
};

# 普通数值统计不声明采样角色，也不要求 Metric 或时钟。
type Statistic = enum {
    Mean,
    Min,
    Max,
    Sum
};
type NumericGroup(Value) = struct {
    id: String,
    value: Type,
    members: Array(Statistic)
};
type NumericGroupFacts = struct {
    id: String,
    value: Type,
    members: Array(Statistic)
};
type StatisticName = struct {
    member: Statistic,
    publish: String
};
def statistic_function: Fn(Statistic) -> qb::AggregateFunction = fn(member) {
    match member {
        Statistic::Mean => qb::AggregateFunction::Avg,
        Statistic::Min => qb::AggregateFunction::Min,
        Statistic::Max => qb::AggregateFunction::Max,
        Statistic::Sum => qb::AggregateFunction::Sum
    }
};
def statistic_name: Fn(Statistic) -> String = fn(member) {
    match member {
        Statistic::Mean => "mean",
        Statistic::Min => "min",
        Statistic::Max => "max",
        Statistic::Sum => "sum"
    }
};
def validate_numeric: Fn(String, Type, Array(Statistic)) -> () = fn(id, value, members) {
    let storage = representation(value);
    if id == "" || array::length(members) == 0 || (storage != Int.type && storage != Float.type) || scalars::time_role(
        value
    ) != None {
        fail!("numeric group requires a name, numeric value type and statistics", id)
    } else if array::any(
        members,
        fn(member) {
            array::length(
                array::filter(
                    members,
                    fn(other) {
                        other == member
                    }
                )
            ) != 1
        }
    ) {
        fail!("numeric group statistics must be distinct", id)
    } else if array::any(
        members,
        fn(member) {
            member == Statistic::Sum
        }
    ) && value != quantity::Count.type && value != quantity::Bytes.type {
        fail!("numeric Sum requires an explicitly additive quantity type", id)
    } else {
        ()
    }
};
def numeric_group: for(Value) Fn(String, TypeOf(Value), Array(Statistic)) -> NumericGroup(Value) = fn(
    id,
    value,
    members
) {
    {id, value, members}
};
def numeric_binding: for(Row, Value) Fn(
    model::Dataset(Row),
    NumericGroup(Value),
    Expr(Row, Value),
    Array(StatisticName)
) -> Binding(Row) = fn(dataset, group, source, names) {
    {
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        contract: BindingContract::Numeric(
            {id: group.id, value: group.value, members: group.members}
        ),
        members: array::map(
            names,
            fn(name) {
                let local = match name.member {
                    Statistic::Mean => "mean",
                    Statistic::Min => "min",
                    Statistic::Max => "max",
                    Statistic::Sum => "sum"
                };
                let function = match name.member {
                    Statistic::Mean => qb::AggregateFunction::Avg,
                    Statistic::Min => qb::AggregateFunction::Min,
                    Statistic::Max => qb::AggregateFunction::Max,
                    Statistic::Sum => qb::AggregateFunction::Sum
                };
                {
                    group: group.id,
                    local,
                    id: name.publish,
                    node: source.node,
                    value: source.value,
                    nullable: True,
                    aggregate: Some(function),
                    projectable: True,
                    filters: [],
                    kind: MemberKind::Numeric(name.member)
                }.ty!(Member)
            }
        )
    }
};

type IdentityName = struct {
    member: String,
    publish: String
};
def identity_dimensions: for(Row) Fn(
    model::Dataset(Row),
    model::Role(Row),
    Array(IdentityName)
) -> Binding(Row) = fn(dataset, role, names) {
    let parts = array::map(
        role.parts,
        fn(part) {
            {name: part.source, value: part.value, nullable: part.nullable}.ty!(Column)
        }
    );
    {
        row: Row.type,
        dataset: dataset.id,
        source: dataset.source,
        contract: BindingContract::Identity(model::prepare(dataset, [role]).roles[0]),
        members: array::map(
            names,
            fn(name) {
                let part = match array::find(
                    role.parts,
                    fn(part) {
                        part.target == name.member
                    }
                ) {
                    Some(part) => part,
                    None => fail!("identity dimension target is missing", name.member)
                };
                {
                    group: `identity_\{role.entity}`,
                    local: part.target,
                    id: name.publish,
                    node: Node::Identity(
                        {
                            column: {name: part.source, value: part.value, nullable: part.nullable},
                            parts
                        }
                    ),
                    value: part.value,
                    nullable: array::any(
                        parts,
                        fn(part) {
                            part.nullable
                        }
                    ),
                    aggregate: None,
                    projectable: True,
                    filters: [Filter::Eq],
                    kind: MemberKind::Dimension({projectable: True, filters: [Filter::Eq]})
                }.ty!(Member)
            }
        )
    }
};

def validate_member_contract: Fn(Member) -> () = fn(member) {
    match member.kind {
        MemberKind::Dimension(policy) => {
            validate_filters(member.value, policy.filters);
            validate_filters(member.value, member.filters);
            if member.aggregate != None || (member.projectable && !policy.projectable) || !array::all(
                member.filters,
                fn(op) {
                    array::any(
                        policy.filters,
                        fn(allowed) {
                            allowed == op
                        }
                    )
                }
            ) {
                fail!("dimension binding cannot expand group capabilities", member.id)
            } else {
                ()
            }
        },
        MemberKind::Numeric(recipe) => {
            validate_numeric(member.group, member.value, [recipe]);
            if member.local != statistic_name(recipe) || member.aggregate != Some(
                statistic_function(recipe)
            ) {
                fail!("numeric binding cannot override its group recipe", member.id)
            } else {
                ()
            }
        },
        MemberKind::Transfer(recipe) => {
            let valid = match recipe {
                TransferMember::AmountTotal => member.local == "amount_total" && member.aggregate == Some(
                    qb::AggregateFunction::Sum
                ) && member.value == quantity::Bytes.type,
                TransferMember::RatePeak => member.local == "rate_peak" && member.aggregate == Some(
                    qb::AggregateFunction::Max
                ) && member.value == quantity::BytesPerSecond.type,
                TransferMember::RateMean => member.local == "rate_mean" && member.aggregate == Some(
                    qb::AggregateFunction::Avg
                ) && member.value == quantity::BytesPerSecond.type,
            };
            let rate_node = match member.node {
                Node::Rate(_) => True,
                _ => False
            };
            if !valid || (recipe != TransferMember::AmountTotal && !rate_node) {
                fail!("measure binding cannot override its group recipe", member.id)
            } else {
                ()
            }
        },
    }
};

# 声明公开且可手写；组合与编译边界重新检查所有节点和发布名称。
def validate_binding_contract: Fn(model::PreparedDataset, BindingFacts) -> () = fn(dataset, binding) {
    match binding.contract {
        BindingContract::Dimension => {
            if array::length(binding.members) != 1 || binding.members[0].local != "value" {
                fail!("dimension binding must publish its declared member", binding.dataset)
            } else {
                ()
            }
        },
        BindingContract::DeferredDimension(group) => {
            if group.id == "" || array::length(binding.members) != 1 {
                fail!("dimension binding must publish its declared member", binding.dataset)
            } else {
                let member = binding.members[0];
                if member.group != group.id || member.local != "value" || member.value != group.value || member.kind != MemberKind::Dimension(
                    {projectable: group.projectable, filters: group.filters}
                ) {
                    fail!("dimension group witness does not match its binding", member.id)
                } else {
                    ()
                }
            }
        },
        BindingContract::Numeric(group) => {
            validate_numeric(group.id, group.value, group.members);
            if array::length(binding.members) != array::length(group.members) || !array::all(
                binding.members,
                fn(member) {
                    member.node == binding.members[0].node
                }
            ) || !array::all(
                group.members,
                fn(recipe) {
                    array::length(
                        array::filter(
                            binding.members,
                            fn(member) {
                                member.group == group.id && member.value == group.value && member.kind == MemberKind::Numeric(
                                    recipe
                                )
                            }
                        )
                    ) == 1
                }
            ) {
                fail!("numeric binding must preserve its complete group", group.id)
            } else {
                ()
            }
        },
        BindingContract::Transfer(group) => {
            if group.id == "" || array::length(group.members) == 0 || array::length(binding.members) != array::length(
                group.members
            ) || !array::all(
                group.members,
                fn(recipe) {
                    array::length(
                        array::filter(
                            group.members,
                            fn(other) {
                                other == recipe
                            }
                        )
                    ) == 1 && array::length(
                        array::filter(
                            binding.members,
                            fn(member) {
                                member.group == group.id && member.kind == MemberKind::Transfer(
                                    recipe
                                )
                            }
                        )
                    ) == 1
                }
            ) {
                fail!("measure binding must preserve its complete group", group.id)
            } else {
                ()
            }
        },
        BindingContract::Identity(role) => {
            model::validate_prepared(dataset <~ {roles: [role]});
            let parts = array::map(
                role.parts,
                fn(part) {
                    {name: part.source, value: part.value, nullable: part.nullable}.ty!(Column)
                }
            );
            if array::length(binding.members) != array::length(parts) || !array::all(
                role.parts,
                fn(part) {
                    array::length(
                        array::filter(
                            binding.members,
                            fn(member) {
                                member.local == part.target && member.group == `identity_\{role.entity}` && member.node == Node::Identity(
                                    {
                                        column: {
                                            name: part.source,
                                            value: part.value,
                                            nullable: part.nullable
                                        },
                                        parts
                                    }
                                ) && member.aggregate == None
                            }
                        )
                    ) == 1
                }
            ) {
                fail!("identity dimensions must preserve the complete role", role.id)
            } else {
                ()
            }
        },
    }
};
def validate_facts: Fn(model::PreparedDataset, Array(BindingFacts)) -> Array(Member) = fn(
    dataset,
    bindings
) {
    model::validate_prepared(dataset);
    let members = array::flat_map(
        bindings,
        fn(binding) {
            if binding.row != dataset.row || binding.dataset != dataset.id || binding.source != dataset.source {
                fail!("group binding belongs to a different dataset", binding.dataset)
            } else {
                validate_binding_contract(dataset, binding);
                binding.members
            }
        }
    );
    array::map(
        members,
        fn(member) {
            validate_member_contract(member);
            let actual = shape(dataset.row, member.node);
            if member.group == "" || member.local == "" {
                fail!("group and local member ids must be nonempty", member.id)
            } else if !qb::is_sql_identifier(member.id) || array::length(
                array::filter(
                    members,
                    fn(other) {
                        other.id == member.id
                    }
                )
            ) != 1 {
                fail!("group publish ids must be valid and unique", member.id)
            } else if member.value != actual.value || (
                member.aggregate == None && member.nullable != actual.nullable
            ) || (member.aggregate != None && !member.nullable) {
                fail!("group member result type does not match its expression", member.id)
            } else if member.aggregate != None && member.filters != [] {
                fail!("measure filters require an aggregate predicate contract", member.id)
            } else {
                member
            }
        }
    )
};
def prepare: for(Row) Fn(model::Dataset(Row), Array(Binding(Row))) -> Array(Member) = fn(
    dataset,
    bindings
) {
    array::flat_map(
        bindings,
        fn(binding) {
            binding.members
        }
    )
};

def node_value: Fn(Node) -> Type = fn(node) {
    match node {
        Node::Column(column) => column.value,
        Node::Seconds(_) => quantity::Seconds.type,
        Node::Rate(_) => quantity::BytesPerSecond.type,
        Node::Ipv4(_) => scalars::Ipv4.type,
        Node::Identity(input) => input.column.value,
        Node::UtcBucket(bucket) => node_value(bucket.input),
    }
};
def lower: Fn(qb::BuildCtx, qb::Source, Node) -> (qb::BuildCtx, qb::Expr) = fn(ctx, source, node) {
    match node {
        Node::Column(column) => (ctx, qb::column(source, column.name)),
        Node::Ipv4(input) => {
            let lowered = lower(ctx, source, input);
            edsl::canonical_ipv4_view(lowered.0, lowered.1)
        },
        Node::UtcBucket(bucket) => {
            let lowered = lower(ctx, source, bucket.input);
            # 节点在准备时已按 Row 校验；lower 从封闭子节点取回名义类型。
            let encoding = bucket_encoding(node_value(bucket.input), bucket.unit);
            (
                lowered.0,
                qb::scalar(
                    qb::ScalarFunction::UtcTimeBucket({unit: bucket.unit, encoding}),
                    [lowered.1]
                )
            )
        },
        Node::Seconds(input) => {
            let lowered = lower(ctx, source, input);
            let divisor = qb::bind(lowered.0, qb::Val::Float(1000.0));
            (divisor.0, qb::scalar(qb::ScalarFunction::Div, [lowered.1, divisor.1]))
        },
        Node::Rate(inputs) => {
            let amount = lower(ctx, source, inputs.amount);
            let duration = lower(amount.0, source, inputs.duration);
            let zero = qb::bind(duration.0, qb::Val::Float(0.0));
            let one = qb::bind(zero.0, qb::Val::Float(1.0));
            let missing = qb::bind(one.0, qb::Val::None);
            let real_amount = qb::scalar(qb::ScalarFunction::Div, [amount.1, one.1]);
            let positive = qb::scalar(qb::ScalarFunction::Gt, [duration.1, zero.1]);
            (
                missing.0,
                qb::scalar_if(
                    positive,
                    qb::scalar(qb::ScalarFunction::Div, [real_amount, duration.1]),
                    missing.1
                )
            )
        },
        Node::Identity(input) => {
            let present = array::map(
                input.parts,
                fn(part) {
                    qb::scalar(qb::ScalarFunction::IsNotNull, [qb::column(source, part.name)])
                }
            );
            let condition = array::fold(
                present,
                present[0],
                fn(all, part) {
                    qb::scalar(qb::ScalarFunction::And, [all, part])
                }
            );
            let missing = qb::bind(ctx, qb::Val::None);
            (missing.0, qb::scalar_if(condition, qb::column(source, input.column.name), missing.1))
        },
    }
};

# 本阶段只有单 Dataset 聚合；没有隐式连接，也不自动投影未授权维度。
type LoweredGroup = struct {
    ctx: qb::BuildCtx,
    projection: Array(qb::SelectItem),
    grouping: Array(qb::Expr)
};
def query: for(Row) Fn(model::Dataset(Row), Array(Binding(Row))) -> qb::QueryAst = fn(
    dataset,
    bindings
) {
    let members = prepare(dataset, bindings);
    let visible = array::filter(
        members,
        fn(member) {
            member.projectable
        }
    );
    if array::length(visible) == 0 {
        fail!("group query requires a projected member", dataset.id)
    } else {
        let source = qb::source_with_hint(qb::build_context(), dataset.source, "sample");
        let lowered = array::fold(
            visible,
            {ctx: source.0, projection: [], grouping: []}.ty!(LoweredGroup),
            fn(state, member) {
                let expr = lower(state.ctx, source.1, member.node);
                let item = match member.aggregate {
                    None => qb::named_expr_item(expr.1, member.id),
                    Some(function) => qb::aggregate(function, expr.1, False, member.id),
                };
                {
                    ctx: expr.0,
                    projection: array::push(state.projection, item),
                    grouping: if member.aggregate == None {
                        array::push(state.grouping, expr.1)
                    } else {
                        state.grouping
                    }
                }
            }
        );
        let plan: qb::Plan = {
            revision: "typed-groups",
            sources: [source.1],
            derived: None,
            projection: lowered.projection,
            internal_measures: [],
            filter: None,
            exists: [],
            joins: [],
            grouping: if array::any(
                visible,
                fn(member) {
                    member.aggregate != None
                }
            ) {
                lowered.grouping
            } else {
                []
            },
            having: [],
            ordering: [],
            limit: None,
            offset: None,
            partition: None,
            scalar_comparisons: [],
            ranked_key_comparisons: []
        };
        qb::finish(lowered.ctx, qb::validate_query_plan(qb::QueryPlan::Rows(plan)))
    }
};

