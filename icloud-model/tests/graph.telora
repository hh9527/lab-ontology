        "filters":[{"node":"alarm","dimension":"alarm_severity","op":"ne","kind":"text","value":"critical"}]}"#).unwrap!());
    if string::contains(query.sql, "alarm.SEVERITY != ?")
        && string::contains(query.sql, "alarm.SEVERITY = ?")
        && array::any(query.bindings, fn(value) { value == qb::Val::String("3") })
        && array::any(query.bindings, fn(value) { value == qb::Val::String("4") }) { True }
    else { fail!("noncritical alarm filter lost the complete declared severity domain", query) }
});

