# ontology/src/query.telora
#
# QueryBuilder: a domain-neutral Plan vocabulary and immutable construction
# context. This package knows nothing about ontologies, enterprises,
# metrics, dimensions or question phrasing. External dependents import the
# public module as `ontology/query`; package-internal code uses `@src/query`.

use std::array as array;
use std::string as string;
use std::regex as regex;
use std::value::{ ScalarValue as Val };

# ---------------------------------------------------------------------------
# Public value type: dynamic values flowing into bindings.
#
# `Val` re-exports the standard closed `ScalarValue` enum. Its JSON codec
# representation lets runtime values cross the
# JSON boundary as native scalar JSON: Val.Int(3) <-> 3, Val.Float(3.5) <-> 3.5,
# Val.String("abc") <-> "abc", Val.Bool(true) <-> true, Val.None <-> null. Query.bindings therefore
# encodes as a native JSON scalar array (e.g. [3, "abc"]) with no variant
# wrapper such as {"Int": 3} or {"String": "abc"}.  This property only
# affects the codec boundary; inside Telora `Val` variants are unchanged and
# SQL placeholder/binding-order/lowering semantics are unaffected.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dialect-independent materialization result: SQL text and scalar bindings.
# ---------------------------------------------------------------------------

type Query = struct {
    sql: String,
    bindings: Array(Val),
};

# ---------------------------------------------------------------------------
# Expressions.
# ---------------------------------------------------------------------------

type ColumnRef = struct {
    source: String,
    column: String,
};

# ScalarFunction is the closed scalar vocabulary.  `Substr` is the required
# SQLite scalar (`substr(value, start[, length])`); `Instr` finds the first
# occurrence of a needle (`instr(haystack, needle)`, 1-based, 0 when absent);
# `If` is the conditional (`CASE WHEN cond THEN t ELSE e END`); `Add`/`Sub`
# are the necessary integer arithmetic primitives; `Lower` is the case
# normalizer (`lower(value)`), which in the default SQLite build folds ASCII
# A-Z only, so `lower(a) = lower(b)` is the closed way to do case-insensitive
# comparison; `Length` (`length(value)`) is the character count of a text
# value.
# The remaining variants are operator-style scalar predicates/logic rendered
# with SQLite operator syntax.  The AST is closed: no raw SQL fragment, no
# arbitrary function name/operator and no identifier can escape through this
# vocabulary.  Semantics never change with the profile or the caller.
type ScalarFunction = enum {
    Substr,
    Instr,
    If,
    Add,
    Sub,
    Lower,
    Length,
    UtcDaysAgo,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    And,
    Or,
    Not,
};

# Arity belongs to the call itself; source visibility and
# profile capabilities remain contextual Plan checks.
@check(fn(call) {
    if scalar_call_valid(call.function, call.args) {
        Ok(())
    } else {
        Err(blame!("invalid scalar call arity", call.args))
    }
})
type ScalarCall = struct {
    function: ScalarFunction,
    args: Array(Expr),
};

type Expr = enum {
    Column(ColumnRef),
    AllocatedBind(AllocatedBinding),
    Scalar(ScalarCall),
};

type AllocatedBinding = struct { index: Int };

type AggregateFunction = enum {
    Count,
    Sum,
    Avg,
    Min,
    Max,
};

# `filter` is the aggregate-local row predicate (SQLite
# `FILTER (WHERE ...)`).  It only narrows this aggregate's input rows and is
# never merged into the global WHERE.  The predicate reuses the closed Expr,
# profile, arity, identifier and binding boundaries.
type AggregateCall = struct {
    function: AggregateFunction,
    arg: Expr,
    distinct: Bool,
    filter: Option(Expr),
    alias: String,
};

# A restricted arithmetic combination of declared aggregates. Operands resolve
# to projected measures or validated internal dependencies; only projected
# items become result columns. Dependencies must be acyclic.
type ComputedOp = enum {
    Add,
    Sub,
};

type ComputedAggregate = struct {
    op: ComputedOp,
    left: String,
    right: String,
    alias: String,
};

type SelectItem = enum {
    Expr(Expr),
    NamedExpr(NamedExprItem),
    Aggregate(AggregateCall),
    Computed(ComputedAggregate),
};

type NamedExprItem = struct { expr: Expr, alias: String };

# Comparison operators for aggregate-result (HAVING) predicates.
type HavingOp = enum {
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
};

# The measure of an aggregate-result predicate.
#   HavingMeasure.Ref(AggregateRef)   names a projected aggregate/computed aggregate alias
#                        (the top-level HAVING case);
#   HavingMeasure.Call(AggregateCall) is a direct aggregate expression such as
#                        count(child.id) used inside a nested aggregate body
#                        (grouped EXISTS or the inner relation of count_groups).
type HavingMeasure = enum {
    Ref(AggregateRef),
    Call(AggregateCall),
};

# One aggregate-result predicate: `<measure> <op> <threshold>`.
# `threshold` is a dynamic scalar that always enters SQL as a `?` binding.
type Having = struct {
    op: HavingOp,
    measure: HavingMeasure,
    threshold: Expr,
};

# ---------------------------------------------------------------------------
# Relations and plan structure.
# ---------------------------------------------------------------------------

type Source = struct {
    alias: String,
    table: String,
    scope: Option(Expr),
};

# Construction-time identifiers are stable across all dialect renderers.
type BuildCtx = struct { source_aliases: Array(String), projection_aliases: Array(String), bindings: Array(Val), next_binding: Int };

def build_context: Fn() -> BuildCtx = fn() { {source_aliases: [], projection_aliases: [], bindings: [], next_binding: 1} };

pub def independent_query_scope: Fn(BuildCtx) -> BuildCtx = fn(ctx) {
    {...ctx, source_aliases: [], projection_aliases: []}
};

def bind: Fn(BuildCtx, Val) -> (BuildCtx, Expr) = fn(ctx, value) {
    ({...ctx, bindings: array::push(ctx.bindings, value), next_binding: ctx.next_binding + 1},
        Expr::AllocatedBind({index: ctx.next_binding}))
};

def page_bound: Fn(BuildCtx, Int) -> (BuildCtx, Expr) = fn(ctx, value) {
    if value < 0 { fail!("pagination value must be non-negative", value) }
    else { bind(ctx, Val::Int(value)) }
};

def take_bound: Fn(BuildCtx, Int) -> (BuildCtx, Expr) = fn(ctx, value) {
    if value <= 0 || value > max_partition_take {
        fail!("partition take must be a positive integer within the cap", value)
    } else { bind(ctx, Val::Int(value)) }
};

def available_source_alias: Fn(Array(String), String, Int) -> String = fn(used, hint, index) {
    let candidate = if index == 1 { hint } else { `\{hint}_\{index}` };
    if array::any(used, fn(alias) { alias == candidate }) {
        available_source_alias(used, hint, index + 1)
    } else { candidate }
};

def source_with_hint: Fn(BuildCtx, String, String) -> (BuildCtx, Source) = fn(ctx, table, hint) {
    if !is_sql_identifier(table) || !is_sql_identifier(hint) {
        fail!("invalid source table or alias hint", (table, hint))
    } else {
        let alias = available_source_alias(ctx.source_aliases, hint, 1);
        let next: BuildCtx = {...ctx, source_aliases: array::push(ctx.source_aliases, alias)};
        (next, {alias, table, scope: None})
    }
};

pub def reserve_source_aliases: Fn(BuildCtx, Array(String)) -> BuildCtx = fn(ctx, aliases) {
    array::fold(aliases, ctx, fn(state, alias) {
        if !is_sql_identifier(alias) { fail!("invalid source alias", alias) }
        else if array::any(state.source_aliases, fn(used) { used == alias }) { state }
        else { {...state, source_aliases: array::push(state.source_aliases, alias)} }
    })
};

def source_column_ref: Fn(Source, String) -> ColumnRef = fn(source_item, column_name) {
    if is_sql_identifier(column_name) {
        {source: source_item.alias, column: column_name}
    } else { fail!("invalid column symbol", column_name) }
};

def source_column: Fn(Source, String) -> Expr = fn(source_item, column_name) {
    Expr::Column(source_column_ref(source_item, column_name))
};

def column: Fn(Source, String) -> Expr = source_column;
def column_ref: Fn(Source, String) -> ColumnRef = source_column_ref;
def expr_ref: Fn(ColumnRef) -> Expr = fn(ref) { Expr::Column(ref) };

def project_column: Fn(BuildCtx, Source, String, String) -> (BuildCtx, SelectItem) = fn(ctx, source_item, column_name, hint) {
    if !is_sql_identifier(hint) { fail!("invalid projected column alias hint", hint) }
    else {
        let alias = available_source_alias(ctx.projection_aliases, hint, 1);
        let next: BuildCtx = {...ctx, projection_aliases: array::push(ctx.projection_aliases, alias)};
        (next, SelectItem::NamedExpr({expr: source_column(source_item, column_name), alias}))
    }
};

type JoinKind = enum {
    Inner,
    Left,
};

# A single equality between two source-qualified columns.  It is the atom of
# `JoinCondition` and of a correlated `Exists` predicate; the two sides are
# distinguished by role/alias, never by position in any business model.
type ColumnEq = struct {
    left: ColumnRef,
    right: ColumnRef,
};

# Closed ON-clause predicate tree for `Join.condition`: equality atoms combined
# by `ScalarFunction.And`/`ScalarFunction.Or` over non-empty arrays.  This expresses role aliases of the
# same physical table (each alias is an ordinary `Source`) and composite
# conditions such as `a.col = b.col AND (a.x = c.x OR a.y = c.y)`.  No raw SQL
# fragment, no open function name and no identifier escape.
type JoinCondition = enum {
    Eq(ColumnEq),
    Predicate(Expr),
    Exists(Exists),
    And(Array(JoinCondition)),
    Or(Array(JoinCondition)),
};

type Join = struct {
    kind: JoinKind,
    source: Source,
    condition: JoinCondition,
};

# Correlated peer existence body: one ordered endpoint-exchange branch of a
# two-participant pairing.  Both equalities follow the correlated-EXISTS
# convention (`left` = outer hub role column, `right` = inner participant key
# column): `origin` connects the hub endpoint column that must hold the origin
# participant's key to that participant's inner key column, `peer` the same for
# the peer participant.
type PeerBranch = struct {
    origin: ColumnEq,
    peer: ColumnEq,
};

# Correlated paired-endpoint (peer) existence.  The predicate keeps a hub base
# row when its two mutually exclusive endpoints are occupied by the ORIGIN and
# PEER participants (each identified by its own inner source table/alias, not by
# a bare value), in either endpoint order:
#
#   EXISTS (SELECT 1 FROM <origin.table> AS <origin.alias>,
#                       <peer.table>   AS <peer.alias>
#           WHERE (branch_a.origin AND branch_a.peer)
#              OR (branch_b.origin AND branch_b.peer)
#           [AND origin_filter][AND peer_filter])
#
# The two exchange branches are closed and ordered.  Every equality connects a
# validated outer hub role column to the key column of the corresponding inner
# participant alias, so a hub endpoint value is only ever interpreted through
# the participant table the request declared (identity is proven inside the SQL,
# not by a type label).  Origin/peer filters and key binds belong to their own
# inner aliases.  The predicate never joins/fans out the hub base grain.
#
# `distinct_keys` is the closed structural identity proof used when the two
# participants belong to the SAME entity/table: the two inner key columns are
# required to be unequal (`origin.key <> peer.key`) so a single participant row
# can never occupy both endpoints of the same hub row (self-loop).  For
# participants of DIFFERENT entities/tables it stays False: the same key value
# in two different tables is still two different identities, so no bare-key
# inequality is added.
type PeerCorr = struct {
    origin: Source,
    peer: Source,
    branch_a: PeerBranch,
    branch_b: PeerBranch,
    origin_filter: Option(Expr),
    peer_filter: Option(Expr),
    distinct_keys: Bool,
    exchange: Bool,
};

# Correlated existence (semi-join) filter.  Rendered as
#   EXISTS (SELECT 1 FROM <table> AS <alias>
#           WHERE <left.col = alias.col> [AND ...] [AND <filter>]
#           [GROUP BY <grouping>] [HAVING <having>])
# `pairs` entries are ANDed equalities whose `left` is an outer main column and
# whose `right` is a column of `source.alias`.  When the inner correlation is a
# closed disjunction of ANDed equalities (e.g. a dual-endpoint hub union
# `outer.l = alias.key OR outer.r = alias.key`), `alternatives` carries that
# ordered list: each alternative is a non-empty conjunction of ColumnEq and each
# equality strictly connects an outer main column (`left`) to an inner source
# column (`right`).  `pairs` is empty in that mode.  `filter` is an optional
# extra predicate over the inner source (and, when desired, outer main columns).
# `grouping`/`having` make this a *correlated aggregate* EXISTS: rows of the
# inner source that match the correlation are grouped and only groups whose
# aggregate-result predicate holds make the EXISTS true (e.g. "subjects with at
# least N matching events").  `peer` is the closed paired-endpoint mode (see
# `PeerCorr`): when present, `pairs`/`alternatives`/`filter`/`grouping`/`having`
# are empty and the body is the two-participant exchange predicate.  The
# subquery is only a predicate: it never fans out the main FROM, so outer
# COUNT/SUM keep the base grain.  `negated` marks the closed anti-existence
# form `NOT EXISTS (...)` (subjects with no matching related row); the body is
# otherwise identical and NULL semantics stay SQL-native.  `link` marks the
# bounded correlated two-hop body (see `ExistsLink`): the whole A -> B -> C
# condition stays inside ONE correlated EXISTS, so a fan-out first hop never
# amplifies the outer A grain.
# `path` is an ordered sequence of inner JOINs for a correlated relation path.
# Its aliases and equality conditions are validated in construction order; it
# is exclusive with the specialized `link` and `peer` bodies.
type Exists = struct {
    source: Source,
    pairs: Array(ColumnEq),
    alternatives: Option(Array(Array(ColumnEq))),
    filter: Option(Expr),
    grouping: Array(Expr),
    having: Array(Having),
    peer: Option(PeerCorr),
    negated: Bool,
    link: Option(ExistsLink),
    path: Array(Join),
};

# Bounded correlated two-hop existence body.  A base row A is kept when it has
# an inner related row B (`Exists.source`, correlated by `Exists.pairs`) which
# in turn has a related row C (`source`), joined inside the same subquery by
# `pairs` (each equality connects a column of `Exists.source.alias` to a column
# of `link.source.alias`).  `filter` optionally constrains C (and, if desired,
# B / outer main columns). An optional tail adds a third inner hop D; middle
# alternatives are confined to the B->C join and the tail only joins C->D.
# Rendered as
#   EXISTS (SELECT 1 FROM <B> AS <ba>
#             INNER JOIN <C> AS <ca> ON <link.pairs>
#           WHERE <Exists.pairs (A -> B)> [AND link.filter])
# The whole body is a predicate only: inner sources never appear in the outer
# projection/grouping/joins, so a fan-out A -> B relation does not fan out A.
type ExistsLink = struct {
    source: Source,
    pairs: Array(ColumnEq),
    alternatives: Option(Array(Array(ColumnEq))),
    tail: Option(ExistsTail),
    filter: Option(Expr),
};

type ExistsTail = struct { source: Source, pairs: Array(ColumnEq) };

# One declared output column of a `UnionBranch`: an explicit stable name and
# the expression (over that branch's own source alias) that produces it.
type UnionColumn = struct {
    name: String,
    expr: Expr,
};

# One branch of a derived UNION ALL relation: a single physical source projected
# to the shared, ordered, named output columns with an optional row filter.
# The branch uses only the closed Expr vocabulary over its own source alias.
type UnionBranch = struct {
    source: Source,
    outputs: Array(UnionColumn),
    filter: Option(Expr),
};

# A restricted, composable derived relation: the ordered `branches` are merged
# with `UNION ALL` and exposed to the outer Plan as a single named source
# `alias`.  Every branch must project the same non-empty column names in the
# same order.  It is a normal FROM source: the outer Plan can project, filter,
# group, aggregate, HAVING, order and partition over the derived columns.  No
# raw SQL, open function name or schema inference.
type DerivedSource = struct {
    alias: String,
    branches: Array(UnionBranch),
};

# Closed set operations between two validated Plan operands: INTERSECT, EXCEPT
# and distinct UNION (duplicate elimination).  Each operand is a complete Plan
# with a non-zero projection and no operand-local ordering/limit/offset/partition
# (shapes that cannot be embedded without changing meaning).  The result keeps
# the operands' shared positional projection shape and may be wrapped by an
# outer `count(1)`.
type SetOpKind = enum {
    Intersect,
    Except,
    Union,
};

type Ordering = enum {
    # The shared AST fixes the SQLite ordering semantics: ascending puts
    # NULL first, descending puts NULL last. A PostgreSQL renderer must emit
    # explicit NULLS FIRST/LAST instead of relying on PG's opposite defaults.
    Asc,
    Desc,
};

# A reference to a projected aggregate, addressed by its output alias.
type AggregateRef = struct {
    alias: String,
};

# Ordering key: a plain expression, a reference to a projected aggregate
# measure, or a direct aggregate expression used only for ordering (an internal
# ordering aggregate that is NOT projected -- e.g. return only the group name
# but order the groups by `count(...) DESC`).  `OrderKey.AggregateRef` is only valid
# when the alias matches an AggregateCall in `Plan.projection`;
# `SelectItem.Aggregate(call)` carries its own AggregateCall and is only valid when the
# Plan is grouped (it orders by an aggregate of each group).
type OrderKey = enum {
    Expr(Expr),
    AggregateRef(AggregateRef),
    Aggregate(AggregateCall),
};

type OrderBy = struct {
    key: OrderKey,
    direction: Ordering,
};

type Plan = struct {
    revision: String,
    sources: Array(Source),
    derived: Option(DerivedSource),
    projection: Array(SelectItem),
    # Closed dependencies of projected computed measures, never result columns.
    internal_measures: Array(SelectItem),
    filter: Option(Expr),
    exists: Array(Exists),
    joins: Array(Join),
    grouping: Array(Expr),
    having: Array(Having),
    ordering: Array(OrderBy),
    limit: Option(Expr),
    offset: Option(Expr),
    partition: Option(PartitionedTopN),
    scalar_comparisons: Array(ScalarAggregateComparison),
    ranked_key_comparisons: Array(RankedKeyComparison),
};

# Top-level result shape is part of the shared AST.  DISTINCT and set
# operations cannot be inferred from a plain Plan's projection alone.
type SetPlan = struct { kind: SetOpKind, left: Plan, right: Plan };
type JoinedGroups = struct {
    left: Plan,
    right: Plan,
    keys: Array(String),
    left_outputs: Array(String),
    right_outputs: Array(String),
};
type QueryPlan = enum {
    Rows(Plan),
    DistinctRows(Plan),
    SetRows(SetPlan),
    SetCount(SetPlan),
    GroupCount(Plan),
    JoinedGroups(JoinedGroups),
    JoinedGroupCount(JoinedGroups),
};

type QueryAst = struct { ctx: BuildCtx, plan: QueryPlan };

def finish: Fn(BuildCtx, QueryPlan) -> QueryAst = fn(ctx, plan) {
    {ctx, plan}
};

# Restricted partitioned Top N stage.  It runs after filter, join, group and
# aggregate: within each partition (a subset of the selected grouping
# expressions) the stable ordering keeps the top `take` rows.  The public AST
# stays closed: no arbitrary window function, frame, raw SQL or identifier
# escape; dialect renderers materialize the partition as a windowed subquery.
type PartitionedTopN = struct {
    partition_by: Array(Expr),
    order_by: Array(OrderBy),
    take: Expr,
};

# A flat, non-recursive inner aggregate specification of a Plan-level scalar
# aggregate comparison: exactly one grain-proven scalar aggregate over one inner
# relation, rendered at its use site as a parenthesized scalar subquery
# `(SELECT <agg>(...) FROM <table> AS <alias> [JOIN ...] [WHERE ...])` that
# always yields exactly one scalar row.  The inner relation's aliases are
# private to the subquery and never leak into the outer plan.  Its only
# expression fields are the aggregate argument, the aggregate-local filter and
# the optional row filter (all ordinary closed `Expr` row expressions over the
# inner aliases).  The specification cannot nest another scalar aggregate and is
# never itself an `Expr`.
type ScalarSubquery = struct {
    source: Source,
    joins: Array(Join),
    filter: Option(Expr),
    function: AggregateFunction,
    arg: Expr,
    distinct: Bool,
    agg_filter: Option(Expr),
};

# A Plan-level scalar aggregate comparison predicate.  The outer query keeps a
# row when `<outer> <op> <scalar subquery>`, where the inner side is exactly one
# grain-proven scalar aggregate over its own relation (see `ScalarSubquery`).
# `op` is restricted by validation to the closed comparison operators
# `ScalarFunction.Eq/ScalarFunction.Ne/ScalarFunction.Lt/ScalarFunction.Le/ScalarFunction.Gt/ScalarFunction.Ge`.  The ordered `Plan.scalar_comparisons` array renders
# as additional parenthesized scalar-subquery predicates in WHERE with
# deterministic predicate order and bindings.  Expr is not involved: this is a
# Plan-level WHERE predicate, so the row-expression vocabulary stays closed.
type ScalarAggregateComparison = struct {
    outer: ColumnRef,
    op: ScalarFunction,
    inner: ScalarSubquery,
};

# A closed grouped-key scalar subquery (a distinct, separate typed spec; it does
# not overload or weaken `ScalarSubquery`).  The inner query projects exactly one
# grouping key (`keys` must validate to exactly one expression), orders the groups
# by ONE closed aggregate ordering expression (`order`) with a required
# `direction`, and returns the key of the first group (`LIMIT 1` semantics).  It
# may carry declared joins and an optional row filter, but no arbitrary
# projection, HAVING, offset, partition, set operation, nested scalar subquery or
# raw SQL.  The inner aliases are private to the subquery and never leak into the
# outer plan.
type RankedKeySubquery = struct {
    source: Source,
    joins: Array(Join),
    filter: Option(Expr),
    keys: Array(Expr),          # exactly one projected/grouped key expression
    order: AggregateCall,       # the one closed aggregate ordering expression
    direction: Ordering,        # Ordering.Asc / Ordering.Desc group rank
};

# A Plan-level ranked grouped-key comparison predicate.  The outer query keeps a
# row when `<outer> <op> <grouped-key scalar subquery>` (the outer side is a
# plain `ColumnRef` of a visible outer alias, `op` a closed comparison operator).
# The ordered `Plan.ranked_key_comparisons` array renders as additional
# parenthesized scalar select predicates in WHERE with deterministic predicate
# order and bindings; the outer projection is never changed.  Expr is not
# involved: this is a Plan-level WHERE predicate, so the row-expression
# vocabulary stays closed.
type RankedKeyComparison = struct {
    outer: ColumnRef,
    op: ScalarFunction,
    inner: RankedKeySubquery,
};

# ---------------------------------------------------------------------------
# Operator vocabulary and profile.
# ---------------------------------------------------------------------------

type Operator = enum {
    Source,
    Project,
    Column,
    Bind,
    Scalar,
    Aggregate,
    Filter,
    Exists,
    Join,
    Group,
    Having,
    Order,
    Limit,
    Offset,
    Partition,
};

# Upper bound for `PartitionedTopN.take`.  `take` must be a positive integer
# within this cap and always enters the SQL through a `?` binding.
def max_partition_take: Int = 1000;

type PlanProfile = struct {
    allowed_operators: Array(Operator),
    allowed_join_kinds: Array(JoinKind),
    allowed_aggregates: Array(AggregateFunction),
    allowed_scalars: Array(ScalarFunction),
    allow_distinct: Bool,
};

# ---------------------------------------------------------------------------
# Identifier checks.
# ---------------------------------------------------------------------------

def sql_identifier_pattern: regex::Regex = regex::compile(r"^[A-Za-z_][A-Za-z0-9_]*$");

def is_sql_identifier: Fn(String) -> Bool = fn(text) {
    regex::is_match(sql_identifier_pattern, text)
};

# ---------------------------------------------------------------------------
# Operator set computation.
# ---------------------------------------------------------------------------

def ops_member: Fn(Array(Operator), Operator) -> Bool = fn(items, op) {
    array::any(items, fn(item) { item == op })
};

def push_unique_operator: Fn(Array(Operator), Operator) -> Array(Operator) = fn(items, op) {
    if ops_member(items, op) { items } else { array::push(items, op) }
};

def ops_union: Fn(Array(Operator), Array(Operator)) -> Array(Operator) = fn(left, right) {
    array::fold(right, left, push_unique_operator)
};

def expr_operators: Fn(Expr) -> Array(Operator) = fn(expr) {
    match expr {
        Expr::Column(_) => [Operator::Column],
        Expr::AllocatedBind(_) => [Operator::Bind],
        Expr::Scalar(call) => {
            let empty: Array(Operator) = [];
            let child = array::fold(call.args, empty, fn(acc, arg) {
                ops_union(acc, expr_operators(arg))
            });
            ops_union(child, [Operator::Scalar])
        },
    }
};

def exprs_operators: Fn(Array(Expr)) -> Array(Operator) = fn(exprs) {
    let empty: Array(Operator) = [];
    array::fold(exprs, empty, fn(acc, expr) { ops_union(acc, expr_operators(expr)) })
};

def aggregate_operators: Fn(AggregateCall) -> Array(Operator) = fn(call) {
    # An aggregate-local predicate is a Filter capability: it narrows that
    # aggregate's input rows, so a profile that forbids Filter must reject it.
    let base = ops_union(expr_operators(call.arg), [Operator::Aggregate]);
    match call.filter {
        Some(expr) => ops_union(ops_union(base, expr_operators(expr)), [Operator::Filter]),
        None => base,
    }
};

def select_item_operators: Fn(SelectItem) -> Array(Operator) = fn(item) {
    match item {
        SelectItem::Expr(expr) => expr_operators(expr),
        SelectItem::NamedExpr(named) => expr_operators(named.expr),
        SelectItem::Aggregate(call) => aggregate_operators(call),
        # A computed aggregate consumes the Scalar capability (the restricted
        # Add/Sub arithmetic over aggregates); operand items contribute their
        # own operators whether projected or internal.
        SelectItem::Computed(_) => {
            let empty: Array(Operator) = [];
            ops_union(empty, [Operator::Scalar])
        },
    }
};

def order_key_operators: Fn(OrderKey) -> Array(Operator) = fn(key) {
    match key {
        OrderKey::Expr(expr) => expr_operators(expr),
        OrderKey::AggregateRef(_) => [Operator::Aggregate],
        # A direct ordering aggregate consumes the same operator set as a
        # projected aggregate (Aggregate plus the operator usage of its
        # argument and aggregate-local filter).
        OrderKey::Aggregate(call) => aggregate_operators(call),
    }
};

def ordering_operators: Fn(Array(OrderBy)) -> Array(Operator) = fn(ordering) {
    let empty: Array(Operator) = [];
    array::fold(ordering, empty, fn(acc, ob) { ops_union(acc, order_key_operators(ob.key)) })
};

def join_condition_operators: Fn(JoinCondition) -> Array(Operator) = fn(condition) {
    match condition {
        JoinCondition::Eq(_) => [Operator::Column],
        JoinCondition::Predicate(expr) => ops_union(expr_operators(expr), [Operator::Filter]),
        JoinCondition::Exists(ex) => exists_operators([ex]),
        JoinCondition::And(items) => {
            let empty: Array(Operator) = [];
            array::fold(items, empty, fn(acc, item) { ops_union(acc, join_condition_operators(item)) })
        },
        JoinCondition::Or(items) => {
            let empty: Array(Operator) = [];
            array::fold(items, empty, fn(acc, item) { ops_union(acc, join_condition_operators(item)) })
        },
    }
};

def joins_operators: Fn(Array(Join)) -> Array(Operator) = fn(joins) {
    let empty: Array(Operator) = [];
    array::fold(joins, empty, fn(acc, join) {
        ops_union(ops_union(ops_union(acc, [Operator::Join]), join_condition_operators(join.condition)), source_operators(join.source))
    })
};

def source_operators: Fn(Source) -> Array(Operator) = fn(source_item) {
    match source_item.scope {
        Some(expr) => ops_union(expr_operators(expr), [Operator::Filter]),
        None => [],
    }
};

# Each correlated EXISTS consumes the `Exists` capability; an inner row
# predicate and an inner aggregate body additionally consume the operators of
# their own closed Exprs/AggregateCalls (Column/Bind/Scalar/Group/Having as
# appropriate).  This recursion is what stops a subquery from bypassing the
# profile.
def exists_operators: Fn(Array(Exists)) -> Array(Operator) = fn(exists_list) {
    let empty: Array(Operator) = [];
    array::fold(exists_list, empty, fn(acc, ex) {
        match ex.peer {
            # Paired-endpoint mode: the correlation reads the two hub role
            # columns and the two participant key columns (`Column`); the
            # per-participant filters contribute their own expression operators.
            Some(corr) => do {
                let base: Array(Operator) = [Operator::Exists, Operator::Column];
                let with_origin = match corr.origin_filter {
                    Some(expr) => ops_union(base, expr_operators(expr)),
                    None => base,
                };
                let with_peer = match corr.peer_filter {
                    Some(expr) => ops_union(with_origin, expr_operators(expr)),
                    None => with_origin,
                };
                ops_union(ops_union(ops_union(acc, with_peer), source_operators(corr.origin)), source_operators(corr.peer))
            },
            None => match ex.link {
                # Bounded two-hop link body: one correlated EXISTS reading the B
                # and C inner columns (Column) plus the link filter's operators.
                Some(link) => do {
                    let base: Array(Operator) = [Operator::Exists, Operator::Column];
                    let with_filter = match link.filter {
                        Some(expr) => ops_union(base, expr_operators(expr)),
                        None => base,
                    };
                    let with_sources = ops_union(ops_union(acc, with_filter), source_operators(ex.source));
                    let with_link = ops_union(with_sources, source_operators(link.source));
                    match link.tail {
                        Some(tail) => ops_union(with_link, source_operators(tail.source)),
                        None => with_link,
                    }
                },
                None => do {
                    let with_exists = ops_union(acc, [Operator::Exists]);
                    let with_filter = match ex.filter {
                        Some(expr) => ops_union(with_exists, expr_operators(expr)),
                        None => with_exists,
                    };
                    let with_group = if array::length(ex.grouping) > 0 {
                        ops_union(ops_union(with_filter, exprs_operators(ex.grouping)), [Operator::Group])
                    } else {
                        with_filter
                    };
                    let with_path = array::fold(ex.path, with_group, fn(used, join) {
                        ops_union(used, joins_operators([join]))
                    });
                    ops_union(ops_union(with_path, having_operators(ex.having)), source_operators(ex.source))
                },
            },
        }
    })
};

# HAVING clauses consume the `Having` capability.  A `HavingMeasure.Ref` measure names a
# projected aggregate/computed item whose usage is already counted through the
# projection; a `HavingMeasure.Call` measure is a direct aggregate expression that is not
# projected, so its operator usage is counted here (the recursion that makes a
# nested aggregate body profile-aware).  The comparison operator itself is
# plain SQL.
def having_operators: Fn(Array(Having)) -> Array(Operator) = fn(having_list) {
    let empty: Array(Operator) = [];
    let with_flag = if array::length(having_list) > 0 {
        ops_union(empty, [Operator::Having])
    } else {
        empty
    };
    array::fold(having_list, with_flag, fn(acc, h) {
        match h.measure {
            HavingMeasure::Ref(_) => acc,
            HavingMeasure::Call(call) => ops_union(acc, aggregate_operators(call)),
        }
    })
};

# Operators consumed by one UNION ALL branch: its output expressions and its
# row filter (the physical source read is represented by `Operator.Source`, which the
# plan-level operator set already includes).
def union_branch_operators: Fn(UnionBranch) -> Array(Operator) = fn(branch) {
    let out_exprs = array::map(branch.outputs, fn(col) { col.expr });
    let out_ops = ops_union(exprs_operators(out_exprs), source_operators(branch.source));
    match branch.filter {
        Some(expr) => ops_union(ops_union(out_ops, expr_operators(expr)), [Operator::Filter]),
        None => out_ops,
    }
};

def derived_operators: Fn(DerivedSource) -> Array(Operator) = fn(ds) {
    let empty: Array(Operator) = [];
    array::fold(ds.branches, empty, fn(acc, branch) { ops_union(acc, union_branch_operators(branch)) })
};

# A scalar aggregate comparison predicate reads its own inner source
# (Source/Column), may join inner tables (Join), applies its aggregate
# (Aggregate) and is itself a row predicate over the outer row (Filter).  Its
# inner row filter and aggregate-local filter also narrow input rows (Filter).
def scalar_comparison_operators: Fn(ScalarAggregateComparison) -> Array(Operator) = fn(cmp) {
    let with_filter: Array(Operator) = [Operator::Filter];
    let with_column = ops_union(with_filter, [Operator::Column]);
    let with_source = ops_union(with_column, [Operator::Source]);
    let with_joins = if array::length(cmp.inner.joins) > 0 {
        ops_union(ops_union(with_source, joins_operators(cmp.inner.joins)), [Operator::Column])
    } else {
        with_source
    };
    let with_agg = ops_union(ops_union(ops_union(with_joins, source_operators(cmp.inner.source)), expr_operators(cmp.inner.arg)), [Operator::Aggregate]);
    let with_agg_filter = match cmp.inner.agg_filter {
        Some(expr) => ops_union(ops_union(with_agg, expr_operators(expr)), [Operator::Filter]),
        None => with_agg,
    };
    match cmp.inner.filter {
        Some(expr) => ops_union(ops_union(with_agg_filter, expr_operators(expr)), [Operator::Filter]),
        None => with_agg_filter,
    }
};

def scalar_comparisons_operators: Fn(Array(ScalarAggregateComparison)) -> Array(Operator) = fn(comparisons) {
    let empty: Array(Operator) = [];
    array::fold(comparisons, empty, fn(acc, cmp) { ops_union(acc, scalar_comparison_operators(cmp)) })
};

# Operators consumed by one ranked grouped-key comparison: the predicate reads
# the outer column and the inner grouped key (Column), reads the inner source
# (Source), aggregates and groups the inner rows (Aggregate/Group), orders the
# groups by the aggregate (Order), narrows rows (Filter through the row filter /
# aggregate-local filter / the comparison itself), and may join inner tables
# (Join).
def ranked_key_comparison_operators: Fn(RankedKeyComparison) -> Array(Operator) = fn(cmp) {
    let sq = cmp.inner;
    let base: Array(Operator) = [Operator::Filter, Operator::Source, Operator::Aggregate, Operator::Group, Operator::Order];
    let with_column = ops_union(base, [Operator::Column]);
    let with_joins = if array::length(sq.joins) > 0 {
        ops_union(ops_union(with_column, joins_operators(sq.joins)), [Operator::Column])
    } else {
        with_column
    };
    let with_key_scalars = array::fold(sq.keys, ops_union(with_joins, source_operators(sq.source)), fn(acc, key) {
        ops_union(acc, expr_operators(key))
    });
    let with_order_arg = ops_union(with_key_scalars, expr_operators(sq.order.arg));
    let with_order_filter = match sq.order.filter {
        Some(expr) => ops_union(ops_union(with_order_arg, expr_operators(expr)), [Operator::Filter]),
        None => with_order_arg,
    };
    match sq.filter {
        Some(expr) => ops_union(ops_union(with_order_filter, expr_operators(expr)), [Operator::Filter]),
        None => with_order_filter,
    }
};

def ranked_key_comparisons_operators: Fn(Array(RankedKeyComparison)) -> Array(Operator) = fn(comparisons) {
    let empty: Array(Operator) = [];
    array::fold(comparisons, empty, fn(acc, cmp) { ops_union(acc, ranked_key_comparison_operators(cmp)) })
};

# The canonical operator vocabulary order documented for this crate.
def canonical_operators: Array(Operator) = [
    Operator::Source, Operator::Project, Operator::Column, Operator::Bind, Operator::Scalar, Operator::Aggregate,
    Operator::Filter, Operator::Exists, Operator::Join, Operator::Group, Operator::Having, Operator::Order, Operator::Limit,
    Operator::Offset, Operator::Partition,
];

# Returns the set of standard operators used by a plan, in canonical vocabulary
# order.  `operators(plan) <= profile.allowed_operators` is the subset check.
def operators: Fn(Plan) -> Array(Operator) = fn(plan) {
    let base: Array(Operator) = [Operator::Source];
    let with_projection = if array::length(plan.projection) > 0 {
        ops_union(base, [Operator::Project])
    } else {
        base
    };
    let with_items = array::fold(plan.projection, with_projection, fn(acc, item) {
        ops_union(acc, select_item_operators(item))
    });
    let with_internal = array::fold(plan.internal_measures, with_items, fn(acc, item) {
        ops_union(acc, select_item_operators(item))
    });
    let with_filter = match plan.filter {
        Some(expr) => ops_union(ops_union(with_internal, expr_operators(expr)), [Operator::Filter]),
        None => with_internal,
    };
    let with_exists = ops_union(with_filter, exists_operators(plan.exists));
    let with_comparisons = ops_union(with_exists, scalar_comparisons_operators(plan.scalar_comparisons));
    let with_ranked = ops_union(with_comparisons, ranked_key_comparisons_operators(plan.ranked_key_comparisons));
    let with_joins = ops_union(ops_union(with_ranked, joins_operators(plan.joins)), array::fold(plan.sources, base, fn(acc, source_item) { ops_union(acc, source_operators(source_item)) }));
    let with_group = if array::length(plan.grouping) > 0 {
        ops_union(ops_union(with_joins, exprs_operators(plan.grouping)), [Operator::Group])
    } else {
        with_joins
    };
    let with_having = ops_union(with_group, having_operators(plan.having));
    let with_order = if array::length(plan.ordering) > 0 {
        ops_union(ops_union(with_having, ordering_operators(plan.ordering)), [Operator::Order])
    } else {
        with_having
    };
    let with_limit = if plan.limit != None {
        ops_union(with_order, [Operator::Limit])
    } else {
        with_order
    };
    let with_offset = if plan.offset != None {
        ops_union(with_limit, [Operator::Offset])
    } else {
        with_limit
    };
    let used = match plan.partition {
        Some(pt) => {
            let with_window_order = ops_union(with_offset, ordering_operators(pt.order_by));
            let with_partition_order = ops_union(with_window_order, [Operator::Order]);
            ops_union(with_partition_order, [Operator::Partition])
        },
        None => with_offset,
    };
    # A derived UNION ALL relation contributes its branches' operators
    # (Source/Column/Bind/Scalar/Filter as used by each branch's projections
    # and filters); the outer stage contributes its own operators above.
    let used_all = match plan.derived {
        Some(ds) => ops_union(used, derived_operators(ds)),
        None => used,
    };
    # Emit only the used operators, always in canonical vocabulary order.
    array::filter(canonical_operators, fn(op) { ops_member(used_all, op) })
};

# ---------------------------------------------------------------------------
# Structural validation.
# ---------------------------------------------------------------------------

def scalar_arity_ok: Fn(ScalarFunction, Array(Expr)) -> Bool = fn(function, args) {
    let len = array::length(args);
    match function {
        ScalarFunction::Substr => len == 2 || len == 3,
        ScalarFunction::Instr => len == 2,
        ScalarFunction::If => len == 3,
        ScalarFunction::Add => len == 2,
        ScalarFunction::Sub => len == 2,
        ScalarFunction::Lower => len == 1,
        ScalarFunction::Length => len == 1,
        ScalarFunction::UtcDaysAgo => len == 2,
        ScalarFunction::Eq => len == 2,
        ScalarFunction::Ne => len == 2,
        ScalarFunction::Lt => len == 2,
        ScalarFunction::Le => len == 2,
        ScalarFunction::Gt => len == 2,
        ScalarFunction::Ge => len == 2,
        ScalarFunction::And => len == 2,
        ScalarFunction::Or => len == 2,
        ScalarFunction::Not => len == 1,
    }
};

def known_alias: Fn(Array(String), String) -> Bool = fn(aliases, alias) {
    array::any(aliases, fn(candidate) { candidate == alias })
};

def utc_days_args_ok: Fn(Array(Expr)) -> Bool = fn(args) {
    match (args[0], args[1]) {
        (Expr::AllocatedBind(_), Expr::AllocatedBind(_)) => True,
        _ => False,
    }
};

def scalar_call_valid: Fn(ScalarFunction, Array(Expr)) -> Bool = fn(function, args) {
    scalar_arity_ok(function, args) && (match function {
        ScalarFunction::UtcDaysAgo => utc_days_args_ok(args),
        _ => True,
    })
};

def expr_valid: Fn(Expr, Array(String)) -> Bool = fn(expr, aliases) {
    match expr {
        Expr::Column(ref) => is_sql_identifier(ref.column) && known_alias(aliases, ref.source),
        Expr::AllocatedBind(binding) => binding.index > 0,
        Expr::Scalar(call) => array::all(call.args, fn(arg) { expr_valid(arg, aliases) }),
    }
};

def select_item_valid: Fn(SelectItem, Array(String)) -> Bool = fn(item, aliases) {
    match item {
        SelectItem::Expr(expr) => expr_valid(expr, aliases),
        SelectItem::NamedExpr(named) => is_sql_identifier(named.alias) && expr_valid(named.expr, aliases),
        SelectItem::Aggregate(call) => is_sql_identifier(call.alias) && expr_valid(call.arg, aliases)
            && (match call.filter {
                Some(expr) => expr_valid(expr, aliases),
                None => True,
            }),
        # Computed aggregates need the full plan for operand resolution; that
        # check runs in `computed_items_ok`.
        SelectItem::Computed(_) => True,
    }
};

def column_ref_id_ok: Fn(ColumnRef) -> Bool = fn(ref) {
    is_sql_identifier(ref.source) && is_sql_identifier(ref.column)
};

def column_eq_id_ok: Fn(ColumnEq) -> Bool = fn(eq) {
    column_ref_id_ok(eq.left) && column_ref_id_ok(eq.right)
};

def column_eq_known: Fn(ColumnEq, Array(String)) -> Bool = fn(eq, aliases) {
    is_sql_identifier(eq.left.column)
        && is_sql_identifier(eq.right.column)
        && known_alias(aliases, eq.left.source)
        && known_alias(aliases, eq.right.source)
};

# Every ColumnRef in an ON tree is a well-formed identifier.
def join_on_identifiers_valid: Fn(JoinCondition) -> Bool = fn(condition) {
    match condition {
        JoinCondition::Eq(eq) => column_eq_id_ok(eq),
        JoinCondition::Predicate(_) => True,
        JoinCondition::Exists(_) => True,
        JoinCondition::And(items) => array::all(items, join_on_identifiers_valid),
        JoinCondition::Or(items) => array::all(items, join_on_identifiers_valid),
    }
};

# And/Or nodes must combine at least one child; an empty conjunction or
# disjunction is rejected.
def join_on_shape_ok: Fn(JoinCondition) -> Bool = fn(condition) {
    match condition {
        JoinCondition::Eq(_) => True,
        JoinCondition::Predicate(_) => True,
        JoinCondition::Exists(_) => True,
        JoinCondition::And(items) => array::length(items) > 0 && array::all(items, join_on_shape_ok),
        JoinCondition::Or(items) => array::length(items) > 0 && array::all(items, join_on_shape_ok),
    }
};

# Every ColumnRef in an ON tree names a source alias visible to the plan.
def join_on_condition_valid: Fn(JoinCondition, Array(String)) -> Bool = fn(condition, aliases) {
    match condition {
        JoinCondition::Eq(eq) => column_eq_known(eq, aliases),
        JoinCondition::Predicate(expr) => expr_valid(expr, aliases),
        JoinCondition::Exists(ex) => exists_structure_ok(ex, aliases),
        JoinCondition::And(items) => array::length(items) > 0
            && array::all(items, fn(child) { join_on_condition_valid(child, aliases) }),
        JoinCondition::Or(items) => array::length(items) > 0
            && array::all(items, fn(child) { join_on_condition_valid(child, aliases) }),
    }
};

def join_identifiers_valid: Fn(Join) -> Bool = fn(join) {
    source_valid(join.source)
    && join_on_identifiers_valid(join.condition)
};

def source_valid: Fn(Source) -> Bool = fn(source_item) {
    is_sql_identifier(source_item.alias) && is_sql_identifier(source_item.table)
        && (match source_item.scope {
            Some(expr) => expr_valid(expr, [source_item.alias]),
            None => True,
        })
};

def join_condition_valid: Fn(Join, Array(String)) -> Bool = fn(join, aliases) {
    join_on_condition_valid(join.condition, aliases)
};

def joins_conditions_valid: Fn(Array(Join), Array(String)) -> Bool = fn(joins, initial_aliases) {
    let state: (Array(String), Bool) = array::fold(joins, (initial_aliases, True), fn(acc, join) {
        let visible = array::push(acc.0, join.source.alias);
        (visible, acc.1 && join_condition_valid(join, visible))
    });
    state.1
};

def aliases_of: Fn(Plan) -> Array(String) = fn(plan) {
    match plan.derived {
        # A derived UNION ALL relation is the only outer FROM source; its
        # branches' local aliases are not visible to the outer plan.
        Some(ds) => [ds.alias],
        None => array::fold(plan.joins, array::map(plan.sources, fn(source) { source.alias }), fn(acc, join) {
            array::push(acc, join.source.alias)
        }),
    }
};

# Aliases of the measures (aggregates and computed aggregates) projected by the
# plan, in projection order.  Ordering and partition ordering may reference any
# of these aliases.
def projected_measure_aliases: Fn(Plan) -> Array(String) = fn(plan) {
    let empty: Array(String) = [];
    array::fold(plan.projection, empty, fn(acc, item) {
        match item {
            SelectItem::Expr(_) => acc,
            SelectItem::NamedExpr(_) => acc,
            SelectItem::Aggregate(call) => array::push(acc, call.alias),
            SelectItem::Computed(ca) => array::push(acc, ca.alias),
        }
    })
};

# An ordering key is valid when a plain expression is a valid Expr, when an
# AggregateRef names a valid SQL identifier that is a projected measure alias,
# or when a direct ordering aggregate carries a valid argument/filter over the
# visible source aliases (the aggregate itself is validated by profile checks).
def order_key_valid: Fn(OrderKey, Array(String), Array(String)) -> Bool = fn(key, source_aliases, measure_aliases) {
    match key {
        OrderKey::Expr(expr) => expr_valid(expr, source_aliases),
        OrderKey::AggregateRef(ref) => is_sql_identifier(ref.alias) && known_alias(measure_aliases, ref.alias),
        OrderKey::Aggregate(call) => expr_valid(call.arg, source_aliases)
            && (match call.filter {
                Some(expr) => expr_valid(expr, source_aliases),
                None => True,
            }),
    }
};

# Structural equality of expressions (closed nominal enum: `==` is structural).
def expr_member: Fn(Array(Expr), Expr) -> Bool = fn(exprs, target) {
    array::any(exprs, fn(candidate) { candidate == target })
};

def exprs_subset: Fn(Array(Expr), Array(Expr)) -> Bool = fn(needles, haystack) {
    array::all(needles, fn(needle) { expr_member(haystack, needle) })
};

# The projection item whose aggregate/computed alias equals `alias`.
def find_item_by_alias: Fn(Plan, String) -> Option(SelectItem) = fn(plan, alias) {
    array::find(plan.projection, fn(item) {
        match item {
            SelectItem::Expr(_) => False,
            SelectItem::NamedExpr(_) => False,
            SelectItem::Aggregate(call) => call.alias == alias,
            SelectItem::Computed(ca) => ca.alias == alias,
        }
    })
};

def computed_operand: Fn(Plan, String) -> Option(SelectItem) = fn(plan, alias) {
    match find_item_by_alias(plan, alias) {
        Some(item) => Some(item),
        None => array::find(plan.internal_measures, fn(item) {
            match item {
                SelectItem::Aggregate(call) => call.alias == alias,
                SelectItem::Computed(ca) => ca.alias == alias,
                _ => False,
            }
        }),
    }
};

def count_in: Fn(Array(String), String) -> Int = fn(items, target) {
    array::length(array::filter(items, fn(item) { item == target }))
};

# Aggregate/computed aliases must be distinct so references are unambiguous and
# reusing a filtered aggregate always means the same declaration.
def measure_aliases_distinct: Fn(Plan) -> Bool = fn(plan) {
    let aliases = array::concat([projected_measure_aliases(plan),
        array::map(plan.internal_measures, fn(item) {
            match item {
                SelectItem::Aggregate(call) => call.alias,
                SelectItem::Computed(ca) => ca.alias,
                _ => "",
            }
        })]);
    array::all(array::enumerate(aliases), fn(pair) { count_in(aliases, pair.1) == 1 })
};

# True when expanding `alias` (a computed aggregate) reaches `alias` again,
# i.e. the computed-aggregate dependency graph has a cycle.
def computed_cycle_from: Fn(Plan, String, Array(String)) -> Bool = fn(plan, alias, path) {
    if array::any(path, fn(p) { p == alias }) {
        True
    } else {
        match computed_operand(plan, alias) {
            Some(SelectItem::Computed(ca)) => {
                let next_path = array::push(path, alias);
                computed_cycle_from(plan, ca.left, next_path)
                    || computed_cycle_from(plan, ca.right, next_path)
            },
            _ => False,
        }
    }
};

# A computed aggregate is well-formed when its alias is a valid SQL identifier,
# both operands resolve to projected or internal aggregate/computed items,
# and the dependency graph is acyclic. Query only guarantees this
# structural resolution (alias, dependency order, SQL structure); business
# grain/relation-path compatibility is the Ontology's responsibility and is NOT
# asserted here.
def computed_ok: Fn(Plan, ComputedAggregate) -> Bool = fn(plan, ca) {
    let alias_ok = is_sql_identifier(ca.alias) && !computed_cycle_from(plan, ca.alias, []);
    let left_ok = match computed_operand(plan, ca.left) {
        Some(SelectItem::Aggregate(_)) => True,
        Some(SelectItem::Computed(_)) => True,
        _ => False,
    };
    let right_ok = match computed_operand(plan, ca.right) {
        Some(SelectItem::Aggregate(_)) => True,
        Some(SelectItem::Computed(_)) => True,
        _ => False,
    };
    alias_ok && left_ok && right_ok
};

def computed_items_ok: Fn(Plan) -> Bool = fn(plan) {
    array::all(array::concat([plan.projection, plan.internal_measures]), fn(item) {
        match item {
            SelectItem::Computed(ca) => computed_ok(plan, ca),
            _ => True,
        }
    })
};

def computed_reaches: Fn(Plan, String, String, Array(String)) -> Bool = fn(plan, alias, target, visited) {
    if alias == target { True }
    else if array::any(visited, fn(name) { name == alias }) { False }
    else match computed_operand(plan, alias) {
        Some(SelectItem::Computed(item)) => {
            let path = array::push(visited, alias);
            computed_reaches(plan, item.left, target, path)
                || computed_reaches(plan, item.right, target, path)
        },
        _ => False,
    }
};

def internal_measures_used: Fn(Plan) -> Bool = fn(plan) {
    array::all(plan.internal_measures, fn(item) {
        let alias = match item {
            SelectItem::Aggregate(call) => call.alias,
            SelectItem::Computed(ca) => ca.alias,
            _ => "",
        };
        array::any(plan.projection, fn(projected) {
            match projected {
                SelectItem::Computed(ca) => computed_reaches(plan, ca.alias, alias, []),
                _ => False,
            }
        })
    })
};

# The partitioned Top N stage is well-formed when:
#   - `take` is a positive integer within `max_partition_take`;
#   - every partition key is one of the selected grouping expressions;
#   - `order_by` is non-empty and every target is a selected grouping
#     expression or a projected aggregate alias;
#   - every non-partition grouping expression is covered by an `Expr` order key
#     (deterministic tie-breaker);
#   - v1 does not combine partitioned Top N with global limit/offset/ordering.
def partition_structure_ok: Fn(Plan, PartitionedTopN) -> Bool = fn(plan, pt) {
    let take_ok = page_value_ok(pt.take, True);
    let row_plan = array::length(plan.grouping) == 0
        && array::length(plan.having) == 0
        && array::all(plan.projection, fn(item) {
            match item { SelectItem::Expr(_) => True, SelectItem::NamedExpr(_) => True, _ => False }
        });
    let aliases = aliases_of(plan);
    let keys_ok = array::length(pt.partition_by) > 0
        && (if row_plan { array::all(pt.partition_by, fn(expr) { expr_valid(expr, aliases) }) }
            else { exprs_subset(pt.partition_by, plan.grouping) });
    let order_ok = array::length(pt.order_by) > 0
        && array::all(pt.order_by, fn(ob) {
            match ob.key {
                OrderKey::Expr(expr) => if row_plan { expr_valid(expr, aliases) } else { expr_member(plan.grouping, expr) },
                OrderKey::AggregateRef(ref) => is_sql_identifier(ref.alias)
                    && known_alias(projected_measure_aliases(plan), ref.alias),
                # v1 partition ordering does not take a direct (unprojected)
                # ordering aggregate.
                OrderKey::Aggregate(_) => False,
            }
        });
    let tie_break_ok = array::all(plan.grouping, fn(group_expr) {
        if expr_member(pt.partition_by, group_expr) {
            True
        } else {
            array::any(pt.order_by, fn(ob) {
                match ob.key {
                    OrderKey::Expr(expr) => expr == group_expr,
                    OrderKey::AggregateRef(_) => False,
                    OrderKey::Aggregate(_) => False,
                }
            })
        }
    });
    let no_combo_ok = plan.limit == None && plan.offset == None
        && array::length(plan.ordering) == 0;
    take_ok && keys_ok && order_ok && tie_break_ok && no_combo_ok
};

# A correlated EXISTS is well-formed when its inner source has a distinct
# alias and exactly one correlation mode holds: either at least one ANDed
# equality pair (each correlating one outer main alias column to one inner
# alias column), or (union mode) a closed `alternatives` list where each
# alternative is a non-empty ANDed equality conjunction and every equality
# strictly connects an outer main alias column to an inner alias column.  The
# optional inner filter, grouping expressions and (aggregate-call) HAVING
# measures are valid Exprs over the outer aliases plus the inner alias.  Inside
# a correlated EXISTS the HAVING measure must be a direct `HavingMeasure.Call` aggregate
# expression: the inner SELECT list is `1`, so there is no projected measure
# alias to reference.
def alt_ok: Fn(Array(ColumnEq), String, Array(String)) -> Bool = fn(alt, inner, main_aliases) {
    array::length(alt) > 0
        && array::all(alt, fn(p) {
            column_ref_id_ok(p.left)
            && is_sql_identifier(p.right.source)
            && is_sql_identifier(p.right.column)
            && p.right.source == inner
            && known_alias(main_aliases, p.left.source)
        })
};

def alternatives_ok: Fn(Array(Array(ColumnEq)), String, Array(String)) -> Bool = fn(alternatives, inner, main_aliases) {
    array::length(alternatives) > 0
        && array::all(alternatives, fn(alt) { alt_ok(alt, inner, main_aliases) })
};

# One participant side of a paired correlation: an equality whose `left` is a
# visible outer (hub) role column and whose `right` is the declared inner key
# column of the participant alias.
def peer_side_eq_ok: Fn(ColumnEq, Array(String), String, ColumnRef) -> Bool = fn(eq, main_aliases, inner_alias, key) {
    column_ref_id_ok(eq.left)
        && known_alias(main_aliases, eq.left.source)
        && eq.right == key
        && key.source == inner_alias
        && is_sql_identifier(key.column)
};

# A paired correlation is well-formed when:
#   - origin and peer are distinct inner sources with distinct aliases that do
#     not shadow any main alias;
#   - the two ordered exchange branches reference the SAME two hub role columns
#     (same hub row) with the origin/peer key columns swapped between branches;
#   - every equality connects a validated hub role column to the key column of
#     its own participant alias (identity is proven through the declared inner
#     source, never through a bare value);
#   - the two hub role columns are distinct (no same-side match);
#   - the origin/peer filters reference only visible aliases plus their own
#     inner alias (participant filters belong to the corresponding alias);
#   - when `distinct_keys` is set (same-entity peer), the identity proof is
#     well-formed: the two inner key columns are legal and live on the two
#     distinct participant aliases.
def peer_corr_ok: Fn(PeerCorr, Array(String)) -> Bool = fn(corr, main_aliases) {
    let origin_alias = corr.origin.alias;
    let peer_alias = corr.peer.alias;
    let origin_id_ok = source_valid(corr.origin)
        && !known_alias(main_aliases, origin_alias);
    let peer_id_ok = source_valid(corr.peer)
        && !known_alias(main_aliases, peer_alias)
        && peer_alias != origin_alias;
    let origin_key = corr.branch_a.origin.right;
    let peer_key = corr.branch_a.peer.right;
    let hub_alias = corr.branch_a.origin.left.source;
    let hub_same = corr.branch_a.peer.left.source == hub_alias
        && corr.branch_b.origin.left.source == hub_alias
        && corr.branch_b.peer.left.source == hub_alias;
    let hub_roles = corr.branch_a.origin.left.column != corr.branch_a.peer.left.column
        && corr.branch_b.origin.left == corr.branch_a.peer.left
        && corr.branch_b.peer.left == corr.branch_a.origin.left;
    let side_a_ok = peer_side_eq_ok(corr.branch_a.origin, main_aliases, origin_alias, origin_key)
        && peer_side_eq_ok(corr.branch_a.peer, main_aliases, peer_alias, peer_key);
    let side_b_ok = peer_side_eq_ok(corr.branch_b.origin, main_aliases, origin_alias, origin_key)
        && peer_side_eq_ok(corr.branch_b.peer, main_aliases, peer_alias, peer_key);
    let origin_allowed = array::push(main_aliases, origin_alias);
    let peer_allowed = array::push(main_aliases, peer_alias);
    let origin_filter_ok = match corr.origin_filter {
        Some(expr) => expr_valid(expr, origin_allowed),
        None => True,
    };
    let peer_filter_ok = match corr.peer_filter {
        Some(expr) => expr_valid(expr, peer_allowed),
        None => True,
    };
    let distinct_ok = if corr.distinct_keys {
        is_sql_identifier(origin_key.column) && is_sql_identifier(peer_key.column)
        && origin_key.source != peer_key.source
    } else {
        True
    };
    origin_id_ok && peer_id_ok && hub_same && hub_roles && side_a_ok && side_b_ok
        && origin_filter_ok && peer_filter_ok && distinct_ok
};

# Structural validation of the bounded correlated two-hop link body:
#   - the hop source (`ex.source`, B) is a legal alias distinct from the main
#     aliases;
#   - the link source (`link.source`, C) is legal and distinct from both;
#   - `ex.pairs` correlates an outer main alias column to a hop-source column;
#   - `link.pairs` or closed alternatives join hop to link;
#   - optional tail pairs join link to a distinct third source;
#   - `link.filter` is a valid Expr over main and declared inner aliases;
#   - the other single-source modes are not combined with the link mode.
def link_structure_ok: Fn(Exists, ExistsLink, Array(String)) -> Bool = fn(ex, link, main_aliases) {
    let hop = ex.source.alias;
    let hop_ok = source_valid(ex.source)
        && !known_alias(main_aliases, hop);
    let link_source_ok = source_valid(link.source)
        && link.source.alias != hop
        && !known_alias(main_aliases, link.source.alias);
    let hop_pairs_ok = match ex.alternatives {
        Some(alternatives) => array::length(ex.pairs) == 0 && alternatives_ok(alternatives, hop, main_aliases),
        None => array::length(ex.pairs) > 0 && array::all(ex.pairs, fn(p) {
            column_ref_id_ok(p.left)
                && is_sql_identifier(p.right.source)
                && is_sql_identifier(p.right.column)
                && p.right.source == hop
                && known_alias(main_aliases, p.left.source)
        }),
    };
    let link_pairs_ok = match link.alternatives {
        None => array::length(link.pairs) > 0 && array::all(link.pairs, fn(p) {
            column_ref_id_ok(p.left) && column_ref_id_ok(p.right)
                && p.left.source == hop && p.right.source == link.source.alias
        }),
        Some(alternatives) => array::length(link.pairs) == 0
            && alternatives_ok(alternatives, link.source.alias, [hop]),
    };
    let mode_ok = array::length(ex.path) == 0 && ex.filter == None
        && array::length(ex.grouping) == 0 && array::length(ex.having) == 0
        && ex.peer == None;
    let tail_ok = match link.tail {
        None => True,
        Some(tail) => source_valid(tail.source)
            && tail.source.alias != hop && tail.source.alias != link.source.alias
            && !known_alias(main_aliases, tail.source.alias)
            && array::length(tail.pairs) > 0 && array::all(tail.pairs, fn(p) {
                column_ref_id_ok(p.left) && column_ref_id_ok(p.right)
                    && p.left.source == link.source.alias && p.right.source == tail.source.alias
            }),
    };
    let allowed = match link.tail {
        None => array::concat([main_aliases, [hop, link.source.alias]]),
        Some(tail) => array::concat([main_aliases, [hop, link.source.alias, tail.source.alias]]),
    };
    let filter_ok = match link.filter {
        Some(expr) => expr_valid(expr, allowed),
        None => True,
    };
    hop_ok && link_source_ok && hop_pairs_ok && link_pairs_ok && tail_ok && mode_ok && filter_ok
};

def path_condition_ok: Fn(JoinCondition, Array(String), String) -> Bool = fn(condition, visible, next) {
    match condition {
        JoinCondition::Eq(pair) => column_ref_id_ok(pair.left) && column_ref_id_ok(pair.right)
            && ((known_alias(visible, pair.left.source) && pair.right.source == next)
                || (known_alias(visible, pair.right.source) && pair.left.source == next)
                || (known_alias(visible, pair.left.source) && known_alias(visible, pair.right.source))),
        JoinCondition::Predicate(expr) => expr_valid(expr, array::push(visible, next)),
        JoinCondition::And(parts) => array::length(parts) > 0
            && array::all(parts, fn(part) { path_condition_ok(part, visible, next) }),
        JoinCondition::Or(parts) => array::length(parts) > 0
            && array::all(parts, fn(part) { path_condition_ok(part, visible, next) }),
        _ => False,
    }
};

def path_condition_joins_new: Fn(JoinCondition, String) -> Bool = fn(condition, next) {
    match condition {
        JoinCondition::Eq(pair) => pair.left.source == next || pair.right.source == next,
        JoinCondition::And(parts) => array::any(parts, fn(part) { path_condition_joins_new(part, next) }),
        JoinCondition::Or(parts) => array::length(parts) > 0
            && array::all(parts, fn(part) { path_condition_joins_new(part, next) }),
        _ => False,
    }
};

def path_structure_ok: Fn(Exists, Array(String)) -> Bool = fn(ex, main_aliases) {
    let first = ex.source.alias;
    let initial: (Array(String), Bool) = ([first], True);
    let checked = array::fold(ex.path, initial, fn(state, join) {
        let alias = join.source.alias;
        (array::push(state.0, alias), state.1 && join.kind == JoinKind::Inner
            && source_valid(join.source) && !known_alias(main_aliases, alias)
            && !known_alias(state.0, alias)
            && path_condition_ok(join.condition, array::concat([main_aliases, state.0]), alias)
            && path_condition_joins_new(join.condition, alias))
    });
    let allowed = array::concat([main_aliases, checked.0]);
    let filter_ok = match ex.filter {
        Some(expr) => expr_valid(expr, allowed),
        None => True,
    };
    checked.1 && ex.peer == None && ex.link == None && filter_ok
};

def exists_structure_ok: Fn(Exists, Array(String)) -> Bool = fn(ex, main_aliases) {
    match ex.peer {
        Some(corr) => array::length(ex.path) == 0 && peer_corr_ok(corr, main_aliases),
        None => match ex.link {
            Some(link) => link_structure_ok(ex, link, main_aliases),
            None => do {
                let inner = ex.source.alias;
                let id_ok = source_valid(ex.source)
                    && !known_alias(main_aliases, inner);
                let allowed = array::concat([main_aliases, [inner], array::map(ex.path, fn(join) { join.source.alias })]);
                let filter_ok = match ex.filter {
                    Some(expr) => expr_valid(expr, allowed),
                    None => True,
                };
                let group_ok = array::all(ex.grouping, fn(expr) { expr_valid(expr, allowed) });
                let having_ok = array::all(ex.having, fn(h) {
                    let measure_ok = match h.measure {
                        HavingMeasure::Ref(_) => False,
                        HavingMeasure::Call(call) => expr_valid(call.arg, allowed)
                            && (match call.filter {
                                Some(expr) => expr_valid(expr, allowed),
                                None => True,
                            }),
                    };
                    measure_ok && match h.threshold {
                        Expr::AllocatedBind(binding) => binding.index > 0,
                        _ => False,
                    }
                });
                let body_ok = match ex.alternatives {
                    Some(alternatives) => {
                        let alt_ok_result = array::length(ex.pairs) == 0 && alternatives_ok(alternatives, inner, main_aliases);
                        id_ok && alt_ok_result && filter_ok && group_ok && having_ok
                    },
                    None => {
                        let pairs_ok = array::all(ex.pairs, fn(p) {
                            column_ref_id_ok(p.left)
                                && is_sql_identifier(p.right.source)
                                && is_sql_identifier(p.right.column)
                                && p.right.source == inner
                                && known_alias(main_aliases, p.left.source)
                        });
                        id_ok && array::length(ex.pairs) > 0 && pairs_ok && filter_ok && group_ok && having_ok
                    },
                };
                body_ok && (if array::length(ex.path) > 0 { path_structure_ok(ex, main_aliases) } else { True })
            },
        },
    }
};

def exists_list_ok: Fn(Array(Exists), Array(String)) -> Bool = fn(exists_list, aliases) {
    array::all(exists_list, fn(ex) { exists_structure_ok(ex, aliases) })
};

# A top-level HAVING predicate is well-formed when its measure is either a
# valid SQL identifier resolving to a projected aggregate/computed item
# (`HavingMeasure.Ref`) or a direct aggregate expression whose argument (and aggregate-local
# filter) is a valid Expr over the plan aliases (`HavingMeasure.Call`).
def having_measure_ok: Fn(Plan, HavingMeasure, Array(String)) -> Bool = fn(plan, measure, aliases) {
    match measure {
        HavingMeasure::Ref(ref) => is_sql_identifier(ref.alias) && match find_item_by_alias(plan, ref.alias) {
            Some(SelectItem::Aggregate(_)) => True,
            Some(SelectItem::Computed(_)) => True,
            _ => False,
        },
        HavingMeasure::Call(call) => expr_valid(call.arg, aliases)
            && (match call.filter {
                Some(expr) => expr_valid(expr, aliases),
                None => True,
            }),
    }
};

def having_ok: Fn(Plan, Array(String), Having) -> Bool = fn(plan, aliases, h) {
    having_measure_ok(plan, h.measure, aliases) && match h.threshold {
        Expr::AllocatedBind(binding) => binding.index > 0,
        _ => False,
    }
};

def page_value_ok: Fn(Expr, Bool) -> Bool = fn(expr, positive) {
    match expr {
        Expr::AllocatedBind(binding) => binding.index > 0,
        _ => False,
    }
};

def page_value_in_context: Fn(Expr, BuildCtx, Bool) -> Bool = fn(expr, ctx, positive) {
    match expr {
        Expr::AllocatedBind(binding) => if binding.index > 0
            && binding.index <= array::length(ctx.bindings) {
            match ctx.bindings[binding.index - 1] {
                Val::Int(value) => if positive { value > 0 && value <= max_partition_take }
                    else { value >= 0 },
                _ => False,
            }
        } else { False },
        _ => page_value_ok(expr, positive),
    }
};

def pagination_in_context: Fn(Plan, BuildCtx) -> Plan = fn(plan, ctx) {
    let limit_ok = match plan.limit {
        Some(value) => page_value_in_context(value, ctx, False), None => True,
    };
    let offset_ok = match plan.offset {
        Some(value) => page_value_in_context(value, ctx, False), None => True,
    };
    let take_ok = match plan.partition {
        Some(partition) => page_value_in_context(partition.take, ctx, True), None => True,
    };
    if limit_ok && offset_ok && take_ok { plan }
    else { fail!("constructed pagination binding must contain an integer within its allowed range", plan) }
};

def validate_contextual_pagination: Fn(QueryPlan, BuildCtx) -> QueryPlan = fn(query_plan, ctx) {
    match query_plan {
        QueryPlan::Rows(plan) => QueryPlan::Rows(pagination_in_context(plan, ctx)),
        QueryPlan::DistinctRows(plan) => QueryPlan::DistinctRows(pagination_in_context(plan, ctx)),
        QueryPlan::GroupCount(plan) => QueryPlan::GroupCount(pagination_in_context(plan, ctx)),
        QueryPlan::SetRows(set) => QueryPlan::SetRows({...set,
            left: pagination_in_context(set.left, ctx), right: pagination_in_context(set.right, ctx)}),
        QueryPlan::SetCount(set) => QueryPlan::SetCount({...set,
            left: pagination_in_context(set.left, ctx), right: pagination_in_context(set.right, ctx)}),
        QueryPlan::JoinedGroups(joined) => QueryPlan::JoinedGroups({...joined,
            left: pagination_in_context(joined.left, ctx), right: pagination_in_context(joined.right, ctx)}),
        QueryPlan::JoinedGroupCount(joined) => QueryPlan::JoinedGroupCount({...joined,
            left: pagination_in_context(joined.left, ctx), right: pagination_in_context(joined.right, ctx)}),
    }
};

def having_list_ok: Fn(Plan, Array(String), Array(Having)) -> Bool = fn(plan, aliases, having_list) {
    array::all(having_list, fn(h) { having_ok(plan, aliases, h) })
};

# ---------------------------------------------------------------------------
# Derived UNION ALL relation validation.
# ---------------------------------------------------------------------------

# Every ColumnRef that names the derived alias must use one of the declared
# output columns; other aliases have no per-column schema in this vocabulary.
def expr_derived_cols_ok: Fn(Expr, String, Array(String)) -> Bool = fn(expr, alias, names) {
    match expr {
        Expr::Column(ref) => if ref.source == alias {
            array::any(names, fn(name) { name == ref.column })
        } else {
            True
        },
        Expr::AllocatedBind(_) => True,
        Expr::Scalar(call) => array::all(call.args, fn(arg) { expr_derived_cols_ok(arg, alias, names) }),
    }
};

def aggregate_call_derived_cols_ok: Fn(AggregateCall, String, Array(String)) -> Bool = fn(call, alias, names) {
    expr_derived_cols_ok(call.arg, alias, names)
        && (match call.filter {
            Some(expr) => expr_derived_cols_ok(expr, alias, names),
            None => True,
        })
};

def select_item_derived_cols_ok: Fn(SelectItem, String, Array(String)) -> Bool = fn(item, alias, names) {
    match item {
        SelectItem::Expr(expr) => expr_derived_cols_ok(expr, alias, names),
        SelectItem::NamedExpr(named) => expr_derived_cols_ok(named.expr, alias, names),
        SelectItem::Aggregate(call) => aggregate_call_derived_cols_ok(call, alias, names),
        SelectItem::Computed(_) => True,
    }
};

# The outer plan over a derived source may reference only the declared output
# columns; expressions are otherwise the same closed Expr vocabulary.
def derived_outer_cols_ok: Fn(Plan, String, Array(String)) -> Bool = fn(plan, alias, names) {
    let projection_ok = array::all(plan.projection, fn(item) {
        select_item_derived_cols_ok(item, alias, names)
    });
    let filter_ok = match plan.filter {
        Some(expr) => expr_derived_cols_ok(expr, alias, names),
        None => True,
    };
    let group_ok = array::all(plan.grouping, fn(expr) { expr_derived_cols_ok(expr, alias, names) });
    let order_ok = array::all(plan.ordering, fn(ob) {
        match ob.key {
            OrderKey::Expr(expr) => expr_derived_cols_ok(expr, alias, names),
            OrderKey::AggregateRef(_) => True,
            OrderKey::Aggregate(call) => aggregate_call_derived_cols_ok(call, alias, names),
        }
    });
    let partition_cols_ok = match plan.partition {
        Some(pt) => array::all(pt.partition_by, fn(expr) { expr_derived_cols_ok(expr, alias, names) })
            && array::all(pt.order_by, fn(ob) {
                match ob.key {
                    OrderKey::Expr(expr) => expr_derived_cols_ok(expr, alias, names),
                    OrderKey::AggregateRef(_) => True,
                    OrderKey::Aggregate(_) => True,
                }
            }),
        None => True,
    };
    let having_cols_ok = array::all(plan.having, fn(h) {
        match h.measure {
            HavingMeasure::Ref(_) => True,
            HavingMeasure::Call(call) => aggregate_call_derived_cols_ok(call, alias, names),
        }
    });
    projection_ok && filter_ok && group_ok && order_ok && partition_cols_ok && having_cols_ok
};

def names_of: Fn(Array(UnionBranch)) -> Array(String) = fn(branches) {
    if array::length(branches) > 0 {
        array::map(branches[0].outputs, fn(col) { col.name })
    } else {
        let empty: Array(String) = [];
        empty
    }
};

def branch_names_match: Fn(Array(UnionBranch), Array(String)) -> Bool = fn(branches, expected) {
    array::all(branches, fn(branch) {
        array::map(branch.outputs, fn(col) { col.name }) == expected
    })
};

def union_names_ok: Fn(Array(String)) -> Bool = fn(names) {
    array::all(names, is_sql_identifier)
        && array::all(array::enumerate(names), fn(pair) { count_in(names, pair.1) == 1 })
};

# A derived source is structurally well-formed when it has at least one branch,
# every branch projects the same non-empty, unique, legal output names in the
# same order, and every branch expression/filter is over that branch's own
# source alias only.
def derived_structure_ok: Fn(DerivedSource) -> Bool = fn(ds) {
    let base_ok = is_sql_identifier(ds.alias) && array::length(ds.branches) > 0;
    if !base_ok {
        False
    } else {
        let expected = names_of(ds.branches);
        let branches_ok = array::all(ds.branches, fn(branch) {
            let alias_ok = source_valid(branch.source)
                && branch.source.alias != ds.alias;
            let local: Array(String) = [branch.source.alias];
            let outputs_ok = array::length(branch.outputs) > 0
                && array::all(branch.outputs, fn(col) {
                    is_sql_identifier(col.name) && expr_valid(col.expr, local)
                });
            let filter_ok = match branch.filter {
                Some(expr) => expr_valid(expr, local),
                None => True,
            };
            alias_ok && outputs_ok && filter_ok
        });
        array::length(expected) > 0
            && union_names_ok(expected)
            && branch_names_match(ds.branches, expected)
            && branches_ok
    }
};

# Pure structural predicate over a plan whose FROM is a derived UNION ALL
# relation: no physical sources/joins/EXISTS, a valid derived source, and a
# valid outer plan over the derived alias's declared columns.
def derived_plan_ok: Fn(Plan, DerivedSource) -> Bool = fn(plan, ds) {
    let physical_empty = array::length(plan.sources) == 0
        && array::length(plan.joins) == 0
        && array::length(plan.exists) == 0;
    let aliases: Array(String) = [ds.alias];
    let names = names_of(ds.branches);
    let projection_nonempty = array::length(plan.projection) > 0;
    let projection_ok = array::all(plan.projection, fn(item) { select_item_valid(item, aliases) });
    let filter_ok = match plan.filter {
        Some(expr) => expr_valid(expr, aliases),
        None => True,
    };
    let grouping_ok = array::all(plan.grouping, fn(expr) { expr_valid(expr, aliases) });
    let measure_aliases = projected_measure_aliases(plan);
    let ordering_ok = array::all(plan.ordering, fn(ob) { order_key_valid(ob.key, aliases, measure_aliases) });
    let direct_order_agg = array::any(plan.ordering, fn(ob) {
        match ob.key {
            OrderKey::Aggregate(_) => True,
            OrderKey::Expr(_) => False,
            OrderKey::AggregateRef(_) => False,
        }
    });
    let order_agg_group_ok = if direct_order_agg {
        array::length(plan.grouping) > 0
    } else {
        True
    };
    let limit_ok = match plan.limit {
        Some(value) => page_value_ok(value, False),
        None => True,
    };
    let offset_ok = match plan.offset {
        Some(value) => page_value_ok(value, False),
        None => True,
    };
    let offset_ordering_ok = match plan.offset {
        Some(_) => array::length(plan.ordering) > 0,
        None => True,
    };
    let partition_ok = match plan.partition {
        Some(pt) => partition_structure_ok(plan, pt),
        None => True,
    };
    let measures_ok = measure_aliases_distinct(plan) && computed_items_ok(plan);
    let having_ok_result = having_list_ok(plan, aliases, plan.having);
    let scalar_cmp_ok = array::all(plan.scalar_comparisons, fn(cmp) {
        scalar_comparison_derived_valid(cmp, ds.alias, names)
    });
    let ranked_cmp_ok = array::all(plan.ranked_key_comparisons, fn(cmp) {
        ranked_comparison_derived_valid(cmp, ds.alias, names)
    });
    physical_empty && derived_structure_ok(ds)
        && projection_nonempty && projection_ok && filter_ok
        && grouping_ok && ordering_ok && order_agg_group_ok
        && limit_ok && offset_ok
        && offset_ordering_ok && partition_ok && measures_ok
        && having_ok_result
        && scalar_cmp_ok
        && ranked_cmp_ok
        && derived_outer_cols_ok(plan, ds.alias, names)
};

# Pure structural predicate: true when the plan is a well-formed Plan whose
# identifiers, scalar arities, source references, limit/offset and partitioned
# Top N stage are legal.
def structure_ok: Fn(Plan) -> Bool = fn(plan) {
    match plan.derived {
        Some(ds) => derived_plan_ok(plan, ds),
        None => structure_ok_tables(plan),
    }
};

def structure_ok_tables: Fn(Plan) -> Bool = fn(plan) {
    let sources_nonempty = array::length(plan.sources) > 0;
    let projection_nonempty = array::length(plan.projection) > 0;
    let source_ids_ok = array::all(plan.sources, fn(source) {
        source_valid(source)
    });
    let join_ids_ok = array::all(plan.joins, join_identifiers_valid);
    let aliases = aliases_of(plan);
    let join_conds_ok = joins_conditions_valid(plan.joins, array::map(plan.sources, fn(source) { source.alias }));
    let projection_ok = array::all(plan.projection, fn(item) { select_item_valid(item, aliases) });
    let filter_ok = match plan.filter {
        Some(expr) => expr_valid(expr, aliases),
        None => True,
    };
    let exists_ok = exists_list_ok(plan.exists, aliases);
    let grouping_ok = array::all(plan.grouping, fn(expr) { expr_valid(expr, aliases) });
    let having_ok_result = having_list_ok(plan, aliases, plan.having);
    let measure_aliases = projected_measure_aliases(plan);
    let ordering_ok = array::all(plan.ordering, fn(ob) { order_key_valid(ob.key, aliases, measure_aliases) });
    # A direct (unprojected) ordering aggregate orders each GROUP of a grouped
    # query, so the Plan must be grouped (otherwise ORDER BY count(...) over
    # ungrouped dimension columns is not a valid aggregate shape).
    let direct_order_agg = array::any(plan.ordering, fn(ob) {
        match ob.key {
            OrderKey::Aggregate(_) => True,
            OrderKey::Expr(_) => False,
            OrderKey::AggregateRef(_) => False,
        }
    });
    let order_agg_group_ok = if direct_order_agg {
        array::length(plan.grouping) > 0
    } else {
        True
    };
    let limit_ok = match plan.limit {
        Some(value) => page_value_ok(value, False),
        None => True,
    };
    let offset_ok = match plan.offset {
        Some(value) => page_value_ok(value, False),
        None => True,
    };
    let offset_ordering_ok = match plan.offset {
        Some(_) => array::length(plan.ordering) > 0,
        None => True,
    };
    let partition_ok = match plan.partition {
        Some(pt) => partition_structure_ok(plan, pt),
        None => True,
    };
    let measures_ok = measure_aliases_distinct(plan) && computed_items_ok(plan);
    let scalar_cmp_ok = array::all(plan.scalar_comparisons, fn(cmp) { scalar_comparison_valid(cmp, aliases) });
    let ranked_cmp_ok = array::all(plan.ranked_key_comparisons, fn(cmp) { ranked_comparison_valid(cmp, aliases) });
    sources_nonempty && projection_nonempty && source_ids_ok && join_ids_ok
        && join_conds_ok && projection_ok && filter_ok && exists_ok
        && grouping_ok && having_ok_result && ordering_ok && order_agg_group_ok
        && limit_ok && offset_ok && offset_ordering_ok && partition_ok && measures_ok
        && scalar_cmp_ok
        && ranked_cmp_ok
};

# A scalar-subquery payload is well-formed only when its inner relation is
# structurally valid: source/join identifiers are legal, the aggregate call (its
# argument and optional aggregate-local filter) and the optional row filter are
# closed Exprs over the subquery's OWN private aliases (source alias plus join
# aliases), and every join condition is a valid equality/And/Or tree over those
# aliases.  The payload is deliberately flat: one scalar aggregate over one inner
# relation with no grouping/order/limit/offset/partition, so the subquery always
# yields exactly one scalar row.  Profile narrowing of the aggregate function,
# scalar functions, join kinds and distinct flag is enforced recursively by
# `scalar_subquery_profiles_ok`, never by bypassing the capability checks.
def scalar_subquery_inner_ok: Fn(ScalarSubquery) -> Bool = fn(sq) {
    let main_alias = sq.source.alias;
    let joins_local: Array(Join) = sq.joins;
    let join_aliases: Array(String) = array::map(joins_local, fn(join_item) { join_item.source.alias });
    let main_names: Array(String) = [main_alias];
    let inner_aliases = array::concat([main_names, join_aliases]);
    let source_id_ok = source_valid(sq.source);
    let join_ids_ok = array::all(joins_local, join_identifiers_valid);
    let join_shape_ok = array::all(joins_local, fn(join_item) { join_on_shape_ok(join_item.condition) });
    let join_conds_ok = joins_conditions_valid(joins_local, main_names);
    let agg_arg_ok = expr_valid(sq.arg, inner_aliases);
    let agg_filter_ok = match sq.agg_filter {
        Some(expr) => expr_valid(expr, inner_aliases),
        None => True,
    };
    let row_filter_ok = match sq.filter {
        Some(expr) => expr_valid(expr, inner_aliases),
        None => True,
    };
    source_id_ok && join_ids_ok && join_shape_ok && join_conds_ok
        && agg_arg_ok && agg_filter_ok && row_filter_ok
};

# The closed comparison operators of a scalar aggregate comparison predicate
# (SQL-native NULL semantics; boolean/logical scalar functions are not allowed).
def scalar_comparison_op_ok: Fn(ScalarFunction) -> Bool = fn(op) {
    match op {
        ScalarFunction::Eq => True,
        ScalarFunction::Ne => True,
        ScalarFunction::Lt => True,
        ScalarFunction::Le => True,
        ScalarFunction::Gt => True,
        ScalarFunction::Ge => True,
        _ => False,
    }
};

# A scalar aggregate comparison is well-formed when the outer ColumnRef is a
# legal identifier that names one of the outer plan's visible aliases, `op` is
# a closed comparison operator, and the inner side is a structurally valid
# scalar-subquery payload.
def scalar_comparison_valid: Fn(ScalarAggregateComparison, Array(String)) -> Bool = fn(cmp, main_aliases) {
    let outer_ok = column_ref_id_ok(cmp.outer) && known_alias(main_aliases, cmp.outer.source);
    outer_ok && scalar_comparison_op_ok(cmp.op) && scalar_subquery_inner_ok(cmp.inner)
};

# Derived-source variant: the outer ColumnRef must reference the derived alias's
# declared output columns (see `expr_derived_cols_ok`); the inner side is
# otherwise validated exactly like the table case.
def scalar_comparison_derived_valid: Fn(ScalarAggregateComparison, String, Array(String)) -> Bool = fn(cmp, alias, names) {
    let outer_ok = column_ref_id_ok(cmp.outer) && cmp.outer.source == alias
        && array::any(names, fn(name) { name == cmp.outer.column });
    outer_ok && scalar_comparison_op_ok(cmp.op) && scalar_subquery_inner_ok(cmp.inner)
};

# ---------------------------------------------------------------------------
# Ranked grouped-key scalar comparisons (separate typed spec).
# ---------------------------------------------------------------------------

# Structural validation of one grouped-key scalar subquery: legal source/join
# identifiers, private aliases (distinct from each other and never shadowing the
# outer plan), EXACTLY ONE grouping key expression, and every key / row filter /
# ordering-aggregate argument and aggregate-local filter is a closed Expr over
# the subquery's OWN private aliases.  The shape is deliberately closed: one
# projected/grouped key, one aggregate ordering expression, no HAVING, no
# offset/partition/set/nested scalar/raw SQL, and always LIMIT 1.
def ranked_inner_ok: Fn(RankedKeySubquery) -> Bool = fn(sq) {
    let main_alias = sq.source.alias;
    let join_aliases: Array(String) = array::map(sq.joins, fn(join_item) { join_item.source.alias });
    let no_self_dup = !array::any(join_aliases, fn(a) { a == main_alias });
    let joins_distinct = array::all(array::enumerate(join_aliases), fn(pair) {
        count_in(join_aliases, pair.1) == 1
    });
    let inner_aliases = array::concat([[main_alias], join_aliases]);
    let source_id_ok = source_valid(sq.source);
    let join_ids_ok = array::all(sq.joins, join_identifiers_valid);
    let join_shape_ok = array::all(sq.joins, fn(join_item) { join_on_shape_ok(join_item.condition) });
    let join_conds_ok = joins_conditions_valid(sq.joins, [main_alias]);
    let keys_single = array::length(sq.keys) == 1;
    let key_ok = keys_single && (match array::get(sq.keys, 0) {
        Some(key) => expr_valid(key, inner_aliases),
        None => False,
    });
    let order_arg_ok = expr_valid(sq.order.arg, inner_aliases);
    let order_filter_ok = match sq.order.filter {
        Some(expr) => expr_valid(expr, inner_aliases),
        None => True,
    };
    let row_filter_ok = match sq.filter {
        Some(expr) => expr_valid(expr, inner_aliases),
        None => True,
    };
    source_id_ok && join_ids_ok && join_shape_ok && join_conds_ok
        && no_self_dup && joins_distinct && key_ok
        && order_arg_ok && order_filter_ok && row_filter_ok
};

# A ranked grouped-key comparison is well-formed when the outer ColumnRef names a
# visible outer main alias, `op` is a closed comparison operator, and the inner
# grouped-key subquery is structurally valid.
def ranked_comparison_valid: Fn(RankedKeyComparison, Array(String)) -> Bool = fn(cmp, main_aliases) {
    let outer_ok = column_ref_id_ok(cmp.outer) && known_alias(main_aliases, cmp.outer.source);
    outer_ok && scalar_comparison_op_ok(cmp.op) && ranked_inner_ok(cmp.inner)
};

# Derived-source variant: the outer ColumnRef must reference the derived alias's
# declared output columns; the inner grouped-key subquery is otherwise validated
# exactly like the table case.
def ranked_comparison_derived_valid: Fn(RankedKeyComparison, String, Array(String)) -> Bool = fn(cmp, alias, names) {
    let outer_ok = column_ref_id_ok(cmp.outer) && cmp.outer.source == alias
        && array::any(names, fn(name) { name == cmp.outer.column });
    outer_ok && scalar_comparison_op_ok(cmp.op) && ranked_inner_ok(cmp.inner)
};

# The scalar-subquery payloads that appear directly in an expression tree.
def expr_subqueries: Fn(Expr) -> Array(ScalarSubquery) = fn(expr) {
    match expr {
        Expr::Scalar(call) => array::concat(array::map(call.args, expr_subqueries)),
        Expr::Column(_) => {
            let empty: Array(ScalarSubquery) = [];
            empty
        },
        Expr::AllocatedBind(_) => [],
    }
};

def aggregate_call_subqueries: Fn(AggregateCall) -> Array(ScalarSubquery) = fn(call) {
    let base = expr_subqueries(call.arg);
    match call.filter {
        Some(expr) => array::concat([base, expr_subqueries(expr)]),
        None => base,
    }
};

def select_item_subqueries: Fn(SelectItem) -> Array(ScalarSubquery) = fn(item) {
    match item {
        SelectItem::Expr(expr) => expr_subqueries(expr),
        SelectItem::NamedExpr(named) => expr_subqueries(named.expr),
        SelectItem::Aggregate(call) => aggregate_call_subqueries(call),
        SelectItem::Computed(_) => {
            let empty: Array(ScalarSubquery) = [];
            empty
        },
    }
};

def order_key_subqueries: Fn(OrderKey) -> Array(ScalarSubquery) = fn(key) {
    match key {
        OrderKey::Expr(expr) => expr_subqueries(expr),
        OrderKey::Aggregate(call) => aggregate_call_subqueries(call),
        OrderKey::AggregateRef(_) => {
            let empty: Array(ScalarSubquery) = [];
            empty
        },
    }
};

def having_subqueries: Fn(Array(Having)) -> Array(ScalarSubquery) = fn(having_list) {
    let empty: Array(ScalarSubquery) = [];
    array::fold(having_list, empty, fn(acc, h) {
        match h.measure {
            HavingMeasure::Ref(_) => acc,
            HavingMeasure::Call(call) => array::concat([acc, aggregate_call_subqueries(call)]),
        }
    })
};

# Every scalar-subquery payload that appears anywhere in a Plan's own
# expressions.
def plan_subqueries: Fn(Plan) -> Array(ScalarSubquery) = fn(plan) {
    let projection_parts = array::concat(array::map(plan.projection, select_item_subqueries));
    let filter_parts = match plan.filter {
        Some(expr) => expr_subqueries(expr),
        None => {
            let empty: Array(ScalarSubquery) = [];
            empty
        },
    };
    let exists_parts = array::concat(array::map(plan.exists, fn(ex) {
        match ex.peer {
            Some(corr) => {
                let origin = match corr.origin_filter {
                    Some(expr) => expr_subqueries(expr),
                    None => {
                        let empty: Array(ScalarSubquery) = [];
                        empty
                    },
                };
                let peer = match corr.peer_filter {
                    Some(expr) => expr_subqueries(expr),
                    None => {
                        let empty: Array(ScalarSubquery) = [];
                        empty
                    },
                };
                array::concat([origin, peer])
            },
            None => match ex.link {
                Some(link) => match link.filter {
                    Some(expr) => expr_subqueries(expr),
                    None => {
                        let empty: Array(ScalarSubquery) = [];
                        empty
                    },
                },
                None => {
                    let filter = match ex.filter {
                        Some(expr) => expr_subqueries(expr),
                        None => {
                            let empty: Array(ScalarSubquery) = [];
                            empty
                        },
                    };
                    let group = array::concat(array::map(ex.grouping, expr_subqueries));
                    array::concat([filter, array::concat([group, having_subqueries(ex.having)])])
                },
            },
        }
    }));
    let group_parts = array::concat(array::map(plan.grouping, expr_subqueries));
    let having_parts = having_subqueries(plan.having);
    let order_parts = array::concat(array::map(plan.ordering, fn(ob) { order_key_subqueries(ob.key) }));
    let partition_parts = match plan.partition {
        Some(pt) => array::concat([
            array::concat(array::map(pt.partition_by, expr_subqueries)),
            array::concat(array::map(pt.order_by, fn(ob) { order_key_subqueries(ob.key) })),
        ]),
        None => {
            let empty: Array(ScalarSubquery) = [];
            empty
        },
    };
    let derived_parts = match plan.derived {
        Some(ds) => array::concat(array::map(ds.branches, fn(branch) {
            let outputs = array::concat(array::map(branch.outputs, fn(col) { expr_subqueries(col.expr) }));
            let filter = match branch.filter {
                Some(expr) => expr_subqueries(expr),
                None => {
                    let empty: Array(ScalarSubquery) = [];
                    empty
                },
            };
            array::concat([outputs, filter])
        })),
        None => {
            let empty: Array(ScalarSubquery) = [];
            empty
        },
    };
    let comparison_parts = array::concat(array::map(plan.scalar_comparisons, fn(cmp) { [cmp.inner] }));
    array::concat([projection_parts, filter_parts, exists_parts, group_parts, having_parts, order_parts, partition_parts, derived_parts, comparison_parts])
};

# Recursive profile enforcement: every scalar-subquery payload inside the Plan
# is narrowed by the SAME profile that narrows the outer plan.  Each inner
# aggregate function must be allowed, its distinct flag must respect
# `allow_distinct`, every inner join kind must be allowed, and every scalar
# function used by the aggregate argument / aggregate-local filter / row filter
# must be allowed.  The inner row filter narrows that aggregate's input rows
# (the `Filter` operator usage is collected through `expr_operators`).
def scalar_subquery_profiles_ok: Fn(Plan, PlanProfile) -> Bool = fn(plan, profile) {
    let subqueries = plan_subqueries(plan);
    array::all(subqueries, fn(sq) {
        let agg_function_ok = array::any(profile.allowed_aggregates, fn(a) { a == sq.function });
        let distinct_ok = if profile.allow_distinct {
            True
        } else {
            sq.distinct == False
        };
        let join_kinds_ok = array::all(sq.joins, fn(join_item) {
            array::any(profile.allowed_join_kinds, fn(kind) { kind == join_item.kind })
        });
        let agg_scalars_ok = expr_scalars_ok(sq.arg, profile.allowed_scalars)
            && (match sq.agg_filter {
                Some(expr) => expr_scalars_ok(expr, profile.allowed_scalars),
                None => True,
            });
        let row_scalars_ok = match sq.filter {
            Some(expr) => expr_scalars_ok(expr, profile.allowed_scalars),
            None => True,
        };
        agg_function_ok && distinct_ok && join_kinds_ok && agg_scalars_ok && row_scalars_ok
            && source_scalars_ok(sq.source, profile.allowed_scalars)
            && array::all(sq.joins, fn(join_item) {
                source_scalars_ok(join_item.source, profile.allowed_scalars)
                    && join_condition_scalars_ok(join_item.condition, profile.allowed_scalars)
            })
    })
};

# Recursive profile enforcement for ranked grouped-key comparisons: the inner
# ordering aggregate function must be allowed, its distinct flag must respect
# `allow_distinct`, every inner join kind must be allowed, and every scalar used
# by the grouping key / ordering-aggregate argument / aggregate-local filter /
# row filter must be allowed.  The operator vocabulary (Source/Column/Aggregate/
# Group/Order/Filter/Join/Scalar/Bind) is collected through `operators`.
def ranked_subquery_profiles_ok: Fn(Plan, PlanProfile) -> Bool = fn(plan, profile) {
    array::all(plan.ranked_key_comparisons, fn(cmp) {
        let sq = cmp.inner;
        let keys_scalars_ok = array::all(sq.keys, fn(key) { expr_scalars_ok(key, profile.allowed_scalars) });
        let agg_function_ok = array::any(profile.allowed_aggregates, fn(a) { a == sq.order.function });
        let distinct_ok = if profile.allow_distinct {
            True
        } else {
            sq.order.distinct == False
        };
        let join_kinds_ok = array::all(sq.joins, fn(join_item) {
            array::any(profile.allowed_join_kinds, fn(kind) { kind == join_item.kind })
        });
        let order_scalars_ok = expr_scalars_ok(sq.order.arg, profile.allowed_scalars)
            && (match sq.order.filter {
                Some(expr) => expr_scalars_ok(expr, profile.allowed_scalars),
                None => True,
            });
        let row_scalars_ok = match sq.filter {
            Some(expr) => expr_scalars_ok(expr, profile.allowed_scalars),
            None => True,
        };
        keys_scalars_ok && agg_function_ok && distinct_ok && join_kinds_ok
            && order_scalars_ok && row_scalars_ok
            && source_scalars_ok(sq.source, profile.allowed_scalars)
            && array::all(sq.joins, fn(join_item) {
                source_scalars_ok(join_item.source, profile.allowed_scalars)
                    && join_condition_scalars_ok(join_item.condition, profile.allowed_scalars)
            })
    })
};

# Failing structural validation for a plan over physical table sources.
def validate_structure_tables: Fn(Plan) -> Plan = fn(plan) {
    if array::length(plan.sources) == 0 {
        fail!("plan must declare at least one source", plan)
    } else if array::length(plan.projection) == 0 {
        fail!("plan must declare a non-empty projection", plan)
    } else if !array::all(plan.sources, source_valid) {
        fail!("plan declares an invalid source identifier", plan)
    } else if !array::all(plan.joins, join_identifiers_valid) {
        fail!("plan declares an invalid join identifier", plan)
    } else if !array::all(plan.joins, fn(join) { join_on_shape_ok(join.condition) }) {
        fail!("plan join condition must combine at least one equality", plan)
    } else if !joins_conditions_valid(plan.joins, array::map(plan.sources, fn(source) { source.alias })) {
        fail!("plan join condition references a source not yet joined", plan)
    } else if !array::all(plan.projection, fn(item) { select_item_valid(item, aliases_of(plan)) }) {
        fail!("plan projection contains an invalid expression", plan)
    } else if !array::all(plan.internal_measures, fn(item) {
        (match item { SelectItem::Aggregate(_) => True, SelectItem::Computed(_) => True, _ => False })
            && select_item_valid(item, aliases_of(plan))
    }) {
        fail!("plan internal aggregate contains an invalid expression", plan)
    } else if !match plan.filter {
        Some(expr) => expr_valid(expr, aliases_of(plan)),
        None => True,
    } {
        fail!("plan filter contains an invalid expression", plan)
    } else if !exists_list_ok(plan.exists, aliases_of(plan)) {
        fail!("plan has an invalid correlated EXISTS filter", plan)
    } else if !array::all(plan.grouping, fn(expr) { expr_valid(expr, aliases_of(plan)) }) {
        fail!("plan grouping contains an invalid expression", plan)
    } else if !having_list_ok(plan, aliases_of(plan), plan.having) {
        fail!("plan HAVING references an unprojected or unknown aggregate", plan)
    } else if !array::all(plan.ordering, fn(ob) { order_key_valid(ob.key, aliases_of(plan), projected_measure_aliases(plan)) }) {
        fail!("plan ordering contains an invalid or unprojected ordering target", plan)
    } else if !match plan.offset {
        Some(_) => array::length(plan.ordering) > 0,
        None => True,
    } {
        fail!("plan offset requires a stable ordering", plan.offset, plan.ordering)
    } else if !match plan.partition {
        Some(pt) => page_value_ok(pt.take, True),
        None => True,
    } {
        fail!("partition take must be a positive integer within the cap", plan)
    } else if !match plan.partition {
        Some(pt) => partition_structure_ok(plan, pt),
        None => True,
    } {
        fail!("partition key must be a selected grouping expression", plan)
    } else if !match plan.partition {
        Some(pt) => partition_structure_ok(plan, pt),
        None => True,
    } {
        fail!("partition ordering must be non-empty with selected targets", plan)
    } else if !match plan.partition {
        Some(pt) => array::all(plan.grouping, fn(group_expr) {
            if expr_member(pt.partition_by, group_expr) {
                True
            } else {
                array::any(pt.order_by, fn(ob) {
                    match ob.key {
                        OrderKey::Expr(expr) => expr == group_expr,
                        OrderKey::AggregateRef(_) => False,
                        OrderKey::Aggregate(_) => False,
                    }
                })
            }
        }),
        None => True,
    } {
        fail!("partition ordering must cover non-partition grouping expressions", plan)
    } else if !match plan.partition {
        Some(_) => plan.limit == None && plan.offset == None
            && array::length(plan.ordering) == 0,
        None => True,
    } {
        fail!("partitioned top N cannot be combined with global limit, offset or ordering", plan)
    } else if !array::all(plan.scalar_comparisons, fn(cmp) { scalar_comparison_valid(cmp, aliases_of(plan)) }) {
        fail!("plan has an invalid scalar aggregate comparison predicate", plan)
    } else if !array::all(plan.ranked_key_comparisons, fn(cmp) { ranked_comparison_valid(cmp, aliases_of(plan)) }) {
        fail!("plan has an invalid ranked grouped-key comparison predicate", plan)
    } else if !measure_aliases_distinct(plan) {
        fail!("projected aggregate and computed aggregate aliases must be distinct", plan)
    } else if !computed_items_ok(plan) {
        fail!("computed aggregate has an unknown operand, an unresolved alias or a dependency cycle", plan)
    } else if !internal_measures_used(plan) {
        fail!("internal measure must be referenced by a projected computed measure", plan)
    } else {
        plan
    }
};

# Failing structural validation: rejects illegal structure, invalid
# identifiers, unknown source references, bad scalar arities and negative
# limits with a Host diagnostic.  Never publishes a partial Query.
def validate_structure: Fn(Plan) -> Plan = fn(plan) {
    match plan.derived {
        Some(ds) => {
            if array::length(plan.sources) > 0
                || array::length(plan.joins) > 0
                || array::length(plan.exists) > 0
                || array::length(plan.internal_measures) > 0 {
                fail!("a derived source plan cannot also declare physical sources, joins, EXISTS or internal measures", plan)
            } else if !derived_structure_ok(ds) {
                fail!("plan declares an invalid derived UNION ALL relation", plan)
            } else if !derived_plan_ok(plan, ds) {
                fail!("outer plan over the derived source references unknown columns or invalid expressions", plan)
            } else {
                plan
            }
        },
        None => validate_structure_tables(plan),
    }
};

# ---------------------------------------------------------------------------
# Profile validation.
# ---------------------------------------------------------------------------

def operator_allowed: Fn(Operator, Array(Operator)) -> Bool = fn(op, allowed) {
    array::any(allowed, fn(candidate) { candidate == op })
};

def expr_scalars_ok: Fn(Expr, Array(ScalarFunction)) -> Bool = fn(expr, allowed) {
    match expr {
        Expr::Column(_) => True,
        Expr::AllocatedBind(_) => True,
        Expr::Scalar(call) => {
            let self_ok = array::any(allowed, fn(candidate) { candidate == call.function });
            self_ok && array::all(call.args, fn(arg) { expr_scalars_ok(arg, allowed) })
        },
    }
};

def source_scalars_ok: Fn(Source, Array(ScalarFunction)) -> Bool = fn(source_item, allowed) {
    match source_item.scope {
        Some(expr) => expr_scalars_ok(expr, allowed),
        None => True,
    }
};

def join_condition_scalars_ok: Fn(JoinCondition, Array(ScalarFunction)) -> Bool = fn(condition, allowed) {
    match condition {
        JoinCondition::Eq(_) => True,
        JoinCondition::Predicate(expr) => expr_scalars_ok(expr, allowed),
        JoinCondition::Exists(ex) => exists_body_scalars_ok(ex, allowed),
        JoinCondition::And(items) => array::all(items, fn(item) { join_condition_scalars_ok(item, allowed) }),
        JoinCondition::Or(items) => array::all(items, fn(item) { join_condition_scalars_ok(item, allowed) }),
    }
};

def source_profile_accepts: Fn(Source, PlanProfile) -> Bool = fn(source_item, profile) {
    source_valid(source_item)
        && array::all(source_operators(source_item), fn(op) { operator_allowed(op, profile.allowed_operators) })
        && source_scalars_ok(source_item, profile.allowed_scalars)
};

def select_scalars_ok: Fn(SelectItem, Array(ScalarFunction)) -> Bool = fn(item, allowed) {
    match item {
        SelectItem::Expr(expr) => expr_scalars_ok(expr, allowed),
        SelectItem::NamedExpr(named) => expr_scalars_ok(named.expr, allowed),
        SelectItem::Aggregate(call) => expr_scalars_ok(call.arg, allowed)
            && (match call.filter {
                Some(expr) => expr_scalars_ok(expr, allowed),
                None => True,
            }),
        # A computed aggregate consumes the scalar capability corresponding to
        # its operator: `ComputedOp.Add` requires `ScalarFunction.Add` in the
        # allowed scalars, `ComputedOp.Sub` requires `ScalarFunction.Sub`.
        SelectItem::Computed(ca) => {
            let op_allowed = match ca.op {
                ComputedOp::Add => array::any(allowed, fn(candidate) { candidate == ScalarFunction::Add }),
                ComputedOp::Sub => array::any(allowed, fn(candidate) { candidate == ScalarFunction::Sub }),
            };
            op_allowed
        },
    }
};

# An AggregateRef ordering key adds no new scalar usage: the referenced
# aggregate or computed aggregate already appears in the projection and is
# checked there.
def order_key_scalars_ok: Fn(OrderKey, Array(ScalarFunction)) -> Bool = fn(key, allowed) {
    match key {
        OrderKey::Expr(expr) => expr_scalars_ok(expr, allowed),
        OrderKey::AggregateRef(_) => True,
        OrderKey::Aggregate(call) => aggregate_call_scalars_ok(call, allowed),
    }
};

def select_aggregate_ok: Fn(SelectItem, Array(AggregateFunction)) -> Bool = fn(item, allowed) {
    match item {
        SelectItem::Expr(_) => True,
        SelectItem::NamedExpr(_) => True,
        SelectItem::Aggregate(call) => array::any(allowed, fn(candidate) { candidate == call.function }),
        SelectItem::Computed(_) => True,
    }
};

def aggregate_call_scalars_ok: Fn(AggregateCall, Array(ScalarFunction)) -> Bool = fn(call, allowed) {
    expr_scalars_ok(call.arg, allowed)
        && (match call.filter {
            Some(expr) => expr_scalars_ok(expr, allowed),
            None => True,
        })
};

def aggregate_profile_accepts: Fn(AggregateCall, PlanProfile) -> Bool = fn(call, profile) {
    array::any(profile.allowed_aggregates, fn(function) { function == call.function })
        && (!call.distinct || profile.allow_distinct)
        && array::all(aggregate_operators(call), fn(op) { operator_allowed(op, profile.allowed_operators) })
        && aggregate_call_scalars_ok(call, profile.allowed_scalars)
};

def predicate_profile_accepts: Fn(Expr, PlanProfile) -> Bool = fn(expr, profile) {
    operator_allowed(Operator::Filter, profile.allowed_operators)
        && array::all(expr_operators(expr), fn(op) { operator_allowed(op, profile.allowed_operators) })
        && expr_scalars_ok(expr, profile.allowed_scalars)
};

def having_measure_scalars_ok: Fn(HavingMeasure, Array(ScalarFunction)) -> Bool = fn(measure, allowed) {
    match measure {
        HavingMeasure::Ref(_) => True,
        HavingMeasure::Call(call) => aggregate_call_scalars_ok(call, allowed),
    }
};

def having_list_scalars_ok: Fn(Array(Having), Array(ScalarFunction)) -> Bool = fn(having_list, allowed) {
    array::all(having_list, fn(h) { having_measure_scalars_ok(h.measure, allowed) })
};

# A `HavingMeasure.Call` having measure is a direct aggregate expression, so the aggregate
# function itself must be in the profile; a `HavingMeasure.Ref` measure is checked through
# its projected projection item.
def having_measure_aggregate_ok: Fn(HavingMeasure, Array(AggregateFunction)) -> Bool = fn(measure, allowed) {
    match measure {
        HavingMeasure::Ref(_) => True,
        HavingMeasure::Call(call) => array::any(allowed, fn(candidate) { candidate == call.function }),
    }
};

def having_list_aggregates_ok: Fn(Array(Having), Array(AggregateFunction)) -> Bool = fn(having_list, allowed) {
    array::all(having_list, fn(h) { having_measure_aggregate_ok(h.measure, allowed) })
};

def having_measure_distinct_ok: Fn(HavingMeasure) -> Bool = fn(measure) {
    match measure {
        HavingMeasure::Ref(_) => True,
        HavingMeasure::Call(call) => call.distinct == False,
    }
};

# Scalar/profile recursion into one paired-endpoint body: origin/peer filters
# are narrowed by the same profile that narrows the outer query.
def peer_corr_scalars_ok: Fn(PeerCorr, Array(ScalarFunction)) -> Bool = fn(corr, allowed) {
    let origin_ok = match corr.origin_filter {
        Some(expr) => expr_scalars_ok(expr, allowed),
        None => True,
    };
    let peer_ok = match corr.peer_filter {
        Some(expr) => expr_scalars_ok(expr, allowed),
        None => True,
    };
    origin_ok && peer_ok && source_scalars_ok(corr.origin, allowed) && source_scalars_ok(corr.peer, allowed)
};

# Scalar/profile recursion into one correlated EXISTS aggregate body: the inner
# filter, grouping expressions and every HAVING measure are narrowed by the
# same profile that narrows the outer query.
def exists_body_scalars_ok: Fn(Exists, Array(ScalarFunction)) -> Bool = fn(ex, allowed) {
    match ex.peer {
        Some(corr) => peer_corr_scalars_ok(corr, allowed),
        None => match ex.link {
            Some(link) => source_scalars_ok(ex.source, allowed)
                && source_scalars_ok(link.source, allowed)
                && (match link.tail {
                    Some(tail) => source_scalars_ok(tail.source, allowed),
                    None => True,
                })
                && (match link.filter {
                    Some(expr) => expr_scalars_ok(expr, allowed),
                    None => True,
                }),
            None => do {
                let filter_ok = match ex.filter {
                    Some(expr) => expr_scalars_ok(expr, allowed),
                    None => True,
                };
                let group_ok = array::all(ex.grouping, fn(expr) { expr_scalars_ok(expr, allowed) });
                filter_ok && group_ok && having_list_scalars_ok(ex.having, allowed)
                    && source_scalars_ok(ex.source, allowed)
                    && array::all(ex.path, fn(join) {
                        source_scalars_ok(join.source, allowed)
                    })
            },
        },
    }
};

def exists_body_aggregates_ok: Fn(Exists, Array(AggregateFunction)) -> Bool = fn(ex, allowed) {
    match ex.peer {
        Some(_) => True,
        None => match ex.link {
            Some(_) => True,
            None => array::all(ex.having, fn(h) { having_measure_aggregate_ok(h.measure, allowed) }),
        },
    }
};

def exists_body_distinct_ok: Fn(Exists) -> Bool = fn(ex) {
    match ex.peer {
        Some(_) => True,
        None => match ex.link {
            Some(_) => True,
            None => array::all(ex.having, fn(h) { having_measure_distinct_ok(h.measure) }),
        },
    }
};

def join_condition_exists_profile_ok: Fn(JoinCondition, PlanProfile) -> Bool = fn(condition, profile) {
    match condition {
        JoinCondition::Exists(ex) => exists_body_aggregates_ok(ex, profile.allowed_aggregates)
            && (profile.allow_distinct || exists_body_distinct_ok(ex)),
        JoinCondition::And(items) => array::all(items, fn(item) { join_condition_exists_profile_ok(item, profile) }),
        JoinCondition::Or(items) => array::all(items, fn(item) { join_condition_exists_profile_ok(item, profile) }),
        _ => True,
    }
};

# Scalar recursion into one UNION ALL branch: its output expressions and row
# filter are narrowed by the same profile as the outer plan.
def union_branch_scalars_ok: Fn(UnionBranch, Array(ScalarFunction)) -> Bool = fn(branch, allowed) {
    let output_ok = array::all(branch.outputs, fn(col) { expr_scalars_ok(col.expr, allowed) });
    let filter_ok = match branch.filter {
        Some(expr) => expr_scalars_ok(expr, allowed),
        None => True,
    };
    output_ok && filter_ok && source_scalars_ok(branch.source, allowed)
};

def derived_branches_scalars_ok: Fn(DerivedSource, Array(ScalarFunction)) -> Bool = fn(ds, allowed) {
    array::all(ds.branches, fn(branch) { union_branch_scalars_ok(branch, allowed) })
};

# Pure capability check: true exactly when every operator and refined
# capability used by the plan is accepted by the profile.  The profile is a
# capability declaration; it never changes operator semantics.
def profile_accepts: Fn(Plan, PlanProfile) -> Bool = fn(plan, profile) {
    let used = operators(plan);
    let ops_ok = array::all(used, fn(op) { operator_allowed(op, profile.allowed_operators) });
    let joins_ok = array::all(plan.joins, fn(join) {
        array::any(profile.allowed_join_kinds, fn(kind) { kind == join.kind })
    });
    let aggregates_ok = array::all(plan.projection, fn(item) { select_aggregate_ok(item, profile.allowed_aggregates) })
        && array::all(plan.internal_measures, fn(item) { select_aggregate_ok(item, profile.allowed_aggregates) })
        && having_list_aggregates_ok(plan.having, profile.allowed_aggregates)
        && array::all(plan.exists, fn(ex) { exists_body_aggregates_ok(ex, profile.allowed_aggregates) })
        && array::all(plan.ordering, fn(ob) {
            match ob.key {
                OrderKey::Aggregate(call) => array::any(profile.allowed_aggregates, fn(a) { a == call.function }),
                OrderKey::Expr(_) => True,
                OrderKey::AggregateRef(_) => True,
            }
        });
    let scalars_ok = array::all(plan.sources, fn(source_item) { source_scalars_ok(source_item, profile.allowed_scalars) })
        && array::all(plan.joins, fn(join_item) {
            source_scalars_ok(join_item.source, profile.allowed_scalars)
                && join_condition_scalars_ok(join_item.condition, profile.allowed_scalars)
        })
        && array::all(plan.projection, fn(item) { select_scalars_ok(item, profile.allowed_scalars) })
        && array::all(plan.internal_measures, fn(item) { select_scalars_ok(item, profile.allowed_scalars) })
        && (match plan.filter {
            Some(expr) => expr_scalars_ok(expr, profile.allowed_scalars),
            None => True,
        })
        && (match plan.derived {
            Some(ds) => derived_branches_scalars_ok(ds, profile.allowed_scalars),
            None => True,
        })
        && array::all(plan.exists, fn(ex) { exists_body_scalars_ok(ex, profile.allowed_scalars) })
        && array::all(plan.grouping, fn(expr) { expr_scalars_ok(expr, profile.allowed_scalars) })
        && having_list_scalars_ok(plan.having, profile.allowed_scalars)
        && array::all(plan.ordering, fn(ob) { order_key_scalars_ok(ob.key, profile.allowed_scalars) });
    let distinct_ok = if profile.allow_distinct {
        True
    } else {
        array::all(plan.projection, fn(item) {
            match item {
                SelectItem::Expr(_) => True,
                SelectItem::NamedExpr(_) => True,
                SelectItem::Aggregate(call) => call.distinct == False,
                SelectItem::Computed(_) => True,
            }
        })
        && array::all(plan.internal_measures, fn(item) {
            match item {
                SelectItem::Aggregate(call) => !call.distinct,
                SelectItem::Computed(_) => True,
                _ => False,
            }
        })
        && array::all(plan.having, fn(h) { having_measure_distinct_ok(h.measure) })
        && array::all(plan.exists, fn(ex) { exists_body_distinct_ok(ex) })
        && array::all(plan.ordering, fn(ob) {
            match ob.key {
                OrderKey::Aggregate(call) => call.distinct == False,
                OrderKey::Expr(_) => True,
                OrderKey::AggregateRef(_) => True,
            }
        })
    };
    # `Operator.Partition` itself is covered by ops_ok via `operators(plan)`; here we
    # check the scalars used by the partition keys and partition ordering.
    let partition_ok = match plan.partition {
        Some(pt) => array::all(pt.partition_by, fn(expr) { expr_scalars_ok(expr, profile.allowed_scalars) })
            && array::all(pt.order_by, fn(ob) { order_key_scalars_ok(ob.key, profile.allowed_scalars) }),
        None => True,
    };
    ops_ok && joins_ok && aggregates_ok && scalars_ok && distinct_ok
        && array::all(plan.joins, fn(join) { join_condition_exists_profile_ok(join.condition, profile) })
        && partition_ok
        && scalar_subquery_profiles_ok(plan, profile)
        && ranked_subquery_profiles_ok(plan, profile)
};

# Failing profile validation: structural problems are rejected first, then any
# operator or refined capability outside the profile (including a distinct
# aggregate when `allow_distinct` is false) fails with a Host diagnostic.
def validate: Fn(Plan, PlanProfile) -> Plan = fn(plan, profile) {
    let structured = validate_structure(plan);
    if profile_accepts(structured, profile) {
        structured
    } else {
        fail!("plan uses capabilities not allowed by the profile", plan, profile)
    }
};

def aggregate_name: Fn(AggregateFunction) -> String = fn(function) {
    match function {
        AggregateFunction::Count => "count",
        AggregateFunction::Sum => "sum",
        AggregateFunction::Avg => "avg",
        AggregateFunction::Min => "min",
        AggregateFunction::Max => "max",
    }
};

# Pure, deterministic concretization of a legal Plan into a parameterized
# SQLite Query.  The same legal Plan always produces byte-identical SQL and
# same-order bindings.  Structurally illegal or SQLite-unrealizable plans fail
# with a Host diagnostic and never publish a partial Query.

def validate_distinct_plan: Fn(Plan) -> Plan = fn(plan) {
    let structured = validate_structure(plan);
    if structured.partition != None {
        fail!("distinct row lowering does not combine with partitioned top N", plan)
    } else if array::length(structured.grouping) > 0 {
        fail!("distinct row lowering requires an ungrouped row projection", plan)
    } else if array::length(structured.having) > 0 {
        fail!("distinct row lowering does not accept HAVING predicates", plan)
    } else if !array::all(structured.projection, fn(item) {
        match item {
            SelectItem::Expr(_) => True,
            SelectItem::NamedExpr(_) => True,
            SelectItem::Aggregate(_) => False,
            SelectItem::Computed(_) => False,
        }
    }) {
        fail!("distinct row lowering requires a projection of plain dimension expressions", plan)
    } else {
        let projected: Array(Expr) = array::map(structured.projection, fn(item) {
            match item {
                SelectItem::Expr(expr) => expr,
                SelectItem::NamedExpr(named) => named.expr,
                _ => fail!("distinct row projection is not expression-only", plan),
            }
        });
        let order_ok = array::all(structured.ordering, fn(ob) {
            match ob.key {
                OrderKey::Expr(expr) => expr_member(projected, expr),
                OrderKey::AggregateRef(_) => False,
                OrderKey::Aggregate(_) => False,
            }
        });
        if !order_ok {
            fail!("distinct row ordering must reference a projected dimension expression", plan)
        } else {
            structured
        }
    }
};

# DISTINCT is a plan shape, not a SQLite-specific permission.  All renderers
# receive the same validated ungrouped projection and projected ordering.

# ---------------------------------------------------------------------------
# Closed set operations (INTERSECT / EXCEPT / distinct UNION).
# ---------------------------------------------------------------------------

def set_op_sql: Fn(SetOpKind) -> String = fn(kind) {
    match kind {
        SetOpKind::Intersect => "INTERSECT",
        SetOpKind::Except => "EXCEPT",
        SetOpKind::Union => "UNION",
    }
};

# Coarse positional projection category used for the type/position compatibility
# guard of set operations: two operands must agree on every position's shape.
def set_item_category: Fn(SelectItem) -> String = fn(item) {
    match item {
        SelectItem::Expr(_) => "expr",
        SelectItem::NamedExpr(_) => "expr",
        SelectItem::Aggregate(_) => "agg",
        SelectItem::Computed(_) => "computed",
    }
};

def set_categories: Fn(Plan) -> Array(String) = fn(plan) {
    array::map(plan.projection, set_item_category)
};

# An operand is embeddable in a set operation only when it carries no local
# ordering/limit/offset/partition (shapes that would change meaning when
# embedded); grouping/HAVING stay inside the operand.
def set_operand_embeddable: Fn(Plan) -> Bool = fn(plan) {
    array::length(plan.ordering) == 0 && plan.limit == None && plan.offset == None
        && plan.partition == None
};

# Pure compatibility probe for set operands: both structurally valid, both
# embeddable, non-zero equal projection arity, and positionally compatible
# projection categories.  Never fails.
def set_ok: Fn(SetOpKind, Plan, Plan) -> Bool = fn(kind, left, right) {
    if !structure_ok(left) || !structure_ok(right) {
        False
    } else if !set_operand_embeddable(left) || !set_operand_embeddable(right) {
        False
    } else if array::length(left.projection) == 0 || array::length(right.projection) == 0 {
        False
    } else if array::length(left.projection) != array::length(right.projection) {
        False
    } else {
        set_categories(left) == set_categories(right)
    }
};

# Both operands of a set operation must be independently embeddable and have
# compatible positional projection shapes. Dialect renderers decide the SQL syntax.
def validate_set_operands: Fn(SetOpKind, Plan, Plan) -> (Plan, Plan) = fn(kind, left, right) {
    let left_structured = validate_structure(left);
    let right_structured = validate_structure(right);
    if !set_operand_embeddable(left_structured) || !set_operand_embeddable(right_structured) {
        fail!("set operation operand carries local ordering/limit/offset/partition that cannot be embedded", kind)
    } else if array::length(left_structured.projection) == 0
        || array::length(right_structured.projection) == 0 {
        fail!("set operation operands must have a non-zero projection", kind)
    } else if array::length(left_structured.projection) != array::length(right_structured.projection) {
        fail!("set operation operand projection arity mismatch", kind)
    } else if set_categories(left_structured) != set_categories(right_structured) {
        fail!("set operation operands have positionally incompatible projection shapes", kind)
    } else {
        (left_structured, right_structured)
    }
};

def validate_joined_groups: Fn(JoinedGroups) -> JoinedGroups = fn(joined) {
    let left = validate_structure(joined.left);
    let right = validate_structure(joined.right);
    let left_names = array::map(left.projection, fn(item) {
        match item {
            SelectItem::NamedExpr(named) => named.alias,
            SelectItem::Aggregate(call) => call.alias,
            SelectItem::Computed(computed) => computed.alias,
            _ => "",
        }
    });
    let right_names = array::map(right.projection, fn(item) {
        match item {
            SelectItem::NamedExpr(named) => named.alias,
            SelectItem::Aggregate(call) => call.alias,
            SelectItem::Computed(computed) => computed.alias,
            _ => "",
        }
    });
    let outputs = array::concat([joined.left_outputs, joined.right_outputs]);
    if array::length(joined.keys) == 0 || array::length(outputs) == 0
        || array::length(joined.keys) != array::length(left.grouping)
        || array::length(joined.keys) != array::length(right.grouping)
        || !set_operand_embeddable(left) || !set_operand_embeddable(right) {
        fail!("joined groups require grouped, embeddable operands, identity keys and visible outputs")
    } else if !array::all(array::enumerate(joined.keys), fn(entry) {
        let key = entry.1;
        is_sql_identifier(key)
            && count_in(left_names, key) == 1 && count_in(right_names, key) == 1
            && array::length(array::filter(joined.keys, fn(other) { other == key })) == 1
            && array::any(left.projection, fn(item) { match item {
                SelectItem::NamedExpr(named) => named.alias == key && named.expr == left.grouping[entry.0],
                _ => False,
            } })
            && array::any(right.projection, fn(item) { match item {
                SelectItem::NamedExpr(named) => named.alias == key && named.expr == right.grouping[entry.0],
                _ => False,
            } })
    }) { fail!("joined groups require uniquely projected grouping identity columns on both operands", joined.keys) }
    else if !array::all(outputs, fn(name) {
        is_sql_identifier(name)
            && array::length(array::filter(outputs, fn(other) { other == name })) == 1
            && !array::any(joined.keys, fn(key) { key == name })
    }) || !array::all(joined.left_outputs, fn(name) { count_in(left_names, name) == 1 })
        || !array::all(joined.right_outputs, fn(name) { count_in(right_names, name) == 1 }) {
        fail!("joined groups output must name unique projected non-key columns on its operand")
    } else { {...joined, left, right} }
};

def validate_query_plan: Fn(QueryPlan) -> QueryPlan = fn(query_plan) {
    match query_plan {
        QueryPlan::Rows(plan) => QueryPlan::Rows(validate_structure(plan)),
        QueryPlan::DistinctRows(plan) => QueryPlan::DistinctRows(validate_distinct_plan(plan)),
        QueryPlan::SetRows(set) => {
            let operands = validate_set_operands(set.kind, set.left, set.right);
            QueryPlan::SetRows({kind: set.kind, left: operands.0, right: operands.1})
        },
        QueryPlan::SetCount(set) => {
            let operands = validate_set_operands(set.kind, set.left, set.right);
            QueryPlan::SetCount({kind: set.kind, left: operands.0, right: operands.1})
        },
        QueryPlan::GroupCount(plan) => {
            let structured = validate_structure(plan);
            if array::length(structured.grouping) == 0 {
                fail!("group count requires grouped inner plan", plan)
            } else {
                QueryPlan::GroupCount(structured)
            }
        },
        QueryPlan::JoinedGroups(joined) => QueryPlan::JoinedGroups(validate_joined_groups(joined)),
        QueryPlan::JoinedGroupCount(joined) => QueryPlan::JoinedGroupCount(validate_joined_groups(joined)),
    }
};


# Outer count over the derived set: `SELECT count(1) FROM (<set>) AS __q_set`.
# The outer layer exposes exactly one count column and none of the operand
# columns; bindings are the concatenated operand bindings in order.

# Nested aggregate primitive (shape 1): count the rows produced by a grouped
# inner `plan` and return the count as a single row:
#   SELECT count(1) FROM (<plan>) AS __q_count
# The inner plan is validated structurally and against `profile` first, so the
# nested aggregate cannot bypass the operator/source/aggregate constraints.
# For the same Plan/PlanProfile the SQL and bindings are byte-identical.

# ---------------------------------------------------------------------------
# Constructor helpers.
# ---------------------------------------------------------------------------



# The inner scalar-aggregate specification of a scalar subquery / scalar
# aggregate comparison (one source, optional joins, optional row filter and the
# aggregate call; no grouping/order/limit/offset/partition are representable).
def scalar_subquery_spec: Fn(Source, Array(Join), Option(Expr), AggregateFunction, Expr, Bool, Option(Expr)) -> ScalarSubquery = fn(source_item, joins, row_filter, function, arg, distinct, agg_filter) {
    let sq: ScalarSubquery = {
        source: source_item,
        joins,
        filter: row_filter,
        function,
        arg,
        distinct,
        agg_filter,
    };
    sq
};

# A flat, non-recursive scalar aggregate spec renders as a parenthesized scalar
# subquery at a comparison's use site; it is never an Expr.


# One Plan-level scalar aggregate comparison predicate:
# `<outer.column> <op> <scalar aggregate subquery>`.
def scalar_aggregate_comparison: Fn(ColumnRef, ScalarFunction, ScalarSubquery) -> ScalarAggregateComparison = fn(outer, op, inner) {
    let cmp: ScalarAggregateComparison = {outer: outer, op: op, inner: inner};
    cmp
};

# The grouped-key scalar subquery specification: one source, optional joins,
# optional row filter, exactly-one grouping key array, the closed aggregate
# ordering call and the required direction.  No grouping multiplicity, HAVING,
# offset, partition, set operation, nested scalar subquery or raw SQL are
# representable; rendering always appends `LIMIT 1`.
def ranked_key_subquery_spec: Fn(Source, Array(Join), Option(Expr), Array(Expr), AggregateCall, Ordering) -> RankedKeySubquery = fn(source_item, joins, row_filter, keys, order, direction) {
    let sq: RankedKeySubquery = {
        source: source_item,
        joins: joins,
        filter: row_filter,
        keys: keys,
        order: order,
        direction: direction,
    };
    sq
};

# One Plan-level ranked grouped-key comparison predicate:
# `<outer.column> <op> <grouped-key scalar subquery>`.
def ranked_key_comparison: Fn(ColumnRef, ScalarFunction, RankedKeySubquery) -> RankedKeyComparison = fn(outer, op, inner) {
    let cmp: RankedKeyComparison = {outer: outer, op: op, inner: inner};
    cmp
};

def scalar: Fn(ScalarFunction, Array(Expr)) -> Expr = fn(function, args) {
    let call: ScalarCall = {function: function, args: args};
    Expr::Scalar(call)
};

def substr: Fn(Array(Expr)) -> Expr = fn(args) {
    let call: ScalarCall = {function: ScalarFunction::Substr, args: args};
    Expr::Scalar(call)
};

# 1-based position of the first occurrence of `needle` within `haystack`;
# 0 when the needle is absent (SQLite `instr`).
def instr: Fn(Expr, Expr) -> Expr = fn(haystack, needle) {
    let call: ScalarCall = {function: ScalarFunction::Instr, args: [haystack, needle]};
    Expr::Scalar(call)
};

# Conditional: `CASE WHEN cond THEN then_expr ELSE else_expr END`.
def scalar_if: Fn(Expr, Expr, Expr) -> Expr = fn(cond, then_expr, else_expr) {
    let call: ScalarCall = {function: ScalarFunction::If, args: [cond, then_expr, else_expr]};
    Expr::Scalar(call)
};

def add: Fn(Expr, Expr) -> Expr = fn(left, right) {
    let call: ScalarCall = {function: ScalarFunction::Add, args: [left, right]};
    Expr::Scalar(call)
};

def sub: Fn(Expr, Expr) -> Expr = fn(left, right) {
    let call: ScalarCall = {function: ScalarFunction::Sub, args: [left, right]};
    Expr::Scalar(call)
};

# Case normalizer: SQLite `lower(value)`.  In the default SQLite build it
# folds ASCII A-Z only; apply it to both sides for case-insensitive
# comparisons (e.g. `instr(lower(a), lower(?))`).
def lower: Fn(Expr) -> Expr = fn(value) {
    let call: ScalarCall = {function: ScalarFunction::Lower, args: [value]};
    Expr::Scalar(call)
};

# Text length: SQLite `length(value)` (characters for text).  It enables
# suffix arithmetic such as `substr(value, length(value) - length(?) + 1)`
# for an ends-with predicate.
def length: Fn(Expr) -> Expr = fn(value) {
    let call: ScalarCall = {function: ScalarFunction::Length, args: [value]};
    Expr::Scalar(call)
};


def expr_item: Fn(Expr) -> SelectItem = fn(expr) { SelectItem::Expr(expr) };

def named_expr_item: Fn(Expr, String) -> SelectItem = fn(expr, alias) {
    let item: NamedExprItem = { expr, alias };
    SelectItem::NamedExpr(item)
};

def aggregate: Fn(AggregateFunction, Expr, Bool, String) -> SelectItem = fn(function, arg, distinct, alias) {
    let call: AggregateCall = {function: function, arg: arg, distinct: distinct, filter: None, alias: alias};
    SelectItem::Aggregate(call)
};

# Filtered aggregate: the row-level predicate only narrows this aggregate's
# input rows (`FILTER (WHERE ...)`); it is never merged into the global WHERE.
def aggregate_filtered: Fn(AggregateFunction, Expr, Bool, Option(Expr), String) -> SelectItem = fn(function, arg, distinct, filter, alias) {
    let call: AggregateCall = {function: function, arg: arg, distinct: distinct, filter: filter, alias: alias};
    SelectItem::Aggregate(call)
};

# Computed aggregate: restricted Add/Sub over declared aggregate aliases.
def computed_aggregate: Fn(ComputedOp, String, String, String) -> ComputedAggregate = fn(op, left, right, alias) {
    let item: ComputedAggregate = {op: op, left: left, right: right, alias: alias};
    item
};

def computed_item: Fn(ComputedOp, String, String, String) -> SelectItem = fn(op, left, right, alias) {
    SelectItem::Computed(computed_aggregate(op, left, right, alias))
};



# Equality atom between two source-qualified columns.
def column_eq: Fn(ColumnRef, ColumnRef) -> ColumnEq = fn(left, right) {
    let item: ColumnEq = {left: left, right: right};
    item
};

# Simple equality ON-clause atom (kept as the common case).
def on_eq: Fn(ColumnRef, ColumnRef) -> JoinCondition = fn(left, right) {
    JoinCondition::Eq(column_eq(left, right))
};

def on_predicate: Fn(Expr) -> JoinCondition = fn(expr) { JoinCondition::Predicate(expr) };

def on_exists: Fn(Exists) -> JoinCondition = fn(ex) { JoinCondition::Exists(ex) };

# AND/OR combination of ON-clause conditions over a non-empty list.
def on_and: Fn(Array(JoinCondition)) -> JoinCondition = fn(items) { JoinCondition::And(items) };

def on_or: Fn(Array(JoinCondition)) -> JoinCondition = fn(items) { JoinCondition::Or(items) };

def join: Fn(JoinKind, Source, ColumnRef, ColumnRef) -> Join = fn(kind, source_item, left, right) {
    let item: Join = {kind: kind, source: source_item, condition: on_eq(left, right)};
    item
};

# General join with a structured ON predicate tree.
def join_on: Fn(JoinKind, Source, JoinCondition) -> Join = fn(kind, source_item, condition) {
    let item: Join = {kind: kind, source: source_item, condition: condition};
    item
};

# Correlated EXISTS predicate.  Each `pairs` entry correlates an outer main
# column (`left`) to an inner column of `ex_source.alias` (`right`);
# `inner_filter` optionally narrows the inner rows further.
def exists: Fn(Source, Array(ColumnEq), Option(Expr)) -> Exists = fn(ex_source, pairs, inner_filter) {
    let empty_group: Array(Expr) = [];
    let empty_having: Array(Having) = [];
    let item: Exists = {
        source: ex_source,
        pairs: pairs,
        alternatives: None,
        filter: inner_filter,
        grouping: empty_group,
        having: empty_having,
        peer: None,
        negated: False,
        link: None,
        path: [],
    };
    item
};

# Correlated aggregate EXISTS: like `exists`, but the matching inner rows are
# grouped (`grouping`) and only groups whose `having` holds make the EXISTS
# true.  `having` measures must be direct `HavingMeasure.Call` aggregate expressions.
def exists_grouped: Fn(Source, Array(ColumnEq), Option(Expr), Array(Expr), Array(Having)) -> Exists = fn(ex_source, pairs, inner_filter, grouping, having_list) {
    let item: Exists = {
        source: ex_source,
        pairs: pairs,
        alternatives: None,
        filter: inner_filter,
        grouping: grouping,
        having: having_list,
        peer: None,
        negated: False,
        link: None,
        path: [],
    };
    item
};

# Correlated-union EXISTS predicate for a closed disjunction of ANDed column
# equalities.  Each alternative in `alternatives` is a non-empty conjunction of
# ColumnEq; every equality strictly connects an outer main column (`left`) to an
# inner `source.alias` column (`right`).  `pairs` is empty in this mode and no
# arbitrary boolean expression or raw SQL is accepted.  `inner_filter`
# optionally narrows the inner rows further.
def exists_union: Fn(Source, Array(Array(ColumnEq)), Option(Expr)) -> Exists = fn(ex_source, alternatives, inner_filter) {
    let empty_pairs: Array(ColumnEq) = [];
    let empty_group: Array(Expr) = [];
    let empty_having: Array(Having) = [];
    let item: Exists = {
        source: ex_source,
        pairs: empty_pairs,
        alternatives: Some(alternatives),
        filter: inner_filter,
        grouping: empty_group,
        having: empty_having,
        peer: None,
        negated: False,
        link: None,
        path: [],
    };
    item
};

# One ordered endpoint-exchange branch of a paired correlation.
def peer_branch: Fn(ColumnEq, ColumnEq) -> PeerBranch = fn(origin, peer) {
    let item: PeerBranch = {origin: origin, peer: peer};
    item
};

# Correlated paired-endpoint (peer) body for DIFFERENT participant entities:
# origin/peer inner sources, the two closed exchange branches and the
# per-participant filters (no bare-key inequality is added across tables).
def peer_corr: Fn(Source, Source, PeerBranch, PeerBranch, Option(Expr), Option(Expr)) -> PeerCorr = fn(origin, peer, branch_a, branch_b, origin_filter, peer_filter) {
    let item: PeerCorr = {
        origin: origin,
        peer: peer,
        branch_a: branch_a,
        branch_b: branch_b,
        origin_filter: origin_filter,
        peer_filter: peer_filter,
        distinct_keys: False,
        exchange: True,
    };
    item
};

# Correlated paired-endpoint (peer) body with the same-entity structural
# identity proof.  `distinct_keys` (True when origin/peer are the same
# entity/table) adds the closed condition `origin.key <> peer.key` so one row
# can never occupy both endpoints of the same hub row.
def peer_corr_distinct: Fn(Source, Source, PeerBranch, PeerBranch, Option(Expr), Option(Expr), Bool) -> PeerCorr = fn(origin, peer, branch_a, branch_b, origin_filter, peer_filter, distinct_keys) {
    let item: PeerCorr = {
        origin: origin,
        peer: peer,
        branch_a: branch_a,
        branch_b: branch_b,
        origin_filter: origin_filter,
        peer_filter: peer_filter,
        distinct_keys: distinct_keys,
        exchange: True,
    };
    item
};

def peer_corr_roles: Fn(Source, Source, PeerBranch, PeerBranch, Option(Expr), Option(Expr), Bool, Bool) -> PeerCorr = fn(origin, peer, branch_a, branch_b, origin_filter, peer_filter, distinct_keys, exchange) {
    let item: PeerCorr = {
        origin, peer, branch_a, branch_b, origin_filter, peer_filter,
        distinct_keys, exchange,
    };
    item
};

# Correlated paired-endpoint EXISTS.  When present, the single-source modes
# (`pairs`/`alternatives`/`filter`/`grouping`/`having`) are empty.
def exists_peer: Fn(PeerCorr) -> Exists = fn(corr) {
    let empty_pairs: Array(ColumnEq) = [];
    let empty_group: Array(Expr) = [];
    let empty_having: Array(Having) = [];
    let item: Exists = {
        source: corr.origin,
        pairs: empty_pairs,
        alternatives: None,
        filter: None,
        grouping: empty_group,
        having: empty_having,
        peer: Some(corr),
        negated: False,
        link: None,
        path: [],
    };
    item
};

# Closed anti-existence wrapper: `exists_not(ex)` returns the same correlated
# body as `ex` with `negated = True`, so lowering renders `NOT EXISTS (...)`
# instead of `EXISTS (...)`.  Only the negation flag changes; correlation,
# source, bindings and grain semantics are identical.  Used to select subjects
# with no (or, with a grouped body, no qualifying) matching related row.
def exists_not: Fn(Exists) -> Exists = fn(ex) {
    let item: Exists = {
        source: ex.source,
        pairs: ex.pairs,
        alternatives: ex.alternatives,
        filter: ex.filter,
        grouping: ex.grouping,
        having: ex.having,
        peer: ex.peer,
        negated: True,
        link: ex.link,
        path: ex.path,
    };
    item
};

# Correlated two-hop existence over a declared link path: the outer subject (A)
# is correlated to an inner hop row B (`hop_source`/`hop_pairs`), which is joined
# inside the same subquery to a related row C (`link_source`/`link_pairs`);
# `link_filter` optionally constrains C.  The body stays one correlated EXISTS,
# so a fan-out A -> B first hop never amplifies the outer A grain.
def exists_two_hop: Fn(Source, Array(ColumnEq), Source, Array(ColumnEq), Option(Expr)) -> Exists = fn(hop_source, hop_pairs, link_source, link_pairs, link_filter) {
    let empty_group: Array(Expr) = [];
    let empty_having: Array(Having) = [];
    let link: ExistsLink = {source: link_source, pairs: link_pairs, alternatives: None, tail: None, filter: link_filter};
    let item: Exists = {
        source: hop_source,
        pairs: hop_pairs,
        alternatives: None,
        filter: None,
        grouping: empty_group,
        having: empty_having,
        peer: None,
        negated: False,
        link: Some(link),
        path: [],
    };
    item
};

# Arbitrarily long, ordered inner join path rooted at a correlated source.
def exists_path: Fn(Source, Array(ColumnEq), Array(Join)) -> Exists = fn(source, pairs, path) {
    {...exists(source, pairs, None), path}
};

def exists_path_alternatives: Fn(Source, Array(Array(ColumnEq)), Array(Join)) -> Exists = fn(source, alternatives, path) {
    {...exists_union(source, alternatives, None), path}
};

def exists_two_hop_alternatives: Fn(Source, Array(Array(ColumnEq)), Source, Array(ColumnEq), Option(Expr)) -> Exists =
    fn(hop_source, alternatives, link_source, link_pairs, link_filter) {
        let empty_pairs: Array(ColumnEq) = [];
        let base = exists_two_hop(hop_source, empty_pairs, link_source, link_pairs, link_filter);
        {...base, alternatives: Some(alternatives)}
    };

def exists_three_hop_alternatives: Fn(Source, Array(ColumnEq), Source, Array(Array(ColumnEq)), Source, Array(ColumnEq), Option(Expr)) -> Exists =
    fn(hop_source, hop_pairs, site_source, site_alternatives, tenant_source, tenant_pairs, filter) {
        let base = exists_two_hop(hop_source, hop_pairs, site_source, [], filter);
        let link: ExistsLink = {source: site_source, pairs: [], alternatives: Some(site_alternatives),
            tail: Some({source: tenant_source, pairs: tenant_pairs}), filter};
        {...base, link: Some(link)}
    };

def exists_three_hop_double_alternatives: Fn(Source, Array(Array(ColumnEq)), Source, Array(Array(ColumnEq)), Source, Array(ColumnEq), Option(Expr)) -> Exists =
    fn(hop_source, endpoint_alternatives, site_source, site_alternatives, tenant_source, tenant_pairs, filter) {
        let base = exists_three_hop_alternatives(hop_source, [], site_source, site_alternatives,
            tenant_source, tenant_pairs, filter);
        {...base, alternatives: Some(endpoint_alternatives)}
    };

# Aggregate-result predicate over a projected aggregate/computed measure alias:
# `<alias> <op> <threshold>`; `threshold` is a dynamic scalar (always bound).

def having_bound: Fn(HavingOp, String, Expr) -> Having = fn(op, measure_alias, threshold) {
    let ref: AggregateRef = {alias: measure_alias};
    {op, measure: HavingMeasure::Ref(ref), threshold}
};

# Aggregate-result predicate over a direct aggregate expression (not projected):
# `<call> <op> <threshold>`; used for nested aggregate bodies.

def having_call_bound: Fn(HavingOp, AggregateFunction, Expr, Bool, Expr) -> Having = fn(op, function, arg, distinct, threshold) {
    let call: AggregateCall = {function, arg, distinct, filter: None, alias: "__having"};
    {op, measure: HavingMeasure::Call(call), threshold}
};

def having_call_filtered_bound: Fn(HavingOp, AggregateFunction, Expr, Bool, Option(Expr), Expr) -> Having = fn(op, function, arg, distinct, filter, threshold) {
    let call: AggregateCall = {function, arg, distinct, filter, alias: "__having"};
    {op, measure: HavingMeasure::Call(call), threshold}
};

# A named output column of one UNION ALL branch.
def union_column: Fn(String, Expr) -> UnionColumn = fn(name, expr) {
    let item: UnionColumn = {name: name, expr: expr};
    item
};

# One UNION ALL branch: a physical source projected to its named outputs with
# an optional row filter.
def union_branch: Fn(Source, Array(UnionColumn), Option(Expr)) -> UnionBranch = fn(source, outputs, filter) {
    let item: UnionBranch = {source: source, outputs: outputs, filter: filter};
    item
};

# A derived UNION ALL relation exposed to the outer plan as the named source
# `alias`.  All branches must project the same ordered output names.
def derived_source: Fn(String, Array(UnionBranch)) -> DerivedSource = fn(alias, branches) {
    let item: DerivedSource = {alias: alias, branches: branches};
    item
};

def asc: Fn(Expr) -> OrderBy = fn(expr) {
    let item: OrderBy = {key: OrderKey::Expr(expr), direction: Ordering::Asc};
    item
};

def desc: Fn(Expr) -> OrderBy = fn(expr) {
    let item: OrderBy = {key: OrderKey::Expr(expr), direction: Ordering::Desc};
    item
};

def asc_aggregate: Fn(String) -> OrderBy = fn(alias) {
    let ref: AggregateRef = {alias: alias};
    let item: OrderBy = {key: OrderKey::AggregateRef(ref), direction: Ordering::Asc};
    item
};

def desc_aggregate: Fn(String) -> OrderBy = fn(alias) {
    let ref: AggregateRef = {alias: alias};
    let item: OrderBy = {key: OrderKey::AggregateRef(ref), direction: Ordering::Desc};
    item
};

def order_by: Fn(OrderKey, Ordering) -> OrderBy = fn(key, direction) {
    let item: OrderBy = {key: key, direction: direction};
    item
};


def partitioned_top_n_bound: Fn(Array(Expr), Array(OrderBy), Expr) -> PartitionedTopN = fn(partition_by, order_by, take) {
    {partition_by, order_by, take}
};

