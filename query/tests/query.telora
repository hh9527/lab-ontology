# Partition by role with the computed first-token grouping expression used in
# the partition-internal ordering; bindings stay deterministic.
def computed_partition_plan: Fn() -> qb.Plan = fn() {
    let token = first_token_expr(qb.column("c", "command"));
    let plan: qb.Plan = {
        revision: "test-computed-partition",
        sources: [qb.source("c", "commands")],
        projection: [
            qb.expr_item(qb.column("c", "role")),
            qb.expr_item(token),
            qb.aggregate('Count, qb.column("c", "id"), 'False, "uses"),
        ],
        filter: 'Some(qb.scalar('Gt, [qb.column("c", "level"), qb.bind_int(5)])),
        joins: [],
        grouping: [qb.column("c", "role"), token],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'Some(qb.partitioned_top_n(
            [qb.column("c", "role")],
            [qb.desc_aggregate("uses"), qb.asc(token)],
            2,
        )),
    };
    plan
};

export def partition_lowers_to_row_number_subquery = do {
    let q = qb.transform_sqlite(top_per_role_plan());
    q.sql == expected_top_per_role_sql && q.bindings == expected_top_per_role_bindings
};

export def partition_keeps_fewer_than_take_rows = do {
    # `__q_rn <= ?` keeps every partition with fewer than N rows; `take` is a
    # bound value, never an inline literal.
    let q = qb.transform_sqlite(top_per_role_plan());
    string.contains(q.sql, "WHERE __q_rn <= ?")
        && q.bindings[1] == 'Int(3)
};

export def partition_tie_breaker_in_ordering = do {
    let q = qb.transform_sqlite(top_per_role_plan());
    # measure DESC then the non-partition grouping expression ASC
    string.contains(q.sql, "ORDER BY count(e.id) DESC, e.command_head ASC")
        && string.contains(q.sql, "ORDER BY __q_0 ASC, event_count DESC, __q_1 ASC")
};

export def partition_operators_in_canonical_order = do {
    let expected: Array(qb.Operator) = [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Group, 'Order, 'Partition,
    ];
    qb.operators(top_per_role_plan()) == expected
};

export def partition_profile_accepts = do {
    qb.profile_accepts(top_per_role_plan(), full_profile())
};

export def partition_profile_rejects_without_partition_operator = do {
    let no_partition: qb.PlanProfile = {
        allowed_operators: [
            'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
            'Filter, 'Group, 'Order, 'Limit,
        ],
        allowed_join_kinds: ['Inner],
        allowed_aggregates: ['Count],
        allowed_scalars: ['Substr, 'Eq],
        allow_distinct: 'True,
    };
    !qb.profile_accepts(top_per_role_plan(), no_partition)
};

export def partition_rejects_non_grouping_key = do {
    !qb.structure_ok(partition_bad_key_plan())
};

export def partition_rejects_unselected_order_target = do {
    !qb.structure_ok(partition_bad_order_target_plan())
};

export def partition_rejects_missing_ordering = do {
    !qb.structure_ok(partition_no_order_plan())
};

export def partition_rejects_missing_tie_breaker = do {
    !qb.structure_ok(partition_no_tie_break_plan())
};

export def partition_rejects_zero_take = do {
    !qb.structure_ok(partition_zero_take_plan())
};

export def partition_rejects_over_cap_take = do {
    !qb.structure_ok(partition_over_cap_take_plan())
};

export def partition_rejects_negative_take = do {
    !qb.structure_ok(partition_negative_take_plan())
};

export def partition_rejects_global_limit_combination = do {
