use crate::typed_relations as t;
use crate::model as baseline;
use ontology::experimental::relations as r;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::test as test;
use std::value::{Value};

pub def entity_and_dataset_ids_are_independent: test::Test = test::should_ok(fn() {
    t::device.id != t::devices.id && t::device_subject.entity == t::device.id
        && array::length(t::payload.relations) == 9 && array::length(t::payload.business_links) == 2
});
pub def endpoint_keys_cover_tenant_and_local_identity: test::Test = test::should_ok(fn() {
    let key = r::lower(baseline::payload, t::connection_a).key;
    match key {
        edsl::RelationKey::And(parts) => array::length(parts) == 2
            && parts[0] == edsl::RelationKey::Eq({from: 0, to: 0})
            && parts[1] == edsl::RelationKey::Eq({from: 2, to: 2}),
        _ => False,
    }
});
pub def a_and_z_remain_distinct_roles: test::Test = test::should_ok(fn() {
    t::connection_a.from.role != t::connection_z.from.role
        && t::a.entity == t::z.entity && t::a.parts[1].source != t::z.parts[1].source
});
pub def incompatible_entity_roles_are_rejected: test::Test = test::should_fail_with(fn() {
    r::checked_relation("wrong", t::devices, t::device_subject, t::sites, t::site_subject, t::many_optional)
}, "relation endpoints must describe the same entity identity");
pub def forged_incomplete_role_is_rechecked: test::Test = test::should_fail_with(fn() {
    let role = t::connection_a.from.dataset.roles[0];
    let dataset = t::connection_a.from.dataset <~ {roles: [role <~ {parts: [role.parts[1]]}]};
    r::checked_lower(baseline::payload, t::connection_a <~ {from: t::connection_a.from <~ {dataset}})
}, "role mapping must cover the complete identity exactly once");
pub def wrong_physical_source_is_rejected: test::Test = test::should_fail_with(fn() {
    let dataset = t::connection_a.from.dataset <~ {source: "other_connections"};
    r::checked_lower(baseline::payload, t::connection_a <~ {from: t::connection_a.from <~ {dataset}})
}, "typed relation source does not match transform dataset");
pub def mismatched_grain_cannot_borrow_baseline_count_proof: test::Test = test::should_fail_with(fn() {
    let dataset = t::connection_a.from.dataset <~ {grain: ["id"]};
    r::checked_lower(baseline::payload, t::connection_a <~ {from: t::connection_a.from <~ {dataset}})
}, "typed relation grain does not match transform dataset");
pub def duplicate_relation_ids_are_rejected: test::Test = test::should_fail_with(fn() {
    r::checked_lower_all(baseline::payload, [t::connection_a, t::connection_a])
}, "typed relation ids must be unique");
pub def same_named_role_cannot_change_mapping: test::Test = test::should_fail_with(fn() {
    let swapped = t::connection_z <~ {id: "conflicting"};
    let role = swapped.from.dataset.roles[0] <~ {id: "a"};
    let dataset = swapped.from.dataset <~ {roles: [role]};
    r::checked_lower_all(baseline::payload, [t::connection_a, swapped <~ {from: swapped.from <~ {role: "a", dataset}}])
}, "typed relations contain conflicting entity or dataset declarations");
pub def business_link_cannot_reuse_one_endpoint_role: test::Test = test::should_fail_with(fn() {
    r::checked_link("wrong", t::connection_a, t::connection_a, edsl::LinkDirection::Undirected)
}, "business link requires distinct hub roles and one explicit participant dataset");
pub def business_link_requires_registered_keys: test::Test = test::should_fail_with(fn() {
    r::checked_lower_link(t::payload <~ {relations: []}, t::connected)
}, "business link endpoints must be registered typed relations");

def reverse: Value = json::parse(r#"{"op":"Graph","root":"z",
    "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
    "edges":[{"relation":"upstream_device","from":"a","to":"z"}],
    "select":[{"node":"a","dimension":"device_id"}]}"#).unwrap!();
pub def directed_business_link_still_rejects_reverse: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(t::payload)(reverse)
}, "directed business link cannot be traversed from Z to A");
pub def root_count_still_rejects_fanout: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(t::payload)(json::parse(r#"{"op":"Graph","root":"d",
        "nodes":[{"id":"d","entity":"device"},{"id":"c","entity":"connection"}],
        "edges":[{"relation":"connection_a","from":"c","to":"d"}],"select":[],"count":"d"}"#).unwrap!())
}, "connection_a");

type RuntimeCase = struct { id: String, baseline: qb::Query, typed: qb::Query };
def runtime_case: Fn(String, String) -> RuntimeCase = fn(id, raw) {
    let request = json::parse(raw).unwrap!();
    {id, baseline: intent::query_intent_lower_factory(baseline::payload, sqlite::build_query)(request),
        typed: intent::query_intent_lower_factory(t::payload, sqlite::build_query)(request)}
};
pub def runtime_cases: Value = codec::encode([
    runtime_case("endpoints", r#"{"op":"Graph","root":"c",
        "nodes":[{"id":"c","entity":"connection"},{"id":"a","entity":"device"},{"id":"z","entity":"device"},{"id":"t","entity":"tenant"}],
        "edges":[{"relation":"connection_a","from":"c","to":"a"},{"relation":"connection_z","from":"c","to":"z"},{"relation":"device_tenant","from":"a","to":"t"}],
        "select":[{"node":"t","dimension":"tenant_id"},{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]}"#),
    runtime_case("exists", r#"{"op":"Graph","root":"d","nodes":[{"id":"d","entity":"device"}],"edges":[],"select":[],"count":"d",
        "exists":[{"anchor":"d","nodes":[{"id":"c","entity":"connection"}],"edges":[{"relation":"connection_a","from":"c","to":"d"}]}]}"#),
    runtime_case("undirected", r#"{"op":"Graph","root":"a","row_grain":"Association","distinct":true,
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"connected_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]}"#),
    runtime_case("directed", r#"{"op":"Graph","root":"a","row_grain":"Association","distinct":true,
        "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"upstream_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]}"#),
    runtime_case("empty_groups", r#"{"op":"Graph","root":"t","include_empty":true,
        "nodes":[{"id":"t","entity":"tenant"},{"id":"s","entity":"site"},{"id":"d","entity":"device"}],
        "edges":[{"relation":"site_tenant","from":"s","to":"t"},{"relation":"device_site","from":"d","to":"s"}],
        "select":[{"node":"t","dimension":"tenant_id"}],"count":"d"}"#),
    runtime_case("alternative_counts", r#"{"op":"Graph","root":"d","include_empty":true,
        "nodes":[{"id":"d","entity":"device"},{"id":"c","entity":"connection"}],
        "edges":[{"relation":"connection_endpoint","from":"c","to":"d"}],
        "select":[{"node":"d","dimension":"device_id"}],"count":"c","group_by_identity":["d"]}"#),
]);
