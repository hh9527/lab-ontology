# 只准备 transform 契约；真实 SQL 用例放在独立按需入口，避免测试初始化重复生成全部查询。
use crate::typed::{payload};
use crate::typed::inventory as inventory;
use crate::model as baseline;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};
use std::test as test;

def base_entity: Fn(String) -> edsl::EntityEntry = fn(id) { match array::find(baseline::payload.entities, fn(entry) { entry.id == id }) { Some(entry) => entry, None => fail!("baseline entity missing", id) } };

pub def physical_sources_fields_and_grains_match_the_baseline: test::Test = test::should_ok(fn() {
    array::all(payload.entities, fn(entity) { let previous = base_entity(entity.id); entity.table == previous.table && entity.scope == previous.scope && entity.fields == array::map(previous.fields, fn(field) {
        # 显式复合 grain 已给出完整样本身份，不把 res_id 单列当成唯一键
        match entity.dataset {
            Some(spec) => if array::length(spec.grain) > 1 { field <~ {is_key: False} } else { field },
            None => field,
        }
    }) && match (entity.dataset, previous.dataset) {
        (Some(current), None) => current.kind == edsl::DatasetKind::Entity && current.utc_time == None && current.grain == array::map(array::filter(previous.fields, fn(field) { field.is_key }), fn(field) { field.name }),
        _ => entity.dataset == previous.dataset,
    } })
});
pub def all_current_dimension_contracts_are_preserved: test::Test = test::should_ok(fn() {
    array::all(payload.entities, fn(entity) {
        let previous = base_entity(entity.id);
        let expected = array::filter(baseline::payload.dimensions, fn(dimension) { dimension.entity == previous.index });
        let actual = array::filter(payload.dimensions, fn(dimension) { dimension.entity == entity.index });
        array::length(expected) == array::length(actual) && array::all(expected, fn(old) {
            match array::find(actual, fn(value) { value.id == old.id }) {
                None => False,
                Some(value) => value.ty == old.ty && value.half_open == old.half_open && value.output_type == old.output_type && value.field == old.field
                    && value.computed == old.computed && value.authorized == old.authorized && value.projectable == old.projectable
                    && value.filterable == old.filterable && value.ops == old.ops && value.input_kinds == old.input_kinds
                    && value.utc_bucket == old.utc_bucket && value.scope == old.scope && value.canonical_order == old.canonical_order
                    && array::map(value.canonical_values, fn(member) { (member.id, member.wires) }) == array::map(old.canonical_values, fn(member) { (member.id, member.wires) }),
            }
        })
    })
});
pub def all_current_record_measures_are_preserved: test::Test = test::should_ok(fn() {
    array::all(payload.entities, fn(entity) {
        let expected = array::filter(baseline::payload.measures, fn(measure) { measure.entity == base_entity(entity.id).index });
        let actual = array::filter(payload.measures, fn(measure) { measure.entity == entity.index });
        array::length(expected) == array::length(actual) && array::all(expected, fn(old) { array::any(actual, fn(value) { value.id == old.id && value.field == old.field && value.aggregate == old.aggregate && value.input == old.input && value.requires == old.requires && value.predicate == old.predicate && value.computed == old.computed && value.row_expression == None }) })
    })
});
pub def every_relation_between_migrated_datasets_is_preserved: test::Test = test::should_ok(fn() {
    let expected = array::filter(baseline::payload.relations, fn(relation) { relation.from < 45 && relation.to < 45 });
    array::length(expected) == array::length(payload.relations) && array::all(expected, fn(old) { array::any(payload.relations, fn(value) { value.id == old.id && value.from == old.from && value.to == old.to && value.cardinality == old.cardinality && value.key == old.key && value.guard == old.guard }) })
});
pub def device_identity_is_id_only: test::Test = test::should_ok(fn() { inventory::device_subject.parts == [{source: "id", target: "id", value: inventory::DeviceId.type, nullable: False, raw: None}] });
pub def sample_roles_units_and_statistics_are_preserved: test::Test = test::should_ok(fn() {
    array::all(payload.entities, fn(entity) { entity.sample_measures == base_entity(entity.id).sample_measures })
});
pub def backend_capability_profile_is_preserved: test::Test = test::should_ok(fn() { payload.profile == baseline::payload.profile });

pub def server_relation_projection_requires_association_grain: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"v","nodes":[{"id":"v","entity":"server_device"},{"id":"t","entity":"tenant"}],"edges":[{"relation":"server_belongs_to_tenant","from":"v","to":"t"}],"select":[{"node":"v","dimension":"server_name"},{"node":"t","dimension":"tenant_name"}]}"#).unwrap!())
}, "graph raw projection crosses a multiplying relation");
pub def component_projection_does_not_reinterpret_server_samples_as_component_values: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"server_memory"},{"id":"v","entity":"server_device"},{"id":"k","entity":"server_kpi"}],"edges":[{"relation":"memory_parent_server","from":"c","to":"v"},{"relation":"server_kpi_of_server","from":"k","to":"v"}],"select":[{"node":"c","dimension":"server_memory_name"},{"node":"k","dimension":"server_cpu_sample"}]}"#).unwrap!())
}, "graph raw projection crosses a multiplying relation");
pub def onu_class_remains_internal: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"p","nodes":[{"id":"p","entity":"pon_onu_role"}],"edges":[],"select":[{"node":"p","dimension":"pon_onu_class"}]}"#).unwrap!())
}, "graph projection dimension pon_onu_class is not authorized");
pub def olt_class_remains_internal: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"p","nodes":[{"id":"p","entity":"pon_olt_role"}],"edges":[],"select":[{"node":"p","dimension":"pon_olt_class"}]}"#).unwrap!())
}, "graph projection dimension pon_olt_class is not authorized");
pub def onu_grouping_does_not_relax_many_to_many_measure_guard: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"k","nodes":[{"id":"k","entity":"onu_kpi"},{"id":"p","entity":"pon_onu_role"}],"edges":[{"relation":"onu_kpi_of_onu_role","from":"k","to":"p"}],"select":[{"node":"p","dimension":"pon_onu_id"}],"measures":[{"node":"k","measure":"onu_receive_usage"}]}"#).unwrap!())
}, "graph measure source may be multiplied by a joined relation");

pub def alarm_is_event_without_implicit_clearance_scope: test::Test = test::should_ok(fn() {
    let alarm = match array::find(payload.entities, fn(entity) { entity.id == "current_alarm" }) { Some(entity) => entity, None => fail!("alarm missing") };
    alarm.dataset == Some({kind: edsl::DatasetKind::Event, grain: ["csn"], utc_time: Some("occur_utc")}) && alarm.scope == []
});
pub def alarm_closed_domain_rejects_unknown_selector: test::Test = test::should_fail_with(fn() {
    intent::query_intent_ast_factory(payload)(json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"}],"edges":[],"select":[],"count":"a","filters":[{"node":"a","dimension":"alarm_severity","op":"Eq","value":{"unknowns":true}}]}"#).unwrap!())
}, "tagged unknown input requires a half-open domain");

pub def business_links_and_native_pairs_are_preserved: test::Test = test::should_ok(fn() {
    payload.business_links == array::filter(baseline::payload.business_links, fn(link) { link.hub < 45 && link.participant < 45 })
        && payload.native_pairs == array::filter(baseline::payload.native_pairs, fn(pair) { pair.entity < 45 })
});

pub def collaboration_does_not_invent_cpu_measure: test::Test = test::should_ok(fn() {
    let entity = match array::find(payload.entities, fn(entity) { entity.id == "source_EntCollaborationElement" }) { Some(entity) => entity, None => fail!("collaboration missing") };
    entity.sample_measures == [] && !array::any(payload.measures, fn(measure) { measure.entity == entity.index })
});


pub def network_optical_source_does_not_invent_an_identity: test::Test = test::should_ok(fn() {
    let entity = match array::find(payload.entities, fn(entity) { entity.id == "source_EnterpriseOpticalModule" }) { Some(entity) => entity, None => fail!("network optical module missing") };
    entity.dataset == None && !array::any(entity.fields, fn(field) { field.is_key }) && entity.sample_measures == []
        && !array::any(payload.measures, fn(measure) { measure.entity == entity.index })
        && !array::any(payload.relations, fn(relation) { relation.from == entity.index || relation.to == entity.index })
});
