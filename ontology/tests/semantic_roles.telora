use ontology::semantic as s;
use ontology::relations as r;
use ontology::ontology as edsl;
use std::test;
use std::array;

@s::entity_by("Port")
type PortByDeviceAndName = struct { device: String, name: String };
@s::dataset("ports", "ports", [])
@s::role("lookup", PortByDeviceAndName.type, {device: "device", name: "name"})
type Ports = struct { device: String, name: String };
@s::dataset("modules", "modules", [])
@s::role("port", PortByDeviceAndName.type, {device: "owner", name: "interface"})
type Modules = struct { owner: String, interface: Option(String) };

pub def compound_role_preserves_keys_and_nullable_source: test::Test = test::should_ok(fn() {
    let left = s::endpoint(Ports.type, "lookup");
    let right = s::endpoint(Modules.type, "port");
    let relation = r::relation("port_modules", left, right, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0});
    if left.binding.optional || !right.binding.optional || array::length(right.binding.parts) != 2 {
        fail!("incorrect compound role optionality")
    } else { () };
    match relation.key {
        edsl::RelationKey::And(parts) => if array::length(parts) != 2 { fail!("lost compound key") } else { () },
        _ => fail!("compound role must lower to AND")
    }
});

pub def missing_identity_part_is_rejected: test::Test = test::should_fail_with(fn() {
    s::role("port", PortByDeviceAndName.type, {device: "owner"}); ()
}, "role mapping must cover the complete identity");

@s::dataset("wrong_storage", "modules", [])
@s::role("port", PortByDeviceAndName.type, {device: "owner", name: "interface"})
type WrongStorage = struct { owner: String, interface: Int };
pub def incompatible_storage_is_rejected: test::Test = test::should_fail_with(fn() {
    s::endpoint(WrongStorage.type, "port"); ()
}, "role field has incompatible representation");

@s::dataset("repeated", "modules", [])
@s::role("port", PortByDeviceAndName.type, {device: "owner", name: "owner"})
type Repeated = struct { owner: String };
pub def repeated_source_part_is_rejected: test::Test = test::should_fail_with(fn() {
    s::endpoint(Repeated.type, "port"); ()
}, "role mapping must use distinct source fields");

@s::dataset("missing_field", "modules", [])
@s::role("port", PortByDeviceAndName.type, {device: "owner", name: "missing"})
type MissingField = struct { owner: String };
pub def nonexistent_source_field_is_rejected: test::Test = test::should_fail_with(fn() {
    s::endpoint(MissingField.type, "port"); ()
}, "role source field does not exist");
