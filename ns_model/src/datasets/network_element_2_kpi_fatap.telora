pub def relations: Array(r::Relation) = [
    r::relation("neelfa__nwf", domain::endpoint(NetworkElement2KpiFatap.type, "obj_id"), domain::endpoint(kpi_network_wlan_fatap::KpiNetworkWlanFatap.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
