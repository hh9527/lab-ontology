    @g::field_view(g::dimension_group("enterprise-front-port-2-kpi/obj_sys_id", ids::CloudBlockNetPort2KpiByObjSysId.type, True, [g::Filter::Eq]), "efp2_obj_sys_id", True, [g::Filter::Eq])
