        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "exists":[{"anchor":"device", "nodes":[{"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
            "any_of":[{"node":"alarm","dimension":"alarm_severity","kind":"text","values":["1","major"]}]
        }]
    }"#).unwrap!())
}, "unknown canonical value for dimension");

pub def alarm_alternatives_reject_empty_group: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "exists":[{"anchor":"device", "nodes":[{"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
            "any_of":[{"node":"alarm","dimension":"alarm_severity","kind":"text","values":[]}]
        }]
    }"#).unwrap!())
}, "graph any_of requires at least one value");

pub def outer_alarm_alternatives_use_declared_values: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[], "select":[], "count":"alarm",
        "any_of":[{"node":"alarm","dimension":"alarm_severity","kind":"text",
                   "values":["critical","major"]}]
    }"#).unwrap!());
    if string::contains(query.sql, "alarm.SEVERITY = ?1 OR alarm.SEVERITY = ?2")
        && query.bindings == [qb::Val::String("1"), qb::Val::String("2")] { True }
    else { fail!(`outer alarm OR group lost canonical binds: \{query.sql}`, query.bindings) }
});

pub def alarm_severity_projection_returns_canonical_business_value: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[], "select":[{"node":"alarm","dimension":"alarm_severity"}]
    }"#).unwrap!());
    if string::contains(query.sql, "CASE WHEN")
        && string::contains(query.sql, "alarm.SEVERITY")
        && query.bindings == [qb::Val::None, qb::Val::String("1"), qb::Val::String("critical"),
            qb::Val::String("2"), qb::Val::String("major")] { True }
    else { fail!(`alarm projection exposed a physical wire instead of the declared value: \{query.sql}`, query.bindings) }
});

pub def grouped_alarm_severity_uses_canonical_grain: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[], "select":[{"node":"alarm","dimension":"alarm_severity"}],
        "count":"alarm"
    }"#).unwrap!());
    if string::contains(query.sql, "GROUP BY CASE WHEN")
        && string::contains(query.sql, "count(alarm.CSN)")
        && array::length(query.bindings) == 5 { True }
    else { fail!(`alarm severity grouping lost its business-value grain: \{query.sql}`, query.bindings) }
});

pub def device_class_projection_merges_declared_wires: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[{"node":"device","dimension":"device_class"}],
        "count":"device"
    }"#).unwrap!());
    if string::contains(query.sql, "GROUP BY CASE WHEN")
        && array::any(query.bindings, fn(value) { value == qb::Val::String("ne.category.ac") })
        && array::any(query.bindings, fn(value) { value == qb::Val::String("WAC") }) { True }
    else { fail!(`device class failed to merge alternate physical wires: \{query.sql}`, query.bindings) }
});

pub def single_alarm_alternative_is_a_plain_filter: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[], "select":[], "count":"alarm",
        "any_of":[{"node":"alarm","dimension":"alarm_severity","kind":"text",
                   "values":["critical"]}]
    }"#).unwrap!());
    if string::contains(query.sql, "alarm.SEVERITY = ?1")
        && query.bindings == [qb::Val::String("1")] { True }
    else { fail!("single canonical alternative was not lowered", query.sql, query.bindings) }
});

pub def three_device_class_alternatives_keep_binary_or: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "any_of":[{"node":"device","dimension":"device_class","kind":"text",
                   "values":["WAC","LSW","router"]}]
    }"#).unwrap!());
    if string::contains(query.sql, " OR ") && array::length(query.bindings) >= 3 { True }
    else { fail!("three canonical alternatives were not lowered", query.sql, query.bindings) }
});

