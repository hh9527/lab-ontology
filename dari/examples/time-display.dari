# One typed instant; the presentation chooses its local calendar labels.
data ctx = context! { now: Context::Now, tz: Context::ClientTz };
data date_format = { time_zone: ctx.tz, date_style: DateStyle::Date };
data zoned_now = to_datetime_tz(ctx.now, ctx.tz);
data today = date_of(zoned_now);
data samples = table([
    { at: ctx.now, value: 1.0 },
    { at: ctx.now + 86400000, value: 2.0 }
]);
answer tree! { Answer [
    p ["本地日期：", UseValue(ref = ctx.now, format = date_format)],
    p ["本地时间：", UseValue(ref = zoned_now)],
    Table(data = samples, spec = { formats: { at: date_format } }),
    LineChart(data = samples, spec = {
        x: $.at,
        value: $.value,
        formats: { at: date_format }
    })
] };
