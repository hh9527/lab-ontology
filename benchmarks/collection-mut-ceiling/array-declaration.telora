# Experiment-only fragment, injected by prepare-mut-ceiling.py.
def each: for(A) Fn(Array(A), Fn(A) -> Bool) -> Bool = fn(items, visit) {
    array::fold(items, False, fn(ignored, item) { visit(item) })
};
def declaration_types: Fn(Array(t::Declaration)) -> Array(Type) = fn(declarations) {
    let output = pipeline::oracle_array_new();
    let emit_expression: Fn(g::Node) -> Bool = fn(node) { each(expression_types(node), fn(ty) { pipeline::oracle_array_push(output, ty) }) };
    each(declarations, fn(d) {
        pipeline::oracle_array_push(output, d.dataset.row);
        each(d.dataset.roles, fn(r) { pipeline::oracle_array_push(output, r.identity) });
        each(d.dataset.roles, fn(r) { each(r.parts, fn(p) {
            pipeline::oracle_array_push(output, p.value);
            match p.raw { Some(ty) => pipeline::oracle_array_push(output, ty), None => False }
        }) });
        each(d.columns, fn(c) { pipeline::oracle_array_push(output, c.value) });
        each(d.samples, fn(b) { pipeline::oracle_array_push(output, b.value) });
        each(d.domains, fn(b) {
            pipeline::oracle_array_push(output, b.definition.value); pipeline::oracle_array_push(output, b.definition.wire); emit_expression(b.node)
        });
        each(d.groups, fn(b) {
            pipeline::oracle_array_push(output, b.row);
            match b.contract {
                g::BindingContract::DeferredDimension(group) => pipeline::oracle_array_push(output, group.value),
                g::BindingContract::Numeric(group) => pipeline::oracle_array_push(output, group.value),
                g::BindingContract::Identity(role) => pipeline::oracle_array_push(output, role.identity), _ => False,
            };
            each(b.members, fn(m) { pipeline::oracle_array_push(output, m.value); emit_expression(m.node) })
        })
    });
    pipeline::oracle_array_finish(output)
};
