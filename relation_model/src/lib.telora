mod model;
pub mod typed_relations;
pub mod explicit_world;

pub use crate::typed_relations::{payload};
use crate::typed_relations::{prepared};
use ontology::intent as intent;
use ontology::world as world;
use crate::explicit_world::{model_world};
use ontology::sqlite as sqlite;
use std::transform_service as service;
use std::http as http;
use std::value::{Value};

def lower: Fn(Value) -> Value = world::stage(
    model_world,
    fn(payload) {
        intent::query_request_method_factory(payload, sqlite::build_query)
    }
);

type QueryService = struct {
    lower: Fn(Value) -> Value
};
impl service::TransformService for QueryService {
    init: fn(ctx) {
        {lower: lower}.ty!(Self)
    },
    transform: fn(self, input) {
        self.lower(input)
    },
};

@service::collection
pub type MainService = struct {
    @service::slot("relation/transform")
    @http::post("/relation/transform")
    query: QueryService,
};
