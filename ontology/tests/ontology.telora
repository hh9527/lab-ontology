@edsl::entity_source("hd_t", "hd")
@edsl::dual_hub(HubParticipant.type, 0, 1, 2)
@edsl::dual_hub(HubParticipant.type, 0, 1, 2)
type HubDup = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
    @edsl::column("left")
    left: Int,
    @edsl::column("right")
