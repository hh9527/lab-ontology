export def check_zip_by_city_case = test.should_ok(fn() { if check_zip_by_city { True } else { fail!("assertion failed: check_zip_by_city") } });
export def check_sections_desc_case = test.should_ok(fn() { if check_sections_desc { True } else { fail!("assertion failed: check_sections_desc") } });
