pub def relations: Array(r::Relation) = [
    r::relation("edd2__dp_rev", domain::endpoint(DiskPool.type, "obj_sys_id"), domain::endpoint(enterprise_disk_domain_2_kpi::EnterpriseDiskDomain2Kpi.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
