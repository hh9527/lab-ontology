use crate::ontology as edsl;
use crate::intent::{ query_intent_ast_factory, query_request_method_factory };
use crate::knowledge as knowledge;
use crate::query as qb;
use crate::sqlite as sqlite;
use crate::time as time;
use std::json as json;
use std::string as string;
use std::test as test;

@edsl::entity_id("dog")
@edsl::entity_source("dogs", "dog")
type Dog = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
    @edsl::column("date_of_birth")
    @edsl::time_field(edsl::TimeSemantics::DateUtc, edsl::TimeEncoding::DateText)
    @edsl::dimension("birth_date", True, True,
        [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::DateUtc])
    birth_date: String,
    @edsl::column("created_at")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("created_at", True, True,
        [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::DatetimeUtc])
    created_at: String,
    @edsl::column("raw_clock")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::EpochMillis)
    @edsl::dimension("raw_clock", True, True,
        [edsl::FilterOp::Ge, edsl::FilterOp::Lt], [edsl::FilterInputKind::EpochMillis])
    raw_clock: Int,
};

@edsl::entity_id("legacy_clock")
@edsl::entity_source("legacy_clocks", "legacy")
@edsl::named_relation_key("bad_clock_join", Dog.type, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Many0},
    edsl::DeclaredRelationKey::FieldEq({from: "timestamp_text", to: "created_at"}))
type LegacyClock = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
    @edsl::column("timestamp_text")
    timestamp_text: String,
};

@edsl::entity_source("bad_time_dimension", "bad")
type BadTimeDimension = struct {
    @edsl::column("id")
    @edsl::key()
    id: Int,
    @edsl::column("time")
    @edsl::time_field(edsl::TimeSemantics::Utc, edsl::TimeEncoding::Rfc3339Text)
    @edsl::dimension("bad_time", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text])
    time: String,
};

def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Column, qb::Operator::Project,
        qb::Operator::Filter, qb::Operator::Scalar, qb::Operator::Bind, qb::Operator::Group,
        qb::Operator::Aggregate],
    allowed_join_kinds: [], allowed_aggregates: [qb::AggregateFunction::Count],
    allowed_scalars: [qb::ScalarFunction::Ge, qb::ScalarFunction::Lt, qb::ScalarFunction::And],
    allow_distinct: False,
};

def payload: edsl::PreparedPayload = edsl::build_root("time-contract", [Dog.type], profile);

pub def date_window_preserves_date_semantics: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"birth_date"}],
        "time_windows":[{"node":"dog","dimension":"birth_date",
            "start":"2024-02-29", "end":"2024-03-01"}]
    }"#).unwrap!()));
    if string::contains(query.sql, "dog.date_of_birth >= ?1")
        && string::contains(query.sql, "dog.date_of_birth < ?2")
        && query.bindings == [qb::Val::String("2024-02-29"), qb::Val::String("2024-03-01"), qb::Val::Int(1000)] { True }
    else { fail!("calendar dates must compare as declared date text", query) }
});

pub def raw_clock_preserves_integer_boundary: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[],"count":"dog",
        "filters":[{"node":"dog","dimension":"raw_clock","op":"Ge","value":123}]
    }"#).unwrap!()));
    if query.bindings == [qb::Val::Int(123), qb::Val::Int(1000)] { True }
    else { fail!("epoch clock must preserve integer milliseconds", query) }
});

pub def epoch_clock_accepts_typed_window: test::Test = test::should_ok(fn() {
    let filters = time::window_filters(payload, "raw_clock", {
        start: time::TimeValue::EpochMillis(123), end: Some(time::TimeValue::EpochMillis(456))});
    if filters[0].input == edsl::FilterInput::EpochMillis(123)
        && filters[1].input == edsl::FilterInput::EpochMillis(456) { True }
    else { fail!("epoch window changed its bounds", filters) }
});

pub def raw_clock_rejects_text_input: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[],"count":"dog",
        "filters":[{"node":"dog","dimension":"raw_clock","op":"Ge","value":"2026-09-20T16:00:00Z"}]
    }"#).unwrap!())
}, "value does not match dimension raw_clock input type");

pub def open_window_omits_upper_predicate_and_binding: test::Test = test::should_ok(fn() {
    let lower = query_intent_ast_factory(payload);
    let explicit = sqlite::build_query(lower(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
        "time_windows":[{"node":"dog","dimension":"created_at",
            "start":"2024-02-29T00:00:00Z", "end":null}]
    }"#).unwrap!()));
    let omitted = sqlite::build_query(lower(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
        "time_windows":[{"node":"dog","dimension":"created_at",
            "start":"2024-02-29T00:00:00Z"}]
    }"#).unwrap!()));
    if explicit == omitted && string::contains(explicit.sql, "dog.created_at >= ?1")
        && !string::contains(explicit.sql, "dog.created_at <")
        && explicit.bindings == [qb::Val::String("2024-02-29T00:00:00Z"), qb::Val::Int(1000)] { True }
    else { fail!("open window must bind only its lower boundary", explicit, omitted) }
});

pub def invalid_calendar_date_fails_before_query: test::Test = test::should_fail_with(fn() {
    time::window_filters(payload, "birth_date", {
        start: time::TimeValue::DateUtc("2025-02-29"), end: Some(time::TimeValue::DateUtc("2025-03-01"))})
}, "invalid calendar date boundary");

pub def instant_cannot_filter_calendar_date: test::Test = test::should_fail_with(fn() {
    time::window_filters(payload, "birth_date", {
        start: time::TimeValue::DatetimeUtc("2024-02-29T00:00:00Z"),
        end: Some(time::TimeValue::DatetimeUtc("2024-03-01T00:00:00Z"))})
}, "time boundary does not match declared field encoding");

pub def reversed_absolute_window_is_rejected: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[],"count":"dog",
        "time_windows":[{"node":"dog","dimension":"created_at",
            "start":"2024-03-01T00:00:00Z", "end":"2024-02-29T00:00:00Z"}]
    }"#).unwrap!())
}, "time window start must precede end");

pub def now_boundary_is_rejected: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[],"count":"dog",
        "time_windows":[{"node":"dog","dimension":"created_at",
            "start":"2024-02-29T00:00:00Z", "end":"now"}]
    }"#).unwrap!())
}, "resolve now to an absolute time boundary");

pub def relative_boundary_is_rejected: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[],"count":"dog",
        "time_windows":[{"node":"dog","dimension":"created_at",
            "start":{"delta_ms":-259200000}, "end":null}]
    }"#).unwrap!())
}, "resolve relative time to an absolute boundary");

pub def query_request_rejects_context: test::Test = test::should_fail_with(fn() {
    query_request_method_factory(payload, sqlite::build_query)(json::parse(r#"{
        "ctx":{"now":1709280550000},
        "intents":[{"op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
            "edges":[],"select":[],"count":"dog"}]
    }"#).unwrap!())
}, "$.ctx: unknown field; see info key \"Schema/syntax/intent\"");

pub def kindless_now_filter_is_rejected: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[],"count":"dog",
        "filters":[{"node":"dog","dimension":"created_at","op":"Lt","value":"now"}]
    }"#).unwrap!())
}, "resolve now to an absolute time value");

pub def rfc3339_field_rejects_noncanonical_text: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","limit":1000,"root":"dog","nodes":[{"id":"dog","entity":"dog"}],
        "edges":[],"select":[{"node":"dog","dimension":"created_at"}],
        "filters":[{"node":"dog","dimension":"created_at","op":"Ge","value":"2024-02-29 00:00:00"}]
    }"#).unwrap!())
}, "invalid canonical RFC3339 UTC second value");

pub def offset_rfc3339_requires_normalization_before_binding: test::Test = test::should_fail_with(fn() {
    time::window_filters(payload, "created_at", {
        start: time::TimeValue::DatetimeUtc("2024-03-01T08:00:00+08:00"),
        end: Some(time::TimeValue::DatetimeUtc("2024-03-02T08:00:00+08:00"))})
}, "invalid canonical RFC3339 UTC second value");

pub def rfc3339_preserves_four_digit_year_and_december: test::Test = test::should_ok(fn() {
    if edsl::canonical_rfc3339("0001-12-31T23:59:59Z")
        && edsl::calendar_date("2024-12-31")
        && !edsl::canonical_rfc3339("2025-02-29T00:00:00Z") { True }
    else { fail!("time validators lost a valid date or accepted a non-leap day") }
});

pub def relation_cannot_join_rfc3339_to_plain_string: test::Test = test::should_fail_with(fn() {
    edsl::build_root("incompatible-time-relation", [Dog.type, LegacyClock.type], profile)
}, "relation fields have different logical time types or encodings");

pub def time_dimension_cannot_declare_plain_text_input: test::Test = test::should_fail_with(fn() {
    edsl::build_root("wrong-time-input-kind", [BadTimeDimension.type], profile)
}, "plain dimension filter input or operation disagrees with field type");

pub def knowledge_exposes_logical_time_type_and_storage_encoding: test::Test = test::should_ok(fn() {
    let target: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::TimeRole,
        owner: "dog", id: "created_at"};
    match knowledge::by_target(payload, target) {
        knowledge::DocResult::Found(point) => match point.time_role {
            Some(role) => if role.logical_type == edsl::TimeLogicalType::DatetimeUtc
                && role.encoding == edsl::TimeEncoding::Rfc3339Text { True }
                else { fail!("time knowledge lost logical or storage type", role) },
            None => fail!("time knowledge has no role", point),
        },
        other => fail!("time role is not discoverable", other),
    }
});
