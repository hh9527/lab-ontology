        ],
        filter: 'Some(qb.scalar('Eq, [qb.column("t", "kind"), qb.bind_string("wire")])),
        exists: [qb.exists(
            qb.source("x", "signals"),
            [qb.column_eq(qb.column_ref("t", "id"), qb.column_ref("x", "transfer_id"))],
            'Some(qb.scalar('Eq, [qb.column("x", "level"), qb.bind_int(1)])),
        )],
        joins: [
            qb.join('Inner, qb.source("a", "accounts"), qb.column_ref("t", "from_id"), qb.column_ref("a", "id")),
            qb.join_on('Inner, qb.source("r", "accounts"), qb.on_and([
                qb.on_eq(qb.column_ref("t", "to_id"), qb.column_ref("r", "id")),
                qb.on_or([
                    qb.on_eq(qb.column_ref("a", "site"), qb.column_ref("r", "site")),
                    qb.on_eq(qb.column_ref("a", "region"), qb.column_ref("r", "region")),
                ]),
            ])),
        ],
        grouping: [qb.column("t", "id"), qb.column("a", "site")],
        having: [qb.having('Gt, "transfer_count", 'Int(2))],
        ordering: [qb.desc_aggregate("transfer_count"), qb.asc(qb.column("a", "site"))],
        limit: 'Some(10),
        offset: 'None,
        derived: 'None,
        partition: 'None,
    };
    plan
};

def expected_verify_combined_sql = "SELECT t.id, a.site, count(t.id) AS transfer_count FROM transfers AS t INNER JOIN accounts AS a ON t.from_id = a.id INNER JOIN accounts AS r ON (t.to_id = r.id AND (a.site = r.site OR a.region = r.region)) WHERE t.kind = ? AND EXISTS (SELECT 1 FROM signals AS x WHERE t.id = x.transfer_id AND x.level = ?) GROUP BY t.id, a.site HAVING count(t.id) > ? ORDER BY count(t.id) DESC, a.site ASC LIMIT ?";

