# Host-facing entry for the dog kennel intent-to-SQL resolver.
#
# Lowering is derived by binding the prepared dog kennel payload to the public
# ontology intent factory (`ontology/intent`); no domain query module is needed.
# The Host (bin/dog-make-query) supplies one source, `input`, whose value is the
# JSON intent described in docs/INTENT.md.  This entry returns the single
# parameterized SQLite Query:
#
#   {"sql": "...", "bindings": [...]}
#
# Pure eval-with entry: no reducer, no effect loop.

import "@src/model" { payload };
import "ontology/intent" { query_intent_lower_factory };
import "ontology/query" as qb;
import "std/codec" as codec;
import "std/dict" as dict;
import "std/entry" as entry;
import "std/result" as result;
import "std/value" { Value };

def lower_intent: Fn(Value) -> qb.Query =
    query_intent_lower_factory(payload, "resolver");

def config: entry.ContextConfig = {
    sources: ["input"],
    envs: [],
    args: 'False,
};

export def main = entry.main(config, fn(ctx) {
    match dict.get(ctx.sources, "input") {
        'Some(intent) => {
            codec.encode(Value, lower_intent(intent)) |> result.unwrap
        },
        'None => fail!("missing input intent source"),
    }
});
