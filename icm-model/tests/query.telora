# ---------------------------------------------------------------------------
# 44. Physical-link A/Z any-end slice (dual_hub): filtering/counting links by a
#     participant on either endpoint uses a correlated union EXISTS at the link
#     base grain - no fan-out JOIN, one row per link even if both ends match.
# ---------------------------------------------------------------------------

def link_exists_intent: Fn(String, Array(edsl.FilterRequest)) -> facade.Intent = fn(target, inner_filters) {
    {
        measures: [request_measure("LinkCount")],
        dimensions: [],
        filters: [],
        any_of: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
        exists: [
            {
                target: target,
                subject: "analyst",
                filters: inner_filters,
                any_of: [],
                min_matches: 'None,
            },
        ],
        having: [],
        group_count: 'None,
        time_windows: 'None,
    }
};

