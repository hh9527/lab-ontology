    @ev::rename("1")
    @ev::description("Normal", "正常")
    Normal,
    @ev::rename("2")
    @ev::description("Faulty", "故障")
    Faulty,
};
def SourceFCSwitchDeviceHealthStatus_domain: v::Domain(SourceFCSwitchDeviceHealthStatus, String) = v::from_enum(
    "SourceFCSwitchDeviceHealthStatus",
    SourceFCSwitchDeviceHealthStatus.type,
    String.type,
    False
);

@knowledge_policy::reverse_references(True)
type SourceFCSwitchDeviceConnectStatus = enum {
    @ev::itag(0)
    @ev::description("offline", "离线")
    Offline,
    @ev::itag(1)
    @ev::description("online", "在线")
    Online,
    @ev::itag(9)
    @ev::description("Disconnected", "连接失败")
    Disconnected,
};
def SourceFCSwitchDeviceConnectStatus_domain: v::Domain(SourceFCSwitchDeviceConnectStatus, Int) = v::from_enum(
    "SourceFCSwitchDeviceConnectStatus",
    SourceFCSwitchDeviceConnectStatus.type,
    Int.type,
    False
);
def declaration: t::Declaration = registry::declaration(FCSwitchDevice.type);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_FCSwitchDevice_EnterprisePhysicalLink_a",
        dataset,
        subject,
        link::dataset,
        a_reference,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_FCSwitchDevice_EnterprisePhysicalLink_z",
        dataset,
        subject,
        link::dataset,
        z_reference,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_FCSwitchDevice_T_CURRENT_ALARM",
        dataset,
        subject,
        alarm::dataset,
        alarm_reference,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_FCSwitchDevice_X_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        cardinality
    ),
];
def alternatives: Array(t::Alternative) = [
    {
        id: "source_FCSwitchDevice_X_SITE_VIEW",
        cardinality,
        choices: [
            r::relation(
                "fc_parent_site",
                dataset,
                parent_site,
                site::dataset,
                site::subject,
                cardinality
            ),
            r::relation(
                "fc_project_site",
                dataset,
                project_site,
                site::dataset,
                site::subject,
                cardinality
            ),
        ]
    }
];
pub use self::{
    FcSwitchId,
    Identity,
    entity,
    FCSwitchDevice,
    dataset,
    subject,
    alarm_reference,
    a_reference,
    z_reference,
    declaration,
    relations,
    alternatives
};
