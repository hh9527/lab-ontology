@edsl::entity_source("dense_hub", "dh")
@edsl::relation(DenseL1.type, fanout_kind, 0, 0)
@edsl::relation(DenseL2.type, fanout_kind, 0, 0)
@edsl::relation(DenseL3.type, fanout_kind, 0, 0)
@edsl::relation(DenseL4.type, fanout_kind, 0, 0)
@edsl::relation(DenseL5.type, fanout_kind, 0, 0)
@edsl::relation(DenseL6.type, fanout_kind, 0, 0)
type DenseHub = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_source("dense_leaf_1", "l1")
@edsl::relation(DenseHub.type, safe_kind, 0, 0)
@edsl::relation(DenseL2.type, fanout_kind, 0, 0)
type DenseL1 = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
