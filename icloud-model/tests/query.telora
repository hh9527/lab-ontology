pub def offline_matches_both_wire_values: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"list","measures":[],"dimensions":["device_id"],"filters":[{"dimension":"device_commu_state","op":"eq","kind":"text","value":"offline"}],"ordering":[],"limit":null,"offset":null}`);
    if q.bindings == [qb::Val::String("1"), qb::Val::String("offline")]
        && array::length(string::split(q.sql, " OR ")) > 1 {
        True
    } else {
        fail!("offline must match both physical values", q)
    }
});

pub def canonical_projection_returns_business_ids: test::Test = test::should_ok(fn() {
