pub def q0392_fan_qualification_counts_alarm_identities: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_event_component","measures":["alarm_count"],"dimensions":[],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"server_device","event_relation":"server_current_alarm","component_relation":"fan_parent_server","owner_tenant_relation":"server_belongs_to_tenant","component_tenant_relation":"fan_belongs_to_tenant","owner_filters":[{"dimension":"server_class","op":"eq","kind":"text","value":"kunlun"}],"component_filters":[{"dimension":"server_fan_manufacturer","op":"eq","kind":"text","value":"Huawei"}],"window":{"dataset":"current_alarm","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"}}`);
    if array::length(string::split(q.sql, "count(a.CSN)")) == 2
        && array::length(string::split(q.sql, "JOIN PhysicalServerFan")) == 1
        && array::length(string::split(q.sql, "EXISTS (SELECT 1 FROM PhysicalServerFan")) > 1 {
        True
    } else { fail!("fan-qualified event count must retain event grain", q) }
});

pub def q0396_groups_fan_qualified_alarms_by_hidden_server_identity: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_event_component","measures":["alarm_count"],"dimensions":["server_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"server_device","event_relation":"server_current_alarm","component_relation":"fan_parent_server","owner_tenant_relation":"server_belongs_to_tenant","component_tenant_relation":"fan_belongs_to_tenant","owner_filters":[{"dimension":"server_class","op":"eq","kind":"text","value":"kunlun"}],"component_filters":[{"dimension":"server_fan_manufacturer","op":"eq","kind":"text","value":"Huawei"}],"window":{"dataset":"current_alarm","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"}}`);
    if array::length(string::split(q.sql, "SELECT count(a.CSN) AS alarm_count, sv.name")) > 1
        && array::length(string::split(q.sql, "GROUP BY sv.name, sv.id, sv.tenantId")) > 1
        && array::length(string::split(q.sql, "EXISTS (SELECT 1 FROM PhysicalServerFan")) > 1 {
        True
    } else { fail!("fan-qualified alarm counts must group by hidden complete server identity", q) }
});

