use crate::model::{ payload };
use ontology::knowledge as knowledge;
use std::value::{ Value };
use std::test as test;

pub def cached_index_preserves_catalog_order_and_pagination: test::Test = test::should_ok(fn() {
    let index = knowledge::knowledge_index_method_factory(payload, "public");
    let input = Value::Object({offset: Value::Int(7), limit: Value::Int(3)});
    let cached = index(input);
    let original = knowledge::serve_value(payload, "public", "ic",
        Value::Object({method: Value::String("index.ic"), input}));
    if cached == original { True }
    else { fail!("cached knowledge index changed topic order or page boundary", cached, original) }
});
