# om-labflow 知识准备
#
# 一次性收集领域模型（src/model.telora）的 property，建立实体/指标/维度/
# 关系索引，预计算安全路径，并发布 PreparedPayload。业务 lowering 只消费
# 这个 payload，不重新扫描 metadata。

import "@src/model" { TimelineEvent, ActionPath };
import "ontology/edsl" as edsl;
import "query/lib" as qb;

# 公共能力 profile：QueryBuilder 的完整标准能力子集。
def profile: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Join, 'Group, 'Order, 'Limit,
    ],
    allowed_join_kinds: ['Inner, 'Left],
    allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
    allowed_scalars: ['Substr, 'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not],
    allow_distinct: 'True,
};

# v1 的授权主体。未来可以替换为真实身份来源，但保持同一个签名边界。
def authorize: Fn(String) -> Bool = fn(subject) { subject == "analyst" };

def payload: edsl.PreparedPayload = edsl.build_root(
    "om-labflow-v1",
    [TimelineEvent, ActionPath],
    profile,
    authorize,
);

export { payload, profile, authorize };
