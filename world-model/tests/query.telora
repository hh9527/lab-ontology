        _ => 'False,
    };
    let third_is_english = match q.bindings[2] {
        'String(s) => s == "English",
        _ => 'False,
    };
    let fourth_is_five = match q.bindings[3] {
        'Int(n) => n == 5,
        _ => 'False,
    };
    if ok_sql && ok_binds && first_is_district && second_is_t && third_is_english && fourth_is_five { 'True } else { fail!("related_hidden_row_order binding order failed") }
};

