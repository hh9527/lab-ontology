# 网络光模块来源：未声明唯一键，不推断设备与接口的复合身份。
use super::inventory as i;
use ontology::model as m;
use ontology::transform as t;
type Row = struct {
    source_neResId: String,
    source_version: String,
    source_vendorPn: String,
    source_vendorName: String,
    source_vendorSn: String,
    source_ifName: String,
    source_projectId: String,
};
def dataset: m::Dataset(Row) = m::dataset("source_EnterpriseOpticalModule", "I_EnterpriseOpticalModule", Row.type, []);
def declaration: t::Declaration = t::map_columns(t::declare(dataset, [], [
    i::exact(dataset, m::field(Row.type, String.type, "source_neResId"), "source_EnterpriseOpticalModule__neResId"),
    i::search(dataset, m::field(Row.type, String.type, "source_version"), "source_EnterpriseOpticalModule__version"),
    i::search(dataset, m::field(Row.type, String.type, "source_vendorPn"), "source_EnterpriseOpticalModule__vendorPn"),
    i::search(dataset, m::field(Row.type, String.type, "source_vendorName"), "source_EnterpriseOpticalModule__vendorName"),
    i::search(dataset, m::field(Row.type, String.type, "source_vendorSn"), "source_EnterpriseOpticalModule__vendorSn"),
    i::search(dataset, m::field(Row.type, String.type, "source_ifName"), "source_EnterpriseOpticalModule__ifName"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "source_EnterpriseOpticalModule__projectId"),
], []), [
    t::column(m::field(Row.type, String.type, "source_neResId"), "neResId"),
    t::column(m::field(Row.type, String.type, "source_version"), "version"),
    t::column(m::field(Row.type, String.type, "source_vendorPn"), "vendorPn"),
    t::column(m::field(Row.type, String.type, "source_vendorName"), "vendorName"),
    t::column(m::field(Row.type, String.type, "source_vendorSn"), "vendorSn"),
    t::column(m::field(Row.type, String.type, "source_ifName"), "ifName"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
]);
pub use self::{declaration};
