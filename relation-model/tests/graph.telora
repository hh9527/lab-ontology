pub def empty_group_count_narrows_nullable_child_with_exists: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"tenant", "include_empty":true,
        "nodes":[{"id":"tenant","entity":"tenant"},{"id":"device","entity":"device"}],
        "edges":[{"relation":"device_tenant","from":"device","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"device",
        "exists":[{"anchor":"device","nodes":[{"id":"site","entity":"site"}],
            "edges":[{"relation":"device_site","from":"device","to":"site"}]}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "LEFT JOIN devices AS device ON (device.tenant_id = tenant.id AND EXISTS (SELECT 1 FROM sites AS site")
        && string::contains(pg.sql, "LEFT JOIN \"devices\" AS \"device\" ON (\"device\".\"tenant_id\" = \"tenant\".\"id\" AND EXISTS (SELECT 1 FROM \"sites\" AS \"site\"")
        && !string::contains(sq.sql, " WHERE EXISTS") {
        True
    } else { fail!("nullable child existence must narrow the LEFT JOIN, not remove empty tenant groups", sq, pg) }
});

pub def empty_group_count_filters_nullable_ancestor_with_exists: test::Test = test::should_ok(fn() {
    let ast = lower(json::parse(r#"{
