type TypeField = struct {
    name: String,
    type: String
};
type TypeVariant = struct {
    name: String,
    payload: Option(String)
};
type RolePart = struct {
    source: String,
    target: String,
    type: String,
    nullable: Bool,
    raw: Option(String)
};
type RolePair = struct {
    from: String,
    to: String
};
type BindingMember = struct {
    local: String,
    publish: String,
    input: Value,
    type: String,
    nullable: Bool,
    aggregate: Option(crate::query::AggregateFunction),
    projectable: Bool,
    filters: Array(g::Filter),
    kind: g::MemberKind
};
type Fact = struct {
    key: String,
    value: Value,
    references: Array(String)
};
def object: Fn(Array((String, Value))) -> Value = fn(pairs) {
    Value::Object(dict::from_pairs(pairs))
};
def ref: Fn(String, String) -> String = fn(root, id) {
    `\{root}/\{uri::encode_component(id)}`
};
def type_ids: memo::TypeMemorizer(String) = memo::type_memorizer(compute_type_id);
def type_id: Fn(Type) -> String = fn(ty) {
    memo::computed_with_type(type_ids, ty)
};
def compute_type_id: Fn(Type) -> String = fn(ty) {
    match td::name(ty) {
        Some(name) => if td::children(ty) == [] {
            name
        } else {
            json::stringify(codec::encode((name, array::map(td::children(ty), type_id))))
        },
        None => {
            let kind = td::kind(ty);
            let children = array::map(td::children(ty), type_id);
            let fields = if kind == td::TypeDescKind::Struct {
                array::map(
                    td::fields(ty),
                    fn(f) {
                        f.name
                    }
                )
            } else {
                []
            };
            let variants = if kind == td::TypeDescKind::Enum {
                array::map(
                    td::variants(ty),
                    fn(v) {
                        v.name
                    }
                )
            } else {
                []
            };
            match kind {
                td::TypeDescKind::Int => "Int",
                td::TypeDescKind::Float => "Float",
                td::TypeDescKind::String => "String",
                td::TypeDescKind::Bytes => "Bytes",
                td::TypeDescKind::Never => "Never",
                td::TypeDescKind::Type => "Type",
                _ => `shape:\{hash::sha256(json::stringify(codec::encode((kind, children, fields, variants))))}`,
            }
        },
    }
};
# 具名类型保留身份；只有内置标量／容器使用内联表达式。
# Option 的公开反射形状是匿名 None/Some 枚举，具名枚举的 kind 为 Ref。
def inline_type: Fn(Type) -> Bool = fn(ty) {
    ty == Int.type || ty == Float.type || ty == Bool.type || ty == String.type || td::kind(ty) == td::TypeDescKind::Array || td::kind(
        ty
    ) == td::TypeDescKind::Dict || (
        td::kind(ty) == td::TypeDescKind::Enum && td::name(ty) == None && array::length(
            td::children(ty)
        ) == 1 && array::map(
            td::variants(ty),
            fn(v) {
                v.name
            }
        ) == ["None", "Some"]
    )
};
def type_ref: Fn(Type) -> String = fn(ty) {
    if ty == Int.type {
        "Int"
    } else if ty == Float.type {
        "Float"
    } else if ty == Bool.type {
        "Bool"
    } else if ty == String.type {
        "String"
    } else if inline_type(ty) {
        let constructor = if td::kind(ty) == td::TypeDescKind::Array {
            "Array"
        } else if td::kind(ty) == td::TypeDescKind::Dict {
            "Dict"
        } else {
            "Option"
        };
        `\{constructor}(\{string::join(array::map(td::children(ty), type_ref), ", ")})`
    } else {
        ref("types", type_id(ty))
    }
};
# 容器没有节点；其中引用的模型类型仍然有明确的引用边。
def resolved: Fn(Type) -> Type = fn(ty) {
    if td::kind(ty) == td::TypeDescKind::Ref {
        match td::resolve(ty) {
            Ok(body) => body,
            Err(error) => fail!(error.message, ty)
        }
    } else {
        ty
    }
};
def type_dependencies: Fn(Type) -> Array(Type) = fn(ty) {
    let body = resolved(ty);
    array::concat(
        [
            td::children(ty),
            if body != ty {
                [body]
            } else {
                []
            },
            if td::kind(body) == td::TypeDescKind::Struct {
                array::map(
                    td::fields(body),
                    fn(f) {
                        f.ty
                    }
                )
            } else if td::kind(body) == td::TypeDescKind::Enum {
                array::flat_map(
                    td::variants(body),
                    fn(v) {
                        match v.payload {
                            Some(p) => [p],
                            None => []
                        }
                    }
                )
            } else {
                td::children(body)
            }
        ]
    )
};
def column: Fn(g::Column) -> Value = fn(c) {
    object(
        [
            ("name", codec::encode(c.name)),
            ("type", codec::encode(type_ref(c.value))),
            ("nullable", codec::encode(c.nullable))
        ]
    )
};
def expression_types: Fn(g::Node) -> Array(Type) = fn(node) {
    match node {
        g::Node::Column(c) => [c.value],
        g::Node::Seconds(input) => expression_types(input),
        g::Node::Ipv4(input) => expression_types(input),
        g::Node::UtcBucket(b) => expression_types(b.input),
        g::Node::Rate(inputs) => array::concat(
            [expression_types(inputs.amount), expression_types(inputs.duration)]
        ),
        g::Node::Identity(input) => array::concat(
            [
                [input.column.value],
                array::map(
                    input.parts,
                    fn(c) {
                        c.value
                    }
                )
            ]
        ),
    }
};
def group_root: Fn(g::BindingFacts) -> String = fn(binding) {
    match binding.contract {
        g::BindingContract::Transfer(_) => "measure_groups",
        g::BindingContract::Numeric(_) => "measure_groups",
        _ => "dimension_groups"
    }
};
def field_business_roles: Fn(
    t::Declaration,
    edsl::EntityEntry,
    edsl::FieldEntry,
    Array(edsl::ReferenceSpec)
) -> Array(edsl::FieldRole) = fn(d, dataset, field, references) {
    let roles = edsl::field_roles_for(d.dataset.row, field, references);
    if array::any(
        d.samples,
        fn(sample) {
            sample.field == field.name
        }
    ) && !array::any(
        roles,
        fn(role) {
            role == edsl::FieldRole::Metric
        }
    ) {
        array::push(roles, edsl::FieldRole::Metric)
    } else {
        roles
    }
};
def raw_relation_key: Fn(edsl::EntityEntry, edsl::EntityEntry, edsl::RelationKey) -> Value = fn(
    from,
    to,
    key
) {
    match key {
        edsl::RelationKey::Eq(pair) => object(
            [
                ("op", Value::String("eq")),
                ("from", codec::encode(from.fields[pair.from].name)),
                ("to", codec::encode(to.fields[pair.to].name))
            ]
        ),
        edsl::RelationKey::And(keys) => object(
            [
                ("op", Value::String("and")),
                (
                    "inputs",
                    Value::Array(
                        array::map(
                            keys,
                            fn(k) {
                                raw_relation_key(from, to, k)
                            }
                        )
                    )
                )
            ]
        ),
        edsl::RelationKey::Or(keys) => object(
            [
                ("op", Value::String("or")),
                (
                    "inputs",
                    Value::Array(
                        array::map(
                            keys,
                            fn(k) {
                                raw_relation_key(from, to, k)
                            }
                        )
                    )
                )
            ]
        ),
    }
};
type LocalCapabilities = struct {
    dimensions: Array(Value),
    measures: Array(Value)
};
def local_capabilities: Fn(edsl::PreparedPayload) -> LocalCapabilities = fn(payload) {
    let dims = array::map(
        payload.dimensions,
        fn(d) {
            object(
                [
                    ("dataset", codec::encode(payload.entities[d.entity].id)),
                    ("id", codec::encode(d.id)),
                    ("authorized", codec::encode(d.authorized)),
                    ("projectable", codec::encode(d.projectable)),
                    ("filterable", codec::encode(d.filterable)),
                    ("ops", codec::encode(d.ops)),
                    ("input_kinds", codec::encode(d.input_kinds)),
                    ("output_type", codec::encode(d.output_type)),
                    ("computed", codec::encode(d.computed)),
                    ("utc_bucket", codec::encode(d.utc_bucket)),
                    ("canonical_values", codec::encode(d.canonical_values)),
                    ("canonical_order", codec::encode(d.canonical_order)),
                    ("half_open", codec::encode(d.half_open)),
                    ("field", codec::encode(payload.entities[d.entity].fields[d.field].name))
                ]
            )
        }
    );
    let measures = array::map(
        payload.measures,
        fn(m) {
            object(
                [
                    ("dataset", codec::encode(payload.entities[m.entity].id)),
                    ("id", codec::encode(m.id)),
                    ("anchor_field", codec::encode(payload.entities[m.entity].fields[m.field].name)),
                    ("aggregate", codec::encode(m.aggregate)),
                    ("predicate", codec::encode(match m.predicate { Some(predicate) => Some(predicate.scope), None => None })),
                    ("computed", codec::encode(m.computed)),
                    (
                        "sampling",
                        codec::encode(
                            array::find(
                                payload.entities[m.entity].sample_measures,
                                fn(s) {
                                    s.id == m.id
                                }
                            )
                        )
                    )
                ]
            )
        }
    );
    {dimensions: dims, measures}
};
def raw_capabilities_with_local: Fn(edsl::PreparedPayload, LocalCapabilities) -> Value = fn(
    payload,
    local
) {
    let relations = array::map(
        payload.relations,
        fn(r) {
            object(
                [
                    ("id", codec::encode(r.id)),
                    ("from_dataset", codec::encode(payload.entities[r.from].id)),
                    ("to_dataset", codec::encode(payload.entities[r.to].id)),
                    ("cardinality", codec::encode(r.cardinality)),
                    (
                        "key",
                        raw_relation_key(payload.entities[r.from], payload.entities[r.to], r.key)
                    ),
                    ("guard", codec::encode(edsl::guard_information(r.guard)))
                ]
            )
        }
    );
    let links = array::map(
        payload.business_links,
        fn(l) {
            object(
                [
                    ("id", codec::encode(l.id)),
                    ("hub", codec::encode(payload.entities[l.hub].id)),
                    ("participant", codec::encode(payload.entities[l.participant].id)),
                    ("a_relation", codec::encode(l.a_relation)),
                    ("z_relation", codec::encode(l.z_relation)),
                    ("direction", codec::encode(l.direction)),
                    ("guard", codec::encode(edsl::guard_information(l.guard)))
                ]
            )
        }
    );
    object(
        [
            ("dimensions", Value::Array(local.dimensions)),
            ("measures", Value::Array(local.measures)),
            ("relations", Value::Array(relations)),
            ("links", Value::Array(links))
        ]
    )
};
def raw_endpoint: Fn(String, String) -> Value = fn(dataset, role) {
    object([("dataset", codec::encode(dataset)), ("role", codec::encode(role))])
};
def raw_relation_sources: Fn(t::Prepared) -> Value = fn(prepared) {
    object(
        [
            (
                "relations",
                Value::Array(
                    array::map(
                        prepared.relations,
                        fn(r) {
                            object(
                                [
                                    ("id", codec::encode(r.id)),
                                    ("from", raw_endpoint(r.from.dataset.id, r.from.role)),
                                    ("to", raw_endpoint(r.to.dataset.id, r.to.role))
                                ]
                            )
                        }
                    )
                )
            ),
            (
                "alternatives",
                Value::Array(
                    array::map(
                        prepared.alternatives,
                        fn(a) {
                            object(
                                [
                                    ("id", codec::encode(a.id)),
                                    (
                                        "choices",
                                        Value::Array(
                                            array::map(
                                                a.choices,
                                                fn(r) {
                                                    object(
                                                        [
                                                            (
                                                                "from",
                                                                raw_endpoint(
                                                                    r.from.dataset.id,
                                                                    r.from.role
                                                                )
                                                            ),
                                                            (
                                                                "to",
                                                                raw_endpoint(
                                                                    r.to.dataset.id,
                                                                    r.to.role
                                                                )
                                                            )
                                                        ]
                                                    )
                                                }
                                            )
                                        )
                                    )
                                ]
                            )
                        }
                    )
                )
            )
        ]
    )
};
