# ---------------------------------------------------------------------------
# Public request vocabulary.
# ---------------------------------------------------------------------------
# Each endpoint counts matches on that side for one instance on the other side.
type Cardinality = enum {
    One,
    Optional,
    Many0,
    Many1
};
type RelationCardinality = struct {
    from: Cardinality,
    to: Cardinality
};

def cardinality_at_most_one: Fn(Cardinality) -> Bool = fn(value) {
    value == Cardinality::One || value == Cardinality::Optional
};

def relation_preserves_grain: Fn(RelationEntry, Bool) -> Bool = fn(relation, forward) {
    cardinality_at_most_one(
        if forward {
            relation.cardinality.to
        } else {
            relation.cardinality.from
        }
    )
};

# A graph query names entity instances separately from entity types. Each edge
# references a declared relation, whose from/to roles remain authoritative.
type GraphNode = struct {
    id: String,
    entity: String
};
type GraphEdge = struct {
    relation: String,
    from: String,
    to: String
};
type GraphSelect = struct {
    node: String,
    dimension: String
};
type GraphMeasureSelect = struct {
    node: String,
    measure: String
};
type GraphFilter = struct {
    node: String,
    request: FilterRequest
};
type GraphAnyOf = struct {
    node: String,
    dimension: String,
    values: Array(FilterInput)
};
type GraphHaving = struct {
    node: String,
    measure: String,
    op: FilterOp,
    threshold: FilterInput
};
type GraphCountHaving = struct {
    op: FilterOp,
    threshold: Int
};
type GraphExist = struct {
    anchor: String,
    nodes: Array(GraphNode),
    edges: Array(GraphEdge),
    constraints: Array(GraphEdge),
    filters: Array(GraphFilter),
    any_of: Array(GraphAnyOf),
    having: Array(GraphHaving),
    negated: Bool
};
type GraphTopPer = struct {
    owner: String,
    sample: String,
    rank: String,
    take: Int
};
type GraphTopMeasure = struct {
    node: String,
    measure: String,
    direction: qb::Ordering,
    take: Int
};
type GraphOrder = struct {
    node: String,
    dimension: String,
    direction: qb::Ordering
};
type GraphRowGrain = enum {
    Root,
    Association
};
type GraphRequest = struct {
    root: String,
    row_grain: GraphRowGrain,
    distinct: Bool,
    nodes: Array(GraphNode),
    edges: Array(GraphEdge),
    constraints: Array(GraphEdge),
    select: Array(GraphSelect),
    measures: Array(GraphMeasureSelect),
    filters: Array(GraphFilter),
    any_of: Array(GraphAnyOf),
    exists: Array(GraphExist),
    count: Option(String),
    count_value: Option(GraphSelect),
    count_having: Option(GraphCountHaving),
    measure_having: Array(GraphHaving),
    count_groups: Bool,
    include_empty: Bool,
    group_by_identity: Array(String),
    top_per: Option(GraphTopPer),
    top_by_measure: Option(GraphTopMeasure),
    order_by: Array(GraphOrder),
    take: Option(Int),
};

# Filter operations. Comparison ops map to the closed query scalars
# (FilterOp.Eq/FilterOp.Ne/FilterOp.Gt/FilterOp.Ge/FilterOp.Lt/FilterOp.Le); text ops (FilterOp.Contains/FilterOp.NotContains/FilterOp.StartsWith/
# FilterOp.EndsWith) lower through the closed qb.ScalarFunction.Instr/qb.ScalarFunction.Lower/qb.ScalarFunction.Length/qb.ScalarFunction.Substr/qb.ComputedOp.Add/qb.ComputedOp.Sub
# vocabulary and always keep the runtime value in a parameterized Bind.
type FilterOp = enum {
    Eq,
    Ne,
    Gt,
    Ge,
    Lt,
    Le,
    Contains,
    NotContains,
    StartsWith,
    EndsWith,
    InSubnet,
    NotInSubnet,
};

@prelude::property(PropertyTarget::Variant)
type VariantDoc = struct {
    text: String
};

def doc: Fn(String) -> Fn(property::VariantPropertyCtx, Option(VariantDoc)) -> VariantDoc = fn(text) {
    fn(ctx, previous) {
        {text}
    }
};

type FilterInputKind = enum {
    @doc(
        "IPv4 address stored as canonical dotted decimal: four octets 0..255, no leading zeros. Eq/Ne take an address; InSubnet/NotInSubnet take a canonical CIDR network with /0..32 and zero host bits. IPv6 is not supported."
    )
    Ipv4,
    Text,
    Number,
    Int,
    Bool,
    @doc(
        "UTC instant with millisecond precision. Canonical format: YYYY-MM-DDTHH:MM:SS.SSSZ; input accepts seconds or 1..3 fractional digits. Example: \"2026-09-20T16:00:00.000Z\". PostgreSQL uses timestamptz; SQLite uses this normalized text format."
    )
    DateTimeUtc,
    EpochMillis,
    @doc(
        "Calendar date without timezone or time of day. Format: YYYY-MM-DD. PostgreSQL uses date; SQLite uses normalized date text."
    )
    Date,
    DateTime,
};

type FilterInputDoc = struct {
    kind: FilterInputKind,
    text: String
};

def filter_input_doc_entries: Array((String, String)) = array::flat_map(
    td::variants(FilterInputKind.type),
    fn(variant) {
        match property::get_variant_prop(FilterInputKind.type, variant.index, VariantDoc.type) {
            Some(note) => [(variant.name, note.text)],
            None => [],
        }
    }
);

def filter_input_docs: Fn(Array(FilterInputKind)) -> Array(FilterInputDoc) = fn(kinds) {
    array::flat_map(
        kinds,
        fn(kind) {
            let name = codec::encode(kind);
            array::flat_map(
                filter_input_doc_entries,
                fn(entry) {
                    if Value::String(entry.0) == name {
                        [{kind, text: entry.1}]
                    } else {
                        []
                    }
                }
            )
        }
    )
};

type FilterInput = enum {
    Ipv4Subnet(String),
    Ipv4(String),
    Unknown(String),
    Unknowns,
    Text(String),
    Number(Float),
    Int(Int),
    Bool(Bool),
    DateTimeUtc(String),
    EpochMillis(Int),
    Date(String),
    DateTime(String),
};

# A member's inherent row-range scope predicate: a constraint on one field of
# the member's own entity (stable field name, filter op, literal value).
# Scope predicates always lower to parameterized bindings.
type ScopePredicate = struct {
    field: String,
    op: FilterOp,
    input: FilterInput,
};

type FilterRequest = struct {
    id: String,
    op: FilterOp,
    input: FilterInput,
};

