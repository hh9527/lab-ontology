}, "sample qualification requires a named safe sample-to-owner relation");

def bounded_sample_plan: Fn(edsl::PreparedPayload) -> qb::Plan = fn(knowledge) {
    let qualification: edsl::SampleQualification = {
        relation: "device_kpi_of_device", dataset: "device_kpi", filters: [],
        start: "2024-02-01T00:00:00Z", end: "2024-03-01T00:00:00Z", min_matches: 0,
    };
    edsl::lower_sample_count_ranges(knowledge,
        {measures: [], dimensions: [{id: "device_name", subject: "public", input: edsl::DimensionInput::None}],
         filters: [], ordering: [], limit: None, offset: None, partition: None},
        [{qualification, min_matches: 0, max_matches: 4}])
};

pub def bounded_sample_count_rejects_missing_owner_tenant_key: test::Test = test::should_fail_with(fn() {
    let relations = array::map(payload.relations, fn(relation) {
        if relation.id == "device_kpi_of_device" {
            let key = match relation.key {
                edsl::RelationKey::And(keys) => match array::get(keys, 0) {
                    Some(first) => first,
                    None => fail!("missing sample owner key"),
                },
                _ => fail!("expected compound sample owner key"),
            };
            {...relation, key}
        } else { relation }
    });
    bounded_sample_plan({...payload, relations})
}, "sample-to-owner relation must cover the owner's complete declared grain");

pub def bounded_sample_count_rejects_fanout_owner_relation: test::Test = test::should_fail_with(fn() {
