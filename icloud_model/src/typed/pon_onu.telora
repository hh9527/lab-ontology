use super::pon_olt as olt;
use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# PON 独立声明：保留来源、时间假定和固有角色范围。
use super::inventory as i;
use super::site as site;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::scalars as s;
use ontology::relations as r;
use ontology::ontology as edsl;
use super::pon_device as p;
@registry::dataset("pon_onu_role", "I_EntPonElement", ["id"])
@registry::roles([subject, parent])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(IEntPonElement.type, String.type, "source_ipAddress"))),
            "pon_onu_role__ipAddress_ipv4",
            True,
            g::ipv4_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_onu_role__manufactureDate_time",
                s::Date.type,
                True,
                g::time_filters
            ),
            g::input(m::field(IEntPonElement.type, s::Date.type, "source_manufactureDate")),
            "pon_onu_role__manufactureDate",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "pon_onu_role__createTime_time",
                s::EpochMillis.type,
                True,
                g::time_filters
            ),
            g::input(m::field(IEntPonElement.type, s::EpochMillis.type, "source_createTime")),
            "pon_onu_role__createTime",
            True,
            g::time_filters
        ),
    ]
)
@registry::scope(
    [
        registry::scope_equal(
            dataset,
            m::field(IEntPonElement.type, String.type, "classification"),
            "Onu"
        )
    ]
)
@registry::relations(
    [
        r::relation(
            "pon_onu_parent_olt",
            r::endpoint(dataset.row, parent.id),
            r::endpoint(olt::dataset.row, olt::subject.id),
            {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
        )
    ]
)
type IEntPonElement = struct {
    @g::exact("pon_onu_id")
    id: p::PonId,
    @g::search("pon_onu_name")
    name: String,
    @m::column("parentOltResId")
    parent_olt_res_id: p::PonId,
    @v::field_domain(PonOnuClass_domain, "pon_onu_class", False, [g::Filter::Eq])
    classification: String,
    @m::column("version")
    @g::search("pon_onu_role__version")
    source_version: String,
    @m::column("ipAddress")
    @g::search("pon_onu_role__ipAddress")
    source_ipAddress: String,
    @m::column("mac")
    @g::search("pon_onu_role__mac")
    source_mac: String,
    @m::column("sn")
    @g::search("pon_onu_role__sn")
    source_sn: String,
    @m::column("manufacturer")
    @g::search("pon_onu_role__manufacturer")
    source_manufacturer: String,
    @m::column("manufactureDate")
    source_manufactureDate: s::Date,
    @m::column("adminState")
    @v::classification(p::PonDeviceAdminState_domain, "pon_onu_role__adminState")
    source_adminState: String,
    @m::column("alias")
    @g::search("pon_onu_role__alias")
    source_alias: String,
    @m::column("productName")
    @g::search("pon_onu_role__productName")
    source_productName: String,
    @m::column("commuState")
    @v::classification(p::PonCommuState_domain, "pon_onu_role__commuState")
    source_commuState: String,
    @m::column("refParentSubnet")
    @g::exact("pon_onu_role__refParentSubnet")
    source_refParentSubnet: i::SiteId,
    @m::column("tenantId")
    @g::exact("pon_onu_role__tenantId")
    source_tenantId: i::TenantId,
    @m::column("createTime")
    source_createTime: s::EpochMillis,
    @m::column("remark")
    @g::search("pon_onu_role__remark")
    source_remark: String,
    @m::column("nePatchVersion")
    @g::search("pon_onu_role__nePatchVersion")
    source_nePatchVersion: String,
    @m::column("neOsVersion")
    @g::search("pon_onu_role__neOsVersion")
    source_neOsVersion: String,
    @m::column("esn")
    @g::search("pon_onu_role__esn")
    source_esn: String,
    @m::column("projectId")
    @g::exact("pon_onu_role__projectId")
    source_projectId: i::SiteId,
};
def dataset: m::Dataset(IEntPonElement) = registry::dataset_of(IEntPonElement.type);
def subject: m::Role(IEntPonElement) = m::role(
    dataset,
    p::entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(IEntPonElement.type, p::PonId.type, "id"),
            m::field(p::Identity.type, p::PonId.type, "id")
        )
    ]
);
def parent: m::Role(IEntPonElement) = m::role(
    dataset,
    p::entity,
    "parent",
    False,
    [
        m::identity_part(
            m::field(IEntPonElement.type, p::PonId.type, "parent_olt_res_id"),
            m::field(p::Identity.type, p::PonId.type, "id")
        )
    ]
);
@knowledge_policy::reverse_references(True)
type PonOnuClass = enum {
    @ev::rename("ne.category.pon.onu")
    Onu,
    @ev::rename("ne.category.pon.spl")
    @ev::description("GPON", "")
    Spl,
};
def PonOnuClass_domain: v::Domain(PonOnuClass, String) = v::from_enum(
    "PonOnuClass",
    PonOnuClass.type,
    String.type,
    False
);

pub use self::{dataset, subject, parent};

pub use self::{IEntPonElement};
