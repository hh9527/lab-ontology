use crate::typed::{payload};
use crate::typed::inventory as inventory;
use crate::model as baseline;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};

type Pair = struct {
    id: String,
    typed: qb::Query,
    baseline: qb::Query,
    postgres: qb::Query,
    columns: Array(intent::ResultColumn),
    baseline_columns: Array(intent::ResultColumn)
};
def pair: Fn(String, Value) -> Pair = fn(id, request) {
    let actual = intent::query_intent_ast_factory(payload)(request);
    let expected = intent::query_intent_ast_factory(baseline::payload)(request);
    {
        id,
        typed: sqlite::build_query(actual),
        baseline: sqlite::build_query(expected),
        postgres: postgres::build_query(actual),
        columns: intent::result_columns(payload, request, actual),
        baseline_columns: intent::result_columns(baseline::payload, request, expected)
    }
};
def source_case: Fn(String, String) -> Pair = fn(id, extra) {
    pair(
        id,
        json::parse(
            `{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"source_EntCollaborationElement"}],"edges":[],\{extra}}`
        ).unwrap!()
    )
};
def cases: Array(Pair) = array::concat(
    [
        array::map(
            array::filter(
                payload.dimensions,
                fn(dimension) {
                    payload.entities[dimension.entity].id == "source_EntCollaborationElement"
                }
            ),
            fn(dimension) {
                source_case(
                    `project_\{dimension.id}`,
                    `"select":[{"node":"c","dimension":"\{dimension.id}"}]`
                )
            }
        ),
        array::flat_map(
            array::filter(
                payload.dimensions,
                fn(dimension) {
                    payload.entities[dimension.entity].id == "source_EntCollaborationElement" && array::length(
                        dimension.canonical_values
                    ) > 0
                }
            ),
            fn(dimension) {
                array::flat_map(
                    dimension.canonical_values,
                    fn(member) {
                        array::map(
                            ["Eq", "Ne"],
                            fn(op) {
                                source_case(
                                    `filter_\{dimension.id}_\{member.id}_\{op}`,
                                    `"select":[{"node":"c","dimension":"source_EntCollaborationElement__id"}],"filters":[{"node":"c","dimension":"\{dimension.id}","op":"\{op}","value":"\{member.id}"}]`
                                )
                            }
                        )
                    }
                )
            }
        ),
        [
            source_case("count", r#""select":[],"count":"c""#),
            source_case(
                "window",
                r#""select":[],"count":"c","time_windows":[{"node":"c","dimension":"source_EntCollaborationElement__createTime","start":2000,"end":5000}]"#
            ),
            source_case(
                "status_groups",
                r#""select":[{"node":"c","dimension":"source_EntCollaborationElement__operState"}],"count":"c""#
            ),
            source_case(
                "class_groups",
                r#""select":[{"node":"c","dimension":"source_EntCollaborationElement__classification"}],"count":"c""#
            ),
            source_case(
                "tenant_groups",
                r#""select":[{"node":"c","dimension":"source_EntCollaborationElement__tenantId"}],"count":"c""#
            ),
            source_case(
                "name_search",
                r#""select":[{"node":"c","dimension":"source_EntCollaborationElement__id"}],"filters":[{"node":"c","dimension":"source_EntCollaborationElement__name","op":"Contains","value":"_%"}]"#
            ),
            source_case(
                "subnet",
                r#""select":[{"node":"c","dimension":"source_EntCollaborationElement__id"}],"filters":[{"node":"c","dimension":"source_EntCollaborationElement__ipAddress_ipv4","op":"InSubnet","value":"192.0.2.0/24"}]"#
            ),
            source_case(
                "not_subnet",
                r#""select":[{"node":"c","dimension":"source_EntCollaborationElement__id"}],"filters":[{"node":"c","dimension":"source_EntCollaborationElement__ipAddress_ipv4","op":"NotInSubnet","value":"192.0.2.0/24"}]"#
            ),
            pair(
                "tenant_relation",
                json::parse(
                    r#"{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"source_EntCollaborationElement"},{"id":"t","entity":"tenant"}],"edges":[{"relation":"source_EntCollaborationElement_X_TENANT_VIEW","from":"c","to":"t"}],"select":[{"node":"c","dimension":"source_EntCollaborationElement__id"},{"node":"t","dimension":"tenant_id"}]}"#
                ).unwrap!()
            ),
            pair(
                "alarm_rows",
                json::parse(
                    r#"{"op":"Graph","root":"c","row_grain":"Association","nodes":[{"id":"c","entity":"source_EntCollaborationElement"},{"id":"a","entity":"current_alarm"}],"edges":[{"relation":"source_EntCollaborationElement_T_CURRENT_ALARM","from":"c","to":"a"}],"select":[{"node":"c","dimension":"source_EntCollaborationElement__id"},{"node":"a","dimension":"alarm_csn"}]}"#
                ).unwrap!()
            ),
            pair(
                "alarm_exists",
                json::parse(
                    r#"{"op":"Graph","root":"c","nodes":[{"id":"c","entity":"source_EntCollaborationElement"}],"edges":[],"select":[],"count":"c","exists":[{"anchor":"c","nodes":[{"id":"a","entity":"current_alarm"}],"edges":[{"relation":"source_EntCollaborationElement_T_CURRENT_ALARM","from":"c","to":"a"}]}]}"#
                ).unwrap!()
            ),
            pair(
                "alarm_totals",
                json::parse(
                    r#"{"op":"Graph","root":"a","nodes":[{"id":"c","entity":"source_EntCollaborationElement"},{"id":"a","entity":"current_alarm"}],"edges":[{"relation":"source_EntCollaborationElement_T_CURRENT_ALARM","from":"c","to":"a"}],"select":[{"node":"c","dimension":"source_EntCollaborationElement__id"}],"measures":[{"node":"a","measure":"alarm_count"},{"node":"a","measure":"alarm_open_count"}]}"#
                ).unwrap!()
            ),
        ],
    ]
);
type Fixture = struct {
    cases: Array(Pair),
    schema: Value
};
pub def runtime_fixture: Value = codec::encode(
    {
        cases,
        schema: codec::encode(
            array::map(
                payload.entities,
                fn(entity) {
                    (
                        entity.id,
                        entity.table,
                        array::map(
                            entity.fields,
                            fn(field) {
                                (
                                    field.name,
                                    field.column,
                                    if field.ty == Int.type || field.ty == Bool.type {
                                        "INTEGER"
                                    } else if field.ty == Float.type {
                                        "REAL"
                                    } else {
                                        "TEXT"
                                    }
                                )
                            }
                        )
                    )
                }
            )
        )
    }.ty!(Fixture)
);
