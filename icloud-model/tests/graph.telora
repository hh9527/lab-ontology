pub def named_alarm_qualifies_independent_running_port_average: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"sample","entity":"device_kpi"}],
        "edges":[{"relation":"device_kpi_of_device","from":"sample","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"sample","measure":"running_port_sample_avg"}],
        "group_by_identity":["device"],
        "filters":[{"node":"device","dimension":"device_class","op":"eq","kind":"text","value":"LSW"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"device_kpi_ts_raw","op":"lt","kind":"text","value":"2025-02-01 00:00:00"}],
        "exists":[{"anchor":"device","nodes":[{"id":"alarm","entity":"current_alarm"}],
            "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
            "filters":[{"node":"alarm","dimension":"alarm_name","op":"eq","kind":"text","value":"deviceOffline"}]}]
    }"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "avg(sample.operStatusCount)")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM T_CURRENT_ALARM AS alarm")
        && string::contains(sq.sql, "alarm.ALARMNAME = ?")
        && string::contains(sq.sql, "device.id = alarm.MEDN AND device.tenant_id = alarm.TENANTID")
        && !string::contains(sq.sql, "JOIN T_CURRENT_ALARM")
        && string::contains(sq.sql, "GROUP BY device.name, device.id, device.tenant_id")
        && string::contains(pg.sql, "avg(\"sample\".\"operStatusCount\")")
        && sq.bindings == pg.bindings { True }
    else { fail!("named alarm qualification multiplied KPI samples or lost complete owner identity", sq, pg) }
});

