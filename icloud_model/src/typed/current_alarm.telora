            ),
            v::member(classes::AlarmResourceType::ServerEnclosure, ["ne.category.server.enclosure"]),
            v::member(
                classes::AlarmResourceType::ServerNeCategoryServerChassis,
                ["ne.category.server.chassis"]
            ),
            v::member(
                classes::AlarmResourceType::ServerNeCategoryServerHighdensity,
                ["ne.category.server.highdensity"]
            ),
            v::member(
                classes::AlarmResourceType::ServerNeCategoryServerLitechassisserver,
                ["ne.category.server.litechassisserver"]
            ),
            v::member(
                classes::AlarmResourceType::ServerNeCategoryServerOther,
                ["ne.category.server.other"]
            ),
            v::member(
                classes::AlarmResourceType::ServerNeCategoryServerBlade,
                ["ne.category.server.blade"]
            ),
            v::member(
                classes::AlarmResourceType::ServerNeCategoryServerSwitch,
                ["ne.category.server.switch"]
            ),
            v::member(
                classes::AlarmResourceType::ServerNeCategoryServerEdge,
                ["ne.category.server.edge"]
            ),
            v::member(classes::AlarmResourceType::StorageHuaweiStorageDevice, ["HuaweiStorage"]),
            v::member(classes::AlarmResourceType::StorageFibreChannelSwitch, ["FcSwitch"]),
            v::member(
                classes::AlarmResourceType::StorageThirdPartyStorageDevice,
                ["ThirdPartyStorage"]
            ),
            v::member(classes::AlarmResourceType::Collaboration, ["Collaboration"])
        ],
        classes::AlarmResourceType::Unknown
    )
    source_METYPE: String,
    @m::column("ORIGINSYSTEMTYPE")
    @g::field_view(
        g::dimension_group("alarm_source_ORIGINSYSTEMTYPE", String.type, True, [g::Filter::Eq]),
        "current_alarm__ORIGINSYSTEMTYPE_raw",
        True,
        [g::Filter::Eq]
    )
    @v::map_or(
        classes::AlarmOriginSystemKind.type,
        "current_alarm__ORIGINSYSTEMTYPE",
        [
            v::member(classes::AlarmOriginSystemKind::Nms, ["NMS"]),
            v::member(classes::AlarmOriginSystemKind::Ems, ["EMS"])
