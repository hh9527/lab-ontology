use std::seq as seq;
# EnterpriseKnowledge eDSL core (domain-independent).
#
# Provides:
#   - typed-property carriers for declaring enterprise knowledge on nominal
#     entity structs (physical columns, keys, measures, dimensions, computed
#     dimensions, entity sources, relations);
#   - graph lowering (lower_graph) over explicitly named nodes and relations.
#
# All Plan/PlanProfile/Query types come from this crate's query module.
use crate::query as qb;
use crate::property_contract as contract;
use std::array as array;
use std::pipeline as pipeline;
use std::dict as dict;
use std::diagnostics as diagnostics;
use std::codec as codec;
use std::json as json;
use std::value::{Value};
use std::type_desc as td;
use std::type_property as property;
use std::prelude as prelude;
use std::regex as regex;
use std::string as string;
use std::uri as uri;

@regex::parse_by(
    regex::compile(
        r"^(?P<year>[0-9]{4})-(?P<month>[0-9]{2})-(?P<day>[0-9]{2}) (?P<hour>[0-9]{2}):(?P<minute>[0-9]{2}):(?P<second>[0-9]{2})$"
    )
)
type CanonicalUtcParts = struct {
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int
};

@regex::parse_by(
    regex::compile(
        r"^(?P<year>[0-9]{4})-(?P<month>[0-9]{2})-(?P<day>[0-9]{2})T(?P<hour>[0-9]{2}):(?P<minute>[0-9]{2}):(?P<second>[0-9]{2})Z$"
    )
)
type DateTimeUtcParts = struct {
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int
};

@regex::parse_by(
    regex::compile(
        r"^(?P<year>[0-9]{4})-(?P<month>[0-9]{2})-(?P<day>[0-9]{2})T(?P<hour>[0-9]{2}):(?P<minute>[0-9]{2}):(?P<second>[0-9]{2})[.](?P<fraction>[0-9]{1,3})Z$"
    )
)
type DateTimeUtcMillisParts = struct {
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
    fraction: String
};

@regex::parse_by(regex::compile(r"^(?P<year>[0-9]{4})-(?P<month>[0-9]{2})-(?P<day>[0-9]{2})$"))
type CalendarDateParts = struct {
    year: Int,
    month: Int,
    day: Int
};

@regex::parse_by(
    regex::compile(
        r"^(?P<a>0|[1-9][0-9]{0,2})\.(?P<b>0|[1-9][0-9]{0,2})\.(?P<c>0|[1-9][0-9]{0,2})\.(?P<d>0|[1-9][0-9]{0,2})$"
    )
)
type Ipv4Parts = struct {
    a: Int,
    b: Int,
    c: Int,
    d: Int
};

# SQL-facing scalar result of a declared Model projection. This knowledge is
# checked before ontology lowering emits a set QueryPlan.
type OutputType = enum {
    Text,
    Integer,
    Number,
    Boolean
};

# ---------------------------------------------------------------------------
# Property carriers (declared on entity structs and their fields).
# ---------------------------------------------------------------------------
# Member-level: physical column mapping for a field.
@prelude::property(PropertyTarget::Field)
type ColumnMap = struct {
    column: String
};

type MeasureNote = struct {
    id: String,
    label: String,
    summary: String
};
@prelude::property(PropertyTarget::Field)
type MeasureDescriptions = struct {
    notes: Array(MeasureNote)
};

type DimensionNote = struct {
    id: String,
    label: String,
    summary: String
