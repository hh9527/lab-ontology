        "current_alarm__METYPE_raw",
        True,
        [g::Filter::Eq]
    )
    @v::map_or(
        classes::AlarmResourceType.type,
        "current_alarm__METYPE",
        [
            v::member(classes::AlarmResourceType::Switch, ["Switch"]),
            v::member(classes::AlarmResourceType::WirelessController, ["WirelessController"]),
