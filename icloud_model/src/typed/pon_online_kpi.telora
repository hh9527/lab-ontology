# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_device as pon;
use ontology::experimental::relations as r;
use ontology::ontology as edsl;
use super::pon_quantities as p;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::samples as samples;
use ontology::experimental::transform as t;
use ontology::query as qb;
type EffectiveCount = struct(Int);
# 仅沿用旧百分比尺度假定，尚未确认生产比例；不增加范围检查。
type AssumedOnlinePercent = struct(Float);
def online_statistics: samples::Group(AssumedOnlinePercent) = samples::group("reported_network_online", AssumedOnlinePercent.type, samples::Statistic::Mean, [samples::Statistic::Min, samples::Statistic::Max], Some("%"));
type Row = struct {
    source_ts: s::DateTimeUtc,
    source_resId: pon::PonId,
    source_tenantId: i::TenantId,
    source_parentId: String,
    source_projectId: String,
    source_onlineRate: AssumedOnlinePercent,
    source_onlineRateEffcnt: EffectiveCount,
};
def dataset: m::Dataset(Row) = m::dataset("source_PonDeviceOnlineKPI", "PonDeviceOnlineKPI", Row.type, ["source_resId", "source_tenantId", "source_ts"]);
def owner: m::Role(Row) = m::role(dataset, pon::entity, "owner", False, [m::identity_part(m::field(Row.type, pon::PonId.type, "source_resId"), m::field(pon::Identity.type, pon::PonId.type, "id"))]);
def raw: t::Declaration = t::map_columns(t::declare(dataset, [owner], [
    g::dimension(dataset, g::dimension_group("source_PonDeviceOnlineKPI__ts", s::DateTimeUtc.type, True, g::numeric_filters), g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), "source_PonDeviceOnlineKPI__ts", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Hour), "source_PonDeviceOnlineKPI_utc_hour", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Day), "source_PonDeviceOnlineKPI_utc_day", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Month), "source_PonDeviceOnlineKPI_utc_month", True, g::time_filters),
    i::exact(dataset, m::field(Row.type, pon::PonId.type, "source_resId"), "source_PonDeviceOnlineKPI__resId"),
    i::exact(dataset, m::field(Row.type, i::TenantId.type, "source_tenantId"), "source_PonDeviceOnlineKPI__tenantId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_parentId"), "source_PonDeviceOnlineKPI__parentId"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "source_PonDeviceOnlineKPI__projectId"),
    g::dimension(dataset, g::dimension_group("source_PonDeviceOnlineKPI__onlineRate", AssumedOnlinePercent.type, True, g::numeric_filters), g::input(m::field(Row.type, AssumedOnlinePercent.type, "source_onlineRate")), "source_PonDeviceOnlineKPI__onlineRate", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_PonDeviceOnlineKPI__onlineRateEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_onlineRateEffcnt")), "source_PonDeviceOnlineKPI__onlineRateEffcnt", True, g::numeric_filters),
], []), [
    t::column(m::field(Row.type, s::DateTimeUtc.type, "source_ts"), "ts"),
    t::column(m::field(Row.type, pon::PonId.type, "source_resId"), "resId"),
    t::column(m::field(Row.type, i::TenantId.type, "source_tenantId"), "tenantId"),
    t::column(m::field(Row.type, String.type, "source_parentId"), "parentId"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
    t::column(m::field(Row.type, AssumedOnlinePercent.type, "source_onlineRate"), "onlineRate"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_onlineRateEffcnt"), "onlineRateEffcnt"),
]);
def declaration: t::Declaration = t::with_samples(t::metric(raw, m::field(Row.type, s::DateTimeUtc.type, "source_ts")), [
    samples::bind(dataset, online_statistics, m::field(Row.type, AssumedOnlinePercent.type, "source_onlineRate"), [{statistic: samples::Statistic::Mean, publish: "pon_online_table_rate_avg"}, {statistic: samples::Statistic::Min, publish: "pon_online_table_rate_min"}, {statistic: samples::Statistic::Max, publish: "pon_online_table_rate_max"}]),
]);
def relations: Array(r::Relation) = [
    r::relation("source_EntPonElement_PonDeviceOnlineKPI", pon::dataset, pon::subject, dataset, owner, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
pub use self::{declaration, relations};
