pub def site_scoped_interface_kpi_count_preserves_port_and_sample_grains: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"port",
        "nodes":[{"id":"port","entity":"port"}],"edges":[],"select":[],"count":"port",
        "exists":[
            {"anchor":"port","nodes":[{"id":"sample","entity":"interface_kpi"}],
             "edges":[{"relation":"interface_kpi_of_port","from":"sample","to":"port"}],
             "filters":[{"node":"sample","dimension":"interface_kpi_ts_raw","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                        {"node":"sample","dimension":"interface_kpi_ts_raw","op":"lt","kind":"text","value":"2025-01-08 00:00:00"}],
             "having":[{"node":"sample","measure":"interface_out_errors","op":"lt","kind":"number","value":72.0}]},
            {"anchor":"port","nodes":[{"id":"owner","entity":"device"},
                                        {"id":"site","entity":"site"},{"id":"tenant","entity":"tenant"}],
             "edges":[{"relation":"port_belongs_to_device","from":"port","to":"owner"},
                      {"relation":"device_located_at_site","from":"owner","to":"site"},
                      {"relation":"device_belongs_to_tenant","from":"owner","to":"tenant"}],
             "constraints":[{"relation":"site_belongs_to_tenant","from":"site","to":"tenant"}],
             "filters":[{"node":"site","dimension":"site_name","op":"eq","kind":"text","value":"site A"},
                        {"node":"owner","dimension":"device_class","op":"eq","kind":"text","value":"router"}]}
        ]}"#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "count(port.id)")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM NetworkDeviceInterfaceKPI AS sample")
        && string::contains(sq.sql, "HAVING avg(sample.ifOutErrors) <")
        && string::contains(sq.sql, "EXISTS (SELECT 1 FROM I_EntNetworkElement AS owner")
        && string::contains(sq.sql, "owner.tenant_id = tenant.TENANT_ID")
        && string::contains(sq.sql, "site.TENANT_ID = tenant.TENANT_ID")
        && !string::contains(sq.sql, "JOIN NetworkDeviceInterfaceKPI")
        && pg.bindings == sq.bindings { True }
    else { fail!("Q0111-shaped interface count mixed site candidates or KPI samples", sq, pg) }
});

pub def olt_summarizes_raw_samples_across_declared_onu_children: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"olt",
        "nodes":[{"id":"olt","entity":"pon_olt_role"},{"id":"onu","entity":"pon_onu_role"},
                 {"id":"sample","entity":"onu_kpi"}],
        "edges":[{"relation":"pon_onu_parent_olt","from":"onu","to":"olt"},
                 {"relation":"onu_kpi_of_onu_role","from":"sample","to":"onu"}],
        "select":[{"node":"olt","dimension":"pon_olt_name"}],
        "measures":[{"node":"sample","measure":"onu_receive_usage"}],
        "group_by_identity":["olt"],
        "filters":[{"node":"sample","dimension":"onu_kpi_ts","op":"ge","kind":"text","value":"2025-01-01 00:00:00"},
                   {"node":"sample","dimension":"onu_kpi_ts","op":"lt","kind":"text","value":"2025-02-01 00:00:00"}]}
    "#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "FROM (SELECT * FROM I_EntPonElement AS olt WHERE olt.classification =")
        && string::contains(sq.sql, "JOIN (SELECT * FROM I_EntPonElement AS onu WHERE onu.classification =")
        && string::contains(sq.sql, "onu.parentOltResId = olt.id")
        && string::contains(sq.sql, "sample.resId = onu.id")
        && string::contains(sq.sql, "avg(sample.ifInBandRate) AS sample_onu_receive_usage")
        && string::contains(sq.sql, "GROUP BY olt.name, olt.id")
        && string::contains(sq.sql, "onu.classification")
        && string::contains(sq.sql, "olt.classification")
        && pg.bindings == sq.bindings { True }
    else { fail!(`OLT pooled raw ONU samples lost scoped role or sample ownership: \{sq.sql} / \{pg.sql}`, sq.bindings, pg.bindings) }
});

