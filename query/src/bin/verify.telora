# A profile that allows offset plans (full profile above includes 'Offset).

# ---------------------------------------------------------------------------
# Partitioned Top N: per-Role top 3 CommandHeads by EventCount desc.
# ---------------------------------------------------------------------------

def top_per_role_plan: Fn() -> qb.Plan = fn() {
    let plan: qb.Plan = {
        revision: "verify-top-per-role",
        sources: [qb.source("e", "events")],
        projection: [
            qb.expr_item(qb.column("e", "role")),
            qb.expr_item(qb.column("e", "command_head")),
            qb.aggregate('Count, qb.column("e", "id"), 'False, "event_count"),
        ],
        filter: 'Some(qb.scalar('Eq, [qb.column("e", "status"), qb.bind_string("failed")])),
        joins: [],
        grouping: [qb.column("e", "role"), qb.column("e", "command_head")],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'Some(qb.partitioned_top_n(
            [qb.column("e", "role")],
            [qb.desc_aggregate("event_count"), qb.asc(qb.column("e", "command_head"))],
            3,
        )),
    };
    plan
};

def expected_partition_sql = "SELECT __q_0, __q_1, event_count FROM (SELECT e.role AS __q_0, e.command_head AS __q_1, count(e.id) AS event_count, row_number() OVER (PARTITION BY e.role ORDER BY count(e.id) DESC, e.command_head ASC) AS __q_rn FROM events AS e WHERE e.status = ? GROUP BY e.role, e.command_head) AS __partitioned WHERE __q_rn <= ? ORDER BY __q_0 ASC, event_count DESC, __q_1 ASC";

def expected_partition_bindings: Array(qb.Val) = ['String("failed"), 'Int(3)];

