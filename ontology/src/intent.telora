# Model-derived lowering from a closed intent Value to Query.
#
# The factory binds one prepared ontology model and one caller subject, then
# mechanically derives a deterministic `Value -> Query` lowering capability.
# Intent values refer only to stable measure, dimension and entity ids published
# by the model; they never carry tables, columns, aliases or join fragments.
#
# Supported intent `op` values:
#   "list"       row-level projection of dimensions (optionally filtered/sorted).
#   "count"      scalar aggregate summary (count/min/max/avg/sum) with retained filters and existence.
#   "aggregate"  grouped aggregate with optional ordering / limit / having.
#   "top"        grouped top-N ordered by a hidden related measure (group rows only).
#   "distinct"   distinct row-level projection.
#   "exists"     base rows/count that have related rows (correlated EXISTS).
#   "absence"    base rows/count that have no related rows (NOT EXISTS).
#   "set"        union / intersect / except of two compatible projections.
#   "compare"    attribute-versus-scalar-aggregate comparison over a list request.
#   "ranked"     outer-detail rows compared with the hidden top/bottom grouped key.
#   "utc_field_window" half-open window over a Model-declared UTC field of the base dataset.
#   "utc_epoch_window" half-open integer-millisecond window over a declared UTC epoch field.

use crate::ontology as edsl;
use crate::query as qb;
use std::array as array;
use std::dict as dict;
use std::value::{ Value };

# ---------------------------------------------------------------------------
# Value navigation helpers
# ---------------------------------------------------------------------------

def as_object: Fn(Value) -> Dict(Value) = fn(value) {
    match value {
        Value::Object(dict_value) => dict_value,
        _ => fail!("intent field is not an object", value),
    }
};

def as_array: Fn(Value) -> Array(Value) = fn(value) {
    match value {
        Value::Array(items) => items,
        _ => fail!("intent field is not an array", value),
    }
};

def as_string: Fn(Value) -> String = fn(value) {
    match value {
        Value::String(text) => text,
        _ => fail!("intent field is not a string", value),
    }
};

def as_int: Fn(Value) -> Int = fn(value) {
    match value {
        Value::Int(number) => number,
        _ => fail!("intent field is not an integer", value),
    }
};

def field: Fn(Dict(Value), String) -> Value = fn(obj, key) {
    match dict::get(obj, key) {
        Some(value) => value,
        None => fail!("intent field is missing", obj, key),
    }
};

def array_opt: Fn(Dict(Value), String) -> Array(Value) = fn(obj, key) {
    match dict::get(obj, key) {
        None => [],
        Some(value) => match value {
            Value::None => [],
            Value::Array(items) => items,
            _ => fail!("intent field is not an array", value),
        },
    }
};

def no_local_window_ok: Fn(Dict(Value)) -> Bool = fn(obj) {
    let order_ok = array::length(array_opt(obj, "ordering")) == 0;
    let limit_ok = match opt_int(dict::get(obj, "limit")) {
        None => True,
        Some(_) => False,
    };
    let offset_ok = match opt_int(dict::get(obj, "offset")) {
        None => True,
        Some(_) => False,
    };
    order_ok && limit_ok && offset_ok
};

def opt_int: Fn(Option(Value)) -> Option(Int) = fn(maybe) {
    match maybe {
        None => None,
        Some(value) => match value {
            Value::None => None,
            Value::Int(number) => Some(number),
            _ => fail!("intent optional field is not an integer", value),
        },
    }
};

# ---------------------------------------------------------------------------
# Parsers from intent values into ontology request vocabulary
# ---------------------------------------------------------------------------

def parse_op: Fn(String) -> edsl::FilterOp = fn(op) {
    let parsed: edsl::FilterOp = match op {
        "eq" => edsl::FilterOp::Eq,
        "ne" => edsl::FilterOp::Ne,
        "gt" => edsl::FilterOp::Gt,
        "ge" => edsl::FilterOp::Ge,
        "lt" => edsl::FilterOp::Lt,
        "le" => edsl::FilterOp::Le,
        "contains" => edsl::FilterOp::Contains,
        "not_contains" => edsl::FilterOp::NotContains,
        "starts_with" => edsl::FilterOp::StartsWith,
        "ends_with" => edsl::FilterOp::EndsWith,
        _ => fail!("unsupported filter operator", op),
    };
    parsed
};

def parse_having_op: Fn(String) -> edsl::HavingOp = fn(op) {
    let parsed: edsl::HavingOp = match op {
        "eq" => edsl::HavingOp::Eq,
        "ne" => edsl::HavingOp::Ne,
        "gt" => edsl::HavingOp::Gt,
        "ge" => edsl::HavingOp::Ge,
        "lt" => edsl::HavingOp::Lt,
        "le" => edsl::HavingOp::Le,
        _ => fail!("unsupported having operator", op),
    };
    parsed
};

def parse_input: Fn(String, Value) -> edsl::FilterInput = fn(kind, value) {
    let input: edsl::FilterInput = match kind {
        "text" => match value {
            Value::String(text) => edsl::FilterInput::Text(text),
            _ => fail!("text filter requires a string value", value),
        },
        "int" => match value {
            Value::Int(number) => edsl::FilterInput::Int(number),
            _ => fail!("int filter requires an integer value", value),
        },
        "number" => match value {
            Value::Int(number) => edsl::FilterInput::Int(number),
            Value::Float(number) => edsl::FilterInput::Number(number),
            _ => fail!("number filter requires a numeric value", value),
        },
        "bool" => match value {
            Value::True => edsl::FilterInput::Bool(True),
            Value::False => edsl::FilterInput::Bool(False),
            _ => fail!("bool filter requires a boolean value", value),
        },
        _ => fail!("unsupported filter value kind", kind),
    };
    input
};

def parse_measure_requests: Fn(edsl::PreparedPayload, String, Array(Value)) -> Array(edsl::MeasureRequest) = fn(payload, subject, items) {
    array::map(items, fn(item) {
        let id = as_string(item);
        let input = match array::find(payload.measures, fn(measure) { measure.id == id }) {
            Some(measure) => measure.input,
            None => fail!("unknown measure", subject, id),
        };
        let request: edsl::MeasureRequest = {
            id,
            subject,
            input,
        };
        request
    })
};

def parse_dimension_requests: Fn(String, Array(Value)) -> Array(edsl::DimensionRequest) = fn(subject, items) {
    array::map(items, fn(item) {
        let request: edsl::DimensionRequest = {
            id: as_string(item),
            subject,
            input: edsl::DimensionInput::None,
        };
        request
    })
};

def parse_filter: Fn(String, Value) -> edsl::FilterRequest = fn(subject, item) {
    let obj = as_object(item);
    let dimension = as_string(field(obj, "dimension"));
    let op = parse_op(as_string(field(obj, "op")));
    let input = parse_input(as_string(field(obj, "kind")), field(obj, "value"));
    let request: edsl::FilterRequest = {
        id: dimension,
        subject,
        op,
        input,
    };
    request
};

# A closed field-to-field predicate compares two plain attributes of the SAME
# prepared subject entity (no dynamic value is supplied).  The intent entry
# carries `left`, `op` and `right` and no `dimension`/`kind`/`value`.
def is_field_predicate: Fn(Value) -> Bool = fn(item) {
    let obj = as_object(item);
    dict::get(obj, "left") != None && dict::get(obj, "right") != None
};

def parse_field_filter: Fn(String, Value) -> edsl::FieldFilterRequest = fn(subject, item) {
    let obj = as_object(item);
    let request: edsl::FieldFilterRequest = {
        subject,
        op: parse_op(as_string(field(obj, "op"))),
        left: as_string(field(obj, "left")),
        right: as_string(field(obj, "right")),
    };
    request
};

def scalar_filter_items: Fn(Array(Value)) -> Array(Value) = fn(items) {
    array::filter(items, fn(item) { !is_field_predicate(item) })
};

def field_filter_items: Fn(Array(Value)) -> Array(Value) = fn(items) {
    array::filter(items, is_field_predicate)
};

def parse_direction: Fn(String) -> edsl::OrderDirection = fn(direction_text) {
    let direction: edsl::OrderDirection = match direction_text {
        "Asc" => edsl::OrderDirection::Asc,
        "Desc" => edsl::OrderDirection::Desc,
        _ => fail!("unsupported ordering direction", direction_text),
    };
    direction
};

def parse_order: Fn(Value) -> edsl::OrderRequest = fn(item) {
    let obj = as_object(item);
    let target_kind = as_string(field(obj, "target"));
    let target_id = as_string(field(obj, "id"));
    let target: edsl::OrderTarget = match target_kind {
        "Measure" => edsl::OrderTarget::Measure(target_id),
        "Dimension" => edsl::OrderTarget::Dimension(target_id),
        _ => fail!("unsupported ordering target kind", target_kind),
    };
    let request: edsl::OrderRequest = { target, direction: parse_direction(as_string(field(obj, "direction"))) };
    request
};

def parse_internal_order: Fn(String, Value) -> edsl::InternalOrderRequest = fn(subject, item) {
    let obj = as_object(item);
    let target_kind = as_string(field(obj, "target"));
    if target_kind == "Measure" {
        let request: edsl::InternalOrderRequest = {
            measure: as_string(field(obj, "id")),
            subject,
            direction: parse_direction(as_string(field(obj, "direction"))),
        };
        request
    } else {
        fail!("internal top ordering must target a measure", item)
    }
};

def parse_exists: Fn(String, Value) -> edsl::ExistsRequest = fn(subject, item) {
    let obj = as_object(item);
    let target = as_string(field(obj, "target"));
    let filter_values = as_array(field(obj, "filters"));
    let filters: Array(edsl::FilterRequest) = array::map(filter_values, fn(filter) { parse_filter(subject, filter) });
    let any_of: Array(edsl::AnyOfRequest) = array::map(array_opt(obj, "any_of"), fn(group) {
        let fields = as_object(group);
        let kind = as_string(field(fields, "kind"));
        { id: as_string(field(fields, "dimension")), subject,
          values: array::map(as_array(field(fields, "values")), fn(value) { parse_input(kind, value) }) }
    });
    let min_matches = opt_int(dict::get(obj, "min_matches"));
    let spec: edsl::ExistsRequest = {
        target,
        subject,
        filters,
        any_of,
        min_matches,
    };
    spec
};

def parse_site_tenant_scope: Fn(String, Dict(Value)) -> Option(edsl::SiteTenantScope) = fn(subject, obj) {
    match dict::get(obj, "site_scope") {
        None => None,
        Some(Value::None) => None,
        Some(value) => do {
            let item = as_object(value);
            Some({
                site_relation: as_string(field(item, "site_relation")),
                tenant_relation: as_string(field(item, "tenant_relation")),
                site_filters: array::map(as_array(field(item, "site_filters")), fn(v) { parse_filter(subject, v) }),
                tenant_filters: array::map(as_array(field(item, "tenant_filters")), fn(v) { parse_filter(subject, v) }),
            })
        },
    }
};

def parse_link_site_scope: Fn(String, Value) -> edsl::LinkSiteScope = fn(subject, value) {
    let spec = as_object(value);
    {
        a_relation: as_string(field(spec, "a_relation")),
        z_relation: as_string(field(spec, "z_relation")),
        link_tenant_relation: as_string(field(spec, "link_tenant_relation")),
        device_tenant_relation: as_string(field(spec, "device_tenant_relation")),
        site_relation: as_string(field(spec, "site_relation")),
        tenant_relation: as_string(field(spec, "tenant_relation")),
        device_filters: array::map(as_array(field(spec, "device_filters")), fn(v) { parse_filter(subject, v) }),
        site_filters: array::map(as_array(field(spec, "site_filters")), fn(v) { parse_filter(subject, v) }),
        tenant_filters: array::map(as_array(field(spec, "tenant_filters")), fn(v) { parse_filter(subject, v) }),
    }
};

def parse_named_exists: Fn(String, Value) -> edsl::NamedExistsRequest = fn(subject, item) {
    let obj = as_object(item);
    let spec: edsl::NamedExistsRequest = {
        relation: as_string(field(obj, "relation")),
        spec: parse_exists(subject, item),
    };
    spec
};

def parse_sample_qualification: Fn(String, Value) -> edsl::SampleQualification = fn(subject, value) {
    let item = as_object(value);
    let window = as_object(field(item, "window"));
    { relation: as_string(field(item, "relation")),
      dataset: as_string(field(item, "dataset")),
      filters: array::map(as_array(field(item, "filters")), fn(filter) { parse_filter(subject, filter) }),
      start: as_string(field(window, "start")),
      end: as_string(field(window, "end")),
      min_matches: as_int(field(item, "min_matches")) }
};

def parse_epoch_sample_qualification: Fn(String, Value) -> edsl::EpochSampleQualification = fn(subject, value) {
    let item = as_object(value);
    let window = as_object(field(item, "window"));
    { relation: as_string(field(item, "relation")),
      dataset: as_string(field(item, "dataset")),
      field: as_string(field(window, "field")),
      filters: array::map(as_array(field(item, "filters")), fn(filter) { parse_filter(subject, filter) }),
      start: as_int(field(window, "start")),
      end: as_int(field(window, "end")),
      min_matches: as_int(field(item, "min_matches")) }
};

def parse_observation_components: Fn(String, Dict(Value)) -> Array(edsl::NamedExistsRequest) = fn(subject, obj) {
    array::map(array_opt(obj, "components"), fn(value) { parse_named_exists(subject, value) })
};

def parse_observation_context: Fn(String, Dict(Value)) -> Option(edsl::ComponentContextSpec) = fn(subject, obj) {
    match dict::get(obj, "context") {
        None => None,
        Some(Value::None) => None,
        Some(value) => do {
            let item = as_object(value);
            Some({ relation: as_string(field(item, "relation")),
                target: as_string(field(item, "target")),
                dimensions: parse_dimension_requests(subject, as_array(field(item, "dimensions"))),
                filters: array::map(as_array(field(item, "filters")), fn(filter) { parse_filter(subject, filter) }) })
        },
    }
};

def parse_owner_site_scope: Fn(String, Dict(Value)) -> Option(edsl::OwnerSiteScope) = fn(subject, obj) {
    match dict::get(obj, "scope") {
        Some(Value::None) => None,
        None => None,
        Some(value) => do {
            let item = as_object(value);
            Some({
                ancestor_relation: as_string(field(item, "ancestor_relation")),
                site_relation: as_string(field(item, "site_relation")),
                tenant_relation: as_string(field(item, "tenant_relation")),
                ancestor_filters: array::map(as_array(field(item, "ancestor_filters")), fn(v) { parse_filter(subject, v) }),
                site_filters: array::map(as_array(field(item, "site_filters")), fn(v) { parse_filter(subject, v) }),
                tenant_filters: array::map(as_array(field(item, "tenant_filters")), fn(v) { parse_filter(subject, v) }),
            })
        },
    }
};

def parse_having: Fn(String, Value) -> edsl::HavingRequest = fn(subject, item) {
    let obj = as_object(item);
    let measure = as_string(field(obj, "measure"));
    let op = parse_having_op(as_string(field(obj, "op")));
    let threshold = parse_input(as_string(field(obj, "kind")), field(obj, "value"));
    let request: edsl::HavingRequest = {
        measure,
        subject,
        op,
        threshold,
    };
    request
};

# Hidden aggregate HAVING (same-source or related internal aggregate) carries the
# same closed shape: measure id, comparison operator and a typed threshold.
def parse_internal_having: Fn(String, Value) -> edsl::InternalHavingRequest = fn(subject, item) {
    let obj = as_object(item);
    let measure = as_string(field(obj, "measure"));
    let op = parse_having_op(as_string(field(obj, "op")));
    let threshold = parse_input(as_string(field(obj, "kind")), field(obj, "value"));
    let request: edsl::InternalHavingRequest = {
        measure,
        subject,
        op,
        threshold,
    };
    request
};

def parse_compare: Fn(String, Value) -> edsl::ScalarCompareRequest = fn(subject, item) {
    let obj = as_object(item);
    let attribute = as_string(field(obj, "attribute"));
    let op = parse_having_op(as_string(field(obj, "op")));
    let measure = as_string(field(obj, "measure"));
    let scope_values = match dict::get(obj, "scope") {
        Some(value) => as_array(value),
        None => [],
    };
    let scope: Array(edsl::FilterRequest) = array::map(scope_values, fn(filter) { parse_filter(subject, filter) });
    let spec: edsl::ScalarCompareRequest = {
        attribute,
        subject,
        op,
        measure,
        scope_filters: scope,
    };
    spec
};

def parse_ranked_key: Fn(String, Value) -> edsl::RankedKeyCompareRequest = fn(subject, item) {
    let obj = as_object(item);
    let attribute = as_string(field(obj, "attribute"));
    let op = parse_having_op(as_string(field(obj, "op")));
    let group = as_string(field(obj, "group"));
    let measure = as_string(field(obj, "measure"));
    let direction = parse_direction(as_string(field(obj, "direction")));
    let scope_values = match dict::get(obj, "scope") {
        Some(value) => as_array(value),
        None => [],
    };
    let scope: Array(edsl::FilterRequest) = array::map(scope_values, fn(filter) { parse_filter(subject, filter) });
    let spec: edsl::RankedKeyCompareRequest = {
        attribute,
        subject,
        op,
        group,
        measure,
        direction,
        scope_filters: scope,
    };
    spec
};

def parse_set_kind: Fn(String) -> qb::SetOpKind = fn(kind) {
    let parsed: qb::SetOpKind = match kind {
        "union" => qb::SetOpKind::Union,
        "intersect" => qb::SetOpKind::Intersect,
        "except" => qb::SetOpKind::Except,
        _ => fail!("unsupported set kind", kind),
    };
    parsed
};

def set_branch_keys: Array(String) = [
    "shape", "measures", "dimensions", "filters", "ordering",
    "exists", "having", "limit", "offset",
];

def has_unknown_key: Fn(Dict(Value), Array(String)) -> Bool = fn(obj, allowed) {
    let keys = dict::keys(obj);
    array::any(keys, fn(key) {
        let known = array::any(allowed, fn(ok) { ok == key });
        !known
    })
};

def build_set_branch: Fn(edsl::PreparedPayload, String, Value) -> qb::Plan = fn(payload, subject, branch) {
    let obj = as_object(branch);
    if has_unknown_key(obj, set_branch_keys) {
        fail!("set branch contains unsupported keys", branch)
    } else {
        let shape = as_string(field(obj, "shape"));
        if shape == "row" || shape == "exists" || shape == "absence" {
            if !no_local_window_ok(obj) {
                fail!("set branch must not carry a local ordering, limit, or offset", branch)
            } else {
                let request = build_request(payload, subject, obj);
                let exists: Array(edsl::ExistsRequest) =
                    array::map(array_opt(obj, "exists"), fn(item) { parse_exists(subject, item) });
                let having: Array(edsl::HavingRequest) =
                    array::map(array_opt(obj, "having"), fn(item) { parse_having(subject, item) });
                if shape == "row" {
                    if array::length(exists) != 0 || array::length(having) != 0 {
                        fail!("row set branch must not carry existence or having constraints", branch)
                    } else {
                        let plan: qb::Plan = edsl::lower(payload, request);
                        plan
                    }
                } else if shape == "exists" {
                    let plan: qb::Plan = edsl::lower_full(payload, request, exists, having);
                    plan
                } else {
                    let plan: qb::Plan = edsl::lower_absence(payload, request, exists, having);
                    plan
                }
            }
        } else {
            fail!("unsupported set branch shape", shape)
        }
    }
};

def parse_projection_token: Fn(Value) -> edsl::ProjectionToken = fn(value) {
    match value {
        # Backward-compatible row-list shorthand.
        Value::String(id) => edsl::ProjectionToken::Dimension(id),
        Value::Object(obj) => do {
            let kind = as_string(field(obj, "kind"));
            let id = as_string(field(obj, "id"));
            match kind {
                "measure" => edsl::ProjectionToken::Measure(id),
                "dimension" => edsl::ProjectionToken::Dimension(id),
                _ => fail!("unsupported output_order token kind", kind),
            }
        },
        _ => fail!("output_order entry is not a projection token", value),
    }
};

def reorder_if_requested: Fn(edsl::PreparedPayload, edsl::QueryRequest, qb::Plan, Array(edsl::ProjectionToken)) -> qb::Plan =
    fn(payload, request, plan, output) {
        if array::length(output) == 0 {
            plan
        } else {
            let ordered: qb::Plan = edsl::reorder_projection(payload, request, plan, output);
            ordered
        }
    };

def lower_list_with_order: Fn(edsl::PreparedPayload, edsl::QueryRequest, Array(edsl::ProjectionToken)) -> qb::Plan = fn(payload, request, output) {
    let base_plan: qb::Plan = edsl::lower(payload, request);
    reorder_if_requested(payload, request, base_plan, output)
};

def build_request: Fn(edsl::PreparedPayload, String, Dict(Value)) -> edsl::QueryRequest = fn(payload, subject, obj) {
    let measures = parse_measure_requests(payload, subject, as_array(field(obj, "measures")));
    let dimensions = parse_dimension_requests(subject, as_array(field(obj, "dimensions")));
    let filter_values = scalar_filter_items(as_array(field(obj, "filters")));
    let filters: Array(edsl::FilterRequest) = array::map(filter_values, fn(item) { parse_filter(subject, item) });
    let order_values = as_array(field(obj, "ordering"));
    let ordering: Array(edsl::OrderRequest) = array::map(order_values, parse_order);
    let limit = opt_int(dict::get(obj, "limit"));
    let offset = opt_int(dict::get(obj, "offset"));
    let request: edsl::QueryRequest = {
        measures,
        dimensions,
        filters,
        ordering,
        limit,
        offset,
        partition: None,
    };
    request
};

# ---------------------------------------------------------------------------
# Public lowering entry: intent Value -> Query
# ---------------------------------------------------------------------------

def lower_set_query: Fn(edsl::PreparedPayload, String, qb::SetOpKind, Value) -> qb::QueryPlan =
    fn(payload, subject, kind, intent) {
        let obj = as_object(intent);
        let branches = as_array(field(obj, "branches"));
        let branch_count = array::length(branches);
        if branch_count == 2 {
            let left = build_set_branch(payload, subject, branches[0]);
            let right = build_set_branch(payload, subject, branches[1]);
            let op = as_string(field(obj, "op"));
            let set: qb::SetPlan = {kind, left, right};
            if op == "set" {
                qb::QueryPlan::SetRows(set)
            } else {
                qb::QueryPlan::SetCount(set)
            }
        } else {
            fail!("set intent requires exactly two branches", branch_count)
        }
    };

def lower_intent_plan: Fn(edsl::PreparedPayload, String, Value) -> qb::QueryPlan = fn(payload, subject, intent) {
    let obj = as_object(intent);
    let op = as_string(field(obj, "op"));
    if op == "set" || op == "set_count" {
        let kind = parse_set_kind(as_string(field(obj, "kind")));
        lower_set_query(payload, subject, kind, intent)
    } else {
        let field_values = field_filter_items(as_array(field(obj, "filters")));
        if array::length(field_values) != 0 && op != "list" {
            fail!("field-to-field predicates are only supported by the list shape", op)
        } else {
            let request = build_request(payload, subject, obj);
            match op {
                "list" => {
                    let output_values = array_opt(obj, "output_order");
                    let output: Array(edsl::ProjectionToken) = array::map(output_values, parse_projection_token);
                    let plan: qb::Plan = if array::length(field_values) != 0 {
                        let field_filters: Array(edsl::FieldFilterRequest) =
                            array::map(field_values, fn(item) { parse_field_filter(subject, item) });
                        let base_plan: qb::Plan = edsl::lower_field_filtered(payload, request, field_filters);
                        reorder_if_requested(payload, request, base_plan, output)
                    } else {
                        lower_list_with_order(payload, request, output)
                    };
                    qb::QueryPlan::Rows(plan)
                },
                "count" => {
                    let exists: Array(edsl::ExistsRequest) =
                        array::map(array_opt(obj, "exists"), fn(item) { parse_exists(subject, item) });
                    let having: Array(edsl::HavingRequest) =
                        array::map(array_opt(obj, "having"), fn(item) { parse_having(subject, item) });
                    let plan: qb::Plan = edsl::lower_full(payload, request, exists, having);
                    qb::QueryPlan::Rows(plan)
                },
                "qualify_group" => {
                    let having: Array(edsl::HavingRequest) =
                        array::map(array_opt(obj, "having"), fn(item) { parse_having(subject, item) });
                    let output: Array(String) = array::map(as_array(field(obj, "visible_dimensions")), as_string);
                    let show_measure = match dict::get(obj, "show_measure") {
                        None => False,
                        Some(Value::True) => True,
                        Some(Value::False) => False,
                        Some(value) => fail!("show_measure requires a boolean", value),
                    };
                    qb::QueryPlan::Rows(edsl::lower_group_projection(payload, request,
                        as_string(field(obj, "relation")), having, output, show_measure))
                },
                "exists_via" => {
                    let specs: Array(edsl::NamedExistsRequest) =
                        array::map(as_array(field(obj, "exists")), fn(item) { parse_named_exists(subject, item) });
                    if array::length(specs) == 0 {
                        fail!("exists_via requires a named relation")
                    } else {
                        qb::QueryPlan::Rows(edsl::lower_named_exists(payload, request, specs, parse_site_tenant_scope(subject, obj)))
                    }
                },
                "qualify_metrics" => {
                    let specs: Array(edsl::MetricQualification) = array::map(
                        as_array(field(obj, "qualifications")), fn(value) {
                            let item = as_object(value);
                            let window = as_object(field(item, "window"));
                            let having = as_object(field(item, "having"));
                            { relation: as_string(field(item, "relation")),
                              dataset: as_string(field(item, "dataset")),
                              measure: as_string(field(having, "measure")),
                              filters: array::map(as_array(field(item, "filters")), fn(filter) { parse_filter(subject, filter) }),
                              start: as_string(field(window, "start")),
                              end: as_string(field(window, "end")),
                              op: parse_having_op(as_string(field(having, "op"))),
                              threshold: parse_input(as_string(field(having, "kind")), field(having, "value")) }
                        });
                    let scope = parse_owner_site_scope(subject, obj);
                    qb::QueryPlan::Rows(edsl::lower_metric_qualifications(payload, request, specs, scope))
                },
                "qualify_epoch_metrics" => {
                    let specs: Array(edsl::EpochMetricQualification) = array::map(
                        as_array(field(obj, "qualifications")), fn(value) {
                            let item = as_object(value);
                            let window = as_object(field(item, "window"));
                            let having = as_object(field(item, "having"));
                            { relation: as_string(field(item, "relation")),
                              dataset: as_string(field(item, "dataset")),
                              measure: as_string(field(having, "measure")),
                              filters: array::map(as_array(field(item, "filters")), fn(filter) { parse_filter(subject, filter) }),
                              field: as_string(field(window, "field")),
                              start: as_int(field(window, "start")),
                              end: as_int(field(window, "end")),
                              op: parse_having_op(as_string(field(having, "op"))),
                              threshold: parse_input(as_string(field(having, "kind")), field(having, "value")) }
                        });
                    qb::QueryPlan::Rows(edsl::lower_epoch_metric_qualifications(payload, request, specs,
                        parse_owner_site_scope(subject, obj)))
                },
                "qualify_samples" => {
                    let specs = array::map(as_array(field(obj, "qualifications")), fn(value) {
                        parse_sample_qualification(subject, value)
                    });
                    qb::QueryPlan::Rows(edsl::lower_sample_qualifications(payload, request, specs))
                },
                "qualify_epoch_samples" => {
                    let specs = array::map(as_array(field(obj, "qualifications")), fn(value) {
                        parse_epoch_sample_qualification(subject, value)
                    });
                    qb::QueryPlan::Rows(edsl::lower_sample_epoch_qualifications(payload, request, specs))
                },
                "qualify_sample_count" => {
                    let ranges: Array(edsl::SampleCountRange) = array::map(
                        as_array(field(obj, "qualifications")), fn(value) {
                            let item = as_object(value);
                            let window = as_object(field(item, "window"));
                            let minimum = as_int(field(item, "min_matches"));
                            let qualification: edsl::SampleQualification = {
                                relation: as_string(field(item, "relation")),
                                dataset: as_string(field(item, "dataset")),
                                filters: array::map(as_array(field(item, "filters")), fn(filter) { parse_filter(subject, filter) }),
                                start: as_string(field(window, "start")),
                                end: as_string(field(window, "end")),
                                min_matches: minimum,
                            };
                            { qualification, min_matches: minimum, max_matches: as_int(field(item, "max_matches")) }
                        });
                    qb::QueryPlan::Rows(edsl::lower_sample_count_ranges(payload, request, ranges))
                },
                "qualify_epoch_sample_count" => {
                    let ranges: Array(edsl::EpochSampleCountRange) = array::map(
                        as_array(field(obj, "qualifications")), fn(value) {
                            let item = as_object(value);
                            let minimum = as_int(field(item, "min_matches"));
                            let spec = parse_epoch_sample_qualification(subject, value);
                            { qualification: spec, min_matches: minimum, max_matches: as_int(field(item, "max_matches")) }
                        });
                    qb::QueryPlan::Rows(edsl::lower_sample_epoch_count_ranges(payload, request, ranges))
                },
                "observe_qualified" => {
                    let specs = array::map(as_array(field(obj, "qualifications")), fn(value) {
                        parse_sample_qualification(subject, value)
                    });
                    let components = parse_observation_components(subject, obj);
                    let context = parse_observation_context(subject, obj);
                    let window = as_object(field(obj, "window"));
                    let observation: edsl::UtcWindowRequest = {
                        dataset: as_string(field(window, "dataset")),
                        start: as_string(field(window, "start")),
                        end: as_string(field(window, "end")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_qualified_observation(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")), observation, specs, components, context))
                },
                "observe_epoch_qualified" => {
                    let specs = array::map(as_array(field(obj, "qualifications")), fn(value) {
                        parse_epoch_sample_qualification(subject, value)
                    });
                    let bounds = as_object(field(obj, "window"));
                    let observation: edsl::UtcEpochWindowRequest = {
                        dataset: as_string(field(bounds, "dataset")),
                        field: as_string(field(bounds, "field")),
                        start: as_int(field(bounds, "start")),
                        end: as_int(field(bounds, "end")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_epoch_qualified_observation(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")), observation, specs,
                        parse_observation_components(subject, obj), parse_observation_context(subject, obj)))
                },
                "observe_related" => {
                    let dataset_id = as_string(field(obj, "dataset"));
                    let window = match dict::get(obj, "window") {
                        None => None,
                        Some(Value::None) => None,
                        Some(value) => do {
                            let bounds = as_object(value);
                            let result: edsl::UtcWindowRequest = {
                                dataset: dataset_id,
                                start: as_string(field(bounds, "start")),
                                end: as_string(field(bounds, "end")),
                            };
                            Some(result)
                        },
                    };
                    qb::QueryPlan::Rows(edsl::lower_related_observation(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")), dataset_id, window))
                },
                "observe_peer_related" => {
                    let dataset_id = as_string(field(obj, "dataset"));
                    let window = match dict::get(obj, "window") {
                        None => None,
                        Some(Value::None) => None,
                        Some(value) => do {
                            let bounds = as_object(value);
                            let result: edsl::UtcWindowRequest = {
                                dataset: dataset_id,
                                start: as_string(field(bounds, "start")),
                                end: as_string(field(bounds, "end")),
                            };
                            Some(result)
                        },
                    };
                    let peer = as_object(field(obj, "peer_scope"));
                    let scope: edsl::PeerObservationScope = {
                        hub: as_string(field(peer, "hub")),
                        origin_relation: as_string(field(peer, "origin_relation")),
                        owner_relation: as_string(field(peer, "owner_relation")),
                        origin_filters: array::map(array_opt(peer, "origin_filters"), fn(v) { parse_filter(subject, v) }),
                    };
                    qb::QueryPlan::Rows(edsl::lower_peer_related_observation(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")), dataset_id, window, scope))
                },
                "observe_related_epoch" => {
                    let dataset_id = as_string(field(obj, "dataset"));
                    let window = match dict::get(obj, "window") {
                        None => None,
                        Some(Value::None) => None,
                        Some(value) => do {
                            let bounds = as_object(value);
                            let result: edsl::UtcEpochWindowRequest = {
                                dataset: dataset_id,
                                field: as_string(field(bounds, "field")),
                                start: as_int(field(bounds, "start")),
                                end: as_int(field(bounds, "end")),
                            };
                            Some(result)
                        },
                    };
                    qb::QueryPlan::Rows(edsl::lower_related_epoch_observation(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")), dataset_id, window))
                },
                "list_via" => {
                    let relation_id = as_string(field(obj, "relation"));
                    qb::QueryPlan::Rows(edsl::lower_via(payload, request, relation_id))
                },
                "list_relation" => {
                    let plan = edsl::lower_relation_rows(payload, request,
                        as_string(field(obj, "base")), as_string(field(obj, "relation")));
                    match as_string(field(obj, "mode")) {
                        "rows" => qb::QueryPlan::Rows(plan),
                        "distinct" => qb::QueryPlan::DistinctRows(plan),
                        _ => fail!("relation rows require rows or distinct mode"),
                    }
                },
                "filter_endpoint_pair" => {
                    let endpoints = as_object(field(obj, "endpoints"));
                    let kind = as_string(field(endpoints, "kind"));
                    let pair: edsl::EndpointPairRequest = {
                        pair: as_string(field(endpoints, "pair")),
                        first: parse_input(kind, field(endpoints, "first")),
                        second: parse_input(kind, field(endpoints, "second")),
                        subject,
                    };
                    qb::QueryPlan::Rows(edsl::lower_endpoint_pair(payload, request,
                        as_string(field(obj, "tenant_relation")), pair))
                },
                "qualify_child_site" => {
                    let scope: edsl::ChildSiteScope = {
                        parent_relation: as_string(field(obj, "parent_relation")),
                        site_relation: as_string(field(obj, "site_relation")),
                        tenant_relation: as_string(field(obj, "tenant_relation")),
                        child_tenant_relation: as_string(field(obj, "child_tenant_relation")),
                        parent_tenant_relation: as_string(field(obj, "parent_tenant_relation")),
                        parent_filters: array::map(as_array(field(obj, "parent_filters")), fn(v) { parse_filter(subject, v) }),
                        site_filters: array::map(as_array(field(obj, "site_filters")), fn(v) { parse_filter(subject, v) }),
                        tenant_filters: array::map(as_array(field(obj, "tenant_filters")), fn(v) { parse_filter(subject, v) }),
                    };
                    qb::QueryPlan::Rows(edsl::lower_child_site_scope(payload, request, scope))
                },
                "list_roles" => {
                    let roles: Array(edsl::RoleProjectionSpec) = array::map(as_array(field(obj, "roles")), fn(value) {
                        let role = as_object(value);
                        { relation: as_string(field(role, "relation")),
                          dimension: as_string(field(role, "dimension")),
                          output: as_string(field(role, "output")) }
                    });
                    let role_filters: Array(edsl::RoleFilterSpec) = array::map(array_opt(obj, "role_filters"), fn(value) {
                        let item = as_object(value);
                        { role: as_string(field(item, "role")), filter: parse_filter(subject, value) }
                    });
                    qb::QueryPlan::Rows(edsl::lower_roles(payload, request, roles, role_filters))
                },
                "utc_window" => {
                    let window_obj = as_object(field(obj, "window"));
                    let window: edsl::UtcWindowRequest = {
                        dataset: as_string(field(window_obj, "dataset")),
                        start: as_string(field(window_obj, "start")),
                        end: as_string(field(window_obj, "end")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_utc_window(payload, request, window))
                },
                "utc_field_window" => {
                    let window_obj = as_object(field(obj, "window"));
                    let window: edsl::UtcFieldWindowRequest = {
                        dataset: as_string(field(window_obj, "dataset")),
                        field: as_string(field(window_obj, "field")),
                        start: as_string(field(window_obj, "start")),
                        end: as_string(field(window_obj, "end")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_utc_field_window(payload, request, window))
                },
                "utc_epoch_window" => {
                    let window_obj = as_object(field(obj, "window"));
                    let window: edsl::UtcEpochWindowRequest = {
                        dataset: as_string(field(window_obj, "dataset")),
                        field: as_string(field(window_obj, "field")),
                        start: as_int(field(window_obj, "start")),
                        end: as_int(field(window_obj, "end")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_utc_epoch_window(payload, request, window))
                },
                "sample_top" => {
                    let window_obj = as_object(field(obj, "window"));
                    let window: edsl::UtcWindowRequest = {
                        dataset: as_string(field(window_obj, "dataset")),
                        start: as_string(field(window_obj, "start")),
                        end: as_string(field(window_obj, "end")),
                    };
                    let scope = parse_owner_site_scope(subject, obj);
                    qb::QueryPlan::Rows(edsl::lower_sample_top(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")),
                        window, as_string(field(obj, "rank")), as_int(field(obj, "take")), scope))
                },
                "sample_epoch_top" => {
                    let bounds = as_object(field(obj, "window"));
                    let window: edsl::UtcEpochWindowRequest = {
                        dataset: as_string(field(bounds, "dataset")),
                        field: as_string(field(bounds, "field")),
                        start: as_int(field(bounds, "start")),
                        end: as_int(field(bounds, "end")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_sample_epoch_top(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")),
                        window, as_string(field(obj, "rank")), as_int(field(obj, "take")),
                        parse_owner_site_scope(subject, obj)))
                },
                "latest_sample" => {
                    let dataset_id = as_string(field(obj, "dataset"));
                    let window = match dict::get(obj, "window") {
                        Some(Value::None) => None,
                        Some(value) => do {
                            let bounds = as_object(value);
                            let result: edsl::UtcWindowRequest = {
                                dataset: dataset_id,
                                start: as_string(field(bounds, "start")),
                                end: as_string(field(bounds, "end")),
                            };
                            Some(result)
                        },
                        None => None,
                    };
                    qb::QueryPlan::Rows(edsl::lower_latest_sample(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")),
                        dataset_id, window, parse_owner_site_scope(subject, obj), parse_site_tenant_scope(subject, obj)))
                },
                "latest_epoch_sample" => {
                    let dataset_id = as_string(field(obj, "dataset"));
                    let window = match dict::get(obj, "window") {
                        Some(Value::None) => None,
                        Some(value) => do {
                            let bounds = as_object(value);
                            let result: edsl::UtcEpochWindowRequest = {
                                dataset: dataset_id,
                                field: as_string(field(bounds, "field")),
                                start: as_int(field(bounds, "start")),
                                end: as_int(field(bounds, "end")),
                            };
                            Some(result)
                        },
                        None => None,
                    };
                    qb::QueryPlan::Rows(edsl::lower_latest_epoch_sample(payload, request,
                        as_string(field(obj, "owner")), as_string(field(obj, "relation")),
                        dataset_id, window, parse_owner_site_scope(subject, obj), parse_site_tenant_scope(subject, obj)))
                },
                "observe_event_component" => {
                    let bounds = as_object(field(obj, "window"));
                    let window: edsl::UtcWindowRequest = {
                        dataset: as_string(field(bounds, "dataset")),
                        start: as_string(field(bounds, "start")),
                        end: as_string(field(bounds, "end")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_event_component(payload, request, window,
                        as_string(field(obj, "owner")), as_string(field(obj, "event_relation")),
                        as_string(field(obj, "component_relation")),
                        as_string(field(obj, "owner_tenant_relation")), as_string(field(obj, "component_tenant_relation")),
                        array::map(as_array(field(obj, "owner_filters")), fn(v) { parse_filter(subject, v) }),
                        array::map(as_array(field(obj, "component_filters")), fn(v) { parse_filter(subject, v) })))
                },
                "observe_epoch_event_component" => {
                    let bounds = as_object(field(obj, "window"));
                    let window: edsl::UtcEpochWindowRequest = {
                        dataset: as_string(field(bounds, "dataset")),
                        field: as_string(field(bounds, "field")),
                        start: as_int(field(bounds, "start")),
                        end: as_int(field(bounds, "end")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_epoch_event_component(payload, request, window,
                        as_string(field(obj, "owner")), as_string(field(obj, "event_relation")),
                        as_string(field(obj, "component_relation")),
                        as_string(field(obj, "owner_tenant_relation")), as_string(field(obj, "component_tenant_relation")),
                        array::map(as_array(field(obj, "owner_filters")), fn(v) { parse_filter(subject, v) }),
                        array::map(as_array(field(obj, "component_filters")), fn(v) { parse_filter(subject, v) })))
                },
                "qualify_link_site" => {
                    let scope = parse_link_site_scope(subject, field(obj, "link_site"));
                    qb::QueryPlan::Rows(edsl::lower_link_site(payload, request, scope))
                },
                "list_link_device_site" => {
                    let scope = parse_link_site_scope(subject, field(obj, "link_site"));
                    qb::QueryPlan::Rows(edsl::lower_link_device_site_rows(payload, request, scope))
                },
                "utc_days_window" => {
                    let window_obj = as_object(field(obj, "window"));
                    let window: edsl::UtcDaysWindowRequest = {
                        dataset: as_string(field(window_obj, "dataset")),
                        as_of: as_string(field(window_obj, "as_of")),
                        days: as_int(field(window_obj, "days")),
                    };
                    qb::QueryPlan::Rows(edsl::lower_utc_days_window(payload, request, window))
                },
                "aggregate" => {
                    if array::length(request.measures) == 0 {
                        fail!("aggregate requires at least one visible measure; use top for hidden group ordering")
                    } else {
                        let output_values = array_opt(obj, "output_order");
                        let output: Array(edsl::ProjectionToken) = array::map(output_values, parse_projection_token);
                        let hidden_values = array_opt(obj, "hidden_having");
                        if array::length(hidden_values) != 0 {
                            # Hidden same-source aggregate HAVING over a grouped
                            # aggregate request; it does not combine with selected
                            # HAVING or existence in this shape.
                            if array::length(array_opt(obj, "having")) != 0
                                || array::length(array_opt(obj, "exists")) != 0 {
                                fail!("aggregate hidden_having does not combine with selected having or existence", op)
                            } else {
                                let hidden: Array(edsl::InternalHavingRequest) =
                                    array::map(hidden_values, fn(item) { parse_internal_having(subject, item) });
                                let base_plan: qb::Plan = edsl::lower_hidden_having(payload, request, hidden);
                                let plan = reorder_if_requested(payload, request, base_plan, output);
                                qb::QueryPlan::Rows(plan)
                            }
                        } else {
                            let exists: Array(edsl::ExistsRequest) =
                                array::map(array_opt(obj, "exists"), fn(item) { parse_exists(subject, item) });
                            let having: Array(edsl::HavingRequest) =
                                array::map(array_opt(obj, "having"), fn(item) { parse_having(subject, item) });
                            let base_plan: qb::Plan = edsl::lower_full(payload, request, exists, having);
                            let plan = reorder_if_requested(payload, request, base_plan, output);
                            qb::QueryPlan::Rows(plan)
                        }
                    }
                },
                "count_groups" => {
                    let having: Array(edsl::HavingRequest) =
                        array::map(array_opt(obj, "having"), fn(item) { parse_having(subject, item) });
                    qb::QueryPlan::GroupCount(edsl::lower_group_count_plan(payload, request, having))
                },
                "count_related_groups" => {
                    let population = as_string(field(obj, "population"));
                    if population != "matched" && population != "all" {
                        fail!("related group count population must be matched or all", population)
                    } else {
                        let having: Array(edsl::HavingRequest) =
                            array::map(array_opt(obj, "having"), fn(item) { parse_having(subject, item) });
                        qb::QueryPlan::GroupCount(edsl::lower_related_group_count_plan(payload, request,
                            as_string(field(obj, "relation")), having, population == "all"))
                    }
                },
                "top" => {
                    if array::length(request.measures) != 0 {
                        fail!("top does not accept visible measures; use aggregate to project a measure")
                    } else {
                        let order_values = array_opt(obj, "ordering");
                        let internal_orders: Array(edsl::InternalOrderRequest) =
                            array::map(order_values, fn(item) { parse_internal_order(subject, item) });
                        let internal_having: Array(edsl::InternalHavingRequest) =
                            array::map(array_opt(obj, "hidden_having"), fn(item) { parse_internal_having(subject, item) });
                        let top_request = request <~ { ordering: [] };
                        let plan: qb::Plan = edsl::lower_internal_related(
                            payload,
                            top_request,
                            internal_orders,
                            internal_having,
                        );
                        qb::QueryPlan::Rows(plan)
                    }
                },
                "distinct" => {
                    let plan: qb::Plan = edsl::lower(payload, request);
                    qb::QueryPlan::DistinctRows(plan)
                },
                "exists" => {
                    let exists: Array(edsl::ExistsRequest) =
                        array::map(array_opt(obj, "exists"), fn(item) { parse_exists(subject, item) });
                    let having: Array(edsl::HavingRequest) =
                        array::map(array_opt(obj, "having"), fn(item) { parse_having(subject, item) });
                    let plan: qb::Plan = edsl::lower_full(payload, request, exists, having);
                    qb::QueryPlan::Rows(plan)
                },
                "absence" => {
                    let absence: Array(edsl::ExistsRequest) =
                        array::map(array_opt(obj, "exists"), fn(item) { parse_exists(subject, item) });
                    let having: Array(edsl::HavingRequest) =
                        array::map(array_opt(obj, "having"), fn(item) { parse_having(subject, item) });
                    let plan: qb::Plan = edsl::lower_absence(payload, request, absence, having);
                    qb::QueryPlan::Rows(plan)
                },
                "compare" => {
                    let comparisons: Array(edsl::ScalarCompareRequest) =
                        array::map(as_array(field(obj, "comparisons")), fn(item) { parse_compare(subject, item) });
                    let base_plan: qb::Plan =
                        edsl::lower_attribute_compare(payload, request, comparisons);
                    let output_values = array_opt(obj, "output_order");
                    let output: Array(edsl::ProjectionToken) = array::map(output_values, parse_projection_token);
                    let plan = reorder_if_requested(payload, request, base_plan, output);
                    qb::QueryPlan::Rows(plan)
                },
                "ranked" => {
                    let comparisons: Array(edsl::RankedKeyCompareRequest) =
                        array::map(as_array(field(obj, "ranked")), fn(item) { parse_ranked_key(subject, item) });
                    let base_plan: qb::Plan =
                        edsl::lower_ranked_key_compare(payload, request, comparisons);
                    let output_values = array_opt(obj, "output_order");
                    let output: Array(edsl::ProjectionToken) = array::map(output_values, parse_projection_token);
                    let plan = reorder_if_requested(payload, request, base_plan, output);
                    qb::QueryPlan::Rows(plan)
                },
                _ => fail!("unsupported intent op", op),
            }
        }
    }
};

def query_intent_lower_factory: Fn(edsl::PreparedPayload, String) -> Fn(Value) -> qb::Query = fn(payload, subject) {
    fn(intent) { qb::transform_sqlite_query_plan(lower_intent_plan(payload, subject, intent)) }
};

def query_intent_plan_factory: Fn(edsl::PreparedPayload, String) -> Fn(Value) -> qb::QueryPlan = fn(payload, subject) {
    fn(intent) { qb::validate_query_plan(lower_intent_plan(payload, subject, intent)) }
};

# ---------------------------------------------------------------------------
# Pure structural feasibility probe (never fails).
#
# `query_intent_ok` returns False for an unauthorized subject, a non-object
# intent, an unknown op, an unsupported set kind or branch count, a malformed
# request field type, or a field-to-field predicate on a non-list shape.  It is
# a quick contract probe for green tests; the real lowering rejects the same
# shapes atomically with `fail!` diagnostics and never emits a partial Query.
# ---------------------------------------------------------------------------

def supported_intent_ops: Array(String) = [
    "list", "count", "aggregate", "top", "distinct", "exists", "absence",
    "set", "set_count", "compare", "ranked",
];

def supported_set_kinds: Array(String) = ["union", "intersect", "except"];

def is_string_value: Fn(Value) -> Bool = fn(value) {
    match value { Value::String(_) => True, _ => False }
};

def is_array_value: Fn(Value) -> Bool = fn(value) {
    match value { Value::Array(_) => True, _ => False }
};

def is_object_value: Fn(Value) -> Bool = fn(value) {
    match value { Value::Object(_) => True, _ => False }
};

def optional_null_or_int_ok: Fn(Option(Value)) -> Bool = fn(maybe) {
    match maybe {
        None => True,
        Some(value) => match value { Value::None => True, Value::Int(_) => True, _ => False },
    }
};

def string_array_ok: Fn(Value) -> Bool = fn(value) {
    match value {
        Value::Array(items) => array::all(items, is_string_value),
        _ => False,
    }
};

def projection_token_shape_ok: Fn(Value) -> Bool = fn(value) {
    match value {
        Value::String(_) => True,
        Value::Object(obj) => match (dict::get(obj, "kind"), dict::get(obj, "id")) {
            (Some(Value::String(kind)), Some(Value::String(_))) => kind == "measure" || kind == "dimension",
            _ => False,
        },
        _ => False,
    }
};

def projection_token_array_ok: Fn(Value) -> Bool = fn(value) {
    match value {
        Value::Array(items) => array::all(items, projection_token_shape_ok),
        _ => False,
    }
};

def filter_entry_shape_ok: Fn(Value) -> Bool = fn(value) {
    match value {
        Value::Object(obj) => do {
            let has_dimension = match dict::get(obj, "dimension") {
                Some(dimension) => is_string_value(dimension),
                None => False,
            };
            let left_right = match (dict::get(obj, "left"), dict::get(obj, "right")) {
                (Some(left), Some(right)) => is_string_value(left) && is_string_value(right),
                _ => False,
            };
            let has_op = match dict::get(obj, "op") { Some(op) => is_string_value(op), None => False };
            (has_dimension || left_right) && has_op
        },
        _ => False,
    }
};

def request_field_shape_ok: Fn(Dict(Value)) -> Bool = fn(obj) {
    let measures_ok = match dict::get(obj, "measures") { Some(value) => string_array_ok(value), None => False };
    let dimensions_ok = match dict::get(obj, "dimensions") { Some(value) => string_array_ok(value), None => False };
    let filters_ok = match dict::get(obj, "filters") {
        Some(value) => match value { Value::Array(items) => array::all(items, filter_entry_shape_ok), _ => False },
        None => False,
    };
    let ordering_ok = match dict::get(obj, "ordering") { Some(value) => is_array_value(value), None => False };
    let limit_ok = optional_null_or_int_ok(dict::get(obj, "limit"));
    let offset_ok = optional_null_or_int_ok(dict::get(obj, "offset"));
    let output_ok = match dict::get(obj, "output_order") {
        None => True,
        Some(value) => projection_token_array_ok(value),
    };
    let exists_ok = match dict::get(obj, "exists") { None => True, Some(value) => is_array_value(value) };
    let having_ok = match dict::get(obj, "having") { None => True, Some(value) => is_array_value(value) };
    let hidden_having_ok = match dict::get(obj, "hidden_having") { None => True, Some(value) => is_array_value(value) };
    measures_ok && dimensions_ok && filters_ok && ordering_ok
        && limit_ok && offset_ok && output_ok && exists_ok && having_ok && hidden_having_ok
};

def set_branch_object_ok: Fn(Value) -> Bool = fn(value) {
    match value {
        Value::Object(obj) => do {
            let shape_ok = match dict::get(obj, "shape") {
                Some(Value::String(shape)) => array::any(["row", "exists", "absence"], fn(ok) { ok == shape }),
                _ => False,
            };
            shape_ok && request_field_shape_ok(obj)
        },
        _ => False,
    }
};

def query_intent_ok: Fn(edsl::PreparedPayload, String, Value) -> Bool = fn(payload, subject, intent) {
    if !payload.authorize(subject) {
        False
    } else {
        match intent {
            Value::Object(obj) => match dict::get(obj, "op") {
                None => False,
                Some(value) => match value {
                    Value::String(op) => do {
                        let op_known = array::any(supported_intent_ops, fn(ok) { ok == op });
                        if !op_known {
                            False
                        } else if op == "set" || op == "set_count" {
                            let kind_ok = match dict::get(obj, "kind") {
                                Some(Value::String(kind)) => array::any(supported_set_kinds, fn(ok) { ok == kind }),
                                _ => False,
                            };
                            let branches_ok = match dict::get(obj, "branches") {
                                Some(Value::Array(branches)) => array::length(branches) == 2
                                    && array::all(branches, set_branch_object_ok),
                                _ => False,
                            };
                            kind_ok && branches_ok
                        } else if request_field_shape_ok(obj) {
                            let field_values = field_filter_items(array_opt(obj, "filters"));
                            if op == "list" {
                                True
                            } else if array::length(field_values) != 0 {
                                False
                            } else if op == "compare" {
                                match dict::get(obj, "comparisons") { Some(value) => is_array_value(value), None => False }
                            } else if op == "ranked" {
                                match dict::get(obj, "ranked") { Some(value) => is_array_value(value), None => False }
                            } else {
                                True
                            }
                        } else {
                            False
                        }
                    },
                    _ => False,
                },
            },
            _ => False,
        }
    }
};

pub use self::{ query_intent_lower_factory, query_intent_plan_factory, query_intent_ok };
