@domain::subject("FileSystem", "obj_id")
@domain::dataset("kpi-storage-cloud-block-file-system", "kpi_storage_cloudBlockFileSystem", ["obj_id","ts"])
@domain::metric("ts")
pub type KpiStorageCloudBlockFileSystem = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-storage-cloud-block-file-system/obj_id", domain::Reference(ids::CloudBlockFileSystem2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "scbfs_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::CloudBlockFileSystem2KpiByObjId),
    @m::column("TS")
