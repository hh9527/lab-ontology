use ontology::semantic as s;
use ontology::preparation as prepared;
use ontology::samples as samples;
use ontology::quantity as q;
use ontology::scalars as scalars;
use std::test;

@s::entity_by("Device")
type DeviceId = struct(String);
@s::bind(DeviceId.type, "id")
@s::dataset("samples", "samples", ["id", "ts"])
@s::metric("ts")
type Row = struct {
    id: s::Reference(DeviceId),
    ts: scalars::DateTimeUtc,
    @samples::valid_count("effective")
    cpu: Option(q::Percent),
    effective: q::EffectiveCount
};
pub def a_reference_can_bind_the_observed_entity: test::Test = test::should_ok(fn() {prepared::prepare(Row.type)});
pub def valid_collection_counts_do_not_become_mean_weights: test::Test = test::should_ok(fn() {
    let contract = samples::mean_contract(Row.type, "cpu");
    if contract.population == "NonNullReportedValues" && contract.weighting == "EqualPerReportedValue" && contract.valid_count == Some("effective") { () }
    else {fail!("mean population must remain reported values")}
});
type MissingCounter = struct {
    @samples::valid_count("absent")
    value: Float
};
pub def valid_count_requires_an_existing_field: test::Test = test::should_fail_with(fn() {samples::valid_count_field(MissingCounter.type, "value")}, "valid_count field does not exist");
type PlainCounter = struct {
    @samples::valid_count("count")
    value: Float,
    count: Int
};
pub def a_plain_integer_is_not_a_valid_collection_counter: test::Test = test::should_fail_with(fn() {samples::valid_count_field(PlainCounter.type, "value")}, "separate EffectiveCount");
@s::bind(DeviceId.type, "id")
@s::dataset("nullable", "nullable", ["ts"])
type NullableId = struct {
    id: Option(s::Reference(DeviceId)),
    ts: scalars::DateTimeUtc
};
pub def a_nullable_reference_is_not_an_entity_binding: test::Test = test::should_fail_with(fn() {prepared::prepare(NullableId.type)}, "row identity binding has incompatible type");
pub def reported_counts_do_not_imply_additive_counter_semantics: test::Test = test::should_fail_with(fn() {
    samples::group("errors", q::ReportedCount.type, samples::Statistic::Mean, [samples::Statistic::Sum], None)
}, "exceeds type calculation capabilities");
pub def reported_count_means_retain_a_floating_nominal_type: test::Test = test::should_ok(fn() {
    if q::mean_result_type(q::ReportedCount.type) == Some(q::MeanReportedCount.type) { () }
    else {fail!("count mean must retain a floating business representation")}
});
