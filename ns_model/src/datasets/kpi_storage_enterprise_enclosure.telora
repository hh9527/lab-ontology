use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
@domain::subject("Chassis", "obj_id")
@domain::dataset("kpi-storage-enterprise-enclosure", "kpi_storage_enterpriseEnclosure", ["obj_id","ts"])
@domain::metric("ts")
pub type KpiStorageEnterpriseEnclosure = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-storage-enterprise-enclosure/obj_id", domain::Reference(ids::EnterpriseEnclosure2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "see_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::EnterpriseEnclosure2KpiByObjId),
    @m::column("TS")
    @g::field_view(g::dimension_group("kpi-storage-enterprise-enclosure/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "see_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("see_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("see_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("see_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("TEMPERATURE")
    @g::field_view(g::dimension_group("kpi-storage-enterprise-enclosure/temperature", metric::KpiStorageEnterpriseEnclosureTemperature.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "see_temperature_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-storage-enterprise-enclosure/temperature", metric::KpiStorageEnterpriseEnclosureTemperature.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("°C")), [{statistic: samples::Statistic::Mean, publish: "see_temperature"}, {statistic: samples::Statistic::Max, publish: "see_temperature_max"}, {statistic: samples::Statistic::Min, publish: "see_temperature_min"}])
    temperature: Option(metric::KpiStorageEnterpriseEnclosureTemperature),
    @m::column("POWER")
    @g::field_view(g::dimension_group("kpi-storage-enterprise-enclosure/power", metric::KpiStorageEnterpriseEnclosurePower.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "see_power_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-storage-enterprise-enclosure/power", metric::KpiStorageEnterpriseEnclosurePower.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("W")), [{statistic: samples::Statistic::Mean, publish: "see_power"}, {statistic: samples::Statistic::Max, publish: "see_power_max"}, {statistic: samples::Statistic::Min, publish: "see_power_min"}])
    power: Option(metric::KpiStorageEnterpriseEnclosurePower),
};
