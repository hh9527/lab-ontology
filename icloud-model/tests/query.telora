def two_metric_qualifications: String = `{"op":"qualify_metrics","measures":[],"dimensions":["device_id"],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"cpu_usage","op":"ge","kind":"number","value":40}},{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-10T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"port_count","op":"ge","kind":"int","value":8}}]}`;

def zero_to_four_samples: String = `{"op":"qualify_sample_count","measures":[],"dimensions":["device_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[{"dimension":"port_count_sample","op":"gt","kind":"int","value":90}],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"min_matches":0,"max_matches":4}]}`;

pub def bounded_sample_count_includes_zero_without_a_lower_bound: test::Test = test::should_ok(fn() {
    let q = lower_json(zero_to_four_samples);
    if array::length(string::split(q.sql, "NOT EXISTS (SELECT 1 FROM NetworkDeviceKPI AS k_samples")) == 2
        && array::length(string::split(q.sql, "HAVING count(k_samples.resId) > ?")) == 2
        && array::length(string::split(q.sql, "d.tenant_id = k_samples.tenantId")) == 2
        && q.bindings == [qb::Val::String("2024-02-01T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z"), qb::Val::Int(90), qb::Val::Int(4)] {
        True
    } else { fail!("upper sample-count bound must include zero without a positive lower bound", q) }
});

pub def bounded_sample_count_can_exclude_zero_explicitly: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"qualify_sample_count","measures":[],"dimensions":["device_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[{"dimension":"port_count_sample","op":"gt","kind":"int","value":90}],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"min_matches":1,"max_matches":4}]}`);
    if array::length(string::split(q.sql, "EXISTS (SELECT 1 FROM NetworkDeviceKPI AS k_samples")) == 3
        && array::length(string::split(q.sql, "HAVING count(k_samples.resId) >= ?")) == 2
        && array::length(string::split(q.sql, "HAVING count(k_samples.resId) > ?")) == 2 {
        True
    } else { fail!("positive lower bound must be independent of excluded upper bound", q) }
});

pub def bounded_sample_count_rejects_reversed_bounds: test::Test = test::should_fail_with(fn() {
