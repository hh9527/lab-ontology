use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::network_element;
use crate::datasets::pon_element;
use crate::datasets::enterprise_ap;
use crate::datasets::huawei_storage_device;
use crate::datasets::physical_server;
@domain::subject("Subnet", "id")
@domain::dataset("subnet", "Subnet", ["id"])
@domain::relations(relations)
pub type Subnet = struct {
    @g::field_view(g::dimension_group("subnet/id", ids::SubnetById.type, True, [g::Filter::Eq]), "subnet_id", True, [g::Filter::Eq])
    @domain::count("subnet_count")
    id: ids::SubnetById,
    @g::field_view(g::dimension_group("subnet/name", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "subnet_name", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    name: String,
    @g::field_view(g::dimension_group("subnet/alias", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "subnet_alias", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    alias: Option(String),
    @m::column("typeId")
    @g::field_view(g::dimension_group("subnet/type_id", String.type, True, [g::Filter::Eq]), "subnet_type_id", True, [g::Filter::Eq])
    type_id: Option(String),
    @m::column("refParentSubnet")
    @g::field_view(g::dimension_group("subnet/ref_parent_subnet", domain::Reference(ids::SubnetById).type, True, [g::Filter::Eq]), "subnet_parent_id", True, [g::Filter::Eq])
    ref_parent_subnet: Option(domain::Reference(ids::SubnetById)),
    @g::field_view(g::dimension_group("subnet/remark", String.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith]), "subnet_remark", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Contains, g::Filter::NotContains, g::Filter::StartsWith, g::Filter::EndsWith])
    remark: Option(String),
    @m::column("createTime")
    @g::field_view(g::dimension_group("subnet/create_time", s::EpochMillis.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "subnet_create_ms", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    create_time: Option(s::EpochMillis),
};

pub def relations: Array(r::Relation) = [
    r::relation("subnet_contains_ne", domain::endpoint(Subnet.type, "id"), domain::endpoint(network_element::NetworkElement.type, "ref_parent_subnet"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("subnet_contains_subnet", domain::endpoint(Subnet.type, "id"), domain::endpoint(Subnet.type, "ref_parent_subnet"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation("subnet_in_parent_subnet", domain::endpoint(Subnet.type, "ref_parent_subnet"), domain::endpoint(Subnet.type, "id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("subnet__pe_rev", domain::endpoint(Subnet.type, "id"), domain::endpoint(pon_element::PonElement.type, "ref_parent_subnet"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("subnet__ea_rev", domain::endpoint(Subnet.type, "id"), domain::endpoint(enterprise_ap::EnterpriseAp.type, "ref_parent_subnet"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("subnet__hsd_rev", domain::endpoint(Subnet.type, "id"), domain::endpoint(huawei_storage_device::HuaweiStorageDevice.type, "ref_parent_subnet"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("subnet__ps_rev", domain::endpoint(Subnet.type, "id"), domain::endpoint(physical_server::PhysicalServer.type, "ref_parent_subnet"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
