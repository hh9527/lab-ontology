use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::storage_logic_port;
use crate::datasets::kpi_storage_enterprise_logical_port;
@domain::subject("StorageLogicPort", "obj_sys_id")
@domain::dataset("enterprise-logical-port-2-kpi", "enterpriseLogicalPort2KPI", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseLogicalPort2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("enterprise-logical-port-2-kpi/obj_sys_id", ids::EnterpriseLogicalPort2KpiByObjSysId.type, True, [g::Filter::Eq]), "elp2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("elp2_count")
    obj_sys_id: ids::EnterpriseLogicalPort2KpiByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("enterprise-logical-port-2-kpi/obj_id", domain::Reference(ids::EnterpriseLogicalPort2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "elp2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseLogicalPort2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("elp2__slp", domain::endpoint(EnterpriseLogicalPort2Kpi.type, "obj_sys_id"), domain::endpoint(storage_logic_port::StorageLogicPort.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("elp2__selp", domain::endpoint(EnterpriseLogicalPort2Kpi.type, "obj_id"), domain::endpoint(kpi_storage_enterprise_logical_port::KpiStorageEnterpriseLogicalPort.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
