use ontology::quantity as statistic_quantity;
use super::metric_values as metric;
use ontology::quantity as presentation;
use ontology::semantic as domain;
# 网络设备样本：保留来源尺度、最新整行选择和端口存量的样本均值、峰值。
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::quantity as q;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
use ontology::quantity::{Percent};
# 来源在线率暂按百分比；不确认生产尺度或与其他在线率总体互换。
# 来源定义为设备端口在线比例，百分比尺度。
@presentation::unit("ms", "time", 0.001)
@presentation::calculations([presentation::Calculation::Compare, presentation::Calculation::Mean,
    presentation::Calculation::Min, presentation::Calculation::Max, presentation::Calculation::Round])
type MeanPingResponseTime = struct(Float);
@presentation::unit("ms", "time", 0.001)
@presentation::calculations([presentation::Calculation::Compare, presentation::Calculation::Mean,
    presentation::Calculation::Min, presentation::Calculation::Max, presentation::Calculation::Round])
@presentation::mean_result(MeanPingResponseTime.type)
type PingResponseTime = struct(Int);
def ping_statistics: samples::Group(PingResponseTime) = samples::group(
    "device_ping_response", PingResponseTime.type, samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max], None
);
@domain::bind(i::DeviceById.type, "res_id")
@g::groupable(["device_kpi__classification"])
@r::sources("device_kpi_of_device", ["source_EntNetworkElement_NetworkDeviceKPI"])
@domain::dataset("device_kpi", "NetworkDeviceKPI", ["res_id", "tenant_id", "ts"])
@domain::record_counts(["device_kpi_sample_count"])
@domain::metric("ts")
@domain::relations(relations)
@v::computed_domain(
    i::device_class_domain,
    "device_kpi__classification",
    "source_classification",
    i::DeviceClass::Unknown
)
type NetworkDeviceKPI = struct {
    @m::column("resId")
    @g::exact("device_kpi_res_id")
    res_id: domain::Reference(i::DeviceById),
    @m::column("tenantId")
    @g::exact("device_kpi_tenant_id")
    tenant_id: i::TenantId,
    @g::view("device_kpi_ts_raw", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("device_kpi_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("device_kpi_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("device_kpi_utc_month", qb::UtcBucketUnit::Month)
    @edsl::field_role(edsl::FieldRole::Classification)
    ts: s::DateTimeUtc,
    @m::column("cpuUsage")
    @g::view("device_cpu_sample", True, g::numeric_filters)
    @samples::field(
        metric::cpu_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "cpu_usage"},
            {statistic: samples::Statistic::Latest, publish: "device_cpu_latest"},
            {statistic: samples::Statistic::Max, publish: "cpu_peak"},
            {statistic: samples::Statistic::Min, publish: "device_cpu_sample_min"}
        ]
    )
    @samples::valid_count("source_cpuUsageEffcnt")
    @domain::count("cpu_usage_observation_count")
    cpu_usage: metric::CpuUtilization,
    @m::column("memUsage")
    @g::view("device_memory_sample", True, g::numeric_filters)
    @samples::field(
        metric::memory_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "memory_usage"},
            {statistic: samples::Statistic::Latest, publish: "device_memory_latest"},
            {statistic: samples::Statistic::Max, publish: "memory_peak"},
            {statistic: samples::Statistic::Min, publish: "device_memory_sample_min"}
        ]
    )
    @samples::valid_count("source_memUsageEffcnt")
    @domain::count("memory_usage_observation_count")
    mem_usage: metric::MemoryUtilization,
    @m::column("nePingRespTime")
    @g::view("device_ping_response_sample", True, g::numeric_filters)
    @samples::field(ping_statistics, [
        {statistic: samples::Statistic::Mean, publish: "device_ping_response_avg"},
        {statistic: samples::Statistic::Min, publish: "device_ping_response_min"},
        {statistic: samples::Statistic::Max, publish: "device_ping_response_max"}
    ])
    @domain::count("device_ping_response_observation_count")
    ping_response_time: Option(PingResponseTime),
    @m::column("portCount")
    @g::view("port_count_sample", True, g::numeric_filters)
    @samples::field(
        port_count_statistics,
        [
            {statistic: samples::Statistic::Max, publish: "port_count_peak"},
            {statistic: samples::Statistic::Mean, publish: "port_count_sample_avg"}
        ]
    )
    @samples::valid_count("source_portCountEffcnt")
    @domain::count("port_count_sample_avg_observation_count")
    port_count: q::Count,
    @m::column("portUsedCount")
    @g::view("used_port_sample", True, g::numeric_filters)
    @samples::field(
        port_used_count_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "used_port_sample_avg"},
            {statistic: samples::Statistic::Max, publish: "used_port_sample_max"}
        ]
    )
    @samples::valid_count("source_portUsedCountEffcnt")
    @domain::count("used_port_sample_avg_observation_count")
    port_used_count: q::Count,
    @m::column("operStatusCount")
    @g::view("running_port_sample", True, g::numeric_filters)
    @samples::field(
        oper_status_count_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "running_port_sample_avg"}
        ]
    )
    @samples::valid_count("source_operStatusCountEffcnt")
    @domain::count("running_port_sample_avg_observation_count")
    oper_status_count: q::Count,
    @m::column("adminStatusCount")
    @g::view("admin_port_sample", True, g::numeric_filters)
    @samples::valid_count("source_adminStatusCountEffcnt")
    admin_status_count: q::Count,
    @m::column("parentId")
    @g::exact("device_kpi__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("device_kpi__projectId")
    source_projectId: String,
    @m::column("deviceName")
    @g::search("device_kpi__deviceName")
    source_deviceName: String,
    @m::column("classification")
    @edsl::field_role(edsl::FieldRole::Classification)
    @g::exact("device_kpi__classification_raw")
    source_classification: String,
    @m::column("onlineRate")
    @g::view("device_kpi__onlineRate", True, g::numeric_filters)
    @samples::field(
        metric::online_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "device_online_rate_avg"},
            {statistic: samples::Statistic::Min, publish: "device_online_rate_min"},
            {statistic: samples::Statistic::Max, publish: "device_online_rate_max"}
        ]
    )
    @samples::valid_count("source_onlineRateEffcnt")
    @domain::count("device_online_rate_avg_observation_count")
    source_onlineRate: metric::OnlineProportion,
    @m::column("ifUtilizationRate")
    @g::view("device_kpi__ifUtilizationRate", True, g::numeric_filters)
    @samples::field(
        metric::DevicePortUtilization_statistics,
        [
            {statistic: samples::Statistic::Mean, publish: "device_port_usage_avg"},
            {statistic: samples::Statistic::Max, publish: "device_port_usage_max"},
            {statistic: samples::Statistic::Min, publish: "device_port_usage_min"}
        ]
    )
    @samples::valid_count("source_ifUtilizationRateEffcnt")
    @domain::count("device_port_usage_avg_observation_count")
    source_ifUtilizationRate: metric::DevicePortUtilization,
    @m::column("cpuUsageEffcnt")
    @g::view("device_kpi__cpuUsageEffcnt", True, g::numeric_filters)
    source_cpuUsageEffcnt: statistic_quantity::EffectiveCount,
    @m::column("memUsageEffcnt")
    @g::view("device_kpi__memUsageEffcnt", True, g::numeric_filters)
    source_memUsageEffcnt: statistic_quantity::EffectiveCount,
    @m::column("onlineRateEffcnt")
    @g::view("device_kpi__onlineRateEffcnt", True, g::numeric_filters)
    source_onlineRateEffcnt: statistic_quantity::EffectiveCount,
    @m::column("ifUtilizationRateEffcnt")
    @g::view("device_kpi__ifUtilizationRateEffcnt", True, g::numeric_filters)
    source_ifUtilizationRateEffcnt: statistic_quantity::EffectiveCount,
    @m::column("portCountEffcnt")
    @g::view("device_kpi__portCountEffcnt", True, g::numeric_filters)
    source_portCountEffcnt: statistic_quantity::EffectiveCount,
    @m::column("portUsedCountEffcnt")
    @g::view("device_kpi__portUsedCountEffcnt", True, g::numeric_filters)
    source_portUsedCountEffcnt: statistic_quantity::EffectiveCount,
    @m::column("operStatusCountEffcnt")
    @g::view("device_kpi__operStatusCountEffcnt", True, g::numeric_filters)
    source_operStatusCountEffcnt: statistic_quantity::EffectiveCount,
    @m::column("adminStatusCountEffcnt")
    @g::view("device_kpi__adminStatusCountEffcnt", True, g::numeric_filters)
    source_adminStatusCountEffcnt: statistic_quantity::EffectiveCount,
};
def device: r::Endpoint = domain::endpoint(NetworkDeviceKPI.type, "res_id");
def port_count_statistics: samples::Group(q::Count) = samples::group(
    "device_port_count",
    q::Count.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max],
    None
);
def port_used_count_statistics: samples::Group(q::Count) = samples::group(
    "device_port_used_count",
    q::Count.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max],
    None
);
def oper_status_count_statistics: samples::Group(q::Count) = samples::group(
    "device_oper_status_count",
    q::Count.type,
    samples::Statistic::Mean,
    [],
    None
);
def relations: Array(r::Relation) = [
    r::relation(
        "device_kpi_of_device",
        device,
        i::device_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{NetworkDeviceKPI};
