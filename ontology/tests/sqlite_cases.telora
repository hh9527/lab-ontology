# 真实 SQLite 执行夹具，检查三值条件、匹配顺序和嵌套 THEN
use crate::query as qb;
use crate::sqlite as sqlite;
use std::codec as codec;
use std::value::{Value};
type Case = struct { query: qb::Query, expected: Int };
def no: (qb::BuildCtx, qb::Expr) = qb::bind(qb::build_context(), qb::Val::Bool(False));
def unknown: (qb::BuildCtx, qb::Expr) = qb::bind(no.0, qb::Val::None);
def yes: (qb::BuildCtx, qb::Expr) = qb::bind(unknown.0, qb::Val::Bool(True));
def seven: (qb::BuildCtx, qb::Expr) = qb::bind(yes.0, qb::Val::Int(7));
def nine: (qb::BuildCtx, qb::Expr) = qb::bind(seven.0, qb::Val::Int(9));
def fallback: (qb::BuildCtx, qb::Expr) = qb::bind(nine.0, qb::Val::Int(11));
def cases: Array(Case) = [
    {query: sqlite::render_sqlite_expr_with_context(qb::scalar_if(unknown.1, seven.1, qb::scalar_if(yes.1, nine.1, fallback.1)), fallback.0), expected: 9},
    {query: sqlite::render_sqlite_expr_with_context(qb::scalar_if(yes.1, seven.1, qb::scalar_if(yes.1, nine.1, fallback.1)), fallback.0), expected: 7},
    {query: sqlite::render_sqlite_expr_with_context(qb::scalar_if(yes.1, qb::scalar_if(no.1, seven.1, nine.1), fallback.1), fallback.0), expected: 9},
    {query: sqlite::render_sqlite_expr_with_context(qb::scalar_if(no.1, seven.1, qb::scalar_if(unknown.1, nine.1, fallback.1)), fallback.0), expected: 11},
];
pub def runtime_cases: Value = codec::encode(cases);
