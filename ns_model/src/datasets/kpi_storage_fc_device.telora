use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::fc_device_2_kpi;
@domain::subject("FcSwitchDevice", "obj_id")
@domain::dataset("kpi-storage-fc-device", "kpi_storage_FcDevice", ["obj_id","ts"])
@domain::metric("ts")
@domain::relations(relations)
pub type KpiStorageFcDevice = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-storage-fc-device/obj_id", domain::Reference(ids::FcDevice2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "sfd_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::FcDevice2KpiByObjId),
    @m::column("TS")
    @g::field_view(g::dimension_group("kpi-storage-fc-device/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "sfd_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("sfd_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("sfd_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("sfd_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("CPUUSAGE")
    @g::field_view(g::dimension_group("kpi-storage-fc-device/cpu_usage", metric::KpiStorageFcDeviceCpuUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sfd_cpu_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-storage-fc-device/cpu_usage", metric::KpiStorageFcDeviceCpuUsage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "sfd_cpu_usage"}, {statistic: samples::Statistic::Max, publish: "sfd_cpu_usage_max"}, {statistic: samples::Statistic::Min, publish: "sfd_cpu_usage_min"}])
    cpu_usage: Option(metric::KpiStorageFcDeviceCpuUsage),
    @m::column("MEMORYUSAGE")
    @g::field_view(g::dimension_group("kpi-storage-fc-device/memory_usage", metric::KpiStorageFcDeviceMemoryUsage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sfd_memory_usage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-storage-fc-device/memory_usage", metric::KpiStorageFcDeviceMemoryUsage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "sfd_memory_usage"}, {statistic: samples::Statistic::Max, publish: "sfd_memory_usage_max"}, {statistic: samples::Statistic::Min, publish: "sfd_memory_usage_min"}])
    memory_usage: Option(metric::KpiStorageFcDeviceMemoryUsage),
};

pub def relations: Array(r::Relation) = [
    r::relation("sfd__fd2_rev", domain::endpoint(KpiStorageFcDevice.type, "obj_id"), domain::endpoint(fc_device_2_kpi::FcDevice2Kpi.type, "obj_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
