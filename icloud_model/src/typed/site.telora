use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 站点独立声明，保留设备定位的两个备选身份角色
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
@domain::entity_by("Site")
type SiteById = struct(i::SiteId);
@knowledge_policy::reverse_references(True)
type SiteType = enum {
    @ev::rename("onlineSite")
    @ev::description("Online site", "线上站点")
    Online,
    @ev::rename("offlineSite")
    @ev::description("Offline site", "线下站点")
    Offline,
};
@domain::subject("Site", "site_id")
@domain::dataset("site", "X_SITE_VIEW", ["site_id"])
@domain::relations(relations)
@domain::alternatives(alternatives)
type XSiteView = struct {
    @m::column("SITE_ID")
    @g::exact("site_id")
    site_id: SiteById,
    @m::column("SITE_NAME")
    @g::search("site_name")
    site_name: String,
    @m::column("SITE_TYPE")
    @v::classification(types, "site_type")
    site_type: String,
    @m::column("TENANT_ID")
    tenant_id: domain::Reference(i::TenantById),
    @m::column("PARENT_SITE_ID")
    @g::exact("site__PARENT_SITE_ID")
    source_PARENT_SITE_ID: String,
    @m::column("SITE_ALIAS")
    @g::search("site__SITE_ALIAS")
    source_SITE_ALIAS: String,
    # 保留基线 UTC 毫秒假定，尚未确认生产单位
    @m::column("CREATE_TIME")
    @g::field_view(
        g::dimension_group("utc_epoch", s::EpochMillis.type, True, g::time_filters),
        "site__CREATE_TIME",
        True,
        g::time_filters
    )
    source_CREATE_TIME: s::EpochMillis,
};

def subject: r::Endpoint = domain::endpoint(XSiteView.type, "site_id");
def tenant: r::Endpoint = domain::endpoint(XSiteView.type, "tenant_id");
def project: r::Endpoint = domain::endpoint(i::IEntNetworkElement.type, "project_id");
def subnet: r::Endpoint = domain::endpoint(i::IEntNetworkElement.type, "ref_parent_subnet");
def types: v::Domain(SiteType, String) = v::from_enum("SiteType", SiteType.type, String.type, False);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Many0,
    to: edsl::Cardinality::Optional
};
def relations: Array(r::Relation) = [
    r::relation("site_belongs_to_tenant", tenant, i::tenant_subject, cardinality),
    r::relation(
        "source_X_TENANT_VIEW_X_SITE_VIEW",
        i::tenant_subject,
        tenant,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
def alternatives: Array(domain::Alternative) = [
    {
        id: "device_located_at_site",
        cardinality,
        choices: [
            r::relation("device_project_site", project, subject, cardinality),
            r::relation("device_subnet_site", subnet, subject, cardinality)
        ]
    },
    {
        id: "source_EntNetworkElement_X_SITE_VIEW",
        cardinality,
        choices: [
            r::relation("source_device_project_site", project, subject, cardinality),
            r::relation("source_device_subnet_site", subnet, subject, cardinality)
        ]
    },
];
pub use self::{relations, alternatives, project, subnet, SiteById, subject};

pub use self::{XSiteView};
