# 网络设备样本：保留来源尺度、最新整行选择和明确的计数样本加总。
use super::inventory as i;
use ontology::model as m;
use ontology::groups as g;
use ontology::quantity as q;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
type Percent = struct(
    Float
);
# 来源在线率暂按百分比；不确认生产尺度或与其他在线率总体互换。
type ReportedOnlinePercent = struct(
    Float
);
# 来源未定义数值尺度或分子分母，不能推导端口数比值。
type ReportedPortUsage = struct(
    Float
);
type Row = struct {
    res_id: i::DeviceId,
    tenant_id: i::TenantId,
    ts: s::DateTimeUtc,
    cpu_usage: Percent,
    mem_usage: Percent,
    port_count: q::Count,
    port_used_count: q::Count,
    oper_status_count: q::Count,
    admin_status_count: q::Count,
    source_parentId: String,
    source_projectId: String,
    source_deviceName: String,
    source_classification: String,
    source_onlineRate: ReportedOnlinePercent,
    source_ifUtilizationRate: ReportedPortUsage,
    source_cpuUsageEffcnt: Int,
    source_memUsageEffcnt: Int,
    source_onlineRateEffcnt: Int,
    source_ifUtilizationRateEffcnt: Int,
    source_portCountEffcnt: Int,
    source_portUsedCountEffcnt: Int,
    source_operStatusCountEffcnt: Int,
    source_adminStatusCountEffcnt: Int,
};
def dataset: m::Dataset(Row) = m::dataset(
    "device_kpi",
    "NetworkDeviceKPI",
    Row.type,
    ["res_id", "tenant_id", "ts"]
);
def device: m::Role(Row) = m::role(
    dataset,
    i::device,
    "device",
    False,
    [
        m::identity_part(
            m::field(Row.type, i::DeviceId.type, "res_id"),
            m::field(i::DeviceIdentity.type, i::DeviceId.type, "id")
        )
    ]
);
def cpu_usage_statistics: samples::Group(Percent) = samples::group(
    "device_cpu_usage",
    Percent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Latest, samples::Statistic::Max, samples::Statistic::Min],
    Some("%")
);
def port_count_statistics: samples::Group(q::Count) = samples::group(
    "device_port_count",
    q::Count.type,
    samples::Statistic::Sum,
    [samples::Statistic::Max, samples::Statistic::Mean],
    None
);
def port_used_count_statistics: samples::Group(q::Count) = samples::group(
    "device_port_used_count",
    q::Count.type,
    samples::Statistic::Sum,
    [samples::Statistic::Mean, samples::Statistic::Max],
    None
);
def oper_status_count_statistics: samples::Group(q::Count) = samples::group(
    "device_oper_status_count",
    q::Count.type,
    samples::Statistic::Sum,
    [samples::Statistic::Mean],
    None
);
def source_onlineRate_statistics: samples::Group(ReportedOnlinePercent) = samples::group(
    "device_source_onlineRate",
    ReportedOnlinePercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max],
    Some("%")
);
def source_ifUtilizationRate_statistics: samples::Group(ReportedPortUsage) = samples::group(
    "device_source_ifUtilizationRate",
    ReportedPortUsage.type,
    samples::Statistic::Mean,
    [samples::Statistic::Max, samples::Statistic::Min],
    None
);
def declaration: t::Declaration = t::with_samples(
    t::metric(
        t::map_columns(
            t::declare(
                dataset,
                [device],
                [
                    i::exact(
                        dataset,
                        m::field(Row.type, i::DeviceId.type, "res_id"),
                        "device_kpi_res_id"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, i::TenantId.type, "tenant_id"),
                        "device_kpi_tenant_id"
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi_ts_raw",
                            s::DateTimeUtc.type,
                            True,
                            [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
                        ),
                        g::input(m::field(Row.type, s::DateTimeUtc.type, "ts")),
                        "device_kpi_ts_raw",
                        True,
                        [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
                        g::utc_bucket(
                            g::input(m::field(Row.type, s::DateTimeUtc.type, "ts")),
                            qb::UtcBucketUnit::Hour
                        ),
                        "device_kpi_utc_hour",
                        True,
                        g::time_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
                        g::utc_bucket(
                            g::input(m::field(Row.type, s::DateTimeUtc.type, "ts")),
                            qb::UtcBucketUnit::Day
                        ),
                        "device_kpi_utc_day",
                        True,
                        g::time_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
                        g::utc_bucket(
                            g::input(m::field(Row.type, s::DateTimeUtc.type, "ts")),
                            qb::UtcBucketUnit::Month
                        ),
                        "device_kpi_utc_month",
                        True,
                        g::time_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_cpu_sample",
                            Percent.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Percent.type, "cpu_usage")),
                        "device_cpu_sample",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_memory_sample",
                            Percent.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Percent.type, "mem_usage")),
                        "device_memory_sample",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "port_count_sample",
                            q::Count.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, q::Count.type, "port_count")),
                        "port_count_sample",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "used_port_sample",
                            q::Count.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, q::Count.type, "port_used_count")),
                        "used_port_sample",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "running_port_sample",
                            q::Count.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, q::Count.type, "oper_status_count")),
                        "running_port_sample",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "admin_port_sample",
                            q::Count.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, q::Count.type, "admin_status_count")),
                        "admin_port_sample",
                        True,
                        g::numeric_filters
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_parentId"),
                        "device_kpi__parentId"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_projectId"),
                        "device_kpi__projectId"
                    ),
                    i::search(
                        dataset,
                        m::field(Row.type, String.type, "source_deviceName"),
                        "device_kpi__deviceName"
                    ),
                    i::exact(
                        dataset,
                        m::field(Row.type, String.type, "source_classification"),
                        "device_kpi__classification"
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__onlineRate",
                            ReportedOnlinePercent.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(
                            m::field(Row.type, ReportedOnlinePercent.type, "source_onlineRate")
                        ),
                        "device_kpi__onlineRate",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__ifUtilizationRate",
                            ReportedPortUsage.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(
                            m::field(Row.type, ReportedPortUsage.type, "source_ifUtilizationRate")
                        ),
                        "device_kpi__ifUtilizationRate",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__cpuUsageEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_cpuUsageEffcnt")),
                        "device_kpi__cpuUsageEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__memUsageEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_memUsageEffcnt")),
                        "device_kpi__memUsageEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__onlineRateEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_onlineRateEffcnt")),
                        "device_kpi__onlineRateEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__ifUtilizationRateEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_ifUtilizationRateEffcnt")),
                        "device_kpi__ifUtilizationRateEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__portCountEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_portCountEffcnt")),
                        "device_kpi__portCountEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__portUsedCountEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_portUsedCountEffcnt")),
                        "device_kpi__portUsedCountEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__operStatusCountEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_operStatusCountEffcnt")),
                        "device_kpi__operStatusCountEffcnt",
                        True,
                        g::numeric_filters
                    ),
                    g::dimension(
                        dataset,
                        g::dimension_group(
                            "device_kpi__adminStatusCountEffcnt",
                            Int.type,
                            True,
                            g::numeric_filters
                        ),
                        g::input(m::field(Row.type, Int.type, "source_adminStatusCountEffcnt")),
                        "device_kpi__adminStatusCountEffcnt",
                        True,
                        g::numeric_filters
                    ),
                ],
                ["device_kpi_sample_count"]
            ),
            [
                t::column(m::field(Row.type, i::DeviceId.type, "res_id"), "resId"),
                t::column(m::field(Row.type, i::TenantId.type, "tenant_id"), "tenantId"),
                t::column(m::field(Row.type, s::DateTimeUtc.type, "ts"), "ts"),
                t::column(m::field(Row.type, Percent.type, "cpu_usage"), "cpuUsage"),
                t::column(m::field(Row.type, Percent.type, "mem_usage"), "memUsage"),
                t::column(m::field(Row.type, q::Count.type, "port_count"), "portCount"),
                t::column(m::field(Row.type, q::Count.type, "port_used_count"), "portUsedCount"),
                t::column(m::field(Row.type, q::Count.type, "oper_status_count"), "operStatusCount"),
                t::column(
                    m::field(Row.type, q::Count.type, "admin_status_count"),
                    "adminStatusCount"
                ),
                t::column(m::field(Row.type, String.type, "source_parentId"), "parentId"),
                t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
                t::column(m::field(Row.type, String.type, "source_deviceName"), "deviceName"),
                t::column(
                    m::field(Row.type, String.type, "source_classification"),
                    "classification"
                ),
                t::column(
                    m::field(Row.type, ReportedOnlinePercent.type, "source_onlineRate"),
                    "onlineRate"
                ),
                t::column(
                    m::field(Row.type, ReportedPortUsage.type, "source_ifUtilizationRate"),
                    "ifUtilizationRate"
                ),
                t::column(m::field(Row.type, Int.type, "source_cpuUsageEffcnt"), "cpuUsageEffcnt"),
                t::column(m::field(Row.type, Int.type, "source_memUsageEffcnt"), "memUsageEffcnt"),
                t::column(
                    m::field(Row.type, Int.type, "source_onlineRateEffcnt"),
                    "onlineRateEffcnt"
                ),
                t::column(
                    m::field(Row.type, Int.type, "source_ifUtilizationRateEffcnt"),
                    "ifUtilizationRateEffcnt"
                ),
                t::column(m::field(Row.type, Int.type, "source_portCountEffcnt"), "portCountEffcnt"),
                t::column(
                    m::field(Row.type, Int.type, "source_portUsedCountEffcnt"),
                    "portUsedCountEffcnt"
                ),
                t::column(
                    m::field(Row.type, Int.type, "source_operStatusCountEffcnt"),
                    "operStatusCountEffcnt"
                ),
                t::column(
                    m::field(Row.type, Int.type, "source_adminStatusCountEffcnt"),
                    "adminStatusCountEffcnt"
                ),
            ]
        ),
        m::field(Row.type, s::DateTimeUtc.type, "ts")
    ),
    [
        samples::bind(
            dataset,
            cpu_usage_statistics,
            m::field(Row.type, Percent.type, "cpu_usage"),
            [
                {statistic: samples::Statistic::Mean, publish: "cpu_usage"},
                {statistic: samples::Statistic::Latest, publish: "device_cpu_latest"},
                {statistic: samples::Statistic::Max, publish: "cpu_peak"},
                {statistic: samples::Statistic::Min, publish: "device_cpu_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            cpu_usage_statistics,
            m::field(Row.type, Percent.type, "mem_usage"),
            [
                {statistic: samples::Statistic::Mean, publish: "memory_usage"},
                {statistic: samples::Statistic::Latest, publish: "device_memory_latest"},
                {statistic: samples::Statistic::Max, publish: "memory_peak"},
                {statistic: samples::Statistic::Min, publish: "device_memory_sample_min"}
            ]
        ),
        samples::bind(
            dataset,
            port_count_statistics,
            m::field(Row.type, q::Count.type, "port_count"),
            [
                {statistic: samples::Statistic::Sum, publish: "port_count"},
                {statistic: samples::Statistic::Max, publish: "port_count_peak"},
                {statistic: samples::Statistic::Mean, publish: "port_count_sample_avg"}
            ]
        ),
        samples::bind(
            dataset,
            port_used_count_statistics,
            m::field(Row.type, q::Count.type, "port_used_count"),
            [
                {statistic: samples::Statistic::Sum, publish: "used_port_count"},
                {statistic: samples::Statistic::Mean, publish: "used_port_sample_avg"},
                {statistic: samples::Statistic::Max, publish: "used_port_sample_max"}
            ]
        ),
        samples::bind(
            dataset,
            oper_status_count_statistics,
            m::field(Row.type, q::Count.type, "oper_status_count"),
            [
                {statistic: samples::Statistic::Sum, publish: "running_port_count"},
                {statistic: samples::Statistic::Mean, publish: "running_port_sample_avg"}
            ]
        ),
        samples::bind(
            dataset,
            source_onlineRate_statistics,
            m::field(Row.type, ReportedOnlinePercent.type, "source_onlineRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "device_online_rate_avg"},
                {statistic: samples::Statistic::Min, publish: "device_online_rate_min"},
                {statistic: samples::Statistic::Max, publish: "device_online_rate_max"}
            ]
        ),
        samples::bind(
            dataset,
            source_ifUtilizationRate_statistics,
            m::field(Row.type, ReportedPortUsage.type, "source_ifUtilizationRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "device_port_usage_avg"},
                {statistic: samples::Statistic::Max, publish: "device_port_usage_max"},
                {statistic: samples::Statistic::Min, publish: "device_port_usage_min"}
            ]
        ),
    ]
);
def relations: Array(r::Relation) = [
    r::relation(
        "device_kpi_of_device",
        dataset,
        device,
        i::devices,
        i::device_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "source_EntNetworkElement_NetworkDeviceKPI",
        i::devices,
        i::device_subject,
        dataset,
        device,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
];
pub use self::{declaration, relations};
