        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "time encoding disagrees with field type");

@edsl::entity_source("bad_epoch_input", "bei")
type WrongEpochInput = struct {
    @edsl::column("created")
    @edsl::time_field(edsl::TimeSemantics::Local, edsl::TimeEncoding::LocalEpochMillis)
    @edsl::dimension("created", yes, yes, eq_only, text_only)
    created: Int,
};

pub def epoch_millis_rejects_text_dimension_input: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-epoch-input-v1", [WrongEpochInput.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "epoch-millisecond time dimension requires numeric filters");

pub def mismatched_wire_type_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("invalid-v1", [InvalidMapping.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "invalid canonical value mapping");

def lower_json: Fn(String) -> qb::Query = fn(source) {
    let value: Value = json::parse(source).unwrap!();
    intent::query_intent_lower_factory(payload, "public")(value)
};

pub def local_epoch_millis_is_discoverable: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "device", "create_time");
    if role.semantics == edsl::TimeSemantics::Local
        && role.encoding == edsl::TimeEncoding::LocalEpochMillis {
        True
    } else { fail!("creation time must disclose its local epoch-ms encoding", role) }
});

pub def local_epoch_millis_filters_use_supplied_bounds: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"list","measures":[],"dimensions":["device_name"],"filters":[{"dimension":"device_create_ms","op":"ge","kind":"int","value":1718467200000},{"dimension":"device_create_ms","op":"lt","kind":"int","value":1718467201000}],"ordering":[],"limit":null,"offset":null}`);
    if array::length(string::split(q.sql, "d.createTime >= ?")) == 2
        && array::length(string::split(q.sql, "d.createTime < ?")) == 2
        && q.bindings == [qb::Val::Int(1718467200000), qb::Val::Int(1718467201000)] {
        True
    } else { fail!("local epoch-ms filter must use externally resolved integer bounds", q) }
});

pub def local_epoch_millis_rejects_unresolved_text: test::Test = test::should_fail_with(fn() {
    lower_json(`{"op":"list","measures":[],"dimensions":["device_name"],"filters":[{"dimension":"device_create_ms","op":"ge","kind":"text","value":"2024-06-15 16:00:00"}],"ordering":[],"limit":null,"offset":null}`)
}, "invalid filter value for dimension");

pub def dataset_grain_and_time_are_discoverable: test::Test = test::should_ok(fn() {
    let device = edsl::dataset_domain(payload, "device");
    let frame = edsl::dataset_domain(payload, "frame");
    let alarm = edsl::dataset_domain(payload, "current_alarm");
    let kpi = edsl::dataset_domain(payload, "device_kpi");
    if device.kind == edsl::DatasetKind::Entity && device.grain == ["id", "tenant_id"]
        && device.utc_time == None
        && frame.kind == edsl::DatasetKind::Entity && frame.grain == ["id", "tenant_id"]
        && alarm.kind == edsl::DatasetKind::Event && alarm.grain == ["csn"]
        && alarm.utc_time == Some("occur_utc")
        && kpi.kind == edsl::DatasetKind::Metric
        && kpi.grain == ["res_id", "tenant_id", "ts"]
        && kpi.utc_time == Some("ts") {
        True
    } else {
        fail!("event and KPI dataset roles must be discoverable", alarm, kpi)
    }
});

pub def device_kpi_metric_contract_is_discoverable: test::Test = test::should_ok(fn() {
    let metrics = edsl::metric_domain(payload, "device_kpi");
    match (array::get(metrics, 0), array::get(metrics, 1), array::get(metrics, 2)) {
        (Some(cpu), Some(ports), Some(peak)) => if array::length(metrics) == 3
            && cpu.id == "cpu_usage" && cpu.field == "cpu_usage"
            && cpu.aggregate == qb::AggregateFunction::Avg && cpu.unit == Some("%")
            && cpu.role == edsl::MetricValueRole::DeclaredMetric
            && ports.id == "port_count" && ports.aggregate == qb::AggregateFunction::Sum
            && ports.role == edsl::MetricValueRole::DeclaredMetric
            && peak.id == "port_count_peak" && peak.field == "port_count"
            && peak.aggregate == qb::AggregateFunction::Max && peak.unit == ports.unit
            && peak.role == edsl::MetricValueRole::SampleSummary {
            True
        } else {
            fail!("device KPI metric metadata differs from iCloud", metrics)
        },
        _ => fail!("missing device KPI metric contract", metrics),
    }
});

pub def device_cpu_metric_uses_declared_aggregation: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"aggregate","measures":["cpu_usage"],"dimensions":["device_name"],"filters":[{"dimension":"device_name","op":"eq","kind":"text","value":"Device-A"}],"ordering":[],"limit":null,"offset":null}`);
    if array::length(string::split(q.sql, "avg(k.cpuUsage)")) > 1
        && array::length(string::split(q.sql, "GROUP BY d.name")) > 1
        && array::length(string::split(q.sql, "k.tenantId = d.tenant_id")) > 1
        && q.bindings == [qb::Val::String("Device-A")] {
        True
    } else {
        fail!("CPU aggregation must use KPI-owned Avg over the device key", q)
    }
});

pub def device_port_count_uses_declared_sum: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"aggregate","measures":["port_count"],"dimensions":["device_name"],"filters":[],"ordering":[],"limit":null,"offset":null}`);
    if array::length(string::split(q.sql, "sum(k.portCount)")) > 1 {
        True
    } else {
        fail!("port_count must use its declared Sum aggregation", q)
    }
});

pub def sample_peak_uses_original_physical_column: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_qualified","measures":["port_count","port_count_peak"],"dimensions":["device_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"device","relation":"device_kpi_of_device","window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[{"dimension":"port_count_sample","op":"gt","kind":"int","value":90}],"window":{"start":"2024-01-31T00:00:00Z","end":"2024-03-01T00:00:00Z"},"min_matches":3}]}`);
    if array::length(string::split(q.sql, "sum(k.portCount) AS port_count")) == 2
        && array::length(string::split(q.sql, "max(k.portCount) AS port_count_peak")) == 2 {
        True
    } else {
        fail!("sample peak must coexist with the original Sum over one physical column", q)
    }
});

def sample_top_intent: String = `{"op":"sample_top","measures":[],"dimensions":["device_name","port_count_sample","device_kpi_ts_raw"],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"device","relation":"device_kpi_of_device","rank":"port_count_sample","take":3,"window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"}}`;

pub def sample_top_partitions_by_hidden_owner_identity: test::Test = test::should_ok(fn() {
    let q = lower_json(sample_top_intent);
    if array::length(string::split(q.sql, "PARTITION BY d.id, d.tenant_id")) == 2
        && array::length(string::split(q.sql, "ORDER BY k.portCount DESC, k.resId ASC, k.tenantId ASC, k.ts ASC")) == 2
        && array::length(string::split(q.sql, "SELECT __q_0, __q_1, __q_2 FROM")) == 2
        && q.bindings == [qb::Val::String("2024-02-01T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z"), qb::Val::Int(3)] {
        True
    } else { fail!("sample top must rank within complete hidden owner and sample grains", q) }
});

pub def sample_top_rejects_wrong_owner_relation: test::Test = test::should_fail_with(fn() {
    lower_json(`{"op":"sample_top","measures":[],"dimensions":["device_name","port_count_sample"],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"device","relation":"device_current_alarm","rank":"port_count_sample","take":3,"window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"}}`)
}, "sample top requires a named grain-safe metric-to-owner relation");

pub def sample_top_adds_hidden_owner_join_when_only_samples_are_visible: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"sample_top","measures":[],"dimensions":["port_count_sample","device_kpi_ts_raw"],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"device","relation":"device_kpi_of_device","rank":"port_count_sample","take":3,"window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"}}`);
    if array::length(string::split(q.sql, "INNER JOIN I_EntNetworkElement AS d")) == 2
        && array::length(string::split(q.sql, "PARTITION BY d.id, d.tenant_id")) == 2
        && array::length(string::split(q.sql, "SELECT __q_0, __q_1 FROM")) == 2 {
        True
    } else { fail!("hidden owner identity must not require an owner projection", q) }
});

pub def sample_top_rejects_owner_attribute_as_rank: test::Test = test::should_fail_with(fn() {
    lower_json(`{"op":"sample_top","measures":[],"dimensions":["device_name","port_count_sample"],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"device","relation":"device_kpi_of_device","rank":"device_name","take":3,"window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"}}`)
}, "sample ranking requires a selected raw metric dimension");

def two_metric_qualifications: String = `{"op":"qualify_metrics","measures":[],"dimensions":["device_id"],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"cpu_usage","op":"ge","kind":"number","value":40}},{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-10T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"port_count","op":"ge","kind":"int","value":8}}]}`;

pub def independent_kpi_qualifications_keep_owner_grain: test::Test = test::should_ok(fn() {
    let q = lower_json(two_metric_qualifications);
    if array::length(string::split(q.sql, "EXISTS (")) != 3 { fail!("wrong EXISTS count", q.sql) }
    else if array::length(string::split(q.sql, "d.id = k_qualification.resId")) != 3 { fail!("missing resource key", q.sql) }
    else if array::length(string::split(q.sql, "d.tenant_id = k_qualification.tenantId")) != 3 { fail!("missing tenant key", q.sql) }
    else if array::length(string::split(q.sql, "avg(k_qualification.cpuUsage)")) != 2 { fail!("missing AVG", q.sql) }
    else if array::length(string::split(q.sql, "sum(k_qualification.portCount)")) != 2 { fail!("missing SUM", q.sql) }
    else if array::length(string::split(q.sql, "JOIN NetworkDeviceKPI")) != 1 { fail!("sample join amplified owner", q.sql) }
    else if q.bindings != [qb::Val::String("2024-02-01T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z"), qb::Val::Int(40), qb::Val::String("2024-02-10T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z"), qb::Val::Int(8)] { fail!("wrong qualification bindings", q.bindings) }
    else { True }
});

pub def qualified_device_count_counts_owners_not_sample_pairs: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"qualify_metrics","measures":["device_count"],"dimensions":[],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"cpu_usage","op":"ge","kind":"int","value":40}},{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-10T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"port_count","op":"ge","kind":"int","value":8}}]}`);
    if array::length(string::split(q.sql, "count(d.id)")) == 2
        && array::length(string::split(q.sql, "EXISTS (")) == 3
        && array::length(string::split(q.sql, "JOIN NetworkDeviceKPI")) == 1 {
        True
    } else { fail!("qualified count must count owner keys without joining samples", q) }
});

pub def qualification_rejects_unrelated_relation: test::Test = test::should_fail_with(fn() {
    lower_json(`{"op":"qualify_metrics","measures":[],"dimensions":["device_id"],"filters":[],"ordering":[],"limit":null,"offset":null,"qualifications":[{"relation":"device_current_alarm","dataset":"device_kpi","filters":[],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"having":{"measure":"cpu_usage","op":"ge","kind":"int","value":40}}]}`)
}, "metric qualification relation must map samples to owner");

pub def qualified_raw_samples_use_independent_observation_window: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_qualified","measures":[],"dimensions":["device_name","port_count_sample","device_kpi_ts_raw"],"filters":[],"ordering":[{"target":"Dimension","id":"device_kpi_ts_raw","direction":"Asc"}],"limit":1000,"offset":null,"owner":"device","relation":"device_kpi_of_device","window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[{"dimension":"port_count_sample","op":"gt","kind":"int","value":90}],"window":{"start":"2024-01-31T00:00:00Z","end":"2024-03-01T00:00:00Z"},"min_matches":3}]}`);
    if array::length(string::split(q.sql, "k.ts >= ?")) != 2 { fail!("outer time window missing", q.sql) }
    else if array::length(string::split(q.sql, "k_samples.ts >= ?")) != 2 { fail!("inner time window missing", q.sql) }
    else if array::length(string::split(q.sql, "k_samples.portCount > ?")) != 2 { fail!("raw sample filter missing", q.sql) }
    else if array::length(string::split(q.sql, "d.id = k_samples.resId")) != 2 { fail!("resource correlation missing", q.sql) }
    else if array::length(string::split(q.sql, "d.tenant_id = k_samples.tenantId")) != 2 { fail!("tenant correlation missing", q.sql) }
    else if array::length(string::split(q.sql, "GROUP BY k_samples.resId, k_samples.tenantId")) != 2 { fail!("composite sample group missing", q.sql) }
    else if array::length(string::split(q.sql, "count(k_samples.resId) >= ?")) != 2 { fail!("sample count threshold missing", q.sql) }
    else if q.bindings != [qb::Val::String("2024-02-01T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z"), qb::Val::String("2024-01-31T00:00:00Z"), qb::Val::String("2024-03-01T00:00:00Z"), qb::Val::Int(90), qb::Val::Int(3), qb::Val::Int(1000)] { fail!("independent sample window bindings wrong", q.bindings) }
    else { True }
});

pub def grouped_observation_keeps_hidden_composite_owner_identity: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_qualified","measures":["port_count"],"dimensions":["device_name"],"filters":[],"ordering":[],"limit":null,"offset":null,"owner":"device","relation":"device_kpi_of_device","window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"qualifications":[{"relation":"device_kpi_of_device","dataset":"device_kpi","filters":[{"dimension":"port_count_sample","op":"gt","kind":"int","value":0}],"window":{"start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"min_matches":1}]}`);
    if array::length(string::split(q.sql, "SELECT sum(k.portCount) AS port_count, d.name")) == 2
        && array::length(string::split(q.sql, "GROUP BY d.name, d.id, d.tenant_id")) == 2
        && array::length(string::split(q.sql, "d.id = k_samples.resId")) == 2
        && array::length(string::split(q.sql, "d.tenant_id = k_samples.tenantId")) == 2 {
        True
    } else { fail!("owner grain must be hidden in grouped observation without merging namesakes", q) }
});

pub def component_filter_keeps_kpi_sample_grain: test::Test = test::should_ok(fn() {
    let q = lower_json(`{"op":"observe_qualified","measures":[],"dimensions":["device_name","port_count_sample"],"filters":[],"ordering":[{"target":"Dimension","id":"port_count_sample","direction":"Desc"}],"limit":2,"offset":null,"owner":"device","relation":"device_kpi_of_device","window":{"dataset":"device_kpi","start":"2024-02-01T00:00:00Z","end":"2024-03-01T00:00:00Z"},"qualifications":[],"components":[{"relation":"frame_belongs_to_device","target":"frame","filters":[{"dimension":"frame_oper_state","op":"eq","kind":"text","value":"normal"}],"min_matches":null}]}`);
    if array::length(string::split(q.sql, "EXISTS (SELECT 1 FROM I_EnterpriseFrame AS f_component")) == 2
        && array::length(string::split(q.sql, "JOIN I_EnterpriseFrame")) == 1
        && array::length(string::split(q.sql, "d.id = f_component.refParentNE")) == 2
