    @v::map(domains::PosuPowerType.type, "posu_power_type", [v::member(domains::PosuPowerType::DcPowerSupply, ["0"]), v::member(domains::PosuPowerType::AcPowerSupply, ["1"]), v::member(domains::PosuPowerType::HighVoltageDcPowerSupply, ["2"]), v::member(domains::PosuPowerType::Value255, ["255"])])
