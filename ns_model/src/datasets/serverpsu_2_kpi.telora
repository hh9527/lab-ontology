use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::physical_server_psu;
use crate::datasets::kpi_server_psu;
@domain::subject("PhysicalServerPsu", "obj_sys_id")
@domain::dataset("serverpsu-2-kpi", "serverpsu2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type Serverpsu2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("serverpsu-2-kpi/obj_sys_id", ids::PhysicalServerPsuByObjSysId.type, True, [g::Filter::Eq]), "serverpsu_2_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: ids::PhysicalServerPsuByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("serverpsu-2-kpi/obj_id", domain::Reference(ids::KpiServerPsuByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "serverpsu_2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::KpiServerPsuByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("serverpsu_2__psp", domain::endpoint(Serverpsu2Kpi.type, "obj_sys_id"), domain::endpoint(physical_server_psu::PhysicalServerPsu.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("serverpsu_2__seps", domain::endpoint(Serverpsu2Kpi.type, "obj_id"), domain::endpoint(kpi_server_psu::KpiServerPsu.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
