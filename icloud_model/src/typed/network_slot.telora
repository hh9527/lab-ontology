use ontology::experimental::knowledge_policy as knowledge_policy;
# NetworkSlot独立声明，保留源可空性和已声明粒度
use super::inventory as i;
use super::frame as frame;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
type SlotId = struct(String);
type Identity = struct { id: SlotId };
def entity: m::Entity(Identity) = m::entity("slot_entity", Identity.type);
type Row = struct {
    id: SlotId,
    name: String,
    is_daughter_card: Bool,
    source_productName: String,
    source_frameNativeId: frame::FrameDn,
    source_manufacturer: String,
    source_hardVersion: String,
    source_softVersion: String,
    source_sn: String,
    source_tenantId: i::TenantId,
    source_refParentNE: i::DeviceId,
    source_operstatus: Int,
    source_adminstatus: Int,
    source_projectId: String,
};
def dataset: m::Dataset(Row) = m::dataset("network_slot", "I_EnterpriseSlot", Row.type, ["id"]);
def subject: m::Role(Row) = m::role(dataset, entity, "subject", False, [m::identity_part(m::field(Row.type, SlotId.type, "id"), m::field(Identity.type, SlotId.type, "id"))]);
def tenant: m::Role(Row) = m::role(dataset, i::tenant, "tenant", False, [m::identity_part(m::field(Row.type, i::TenantId.type, "source_tenantId"), m::field(i::TenantIdentity.type, i::TenantId.type, "id"))]);
def frame_reference: m::Role(Row) = m::role(dataset, frame::reference, "frame_reference", False, [m::identity_part(m::field(Row.type, frame::FrameDn.type, "source_frameNativeId"), m::field(frame::Reference.type, frame::FrameDn.type, "dn"))]);
@knowledge_policy::reverse_references(True)
type NetworkSlotOperstatus = struct(String);
def NetworkSlotOperstatus_domain: v::Domain(NetworkSlotOperstatus, Int) = v::domain("NetworkSlotOperstatus", NetworkSlotOperstatus.type, Int.type, [
    v::member(NetworkSlotOperstatus("wire_3_bab86ec8"), [3]),
    v::member(NetworkSlotOperstatus("wire_11_2c163c76"), [11]),
    v::member(NetworkSlotOperstatus("wire_13_c3b4db05"), [13]),
    v::member(NetworkSlotOperstatus("wire_15_bdb94c07"), [15]),
    v::member(NetworkSlotOperstatus("wire_16_a81f6949"), [16]),
    v::member(NetworkSlotOperstatus("wire_2_d0a68914"), [2]),
    v::member(NetworkSlotOperstatus("wire_5_c6f5830f"), [5]),
    v::member(NetworkSlotOperstatus("wire_12_5dc4ea39"), [12]),
    v::member(NetworkSlotOperstatus("wire_17_250739fa"), [17]),
    v::member(NetworkSlotOperstatus("wire_4_5978b238"), [4]),
    v::member(NetworkSlotOperstatus("wire_1_8d618873"), [1]),
    v::member(NetworkSlotOperstatus("wire__1_fe93bf05"), [-1]),
], False);
@knowledge_policy::reverse_references(True)
type NetworkSlotAdminstatus = struct(String);
def NetworkSlotAdminstatus_domain: v::Domain(NetworkSlotAdminstatus, Int) = v::domain("NetworkSlotAdminstatus", NetworkSlotAdminstatus.type, Int.type, [
    v::member(NetworkSlotAdminstatus("wire_4_5978b238"), [4]),
    v::member(NetworkSlotAdminstatus("wire_11_2c163c76"), [11]),
    v::member(NetworkSlotAdminstatus("wire_2_d0a68914"), [2]),
    v::member(NetworkSlotAdminstatus("wire_3_bab86ec8"), [3]),
    v::member(NetworkSlotAdminstatus("wire_12_5dc4ea39"), [12]),
    v::member(NetworkSlotAdminstatus("wire_13_c3b4db05"), [13]),
    v::member(NetworkSlotAdminstatus("wire_1_8d618873"), [1]),
    v::member(NetworkSlotAdminstatus("wire__1_fe93bf05"), [-1]),
], False);
def declaration: t::Declaration = t::with_domains(t::map_columns(t::declare(dataset, [subject, tenant, frame_reference], [
    i::exact(dataset, m::field(Row.type, SlotId.type, "id"), "slot_id"),
    i::search(dataset, m::field(Row.type, String.type, "name"), "slot_name"),
    g::dimension(dataset, g::dimension_group("slot_is_daughter_card", Bool.type, True, g::equality_filters), g::input(m::field(Row.type, Bool.type, "is_daughter_card")), "slot_is_daughter_card", True, g::equality_filters),
    i::search(dataset, m::field(Row.type, String.type, "source_productName"), "network_slot__productName"),
    i::exact(dataset, m::field(Row.type, frame::FrameDn.type, "source_frameNativeId"), "network_slot__frameNativeId"),
    i::search(dataset, m::field(Row.type, String.type, "source_manufacturer"), "network_slot__manufacturer"),
    i::search(dataset, m::field(Row.type, String.type, "source_hardVersion"), "network_slot__hardVersion"),
    i::search(dataset, m::field(Row.type, String.type, "source_softVersion"), "network_slot__softVersion"),
    i::search(dataset, m::field(Row.type, String.type, "source_sn"), "network_slot__sn"),
    i::exact(dataset, m::field(Row.type, i::TenantId.type, "source_tenantId"), "network_slot__tenantId"),
    i::exact(dataset, m::field(Row.type, i::DeviceId.type, "source_refParentNE"), "network_slot__refParentNE"),
    i::exact(dataset, m::field(Row.type, String.type, "source_projectId"), "network_slot__projectId"),
], ["slot_count"]), [
    t::column(m::field(Row.type, SlotId.type, "id"), "id"),
    t::column(m::field(Row.type, String.type, "name"), "name"),
    t::column(m::field(Row.type, Bool.type, "is_daughter_card"), "isDaughterCard"),
    t::column(m::field(Row.type, String.type, "source_productName"), "productName"),
    t::column(m::field(Row.type, frame::FrameDn.type, "source_frameNativeId"), "frameNativeId"),
    t::column(m::field(Row.type, String.type, "source_manufacturer"), "manufacturer"),
    t::column(m::field(Row.type, String.type, "source_hardVersion"), "hardVersion"),
    t::column(m::field(Row.type, String.type, "source_softVersion"), "softVersion"),
    t::column(m::field(Row.type, String.type, "source_sn"), "sn"),
    t::column(m::field(Row.type, i::TenantId.type, "source_tenantId"), "tenantId"),
    t::column(m::field(Row.type, i::DeviceId.type, "source_refParentNE"), "refParentNE"),
    t::column(m::field(Row.type, Int.type, "source_operstatus"), "operstatus"),
    t::column(m::field(Row.type, Int.type, "source_adminstatus"), "adminstatus"),
    t::column(m::field(Row.type, String.type, "source_projectId"), "projectId"),
 ]), [
    v::bind(dataset, v::dimension_group(NetworkSlotOperstatus_domain, True, g::equality_filters), g::input(m::field(Row.type, Int.type, "source_operstatus")), "network_slot__operstatus", True, g::equality_filters),
    v::bind(dataset, v::dimension_group(NetworkSlotAdminstatus_domain, True, g::equality_filters), g::input(m::field(Row.type, Int.type, "source_adminstatus")), "network_slot__adminstatus", True, g::equality_filters),
]);
def relations: Array(r::Relation) = [
    r::relation("source_EnterpriseFrame_EnterpriseSlot", frame::dataset, frame::frame_reference, dataset, frame_reference, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("source_EnterpriseSlot_X_TENANT_VIEW", dataset, tenant, i::tenants, i::tenant_subject, {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
pub use self::{declaration, relations};
