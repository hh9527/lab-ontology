# 独立 transform 声明；单位、grain 与关系只采用既有公开契约。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::samples as samples;
use ontology::experimental::values as v;
use ontology::experimental::relations as r;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::query as qb;
use super::storage as storage;
use super::fc_switch as fc;
type EffectiveCount = struct(Int);
type Row = struct {
    source_ts: s::DateTimeUtc,
    source_resId: String,
    source_cpuusage: p::Percent,
    source_memoryusage: p::Percent,
    source_cpuusageEffcnt: EffectiveCount,
    source_memoryusageEffcnt: EffectiveCount,
};
def dataset: m::Dataset(Row) = m::dataset("source_StorageDeviceKPI", "StorageDeviceKPI", Row.type, ["source_resId", "source_ts"]);
def storage_owner: m::Role(Row) = m::role(dataset, storage::entity, "storage_owner", False, [m::reference_part(m::field(Row.type, String.type, "source_resId"), m::field(storage::Identity.type, storage::StorageId.type, "id"))]);
def fc_owner: m::Role(Row) = m::role(dataset, fc::entity, "fc_owner", False, [m::reference_part(m::field(Row.type, String.type, "source_resId"), m::field(fc::Identity.type, fc::FcSwitchId.type, "id"))]);
def raw: t::Declaration = t::map_columns(t::declare(dataset, [storage_owner, fc_owner], [
    g::dimension(dataset, g::dimension_group("source_StorageDeviceKPI__ts", s::DateTimeUtc.type, True, g::numeric_filters), g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), "source_StorageDeviceKPI__ts", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Hour), "source_StorageDeviceKPI_utc_hour", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Day), "source_StorageDeviceKPI_utc_day", True, g::time_filters),
    g::dimension(dataset, g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters), g::utc_bucket(g::input(m::field(Row.type, s::DateTimeUtc.type, "source_ts")), qb::UtcBucketUnit::Month), "source_StorageDeviceKPI_utc_month", True, g::time_filters),
    i::exact(dataset, m::field(Row.type, String.type, "source_resId"), "source_StorageDeviceKPI__resId"),
    g::dimension(dataset, g::dimension_group("source_StorageDeviceKPI__cpuusage", p::Percent.type, True, g::numeric_filters), g::input(m::field(Row.type, p::Percent.type, "source_cpuusage")), "source_StorageDeviceKPI__cpuusage", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_StorageDeviceKPI__memoryusage", p::Percent.type, True, g::numeric_filters), g::input(m::field(Row.type, p::Percent.type, "source_memoryusage")), "source_StorageDeviceKPI__memoryusage", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_StorageDeviceKPI__cpuusageEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_cpuusageEffcnt")), "source_StorageDeviceKPI__cpuusageEffcnt", True, g::numeric_filters),
    g::dimension(dataset, g::dimension_group("source_StorageDeviceKPI__memoryusageEffcnt", EffectiveCount.type, True, g::numeric_filters), g::input(m::field(Row.type, EffectiveCount.type, "source_memoryusageEffcnt")), "source_StorageDeviceKPI__memoryusageEffcnt", True, g::numeric_filters),
], []), [
    t::column(m::field(Row.type, s::DateTimeUtc.type, "source_ts"), "ts"),
    t::column(m::field(Row.type, String.type, "source_resId"), "resId"),
    t::column(m::field(Row.type, p::Percent.type, "source_cpuusage"), "cpuusage"),
    t::column(m::field(Row.type, p::Percent.type, "source_memoryusage"), "memoryusage"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_cpuusageEffcnt"), "cpuusageEffcnt"),
    t::column(m::field(Row.type, EffectiveCount.type, "source_memoryusageEffcnt"), "memoryusageEffcnt"),
]);
def declaration: t::Declaration = t::with_samples(t::metric(raw, m::field(Row.type, s::DateTimeUtc.type, "source_ts")), [
    samples::bind(dataset, p::Percent_statistics, m::field(Row.type, p::Percent.type, "source_cpuusage"), [{statistic: samples::Statistic::Mean, publish: "storage_cpu_usage"}, {statistic: samples::Statistic::Max, publish: "storage_cpu_sample_max"}, {statistic: samples::Statistic::Min, publish: "storage_cpu_sample_min"}]),
    samples::bind(dataset, p::Percent_statistics, m::field(Row.type, p::Percent.type, "source_memoryusage"), [{statistic: samples::Statistic::Mean, publish: "storage_memory_usage"}, {statistic: samples::Statistic::Max, publish: "storage_memory_usage_max"}, {statistic: samples::Statistic::Min, publish: "storage_memory_usage_min"}]),
]);
def relations: Array(r::Relation) = [
    r::relation("source_HuaweiStorageDeviceAssociationStorageDeviceKPI", storage::dataset, storage::subject, dataset, storage_owner, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
    r::relation("source_FCSwitchDevice_StorageDeviceKPI", fc::dataset, fc::subject, dataset, fc_owner, {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
pub use self::{declaration, relations};
