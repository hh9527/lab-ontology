pub def link_device_rows_reject_incomplete_endpoint_grain: test::Test = test::should_fail_with(fn() {
    let relations = array::map(payload.relations, fn(relation) {
        if relation.id == "physical_link_a_device" {
            let key = match relation.key {
                edsl::RelationKey::And(keys) => match array::get(keys, 0) {
                    Some(first) => first,
                    None => fail!("missing A endpoint key"),
                },
                _ => fail!("expected compound A endpoint relation"),
            };
            {...relation, key}
        } else { relation }
    });
    let broken = {...payload, relations};
    let scope: edsl::LinkSiteScope = {
        a_relation: "physical_link_a_device", z_relation: "physical_link_z_device",
        link_tenant_relation: "physical_link_belongs_to_tenant",
        device_tenant_relation: "device_belongs_to_tenant",
        site_relation: "device_located_at_site", tenant_relation: "site_belongs_to_tenant",
        device_filters: [], site_filters: [], tenant_filters: [],
    };
    edsl::lower_link_device_site_rows(broken,
        {measures: [], dimensions: [
            {id: "device_name", subject: "public", input: edsl::DimensionInput::None},
            {id: "physical_link_name", subject: "public", input: edsl::DimensionInput::None}],
         filters: [], ordering: [], limit: None, offset: None, partition: None}, scope)
}, "link-device rows require complete endpoint grain and aligned tenant identity keys");

