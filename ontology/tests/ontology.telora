# Public type and module contract checks for the EnterpriseKnowledge eDSL.
# Evaluated by `check @test/ontology`; any broken contract fails loudly.

import "query/lib" as qb;
import "std/array" as array;
import "std/string" as string;
import "@src/edsl" as edsl;
import "@src/knowledge" as knowledge;

def check: Fn(Bool, String) -> Bool = fn(cond, label) {
    if cond { 'True } else { fail!("ontology contract check failed", label) }
};

def option_unwrap: for(A) Fn(Option(A)) -> A = fn(value) {
    match value { 'Some(v) => v, 'None => fail!("expected a value") }
};

def get_index: for(A) Fn(Array(A), Int) -> A = fn(values, i) {
    match array.get(values, i) {
        'Some(v) => v,
        'None => fail!("index out of range", i),
    }
};

def is_head_expr: Fn(qb.Expr) -> Bool = fn(e) {
    match e {
        'Scalar(call) => call.function == 'If && array.length(call.args) == 3,
        _ => 'False,
    }
};

def is_eq_bind: Fn(qb.Expr, String, qb.Val) -> Bool = fn(e, column, value) {
    match e {
        'Scalar(call) => call.function == 'Eq
            && array.length(call.args) == 2
            && (match array.get(call.args, 0) |> option_unwrap {
                'Column(ref) => ref.source == "t" && ref.column == column,
                _ => 'False,
            })
            && (match array.get(call.args, 1) |> option_unwrap { 'Bind(v) => v == value, _ => 'False }),
        _ => 'False,
    }
};

def main_request: Fn() -> edsl.QueryRequest = fn() {
    let request: edsl.QueryRequest = {
        measures: [
            { id: "OrderAmount", subject: "analyst", input: 'All },
        ],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [
            { target: 'Measure("OrderAmount"), direction: 'Desc },
            { target: 'Dimension("OrderRegion"), direction: 'Asc },
        ],
        limit: 'Some(3),
        offset: 'None,
        partition: 'None,
    };
    request
};

# Plan / PlanProfile / Query are owned by query: the eDSL does not
# define alternatives and the knowledge profile is a qb.PlanProfile.
def plan_ownership_ok: Bool = do {
    let plan: qb.Plan = edsl.lower(knowledge.payload, main_request());
    let validated: qb.Plan = qb.validate(plan, knowledge.profile);
    check(array.length(validated.sources) >= 1, "plan is a query Plan and validates")
};

# The request vocabulary is closed and typed: ordering targets distinguish
# Measure and Dimension variants; ids are the declared business vocabulary.
def request_vocabulary_ok: Bool = do {
    let target: edsl.OrderTarget = 'Measure("OrderAmount");
    let target2: edsl.OrderTarget = 'Dimension("OrderRegion");
    let ok1 = match target { 'Measure(id) => id == "OrderAmount", 'Dimension(_) => 'False };
    let ok2 = match target2 { 'Dimension(id) => id == "OrderRegion", 'Measure(_) => 'False };
    check(ok1 && ok2, "ordering targets distinguish closed Measure/Dimension variants")
};

# Business vocabulary ids in the prepared payload are valid SQL output
# identifiers (aliases are derived from them at prepare time).
def vocabulary_identifiers_ok: Bool = do {
    let p = knowledge.payload;
    let measure_ok = array.all(p.measures, fn(m) { qb.is_sql_identifier(m.alias) });
    let dim_ok = array.all(p.dimensions, fn(d) { qb.is_sql_identifier(d.id) });
    check(measure_ok, "measure aliases are valid SQL identifiers")
        && check(dim_ok, "dimension ids are valid SQL identifiers")
};

# Prepared behavior is cross-module: the payload published by the knowledge
# module is consumed here with its closures intact.
def prepared_cross_module_ok: Bool = do {
    let p = knowledge.payload;
    let auth_ok = p.authorize("analyst") && !p.authorize("nobody");
    let week = match array.find(p.dimensions, fn(d) { d.id == "OrderWeek" }) {
        'Some(d) => d,
        'None => fail!("OrderWeek missing from prepared dimensions"),
    };
    let expr = edsl.dimension_expr(p, week);
    let computed_ok = match expr {
        'Scalar(call) => call.function == 'Substr,
        _ => 'False,
    };
    check(auth_ok, "published authorization closure works cross-module")
        && check(computed_ok, "published computed-dimension closure works cross-module")
};

# The knowledge declares a closed set of entities explicitly on the root; the
# payload contains exactly those entities and their facts, including the
# vocabulary-vs-authorization separation and measure required entities.
def root_explicit_entities_ok: Bool = do {
    let p = knowledge.payload;
    let contact = array.find(p.dimensions, fn(d) { d.id == "CustomerContact" });
    let contact_known = match contact {
        'Some(d) => !d.authorized && !d.filterable,
        'None => 'False,
    };
    let item_amount = array.find(p.measures, fn(m) { m.id == "ItemAmount" });
    let item_requires_order = match item_amount {
        'Some(m) => m.requires == [0],
        'None => 'False,
    };
    check(array.length(p.entities) == 9, "root explicitly lists nine entity types")
        && check(array.length(p.measures) == 19, "nineteen measures collected from properties")
        && check(array.length(p.dimensions) == 18, "eighteen dimensions collected from properties")
        && check(array.length(p.relations) == 5, "five relations collected from properties")
        && check(contact_known, "known-but-unauthorized dimension stays in the closed vocabulary")
        && check(item_requires_order, "measure required entities resolved to entity indexes")
};

# A lower request produces a Plan whose Query is deterministic and
# parameterized (bindings non-empty when filters/limit present).
def parameterized_query_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [{ id: "OrderRegion", subject: "analyst", op: 'Eq, input: 'Text("west") }],
        ordering: [],
        limit: 'Some(2),
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let query: qb.Query = qb.transform_sqlite(plan);
    check(array.length(query.bindings) == 2, "filter value and limit are parameterized bindings")
        && check(!qb.is_sql_identifier("1abc"), "identifier lexical rule still applies")
};

# Closed enum value domains: the CustomerTier dimension publishes a closed
# catalog (stable values and labels) discoverable from the payload, while open
# String dimensions keep an empty domain.
def enum_domain_ok: Bool = do {
    let p = knowledge.payload;
    let tier = match array.find(p.dimensions, fn(d) { d.id == "CustomerTier" }) {
        'Some(d) => d,
        'None => fail!("CustomerTier dimension missing"),
    };
    let values = tier.values;
    let domain_ok = array.length(values) == 3
        && array.any(values, fn(v) { v.variant == "Gold" && v.value == "gold" && v.label == "Gold customer" })
        && array.any(values, fn(v) { v.variant == "Silver" && v.value == "silver" && v.label == "Silver customer" })
        && array.any(values, fn(v) { v.variant == "Bronze" && v.value == "bronze" && v.label == "Bronze customer" });
    let region = match array.find(p.dimensions, fn(d) { d.id == "OrderRegion" }) {
        'Some(d) => d,
        'None => fail!("OrderRegion dimension missing"),
    };
    check(domain_ok, "CustomerTier dimension publishes its closed enum value domain")
        && check(array.length(region.values) == 0, "open String dimension has an empty value domain")
};

# A legal enum stable value produces a parameterized binding; the closed
# domain does not change projection/grouping of the underlying column.
def enum_filter_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "CustomerTier", subject: "analyst", input: 'None }],
        filters: [{ id: "CustomerTier", subject: "analyst", op: 'Eq, input: 'Text("gold") }],
        ordering: [{ target: 'Dimension("CustomerTier"), direction: 'Asc }],
        limit: 'Some(3),
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let filter_ok = match plan.filter {
        'Some('Scalar(call)) => call.function == 'Eq
            && array.length(call.args) == 2
            && (match call.args[0] { 'Column(ref) => ref.source == "c" && ref.column == "tier", _ => 'False })
            && (match call.args[1] { 'Bind('String("gold")) => 'True, _ => 'False }),
        _ => 'False,
    };
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("gold"), 'Int(3)];
    check(filter_ok, "legal enum value lowers to Eq on the tier column with a bind")
        && check(query.bindings == expected, "enum filter binding is the stable value followed by the limit")
};

# Public discovery helper: dimension_domain exposes the closed catalog for an
# enum dimension and the empty domain for an open dimension.
def dimension_domain_helper_ok: Bool = do {
    let values = edsl.dimension_domain(knowledge.payload, "CustomerTier");
    let region_values = edsl.dimension_domain(knowledge.payload, "OrderRegion");
    check(array.length(values) == 3, "dimension_domain exposes the enum closed catalog")
        && check(array.length(region_values) == 0, "dimension_domain exposes the open domain as empty")
};

# Pagination lowers to the standard Plan.offset: a request with stable ordering
# and a non-negative offset keeps limit, sets offset, and appends the offset as
# the last ordered binding. Finite results are business semantics, not proof of
# full coverage.
def pagination_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [{ target: 'Measure("OrderAmount"), direction: 'Desc }],
        limit: 'Some(5),
        offset: 'Some(20),
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let query: qb.Query = qb.transform_sqlite(plan);
    let offset_ok = plan.offset == 'Some(20);
    let last_ok = match array.get(query.bindings, array.length(query.bindings) - 1) {
        'Some(v) => v == 'Int(20),
        'None => 'False,
    };
    check(offset_ok, "pagination: offset lowers to Plan.offset")
        && check(last_ok, "pagination: offset is the last ordered binding")
};

# Computed dimensions can safely use the closed query scalars ('If/'Instr) and
# participate in projection and grouping with arity-validated expressions.
def computed_dimension_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "TraceCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "TraceHead", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let proj_ok = array.any(plan.projection, fn(item) {
        match item { 'Expr(e) => is_head_expr(e), 'Aggregate(_) => 'False, 'Computed(_) => 'False }
    });
    let group_ok = array.length(plan.grouping) == 1 && is_head_expr(array.get(plan.grouping, 0) |> option_unwrap);
    check(proj_ok, "computed dimension: new-scalar expression in projection")
        && check(group_ok, "computed dimension: same expression in grouping")
};

# Generic domain scope: a dimension member declares its inherent row range as
# typed predicates; the prepared payload publishes them, and selecting the
# member merges the scope before user filters, both parameterized.
def scope_ok: Bool = do {
    let p = knowledge.payload;
    let head = match array.find(p.dimensions, fn(d) { d.id == "TraceHead" }) {
        'Some(d) => d,
        'None => fail!("TraceHead dimension missing"),
    };
    let declared_ok = array.length(head.scope) == 1
        && get_index(head.scope, 0).field == 1
        && get_index(head.scope, 0).op == 'Eq
        && get_index(head.scope, 0).input == 'Text("run");
    let request: edsl.QueryRequest = {
        measures: [{ id: "TraceCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "TraceHead", subject: "analyst", input: 'None }],
        filters: [{ id: "TraceOwner", subject: "analyst", op: 'Eq, input: 'Text("alice") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let merged_ok = match plan.filter {
        'Some('Scalar(call)) => call.function == 'And
            && array.length(call.args) == 2
            && is_eq_bind(array.get(call.args, 0) |> option_unwrap, "kind", 'String("run"))
            && is_eq_bind(array.get(call.args, 1) |> option_unwrap, "owner", 'String("alice")),
        _ => 'False,
    };
    check(declared_ok, "scope: inherent scope predicate published on the member")
        && check(merged_ok, "scope: scope merges before the user filter, both parameterized")
};

# Top Per Group lowers to the standard Plan.partition: per-partition top N with
# a stable ordering; global limit/offset/ordering are not combined.
def top_per_group_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
            { id: "OrderWeek", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [
            { target: 'Measure("OrderAmount"), direction: 'Desc },
            { target: 'Dimension("OrderWeek"), direction: 'Asc },
        ],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["OrderRegion"], take: 2 }),
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let part_ok = match plan.partition {
        'Some(p) => p.take == 2
            && array.length(p.partition_by) == 1
            && array.length(p.order_by) == 2,
        'None => 'False,
    };
    let no_global = array.length(plan.ordering) == 0 && plan.limit == 'None && plan.offset == 'None;
    check(part_ok, "top per group: partition lowers to Plan.partition")
        && check(no_global, "top per group: no global limit/offset/ordering combined")
};

# Filtered and computed measures are part of the prepared knowledge and lower
# through the public Plan: filtered aggregates carry their inherent predicate,
# computed measures combine declared dependencies.
def filtered_computed_measures_ok: Bool = do {
    let p = knowledge.payload;
    let run = match array.find(p.measures, fn(m) { m.id == "TraceRunCount" }) {
        'Some(m) => m.predicate,
        'None => fail!("TraceRunCount missing"),
    };
    let delta = match array.find(p.measures, fn(m) { m.id == "TraceDelta" }) {
        'Some(m) => m.computed,
        'None => fail!("TraceDelta missing"),
    };
    let pred_ok = match run {
        'Some(pred) => pred.field == 1 && pred.op == 'Eq && pred.input == 'Text("run"),
        'None => 'False,
    };
    let total = match array.find(p.measures, fn(m) { m.id == "TraceTotal" }) {
        'Some(m) => m.computed,
        'None => fail!("TraceTotal missing"),
    };
    let computed_ok = match delta {
        'Some(spec) => spec.op == 'Sub && spec.left == "TraceRunCount" && spec.right == "TraceSkipCount",
        'None => 'False,
    };
    let total_ok = match total {
        'Some(spec) => spec.op == 'Add && spec.left == "TraceRunCount" && spec.right == "TraceSkipCount",
        'None => 'False,
    };
    let request: edsl.QueryRequest = {
        measures: [{ id: "TraceDelta", subject: "analyst", input: 'All }],
        dimensions: [{ id: "TraceOwner", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let deps_projected = array.any(plan.projection, fn(item) {
        match item { 'Aggregate(agg) => agg.alias == "TraceRunCount" || agg.alias == "TraceSkipCount", _ => 'False }
    });
    let computed_projected = array.any(plan.projection, fn(item) {
        match item { 'Computed(c) => c.alias == "TraceDelta" && c.op == 'Sub, _ => 'False }
    });
    check(pred_ok, "filtered measure: inherent predicate published on the measure entry")
        && check(computed_ok && total_ok, "computed measure: 'Sub and 'Add dependency specs published")
        && check(deps_projected && computed_projected, "computed measure: dependencies and computed item are projected")
};

# The non-Timeline Approval example declares mutually exclusive conditional
# counts plus Add/Sub composition through the same public path.
def approval_measures_ok: Bool = do {
    let p = knowledge.payload;
    let net = match array.find(p.measures, fn(m) { m.id == "ApprovalNet" }) {
        'Some(m) => m.computed,
        'None => fail!("ApprovalNet missing"),
    };
    let spec_ok = match net {
        'Some(spec) => spec.op == 'Sub && spec.left == "ApprovalApprovedCount" && spec.right == "ApprovalRejectedCount",
        'None => 'False,
    };
    let request: edsl.QueryRequest = {
        measures: [{ id: "ApprovalTotal", subject: "analyst", input: 'All }],
        dimensions: [{ id: "ApprovalStatus", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let total_ok = array.any(plan.projection, fn(item) {
        match item { 'Computed(c) => c.alias == "ApprovalTotal" && c.op == 'Add, _ => 'False }
    });
    check(spec_ok, "approval: non-Timeline computed net spec published")
        && check(total_ok, "approval: non-Timeline Add composition lowers")
};

# JSON-backed dimensions: the declared path lowers to a String binding through
# query's public JsonExtract and participates in projection/grouping.
def json_dimension_ok: Bool = do {
    let p = knowledge.payload;
    let channel = match array.find(p.dimensions, fn(d) { d.id == "DeviceChannel" }) {
        'Some(d) => d,
        'None => fail!("DeviceChannel missing"),
    };
    let retry = match array.find(p.dimensions, fn(d) { d.id == "DeviceRetryCount" }) {
        'Some(d) => d,
        'None => fail!("DeviceRetryCount missing"),
    };
    let prepared_ok = channel.computed && retry.computed;
    let request: edsl.QueryRequest = {
        measures: [{ id: "DeviceCount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "DeviceChannel", subject: "analyst", input: 'None },
            { id: "DeviceRetryCount", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let proj_ok = array.length(plan.projection) == 3
        && array.any(plan.projection, fn(item) {
            match item {
                'Expr('Scalar(call)) => call.function == 'JsonExtract && array.length(call.args) == 2,
                _ => 'False,
            }
        });
    let group_ok = array.length(plan.grouping) == 2;
    check(prepared_ok, "json dimension: declared as a computed dimension in the payload")
        && check(proj_ok, "json dimension: JsonExtract items in projection")
        && check(group_ok, "json dimension: paths in grouping")
};

# ---------------------------------------------------------------------------
# Next-round contracts: measureless row lists, existence filters, HAVING and
# structured (composite) relation keys.
# ---------------------------------------------------------------------------

# Measureless row-level list: no fictional COUNT measure is introduced; the
# projection stays expression-only and the plan is ungrouped.
def next_row_list_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [],
        dimensions: [
            { id: "OrderRegion", subject: "analyst", input: 'None },
            { id: "CustomerTier", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [{ target: 'Dimension("OrderRegion"), direction: 'Asc }],
        limit: 'Some(10),
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let expr_only = array.all(plan.projection, fn(item) {
        match item { 'Expr(_) => 'True, 'Aggregate(_) => 'False, 'Computed(_) => 'False }
    });
    let query: qb.Query = qb.transform_sqlite(plan);
    check(array.length(plan.grouping) == 0, "row list: measureless request stays ungrouped")
        && check(expr_only, "row list: no fictional aggregate is projected")
        && check(array.length(query.bindings) == 1, "row list: only the limit is bound")
};

# Grain-preserving existence filter: a fan-out-only required entity is satisfied
# by a correlated EXISTS predicate, not a fan-out join.
def next_exists_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "CustomerCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let exists: edsl.ExistsRequest = { target: "orders", subject: "analyst", filters: [], any_of: [], min_matches: 'None };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [exists], []);
    check(array.length(plan.exists) == 1, "exists: typed existence filter lowers")
        && check(array.length(plan.joins) == 0, "exists: required fan-out entity is not joined")
        && check(array.length(plan.grouping) == 0, "exists: subject count stays at customer grain")
};

# Typed HAVING over a requested measure.
def next_having_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let having: edsl.HavingRequest = {
        measure: "OrderAmount",
        subject: "analyst",
        op: 'Gt,
        threshold: 'Number(50.0),
    };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [], [having]);
    check(array.length(plan.having) == 1, "having: aggregate predicate request lowers")
};

# Text search operations are part of the closed vocabulary.
def next_text_ops_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [{ id: "OrderRegion", subject: "analyst", op: 'StartsWith, input: 'Text("ea") }],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(knowledge.payload, request);
    let filter_ok = match plan.filter {
        'Some(_) => 'True,
        'None => 'False,
    };
    check(filter_ok, "text ops: starts-with filter lowers through the closed vocabulary")
};

# ---------------------------------------------------------------------------
# Structured relation keys (local, domain-neutral fixture): a composite
# conjunction key lowers to an AND of equality ON conditions.
# ---------------------------------------------------------------------------

def count_agg_local: qb.AggregateFunction = 'Count;
def no_requires: Array(Type) = [];
def flag_yes: Bool = 'True;
def safe_rel: edsl.RelationKind = 'Safe;
def eq_ops_local: Array(edsl.FilterOp) = ['Eq];
def text_kinds_local: Array(edsl.FilterInputKind) = ['Text];
def authorizer: Fn(String) -> Bool = fn(subject) { subject == "analyst" };

def flow_profile: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Join, 'Group, 'Order, 'Limit,
    ],
    allowed_join_kinds: ['Inner],
    allowed_aggregates: ['Count],
    allowed_scalars: [],
    allow_distinct: 'False,
};

def flow_ep_key: edsl.RelationKey = 'And([
    'Eq({from: 1, to: 1}),
    'Eq({from: 0, to: 0}),
]);

@edsl.entity_id("ep")
@edsl.entity_source("endpoints", "e")
type EpEnd = struct {
    @edsl.column("class")
    @edsl.dimension("EpClass", flag_yes, flag_yes, eq_ops_local, text_kinds_local)
    class: String,
    @edsl.column("id")
    @edsl.key(flag_yes)
    id: Int,
    @edsl.column("name")
    @edsl.dimension("EpName", flag_yes, flag_yes, eq_ops_local, text_kinds_local)
    name: String,
};

@edsl.entity_id("flow")
@edsl.entity_source("flows", "f")
@edsl.relation_key(EpEnd, safe_rel, flow_ep_key)
type FlowRow = struct {
    @edsl.column("ep_class")
    ep_class: String,
    @edsl.column("ep_id")
    ep_id: Int,
    @edsl.column("id")
    @edsl.key(flag_yes)
    @edsl.measure("FlowCount", count_agg_local, no_requires)
    id: Int,
};

def flow_payload: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [EpEnd, FlowRow];
    let result: edsl.PreparedPayload = edsl.build_root("flow-v1", entity_types, flow_profile, authorizer);
    result
};

def next_composite_key_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "FlowCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "EpName", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plan: qb.Plan = edsl.lower(flow_payload, request);
    let join_ok = array.length(plan.joins) == 1 && (match array.get(plan.joins, 0) {
        'Some(j) => match j.condition {
            'And(parts) => array.length(parts) == 2,
            _ => 'False,
        },
        'None => 'False,
    });
    check(join_ok, "composite relation key: conjunction key lowers to an AND ON condition")
};

# ---------------------------------------------------------------------------
# Next-round (nested aggregate) contracts: correlated existence thresholds,
# count-of-groups, mechanical parent/child grain and reverse existence.
# ---------------------------------------------------------------------------

# Parent count never joins the fan-out child edge; a correlated existence keeps
# the count at the parent grain (no amplification by child rows).
def next_parent_grain_ok: Bool = do {
    let base: edsl.QueryRequest = {
        measures: [{ id: "ParentCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let plain: qb.Plan = edsl.lower(knowledge.payload, base);
    let exists: edsl.ExistsRequest = { target: "children", subject: "analyst", filters: [], any_of: [], min_matches: 'Some(1) };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, base, [exists], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    let threshold_b: Array(qb.Val) = ['Int(1)];
    check(array.length(plain.joins) == 0 && array.length(plan.joins) == 0,
        "parent grain: ParentCount never joins the fan-out child edge")
        && check(array.length(plan.exists) == 1 && array.length(plan.grouping) == 0,
            "parent grain: correlated existence keeps an ungrouped parent count")
        && check(string.contains(query.sql, "EXISTS (SELECT 1 FROM children AS k WHERE p.id = k.parent_id")
            && !string.contains(query.sql, "INNER JOIN children"),
            "parent grain: related child existence does not amplify the parent count")
        && check(query.bindings == threshold_b, "parent grain: minimum match threshold is parameterized")
};

# Group count over an aggregated/grouped request (nested shape 1).
def next_group_count_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let having: edsl.HavingRequest = {
        measure: "OrderAmount",
        subject: "analyst",
        op: 'Ge,
        threshold: 'Number(100.0),
    };
    let query: qb.Query = edsl.lower_group_count(knowledge.payload, request, [having]);
    let expected: Array(qb.Val) = ['Float(100.0)];
    check(string.contains(query.sql, "count(1) FROM (SELECT sum(o.amount) AS OrderAmount, o.region"),
        "group count: count of groups satisfying HAVING lowers to count(1) over the inner query")
        && check(query.bindings == expected, "group count: the HAVING threshold is the only binding")
};

# Local reverse-existence fixture: only Claim -> Owner is declared; deriving
# "owners with claims" must not require duplicating the reverse edge.
@edsl.entity_id("owner")
@edsl.entity_source("owners", "o")
type Owner = struct {
    @edsl.column("id")
    @edsl.key(flag_yes)
    @edsl.measure("OwnerCount", count_agg_local, no_requires)
    id: Int,
};

@edsl.entity_id("claim")
@edsl.entity_source("claims", "m")
@edsl.relation(Owner, safe_rel, 1, 0)
type Claim = struct {
    @edsl.column("id")
    @edsl.key(flag_yes)
    @edsl.measure("ClaimCount", count_agg_local, no_requires)
    id: Int,
    @edsl.column("owner_id")
    owner_id: Int,
    @edsl.column("status")
    @edsl.dimension("ClaimStatus", flag_yes, flag_yes, eq_ops_local, text_kinds_local)
    status: String,
};

def owner_profile: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Exists, 'Join, 'Group, 'Having, 'Order, 'Limit,
    ],
    allowed_join_kinds: ['Inner],
    allowed_aggregates: ['Count],
    allowed_scalars: ['Eq],
    allow_distinct: 'False,
};

def owner_payload: edsl.PreparedPayload = do {
    let entity_types: Array(Type) = [Owner, Claim];
    let result: edsl.PreparedPayload = edsl.build_root("owner-v1", entity_types, owner_profile, authorizer);
    result
};

def next_reverse_exists_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OwnerCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let exists: edsl.ExistsRequest = { target: "claim", subject: "analyst", filters: [], any_of: [], min_matches: 'None };
    let plan: qb.Plan = edsl.lower_full(owner_payload, request, [exists], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    check(array.length(plan.exists) == 1 && array.length(plan.joins) == 0,
        "reverse existence: a single related-entity edge derives the existence")
        && check(string.contains(query.sql, "EXISTS (SELECT 1 FROM claims AS m WHERE o.id = m.owner_id)"),
            "reverse existence: outer key equals the inner foreign key without duplicating edges")
};

def next_reverse_grouped_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OwnerCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let exists: edsl.ExistsRequest = { target: "claim", subject: "analyst", filters: [], any_of: [], min_matches: 'Some(2) };
    let plan: qb.Plan = edsl.lower_full(owner_payload, request, [exists], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['Int(2)];
    check(array.length(plan.exists) == 1 && query.bindings == expected,
        "reverse grouped existence: minimum matches lower to a correlated aggregate predicate")
        && check(string.contains(query.sql, "GROUP BY m.owner_id HAVING count(m.id) >= ?"),
            "reverse grouped existence: inner GROUP BY/HAVING keeps the owner grain")
};

# Closed OR-group on the subject filter: one inner Or over equalities, member
# values in request order.
def next_any_ordinary_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let any: edsl.AnyOfRequest = { id: "OrderRegion", subject: "analyst", values: ['Text("east"), 'Text("west")] };
    let plan: qb.Plan = edsl.lower_any(knowledge.payload, request, [any], [], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("east"), 'String("west")];
    check(string.contains(query.sql, "(o.region = ? OR o.region = ?)"),
        "any-of: a single dimension OR-group lowers to one inner Or")
        && check(!string.contains(query.sql, "o.region = ? AND o.region = ?"),
            "any-of: an OR-group is never flattened into an AND")
        && check(query.bindings == expected, "any-of: member values enter bindings in request order")
};

# Closed enum members form one Or over the tier column.
def next_any_enum_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "OrderRegion", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let any: edsl.AnyOfRequest = { id: "CustomerTier", subject: "analyst", values: ['Text("gold"), 'Text("silver")] };
    let plan: qb.Plan = edsl.lower_any(knowledge.payload, request, [any], [], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("gold"), 'String("silver")];
    check(string.contains(query.sql, "(c.tier = ? OR c.tier = ?)"),
        "any-of: closed enum stable values form one Or over the tier column")
        && check(query.bindings == expected, "any-of: enum stable values keep request order and bind")
};

# OR-group inside an existence filter keeps a single correlated EXISTS (with
# min_matches) and never joins the fan-out target into the subject query.
def next_exists_any_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "ParentCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let any: edsl.AnyOfRequest = { id: "ChildName", subject: "analyst", values: ['Text("a"), 'Text("b")] };
    let exists: edsl.ExistsRequest = { target: "children", subject: "analyst", filters: [], any_of: [any], min_matches: 'Some(2) };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [exists], []);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("a"), 'String("b"), 'Int(2)];
    check(array.length(plan.exists) == 1 && array.length(plan.joins) == 0 && array.length(plan.grouping) == 0,
        "exists any-of: inner OR-group keeps one correlated EXISTS without fan-out join")
        && check(string.contains(query.sql, "(k.name = ? OR k.name = ?)")
            && string.contains(query.sql, "GROUP BY k.parent_id HAVING count(k.id) >= ?"),
            "exists any-of: the OR-group stays inside the single EXISTS")
        && check(query.bindings == expected, "exists any-of: member values then the minimum threshold keep bindings order")
};

# ---------------------------------------------------------------------------
# Permanent negative evidence: an AnyOf Plan is accepted by the full profile but
# rejected (profile_accepts == False) when 'Or or 'Eq is removed from the
# allowed scalars. Covers an ordinary OR-group and an EXISTS-inner OR-group.
# ---------------------------------------------------------------------------

def profile_no_or: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Exists, 'Join, 'Group, 'Having, 'Order,
        'Limit, 'Offset, 'Partition,
    ],
    allowed_join_kinds: ['Inner, 'Left],
    allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
    allowed_scalars: [
        'Substr, 'Instr, 'If, 'Add, 'Sub, 'Lower, 'Length,
        'JsonExtract, 'JsonType, 'JsonValid,
        'Eq, 'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Not,
    ],
    allow_distinct: 'True,
};

def profile_no_eq: qb.PlanProfile = {
    allowed_operators: [
        'Source, 'Project, 'Column, 'Bind, 'Scalar, 'Aggregate,
        'Filter, 'Exists, 'Join, 'Group, 'Having, 'Order,
        'Limit, 'Offset, 'Partition,
    ],
    allowed_join_kinds: ['Inner, 'Left],
    allowed_aggregates: ['Count, 'Sum, 'Avg, 'Min, 'Max],
    allowed_scalars: [
        'Substr, 'Instr, 'If, 'Add, 'Sub, 'Lower, 'Length,
        'JsonExtract, 'JsonType, 'JsonValid,
        'Ne, 'Lt, 'Le, 'Gt, 'Ge, 'And, 'Or, 'Not,
    ],
    allow_distinct: 'True,
};

def next_profile_any_ordinary_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "OrderAmount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let any: edsl.AnyOfRequest = { id: "OrderRegion", subject: "analyst", values: ['Text("east"), 'Text("west")] };
    let plan: qb.Plan = edsl.lower_any(knowledge.payload, request, [any], [], []);
    let full_ok = qb.profile_accepts(plan, knowledge.profile);
    let no_or_ok = qb.profile_accepts(plan, profile_no_or);
    let no_eq_ok = qb.profile_accepts(plan, profile_no_eq);
    check(full_ok, "any-of profile: full profile accepts the ordinary OR-group")
        && check(!no_or_ok, "any-of profile: removing 'Or rejects the ordinary OR-group")
        && check(!no_eq_ok, "any-of profile: removing 'Eq rejects the ordinary OR-group")
};

def next_profile_any_exists_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "ParentCount", subject: "analyst", input: 'All }],
        dimensions: [],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let any: edsl.AnyOfRequest = { id: "ChildName", subject: "analyst", values: ['Text("a"), 'Text("b")] };
    let exists: edsl.ExistsRequest = { target: "children", subject: "analyst", filters: [], any_of: [any], min_matches: 'Some(1) };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [exists], []);
    let full_ok = qb.profile_accepts(plan, knowledge.profile);
    let no_or_ok = qb.profile_accepts(plan, profile_no_or);
    let no_eq_ok = qb.profile_accepts(plan, profile_no_eq);
    check(full_ok, "any-of profile: full profile accepts the EXISTS-inner OR-group")
        && check(!no_or_ok, "any-of profile: removing 'Or rejects the EXISTS-inner OR-group")
        && check(!no_eq_ok, "any-of profile: removing 'Eq rejects the EXISTS-inner OR-group")
};

# Union (multi-source) entity: two item branches merged under one logical alias;
# the outer query keeps projection/grouping/HAVING/partition over the derived
# source, with branch-declaration-then-outer binding order.
def next_union_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "ItemCount", subject: "analyst", input: 'All }],
        dimensions: [
            { id: "ItemOwner", subject: "analyst", input: 'None },
            { id: "ItemGroup", subject: "analyst", input: 'None },
        ],
        filters: [],
        ordering: [
            { target: 'Measure("ItemCount"), direction: 'Desc },
            { target: 'Dimension("ItemGroup"), direction: 'Asc },
        ],
        limit: 'None,
        offset: 'None,
        partition: 'Some({ by: ["ItemOwner"], take: 1 }),
    };
    let having: edsl.HavingRequest = {
        measure: "ItemCount",
        subject: "analyst",
        op: 'Ge,
        threshold: 'Int(2),
    };
    let plan: qb.Plan = edsl.lower_full(knowledge.payload, request, [], [having]);
    let query: qb.Query = qb.transform_sqlite(plan);
    let expected: Array(qb.Val) = ['String("retail"), 'Int(2), 'Int(1)];
    check(plan.derived != 'None && array.length(plan.sources) == 0
        && array.length(plan.joins) == 0 && array.length(plan.exists) == 0,
        "union entity: derived source with no physical sources/joins/exists")
        && check(string.contains(query.sql, "UNION ALL")
            && string.contains(query.sql, "FROM items_a AS a")
            && string.contains(query.sql, "FROM items_b AS b")
            && string.contains(query.sql, "a.owner_id")
            && string.contains(query.sql, "b.category_key")
            && string.contains(query.sql, "b.resource_key")
            && string.contains(query.sql, "b.account_key")
            && string.contains(query.sql, "WHERE b.kind = ?")
            && string.contains(query.sql, "HAVING count(u.item_id) >= ?"),
            "union entity: heterogeneous branch columns merge under stable logical names")
        && check(query.bindings == expected, "union entity: branch filter then having then take bind order")
};

def next_union_deterministic_ok: Bool = do {
    let request: edsl.QueryRequest = {
        measures: [{ id: "ItemCount", subject: "analyst", input: 'All }],
        dimensions: [{ id: "ItemOwner", subject: "analyst", input: 'None }],
        filters: [],
        ordering: [],
        limit: 'None,
        offset: 'None,
        partition: 'None,
    };
    let p1: qb.Plan = edsl.lower(knowledge.payload, request);
    let p2: qb.Plan = edsl.lower(knowledge.payload, request);
    let q1: qb.Query = qb.transform_sqlite(p1);
    let q2: qb.Query = qb.transform_sqlite(p2);
    check(p1 == p2 && q1.sql == q2.sql && q1.bindings == q2.bindings,
        "union entity: repeated lowering is byte-identical")
};

