use ontology::registry as registry;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::transform as t;
use ontology::query as qb;
type ResourceId = struct(
    String
);
use ontology::quantity::{EffectiveCount};
# 仅沿用旧百分比尺度假定，尚未确认生产比例；不增加范围检查。
type AssumedOnlinePercent = struct(
    Float
);
def online_statistics: samples::Group(AssumedOnlinePercent) = samples::group(
    "reported_network_online",
    AssumedOnlinePercent.type,
    samples::Statistic::Mean,
    [samples::Statistic::Min, samples::Statistic::Max],
    Some("%")
);
@registry::dataset(
    "source_NetworkDeviceOnlineKPI",
    "NetworkDeviceOnlineKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceOnlineKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkDeviceOnlineKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_NetworkDeviceOnlineKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceOnlineKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_NetworkDeviceOnlineKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceOnlineKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_NetworkDeviceOnlineKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceOnlineKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_NetworkDeviceOnlineKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceOnlineKPI__onlineRate",
                AssumedOnlinePercent.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkDeviceOnlineKPI.type,
                    AssumedOnlinePercent.type,
                    "source_onlineRate"
                )
            ),
            "source_NetworkDeviceOnlineKPI__onlineRate",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceOnlineKPI__onlineRateEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkDeviceOnlineKPI.type,
                    EffectiveCount.type,
                    "source_onlineRateEffcnt"
                )
            ),
            "source_NetworkDeviceOnlineKPI__onlineRateEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::metric("source_ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            online_statistics,
            m::field(NetworkDeviceOnlineKPI.type, AssumedOnlinePercent.type, "source_onlineRate"),
            [
                {statistic: samples::Statistic::Mean, publish: "network_online_rate_avg"},
                {statistic: samples::Statistic::Min, publish: "network_online_rate_min"},
                {statistic: samples::Statistic::Max, publish: "network_online_rate_max"}
            ]
        ),
    ]
)
type NetworkDeviceOnlineKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkDeviceOnlineKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkDeviceOnlineKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_NetworkDeviceOnlineKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_NetworkDeviceOnlineKPI__projectId")
    source_projectId: String,
    @m::column("deviceName")
    @g::search("source_NetworkDeviceOnlineKPI__deviceName")
    source_deviceName: String,
    @m::column("classification")
    @g::exact("source_NetworkDeviceOnlineKPI__classification")
    source_classification: String,
    @m::column("onlineRate")
    source_onlineRate: AssumedOnlinePercent,
    @m::column("onlineRateEffcnt")
    source_onlineRateEffcnt: EffectiveCount,
};
def dataset: m::Dataset(NetworkDeviceOnlineKPI) = registry::dataset_of(NetworkDeviceOnlineKPI.type);

def declaration: t::Declaration = registry::declaration(NetworkDeviceOnlineKPI.type);
pub use self::{declaration};

pub use self::{NetworkDeviceOnlineKPI};
