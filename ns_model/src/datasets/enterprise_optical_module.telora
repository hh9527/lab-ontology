    @m::column("ifName")
    @g::field_view(g::dimension_group("enterprise-optical-module/if_name", domain::Reference(ids::EnterpriseOpticalModuleByIfName).type, True, [g::Filter::Eq]), "eom_if_name", True, [g::Filter::Eq])
    if_name: Option(domain::Reference(ids::EnterpriseOpticalModuleByIfName)),
