use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::serverfan_2_kpi;
@domain::subject("PhysicalServerFan", "obj_id")
@domain::dataset("kpi-server-fan", "kpi_server_fan", ["obj_id","ts"])
@domain::metric("ts")
@domain::relations(relations)
pub type KpiServerFan = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-server-fan/obj_id", domain::Reference(ids::KpiServerFanByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "sf_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::KpiServerFanByObjId),
    @m::column("TS")
    @g::field_view(g::dimension_group("kpi-server-fan/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "sf_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
    @g::utc_bucket_view("sf_utc_hour", qb::UtcBucketUnit::Hour)
    @g::utc_bucket_view("sf_utc_day", qb::UtcBucketUnit::Day)
    @g::utc_bucket_view("sf_utc_month", qb::UtcBucketUnit::Month)
    ts: s::DateTimeUtc,
    @m::column("SPEED")
    @g::field_view(g::dimension_group("kpi-server-fan/speed", metric::KpiServerFanSpeed.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sf_speed_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-server-fan/speed", metric::KpiServerFanSpeed.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("RPM")), [{statistic: samples::Statistic::Mean, publish: "sf_speed"}, {statistic: samples::Statistic::Max, publish: "sf_speed_max"}, {statistic: samples::Statistic::Min, publish: "sf_speed_min"}])
    speed: Option(metric::KpiServerFanSpeed),
    @m::column("SPEEDPERCENTAGE")
    @g::field_view(g::dimension_group("kpi-server-fan/speed_percentage", metric::KpiServerFanSpeedPercentage.type, True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]), "sf_speed_percentage_raw", True, [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le])
    @samples::field(samples::group("kpi-server-fan/speed_percentage", metric::KpiServerFanSpeedPercentage.type, samples::Statistic::Mean, [samples::Statistic::Max, samples::Statistic::Min], Some("%")), [{statistic: samples::Statistic::Mean, publish: "sf_speed_percentage"}, {statistic: samples::Statistic::Max, publish: "sf_speed_percentage_max"}, {statistic: samples::Statistic::Min, publish: "sf_speed_percentage_min"}])
    speed_percentage: Option(metric::KpiServerFanSpeedPercentage),
};

pub def relations: Array(r::Relation) = [
    r::relation("sf__se_rev", domain::endpoint(KpiServerFan.type, "obj_id"), domain::endpoint(serverfan_2_kpi::Serverfan2Kpi.type, "obj_id"), {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
];
