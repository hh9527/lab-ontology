use crate::model::{ payload };
use ontology::knowledge as knowledge;
use ontology::ontology as edsl;
use std::value::{ Value };
use std::codec as codec;
use std::array as array;
use std::test as test;

pub def ic_peer_link_exposes_both_declared_endpoint_roles: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::BusinessLink,
        owner: "physical_link", id: "physical_link_peer_device"};
    match knowledge::by_target(payload, "public", id) {
        knowledge::DocResult::Found(point) => if point.direction == Some(edsl::LinkDirection::Undirected)
            && array::any(point.refs, fn(ref) {
                ref.target.kind == edsl::KnowledgeKind::Relation && ref.target.id == "physical_link_a_device"
            })
            && array::any(point.refs, fn(ref) {
                ref.target.kind == edsl::KnowledgeKind::Relation && ref.target.id == "physical_link_z_device"
            }) { True }
            else { fail!("peer knowledge lost direction or a declared endpoint role", point) },
        other => fail!("IC peer business link is not discoverable", other),
    }
});

pub def ic_undirected_link_participation_is_discoverable: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "physical_link", id: "physical_link_attached_device"};
    match knowledge::by_target(payload, "public", id) {
        knowledge::DocResult::Found(point) => match point.relation {
            Some(relation) => if relation.from_dataset == "physical_link"
                && relation.to_dataset == "device"
                && relation.kind == edsl::RelationKind::FanOut
                && match relation.shape {
                    edsl::RelationShape::Any(branches) => array::length(branches) == 2
                        && array::all(branches, fn(branch) {
                            match branch {
                                edsl::RelationShape::All(keys) => array::length(keys) == 2,
                                _ => False,
                            }
                        }),
                    _ => False,
                } { True }
            else { fail!("link participation knowledge lost either complete endpoint", relation) },
            None => fail!("link participation has no declared relation detail"),
        },
        other => fail!("IC link participation relation is not discoverable", other),
    }
});

pub def on_demand_relation_matches_full_catalog: test::Test = test::should_ok(fn() {
    let request = Value::Object({target: Value::Object({kind: Value::String("relation"),
        owner: Value::String("physical_link"), id: Value::String("physical_link_attached_device")})});
    let response = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic")(request);
    match codec::decode@[knowledge::KnowledgeResponse](response).unwrap!() {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(item)) =>
            match item.relation {
                Some(relation) => match relation.shape {
                    edsl::RelationShape::Any(branches) => if array::length(branches) == 2
                        && array::any(item.refs, fn(ref) {
                            ref.target.kind == edsl::KnowledgeKind::Dataset && ref.target.id == "device"
                        }) { True }
                        else { fail!("on-demand relation lost an endpoint or branch", item) },
                    _ => fail!("on-demand relation lost its OR branches", item),
                },
                None => fail!("on-demand relation lost its details", item),
            },
        other => fail!("on-demand relation returned a non-document", other),
    }
});

pub def frame_context_owner_relations_are_discoverable: test::Test = test::should_ok(fn() {
    let doc = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic");
    let frame = codec::decode@[knowledge::KnowledgeResponse](doc(Value::Object({topic: Value::String("frame_belongs_to_device")}))).unwrap!();
    let sample = codec::decode@[knowledge::KnowledgeResponse](doc(Value::Object({topic: Value::String("device_kpi_of_device")}))).unwrap!();
    match (frame, sample) {
        (knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(f)),
            knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(s))) =>
            match (f.relation, s.relation) {
                (Some(fr), Some(sr)) => if fr.to_dataset == "device" && sr.to_dataset == "device"
                    && fr.kind == edsl::RelationKind::Safe && sr.kind == edsl::RelationKind::Safe
                    && array::any(f.refs, fn(ref) { ref.target.id == "device" })
                    && array::any(s.refs, fn(ref) { ref.target.id == "device" }) { True }
                    else { fail!("Frame context and KPI sample do not share a discoverable Device owner", fr, sr) },
                _ => fail!("Frame context has no discoverable named ownership relations", f, s),
            },
        other => fail!("Frame and KPI ownership paths are absent from doc.ic", other),
    }
});

pub def device_kpi_sample_count_is_discoverable: test::Test = test::should_ok(fn() {
    let result = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic")(
        Value::Object({topic: Value::String("device_kpi_sample_count")}));
    match codec::decode@[knowledge::KnowledgeResponse](result).unwrap!() {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if point.target.kind == edsl::KnowledgeKind::Measure
                && point.target.owner == "device_kpi"
                && array::any(point.refs, fn(ref) {
                    ref.target.kind == edsl::KnowledgeKind::Dataset && ref.target.id == "device_kpi"
                }) { True }
            else { fail!("sample count lost its metric dataset reference", point) },
        other => fail!("named sample count is absent from doc.ic", other),
    }
});

pub def onu_sample_role_path_is_discoverable: test::Test = test::should_ok(fn() {
    let doc = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic");
    let sample = codec::decode@[knowledge::KnowledgeResponse](doc(Value::Object({topic: Value::String("onu_kpi_of_onu_role")}))).unwrap!();
    let parent = codec::decode@[knowledge::KnowledgeResponse](doc(Value::Object({topic: Value::String("pon_onu_parent_olt")}))).unwrap!();
    match (sample, parent) {
        (knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(s)),
            knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(p))) =>
            match (s.relation, p.relation) {
                (Some(sr), Some(pr)) => if sr.from_dataset == "onu_kpi"
                    && sr.to_dataset == "pon_onu_role"
                    && pr.from_dataset == "pon_onu_role"
                    && pr.to_dataset == "pon_olt_role" { True }
                else { fail!("ONU sample and parent paths do not meet at scoped child role", sr, pr) },
                _ => fail!("ONU ownership path has no relation detail", s, p),
            },
        other => fail!("ONU sample-to-parent relation path is undiscoverable", other),
    }
});

pub def computed_alarm_measure_links_its_operand_knowledge: test::Test = test::should_ok(fn() {
    let result = knowledge::knowledge_method_factory(payload, "public", "ic", "doc.ic")(
        Value::Object({topic: Value::String("critical_or_major_alarm_count")}));
    match codec::decode@[knowledge::KnowledgeResponse](result).unwrap!() {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if point.target.kind == edsl::KnowledgeKind::Measure
                && point.target.owner == "current_alarm"
                && array::any(point.refs, fn(ref) { ref.target.id == "critical_alarm_count" })
                && array::any(point.refs, fn(ref) { ref.target.id == "major_alarm_count" }) { True }
            else { fail!("computed alarm count lost its operand knowledge references", point) },
        other => fail!("computed alarm count is not discoverable", other),
    }
});
