    pair("semantic_site_exists", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"}],"edges":[],"select":[{"node":"a","dimension":"alarm_csn"}],"exists":[{"anchor":"a","nodes":[{"id":"p","entity":"site"}],"edges":[{"relation":"alarm_site_reference","from":"a","to":"p"}]}]}"#).unwrap!()),
    pair("source_site_exists", json::parse(r#"{"op":"Graph","root":"a","nodes":[{"id":"a","entity":"current_alarm"}],"edges":[],"select":[{"node":"a","dimension":"alarm_csn"}],"exists":[{"anchor":"a","nodes":[{"id":"p","entity":"site"}],"edges":[{"relation":"source_X_SITE_VIEW_T_CURRENT_ALARM","from":"p","to":"a"}]}]}"#).unwrap!()),
