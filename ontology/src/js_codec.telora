# 模型属性形成 codec 描述；单份构造程序在宿主上实例化这些约束。
use crate::shared_types as shared;
use std::prelude as prelude;
use std::type_property as property;
use std::codec as codec;
use std::type_desc as td;
use std::array as array;
use std::value::{Value};
use crate::intent as intent;
use crate::type_catalog as catalog;
use crate::enum_values as ev;
use crate::ontology as edsl;
use crate::quantity as quantity;
@prelude::property(PropertyTarget::Type)
type NumberRange = struct {
    min: Float,
    max: Float
};
def number_range: Fn(Float, Float) -> Fn(Type, Option(NumberRange)) -> NumberRange = fn(min, max) {
    if min > max {
        fail!("invalid codec number range", min, max)
    } else {
        ()
    };
    fn(ctx, previous) {
        {min, max}
    }
};

def optional_value: Fn(Type) -> Option(Type) = fn(ty) {
    catalog::describe(ty).optional
};
def leaf: Fn(Type) -> Type = fn(ty) {
    let description = catalog::describe(ty);
    if description.kind == td::TypeDescKind::Newtype {
        leaf(td::children(description.body)[0])
    } else {
        ty
    }
};
def ranges: Fn(Type, intent::ResultType) -> Array(NumberRange) = fn(ty, storage) {
    let own = match property::get_type_prop(ty, NumberRange.type) {
        Some(range) => if storage == intent::ResultType::Float || storage == intent::ResultType::Int {
            [range]
        } else {
            fail!("number_range requires numeric storage", ty)
        },
        None => []
    };
    let description = catalog::describe(ty);
    array::concat(
        [
            if description.kind == td::TypeDescKind::Newtype {
                ranges(td::children(description.body)[0], storage)
            } else {
                []
            },
            own
        ]
    )
};
type EnumCase = struct {
    name: String,
    wires: Array(Value)
};
type EnumDescription = struct {
    kind: String,
    storage: intent::ResultType,
    cases: Array(EnumCase),
    tags: Array((String, Int)),
    order: Array(String)
};
def enum_description: Fn(Type, intent::ResultType) -> Value = fn(ty, storage) {
    let variants = catalog::describe(ty).variants;
    if !array::all(
        variants,
        fn(v) {
            v.payload == None
        }
    ) {
        fail!("business enum requires unit variants", ty)
    } else {
        ()
    };
    if storage != intent::ResultType::String && storage != intent::ResultType::Int {
        fail!("enum codec requires String or Int storage", ty)
    } else {
        ()
    };
    let tags = ev::integer_tags(ty);
    let cases = array::map(
        variants,
        fn(v) {
            let wire = if storage == intent::ResultType::String {
                codec::encode(v.name)
            } else {
                match array::find(
                    tags,
                    fn(t) {
                        t.0 == v.name
                    }
                ) {
                    Some(tag) => codec::encode(tag.1),
                    None => fail!(
                        "integer enum codec requires exactly one itag per variant",
                        ty,
                        v.name
                    )
                }
            };
            {name: v.name, wires: [wire]}.ty!(EnumCase)
        }
    );
    codec::encode(
        {kind: "enum", storage, cases, tags, order: ev::business_order(ty)}.ty!(EnumDescription)
    )
};
type ScalarDescription = struct {
    kind: String,
    primary: String,
    ranges: Array(NumberRange),
    operations: Option(Array(quantity::Calculation))
};
type OptionalDescription = struct {
    kind: String,
    inner: Value
};
def describe: Fn(Type, intent::ResultType) -> Value = fn(ty, storage) {
    match optional_value(ty) {
        Some(inner) => codec::encode(
            {kind: "optional", inner: describe(inner, storage)}.ty!(OptionalDescription)
        ),
        None => do {
            let value = leaf(ty);
            if value != Bool.type && catalog::describe(value).kind == td::TypeDescKind::Enum {
                enum_description(value, storage)
            } else {
                let primary = match shared::semantic(ty) {
                    Some("TimeZone") => if storage == intent::ResultType::String {
                        "TimeZone"
                    } else {
                        fail!("TimeZone requires String storage")
                    },
                    _ => match storage {
                        intent::ResultType::String => "String",
                        intent::ResultType::Int => "Int",
                        intent::ResultType::Float => "Float",
                        intent::ResultType::Bool => "Bool",
                        intent::ResultType::DateTimeUtc => "DateTimeUtc",
                        intent::ResultType::EpochMillis => "EpochMillis",
                        intent::ResultType::DateTime => "DateTime"
                    }
                };
                codec::encode(
                    {
                        kind: "scalar",
                        primary,
                        ranges: ranges(ty, storage),
                        operations: quantity::calculation_policy(ty)
                    }.ty!(ScalarDescription)
                )
            }
        }
    }
};
type Description = struct {
    storage: intent::ResultType,
    value: Value
};
def descriptions: Fn(Type, intent::ResultType) -> Array(Description) = fn(ty, storage) {
    let base = {storage, value: describe(ty, storage)}.ty!(Description);
    let value = leaf(ty);
    let description = catalog::describe(value);
    if value != Bool.type && description.kind == td::TypeDescKind::Enum && storage != intent::ResultType::Int {
        let tags = ev::integer_tags(value);
        if tags != [] && array::length(tags) == array::length(description.variants) {
            [
                base,
                {storage: intent::ResultType::Int, value: describe(ty, intent::ResultType::Int)}.ty!(
                    Description
                )
            ]
        } else {
            [base]
        }
    } else {
        [base]
    }
};
type MappingDescription = struct {
    cases: Array(EnumCase),
    fallback: Option(String)
};
def mapping: Fn(edsl::DimensionEntry) -> Value = fn(entry) {
    let cases = array::map(
        entry.canonical_values,
        fn(value) {
            {
                name: value.id,
                wires: array::map(
                    value.wires,
                    fn(wire) {
                        match wire {
                            edsl::FilterInput::Text(value) => codec::encode(value),
                            edsl::FilterInput::Int(value) => codec::encode(value),
                            _ => fail!("field mapping requires String or Int source", entry.id)
                        }
                    }
                )
            }.ty!(EnumCase)
        }
    );
    codec::encode({cases, fallback: entry.fallback}.ty!(MappingDescription))
};
pub use self::{
    NumberRange,
    number_range,
    optional_value,
    describe,
    Description,
    descriptions,
    mapping
};
# 展现和共享语义分别发布，不属于 parse/encode/decode 的实现。
type DisplayPresentation = struct {
    multiplier: Float,
    suffix: String,
    precision: Int
};
def presentation: Fn(Type) -> Value = fn(ty) {
    let digits = quantity::display_digits(ty);
    let policy: Option(DisplayPresentation) = match quantity::display_policy(ty) {
        Some(scale) => Some(
            {
                multiplier: scale.multiplier,
                suffix: scale.suffix,
                precision: match digits {
                    Some(value) => value,
                    None => 2
                }
            }
        ),
        None => match digits {
            Some(value) => Some({multiplier: 1.0, suffix: "", precision: value}),
            None => None
        },
    };
    codec::encode(policy)
};
type SemanticIdentity = struct {
    identity: Option(String),
    semantic: Option(String)
};
def semantic: Fn(Type) -> Value = fn(ty) {
    let identity: SemanticIdentity = {identity: shared::direct(ty), semantic: shared::semantic(ty)};
    codec::encode(identity)
};
pub use self::{presentation, semantic};
