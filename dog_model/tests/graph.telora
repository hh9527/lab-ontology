use crate::model::{ payload };
use ontology::knowledge as knowledge;
use ontology::ontology as edsl;
use ontology::intent::{ query_intent_ast_factory };
use ontology::sqlite as sqlite;
use std::array as array;
use std::json as json;
use std::string as string;
use std::test as test;

pub def aggregate_knowledge_uses_real_fields: test::Test = test::should_ok(fn() {
    let points = knowledge::map(payload, "resolver");
    let expected = [
        ("Charge", "MaxChargeAmount", "charge_amount"),
        ("Dog", "AvgDogAge", "age"),
        ("Dog", "MinDogWeight", "weight"),
        ("Treatment", "MaxTreatmentCost", "cost_of_treatment"),
    ];
    if array::all(expected, fn(item) {
        let (owner, id, field) = item;
        array::any(points, fn(point) {
            point.target == {kind: edsl::KnowledgeKind::Measure, owner, id}
                && array::any(point.refs, fn(link) {
                    link.kind == knowledge::LinkKind::Member
                        && link.target == {kind: edsl::KnowledgeKind::Field, owner, id: field}
                })
        })
    }) && !array::any(points, fn(point) {
        point.target.kind == edsl::KnowledgeKind::Field
            && array::any(["zz_amount_avg", "zz_age_avg", "zz_weight_min", "zz_cost_max"], fn(id) {
                point.target.id == id
            })
    }) { True } else { fail!("aggregate knowledge retained synthetic fields or lost real-field references") }
});

pub def dog_breed_projection: test::Test = test::should_ok(fn() {
    let lower = query_intent_ast_factory(payload, "resolver");
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"dog",
        "nodes":[{"id":"dog","entity":"Dog"},{"id":"breed","entity":"Breed"}],
        "edges":[{"relation":"dog_breed","from":"dog","to":"breed"}],
        "select":[{"node":"dog","dimension":"DogName"},{"node":"breed","dimension":"BreedName"}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "JOIN Breeds AS breed ON dog.breed_code = breed.breed_code") {
        True
    } else { fail!("dog/breed graph did not lower", sql) }
});

pub def count_dogs_with_treatment: test::Test = test::should_ok(fn() {
    let lower = query_intent_ast_factory(payload, "resolver");
    let ast = lower(json::parse(r#"{
        "op":"graph", "root":"dog", "nodes":[{"id":"dog","entity":"Dog"}],
        "edges":[], "select":[], "count":"dog",
        "exists":[{"anchor":"dog","nodes":[{"id":"treatment","entity":"Treatment"}],
            "edges":[{"relation":"treatment_dog","from":"treatment","to":"dog"}]}]
    }"#).unwrap!());
    let sql = sqlite::build_query(ast).sql;
    if string::contains(sql, "count(dog.dog_id)")
        && string::contains(sql, "EXISTS (SELECT 1 FROM Treatments AS treatment") {
        True
    } else { fail!("treatment existence must preserve Dog grain", sql) }
});
