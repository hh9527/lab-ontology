use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::transform as t;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::codec as codec;
use std::json as json;
use std::value::{Value};
use std::test as test;

type State = struct(String);
type Class = struct(String);
type Row = struct { seq: Int, state: Option(Int), class: Option(String) };
def rows: m::Dataset(Row) = m::dataset("values", "value_rows", Row.type, ["seq"]);
def states: v::Domain(State, Int) = v::domain("State", State.type, Int.type, [v::member(State("Online"), [0, 2]), v::member(State("Offline"), [1])], False);
def classes: v::Domain(Class, String) = v::domain("Class", Class.type, String.type, [v::member(Class("LoadBalancer"), ["lb", "ne.category.lb"]), v::member(Class("Other"), ["other"])], True);
def state: v::Binding(Row) = v::bind(rows, v::dimension_group(states, True, g::equality_filters), g::input(m::optional_field(Row.type, Int.type, "state")), "state", True, g::equality_filters);
def class: v::Binding(Row) = v::bind(rows, v::dimension_group(classes, True, g::equality_filters), g::input(m::optional_field(Row.type, String.type, "class")), "class", True, g::equality_filters);
def declared: t::Declaration = t::with_domains(t::map_columns(t::declare(rows, [], [g::dimension(rows, g::dimension_group("seq", Int.type, True, []), g::input(m::field(Row.type, Int.type, "seq")), "seq", True, [])], ["total"]), [t::column(m::optional_field(Row.type, Int.type, "state"), "STATE_CODE"), t::column(m::optional_field(Row.type, String.type, "class"), "CLASS_CODE")]), [state, class]);
def profile: qb::PlanProfile = {
    allowed_operators: [qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate, qb::Operator::Filter, qb::Operator::Group, qb::Operator::Order],
    allowed_join_kinds: [], allowed_aggregates: [qb::AggregateFunction::Count],
    allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::If, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not, qb::ScalarFunction::IsNotNull, qb::ScalarFunction::Add], allow_distinct: True,
};
def payload: edsl::PreparedPayload = t::prepare("values", [declared], profile).payload;
def ast: Fn(String) -> qb::QueryAst = fn(extra) { intent::query_intent_ast_factory(payload)(json::parse(`{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"values"}],"edges":[],\{extra}}`).unwrap!()) };
type RuntimeCase = struct { id: String, sqlite: qb::Query, postgres: qb::Query };
def runtime_case: Fn(String, String) -> RuntimeCase = fn(id, extra) { let query = ast(extra); {id, sqlite: sqlite::build_query(query), postgres: postgres::build_query(query)} };
def filtered: Fn(String, String, String, String) -> RuntimeCase = fn(id, dimension, op, value) { runtime_case(id, `"select":[{"node":"r","dimension":"seq"}],"filters":[{"node":"r","dimension":"\{dimension}","op":"\{op}","value":\{value}}]`) };
pub def runtime_cases: Value = codec::encode([
    runtime_case("project", r#""select":[{"node":"r","dimension":"seq"},{"node":"r","dimension":"state"},{"node":"r","dimension":"class"}]"#),
    runtime_case("open_project", r#""select":[{"node":"r","dimension":"seq"},{"node":"r","dimension":"class"}]"#),
    filtered("online", "state", "Eq", r#""Online""#),
    filtered("not_online", "state", "Ne", r#""Online""#),
    filtered("known_class", "class", "Eq", r#""LoadBalancer""#),
    filtered("not_class", "class", "Ne", r#""LoadBalancer""#),
    filtered("collision", "class", "Eq", r#"{"unknown":"LoadBalancer"}"#),
    filtered("unknowns", "class", "Eq", r#"{"unknowns":true}"#),
    filtered("knowns", "class", "Ne", r#"{"unknowns":true}"#),
]);
pub def raw_numeric_filter_is_rejected: test::Test = test::should_fail(fn() { filtered("bad", "state", "Eq", "0") });
pub def raw_wire_is_not_business_value: test::Test = test::should_fail(fn() { filtered("bad", "class", "Eq", r#""lb""#) });
pub def overlapping_wire_is_rejected: test::Test = test::should_fail_with(fn() { v::checked_domain("bad", State.type, Int.type, [v::member(State("Online"), [0]), v::member(State("Offline"), [0])], False) }, "business domain wire values must be disjoint");
pub def half_open_integer_is_rejected: test::Test = test::should_fail_with(fn() { v::checked_domain("bad", State.type, Int.type, [v::member(State("Online"), [0])], True) }, "half-open business domain requires text wire storage");
pub def half_open_order_is_rejected: test::Test = test::should_fail_with(fn() { v::checked_ordered(classes, [Class("LoadBalancer"), Class("Other")]) }, "half-open business domain cannot declare a closed order");
pub def complete_closed_order_is_accepted: test::Test = test::should_ok(fn() { v::ordered(states, [State("Offline"), State("Online")]).definition.order == ["Offline", "Online"] });
pub def erased_wire_witness_is_rechecked: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [declared <~ {domains: [v::binding_facts(state) <~ {definition: states.definition <~ {wire: String.type}}]}], profile) }, "business domain wire does not match its declared type");
pub def erased_owner_is_rechecked: test::Test = test::should_fail_with(fn() { t::checked_prepare("bad", [declared <~ {domains: [v::binding_facts(state) <~ {dataset: "other"}]}], profile) }, "business dimension binding belongs to another dataset");

pub def same_business_type_accepts_another_source_encoding: test::Test = test::should_ok(fn() {
    let text_states = v::domain("State", State.type, String.type, [v::member(State("Online"), ["up"]), v::member(State("Offline"), ["down"])], False);
    let text = v::bind(rows, v::dimension_group(text_states, True, g::equality_filters), g::input(m::optional_field(Row.type, String.type, "class")), "text_state", True, g::equality_filters);
    let prepared = t::prepare("two-encodings", [t::with_domains(declared, [state, text])], profile);
    prepared.payload.dimensions[1].value_type == prepared.payload.dimensions[2].value_type
});
pub def binding_cannot_expand_domain_capabilities: test::Test = test::should_fail_with(fn() {
    v::checked_bind(rows, v::checked_dimension_group(states, False, [g::Filter::Eq]), g::checked_input(m::checked_optional_field(Row.type, Int.type, "state")), "state", True, g::equality_filters)
}, "business dimension binding cannot expand group capabilities");
pub def duplicate_business_ids_are_rejected: test::Test = test::should_fail_with(fn() {
    v::checked_domain("bad", State.type, Int.type, [v::member(State("Online"), [0]), v::member(State("Online"), [1])], False)
}, "business domain member ids must be distinct and have wire values");
pub def incomplete_business_order_is_rejected: test::Test = test::should_fail_with(fn() {
    v::checked_ordered(states, [State("Online")])
}, "business domain order must name every known member exactly once");
pub def empty_known_domain_is_rejected: test::Test = test::should_fail_with(fn() {
    v::checked_domain("bad", State.type, Int.type, [].ty!(Array(v::Member(State, Int))), False)
}, "business domain must declare known members");
