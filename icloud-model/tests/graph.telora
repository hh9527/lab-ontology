pub def independently_filtered_alarm_measures_keep_separate_thresholds: test::Test = test::should_ok(fn() {
    let intent = json::parse(r#"{"op":"graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"device_current_alarm","from":"alarm","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"alarm","measure":"critical_alarm_count"},
                    {"node":"alarm","measure":"major_alarm_count"}],
        "group_by_identity":["device"],
        "measure_having":[{"node":"alarm","measure":"critical_alarm_count","op":"gt","kind":"int","value":2},
                          {"node":"alarm","measure":"major_alarm_count","op":"gt","kind":"int","value":1}]}
    "#).unwrap!();
    let sq = lower(intent);
    let pg = postgres::build_query(query_intent_ast_factory(payload, "public")(intent));
    if string::contains(sq.sql, "count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?1) AS alarm_critical_alarm_count")
        && string::contains(sq.sql, "count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?2) AS alarm_major_alarm_count")
        && string::contains(sq.sql, "HAVING count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?1) > ?3")
        && string::contains(sq.sql, "count(alarm.CSN) FILTER (WHERE alarm.SEVERITY = ?2) > ?4")
        && string::contains(pg.sql, "FILTER (WHERE \"alarm\".\"SEVERITY\" = $1)")
        && sq.bindings == [qb::Val::String("1"), qb::Val::String("2"), qb::Val::Int(2), qb::Val::Int(1)]
        && pg.bindings == sq.bindings { True }
    else { fail!("independent filtered alarm thresholds merged their populations", sq, pg) }
});

