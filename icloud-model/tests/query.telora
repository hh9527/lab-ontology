pub def slot_boolean_dimension_lowers_and_is_discoverable: test::Test = test::should_ok(fn() {
    let yes_rows = lower_json(`{"op":"list","measures":[],"dimensions":["slot_id","slot_name"],"filters":[{"dimension":"slot_is_daughter_card","op":"eq","kind":"bool","value":true}],"ordering":[],"limit":null,"offset":null}`);
    let no_rows = lower_json(`{"op":"list","measures":[],"dimensions":["slot_id"],"filters":[{"dimension":"slot_is_daughter_card","op":"ne","kind":"bool","value":true}],"ordering":[],"limit":null,"offset":null}`);
    let detail = edsl::dimension_detail_for_subject(payload, "public", "slot_is_daughter_card");
    if string::contains(yes_rows.sql, "sl.isDaughterCard = ?")
        && string::contains(no_rows.sql, "sl.isDaughterCard != ?")
        && yes_rows.bindings == [qb::Val::Bool(True)] && no_rows.bindings == [qb::Val::Bool(True)]
        && detail.dataset == "network_slot" && detail.input_kinds == [edsl::FilterInputKind::Bool]
        && detail.ops == [edsl::FilterOp::Eq, edsl::FilterOp::Ne]
        && array::length(detail.values) == 0 { True }
    else { fail!("slot Bool must lower with typed bindings and remain discoverable", yes_rows, no_rows, detail) }
});

pub def bilingual_knowledge_names_resolve_to_stable_ids: test::Test = test::should_ok(fn() {
    let catalog = edsl::knowledge_index_for_subject(payload, "public");
    let slot = array::find(catalog, fn(item) { item.id == "network_slot" });
    let dimension = edsl::dimension_detail_for_subject(payload, "public", "slot_is_daughter_card");
    let measure = edsl::measure_domain_for_subject(payload, "public", "slot_count");
    let relation = edsl::relation_detail_for_subject(payload, "public", "device_belongs_to_tenant");
    let slot_ok = match slot {
        Some(item) => item.label == "Slot" && item.aliases == ["单板"]
            && array::length(item.localized) == 2
            && array::any(item.localized, fn(note) { note.locale == "zh" && note.label == "单板" && note.summary == "网络设备机框内的单板" })
            && array::any(item.dimension_ids, fn(id) { id == dimension.id })
            && array::any(item.measure_ids, fn(id) { id == measure.id }),
        None => False,
    };
    if slot_ok && dimension.label == "Subboard" && dimension.aliases == ["是否子卡"]
        && array::any(dimension.localized, fn(note) { note.locale == "zh" && note.label == "是否子卡" })
        && array::any(edsl::dimension_detail(payload, dimension.id).localized, fn(note) { note.locale == "en" && note.label == "Subboard" })
        && array::any(measure.localized, fn(note) { note.locale == "zh" && note.summary == "网络单板的数量" })
        && array::any(relation.localized, fn(note) { note.locale == "zh" && note.label == "所属租户" })
        && measure.aliases == ["单板数量"] && relation.aliases == ["所属租户"]
        && edsl::dimension_detail(payload, dimension.id).aliases == dimension.aliases { True }
    else { fail!("localized names must cross-reference stable knowledge ids", slot, dimension, measure, relation) }
});

