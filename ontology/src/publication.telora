use crate::quantity as quantity;
# 模型发布：知识载荷、公开类型、codec 与两阶段查询协议。
use crate::typed_query as typed_query;
use crate::typed_query_protocol as protocol;
use crate::intent as intent;
use crate::ontology as edsl;
use crate::codec_publication;
use crate::semantic_preparation as semantic;
use crate::world as world;
use crate::query as query;
use std::value::{Value};
use std::codec as codec;
use std::build as build;
use std::array as array;
use std::string as string;
use std::json as json;
use std::dict as dict;
use std::pipeline as pipeline;
use std::hash as hash;
type InputType = typed_query::PublishedType;
type Contract = struct {
    contract_id: String,
    abi_version: String,
    datasets: Array(typed_query::Dataset),
    relations: Array(typed_query::Relation),
    types: Array(InputType),
    codec_module: String
};
type ContractBody = struct {
    abi_version: String,
    datasets: Array(typed_query::Dataset),
    relations: Array(typed_query::Relation),
    types: Array(InputType),
    codec_module: String
};
type Program = struct {
    contract: Value,
    transform: Fn(Value) -> Value
};

def prepare: Fn(edsl::PreparedPayload, String, Array((String, typed_query::TypeRef))) -> Program = fn(
    model,
    namespace,
    input_declarations
) {
    let collected: typed_query::Collected = typed_query::collect(model, namespace);
    let catalog: Array(typed_query::Dataset) = collected.datasets;
    let relations: Array(typed_query::Relation) = typed_query::relation_symbols(model, namespace);
    let input_refs: Array(typed_query::TypeRef) = array::map(
        input_declarations,
        fn(declared) {
            declared.1
        }
    );
    let input_types: Array(InputType) = array::map(
        array::enumerate(input_declarations),
        fn(pair) {
            {name: pair.1.0, preferred: True, logical: input_refs[pair.0].logical, storage: pair.1.1.storage}.ty!(
                InputType
            )
        }
    );
    # Mean result types belong to the same finite model type catalog.
    let original_refs = array::concat([collected.types, input_refs]);
    let mean_refs = array::flat_map(original_refs, fn(ref) {
        match quantity::mean_result_type(ref.ty) {Some(value) => [typed_query::type_ref(value, intent::ResultType::Float)], None => []}
    });
    # 自定义类型先去重；在这一边界之后才生成源码。
    let type_refs: Array(typed_query::TypeRef) = pipeline::run(
        pipeline::from_array(array::concat([original_refs, mean_refs])) |> pipeline::distinct_by(
            typed_query::type_key
        ) |> pipeline::collect()
    );
    let public_types: Array(InputType) = array::concat(
        [
            input_types,
            array::filter(
                typed_query::type_symbols(namespace, type_refs),
                fn(item) {
                    !array::any(
                        input_types,
                        fn(declared) {
                            declared.name == item.name
                        }
                    )
                }
            )
        ]
    );
    let codec_module: String = codec_publication::module_source(type_refs, model);
    let contract_id: String = hash::sha256(
        json::stringify(
            codec::encode(
                {
                    abi_version: "dari-model/v3",
                    datasets: catalog,
                    relations,
                    types: public_types,
                    codec_module
                }.ty!(ContractBody)
            )
        )
    );

    {
        contract: codec::encode(
            {
                contract_id,
                abi_version: "dari-model/v3",
                datasets: catalog,
                relations,
                types: public_types,
                codec_module
            }.ty!(Contract)
        ),
        transform: fn(input) {
            protocol::check_type(model, catalog, relations, contract_id, input)
        }
    }.ty!(Program)
};

# 构建期计算目录和 codec，运行期只保留发布合同与查询闭包。
def stage: Fn(
    String,
    Array(Type),
    query::PlanProfile,
    String,
    Array((String, typed_query::TypeRef))
) -> Program = fn(revision, roots, profile, namespace, aliases) {
    build::stage(
        fn() {
            let definition = semantic::define(revision, roots, profile);
            let prepared = world::prepare(definition);
            let program = prepare(prepared.payload, namespace, aliases);
            {
                runtime: program,
                information: dict::from_pairs(
                    [("ontology.knowledge", world::publication(definition, prepared))]
                )
            }
        },
        fn(program) {
            program
        }
    )
};

type Request = struct {
    method: String,
    input: Value
};
def dispatch: Fn(Program, Value) -> Value = fn(program, input) {
    let request = codec::decode@[Request](input).unwrap!();
    if request.method == "contract" {
        program.contract
    } else if request.method == "transform" {
        program.transform(request.input)
    } else {
        fail!("unknown model publication method", request.method)
    }
};
pub use self::{Program, Contract, prepare, stage, dispatch};
