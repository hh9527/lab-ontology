        {id: "wire_10_63a7292b", label: "FC", wires: [edsl::FilterInput::Int(10)]},
        {id: "wire_11_2c163c76", label: "PlanImport", wires: [edsl::FilterInput::Int(11)]},
        {id: "wire_12_5dc4ea39", label: "AID", wires: [edsl::FilterInput::Int(12)]},
        {id: "wire_13_c3b4db05", label: "OMCI", wires: [edsl::FilterInput::Int(13)]},
        {id: "wire_100_9fe18167", label: "DcnNorth", wires: [edsl::FilterInput::Int(100)]}
    ]]))
    link_type: Int,
    @edsl::column("direction")
    @edsl::dimension("physical_link_direction", True, True, canonical_eq_ne_ops, text_inputs)
    @edsl::canonical_values(link_direction_values)
    direction: String,
    @edsl::column("linkStatus")
    @edsl::dimension("physical_link_status", True, True, canonical_eq_ne_ops, text_inputs)
    @edsl::canonical_values(array::concat([physical_link_status_values, [
        {id: "wire_0_92e42f8f", label: "NORMAL", wires: [edsl::FilterInput::Int(0)]},
        {id: "wire_1_8d618873", label: "UNKNOWN", wires: [edsl::FilterInput::Int(1)]},
        {id: "wire_4_5978b238", label: "OFFLINE", wires: [edsl::FilterInput::Int(4)]},
        {id: "wire_5_c6f5830f", label: "UNMANAGE", wires: [edsl::FilterInput::Int(5)]}
    ]]))
    link_status: Int,
    @edsl::column("zNeResId")
    z_ne_res_id: String,
    @edsl::column("aPortIp")
    @edsl::dimension("physical_link_a_port_ip", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("physical_link_a_port_ip", "A-End Port IP Address", "IP address of the port at end A. Literal address-text search, not network membership or address normalization.")
    @edsl::computed_dimension("physical_link_a_port_ip_ipv4", edsl::OutputType::Text, True, True,
        ipv4_ops, ipv4_inputs, edsl::canonical_ipv4_view)
    @edsl::dimension_description("physical_link_a_port_ip_ipv4", "A-End Port IP Address (IPv4 view)",
        "Explicit canonical IPv4 view of physical_link_a_port_ip. Only four decimal octets 0..255 without leading zeros are retained; NULL, IPv6 and other representations produce NULL. No normalization or assertion about all source rows is made. InSubnet/NotInSubnet use CIDR with zero host bits, /0..32; complements exclude NULL and non-IPv4 values. Use physical_link_a_port_ip for raw text search or non-IPv4 values. This validated computed view does not promise source-column index access.")
    a_port_ip: String,
    @edsl::column("zPortName")
    @edsl::dimension("physical_link_z_port_name", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("physical_link_z_port_name", "Z-End Port", "Name of the port at end Z, which is the name of the destination port. Raw text search, not semantic ordering or identifier normalization.")
    z_port_name: String,
    @edsl::column("aNeIp")
    @edsl::dimension("physical_link_a_ne_ip", True, True, search_text_ops, text_inputs)
    @edsl::dimension_description("physical_link_a_ne_ip", "A-End NE IP Address", "IP address of the NE at end A, which is the IP address of the NE at the source end. Literal address-text search, not network membership or address normalization.")
    @edsl::computed_dimension("physical_link_a_ne_ip_ipv4", edsl::OutputType::Text, True, True,
