{
  "measures": [
    {"id": "EventCount", "input": "all"},
    {"id": "DurationSum", "input": "all"}
  ],
  "dimensions": [{"id": "Command"}],
  "filters": [
    {"id": "EventType", "op": "eq", "value": "action"},
    {"id": "Action", "op": "eq", "value": "shell"},
    {"id": "Success", "op": "eq", "value": 1}
  ],
  "ordering": [{"target": {"kind": "measure", "id": "DurationSum"}, "direction": "desc"}],
  "limit": 10
}
