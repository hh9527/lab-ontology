# spider_model/src/model.telora
#
# EnterpriseKnowledge for the Spider `student_transcripts_tracking` domain,
# built on the ontology eDSL.  The declarations here are PRIVATE: physical
# table/column names and relation paths live in this module and are never
# published to docs/DOMAIN.md or docs/INTENT.md.  Only the stable business
# vocabulary ids (measures/dimensions/entities) are public (docs/DOMAIN.md).
#
# Physical identifiers are declared lowercase; SQLite identifier matching is
# case-insensitive so generated SQL runs against the real database.

use ontology::query as qb;
use ontology::ontology as edsl;

# ---------------------------------------------------------------------------
# Shared filter capabilities.
# ---------------------------------------------------------------------------

def num_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Gt, edsl::FilterOp::Ge, edsl::FilterOp::Lt, edsl::FilterOp::Le];
def text_ops: Array(edsl::FilterOp) = [edsl::FilterOp::Eq, edsl::FilterOp::Ne, edsl::FilterOp::Contains, edsl::FilterOp::NotContains, edsl::FilterOp::StartsWith, edsl::FilterOp::EndsWith];
def text_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Text];
def num_kinds: Array(edsl::FilterInputKind) = [edsl::FilterInputKind::Int, edsl::FilterInputKind::Number];

# ---------------------------------------------------------------------------
# Entities.
#
# Canonical field indexes are the alphabetical order of the field names.
# ---------------------------------------------------------------------------

# --- addresses -------------------------------------------------------------
# Postal address (direct address queries).
# Canonical fields: city(0), country(1), id(2), line1(3), line2(4),
# state(5), zip(6).
@edsl::entity_id("address")
@edsl::entity_source("addresses", "ad")
type Address = struct {
    @edsl::column("city")
    @edsl::dimension("address_city", True, True, text_ops, text_kinds)
    city: String,

    @edsl::column("country")
    @edsl::dimension("address_country", True, True, text_ops, text_kinds)
    country: String,

    @edsl::column("address_id")
    @edsl::key()
    @edsl::measure("address_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("address_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("line_1")
    @edsl::dimension("address_line1", True, False, [], [])
    line1: String,

    @edsl::column("line_2")
    @edsl::dimension("address_line2", True, False, [], [])
    line2: String,

    @edsl::column("state_province_county")
    @edsl::dimension("address_state", True, True, text_ops, text_kinds)
    state: String,

    @edsl::column("zip_postcode")
    @edsl::dimension("address_zip", True, False, [], [])
    zip: String,
};

# --- current address role --------------------------------------------------
# The role "where a student currently lives": same physical address table,
# exposed as a separate entity so student->current-address joins are
# unambiguous.
# Canonical fields: city(0), country(1), id(2), line1(3), line2(4), state(5).
@edsl::entity_id("current_address")
@edsl::entity_source("addresses", "ca")
type CurrentAddress = struct {
    @edsl::column("city")
    @edsl::dimension("current_city", True, True, text_ops, text_kinds)
    city: String,

    @edsl::column("country")
    @edsl::dimension("current_country", True, True, text_ops, text_kinds)
    country: String,

    @edsl::column("address_id")
    @edsl::key()
    @edsl::dimension("current_address_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("line_1")
    @edsl::dimension("current_line1", True, False, [], [])
    line1: String,

    @edsl::column("line_2")
    @edsl::dimension("current_line2", True, False, [], [])
    line2: String,

    @edsl::column("state_province_county")
    @edsl::dimension("current_state", True, True, text_ops, text_kinds)
    state: String,
};

# --- permanent address role ------------------------------------------------
# The role "where a student permanently lives": same physical address table.
# Canonical fields: city(0), country(1), id(2), line1(3), line2(4), state(5).
@edsl::entity_id("permanent_address")
@edsl::entity_source("addresses", "pa")
type PermanentAddress = struct {
    @edsl::column("city")
    @edsl::dimension("permanent_city", True, True, text_ops, text_kinds)
    city: String,

    @edsl::column("country")
    @edsl::dimension("permanent_country", True, True, text_ops, text_kinds)
    country: String,

    @edsl::column("address_id")
    @edsl::key()
    @edsl::dimension("permanent_address_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("line_1")
    @edsl::dimension("permanent_line1", True, False, [], [])
    line1: String,

    @edsl::column("line_2")
    @edsl::dimension("permanent_line2", True, False, [], [])
    line2: String,

    @edsl::column("state_province_county")
    @edsl::dimension("permanent_state", True, True, text_ops, text_kinds)
    state: String,
};

# --- courses ---------------------------------------------------------------
# A course with name and description.
# Canonical fields: description(0), id(1), name(2).
@edsl::entity_id("course")
@edsl::entity_source("courses", "co")
type Course = struct {
    @edsl::column("course_description")
    @edsl::dimension("course_description", True, True, text_ops, text_kinds)
    description: String,

    @edsl::column("course_id")
    @edsl::key()
    @edsl::measure("course_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("course_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("course_name")
    @edsl::dimension("course_name", True, True, text_ops, text_kinds)
    name: String,
};

# --- departments -----------------------------------------------------------
# An academic department.
# Canonical fields: description(0), id(1), name(2).
@edsl::entity_id("department")
@edsl::entity_source("departments", "de")
type Department = struct {
    @edsl::column("department_description")
    @edsl::dimension("department_description", True, True, text_ops, text_kinds)
    description: String,

    @edsl::column("department_id")
    @edsl::key()
    @edsl::measure("department_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("department_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("department_name")
    @edsl::dimension("department_name", True, True, text_ops, text_kinds)
    name: String,
};

# --- degree programs -------------------------------------------------------
# A degree program offered by a department.
# Canonical fields: department_id(0), description(1), id(2), summary_name(3).
@edsl::entity_id("degree_program")
@edsl::entity_source("degree_programs", "dp")
@edsl::named_typed_relation_key("degree_program_department", DegreeProgram.type, Department.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(DegreeProgram.type, Int.type, "department_id"), edsl::model_field(Department.type, Int.type, "id")),
])
type DegreeProgram = struct {
    @edsl::column("department_id")
    department_id: Int,

    @edsl::column("degree_summary_description")
    @edsl::dimension("degree_description", True, True, text_ops, text_kinds)
    description: String,

    @edsl::column("degree_program_id")
    @edsl::key()
    @edsl::measure("degree_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("degree_program_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("degree_summary_name")
    @edsl::measure("degree_summary_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("degree_summary_name", True, True, text_ops, text_kinds)
    summary_name: String,
};

# --- sections --------------------------------------------------------------
# A course section with name and description.
# Canonical fields: course_id(0), description(1), id(2), name(3).
@edsl::entity_id("section")
@edsl::entity_source("sections", "se")
@edsl::named_typed_relation_key("section_course", Section.type, Course.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Section.type, Int.type, "course_id"), edsl::model_field(Course.type, Int.type, "id")),
])
type Section = struct {
    @edsl::column("course_id")
    course_id: Int,

    @edsl::column("section_description")
    @edsl::dimension("section_description", True, True, text_ops, text_kinds)
    description: String,

    @edsl::column("section_id")
    @edsl::key()
    @edsl::measure("section_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("section_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("section_name")
    @edsl::dimension("section_name", True, True, text_ops, text_kinds)
    name: String,
};

# --- semesters -------------------------------------------------------------
# An academic semester with name and description.
# Canonical fields: description(0), id(1), name(2).
@edsl::entity_id("semester")
@edsl::entity_source("semesters", "sm")
type Semester = struct {
    @edsl::column("semester_description")
    @edsl::dimension("semester_description", True, True, text_ops, text_kinds)
    description: String,

    @edsl::column("semester_id")
    @edsl::key()
    @edsl::measure("semester_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("semester_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("semester_name")
    @edsl::dimension("semester_name", True, True, text_ops, text_kinds)
    name: String,
};

# --- students --------------------------------------------------------------
# A student.  Canonical fields:
# cell(0), current_address_id(1), date_left(2), date_registered(3), email(4),
# first_name(5), id(6), last_name(7), middle_name(8), other_details(9),
# permanent_address_id(10).
@edsl::entity_id("student")
@edsl::entity_source("students", "st")
@edsl::named_typed_relation_key("student_enrolments", Student.type, StudentEnrolment.type, edsl::RelationKind::FanOut, [
    edsl::typed_relation_pair(edsl::model_field(Student.type, Int.type, "id"), edsl::model_field(StudentEnrolment.type, Int.type, "student_id")),
])
@edsl::named_typed_relation_key("student_current_address", Student.type, CurrentAddress.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Student.type, Int.type, "current_address_id"), edsl::model_field(CurrentAddress.type, Int.type, "id")),
])
@edsl::named_typed_relation_key("student_permanent_address", Student.type, PermanentAddress.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(Student.type, Int.type, "permanent_address_id"), edsl::model_field(PermanentAddress.type, Int.type, "id")),
])
type Student = struct {
    @edsl::column("cell_mobile_number")
    @edsl::dimension("student_cell", True, False, [], [])
    cell: String,

    @edsl::column("current_address_id")
    @edsl::measure("student_current_address_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("student_current_address", True, True, num_ops, num_kinds)
    current_address_id: Int,

    @edsl::column("date_left")
    @edsl::dimension("student_date_left", True, False, [], [])
    date_left: String,

    @edsl::column("date_first_registered")
    @edsl::dimension("student_date_registered", True, False, [], [])
    date_registered: String,

    @edsl::column("email_address")
    @edsl::dimension("student_email", True, False, [], [])
    email: String,

    @edsl::column("first_name")
    @edsl::dimension("student_first_name", True, True, text_ops, text_kinds)
    first_name: String,

    @edsl::column("student_id")
    @edsl::key()
    @edsl::measure("student_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("student_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("last_name")
    @edsl::dimension("student_last_name", True, True, text_ops, text_kinds)
    last_name: String,

    @edsl::column("middle_name")
    @edsl::dimension("student_middle_name", True, False, [], [])
    middle_name: String,

    @edsl::column("other_student_details")
    @edsl::dimension("student_details", True, False, [], [])
    other_details: String,

    @edsl::column("permanent_address_id")
    @edsl::dimension("student_permanent_address", True, True, num_ops, num_kinds)
    permanent_address_id: Int,
};

# --- student enrolment -----------------------------------------------------
# A student enrolment in a degree program during a semester.
# Canonical fields: degree_program_id(0), id(1), semester_id(2), student_id(3).
@edsl::entity_id("student_enrolment")
@edsl::entity_source("student_enrolment", "en")
@edsl::named_typed_relation_key("enrolment_program", StudentEnrolment.type, DegreeProgram.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(StudentEnrolment.type, Int.type, "degree_program_id"), edsl::model_field(DegreeProgram.type, Int.type, "id")),
])
@edsl::named_typed_relation_key("enrolment_semester", StudentEnrolment.type, Semester.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(StudentEnrolment.type, Int.type, "semester_id"), edsl::model_field(Semester.type, Int.type, "id")),
])
type StudentEnrolment = struct {
    @edsl::column("degree_program_id")
    degree_program_id: Int,

    @edsl::column("student_enrolment_id")
    @edsl::key()
    @edsl::measure("enrolment_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("student_enrolment_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("semester_id")
    semester_id: Int,

    @edsl::column("student_id")
    student_id: Int,
};

# --- student enrolment courses ---------------------------------------------
# A course taken by one student enrolment.
# Canonical fields: course_id(0), id(1), student_enrolment_id(2).
@edsl::entity_id("student_enrolment_course")
@edsl::entity_source("student_enrolment_courses", "ec")
@edsl::named_typed_relation_key("enrolled_course", StudentEnrolmentCourse.type, Course.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(StudentEnrolmentCourse.type, Int.type, "course_id"), edsl::model_field(Course.type, Int.type, "id")),
])
@edsl::named_typed_relation_key("course_enrolment", StudentEnrolmentCourse.type, StudentEnrolment.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(StudentEnrolmentCourse.type, Int.type, "student_enrolment_id"), edsl::model_field(StudentEnrolment.type, Int.type, "id")),
])
type StudentEnrolmentCourse = struct {
    @edsl::column("course_id")
    course_id: Int,

    @edsl::column("student_course_id")
    @edsl::key()
    @edsl::measure("course_enrolment_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("student_course_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("student_enrolment_id")
    student_enrolment_id: Int,
};

# --- transcripts -----------------------------------------------------------
# A transcript printed on a date.
# Canonical fields: date(0), id(1), other_details(2).
@edsl::entity_id("transcript")
@edsl::entity_source("transcripts", "tr")
type Transcript = struct {
    @edsl::column("transcript_date")
    @edsl::dimension("transcript_date", True, False, [], [])
    date: String,

    @edsl::column("transcript_id")
    @edsl::key()
    @edsl::measure("transcript_count", qb::AggregateFunction::Count, [])
    @edsl::dimension("transcript_id", True, True, num_ops, num_kinds)
    id: Int,

    @edsl::column("other_details")
    @edsl::dimension("transcript_details", True, False, [], [])
    other_details: String,
};

# --- transcript contents ---------------------------------------------------
# One course result appearing on a transcript.
# Canonical fields: student_course_id(0), transcript_id(1).
@edsl::entity_id("transcript_content")
@edsl::entity_source("transcript_contents", "tc")
@edsl::named_typed_relation_key("transcript_content_course", TranscriptContent.type, StudentEnrolmentCourse.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(TranscriptContent.type, Int.type, "student_course_id"), edsl::model_field(StudentEnrolmentCourse.type, Int.type, "id")),
])
@edsl::named_typed_relation_key("transcript_content_transcript", TranscriptContent.type, Transcript.type, edsl::RelationKind::Safe, [
    edsl::typed_relation_pair(edsl::model_field(TranscriptContent.type, Int.type, "transcript_id"), edsl::model_field(Transcript.type, Int.type, "id")),
])
type TranscriptContent = struct {
    @edsl::column("student_course_id")
    @edsl::measure("transcript_content_count", qb::AggregateFunction::Count, [])
    student_course_id: Int,

    @edsl::column("transcript_id")
    transcript_id: Int,
};

# ---------------------------------------------------------------------------
# Profile and prepared payload.
# ---------------------------------------------------------------------------

def profile: qb::PlanProfile = {
    allowed_operators: [
        qb::Operator::Source, qb::Operator::Project, qb::Operator::Column, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Aggregate,
        qb::Operator::Filter, qb::Operator::Exists, qb::Operator::Join, qb::Operator::Group, qb::Operator::Having, qb::Operator::Order,
        qb::Operator::Limit, qb::Operator::Offset,
    ],
    allowed_join_kinds: [qb::JoinKind::Inner, qb::JoinKind::Left],
    allowed_aggregates: [qb::AggregateFunction::Count, qb::AggregateFunction::Sum, qb::AggregateFunction::Avg, qb::AggregateFunction::Min, qb::AggregateFunction::Max],
    allowed_scalars: [
        qb::ScalarFunction::Substr, qb::ScalarFunction::Instr, qb::ScalarFunction::If, qb::ScalarFunction::Add, qb::ScalarFunction::Sub, qb::ScalarFunction::Lower, qb::ScalarFunction::Length,
        qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::And, qb::ScalarFunction::Or, qb::ScalarFunction::Not,
    ],
    allow_distinct: True,
};

def authorize: Fn(String) -> Bool = fn(subject) {
    subject == "public"
};

def entity_types: Array(Type) = [
    Address.type,
    CurrentAddress.type,
    PermanentAddress.type,
    Course.type,
    Department.type,
    DegreeProgram.type,
    Section.type,
    Semester.type,
    Student.type,
    StudentEnrolment.type,
    StudentEnrolmentCourse.type,
    Transcript.type,
    TranscriptContent.type,
];

def payload: edsl::PreparedPayload = edsl::build_root(
    "student-transcripts-tracking-v1",
    entity_types,
    profile,
    authorize,
);

pub use self::{
    Address,
    CurrentAddress,
    PermanentAddress,
    Course,
    Department,
    DegreeProgram,
    Section,
    Semester,
    Student,
    StudentEnrolment,
    StudentEnrolmentCourse,
    Transcript,
    TranscriptContent,
    profile,
    authorize,
    payload,
};
