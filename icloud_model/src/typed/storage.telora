    g::dimension(dataset, g::dimension_group("storage_device__totalCapacity", ReportedCapacity.type, True, g::numeric_filters), g::input(m::field(Row.type, ReportedCapacity.type, "source_totalCapacity")), "storage_device__totalCapacity", True, g::numeric_filters),
