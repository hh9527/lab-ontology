use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 独立 transform 声明；单位、grain 与关系只采用既有公开契约。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::query as qb;
type CatalogId = struct(
    String
);
@registry::entity("device_catalog_entity")
type Identity = struct {
    id: CatalogId
};
@registry::dataset("source_T_DEVICE_ALL", "T_DEVICE_ALL", ["source_ID"])
@registry::roles([subject])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group("ipv4", s::Ipv4.type, True, g::ipv4_filters),
            g::ipv4(g::input(m::field(TDeviceAll.type, String.type, "source_IP"))),
            "source_T_DEVICE_ALL__IP_ipv4",
            True,
            g::ipv4_filters
        ),
    ]
)
type TDeviceAll = struct {
    @m::column("ID")
    @g::exact("source_T_DEVICE_ALL__ID")
    source_ID: CatalogId,
    @m::column("NAME")
    @g::search("source_T_DEVICE_ALL__NAME")
    source_NAME: String,
    @m::column("CATEGORY")
    @v::classification(SourceTDEVICEALLCATEGORY_domain, "source_T_DEVICE_ALL__CATEGORY")
    source_CATEGORY: String,
    @m::column("IP")
    @g::search("source_T_DEVICE_ALL__IP")
    source_IP: String,
    @m::column("MAC")
    @g::search("source_T_DEVICE_ALL__MAC")
    source_MAC: String,
    @m::column("CLASS_NAME")
    @g::exact("source_T_DEVICE_ALL__CLASS_NAME")
    source_CLASS_NAME: String,
};
def dataset: m::Dataset(TDeviceAll) = registry::dataset_of(TDeviceAll.type);
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def subject: m::Role(TDeviceAll) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(TDeviceAll.type, CatalogId.type, "source_ID"),
            m::field(Identity.type, CatalogId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourceTDEVICEALLCATEGORY = enum {
    @ev::rename("STORAGE")
    @ev::description("storage device", "存储设备")
    StorageDevice,
    @ev::rename("FW")
    @ev::description("Firewall", "防火墙")
    Firewall,
    @ev::rename("AR")
    @ev::description("router device", "路由器设备")
    RouterDevice,
    @ev::rename("LSW")
    @ev::description("switch device", "交换机设备")
    SwitchDevice,
    @ev::rename("TianGuan")
    @ev::description("Tian Guan", "天关设备")
    TianGuan,
    @ev::rename("AC")
    @ev::description("AC device", "AC设备")
    AcDevice,
    @ev::rename("AP")
    @ev::description("AP device", "AP设备")
    ApDevice,
    @ev::rename("Collaboration")
    @ev::description("Collaboration device", "协作设备")
    CollaborationDevice,
    @ev::rename("ONU")
    @ev::description("onu device", "ONU设备")
    OnuDevice,
    @ev::rename("OLT")
    @ev::description("OLT device", "OLT设备")
    OltDevice,
    @ev::rename("SPL")
    @ev::description("optical splitter", "SPL分光器设备")
    OpticalSplitter,
    @ev::rename("SERVER")
    @ev::description("server", "服务器")
    Server,
};
def SourceTDEVICEALLCATEGORY_domain: v::Domain(SourceTDEVICEALLCATEGORY, String) = v::from_enum(
    "SourceTDEVICEALLCATEGORY",
    SourceTDEVICEALLCATEGORY.type,
    String.type,
    False
);

pub use self::{TDeviceAll, Identity};
