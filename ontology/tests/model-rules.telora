import "@src/edsl" as edsl;
import "@src/query" as qb;
import "std/test" as test;
import "std/codec" as codec;
import "std/value" { Value };

def partition: Fn(Int) -> edsl.PartitionRequest = fn(take) {
    { by: ["region"], take }
};

export def partition_accepts_bounds = test.should_ok(fn() {
    let low = partition(1);
    let high = partition(qb.max_partition_take);
    if low.take == 1 && high.take == qb.max_partition_take { True }
    else { fail!("partition bounds changed", low, high) }
});

export def partition_rejects_zero = test.should_fail_with(fn() {
    partition(0)
}, "partition take must be a positive integer within the upper bound");

export def partition_rejects_negative = test.should_fail_with(fn() {
    partition(-1)
}, "partition take must be a positive integer within the upper bound");

export def partition_rejects_above_bound = test.should_fail_with(fn() {
    partition(qb.max_partition_take + 1)
}, "partition take must be a positive integer within the upper bound");

export def partition_rejects_empty_groups = test.should_fail_with(fn() {
    let value: edsl.PartitionRequest = { by: [], take: 1 };
    value
}, "partition must name at least one dimension");

export def partition_rechecks_update = test.should_fail_with(fn() {
    let valid = partition(1);
    valid <~ { take: 0 }
}, "partition take must be a positive integer within the upper bound");

export def partition_completes_unchecked = test.should_fail_with(fn() {
    let candidate: Unchecked(edsl.PartitionRequest) = { by: ["region"], take: 0 };
    let value: edsl.PartitionRequest = candidate;
    value
}, "partition take must be a positive integer within the upper bound");

export def partition_codec_roundtrip = test.should_ok(fn() {
    let original = partition(2);
    let encoded = codec.encode(Value.type, original);
    let decoded = codec.decode(edsl.PartitionRequest.type, encoded).unwrap!();
    if decoded == original { True } else { fail!("partition roundtrip mismatch", decoded) }
});

export def partition_decode_rejections = test.with_fixtures([
    "fixtures/partition-zero.json", "fixtures/partition-empty.json",
], fn(input) {
    test.should_ok(fn() {
        match codec.decode(edsl.PartitionRequest.type, input) {
            Err(_) => True,
            Ok(value) => fail!("invalid partition decoded", value),
        }
    })
});
