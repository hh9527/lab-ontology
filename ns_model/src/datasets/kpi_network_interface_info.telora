@registry::metric("ts")
pub type kpi_network_interface_info = struct {
    @m::column("timestamp")
    @g::field_view(
        groups::group_6,
        "nii_sample_time",
        True,
        [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]
    )
    ts: s::DateTimeUtc,
    @g::field_view(
        groups::group_3,
        "nii_obj_id",
        True,
        [g::Filter::Eq, g::Filter::Ne, g::Filter::Gt, g::Filter::Ge, g::Filter::Lt, g::Filter::Le]
