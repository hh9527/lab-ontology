use ontology::registry as registry;
# 保留旧来源的 grain、时钟和公开运算，不从 KPI 名称补造统计能力。
use super::inventory as i;
use super::pon_quantities as p;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::samples as samples;
use ontology::query as qb;
type ResourceId = struct(String);
use ontology::quantity::{EffectiveCount};
@registry::dataset(
    "source_NetworkDeviceBoardKPI",
    "NetworkDeviceBoardKPI",
    ["source_resId", "source_tenantId", "source_ts"]
)
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceBoardKPI__ts",
                s::DateTimeUtc.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkDeviceBoardKPI.type, s::DateTimeUtc.type, "source_ts")),
            "source_NetworkDeviceBoardKPI__ts",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceBoardKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Hour
            ),
            "source_NetworkDeviceBoardKPI_utc_hour",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceBoardKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Day
            ),
            "source_NetworkDeviceBoardKPI_utc_day",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group("utc_bucket", s::DateTimeUtc.type, True, g::time_filters),
            g::utc_bucket(
                g::input(m::field(NetworkDeviceBoardKPI.type, s::DateTimeUtc.type, "source_ts")),
                qb::UtcBucketUnit::Month
            ),
            "source_NetworkDeviceBoardKPI_utc_month",
            True,
            g::time_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceBoardKPI__cpuUsage",
                p::Percent.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkDeviceBoardKPI.type, p::Percent.type, "source_cpuUsage")),
            "source_NetworkDeviceBoardKPI__cpuUsage",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceBoardKPI__memUsage",
                p::Percent.type,
                True,
                g::numeric_filters
            ),
            g::input(m::field(NetworkDeviceBoardKPI.type, p::Percent.type, "source_memUsage")),
            "source_NetworkDeviceBoardKPI__memUsage",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceBoardKPI__hwEntityTemperature",
                p::DegreesCelsius.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkDeviceBoardKPI.type,
                    p::DegreesCelsius.type,
                    "source_hwEntityTemperature"
                )
            ),
            "source_NetworkDeviceBoardKPI__hwEntityTemperature",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceBoardKPI__cpuUsageEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(NetworkDeviceBoardKPI.type, EffectiveCount.type, "source_cpuUsageEffcnt")
            ),
            "source_NetworkDeviceBoardKPI__cpuUsageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceBoardKPI__memUsageEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(NetworkDeviceBoardKPI.type, EffectiveCount.type, "source_memUsageEffcnt")
            ),
            "source_NetworkDeviceBoardKPI__memUsageEffcnt",
            True,
            g::numeric_filters
        ),
        g::dimension(
            dataset,
            g::dimension_group(
                "source_NetworkDeviceBoardKPI__hwEntityTemperatureEffcnt",
                EffectiveCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(
                    NetworkDeviceBoardKPI.type,
                    EffectiveCount.type,
                    "source_hwEntityTemperatureEffcnt"
                )
            ),
            "source_NetworkDeviceBoardKPI__hwEntityTemperatureEffcnt",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::metric("source_ts")
@registry::reported_samples(
    [
        samples::bind(
            dataset,
            p::Percent_statistics,
            m::field(NetworkDeviceBoardKPI.type, p::Percent.type, "source_cpuUsage"),
            [
                {statistic: samples::Statistic::Mean, publish: "board_cpu_usage"},
                {statistic: samples::Statistic::Max, publish: "board_cpu_usage_max"},
                {statistic: samples::Statistic::Min, publish: "board_cpu_usage_min"}
            ]
        ),
        samples::bind(
            dataset,
            p::Percent_statistics,
            m::field(NetworkDeviceBoardKPI.type, p::Percent.type, "source_memUsage"),
            [
                {statistic: samples::Statistic::Mean, publish: "board_memory_usage"},
                {statistic: samples::Statistic::Max, publish: "board_memory_usage_max"},
                {statistic: samples::Statistic::Min, publish: "board_memory_usage_min"}
            ]
        ),
        samples::bind(
            dataset,
            p::DegreesCelsius_statistics,
            m::field(
                NetworkDeviceBoardKPI.type,
                p::DegreesCelsius.type,
                "source_hwEntityTemperature"
            ),
            [
                {statistic: samples::Statistic::Mean, publish: "board_temperature"},
                {statistic: samples::Statistic::Max, publish: "board_temperature_max"},
                {statistic: samples::Statistic::Min, publish: "board_temperature_min"}
            ]
        ),
    ]
)
type NetworkDeviceBoardKPI = struct {
    @m::column("ts")
    source_ts: s::DateTimeUtc,
    @m::column("resId")
    @g::exact("source_NetworkDeviceBoardKPI__resId")
    source_resId: ResourceId,
    @m::column("tenantId")
    @g::exact("source_NetworkDeviceBoardKPI__tenantId")
    source_tenantId: i::TenantId,
    @m::column("parentId")
    @g::exact("source_NetworkDeviceBoardKPI__parentId")
    source_parentId: String,
    @m::column("projectId")
    @g::exact("source_NetworkDeviceBoardKPI__projectId")
    source_projectId: String,
    @m::column("cpuUsage")
    source_cpuUsage: p::Percent,
    @m::column("memUsage")
    source_memUsage: p::Percent,
    @m::column("hwEntityTemperature")
    source_hwEntityTemperature: p::DegreesCelsius,
    @m::column("cpuUsageEffcnt")
    source_cpuUsageEffcnt: EffectiveCount,
    @m::column("memUsageEffcnt")
    source_memUsageEffcnt: EffectiveCount,
    @m::column("hwEntityTemperatureEffcnt")
    source_hwEntityTemperatureEffcnt: EffectiveCount,
};
def dataset: m::Dataset(NetworkDeviceBoardKPI) = registry::dataset_of(NetworkDeviceBoardKPI.type);

pub use self::{NetworkDeviceBoardKPI};
