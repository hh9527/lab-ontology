use crate::model::{ payload };
use ontology::intent::{ query_intent_ast_factory };
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use ontology::query as qb;
use ontology::ontology as edsl;
use std::json as json;
use std::string as string;
use std::test as test;

pub def source_link_status_uses_original_column: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"link","nodes":[{"id":"link","entity":"physical_link"}],
        "edges":[],"select":[],"count":"link",
        "filters":[{"node":"link","dimension":"physical_link_status","op":"Eq","value":"fault"}]
    }"#).unwrap!()));
    if string::contains(query.sql, "link.linkStatus")
        && !string::contains(query.sql, "link.link_status")
        && query.bindings == [qb::Val::Int(2), qb::Val::Int(3)] { True }
    else { fail!("link status lost its original column or typed wires", query) }
});

pub def source_pon_self_relation_keeps_parent_orientation: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"parent","row_grain":"Association",
        "nodes":[{"id":"parent","entity":"pon_device"},{"id":"child","entity":"pon_device"}],
        "edges":[{"relation":"source_EntPonElementAssociationEntPonElement","from":"parent","to":"child"}],
        "select":[{"node":"parent","dimension":"pon_name"},{"node":"child","dimension":"pon_name"}]
    }"#).unwrap!()));
    if string::contains(query.sql, "parent.id = child.parentOltResId") { True }
    else { fail!("source PON parent direction was reversed", query) }
});

pub def source_onu_many_to_many_does_not_claim_sample_safety: test::Test = test::should_fail_with(fn() {
    query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"sample",
        "nodes":[{"id":"sample","entity":"onu_kpi"},{"id":"device","entity":"pon_device"}],
        "edges":[{"relation":"source_EntPonElementAssociationPonDeviceOnuKPI","from":"device","to":"sample"}],
        "select":[{"node":"sample","dimension":"onu_kpi_ts"},{"node":"device","dimension":"pon_name"}]
    }"#).unwrap!())
}, "graph raw projection crosses a multiplying relation");

pub def source_site_or_relation_preserves_device_rows: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"site","entity":"site"}],
        "edges":[{"relation":"device_located_at_site","from":"device","to":"site"}],
        "select":[{"node":"device","dimension":"device_name"},{"node":"site","dimension":"site_name"}]
    }"#).unwrap!()));
    if string::contains(query.sql, "device.projectId = site.SITE_ID")
        && string::contains(query.sql, "device.refParentSubnet = site.SITE_ID")
        && !string::contains(query.sql, "tenantId") { True }
    else { fail!("original M:1 OR relation was changed", query) }
});

pub def source_fan_container_does_not_add_tenant_equality: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"fan",
        "nodes":[{"id":"fan","entity":"server_fan"},{"id":"server","entity":"server_device"}],
        "edges":[{"relation":"fan_parent_server","from":"fan","to":"server"}],
        "select":[{"node":"fan","dimension":"server_fan_name"},{"node":"server","dimension":"server_name"}]
    }"#).unwrap!()));
    if string::contains(query.sql, "fan.parentResId = server.oriResId")
        && !string::contains(query.sql, "tenantId") { True }
    else { fail!("fan parent relation differs from source", query) }
});

pub def newly_published_storage_disk_fields_are_queryable: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"disk","nodes":[{"id":"disk","entity":"source_SYS_StorageDisk"}],
        "edges":[],"select":[{"node":"disk","dimension":"source_SYS_StorageDisk__name"}]
    }"#).unwrap!()));
    if string::contains(query.sql, "SYS_StorageDisk") && string::contains(query.sql, "disk.name") { True }
    else { fail!("new source carrier is not queryable", query) }
});

pub def source_alarm_integer_clock_preserves_wire_value: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"alarm","nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[],"select":[],"count":"alarm",
        "filters":[{"node":"alarm","dimension":"alarm_occur_utc_raw","op":"Ge","value":12345}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if sq.bindings == [qb::Val::Int(12345)] && pg.bindings == sq.bindings
        && string::contains(sq.sql, "alarm.OCCURUTC >= ?1") { True }
    else { fail!("source integer clock was converted", sq, pg) }
});

pub def source_alarm_clock_supports_provisional_millisecond_window: test::Test = test::should_ok(fn() {
    let ast = query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"alarm","nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[],"select":[],"count":"alarm",
        "time_windows":[{"node":"alarm","dimension":"alarm_occur_utc_raw","start":12345,"end":12346}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if sq.bindings == [qb::Val::Int(12345), qb::Val::Int(12346)] && pg.bindings == sq.bindings
        && string::contains(sq.sql, "alarm.OCCURUTC >= ?1")
        && string::contains(sq.sql, "alarm.OCCURUTC < ?2") { True }
    else { fail!("epoch window changed its bounds", sq, pg) }
});

pub def source_severity_binds_integer_canonical_wire: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"alarm","nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[],"select":[],"count":"alarm",
        "filters":[{"node":"alarm","dimension":"alarm_severity","op":"Eq","value":"critical"}]
    }"#).unwrap!()));
    if query.bindings == [qb::Val::Int(1)] && string::contains(query.sql, "alarm.SEVERITY") { True }
    else { fail!("alarm severity lost its integer wire", query) }
});

pub def source_manufacturer_is_open_text: test::Test = test::should_ok(fn() {
    let query = sqlite::build_query(query_intent_ast_factory(payload)(json::parse(r#"{
        "op":"Graph","root":"device","nodes":[{"id":"device","entity":"device"}],
        "edges":[],"select":[],"count":"device",
        "filters":[{"node":"device","dimension":"device_manufacturer","op":"Eq","value":"OtherVendor"}]
    }"#).unwrap!()));
    if query.bindings == [qb::Val::String("OtherVendor")]
        && string::contains(query.sql, "device.manufacturer") { True }
    else { fail!("manufacturer was closed or rewritten", query) }
});

pub def alarm_clock_uses_standard_epoch_encoding: test::Test = test::should_ok(fn() {
    let role = edsl::time_domain(payload, "current_alarm", "occur_utc");
    if role.encoding == edsl::TimeEncoding::EpochMillis
        && edsl::time_logical_type(role) == edsl::TimeLogicalType::EpochMillis { True }
    else { fail!("alarm clock lost epoch milliseconds", role) }
});
