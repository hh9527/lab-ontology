@edsl::entity_source("dense_leaf_2", "l2")
@edsl::relation(DenseHub.type, safe_kind, 0, 0)
@edsl::relation(DenseL3.type, fanout_kind, 0, 0)
type DenseL2 = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_source("dense_leaf_3", "l3")
@edsl::relation(DenseHub.type, safe_kind, 0, 0)
@edsl::relation(DenseL4.type, fanout_kind, 0, 0)
type DenseL3 = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_source("dense_leaf_4", "l4")
@edsl::relation(DenseHub.type, safe_kind, 0, 0)
@edsl::relation(DenseL5.type, fanout_kind, 0, 0)
type DenseL4 = struct {
    @edsl::column("id")
    @edsl::key(flag_true)
    id: Int,
};

@edsl::entity_source("dense_leaf_5", "l5")
@edsl::relation(DenseHub.type, safe_kind, 0, 0)
@edsl::relation(DenseL6.type, fanout_kind, 0, 0)
type DenseL5 = struct {
