def test_related_outer_wrong_base = do {
    let text: String = `{"RelatedExists":{"measures":[{"id":"city_count","mode":"all"}],"dimensions":[],"filters":[],"order":[],"limit":null,"offset":null,"related":{"target":"country_language","filters":[],"min_matches":null},"output_order":[]}}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "rule:") { 'True } else { fail!("non-country related base was not rule") },
        'None => fail!("non-country related base was accepted"),
    }
};

def test_related_outer_wrong_dim = do {
    let text: String = `{"RelatedExists":{"measures":[],"dimensions":[{"id":"country_name"},{"id":"city_name"}],"filters":[],"order":[],"limit":null,"offset":null,"related":{"target":"city","filters":[],"min_matches":null},"output_order":[]}}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "rule:") { 'True } else { fail!("outer dimension from another entity was not rule") },
        'None => fail!("outer dimension from another entity was accepted"),
    }
};

def test_related_outer_wrong_filter = do {
    let text: String = `{"RelatedAbsent":{"measures":[],"dimensions":[{"id":"country_name"}],"filters":[{"id":"language_name","op":"eq","value":"English"}],"order":[],"limit":null,"offset":null,"related":{"target":"city","filters":[],"min_matches":null},"output_order":[]}}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "rule:") { 'True } else { fail!("outer filter from another entity was not rule") },
        'None => fail!("outer filter from another entity was accepted"),
    }
};

def test_related_nonpositive_min_matches = do {
    let text: String = `{"RelatedExists":{"measures":[{"id":"country_count","mode":"all"}],"dimensions":[],"filters":[],"order":[],"limit":null,"offset":null,"related":{"target":"city","filters":[],"min_matches":0},"output_order":[]}}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "rule:") { 'True } else { fail!("non-positive min_matches was not rule") },
        'None => fail!("non-positive min_matches was accepted"),
    }
};

def test_related_absent_no_projection_pollution = do {
    let q = run_text(absent_sum_pop_english_json);
    let ok_proj = contains_literal(q.sql, "SELECT sum(c.Population) AS country_population_sum");
    let no_lang_col = !contains_literal(q.sql, "AS language_name");
    if ok_proj && no_lang_col { 'True } else { fail!("related absent projected an unexpected column") }
};

