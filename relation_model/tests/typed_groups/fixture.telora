use ontology::model as m;
use ontology::groups as g;
use ontology::quantity as q;

type TenantId = struct(String);
type DeviceId = struct(String);
type Category = struct(String);
type Identity = struct { tenant: TenantId, local: DeviceId };
type MillisRow = struct {
    tenant: TenantId, device: Option(DeviceId), seq: Int, name: Option(String), category: Category,
    rx: Option(q::Bytes), tx: q::Bytes, elapsed_ms: Option(q::Milliseconds),
};
type SecondsRow = struct {
    tenant_key: TenantId, device_key: Option(DeviceId), sequence: Int, title: Option(String), kind: Category,
    bytes_in: Option(q::Bytes), bytes_out: q::Bytes, duration_seconds: Option(q::Seconds),
};
def millis: m::Dataset(MillisRow) = m::dataset("millis", "samples_ms", MillisRow.type, ["tenant", "seq"]);
def secs: m::Dataset(SecondsRow) = m::dataset("seconds", "samples_s", SecondsRow.type, ["tenant_key", "sequence"]);
def device: m::Entity(Identity) = m::entity("device", Identity.type);
def millis_role: m::Role(MillisRow) = m::role(millis, device, "subject", True, [
    m::identity_part(m::field(MillisRow.type, TenantId.type, "tenant"), m::field(Identity.type, TenantId.type, "tenant")),
    m::identity_part(m::optional_field(MillisRow.type, DeviceId.type, "device"), m::field(Identity.type, DeviceId.type, "local")),
]);
def seconds_role: m::Role(SecondsRow) = m::role(secs, device, "subject", True, [
    m::identity_part(m::field(SecondsRow.type, TenantId.type, "tenant_key"), m::field(Identity.type, TenantId.type, "tenant")),
    m::identity_part(m::optional_field(SecondsRow.type, DeviceId.type, "device_key"), m::field(Identity.type, DeviceId.type, "local")),
]);
def names: Fn(String) -> Array(g::Rename) = fn(prefix) { [
    {member: g::TransferMember::AmountTotal, publish: `\{prefix}_total`},
    {member: g::TransferMember::RatePeak, publish: `\{prefix}_peak`},
    {member: g::TransferMember::RateMean, publish: `\{prefix}_mean`},
] };
def label: g::DimensionGroup(String) = g::dimension_group("label", String.type, True, [g::Filter::Eq, g::Filter::Contains]);
def category: g::DimensionGroup(Category) = g::dimension_group("category", Category.type, True, [g::Filter::Eq]);
def ms_amount: g::Expr(MillisRow, q::Bytes) = g::input(m::optional_field(MillisRow.type, q::Bytes.type, "rx"));
def ms_duration: g::Expr(MillisRow, q::Seconds) = g::seconds(g::input(m::optional_field(MillisRow.type, q::Milliseconds.type, "elapsed_ms")));
def ms_rx: g::Binding(MillisRow) = g::transfer_binding(millis, g::transfer, ms_amount, ms_duration, names("rx"));
def ms_tx: g::Binding(MillisRow) = g::transfer_binding(millis, g::transfer,
    g::input(m::field(MillisRow.type, q::Bytes.type, "tx")), ms_duration, names("tx"));
def s_rx: g::Binding(SecondsRow) = g::transfer_binding(secs, g::transfer,
    g::input(m::optional_field(SecondsRow.type, q::Bytes.type, "bytes_in")),
    g::input(m::optional_field(SecondsRow.type, q::Seconds.type, "duration_seconds")), names("rx"));
def s_tx: g::Binding(SecondsRow) = g::transfer_binding(secs, g::transfer,
    g::input(m::field(SecondsRow.type, q::Bytes.type, "bytes_out")),
    g::input(m::optional_field(SecondsRow.type, q::Seconds.type, "duration_seconds")), names("tx"));
def ms_label: g::Binding(MillisRow) = g::dimension(millis, label,
    g::input(m::optional_field(MillisRow.type, String.type, "name")), "label", True, [g::Filter::Eq]);
def s_label: g::Binding(SecondsRow) = g::dimension(secs, label,
    g::input(m::optional_field(SecondsRow.type, String.type, "title")), "label", True, [g::Filter::Eq]);
def ms_category: g::Binding(MillisRow) = g::dimension(millis, category,
    g::input(m::field(MillisRow.type, Category.type, "category")), "category", True, [g::Filter::Eq]);
def s_category: g::Binding(SecondsRow) = g::dimension(secs, category,
    g::input(m::field(SecondsRow.type, Category.type, "kind")), "category", True, [g::Filter::Eq]);
def identity_names: Array(g::IdentityName) = [{member: "tenant", publish: "tenant_id"}, {member: "local", publish: "device_id"}];
def ms_identity: g::Binding(MillisRow) = g::identity_dimensions(millis, millis_role, identity_names);
def s_identity: g::Binding(SecondsRow) = g::identity_dimensions(secs, seconds_role, identity_names);

pub use self::{TenantId, DeviceId, Category, Identity, MillisRow, SecondsRow, millis, secs, device,
    millis_role, seconds_role, names, label, category, ms_amount, ms_duration, ms_rx, ms_tx, s_rx, s_tx,
    ms_label, s_label, ms_category, s_category, identity_names, ms_identity, s_identity};
