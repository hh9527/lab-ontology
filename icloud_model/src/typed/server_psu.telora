use ontology::quantity as q;
use super::classifications as classes;
use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# ServerPsu独立声明，部件主身份与来源父资源角色分开
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
type ComponentId = struct(String);
@domain::entity_by("ServerPsu")
type ServerPsuById = struct(ComponentId);
@domain::subject("ServerPsu", "id")
@g::groupable(["server_psu_health", "server_psu__redundancyMode", "server_psu__workMode"])
@domain::record_counts(["server_psu_count"])
@r::sources("psu_parent_server", ["source_PhysicalServer_PhysicalServerPSU"])
@r::sources("psu_belongs_to_tenant", ["source_PhysicalServerPSU_X_TENANT_VIEW"])
@domain::dataset("server_psu", "PhysicalServerPSU", ["id"])
@domain::relations(relations)
@v::computed(
    "server_psu__redundancyMode",
    "source_redundancyMode",
    classes::RedundancyMode.type,
    [
        v::member(classes::RedundancyMode::NPlusOne, ["N+1"]),
        v::member(classes::RedundancyMode::NPlusN, ["N+N"])
    ],
    classes::RedundancyMode::Unknown
)
@v::computed(
    "server_psu__workMode",
    "source_workMode",
    classes::PowerWorkMode.type,
    [
        v::member(classes::PowerWorkMode::Active, ["主用"]),
        v::member(classes::PowerWorkMode::Standby, ["备用"])
    ],
    classes::PowerWorkMode::Unknown
)
type PhysicalServerPSU = struct {
    id: ServerPsuById,
    @m::column("parentResId")
    parent_res_id: domain::Reference(server::ServerByOriginId),
    @m::column("tenantId")
    tenant_id: domain::Reference(i::TenantById),
    @g::search("server_psu_manufacturer")
    manufacturer: String,
    @m::column("healthStatus")
    @g::exact("server_psu_health")
    health_status: ServerPsuHealth,
    @m::column("name")
    @g::search("server_psu__name")
    @edsl::field_role(edsl::FieldRole::Appellation)
    source_name: String,
    @m::column("redundancyMode")
    @g::exact("server_psu__redundancyMode_raw")
    source_redundancyMode: String,
    @m::column("workMode")
    @g::exact("server_psu__workMode_raw")
    source_workMode: String,
    @m::column("ratedPower")
    @g::view("server_psu__ratedPower", True, g::numeric_filters)
    source_ratedPower: q::IntegerWatts,
    @m::column("sn")
    @g::search("server_psu__sn")
    source_sn: String,
    @m::column("slotId")
    @g::view("server_psu__slotId", True, g::numeric_filters)
    source_slotId: Int,
    @m::column("psuName")
    @g::search("server_psu__psuName")
    source_psuName: String,
    @m::column("projectId")
    @g::exact("server_psu__projectId")
    source_projectId: String,
    @m::column("resId")
    @g::exact("server_psu__resId")
    source_resId: String,
};

def subject: r::Endpoint = domain::endpoint(PhysicalServerPSU.type, "id");
def parent: r::Endpoint = domain::endpoint(PhysicalServerPSU.type, "parent_res_id");
def tenant: r::Endpoint = domain::endpoint(PhysicalServerPSU.type, "tenant_id");
@knowledge_policy::reverse_references(True)
type ServerPsuHealth = enum {
    @ev::description("unknown", "未知")
    @ev::itag(-2)
    Unknown,
    @ev::description("warning", "警告")
    @ev::itag(1)
    Warning,
    @ev::description("normal", "正常")
    @ev::itag(0)
    Normal,
    @ev::description("minor", "一般")
    @ev::itag(2)
    Minor,
    @ev::description("major", "严重")
    @ev::itag(3)
    Major,
    @ev::description("critical", "紧急")
    @ev::itag(4)
    Critical,
    @ev::description("error", "错误")
    @ev::itag(-1)
    Error,
};

def tenant_cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "psu_parent_server",
        parent,
        server::origin,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
    r::relation(
        "psu_belongs_to_tenant",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{PhysicalServerPSU, ServerPsuById};

pub use self::{ServerPsuHealth};
