# canonical indices: cpu_usage_avg=0, cpu_usage_max=1, if_utilization_avg=2,
# mem_usage_avg=3, mem_usage_max=4, online_rate_avg=5, port_count_sum=6,
# port_used_count_sum=7, res_id=8, ts=9
