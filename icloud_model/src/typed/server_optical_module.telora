use ontology::registry as registry;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# 服务器组件来源：parent 使用服务器原始身份，不以服务 ID 替代。
use super::inventory as i;
use super::server as server;
use ontology::model as m;
use ontology::groups as g;
use ontology::scalars as s;
use ontology::values as v;
use ontology::relations as r;
use ontology::transform as t;
use ontology::ontology as edsl;
type ComponentId = struct(
    String
);
@registry::entity("server_optical_module_entity")
type Identity = struct {
    id: ComponentId
};
type ChannelCount = struct(
    Int
);
@registry::dataset(
    "source_PhysicalServerOpticalModule",
    "PhysicalServerOpticalModule",
    ["source_id"]
)
@registry::roles([subject, tenant, parent])
@registry::groups(
    [
        g::dimension(
            dataset,
            g::dimension_group(
                "source_PhysicalServerOpticalModule__channelNum",
                ChannelCount.type,
                True,
                g::numeric_filters
            ),
            g::input(
                m::field(PhysicalServerOpticalModule.type, ChannelCount.type, "source_channelNum")
            ),
            "source_PhysicalServerOpticalModule__channelNum",
            True,
            g::numeric_filters
        ),
    ]
)
@registry::relations(relations)
type PhysicalServerOpticalModule = struct {
    @m::column("name")
    @g::search("source_PhysicalServerOpticalModule__name")
    source_name: String,
    @m::column("tenantId")
    @g::exact("source_PhysicalServerOpticalModule__tenantId")
    source_tenantId: i::TenantId,
    @m::column("id")
    @g::exact("source_PhysicalServerOpticalModule__id")
    source_id: ComponentId,
    @m::column("partNumber")
    @g::search("source_PhysicalServerOpticalModule__partNumber")
    source_partNumber: String,
    @m::column("channelNum")
    source_channelNum: ChannelCount,
    @m::column("portResId")
    @g::exact("source_PhysicalServerOpticalModule__portResId")
    source_portResId: String,
    @m::column("cardResId")
    @g::exact("source_PhysicalServerOpticalModule__cardResId")
    source_cardResId: String,
    @m::column("serialNumber")
    @g::search("source_PhysicalServerOpticalModule__serialNumber")
    source_serialNumber: String,
    @m::column("operStatus")
    @v::classification(
        SourcePhysicalServerOpticalModuleOperStatus_domain,
        "source_PhysicalServerOpticalModule__operStatus"
    )
    source_operStatus: String,
    @m::column("adminStatus")
    @g::exact("source_PhysicalServerOpticalModule__adminStatus")
    source_adminStatus: String,
    @m::column("transType")
    @g::exact("source_PhysicalServerOpticalModule__transType")
    source_transType: String,
    @m::column("vendorSn")
    @g::search("source_PhysicalServerOpticalModule__vendorSn")
    source_vendorSn: String,
    @m::column("vendorName")
    @g::search("source_PhysicalServerOpticalModule__vendorName")
    source_vendorName: String,
    @m::column("neResId")
    @g::exact("source_PhysicalServerOpticalModule__neResId")
    source_neResId: server::ServerOriginId,
    @m::column("projectId")
    @g::exact("source_PhysicalServerOpticalModule__projectId")
    source_projectId: String,
    @m::column("ifName")
    @g::search("source_PhysicalServerOpticalModule__ifName")
    source_ifName: String,
};
def entity: m::Entity(Identity) = registry::entity_of(Identity.type);
def dataset: m::Dataset(PhysicalServerOpticalModule) = registry::dataset_of(
    PhysicalServerOpticalModule.type
);
def subject: m::Role(PhysicalServerOpticalModule) = m::role(
    dataset,
    entity,
    "subject",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerOpticalModule.type, ComponentId.type, "source_id"),
            m::field(Identity.type, ComponentId.type, "id")
        )
    ]
);
def tenant: m::Role(PhysicalServerOpticalModule) = m::role(
    dataset,
    i::tenant,
    "tenant",
    False,
    [
        m::identity_part(
            m::field(PhysicalServerOpticalModule.type, i::TenantId.type, "source_tenantId"),
            m::field(i::TenantIdentity.type, i::TenantId.type, "id")
        )
    ]
);
def parent: m::Role(PhysicalServerOpticalModule) = m::role(
    dataset,
    server::origin_entity,
    "server_origin",
    False,
    [
        m::identity_part(
            m::field(
                PhysicalServerOpticalModule.type,
                server::ServerOriginId.type,
                "source_neResId"
            ),
            m::field(server::OriginIdentity.type, server::ServerOriginId.type, "id")
        )
    ]
);

@knowledge_policy::reverse_references(True)
type SourcePhysicalServerOpticalModuleOperStatus = enum {
    @ev::rename("OK")
    @ev::description("normal", "正常")
    Normal,
    @ev::rename("Warning")
    @ev::description("warning", "警告")
    Warning,
    @ev::rename("Critical")
    @ev::description("critical", "紧急")
    Critical,
    @ev::rename("Unknown")
    @ev::description("unknown", "未知")
    Unknown,
};
def SourcePhysicalServerOpticalModuleOperStatus_domain: v::Domain(
    SourcePhysicalServerOpticalModuleOperStatus,
    String
) = v::from_enum(
    "SourcePhysicalServerOpticalModuleOperStatus",
    SourcePhysicalServerOpticalModuleOperStatus.type,
    String.type,
    False
);
def declaration: t::Declaration = registry::declaration(PhysicalServerOpticalModule.type);
def cardinality: edsl::RelationCardinality = {
    from: edsl::Cardinality::Optional,
    to: edsl::Cardinality::Many0
};
def relations: Array(r::Relation) = [
    r::relation(
        "source_PhysicalServer_PhysicalServerOpticalModule",
        server::dataset,
        server::origin,
        dataset,
        parent,
        cardinality
    ),
    r::relation(
        "source_PhysicalServerOpticalModule_X_TENANT_VIEW",
        dataset,
        tenant,
        i::tenants,
        i::tenant_subject,
        cardinality
    ),
];
pub use self::{declaration, relations};

pub use self::{PhysicalServerOpticalModule, Identity};
