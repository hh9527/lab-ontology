use ontology::semantic as domain;
use ontology::enum_values as ev;
use ontology::knowledge_policy as knowledge_policy;
# NetworkSlot独立声明，保留源可空性和已声明粒度
use super::inventory as i;
use super::frame as frame;
use ontology::model as m;
use ontology::groups as g;
use ontology::relations as r;
use ontology::ontology as edsl;
type SlotId = struct(String);
@domain::entity_by("NetworkSlot")
type NetworkSlotById = struct(SlotId);

@domain::subject("NetworkSlot", "id")
@g::groupable(["network_slot__adminstatus", "network_slot__operstatus"])
@domain::dataset("network_slot", "EnterpriseSlot", ["id"])
@domain::record_counts(["slot_count"])
@domain::relations(relations)
type IEnterpriseSlot = struct {
    @g::exact("slot_id")
    id: NetworkSlotById,
    @g::search("slot_name")
    @edsl::field_role(edsl::FieldRole::Appellation)
    name: String,
    @m::column("isDaughterCard")
    @g::view("slot_is_daughter_card", True, g::equality_filters)
    is_daughter_card: Bool,
    @m::column("productName")
    @g::search("network_slot__productName")
    source_productName: String,
    @m::column("frameNativeId")
    @g::exact("network_slot__frameNativeId")
    source_frameNativeId: domain::Reference(frame::FrameByDn),
    @m::column("manufacturer")
    @g::search("network_slot__manufacturer")
    source_manufacturer: String,
    @m::column("hardVersion")
    @g::search("network_slot__hardVersion")
    source_hardVersion: String,
    @m::column("softVersion")
    @g::search("network_slot__softVersion")
    source_softVersion: String,
    @m::column("sn")
    @g::search("network_slot__sn")
    source_sn: String,
    @m::column("tenantId")
    @g::exact("network_slot__tenantId")
    source_tenantId: domain::Reference(i::TenantById),
    @m::column("refParentNE")
    @g::exact("network_slot__refParentNE")
    source_refParentNE: domain::Reference(i::DeviceById),
    @m::column("operstatus")
    @g::exact("network_slot__operstatus")
    source_operstatus: NetworkSlotOperstatus,
    @m::column("adminstatus")
    @g::exact("network_slot__adminstatus")
    source_adminstatus: NetworkSlotAdminstatus,
    @m::column("projectId")
    @g::exact("network_slot__projectId")
    source_projectId: String,
};
def subject: r::Endpoint = domain::endpoint(IEnterpriseSlot.type, "id");
def tenant: r::Endpoint = domain::endpoint(IEnterpriseSlot.type, "source_tenantId");
def frame_reference: r::Endpoint = domain::endpoint(IEnterpriseSlot.type, "source_frameNativeId");

@knowledge_policy::reverse_references(True)
type NetworkSlotOperstatus = enum {
    @ev::description("normal", "正常")
    @ev::itag(3)
    @ev::alias(11)
    @ev::alias(13)
    @ev::alias(15)
    @ev::alias(16)
    Normal,
    @ev::description("faulty", "故障")
    @ev::itag(2)
    @ev::alias(5)
    @ev::alias(12)
    @ev::alias(17)
    Faulty,
    @ev::description("offline", "离线")
    @ev::itag(4)
    Offline,
    @ev::description("unknow", "未知")
    @ev::itag(1)
    @ev::alias(-1)
    Unknown,
};

@knowledge_policy::reverse_references(True)
type NetworkSlotAdminstatus = enum {
    @ev::description("normal", "正常")
    @ev::itag(4)
    @ev::alias(11)
    Normal,
    @ev::description("faulty", "故障")
    @ev::itag(2)
    @ev::alias(3)
    @ev::alias(12)
    Faulty,
    @ev::description("loopback", "回环")
    @ev::itag(13)
    Loopback,
    @ev::description("unknow", "未知")
    @ev::itag(1)
    @ev::alias(-1)
    Unknown,
};

def relations: Array(r::Relation) = [
    r::relation(
        "source_EntNetworkElement_EnterpriseSlot",
        i::device_subject,
        domain::endpoint(IEnterpriseSlot.type, "source_refParentNE"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EnterpriseFrame_EnterpriseSlot",
        frame::frame_reference,
        frame_reference,
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EnterpriseSlot_X_TENANT_VIEW",
        tenant,
        i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}
    ),
];
pub use self::{relations};

pub use self::{IEnterpriseSlot, NetworkSlotById};

pub use self::{NetworkSlotOperstatus, NetworkSlotAdminstatus};
