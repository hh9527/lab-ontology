use ontology::relations as r;
use ontology::ontology as edsl;
use super::port as port;
use ontology::semantic as domain;
use ontology::groups as g;
# 网络光模块按 corpus MD-2 的 id 标识；设备与端口名仍仅用于关联。
use super::inventory as i;
use ontology::model as m;
@domain::entity_by("NetworkOpticalModule")
type NetworkOpticalModuleById = struct(String);
@domain::subject("NetworkOpticalModule", "source_id")
@domain::record_counts(["network_optical_module_count"])
@domain::dataset("source_EnterpriseOpticalModule", "I_EnterpriseOpticalModule", ["source_id"])
@domain::relations(source_relations)
@domain::role(
    "port_reference",
    port::PortByDeviceAndName.type,
    {device: "source_neResId", name: "source_ifName"}
)
type IEnterpriseOpticalModule = struct {
    @m::column("id")
    @g::exact("network_optical_module_id")
    source_id: NetworkOpticalModuleById,
    @m::column("tenantId")
    @g::exact("network_optical_module_tenant_id")
    source_tenantId: Option(domain::Reference(i::TenantById)),
    @m::column("neResId")
    @g::exact("source_EnterpriseOpticalModule__neResId")
    source_neResId: domain::Reference(i::DeviceById),
    @m::column("version")
    @g::search("source_EnterpriseOpticalModule__version")
    source_version: String,
    @m::column("vendorPn")
    @g::search("source_EnterpriseOpticalModule__vendorPn")
    source_vendorPn: String,
    @m::column("vendorName")
    @g::search("source_EnterpriseOpticalModule__vendorName")
    source_vendorName: String,
    @m::column("vendorSn")
    @g::search("source_EnterpriseOpticalModule__vendorSn")
    source_vendorSn: String,
    @m::column("ifName")
    @g::search("source_EnterpriseOpticalModule__ifName")
    source_ifName: String,
    @m::column("projectId")
    @g::exact("source_EnterpriseOpticalModule__projectId")
    source_projectId: String,
};

pub use self::{IEnterpriseOpticalModule};

def source_relations: Array(r::Relation) = [
    r::relation("source_EnterpriseOpticalModule_X_TENANT_VIEW",
        domain::endpoint(IEnterpriseOpticalModule.type, "source_tenantId"), i::tenant_subject,
        {from: edsl::Cardinality::Many0, to: edsl::Cardinality::Optional}),
    r::relation(
        "source_EntNetworkElement_EnterpriseOpticalModule",
        i::device_subject,
        domain::endpoint(IEnterpriseOpticalModule.type, "source_neResId"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}
    ),
    r::relation(
        "source_EnterpriseNetworkLTP_EnterpriseOpticalModule",
        domain::endpoint(port::IEnterpriseNetworkLTP.type, "device_and_name"),
        domain::endpoint(IEnterpriseOpticalModule.type, "port_reference"),
        {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}
    )
];
