# Time inputs are normalized against the Model's logical time role before binding.
use crate::ontology as edsl;
use std::array as array;
use std::string as string;

type TimeValue = enum {
    Date(String),
    LocalDateTime(String),
    UtcSecond(String),
    Rfc3339(String),
    EpochMillis(Int),
};

type Window = struct { start: TimeValue, end: TimeValue };

type RequestContext = struct { now: Int, tz: Option(Int) };

def request_context: Fn(Int, Option(Int)) -> RequestContext = fn(now, tz) {
    match tz {
        Some(minutes) => if minutes < -840 || minutes > 840 {
            fail!("request timezone offset must be within +/-840 minutes", minutes)
        } else { {now, tz} },
        None => {now, tz},
    }
};

def pad2: Fn(Int) -> String = fn(n) { if n < 10 { `0\{n}` } else { `\{n}` } };
def pad4: Fn(Int) -> String = fn(n) {
    if n < 10 { `000\{n}` } else if n < 100 { `00\{n}` }
    else if n < 1000 { `0\{n}` } else { `\{n}` }
};

# Civil-from-days uses a proleptic Gregorian calendar, anchored at 1970-01-01.
def utc_second_parts: Fn(Int) -> String = fn(seconds) {
    let day = seconds / 86400 - if seconds % 86400 < 0 { 1 } else { 0 };
    let clock = seconds - day * 86400;
    let shifted = day + 719468;
    let era = shifted / 146097 - if shifted % 146097 < 0 { 1 } else { 0 };
    let doe = shifted - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let year0 = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day_of_month = doy - (153 * mp + 2) / 5 + 1;
    let month = if mp < 10 { mp + 3 } else { mp - 9 };
    let year = year0 + if month <= 2 { 1 } else { 0 };
    if year < 1 || year > 9999 { fail!("request time is outside the supported four-digit UTC year range", seconds) }
    else { `\{pad4(year)}-\{pad2(month)}-\{pad2(day_of_month)} \{pad2(clock / 3600)}:\{pad2(clock % 3600 / 60)}:\{pad2(clock % 60)}` }
};

def now_seconds: Fn(Int, edsl::FilterOp) -> Int = fn(ms, op) {
    let floor = ms / 1000 - if ms < 0 && ms % 1000 != 0 { 1 } else { 0 };
    let ceil = floor + if ms % 1000 != 0 { 1 } else { 0 };
    match op {
        edsl::FilterOp::Ge => ceil,
        edsl::FilterOp::Lt => ceil,
        edsl::FilterOp::Gt => floor,
        edsl::FilterOp::Le => floor,
        edsl::FilterOp::Eq => if ms % 1000 == 0 { floor }
            else { fail!("millisecond instant cannot be compared for equality with a second-resolution field", ms) },
        edsl::FilterOp::Ne => if ms % 1000 == 0 { floor }
            else { fail!("millisecond instant cannot be compared for equality with a second-resolution field", ms) },
        _ => fail!("now requires a time comparison operator", op),
    }
};

def now_for_op: Fn(RequestContext, edsl::TimeField, edsl::FilterOp) -> TimeValue = fn(context, role, op) {
    match role.encoding {
        edsl::TimeEncoding::UtcEpochMillis => TimeValue::EpochMillis(context.now),
        edsl::TimeEncoding::LocalEpochMillis => TimeValue::EpochMillis(context.now),
        edsl::TimeEncoding::CanonicalUtcSecondText => TimeValue::UtcSecond(utc_second_parts(now_seconds(context.now, op))),
        edsl::TimeEncoding::Rfc3339Text => do {
            let text = utc_second_parts(now_seconds(context.now, op));
            let parts = string::split(text, " ");
            TimeValue::Rfc3339(`\{parts[0]}T\{parts[1]}Z`)
        },
        _ => fail!("now cannot be used with this time field encoding", role.encoding),
    }
};

def now_for: Fn(RequestContext, edsl::TimeField) -> TimeValue = fn(context, role) {
    now_for_op(context, role, edsl::FilterOp::Ge)
};

def now_filter: Fn(RequestContext, edsl::TimeField, edsl::FilterOp, String) -> edsl::FilterInput =
    fn(context, role, op, dimension) { input(role, now_for_op(context, role, op), dimension) };

def input: Fn(edsl::TimeField, TimeValue, String) -> edsl::FilterInput = fn(role, value, dimension) {
    match (role.encoding, value) {
        (edsl::TimeEncoding::DateText, TimeValue::Date(text)) =>
            if edsl::calendar_date(text) { edsl::FilterInput::Date(text) }
            else { fail!("invalid calendar date boundary", dimension, text) },
        (edsl::TimeEncoding::Rfc3339Text, TimeValue::Rfc3339(text)) =>
            if edsl::canonical_rfc3339(text) { edsl::FilterInput::Rfc3339(text) }
            else { fail!("invalid canonical RFC3339 UTC second value", dimension, text) },
        (edsl::TimeEncoding::CanonicalUtcSecondText, TimeValue::UtcSecond(text)) =>
            if edsl::canonical_utc_second(text) { edsl::FilterInput::UtcSecond(text) }
            else { fail!("invalid canonical UTC second boundary", dimension, text) },
        (edsl::TimeEncoding::UtcEpochMillis, TimeValue::EpochMillis(ms)) =>
            edsl::FilterInput::EpochMillis(ms),
        (edsl::TimeEncoding::LocalEpochMillis, TimeValue::EpochMillis(ms)) =>
            edsl::FilterInput::EpochMillis(ms),
        (edsl::TimeEncoding::LocalText, TimeValue::LocalDateTime(text)) =>
            if edsl::canonical_utc_second(text) { edsl::FilterInput::LocalDateTime(text) }
            else { fail!("invalid local datetime boundary", dimension, text) },
        _ => fail!("time boundary does not match declared field encoding", dimension, role, value),
    }
};

def before: Fn(TimeValue, TimeValue, String) -> Bool = fn(start, end, dimension) {
    match (start, end) {
        (TimeValue::EpochMillis(a), TimeValue::EpochMillis(b)) => a < b,
        (TimeValue::UtcSecond(a), TimeValue::UtcSecond(b)) => a < b,
        (TimeValue::Rfc3339(a), TimeValue::Rfc3339(b)) => a < b,
        (TimeValue::Date(a), TimeValue::Date(b)) => if edsl::calendar_date(a) && edsl::calendar_date(b) { a < b }
            else { fail!("invalid calendar date boundary", dimension, a, b) },
        # A local clock cannot be compared across daylight-saving transitions
        # without a zone and ambiguity policy supplied by the caller.
        (TimeValue::LocalDateTime(_), TimeValue::LocalDateTime(_)) =>
            fail!("local time window requires externally resolved instant boundaries", dimension),
        _ => fail!("time window boundaries have different logical types", dimension, start, end),
    }
};

def window_filters: Fn(edsl::PreparedPayload, String, String, Window) -> Array(edsl::FilterRequest) =
    fn(payload, subject, dimension, window) {
        let detail = edsl::dimension_detail_for_subject(payload, subject, dimension);
        if !detail.filterable || !array::any(detail.ops, fn(op) { op == edsl::FilterOp::Ge })
            || !array::any(detail.ops, fn(op) { op == edsl::FilterOp::Lt }) {
            fail!("time dimension does not support half-open range filters", dimension)
        } else {
            let role = edsl::time_domain(payload, detail.dataset, detail.field);
            let start = input(role, window.start, dimension);
            let end = input(role, window.end, dimension);
            if !before(window.start, window.end, dimension) {
                fail!("time window start must precede end", dimension, window)
            } else {
                [{id: dimension, subject, op: edsl::FilterOp::Ge, input: start},
                 {id: dimension, subject, op: edsl::FilterOp::Lt, input: end}]
            }
        }
    };

pub use self::{TimeValue, Window, RequestContext, request_context, now_for, now_filter, window_filters};
