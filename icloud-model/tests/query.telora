type ValidTarget = struct {
    @edsl::column("id")
    @edsl::key(yes)
    id: Int,
    @edsl::column("label")
    label: Int,
};

@edsl::entity_source("bad_measure_note", "bmn")
type BadMeasureNote = struct {
    @edsl::column("id")
    @edsl::key(yes)
    @edsl::measure_description("missing_count", "Missing count", "No matching measure")
    id: Int,
};

pub def orphan_measure_description_is_model_error: test::Test = test::should_fail_with(fn() {
    edsl::build_root("bad-measure-note-v1", [BadMeasureNote.type],
        { allowed_operators: [qb::Operator::Source], allowed_join_kinds: [],
          allowed_aggregates: [], allowed_scalars: [], allow_distinct: False },
        fn(subject) { subject == "public" })
}, "measure description must name one measure on its field");

