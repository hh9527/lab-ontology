pub def empty_count_keeps_child_entity_scope_inside_source: test::Test = test::should_ok(fn() {
    let ast = lower_count_grain(json::parse(r#"{
        "op":"graph", "root":"tenant", "nodes":[{"id":"tenant","entity":"tenant"},{"id":"reading","entity":"scoped_reading"}],
        "edges":[{"relation":"scoped_reading_tenant","from":"reading","to":"tenant"}],
        "select":[{"node":"tenant","dimension":"tenant_id"}], "count":"reading", "include_empty":true,
        "filters":[{"node":"tenant","dimension":"tenant_id","op":"eq","kind":"text","value":"tenant-1"}]
    }"#).unwrap!());
    let sq = sqlite::build_query(ast);
    let pg = postgres::build_query(ast);
    if string::contains(sq.sql, "LEFT JOIN (SELECT * FROM scoped_readings AS reading WHERE reading.classification = ?1) AS reading")
        && string::contains(sq.sql, "WHERE tenant.id = ?2")
        && string::contains(pg.sql, "LEFT JOIN (SELECT * FROM \"scoped_readings\" AS \"reading\" WHERE \"reading\".\"classification\" = $1) AS \"reading\"")
        && sq.bindings == [qb::Val::String("active"), qb::Val::String("tenant-1")]
        && pg.bindings == sq.bindings {
        True
    } else { fail!("child source scope escaped the nullable LEFT JOIN", sq, pg) }
});

