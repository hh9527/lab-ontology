# First member has one wire; later members must still contribute capabilities.
@edsl::value_type("Domain", String.type, [
    {id: "One", label: "One", wires: [edsl::FilterInput::Text("one")]},
    {id: "Two", label: "Two", wires: [edsl::FilterInput::Text("two"), edsl::FilterInput::Text("second")]},
])
type ClosedDomain = struct {};
@edsl::value_type("OpenDomain", String.type, [
    {id: "One", label: "One", wires: [edsl::FilterInput::Text("one")]},
    {id: "Two", label: "Two", wires: [edsl::FilterInput::Text("two"), edsl::FilterInput::Text("second")]},
]) @edsl::half_open()
type OpenDomain = struct {};

@edsl::entity_id("fixture") @edsl::entity_source("fixture", "f")
type ClosedEq = struct {
    @edsl::column("value") @edsl::dimension_type(ClosedDomain.type)
    @edsl::dimension("value", True, True, [edsl::FilterOp::Eq], [edsl::FilterInputKind::Text]) value: String,
};
pub def ClosedEq_checks_later_multiwire_values: test::Test = test::should_ok(fn() {
    accepts(ClosedEq.type, profile) && !accepts(ClosedEq.type, {...profile,
        allowed_scalars: array::filter(profile.allowed_scalars, fn(op) { op != qb::ScalarFunction::Or })})
});

@edsl::entity_id("fixture") @edsl::entity_source("fixture", "f")
type ClosedNe = struct {
    @edsl::column("value") @edsl::dimension_type(ClosedDomain.type)
    @edsl::dimension("value", True, True, [edsl::FilterOp::Ne], [edsl::FilterInputKind::Text]) value: String,
};
pub def ClosedNe_checks_later_multiwire_values: test::Test = test::should_ok(fn() {
    accepts(ClosedNe.type, profile) && !accepts(ClosedNe.type, {...profile,
        allowed_scalars: array::filter(profile.allowed_scalars, fn(op) { op != qb::ScalarFunction::Or })})
});

