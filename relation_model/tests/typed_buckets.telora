use ontology::experimental::model as m;
use ontology::experimental::groups as g;
use ontology::experimental::scalars as s;
use ontology::experimental::transform as t;
use ontology::ontology as edsl;
use ontology::intent as intent;
use ontology::query as qb;
use ontology::sqlite as sqlite;
use ontology::postgres as postgres;
use std::array as array;
use std::codec as codec;
use std::json as json;
use std::value::{Value};
use std::test as test;

type Row = struct { seq: Int, epoch: Option(s::EpochMillis), utc: Option(s::Rfc3339Utc), date: Option(s::DateUtc), local: s::LocalEpochMillis };
def rows: m::Dataset(Row) = m::dataset("buckets", "bucket_rows", Row.type, ["seq"]);
def epoch: g::Expr(Row, s::EpochMillis) = g::input(m::optional_field(Row.type, s::EpochMillis.type, "epoch"));
def utc: g::Expr(Row, s::Rfc3339Utc) = g::input(m::optional_field(Row.type, s::Rfc3339Utc.type, "utc"));
def date: g::Expr(Row, s::DateUtc) = g::input(m::optional_field(Row.type, s::DateUtc.type, "date"));
def declared: t::Declaration = t::map_columns(t::declare(rows, [], [
    g::dimension(rows, g::dimension_group("seq", Int.type, True, []), g::input(m::field(Row.type, Int.type, "seq")), "seq", True, []),
    g::dimension(rows, g::dimension_group("epoch", s::EpochMillis.type, True, g::time_filters), g::utc_bucket(epoch, qb::UtcBucketUnit::Day), "epoch_day", True, g::time_filters),
    g::dimension(rows, g::dimension_group("epoch", s::EpochMillis.type, True, g::time_filters), g::utc_bucket(epoch, qb::UtcBucketUnit::Month), "epoch_month", True, g::time_filters),
    g::dimension(rows, g::dimension_group("utc", s::Rfc3339Utc.type, True, g::time_filters), g::utc_bucket(utc, qb::UtcBucketUnit::Hour), "utc_hour", True, g::time_filters),
    g::dimension(rows, g::dimension_group("utc", s::Rfc3339Utc.type, True, g::time_filters), g::utc_bucket(utc, qb::UtcBucketUnit::Day), "utc_day", True, g::time_filters),
    g::dimension(rows, g::dimension_group("date", s::DateUtc.type, True, g::time_filters), g::utc_bucket(date, qb::UtcBucketUnit::Month), "date_month", True, g::time_filters),
], ["total"]), [t::column(m::optional_field(Row.type, s::EpochMillis.type, "epoch"), "EPOCH_MS"), t::column(m::optional_field(Row.type, s::Rfc3339Utc.type, "utc"), "UTC_TEXT")]);
def profile: qb::PlanProfile = {allowed_operators: [qb::Operator::Source, qb::Operator::Column, qb::Operator::Project, qb::Operator::Aggregate, qb::Operator::Group, qb::Operator::Bind, qb::Operator::Scalar, qb::Operator::Filter], allowed_aggregates: [qb::AggregateFunction::Count], allowed_join_kinds: [], allow_distinct: False,
    allowed_scalars: [qb::ScalarFunction::Eq, qb::ScalarFunction::Ne, qb::ScalarFunction::Gt, qb::ScalarFunction::Ge, qb::ScalarFunction::Lt, qb::ScalarFunction::Le, qb::ScalarFunction::And,
        qb::ScalarFunction::UtcTimeBucket({unit: qb::UtcBucketUnit::Day, encoding: qb::UtcBucketEncoding::EpochMillis}),
        qb::ScalarFunction::UtcTimeBucket({unit: qb::UtcBucketUnit::Month, encoding: qb::UtcBucketEncoding::EpochMillis}),
        qb::ScalarFunction::UtcTimeBucket({unit: qb::UtcBucketUnit::Hour, encoding: qb::UtcBucketEncoding::DatetimeUtc}),
        qb::ScalarFunction::UtcTimeBucket({unit: qb::UtcBucketUnit::Day, encoding: qb::UtcBucketEncoding::DatetimeUtc}),
        qb::ScalarFunction::UtcTimeBucket({unit: qb::UtcBucketUnit::Month, encoding: qb::UtcBucketEncoding::DateUtc})]};
def payload: edsl::PreparedPayload = t::prepare("buckets", [declared], profile).payload;
def ast: Fn(String) -> qb::QueryAst = fn(extra) { intent::query_intent_ast_factory(payload)(json::parse(`{"op":"Graph","root":"r","nodes":[{"id":"r","entity":"buckets"}],"edges":[],\{extra}}`).unwrap!()) };
type RuntimeCase = struct { id: String, sqlite: qb::Query, postgres: qb::Query };
def runtime_case: Fn(String, String) -> RuntimeCase = fn(id, extra) { let query = ast(extra); {id, sqlite: sqlite::build_query(query), postgres: postgres::build_query(query)} };
pub def runtime_cases: Value = codec::encode([
    runtime_case("project", r#""select":[{"node":"r","dimension":"seq"},{"node":"r","dimension":"epoch_day"},{"node":"r","dimension":"epoch_month"},{"node":"r","dimension":"utc_hour"},{"node":"r","dimension":"utc_day"},{"node":"r","dimension":"date_month"}]"#),
    runtime_case("grouped", r#""select":[{"node":"r","dimension":"epoch_day"}],"measures":[{"node":"r","measure":"total"}]"#),
    runtime_case("window", r#""select":[{"node":"r","dimension":"seq"}],"time_windows":[{"node":"r","dimension":"epoch_day","start":-86400000,"end":86400000}]"#),
]);
pub def local_clock_cannot_be_bucketed_as_utc: test::Test = test::should_fail_with(fn() { g::checked_utc_bucket(g::checked_input(m::checked_field(Row.type, s::LocalEpochMillis.type, "local")), qb::UtcBucketUnit::Day) }, "UTC bucket does not accept local time");
pub def plain_int_is_not_a_time_clock: test::Test = test::should_fail_with(fn() { g::checked_utc_bucket(g::checked_input(m::checked_field(Row.type, Int.type, "seq")), qb::UtcBucketUnit::Day) }, "UTC bucket requires a UTC time type");
pub def date_has_no_hour_bucket: test::Test = test::should_fail_with(fn() { g::checked_utc_bucket(date, qb::UtcBucketUnit::Hour) }, "DateUtc has no hour bucket");
pub def invalid_bucket_filter_is_rejected: test::Test = test::should_fail(fn() { ast(r#""select":[],"filters":[{"node":"r","dimension":"date_month","op":"Eq","value":"2023-02-29"}]"#) });
pub def utc_bucket_filter_rejects_offsets: test::Test = test::should_fail(fn() { ast(r#""select":[],"filters":[{"node":"r","dimension":"utc_day","op":"Eq","value":"2024-02-29T00:00:00+00:00"}]"#) });
pub def erased_bucket_node_is_rechecked: test::Test = test::should_fail_with(fn() { g::checked(g::checked_utc_bucket(epoch, qb::UtcBucketUnit::Day) <~ {node: g::Node::UtcBucket({input: g::Node::Column({name: "seq", value: Int.type, nullable: False}), unit: qb::UtcBucketUnit::Day})}) }, "UTC bucket requires a UTC time type");
pub def bucket_result_is_conservatively_nullable: test::Test = test::should_ok(fn() { g::utc_bucket(epoch, qb::UtcBucketUnit::Day).nullable });
pub def bucket_profile_is_checked: test::Test = test::should_fail(fn() { t::checked_prepare("bad", [declared], profile <~ {allowed_scalars: [qb::ScalarFunction::Eq]}) });
pub def prepared_bucket_contract_is_retained: test::Test = test::should_ok(fn() { payload.dimensions[1].utc_bucket == Some({id: "epoch_day", unit: qb::UtcBucketUnit::Day}) });
