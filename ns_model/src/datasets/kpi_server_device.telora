use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::serverdevice_2_kpi;
@domain::subject("PhysicalServer", "obj_id")
@domain::dataset("kpi-server-device", "kpi_server_device", ["obj_id","ts"])
@domain::metric("ts")
@domain::relations(relations)
pub type KpiServerDevice = struct {
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("kpi-server-device/obj_id", domain::Reference(ids::KpiServerDeviceByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "sede_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: domain::Reference(ids::KpiServerDeviceByObjId),
    @m::column("TS")
    @g::field_view(g::dimension_group("kpi-server-device/ts", s::DateTimeUtc.type, True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt]), "sede_sample_time", True, [g::Filter::Eq, g::Filter::Ge, g::Filter::Lt])
