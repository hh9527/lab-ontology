use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::physical_server_processor;
use crate::datasets::kpi_server_processor;
@domain::subject("PhysicalServerProcessor", "obj_sys_id")
@domain::dataset("serverprocessor-2-kpi", "serverprocessor2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type Serverprocessor2Kpi = struct {
    @m::column("OBJSYSID")
    @g::field_view(g::dimension_group("serverprocessor-2-kpi/obj_sys_id", ids::PhysicalServerProcessorByObjSysId.type, True, [g::Filter::Eq]), "serverprocessor_2_obj_sys_id", True, [g::Filter::Eq])
    obj_sys_id: ids::PhysicalServerProcessorByObjSysId,
    @m::column("OBJ_ID")
    @g::field_view(g::dimension_group("serverprocessor-2-kpi/obj_id", domain::Reference(ids::KpiServerProcessorByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "serverprocessor_2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::KpiServerProcessorByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("serverprocessor_2__phsepr", domain::endpoint(Serverprocessor2Kpi.type, "obj_sys_id"), domain::endpoint(physical_server_processor::PhysicalServerProcessor.type, "obj_sys_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Optional}),
    r::relation("serverprocessor_2__sepr", domain::endpoint(Serverprocessor2Kpi.type, "obj_id"), domain::endpoint(kpi_server_processor::KpiServerProcessor.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
