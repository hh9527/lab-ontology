pub def knowledge_index_cross_references_are_model_derived: test::Test = test::should_ok(fn() {
    let catalog = edsl::knowledge_index(payload);
    let kpi = match array::find(catalog, fn(item) { item.id == "device_kpi" }) {
        Some(item) => item,
        None => fail!("device KPI missing from discovery index"),
    };
    let device = match array::find(catalog, fn(item) { item.id == "device" }) {
        Some(item) => item,
        None => fail!("device missing from discovery index"),
    };
    let link = edsl::relation_domain(payload, "device_kpi_of_device");
    if kpi.kind == edsl::DatasetKind::Metric
        && kpi.label == "Device KPI samples"
        && array::any(kpi.metric_ids, fn(id) { id == "cpu_usage" })
        && array::any(kpi.relation_ids, fn(id) { id == "device_kpi_of_device" })
        && array::any(device.relation_ids, fn(id) { id == "device_kpi_of_device" })
        && link.label == "Samples for device"
        && link.summary == "Resource and tenant identify the KPI owner" {
        True
    } else {
        fail!("discovery index lost its model cross references", kpi, device, link)
    }
});

