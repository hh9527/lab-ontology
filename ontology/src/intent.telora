use crate::ontology as edsl;
use crate::query as qb;
use crate::time as time;
use std::array as array;
use std::blame as blame;
use std::codec as codec;
use std::diagnostics as diagnostics;
use std::dict as dict;
use std::string as string;
use std::value::{ Value };

def as_object: Fn(Value) -> Dict(Value) = fn(value) {
    match value {
        Value::Object(obj) => obj,
        _ => fail!("intent must be an object", value),
    }
};

def as_array: Fn(Value) -> Array(Value) = fn(value) {
    match value {
        Value::Array(items) => items,
        _ => fail!("intent field must be an array", value),
    }
};

def as_string: Fn(Value) -> String = fn(value) {
    match value {
        Value::String(text) => text,
        _ => fail!("intent field must be a string", value),
    }
};

# fail! places the rule at locs[0] and argument origins after it; actionable IDs
# must also appear in the message.
def field: Fn(Dict(Value), String) -> Value = fn(obj, key) {
    match dict::get(obj, key) {
        Some(value) => value,
        None => fail!(`intent field is missing: \{key}`, obj, key),
    }
};

def array_opt: Fn(Dict(Value), String) -> Array(Value) = fn(obj, key) {
    match dict::get(obj, key) {
        None => [],
        Some(Value::None) => [],
        Some(value) => as_array(value),
    }
};

def parse_op: Fn(String) -> edsl::FilterOp = fn(op) {
    match codec::decode@[edsl::FilterOp](Value::String(op)) {
        Ok(value) => value,
        Err(error) => raise!(blame::with_context(error,
            `unsupported filter operator \{op}; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/graph/filter")}`)),
    }
};

def parse_input: Fn(String, Value) -> edsl::FilterInput = fn(kind, value) {
    match kind {
        "text" => match value {
            Value::String(text) => edsl::FilterInput::Text(text),
            _ => fail!("text filter requires a string value", value),
        },
        "int" => match value {
            Value::Int(number) => edsl::FilterInput::Int(number),
            _ => fail!("int filter requires an integer value", value),
        },
        "number" => match value {
            Value::Int(number) => edsl::FilterInput::Int(number),
            Value::Float(number) => edsl::FilterInput::Number(number),
            _ => fail!("number filter requires a numeric value", value),
        },
        "bool" => match value {
            Value::True => edsl::FilterInput::Bool(True),
            Value::False => edsl::FilterInput::Bool(False),
            _ => fail!("bool filter requires a boolean value", value),
        },
        "rfc3339" => match value {
            Value::String(text) => edsl::FilterInput::Rfc3339(text),
            _ => fail!("RFC3339 filter requires a string representation", value),
        },
        "epoch_millis" => match value {
            Value::Int(ms) => edsl::FilterInput::EpochMillis(ms),
            _ => fail!("EpochMillis filter requires an integer representation", value),
        },
        "date" => match value {
            Value::String(text) => edsl::FilterInput::Date(text),
            _ => fail!("Date filter requires a string representation", value),
        },
        "utc_second" => match value {
            Value::String(text) => edsl::FilterInput::Utc1(text),
            _ => fail!("Utc1 filter requires a string representation", value),
        },
        "local_datetime" => match value {
            Value::String(text) => edsl::FilterInput::LocalDateTime(text),
            _ => fail!("LocalDateTime filter requires a string representation", value),
        },
        _ => fail!("internal filter input type is unsupported", kind),
    }
};

def inferred_input: Fn(edsl::PreparedPayload, String, Value) -> edsl::FilterInput =
    fn(payload, dimension, value) {
        let detail = edsl::visible_dimension_detail(payload, dimension);
        if let Value::Object(obj) = value {
            if !detail.half_open { fail!("tagged unknown input requires a half-open domain", dimension, value) }
            else if array::length(dict::keys(obj)) != 1 { fail!("unknown input requires exactly one tag", dimension, value) }
            else {
                match dict::get(obj, "unknown") {
                    Some(Value::String(raw)) => edsl::FilterInput::Unknown(raw),
                    Some(_) => fail!("unknown raw value must be a string", dimension, value),
                    None => match dict::get(obj, "unknowns") {
                        Some(Value::True) => edsl::FilterInput::Unknowns,
                        _ => fail!("expected unknown string or unknowns true", dimension, value),
                    },
                }
            }
        } else {
            let candidates = array::filter(detail.input_kinds, fn(kind) {
                match value {
                    Value::String(_) => kind == edsl::FilterInputKind::Text || kind == edsl::FilterInputKind::Date
                        || kind == edsl::FilterInputKind::Rfc3339 || kind == edsl::FilterInputKind::Utc1
                        || kind == edsl::FilterInputKind::LocalDateTime || kind == edsl::FilterInputKind::Ipv4,
                    Value::Int(_) => kind == edsl::FilterInputKind::Int || kind == edsl::FilterInputKind::Number
                        || kind == edsl::FilterInputKind::EpochMillis,
                    Value::Float(_) => kind == edsl::FilterInputKind::Number,
                    Value::True => kind == edsl::FilterInputKind::Bool,
                    Value::False => kind == edsl::FilterInputKind::Bool,
                    _ => False,
                }
            });
            if array::length(candidates) == 0 { fail!(`value does not match dimension \{dimension} input type; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Dimension, detail.dataset, dimension)}`, dimension, detail.input_kinds, value) }
            else {
                let chosen = if array::any(candidates, fn(kind) { kind == edsl::FilterInputKind::Int })
                    && array::any(candidates, fn(kind) { kind == edsl::FilterInputKind::Number })
                    && array::length(candidates) == 2 { edsl::FilterInputKind::Int }
                    else if array::length(candidates) == 1 { candidates[0] }
                    else { fail!(`dimension \{dimension} has ambiguous declared input types; fix its Model definition`, dimension, candidates, value) };
                match chosen {
                    edsl::FilterInputKind::Text => parse_input("text", value),
                    edsl::FilterInputKind::Ipv4 => match value {
                        Value::String(text) => edsl::FilterInput::Ipv4(text),
                        _ => fail!("IPv4 filter requires a string", value),
                    },
                    edsl::FilterInputKind::Int => parse_input("int", value),
                    edsl::FilterInputKind::Number => parse_input("number", value),
                    edsl::FilterInputKind::Bool => parse_input("bool", value),
                    edsl::FilterInputKind::Rfc3339 => parse_input("rfc3339", value),
                    edsl::FilterInputKind::EpochMillis => parse_input("epoch_millis", value),
                    edsl::FilterInputKind::Date => parse_input("date", value),
                    edsl::FilterInputKind::Utc1 => parse_input("utc_second", value),
                    edsl::FilterInputKind::LocalDateTime => parse_input("local_datetime", value),
                }
            }
        }
    };

def measure_input: Fn(edsl::PreparedPayload, String, Value) -> edsl::FilterInput = fn(payload, measure, value) {
    match (edsl::measure_output_type(payload, measure), value) {
        (edsl::OutputType::Text, Value::String(text)) => edsl::FilterInput::Text(text),
        (edsl::OutputType::Integer, Value::Int(number)) => edsl::FilterInput::Int(number),
        (edsl::OutputType::Number, Value::Int(number)) => edsl::FilterInput::Int(number),
        (edsl::OutputType::Number, Value::Float(number)) => edsl::FilterInput::Number(number),
        (edsl::OutputType::Boolean, Value::True) => edsl::FilterInput::Bool(True),
        (edsl::OutputType::Boolean, Value::False) => edsl::FilterInput::Bool(False),
        _ => do {
            let detail = edsl::measure_detail(payload, measure);
            fail!(`value does not match measure \{measure} output type; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Measure, detail.dataset, measure)}`, measure, value)
        },
    }
};

type RawGraphFilter = struct { node: String, dimension: String, op: String, value: Value };
type RawGraphAnyOf = struct { node: String, dimension: String, values: Array(Value) };
type RawGraphHaving = struct { node: String, measure: String, op: String, value: Value };
type RawTimeWindow = struct { node: String, dimension: String, start: Value, end: Option(Value) };
type RawGraphOrder = struct { node: String, dimension: String, direction: String };
type RawGraphTopMeasure = struct { node: String, measure: String, direction: String, take: Int };
# Optional Value fields define the codec key schema; semantic parsing below
# reads the original object to distinguish omission from explicit null.
type RawGraphEnvelope = struct {
    op: String,
    root: String,
    nodes: Value,
    edges: Value,
    select: Value,
    row_grain: Option(Value),
    distinct: Option(Value),
    constraints: Option(Value),
    measures: Option(Value),
    measure_having: Option(Value),
    filters: Option(Value),
    time_windows: Option(Value),
    any_of: Option(Value),
    exists: Option(Value),
    count: Option(Value),
    count_value: Option(Value),
    count_having: Option(Value),
    count_groups: Option(Value),
    include_empty: Option(Value),
    group_by_identity: Option(Value),
    top_per: Option(Value),
    top_by_measure: Option(Value),
    order_by: Option(Value),
    take: Option(Value),
};
type RawGraphExistEnvelope = struct {
    anchor: String,
    nodes: Value,
    edges: Value,
    constraints: Option(Value),
    filters: Option(Value),
    time_windows: Option(Value),
    any_of: Option(Value),
    having: Option(Value),
    negated: Option(Value),
};
type RawCountThreshold = struct { op: String, value: Value };
type RawGraphPair = struct { op: String, left: Value, right: Value, count_groups: Option(Value) };
type RawGraphUnion = struct { op: String, branches: Array(Value) };
type RawUnionBranch = struct { result_node: String, graph: Value };
type RawQueryRequest = struct { intents: Array(Value) };

def decode_graph_shape: for(A: codec::Decode) Fn(Value, String) -> A = fn(value, topic) {
    match codec::decode@[A](value) {
        Ok(decoded) => decoded,
        Err(error) => raise!(blame::with_context(error,
            `see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", topic)}`)),
    }
};

def parse_graph_node: Fn(Value) -> edsl::GraphNode = fn(item) {
    decode_graph_shape@[edsl::GraphNode](item, "syntax/graph/node")
};

def parse_graph_edge: Fn(Value) -> edsl::GraphEdge = fn(item) {
    decode_graph_shape@[edsl::GraphEdge](item, "syntax/graph/edge")
};

def parse_graph_filter: Fn(edsl::PreparedPayload, Value) -> edsl::GraphFilter = fn(payload, item) {
    let raw = decode_graph_shape@[RawGraphFilter](item, "syntax/graph/filter");
    let dimension = raw.dimension;
    let op = parse_op(raw.op);
    let value = raw.value;
    let input = if op == edsl::FilterOp::InSubnet || op == edsl::FilterOp::NotInSubnet {
        let detail = edsl::visible_dimension_detail(payload, dimension);
        if detail.input_kinds != [edsl::FilterInputKind::Ipv4] {
            fail!(`subnet operation requires an IPv4 dimension \{dimension}; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/model/ipv4_subnets")}`, dimension, value)
        } else { match value {
            Value::String(text) => edsl::FilterInput::Ipv4Subnet(text),
            _ => fail!(`IPv4 subnet requires a CIDR string; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/model/ipv4_subnets")}`, value),
        } }
    } else if value == Value::String("now") {
        let detail = edsl::visible_dimension_detail(payload, dimension);
        let temporal = array::any(detail.input_kinds, fn(kind) {
            kind == edsl::FilterInputKind::EpochMillis || kind == edsl::FilterInputKind::Rfc3339
                || kind == edsl::FilterInputKind::Utc1 || kind == edsl::FilterInputKind::Date
                || kind == edsl::FilterInputKind::LocalDateTime
        });
        if temporal {
            fail!(`resolve now to an absolute time value before submitting intent; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/graph/filter")}`, dimension, value)
        } else { inferred_input(payload, dimension, value) }
    } else { inferred_input(payload, dimension, value) };
    let request: edsl::FilterRequest = {
        id: dimension, op, input,
    };
    {node: raw.node, request}
};

def parse_time_value: Fn(edsl::TimeField, Value) -> time::TimeValue =
    fn(role, value) {
        match value {
            Value::String("now") => fail!(`resolve now to an absolute time boundary before submitting intent; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/operations/time_window")}`, value),
            Value::String(text) => match role.encoding {
                edsl::TimeEncoding::DateText => time::TimeValue::Date(text),
                edsl::TimeEncoding::Rfc3339Text => time::TimeValue::Rfc3339(text),
                edsl::TimeEncoding::CanonicalUtcSecondText => time::TimeValue::Utc1(text),
                edsl::TimeEncoding::LocalText => time::TimeValue::LocalDateTime(text),
                _ => fail!("time boundary requires epoch milliseconds", role.encoding, value),
            },
            Value::Int(ms) => match role.encoding {
                edsl::TimeEncoding::EpochMillis => time::TimeValue::EpochMillis(ms),
                _ => fail!("time boundary requires text in the declared logical format", role.encoding, value),
            },
            Value::Object(_) => fail!("resolve relative time to an absolute boundary before submitting intent", value),
            _ => fail!("time boundary must be a field-compatible absolute value", role.encoding, value),
        }
    };

def parse_time_window: Fn(edsl::PreparedPayload, Value) -> Array(edsl::GraphFilter) =
    fn(payload, value) {
        let raw = decode_graph_shape@[RawTimeWindow](value, "syntax/operations/time_window");
        let detail = edsl::visible_dimension_detail(payload, raw.dimension);
        let role = edsl::time_domain(payload, detail.dataset, detail.field);
        let window: time::Window = {start: parse_time_value(role, raw.start),
            end: match raw.end {
                None => None,
                Some(end) => Some(parse_time_value(role, end)),
            }};
        array::map(time::window_filters(payload, raw.dimension, window), fn(request) {
            {node: raw.node, request}
        })
    };

def parse_graph_any_of: Fn(edsl::PreparedPayload, Value) -> edsl::GraphAnyOf = fn(payload, item) {
    let raw = decode_graph_shape@[RawGraphAnyOf](item, "syntax/graph/filter");
    {node: raw.node, dimension: raw.dimension,
        values: array::map(raw.values, fn(value) { inferred_input(payload, raw.dimension, value) })}
};

def parse_graph_having: Fn(edsl::PreparedPayload, Value) -> edsl::GraphHaving = fn(payload, item) {
    let raw = decode_graph_shape@[RawGraphHaving](item, "syntax/graph/aggregate");
    {node: raw.node, measure: raw.measure, op: parse_op(raw.op),
        threshold: measure_input(payload, raw.measure, raw.value)}
};

def parse_graph_existence: Fn(edsl::PreparedPayload, Value) -> edsl::GraphExist = fn(payload, item) {
    let raw = decode_graph_shape@[RawGraphExistEnvelope](item, "syntax/graph/existence");
    let obj = as_object(item);
    let negated = match dict::get(obj, "negated") {
        None => False,
        Some(Value::True) => True,
        Some(Value::False) => False,
        Some(value) => fail!(`graph existence negated must be boolean; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/graph/existence")}`, value),
    };
    {anchor: raw.anchor,
        nodes: array::map(as_array(raw.nodes), parse_graph_node),
        edges: array::map(as_array(raw.edges), parse_graph_edge),
        constraints: array::map(array_opt(obj, "constraints"), parse_graph_edge),
        filters: array::concat([array::map(array_opt(obj, "filters"), fn(value) { parse_graph_filter(payload, value) }),
            array::flat_map(array_opt(obj, "time_windows"), fn(value) { parse_time_window(payload, value) })]),
        any_of: array::map(array_opt(obj, "any_of"), fn(value) { parse_graph_any_of(payload, value) }),
        having: array::map(array_opt(obj, "having"), fn(value) { parse_graph_having(payload, value) }),
        negated}
};

def lower_graph_object: Fn(qb::BuildCtx, edsl::PreparedPayload, Value) -> (qb::BuildCtx, edsl::GraphRequest, qb::Plan) = fn(ctx, payload, value) {
    let obj = as_object(value);
    let op = as_string(field(obj, "op"));
    if op != "Graph" { fail!("graph pair and union branches must be Graph intents", op) }
    else {
        let raw = decode_graph_shape@[RawGraphEnvelope](value, "syntax/graph");
        let request: edsl::GraphRequest = {
            root: raw.root,
            row_grain: match dict::get(obj, "row_grain") {
                None => edsl::GraphRowGrain::Root,
                Some(Value::String("Root")) => edsl::GraphRowGrain::Root,
                Some(Value::String("Association")) => edsl::GraphRowGrain::Association,
                Some(value) => fail!(`graph row_grain must be Root or Association; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/graph")}`, value),
            },
            distinct: match dict::get(obj, "distinct") {
                None => False,
                Some(Value::True) => True,
                Some(Value::False) => False,
                Some(value) => fail!("graph distinct must be boolean", value),
            },
            nodes: array::map(as_array(raw.nodes), parse_graph_node),
            edges: array::map(as_array(raw.edges), parse_graph_edge),
            constraints: array::map(array_opt(obj, "constraints"), parse_graph_edge),
            select: decode_graph_shape@[Array(edsl::GraphSelect)](raw.select, "syntax/graph/select"),
            measures: array::map(array_opt(obj, "measures"), fn(value) {
                decode_graph_shape@[edsl::GraphMeasureSelect](value, "syntax/graph/select")
            }),
            measure_having: array::map(array_opt(obj, "measure_having"), fn(value) { parse_graph_having(payload, value) }),
            filters: array::concat([array::map(array_opt(obj, "filters"), fn(value) { parse_graph_filter(payload, value) }),
                array::flat_map(array_opt(obj, "time_windows"), fn(value) { parse_time_window(payload, value) })]),
            any_of: array::map(array_opt(obj, "any_of"), fn(value) { parse_graph_any_of(payload, value) }),
            exists: array::map(array_opt(obj, "exists"), fn(value) { parse_graph_existence(payload, value) }),
            count: match dict::get(obj, "count") {
                None => None,
                Some(Value::None) => None,
                Some(value) => Some(as_string(value)),
            },
            count_value: match dict::get(obj, "count_value") {
                None => None,
                Some(Value::None) => None,
                Some(value) => Some(decode_graph_shape@[edsl::GraphSelect](value, "syntax/graph/select")),
            },
            count_having: match dict::get(obj, "count_having") {
                None => None,
                Some(Value::None) => None,
                Some(value) => do {
                    let threshold = decode_graph_shape@[RawCountThreshold](value, "syntax/graph/aggregate");
                    let count = match threshold.value {
                        Value::Int(n) => n,
                        other => fail!("graph count threshold must be an integer", other),
                    };
                    Some({op: parse_op(threshold.op), threshold: count})
                },
            },
            count_groups: match dict::get(obj, "count_groups") {
                None => False,
                Some(Value::True) => True,
                Some(Value::False) => False,
                Some(value) => fail!("graph count_groups must be boolean", value),
            },
            include_empty: match dict::get(obj, "include_empty") {
                None => False,
                Some(Value::True) => True,
                Some(Value::False) => False,
                Some(value) => fail!("graph include_empty must be boolean", value),
            },
            group_by_identity: array::map(array_opt(obj, "group_by_identity"), as_string),
            take: match dict::get(obj, "take") {
                None => None,
                Some(Value::Int(n)) => Some(n),
                Some(value) => fail!("graph raw take must be an integer", value),
            },
            order_by: array::map(array_opt(obj, "order_by"), fn(value) {
                let order = decode_graph_shape@[RawGraphOrder](value, "syntax/graph/order");
                let direction = match order.direction {
                    "Asc" => qb::Ordering::Asc,
                    "Desc" => qb::Ordering::Desc,
                    other => fail!(`graph order direction must be Asc or Desc; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/graph/order")}`, other),
                };
                {node: order.node, dimension: order.dimension, direction}
            }),
            top_per: match dict::get(obj, "top_per") {
                None => None,
                Some(Value::None) => None,
                Some(value) => Some(decode_graph_shape@[edsl::GraphTopPer](value, "syntax/graph/order")),
            },
            top_by_measure: match dict::get(obj, "top_by_measure") {
                None => None,
                Some(Value::None) => None,
                Some(value) => do {
                    let top = decode_graph_shape@[RawGraphTopMeasure](value, "syntax/graph/order");
                    let direction = match top.direction {
                        "Asc" => qb::Ordering::Asc,
                        "Desc" => qb::Ordering::Desc,
                        other => fail!(`graph aggregate top direction must be Asc or Desc; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/graph/order")}`, other),
                    };
                    Some({node: top.node, measure: top.measure, direction, take: top.take})
                },
            },
        };
        let lowered = edsl::lower_graph(ctx, payload, request);
        (lowered.0, request, lowered.1)
    }
};

def paired_graph_shape: Fn(edsl::GraphRequest) -> Bool = fn(request) {
    array::get(request.group_by_identity, 0) == Some(request.root)
        && array::length(request.measures) == 1 && request.count == None && request.count_value == None
        && request.count_having == None && !request.count_groups && !request.distinct
        && !request.include_empty && request.top_per == None && request.top_by_measure == None
        && array::length(request.order_by) == 0 && request.take == None
};

def paired_group_operand: Fn(qb::Plan) -> qb::Plan = fn(plan) {
    let keys = array::map(array::enumerate(plan.grouping), fn(entry) {
        qb::named_expr_item(entry.1, `__q_key_\{entry.0}`)
    });
    {...plan, projection: array::concat([plan.projection, keys])}
};

def same_group_expr: Fn(qb::BuildCtx, qb::Expr, qb::Expr) -> Bool = fn(ctx, left, right) {
    match (left, right) {
        (qb::Expr::Column(a), qb::Expr::Column(b)) => a == b,
        (qb::Expr::AllocatedBind(a), qb::Expr::AllocatedBind(b)) => ctx.bindings[a.index - 1] == ctx.bindings[b.index - 1],
        (qb::Expr::Scalar(a), qb::Expr::Scalar(b)) => a.function == b.function
            && array::length(a.args) == array::length(b.args)
            && array::all(array::enumerate(a.args), fn(arg) { same_group_expr(ctx, arg.1, b.args[arg.0]) }),
        _ => False,
    }
};

def lower_graph_pair: Fn(edsl::PreparedPayload, Value) -> qb::QueryAst = fn(payload, value) {
    let raw = decode_graph_shape@[RawGraphPair](value, "syntax/graph_pair");
    let obj = as_object(value);
    let count_groups = match dict::get(obj, "count_groups") {
        None => False,
        Some(Value::True) => True,
        Some(Value::False) => False,
        Some(value) => fail!("aggregate pair count_groups must be boolean", value),
    };
    let left = lower_graph_object(qb::build_context(), payload, raw.left);
    let right = lower_graph_object(qb::independent_query_scope(left.0), payload, raw.right);
    if !paired_graph_shape(left.1) || !paired_graph_shape(right.1) {
        fail!("aggregate pair operands each require one measure, grouping beginning with root identity, and no row ordering or count; qualify each population inside its own graph")
    } else if left.1.root != right.1.root
        || edsl::graph_node(left.1, left.1.root).entity != edsl::graph_node(right.1, right.1.root).entity {
        fail!("aggregate pair roots must name the same entity instance on both sides", left.1.root, right.1.root)
    } else if left.1.select != right.1.select {
        fail!("aggregate pair operands must select the same dimensions in the same order", left.1.select, right.1.select)
    } else if left.1.group_by_identity != right.1.group_by_identity
        || !array::all(left.1.group_by_identity, fn(id) {
            edsl::graph_node(left.1, id).entity == edsl::graph_node(right.1, id).entity
        }) || !array::all(left.1.select, fn(item) {
            edsl::graph_node(left.1, item.node).entity == edsl::graph_node(right.1, item.node).entity
        }) {
        fail!("aggregate pair operands must use the same node instance ids and entities for every grouped and selected node; align group_by_identity and node ids", left.1.group_by_identity, right.1.group_by_identity)
    } else if array::length(left.2.grouping) != array::length(right.2.grouping)
        || !array::all(array::enumerate(left.2.grouping), fn(group) {
            same_group_expr(right.0, group.1, right.2.grouping[group.0])
        }) {
        fail!("aggregate pair operands must group by the same complete declared identities", left.1.group_by_identity)
    } else {
        let keys = array::map(array::enumerate(left.2.grouping), fn(entry) { `__q_key_\{entry.0}` });
        let visible = array::flat_map(left.1.select, fn(item) {
            let alias = `\{item.node}_\{item.dimension}`;
            if edsl::visible_dimension_detail(payload, item.dimension).half_open { [alias, `\{alias}__kind`] }
            else { [alias] }
        });
        let left_measure = left.1.measures[0];
        let right_measure = right.1.measures[0];
        let joined: qb::JoinedGroups = {
            left: paired_group_operand(left.2), right: paired_group_operand(right.2), keys,
            left_outputs: array::push(visible, `\{left_measure.node}_\{left_measure.measure}`),
            right_outputs: [`\{right_measure.node}_\{right_measure.measure}`],
        };
        let plan = if count_groups { qb::QueryPlan::JoinedGroupCount(joined) }
            else { qb::QueryPlan::JoinedGroups(joined) };
        qb::finish(right.0, qb::validate_query_plan(plan))
    }
};

# A union returns one entity population, not an arbitrary mixture of rows.
# Requiring its complete visible identity makes SQL's whole-row UNION distinct
# equivalent to entity deduplication for the selected dimensions.
def union_graph_result: Fn(edsl::PreparedPayload, edsl::GraphRequest, String, Int) -> String = fn(payload, request, result_node, branch) {
    let node = edsl::graph_node(request, result_node);
    if request.count != None || request.count_value != None || request.count_having != None
        || request.count_groups || array::length(request.measures) > 0
        || array::length(request.measure_having) > 0 || array::length(request.group_by_identity) > 0
        || request.include_empty || request.top_per != None || request.top_by_measure != None
        || array::length(request.order_by) > 0 || request.take != None {
        fail!("graph union branch must return unordered raw entity rows without counts, measures or Top-N", branch)
    } else if array::length(request.select) == 0 || !array::all(request.select, fn(item) { item.node == result_node }) {
        fail!("graph union branch must select only dimensions of its result node", branch, result_node)
    } else {
        let entity = match array::find(payload.entities, fn(entry) { entry.id == node.entity }) {
            Some(entry) => entry,
            None => fail!("graph union result node has an unknown entity", branch, node.entity),
        };
        let grain = match entity.dataset {
            Some(dataset) => dataset.grain,
            None => if entity.key_field >= 0 { [entity.fields[entity.key_field].name] }
                else { fail!("graph union result entity needs a declared identity", branch, node.entity) },
        };
        if !array::all(grain, fn(name) {
            let field = match array::find(array::enumerate(entity.fields), fn(entry) { entry.1.name == name }) {
                Some(entry) => entry.0,
                None => fail!("graph union identity field is missing from the entity", branch, name),
            };
            array::any(request.select, fn(item) {
                array::any(payload.dimensions, fn(dimension) {
                    dimension.id == item.dimension && dimension.entity == entity.index
                        && dimension.field == field && !dimension.computed
                })
            })
        }) {
            fail!("graph union branch must project every field of its complete result identity as a plain dimension", branch, node.entity, grain)
        } else { node.entity }
    }
};

def lower_union_branch: Fn(qb::BuildCtx, edsl::PreparedPayload, Value, Int) -> (qb::BuildCtx, String, Array(String), qb::Plan) =
    fn(ctx, payload, value, index) {
        let branch = decode_graph_shape@[RawUnionBranch](value, "syntax/graph_union");
        let lowered = lower_graph_object(ctx, payload, branch.graph);
        let entity = union_graph_result(payload, lowered.1, branch.result_node, index);
        (lowered.0, entity, array::map(lowered.1.select, fn(item) { item.dimension }), lowered.2)
    };

def lower_graph_union: Fn(edsl::PreparedPayload, Value) -> qb::QueryAst = fn(payload, value) {
    let union = decode_graph_shape@[RawGraphUnion](value, "syntax/graph_union");
    let branches = union.branches;
    if array::length(branches) < 2 {
        fail!("graph union requires at least two graph branches", array::length(branches))
    } else {
        let first = lower_union_branch(qb::build_context(), payload, branches[0], 1);
        let combined = array::fold(array::enumerate(branches),
            (first.0, first.1, first.2, [first.3]), fn(state, entry) {
                if entry.0 == 0 { state }
                else {
                    let branch = lower_union_branch(qb::independent_query_scope(state.0),
                        payload, entry.1, entry.0 + 1);
                    if branch.1 != state.1 {
                        fail!(`graph union branch \{entry.0 + 1} must return the same result entity as branch 1: expected \{state.1}, got \{branch.1}`, entry.0 + 1, state.1, branch.1)
                    } else if branch.2 != state.2 {
                        fail!(`graph union branch \{entry.0 + 1} must select the same result dimensions in the same order as branch 1`, entry.0 + 1, state.2, branch.2)
                    } else { (branch.0, state.1, state.2, array::push(state.3, branch.3)) }
                }
            });
        qb::finish(combined.0, qb::validate_query_plan(qb::QueryPlan::SetRows({
            kind: qb::SetOpKind::Union, operands: combined.3
        })))
    }
};

def lower_intent_ast: Fn(edsl::PreparedPayload, Value) -> qb::QueryAst = fn(payload, intent) {
    let obj = as_object(intent);
    let op = as_string(field(obj, "op"));
    if op == "Graph" {
        let lowered = lower_graph_object(qb::build_context(), payload, intent);
        let request = lowered.1;
        let plan = if request.count_groups { qb::QueryPlan::GroupCount(lowered.2) }
            else if request.distinct { qb::QueryPlan::DistinctRows(lowered.2) }
            else { qb::QueryPlan::Rows(lowered.2) };
        qb::finish(lowered.0, qb::validate_query_plan(plan))
    } else if op == "GraphPair" { lower_graph_pair(payload, intent) }
    else if op == "GraphUnion" { lower_graph_union(payload, intent) }
    else { fail!(`unsupported intent op \{op}; use Graph, GraphPair or GraphUnion with named nodes and relations; see info key \{edsl::knowledge_key_hint(edsl::KnowledgeKind::Schema, "", "syntax/intent")}`, op) }
};

type ToQuery = Fn(qb::QueryAst) -> qb::Query;

def query_intent_lower_factory: Fn(edsl::PreparedPayload, ToQuery) -> Fn(Value) -> qb::Query = fn(payload, to_query) {
    fn(intent) { to_query(lower_intent_ast(payload, intent)) }
};

def query_intent_ast_factory: Fn(edsl::PreparedPayload) -> Fn(Value) -> qb::QueryAst = fn(payload) {
    fn(intent) { lower_intent_ast(payload, intent) }
};

type BatchEvaluation = struct {
    index: Int,
    query: Option(qb::Query),
    diagnostics: Array(diagnostics::Diagnostic),
};
type IndexedDiagnostic = struct {
    index: Int,
    diagnostic: diagnostics::Diagnostic,
};
type BatchResponse = struct {
    accepted: Bool,
    diagnostics: Array(IndexedDiagnostic),
    queries: Option(Array(qb::Query)),
};

def query_request_method_factory: Fn(edsl::PreparedPayload, ToQuery) -> Fn(Value) -> Value =
    fn(payload, to_query) {
        fn(request) {
            let parsed = decode_graph_shape@[RawQueryRequest](request, "syntax/intent");
            let intents = parsed.intents;
            if array::length(intents) < 1 || array::length(intents) > 5 {
                fail!(`query request requires one to five independent intents; got \{array::length(intents)}`, array::length(intents))
            } else {
                let assessed: Array(BatchEvaluation) = array::map(array::enumerate(intents), fn(entry) {
                    let observed = diagnostics::with_diagnostics(fn(intent: Value) {
                        to_query(lower_intent_ast(payload, intent))
                    })(entry.1);
                    match observed {
                        Ok((query, reports)) => {index: entry.0, query: Some(query), diagnostics: reports},
                        Err(reports) => {index: entry.0, query: None, diagnostics: reports},
                    }
                });
                let accepted = array::all(assessed, fn(item) { item.query != None });
                let reports: Array(IndexedDiagnostic) = array::fold(assessed, [], fn(all, item) {
                    array::concat([all, array::map(item.diagnostics, fn(diagnostic) {
                        {index: item.index, diagnostic}
                    })])
                });
                let queries = if accepted {
                    Some(array::map(assessed, fn(item) {
                        match item.query {
                            Some(query) => query,
                            None => fail!("accepted query batch has a failed item", item.index),
                        }
                    }))
                } else { None };
                let response: BatchResponse = {accepted, diagnostics: reports, queries};
                codec::encode(response)
            }
        }
    };

pub use self::{ ToQuery, query_intent_lower_factory, query_intent_ast_factory,
    query_request_method_factory };
