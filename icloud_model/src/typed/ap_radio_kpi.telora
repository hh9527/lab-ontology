    source_rssiEffcnt: a::EffectiveCount,
};

@knowledge_policy::reverse_references(True)
type SourceNetworkApRadioKPIFrequency = enum {
    @ev::rename("1")
    @ev::description("2.4G", "")
    Ghz2Point4,
    @ev::rename("2")
    @ev::description("5G", "")
    Ghz5,
    @ev::rename("3")
    @ev::description("6G", "")
    Ghz6,
};
def frequencies: v::Domain(SourceNetworkApRadioKPIFrequency, String) = v::from_enum(
    "SourceNetworkApRadioKPIFrequency",
    SourceNetworkApRadioKPIFrequency.type,
    String.type,
    False
);

pub use self::{NetworkApRadioKPI};
