    fn() {
        uql::render_expr_with_context(
            qb::scalar(
                qb::ScalarFunction::UtcTimeBucket(
                    {unit: qb::UtcBucketUnit::Quarter, encoding: qb::UtcBucketEncoding::DateTimeUtc}
                ),
                [id]
            ),
            cap.0
        )
    },
    "UQL buckets support hour, day and month units only"
);
pub def week_bucket_is_rejected: test::Test = test::should_fail_with(
