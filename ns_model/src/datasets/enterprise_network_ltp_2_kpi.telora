use ontology::semantic as domain;
use ontology::model as m;
use ontology::groups as g;
use ontology::samples as samples;
use ontology::values as v;
use ontology::relations as r;
use ontology::ontology as edsl;
use ontology::scalars as s;
use ontology::query as qb;
use crate::identities as ids;
use crate::domains as domains;
use crate::metric_values as metric;
use crate::units as units;
use crate::datasets::kpi_network_interface_info;
@domain::subject("EnterpriseNetworkLtp", "obj_sys_id")
@domain::dataset("enterprise-network-ltp-2-kpi", "EnterpriseNetworkLTP2kpi", ["obj_sys_id"])
@domain::relations(relations)
pub type EnterpriseNetworkLtp2Kpi = struct {
    @m::column("objSysId")
    @g::field_view(g::dimension_group("enterprise-network-ltp-2-kpi/obj_sys_id", ids::EnterpriseNetworkLtpByObjSysId.type, True, [g::Filter::Eq]), "enl2_obj_sys_id", True, [g::Filter::Eq])
    @domain::count("enl2_count")
    obj_sys_id: ids::EnterpriseNetworkLtpByObjSysId,
    @g::field_view(g::dimension_group("enterprise-network-ltp-2-kpi/obj_id", domain::Reference(ids::EnterpriseNetworkLtp2KpiByObjId).type, True, [g::Filter::Eq, g::Filter::Ne]), "enl2_obj_id", True, [g::Filter::Eq, g::Filter::Ne])
    obj_id: Option(domain::Reference(ids::EnterpriseNetworkLtp2KpiByObjId)),
};

pub def relations: Array(r::Relation) = [
    r::relation("enl2__nii", domain::endpoint(EnterpriseNetworkLtp2Kpi.type, "obj_id"), domain::endpoint(kpi_network_interface_info::KpiNetworkInterfaceInfo.type, "obj_id"), {from: edsl::Cardinality::Optional, to: edsl::Cardinality::Many0}),
];
