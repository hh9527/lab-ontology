use ontology::registry as registry;
use ontology::query as q;
use ontology::model as m;
use ontology::groups as g;
use ontology::relations as r;
use std::test as test;

@registry::dataset("rows", "rows", ["id"])
type Row = struct {
    @g::exact("id")
    id: Int,
    name: String
};
pub def missing_field: test::Test = test::should_fail_with(
    fn() {
        m::field(Row.type, Int.type, "missing");
        ()
    },
    "typed model field does not exist"
);
pub def wrong_field_type: test::Test = test::should_fail_with(
    fn() {
        m::field(Row.type, String.type, "id");
        ()
    },
    "typed model field has a different nominal type"
);
pub def missing_role: test::Test = test::should_fail_with(
    fn() {
        r::endpoint(Row.type, "missing");
        ()
    },
    "relation endpoint role does not exist"
);
@registry::dataset("collision", "collision", ["id"])
type Collision = struct {
    id: Int,
    @g::exact("same")
    a: String,
    @g::exact("same")
    b: String
};
pub def duplicate_publication: test::Test = test::should_fail_with(
    fn() {
        registry::payload(
            "boundary",
            [Collision.type],
            {
                allowed_operators: [],
                allowed_scalars: [],
                allowed_aggregates: [],
                allowed_join_kinds: [],
                allow_distinct: False
            }.ty!(q::PlanProfile)
        );
        ()
    },
    "duplicate key in unique_by"
);
@registry::entity("identity")
type Identity = struct {
    id: Int,
    other: String
};
pub def incomplete_identity_mapping: test::Test = test::should_fail_with(
    fn() {
        m::role(
            registry::dataset_of(Row.type),
            registry::entity_of(Identity.type),
            "subject",
            False,
            [
                m::identity_part(
                    m::field(Row.type, Int.type, "id"),
                    m::field(Identity.type, Int.type, "id")
                )
            ]
        );
        ()
    },
    "role mapping must cover the complete identity exactly once"
);
pub def invalid_count_name: test::Test = test::should_fail_with(
    fn() {
        registry::record_counts(["not a name"]);
        ()
    },
    "property publish name must be a valid identifier"
);
