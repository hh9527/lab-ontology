    @ev::itag(5)
    @ev::description("Environmental Alarm", "环境告警")
    EnvironmentalAlarm,
    @ev::itag(6)
    @ev::description("Integrity Alarm", "完整性告警")
    IntegrityAlarm,
    @ev::itag(7)
    @ev::description("Operation Alarm", "操作告警")
