# world-model/src/bin/make-query.telora
#
# Deterministic entry used by the Host adapter `bin/world-make-query check`.

import "ontology/edsl" as edsl;
import "ontology/query" as qb;
import "@src/model" { payload };
import "@src/query" { intent_of_value, resolve };
import "std/dict" as dict;
import "std/entry" as entry;
import "std/codec" as codec;
import "std/value" { Value };

def config: entry.ContextConfig = {
    sources: ["input"],
    envs: [],
    args: 'False,
};

export def main = entry.main(config, fn(ctx) {
    let raw: Value = match dict.get(ctx.sources, "input") {
        'Some(value) => value,
        'None => fail!("missing input source"),
    };
    let intent = match intent_of_value(raw) {
        'Ok(x) => x,
        'Err(message) => fail!(message),
    };
    let query = resolve(payload, intent);
    match codec.encode(Value, query) {
        'Ok(value) => value,
        'Err(_) => fail!("failed to encode the query result"),
    }
});
