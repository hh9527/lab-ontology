# spider-model/tests/query.telora
#
# Contract tests for the spider-model intent resolver (v3).  These tests
# exercise the public INTENT JSON contract end-to-end (parse -> validate ->
# lower -> parameterized Query) and cover:
#   - legal modeling intents (counts, filtered aggregates, group-by, lists,
#     range filters, ordering + Top N);
#   - result shapes: output column order (dimensions before measures),
#     SELECT DISTINCT attribute lists, ordering by a non-returned dimension,
#     positive correlated existence (records meeting A AND B), anti-existence
#     (NOT EXISTS / no matching related row), capacity avg/max measures;
#   - unknown vocabulary and type errors;
#   - illegal combinations (unselected ordering target, hidden ordering on an
#     aggregated intent, distinct with measures, offset without ordering,
#     non-positive limit);
#   - parameter binding presence/order and determinism.
#
# The assertions are structural: they only rely on the stable, documented SQL
# contract, not on the exact text produced by a given ontology version.

import "@src/model" { payload };
import "@src/query" {
    Intent,
    parse_intent,
    intent_problem,
    resolve,
};
import "ontology/query" as qb;
import "std/array" as array;
import "std/string" as string;

# --- helpers ---------------------------------------------------------------

def intent_of_text: Fn(String) -> Intent = fn(text) {
    match parse_intent(text) {
        'Ok(i) => i,
        'Err(message) => fail!("test intent did not parse", message),
    }
};

def run_text: Fn(String) -> qb.Query = fn(text) {
    resolve(payload, intent_of_text(text))
};

def problem_text: Fn(String) -> Option(String) = fn(text) {
    intent_problem(payload, intent_of_text(text))
};

def contains_literal: Fn(String, String) -> Bool = fn(sql, literal) {
    array.length(string.split(sql, literal)) > 1
};

def binding_count: Fn(qb.Query) -> Int = fn(q) {
    array.length(q.bindings)
};

# --- valid intent fixtures -------------------------------------------------

def total_singers_json: String = `{"measures":[{"id":"singer_count","mode":"all"}],"dimensions":[],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;

def france_age_stats_json: String = `{"measures":[{"id":"singer_age_avg","mode":"all"},{"id":"singer_age_min","mode":"all"},{"id":"singer_age_max","mode":"all"}],"dimensions":[],"distinct":false,"filters":[{"id":"singer_country","op":"eq","value":"France"}],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;

def singers_by_country_json: String = `{"measures":[{"id":"singer_count","mode":"all"}],"dimensions":[{"id":"singer_country"}],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;

def distinct_countries_json: String = `{"measures":[],"dimensions":[{"id":"singer_country"}],"distinct":true,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;

def hidden_age_order_json: String = `{"measures":[],"dimensions":[{"id":"singer_song_name"},{"id":"singer_song_year"}],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[{"measure":null,"dimension":"singer_age","direction":"asc"}],"limit":1,"offset":null}`;

def stadium_range_list_json: String = `{"measures":[],"dimensions":[{"id":"stadium_location"},{"id":"stadium_name"}],"distinct":false,"filters":[{"id":"stadium_capacity","op":"ge","value":5000},{"id":"stadium_capacity","op":"le","value":10000}],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;

def concerts_per_stadium_json: String = `{"measures":[{"id":"concert_count","mode":"all"}],"dimensions":[{"id":"stadium_name"}],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;

def stadium_capacity_stats_json: String = `{"measures":[{"id":"stadium_capacity_avg","mode":"all"},{"id":"stadium_capacity_max","mode":"all"}],"dimensions":[],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;

def stadium_two_year_exists_json: String = `{"measures":[],"dimensions":[{"id":"stadium_name"}],"distinct":false,"filters":[],"exists":[{"target":"concert","filters":[{"id":"concert_year","op":"eq","value":2014}]},{"target":"concert","filters":[{"id":"concert_year","op":"eq","value":2015}]}],"absence":[],"order":[],"limit":null,"offset":null}`;

def stadium_no_concert_json: String = `{"measures":[],"dimensions":[{"id":"stadium_name"}],"distinct":false,"filters":[],"exists":[],"absence":[{"target":"concert","filters":[{"id":"concert_year","op":"eq","value":2014}]}],"order":[],"limit":null,"offset":null}`;

def stadium_top_capacity_json: String = `{"measures":[],"dimensions":[{"id":"stadium_name"},{"id":"stadium_capacity"}],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[{"measure":null,"dimension":"stadium_capacity","direction":"desc"}],"limit":3,"offset":null}`;

def top_country_by_singer_count_json: String = `{"measures":[],"dimensions":[{"id":"singer_country"}],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[{"measure":"singer_count","dimension":null,"direction":"desc"}],"limit":1,"offset":null}`;

def two_bindings_json: String = `{"measures":[],"dimensions":[{"id":"singer_name"},{"id":"singer_country"}],"distinct":false,"filters":[{"id":"singer_country","op":"eq","value":"AAA"},{"id":"singer_name","op":"eq","value":"BBB"}],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;

# --- legal intent tests ----------------------------------------------------

def test_total_singers = do {
    let q = run_text(total_singers_json);
    let ok_sel = contains_literal(q.sql, "SELECT");
    let ok_rows = binding_count(q) == 0;
    if ok_sel && ok_rows {
        'True
    } else {
        fail!("total singers intent failed", q.sql)
    }
};

def test_filtered_age_stats = do {
    let q = run_text(france_age_stats_json);
    let no_literal = !contains_literal(q.sql, "France");
    let ok_binds = binding_count(q) == 1;
    if no_literal && ok_binds {
        'True
    } else {
        fail!("filtered age stats intent failed", q.sql)
    }
};

def test_group_by_country = do {
    let q = run_text(singers_by_country_json);
    let ok_group = contains_literal(q.sql, "GROUP BY");
    let ok_order = contains_literal(q.sql, "sg.country, count(");
    if ok_group && ok_order {
        'True
    } else {
        fail!("group by country intent failed", q.sql)
    }
};

def test_distinct_countries = do {
    let q = run_text(distinct_countries_json);
    let ok_distinct = contains_literal(q.sql, "DISTINCT");
    let no_count = !contains_literal(q.sql, "count(");
    let ok_binds = binding_count(q) == 0;
    if ok_distinct && no_count && ok_binds {
        'True
    } else {
        fail!("distinct countries intent failed", q.sql)
    }
};

def test_hidden_age_order = do {
    let q = run_text(hidden_age_order_json);
    let ok_order = contains_literal(q.sql, "ORDER BY");
    let ok_age = contains_literal(q.sql, "sg.age");
    let ok_binds = binding_count(q) == 1;
    if ok_order && ok_age && ok_binds {
        'True
    } else {
        fail!("hidden ordering intent failed", q.sql)
    }
};

def test_stadium_range_list = do {
    let q = run_text(stadium_range_list_json);
    let ok_binds = binding_count(q) == 2;
    let no_literal = !contains_literal(q.sql, "5000");
    if ok_binds && no_literal {
        'True
    } else {
        fail!("stadium range list intent failed", q.sql)
    }
};

def test_concerts_per_stadium = do {
    let q = run_text(concerts_per_stadium_json);
    let ok_join = contains_literal(q.sql, "JOIN");
    let ok_group = contains_literal(q.sql, "GROUP BY");
    if ok_join && ok_group {
        'True
    } else {
        fail!("concerts per stadium intent failed", q.sql)
    }
};

def test_stadium_capacity_stats = do {
    let q = run_text(stadium_capacity_stats_json);
    let ok_avg = contains_literal(q.sql, "avg(");
    let ok_max = contains_literal(q.sql, "max(");
    let ok_binds = binding_count(q) == 0;
    if ok_avg && ok_max && ok_binds {
        'True
    } else {
        fail!("stadium capacity stats intent failed", q.sql)
    }
};

def test_stadium_two_year_exists = do {
    let q = run_text(stadium_two_year_exists_json);
    let ok_exists = contains_literal(q.sql, "EXISTS");
    let ok_binds = binding_count(q) == 2;
    if ok_exists && ok_binds {
        'True
    } else {
        fail!("two-condition existence intent failed", q.sql)
    }
};

def test_stadium_no_concert = do {
    let q = run_text(stadium_no_concert_json);
    let ok_not_exists = contains_literal(q.sql, "NOT EXISTS");
    let ok_binds = binding_count(q) == 1;
    if ok_not_exists && ok_binds {
        'True
    } else {
        fail!("absence (NOT EXISTS) intent failed", q.sql)
    }
};

def test_stadium_top_capacity = do {
    let q = run_text(stadium_top_capacity_json);
    let ok_order = contains_literal(q.sql, "ORDER BY");
    let ok_limit = binding_count(q) == 1;
    if ok_order && ok_limit {
        'True
    } else {
        fail!("stadium top capacity intent failed", q.sql)
    }
};

def test_internal_top_country = do {
    # Group singers by country, order by the (internal, unreturned) singer
    # count, keep the top group, and return only the country column.
    let q = run_text(top_country_by_singer_count_json);
    let ok_group = contains_literal(q.sql, "GROUP BY");
    let ok_order = contains_literal(q.sql, "ORDER BY");
    let no_alias = !contains_literal(q.sql, "singer_count");
    let ok_binds = binding_count(q) == 1;
    if ok_group && ok_order && no_alias && ok_binds {
        'True
    } else {
        fail!("internal top-N intent failed", q.sql)
    }
};

def test_internal_top_wrong_entity = do {
    # Internal ordering measure must be on the subject (base) entity.
    let text: String = `{"measures":[],"dimensions":[{"id":"singer_country"}],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[{"measure":"stadium_count","dimension":null,"direction":"desc"}],"limit":1,"offset":null}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "unsupported") {
            'True
        } else {
            fail!("internal ordering on a different entity should be unsupported", msg)
        },
        'None => fail!("internal ordering on a different entity was accepted"),
    }
};

# --- parameter binding order / determinism --------------------------------

def test_two_bindings_parameterized = do {
    let q = run_text(two_bindings_json);
    let ok_binds = binding_count(q) == 2;
    let no_a = !contains_literal(q.sql, "AAA");
    let no_b = !contains_literal(q.sql, "BBB");
    let ordered = q.bindings[0] != q.bindings[1];
    if ok_binds && no_a && no_b && ordered {
        'True
    } else {
        fail!("two-binding parameterization failed", q.sql)
    }
};

def test_deterministic = do {
    let a = run_text(two_bindings_json);
    let b = run_text(two_bindings_json);
    if a.sql == b.sql && a.bindings == b.bindings {
        'True
    } else {
        fail!("repeated lowering is not deterministic")
    }
};

# --- unknown vocabulary ----------------------------------------------------

def test_unknown_measure = do {
    let text: String = `{"measures":[{"id":"singer_bogus","mode":"all"}],"dimensions":[],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("unknown measure was accepted"),
    }
};

def test_unknown_dimension = do {
    let text: String = `{"measures":[],"dimensions":[{"id":"bogus_dim"}],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("unknown dimension was accepted"),
    }
};

def test_unknown_exists_target = do {
    let text: String = `{"measures":[],"dimensions":[{"id":"stadium_name"}],"distinct":false,"filters":[],"exists":[{"target":"bogus_entity","filters":[]}],"absence":[],"order":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("unknown exists target was accepted"),
    }
};

def test_unknown_absence_target = do {
    let text: String = `{"measures":[],"dimensions":[{"id":"stadium_name"}],"distinct":false,"filters":[],"exists":[],"absence":[{"target":"bogus_entity","filters":[]}],"order":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("unknown absence target was accepted"),
    }
};

# --- type errors -----------------------------------------------------------

def test_text_value_on_numeric_dimension = do {
    let text: String = `{"measures":[],"dimensions":[{"id":"singer_name"}],"distinct":false,"filters":[{"id":"singer_age","op":"eq","value":"old"}],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("text value on a numeric dimension was accepted"),
    }
};

def test_unsupported_filter_operator = do {
    let text: String = `{"measures":[],"dimensions":[{"id":"singer_name"}],"distinct":false,"filters":[{"id":"singer_country","op":"contains","value":5}],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("numeric value for a text operator was accepted"),
    }
};

# --- illegal combinations --------------------------------------------------

def test_ordering_unselected_measure = do {
    let text: String = `{"measures":[{"id":"singer_count","mode":"all"}],"dimensions":[],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[{"measure":"singer_age_avg","dimension":null,"direction":"desc"}],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "unsupported") {
            'True
        } else {
            fail!("ordering by an unreturned aggregate should be reported as unsupported", msg)
        },
        'None => fail!("ordering by an unselected measure was accepted"),
    }
};

def test_unsupported_multi_hop_exists = do {
    # A subject on stadium with a related condition on singer would need a
    # multi-hop fan-out existence that the base layer cannot express.  It must
    # be reported as unsupported, never approximated with an extra count.
    let text: String = `{"measures":[],"dimensions":[{"id":"stadium_name"}],"distinct":false,"filters":[],"exists":[{"target":"singer","filters":[{"id":"singer_country","op":"eq","value":"AAA"}]}],"absence":[],"order":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(msg) => if contains_literal(msg, "unsupported") {
            'True
        } else {
            fail!("multi-hop existence should be reported as unsupported", msg)
        },
        'None => fail!("unreachable multi-hop existence was accepted"),
    }
};

def test_singer_concert_two_hop_supported = do {
    # "Singers who performed in a 2014 concert" is a fan-out first-hop two-hop
    # existence (singer -> singer_in_concert -> concert).  The base now lowers
    # this as the link shape and returns only the singer dimension (no count,
    # no GROUP BY amplification).
    let text: String = `{"measures":[],"dimensions":[{"id":"singer_name"}],"distinct":false,"filters":[],"exists":[{"target":"concert","filters":[{"id":"concert_year","op":"eq","value":2014}]}],"absence":[],"order":[],"limit":null,"offset":null}`;
    let q = run_text(text);
    let ok_exists = contains_literal(q.sql, "EXISTS");
    let no_count = !contains_literal(q.sql, "singer_count");
    let ok_binds = binding_count(q) == 1;
    if ok_exists && no_count && ok_binds {
        'True
    } else {
        fail!("singer->concert two-hop existence should be supported", q.sql)
    }
};

def test_singer_concert_two_hop_absence_supported = do {
    # The anti-existence counterpart returns singers with no 2014 concert.
    let text: String = `{"measures":[],"dimensions":[{"id":"singer_name"}],"distinct":false,"filters":[],"exists":[],"absence":[{"target":"concert","filters":[{"id":"concert_year","op":"eq","value":2014}]}],"order":[],"limit":null,"offset":null}`;
    let q = run_text(text);
    let ok_not_exists = contains_literal(q.sql, "NOT EXISTS");
    let no_count = !contains_literal(q.sql, "singer_count");
    let ok_binds = binding_count(q) == 1;
    if ok_not_exists && no_count && ok_binds {
        'True
    } else {
        fail!("singer->concert two-hop absence should be supported", q.sql)
    }
};

def test_synonym_consistency_unsupported = do {
    # Two synonymous spellings of a genuinely unreachable multi-hop existence
    # (stadium base, singer target) must produce the same deterministic
    # unsupported result (never one success with an extra count and one
    # unsupported).
    let s1: String = `{"measures":[],"dimensions":[{"id":"stadium_name"}],"distinct":false,"filters":[],"exists":[{"target":"singer","filters":[{"id":"singer_country","op":"eq","value":"AAA"}]}],"absence":[],"order":[],"limit":null,"offset":null}`;
    let s2: String = `{"measures":[],"dimensions":[{"id":"stadium_name"}],"distinct":false,"filters":[],"exists":[{"target":"singer","filters":[{"id":"singer_country","op":"ge","value":"AAA"},{"id":"singer_country","op":"le","value":"AAA"}]}],"absence":[],"order":[],"limit":null,"offset":null}`;
    let p1a = problem_text(s1);
    let p1b = problem_text(s1);
    let p2 = problem_text(s2);
    let same_repeat = p1a == p1b;
    let same_synonym = p1a == p2;
    let is_unsupported = match p1a {
        'Some(msg) => contains_literal(msg, "unsupported"),
        'None => 'False,
    };
    if same_repeat && same_synonym && is_unsupported {
        'True
    } else {
        fail!("synonymous unreachable existence intents are not consistent")
    }
};

def test_synonym_consistency_supported = do {
    # A supported shape must be repeatable and identical for synonymous
    # spellings (same semantic request encoded with different JSON key order).
    let s1: String = `{"measures":[],"dimensions":[{"id":"singer_name"}],"distinct":false,"filters":[{"id":"singer_country","op":"eq","value":"AAA"}],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;
    let s2: String = `{"limit":null,"offset":null,"order":[],"absence":[],"exists":[],"filters":[{"id":"singer_country","op":"eq","value":"AAA"}],"distinct":false,"dimensions":[{"id":"singer_name"}],"measures":[]}`;
    let a = run_text(s1);
    let b = run_text(s1);
    let c = run_text(s2);
    let same_repeat = a.sql == b.sql && a.bindings == b.bindings;
    let same_synonym = a.sql == c.sql && a.bindings == c.bindings;
    if same_repeat && same_synonym {
        'True
    } else {
        fail!("synonymous supported intents are not consistent")
    }
};

def test_ordering_unselected_dimension_in_aggregate = do {
    let text: String = `{"measures":[{"id":"singer_count","mode":"all"}],"dimensions":[],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[{"measure":null,"dimension":"singer_age","direction":"asc"}],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("hidden ordering inside an aggregated intent was accepted"),
    }
};

def test_distinct_with_measures = do {
    let text: String = `{"measures":[{"id":"singer_count","mode":"all"}],"dimensions":[{"id":"singer_country"}],"distinct":true,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("distinct with measures was accepted"),
    }
};

def test_offset_without_ordering = do {
    let text: String = `{"measures":[{"id":"singer_count","mode":"all"}],"dimensions":[],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[],"limit":null,"offset":5}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("offset without ordering was accepted"),
    }
};

def test_nonpositive_limit = do {
    let text: String = `{"measures":[],"dimensions":[{"id":"singer_name"}],"distinct":false,"filters":[],"exists":[],"absence":[],"order":[],"limit":0,"offset":null}`;
    match problem_text(text) {
        'Some(_) => 'True,
        'None => fail!("non-positive limit was accepted"),
    }
};

# ---------------------------------------------------------------------------
# Exports (tests must be exported so `check @test/query` evaluates them).
# ---------------------------------------------------------------------------

export {
    test_total_singers,
    test_filtered_age_stats,
    test_group_by_country,
    test_distinct_countries,
    test_hidden_age_order,
    test_stadium_range_list,
    test_concerts_per_stadium,
    test_stadium_capacity_stats,
    test_stadium_two_year_exists,
    test_stadium_no_concert,
    test_stadium_top_capacity,
    test_internal_top_country,
    test_internal_top_wrong_entity,
    test_two_bindings_parameterized,
    test_deterministic,
    test_unknown_measure,
    test_unknown_dimension,
    test_unknown_exists_target,
    test_unknown_absence_target,
    test_text_value_on_numeric_dimension,
    test_unsupported_filter_operator,
    test_ordering_unselected_measure,
    test_unsupported_multi_hop_exists,
    test_singer_concert_two_hop_supported,
    test_singer_concert_two_hop_absence_supported,
    test_synonym_consistency_unsupported,
    test_synonym_consistency_supported,
    test_ordering_unselected_dimension_in_aggregate,
    test_distinct_with_measures,
    test_offset_without_ordering,
    test_nonpositive_limit,
};
