    match checked_response(document) {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if point.target.kind == edsl::KnowledgeKind::BusinessLink
                && point.direction == Some(edsl::LinkDirection::Directed)
                && point.guard == Some({field: "direction", op: edsl::FilterOp::Eq,
                    input: edsl::FilterInput::Text("unidirectional")}) { True }
            else { fail!("downstream topic lost directed one-way semantics", point) },
        other => fail!("downstream topic did not resolve to its guarded knowledge point", other),
    }
});

pub def site_alarm_relation_discloses_its_guard: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Relation,
        owner: "current_alarm", id: "alarm_site_reference"};
    match lookup(id) {
        knowledge::DocResult::Found(point) => match point.relation {
            Some(detail) => match detail.guard {
                Some(guard) => if guard.field == "strext13" && guard.op == edsl::FilterOp::Ne
                    && guard.input == edsl::FilterInput::Text("3")
                    && array::any(point.refs, fn(ref) { ref.target.kind == edsl::KnowledgeKind::Field
                        && ref.target.owner == "current_alarm" && ref.target.id == "strext13" })
                    && match lookup({kind: edsl::KnowledgeKind::Field,
                        owner: "current_alarm", id: "strext13"}) {
                        knowledge::DocResult::Found(_) => True, _ => False,
                    } { True }
                    else { fail!("site-alarm relation guard changed", guard) },
                None => fail!("site-alarm relation lost its guard in discovery", detail),
            },
            None => fail!("site-alarm topic has no relation detail", point),
        },
        other => fail!("guarded relation is undiscoverable", other),
    }
});

pub def alarm_severity_discovery_covers_all_source_business_values: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Dimension,
        owner: "current_alarm", id: "alarm_severity"};
    match lookup(id) {
        knowledge::DocResult::Found(point) => match point.dimension {
            Some(detail) => if array::length(detail.values) == 4
                && detail.canonical_order == ["critical", "major", "minor", "warning"]
                && array::all(["critical", "major", "minor", "warning"], fn(name) {
                    array::any(detail.values, fn(value) { value.id == name })
                }) && array::any(detail.ops, fn(op) { op == edsl::FilterOp::Ne }) { True }
            else { fail!("alarm severity discovery lost a source value or Ne capability", detail) },
            None => fail!("alarm severity topic has no dimension detail", point),
        },
        other => fail!("alarm severity is undiscoverable", other),
    }
});

pub def ic_device_kpi_measure_is_discoverable: test::Test = test::should_ok(fn() {
    let id: edsl::KnowledgeTarget = {kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "port_count_sample_avg"};
    match lookup(id) {
        knowledge::DocResult::Found(point) => if point.measure != None { True }
            else { fail!("sample aggregate has no declared measure detail", point) },
        other => fail!("model-declared sample aggregate is undiscoverable", other),
    }
});

def kpi_measure_doc: Fn(String) -> edsl::MeasureBrief = fn(id) {
    let input = key_input(edsl::KnowledgeKind::Measure, "device_kpi", id);
    let document = knowledge::knowledge_info_method_factory(payload)(input);
    match checked_response(document) {
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::Found(point)) =>
            if point.target.kind != edsl::KnowledgeKind::Measure || point.target.owner != "device_kpi"
                || point.target.id != id {
                fail!("KPI topic resolved to another knowledge point", id, point.target)
            } else { match point.measure {
                Some(measure) => measure,
                None => fail!("KPI document has no measure detail", id),
            } },
        knowledge::KnowledgeResponse::Document(knowledge::DocResult::NotFound) =>
            fail!("KPI key is not indexed", id),
        _ => fail!("KPI measure is not discoverable by ic/info", id),
    }
};

pub def published_port_total_is_discoverable_as_sum: test::Test = test::should_ok(fn() {
    let measure = kpi_measure_doc("port_count");
    match measure.metric {
        Some(metric) => if measure.aggregate == Some(qb::AggregateFunction::Sum)
            && metric.role == edsl::MetricValueRole::DeclaredMetric { True }
        else { fail!("published port metric lost Sum role", measure) },
        None => fail!("published port metric lost its role"),
    }
});

pub def port_sample_average_is_discoverable_as_distinct_summary: test::Test = test::should_ok(fn() {
    let measure = kpi_measure_doc("port_count_sample_avg");
    match measure.metric {
        Some(metric) => if measure.aggregate == Some(qb::AggregateFunction::Avg)
            && metric.role == edsl::MetricValueRole::SampleSummary
            && string::contains(measure.summary, "distinct from the published Sum") { True }
        else { fail!("sample port average lost Avg summary role", measure) },
