use ontology::quantity as q;
use ontology::js_codec as js;
use ontology::intent as intent;
use std::type_property as property;
use std::test as test;
use std::array as array;
use std::string as string;

type Samples = struct {
    @q::field_unit("%", "ratio", 0.01)
    percent: Option(q::Percent),
    @q::field_unit("1", "ratio", 1.0)
    ratio: q::Ratio,
};
pub def ratios_are_nonadditive: test::Test = test::should_ok(fn() {
    match property::get_type_prop(q::Percent.type, q::Calculations.type) {
        Some(policy) => array::any(policy.allowed, fn(op) {op == q::Calculation::Mean}) && !array::any(policy.allowed, fn(op) {op == q::Calculation::Sum || op == q::Calculation::Add}),
        None => False,
    }
});
pub def scale_belongs_to_field: test::Test = test::should_ok(fn() {
    match property::get_field_prop(Samples.type, 0, q::FieldUnit.type) {
        Some(spec) => spec.unit.symbol == "%" && spec.unit.scale == 0.01,
        None => False,
    }
});
pub def codec_carries_policy: test::Test = test::should_ok(fn() {
    string::contains(js::source(q::Percent.type, intent::ResultType::Float), "operations:")
});

use ontology::samples as samples;
@q::calculations([q::Calculation::Compare])
type ComparisonOnly = struct(Float);
@q::calculations([q::Calculation::Compare, q::Calculation::Sum])
type WidenedPercent = struct(q::Percent);
pub def model_cannot_publish_forbidden_statistic: test::Test = test::should_fail_with(fn() {
    samples::group("forbidden", ComparisonOnly.type, samples::Statistic::Mean, [], None)
}, "sample statistic exceeds type calculation capabilities");
pub def wrapper_cannot_restore_additivity: test::Test = test::should_fail_with(fn() {
    js::source(WidenedPercent.type, intent::ResultType::Float)
}, "newtype calculations cannot exceed inner type capabilities");

@q::display_precision(3)
type FineRatio = struct(q::Ratio);
type InheritedFineRatio = struct(FineRatio);
pub def precision_is_inherited_and_published: test::Test = test::should_ok(fn() {
    q::display_digits(InheritedFineRatio.type) == Some(3) && string::contains(js::presentation_source(InheritedFineRatio.type), "\"precision\":3")
});
