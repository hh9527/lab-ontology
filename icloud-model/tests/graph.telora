pub def empty_alarm_population_rejects_outer_alternatives: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"alarm", "nodes":[{"id":"alarm","entity":"current_alarm"}],
        "edges":[], "select":[], "count":"alarm", "include_empty":true,
        "any_of":[{"node":"alarm","dimension":"alarm_severity","kind":"text",
                   "values":["critical"]}]
    }"#).unwrap!())
}, "graph include_empty cannot apply any_of in WHERE without changing empty populations");

pub def measure_projection_rejects_another_fanout_join: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device",
        "nodes":[{"id":"device","entity":"device"},{"id":"observed","entity":"device_kpi"},
                 {"id":"alarm","entity":"current_alarm"}],
        "edges":[{"relation":"device_kpi_of_device","from":"observed","to":"device"},
                 {"relation":"device_current_alarm","from":"alarm","to":"device"}],
        "select":[{"node":"device","dimension":"device_name"}],
        "measures":[{"node":"observed","measure":"port_count"}],
        "group_by_identity":["device"]
    }"#).unwrap!())
}, "graph measure source may be multiplied by a joined relation; use correlated EXISTS for qualification");

pub def measure_projection_rejects_wrong_owner: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "measures":[{"node":"device","measure":"cpu_usage"}]
    }"#).unwrap!())
}, "graph projection measure does not belong to its named node");

pub def measure_projection_rejects_ambiguous_combined_count: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"device", "nodes":[{"id":"device","entity":"device"}],
        "edges":[], "select":[], "count":"device",
        "measures":[{"node":"device","measure":"device_count"}]
    }"#).unwrap!())
}, "graph cannot combine row count with measure projection; choose one aggregation grain");

pub def ic_physical_link_peer_is_traversable_from_both_endpoints: test::Test = test::should_ok(fn() {
    let from_a = lower(json::parse(r#"{
        "op":"graph", "root":"a", "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"physical_link_peer_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    let from_z = lower(json::parse(r#"{
        "op":"graph", "root":"z", "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"physical_link_peer_device","from":"a","to":"z"}],
        "select":[{"node":"a","dimension":"device_id"},{"node":"z","dimension":"device_id"}]
    }"#).unwrap!());
    if string::contains(from_a.sql, "a_ne_res_id") && string::contains(from_a.sql, "z_ne_res_id")
        && string::contains(from_a.sql, "tenantId") && string::contains(from_a.sql, " OR ")
        && string::contains(from_z.sql, " OR ") { True }
    else { fail!("IC bidirectional link lost A/Z or tenant ownership", from_a.sql, from_z.sql) }
});

pub def ic_peer_does_not_accept_an_unrelated_endpoint_relation: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"a", "nodes":[{"id":"a","entity":"device"},{"id":"z","entity":"device"}],
        "edges":[{"relation":"physical_link_belongs_to_tenant","from":"a","to":"z"}],
        "select":[{"node":"z","dimension":"device_id"}]
    }"#).unwrap!())
}, "graph edge role or target does not match declared relation");

pub def peer_existence_can_constrain_named_tenant: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"owner", "nodes":[{"id":"owner","entity":"device"}],
        "edges":[], "select":[{"node":"owner","dimension":"device_id"}],
        "exists":[{"anchor":"owner",
            "nodes":[{"id":"peer","entity":"device"},{"id":"tenant","entity":"tenant"}],
            "edges":[{"relation":"physical_link_peer_device","from":"owner","to":"peer"},
                     {"relation":"device_belongs_to_tenant","from":"owner","to":"tenant"}],
            "constraints":[{"relation":"device_belongs_to_tenant","from":"peer","to":"tenant"}]
        }]
    }"#).unwrap!());
    if string::contains(query.sql, "peer.tenant_id = tenant.TENANT_ID")
        && string::contains(query.sql, "EXISTS (SELECT 1 FROM EnterprisePhysicalLink") { True }
    else { fail!(`peer existence lost its named tenant constraint: \{query.sql}`) }
});

pub def peer_existence_rejects_implicit_hub_constraint: test::Test = test::should_fail_with(fn() {
    lower(json::parse(r#"{
        "op":"graph", "root":"owner", "nodes":[{"id":"owner","entity":"device"}],
        "edges":[], "select":[{"node":"owner","dimension":"device_id"}],
        "exists":[{"anchor":"owner", "nodes":[{"id":"peer","entity":"device"}],
            "edges":[{"relation":"physical_link_peer_device","from":"owner","to":"peer"}],
            "constraints":[{"relation":"physical_link_belongs_to_tenant","from":"physical_link_peer_device_link","to":"peer"}]
        }]
    }"#).unwrap!())
}, "graph node is not connected to the root");

pub def peer_existence_can_constrain_outer_tenant: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"owner",
        "nodes":[{"id":"owner","entity":"device"},{"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"device_belongs_to_tenant","from":"owner","to":"tenant"}],
        "select":[{"node":"owner","dimension":"device_id"}],
        "exists":[{"anchor":"owner", "nodes":[{"id":"peer","entity":"device"}],
            "edges":[{"relation":"physical_link_peer_device","from":"owner","to":"peer"}],
            "constraints":[{"relation":"device_belongs_to_tenant","from":"peer","to":"tenant"}]
        }]
    }"#).unwrap!());
    if string::contains(query.sql, "peer.tenant_id = tenant.TENANT_ID")
        && string::contains(query.sql, "EXISTS (SELECT 1 FROM EnterprisePhysicalLink") { True }
    else { fail!(`peer existence lost its outer tenant: \{query.sql}`) }
});

pub def alarm_server_component_requires_shared_tenant: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"alarm",
        "nodes":[{"id":"alarm","entity":"current_alarm"},{"id":"server","entity":"server_device"}],
        "edges":[{"relation":"server_current_alarm","from":"alarm","to":"server"}],
        "select":[{"node":"alarm","dimension":"alarm_csn"}],
        "exists":[{"anchor":"server",
            "nodes":[{"id":"fan","entity":"server_fan"},{"id":"tenant","entity":"tenant"}],
            "edges":[{"relation":"fan_parent_server","from":"fan","to":"server"},
                     {"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
            "constraints":[{"relation":"fan_belongs_to_tenant","from":"fan","to":"tenant"}],
            "filters":[{"node":"fan","dimension":"server_fan_manufacturer","op":"eq","kind":"text","value":"Huawei"}]
        }]
    }"#).unwrap!());
    if string::contains(query.sql, "alarm.MEDN = server.id")
        && string::contains(query.sql, "alarm.TENANTID = server.tenantId")
        && string::contains(query.sql, "server.oriResId = fan.parentResId")
        && string::contains(query.sql, "server.tenantId = tenant.TENANT_ID")
        && string::contains(query.sql, "fan.tenantId = tenant.TENANT_ID") { True }
    else { fail!(`component qualification lost tenant alignment: \{query.sql}`, query.bindings) }
});

pub def alarm_component_can_constrain_outer_tenant: test::Test = test::should_ok(fn() {
    let query = lower(json::parse(r#"{
        "op":"graph", "root":"alarm",
        "nodes":[{"id":"alarm","entity":"current_alarm"},{"id":"server","entity":"server_device"},
                 {"id":"tenant","entity":"tenant"}],
        "edges":[{"relation":"server_current_alarm","from":"alarm","to":"server"},
                 {"relation":"server_belongs_to_tenant","from":"server","to":"tenant"}],
        "select":[{"node":"alarm","dimension":"alarm_csn"},
                  {"node":"tenant","dimension":"tenant_name"}],
        "exists":[{"anchor":"server", "nodes":[{"id":"fan","entity":"server_fan"}],
            "edges":[{"relation":"fan_parent_server","from":"fan","to":"server"}],
            "constraints":[{"relation":"fan_belongs_to_tenant","from":"fan","to":"tenant"}]
        }]
    }"#).unwrap!());
    if string::contains(query.sql, "server.oriResId = fan.parentResId")
        && string::contains(query.sql, "fan.tenantId = tenant.TENANT_ID") { True }
    else { fail!(`component lost its outer tenant identity: \{query.sql}`) }
});

