use crate::ontology as edsl;
use std::array as array;
use std::codec as codec;
use std::dict as dict;
use std::json as json;
use std::type_property as property;
use std::value::{ Value };

type LinkKind = enum { Member, Traversable, Related };
type KnowledgeLink = struct { target: edsl::KnowledgeTarget, kind: LinkKind };
type Point = struct {
    target: edsl::KnowledgeTarget,
    label: String,
    aliases: Array(String),
    localized: Array(edsl::LocalizedKnowledgeText),
    summary: String,
    refs: Array(KnowledgeLink),
    grain: Array(String),
    time_roles: Array(edsl::TimeRoleBrief),
    time_role: Option(edsl::TimeRoleBrief),
    dimension: Option(edsl::SubjectDimensionBrief),
    measure: Option(edsl::MeasureBrief),
    relation: Option(edsl::RelationBrief),
    metric: Option(edsl::MetricValueEntry),
    direction: Option(edsl::LinkDirection),
    guard: Option(edsl::ScopePredicate),
};
type TopicEntry = struct { topic: String, target: edsl::KnowledgeTarget, label: String, owner: String, locale: Option(String) };
type DocResult = enum { NotFound, Found(Point), Candidates(Array(TopicEntry)) };
type TopicPage = struct { entries: Array(TopicEntry), next_offset: Option(Int) };
type KnowledgeResponse = enum { Index(TopicPage), Document(DocResult) };
type Catalog = struct { points: Array(Point), topics: Array(TopicEntry) };

def target: Fn(edsl::KnowledgeKind, String, String) -> edsl::KnowledgeTarget = fn(kind, owner, id) {
    {kind, owner, id}
};

def member: Fn(edsl::KnowledgeTarget) -> KnowledgeLink = fn(item) { {target: item, kind: LinkKind::Member} };
def traversable: Fn(edsl::KnowledgeTarget) -> KnowledgeLink = fn(item) { {target: item, kind: LinkKind::Traversable} };

def point: Fn(edsl::KnowledgeTarget, String, Array(String), String, Array(KnowledgeLink)) -> Point =
    fn(id, label, aliases, summary, refs) {
        {target: id, label, aliases, localized: [], summary, refs, grain: [], time_roles: [], time_role: None,
            dimension: None, measure: None, relation: None, metric: None, direction: None, guard: None}
    };

def labels: Fn(Array(edsl::LocalizedKnowledgeText)) -> Array(String) = fn(texts) {
    array::map(texts, fn(entry) { entry.label })
};

def dataset_point: Fn(edsl::PreparedPayload, edsl::DatasetBrief) -> Point = fn(payload, brief) {
    let id = target(edsl::KnowledgeKind::Dataset, "", brief.id);
    let dimensions = array::map(brief.dimension_ids, fn(name) {
        member(target(edsl::KnowledgeKind::Dimension, brief.id, name))
    });
    let fields = array::map(edsl::published_fields(payload, brief.id), fn(name) {
        member(target(edsl::KnowledgeKind::Field, brief.id, name))
    });
    let measures = array::map(brief.measure_ids, fn(name) {
        member(target(edsl::KnowledgeKind::Measure, brief.id, name))
    });
    let metrics = array::map(brief.metric_ids, fn(name) {
        member(target(edsl::KnowledgeKind::Metric, brief.id, name))
    });
    let times = array::map(brief.time_roles, fn(role) {
        member(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field))
    });
    let relations = array::map(brief.relation_ids, fn(name) {
        let declared = match array::find(payload.relations, fn(entry) { entry.id == name }) {
            Some(entry) => entry,
            None => fail!("knowledge relation disappeared from prepared model", name),
        };
        member(target(edsl::KnowledgeKind::Relation, payload.entities[declared.from].id, name))
    });
    let links = array::map(array::filter(payload.business_links, fn(link) {
        let hub = payload.entities[link.hub].id;
        let participant = payload.entities[link.participant].id;
        hub == brief.id || participant == brief.id
    }), fn(link) {
        member(target(edsl::KnowledgeKind::BusinessLink, payload.entities[link.hub].id, link.id))
    });
    let refs = array::concat([fields, dimensions, measures, metrics, times, relations, links]);
    let item = point(id, brief.label, array::concat([brief.aliases, labels(brief.localized)]), brief.summary, refs);
    let entity = match array::find(payload.entities, fn(e) { e.id == brief.id }) {
        Some(e) => e, None => fail!("knowledge dataset disappeared from prepared model", brief.id),
    };
    let grain = match entity.dataset { Some(spec) => spec.grain, None => [] };
    {...item, localized: brief.localized, grain, time_roles: brief.time_roles}
};

def dimension_points: Fn(edsl::PreparedPayload, String, String) -> Array(Point) = fn(payload, subject, id) {
    let detail = edsl::dimension_detail_for_subject(payload, subject, id);
    let parent = target(edsl::KnowledgeKind::Dataset, "", detail.dataset);
    let dimension = target(edsl::KnowledgeKind::Dimension, detail.dataset, detail.id);
    let values = array::map(detail.values, fn(value) {
        let current = target(edsl::KnowledgeKind::Value, detail.id, value.id);
        let item = point(current, value.label, array::concat([value.aliases, array::map(value.localized, fn(text) { text.label })]),
            "", [member(dimension)]);
        {...item, localized: array::map(value.localized, fn(text) {
            {locale: text.locale, label: text.label, summary: ""}
        })}
    });
    let value_refs = array::map(detail.values, fn(value) {
        member(target(edsl::KnowledgeKind::Value, detail.id, value.id))
    });
    let base = point(dimension, detail.label, array::concat([detail.aliases, labels(detail.localized)]),
        detail.summary, array::concat([[member(parent), member(target(edsl::KnowledgeKind::Field, detail.dataset, detail.field))], value_refs]));
    array::concat([[{...base, dimension: Some(detail), localized: detail.localized}], values])
};

def measure_point: Fn(edsl::PreparedPayload, String, String) -> Point = fn(payload, subject, id) {
    let detail = edsl::measure_domain_for_subject(payload, subject, id);
    let field_refs = match detail.field {
        Some(name) => [member(target(edsl::KnowledgeKind::Field, detail.dataset, name))], None => [],
    };
    let predicate_refs = match detail.predicate {
        None => [],
        Some(predicate) => do {
            let entity = match array::find(payload.entities, fn(entry) { entry.id == detail.dataset }) {
                Some(entry) => entry, None => fail!("measure predicate owner is not in the prepared model", id),
            };
            let field = match array::find(entity.fields, fn(entry) { entry.name == predicate.field }) {
                Some(entry) => entry, None => fail!("measure predicate field is not in the prepared model", id, predicate.field),
            };
            let dimension = match array::find(payload.dimensions, fn(entry) {
                entry.entity == entity.index && entry.field == field.index
            }) {
                Some(entry) => entry, None => fail!("measure predicate dimension is not in the prepared model", id, predicate.field),
            };
            let dimension_ref = target(edsl::KnowledgeKind::Dimension, detail.dataset, dimension.id);
            let business = edsl::dimension_detail_for_subject(payload, subject, dimension.id);
            let value_ref = match (predicate.op, predicate.input) {
                (edsl::FilterOp::Eq, edsl::FilterInput::Text(name)) =>
                    if array::any(business.values, fn(value) { value.id == name }) {
                        [member(target(edsl::KnowledgeKind::Value, dimension.id, name))]
                    } else { [] },
                _ => [],
            };
            array::concat([[member(dimension_ref)], value_ref])
        },
    };
    let computed_refs = match detail.computed {
        Some(computed) => [member(target(edsl::KnowledgeKind::Measure, detail.dataset, computed.left)),
            member(target(edsl::KnowledgeKind::Measure, detail.dataset, computed.right))],
        None => [],
    };
    let refs = array::concat([
        [member(target(edsl::KnowledgeKind::Dataset, "", detail.dataset))],
        field_refs,
        array::map(detail.required_dataset_ids, fn(dataset) {
            member(target(edsl::KnowledgeKind::Dataset, "", dataset))
        }),
        predicate_refs, computed_refs,
    ]);
    let base = point(target(edsl::KnowledgeKind::Measure, detail.dataset, detail.id), detail.label,
        array::concat([detail.aliases, labels(detail.localized)]), detail.summary, refs);
    {...base, measure: Some(detail), localized: detail.localized}
};

def relation_point: Fn(edsl::PreparedPayload, String, String) -> Point = fn(payload, subject, id) {
    let detail = edsl::relation_detail_for_subject(payload, subject, id);
    let guard_refs = match detail.guard {
        Some(guard) => [member(target(edsl::KnowledgeKind::Field, detail.from_dataset, guard.field))],
        None => [],
    };
    let base = point(target(edsl::KnowledgeKind::Relation, detail.from_dataset, detail.id), detail.label,
        array::concat([detail.aliases, labels(detail.localized)]), detail.summary,
        array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", detail.from_dataset)),
         traversable(target(edsl::KnowledgeKind::Dataset, "", detail.to_dataset))], guard_refs]));
    {...base, relation: Some(detail), localized: detail.localized}
};

def link_point: Fn(edsl::PreparedPayload, edsl::BusinessLinkEntry) -> Point = fn(payload, link) {
    let hub = payload.entities[link.hub].id;
    let participant = payload.entities[link.participant].id;
    let guard_refs = match link.guard {
        None => [],
        Some(pred) => [member(target(edsl::KnowledgeKind::Field, hub, pred.field))],
    };
    let base = point(target(edsl::KnowledgeKind::BusinessLink, hub, link.id), link.id, [], "",
        array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", hub)),
         traversable(target(edsl::KnowledgeKind::Dataset, "", participant)),
         member(target(edsl::KnowledgeKind::Relation, hub, link.a_relation)),
         member(target(edsl::KnowledgeKind::Relation, hub, link.z_relation))], guard_refs]));
    {...base, direction: Some(link.direction), guard: link.guard}
};

def dataset_members: Fn(edsl::PreparedPayload, String, edsl::DatasetBrief) -> Array(Point) = fn(payload, subject, brief) {
    let fields = array::map(edsl::published_fields(payload, brief.id), fn(name) {
        point(target(edsl::KnowledgeKind::Field, brief.id, name), name, [], "",
            [member(target(edsl::KnowledgeKind::Dataset, "", brief.id))])
    });
    let dimensions = array::flat_map(brief.dimension_ids, fn(id) { dimension_points(payload, subject, id) });
    let measures = array::map(brief.measure_ids, fn(id) { measure_point(payload, subject, id) });
    let relations = array::map(array::filter(payload.relations, fn(entry) {
        entry.id != "" && payload.entities[entry.from].id == brief.id
    }), fn(entry) { relation_point(payload, subject, entry.id) });
    let metrics = array::map(array::filter(payload.entities, fn(e) { e.id == brief.id }), fn(e) { e.metrics });
    let metric_points = array::flat_map(metrics, fn(items) { array::map(items, fn(metric) {
        let measure_refs = if array::any(brief.measure_ids, fn(id) { id == metric.id }) {
            [member(target(edsl::KnowledgeKind::Measure, brief.id, metric.id))]
        } else { [] };
        let base = point(target(edsl::KnowledgeKind::Metric, brief.id, metric.id), metric.id, [], "",
            array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", brief.id)),
                member(target(edsl::KnowledgeKind::Field, brief.id, metric.field))], measure_refs]));
        {...base, metric: Some(metric)}
    }) });
    let times = array::map(brief.time_roles, fn(role) {
        let base = point(target(edsl::KnowledgeKind::TimeRole, brief.id, role.field), role.field, [], "",
            array::concat([[member(target(edsl::KnowledgeKind::Dataset, "", brief.id)),
                member(target(edsl::KnowledgeKind::Field, brief.id, role.field))],
                array::map(role.dimension_ids, fn(id) {
                    member(target(edsl::KnowledgeKind::Dimension, brief.id, id))
                })]));
        {...base, time_role: Some(role)}
    });
    let links = array::map(array::filter(payload.business_links, fn(link) {
        payload.entities[link.hub].id == brief.id
    }), fn(link) { link_point(payload, link) });
    array::concat([fields, dimensions, measures, relations, metric_points, times, links])
};

def target_key: Fn(edsl::KnowledgeTarget) -> String = fn(id) {
    json::stringify(codec::encode(id))
};

# Every node is addressable by stable id or declared label, but details and
# references are returned one point at a time. No topic string is a query id.
def map: Fn(edsl::PreparedPayload, String) -> Array(Point) = fn(payload, subject) {
    let datasets = edsl::knowledge_index_for_subject(payload, subject);
    let raw = array::concat([
        array::map(datasets, fn(brief) { dataset_point(payload, brief) }),
        array::flat_map(datasets, fn(brief) { dataset_members(payload, subject, brief) }),
    ]);
    let visible = dict::from_pairs(array::map(raw, fn(item) { (target_key(item.target), True) }));
    let incoming_keys = array::fold(raw, [].ty!(Array(String)), fn(seen, item) {
        array::fold(item.refs, seen, fn(keys, ref) {
            let key = target_key(ref.target);
            if ref.kind == LinkKind::Related || array::any(keys, fn(existing) { existing == key }) {
                keys
            } else { array::push(keys, key) }
        })
    });
    let incoming = dict::from_pairs(array::map(incoming_keys, fn(key) { (key, True) }));
    if let Some(dangling) = array::find(raw, fn(item) {
        array::any(item.refs, fn(ref) {
            dict::get(visible, target_key(ref.target)) == None
        })
    }) { fail!("knowledge point references a point outside the visible model", dangling.target) }
    else if let Some(orphan) = array::find(raw, fn(item) {
        item.target.kind != edsl::KnowledgeKind::Dataset
            && dict::get(incoming, target_key(item.target)) == None
    }) { fail!("knowledge point is not reachable from its declaring model", orphan.target) }
    else {
        let docs = array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeDocs.type) {
                Some(declared) => declared.entries, None => [],
            }
        });
        let related = array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeRelations.type) {
                Some(declared) => declared.entries, None => [],
            }
        });
        array::map(raw, fn(item) {
            let refs = array::concat([item.refs, array::map(array::filter(related, fn(ref) {
                ref.source == item.target && dict::get(visible, target_key(ref.target)) != None
            }), fn(ref) { {target: ref.target, kind: LinkKind::Related} })]);
            let summary = match array::find(docs, fn(note) { note.target == item.target }) {
                Some(note) => note.text, None => item.summary,
            };
            {...item, refs, summary}
        })
    }
};

def topic_index_from_points: Fn(Array(Point)) -> Array(TopicEntry) = fn(points) {
    array::flat_map(points, fn(item) {
        let names = array::concat([[item.target.id, item.label], item.aliases]);
        array::map(array::filter(array::enumerate(names), fn(indexed) {
            indexed.1 != "" && !array::any(array::filter(array::enumerate(names), fn(other) {
                other.0 < indexed.0
            }), fn(other) { other.1 == indexed.1 })
        }), fn(indexed) {
            let locale = match array::find(item.localized, fn(text) { text.label == indexed.1 }) {
                Some(text) => Some(text.locale), None => None,
            };
            {topic: indexed.1, target: item.target, label: item.label, owner: item.target.owner, locale}
        })
    })
};

def topic_index: Fn(edsl::PreparedPayload, String) -> Array(TopicEntry) = fn(payload, subject) {
    topic_index_from_points(map(payload, subject))
};

# Lightweight request index; the service's index slot validates the full
# catalog and reference closure once at initialization.
def topic_index_from_model: Fn(edsl::PreparedPayload, String) -> Array(TopicEntry) = fn(payload, subject) {
    let datasets = edsl::knowledge_index_for_subject(payload, subject);
    topic_index_from_points(array::concat([
        array::map(datasets, fn(brief) { dataset_point(payload, brief) }),
        array::flat_map(datasets, fn(brief) { dataset_members(payload, subject, brief) }),
    ]))
};

def prepare_catalog: Fn(edsl::PreparedPayload, String) -> Catalog = fn(payload, subject) {
    let points = map(payload, subject);
    {points, topics: topic_index_from_points(points)}
};

def doc_in_catalog: Fn(Catalog, String) -> DocResult = fn(catalog, topic) {
    let candidates = array::filter(catalog.topics, fn(entry) { entry.topic == topic });
    if array::length(candidates) == 0 { DocResult::NotFound }
    else if array::length(candidates) > 1 { DocResult::Candidates(candidates) }
    else {
        let candidate = candidates[0];
        match array::find(catalog.points, fn(point) { point.target == candidate.target }) {
            Some(item) => DocResult::Found(item),
            None => fail!("knowledge topic has no point in prepared model", candidate),
        }
    }
};

def point_from_topics: Fn(edsl::PreparedPayload, String, Array(TopicEntry), edsl::KnowledgeTarget) -> DocResult = fn(payload, subject, topics, id) {
    if !array::any(topics, fn(entry) { entry.target == id }) { DocResult::NotFound }
    else {
        let datasets = edsl::knowledge_index_for_subject(payload, subject);
        let brief = match array::find(datasets, fn(entry) {
            if id.kind == edsl::KnowledgeKind::Dataset { entry.id == id.id }
            else if id.kind == edsl::KnowledgeKind::Value {
                array::any(entry.dimension_ids, fn(name) { name == id.owner })
            } else { entry.id == id.owner }
        }) {
            Some(entry) => entry,
            None => fail!("knowledge topic owner disappeared from prepared model", id),
        };
        let raw = if id.kind == edsl::KnowledgeKind::Dataset { dataset_point(payload, brief) }
        else { match array::find(dataset_members(payload, subject, brief), fn(item) { item.target == id }) {
            Some(item) => item,
            None => fail!("knowledge topic has no point in prepared model", id),
        } };
        let docs = array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeDocs.type) {
                Some(declared) => declared.entries, None => [],
            }
        });
        let related = array::flat_map(payload.entities, fn(entity) {
            match property::get_type_prop(entity.entity_type, edsl::KnowledgeRelations.type) {
                Some(declared) => declared.entries, None => [],
            }
        });
        let refs = array::concat([raw.refs, array::map(array::filter(related, fn(ref) {
            ref.source == id && array::any(topics, fn(entry) { entry.target == ref.target })
        }), fn(ref) { {target: ref.target, kind: LinkKind::Related} })]);
        let summary = match array::find(docs, fn(note) { note.target == id }) {
            Some(note) => note.text, None => raw.summary,
        };
        DocResult::Found({...raw, refs, summary})
    }
};

def doc_in_topics: Fn(edsl::PreparedPayload, String, Array(TopicEntry), String) -> DocResult = fn(payload, subject, topics, topic) {
    let candidates = array::filter(topics, fn(entry) { entry.topic == topic });
    if array::length(candidates) == 0 { DocResult::NotFound }
    else if array::length(candidates) > 1 { DocResult::Candidates(candidates) }
    else { point_from_topics(payload, subject, topics, candidates[0].target) }
};

# Exact codepoint match: no trimming, case folding, language inference or
# automatic disambiguation. A missing topic returns a value, not a fallback.
def doc: Fn(edsl::PreparedPayload, String, String) -> DocResult = fn(payload, subject, topic) {
    doc_in_catalog(prepare_catalog(payload, subject), topic)
};

def by_target: Fn(edsl::PreparedPayload, String, edsl::KnowledgeTarget) -> DocResult = fn(payload, subject, id) {
    match array::find(map(payload, subject), fn(item) { item.target == id }) {
        Some(item) => DocResult::Found(item), None => DocResult::NotFound,
    }
};

def page_entries: Fn(Array(TopicEntry), Int, Int) -> TopicPage = fn(entries, offset, limit) {
    if offset < 0 || limit < 1 || limit > 100 { fail!("knowledge index requires nonnegative offset and limit in 1..100", offset, limit) }
    else {
        let selected = array::map(array::filter(array::enumerate(entries), fn(item) {
            item.0 >= offset && item.0 - offset < limit
        }), fn(item) { item.1 });
        let next_offset = if offset < array::length(entries) && limit < array::length(entries) - offset {
            Some(offset + limit)
        } else { None };
        {entries: selected, next_offset}
    }
};

def page: Fn(edsl::PreparedPayload, String, Int, Int) -> TopicPage = fn(payload, subject, offset, limit) {
    page_entries(topic_index(payload, subject), offset, limit)
};

def object: Fn(Value) -> Dict(Value) = fn(value) {
    match value { Value::Object(fields) => fields, _ => fail!("knowledge request must be an object", value) }
};
def required: Fn(Dict(Value), String) -> Value = fn(fields, key) {
    match dict::get(fields, key) {
        Some(value) => value, None => fail!("knowledge request field is missing", key),
    }
};
def text_field: Fn(Dict(Value), String) -> String = fn(fields, key) {
    match required(fields, key) {
        Value::String(value) => value, other => fail!("knowledge request field must be a string", key, other),
    }
};
def int_field: Fn(Dict(Value), String, Int) -> Int = fn(fields, key, fallback) {
    match dict::get(fields, key) {
        None => fallback, Some(Value::Int(value)) => value,
        Some(other) => fail!("knowledge request field must be an integer", key, other),
    }
};
def keys: Fn(Dict(Value), Array(String)) -> () = fn(fields, allowed) {
    match array::find(dict::keys(fields), fn(key) { !array::any(allowed, fn(name) { name == key }) }) {
        Some(key) => fail!("knowledge request contains unsupported field", key), None => (),
    }
};
def parse_kind: Fn(String) -> edsl::KnowledgeKind = fn(name) {
    match name {
        "dataset" => edsl::KnowledgeKind::Dataset,
        "field" => edsl::KnowledgeKind::Field,
        "dimension" => edsl::KnowledgeKind::Dimension,
        "measure" => edsl::KnowledgeKind::Measure,
        "value" => edsl::KnowledgeKind::Value,
        "relation" => edsl::KnowledgeKind::Relation,
        "business_link" => edsl::KnowledgeKind::BusinessLink,
        "time_role" => edsl::KnowledgeKind::TimeRole,
        "metric" => edsl::KnowledgeKind::Metric,
        _ => fail!("unknown knowledge target kind", name),
    }
};

# The caller binds a domain to its prepared model and subject. Input is
# validated before looking up a point; topic text never enters query lowering.
def serve_catalog: Fn(Catalog, String, Value) -> KnowledgeResponse = fn(catalog, domain, request) {
    if domain == "" { fail!("knowledge domain must not be empty") } else { () };
    let envelope = object(request);
    keys(envelope, ["method", "input"]);
    let method = text_field(envelope, "method");
    let input = object(required(envelope, "input"));
    if method == `index.\{domain}` {
        keys(input, ["offset", "limit"]);
        KnowledgeResponse::Index(page_entries(catalog.topics, int_field(input, "offset", 0), int_field(input, "limit", 50)))
    } else if method == `doc.\{domain}` {
        let topic = dict::get(input, "topic");
        let id = dict::get(input, "target");
        match (topic, id) {
            (Some(Value::String(name)), None) => do {
                keys(input, ["topic"]);
                KnowledgeResponse::Document(doc_in_catalog(catalog, name))
            },
            (None, Some(value)) => do {
                keys(input, ["target"]);
                let fields = object(value);
                keys(fields, ["kind", "owner", "id"]);
                let target = target(parse_kind(text_field(fields, "kind")), text_field(fields, "owner"), text_field(fields, "id"));
                KnowledgeResponse::Document(match array::find(catalog.points, fn(item) { item.target == target }) {
                    Some(point) => DocResult::Found(point), None => DocResult::NotFound,
                })
            },
            _ => fail!("knowledge doc requires exactly one topic string or target", input),
        }
    } else { fail!("unknown knowledge method for domain", method, domain) }
};

def serve: Fn(edsl::PreparedPayload, String, String, Value) -> KnowledgeResponse = fn(payload, subject, domain, request) {
    serve_catalog(prepare_catalog(payload, subject), domain, request)
};

def serve_value: Fn(edsl::PreparedPayload, String, String, Value) -> Value = fn(payload, subject, domain, request) {
    codec::encode(serve(payload, subject, domain, request))
};

def knowledge_service_factory: Fn(edsl::PreparedPayload, String, String) -> Fn(Value) -> Value =
    fn(payload, subject, domain) {
        fn(request) { serve_value(payload, subject, domain, request) }
    };

# A TransformService slot receives only `input`; the collection has already
# selected its method. Bind that method once when initializing the slot.
def knowledge_method_factory: Fn(edsl::PreparedPayload, String, String, String) -> Fn(Value) -> Value =
    fn(payload, subject, domain, method) {
        let index_topics = if method == `index.\{domain}` { topic_index(payload, subject) } else { [] };
        fn(input) {
            if domain == "" { fail!("knowledge domain must not be empty") }
            else if method == `index.\{domain}` {
                let fields = object(input);
                keys(fields, ["offset", "limit"]);
                codec::encode(KnowledgeResponse::Index(page_entries(index_topics,
                    int_field(fields, "offset", 0), int_field(fields, "limit", 50))))
            } else if method == `doc.\{domain}` {
                let fields = object(input);
                let topic = dict::get(fields, "topic");
                let id = dict::get(fields, "target");
                let document = match (topic, id) {
                    (Some(Value::String(name)), None) => do {
                        keys(fields, ["topic"]);
                        let topics = topic_index_from_model(payload, subject);
                        doc_in_topics(payload, subject, topics, name)
                    },
                    (None, Some(value)) => do {
                        keys(fields, ["target"]);
                        let target_fields = object(value);
                        keys(target_fields, ["kind", "owner", "id"]);
                        let topics = topic_index_from_model(payload, subject);
                        point_from_topics(payload, subject, topics,
                            target(parse_kind(text_field(target_fields, "kind")),
                                text_field(target_fields, "owner"), text_field(target_fields, "id")))
                    },
                    _ => fail!("knowledge doc requires exactly one topic string or target", input),
                };
                codec::encode(KnowledgeResponse::Document(document))
            } else { fail!("unknown knowledge method for domain", method, domain) }
        }
    };

def knowledge_index_method_factory: Fn(edsl::PreparedPayload, String) -> Fn(Value) -> Value =
    fn(payload, subject) {
        let topics = topic_index(payload, subject);
        fn(input) {
            let fields = object(input);
            keys(fields, ["offset", "limit"]);
            codec::encode(KnowledgeResponse::Index(page_entries(topics,
                int_field(fields, "offset", 0), int_field(fields, "limit", 50))))
        }
    };

pub use self::{ LinkKind, KnowledgeLink, Point, TopicEntry, DocResult, TopicPage, KnowledgeResponse,
    map, topic_index, topic_index_from_model, topic_index_from_points, doc, by_target, page, serve, serve_value,
    knowledge_service_factory, knowledge_method_factory, knowledge_index_method_factory };
