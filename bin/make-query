#!/bin/sh
set -eu

usage() {
    echo "usage: make-query check <intent.json|intent-json>" >&2
    exit 64
}

[ "$#" -eq 2 ] || usage
[ "$1" = "check" ] || usage

if [ -f "$2" ]; then
    case "$2" in
        /*) intent_path=$2 ;;
        *) intent_path=$(pwd)/$2 ;;
    esac
else
    case "$2" in
        \{*\})
            intent_path=$(mktemp "${TMPDIR:-/tmp}/labflow-make-query.XXXXXX.json") || {
                echo "make-query: cannot create temporary intent file" >&2
                exit 73
            }
            trap 'rm -f "$intent_path"' 0 HUP INT TERM
            printf '%s\n' "$2" > "$intent_path"
            ;;
        *)
            echo "make-query: intent must be a regular file or a JSON object" >&2
            exit 66
            ;;
    esac
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
telora=$project_root/bin/telora
model=$project_root/icm-model

[ -x "$telora" ] || {
    echo "make-query: Telora executable is unavailable: $telora" >&2
    exit 69
}
[ -f "$model/telora-crate.json" ] || {
    echo "make-query: ICM model is unavailable: $model" >&2
    exit 69
}

"$telora" -C "$model" eval-with @src/bin/make-query:main \
    --source "input=$intent_path"
