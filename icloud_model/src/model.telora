    edsl::DeclaredRelationKey::FieldEq({from: "res_id", to: "id"}))
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "cpu_usage"}, {kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "cpu_peak"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "cpu_usage"}, {kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "device_cpu_sample_min"})
@edsl::related_to({kind: edsl::KnowledgeKind::Measure, owner: "device_kpi", id: "cpu_usage"}, {kind: edsl::KnowledgeKind::Dimension, owner: "device_kpi", id: "device_cpu_sample"})
