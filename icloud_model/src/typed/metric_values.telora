type MeanReceivedErrorPackets = struct(q::MeanReportedCount);
@q::mean_result(MeanReceivedErrorPackets.type)
type ReceivedErrorPackets = struct(q::ReportedCount);
def ReceivedErrorPackets_statistics: samples::Group(ReceivedErrorPackets) = samples::group(
    "ReceivedErrorPackets",
    ReceivedErrorPackets.type,
    samples::Statistic::Mean,
    [],
    None
);
pub use self::{ReceivedErrorPackets, MeanReceivedErrorPackets, ReceivedErrorPackets_statistics};

